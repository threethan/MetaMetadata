4.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgPNZKkbORcQ7kNvwHgqPk8&_nc_oc=AdpGrZde6Y-C8TlTOBFIFWLpKdYnS0f8NdF0RcXnTcA08Tn6p6fsGDCJw3EXz9oS_Wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvgA1B6hklOvdARTlAOYlqk6WeUxjm28Otg_R-1N6fOA&oe=6AE75D69"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujOYnitWN8UQ7kNvwH6R2v4&_nc_oc=AdrtAz1lcDHbwd34SyyhwCfVIZnI7t4lWPT79R5AU4tpC69_etqDYn0cqHYT8E0aB5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEuG1DSeUS_hAjORJiHepyLrgqshL83d7N36lDTUDk4A&oe=6AE74C2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_AuiU6Nv3YQ7kNvwFECVqQ&_nc_oc=AdqtZ91DO2JW6Mhs57zT0rxOnF3N2LbUyUdnsx0UYKdk6aRtDjkzlAtFrlN8IuExat4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuooQ2HL_IB16kqk8QEuV10VKoi5y5-0XUthJHeGp6Cw&oe=6AE7512C"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIZ5634cExwQ7kNvwEeEJrf&_nc_oc=AdpkRNIbrMWqoHV4AWN1MQmPRPezXi8etkWayT1RTM9D1uPReX4UfCb_rLtZ6Ddgs20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYMXNRl5EGgr8Qh2YZxGVlyfgIZeBJKUvJH8sfLo3Tag&oe=6AE74152"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=powJHVwgPUUQ7kNvwFTZ7sL&_nc_oc=AdpU7NxCsvljzgw10zgLkHm3zs7X78N78yl4Kie1d13n5VXFxjIF5unVss-05_Z2TTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV2voxGCM0vJ-_Q7nl6kEimDiwPM0Ypd_E5P2hbFO-6w&oe=6AE76817"}, {"file_name": "background-512x512.png", "id": "2126344877981813", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623512_2126344881315146_4947547688862397006_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVHwcDpdOysQ7kNvwGsMe0R&_nc_oc=Adr0oSycIDsJ-R4QyiZ0GiPwQwC0hyhdcCVXBBs-vpOM0LWUW1IRI7KRFekwaILm49I&_
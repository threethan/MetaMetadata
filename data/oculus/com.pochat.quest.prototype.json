4.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq8YIW3un1AQ7kNvwHZvwe-&_nc_oc=Adpb8fzmRbhYZahXlGP4uXg0i_gCSsXo5cMXPeC2q3qEhKCAzLHFVz5Mo60sfzwqy2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrxybWF-CU5-Xjix-MGzBP3mYy7x0GIn2-YrE_2-kFLg&oe=6AEF4669"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IgHrZybxCsQ7kNvwHunvVB&_nc_oc=AdpGaU4XIuBhDGqmSyu_FB9Jc5z8tlBqFIW9GTay0TcpjwkusPUjpQwbcCizjDl7YDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdKL-PcACMYfniUxwq5iGKb5RZnDZrhEVjFEx1WPqd-A&oe=6AEF352E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiJJYytbR1EQ7kNvwEg8Dtl&_nc_oc=AdqqVRmiph9Qo0wm9K7--o0DrxVqat-zkJgIkjzjSJ3B5DZk3I-03FHY7e_Ahf-EH00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf65pCtuLS_TB_kVdqPOgx5gZmWR4EKEZuYxGqgyxswg&oe=6AEF3A2C"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsuIyZ9KpXgQ7kNvwGwX9ej&_nc_oc=Adov1jFTc6Rsxi1KHNbBM-qhYVez09Q3JiwxdN825GDd5DjBvXbBLtlRcGLCPGHnqCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxxS8hnhojN5OXJEjmPIKuKRwgYiNaM1dXdSfTGSTgdw&oe=6AEF6292"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFZ_DDoht4cQ7kNvwHX4S2N&_nc_oc=AdoG35ZNx8JrUMhJEtePuuQh-OH2XS_c-woompZtl7Fl-4YNrdhC1j2xM7-R-AKNiY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiNvge3d6Mjrf2gY9aCfAekUKFosAoEvoPHy2xCbkztw&oe=6AEF5117"}, {"file_name": "background-512x512.png", "id": "2126344877981813", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623512_2126344881315146_4947547688862397006_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBnOHMLjJyQQ7kNvwHb2q9-&_nc_oc=Adptkt25uPAyAmCzATjvdMvVdk7SOoWwou-_zLOeicTQ2q6yV3XnTBeObOP22Th4GqE&_
-oDD5iDpgT-ks4Q7GWBM5SnuoJcsGD_2WFfL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR70fRHCzHtNGnuaSoeIMOKjIdWk_gdC552cgZ-FJaAIw&oe=6AFDDFBB"}, {"file_name": "858304537_29837295469191797_4388193426456345984_n.png", "id": "1667358748419421", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdRBS8tMqOoQ7kNvwGL6w41&_nc_oc=AdpqD7EDcpSUySEzWNIZ68bhnZrEPGQ_Z9dJyOxhIDTl9WGg32D3AKKKLZ7muiPUus8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOELpzglbyky3DGSLI0CWuUQU7V5JY3X1MD0M4SNshsQ&oe=6AFDC6E9"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkiamRXFcacQ7kNvwFIxSyv&_nc_oc=AdpffD4ImsOV7D7IjOOSEz7rr9ki5VlOpz8GppASGIZjACWRv6Dd_DEpPmDUUrc3PEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbXpStTw8CcWZJ5mh_z82PiKxGKzO29YFaASgfCvAA0Q&oe=6AFDB5AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85POODwWN6UQ7kNvwEXpZRg&_nc_oc=AdqzzDENbGh-kn0Y_Q8BUS2dBBmCe5dKp90XnrMetW07vHvUMHrBCIm6QtMcanUUa1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6BGyzt5502gA1-R8Gkwp_qzEmlDJ3mFmsD_TxmvH7YA&oe=6AFDBAAC"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5r8WkaVbNoQ7kNvwGqRSaU&_nc_oc=Adq5xtLF9lusiF1y9pJ6OKr5wWmYyV0y8AVi7Z9FLiNRSpa1ctVtFyoFEK75Lfc2uH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiWRjI5GeFehyvwNDKoic2m6gb3DosP54yKc1aVSaWNA&oe=6AFDE312"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV3H22Xhg5wQ7kNvwEnqHD7&_nc_oc=AdoONjxOxko8RyepxuJfZsBosXHFTU0yubtpaPNDYJtbQmijT7MMRacavSlp-GJdeKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss
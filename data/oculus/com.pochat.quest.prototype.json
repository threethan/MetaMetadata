nyzgZGToQ6YlXLO8MfwzS1p-zfJxgt-cgzSi0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdSy2wvi_UVbx0DYgQbZQEIO-O5M3tFM61whtbx3ttGw&oe=6B086BBB"}, {"file_name": "858304537_29837295469191797_4388193426456345984_n.png", "id": "1667358748419421", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXAYCcKvqmgQ7kNvwHxmk0-&_nc_oc=AdpgAsqoit3N_AApuZe3ixGQh83cSQar3lNJPjXRSxwkthqiEKM2zRX-IC_A0PHqja0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq7IzrbNBpMyzResjSwZmE7PpD_fMuatptDA5MRIHPwQ&oe=6B0852E9"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGuV3fA60joQ7kNvwHZcIib&_nc_oc=Adrrc009H9codOhj26zpM9oXQJzG7QchA1dgfIoNKaAZEMD776ODvtZ2V_H821CO1ok&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbCPqPEr7wR86ayvxI9W_hRJKbyjHZTJ-NfSD45M-xNw&oe=6B0841AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24MkzUOPR7AQ7kNvwGR2cn7&_nc_oc=AdoR74tH2H6WD80-8VZF1UsWwLTaUFnnW5SbnvtAlT4XDcPLRlcgTURDybznCt-H5m0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa5V2sqboOqx72d3-Vuvgkcq5xfWt372HEo1sBGv2ktQ&oe=6B0846AC"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zDsjY6VGUcQ7kNvwEFLdYi&_nc_oc=AdqODv80AETNFJHQYSZ5edqgm3FaZ1ycERitXWr76WPwG8XQMqvmvl63CfDuuaEtK4w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWKcXuamijx0uwDXzwXPbu1gdbc80-0VItqW-it2n1mw&oe=6B086F12"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ9AIvZWoqUQ7kNvwGkL9Z4&_nc_oc=Adqbgfe_jfIy0SUcqjmx56DcYu7AziGlPF8IkeVyF-6yXo2mA1VbyfW7IzuvplyHeKw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss
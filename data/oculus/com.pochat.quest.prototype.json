o_6ry-7qlTHtW5-SGGZ4x0-3uWaLpfmMbjveY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3xn8f7hHzGn4uhXXIFA1BYRf4XGj5xlnrKb7guvcgQQ&oe=6B0B0EBB"}, {"file_name": "858304537_29837295469191797_4388193426456345984_n.png", "id": "1667358748419421", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t-TIyoSGMUQ7kNvwE4lCgf&_nc_oc=AdqiltaWQ9zbXqmn9HoPNONWVFNLm-W4GrFIr5k_dBjTcvbjInQldaR38MpMMVcgNaI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEtAPbpik3U5yifqfdgq99XC0Z655R_B0ASjtS1HFufQ&oe=6B0B2E29"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVBWUp6v2ckQ7kNvwEl3uEt&_nc_oc=Adr5VQGVgC_O6tfMLHJMYdIwJ_uPYilSyTBkMi6B6SHzpK3LyNXNjbJE9IvVAdDgcl0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQOPswkyXLw5aPMgz9TP_jdhOXG13tH7ZSwqtD6geMltg&oe=6B0B1CEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24MkzUOPR7AQ7kNvwHM_tMz&_nc_oc=AdqGgI-1ky_G4xSmcgB4PbKoPFrEuzNarNZhy9T1QlZqwrpDl87citb9j7hPuc6MA8w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAFsP7-LaPXT5v_Ehdp9_w_KIeA60aLfExRAP6QDaKqA&oe=6B0B21EC"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9oftzLENDUQ7kNvwF4ug67&_nc_oc=AdqcOXqa0dzoPAQ7mQ1eNGoKcDeyfBFqPTxths6WgsjsGDhuIIp2vYfhS_ldn43LF6E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRifQ0oxxSDu5JrL7wl3zpnqrue521ZYKjgmJBMFCiy8Q&oe=6B0B1212"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juJGPRWrhGkQ7kNvwFcDsUV&_nc_oc=Ado51gLG4-ZJVjIU4AQljinB-NWcA77MbW2a49MlR-QMP6bdT1bsUza4VskMHtO6shc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss
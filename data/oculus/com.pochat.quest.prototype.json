4.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJScFtNv-98Q7kNvwHJzbE5&_nc_oc=AdpuAEZGMX3wlbMTRhXyuEL19MEWspWH8Xa1feHbRSOdTMNGDr9_IX9xA4aqUhPDoKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmSwvaGpMZi4WWwXKlWQ5shdCohGipJ-r2wHrDlzQpOg&oe=6AF72F69"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exWjIv2vHWUQ7kNvwF6QoOl&_nc_oc=Adp_akavSGvUxVWY1ePAglxJk4lDnwC-q-QVy8hjfG_Wo9J9bhAS5uWKAKmCt8E3sxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZeqEoGem9UxM-sb0T3wvLP2NjxCvihbzzfr1oQqNaxw&oe=6AF71E2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGAk0qbqzMoQ7kNvwFWPwMX&_nc_oc=AdqH-4nEfDW0bC6tSvfrW0YPz21bee6FXEtTP6NYGjU7nVdXAVn2-FComhEwT3qvfok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHstdFr91tG7vYoHXcTBnnwBn629KlYB0AVpl74uOFhw&oe=6AF7232C"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx00jkkNIsQQ7kNvwHMO8Qs&_nc_oc=AdqPVx7JHEmuPQL4oV7FeLdH7eCjKyIw_oLk0NMhs-ocaeEIAzLRvpE147urG4QNm_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3gqSoWxp7O7h8GDZxpmI2qN8Lwqp3XypuTwkusLRuBA&oe=6AF74B92"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMgseCwWdxwQ7kNvwEVJgUx&_nc_oc=AdrWhuqLy-RPGclO3AZgGuS3Y0aiJnPdKg3lPWnp5vu_oanlGrs71s9stgADxLgzXIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmbbPo7iAzZByYqcBU-imNvfr-ehD0KKIc8kOGCbxnzA&oe=6AF73A17"}, {"file_name": "background-512x512.png", "id": "2126344877981813", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623512_2126344881315146_4947547688862397006_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7y5OpYpdsMQ7kNvwHQZARt&_nc_oc=AdrHvm0LsTKpMLNVZn_3KqrhEiVik40sbJEuHlzwE65buRdVozpEQksAFmJN6XfnRHI&_
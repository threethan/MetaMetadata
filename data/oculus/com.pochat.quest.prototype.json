6XGyJisK-Fc80uiZapOfxAj7AmCuhJq16ajac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXszyj_NLTvvfBX_CkZPq9cn_cv08kGJxk3WxDhIxLMTQ&oe=6B1054BB"}, {"file_name": "858304537_29837295469191797_4388193426456345984_n.png", "id": "1667358748419421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Svk3CQR8cAQ7kNvwEJnmQ9&_nc_oc=AdqlenfOFRkxQk8OCKrRlCO2Uqz-lnIdh3dlsFSO4T4xxsRFgYdVxiB03gAf5UajkHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUfugFm32elT3ZuqyNoVyHgr7E4zseyDpwCTvIHEBwT7Q&oe=6B103BE9"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZJ6zSxo6R8Q7kNvwFyx377&_nc_oc=AdpvQEbi_sIlitheLNP8TQKmmo8SPQBn4I5sl1HhetJ19HyAiSJ5WE-QIiFTiI5BQyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwYo82MGo7GUwshRSQOYi6nO1STR_CFAypZ7BTLCcf9A&oe=6B1062EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WornLd4N8yoQ7kNvwHOYpLm&_nc_oc=Adponifovif5rZKNYSiC2Hq_yB_MNPRO6w4q3KHJ4ozBIQhRwqwQiX-tfnA_9J_Ybnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXK2k2vutJuMAyXtRvo4tAWSybBcUOeY1QweILqRIghhQ&oe=6B1067EC"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzDeAs3dGvsQ7kNvwEWkRxG&_nc_oc=AdpCCUSMYe-f9WspA2vDn-_204Or5C4KaA_3Ok6oT45ONNGHk1WEUbmyd0iZ9Cnbxoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX4ZTDvP9DgIiq-Ho_iSxa4jkY3PNMKZ__Px4ucM0LMtQ&oe=6B105812"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSeFpF2oj-YQ7kNvwHjAfuW&_nc_oc=Adp5_XTDX8T3rCcdMU-mGlaLajAL323bGX9Gw7ZbMdfyxUR4yJszwK5oNjONsBhG9kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss
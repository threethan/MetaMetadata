sD2iPe2UgJuX2xHsDTQ4mUey4YHn9UNt9x-Rw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVIL0UJvCDXrf57XxH4WT1W7SflCjV1azfIqKAdI5sdA&oe=6AFC8E3B"}, {"file_name": "858304537_29837295469191797_4388193426456345984_n.png", "id": "1667358748419421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgBpQH3YyBEQ7kNvwGnMajr&_nc_oc=Adr8wF4zY6auboN0rYl0isoq6mRdeMaffQLDB8Rmgc182fpsmkZ7xlh0Kg_IPnu22RA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFoHW0Oy-UX_L6MduksbcNB76DAvfvIMAWK7jQtrjjtA&oe=6AFC7569"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkiamRXFcacQ7kNvwHMwXbE&_nc_oc=Adq9focFlgKMf7VWvRM9lRJjKehLx6YZPx8i8DfL3U9Z_PHkkaIP3rsVgoT8xsEkKyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVBuKBzOsk6S_bRuhlU-rqh6_T2zFjSL66fDz_svf0TA&oe=6AFC642E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85POODwWN6UQ7kNvwE1tyQa&_nc_oc=Adoca_uaHZp18V4JfyB9tT4e-8jRrOvzZCPHPdYsfMTAyQ7lAzzPioZJd982p87yiqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQk3lgEJ5cR6KKgSAqjGc0-MJrTv7EFqsNkzFEtZt3IQ&oe=6AFC692C"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5r8WkaVbNoQ7kNvwHQM3XH&_nc_oc=Adp94sQYtJeTSzxE_sSU6MzxUUV9oJd3WDLtuFNSr6yI2or-vp0wlRl32SKBF2Mami4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqROpftVy8d7rPI8MylLZRlfczd-HitEyym4mnkGxOyg&oe=6AFC9192"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEldZccs3pIQ7kNvwElyrg_&_nc_oc=AdqaU47S4q36JVHfAyiYaSVI2m53O2E9GqSaCoyqhlGKMIKJvN2s1VdhhynhpBMX5vQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss
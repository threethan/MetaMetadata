ttps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312369_1260473266168166_5414062746124603199_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xbb0suTGY4Q7kNvwHYy02E&_nc_oc=AdpX2VVSEsSPhKIQw6uYx1wotVvJqT5gZvuNaA_9kH_ZoLuM0gfktYKuX7-APJClZuQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xj-I-4nHSOTmoNupthwgud5ikvEa2GnHRd4piUsVjvw&oe=6A314D8D"}, {"file_name": "1.png", "id": "1001252065566718", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307352_1001252068900051_1592046074941075571_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-1o_I8UEBcQ7kNvwH3yWXn&_nc_oc=AdpQQw8NvWyvnPDgZyEtaWMxoyPZNbHgKif8VyBcwWdX5ui6Wmu0K0K-SDYFr4n3rBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AAfSsjpScPrqTiwMXMUR_E1dgDe9tnU0W6yxhJpPhbQ&oe=6A314901"}, {"file_name": "2.png", "id": "1670731170913068", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312454_1670731174246401_6604719355597145101_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wymr1YXN0KIQ7kNvwGI-jtb&_nc_oc=AdoYWyN5GiBUhGir05h0XRRc8rZzhGbV3vaBfVjurm5dWgxnmA8IgPf2qaxVJPRN-b4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OTcrT55cjvVKmP-NzKVkp2EFpBpV3-35eyw8Yhbli7A&oe=6A316D6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fruit Ninja VR: Ghostbusters", "keywords": ["Fruitninja", "fruitslicinggame", "ninjafruitgame", "fruitcuttinggame", "arcadeslicinggame"], "long_description": "Fruit Ninja VR: Ghostbusters is a fast-paced VR arcade action game that combines classic fruit-slicing gameplay with supernatural ghost-hunting chaos in an immersive virtual reality world.\n\nStep into the role of a high-tech ninja exorcist equipped with proton-powered blades and advanced VR motion controls. Your mission is simple: slice everything in your path. Chop flying fruit with precision, unleash combo streaks, and battle waves of paranormal entities invading haunted locations.\n\nFrom glowing fruit storms to terrifying ghost swarms, every level challenges your reflexes, accuracy, and speed. Use your VR controllers to swing, slash, and perform powerful combo attacks while dodging cursed objects and dangerous spectral traps.\n\nFace increasingly difficult waves of enemies, including powerful boss ghosts that require timing, strategy, and skill to defeat. Team up with friends in co-op mode or test your endurance in endless survival challenges.\n\nKey Features:\nImmersive VR motion-based slicing gameplay\nClassic fruit-slicing action combined with ghost battles\nFast-paced arcade combat and combo scoring system\nParanormal boss fights with unique attack patterns\nHaunted environments and cinematic effects\nCo-op multiplayer and survival modes\nSmooth, responsive VR controls for full immersion\n\nWhether you\u2019re slicing fruit at lightning speed or fighting off waves of angry spirits, Fruit Ninja VR: Ghostbusters delivers an intense, energetic VR experience built for action lovers and arcade", "short_description": "Fruit Ninja VR: Ghostbusters is a fast-paced VR arcade game where you slice fruit and battle ghosts in motion-based combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fun-soft/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Fun Soft", "support_website_url": null, "website_url": "https://sites.google.com/view/fun-soft/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
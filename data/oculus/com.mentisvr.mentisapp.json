ntent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7PC4vuq7UqfyXia5D1vNBmcK-WcLXlvQ0nTObfiissA&oe=6A8045F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mHub Landscape 2560x1440.png", "id": "1186790353374038", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824292_1186790356707371_5842390336773049075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7m88CQDhHEcQ7kNvwFb3dMC&_nc_oc=AdrnCd-zn_IjjxNhNEoninrd41f_cUO4ipLFZeE_W7Vbjwc8OkYbVOZ3utENHBoxW2I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEecEeJVz-rBoxfSz97lp76zxKci9517-nbhrtR63_Hhw&oe=6A805CFC"}, "display_name": "mHub Pro", "keywords": ["sports", "mhub", "vkeepr", "speedpad", "vplayr"], "long_description": "At MentisVR, we are redefining how athletes train their minds.\nWe developed mHub, a cutting-edge virtual reality platform where players and goalkeepers can enhance their cognitive performance \u2014 the invisible side of the game that separates good players from the truly elite.\nmHub is a science-based training environment designed to sharpen perception, decision-making, and reaction speedthrough immersive, sport-specific exercises. Inside this virtual space, players experience realistic game situations that challenge the brain\u2019s ability to anticipate, adapt, and respond under pressure. Every drill targets the cognitive processes that underpin top-level performance \u2014 such as attention, spatial awareness, working memory, and game intelligence.\nModern football is faster, more tactical, and more demanding than ever. Physical fitness and technical skill are no longer enough. What defines the elite is their football IQ \u2014 the ability to read the game, predict actions before they happen, and make the right decisions in fractions of a second.\nThat\u2019s where mHub comes in. By training the brain just like the body, players gain a competitive edge that translates directly onto the pitch. They learn to process information faster, stay composed under pressure, and make smarter, more instinctive choices.", "short_description": "At MentisVR, we are redefining how athletes train their minds.\nWe created mHub, a science-based virtual reality platform where players and goalkeepers enhance their cognitive performance \u2014 the invisible side of the game that separates good from elite.\nThrough immersive, sport-specific exercises, mHub sharpens decision-making, perception, and reaction speed, training the brain just like the body. Train your brain. Elevate your game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1n07ENdQIgiPH5NqPp4hAD8DoqYtJVH5O/view", "developer_terms_of_service_url": null, "publisher_name": "MentisVR", "support_website_url": null, "website_url": "https://mentis-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28253141994277672"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1117314763725867"}]}, "baseline_offer": {"id": "1117314763725867"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785410880, "status": "PUBLISHED", "id": "1117314763725867"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28253207904271081", "version": "1.0.7"}, "id": "1025158442928624", "channel_name": "LIVE"}]}, "is_fo
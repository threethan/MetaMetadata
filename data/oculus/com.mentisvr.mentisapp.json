1-25/491820428_1489836315625024_2812837844146980197_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QhTP8ZPZoAQ7kNvwHewB8C&_nc_oc=AdpoMU2GtNVGxDUDlSWUr4J5ujrDpt9081Q-8k4WXsBJEmBHn7D1qnVKNja1EjYGVsw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIYhzyPSB69GXETFstszL98QtUfr1EnnJ8_wDQ5Ge1og&oe=6A8065F5"}, {"file_name": "7_2560x1440.png", "id": "25120005690949389", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_25120005714282720_1661632867461320970_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_J-yDQsdl0Q7kNvwE32Xkn&_nc_oc=Adon-3NSdesy4L9FsaPYCX59wd6lNCCsn-El4zKXFgX3dmmg6IIdyYbGcVEfxv1EhMo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7PC4vuq7UqfyXia5D1vNBmcK-WcLXlvQ0nTObfiissA&oe=6A8045F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mHub Landscape 2560x1440.png", "id": "1186790353374038", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824292_1186790356707371_5842390336773049075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7m88CQDhHEcQ7kNvwFb3dMC&_nc_oc=AdrnCd-zn_IjjxNhNEoninrd41f_cUO4ipLFZeE_W7Vbjwc8OkYbVOZ3utENHBoxW2I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEecEeJVz-rBoxfSz97lp76zxKci9517-nbhrtR63_Hhw&oe=6A805CFC"}, "display_name": "mHub Pro", "keywords": ["sports", "mhub", "vkeepr", "speedpad", "vplayr"], "long_description": "At MentisVR, we are redefining how athletes train their minds.\nWe developed mHub, a cutting-edge virtual reality platform where players and goalkeepers can enhance their cognitive performance \u2014 the invisible side of the game that separates good players from the truly elite.\nmHub is a science-based training environment designed to sharpen perception, decision-making, and reaction speedthrough immersive, sport-specific exercises. Inside this virtual space, players experience realistic game situations that challenge the brain\u2019s ability to anticipate, adapt, and respond under pressure. Every drill targets the cognitive processes that underpin top-level performance \u2014 such as attention, spatial awareness, working memory, and game intelligence.\nModern football is faster, more tactical, and more demanding than ever. Physical fitness and technical skill are no longer enough. What defines the elite is their football IQ \u2014 the ability to read the game, predict actions before they happen, and make the right decisions in fractions of a second.\nThat\u2019s where mHub comes in. By training the brain just like the body, players gain a competitive edge that translates directly onto the pitch. They learn to process information faster, stay composed under pressure, and make smarter, more instinctive choices.", "short_description": "At MentisVR, we are redefining how athletes train their minds.\nWe created mHub, a science-based virtual reality platform where players and goalkeepers enhance their cognitive performance \u2014 the invisible side of the game that separates good from elite.\nThrough immersive, sport-specific exercises, mHub sharpens decision-making, perception, and reaction speed, training the brain just like the body. Train your brain. Elevate your game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1n07ENdQIgiPH5NqPp4hAD8DoqYtJVH5O/view", "developer_terms_of_service_url": null, "publisher_name": "MentisVR", "support_website_url": null, "website_url": "https://mentis-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28253141994277672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824328_607714992363992_2257584102970606268_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COocRIeTJvsQ7kNvwHKsnpr&_nc_oc=AdqOCkg0_P2_iXSK_BePl1omTtY6CU7DT6WrUZgubUl_pVYwVl9fdsSbAozECDYLUjE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6LlNgfBjUPj0jW5uJHpfr6Np9hf7NFb0Z-o9B1cGraA&oe=6A804ACE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "mHub Pro", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1785410880, "lastRevision": {"nodes": [{"id": "24199817242943521", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24199817209610191", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1120191293202309"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "mHub Landscape 2560x1440.png", "id": "3761850710616253", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822550_3761850717282919_682528056179388432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edroecjQvrkQ7kNvwHIl8Cx&_nc_oc=AdqwqRXw3q23E9nHE9vUuLTv60qGJZ6U2wkoRwXl84mEWCuaBRoUPuMeNreNgwlGzrE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL8lDx09vWpAeD7EosLWU9_C-tI37dvz_wUSrw3bUU0Q&oe=6A80535E"}, {"file_name": "mHub Portrait 1008x1440.png", "id": "1263387035509214", "image_type": "APP_IMG_
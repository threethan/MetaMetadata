ontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSuoTh6Uu1SPVQ3gD-pX8hI95lxD8ccCyYiY8suT68qg&oe=6B05B82A"}, {"file_name": "4.png", "id": "1334968048388166", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619646_1334968051721499_6215324787027372589_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCFxOvFDswIQ7kNvwEvWrH-&_nc_oc=AdoDVgyb7ozCixiTFP7nna7X17ewU5KnVgZ9qb_8KTPTTmLkv7uGQ7jD1QOUaf8vIXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8DVNXdskLyvwxRLY3U219vd-LmOm_bsJpY7qfNvNTRw&oe=6B05C291"}, {"file_name": "5.png", "id": "1966722484020720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1966722487354053_767883963221629111_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjjPxHuEKoIQ7kNvwHJVjFZ&_nc_oc=AdpO_pr0nF6wiZOo3ooyt_cNAnw3fUbgE5p3pEQqqzYglKVbfRyCRhzm9W3PiNrL7IE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcyS8h76v3xDhRlK7iJ7qxc58N0uFVuyZpGEV-Tr-J-g&oe=6B05D1BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "954036937539032", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619159_954036940872365_5926337999884296473_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3pEYpUTZG8Q7kNvwGf_vFl&_nc_oc=Adr_MaJqKitYZGyEqnoZEwjMt4lGiQQKpBgdAYif3VgXeWpgrdhdtVEDEbiTyzGcxCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqElD-9leq5cJnAyi8p8aKa8Si47V6U_WyivWPQkuj9Q&oe=6B05CD06"}, "display_name": "Flappy Ball VR", "keywords": ["flappy"], "long_description": "Dive into the ultimate arcade experience with Flappy Ball VR, a challenge that\u2019s easy to learn but hard to master. Control a floating sphere through a world full of dynamic obstacles and put your reflexes to the test as you keep moving forward. Each round is fast, intense, and addictive\u2014perfect for short sessions or competing with friends for the highest score.\n\nFeel the immersion of mixed reality as you dodge columns, with polished physics and a vibrant environment that will keep you on the edge of your seat. Can you beat your own record and become the master of endless endurance? Discover it in Flappy Ball VR and show off your skills!", "short_description": "Pon a prueba tus reflejos y concentraci\u00f3n en un desaf\u00edo de realidad mixta donde cada movimiento cuenta. Esquiva obst\u00e1culos en un mundo vibrante y descubre hasta d\u00f3nde puedes llegar en la experiencia arcade m\u00e1s adictiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Xjao0UImbqlv_-pJ8Kq1JoQmZh85Nrqj7wPPFMIrjPo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/flappy-ball-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25579063285036795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_894401340003365_7624504270911390072_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p50Ov7wc-QgQ7kNvwGPbYJk&_nc_oc=AdrAWjk7RrvAFvtuBMU8GVWrR_W6ZkmgBMoAklAUM0rxTCKJB1fyvEx5EOYMeuK1G-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7
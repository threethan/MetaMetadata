=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1glD8oPQPQQ7kNvwEl95WS&_nc_oc=AdrBI0eoogEB5bffktN8DJuqBVmhyiRZjGn9-qVOnLISKmjO8X1sUT0YnzYJXk-H0gc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhTFcDbVUayWAa66ZCYiML8ZvgVm1e0JTNmneeX1J-gg&oe=6A9ACFFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "954036937539032", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_954036940872365_5926337999884296473_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyxVyFdv8dwQ7kNvwEj45OO&_nc_oc=AdrMXiWzvZgl_rluhaVbFrSwS1rmJe0lw5oYtEQ10zkPoXcRZ5GhDKphASWKwXmFMJ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8I1_nHDcHKpUaq4-qUqfvXW7T02DxAcC1EXed4oBAhQ&oe=6A9ACB46"}, "display_name": "Flappy Ball VR", "keywords": ["flappy"], "long_description": "Dive into the ultimate arcade experience with Flappy Ball VR, a challenge that\u2019s easy to learn but hard to master. Control a floating sphere through a world full of dynamic obstacles and put your reflexes to the test as you keep moving forward. Each round is fast, intense, and addictive\u2014perfect for short sessions or competing with friends for the highest score.\n\nFeel the immersion of mixed reality as you dodge columns, with polished physics and a vibrant environment that will keep you on the edge of your seat. Can you beat your own record and become the master of endless endurance? Discover it in Flappy Ball VR and show off your skills!", "short_description": "Pon a prueba tus reflejos y concentraci\u00f3n en un desaf\u00edo de realidad mixta donde cada movimiento cuenta. Esquiva obst\u00e1culos en un mundo vibrante y descubre hasta d\u00f3nde puedes llegar en la experiencia arcade m\u00e1s adictiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Xjao0UImbqlv_-pJ8Kq1JoQmZh85Nrqj7wPPFMIrjPo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer"
Bc4G3pBoYHLg&oe=6AC9132A"}, {"file_name": "4.png", "id": "1334968048388166", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619646_1334968051721499_6215324787027372589_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8X88z1ljikQ7kNvwGlIvyt&_nc_oc=AdrIM4dnRsTFb1d4RhuxYOmEJQmXaAKAyJ0FwggEidYQEaEjqgy9h8ssTWAYGtbq9wU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFrs2xjbbw9UQftlzPPc_lJuI08As3nJwQGuctqHHroA&oe=6AC8E551"}, {"file_name": "5.png", "id": "1966722484020720", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828028_1966722487354053_767883963221629111_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLG96RN70iAQ7kNvwHPwiCw&_nc_oc=AdrDwspBadVgdJ7tyggWxXkrcEpzd0SxE1jPVrPg2VxTDW7ZCcfK5AnG04cxCYcdD7I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXHkoYCJsFiDSjaZjcl06lEXJC4QyEU4ywXALD9sN1-A&oe=6AC8F47A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy Ball VR", "keywords": ["flappy"], "long_description": "Dive into the ultimate arcade experience with Flappy Ball VR, a challenge that\u2019s easy to learn but hard to master. Control a floating sphere through a world full of dynamic obstacles and put your reflexes to the test as you keep moving forward. Each round is fast, intense, and addictive\u2014perfect for short sessions or competing with friends for the highest score.\n\nFeel the immersion of mixed reality as you dodge columns, with polished physics and a vibrant environment that will keep you on the edge of your seat. Can you beat your own record and become the master of endless endurance? Discover it in Flappy Ball VR and show off your skills!", "short_description": "Pon a prueba tus reflejos y concentraci\u00f3n en un desaf\u00edo de realidad mixta donde cada movimiento cuenta. Esquiva obst\u00e1culos en un mundo vibrante y descubre hasta d\u00f3nde puedes llegar en la experiencia arcade m\u00e1s adictiva."}]}, "developer_name": null, "developer_privacy_p
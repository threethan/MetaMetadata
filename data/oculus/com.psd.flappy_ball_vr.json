om&_nc_ss=7f20f&oh=00_AQGqnY3DuYsDJHq36s0jtkfqdLh5ixslO82RKoOdahEHIg&oe=6A7C6E51"}, {"file_name": "5.png", "id": "1966722484020720", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828028_1966722487354053_767883963221629111_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylbHztaVwpUQ7kNvwFENTfO&_nc_oc=AdqWl4_Vnzg27xxPjaoNSRiWz2ViRQRaXryUQ0xmGNuE1CD2gENdocWxTH5giybRgqQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgWn0-ssz6WuD8rsH5LV6QwryqB4xYk5llis_15ZNqUg&oe=6A7C453A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy Ball VR", "keywords": ["flappy"], "long_description": "Dive into the ultimate arcade experience with Flappy Ball VR, a challenge that\u2019s easy to learn but hard to master. Control a floating sphere through a world full of dynamic obstacles and put your reflexes to the test as you keep moving forward. Each round is fast, intense, and addictive\u2014perfect for short sessions or competing with friends for the highest score.\n\nFeel the immersion of mixed reality as you dodge columns, with polished physics and a vibrant environment that will keep you on the edge of your seat. Can you beat your own record and become the master of endless endurance? Discover it in Flappy Ball VR and show off your skills!", "short_description": "Pon a prueba tus reflejos y concentraci\u00f3n en un desaf\u00edo de realidad mixta donde cada movimiento cuenta. Esquiva obst\u00e1culos en un mundo vibrante y descubre hasta d\u00f3nde puedes llegar en la experiencia arcade m\u00e1s adictiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Xjao0UImbqlv_-pJ8Kq1JoQmZh85Nrqj7wPPFMIrjPo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/flappy-ball-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "c
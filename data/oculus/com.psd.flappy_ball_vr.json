ontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iJqUr6GAed1Waqgkyu0B14CHcJRdl9NiVSE4f1TY2uw&oe=69DE2FEA"}, {"file_name": "4.png", "id": "1334968048388166", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619646_1334968051721499_6215324787027372589_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM25G-C7c-AQ7kNvwHKebtu&_nc_oc=Adp2ULXsEki5OdEieQThU1afP89dTV-kINw02DSRaEB8KFGjJneSfrjqlXoTOlUTKpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2d4E-plMifht9JuayjDhGQR-76FFaxeSpotHmbHwyLzQ&oe=69DE3A51"}, {"file_name": "5.png", "id": "1966722484020720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828028_1966722487354053_767883963221629111_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SF5P-WeBc34Q7kNvwEF_Gc8&_nc_oc=AdpnXXdwtEnfREaWleFZD0wtmU-0QLuuXIHm5GCbLHTUr8JpR6i1AUr7jBYCrCQpJhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OTcNz0pCZgyBcHX02b2Ost1Tcm_fO4gQmRp9xOMvosQ&oe=69DE497A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy Ball VR", "keywords": ["flappy"], "long_description": "Dive into the ultimate arcade experience with Flappy Ball VR, a challenge that\u2019s easy to learn but hard to master. Control a floating sphere through a world full of dynamic obstacles and put your reflexes to the test as you keep moving forward. Each round is fast, intense, and addictive\u2014perfect for short sessions or competing with friends for the highest score.\n\nFeel the immersion of mixed reality as you dodge columns, with polished physics and a vibrant environment that will keep you on the edge of your seat. Can you beat your own record and become the master of endless endurance? Discover it in Flappy Ball VR and show off your skills!", "short_description": "Pon a prueba tus reflejos y concentraci\u00f3n en un desaf\u00edo de realidad mixta donde cada movimiento cuenta. Esquiva obst\u00e1culos en un mundo vibrante y descubre hasta d\u00f3nde puedes llegar en la experiencia arcade m\u00e1s adictiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Xjao0UImbqlv_-pJ8Kq1JoQmZh85Nrqj7wPPFMIrjPo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/flappy-ball-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24757470710529394"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "936860502409939"}, {"status": "PUBLISHED", "id": "2077195692820825"}]}, "baseline_offer": {"id": "936860502409939"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775222820, "status": "PUBLISHED", "id": "936860502409939"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24789015910708207", "version": "1.2.0"}, "id": "1543563443366448", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24757470613862737", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24789015910708207"}, "release_status": "RELEASED"}, "binary_release_channels
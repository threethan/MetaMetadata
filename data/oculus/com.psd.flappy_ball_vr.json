&_nc_ss=7f20f&oh=00_AQIbPxqgCgDfT4plQGNUdwdmsZW9803U5CUG8PTyka2Q1Q&oe=6AB67051"}, {"file_name": "5.png", "id": "1966722484020720", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_1966722487354053_767883963221629111_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3HCr20fbGAQ7kNvwFqnUF9&_nc_oc=Ado-bZSxeBAIxPbyv4kmjG_-UcEBiebjiy2SRRfdHJlEkYEiAbgQjOz7rdb_kQCQclQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJULMUj4s7l4BTYxmunyE1oKHfN1BkXDV77OdfdV23Sjw&oe=6AB67F7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "954036937539032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619159_954036940872365_5926337999884296473_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQk4cF5DMUwQ7kNvwEtLoN5&_nc_oc=AdqfKgoYzJ-cTJYnFRZ3Na3-mOG2dTJ7h2t4DSmAHa3TScCUR4p1WZKMrtLo04Q1Cgg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3_LMwlBXa_r9qxwZdHt3UNq-OYKsGVBjDOEEC2AlLYA&oe=6AB67AC6"}, "display_name": "Flappy Ball VR", "keywords": ["flappy"], "long_description": "Dive into the ultimate arcade experience with Flappy Ball VR, a challenge that\u2019s easy to learn but hard to master. Control a floating sphere through a world full of dynamic obstacles and put your reflexes to the test as you keep moving forward. Each round is fast, intense, and addictive\u2014perfect for short sessions or competing with friends for the highest score.\n\nFeel the immersion of mixed reality as you dodge columns, with polished physics and a vibrant environment that will keep you on the edge of your seat. Can you beat your own record and become the master of endless endurance? Discover it in Flappy Ball VR and show off your skills!", "short_description": "Pon a prueba tus reflejos y concentraci\u00f3n en un desaf\u00edo de realidad mixta donde cada movimiento cuenta. Esquiva obst\u00e1culos en un mundo vibrante y descubre hasta d\u00f3nde puedes llegar en la experiencia arcade m\u00e1s adictiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Xjao0UImbqlv_-pJ8Kq1JoQmZh85Nrqj7wPPFMIrjPo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/flappy-ball-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25579063285036795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307311_894401340003365_7624504270911390072_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bLzU3qbgesQ7kNvwEpCZ73&_nc_oc=AdoTxyJez6reCB4XGjr6cLxT9qHMe9Ku72GMwcj-Or_8enld2s0ViM6uB6FzFRJb_sA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAUBmhjdCiqqT6By2_7RJWzrRw-6XiIDVuAyp-K-B99Q&oe=6AB69878"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flappy Ball VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1770747360, "lastRevision": {"nodes": [{"id": "24757470767196055", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_
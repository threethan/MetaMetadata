&_nc_ss=7f20f&oh=00_AQOOayui9V2IPTbcA14mYCzunadXVg2QQkfIeO4Kg9quNw&oe=6AC64251"}, {"file_name": "5.png", "id": "1966722484020720", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828028_1966722487354053_767883963221629111_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ETT51tt4JIQ7kNvwE0RsGY&_nc_oc=AdrTpjbg3MaVyXqTCzhGomsRDi87y_z1OuBMudLpM2y-eMS3w4AQmEd30n9dUye4RoQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUnCscO6f1PR20-7ld9I6Py8IjL9Z3F4UtnPkWpAMu1g&oe=6AC6517A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "954036937539032", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_954036940872365_5926337999884296473_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPk6TpA7yWMQ7kNvwElGsLU&_nc_oc=AdoNb5hzcOuT7RR_zX78uSVRlft-pcm9YHS-Xso4wwg3aDToj_03FKmYy8j3aT8LQiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6kW-5XVPv7g1NtXWLjJYR2-wr3-tzJNVTXTf7rvK57g&oe=6AC64CC6"}, "display_name": "Flappy Ball VR", "keywords": ["flappy"], "long_description": "Dive into the ultimate arcade experience with Flappy Ball VR, a challenge that\u2019s easy to learn but hard to master. Control a floating sphere through a world full of dynamic obstacles and put your reflexes to the test as you keep moving forward. Each round is fast, intense, and addictive\u2014perfect for short sessions or competing with friends for the highest score.\n\nFeel the immersion of mixed reality as you dodge columns, with polished physics and a vibrant environment that will keep you on the edge of your seat. Can you beat your own record and become the master of endless endurance? Discover it in Flappy Ball VR and show off your skills!", "short_description": "Pon a prueba tus reflejos y concentraci\u00f3n en un desaf\u00edo de realidad mixta donde cada movimiento cuenta. Esquiva obst\u00e1culos en un mundo vibrante y descubre hasta d\u00f3nde puedes llegar en la experiencia arcade m\u00e1s adictiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Xjao0UImbqlv_-pJ8Kq1JoQmZh85Nrqj7wPPFMIrjPo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/flappy-ball-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25579063285036795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_894401340003365_7624504270911390072_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9JyRsAqqjsQ7kNvwGqh7IR&_nc_oc=Adp2eNhJF7tnXn82hSu-9cGSwyKG91r3t5Htz5kmmQYDCOyTZTPSCk5fu06Gif7hUAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1Y54d_4ZydIKxvzsu8hcWDCw1C3SFWYVASDPBZbn2ig&oe=6AC66A78"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flappy Ball VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1770747360, "lastRevision": {"nodes": [{"id": "24757470767196055", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_
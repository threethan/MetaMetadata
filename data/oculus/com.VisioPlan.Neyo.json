1883_683782470713971_6697760083143168381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wBd4UH3DkgQ7kNvwEPomSL&_nc_oc=AdpWrQItDn3IvPH2LIOqVFPf5Hauxl3Fx1G2vA2r5V7_N0pS9TeaHeI6ycYGZm2hi9g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ6Re2Ptcf7ozYccCysMB_v22ixlyQIYIJAQN1dGJDhA&oe=6A8ED895"}, {"file_name": "outside_art6.png", "id": "1418731629489277", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393444_1418731632822610_4553946260192839708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOG_-c6hKvQQ7kNvwEoKryH&_nc_oc=AdpQskt1GzKJh0r0iKrhcx2vaB2P5sIIlQSpl1MRhPqDqqaqmYv9_tHWDwbUgqbDwGY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHjkzXjvpdeoIdugwTQTBql2Ff0hXA5LUtjT0lBx1COQ&oe=6A8ED8A9"}, {"file_name": "Art6_kitchen.png", "id": "8810995482336524", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391911_8810995489003190_3481627969198699272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GC9vVW5_rIQ7kNvwEA0CyH&_nc_oc=Adof1hgVW6ysPc3qnSgPpfZ50QHiec_VKznD_22tdlyNsDj-kijsnkUqocNL2pcT-88&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY8QfecV8fImM69IxrIZbcfZ4AG-w_XMMoWTokCLsXFQ&oe=6A8EE462"}, {"file_name": "outside_schaller.png", "id": "645468378314980", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473402211_645468381648313_124640857118417874_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEXvmd_7RyYQ7kNvwE_Mcd5&_nc_oc=AdoLureCZqZ-NCS9tfvml0cq9Xkp0jNFuzI7qqcu2ANXUn6C-BLu7hOG9xbUDKvE8Ck&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYudx0s_K9vyp5MQ9_QYy8yJDH3g99COhpDZTYDfm5UQ&oe=6A8EF610"}, {"file_name": "bathroom_schaller.png", "id": "660485266909923", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391911_660485270243256_4703071978444780768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRgZSJ685iIQ7kNvwHe72m1&_nc_oc=AdrxPsGZLRCuBa95fds68mUHTH-WLnsqErLks7pJh8q67C8mfrpAPWdfY6iem1OwtIY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVcvMGj673nD4gZ4Osx2bQs_Wka8w_q7uNXO88EvoM-g&oe=6A8EC175"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neyo", "keywords": ["Architecture", "floorplan", "Home", "Walkthrough", "House"], "long_description": "\ud83c\udfe1 Neyo \u2013 Explore Prefabricated Homes\n\nWith Neyo, architecture becomes a walkable experience before construction begins. Step inside fully furnished prefab houses from top German manufacturers \u2013 realistic, intuitive, immersive.\n\n\ud83d\udeb6\u200d\u2642\ufe0f What to Expect:\n> Virtual walkthroughs of real 3D floorplans\n> Highly realistic interiors with premium design\n> Free navigation through every room\n> Switch between house models\n> Compare layouts, styles, and finishes\n\n\ud83c\udfaf Our Mission:\nTo make building visualization and virtual home experiences accessible, intuitive, and visually compelling for everyone.\n\n\ud83d\udea7 In Development:\nNeyo is becoming a full-featured VR platform for home planning. \n\nUpcoming features:\n> More homes and architectural styles\n> Interactive interiors: change furnitur, materials\n> Explore gardens, terraces, and driveways\n> Leave feedback directly in VR\n> Contact prefab manufacturers\n> Upload your own floor plan and walk through it\n> Create your own 3D renderings\n\n\ud83d\udc65 Who It's For:\n\n> Future homeowners comparing designs and layouts\n> Manufacturers showcasing models with immersive tools\n> Architects and planners using 3D walkthroughs\n> Anyone curious about VR home tours and digital architecture\n\n--\nNeyo by VisioPlan Solutions", "short_description": "Neyo \u2013 Explore Prefabricated Homes\n\nWith Neyo, you walk through fully furnished prefabricated houses in stunning detail. Move freely, switch between models, and experience architecture in a new, accessible way. Whether you're planning a home, love design, or just want to explore \u2013 this is where virtual and real spaces meet.\n"}]}, "developer_nam
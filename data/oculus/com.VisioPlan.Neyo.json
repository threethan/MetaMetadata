1883_683782470713971_6697760083143168381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7trsI3JVmkQ7kNvwG0lRVf&_nc_oc=Adqa6NNM7zE1B-m9j4hjN5l8NFAB5HTVy3LjZxd-JvKJ1gGD2jfIKFsGvMKdP94hn1k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH01w_qFiwcEeZ1vrryvQq_JR3JheskMrYsbntYrEtZjA&oe=6A859E15"}, {"file_name": "outside_art6.png", "id": "1418731629489277", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393444_1418731632822610_4553946260192839708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai6oDA4tKrYQ7kNvwGGTz96&_nc_oc=Adp_nyffErw6ueuik6Ej0AjN40WmRLhxmbhBsxtPgREatKehZ4K9OYjGBkaSVNehDfo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5klVt2Xfhreo5z7sTAJb-yyDcP-xtJfCQcxh5RgZeyQ&oe=6A859E29"}, {"file_name": "Art6_kitchen.png", "id": "8810995482336524", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391911_8810995489003190_3481627969198699272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr6xlcWdVW8Q7kNvwGEsiFY&_nc_oc=Adr1XXeRiP7pcbQH01IzWsfmwdj6D_l1WooiTsgt4VEmItYH6beorGfnn0omaj_JwTY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9iM_CNUCUZKFQGDlpBHSiHH8r9bVXvT_VK32kxmV4fA&oe=6A85A9E2"}, {"file_name": "outside_schaller.png", "id": "645468378314980", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473402211_645468381648313_124640857118417874_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_IVObC_zswQ7kNvwFXIQlI&_nc_oc=AdqULq7VQXRRONl3n_s36r0rRrBNbLCPRYnOskTCT2Mm9xOrpdBLrZyUKIR0OTz3mD4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH87D_CHeTNZxrNDePTh6uxIv2ILEzE7MwqFmCzpIyt0g&oe=6A858350"}, {"file_name": "bathroom_schaller.png", "id": "660485266909923", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391911_660485270243256_4703071978444780768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0N4gK3pppgQ7kNvwFokG_9&_nc_oc=AdozuGMmJ-JPdU9TYDIGmPYq2CuGLccUbD3ywMHef8TgspvaAyu1tZt4vhL8PAY3xP8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQOLPSIO1ZUTCOj9c34N81u4i4RS1Hy5uw1ivUOq9Ogg&oe=6A8586F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neyo", "keywords": ["Architecture", "floorplan", "Home", "Walkthrough", "House"], "long_description": "\ud83c\udfe1 Neyo \u2013 Explore Prefabricated Homes\n\nWith Neyo, architecture becomes a walkable experience before construction begins. Step inside fully furnished prefab houses from top German manufacturers \u2013 realistic, intuitive, immersive.\n\n\ud83d\udeb6\u200d\u2642\ufe0f What to Expect:\n> Virtual walkthroughs of real 3D floorplans\n> Highly realistic interiors with premium design\n> Free navigation through every room\n> Switch between house models\n> Compare layouts, styles, and finishes\n\n\ud83c\udfaf Our Mission:\nTo make building visualization and virtual home experiences accessible, intuitive, and visually compelling for everyone.\n\n\ud83d\udea7 In Development:\nNeyo is becoming a full-featured VR platform for home planning. \n\nUpcoming features:\n> More homes and architectural styles\n> Interactive interiors: change furnitur, materials\n> Explore gardens, terraces, and driveways\n> Leave feedback directly in VR\n> Contact prefab manufacturers\n> Upload your own floor plan and walk through it\n> Create your own 3D renderings\n\n\ud83d\udc65 Who It's For:\n\n> Future homeowners comparing designs and layouts\n> Manufacturers showcasing models with immersive tools\n> Architects and planners using 3D walkthroughs\n> Anyone curious about VR home tours and digital architecture\n\n--\nNeyo by VisioPlan Solutions", "short_description": "Neyo \u2013 Explore Prefabricated Homes\n\nWith Neyo, you walk through fully furnished prefabricated houses in stunning detail. Move freely, switch between models, and experience architecture in a new, accessible way. Whether you're planning a home, love design, or just want to explore \u2013 this is where virtual and real spaces meet.\n"}]}, "developer_nam
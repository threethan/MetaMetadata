470713971_6697760083143168381_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgHVNE-zC6UQ7kNvwGiDuSI&_nc_oc=AdqEjD09FCkL9J57qyLLlCjBCTS3lZe8o_H_MtedYFHlmyn0GXZKBNXiSYzMsdg9KdU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp-3hvSSdpqU6NO11JVwFcnN0anvnLzzWRR0PfHPT1zQ&oe=6A5CBF95"}, {"file_name": "outside_art6.png", "id": "1418731629489277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_1418731632822610_4553946260192839708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9COfErGLegQ7kNvwF2Ha2E&_nc_oc=Adof-srvor7wnX4lvqWbnWuMdXCuY0smWyjkZsFy3yQsT5EwsoE5ZTiWuEv-OJwV7Lk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcKPEfFKPB5Yh7RujA9tr1B94_vmuHGcvCZQoN2klnMQ&oe=6A5CBFA9"}, {"file_name": "Art6_kitchen.png", "id": "8810995482336524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_8810995489003190_3481627969198699272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKjCo_P2POEQ7kNvwH8umYd&_nc_oc=Ado4ibWLiey_9nr3WoeTtaLRhDNDxbOplNLc9XZ2pifiX7lPSBydgpX_XznCS-ykaRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGk1TWdBCjKz5n4sHYMmBg3yNpxVbGFV0-5HDWu_sgig&oe=6A5CCB62"}, {"file_name": "outside_schaller.png", "id": "645468378314980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473402211_645468381648313_124640857118417874_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfOt3zPOcYEQ7kNvwEPTZ74&_nc_oc=AdqO3ITFKykippgoh8aTh7kNwN-9TMvDmsfzItQ5Ywd3PtE0lFdVUud7VAAvfyBK66c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHQhNoLufnsLp1OV3BqGvRVkFk-yTJB5UZO8k3MIdHCg&oe=6A5CDD10"}, {"file_name": "bathroom_schaller.png", "id": "660485266909923", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_660485270243256_4703071978444780768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeOVSX9WwCEQ7kNvwED2fAo&_nc_oc=AdpOASg79V50eNMHHH06gy8MR3J-6sXNS-hhl7gNIQIi9BnuqmoxjS_ab8PA4JIIjrg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrc0CZrd85SuGle0ClL93oQEjAj5i0SoOIKt56R7qeCw&oe=6A5CE0B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neyo", "keywords": ["Architecture", "floorplan", "Home", "Walkthrough", "House"], "long_description": "\ud83c\udfe1 Neyo \u2013 Explore Prefabricated Homes\n\nWith Neyo, architecture becomes a walkable experience before construction begins. Step inside fully furnished prefab houses from top German manufacturers \u2013 realistic, intuitive, immersive.\n\n\ud83d\udeb6\u200d\u2642\ufe0f What to Expect:\n> Virtual walkthroughs of real 3D floorplans\n> Highly realistic interiors with premium design\n> Free navigation through every room\n> Switch between house models\n> Compare layouts, styles, and finishes\n\n\ud83c\udfaf Our Mission:\nTo make building visualization and virtual home experiences accessible, intuitive, and visually compelling for everyone.\n\n\ud83d\udea7 In Development:\nNeyo is becoming a full-featured VR platform for home planning. \n\nUpcoming features:\n> More homes and architectural styles\n> Interactive interiors: change furnitur, materials\n> Explore gardens, terraces, and driveways\n> Leave feedback directly in VR\n> Contact prefab manufacturers\n> Upload your own floor plan and walk through it\n> Create your own 3D renderings\n\n\ud83d\udc65 Who It's For:\n\n> Future homeowners comparing designs and layouts\n> Manufacturers showcasing models with immersive tools\n> Architects and planners using 3D walkthroughs\n> Anyone curious about VR home tours and digital architecture\n\n--\nNeyo by VisioPlan Solutions", "short_description": "Neyo \u2013 Explore Prefabricated Homes\n\nWith Neyo, you walk through fully furnished prefabricated houses in stunning detail. Move freely, switch between models, and experience architecture in a new, accessible way. Whether you're planning a home, love design, or just want to explore \u2013 this is where virtual and real spaces meet.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/visioplan/NeyoPrivacyPolicy/blob/main/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "VisioPlan Solutions GmbH", "support_website_url": null, "website_url": "https://visioplan.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9063887050384530"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "9118317478270096"}, {"status": "PUBLISHED", "id": "1444483523205768"}]}, "baseline_offer": {"id": "9118317478270096"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747250280, "status": "PUBLISHED", "id": "9118317478270096"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9849901325116428", "version": "0.9.2"}, "id": "1167521198147369", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9063887047051197", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9849901325116428"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1167521198147369"}]}, "change_log": "New Features: \n\n- Login \n\n\nBugFix: \n\n- Project Image 
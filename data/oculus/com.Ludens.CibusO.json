mini-landscape_1080_360.png", "id": "661479690117428", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393355_661479693450761_4205383987433342576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4epNHD8JQacQ7kNvwFhq4MP&_nc_oc=AdrrKeNmdxHa2gCW6_378Mdz0Fh-v-bs9TFsP9AmKsjppvy5COtGDNpLalC63NIOtaY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LEw7mCjQtnJ-X-VcNiEkr0QT4X2f5ilV7MdK1xRF1DA&oe=6A11A695"}]}, "id": "1789176181663817", "locale": "en_US", "screenshots": [{"file_name": "ScreenShot-1.png", "id": "1594383754469401", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392192_1594383757802734_3960561122027492988_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUvXOfTidSwQ7kNvwFo70J4&_nc_oc=AdoNSQfWge_6g-wffpORoU2stQKj-rvvuY8f201VfPUJoOnfaOMnwtyAWV-qCEs67AU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SlNz8reRyjlGsx45J91skcAVFnXqTZUV-S9SF7vZ7WQ&oe=6A11BA81"}, {"file_name": "ScreenShot-5.png", "id": "710387235002759", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392182_710387238336092_7760178870163989750_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d53R34W6vPcQ7kNvwFCEVFt&_nc_oc=AdrbqE5wCSj46w2pqq7fits4QZhvFdg9IIfSl9Ffzwsm82zEOGzA3yEg5JvqVtJoLEk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hcL0p5orF7eMSnwOOf7m6sp8-eVUaVcYHexYLdJZBvA&oe=6A119F67"}, {"file_name": "ScreenShot-3.png", "id": "678311941480617", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393759_678311944813950_4323477333881705628_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM9m99k2VHUQ7kNvwEJwXnc&_nc_oc=AdpYoHOwucE3471lSgvySFac4A5bHgYr-kdlIyRqzMjUOnVAa9qSZrx00DrW6Puwg74&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_3pRt7510dP4pQST6V_PDNyOt4ytWXBffUvhnaqPQ6w&oe=6A11BB0D"}, {"file_name": "ScreenShot-2.png", "id": "1878894002952190", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393560_1878894006285523_778602697630999071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAZhZRMGe54Q7kNvwGmfqwV&_nc_oc=Adqw6XwzcoiuKFE1BxSLi_axJdgeJG0XUEi2gIJlJYWa3rgInUQhZPfOh-X7jUAtwKs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X58PLtKOx0XMLqgNi2yO1xRQ6hyR7gnc4SbRlY0fe1Q&oe=6A11ADCF"}, {"file_name": "ScreenShot-4.png", "id": "538922042409732", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392167_538922045743065_8821071595574170627_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvspLqu1i24Q7kNvwGjbZx5&_nc_oc=AdqQNpyAfrZYB3UVAUAWw6tNtAbgNXGcJelTuNZ4aS9S-3Wy82xcZxnx6fBL1szMq54&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57Qt1vsQWu-wIgBSbHK012_pxZccSqNJfAWPPUXUNhrw&oe=6A11A782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover Image_2560_1440.png", "id": "1213885759728931", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392175_1213885763062264_6617871192328691578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K5noyPld68Q7kNvwGbjKP-&_nc_oc=AdoQxffz5vByjWfY2iwJeZcN5iXx8t7RgGh3e2xrpK4NUMb3dnAT5GaFAM8IIRnua_s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lCuFBdctXRpv9KBb1zyXEjchUlSoYsfcCuVPBFnbyKA&oe=6A11AFE7"}, "display_name": "Cibus Odyssey", "keywords": ["VR", "Boardgame"], "long_description": "\ud83d\udea7 Cibus Odyssey will continue to receive updates!\nWe're planning to introduce new main maps and mini-games over time, so stay tuned and look forward to what\u2019s coming!\n\nCibus Odyssey is a thrilling party board game in VR where strategy meets action. Compete on the main map by collecting two treasures or defeating your rivals three times. Use your sled's map and camera to plan your moves and make the most of your items to gain the upper hand. Between rounds, dive into fast-paced mini-games to earn valuable resources \u2014 cash, ammo, and power-ups \u2014 all of which give you a competitive edge in the main game. Perform well, and you might just become the 'Chosen One' who saves the continent of Cibus!\n\nWelcome to Cibus, a once-thriving continent where diverse culinary regions flourished in harmony. But peace was shattered when a sinister force emerged from Dairy, corrupting the land and plunging Cibus into chaos. The self-proclaimed Dark Lord seeks to dominate the continent, controlling not just its wealth but the very essence of its cuisine.\n\nAs fear and mistrust drive regions into isolation, a few brave souls rise to restore balance. In this savory VR adventure, embark on a journey to unravel the mystery, unite divided lands, and reclaim the lost flavors of Cibus. The fate of this world\u2014and its cuisine\u2014rests in your hands!", "short_description": "Cibus Odyssey is a first-person VR party board game. You are no longer just a player \u2014 you become the game piece itself. Move, use items, and compete in mini-games, all from a fully immersive first-person perspective. Win mini-games, dominate the board, and prove you\u2019re the 'Chosen One' destined to save the land of Cibus!"}, {"images": {"nodes": []}, "id": "1060938795398774", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cibus Odyssey", "keywords": [], "long_description": "\uce58\ubd80\uc2a4 \uc624\ub514\uc138\uc774\ub294 1\uc778\uce6d \ud30c\ud2f0\ubcf4\ub4dc\uac8c\uc784\uc785\ub2c8\ub2e4. \uc5ec\ub7ec\ubd84\ub4e4\uc740 \uc774\uc81c \ubcf4\ub4dc\ud310 \uc704\uc758 \ub9d0\uc774 \ub418\uc5b4\uc11c \ubaa8\ub4e0 \ud589\ub3d9\uc744 \uc9c1\uc811 \uc218\ud589\ud558\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4.\n\n\uba54\uc778\ub9f5\uc5d0\uc11c \uc5ec\ub7ec\ubd84\ub4e4\uc740 \uc2b9\ub9ac\ub97c \ud5a5\ud55c \ud50c\ub808\uc774\ub97c \ud558\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4. \uc8fc\uc0ac\uc704\ub97c \uad74\ub9ac\uace0, \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uace0, \uc800\uaca9\ucd1d\uc744 \uc0ac\uc6a9\ud574\uc11c \ubcf4\ubb3c\uc744 \uc5bb\uac70\ub098 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub97c \ucc98\uce58\ud558\uc138\uc694. 1\ubc88\uc9f8 \ub9f5\uc778 \uaf41\uaf41\ube59\uc218\uc5d0\uc11c \uc5ec\ub7ec\ubd84\ub4e4\uc740\n\ubcf4\ubb3c 2\uac1c \ud68d\ub4dd \ud639\uc740 \ud50c\ub808\uc774\uc5b4 3\ubc88 \ucc98\uce58\ub97c \ud1b5\ud574\uc11c \uc2b9\ub9ac\ub97c \ucc28\uc9c0\ud560 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.\n\n\ubbf8\ub2c8\uac8c\uc784\uc5d0\uc11c \uc5ec\ub7ec\ubd84\ub4e4\uc740 \uac8c\uc784\uc5d0 \ud544\uc694\ud55c \uc7ac\ud654\ub97c \uc5bb\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4. \ubbf8\ub2c8\uac8c\uc784\uc5d0\uc11c \uc5ec\ub7ec\ubd84\ub4e4\uc740 \uac01\uc790\uc758 \ud53c\uc9c0\uceec, \ub1cc\uc9c0\uceec, \uc6b4\uc744 \uc2dc\ud5d8\ubc1b\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ubbf8\ub2c8\uac8c\uc784\uc5d0\uc11c \uc88b\uc740 \uc131\uc801\uc744 \uac70\ub450\uba74, \uba54\uc778\ub9f5\uc5d0\uc11c \uba3c\uc800 \uc8fc\uc0ac\uc704\ub97c \uad74\ub9ac\uac8c \ub418\ub294 \uac83\uc740 \ubb3c\ub860, \uc544\uc774\ud15c\uacfc \uace8\ub4dc\ub97c \ud68d\ub4dd\ud560 \uc218 \uc788\uae30\ub3c4 \ud569\ub2c8\ub2e4. \uba54\uc778\ub9f5\uc5d0\uc11c \uc544\ubb34\ub9ac \uc88b\uc740 \uc804\ub7b5\uc744 \uc138\uc6e0\ub354\ub77c\ub3c4, \ubbf8\ub2c8\uac8c\uc784\uc5d0\uc11c \uc88b\uc740 \uc131\uc801\uc744 \uac70\ub450\uc9c0 \ubabb\ud55c\ub2e4\uba74, \uc5ec\ub7ec\ubd84\ub4e4\uc758 \uc804\ub7b5\uc740 \ubb34\ub108\uc9c8 \uac83\uc785\ub2c8\ub2e4.\n\n\uce58\ubd80\uc2a4 \uc624\ub514\uc138\uc774\ub294 \uafb8\uc900\ud788 \uc5c5\ub370\uc774\ud2b8 \ub420 \uc608\uc815\uc785\ub2c8\ub2e4!\n\uc9c0\uc18d\uc801\uc73c\ub85c \uc0c8\ub85c\uc6b4 \ub9f5\uacfc \ubbf8\ub2c8\uac8c\uc784\uc744 \ucd94\uac00\ud558\uba74\uc11c \uc5ec\ub7ec\ubd84\ub4e4\uc5d0\uac8c \uc0c8\ub85c\uc6b4 \uc990\uac70\uc6c0\uc744, \uadf8\ub9ac\uace0 \uce58\ubd80\uc2a4 \ub300\ub959\uc758 \ube44\ubc00\uc5d0 \ub300\ud574\uc11c \ub098\ub204\uace0 \uc2f6\uc2b5\ub2c8\ub2e4!\n\uc624\uc5fc\ub418\uace0 \ubd84\uc5f4\ub41c \uce58\ubd80\uc2a4 \ub300\ub959\uc744 \uad6c\uc6d0\ud560 \uc120\ud0dd\ubc1b\uc740 \uc6a9\uc0ac\uac00 \ubc14\ub85c \ub2f9\uc2e0\uc774\ub77c\ub294 \uac83\uc744 \uaf2d \uc99d\uba85\ud574\uc8fc\uc138\uc694!", "short_description": "\uce58\ubd80\uc2a4 \uc624\ub514\uc138\uc774\ub294 1\uc778\uce6d VR \ud30c\ud2f0\ubcf4\ub4dc\uac8c\uc784\uc785\ub2c8\ub2e4. \uce58\ubd80\uc2a4 \uc624\ub514\uc138\uc774\uc5d0\uc11c \uc5ec\ub7ec\ubd84\ub4e4\uc740 \ubcf4\ub4dc\ud310 \uc704\uc758 \ub9d0\uc774 \ub418\uc5b4\uc11c \uc9c1\uc811 \uc8fc\uc0ac\uc704\ub97c \uad74\ub9ac\uace0, \uc774\ub3d9\ud558\uace0, \ubbf8\ub2c8\uac8c\uc784\uc744 \ud50c\ub808\uc774\ud558\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4.\n\ud6cc\ub96d\ud55c \uc804\ub7b5\uc744 \uad6c\uc0c1\ud558\uace0, \ubbf8\ub2c8\uac8c\uc784\uc744 \uc2b9\ub9ac\ud558\uace0, \uc544\uc774\ud15c\uc744 \uc801\uc808\ud788 \uc0ac\uc6a9\ud574\uc11c \uc2b9\ub9ac\ub97c \ucc28\uc9c0\ud558\uc138\uc694!\n\ubc14\ub85c \ub2f9\uc2e0\uc774 \uce58\ubd80\uc2a4 \ub300\ub959\uc744 \uad6c\uc6d0\ud560 \uc120\ud0dd\ubc1b\uc740 \uc6a9\uc0ac\ub77c\ub294 \uac83\uc744 \uc99d\uba85\ud558\uc138\uc694."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludensgame.com/policy", "developer_terms_of_service_url": null, "publisher_name": "LUDENS Co., Ltd.", "support_website_url": null, "website_url": "https://ludensgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "981
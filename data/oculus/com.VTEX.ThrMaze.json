"video_trailer_thumbnail": {"file_name": "the_maze_2560x1440.png", "id": "26963423236596127", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825546_26963423249929459_1159735689245200696_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inkMyLXkpAEQ7kNvwFVXqFM&_nc_oc=AdpPRu1eQzM6XptMXBuh6otC2OY8B5cr2W3etsK0E0xt8K0hqCvgBdoFw-MJ7xjxiY8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gUzQeroDqIFtOzvY8esNtxAU3ZxKUXu-MXlJkUcUEVQ&oe=6A450DDD"}, "display_name": "The Maze", "keywords": ["maze", "zombie", "shooting", "puzzle", "gun"], "long_description": "Enter a terrifying and intense VR survival experience where every second matters. You wake up trapped inside a dark and confusing maze with only one goal \u2014 escape before time runs out. With just three minutes on the clock, you must quickly explore the maze, find the correct path, and stay alive long enough to reach the exit.\n\nBut escaping won\u2019t be easy. The maze is filled with dangerous zombies that can appear at any corner. As you move through narrow corridors and hidden turns, you must stay alert and use your weapon to fight and shoot the zombies that try to stop you. Your reflexes, aim, and decision-making will determine whether you survive or become another victim of the maze.\n\nThe immersive VR environment puts you directly inside the action, making every sound, movement, and encounter feel real. The pressure of the countdown timer, combined with the constant threat of zombies, creates a thrilling and heart-pounding experience.\n\nWill you stay calm under pressure, defeat the undead, and find the way out before the 3 minutes are over? Or will the maze claim another survivor?\n\nRun. Fight. Escape.", "short_description": "Escape the maze before time runs out! In this intense VR experience, you have only 3 minutes to find your way out while fighting off terrifying zombies lurking in the darkness. Stay alert, move fast, and use your weapon wisely to survive and escape the maze before it\u2019s too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://v2tex.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "VTex", "support_website_url": null, "website_url": "https://v2tex.weebly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26346150598372621"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "793120170501260"}]}, "baseline_offer": {"id": "793120170501260"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774383120, "status": "PUBLISHED", "id": "793120170501260"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26335515619436119", "version": "0.0.2"}, "id": "892570430434179", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26051507967836887", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26335515619436119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "892570430
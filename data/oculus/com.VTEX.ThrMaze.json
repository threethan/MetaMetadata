ng", "id": "1285615653628249", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1285615656961582_3316728195096459909_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vELXeTX2w1YQ7kNvwETe5kU&_nc_oc=AdpDMBe8VideNQuePXh86cjWUAB-cGr8xUyY-OzmsJBII0z4JwM4S3KA6p2CfsfT14U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97QATn1Cv8rzMiNWpmNoFnneYDnhCPWGHUfa92ZrJbCg&oe=6A451FB6"}]}, "id": "1475559380626121", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2026-03-23 195009.png", "id": "4351258298454126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_4351258308454125_4240720125227253201_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3aXG24NCAsQ7kNvwG1Lbrk&_nc_oc=AdryFQCU0JpChxWg_-xOKuWTjQmIJhOQnl22WORXt7YoRQ76c6aCuBqpgCBpUNFDOBg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N5GbdDChk3NOx-55Lp6BUzXcmyTJd0_ZbbpICvNjHxQ&oe=6A4518B9"}, {"file_name": "Screenshot 2026-03-23 194936.png", "id": "1242952647511037", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823286_1242952650844370_3390260226765141857_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zAq8tlaCaMQ7kNvwFmoWu_&_nc_oc=Ado6wnrN_H1rt_FJK7ihMNphIIsZeQMHqscYpI8dipD4p-Cr31iV75UWOBHqVHsbwqg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94SXFDeQiGJQOXVQ5t56l5kps-DQDWuXcaLInXBdrLZw&oe=6A4519BD"}, {"file_name": "Screenshot 2026-03-23 195044.png", "id": "1253612233564347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_1253612240231013_8768816059267736155_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sAx4D7dxn4Q7kNvwENEuWl&_nc_oc=AdqnCP-E8UfI1t9yKBycBfkkXOGeCjWKMvi41vmZzDYlq5rjJqeZ1OSWGD4kwcuiBwQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oxBDBkVivw_Xi9PHkzp96Pqerqo-7JckTy-nJ6K5VSQ&oe=6A4502D3"}, {"file_name": "1.png", "id": "1977941409473191", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1977941412806524_6629178157847228226_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YS78dCuHgRgQ7kNvwFPjRp4&_nc_oc=AdpHzigaR7-6uTiJcMHYy21tKWs7ZFFtZL5poVgo8uEW6fCkeiL2AwfA8s8Dz7WBRks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DojQBsbEiqI9mfSM8AdfKoJuJnQx20CVizvMCqn398g&oe=6A452853"}, {"file_name": "Screenshot 2026-03-24 183812.png", "id": "1262668308625883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298502_1262668311959216_2561977697635975414_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dBcJTezeswQ7kNvwFoIoRp&_nc_oc=AdrqR07tikjJoZGoCPTB8BdRiAGTYZ8A77OGR5Ki7Ill-S_iwW1AZvaCETTWbTQI5N8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bVJTnn3fsyxBt_BQTjrCY4NFYO8UqAJLR3vqcxpnkQg&oe=6A450903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "the_maze_2560x1440.png", "id": "26963423236596127", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825546_26963423249929459_1159735689245200696_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inkMyLXkpAEQ7kNvwFVXqFM&_nc_oc=AdpPRu1eQzM6XptMXBuh6otC2OY8B5cr2W3etsK0E0xt8K0hqCvgBdoFw-MJ7xjxiY8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gUzQeroDqIFtOzvY8esNtxAU3ZxKUXu-MXlJkUcUEVQ&oe=6A450DDD"}, "display_name": "The Maze", "keywords": ["maze", "zombie", "shooting", "puzzle", "gun"], "long_description": "Enter a terrifying and intense VR survival experience where every second matters. You wake up trapped inside a dark and confusing maze with only one goal \u2014 escape before time runs out. With just three minutes on the clock, you must quickly explore the maze, find the correct path, and stay alive long enough to reach the exit.\n\nBut escaping won\u2019t be easy. The maze is filled with dangerous zombies that can appear at any corner. As you move through narrow corridors and hidden turns, you must stay alert and use your weapon to fight and shoot the zombies that try to stop you. Your reflexes, aim, and decision-making will determine whether you survive or become another victim of the maze.\n\nThe immersive VR environment puts you directly inside the action, making every sound, movement, and encounter feel real. The pressure of the countdown timer, combined with the constant threat of zombies, creates a thrilling and heart-pounding experience.\n\nWill you stay calm under pressure, defeat the undead, and find the way out before the 3 minutes are over? Or will the maze claim another survivor?\n\nRun. Fight. Escape.", "short_description": "Escape the maze before time runs out! In this intense VR experience, you have only 3 minutes to find your way out while fighting off terrifying zombies lurking in the darkness. Stay alert, move fast, and use your weapon wisely to survive and escape the maze before it\u2019s too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://v2tex.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "VTex", "support_website_url": null, "website_url": "https://v2tex.weebly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26346150598372621"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_269971
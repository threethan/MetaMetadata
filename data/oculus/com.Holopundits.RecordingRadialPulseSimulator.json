le_name": "Recording Radial Pulse Simulator_SS_05.png", "id": "837151848339615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43931336_837151851672948_3791241212278429846_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6MFxdyjvwYQ7kNvwHOhgDl&_nc_oc=Adnq50Nb2wfmzQMGmSf10xSDVkRatYh4Eqr2bVKBRQQhkcFOAulzd4X8qApS9OPmR_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTQF3Zid7To7hwB6mFVBveMTUzKRZSevH7axXZtx7_cQ&oe=69B004A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "3812821238933502", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982527_3812821242266835_422188521434867194_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW_LfRu8NGMQ7kNvwH2z7gg&_nc_oc=Adl6x9qbvegmCbyFm3-2fnHbIR8hNn60E32kUR3GisTz3oaWBLd6TWWZ2lOhVcAmrDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbFjcDMu0RwIj4OkYoZU3pi4_1-cveHPCqx3F0km_uFw&oe=69B022CC"}, "display_name": "Recording Radial Pulse Simulator", "keywords": [], "long_description": "This tutorial covers the essential steps for measuring and recording a patient's radial pulse. It includes preparation, locating the pulse, measurement, and documentation. By the end of this tutorial, learners will be able to: \n\nRemember the key steps in recording a radial pulse. \n- Understand the significance of pulse measurement in patient assessment. \n- Apply the correct techniques to ensure accurate pulse recording. \n- Analyze pulse data to detect any irregularities. \n- Evaluate their measurement accuracy and identify areas for improvement. \n- Create precise and thorough patient records based on their findings. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Develop proficiency in accurately recording a patient's radial pulse."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7883067155117351"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24132446639752811", "version": "2.0"}, "id": "1151833229365865", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7883067125117354", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24132446639752811"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1151833229365865"}]}, "change_log": null, "created_date": 1753370024, "id": "24132446639752811", "version": "2.0", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "And
vK-imCyrGw495N-Tp4G49MfHffhQ&oe=6ACE5F53"}, {"file_name": "Recording Radial Pulse Simulator_SS_05.png", "id": "837151848339615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931336_837151851672948_3791241212278429846_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScNLo2nlTWcQ7kNvwGq-9nM&_nc_oc=AdoOlzrStE_qrYXBm21nXyWPB9J-Zw5gdnYHqNrZKsB_nZvqfwtJHojhoEg3YmcLUSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMFM66y_ZpPnpy2YJK9GUVJ4ErBSwqSAYsr__Oy8WDYg&oe=6ACE5267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "3812821238933502", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982527_3812821242266835_422188521434867194_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnMRRygLo6kQ7kNvwG5zj2u&_nc_oc=AdryvwEV3dj6ZfcjXapgQ9g061JW2HziMu_Tsb_b2odO85zAJYkCsRvBmHOI4mV_FK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfQmDjr1D8llJG5bHJR3--6QZ9CfYBc8ElK7bb8GNd4w&oe=6ACE384C"}, "display_name": "Recording Radial Pulse Simulator", "keywords": [], "long_description": "This tutorial covers the essential steps for measuring and recording a patient's radial pulse. It includes preparation, locating the pulse, measurement, and documentation. By the end of this tutorial, learners will be able to: \n\nRemember the key steps in recording a radial pulse. \n- Understand the significance of pulse measurement in patient assessment. \n- Apply the correct techniques to ensure accurate pulse recording. \n- Analyze pulse data to detect any irregularities. \n- Evaluate their measurement accuracy and identify areas for improvement. \n- Create precise and thorough patient records based on their findings. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Develop proficiency in accurately recording a patient's radial pulse."}]}, "developer_name": null, 
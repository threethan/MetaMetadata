7g2P1G6ZZ5RHrIDj5TABeGbMg-Fw&oe=69E61F13"}, {"file_name": "Recording Radial Pulse Simulator_SS_05.png", "id": "837151848339615", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/43931336_837151851672948_3791241212278429846_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU2E80gt47EQ7kNvwFB76Du&_nc_oc=AdphBCMw0t1d-Ooi_X8WyLv2urPY4PAQmermSHCrcJt4oEcvfWmev-VPjohhmamZ0-Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PLj9ZKyriJu-6P5d4N9AGPz_lZE_-UIf5kyvJvRD18A&oe=69E61227"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "3812821238933502", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982527_3812821242266835_422188521434867194_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihWU7ZV7q88Q7kNvwFOOTNK&_nc_oc=AdppzdHe9CyC_mkQXOrH33_a2OOvb_A1Ugd32Ywl9QRD6JP6941afxQUZ2xPwqLXgQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fgGdRBU9r1qI5D7O6t4khDHp07VFXNQqbvQc-9tUsgA&oe=69E6304C"}, "display_name": "Recording Radial Pulse Simulator", "keywords": [], "long_description": "This tutorial covers the essential steps for measuring and recording a patient's radial pulse. It includes preparation, locating the pulse, measurement, and documentation. By the end of this tutorial, learners will be able to: \n\nRemember the key steps in recording a radial pulse. \n- Understand the significance of pulse measurement in patient assessment. \n- Apply the correct techniques to ensure accurate pulse recording. \n- Analyze pulse data to detect any irregularities. \n- Evaluate their measurement accuracy and identify areas for improvement. \n- Create precise and thorough patient records based on their findings. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Develop proficiency in accurately recording a patient's radial pulse."}]}, "developer_name": null, 
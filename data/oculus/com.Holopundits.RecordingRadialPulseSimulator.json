d3-1.oculuscdn.com/v/t64.5771-25/43931336_837151851672948_3791241212278429846_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hfqWA7_03kQ7kNvwHXed-Z&_nc_oc=AdkqpZf5yN3HtW-S1vnA27xlktqcxafbqoJW_cmSUJGMUOGuJwVTHKPjN6bAbZ8qau8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWGOoaGC3oo1kEd52qYZQHsoyUdAtHmVgZ4wbEZFJ9BQ&oe=69A6CA27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "3812821238933502", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982527_3812821242266835_422188521434867194_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ducAx_uqBEQ7kNvwHP8tQ8&_nc_oc=Adkp6jAoDYzP9wX-zjmNQQ9zxz87Xa5zu2h1Pr04QNIFnOGghliZE8NKuyPURTEEDlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfszTOJLvJAbHzl-LQAtqRNNPiJ-gTg8N98MYDDbeFvCOQ&oe=69A6E84C"}, "display_name": "Recording Radial Pulse Simulator", "keywords": [], "long_description": "This tutorial covers the essential steps for measuring and recording a patient's radial pulse. It includes preparation, locating the pulse, measurement, and documentation. By the end of this tutorial, learners will be able to: \n\nRemember the key steps in recording a radial pulse. \n- Understand the significance of pulse measurement in patient assessment. \n- Apply the correct techniques to ensure accurate pulse recording. \n- Analyze pulse data to detect any irregularities. \n- Evaluate their measurement accuracy and identify areas for improvement. \n- Create precise and thorough patient records based on their findings. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Develop proficiency in accurately recording a patient's radial pulse."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": nu
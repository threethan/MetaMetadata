2aK02Tk1w-xRp36-hBo5t8-rl8pg&oe=69FDDA13"}, {"file_name": "Recording Radial Pulse Simulator_SS_05.png", "id": "837151848339615", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/43931336_837151851672948_3791241212278429846_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uD6KTSRisZ0Q7kNvwHVSScT&_nc_oc=Adob1g4_dtpmLt7LY84ysCSK-45AO1bCOz0VitH2PKrXMehCGuuBIlex4V316TpCy-Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JSoGqA0B-zANr_mQtdBWdbKQPEH47IWaPl9RgJJ5CVA&oe=69FE0567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "3812821238933502", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982527_3812821242266835_422188521434867194_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHRLUM_VnCoQ7kNvwE3CMMF&_nc_oc=AdprTEB68y8rZlXh1S_MzL2NCeso8HDPDPpJIP6TqYw3NzlBE49LIYCugFIjPqJgOhc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AKjQXt4zVqwwaxHFaUny7cRDi-cTKhSs_SND7xhShtA&oe=69FDEB4C"}, "display_name": "Recording Radial Pulse Simulator", "keywords": [], "long_description": "This tutorial covers the essential steps for measuring and recording a patient's radial pulse. It includes preparation, locating the pulse, measurement, and documentation. By the end of this tutorial, learners will be able to: \n\nRemember the key steps in recording a radial pulse. \n- Understand the significance of pulse measurement in patient assessment. \n- Apply the correct techniques to ensure accurate pulse recording. \n- Analyze pulse data to detect any irregularities. \n- Evaluate their measurement accuracy and identify areas for improvement. \n- Create precise and thorough patient records based on their findings. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Develop proficiency in accurately recording a patient's radial pulse."}]}, "developer_name": null, 
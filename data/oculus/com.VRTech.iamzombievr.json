rEFRlu0AMN8VHqF4sBYPChTzECATYslnsfTELpQhmciW8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFEZIUzvjOLw1i7oMXs9eSq10wW6bJGJwE9y_BQktVDw&oe=6AF9D59D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIhxHMrRs2EQ7kNvwHE0dJf&_nc_oc=AdpgOgqKQsDSiQzuGk3Z09-o_z1PXqqQipfdtCTNgf12cm2EPxHvJKBXtbKVhP1zqJo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3Spg1sNlYCJW4H-1c_GcA5lgWA0iCkLwRe_Bh1JRgow&oe=6AF9D7A9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELqEf8F2AboQ7kNvwFmxUUd&_nc_oc=Adr4Md5QI1Zj9BS9rMpxqz0vyuioNVmRE7ddkfaaTqpE7GLVbZUQcceMAQK-WwYBTv8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZzXP9DJT3uX6d4CFHXO-7GJYLsHmb5_T0q_vIKOIywg&oe=6AF9E3D5"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw2GXnE6LooQ7kNvwHDe1RK&_nc_oc=AdqntfenCfPXBwTsMecXWUQbmUWx32XziSsHpGBwJ8qGNN__8gLJFnTJ-m858gMJeSo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5r4U3zls2DHygNyt6iqN9PHf6ist0jwd5tmhlmSs3Cg&oe=6AF9C1E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blOEM0Xckb8Q7kNvwHdLNjm&_nc_oc=Adprh3g2_fxz5j08mG5RF_XwkYt0YJkCCwt4VKvjPKspHSXJ2x0EPenxWZgDPH2zzmI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3pUO6oJr0K4JBEmyNVw6EcDDkMbMzr6yhQ7Y5j20sQA&oe=6AF9D4A7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
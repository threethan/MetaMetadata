104_8511254157537159748_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gONz8t_xCTEQ7kNvwEth68G&_nc_oc=AdrtJfoCmW5FAnkSILfGub5OUsf1UCLFmBEinZhK991LVbtDvf2s04nzapGnYAvmm4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN_PQI2Ho61pD6InWsePSmJAl-gLbzprfa91lSpFnXUg&oe=6AF5F503"}, {"file_name": "Screenshots (4).png", "id": "26194547793541779", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_26194547800208445_5224721323504848497_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhYvCE1qVMQQ7kNvwFR7qGb&_nc_oc=AdouJMHDs_74SMoluB5WvfFrga13hKWohkqtGQVi-KGh7tREWC7xfWHMMTj7A64Al8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHjOxwmRiXpEk93jbhyOzkKBUgpHIqDUfiawYTrxpoBA&oe=6AF5E11D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGOilqddzKUQ7kNvwFlsUVY&_nc_oc=AdriH_uebt-vjIVdTExpZ41A5TfBSwqa_O-Iy0GVES-8FUEr74Sh0Xw8bhulhgktn0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvANSk0bUTdOnd2RxrBqDsuft1JLAewDHQ4MksRxBQuQ&oe=6AF5E329"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y04vyFPWHPwQ7kNvwFs7F0l&_nc_oc=Adr5pTJHVs3AlZdgyeKU7BAR8FKkHvAXSrQJShhhLwJ61jy7650WGFMFnPGJEDyhMgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa7VW--PR15nUkOQuEnmjxbB_0fayHjWhhaJSNvym3uA&oe=6AF5EF55"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxjfsX4pWdgQ7kNvwFWECf-&_nc_oc=AdoBzZzz-mYwGrIeS5Z5fwBAp1uSxcgteMLTCWNkucWo9uO2a7h2xMw0G_K9LUU0mP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoyS1FcqEv1qtMIns9Mu6RkekH8mxNQ4hBFkdHu2fYNA&oe=6AF5CD68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5vJAzgCCogQ7kNvwGDLkmy&_nc_oc=AdqjJGQ97B48Fif6mjdeuFCndXBK4QE1AE-I0UZBtDCcXqAJfURPyjFsjiTAlWKCDVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRttkal_qlK1QuP-uVzxaudilZ48uNcUdfXO8K6xdf4cQ&oe=6AF5E027"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34615430358101354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619832_870501819345777_3504912236659634520_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akHieeoE6RUQ7kNvwGB3tkt&_nc_oc=AdrSPIF1_WhA2DoKCNlq_O8vQKtZebvURb2ZfxF_Ng47A5vA6YzEkIUF8l3fKj0B2BQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm8ejTXVofYgmVbG1lRRO0Da_hcvacEsetqgPeJvW2Pw&oe=6AF5CE10"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Zombie VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1775102640, "lastRevision": {"nodes": [{"id": "346154304281013
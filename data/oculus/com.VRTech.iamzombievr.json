hrJDzn7qn0z1qbMp_NgZB8xeXex8Tbu4w&oe=6A2C2B9D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M8c9BmJ_cEQ7kNvwGEBi9T&_nc_oc=AdrciZ-OHHdAzUcqgPsaX_zqoztGt8aaeyrRiFT6z4GlXUqWk6TX7l7moLmpeL2CQrU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eL3MNfIScMGcl2SEJbvbogWG3uT0MJ8XNd3TsGGpu5w&oe=6A2C2DA9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEGCjGx-kPEQ7kNvwHgJiaP&_nc_oc=Ado1xtiC_wEGydY2Z8qaYD7eYv8GU-JDuDHMjYNH7XN_6E0JUF4ybKx-bHraTgkYWqo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9szbLndJvstRpk5QgcKytE9lTGB7rZSaG3RS1Sh2g3BQ&oe=6A2C0195"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXsECK2BzqIQ7kNvwFE7jNq&_nc_oc=AdrykkGFG1cA0hVZ_vn8Oupr77xovvbIMsMr9QRTzhTa6kt7iNA0LQNvHjWlPS4CNUY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CVPOQhPLXRBTE_WYBIPdodLWL-RrS6K93SFCc18E1bQ&oe=6A2C17E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDsLW1xxv4sQ7kNvwHVR0WR&_nc_oc=AdqwJzjWvOqMl0_Pfrs-s0x3yQ3fIbHpfj1QHCGHDcNSlqG8KqdyKFPBloPudtNBhuc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0HdV4ScHB1w7kPl_ut01SU-Rfy32_b7oKWawHg6TVZg&oe=6A2C2AA7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres"
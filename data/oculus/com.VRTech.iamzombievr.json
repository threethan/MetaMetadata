vqmpAMuhFGAYL5Bd1L6rG_QX2PW18FoGYNkFz4n1Nb5L8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3rDOadMySfpkBZ3svLdXZCQ4poLmQkjTUpLg7gT7aqg&oe=6AAD5E9D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ1LTQ7jZQUQ7kNvwGacNOG&_nc_oc=Ado65Q9Np_hBhR2UBv1b_3SV9vo9GqTwBkIP9VQpfvA2pebjRUDtE4j1f8aybr-rqgw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPVc-Y5EFM1oL6jsdILFSZWx2mwvsI1bOhj5wKTF8gAA&oe=6AAD60A9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewO8qTCH_hAQ7kNvwF2PADn&_nc_oc=AdpNxdOFw0P2oP1x24jHu1HpOyDnXkdbKxLcMtN2IHSkZjcQ5utbTycuIWR-p3747Yo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjeih_IGf-V1YrSdD3MGdM-6jTCT84PX6DZ2JzLC8XVw&oe=6AAD3495"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI5DByDlk6UQ7kNvwHFSG2x&_nc_oc=AdoTfkQEHRNCn7lGNWzRoZsXwaVQQAMUfgo4caS8fLal7rsote3ZDYWIrBo4m48sxU4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxO3ZMKl7A95a7WpINfRYTDZqjTEePmuGFoOOmm9WjvA&oe=6AAD4AE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWeuMEHxq9gQ7kNvwE33JcV&_nc_oc=AdpKALHMeQpkYhYTjyhuAQKiM4bP6SnrnfuHW754A4p2L8k_gM7p2QZbQLL-61pKNuw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-qjvc3eQFLvrQJcBS5ZAkoqQ156l2Pg8ne_Peg8No8w&oe=6AAD5DA7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
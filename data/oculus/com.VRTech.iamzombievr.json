isYtXcILDAsoMGulomaQLsdlORSG5HVlw&oe=6A7718DD"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnKRIIV06L4Q7kNvwFFTq2M&_nc_oc=AdpnkSdPlRghVqD-Wyolt8lEJl2fOl-qGRFvmkHTTWKmkOLu4Wr_hAIKvJHN-DGSPgA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFD21Hod0XvFlviooVFWnr3FTu9T6w1aeyp9YYryLjEA&oe=6A771AE9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRAJgbw7hZMQ7kNvwHLvUnY&_nc_oc=AdqxDAZek6FHcIuK4Bgn14BNmbWVc5oK3F72ab8zU3KOmFUAmTYHFdZK8y1Ll7JxNNY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxk5ZgFTJEo7fE8DB38ZonIyHkZ3Z2a7zEA8PfM7xX7g&oe=6A772715"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nq77NGP9LlwQ7kNvwE7UE6W&_nc_oc=AdqUdbsZUyTBX4FOwkiTQ4KtAgAR5LyyeDEe_wX7ovgrtlMazV957xteK2Ex-Qkabyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzEfeE346yI5q6Zf-gS5VLQaqiGmQCULYw--DWw5aGxw&oe=6A773D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZgCw2t_55EQ7kNvwH0FHU4&_nc_oc=AdqRNOfFMcBm9jnAPfnh3b0XsjFJLq6624ZPEzt57w8yiBYBLZeHeuStWJ2N4J6Oi2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUjXH-LSszrirWo-mMja6iihWiVhavxT7hxHbqYyPDJw&oe=6A7717E7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres"
104_8511254157537159748_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x4dHSjl3EgQ7kNvwE5_hHW&_nc_oc=AdofS0GfMUjypJgTKg8Mr54nTLP03ylS4mlEDfA2RAIDLxCXQ1JWmQLRGnTqOzD5isg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTreVie8yVLN1r0e1T5FVUwR79BmdRsp5u4SukSaUBmjg&oe=6AF9E983"}, {"file_name": "Screenshots (4).png", "id": "26194547793541779", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619805_26194547800208445_5224721323504848497_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XXi0wM6P-sQ7kNvwHTwNrs&_nc_oc=AdqYjbizfpFLx9c7Q2WTtrrEFRlu0AMN8VHqF4sBYPChTzECATYslnsfTELpQhmciW8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFEZIUzvjOLw1i7oMXs9eSq10wW6bJGJwE9y_BQktVDw&oe=6AF9D59D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIhxHMrRs2EQ7kNvwHE0dJf&_nc_oc=AdpgOgqKQsDSiQzuGk3Z09-o_z1PXqqQipfdtCTNgf12cm2EPxHvJKBXtbKVhP1zqJo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3Spg1sNlYCJW4H-1c_GcA5lgWA0iCkLwRe_Bh1JRgow&oe=6AF9D7A9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELqEf8F2AboQ7kNvwFmxUUd&_nc_oc=Adr4Md5QI1Zj9BS9rMpxqz0vyuioNVmRE7ddkfaaTqpE7GLVbZUQcceMAQK-WwYBTv8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZzXP9DJT3uX6d4CFHXO-7GJYLsHmb5_T0q_vIKOIywg&oe=6AF9E3D5"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw2GXnE6LooQ7kNvwHDe1RK&_nc_oc=AdqntfenCfPXBwTsMecXWUQbmUWx32XziSsHpGBwJ8qGNN__8gLJFnTJ-m858gMJeSo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5r4U3zls2DHygNyt6iqN9PHf6ist0jwd5tmhlmSs3Cg&oe=6AF9C1E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blOEM0Xckb8Q7kNvwHdLNjm&_nc_oc=Adprh3g2_fxz5j08mG5RF_XwkYt0YJkCCwt4VKvjPKspHSXJ2x0EPenxWZgDPH2zzmI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3pUO6oJr0K4JBEmyNVw6EcDDkMbMzr6yhQ7Y5j20sQA&oe=6AF9D4A7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34615430358101354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619832_870501819345777_3504912236659634520_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F43V2hsygO8Q7kNvwFhBZhS&_nc_oc=AdrUwKjeoIbHs0nGR6n5wvVjmFDobZh8Z2bHJOTdIf4Ft4fNYgcrY9tWdlGPgIdC0rE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTDC-f3nT2N69rB3U9iqtF2F7Lxfp-U85LkEz0eD-SSw&oe=6AF9C290"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Zombie VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1775102640, "lastRevision": {"nodes": [{"id": "346154304281013
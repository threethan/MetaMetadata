vd15qdBne_xGk-yEPn-q0QDoShTduevww&oe=6A9176DD"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-TJSuILDrUQ7kNvwG1t3Vd&_nc_oc=Adr_I33NmutIWIc-3iZ1rHz5b2K4w1pP3vwjCDW6fJ0ySPAw4i1cSgOtUNhLN0gsCFg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8ULebP3gP5c-6sVWqJGcRLyDG5YWhwG38X8Y9UW95Ng&oe=6A9178E9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Xt2Wstzz0Q7kNvwF5zU0V&_nc_oc=AdoYE6rUsMK4k5Zx-ICs5wfMr6GwVbxWE4eD9IXSxie2Ea1C69ZY87FqJZVlT9adfC0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH80js6tPX_daoEln_T-l164bjkkrHKJT4fP1Ceftl_4Q&oe=6A918515"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1snp0JUdPl0Q7kNvwHd1Y5X&_nc_oc=AdopxoRkpTqyXRBBRHg3RB8iGlAtwfGMz08mGYnWTTAYf-bw9vBr2aRwNd-QXMwK6Kk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHll8zpGsA4Lo1ib1ITk31GWX3aCtGQ8-eXucyIpxN9JA&oe=6A916328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZi_jkQWbKAQ7kNvwF3HfMa&_nc_oc=Adoz8x6ooWA0rVaLVt31K2IKSCjUAYVE3-7Xtz1Zmxicbh36revsmQWEEkOGNbCkSDs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPHRElIFTYZYj4BJRmxcGiQJpzJEkJEFg_Yq5ix1T4hg&oe=6A9175E7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres"
fgQVBI5xKecOSfPu9Njni-Ph532DYfHVA&oe=69E7655D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lphkyBMaAsQ7kNvwGE6vn0&_nc_oc=Adr04GF7UX4_BVZ01hAKlA_554T2DBu3qNa4JvLP5miDtG53o2Fg7aRg31_Se5Er2iA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j7Y6AgAyagpiHHD8h5mWpNlt_TKx9qCMJXmEhTEvJ7Q&oe=69E76769"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7lEqDVt2GgQ7kNvwEKubTN&_nc_oc=Adox-fkWRkiRGGOZyMdSrjMrSecyR3l4P4yTed9ATy59e_4rLkMlezlpv9XgQtIR8Co&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12bFgrEdn3RaYoOmp8FxYc6hG8U9nJed5nGVTqEfDVEA&oe=69E77395"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blj75v-cyVwQ7kNvwFBGw3K&_nc_oc=AdoH_xP_4XiJ6O5iR8XLT3D-yzd1zeBlfnt1NBx_lFuIdUpz6kTMfyEFCa0mEh7Lpao&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Vk9OcaFnGEGAtuCCKZ1icHKqDiEb2h-m2-iP4eBnNAw&oe=69E789E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDNzVZBkB6cQ7kNvwF9YVb3&_nc_oc=AdrTtG_nDC7ptrsNWDb4UP4Ly13yEjUsAiuyPjK3C0ZlTQ1LlQA0Qskfg4gifg_3hBw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T_ZCtGf0jnkpL-l0vxP5dGzmi0Q3Sx-TWOMdz8D6Pdg&oe=69E76467"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres"
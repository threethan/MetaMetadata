104_8511254157537159748_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUptATt-SZYQ7kNvwHSIETL&_nc_oc=AdplTyS9Z4jrcXK5a42pKGMXqiadiih_C7ZoxqverRH_NFqL3CXrN5Sxd6nrbqGj2O4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILPk3Wemu1V1U2EZnmf_wr_O9bNCR1BiFXRMKmr3XKpA&oe=6AAA9743"}, {"file_name": "Screenshots (4).png", "id": "26194547793541779", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619805_26194547800208445_5224721323504848497_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW7CgZ7AkY4Q7kNvwFEy3PG&_nc_oc=AdocGWy4Occ9lNxZ8e9Iw-QH69NIgv1TdGY0DiCWwQtwJqy9Ia6bx0VwRWasm1FPSTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-caa2Q9QLPaUk5Dr_9T07_dXzLsCenesOiaFMSIA2cA&oe=6AAABB9D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqBDbgEkJ1sQ7kNvwE8oCpC&_nc_oc=Ado0ttItGl622j2sXIICF5EovtkFVZwHhzRGU1tU_CnadcfNaM3ciod93GetNfKITS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG9t0JWBeeSRUWupw22DkaZyJlkBGfAcchdTiK_eFXxQ&oe=6AAA8569"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knCmDLvhifYQ7kNvwGgJ396&_nc_oc=Adq3SITSxEL2y12QJ2Wku80G5_iM17Mt4MIExqwNmjOAXtF-B9-qlF57DvCfbt_NLvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwSPRSYd8s7GbnG4svqkfQFVnGTKscxmbqVIVuyzqPqg&oe=6AAA9195"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI5DByDlk6UQ7kNvwETp_J0&_nc_oc=Adr2XiiE2rwr52DXJq_rQEbA10Qi7ckc0tj35m-7ptWURFdTWWrn4tLi87XasAzBbdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS3VuyexDVhadM725imTvCCWVDtPPQV0yRm6-bXcz6qA&oe=6AAAA7E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWeuMEHxq9gQ7kNvwFF7XU3&_nc_oc=Adrfk0PoLwR90JYfohjxCsc2DxgVRXm9hlPM5AAhcrkVJ4GYkmG0iMVaaQU48rF-JvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjr5NXhCXnQU7f3v0krI8Cm5KRXCApDE6Ws-rSx4uBEg&oe=6AAABAA7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34615430358101354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619832_870501819345777_3504912236659634520_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCCIm70ib-QQ7kNvwHH4l9u&_nc_oc=AdrbGuiZ11mL9AA6XjOTJaUFb90t2Td-J_mlolvyPKyF34e2XJDQGS_j5VrIEcX9rko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1EEMziY78jcqAHHqIGFTwSgbzrKwHggVWMU6lxK7afQ&oe=6AAAA890"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Zombie VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1775102640, "lastRevision": {"nodes": [{"id": "346154304281013
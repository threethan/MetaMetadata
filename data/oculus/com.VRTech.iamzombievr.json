LeSVSLQ2KBNWx9IkDII56yOZMo8IrbIfg&oe=69F888DD"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhaPDuFHqV4Q7kNvwEpSM6h&_nc_oc=Adoh0luxDDQR-XxiQ4QmSbzM29POVwFTX_jEn4J4jSjYLeqUE415rN3y6h9uxBF8lDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33yOTHIjh1uQfJxBnk6HORz8GpWEkUP-SzBxl7qC7dlA&oe=69F88AE9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El3H0lH0qKcQ7kNvwFL6m6c&_nc_oc=AdpUcfNWUIPBk_rwJ6As22jhqVXWT0cNIpun6zzvvxGlbO4OYyYpSEQD1tnliLHOp3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JkCf0wN7BbkE-l6WMt9iq8m8p9WftOpNE_f9vDLJzhA&oe=69F89715"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sICipI2bVoQ7kNvwGSe32s&_nc_oc=Adrh7WrpkLzHs62y9f1DpLJu_DvFhowdptxuDMp6maF0wf8uKEo5aCLEO80suenpee4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pNoOcf3pbaB3LZyAt_6W24MyD2UuM7e9Zxs8n8_ykLA&oe=69F8AD68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eulwErmwHCAQ7kNvwHJbXb1&_nc_oc=AdqX4EoJTB6VL2I5jPm0M4dH8_-x0EqISjvD63FHlfQkHSJdDoos3RfWp2sniak1w2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cGPmLugbfPfUMRASWNMgh0Tf6KPD3FDHc1lB3K7BPTw&oe=69F8C027"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres"
iO9H78RUuwwcj9j_JkXRitzt7N7Jmrkf5kqNu2bqpjTuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQG_RPSPE34NJwpuHPlne12qw9GxQGwTT8af6e8MTzPg&oe=6AF7329D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIhxHMrRs2EQ7kNvwHoslZM&_nc_oc=AdrhWgeHTAS9HOABdN1yCFAajBGU6R5aeD3llCF0U9yuVlbmiCkRiR4mmktbKVnucTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsNOtrmnpbstugJgYFqglSLmo4wrdhqACE2H9zW6ZS3g&oe=6AF734A9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y04vyFPWHPwQ7kNvwHwdyjw&_nc_oc=Adq-G3IG0yCUkzxtSKIZZM6ODie8woJc3xRe9KLh0Z-w8wIwJUHX3GqQHUBDiZsOJWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhKSel_6nTRGsnyDaSWloNy_nrLdvu4f01xLA0Zp-EHw&oe=6AF740D5"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxjfsX4pWdgQ7kNvwHeAmIF&_nc_oc=AdosoCz54hnPN7cetX_WJzOQJWep-zaHahKq09Pj2gDs1zkS4OGaJOLdYTQ26_UQOqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnHoWcg2QGJfi6JYf2lSYDn7C6jcp1FtUwULDq64b9_Q&oe=6AF71EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5vJAzgCCogQ7kNvwGeh3Cb&_nc_oc=Adp-lSyb3KNwZ5xfPvVp12IFhdw3jkDMgJKrDJ6_tCTTrLTTqOi3Hh3JC97F2rX7OBQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV0sqy1dnkbsdZEgMCAc19QiteuOho1uxHH91xWdLqQw&oe=6AF731A7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
Dq6OYjfHf9mnC8pMQLkUd-feLMVLVyGXymgXEfLxpYIk2u4q8788NJ0yYA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_r4onIEwAdFgvfXvZO8QHEXKGOyxWQyhxTQ96t7670Q&oe=6AAEB01D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ1LTQ7jZQUQ7kNvwFZn2l4&_nc_oc=AdriBMOY6JAr5pjLoCR26Wh13qL2KetdDy1QNZ0IdM9cNbXY1faH0-CcwZswRXjFdO8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlAVsUB4MMy7YJkwAXuu2FP5Aq1kgGXyN2j3RNbJdB9g&oe=6AAEB229"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewO8qTCH_hAQ7kNvwEq4rXp&_nc_oc=AdpBKvBpE356uLpXXkeOI9ftANLzYZYd9iWBwXGpuqHxTMo_NqI-7fA9thjfF_GqRuU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFnJHuRcl75dXlQBE0xGXEr75Vp1Q3vIDoQoHi_NXA3A&oe=6AAE8615"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRJ-DKIrBwEQ7kNvwEXhgTl&_nc_oc=AdrHabJ-XN7fUGVjsYiGuTt0HI_Z-kVsoWXfX9QlODtd0RGOtBxsO5Yh1s91ou-rq4I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJekQHsKUF5ORXYHRUSBwltOOyZZYjfI5uk5tVnimPsYA&oe=6AAE9C68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxyDbBTXOVMQ7kNvwG3GewB&_nc_oc=AdrbKhca2qyceeAW9VoXvRSssb603zfhyt4OR0KTByzPYSmOx2_6hMZkTySLeW_GKtU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPsdLTDKbD6O2Rb03qieFekAOQt_8GBxXXHLyss7ALXA&oe=6AAEAF27"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
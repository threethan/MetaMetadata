QrL_3kbtHVOu4HDCWXKtRefIIUyVSxhXw&oe=6A972D5D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThA5Pzi_5ssQ7kNvwH38OMH&_nc_oc=Ados5T38rmsiElwwG797E9cu6uM0q6gQUqX84FQ3q95g8z24d7BAbid0WdpEWHJ49M4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUugyAfkPRuJa6SnhsI2MSjfHtivt_ciu2RGMne589wA&oe=6A972F69"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OElqxFZXWhAQ7kNvwE3Sleg&_nc_oc=Ado0r7Z9lUMFtNG-Whl38xPii5fU3d_v0Mn1ddURzSp5xkv282Ol4kl2spQwM8vrBYE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG29U-P8tgCCOmA8S-AGu6kQbw1nOe_9LseKcHXoBxpAw&oe=6A973B95"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvCzG8rCACcQ7kNvwFppTwq&_nc_oc=Adpcu2xlLoHjMrwmqKQs7kz-ZWiVglVvZFOIiBAoopQo-nFA9MVbwbSGvzrlZ8pMpNA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXf_wlxge5oLnEojE4xzg8ai0f3i5OxmCdgB4p4nCI1Q&oe=6A9751E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgUmTqcmSLIQ7kNvwHw6csY&_nc_oc=AdquyNS8aeE7cc3dN-chDkD9ujqPw8V-i-kuXC67cJYFjxVTiU65cUEgTv2ALxX0pKw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvQb8ImCw4S4-n8HG3WSIJjTLXGpRD03qFspxHk7gEbA&oe=6A972C67"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres"
tBi9bVwgW_tEhrjuv7pSMu7p1c5rUrokA&oe=6A30201D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHMwCGzWn0sQ7kNvwHfMxYA&_nc_oc=AdoBmLSc7syq6DKclHnB3Nr_42cSg5u54Z4D_xEkjb8H7QjGy5JTm5xev2AHm2DTWhA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EhOvT091Tsrbpnva3WreMrExE_zHIzEnXVAuPI4CWYg&oe=6A302229"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ6Tdp-Iw4kQ7kNvwFd-MP2&_nc_oc=Adr00m7WWHVoMpazHNfmtQZ8Xoe9ph9NW4PN_sk9FtASySc4nDhUWxO2f8Ks5lesPzk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fQR13tMELGKB0_k96MIV3w2A-omuKwEb6JB5MXnMa8A&oe=6A2FF615"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgvRy5gxw3sQ7kNvwELBOVN&_nc_oc=AdpaiCxPBxyj3JF3G3_Hng0L5496EcCJWXvtZzWWVIIPTXJA9sImjp8_h6_SM1oS7HE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mStpZ3Y49Xzqxl51blgAYVSTu4m8IfrD8Wxm02J1wrw&oe=6A300C68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRQRisE4mMAQ7kNvwGapaMW&_nc_oc=Adpxcr7qv2GozExjOgyqa7T5-dTWymUwPptLrMou3j_BCwV_U8dpuwhEalYzg_0A40U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g8YWY86thhq9YBZDev91VSlL6N6OLn83wAmBX41ZSpA&oe=6A301F27"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres"
ygARipxu-cC_8Jdb0Lh25M-qCPnnBIO5Zvseq4ebgERxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw-FRFtsNJ1Zn8dSIaUCoaOGdIuDUigymn_AzP_RqHFQ&oe=6AE4BD9D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHiDD9UgxZAQ7kNvwEqFc_E&_nc_oc=AdqnkZYJdZ5Q5aa5S_6Hh_suyaW7w6Sn6acudAKst3W1JI3RQq_osy7Wt6nGOFU8YQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPluEDURd27fdBz9Zi7rvo37Supvg4WXP1w6jpxpTR0rw&oe=6AE4BFA9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMITzak5qO8Q7kNvwGdi8Qq&_nc_oc=Adp7E7uMdpuJZHRNjcCTlMHB_zlkZX9_xWQeqizBg00Zq2O_keIiCHHE2lR6ocQPqnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNAgRNh3hk3sL1-OTvEe6FJfTKHsOOIAlutIJGhYfD5Q&oe=6AE49395"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3Hl7dL3yp0Q7kNvwEAGDZz&_nc_oc=Ado6IEn0CdYq3lfKENO-dX0ozs7Zbo_sOrNxcaASKPLZq72BbvDQr2B-8KNxNCMK9Zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOShxHg2TVGe_RC4sGspy6N1lf_Q6cjH4vln17Okd87zw&oe=6AE4A9E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0LJzh8nEYAQ7kNvwEGF0aU&_nc_oc=AdoowHIEDS96f8FSp8c2ReqyAmaCXtGqqyJ5SwsgjASS7kKGIndsL5EEwt79yc3OfWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1o4865mdOPTZbaim7W0gxDCKkQ73DmwhOHWwXQWDhCw&oe=6AE4BCA7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
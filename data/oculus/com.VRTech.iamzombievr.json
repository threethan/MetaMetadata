4m0KulERo8OXhLgQfOawKkI3u4P3zYDXOTxSLVHsf2IVl3DEblYNmqQ870&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVV0oDxKOI3wf2kXeSW6g7flOUYF-2lStJDT61zCU7oA&oe=6AA4241D"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdF3RDSpWLoQ7kNvwEN419X&_nc_oc=AdqIiwtC03qab9JTg6mmYPyzo00kvd0PL4ERRlDhMquYgrO_7vUDbt9wT4grzCsMUJg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2k28TG9ytqiHXCSVcWA-9KQFVkr3jlP46TZTNvapkMg&oe=6AA3EDE9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSoWqDVfG6UQ7kNvwEjHXNU&_nc_oc=AdreaHXMcB73UMfHiRhTHvO3d3bGVFIRwt_REfbCLaGVxtxPV13owTkUCaTUMBZRIzw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxGvpnetetAtwBDROIYR08ZOBgSFW2mnGs9WmsLW_WsA&oe=6AA3FA15"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybHfRQPLix0Q7kNvwFxexlZ&_nc_oc=AdpL80Isy5uocwjV8tTOplieDgzfmy3lw7XEsD84CADV8-aEX-zgED_h3FzcKLSjP3M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXjJLbwkBRjIIxb-w45w5bJhj8ywiquEH0J_3x7s8nlQ&oe=6AA41068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAn5QlPc0YUQ7kNvwEcyhbn&_nc_oc=Adr4CkEmuWl52KCRIw_BxHRy7p-QDVhLiCnJzixCqXwJ-TKZMIwyGAg77h7B7npi1UY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUNpllckD27ydn1lKrjrZOMc3EJ-qT8ddygNvJAWdhOg&oe=6AA42327"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
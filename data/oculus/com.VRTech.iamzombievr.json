NuXDkv57DH2HjiAVYPGrEUkDxMtIitciw&oe=6A69E9DD"}, {"file_name": "Screenshots (1).png", "id": "1428232985089879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_1428232988423212_1759484633922606531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoCuZSOhW1MQ7kNvwFmM6ma&_nc_oc=AdrSSeSvaPS_pPSX8Ki-CeH0Detk5IGJMaDbLCR7oLG3Wy3sVSUIOPQ3aMiOTFT98Hc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpZMRwA1AWASV4GISpOCAUM32GhVgPoOAP0UxPvxjNTw&oe=6A69EBE9"}, {"file_name": "Screenshots (2).png", "id": "1363438795589422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619594_1363438798922755_9161248500125076003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEQQQh3q3BIQ7kNvwEmgXOm&_nc_oc=AdpuH7m8EKQIDC1TD0pFMN26gqDzizpueCH9dsoyug8HUCBuySrRwN5jwKdJMwFW10k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd9z3bCB5aGuYQ9EEtsR_RJ0IlEa9WDK9r1aSuVtAeFQ&oe=6A69F815"}, {"file_name": "Screenshots (3).png", "id": "1441759450756230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_1441759454089563_5831044336473974921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P5Y5z1ACLkQ7kNvwEXeRN0&_nc_oc=AdpN1p4a6uXRub3dJt4JjlIJe_-kvWjmU5DpKv8R834l8Ds4-KAm8dmnVFW-dqKCtds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAvamm6eIk9qFy8brEbLZnhyf1At8wrF5vOe-czZMBKA&oe=6A6A0E68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landsacpe.png", "id": "1368326505327967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_1368326508661300_1627871630264978088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOEbfKCQPs0Q7kNvwGrnUj1&_nc_oc=Adq-hD0iQXoemOKJaBP1fq74fLC_ZhfXDR3nIEjcEiTuV7DK7Bjg3dv-wE62L5WSweI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrqO8zr2B4fL_6cvjcP0PkTOZ2xCD629tuX2iO3k68IA&oe=6A69E8E7"}, "display_name": "I Am Zombie VR", "keywords": ["zombie", "action", "simulator"], "long_description": "I Am Zombie VR is a fast-paced VR action game where you become the zombie.\n\nEnter a dangerous laboratory outbreak and hunt down terrified humans from a first-person perspective. Use your hands to grab, chase, and infect your targets as chaos spreads through a stylized sci-fi lab. Every moment is built for immersive VR gameplay\u2014feel the tension as victims run, panic, and try to escape.\n\nDesigned for accessibility and fun, the game blends cartoon-style visuals with intense action. Easy to pick up, hard to master\u2014perfect for both casual players and VR enthusiasts looking for a unique role reversal experience.\n\n\ud83d\udd25 Key Features:\n\nBe the zombie in a true first-person VR experience\nGrab, chase, and infect humans with intuitive controls\nDynamic NPC reactions: fear, panic, and escape behaviors\nStylized laboratory environment with biohazard theme\nFast, replayable arcade gameplay loops\nOptimized for smooth and comfortable VR play\n\nWhether you're looking for a fun VR action game, a unique zombie simulator, or a fresh horror-inspired experience\u2014I Am Zombie VR delivers thrilling gameplay with a playful twist.\n\nInfect. Chase. Dominate.", "short_description": "Become the hunter in I Am Zombie VR. Chase terrified humans through a chaotic lab, infect, grab, and turn them into zombies. Use your hands to interact, hunt, and spread the outbreak in a fast-paced, cartoon-style VR experience full of tension, action, and dark humor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres"
3_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr4xJDGBJjEQ7kNvwFs7ppo&_nc_oc=AdrlvelKZfziY1jHkffSC3te9LNqk5v6Sb8aovFKjnIJOAaSDDBEzErqva7tMocRGK0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4OW-CmIFvybDn-OSTcLw5wdrueKylbYZexwUYWiw6WQ&oe=6ADCB6DC"}, {"file_name": "Movie_020.00_00_37_14.Still014.png", "id": "651687707182852", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974778_651687710516185_5385406890132925778_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2TFuo1TwpYQ7kNvwFBJp2m&_nc_oc=AdoaQwDLDkUgwdLPChKcz3jCPwWT_TUqFRR8mvev6xOulQHZDeQSuZNIfk2oupMTet4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4cBI3GyOha-WrJX461eIedg8o9CRj4Qm_CSPyLvjrHw&oe=6ADCA916"}, {"file_name": "Movie_020.00_00_01_19.Still001.png", "id": "28007075815605168", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86634396_28007075822271834_7255437752662035665_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=av3NJGZlc-0Q7kNvwH0CVz5&_nc_oc=AdqOwQ9lthWNJoCWYIEbXqcSX0B2b12NMMR76MvQBX7yBFfvLXZe8yiWjqhpJi0G7Y0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv4tFCO7WmWo1TjL7qz70iqAKYpAM2y2oIpNZiGHfh-g&oe=6ADCCEA3"}, {"file_name": "Movie_020.00_00_06_24.Still003.png", "id": "1294216188579812", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203626_1294216191913145_6488011176947402908_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2Y9cSYL6jkQ7kNvwGgNZmG&_nc_oc=AdpiHxJ3t47Qzcf2RdLXnDRsosKL0bmKEaEif78DyiqfzpYIIJ31efv49bNRc0yHsBU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsWVUQId6QkRpyfjuDA6T-93CA9IxRwixuVL8jay0Kgg&oe=6ADCCED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1140.png", "id": "1107926010992482", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75514542_1107926014325815_6730707163201477685_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74Vb9Oh4bWYQ7kNvwFNiCqp&_nc_oc=AdpnmbQ8j5SmRDf8OCfCYAarGi09tGKNCLIWgBL8NC4hbhHcz-QIiQStxcdnzckx454&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdetiJfDQvEzUWReedGe3-Y9MLJNM_3Mpx1X3PA_o5lw&oe=6ADCCB36"}, "display_name": "Eternal Strike", "keywords": ["Game", "Shooter", "FPS", "Gun", "Battle"], "long_description": "Eternal Strike Shooter offers an adrenaline-filled, non-stop action experience. You'll step into the shoes of a skilled fighter, battling to survive in a world overrun by ruthless enemies. Armed with powerful weapons and tactical upgrades, you're ready for anything\u2014because danger is always around the corner!\n\nThe game features a range of levels, each with its own unique challenges, environments, and epic boss fights. You can customize your character, unlock new gear, and refine your combat skills as you progress. Whether you're battling through futuristic cities or war-torn landscapes, you'll need quick reflexes and solid strategies to stay on top. If you love action-packed shooters, Eternal Strike Shooter is your ultimate test. Stay sharp, keep your aim steady, and fight to become the best fighter out there!", "short_description": "Eternal Strike Shooter is a fast-paced action game where you fight off endless waves of enemies. With various weapons, powerful upgrades, and intense combat, you'll need to master your aim and strategy to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "
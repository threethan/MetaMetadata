uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75514542_1107926014325815_6730707163201477685_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjEwjQzQB4kQ7kNvwHadis1&_nc_oc=AdrX39K4EHKV8Ub4YYNxhuLxKBfatQVf259ENsE8X9_8wbm8CpR4NdIbwhPapCDNKDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6FKe2MHgptUhtcUD9Bh2hed6N5F7zIdGElW_dG4sQxw&oe=6A316836"}, "display_name": "Eternal Strike", "keywords": ["Game", "Shooter", "FPS", "Gun", "Battle"], "long_description": "Eternal Strike Shooter offers an adrenaline-filled, non-stop action experience. You'll step into the shoes of a skilled fighter, battling to survive in a world overrun by ruthless enemies. Armed with powerful weapons and tactical upgrades, you're ready for anything\u2014because danger is always around the corner!\n\nThe game features a range of levels, each with its own unique challenges, environments, and epic boss fights. You can customize your character, unlock new gear, and refine your combat skills as you progress. Whether you're battling through futuristic cities or war-torn landscapes, you'll need quick reflexes and solid strategies to stay on top. If you love action-packed shooters, Eternal Strike Shooter is your ultimate test. Stay sharp, keep your aim steady, and fight to become the best fighter out there!", "short_description": "Eternal Strike Shooter is a fast-paced action game where you fight off endless waves of enemies. With various weapons, powerful upgrades, and intense combat, you'll need to master your aim and strategy to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440400
PGfMva1mnoCuX6VhuxXtIWnhDZIxw5LA&oe=6AC3C223"}, {"file_name": "Movie_020.00_00_06_24.Still003.png", "id": "1294216188579812", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203626_1294216191913145_6488011176947402908_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vok6qee-Dt0Q7kNvwFlh70b&_nc_oc=AdquxdX-s6snjl5XQ6Gt4_V0inuvxFJMYDUMwWg_jg1ejq6YaYEbjtbcMyRLRLPGYb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN8p7EKNOKtHn7caHktLdOxl0h-aYGpKSPsMF_IVgtxg&oe=6AC3C255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1140.png", "id": "1107926010992482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75514542_1107926014325815_6730707163201477685_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56s26V1kOdAQ7kNvwHw1Krt&_nc_oc=Adr_m-kB8GXQPqAEQbSBZk5sDAmHHUWppYokZFYkeuU_u2HWLxS4-XsF1wCae0U-9nQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXlXnjJW5tcCEEgSeGUuwJ6r7oTI_6hT6zdRnG34ds_Q&oe=6AC3BEB6"}, "display_name": "Eternal Strike", "keywords": ["Game", "Shooter", "FPS", "Gun", "Battle"], "long_description": "Eternal Strike Shooter offers an adrenaline-filled, non-stop action experience. You'll step into the shoes of a skilled fighter, battling to survive in a world overrun by ruthless enemies. Armed with powerful weapons and tactical upgrades, you're ready for anything\u2014because danger is always around the corner!\n\nThe game features a range of levels, each with its own unique challenges, environments, and epic boss fights. You can customize your character, unlock new gear, and refine your combat skills as you progress. Whether you're battling through futuristic cities or war-torn landscapes, you'll need quick reflexes and solid strategies to stay on top. If you love action-packed shooters, Eternal Strike Shooter is your ultimate test. Stay sharp, keep your aim steady, and fight to become the best fighter out there!", "short_description": "Eternal Strike Shooter is a fast-paced action game where you fight off endless waves of enemies. With various weapons, powerful upgrades, and intense combat, you'll need to master your aim and strategy to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8651103948331244"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "967272615632698"}, {"status": "PUBLISHED", "id": "747046851658728"}, {"status": "PUBLISHED", "id": "1235863414814902"}, {"status": "PUBLISHED", "id": "849425464044326"}, {"status": "PUBLISHED", "id": "1418168899152193"}, {"status": "PUBLISHED", "id": "1302111327596604"}, {"status": "PUBLISHED", "id": "974288381225989"}]}, "baseline_offer": {"id": "974288381225989"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "967272615632698"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8656613774446928", "version": "0.3"}, "id": "584283750897472", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false
zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrHZ-qcubBux2Kz1KddPj6nd8XZ7dmHBAR1jNra2A-IA&oe=6AA000BE"}, {"file_name": "Screenshot_2026-05-14_at_14_33_36.png", "id": "1081579167761411", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507818746_1081579171094744_2756916301973370765_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n9s_gdvy0EQ7kNvwEMY_iV&_nc_oc=Adr2NxOHUkvXRyrKVJTs7oAjNEQFuHEvIjwaWYKy6NIUq2X_ItdYITFccAR9yjEoWNg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYZ4xOVlWB_fwH1FQlXotNExQbLBaqZBVrop5XfJM9-Q&oe=6A9FFE44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "2901947096820583", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313390_2901947100153916_6804306837384425217_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Eo9MwyczIkQ7kNvwE1ZqI_&_nc_oc=AdoNsgXjcdacIXkO5eHogmEQac8bWw1uaO9ma0CMsWbbJ6A__dg4taScf5Lxl5QiJmE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkfSj8kXIuDJ9nDmSvAMva8MsTk1kaqqcJA1h_RPDOmw&oe=6AA00496"}, "display_name": "Bad Grip Club Demo", "keywords": [], "long_description": "This demo includes one of the four biomes from the full game \u2014 a first taste of the climb.\n\nBad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope.\n\nVR IMMERSIVE CLIMBING\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive \u2014 and comical \u2014 crash landing!\n\nCO-OP & CROSSPLAY\n\nTeam up with friends playing in VR or on a regular PC screen. Coordinate via voice chat, share items, and pull your friends up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n\nNEVER THE SAME CLIMB\n\nEvery climb feels fresh thanks to unpredictable physics and randomized loot along the way. Chug an energy drink for a stamina boost, use handy items to cross gaps, or take a break to roast sausages at camp.", "short_description": "Ready for the full adventure?\nSearch for \"Bad Grip Club\" in the Meta Horizon Store, add the full game to your wishlist, and continue your journey when it launches.\nThis demo drops you into one of the game's four biomes. Climb a cartoonish mountain in VR with crossplay co-op, where physical grip and teamwork are your only hope. Grab quirky items, pull your friends up, and see how high your squad can get."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "1030018393254984"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1648700580157936"}]}, "baseline_offer": {"id": "1648700580157936"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787227200, "status": "PUBLISHED", "id": "1648700580157936"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
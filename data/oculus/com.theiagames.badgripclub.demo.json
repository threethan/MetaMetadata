CN&_nc_oc=AdrRAbtskNnIlgnXh3LkRHGHvhrbnYOXKalFyrAAIqfnhffIclyzciUBx5BxnhLRCpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIjALJVSKYVMq9uJ3ge8Snya6Mdfh2jki3GkGF6AjOEA&oe=6ABFBB78"}, {"file_name": "Screenshot_2026-05-14_at_14_34_36.png", "id": "2078320672809547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312422_2078320676142880_5900716451868572728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD0ULhkn75cQ7kNvwE_GSNC&_nc_oc=AdpT51B28zVOYr1aDUWVGMtfns4_W603vuo7S1DraFEE94bALARGX9bjsVG7jHA1Bgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMoIc8d1Zqe99S0ySnRIpMJ39cJP_YqaTRq4GojMTD5w&oe=6ABFDB7C"}, {"file_name": "Screenshot_2026-05-14_at_14_33_57.png", "id": "1008212938912033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310734_1008212942245366_5067895921345648457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9AAMsJLHPAQ7kNvwErbwDZ&_nc_oc=AdolZVMxPA5n2xU-jfBB4z6W-F8Rmya1NMraa8Fm-I59fQ6gTkyh5w71gAlGhZ3nuMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN3reRg1dDoge98CGZXkC-1v8AjdBNLvFQ_pem1SCguA&oe=6ABFD2E0"}, {"file_name": "Screenshot_2026-05-14_at_14_31_55.png", "id": "1039622001782208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1039622005115541_3228147398385558470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Lr7NZfNPzIQ7kNvwHU9ewL&_nc_oc=AdrlSLNPT5naDdJCFTMhG45Yj2EcR3Chg3gt_2XV0k7DgLcr0jbyFNBhv4GM8a9FBn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMXmNziuB_VdQrUwQQg2LidgecQ2QIEY4If45D7piVGQ&oe=6ABFDCFE"}, {"file_name": "Screenshot_2026-05-14_at_14_33_36.png", "id": "1081579167761411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1081579171094744_2756916301973370765_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TfEUQUaevgQ7kNvwGvnaz-&_nc_oc=Adr66H4ZR-VX_ViaZmKJRoW1cmHPCgh2p5bre1C-GxvvmuqzKN2E_sZDuHULTS62rkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhm3M4_-jdRdR-vGLzBMnYS38hxIK7Se1gt5pcgB0R-A&oe=6ABFDA84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "2901947096820583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_2901947100153916_6804306837384425217_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7WLwcvzFZYQ7kNvwFEyY0z&_nc_oc=Adrv9B1UDkV6THCXnZo2855-9vIw-y4y1PEWjXF2gptAQihOLQ0oRKeJEQPe2Au4Fc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2xGVmwXtfKOFvkzayY-s_Wyslaces8YMlEm14VsmzxA&oe=6ABFA896"}, "display_name": "Bad Grip Club Demo", "keywords": [], "long_description": "This demo includes one of the four biomes from the full game \u2014 a first taste of the climb.\n\nBad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope.\n\nVR IMMERSIVE CLIMBING\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive \u2014 and comical \u2014 crash landing!\n\nCO-OP & CROSSPLAY\n\nTeam up with friends playing in VR or on a regular PC screen. Coordinate via voice chat, share items, and pull your friends up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n\nNEVER THE SAME CLIMB\n\nEvery climb feels fresh thanks to unpredictable physics and randomized loot along the way. Chug an energy drink for a stamina boost, use handy items to cross gaps, or take a break to roast sausages at camp.", "short_description": "Ready for the full adventure?\nSearch for \"Bad Grip Club\" in the Meta Horizon Store, add the full game to your wishlist, and continue your journey when it launches.\nThis demo drops you into one of the game's four biomes. Climb a cartoonish mountain in VR with crossplay co-op, where physical grip and teamwork are your only hope. Grab quirky items, pull your friends up, and see how high your squad can get."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "1030018393254984"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1648700580157936"}]}, "baseline_offer": {"id": "1648700580157936"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787227200, "status": "PUBLISHED", "id": "1648700580157936"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1070915535831936", "version": "1.0"}, "id": "1671291197271554", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1030018389921651", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1070915535831936"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "167129119
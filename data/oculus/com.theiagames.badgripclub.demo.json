qr&_nc_oc=AdrT7qkBwdiGgU9_gxj2UCfhLH3EkFQiOH_7AreLhjA1wUemuCP1suvDNQHKIu934QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr3_zHJTaZjCUBQoAWrydYeEScpT840aTmxAWGEn36XA&oe=6AC25E78"}, {"file_name": "Screenshot_2026-05-14_at_14_34_36.png", "id": "2078320672809547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312422_2078320676142880_5900716451868572728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg9OhGs7FQYQ7kNvwEI4kC_&_nc_oc=AdqtaHDZQqjEKB2Lvuq3FdqXTNcUUxn0zcsSyJTYKFrIhi8ZVyMcKooHhKAYK7TLQaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbL5b1cxNXu1IzL6gMMAIa23R-hzFH5PS5VnooiSHN6g&oe=6AC27E7C"}, {"file_name": "Screenshot_2026-05-14_at_14_33_57.png", "id": "1008212938912033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310734_1008212942245366_5067895921345648457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RJ6EzzK3z0Q7kNvwEOZRRj&_nc_oc=Adq4td9JEqcgStJKA3KCPESALr64AK9eI-3ROmQJrYbNJvdKqm3wY5R22zUjSMIQ5U0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKh5z86i4G-dHM0Q7Yfzd4ldZ7lsLmrv6vso8QPKOTVw&oe=6AC275E0"}, {"file_name": "Screenshot_2026-05-14_at_14_31_55.png", "id": "1039622001782208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310734_1039622005115541_3228147398385558470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxVPWXWrMnMQ7kNvwFfzW5o&_nc_oc=AdodQCVih2IvAj6zcxbCxXWD295MLCTDHtqcFe1wjQrs_ZbcLxvEMk-Q11lbVcYz3cU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr-sgSezuWghX6Z1iF6rs41tj0fK69ejyMbfxqfmki2g&oe=6AC27FFE"}, {"file_name": "Screenshot_2026-05-14_at_14_33_36.png", "id": "1081579167761411", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507818746_1081579171094744_2756916301973370765_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TfEUQUaevgQ7kNvwG7QJ0M&_nc_oc=AdoFQ226l9O3aUdPvWQ1QhRCxAEXZOdkRLhLeny11_uwKeIult4PmYEqa_pmZVNoMro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbsa_T1cV92VL1d-fpt6NtiMqJo_meLFRFeyS_YtloUQ&oe=6AC27D84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGCVR_Thumbnail_Meta_2560x1440_english.png", "id": "2901947096820583", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313390_2901947100153916_6804306837384425217_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7WLwcvzFZYQ7kNvwE-OK17&_nc_oc=AdrhvovOepdvN20wdjcHr712GnZfzA3xEv3PDue0-a72WXdlDAOWLYECxHT01FL5GK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWt9Fih70SkAp921zLGO2p7yknB4EM8poMCHVqMdA7zQ&oe=6AC283D6"}, "display_name": "Bad Grip Club Demo", "keywords": [], "long_description": "This demo includes one of the four biomes from the full game \u2014 a first taste of the climb.\n\nBad Grip Club is a physics-based co-op climbing game for VR with crossplay. Climb a cartoonish mountain where physical grip and teamwork are your only hope.\n\nVR IMMERSIVE CLIMBING\n\nFeel the height and the risk of falling as you climb using your actual hands. Grab ledges, hold your grip, and recover from slips. If you do lose your hold, expect an immersive \u2014 and comical \u2014 crash landing!\n\nCO-OP & CROSSPLAY\n\nTeam up with friends playing in VR or on a regular PC screen. Coordinate via voice chat, share items, and pull your friends up difficult cliffs. Just be careful not to accidentally drag your whole squad down into the abyss.\n\nNEVER THE SAME CLIMB\n\nEvery climb feels fresh thanks to unpredictable physics and randomized loot along the way. Chug an energy drink for a stamina boost, use handy items to cross gaps, or take a break to roast sausages at camp.", "short_description": "Ready for the full adventure?\nSearch for \"Bad Grip Club\" in the Meta Horizon Store, add the full game to your wishlist, and continue your journey when it launches.\nThis demo drops you into one of the game's four biomes. Climb a cartoonish mountain in VR with crossplay co-op, where physical grip and teamwork are your only hope. Grab quirky items, pull your friends up, and see how high your squad can get."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polden.gg/policy", "developer_terms_of_service_url": null, "publisher_name": "Polden Publishing", "support_website_url": null, "website_url": "https://www.polden.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "1030018393254984"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1648700580157936"}]}, "baseline_offer": {"id": "1648700580157936"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787227200, "status": "PUBLISHED", "id": "1648700580157936"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1070915535831936", "version": "1.0"}, "id": "1671291197271554", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1030018389921651", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1070915535831936"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "167129119
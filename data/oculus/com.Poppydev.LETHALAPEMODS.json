ntent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwE3hQs0rwWOgjXwhQ5YYVfY0zcN057E0m0suMZK2rfQ&oe=6AE36430"}, {"file_name": "0_Custom..._21.06.2026_14-20-29.png", "id": "1376406534460501", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823757_1376406537793834_6308083808288924456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnUSuQ4THw8Q7kNvwEJZLB_&_nc_oc=Adpg0y1eTLP5z6ADXIx78dQV1zDcIzAhuKWlwlHAM0iRwisXQ-lbEA3-4DGG4hq5YU8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7V2Ffhb8wzdYzEQc9sZtyKXNX0Ai1maUUgXfy8W5noA&oe=6AE36B09"}, {"file_name": "0_Custom..._21.06.2026_14-20-42.png", "id": "1832375461462474", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823366_1832375468129140_1991501487540576659_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3Y0KN630o4Q7kNvwHj9drI&_nc_oc=AdpdqjXnlptxyO-v6iI8z71zzt-l8BdbaXfIhibISBUCoXj3iP3E6svFbnqIZUbGwsA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTLjBQBHBNsYFnEG-gUDI_WqcWGSU3gfbtGv4TIarGAQ&oe=6AE36D21"}, {"file_name": "0_Custom..._21.06.2026_14-20-24.png", "id": "1696338491656152", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827567_1696338501656151_3205278467928660406_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIts_7Ye2j8Q7kNvwEL-SVr&_nc_oc=AdrvSPYWYW-fWOAOW6lE3MtE1ium6psta_U0biBGvdTSCQIvvzYfP9pptNqY96agEro&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN00uBvsEZOBukCVQlAbJrDAwItVkZxTp8DLUsG1hP4gg&oe=6AE34499"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Brick", "keywords": ["lethalbrick", "lethal", "brick", "Horror"], "long_description": "\ud83e\uddf1 Lethal Brick\n\nLethal Brick is a creepy brick-styled VR horror game where the walls may look playful, but something much darker is hiding inside.\n\nEnter a mysterious abandoned facility filled with dark corridors, strange rooms, dangerous creatures, and secrets waiting to be discovered. Explore with your friends, stay together, and keep your eyes open\u2014because you never know what could be waiting around the next corner.\n\n\ud83d\udd26 Explore a dark and mysterious facility\n\ud83d\udc79 Survive terrifying creatures and unexpected encounters\n\ud83e\uddf1 Brick-styled world with a unique visual style\n\ud83d\udc65 Play with friends and experience the horror together\n\ud83d\udd0e Discover secrets hidden throughout the facility\n\ud83d\ude31 Stay alert \u2014 danger can be anywhere\n\nWill you escape the facility\u2026 or become another part of it?", "short_description": "\ud83e\uddf1 Lethal Brick\n\nLethal Brick is a creepy brick-styled VR horror game where the walls may look playful, but something much darker is hiding inside."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalbrick/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "grahamvrr", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalbrick/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28380443898306089"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824700_1975653623246621_1046288645653542420_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l6ScLwenvEQ7kNvwFOPUBu&_nc_oc=AdrxEqTVwuCdN5Oe6mybu0YcnANf8
ntent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGPNWPhA3v09WFkBm9hBR8GMuKccdZGSRiAdrgpD8--Q&oe=6AD0EF30"}, {"file_name": "0_Custom..._21.06.2026_14-20-29.png", "id": "1376406534460501", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823757_1376406537793834_6308083808288924456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5wRnPg97FkQ7kNvwGRZ2HE&_nc_oc=AdoCm8OP0n2aRqLkGYQcz4EGyDRasRo5sS4eKBBLuK-M3KlYiGds32ripikXS00Vw4w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy6JFNp-gkH-4HenmSEXfx-hdhJjEATPq-BjTgYmRNlg&oe=6AD0F609"}, {"file_name": "0_Custom..._21.06.2026_14-20-42.png", "id": "1832375461462474", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823366_1832375468129140_1991501487540576659_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K99xBYh6sSgQ7kNvwFl0EpK&_nc_oc=AdrtxhwO5VddYztRpcKgh31v52CWzTDMSFx6_LqN-J5HqQWix3SyMFfbqni9aL8iJZA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6kRbCca4tS8haStTW8HK4aS53Jv49LvYbinSQRLrapQ&oe=6AD0F821"}, {"file_name": "0_Custom..._21.06.2026_14-20-24.png", "id": "1696338491656152", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827567_1696338501656151_3205278467928660406_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9VpMU-rfHEQ7kNvwHtobqB&_nc_oc=Adp2Rep0roSUbztYQZ28ec8Y_6cMq_ifC-RnQj2_2UehxQK8Jt4TZdW-ECf_W-SHRQk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlLNoMQWRVlrUUYz5nwUum7RAWk6heZ4YBx26pgIeCYQ&oe=6AD107D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Brick", "keywords": ["lethalbrick", "lethal", "brick", "Horror"], "long_description": "\ud83e\uddf1 Lethal Brick\n\nLethal Brick is a creepy brick-styled VR horror game where the walls may look playful, but something much darker is hiding inside.\n\nEnter a mysterious abandoned facility filled with dark corridors, strange rooms, dangerous creatures, and secrets waiting to be discovered. Explore with your friends, stay together, and keep your eyes open\u2014because you never know what could be waiting around the next corner.\n\n\ud83d\udd26 Explore a dark and mysterious facility\n\ud83d\udc79 Survive terrifying creatures and unexpected encounters\n\ud83e\uddf1 Brick-styled world with a unique visual style\n\ud83d\udc65 Play with friends and experience the horror together\n\ud83d\udd0e Discover secrets hidden throughout the facility\n\ud83d\ude31 Stay alert \u2014 danger can be anywhere\n\nWill you escape the facility\u2026 or become another part of it?", "short_description": "\ud83e\uddf1 Lethal Brick\n\nLethal Brick is a creepy brick-styled VR horror game where the walls may look playful, but something much darker is hiding inside."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalbrick/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "grahamvrr", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalbrick/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28380443898306089"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824700_1975653623246621_1046288645653542420_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-vuKs13Mm8Q7kNvwE5pqTx&_nc_oc=Adq4iOzP8XNHUmnMHhyW_YtPelNF4
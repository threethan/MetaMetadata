syQXNF5b8H1O9JuMKJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOhdGDTvFeeeCcyRj7Ox1rkpzlmLvDYERS6ls-D0YmZA&oe=6AC669AE"}, {"file_name": "App-Lab-Screenshot1-black.png", "id": "447713064999801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974460_447713071666467_6974512133300380019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyPO74gnYAIQ7kNvwEF2EWB&_nc_oc=AdpGnKhDtUkP6BL995yJ7j-bkM_1Zuq37-IP5DkAkqeNcO5is0rCxxvg1tIkYrPmwik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP30mKu2gyeNH2XdgjmN3yjYpKrFeh2RqLbCVIrBWx50g&oe=6AC65AB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StartVR", "keywords": ["VR", "Player", "Entertainment", "Streaming"], "long_description": "Start loving virtual reality! Welcome to the immersive experience that is StartVR. This comprehensive VR video player works seamlessly with leading VR headsets.  With intuitive design and navigation, get the most from the VR content you love.\n\nYou'll have advanced playback features at your fingertips and engaging options such as passthrough menu, hand tracking and more. Take control over your journey into VR and make StartVR your hub for the the best virtual content.\n\nPlayback supports DLNA, web streaming, AND local files too\nCompletely customizable: adjust every element for your unique preferences\nPlayer is free for all users\n\nDownload our free VR player for streaming the best VR from your favorite websites. Be immersed and enjoy 8K, 3D, 180 experience with StartVR.\n\nPlease send questions and feedback to support@startvr.io", "short_description": "Start Loving Virtual Reality! Download our new, free VR Video Player and enjoy immersive VR videos with StartVR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://startvr.io/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "StartVR", "support_website_url": null, "website_url": "https://startvr.io/", "category": nul
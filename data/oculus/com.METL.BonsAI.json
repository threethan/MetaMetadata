7kNvwHpIr3B&_nc_oc=AdmUWr46JywpH3e1bNuLfjfJ5NlT0Rkp9iyqGkle7JgCkzzZDhZrptTYsNEa6L8lqB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOGGBP9fmOjLwPQKKKcYNZPw__MTEufzq8NEhuuRcVyA&oe=699D9157"}, {"file_name": "DroneVision.png", "id": "1359000001125319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982648_1359000004458652_7227389611288828689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uNXT1bUCjoQ7kNvwFH2fpY&_nc_oc=Adnu6D4Y7kQUnpJtztqpGhwexwgWnVFTILSxTbsnmc_pBTJivbUE8JaODHaIHUMoKqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftIzGbX-QLp4s2w-bpEHXKOFZxk9gAl0y3VjhSCvptrog&oe=699DB262"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo2560x1440.png", "id": "461677318355524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_461677321688857_139602460111776365_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkYP48n_4jIQ7kNvwE0o6l0&_nc_oc=AdlVLJ_gNRgxZcRz1s73EogWWiVmnPQseyIyrVtJaGpfmix6Vn_em2ZNtUVFdmYdv6A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvvgOZ6NyC2-ecJWfnHgj9tW7QjC9-TMZ5PnuZhldcH6g&oe=699DA327"}, "display_name": "BonsAI", "keywords": [], "long_description": "The three of us met for the first time on March 2, 2020 for METL\u2019s inaugural Immersive Media Residency in Winston-Salem, North Carolina. What followed were six months of inspiration, growth, adversity, and the burning desire to make something authentic. \n\nBonsAI came to us roughly two months into our time together, springing from a wish amidst the heaviness of the pandemic: to give folks a memory of saving the world by blending nature and technology. We wanted to provide a radically positive vision of a possible future. Just weeks before, the world shifted to disrupt what we thought our futures would be. ", "short_description": "A novel plant virus threatens the world's vegetation. As the new assistant to a top botanist, you step up to save the day while avoiding the clutches of an evil agribusiness."}]}, "develop
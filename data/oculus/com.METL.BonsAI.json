7kNvwE6AQ7q&_nc_oc=AdoS6xI1uERRotO6E1qjHcyBaUp41AVjD8wZtB4SExBucAk0qj8EEWrgiU4BiUzfiZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af12mcPpzPP_hVeOqZSmJUpQ22JA25xk2-KG48D9J61l5g&oe=69F09FD7"}, {"file_name": "DroneVision.png", "id": "1359000001125319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982648_1359000004458652_7227389611288828689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rij4yAFJjsQ7kNvwHUgapk&_nc_oc=AdoDuepwipmgd2DF_s9kn3Ogp6rBPwznjgc2ZX2F33ixBtKtgz1H7ioddz57fGGsIf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3E3Fi6OjvIgzZT0BGvZMf_ZUd2qqJS45n1Ahmvqbbrmg&oe=69F0C0E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo2560x1440.png", "id": "461677318355524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_461677321688857_139602460111776365_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdPfstbQDcIQ7kNvwEIKfAv&_nc_oc=Ado8KHZDiak0IP2Gf6eRfRsqgVbWhyXJ2sve-BnMpqSCFufl12p_E_bvIe48QIUpz58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0wmG8YWDXo7GrwEfVOKInvIkUsN9k0vTLcXBlhtZSr_w&oe=69F0B1A7"}, "display_name": "BonsAI", "keywords": [], "long_description": "The three of us met for the first time on March 2, 2020 for METL\u2019s inaugural Immersive Media Residency in Winston-Salem, North Carolina. What followed were six months of inspiration, growth, adversity, and the burning desire to make something authentic. \n\nBonsAI came to us roughly two months into our time together, springing from a wish amidst the heaviness of the pandemic: to give folks a memory of saving the world by blending nature and technology. We wanted to provide a radically positive vision of a possible future. Just weeks before, the world shifted to disrupt what we thought our futures would be. ", "short_description": "A novel plant virus threatens the world's vegetation. As the new assistant to a top botanist, you step up to save the day while avoiding the clutches of an evil agribusiness."}]}, "develop
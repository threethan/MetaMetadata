7kNvwHhhyFV&_nc_oc=AdnzXIw_TNAV1-O6VLgMO1KJbxX6jJjZgtDJ9lqg4ZcWYHEdDPyJzm2_nkeqe90ViN0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvjw_-6mVLiMMT-6NUnY3zMxWQHGjbTUz3D3ratdFUvkg&oe=69A57A57"}, {"file_name": "DroneVision.png", "id": "1359000001125319", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982648_1359000004458652_7227389611288828689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_R-eUlMJzYQ7kNvwH7htOL&_nc_oc=Adkr6vaue45RkvdsabHGO5v14-MkoW7oY6zNr7O351COu07X9LfSRbgGHlZqNE5s1P4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuKmcdEjRYX1sBkiZDH8vKp7JxP3dYv86Ug9G7BR-BNpg&oe=69A59B62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo2560x1440.png", "id": "461677318355524", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974864_461677321688857_139602460111776365_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CWOpemqEk4Q7kNvwFEtiIf&_nc_oc=AdnbOCTburNSRb2rT4BpYhT9FJtsunPwUgLILZACLQDWndeEacFjzHLEdiQJDboBi5c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftqwfCHX8n6IPi0gCL-DWTSTx60TZLq187TvFE-W3J16g&oe=69A58C27"}, "display_name": "BonsAI", "keywords": [], "long_description": "The three of us met for the first time on March 2, 2020 for METL\u2019s inaugural Immersive Media Residency in Winston-Salem, North Carolina. What followed were six months of inspiration, growth, adversity, and the burning desire to make something authentic. \n\nBonsAI came to us roughly two months into our time together, springing from a wish amidst the heaviness of the pandemic: to give folks a memory of saving the world by blending nature and technology. We wanted to provide a radically positive vision of a possible future. Just weeks before, the world shifted to disrupt what we thought our futures would be. ", "short_description": "A novel plant virus threatens the world's vegetation. As the new assistant to a top botanist, you step up to save the day while avoiding the clutches of an evil agribusiness."}]}, "develop
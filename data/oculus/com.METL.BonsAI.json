&_nc_ss=7f20f&oh=00_AQB502boVjdAmYqqlgO2E9Lc26xJ2hPrlkvsCa6kDdSj5g&oe=6A5F56FA"}, {"file_name": "Hangar_Blowdelion.png", "id": "429261505187785", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974738_429261508521118_2688888966824031806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rCVJVtbOe4Q7kNvwG8cll6&_nc_oc=AdqIPCyQJIr_CDB0kUotbqaETAsrig3SZDTof00an311cEtbBXD8lTrCto_Ns5YLqFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9qIGK4X4lVLI638MbT_JfvjVScVNCkRTrNR2h-a-qfA&oe=6A5F5DD7"}, {"file_name": "DroneVision.png", "id": "1359000001125319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982648_1359000004458652_7227389611288828689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kigx5FioQvcQ7kNvwF1TGU9&_nc_oc=Adrp28z3PZL1R9h7wTSzLl3aVkoclLjOu40ABvuVUWn7gENPyJpKzX8PYnkgjuo2yhE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNtD45gJMeRn9MlxXPbMjg-RzTyt6yOac-nTQiLu-e9w&oe=6A5F7EE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo2560x1440.png", "id": "461677318355524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_461677321688857_139602460111776365_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUhh89sDQs4Q7kNvwEWyb3R&_nc_oc=AdpgIrWQWcpe_BSLTDH8Syrm5dZNGPI0zRxQ3FzRRNURRcsiG7D1JMH2_9V4lVH2OTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbot--qs9POw6x_lKFTgrBTLElx6myWqtwWmO8DisN1Q&oe=6A5F6FA7"}, "display_name": "BonsAI", "keywords": [], "long_description": "The three of us met for the first time on March 2, 2020 for METL\u2019s inaugural Immersive Media Residency in Winston-Salem, North Carolina. What followed were six months of inspiration, growth, adversity, and the burning desire to make something authentic. \n\nBonsAI came to us roughly two months into our time together, springing from a wish amidst the heaviness of the pandemic: to give folks a memory of saving the world by blending nature and technology. We wanted to provide a radically positive vision of a possible future. Just weeks before, the world shifted to disrupt what we thought our futures would be. ", "short_description": "A novel plant virus threatens the world's vegetation. As the new assistant to a top botanist, you step up to save the day while avoiding the clutches of an evil agribusiness."}]}, "developer_name": "Trent, Alex and Fernando", "developer_privacy_policy_url": "https://sites.google.com/view/bonsaiprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "METL", "support_website_url": null, "website_url": "https://www.uncsa.edu/metl/residency-program/2020-residency.aspx", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "964756971068890"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1502668190118001"}]}, "baseline_offer": {"id": "1502668190118001"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1617669780, "status": "PUBLISHED", "id": "1502668190118001"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6971749946172808", "version": "1.0"}, "id": "1478726018987881", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBin
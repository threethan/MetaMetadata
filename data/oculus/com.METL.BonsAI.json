7kNvwFogQXN&_nc_oc=AdlwWXoF7mSgCajT0mhhm2K686V4Ft05jWuvOcInrRZXfKGZfQ_p0yC2qFBXW7B6iy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5JZXk8KS8PYTomoXtAw2xoG2kUKXhJdejwkvvRSRLcA&oe=69999CD7"}, {"file_name": "DroneVision.png", "id": "1359000001125319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982648_1359000004458652_7227389611288828689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpjhToGr-5sQ7kNvwELPijz&_nc_oc=Admyb2QS6AM79_RGmQUqyP8w2AIy1iG2KsNtghNB7iy9BaJ9wGL7awBIJbyEFBeRk_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftaEepJ_VbagC3CKuqsqmxMdFNOdy5_gPnMdmIlqK1eHg&oe=6999BDE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo2560x1440.png", "id": "461677318355524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_461677321688857_139602460111776365_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlhuSmYfovsQ7kNvwFTEUif&_nc_oc=AdlLtVZfziWs14jVaCs8ICcbG-_Mi5dcMdyDc7jfMSOKe1Su6zBHznSKgGAoT6ZZvVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftYcK09CJ7sK29DDs1H8pMd_4bSDHyAtVL-nk-fgJA9Pw&oe=6999AEA7"}, "display_name": "BonsAI", "keywords": [], "long_description": "The three of us met for the first time on March 2, 2020 for METL\u2019s inaugural Immersive Media Residency in Winston-Salem, North Carolina. What followed were six months of inspiration, growth, adversity, and the burning desire to make something authentic. \n\nBonsAI came to us roughly two months into our time together, springing from a wish amidst the heaviness of the pandemic: to give folks a memory of saving the world by blending nature and technology. We wanted to provide a radically positive vision of a possible future. Just weeks before, the world shifted to disrupt what we thought our futures would be. ", "short_description": "A novel plant virus threatens the world's vegetation. As the new assistant to a top botanist, you step up to save the day while avoiding the clutches of an evil agribusiness."}]}, "develop
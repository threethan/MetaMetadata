7kNvwHGk2WL&_nc_oc=AdlmBlJsnGIW1CKrA22m3Sf-1DLm7HVk3K3U3poWmXtDVOrNw-Gp3nHvQOY9M5EP5IA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfunWFzWFGJuGqTFL3HpolCF93LjuL33AgffjmLlS25T_Q&oe=699C3FD7"}, {"file_name": "DroneVision.png", "id": "1359000001125319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982648_1359000004458652_7227389611288828689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpjhToGr-5sQ7kNvwFzhZEO&_nc_oc=AdnGuL0HWXnIAZBS7lZozNjmkRV_rGWtfkKadtZXkyfP5oDkznwqKGgDN1D37SOVVEY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftapjAy94-2A4f48whe7O5oYeRQc11u1B2PpY1SQXFp0g&oe=699C60E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo2560x1440.png", "id": "461677318355524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_461677321688857_139602460111776365_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkYP48n_4jIQ7kNvwEANRxr&_nc_oc=AdlURtEQ8OLv3qK0SVlfva84Xb3ZVFYBQNAa9DdxPyHs0WwOVYIT0EdkrSXAC80wU-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvBQnZRBTKNXH_CdoY2RCn5-R_8i6TDqmM4JQCnc3N8EA&oe=699C51A7"}, "display_name": "BonsAI", "keywords": [], "long_description": "The three of us met for the first time on March 2, 2020 for METL\u2019s inaugural Immersive Media Residency in Winston-Salem, North Carolina. What followed were six months of inspiration, growth, adversity, and the burning desire to make something authentic. \n\nBonsAI came to us roughly two months into our time together, springing from a wish amidst the heaviness of the pandemic: to give folks a memory of saving the world by blending nature and technology. We wanted to provide a radically positive vision of a possible future. Just weeks before, the world shifted to disrupt what we thought our futures would be. ", "short_description": "A novel plant virus threatens the world's vegetation. As the new assistant to a top botanist, you step up to save the day while avoiding the clutches of an evil agribusiness."}]}, "develop
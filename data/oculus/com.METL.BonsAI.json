7kNvwH7Gmeo&_nc_oc=AdnyJyjAQO4-yjF12WBBZKVdnCabjv9JEd3EKAUjhQVns93ubHFCvYloCQE9jma19SQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfthnMId1bnveFB8rb-INwUqwL4YcyGBr2-3BTrrK7zlMg&oe=699AEE57"}, {"file_name": "DroneVision.png", "id": "1359000001125319", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982648_1359000004458652_7227389611288828689_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpjhToGr-5sQ7kNvwEthPwS&_nc_oc=AdmhwIp-EJgmIXJ3hah8zfT-X2HMY_BoRn0ejMzcmox5TG-3Ae3v9Py2lvhLyB4XlfY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvUegBWpQHg-xBe23MrOvpH8q2I-_oQDyzUpyhBDapulg&oe=699B0F62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo2560x1440.png", "id": "461677318355524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_461677321688857_139602460111776365_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlhuSmYfovsQ7kNvwEkEWQt&_nc_oc=AdnMU6EOzeUHsd13R0EU4odAkIxIvyoKUTJRns7y8bio6XjFxmJTKSEW2fYFR3X13Dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvQtzanmUV72QScdH7wX0HqgWhRKPHeV4um-U0hnHFOdA&oe=699B0027"}, "display_name": "BonsAI", "keywords": [], "long_description": "The three of us met for the first time on March 2, 2020 for METL\u2019s inaugural Immersive Media Residency in Winston-Salem, North Carolina. What followed were six months of inspiration, growth, adversity, and the burning desire to make something authentic. \n\nBonsAI came to us roughly two months into our time together, springing from a wish amidst the heaviness of the pandemic: to give folks a memory of saving the world by blending nature and technology. We wanted to provide a radically positive vision of a possible future. Just weeks before, the world shifted to disrupt what we thought our futures would be. ", "short_description": "A novel plant virus threatens the world's vegetation. As the new assistant to a top botanist, you step up to save the day while avoiding the clutches of an evil agribusiness."}]}, "develop
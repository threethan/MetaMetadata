15958724856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGv2sutuuEIQ7kNvwGvGiOv&_nc_oc=Adl5R36UKxzmtsLcEDv0pp81nXKU_2I0KJLUxdLCHf_67sq_azqgjPl82w247H0G2qo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHcNEENe3jLi9TVx3_Gp6_glvF95wTd7IBW6vAIDWfzg&oe=69BE8B66"}, "display_name": "Pickleball Dink", "keywords": ["racket", "sports", "tennis", "racquet", "workout"], "long_description": "# EXPERIENCE THE FUTURE OF PICKLEBALL\nPickleball Dink gives you a **14-Day** glimpse of the exciting gameplay and community that awaits. Explore cutting-edge VR physics, single-player matches, mixed reality gameplay, fitness features, and introductory training\u2014all from the comfort of your home.\n{638775075561987}\n# WHAT'S INCLUDED IN THE DEMO:\n- **Realistic Physics**: Experience authentic, responsive gameplay.\n- **Single-player Matches**: Enjoy practice and competitive match scenarios.\n- **Mixed Reality Gameplay**: Immerse yourself in a unique blend of virtual and real-world play.\n- **Fitness and Training**: Experience introductory fitness features and targeted practice.\n{581303474955457}\n\n# UPGRADE FOR FULL ACCESS: \nUnlock multiplayer matches, ranked competition, comprehensive training modules, ongoing content updates, and become part of our vibrant, engaging pickleball community.\n\n{2071089853326010}\n# COMMON QUESTIONS:\n**Does the demo require a lot of space?** No. Pickleball Dink is designed for home use, requiring minimal space.\n\n**How do I upgrade to the full game?** Upgrade directly within the app or visit www.pickleballone.app to join the full experience.\n\n**Need help or have questions?** Join our community on Discord or reach us at support@playingames.net.\n\n\n", "short_description": "EXPERIENCE THE FUTURE OF PICKLEBALL\nPickleball Dink gives you a 14-Day glimpse of the exciting gameplay and community that awaits. Explore cutting-edge VR physics, single-player matches, mixed reality gameplay, fitness features, and introductory training\u2014all from the comfort of your home.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pickleballone.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Future World Software", "support_website_url": null, "website_url": "https://pickleballone.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23900581306273240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824534_1386664202551599_8899144559251589010_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9B8E-0p7AcQ7kNvwGxWbkE&_nc_oc=AdlDW6nYtcnWBb_DN3srqSSA7rJ9fHbU4i4vRlpqCT7GpbVFEX1hdNgyzZmVXHwkljE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwjy0DnZLOW4eDxuWeQcPRJXMZ-v7BNgLl97wtPzql0zg&oe=69BE9CB6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Dink", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1743609300, "lastRevision": {"nodes": [{"id": "9481632191928058", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
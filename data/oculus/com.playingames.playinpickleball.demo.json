oculuscdn.com&_nc_ss=7f30f&oh=00_AQXQbZH0ltYLSdvQMVM2CZ28MZlNsrJWU_WGAM7H0bzFPA&oe=6B0EF710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pickleball One - Meta Store - Landscape - Characters (2560 x 1440 px)_N.png", "id": "1214397197034482", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822808_1214397200367815_5595452115958724856_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAeomtnCnf4Q7kNvwHFGm4W&_nc_oc=AdpwLsV5kL6Pgx4dyPSfOi2pS6bayR1Cl9aeVijh6w2zETtcThLy3yc5YYqrWtwyQ3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVuew9Fk9gkEUPBQ8Xji7rMmU9hhAGOjOY9UuP9c0Zl_Q&oe=6B0EF226"}, "display_name": "Pickleball Dink", "keywords": ["racket", "sports", "tennis", "racquet", "workout"], "long_description": "# EXPERIENCE THE FUTURE OF PICKLEBALL\nPickleball Dink gives you a **14-Day** glimpse of the exciting gameplay and community that awaits. Explore cutting-edge VR physics, single-player matches, mixed reality gameplay, fitness features, and introductory training\u2014all from the comfort of your home.\n{638775075561987}\n# WHAT'S INCLUDED IN THE DEMO:\n- **Realistic Physics**: Experience authentic, responsive gameplay.\n- **Single-player Matches**: Enjoy practice and competitive match scenarios.\n- **Mixed Reality Gameplay**: Immerse yourself in a unique blend of virtual and real-world play.\n- **Fitness and Training**: Experience introductory fitness features and targeted practice.\n{581303474955457}\n\n# UPGRADE FOR FULL ACCESS: \nUnlock multiplayer matches, ranked competition, comprehensive training modules, ongoing content updates, and become part of our vibrant, engaging pickleball community.\n\n{2071089853326010}\n# COMMON QUESTIONS:\n**Does the demo require a lot of space?** No. Pickleball Dink is designed for home use, requiring minimal space.\n\n**How do I upgrade to the full game?** Upgrade directly within the app or visit www.pickleballone.app to join the full experience.\n\n**Need help or have questions?** Join our community on Discord or reach us at support@playingames.net.\n\n\n", "short_description": "EXPERIENCE THE FUTURE OF PICKLEBALL\nPickleball Dink gives you a 14-Day glimpse of the exciting gameplay and community that awaits. Explore cutting-edge VR physics, single-player matches, mixed reality gameplay, fitness features, and introductory training\u2014all from the comfort of your home.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pickleballone.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Future World Software", "support_website_url": null, "website_url": "https://pickleballone.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23900581306273240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824534_1386664202551599_8899144559251589010_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZGsK2ojIZUQ7kNvwHiwggP&_nc_oc=AdpRG_n-OX3-9TyTBVtc6MfL2NqzuQictHvelaOWDg9OKravOPmUE-5duOTBSOAzhlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWCKmf-cSpkOifah7mKRoM2EU6by3cNit9alz4T2Z3PpQ&oe=6B0F0376"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Dink", "platform": 
4_1887540105388300_3012133008426227535_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPSveUm0P98Q7kNvwEn9-gU&_nc_oc=AdnYAezEpgLxbiOMpTdqh0M6dbhKMMdZ1yZ9YOsgTcNu9Pct8CQk99VgtOMk8u0oSIw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSw2IR7Zv-1246Ce8OWUy3HiIKrHmKcL6D1oB63CzF0g&oe=69AACE10"}, {"file_name": "75556279_438582308618616_5242317205619296025_n.png", "id": "673246245368500", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393107_673246252035166_2457298756414624870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KobvTKDQNxsQ7kNvwEynkA-&_nc_oc=Adnk8FlQmN53h9kVBe8_lqSJQVzv-KDkqkKg1ZFRPWoZGpdqjrhwcz9HmvcJETkuaJY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_Arbe8gn9ZPFtyCQqxVermNCZxHLEZfWKbWwhYMM8Gw&oe=69AAE52E"}, {"file_name": "38974625_1496488591050337_2103753940590390213_n.png", "id": "1231556548676285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393589_1231556552009618_7314687898927767121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtaa1GIy_hkQ7kNvwFKnbB4&_nc_oc=AdlD_6N_TM4b23VOFox3zggu0VhIoLW-g5zaxvbY28hqM-Tbv0026jAx2q240YfUsG4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiV6BH-oiYznV0Z1SmMG0CskGlLtS1hoHno02089pS6g&oe=69AACFDE"}, {"file_name": "2.0.10 - Multiplayer 1v1 - City - Cole (3rd Person)-00.05.41.510.png", "id": "727715513342883", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391924_727715516676216_8478215564952713292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOwVX43d7OMQ7kNvwG2gbME&_nc_oc=AdmENJK5ANXeCkGdse0ArR7_7jBWZEklhksKo09xjSAsOagbd7vfcwD3dmE9fDCloYw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyevmWPZOTyU0iXECO5Yk-X6BA3iFcyK3w9XDLb_eIAIA&oe=69AAC9D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pickleball One - Meta Store - Landscape - Characters (2560 x 1440 px)_N.png", "id": "1214397197034482", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822808_1214397200367815_5595452115958724856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pH5Tz8DeWAsQ7kNvwE0kQu5&_nc_oc=AdlN_YqkiXM8K5CRisI67P6Z8PJjea2NPTouYx9c56XwLyz4opmp7VTXB1DdRdysc2k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afzi5TxFuF4vceRGRSIbfAwUCkq0FB-0VP07FUduxJK0Eg&oe=69AAC4E6"}, "display_name": "Pickleball Dink", "keywords": ["racket", "sports", "tennis", "racquet", "workout"], "long_description": "# EXPERIENCE THE FUTURE OF PICKLEBALL\nPickleball Dink gives you a **14-Day** glimpse of the exciting gameplay and community that awaits. Explore cutting-edge VR physics, single-player matches, mixed reality gameplay, fitness features, and introductory training\u2014all from the comfort of your home.\n{638775075561987}\n# WHAT'S INCLUDED IN THE DEMO:\n- **Realistic Physics**: Experience authentic, responsive gameplay.\n- **Single-player Matches**: Enjoy practice and competitive match scenarios.\n- **Mixed Reality Gameplay**: Immerse yourself in a unique blend of virtual and real-world play.\n- **Fitness and Training**: Experience introductory fitness features and targeted practice.\n{581303474955457}\n\n# UPGRADE FOR FULL ACCESS: \nUnlock multiplayer matches, ranked competition, comprehensive training modules, ongoing content updates, and become part of our vibrant, engaging pickleball community.\n\n{2071089853326010}\n# COMMON QUESTIONS:\n**Does the demo require a lot of space?** No. Pickleball Dink is designed for home use, requiring minimal space.\n\n**How do I upgrade to the full game?** Upgrade directly within the app or visit www.pickleballone.app to join the full experience.\n\n**Need help or have questions?** Join our community on Discord or reach us at support@playingames.net.\n\n\n", "short_description": "EXPERIENCE THE FUTURE OF PICKLEBALL\nPickleball Dink gives you a 14-Day glimpse of the exciting gameplay and community that awaits. Explore cutting-edge VR physics, single-player matches, mixed reality gameplay, fitness features, and introductory training\u2014all from the comfort of your home.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pickleballone.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Future World Software", "support_website_url": null, "website_url": "https://pickleballone.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23900581306273240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491824534_1386664202551599_8899144559251589010_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WS6RqFaCigQ7kNvwEz8d9N&_nc_oc=AdlT0qN6rUXHNrKN0wzPd6VskENVN6sC56b8vMjQjLwzn0CsX_YY2WvhtdgEXwRmSrI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQi3kwX0uJv61wskG68L1mn1zaJuFVHDgmyw2xrJu7VQ&oe=69AAD636"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Dink", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1743609300, "lastRevision": {"nodes": [{"id": "9481632191928058", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defaul
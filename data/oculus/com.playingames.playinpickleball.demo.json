540105388300_3012133008426227535_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChAcDxkAihcQ7kNvwH8N2dL&_nc_oc=AdlqCFyHT1r7XjfXfv8NUC3L_CBkK-37Mw0QTPdwA2wLrm7S3KjFXzCZbN8cH7kSOKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUSeoT9me60LtjutevHFo0HpwLG7ymzjjSkbjEPz6wwQ&oe=69AEC290"}, {"file_name": "75556279_438582308618616_5242317205619296025_n.png", "id": "673246245368500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393107_673246252035166_2457298756414624870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy70y3MNQGEQ7kNvwELuX-H&_nc_oc=AdnzcmkGHFeQdZw3x_7yMm7D5BxSR9N9LLsKq40SiRvQT7JNa5LRBQ9B0eKBs5_TiWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwY4AD6ojrmFx2p-yHhyvPNkCfQhF6ocxWLfj1Cq-zTQ&oe=69AED9AE"}, {"file_name": "38974625_1496488591050337_2103753940590390213_n.png", "id": "1231556548676285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_1231556552009618_7314687898927767121_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR7fGfhzdpoQ7kNvwGkOMTl&_nc_oc=AdkURtKucqVBJ7XgEp2rhfnkM9kmzSOjgRWWO0-XQYp_oJQVMZJQ5UazjzdL-ggar3M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyy07KSlP44dzFqeGZHm_1SqYiYIBlM_K4HV2jCmDf5wA&oe=69AEC45E"}, {"file_name": "2.0.10 - Multiplayer 1v1 - City - Cole (3rd Person)-00.05.41.510.png", "id": "727715513342883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_727715516676216_8478215564952713292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev6BG10V1EQQ7kNvwGMztwy&_nc_oc=AdmqtU7ZdPvNGCEKsDZg-F8seRr-AiP9wHTxJa1x3Gpx_HXovPWbn5sbp3beVPX1_3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfygLWi1MccsXJnPoJC8_CIm64QwwfaxuADdYe8yvxuw&oe=69AEBE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pickleball One - Meta Store - Landscape - Characters (2560 x 1440 px)_N.png", "id": "1214397197034482", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822808_1214397200367815_5595452115958724856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsDoNmM2UtAQ7kNvwEpFz7E&_nc_oc=AdmRTMFUrTB3ezPeBNV_fyt-nmZec4Hnf0jHpLlZRXyWmrojUgAdmQ_5UiFLIY488M8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTILGpVzlB7XZhhT6IIfZzPuJsDL8q6Tc23qlLAH7lVQ&oe=69AEB966"}, "display_name": "Pickleball Dink", "keywords": ["racket", "sports", "tennis", "racquet", "workout"], "long_description": "# EXPERIENCE THE FUTURE OF PICKLEBALL\nPickleball Dink gives you a **14-Day** glimpse of the exciting gameplay and community that awaits. Explore cutting-edge VR physics, single-player matches, mixed reality gameplay, fitness features, and introductory training\u2014all from the comfort of your home.\n{638775075561987}\n# WHAT'S INCLUDED IN THE DEMO:\n- **Realistic Physics**: Experience authentic, responsive gameplay.\n- **Single-player Matches**: Enjoy practice and competitive match scenarios.\n- **Mixed Reality Gameplay**: Immerse yourself in a unique blend of virtual and real-world play.\n- **Fitness and Training**: Experience introductory fitness features and targeted practice.\n{581303474955457}\n\n# UPGRADE FOR FULL ACCESS: \nUnlock multiplayer matches, ranked competition, comprehensive training modules, ongoing content updates, and become part of our vibrant, engaging pickleball community.\n\n{2071089853326010}\n# COMMON QUESTIONS:\n**Does the demo require a lot of space?** No. Pickleball Dink is designed for home use, requiring minimal space.\n\n**How do I upgrade to the full game?** Upgrade directly within the app or visit www.pickleballone.app to join the full experience.\n\n**Need help or have questions?** Join our community on Discord or reach us at support@playingames.net.\n\n\n", "short_description": "EXPERIENCE THE FUTURE OF PICKLEBALL\nPickleball Dink gives you a 14-Day glimpse of the exciting gameplay and community that awaits. Explore cutting-edge VR physics, single-player matches, mixed reality gameplay, fitness features, and introductory training\u2014all from the comfort of your home.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pickleballone.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Future World Software", "support_website_url": null, "website_url": "https://pickleballone.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23900581306273240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824534_1386664202551599_8899144559251589010_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_Abdv9smmoQ7kNvwEiOiy1&_nc_oc=AdkQinOvipVMxku18uDz3LTs7ftAceNspuQHtUZNF36HNs7tt303NkZVPg7bcUMlY0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0XkNY0Lc3yI00rooIlDi9p99GYSwrejJc52dlLEHu9Q&oe=69AECAB6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Dink", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1743609300, "lastRevision": {"nodes": [{"id": "9481632191928058", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
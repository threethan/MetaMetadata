&_nc_ohc=R5A_rl3aeCgQ7kNvwG79lPr&_nc_oc=AdrLyQGlWEJm7Vns52gSdq__K3hf99O_CGHpp1-4uFB6vgNx-6kw4Xm-J8alXX5WWBw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShoMfoZln85OnPyWl5qt1w3Q5cAKRMYrXj7LD-RNol-g&oe=6AFC7FE9"}, {"file_name": "screenshot_5.png", "id": "1638459391003869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1638459394337202_2798768590240387167_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orQlrVyF8esQ7kNvwFhKLT7&_nc_oc=AdrZQTYvUsSyKG6ev-iC-e-bzDyzC3Lh9Qz8tIzHgUpwg7eFO8SZ5JMEA7ToxQ1h4A0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVGcVSvsULMIaisaZKT5v7QfdqMD0amnT7zaX5UfdmMQ&oe=6AFC87DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1408221194092022", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831569_1408221197425355_1699430163143489589_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvYl01GCRkMQ7kNvwH1Q85k&_nc_oc=Ado0HFZV17XcgxQRUXamkLxVSBrmHDye78-r9qlCNnyJp0TaCBBS3v5TifzekBiO0OM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz_MNNNPbOS7dS4nWPBMsBq4mwcjCYDzYbQPBPU_NpZg&oe=6AFC7D6C"}, "display_name": "Paint 2", "keywords": ["paint", "painting", "painter", "decorating", "relaxing"], "long_description": "Paint is back, and this time it's your job.\n\nEIGHT CLIENTS, EIGHT ROOMS\nEvery client has a brief and a room that needs it. A first flat in Sage Leaf. A Harbour Navy accent wall. A two-tone dining room with a chair rail. Nursery stripes. A terracotta kitchen. A mountain mural for a seven-year-old. A charcoal gallery turned bright white. A penthouse colour-block with a painted arch.\n\nPAINT THAT BEHAVES LIKE PAINT\nRollers lay a strip as wide as their sleeve. Brushes leave bristle streaks. Dark walls need a second coat. Wet paint gleams, then dries to a soft matte. Old walls come with scuffs, stains and the pale ghosts of old picture frames.\n\nMASKING TAPE\nStick blue painter's tape along the pencil marks, roll right over it, then peel it off for a perfectly crisp line.\n\nTHE INSPECTION LAMP\nShine it on a wall and every thin coat and missed spot glows. Get every wall to 100% before you call the client.\n\nSTARS, PAY AND BETTER TOOLS\nFinish a job, beat the par time and nail the quality for three stars. Spend your pay on an 18-inch roller, a pro sleeve, an HVLP gun and the airless sprayer. Every finished room hangs on your job board as an after photo.\n\nYOUR SANDBOX STUDIO\nEvery tool, every colour, no brief. Your studio walls save between sessions.\n\nIncludes a work radio, a first-job coach and before and after photos of every room.", "short_description": "The sequel to Paint. Become a house painter in VR: take on client jobs, roll real paint onto tired old walls, lay masking tape for crisp stripes and murals, hunt missed spots with the inspection lamp, and earn stars and cash for better tools. Or just paint anything you like in your own sandbox studio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/paint2/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/paint2/", "website_url": "https://citiview-games.pages.dev/paint2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
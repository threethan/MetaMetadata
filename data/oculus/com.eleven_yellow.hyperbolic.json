YqZJ7NZ0Q7kNvwFLlPDA&_nc_oc=AdoTHkWyq3RXE5cQLrtNXXXZGbrnv8ZA180XeHoeri6V2QqzI8XTQCO5UARHN6Fa8-s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnP9mQieoYow1BHEBjog1Y8karLi1AZsIxMAfWfQEazQ&oe=6A86E478"}, {"file_name": "2.png", "id": "1196487568833829", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303746_1196487572167162_4797488169829267208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGICqeU-K8IQ7kNvwEnloSz&_nc_oc=AdrmyXqzVfXVocVOtV6W0eXMATQvu0tbj3LfSqtZA3Z22LLyzdrKedfUlgSgOujmh3c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIfocfkp57UkkmZhPmKt8NS2UD57fSOgZBvuPUFW-R5g&oe=6A86D0F6"}, {"file_name": "menu.png", "id": "3128629650634197", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303672_3128629653967530_8026494026235859714_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RizFbF0sKBYQ7kNvwEilW8i&_nc_oc=AdpmLJfiZabD9PZXOnpvzOkSezkQK1qzTQ8euO6iWO93NMYZNPTRTsxq-7C_rzr90Ec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEvdn0lW3iALevEULkLSKK524IAYTgoZZurTSHyPDyTA&oe=6A86FB6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_16_9_2560x1440.png", "id": "1109105107747438", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307505_1109105111080771_354117929219359067_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfNwSgNDqF0Q7kNvwEP8AAG&_nc_oc=AdovbYP0MogVgUY6HQsA1zi2XYDHvd6L00NZ4423DhgBnX7i_qU74Sdmu6JIVoR_uRE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz-bwP3CaJHILJmvciBYiaF8FRf-8Y-ftUxR0O0PwtcQ&oe=6A86D26B"}, "display_name": "Hyperbolic Time Chamber - Endless Runner", "keywords": ["fitness", "exercise", "workout", "cardio", "rhythm"], "long_description": "Step into the legendary Hyperbolic Time Chamber and experience an intense VR fitness adventure. This anime-inspired endless runner is a cardio rhythm gameplay that will push your limits and forge you into a true warrior.\n\nJourney through four breathtaking worlds, each crafted with stunning aesthetics that transport you straight into one of your favourite anime. The further you advance, the more intense it becomes \u2013 every environment becomes progressively more challenging as you prove your worth.\n\nFeel the burn as you duck under lasers, escape obstacles, and unleash devastating punch combos. Engage your core, work your arms, and get your heart rate soaring. \n\nVisit the in-game store to unlock powerful gear that enhances your performance and style. With exciting new assets continuously being added, your fighter will always have fresh customization options in the Time Chamber.\n\nEveryone starts as a Farmer with a Shotgun, Yamchas or Krillins \ud83d\udc09\nBut can you become the Super Sayan? \nProve it on the World Leaderboard where warriors from across the globe compete for ultimate supremacy.", "short_description": "Workout at home with this anime-inspired endless runner! \ud83d\udc09 Hyperbolic Time Chamber is where you gain strength, agility and a unique experience of a rhythm, fitness and endless runner all-in-one. Punch, dodge and sweat your way to the top of the World Leaderboard. \ud83c\udfc6"}]}, "developer_name": "TACTO Studio", "developer_privacy_policy_url": "https://www.tac.to/privacy", "developer_terms_of_service_url": null, "publisher_name": "TACTO Studio", "support_website_url": null, "website_url": "https://www.tac.to/htc", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"]
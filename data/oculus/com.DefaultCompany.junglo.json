-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw09gvCQz0CfF_bTjqTzX2qCm0hYUE2usO9-1bEeB3sWQ&oe=69BFF00A"}, {"file_name": "Untitled Project (43) (1).png", "id": "704617809397838", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822952_704617812731171_264799795856502456_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGyevNDKw70Q7kNvwEkSXHV&_nc_oc=AdmJ7MS5hntrPVE48W1Rh67BThVuO24WH4g0BdyzXSyCeUXOf82hGrCJ5CShgAQwih4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGQHlNKLI8iTEyKwmhPhVuG_YVTBuPfpq1nTk3dsr0gQ&oe=69BFDE7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "junglo", "keywords": [], "long_description": "Junglo is a chaotic, physics-based fan game built for pure movement, loud laughs, and unpredictable moments. Inspired by the likes of Gorilla Tag, it throws you into uniquely designed maps where your hands are your legs, and every surface is a playground.\n\n\ud83c\udfc3\u200d\u2642\ufe0f No sticks. No buttons. Just movement.\nWall-run, bounce, climb, and vault your way across arenas with full-body locomotion. Whether you\u2019re tagging others, running for your life, or showing off insane movement skills, every match feels different.\n\n\ud83c\udfae What Makes Junglo Different?\n\nUnique non-jungle-themed maps that break expectations\n\nSlapstick player interactions and voice chaos\n\nCommunity memes, custom skins, and experimental modes\n\nFree-movement locomotion without stick control\n\n", "short_description": "Junglo is a chaotic, physics-based fan game built for pure movement, loud laughs, and unpredictable moments. Inspired by the likes of Gorilla Tag, it throws you into uniquely designed maps where your hands are your legs, and every surface is a playground.\n\n\ud83c\udfc3\u200d\u2642\ufe0f No sticks. No buttons. Just movement.\nWall-run, bounce, climb, and vault your way across arenas with full-body locomotion. Whether you\u2019re tagging others, running for your life, or showing off insane movement sk
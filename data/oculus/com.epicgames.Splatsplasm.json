, "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196228_1095338655597823_6412044953759032441_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSoLn4dUMQYQ7kNvwGQeD2_&_nc_oc=Adrq6GtJKccN-z5SMQ_zB_c1IchZxxjrTxHbTh3Ncu0Zx2w8woyhmbJIiHAR5P4ohIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74d7W4188sV6o8UeA4lWK1jsvB-YpqU2puJCr-6fvHHA&oe=6A15A227"}, {"file_name": "splatscreen6.png", "id": "1287907002401238", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75367587_1287907005734571_1428784944851958953_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Phk7wlhTqdgQ7kNvwF77s3q&_nc_oc=AdpXQWgOJ7Pb__deZlqML3kCGNTr8dfnVs08nnVRIWS3mq49paMJXeiueuwQ2aqCbPU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5htkqTMvb36lCx_wmqmwVOXuvoegeUuzEqXkxZ24Ca5w&oe=6A159058"}, {"file_name": "splatscreen5.png", "id": "486250757178794", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974613_486250760512127_2514502791044826890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJkrZAzIPbAQ7kNvwH5_Zbz&_nc_oc=AdrEh058zndKIJPDczcFkXvC6LtNSjuAFFwjFXoIbB9B3Dv4a7Rq3ch7hZ0FvLk3C3w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Lrhg4jfEhtrnMX7Ai8vwUXlEhFxnO8VL2H7pUYxc5dQ&oe=6A15C0A6"}, {"file_name": "splatscreen1.png", "id": "2060790107689147", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974465_2060790111022480_4963927010090695375_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59rmlq9vk1UQ7kNvwFFr_1O&_nc_oc=AdrtV-j2QaipbpdmSTMhVAGWCrZCD9qUkv9D8nEkeaa0liIGWW3CQkD4WuNFJxK6iTU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6irjpAKUWcwdyVf95pkw9cAVr2C_0g8SmXz8Bk_Yix4w&oe=6A158F2A"}, {"file_name": "splatscreen4.png", "id": "1222226439078854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75287554_1222226445745520_7139984044701695194_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVMIfx9l208Q7kNvwHsWttG&_nc_oc=AdokZd3434_ja_yy6p2oge7DwQLOPWbGd1tp2-VT5U2shKseo6EiE_3rMkTA9v9TKiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rVQz8TQgDOZwUa4mwsxH3HXyPDtESagwffWeTodpu0A&oe=6A159A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splatcover1.png", "id": "27727614090220486", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/442456783_27727614100220485_6038477975986382459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixH_jDVt4LsQ7kNvwGs_Vqr&_nc_oc=Adp2w2YQhKjDbQSi6HyMhOByzbd9RkLklLIjvG9Np55sJ4XGzNx-_sHM90_1CnJ7f98&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DRYYQjRt5SrkyxnPHv5tyA4z9SgWEsqoXkK5fXPzg-g&oe=6A15B1BA"}, "display_name": "Splatsplasm", "keywords": [], "long_description": "Splatsplasm\nPlaying as an astronaut, you approach a creaky, abandoned spaceship where you'll fend off relentless waves of weird alien creatures in various arenas.\nStart off in campaign mode, where you\u2019ll unlock a fancy new bat for each level cleared. Each bat changes your gameplay. \nSplat the aliens against the walls until there is enough alien goop on the wall to dissolve it, and reveal the next room...\nA couple of words of warning .... you really don\u2019t want to hit the sponges. These little traitors will clean the goop off the walls and you can watch your progress go sliding backwards.\nAnd the alien waste disposal system? Yeah, that\u2019s running too. Miss a beat, and your head ends up in one of those purple waste streams\nIn Fun Mode, the task is simple: Smack as many aliens as you can into the walls, because why not? You can groove to the in-built beats or go wild with any public domain jam you find on the internet. Thousands of songs for hours of alien splatting... just what the doctor didn\u2019t order.\nSpaltsplasm is pure stress-ball energy. Splat your way to inner peace or at least work out some road rage after that person cut you off in traffic today.\nGet splatting, and may your walls be covered in alien goo!\n", "short_description": "Welcome to Splatsplasm, the ridiculous new outer space VR game that\u2019s basically bubble wrap-popping therapy for rhythm game addicts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.splatsplasm.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PRPVFX LTD", "support_website_url": null, "website_url": "https://www.splatsplasm.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8741875095878282"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1580146219720542"}, {"status": "PUBLISHED", "id": "768073699673923"}, {"status": "PUBLISHED", "id": "1735418943821350"}, {"status": "PUBLISHED", "id": "1392188872914668"}, {"status": "PUBLISHED", "id": "1782725899312748"}, {"status": "PUBLISHED", "id": "474710435458496"}, {"status": "PUBLISHED", "id": "607009325147042"}, {"status": "PUBLISHED", "id": "1648419299429740"}]}, "baseline_offer": {"id": "1580146219720542"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774897980, "status": "PUBLISHED", "id": "1580146219720542"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9045623582170097", "version": "1.0"}, "id": "584178947464407", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes"
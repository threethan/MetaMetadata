, "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196228_1095338655597823_6412044953759032441_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbiHFlwjTRwQ7kNvwGqsak7&_nc_oc=AdoD7uHt7zuPDYXQ7uVuSsdh67GvAP0jzUM94BsQ9kGV67I7fMF6_3YWkahEfcaPpqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JquXVpNqjPxwy07PbdGuDpVbDxZLiMjfZa9VxqLUnMg&oe=6A281727"}, {"file_name": "splatscreen6.png", "id": "1287907002401238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367587_1287907005734571_1428784944851958953_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7bSIPaN9TYQ7kNvwGQhCXn&_nc_oc=AdpslrW9becFh1eXGobXP8FzwoAyLRUa2ej9X1hM3Ndka7Bn79dyqy0XZHqRocK8bdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z26hPJscEaHqa8UYGkqDzXrwKgHjmbeX5UuHvyLtepw&oe=6A280558"}, {"file_name": "splatscreen5.png", "id": "486250757178794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974613_486250760512127_2514502791044826890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCO9rCOszUAQ7kNvwFUO5X_&_nc_oc=AdpF40zgWMPbiZlJc5IspoOL28k_90A4W9IoDI6_3HxWhUhe_mOq4dy5vvQFI_QeVVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8f44jLPRU-4qkvfqiMRlqrRDtyzBCj3S-m0phyU0NRg&oe=6A2835A6"}, {"file_name": "splatscreen1.png", "id": "2060790107689147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974465_2060790111022480_4963927010090695375_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff_Rgc0pYCcQ7kNvwEL4mCl&_nc_oc=AdpmvPtl9XSKo5upNjmnv4h58agFxo6eoFvETuEPn6ekeQr6rxXJRXlDfozjP_bJ99o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BkPQZ8TpZACsHON1wE-AUmIHyvdzD2Omk9b2DHnKIdg&oe=6A283C6A"}, {"file_name": "splatscreen4.png", "id": "1222226439078854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75287554_1222226445745520_7139984044701695194_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWw8gQ-3m-0Q7kNvwFiuDTf&_nc_oc=AdrLuYgZfYuD7XYG_yQFKzxKAd6JJmBjJlYrymYBPnXP-aiiZV8xSbeH9-d6Fd6NcwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88uiw8SrkS6kFNQtD4KuCWSuBRR9kj7_E1Lf8BiT85Ow&oe=6A280F22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splatcover1.png", "id": "27727614090220486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/442456783_27727614100220485_6038477975986382459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qViNunwkZ3QQ7kNvwHjSV0P&_nc_oc=Adq7GMoxkx-lXPeTnwBvgzMKBrYNhSEJn2t8HJfcg-euXDyfBIhTiojJ0S36YwToVSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Gq3dxGjofzIG5l9fSQPErJdQiIQFTvk1Iv6E_omwMew&oe=6A2826BA"}, "display_name": "Splatsplasm", "keywords": [], "long_description": "Splatsplasm\nPlaying as an astronaut, you approach a creaky, abandoned spaceship where you'll fend off relentless waves of weird alien creatures in various arenas.\nStart off in campaign mode, where you\u2019ll unlock a fancy new bat for each level cleared. Each bat changes your gameplay. \nSplat the aliens against the walls until there is enough alien goop on the wall to dissolve it, and reveal the next room...\nA couple of words of warning .... you really don\u2019t want to hit the sponges. These little traitors will clean the goop off the walls and you can watch your progress go sliding backwards.\nAnd the alien waste disposal system? Yeah, that\u2019s running too. Miss a beat, and your head ends up in one of those purple waste streams\nIn Fun Mode, the task is simple: Smack as many aliens as you can into the walls, because why not? You can groove to the in-built beats or go wild with any public domain jam you find on the internet. Thousands of songs for hours of alien splatting... just what the doctor didn\u2019t order.\nSpaltsplasm is pure stress-ball energy. Splat your way to inner peace or at least work out some road rage after that person cut you off in traffic today.\nGet splatting, and may your walls be covered in alien goo!\n", "short_description": "Welcome to Splatsplasm, the ridiculous new outer space VR game that\u2019s basically bubble wrap-popping therapy for rhythm game addicts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.splatsplasm.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PRPVFX LTD", "support_website_url": null, "website_url": "https://www.splatsplasm.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8741875095878282"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1580146219720542"}, {"status": "PUBLISHED", "id": "768073699673923"}, {"status": "PUBLISHED", "id": "1735418943821350"}, {"status": "PUBLISHED", "id": "1392188872914668"}, {"status": "PUBLISHED", "id": "1782725899312748"}, {"status": "PUBLISHED", "id": "474710435458496"}, {"status": "PUBLISHED", "id": "607009325147042"}, {"status": "PUBLISHED", "id": "1648419299429740"}]}, "baseline_offer": {"id": "1580146219720542"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774897980, "status": "PUBLISHED", "id": "1580146219720542"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9045623582170097", "version": "1.0"}, "id": "584178947464407", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes"
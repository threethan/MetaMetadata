, "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196228_1095338655597823_6412044953759032441_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbCO6kHIvTcQ7kNvwE-JFWR&_nc_oc=AdppEn5IeXR9-CYT3KbpmKaFTeuoi0BHBTJW7smoifpvelKZCLy6jHvHczfCt29qddA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9O0yHV_MB3IpvdiEmIZdL9JiRo8g4nJ5RuK02xeQfoQ&oe=6A6DF6A7"}, {"file_name": "splatscreen6.png", "id": "1287907002401238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367587_1287907005734571_1428784944851958953_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kJu8JGjzpwQ7kNvwHKTrGo&_nc_oc=Adqjy7I-xgG6Y3r0wg8W9odJhLh8fLn7erOT8L9v6580YW4WxT_KNu8EwtYHE3FhVBM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWQpRnXGaILqVhwpt5oUsBY6CJXPu1MyC6jilxhARwlQ&oe=6A6DE4D8"}, {"file_name": "splatscreen5.png", "id": "486250757178794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974613_486250760512127_2514502791044826890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WcAJhXOxCoQ7kNvwGHk1Yj&_nc_oc=AdoE1LQ-7j4kU3Ic_Muqb7wurtV8f2H06NQgfcXZGOzzQFat5M40Kmwaj_XPCeBq20A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCldRFoHhOwpHpAz1c5p0qgQ8IfsjFoa90s8ru3IYR4YA&oe=6A6DDCE6"}, {"file_name": "splatscreen1.png", "id": "2060790107689147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974465_2060790111022480_4963927010090695375_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUTWV8Xf5LAQ7kNvwHwOc4v&_nc_oc=Adqa1D8H10QZVWp9I3icLpEBAgsOytKqH0a0CPRBn1y6Ufd11jmePtM2Hn2sT4Z7SYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6M9VNurYwnYFdgG9-BRz61ku5ZsPWkBtI_7M3fB-hIQ&oe=6A6DE3AA"}, {"file_name": "splatscreen4.png", "id": "1222226439078854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75287554_1222226445745520_7139984044701695194_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uv5iJd2e0pIQ7kNvwFzG2VI&_nc_oc=AdrHNVyfWqYs7vhSPc7RkyTCpF5E59r4IpyczYANBqAThavE_KA3b_ArdQL0xKjK7Gg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-EYBaVNavrLJfL1hW5LcALh-VrzbSrtGOPy1Lh9gRiw&oe=6A6DEEA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splatcover1.png", "id": "27727614090220486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/442456783_27727614100220485_6038477975986382459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES3DvMBfSgQQ7kNvwGt9ckZ&_nc_oc=Ado9D8Se2qsBbtDWnqHMUUwdBQ9-Wsqek7fPynH3nN82hze0Y7BC91fMQW4MwhxexKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdq3LJpS1mdnVpYCCtCa22z1wjVSSUGMk1HvGtwryzLw&oe=6A6E063A"}, "display_name": "Splatsplasm", "keywords": [], "long_description": "Splatsplasm\nPlaying as an astronaut, you approach a creaky, abandoned spaceship where you'll fend off relentless waves of weird alien creatures in various arenas.\nStart off in campaign mode, where you\u2019ll unlock a fancy new bat for each level cleared. Each bat changes your gameplay. \nSplat the aliens against the walls until there is enough alien goop on the wall to dissolve it, and reveal the next room...\nA couple of words of warning .... you really don\u2019t want to hit the sponges. These little traitors will clean the goop off the walls and you can watch your progress go sliding backwards.\nAnd the alien waste disposal system? Yeah, that\u2019s running too. Miss a beat, and your head ends up in one of those purple waste streams\nIn Fun Mode, the task is simple: Smack as many aliens as you can into the walls, because why not? You can groove to the in-built beats or go wild with any public domain jam you find on the internet. Thousands of songs for hours of alien splatting... just what the doctor didn\u2019t order.\nSpaltsplasm is pure stress-ball energy. Splat your way to inner peace or at least work out some road rage after that person cut you off in traffic today.\nGet splatting, and may your walls be covered in alien goo!\n", "short_description": "Welcome to Splatsplasm, the ridiculous new outer space VR game that\u2019s basically bubble wrap-popping therapy for rhythm game addicts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.splatsplasm.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PRPVFX LTD", "support_website_url": null, "website_url": "https://www.splatsplasm.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8741875095878282"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1580146219720542"}, {"status": "PUBLISHED", "id": "768073699673923"}, {"status": "PUBLISHED", "id": "1735418943821350"}, {"status": "PUBLISHED", "id": "1392188872914668"}, {"status": "PUBLISHED", "id": "1782725899312748"}, {"status": "PUBLISHED", "id": "474710435458496"}, {"status": "PUBLISHED", "id": "607009325147042"}, {"status": "PUBLISHED", "id": "1648419299429740"}]}, "baseline_offer": {"id": "1580146219720542"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774897980, "status": "PUBLISHED", "id": "1580146219720542"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9045623582170097", "version": "1.0"}, "id": "584178947464407", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes"
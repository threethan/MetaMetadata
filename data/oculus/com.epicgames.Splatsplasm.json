, "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196228_1095338655597823_6412044953759032441_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZH3yVyJUocQ7kNvwEOskMN&_nc_oc=AdoNKzQ7YiN6BNs6fp8SnR07mrtYzPcNFkaS5kI4rN9raUmrvaGs8ZrakISMsvzjdOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvizjm-D3Te6ZT7trfZZE645WgUY1jbak27qexVcqWYw&oe=6AE740A7"}, {"file_name": "splatscreen6.png", "id": "1287907002401238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75367587_1287907005734571_1428784944851958953_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oat4Bmx1u2kQ7kNvwHVZ5DB&_nc_oc=AdpKroKQp6MApcBaQFRQ4EDvWlIozU5I8biaRljRptbtgAJC9YwqsXYMFgUb7fZx6_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRyOedMcS0FkO1SCeCEBbD6vWw0LdZJTA7TrYCYS8kbA&oe=6AE76718"}, {"file_name": "splatscreen5.png", "id": "486250757178794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974613_486250760512127_2514502791044826890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A7YuvLDeLkQ7kNvwF4IDl1&_nc_oc=AdqcUP1MezvtbrT2Hec38p4YcQ0IjzPHcX40nj3pxw1wJHsn3-0zezWOkv5YeREAWUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLcgqqrv8Bm6IzCa-5R8Wf6VE4MBiVvPJUtNc-EZwfZA&oe=6AE75F26"}, {"file_name": "splatscreen1.png", "id": "2060790107689147", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974465_2060790111022480_4963927010090695375_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZoeQxVRQFAQ7kNvwHl5q33&_nc_oc=Adpz77H0j6L2M5WZOULoaEerOpn8EY_cYuj1W7pmM_Ex4lIVkgiCrX99WtTiExAoeK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVj4h9b2P7E3k-tbR7baQxsU7mq6xkMfJWVATmLTzL5A&oe=6AE765EA"}, {"file_name": "splatscreen4.png", "id": "1222226439078854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75287554_1222226445745520_7139984044701695194_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VstEeOtpdssQ7kNvwG5ys3W&_nc_oc=AdqGTzviyqAOqYIKxDcUkMsS-tr6rO6lWY0L7yKg4bH5Isjxo1bw_ybNmvaasHo4Xx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ95AP_gGC8JWibvmRVfZb1bSkgRgPNZ4So8wQcA2dZAw&oe=6AE770E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splatcover1.png", "id": "27727614090220486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/442456783_27727614100220485_6038477975986382459_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfsfNpPXGNkQ7kNvwGpoBB1&_nc_oc=AdrjwcKu05Sn2VTJjQGsnWvjP3bv-beIcmJw5hNyR7nZFq_vR4VQ_lBNrdjtm_Z70yk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROmXO49_SDbczOZihroT73TC4ZxedrCuUwMagXHpyr6g&oe=6AE7503A"}, "display_name": "Splatsplasm", "keywords": [], "long_description": "Splatsplasm\nPlaying as an astronaut, you approach a creaky, abandoned spaceship where you'll fend off relentless waves of weird alien creatures in various arenas.\nStart off in campaign mode, where you\u2019ll unlock a fancy new bat for each level cleared. Each bat changes your gameplay. \nSplat the aliens against the walls until there is enough alien goop on the wall to dissolve it, and reveal the next room...\nA couple of words of warning .... you really don\u2019t want to hit the sponges. These little traitors will clean the goop off the walls and you can watch your progress go sliding backwards.\nAnd the alien waste disposal system? Yeah, that\u2019s running too. Miss a beat, and your head ends up in one of those purple waste streams\nIn Fun Mode, the task is simple: Smack as many aliens as you can into the walls, because why not? You can groove to the in-built beats or go wild with any public domain jam you find on the internet. Thousands of songs for hours of alien splatting... just what the doctor didn\u2019t order.\nSpaltsplasm is pure stress-ball energy. Splat your way to inner peace or at least work out some road rage after that person cut you off in traffic today.\nGet splatting, and may your walls be covered in alien goo!\n", "short_description": "Welcome to Splatsplasm, the ridiculous new outer space VR game that\u2019s basically bubble wrap-popping therapy for rhythm game addicts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.splatsplasm.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PRPVFX LTD", "support_website_url": null, "website_url": "https://www.splatsplasm.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8741875095878282"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1580146219720542"}, {"status": "PUBLISHED", "id": "768073699673923"}, {"status": "PUBLISHED", "id": "1735418943821350"}, {"status": "PUBLISHED", "id": "1392188872914668"}, {"status": "PUBLISHED", "id": "1782725899312748"}, {"status": "PUBLISHED", "id": "474710435458496"}, {"status": "PUBLISHED", "id": "607009325147042"}, {"status": "PUBLISHED", "id": "1648419299429740"}]}, "baseline_offer": {"id": "1580146219720542"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774897980, "status": "PUBLISHED", "id": "1580146219720542"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9045623582170097", "version": "1.0"}, "id": "584178947464407", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes"
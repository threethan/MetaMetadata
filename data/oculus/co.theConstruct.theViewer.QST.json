5/39031354_253507116274136_1982848679635783336_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNeWQ-zy_fwQ7kNvwHtUBYe&_nc_oc=AdrXW0l9JVn3xalCwXIzedsAXhKjq_BBiD0nS8hdOVoPl4JIhW1m6rLC7zLFvNlJB1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5PbIAOmeNp3125vRpvFPWkiJlvCDpAcm6KFnLql8jaw&oe=6B045BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3cover_n.png", "id": "508447683513346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974578_508447686846679_5933018524326450542_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeiXuSoWtioQ7kNvwEhVVT8&_nc_oc=Ado1iiBtOL-eZ4xpBl-l-o632fpYeOeaqGTcGK_wcim_LwLbJ1n0_RjYSYH0LY6ghxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr_x8PVwMoSMA-MixYoxtQmCgrPRdJHAz-ue2MGt_jXQ&oe=6B046D7A"}, "display_name": "theViewer", "keywords": [], "long_description": "No matter if you are an architect or an amateur photographer, with theViewer you can create VR tours from 360 images in minutes and immediately view them together with your client thanks to our Shared Experience functionality and Oculus Avatars.\n\nVisit theViewer.co to find out more about special features like :\n- magic links\n- shared experience\n- embedded VR \nand many more .", "short_description": "theViewer is the Easiest way to Create and Share VR Tours from your 360s \nTrusted by the world's top artists and designers"}]}, "developer_name": null, "developer_privacy_policy_url": "https://theconstruct.io/theviewer/privacypolicy", "developer_terms_of_service_url": "https://theconstruct.io/theviewer/terms-of-service", "publisher_name": "theConstruct BV", "support_website_url": "https://help.theViewer.co/", "website_url": "https://theViewer.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscrip
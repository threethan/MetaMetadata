ler": null, "video_trailer_thumbnail": {"file_name": "3cover_n.png", "id": "508447683513346", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974578_508447686846679_5933018524326450542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoLe1F6q1ZcQ7kNvwEaGSij&_nc_oc=AdkAx25iJmkDdBr4KUs5GbIaKpel6Xp0S4eel2Kau-8BrmFAgdZTtwck9PzSvU2q5K8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6IuxvgpOfG3fqx4rdvBvRuVIgqbhEmL8pH-SU9bi92g&oe=69B406BA"}, "display_name": "theViewer", "keywords": [], "long_description": "No matter if you are an architect or an amateur photographer, with theViewer you can create VR tours from 360 images in minutes and immediately view them together with your client thanks to our Shared Experience functionality and Oculus Avatars.\n\nVisit theViewer.co to find out more about special features like :\n- magic links\n- shared experience\n- embedded VR \nand many more .", "short_description": "theViewer is the Easiest way to Create and Share VR Tours from your 360s \nTrusted by the world's top artists and designers"}]}, "developer_name": null, "developer_privacy_policy_url": "https://theconstruct.io/theviewer/privacypolicy", "developer_terms_of_service_url": "https://theconstruct.io/theviewer/terms-of-service", "publisher_name": "theConstruct BV", "support_website_url": "https://help.theViewer.co/", "website_url": "https://theViewer.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STAND
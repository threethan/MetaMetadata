5/39031354_253507116274136_1982848679635783336_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7xecEVUbEYQ7kNvwFted6a&_nc_oc=AdqdtsHcNVKoUTpkSfr82OS7L8F0weuwfSKfrs_elv4AMuIgTmoCkeCdou41eATdHnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTdfwAXJJMGb7MoKYhVLwRkuIOms-Z_2sDKwBLCVrDJw&oe=6B0DCEB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3cover_n.png", "id": "508447683513346", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974578_508447686846679_5933018524326450542_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYe7LfCfif8Q7kNvwGNhVmc&_nc_oc=AdoF6PdnJk8mRAkTDGD1ZY2WE00Lp_ReWl6rO7C3MzPFqG8oHBPrqP5468CVEYsfYn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRN2fijCBRS5V_MQ5MknvYhht0CQA6EQybMxeXUtXVYfg&oe=6B0DA7FA"}, "display_name": "theViewer", "keywords": [], "long_description": "No matter if you are an architect or an amateur photographer, with theViewer you can create VR tours from 360 images in minutes and immediately view them together with your client thanks to our Shared Experience functionality and Oculus Avatars.\n\nVisit theViewer.co to find out more about special features like :\n- magic links\n- shared experience\n- embedded VR \nand many more .", "short_description": "theViewer is the Easiest way to Create and Share VR Tours from your 360s \nTrusted by the world's top artists and designers"}]}, "developer_name": null, "developer_privacy_policy_url": "https://theconstruct.io/theviewer/privacypolicy", "developer_terms_of_service_url": "https://theconstruct.io/theviewer/terms-of-service", "publisher_name": "theConstruct BV", "support_website_url": "https://help.theViewer.co/", "website_url": "https://theViewer.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscrip
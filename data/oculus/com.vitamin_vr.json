tion with careful control of volume and endpoint observation. The experience focuses on correct sequence, safe handling, and accurate measurement habits.", "short_description": "A VR lab simulation that guides you through a Vitamin C content analysis, including precise titration steps, measurements, and result calculation. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.knou.ac.kr/knou/123/subview.do", "developer_terms_of_service_url": null, "publisher_name": "KNOU VR Lab - OpenVLab", "support_website_url": null, "website_url": "https://www.openvlab.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26447665708218669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619159_906847465421844_2301521955612619382_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Axhyk_xSnewQ7kNvwEbVOJo&_nc_oc=AdrPUuKG9x8HDjqGc3VS8gVnop5rgJpRcflJd2viitIjinYf2IV6XJ9whylazD__6vQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOci0i71p9sbF9CHUrkjLSOEteAVh-tDBZRtjMdneKRQ&oe=6B083DDE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "\ube44\ud0c0\ubbfcC \ud568\ub7c9\uc2e4\ud5d8", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
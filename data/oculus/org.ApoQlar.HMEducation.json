XeLx-g&oe=6AFC7A87"}, {"file_name": "org.ApoQlar.HMEducation-20260624-132755.png", "id": "4490614454592314", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491828028_4490614457925647_5434787555769603899_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLJ7Z4jHstkQ7kNvwHQZcWa&_nc_oc=AdpDnYw85bSOXAroniuCvEdN9BxI3_9RtGEFWy6PMnkZOG5ESpyTOMOk5g7t07hNbP0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUTqQfwtxrAiF3zAyu809K5a8eqV5nmrL8V2VmTi5k6Q&oe=6AFC6A2C"}, {"file_name": "org.ApoQlar.HMEducation-20260624-132732.png", "id": "1579342453707315", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825470_1579342457040648_526706241063663065_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9DVe0N-17wQ7kNvwHw9o8L&_nc_oc=AdqhVQFFVNGyE4GNNfhDzUkT3DHZfToGhl4BkWMerFPjb0cjiAT7bicSduRzrpBW4nw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0zIxzy7Ie0DC5F6dOIK52-3jPhnmuNvtmDjl3-2P7KQ&oe=6AFC90FC"}, {"file_name": "org.ApoQlar.HMEducation-20260624-132638.png", "id": "1349193010490943", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825345_1349193017157609_3475846142829712007_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1Czw9rbBe8Q7kNvwEurbLW&_nc_oc=AdpUUWseDdM2TzvJmjfvVoX8G8rVn_9pT9OQ8D71n3r8vdjgYQteSvyCtWqd1U8DbGY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYa19sXim3LVZf-teWiLRpiM_SdQvGLGASjY5uS26sng&oe=6AFC7E4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-04-29-09h36m27s998.png", "id": "1500211501455043", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820441_1500211504788376_2416225467677078513_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrkD-_prXroQ7kNvwF-zXAh&_nc_oc=AdqHHz97SJLwqHh-9Ka37Z47ULjYNmX21GAmoptYK41CusDG7N5ESK5rStLlXZbYBvM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwslG30b3pxuXaH7XXk6ycBYcx7CnKFM_YptC6ooPB6w&oe=6AFC9424"}, "display_name": "HoloMedicine\u00ae Education", "keywords": ["Anatomy", "Simulation", "Training", "Collaboration", "Medical"], "long_description": "HoloMedicine\u00ae Education brings medical imaging data into mixed reality for learning, training, and exploration. Designed for medical students, residents, educators, surgical trainees, allied health learners, and anyone studying human anatomy in 3D.\n\n# FEATURES\n\n- DICOM visualization (CT, MR, PET, SPECT, US, XA) with multiplanar reconstruction \u2014 axial, coronal, sagittal\n- Interactive 3D anatomical models and 2D media (images, videos, PDFs)\n- Crop, rotate, and window/level adjustments (CT presets: Bone, Lung, Soft Tissue, Liver, Brain)\n- Planning tools \u2014 annotate, place arrows and markers in 3D space; save and load scenarios\n\n- Hand-tracking only; no controllers required\n- Sample educational datasets pre-loaded \u2014 start exploring immediately, no login needed\n- Collaboration (Coming Soon) \u2014 host or join collaborative sessions with peers and instructors\n\n# REQUIREMENTS\nMeta Quest 3 or Quest 3S, Horizon OS v83.0+, Wi-Fi (min 30 Mbps for Shared Experience). HoloMedicine\u00ae account for access to your organization's content library.\n\n# \u26a0 NOT A MEDICAL DEVICE\nHoloMedicine\u00ae Education is provided for education and training purposes only. \n\nIt is NOT intended for clinical use, medical diagnosis, treatment decisions, surgical planning for real patients, or any patient-care workflow.\n \n\nProduced by apoQlar GmbH, Hamburg, Germany.", "short_description": "Explore medical imaging in mixed reality. HoloMedicine\u00ae Education lets medical students, residents, and educators visualize DICOM scans, 3D anatomical models, and 2D media on Meta Quest 3 / 3S.\nHoloMedicine account is needed to start. \n\nNOT A MEDICAL DEVICE. \nFor education and training only, not for clinical use, diagnosis, or treatment decisions."}]}, "developer_name": null,
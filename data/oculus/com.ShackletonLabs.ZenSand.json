.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA9Ht0wYRO0Q7kNvwGA7jaC&_nc_oc=Adqx3dZX4ReHLJc9Q7N-kAN-IR_BT63Divy4sdPIWL_kcl5n1KpY5zsz_NgTxeJercc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzVNQpxVnL2CLgj0MWnDHm7dzT6n3U2ghFMOJ_Xv0Tqw&oe=6ABBBBF9"}, {"file_name": "triforce-circle.png", "id": "917706974385601", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_917706977718934_2970232128500494362_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo9Q5KS4TdcQ7kNvwFSDPw5&_nc_oc=Adrsb0m2DQDecYmDsMgiU6n7cy2F2Cs2Azv32U6JvfQXYM7Rb8acUSCH67b6DCfBVLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuYV_Jpw724BK2RbLpki5vI8MDhsZojVkGWmRqLU3vCw&oe=6ABBB6F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Sand", "keywords": ["Meditation", "Mindfulness", "Relaxation", "Art", "Wellness"], "long_description": "# Zen Sand: AR Mandalas\nRelax and unwind as you create peaceful art to relax the heart, mind, and soul.\n\n## The Experience\nStep into a digital sanctuary where ancient tradition meets modern immersion. Inspired by the meticulous discipline of monks creating complex mandalas, this app transforms your environment into a canvas for mindfulness. \n\n* **Tactile Intuition**\nSimply close your hand into a fist to begin the flow of sand. Release to stop.\n\n* **Focus & Flow**\nEngage in the \"micro-moments\" of creation, focusing on the grain, the pattern, and the breath.\n\n* **Boundless Canvas**\nYou are only limited by your own creativity.\n\n## Key Features\n\n- **Fist-to-Flow:** Natural gesture control that mimics holding physical sand.\n- **AR Integration:** Layer your art over your real-world desk, floor, or garden.\n- **Zen Acoustics:** Procedural soundscapes that react to your movement and speed.\n- **Impermanence Mode:** Practice the art of letting go by clearing your canvas with a single gesture.\n\n---\n*Unwind. Create. Let go.*", "short_description": "Relax and unwind as you create peaceful art to relax the heart, mind, and soul."}]}, "developer_name": null, "developer_privacy_policy_url": "https://super-beignet-cb24e1.netlify.app/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Shackleton Labs", "support_website_url": null, "website_url": "https://super-beignet-cb24e1.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25713596395009136"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305114_1569144310835955_4576424195948927785_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90ylHG3xzS4Q7kNvwHKqELr&_nc_oc=Adrt3hixfh9l-0vhXa0212T60esBOr9vLLLAjR0rmtXG5BxV3eodfx7RuUvGj7sI9Mc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1wGAk5zP3927Scvtn_N5F2gEG_xXh2iADQoiWpSbk3A&oe=6ABBB0B5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Sand", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1774987380, "lastRevision": {"nodes": [{"id": "25713596445009131", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata":
20f&oh=00_Af8x60E4W3FmGjHdUgeGFDzr4jeyjFiBMGE1eiWchnEiYg&oe=6A22CBAA"}, {"file_name": "yumtongmyyang.png", "id": "3437868499711281", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821194_3437868503044614_331360850802110944_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiqzF0jGxF0Q7kNvwGtJ8gq&_nc_oc=AdrZwgZ5iRbeTRJ7hAUvd-ByfW9-VXJs35M0kAUN791Ji3raT_No2MZWTlMfNGQk_Pc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E5dRNA3QArDo7zmajROEGoA0J3Q59nx5zOVLXwGkfwg&oe=6A22CDF9"}, {"file_name": "triforce-circle.png", "id": "917706974385601", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617762_917706977718934_2970232128500494362_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZoelTYn9JAQ7kNvwFKbd59&_nc_oc=Adp272Ex1gc8MMJ7z1AIZa0r4zJ2VDY9TBAYLR18br8C2uGUK4xXkCxb5ImtmV2syOE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jfeuvL3iq9R_2Od1oMZQPMtwZQF19EDeW7S87SsJzlg&oe=6A230130"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Sand", "keywords": ["Meditation", "Mindfulness", "Relaxation", "Art", "Wellness"], "long_description": "# Zen Sand: AR Mandalas\nRelax and unwind as you create peaceful art to relax the heart, mind, and soul.\n\n## The Experience\nStep into a digital sanctuary where ancient tradition meets modern immersion. Inspired by the meticulous discipline of monks creating complex mandalas, this app transforms your environment into a canvas for mindfulness. \n\n* **Tactile Intuition**\nSimply close your hand into a fist to begin the flow of sand. Release to stop.\n\n* **Focus & Flow**\nEngage in the \"micro-moments\" of creation, focusing on the grain, the pattern, and the breath.\n\n* **Boundless Canvas**\nYou are only limited by your own creativity.\n\n## Key Features\n\n- **Fist-to-Flow:** Natural gesture control that mimics holding physical sand.\n- **AR Integration:** Layer your art over your real-world desk, floor, or garden.\n- **Zen Acoustics:** Procedural soundscapes that react to your movement and speed.\n- **Impermanence Mode:** Practice the art of letting go by clearing your canvas with a single gesture.\n\n---\n*Unwind. Create. Let go.*", "short_description": "Relax and unwind as you create peaceful art to relax the heart, mind, and soul."}]}, "developer_name": null, "developer_privacy_policy_url": "https://super-beignet-cb24e1.netlify.app/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Shackleton Labs", "support_website_url": null, "website_url": "https://super-beignet-cb24e1.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25713596395009136"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "903807709342801"}, {"status": "PUBLISHED", "id": "1275937191288677"}, {"status": "PUBLISHED", "id": "2519976975124244"}]}, "baseline_offer": {"id": "2519976975124244"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "903807709342801"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25916942181341222", "version": "1.0.1"}, "id": "1912204942765760", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "
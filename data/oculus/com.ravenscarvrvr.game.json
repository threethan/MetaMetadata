d": "1451344660272131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499627502_1451344663605464_8490123737122144627_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXEADXOfC_EQ7kNvwF7FYmt&_nc_oc=AdruF0RjPa4Po3R_qRwfJ0gSekBW19qHZsFtahUBq_3Qoij-JtVvzofcrbqzg4V52Xg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyahZ7WsaFEn1sGU4T0T6y34OWw-jjkqHT4T7orVapIw&oe=6AFB424A"}, {"file_name": "Rvnsc_jump.png", "id": "2311071823065777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593919959_2311071826399110_7275812116933911031_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oci_9h4iqoQ7kNvwGjoE2P&_nc_oc=AdrvJWHO9v7NocOpZTGwRqdNjgYglv-nYb80LVbW-UJZufXXjWrEY5CUd8tYQ3Y6_AI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBFbc3rKrpjfnrkCnLZYu7AAYwaCaitJ4ns9_JcXILIg&oe=6AFB4A9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ravenscar VR", "keywords": ["dungeon", "multiplayer", "coop"], "long_description": "Forge Your Legend. Fight for Glory.\n\nEnter the brutal world of Ravenscar VR, a Viking-inspired virtual reality action adventure where survival depends on your strength, skill, and courage.\n\n\u2694\ufe0f Immersive VR Combat\nWield swords, axes, and shields in physical, hands-on combat. Strike, block, grab, and throw enemies as you battle your way through dangerous encounters.\n\n\ud83d\udee1\ufe0f Four-Player Online Co-op\nFight alone or team up with up to three friends. Explore dungeons together, battle relentless enemies, and face powerful bosses.\n\n\u2694\ufe0f Level Up and Unlock Weapons\nEarn experience by defeating enemies and completing dungeons. Level up to unlock new weapons and expand your arsenal. Your progression carries forward between adventures.\n\n\ud83d\udd25 Optional PvP Arena\nChallenge your friends in a dedicated arena and put your combat skills to the test.\n\nYour Saga Begins Here\nGather your warriors, sharpen your blades, and prepare for battle.\n\nEARLY ACCESS: Ravenscar VR is actively being developed, with additional content, improvements, and new features planned for future updates. - Online play may not be stable or optimized", "short_description": "Enter the world of Ravenscar VR! Battle fierce enemies, explore dangerous dungeons, and unlock powerful weapons in a Viking-inspired VR adventure. Fight alone or alongside up to three friends in brutal, physics-driven combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mobilitystudio/home", "developer_terms_of_service_url": null, "publisher_name": "Mobility Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/mobilitystudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "1344690622066301"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619404_1140407282188269_7399350216361463956_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnzGSNZvQZ4Q7kNvwFx62mE&_nc_oc=AdpmXhBOcW9eJcI8hJZIoautaBhfUtY55tVOvCOR-KlJ9LjhFbEIzQFrQgcDn0Mu2Bs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG9jOvFiHwir5r7zujE18AbHGDAfKbO0jttn
121913404823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umr_OvDRMNIQ7kNvwFFTFeG&_nc_oc=Adnwx2YivG4D4PNzFcD1J__lA4guj01Kj0XG4c33pTewNoAAXV7qdzPvZiPmeQrG4gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdeNvcbruX2G5UaN-anyYCQTQgObidGRmPf7mt1Pdr5g&oe=69B6935C"}, {"file_name": "Screen3 copy.png", "id": "999514750742610", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001691_999514754075943_7667676765072486147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJOiQP2htAsQ7kNvwFdBb3F&_nc_oc=AdmTFNE_c29_Am92jg-opurmkxtBZI4wU5o7OYAuI6nLLg2GLFgDQD9gcRMG76e8a4s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2hpBCvtfWypwRjHHj0cMcmh-cVdnBQgl5Rxq05LZVBA&oe=69B6B7A1"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNyba4Qb8eIQ7kNvwFctpm6&_nc_oc=AdnoqmINl8quo6tlzFg3tqeVyKYlxzyrg1IO3kYe2fpOUVDSZcA2DeEDW2vI3l98ryg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWhbQ3VapRyB-UJHFiZqBG8h2GMkW21QzwyKZoK8NFmw&oe=69B6B3B7"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1510ZEeBwoQ7kNvwE63tkf&_nc_oc=Adl0n2UsOjDp7QKr1DGA-b0GSeOxdCkoCOYi__w504nYpORR9IGbgq3y8BQK8Jycs08&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJVzKzSju5b2-ejmPJnkfujRMShieYFQzAkNuHkjcBXQ&oe=69B6C0CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6kcBgOt8BgQ7kNvwHpg91q&_nc_oc=Adlb4NZHpU73JH7EMccHsrXyGaWpGGZomZuB_A9eUAfTtTOj5F7nc475ioiwdRnDwlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz-rh9HLgO3fhHW2Q58jdEsJoGeQpxkhT1GJZ-Ahp7Vw&oe=69B69D1D"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
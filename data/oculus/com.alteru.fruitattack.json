/38974672_1060755457915323_2954547121913404823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQDt2MWSELAQ7kNvwHD6PmN&_nc_oc=AdogL6WdFseInb3mTkEI386ZTEo6bp5UDNt_qisUO1YhBcpB1NbwHK5r0wEwf2-mqaA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eVwJ7zUoAeq45uM6WFdp3HBXdZBFJilYUWrmyeOUGfQ&oe=6A39501C"}, {"file_name": "Screen3 copy.png", "id": "999514750742610", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001691_999514754075943_7667676765072486147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzZqXJ3reZsQ7kNvwGERPwf&_nc_oc=AdoiilqfW4edx2OtDkEV_dR5Yft5fgMfOajstyVWkk1hUy0NWjSgfVNsWweN74NUH84&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tc8aDfWnlE3t1YtHKNkc6BxmOrdrx-hVA4FKpCCs1Cg&oe=6A393C21"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3lbxYi8iFgQ7kNvwFjUN_Q&_nc_oc=AdrK3-C-gjisuzrPWUUJGbSNpe16R7eHPyVhjRPkUQIQrxYyGze2LmR4i3jLCKaJouU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hymLqvw3BqPMqG6m8o2judfnQT7lSDdqg1r6DfYor5g&oe=6A393837"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u8WtGf-QO8Q7kNvwHjluHI&_nc_oc=Adqp9BrwjCJy9xzDsDd9EAUFE-rlyIMAGkA7TgBfBe9ePtMO2L97bN4t3nssf6n0aug&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y51sl4ASY1xdBwzJnoudoR7fmv5lp-T1fK7teOC0eUg&oe=6A39454A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sV6NNVknUyQQ7kNvwF6DTI2&_nc_oc=Adp9zPM0Gw78v--5jYWsxs7kGJibpCpFppZFNXKi7TqT380jMjb69VZMcD9hKBghezY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9izshCiczuc97Fg_Y_eiD3go_7j9YL9i_r85wf_wH9XA&oe=6A3959DD"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
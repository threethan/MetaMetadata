121913404823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoxSL1LpeNMQ7kNvwFg-5h9&_nc_oc=AdlSZ9qpv6kKfuBDQTi9zjMh-MMiIZieTOOVArZ1w5UjD8ovz01EbPVG0tZbSK7KfEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfshYTQa8CQNI3uxKd9bTDlKGDPl6MdRSiHJrxFDazW56w&oe=69A812DC"}, {"file_name": "Screen3 copy.png", "id": "999514750742610", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001691_999514754075943_7667676765072486147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcM3fE7wrZkQ7kNvwEvondi&_nc_oc=Adk6ICzPmJr3jG09iCJSXI7EfXAksfbYuDRlKteygDtGeBKvYTErmLEuCcTTs_zfPDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvsSkZD4mRZvyzjzalam7c8UFyPzayzd60KvqczxaIUxw&oe=69A83721"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRwVzh97X1gQ7kNvwHVqAfe&_nc_oc=AdlXRgX9NiVTUZ0P-vEnaF28IQ1O6gEFRjk2eY21VsCYo8oCadzZEaFazga9y3xXCek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuUmwNXDTVUIUPMt8cI0M_jcf5O9fPFjFOPcboGrnROtQ&oe=69A83337"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lptgyAI5gLMQ7kNvwEDm3Jk&_nc_oc=AdkchP4MVYPr3Ygo64ly9v7LZl46_AttKF6tjmOAVSzUzdrrjxe5wcqSj-gDLsJZnoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuiyKgxZ4H-8V232y2b99y2RY5USV5qo23oqv4zefqNZg&oe=69A8404A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGI1-8FUs54Q7kNvwHRjZ2V&_nc_oc=AdkNeC3FZoocZGtBbYCOumoLF8WHM4ZvpzzT-RxXYupkNDxRKxxesWPeqCAH7ahHHSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsHDDwiI1hIZmlldYPFF6_ITxReSNwFAsMRMGfmzbg9cg&oe=69A81C9D"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
ng?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXXgZvDGxmIQ7kNvwEI177Y&_nc_oc=AdmPed_4zg-Ib1zWceW5HskYmnqQVBQ4FJxVwvFs6MXqQErrSPcca_E4-pGC4duVzh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslhHHKdqNI3Mvwqqjz6eMVIJj5dFmoAhkbbmvyFsJvFA&oe=6999B2B7"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXE5ObWzea0Q7kNvwGZ23q4&_nc_oc=AdkHW_UaRlw3ZTnUcXbdcESYPchUfTyT3sJ8IAGrrgdyrF1SWsKrVrRqKIswxRL8CWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvfXCTpHCpLv-JiFP5BBPtRzEBdY-OCKqZMJW3mV7CxhQ&oe=6999BFCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Smiq9m3Ex8AQ7kNvwEzRSaB&_nc_oc=Adl0Z9xrLk-7HYYWlZVIE66Ne6ckeUcV2c4S70Zqmh98I6NgLOzGaEB_O8zKELprDTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSET_FCx6SIZbyOLReJEMR-gLDIu6bATzcPTc-3aJpKQ&oe=69999C1D"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "863212618416448"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1025828001432309"}]}, "baseline_offer": {"id": "1025828001432309"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1658515320, "status": "PUBLISHED", "id": "1025828001432309"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5775524795867990", "version": "1.0"}, "id": "2236097656559984", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5280691895351285", "is_concept": false, "latest_released_binary": {"__typ
121913404823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_I77Sspyl4Q7kNvwFvetp_&_nc_oc=Adm1uq9fmf0I0-a5FgXSd8Ln8FWegJCEa-UJMMqqGJaxNZbz2fTSrK1mZ3y6HZsDljI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVHhXwsYptzX3vP9PNw2TbBeh8WWV_QXkp1E7Nrr4Ojg&oe=69B14D5C"}, {"file_name": "Screen3 copy.png", "id": "999514750742610", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001691_999514754075943_7667676765072486147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfJ3q0c8qWkQ7kNvwFoFD69&_nc_oc=AdnGdTl3wGWWbqIyRv7I3ngH_fJk0Rpz1fc7dJJLD-QSgQxE8q9D1-UuZMUoEpdGF7w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzX6V8ga1ujxF2vK42Hj-4mp4WHjzF8bY50jvj7rT8f3w&oe=69B171A1"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLpnOai7V7cQ7kNvwFuQKqD&_nc_oc=AdnMqk60Bbcp-W-BxyI3k5r0O5ffp2qY1y4PzE_Izbft_RHtsS80nLHLbpy7OUPrL8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoVZnsTT8tFllppSeKQ2bis2VdpFxzkBvY_FH15CSRPg&oe=69B16DB7"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQ7I4fU_iIsQ7kNvwGsNq5C&_nc_oc=AdlsYSvFUdqh-33yB5I3hKarCQvaRZrhS0amCNrJFJAVfHRsaSxm7QuteP_lzQRAmcg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIwtr0UNJH19U3mToZmyxu1E6qjuyPHZi4y_xXXck-rQ&oe=69B17ACA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdrQ5T5gCvcQ7kNvwH8IVLv&_nc_oc=Adn002pSPKVIEmLVmfDysbZJbmcsve6VPtu2w0N8d_k8erqAdRjjsJFKrZvs_6kv4Zs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyI1JJA2APCmk002HCxcWVpzY2CCv5oxgAkbQaAF16hBA&oe=69B1571D"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
QOkV_ojEL2VY5YgE9H03MQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr9mGHHyNa2peLghKeD-f-0nJHTUw0YLTqN7XFBHbIgQ&oe=6AC3A9A1"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L1_1R0utTIQ7kNvwEVAGwe&_nc_oc=AdrYm9gYlJpc6ONYDk_Q0qU2U0vxgudQK3Phfus1kPWEqG5gIbQqsaoDlkJQFhjb9QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR3RBAGz46x46fK84CvycgH9OAK37a-y-9DB1O1_0SxQ&oe=6AC3A5B7"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCPD19knS6IQ7kNvwF7XXMF&_nc_oc=Adqn2WGVG91u7qKwraKSTdQBajEh-_Qxai8rfAodOckOUdMgmy8N2ZDvROobeuXyylM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcqv02soSuYmNOICp47LiK--jUM8w_MlnnABK6YkZziA&oe=6AC3B2CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXFE2yKV0aUQ7kNvwFPq2PX&_nc_oc=Adqa-Hi29EROFL_XuHsgGtYeU7H7ZWBh1TTPC2fr1PMZby5msMB4QOA4LFn6hkoUpOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA9bI0gSQPgHmRf8r0z6hsqT-TT5l54yY4JLsLmTnHdA&oe=6AC3C75D"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "863212618416448"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1025828001432309"}]}, "baseline_offer": {"id": "1025828001432309"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1658515320, "status": "PUBLISHED", "id": "1025828001432309"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "577
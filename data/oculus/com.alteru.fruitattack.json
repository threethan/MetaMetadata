121913404823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umr_OvDRMNIQ7kNvwHH293Y&_nc_oc=AdmBsSbEGxCU__P03tg6s2mW-orZHmQZFjXZk9SljtGMY9a99aWUmFW4Avu4Uf4ta80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyXTHrbEDo5m-3aqvUErijUaLD1ZRbtiHqy78EupXRHCA&oe=69B7E4DC"}, {"file_name": "Screen3 copy.png", "id": "999514750742610", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001691_999514754075943_7667676765072486147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJOiQP2htAsQ7kNvwFefTf0&_nc_oc=Adl52LMbFW17bvsKJKcMoisN732lb9mkQ9GtuB6qe9XZ6eY3VtHO9zWjISxpPitQ6dg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMbcuepnZuqyutKEtNKxy1RTbQnRpv85D8_xYeOAj7AQ&oe=69B80921"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0Z1csn3Ls8Q7kNvwH31ZBf&_nc_oc=AdnbJBbKZJ7i8jlezllJVdsO5TI-dabzdVsPg-ys7fMA_YD58Dw5sW4BwIBu7EOmUyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZkZ06QzEWC2p7bs7XMvi9313P6NLvPw8VKCZVZa2BLw&oe=69B80537"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r1p5q3prgIQ7kNvwGtdOm6&_nc_oc=AdlMqm26C4FGZ74cqYit5XMBxUOhgcio1E7ZfOah-kJAYr9eb5qI-qVAoYiJyMDS_58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcBj4QjX3neE_ED8LSoGTtFDZjvy90XgRlaGCZu7ALIw&oe=69B8124A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6kcBgOt8BgQ7kNvwHVdaPF&_nc_oc=AdlcyffL1Jw3XdLFNddmeJKzA6LSHlbcSXogqiYKVYuipmSYCMK2qgn-7LUGCHyvXZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFhohDmdt_bLybnMWcfy3BqeQqV4JxXJd762dQSXDTQQ&oe=69B7EE9D"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
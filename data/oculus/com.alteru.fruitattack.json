AoUExJwvOi5tujmgTonJfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlIpaXpYS4nOt986DlouBsue0tpsD0H0vexfqkzgBbrg&oe=6AA55721"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z0IHmyDpQoQ7kNvwHmTWeq&_nc_oc=AdqI2AwCRaANTT6rCJhSDW_lEYp7amDuftLhzudZoozmPWGtfi2X6yNzreBh3h8lqT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC8R4DOFmbCWLco8gXrtItBaed4h6DwoqJQdLxX8Je0A&oe=6AA55337"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLZvlCGX2DUQ7kNvwEx_Gij&_nc_oc=AdpFgBaH0ZCcKYu0dfuOz--EW6_wT0nWH81HwwvG407lCWHE5lBfgSIf16X0iLtEs9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOTjxYo-QYDuzvnzB_MUZ8_weLYK5SCWouR3mUzsewhg&oe=6AA5604A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjy6YyHXmOQQ7kNvwFBsQj5&_nc_oc=Adp7-tnW0IfL0GdRjc6YLq1G_5tR-JP751ifDip1RSxnsSqiOHzeEOJU_KzlcM3EVMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCCZi5eaiB0IlkRCL4xzaZplZjr8kXpUb2EVk5ooL2zw&oe=6AA574DD"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "863212618416448"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1025828001432309"}]}, "baseline_offer": {"id": "1025828001432309"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1658515320, "status": "PUBLISHED", "id": "1025828001432309"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "577
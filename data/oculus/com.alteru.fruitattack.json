121913404823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC3hmU6pSssQ7kNvwHntkUC&_nc_oc=AdlMxOY5wIdKRXL303SUfIJdx0L0v178D2na1zsArFncZrwehbcMtL9Nmngv25L-XOs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjX0-Y6VjyN4xTEHIMpBwxAIvYPp3c0XNLUPKbY0gYkA&oe=69BA87DC"}, {"file_name": "Screen3 copy.png", "id": "999514750742610", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001691_999514754075943_7667676765072486147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCe8vahPbDoQ7kNvwGDXXhW&_nc_oc=Adn78qi3WPXvEDHHvDjFEW95b7nHwp4mf1iZ9eLd0JqyD69EQFcHUHbbwzjyPW7_LeE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkGW5POv8J14rV69uBjOrV6wQSkh_GYYDXy5p4XXQ5sA&oe=69BAAC21"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0Z1csn3Ls8Q7kNvwEu6Lsd&_nc_oc=AdlfgCIJKj81dRRkhrrv88XiwnSHcvdrTPAdtzRbI0kLY59DSdEQQcW8SLeIkW6Bzj8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCm-sYI77Tgze_KNdtPXQMxYI1FkCJip-HcC3sl0EsCw&oe=69BAA837"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r1p5q3prgIQ7kNvwFE2bsJ&_nc_oc=AdklXC9wAGeyYGGUEt8-vzEFV1aqkIOY3CU65e7ZYjbsGot8a933D58cXIXV2vPyp04&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLwgS_P2icTT78CIhElV0xdNlmIMzrgFKlTafzGYbPuQ&oe=69BAB54A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sMe-QLPUZQQ7kNvwEojETm&_nc_oc=AdlnG42Np8QzyU7EgX-RnT2FhkegJdnq7_YrEzPV7J14gUbyGfrBgF_dwhUjMntlHSo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJcfP7uENta4BHDc-mVMENrCtMvAu1AQ-x4kfuwGtwyg&oe=69BA919D"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
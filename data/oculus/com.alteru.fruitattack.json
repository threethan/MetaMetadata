121913404823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL-A9_lUOEgQ7kNvwEji87K&_nc_oc=AdmJM0JTtySSPnMjR-0MQUGZDVdJ6a4bgotv89dnSxQrENyuX01xTxoAkEAOfowQsXg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfI9ZARGkTdSyicogM0QfiJbahFfqnrXAinGfzXGb59Q&oe=69AD58DC"}, {"file_name": "Screen3 copy.png", "id": "999514750742610", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001691_999514754075943_7667676765072486147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0C4wWCv8BMQ7kNvwFT5x-R&_nc_oc=AdlC7PM0TwCyJZg4xTFSwus3RfK_5cTH0tDjDjwcxH-vZwxlgz6-wZi0pJfn6MKQLjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDg0fUABrnxknjeMsbb9IMBdS9qOmphe37ueNjCtm0pg&oe=69AD7D21"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIF3I5aLw4oQ7kNvwGYxnYN&_nc_oc=Adk4sbpxXwrQv2se_Pa1odWnp7FIqyRj2_H8ZvKs_cYZvI6kgM0LbDYZjtWSO63yH10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIBt03_pPH2XB6cfJ_T0l2I_xSbEy599-dKrfbrRBg0Q&oe=69AD7937"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0bzvF-KAcgQ7kNvwGapvKQ&_nc_oc=Adnp_641kWnCs6t5sg124t8Nm8vj-18is_S0I9v-qpdw7piD9Bgg5lIeZ_XXL6FhWWs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBpRojJh6IXdEkA5LZ125XzL_rT-mq5dCicO641XGPbg&oe=69AD864A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTccbQyAT8YQ7kNvwHxafqk&_nc_oc=AdmY6TtpTNzma_LnltXAThai4MRoOOzxgyaa5moOf4tt5i3a1Ci6anI64dOKhseOgAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmrYOvHOduXg4FPXz49u3LSBv4WHHUxWHKFbiFjcDdkQ&oe=69AD629D"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
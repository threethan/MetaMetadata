/38974672_1060755457915323_2954547121913404823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7L-Vk0M-lEQ7kNvwGyqIWp&_nc_oc=AdpMhltw91evY6zC85kiXnGBCqhJyukrk0F36CDqvczkVEcCBcS9d1VTCxY3bWoALpQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-16XDHQO-uPMVfgyUL-5OK7qFdTx8CAymdHOKAUUzMSw&oe=6A467F1C"}, {"file_name": "Screen3 copy.png", "id": "999514750742610", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001691_999514754075943_7667676765072486147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asjZmGsXhN8Q7kNvwEKHdg4&_nc_oc=Adp8mq65P9S-K9u0H7rkjy39LCCk4rAA71S7Jn3GOtY0VdWPTxcu768AxUBzyF1Zlbo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CKQtXG4Q0aAQBmRAICyNS-WlzOaa1Z9BDFVWJ8t0i_g&oe=6A466B21"}, {"file_name": "coverart.png", "id": "513796560514988", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982613_513796563848321_127944825777716694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6lhArxuvLUQ7kNvwHQHTIx&_nc_oc=Adq3fxhiD4D0jBK-gXuuWHdoD421AOBQN5G5Fu4Jd6jPhXwg0BrVDhyKkZR5mX2GlgA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zz2B1aOv2ksuRKA3i-_bzsdfXev0Bzj1gk2y-OKzCCw&oe=6A466737"}, {"file_name": "Screen4 copy.png", "id": "441198057904099", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001687_441198061237432_5298168853997585801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeXMPkSuccAQ7kNvwH72a3I&_nc_oc=Adp7AhEBUlWnTo4NXO9B_bPqBFrbNSQQZrGLWnAfew_QURJG6OVNmyasMyLpV5WNkzo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oXCOYJXFGwS8ubt82LlrJZTqx1fMj7-UdxYFbOjx1QQ&oe=6A46744A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "538503934725167", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031505_538503941391833_4338637803249112835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UKk27pdKbkQ7kNvwFgRQig&_nc_oc=AdogszWkOsS7_qCPXXFdSYKe1n1woB40jHyb_nBHgTDbJAq05nDUqlhYa9n8ONoIBD8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uHoobTbW7b-fddSagWmTVOu5cEM6-fkjqeK6pLom87A&oe=6A4688DD"}, "display_name": "Fruit Attack", "keywords": [], "long_description": "Slicing fruits in VR environment can never be easier.  This app is different from any other fruits cutting app.   The fruits are not thrown from bottom to top.  Instead the fruit will fly to you at certain speed.  There will be bomb hidden behind.  So you will have to be careful.  Once you cut the fruits, you will get certain scores. If your score is over 500, you will proceed the next level.  Otherwise, you will have to play again on this level.   Each level it creates fruits and bomb.   In the higher level,  the fruit comes to you much faster with more bombs.  It is very simple ideas.  But many people find fun.  Instead of exercise the finger in screen, you will exercise two hands in this game. ", "short_description": "There are many fruits comes to attack you and you have to use two knifes to slice the fruits.  But you can not slice the bomb.   You died if you slice the bomb.  There will be around 10 levels you can take.  Each level is 1 minutes.  The goal of this app is to have fun and have you exercised and enjoy the living by slicing many fruits. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.alteru.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Alteru Inc", "support_website_url": null, "website_url": "http://www.alteru.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
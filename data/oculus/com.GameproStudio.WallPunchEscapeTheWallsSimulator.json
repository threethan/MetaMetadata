3XT2Kuu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVGQueVLYoeaL0LQRV4aCZ64PcqTbBaK2lqyyeTgUYGZQ&oe=6B1045D8"}, {"file_name": "6SCREEN.png", "id": "2176189356295942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593734382_2176189359629275_611890869540807418_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7Vf2juYtVkQ7kNvwF5Nqz5&_nc_oc=AdpW69pmgODa0FlLeJzNyJ2Am8Yf1ps59ApCp1uk4W-dX6E2U4A4yBcAzvwn2lHoK1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhRIT5SGRtCne2DPvfnshqlPxjiIgAOTd6i5O1wRRQWQ&oe=6B105E45"}, {"file_name": "2SCREEN.png", "id": "1669721431215730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620414_1669721434549063_3156508618046153957_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgBeX8SGZ3YQ7kNvwFjSPmB&_nc_oc=AdqkQuj1xH2-Yeb9mnzPXHBJX4j08u9D-WGcJFSem8Pbp_IIVafQ0ZBT2wqDviUoSoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3a-Ly2KGf0Fym_6ZcSi4i1kSdFSkDbMnBnzfKt3-d1Q&oe=6B105ED6"}, {"file_name": "5SCREEN.png", "id": "1988140435197012", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622192_1988140438530345_7043673009539552484_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_obPgMxxaUQ7kNvwFl4BSR&_nc_oc=AdqIlQPmLxTA0eR-8fnA76jWlfE--KCa62ta1FPqPuZLUr2-Q4Y09V__y4cWagQjDOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUqKP4y3olSAEC_PCrknTLKNy_tvqOAqhtGdd97fhITcA&oe=6B105EC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wall Punch - Escape The Walls Simulator", "keywords": ["punch", "walls", "escape", "simulation", "boxing"], "long_description": "WALL PUNCH: ESCAPE THE WALLS SIMULATOR\n\n\ud83d\udc4a PUNCH. SMASH. BREAK. ESCAPE.\n\nEver wanted to punch a wall like doing boxing? Welcome to Wall Punch: Escape The Walls Simulator, a satisfying wall-breaking and prison escape simulator where your fists are your only way to freedom!\n\nYou're trapped inside a prison surrounded by thousands of bricks, and there's only one way out: PUNCH YOUR WAY THROUGH!\n\nStart with nothing but your bare fists and punch through thousands of bricks standing between you and freedom. Every wall punch brings you one step closer to escaping. Smash bricks, destroy walls, and see just how far you can go!\n\n\ud83e\uddf1 BREAK THE WALLS AND ESCAPE!\n\nYour mission is simple: break the walls, keep moving forward, and escape prison!\n\nBut escaping isn't going to be easy. With thousands of bricks standing between you and freedom, you'll need patience, determination, and some serious punching power.\n\nExperience the satisfaction of breaking walls one punch at a time in this addictive prison escape simulator!\n\n\ud83c\udfae GAME FEATURES\n\n\ud83d\udc4a PUNCH YOUR WAY THROUGH \u2013 Use your fists to punch a wall, smash bricks, and destroy everything standing between you and freedom.\n\n\ud83e\uddf1 THOUSANDS OF BRICKS TO BREAK \u2013 Take on an enormous wall break challenge where every destroyed brick brings you closer to escaping prison.\n\n\ud83d\udca5 SATISFYING WALL SMASH GAMEPLAY \u2013 Enjoy the simple satisfaction of punching, smashing, and breaking walls as you progress.\n\n\ud83d\udeaa PRISON ESCAPE CHALLENGE \u2013 Trapped behind thousands of bricks!", "short_description": "Punch your way to freedom in Wall Punch: Escape The Walls Simulator! Smash through thousands of walls, learn the punch tactics to escape out of prison, and keep punching until you escape. How many walls can you break? Can you break through 50,000 bricks?"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://MBGameStudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743
40446_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykJjhPVEaQAQ7kNvwG78pM1&_nc_oc=Adqc_b-gmADm5C2VwrWhe3c9SDY9ggcrjBuXbL2h3dumFhkfWAbUFbchnqynZ7sLPMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLa-L7_Tn7mgO5kLzpRdByjxlwNFyFBekjKfEsJsGMNA&oe=6B106BC4"}, {"file_name": "Pic5.png", "id": "1915630279237600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842260_1915630282570933_5775581664880036874_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1McGLzxI88Q7kNvwGNlgcK&_nc_oc=AdpzeTeKKqcfDj8VkLX1FRwDyvzU9xd5ZMwg26Zru7NwEbE-9xhrTZLsSjj6RPrgd2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWaynoXX-J1FE6qY6zHONDq7DaMTY33t5Jps3O_MsI4zw&oe=6B104399"}, {"file_name": "Pic3.png", "id": "1121835627155122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842206_1121835630488455_835862390183663374_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFRsFFfUPqgQ7kNvwH_PsPI&_nc_oc=Adr5zGrqvJyh2Z7WgO-N92uU9DS9Oh0GAsQyw4bIOgL2u52eZi_7QammOlMDwlB7mvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWMPmsbFOwbZsNfwofPnj0rqIDPknA9jLy5_rtELFk3Vw&oe=6B10658D"}, {"file_name": "Pic4.png", "id": "1948137863224412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908850575_1948137866557745_8426901961053144106_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZmrLRzzHwoQ7kNvwGd8yNe&_nc_oc=AdoPoYzMmNyLo-ngDm0pkURX02OfuUGP3PKgPxs18ybOwNUDaPh24c239wi38DicfvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU7136YS3LCiSwhKzfXgzIJ4FN0PbxHK5GDMewSD0xIlw&oe=6B105427"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wall Punch - Escape The Walls Simulator", "keywords": ["punch", "walls", "escape", "simulation", "boxing"], "long_description": "WALL PUNCH: ESCAPE THE WALLS SIMULATOR\n\n\ud83d\udc4a PUNCH. SMASH. BREAK. ESCAPE.\n\nEver wanted to punch a wall like doing boxing? Welcome to Wall Punch: Escape The Walls Simulator, a satisfying wall-breaking and prison escape simulator where your fists are your only way to freedom!\n\nYou're trapped inside a prison surrounded by thousands of bricks, and there's only one way out: PUNCH YOUR WAY THROUGH!\n\nStart with nothing but your bare fists and punch through thousands of bricks standing between you and freedom. Every wall punch brings you one step closer to escaping. Smash bricks, destroy walls, and see just how far you can go!\n\n\ud83e\uddf1 BREAK THE WALLS AND ESCAPE!\n\nYour mission is simple: break the walls, keep moving forward, and escape prison!\n\nBut escaping isn't going to be easy. With thousands of bricks standing between you and freedom, you'll need patience, determination, and some serious punching power.\n\nExperience the satisfaction of breaking walls one punch at a time in this addictive prison escape simulator!\n\n\ud83c\udfae GAME FEATURES\n\n\ud83d\udc4a PUNCH YOUR WAY THROUGH \u2013 Use your fists to punch a wall, smash bricks, and destroy everything standing between you and freedom.\n\n\ud83e\uddf1 THOUSANDS OF BRICKS TO BREAK \u2013 Take on an enormous wall break challenge where every destroyed brick brings you closer to escaping prison.\n\n\ud83d\udca5 SATISFYING WALL SMASH GAMEPLAY \u2013 Enjoy the simple satisfaction of punching, smashing, and breaking walls as you progress.\n\n\ud83d\udeaa PRISON ESCAPE CHALLENGE \u2013 Trapped behind thousands of bricks!", "short_description": "Punch your way to freedom in Wall Punch: Escape The Walls Simulator! Smash through thousands of walls, learn the punch tactics to escape out of prison, and keep punching until you escape. How many walls can you break? Can you break through 50,000 bricks?"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": 
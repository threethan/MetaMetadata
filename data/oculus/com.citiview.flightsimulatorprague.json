=Ado6iLGbMVf3-25Bu-Ud0b0efgHalcg56eT-ngx-f79yA2cmLo1Ma6yB9Lt3pnH8-Tk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGKZgZ3FMJQxxWHzueDkxgZsvDPYoAxO4K74HN0lg1VA&oe=6AF35823"}, {"file_name": "screenshot_5.png", "id": "2198877077323473", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673645340_2198877080656806_5479581313130383867_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJTwYj_3oygQ7kNvwHtEkXU&_nc_oc=AdqTvfBUBHZ8EFjP-uSpFxgyco7cWotCI0Wgx3vovz6S0DfAW3r-Py8-Kjd46iSe1ZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHSt6sw2a4D_5UMPmbyQ1wseKVKohX_yOkFIVhoaavPQ&oe=6AF346E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1123837380640451", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_1123837387307117_6100380372828960781_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX4HiK0oKo0Q7kNvwHSWIH1&_nc_oc=Adr_3fSATbEj-kWuHJ4beL3BNNVU-U-DqcMPLbGYpDqF2hYlabseaRKBH3KOWFrwe84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSZUQLPLNjh1t_DLDRdlqTCd4qH7g7Skz-MWcbkYwxcw&oe=6AF34BAD"}, "display_name": "Flight Simulator Prague", "keywords": ["flight", "simulator", "prague", "jet", "pilot"], "long_description": "Flight Simulator Prague puts you in the captain's seat over the real Prague - with English and Czech menus.\n\nTHE REAL PRAGUE\nReal satellite, elevation and map data: Prague Castle and St Vitus, Charles Bridge, the Old Town Square and the Astronomical Clock, Wenceslas Square, the Zizkov TV Tower, Petrin, Vysehrad, the Nusle Bridge, the Dancing House, Karlstejn and the Vltava bridges. Three airports: Vaclav Havel, Kbely and Vodochody.\n\nA LIVING CITY\nThe red trams of lines 22 and 17, the Pendolino and the double-deck trains on their real tracks, Skodas and the red DPP buses on the roads, cruise boats and paddle steamers on the Vltava, airliners in the holding stacks. At night the Castle and the bridges are floodlit gold.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Vltava at Smichov, Vysehrad and the Castle out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the city approach to runway 24, Kbely, a Vltava run, UNDER the Nusle Bridge, Karlstejn, a fighter scramble, the Golden City after dark and a Prague tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Prague, built from real satellite and map data: Prague Castle and St Vitus, Charles Bridge, the Old Town Square, the Zizkov tower, Petrin, Vysehrad, Karlstejn and three airports. Start in your own glass hangar on the Vltava, talk to live air traffic control, fly UNDER the Nusle Bridge, take out private jets or a fighter. English and Czech menus. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorprague/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citi Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorprague/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pla
95119480_1098736846482442_6850043566522687944_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLbkWnEfM_8Q7kNvwF52ada&_nc_oc=AdrQ_oY7sjNp48uI0aM0MbJP2aD0whV0tngyb6UYsFEaxvAxDQB_qmpdMd7e9buCp-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMgcrjghIkiUnxed7eFvZfiz20AblTWEPetC4P-HZerA&oe=6AF47163"}, {"file_name": "screenshot_5.png", "id": "2198877077323473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673645340_2198877080656806_5479581313130383867_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJTwYj_3oygQ7kNvwH5GwD7&_nc_oc=AdpMZuqOaYp_J4i5WkfW4mkBW3XO7noij9v2FKqjhoiezHcYP3HVESOKD1Lw_Hd2Y-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcS_434ivK6V_p8F3vFHSUY3FLXrW9L0MPGCaDyi7Jfg&oe=6AF49865"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1123837380640451", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831279_1123837387307117_6100380372828960781_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX4HiK0oKo0Q7kNvwHSgTJp&_nc_oc=Adqgj4xwzHqArtswZIcJqXONIGG3XSDMAHhIOkmf_MpIdQZtgt-c6oGt9MTiOMsjZxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC4Z_IyN2lV5xyLzDjyPDlvRwSeDRIk4KI_L1OuLn4TQ&oe=6AF49D2D"}, "display_name": "Flight Simulator Prague", "keywords": ["flight", "simulator", "prague", "jet", "pilot"], "long_description": "Flight Simulator Prague puts you in the captain's seat over the real Prague - with English and Czech menus.\n\nTHE REAL PRAGUE\nReal satellite, elevation and map data: Prague Castle and St Vitus, Charles Bridge, the Old Town Square and the Astronomical Clock, Wenceslas Square, the Zizkov TV Tower, Petrin, Vysehrad, the Nusle Bridge, the Dancing House, Karlstejn and the Vltava bridges. Three airports: Vaclav Havel, Kbely and Vodochody.\n\nA LIVING CITY\nThe red trams of lines 22 and 17, the Pendolino and the double-deck trains on their real tracks, Skodas and the red DPP buses on the roads, cruise boats and paddle steamers on the Vltava, airliners in the holding stacks. At night the Castle and the bridges are floodlit gold.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Vltava at Smichov, Vysehrad and the Castle out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the city approach to runway 24, Kbely, a Vltava run, UNDER the Nusle Bridge, Karlstejn, a fighter scramble, the Golden City after dark and a Prague tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Prague, built from real satellite and map data: Prague Castle and St Vitus, Charles Bridge, the Old Town Square, the Zizkov tower, Petrin, Vysehrad, Karlstejn and three airports. Start in your own glass hangar on the Vltava, talk to live air traffic control, fly UNDER the Nusle Bridge, take out private jets or a fighter. English and Czech menus. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorprague/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citi Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorprague/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
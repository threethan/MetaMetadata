/741360331_1465734242409028_2272815283126233878_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-7ojSf4AdIQ7kNvwFZGfi5&_nc_oc=AdrUVAwCv9yc7uPF0Ss469x-uhnURLkjXfVw1vs--ibNFUuyN27Lm-XzPIikZ8tOj_w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-7F-vKKqTREWVSp2GkQ7nC1tyNZuSSxs96uUS5F5_GA&oe=6B085CAB"}, {"file_name": "screenshot_3.png", "id": "2215512215697813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830822_2215512219031146_8449295322687270597_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLYVnP_I29cQ7kNvwHNAhN7&_nc_oc=AdqTVU1DbacGGeXYkRyg0FlyqrO2uwE0VmrtZCij1MBTRncIcqTGzAmw8Q6cu41VpTA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsf0sIfuge4aGKYMMYGta3M5HpTDwiMzg1ncDg8v4zZQ&oe=6B083C1B"}, {"file_name": "screenshot_4.png", "id": "1098736843149109", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595119480_1098736846482442_6850043566522687944_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAADro9HqcgQ7kNvwEwGymd&_nc_oc=Ado9pa772jXERD9d_w9jIp56PyC4Gpa7bSx7rrHniUyLvQuAck-zgqRCI03mxu3heg4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMG6GXEKA2bU5TqNMmOwSBtflyhK6P7J1xqXSQ0SzfKw&oe=6B087023"}, {"file_name": "screenshot_5.png", "id": "2198877077323473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673645340_2198877080656806_5479581313130383867_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKyccy6wVEEQ7kNvwFH6iG0&_nc_oc=Adp205RWf4ph5vn5e8c0d-2GnQoAYSGAaUDgVDsrR_HDfKBvgEcBkGICj9nad539h48&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUhrRdKc-h7o7DT9Xp0XjiSQJR1v-6cdfEFgT9BI2RFw&oe=6B085EE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1123837380640451", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831279_1123837387307117_6100380372828960781_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY-gY58sB1gQ7kNvwHDJc4D&_nc_oc=Adp20nUHFumJWKrLCcG_Zff3nbJ09AwpJFv5VjcUZ-mlzuQOpAHggzKyVT8X71JSnEI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjlaBIbVqQur4W_YzCO4LCD0L5AIlrLeQKAclrP0O1fQ&oe=6B0863AD"}, "display_name": "Flight Simulator Prague", "keywords": ["flight", "simulator", "prague", "jet", "pilot"], "long_description": "Flight Simulator Prague puts you in the captain's seat over the real Prague - with English and Czech menus.\n\nTHE REAL PRAGUE\nReal satellite, elevation and map data: Prague Castle and St Vitus, Charles Bridge, the Old Town Square and the Astronomical Clock, Wenceslas Square, the Zizkov TV Tower, Petrin, Vysehrad, the Nusle Bridge, the Dancing House, Karlstejn and the Vltava bridges. Three airports: Vaclav Havel, Kbely and Vodochody.\n\nA LIVING CITY\nThe red trams of lines 22 and 17, the Pendolino and the double-deck trains on their real tracks, Skodas and the red DPP buses on the roads, cruise boats and paddle steamers on the Vltava, airliners in the holding stacks. At night the Castle and the bridges are floodlit gold.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance, with chatter between airliners.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Vltava at Smichov, Vysehrad and the Castle out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: the city approach to runway 24, Kbely, a Vltava run, UNDER the Nusle Bridge, Karlstejn, a fighter scramble, the Golden City after dark and a Prague tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Prague, built from real satellite and map data: Prague Castle and St Vitus, Charles Bridge, the Old Town Square, the Zizkov tower, Petrin, Vysehrad, Karlstejn and three airports. Start in your own glass hangar on the Vltava, talk to live air traffic control, fly UNDER the Nusle Bridge, take out private jets or a fighter. English and Czech menus. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorprague/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citi Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorprague/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374288975767638"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1374381549091714", "version": "1.0.0"}, "id": "1086291200816712", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1374288962434306", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1374381549091714"}, "release_status": "RELEASED"}, "binary_release_channels":
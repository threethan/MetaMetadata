BpfSchjZR4Q7kNvwEbioB0&_nc_oc=AdpoJ0hPTgufukXTwWcJ6oub4U5Ej2hDoQZAtA3x0Yr0kajkyKpJhPa5ydN9w-vGH3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYdPXOLa5KDt1oC3aD29nWtkLFfpL9C2Xsf1RnVtQKew&oe=6B0F0C10"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFXZNxGLmggQ7kNvwHLPwVr&_nc_oc=AdrEcCU0AaScqFs_I3CHCnsph2nRHKUQsd59p0MGbX-ic1LeCl8_f8Gdbq1jq1E41ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXF-BOojuXckhh1FKnhEBza_h-f4yB-evW41KM08rmcwA&oe=6B0F1051"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl4iLTOswtsQ7kNvwHx76Ek&_nc_oc=Adrn-N7VM1ahZJIXtnwMhuzmHKFYsAukZrbV3WzR6kZXZMfBWupwwLP2vq1_i6xctgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwCs5K47wfBf0um2sve8JYfxwVzc38JalQoHS8Ivemsg&oe=6B0F0586"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTMVCI6qp_UQ7kNvwFz1SSy&_nc_oc=Adpcw2GeOYMpmUK3f7biAhrxGJ2pSvA1xWOVpU4-3QAzuBbHKutGj7HTS6KmLB1Z64E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWYTkSkW--RDphb033-LHrzuZbZEh7TxU6woUPaqzTrcw&oe=6B0EFC95"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cbQQXZPl8AQ7kNvwGJ-dKn&_nc_oc=AdrLH-OOXHIWtjQXpM_eNdIeIfayvt32kDsOxpErAK4FlYvriqae9ySlVg388xudQHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXGCiM5vj7HdTlKPhX7eRh8O5O3RPTBRbGB-MM3SRo4-Q&oe=6B0F1296"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training App", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "268601082463684"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8233207353464245", "version": "1.0.0"}, "id": "1025768451751586", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6407970459321286", "is_concept": fa
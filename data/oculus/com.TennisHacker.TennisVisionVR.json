ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGaZo-o58doQ7kNvwFdydoz&_nc_oc=Adp6TdRAqJNfZ5VsD_I3ftAVomrSCZbsN3gXlDO94o3B4CLlWF3xjloDFvvP0mHVNWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afye_xYaIcGcdKu0idZKSwkNvkKMOsnxyP2hoiLRiSnFtA&oe=69D112BB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NEryIc0o8sQ7kNvwFZOmZ1&_nc_oc=AdpxrKlsqZYCvQxHMuIHZod5P8_ED3BvoR1OLskntd94QCGxERmtP2TuKYmjX5ddS0g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzpv7uBwHEi5UoTCMZGOGJf2B7Rvu8d44sd2fcoRQHOxg&oe=69D0F30A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDmNRzPn9O0Q7kNvwFiqFR7&_nc_oc=Adr4KRwiCvBcEAm5CPXy10vA0HYo4Baz6uBzn7IXoCInOUAj9Ec1jjfbBKrPj7dx1fQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxEkS0lNb_LglErbW6YtSb1uO1wNgQQnUgHA4XIce9tA&oe=69D11A50"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCGTpYgip_AQ7kNvwGTzjgN&_nc_oc=AdrnnPiFwz18KomDj3GicJl2dFzyLiFCQMSBywXdL1QRAKrVhZrBpBjsVppW9J_J6gA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiA1DSGwJeYpsNCbp35pHRjRQdyGWyQhweYCDddsfCGA&oe=69D11E91"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_PVVOQAtf8Q7kNvwGTq1_7&_nc_oc=AdodIlN58cB47B1tWRKQpDqo2c7cGXF7sZdcZ48oSQMJCj6wUJbMdQITank40LNLd4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9-FLFCBiRwJmMHCQQgbN6GlUxSr3_Z6hGRQ37Auds7Q&oe=69D113C6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HS-vWm3czYQ7kNvwHPa1GD&_nc_oc=AdrnGg91B60PE9htAjpVPhNfwlR8JrpdanZiYGWyU5sCRMw4obQVQ5WkLV5w3rECEMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZa2FuPEwkmRxwNjhrfkKGxsSOeYy3A1sBxyjxue32VQ&oe=69D10AD5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygqbF1E34eMQ7kNvwGre3cJ&_nc_oc=AdrP1sOkSqIoohMR5IcHQR5fWMsFDiXfNmZtyJmn5dMJQRovns3ICPhWiYahIIqQFVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDGCVZJWLJ6-TwsPXkNSNuQy4qBL0FDAZJ9s3lzcfdow&oe=69D120D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
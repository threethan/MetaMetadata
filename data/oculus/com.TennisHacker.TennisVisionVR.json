c_ss=7f30f&oh=00_AQRF2R8hXSgI44MfW7P944mWFCveXWaU2CKbfxN9f4y_PQ&oe=6B0B1BD1"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48tqoOsD5L0Q7kNvwE2lxdp&_nc_oc=Ado2i1S38cgapX7CGuxDlm6wuuXsNekvJGBqa1Ig9iDe0Sx2kkJG1uR-iRBX3O3FtGQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTH_tRo1rSWQrRP0Rlgjxx83xOMbTm1ffftqE01hAOrSQ&oe=6B0B1106"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RjRrE-XblMQ7kNvwGlt-6Q&_nc_oc=Adr8ncl-aMgwm72msMERAP0j8mtGy01dlgTrxNaWdNZAnzv4iYfjCg_CrQ-D-dcNIdM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRa8wysgG-wvwRZDPHbTN-yPodRh6VG1aN4D_EZQnNSvQ&oe=6B0B4055"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bONHVTnEKqYQ7kNvwFkmCss&_nc_oc=AdrFK6zaw_-LFDJk4JwDCnJr9XrBOzGVmfs--yjeoiSP4E_RnaeQvKS19056JVnuBcE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuA97qWSqCftL2lKfKtvtiedqPV8BYew8oOxaigbyR8w&oe=6B0B1E16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8276279402490373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982592_812445343850530_4146022295315313774_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pD6qLQTt25QQ7kNvwGtnCEe&_nc_oc=AdpDVBb-SUpV5il1ObyFe48DnwNZr-paHrMrXjt7r3hVEgfXEKIhOCvdNBhgB9nVkhQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMHyo_iX3Y0h1M_Oh9K6oefMp6BEwjBG5jk-OhZYnzqg&oe=6B0B2DEA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tennis Vision VR - Vision Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1726864920, "lastRevision": {"nodes": [{"id": "6407970465987952", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6407970459321286", "is_first_party": false, "enables_in_app_ads": false, "is_concept": 
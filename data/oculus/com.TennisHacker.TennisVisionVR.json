ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WWOyBQCOUIQ7kNvwHHQvzj&_nc_oc=Adpr3SD5miH80alTjJCp3xWGY2SHXw6gmEA2iAu3x5WpKauk9KJG_WGj8utn2Ltrln0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0ko7qGJTT9uVlMYwDCa6ngIDOVPOSxvBp5pGoWsgyRQ&oe=6A675DBB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_T7GuXf0B4Q7kNvwE66zvP&_nc_oc=Adom1furUOzbU85zCHc4ih_LK6ghPxGN_9So1NQltpce5CBkb-O4kL65THXyFlsQz04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0UuS5X-QR1mvYcDrz7y-MyEhK4slneTkav0qr50QUEw&oe=6A67764A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj9vkMHokGYQ7kNvwFWzR1S&_nc_oc=Adra0C9yCLOyqO4jGALP-UmnAGvXL8DpBhPxXJq_qhSTI65kIP227O1UJebN8GT8G6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaZ5qPDiMS7noYSrfw81UsPlgorPmjfz7JxwkHzLl4nA&oe=6A676550"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlXv6dZ0G4oQ7kNvwFzZsLD&_nc_oc=AdonHpkDUvGC5dTBEIaaRKaebw8CsDvoIDC24wxz6XodI0O5HRbGVJD7K8y0ATIMOZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE-3UTUCi_UerV14Eh9OvN8p1xZ_nwf1evjxUG6OGyPQ&oe=6A676991"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojlfDCE4VHMQ7kNvwEcQGCB&_nc_oc=AdoOmKzC-Y4lCgmU_V0Qns0JR_He6M9bWLfkNwSJOt1tiD1LkTUyeSFdIIjFd5LfKjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH2elZMol4FLcurlD2qn7bBVu1elN5_KYnlhN-g29vSQ&oe=6A675EC6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNlyRnWsPfUQ7kNvwECK5Lp&_nc_oc=Adrz7-4WT_e7wp_YO-6uMWpH8vYBkjv4h-AXQSASxm1HjnBMhBtF4Oz2UjBLvCacFOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMSs1x-Yff3T0z62Nr4-L9e2VQlxuimwTra593mUj6HA&oe=6A6755D5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sCqLKIGcGUQ7kNvwG9iA_t&_nc_oc=AdrOFEiIoEmsnADBErcrTeq9fIAKr1HTxYaqg-kyV2wwpNhDZ36_SfvD7zGnRaubfms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAatxVONOE1hFH5Od8ZjiMMJtFXJgyEzK0VyrsQCUt5w&oe=6A676BD6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
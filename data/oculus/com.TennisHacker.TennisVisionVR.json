ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yz_NaxMKvtMQ7kNvwFDJRie&_nc_oc=Adr4epLN2aC6L-oDEr7V9ujZok62l-Lll_9bv2wt3yfx-AgSfoeQ6ZUbPq2wNwDbhnI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnmxrAZ9CbXYdbkpu2fCr_HbrNo5zhBqTXHXrwpWTOMQ&oe=6A58DD3B"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2IYOAQ4E9oQ7kNvwH0P4y_&_nc_oc=AdrutnZyM_8BMWsE-CMoBdlxBYhJGyExPWDhohAyir6HPCG2l9K8L30HiEXRTw7xGN8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0l-jK8yLgu8P1OmgRUiVg8BHZ-LwUZftlaoqg4_R2sA&oe=6A58F5CA"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wt1bx3SSmUQ7kNvwHiESeJ&_nc_oc=Adovxq5tzWENTYl9zFctzbuuQe8WGh_2zLIXKKqpftW4klCN3Yd4dQOVU8q-1TQJJiE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAixEKb3Fb3oDJ7oBBXGV30iHi3VZL2apr-UcXU7eQGmQ&oe=6A58E4D0"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvqTYIHdsM0Q7kNvwGNRxrr&_nc_oc=AdrK5uMkGjfthFyifCEESqg0kveYjikuN06Z4ygR1_-aKRy57CYT1gjShEp5KpRvdBs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU95SpW_VT_8sxuFEM3xon_wM477Rd3g-8ol6UpGqhYw&oe=6A58E911"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXT9s_HZ2REQ7kNvwGG_chG&_nc_oc=AdqmS5Psa2PENmgoaA4fXGTw7k6LIk6sprRJSAzUMioRqkd62djInIDIwWD8PfImWx0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClpDellqhLwo23Rs4pgijpsqumxT7Xxyon79gkW4rLlg&oe=6A58DE46"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVtkNxUMrw4Q7kNvwEcduph&_nc_oc=Adp_9RRRXAwjVL23Yxvqf-xCm3ZWVuxWkSgmFK8UVCOZFa71MhUfdk-ULRiLS3dxq-Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpzRPDgOfhfXzTuMx5Tn-MNTnSIBqhiNnMoTcV4OGJVQ&oe=6A58D555"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMamOIO508wQ7kNvwFm0UUn&_nc_oc=Adq-yckmbViSxnEZovo-DYwFFmf_65qykKxXxfFgDNx8yDsPmrSUNIsiQtAZtkYsgRY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIUC3esQoECaIxuj-NaWOgIAWv4kc59taaLQOF_QXsXQ&oe=6A58EB56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
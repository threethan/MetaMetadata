ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek48FrmR9WUQ7kNvwELrfH-&_nc_oc=AdqIf9l2bw6iwPfOev1uMd0iwMbHa0-SOPe4RxxaK6Uba0cTEYYCa_U4eKwuuoh0hmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy3xHPKDuynpGGBSm4r12lcmNagOH6npm9IMC-cAIqAA&oe=6A75DE3B"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1NNEHjC0V0Q7kNvwGK2zab&_nc_oc=AdoyE11jcCihdQOvQ3CIyiVuoC0eBX5LKBYS7T-SR8M7psCZohBjw1vG55pbB4z4mWg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA4zDyRt2NmksccVK2j6PsRHkDKFrLUUmramE5t_PFHw&oe=6A75F6CA"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGzSE4lziDIQ7kNvwHEViaM&_nc_oc=Adoscs04ReGwn2qIRE1ZfVxkBQA3w7c51qo87FwI8p1wRAQm5rWADy_Xk433yUKy8NA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-QAJZAHi-cjcmAxzjAZp7s0vWfolgRVTlxZcxzeQ6WQ&oe=6A75E5D0"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxjeYr8xWlAQ7kNvwHR4Nf7&_nc_oc=AdrXwNvLgcCnChWVMd6cJJpSGJ96QdTG4H1JEb0ZaH2oCul_hWfbCjsAmOSnT6bLtLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI-DtCRYi1BQNYF9hzuvIEDr0cKrLRa5wrP5UlIicdUQ&oe=6A75EA11"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lqsWaRRk2YQ7kNvwGN4u77&_nc_oc=AdrHeAx81gpVUCnVukrTeGVjQCrkgZPHkQdVUKGeRtzbSytdv1AVMWbm_jX10i2t3Mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN290Insq2kSZgEG_e__-5pafFOZIXVbCedpiaW0KL5g&oe=6A75DF46"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5kTWua6PsAQ7kNvwEfs9IG&_nc_oc=AdqYUJEUvoPlPXMZ9ntNHEg2Mjy0WfXI6dMnFnDRu_ARjxNWI7SpbhDNytWp2g-duWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr7rAIGYzzR1sRhU0l-fRtUiC6VaR-KW32R7isbx4ynA&oe=6A75D655"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAK4zXS8VM8Q7kNvwGayK5o&_nc_oc=AdoI94dnxruGwQtm9Uj0U8pMABodNdsEYgLHV9gcIXRsH8PeLunyJ11_IZwPC3uev38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYcg0GOrUHBfrSsFR7XXsGSUH8PE3-PhB7cMGYxMGzyg&oe=6A75EC56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
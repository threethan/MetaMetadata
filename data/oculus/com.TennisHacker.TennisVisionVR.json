ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leUUyLLJpGYQ7kNvwEfuVZf&_nc_oc=AdoMHgN3v8dsla-VoickH0bGaKOUCN1uIr5JbqLlXscg-h1LIwMXThMyJGI3JI7XHks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67Hkx0CIUgMHY8qlHmePtrtnC4UiohpejqUtm6FfM6BA&oe=6A0871BB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkQ6C5mLC2cQ7kNvwElVsHS&_nc_oc=AdpJPVw9moG023fTjuH0uySRibawcE98fGzsqlgQNXqwMkj6fo2plmXN5JVLXT7_SRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gB4Baj3EJEtaQPw9BGuyrDJncsuncYMdFh8av6t8VVw&oe=6A088A4A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLg0RxB7x3wQ7kNvwE77Kt0&_nc_oc=AdrHTptDTaGryD_InPdLO5ysqZiMlPrYjJNKpCftIursvVG_0cNjqBXh5libaCo-jN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yyXbQcrnHBLuKZCF7uwkLGM9K99bQUzvVNKQ2-nzc0Q&oe=6A087950"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViFuF7YAxnUQ7kNvwE3dubj&_nc_oc=AdrMuj-OHDDkbY0D1hnRFIwCwS35SIzAfoY0ZBR6sydQEta8h_Ge2fH2AZmCaC68-KU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VWQStifdVsnNE-hA24VL3I_wGKEhmKa3YKXamxLcmcQ&oe=6A087D91"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vta1BpQZaHAQ7kNvwHLThMn&_nc_oc=AdoiPjwb4IAu8Lh_1bcHhyY1wPDXh9BWq_U6MfL0_AIjzn1skVmh4LWSWqlnMKnBCro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DFtBHvlq8927TrVY3o9Pwf3mJRZKgPm8N891V6fSZ9g&oe=6A0872C6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuXVm3bJXncQ7kNvwHh_cz3&_nc_oc=AdqcwbBfK-DENGmvBQ65IErrvT9nRLmA4HbXyrPSAgSNHJ11iy3P36A80U-8cCL543s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yrBx4KGcpQhllJXj35dGqMwb-4DoYj5NRPtc0AITaSw&oe=6A0869D5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IDGMd3OVnAQ7kNvwFG6NtF&_nc_oc=AdryJGk40n5aEl62kOPrZnsdttRyXvb_EUJTEC8XLXPpx7C19K-ke8-JE4H2WaUsQcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o4B_B3BVwUYlGRHy9PU4fUAd0FMLFgBRGPVlDgiWQMw&oe=6A087FD6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
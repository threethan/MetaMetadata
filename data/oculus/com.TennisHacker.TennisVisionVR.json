c_ss=7f20f&oh=00_AQTQ4kSfzsBXDgb9ATMTJysKm-lD2bCT-S8K_Brrfqay6w&oe=6B05D5D1"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqQ4yaSh0E0Q7kNvwFZA3Q3&_nc_oc=AdqDXXZ6QcNwmkSxuHu9PwYqLOdLfMjyYYbtlhdDE4WDtKRpwqCtl2Umcet3V1LlLHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLpWOXzC0GqWP2GivuO5zy1syN8Pvfb_27ABCDz4EakA&oe=6B05CB06"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiQviX5HazUQ7kNvwE46pH5&_nc_oc=AdotJr2ifNpIhEHmnenKFkuFZsKmMKJq5ljxbLCEox1DZbzhA4Osf7mXoupJQjlCAE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwUCpiYju3a8sQpINJ6ow_VrWWHeZ3rnuyVP85HNPA8g&oe=6B05C215"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMfAnd1iFWMQ7kNvwG8s-rd&_nc_oc=Adr8CEj6hAkTK4neuWoADRnSnS34Im9n20odsbH3iAAwhMqw06BafdJs9SNyZv4RIf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_t_ZpaFLtayUtDDyN6Pd3Yxw6toCoOKodQ4wjWG5Mng&oe=6B05D816"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8276279402490373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982592_812445343850530_4146022295315313774_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iQOOHj65CsQ7kNvwFoD77L&_nc_oc=Adpb0sXp66XAbsnN7uekZP076IoLzEYTzXqyg_l_94bb0hSIIU2H3dWiROafWdMan7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ9fi2Xobuu0R88jys-0qdWskjtJb5Q4OylRk_AUqUTQ&oe=6B05AFAA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tennis Vision VR - Vision Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1726864920, "lastRevision": {"nodes": [{"id": "6407970465987952", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6407970459321286", "is_first_party": false, "enables_in_app_ads": false, "is_concept": 
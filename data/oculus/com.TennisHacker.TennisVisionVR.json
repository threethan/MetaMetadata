ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoyH34bo74AQ7kNvwFLuFmJ&_nc_oc=AdpmPE7Ywum8qaIw5YCdFTZBVD948gx1Ufgy8cKBFeyUqz-U9ThhVXrAeuwEZw0qbmY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkIYhox7PIEQtkxZGebUYWFhe9HQZziJtzTntsibxDrg&oe=6A6217BB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMJayAIM4FAQ7kNvwGjRLs4&_nc_oc=Adq2wBqm9popgGCORdBNkABaF-6ScP_pMr6zeIN8bY1a8cU6yPxWm_UjvN9x2VO2Jic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBv5kcUGSUlUULcpkSuhZi9I47gAmVzuOKVC7d0eDUCQ&oe=6A62304A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNRssmlKWRUQ7kNvwGEARu1&_nc_oc=Adoxi_owrsMENM1YmFAIQoA1g_0Gf9j4thI_SZSfkfT-DdMRL3y8O3BiuTBFixBcl94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBaML79nHHBOkogKD_cdhTktyGqFD4zGf53swNTLOfQA&oe=6A621F50"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0_bti7sSR0Q7kNvwFCfKEk&_nc_oc=AdrWRlV-djcg9f_pLP1mbKCGUEQ6vEUdMyXHvuBixDa_yfa6nLTqcjFFltjgMyM_tv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF5Wzv8TNk5xSzlXdIHBrUIOZTX5y1fYhX-70kHIMQcA&oe=6A622391"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1omAkZ_1JAQ7kNvwGhi1ow&_nc_oc=AdqIHd4b7QHuJHUEFrBxS2Gnq9ou7B5-daoqgp71oLVXkJlznu6meuuNhxmOgIrgDOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXUnji20-p_l0n9YHPY_fuSh257npt76-mv71aw0BXsw&oe=6A6218C6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8ztD-W32tkQ7kNvwHqn7DH&_nc_oc=AdogeDv6mFs31viQYDxz0STDW9v8H_1PMlfoLpq-BtYgNhN1TwrLQWWyTGhlOfQMy10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVVEv5os0_lne9DjVde-077XImh0blPnCvfbl0GFxsQA&oe=6A620FD5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuD_xR4hlokQ7kNvwHqYqah&_nc_oc=Adoe7mXkRsif4otrpx8GyhbXABKWA2e8iaf1M7wg1jFxp6JvHMXroAFrUO15PNDZdaI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq1CA8qK8IrGWpJhwjeJnSnNMigsrkrLu-K-A1x2sGHw&oe=6A6225D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJwTrRc8cE8Q7kNvwECEFQO&_nc_oc=AdquRq5uOc9S2_wm1KyETmVWtBiEXqyJKNjSRs_y2HMvYgNqdzFlbzmWTjZxKl4O33s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISoChk8bO0QMtt-uLvSN2yn7IbWC1XDtGn2PWEC2MPzA&oe=6AAFE03B"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEM8ZMYpysYQ7kNvwFb6QaR&_nc_oc=AdqspZlU29gc012oc1WOJjDBrPHsY5Aq8B7BDlR8BDtVU8MHt7JYjHP4J1k1qs5XxyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL02T-5-HqXFuDrjQXnqvkowS6xffqs3g4W9yCSVNMkgw&oe=6AAFF8CA"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcGhYBVZt4oQ7kNvwFp_NlZ&_nc_oc=AdrUF5o-k4zWX4WC86p3VUEoct9uGuVjwyelvf35_yT7cSTWplh9PsZfRlDdD-anjHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrpooZGN_Glzr1OchMhEFrn1GEpNku3jNYgGx7knA7MQ&oe=6AAFE7D0"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yLmIoodVQkQ7kNvwGh5VU0&_nc_oc=AdrdRD2HMgMHHI1nSqhMjvqB_0KdJ5ie9o-3wN2AEooZNBAT2qrwD4V2dwZjLg07j3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUrrz3q4amrb76R0TJfpMkYgfqncad2YcCsUZz-MSEaA&oe=6AAFEC11"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnawXuCevQQQ7kNvwHVVBOa&_nc_oc=AdqmuEZwmxoCtKqTfynYt-4fEMh8MaqpGS8Uh1M-Y7f8s9CAYgQnnQIzjKgRqOx2rwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbPlScIWHWOhj_7gwh8oVnUbiw_sqtm_VtI_1HGsd2qw&oe=6AAFE146"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9sM7dSZw5YQ7kNvwHwYXRb&_nc_oc=AdqaklPhHdXd_LPkbkSzgb6T6CuO4GrvthWjlSjPuvgq7LOJ3d2EGbjtYd8-Hn2rNVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQpfjrGb4g6v-yI4iQfCywLl0XSWrdWQ5UcM6DXO5rcg&oe=6AAFD855"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvyQ_Flz_J0Q7kNvwG_wlux&_nc_oc=Adow_j_loe4PCwqEKCnmxipR4M3WLH-XuI_PiNXAxkbSxb2VDVYepYhzVOd1fqaUMl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeeRqgMF_kqv4uYTxy8DyQdhPJB8YdXZKjBTdC_zBmig&oe=6AAFEE56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
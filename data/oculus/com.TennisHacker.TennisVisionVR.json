ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mg_1Zx8X0oQ7kNvwF4ozuR&_nc_oc=Adqwt8SozlHQ2rqPVJ9NZPVhsWKFgCvISeqLub-aon3dKhdNQFTYsoX4_obyh--iql4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDazO4xYsgTNVKYvIIl4lVWkyowIcw87ftXnMYzHBpXQQ&oe=6A5245BB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYEtctg-rlwQ7kNvwGk3XYy&_nc_oc=Adp7f5W-3-HGaU0leCBw2yvWZPWRBgFSrVmmn-kTfjh0gXnkvxy5GFRQzxckJTlsNFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTYJHMZ_J6jmO0sXELEV0SM9vfA97uRCZFzYt2MfSckA&oe=6A525E4A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-sClnY-I2IQ7kNvwE26UqO&_nc_oc=AdqYnSRZtEgeIxZivYGCl77aeLl-zDtmEGlfsjvn_11Imi6GuNpwZ2lRZ64io9Mge7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAakm3d-gnZSZBEyEjFsKMSTP-YhkBq0rvJ8L5fnq081g&oe=6A524D50"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vzTxvGcJ-cQ7kNvwEiDBzz&_nc_oc=AdpGjJiPsa9zIJQTH3djK4YZZSUiqThSQyKDyYzcoVPwCLteMBpTbl7FFpFwQE6Nh-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQWCkt9ry-akK-Wad3WgnR2myEd0hFjZ3omQtiwIoHbg&oe=6A525191"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uad2eSSK74QQ7kNvwGOwuv4&_nc_oc=Adrkro4MyrVM1xiUV_ow2bZbY5FZ8z0_RLVByuuOrkFq8hfzF-yFXutYNTyLsFQhTCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6ZULLZ-p98o0R5RtEEQh0m_3f_sAy4P7LUfUqCg-y7Q&oe=6A5246C6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBsNOSu0CMEQ7kNvwHKvLC7&_nc_oc=Adp26b3zVnRG1TXpt2ASdpWHBJvPWkp4QEMHG_20UXMkv3ZIJBIBASVV12R5yOHbWGk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4TJ4LGwYSMiioN58JVlPiJd8vdmNg0-Eliqy4c_fz1Q&oe=6A523DD5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOS28NakmqMQ7kNvwEJhno7&_nc_oc=AdqIQAZbFhDsqegIpjik-_iFLaA6KLQAQY7K0qK5jK5H-pQq3mZH6FuwHc-yOi14uPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvQ0jEQ-ftHB9M4t0ttHSyBCKjQdJupQRZ2beZ-QRSlQ&oe=6A5253D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO7QFvDCyrSF26kem09ra8S-8JoHk6IF47Qp49e7jhWw&oe=6ADE1091"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=accrGasdaXoQ7kNvwGd9FaD&_nc_oc=AdpI-zVbfkPYqi_5T6xdyEUAtQEzo5vI1K30pPHPlgdbVE3mEL40JDMQJtPduUlGN7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAbO2nhqE8ot6RrZbT9aenBv2NkiguU0ufMg8JgnWbOA&oe=6ADE05C6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsQw270iI9kQ7kNvwHvVrD_&_nc_oc=Adqw7GhNIWtMoQUa5u03VYE8i6hmNXJfihoq2Tyqcy-k8f0WIOxTTDpPUf9z4zT4H6M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiXBDvXmjQms-xBtEqb_eHXACxJ_pJifoHr1qyT_eiKA&oe=6ADDFCD5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmMJAAQ4Ka8Q7kNvwFnwozj&_nc_oc=AdpssETW_A6Tg_Zh4y9yBLyNFglYqJ-BX1UmEMwzd6wQbYaq1Su3Yje64CYO4wjbuAo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOipfXORGkhkVABs6ziE7hk-9EOr8ZrNO37paefXGpT6Q&oe=6ADE12D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training App", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "
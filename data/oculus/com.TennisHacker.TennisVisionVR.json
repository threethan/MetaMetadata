ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUjlJ4SesPgQ7kNvwGOfOG6&_nc_oc=Ado9zL0pPDbhr54CwxMiV3G4B3GEmZGpb9yMKT1jHpFRNtd9_XuzUou_3zYC4AQsN8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcW_LZdZU_4hXHfr-YN8JEaVMr4annzzXRuFpKypSGbg&oe=6ACE32BB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvU1pw7DEZgQ7kNvwGVTGAP&_nc_oc=AdoShI-t4RDkW0-buZROkYGi-9sxWiDeXXzRQKhYCwlCNb7BF4Tlkag_9LpFSnDvKqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzewiLI-OgZZEf_KKzbtqj29SimmBu4xIqZB7K-0TpkQ&oe=6ACE4B4A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_ZKvs6unxkQ7kNvwFUcJHe&_nc_oc=AdoGa95rY_TngHCS97QK8Mqn6fjvl8LtRxId5l1CVCp7a7ZnIZlcYkJrzxufSXMQbpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4q5p1Skiomk7h_7TdTSweE_Lh1MWjpUMGW8naGvPkvA&oe=6ACE3A50"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HVRH59gptwQ7kNvwHNlgII&_nc_oc=AdokE-Y_jAZp7y3mPcKQjq7z1EuXjpcELP6HAut8HoqkWDRJl8GIds63WT6gGl6EGjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNybtbI0iTJcovc7AI12jSdlHwuaddTbtXrGvqBWqeHvw&oe=6ACE3E91"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOrrE_6j2BMQ7kNvwFLDPsZ&_nc_oc=AdrIHv6SoZh0AnvQ5b_6cbFCrJjq9kYY2YkT39Lp543PaNR0p8StxgdD7zifD3ox8s4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkz7WLahS65rjpKpfo2ocMZJ6Z9DJRXTVYcf_x8pCq-w&oe=6ACE33C6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAmgxhNieKIQ7kNvwFxIiWd&_nc_oc=AdrZHIOKvUL8K5y5bwrVCYIpj_pknTQyUBkt-UBQx2TkBbWCH5BGcFgw5ssv5HIE1rw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM-Rg3xB_S1NZixgV-HS3logFMwqgwpsqLPqDsu2AHHQ&oe=6ACE6315"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp13kUMsxqIQ7kNvwEpsy2m&_nc_oc=AdppNWHwwKuZFVsxzQwe1DK-AuKKa3vpeQbrrUcsNc7v8lQ-cA1J_Pr5kKHtcZhdA3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjPosNlu3mFrotQ83i7amJ11OXm_xmoBH3iHMhlF9CFg&oe=6ACE40D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
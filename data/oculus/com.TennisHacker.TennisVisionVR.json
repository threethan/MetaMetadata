ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIWxo-vI5e0Q7kNvwGXYV6_&_nc_oc=AdqRYTsxmWodeBybVSitTmzZYKP0rfXlFQg-jYkfLF8SzOpTGB_m2BF537jwAzusCis&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ExX_EAJ6JGBghZO8u4HG86YQicKBvNS3UK3-Ih3lUJw&oe=6A01DA3B"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGYSaZ0AU_IQ7kNvwHyUzyW&_nc_oc=AdpJ7jHTBw9Pul5Okwy03DzciHLPeOG6HR-NgJ7ifbHAjD0J25xNeRZlg2yjKo0BKic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kBnlYml7DPc1eCOOTOBoCemec0N43oGtTORrFucvD3A&oe=6A01F2CA"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIenl5sXcSkQ7kNvwERm2Me&_nc_oc=AdoyNP6vh_F9OBLUL3RhZOlqyIQOH2VrpiwRanN0vIViryAKKnWn3njVX0sHmW3EjJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZvAh0rvT3Nh8hWr3ued3xl9jUvydNyRKj-9rh0k-WNQ&oe=6A01E1D0"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImLs08yglHcQ7kNvwEu-4j0&_nc_oc=AdqPbEMA3x0AMFQL7Qb2Peote_CbzpQL04_WIaZiFgWGjxQgbtNBngPndsg2qYvYkg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74QwDZsJEXCNUmz7IyTE4_FJJiprCc7C1UWhT6eZ-MZw&oe=6A01E611"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZsCnrshEjoQ7kNvwEFBEHe&_nc_oc=AdowP6V1Oa9lMZEjwuZ0WINKVZ0AClt4bYVhqWzZHn7L-mkMfeSYwb3QwgE68Y27E2Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wksBvMYu0Zy0-vgZPfmF7UAcHH-4GlQjN4CsBTRgKQg&oe=6A01DB46"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olCfbjCV500Q7kNvwEes9rD&_nc_oc=AdpF5bNk7_buJ47n6mIxo0EfxlZDrHstDl4jfEKRCrMy382KAiu6zo--iAq1DKLQtwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SD4snLSUe7gtE-9A0QoM6guf8zSzzYaVosq2wc_Pxfg&oe=6A01D255"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OigWonmmxYcQ7kNvwFlMSn8&_nc_oc=Adr8MJxhzyBhe1NPhGuDq4_MhZrRkcapA-28Xnq_O-ijKRNc4NqU55gFNrtzovg6Dcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ImSDH-7hdWqAGwxE5aQwWHiYz13rcTtRnn7yPjJPMDA&oe=6A01E856"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuCKzuSOke4Q7kNvwF-GXbP&_nc_oc=AdqgxwdiLi9Iekb0AKOlVu1HLRDZP5TniDoVhFpjMU84TXwXuVvGF9H0LtAUBq1AnfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXEIREMyWcIJm_IsNnylsIHcj7J1PS1cWVOObvGU8Sag&oe=6AEB33BB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEVwkW6DV4IQ7kNvwGQj3NZ&_nc_oc=Ado3KapcMGwYj7E4WUFvs15ERtf_eNfrST4p8STJCQ_4hf53U3lhiwLS8p_8mydqegc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoshAxfxgBl_-minNlMY4wSND7h0NK49Bd9qAeH89ang&oe=6AEB4C4A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXEqIYCA-IoQ7kNvwFg_vFZ&_nc_oc=Ado2wIkgi9ok-SomJNAtIeP7bcUeUrok3btAsdsxSIY02q9I7rYdZsiNbxDq98FqoK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzow73UkYACudNM-i_iDYRzuJ_AGXabAfEb76iETEzCg&oe=6AEB3B50"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOkNxGAzdIcQ7kNvwHyQfry&_nc_oc=AdoOviVuLz0eMeQW-n9YKJqIecQ41078uOYuu2xhVPo_0FKFanKW4tuGAiSjg8EGDAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa298mjQlGLMqVoXzKQCcKCLNrx5ga9pqgC-1KpxE2RA&oe=6AEB3F91"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5ApwoySP3wQ7kNvwGk5oXV&_nc_oc=Adrb0aJQKh51bEZxcD4TFtyh86Tnh6G0iwErDgiCejyt14C6iO-sd8gQUXeWE9j5j0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvmwcgWzQrW8i3DCTCb02bRS2pfVL-8-kRDbDtcFakNQ&oe=6AEB34C6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsGFuhp9-58Q7kNvwG4ZEoE&_nc_oc=AdqEmvj8CeP20wQLiIGZQmOR1QyJaITd7r7srrtTCBAJF8d8B441Z7Cv0jHZxonFIUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUbNshKRdfixfucNHHxOdpZeuNiagFUknM-koIkr0ySQ&oe=6AEB2BD5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiKAjH0YZfkQ7kNvwGCDFLG&_nc_oc=AdoNv8AJ1udsLd5PNZqWf1faP6EJL_-1NO3xMT1JD6_h-_AdKkg1hps1gjNrOxCyTkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeQwv4TSIjADHb5rZZh1mGn7x4VVZcW3nNCOzFQ8Ayow&oe=6AEB41D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
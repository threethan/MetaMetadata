ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBuqQlT8NIgQ7kNvwFydAju&_nc_oc=AdpICoXllUm_8baGlZeLHt-TVYoADC5o7p__ljn7ZCk61W5bqKJY4ko_wFpu5uhNa4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01v5wwv0zYlyI7cxIPQZrFrAq6nYgUZXRYLDVSbuHHMw&oe=69E4D93B"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KG6HIs5iPsQ7kNvwHleOHy&_nc_oc=Adp5Zd3pLxiluSF6R6ps5_MGrlRPQvldqzcjtwzivct4EKYRJJ4mvbabDPh_LmV7NBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CXXClRK5hNIW3deYRm7ktZ5Je75TMtvDSix_ctNWCQg&oe=69E4B98A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKfN7nTMfoQQ7kNvwF7GArE&_nc_oc=AdpTeub0AnJSf51AStQbrzcSSeYw_10P8HKejFdFcYJu4gv1tE9O2CnJVAbh_iX-lmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HvbLjLDKt9p-Ac6cGvZ_dDd66O46TV3j7X2M5T60UDQ&oe=69E4E0D0"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtaFUAtLaQoQ7kNvwFEbYGs&_nc_oc=AdqmPoZX0hyyYqRKR_EmRG0-3dVYNdXj_mtbYIkOtN2QbsnrYEYh4s5TkAeWqk8JT_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37TwbVZ8fkajQOLQER_BF3cEddem6vRKMr5DHp-J5T7g&oe=69E4E511"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvpcX6Qf0_QQ7kNvwFpx3hx&_nc_oc=AdolAyzC7X9mGpOZFaFLVtka23nUTFtPsMVp82QouVICRykMGd-d3Wha5go3Yd-gpEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GS3rcwKyQDmn4fPvNqfyAoOZrsRRvWwg2_jLrvmLxrg&oe=69E4DA46"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vChpmrPRQGsQ7kNvwFM5OFl&_nc_oc=AdqVZ2Kg6aKIuM8txf1uvmqMkzl5Ej6MZiBhI6DVUPJ4MBukXIINLT6SSqu6S3lSVOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mzR1ImfOnhIqHCcKx-uV2a1A6bBYtfigmYMoJoU0tAw&oe=69E4D155"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w-hznVo0cIQ7kNvwF5jVCG&_nc_oc=AdqsUynFOV5ZTImV3M3sWKmfxAZrMtqI9nKJjSMo26mVz3wI5ScwEIod9e_wxv6J-dU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Smf558nq4cZpoyio6HdUUZhrX4grSMahb75dJC0i-zg&oe=69E4E756"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oEHFem1XCkQ7kNvwFrnD_a&_nc_oc=Adpq61tY0ayyYDil7l5WEfHQ3Jy4EGagrlLVzvEdZZk0gUEp45ySB3fMpX2fmRmE3go&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sa3VI6LGR-tfAynb798OXHM7grEf7u_IaqBsfW6X-BQ&oe=69F359BB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_q9XP5R6gsQ7kNvwFf1xjr&_nc_oc=AdpFTJo3TQnIOCQRdEoi7K_6NeD1m97YJVMsQbxkeN-hdcjfqXYSlCGsDYorf2Z4RQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rorYo_yfx-4J3-UtMf-ctlyYRtFrMupWjgPsdir2yjA&oe=69F3724A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyO0JC5XdQgQ7kNvwGRj43f&_nc_oc=Adodnbp37HKBE-mkWDe-YlSRY35f2wsUuJTRYV1-2ijPZ_nHIK54g-xbiMaVdr0FAvE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cKBM1O1TGk7HxI5mlMInpoH8ETTmv9kZfzleJ-gcEKA&oe=69F36150"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phY5NQxpzucQ7kNvwGfhOxE&_nc_oc=AdolDFhZ5-E2futwXwU3w1yIrrkl39-F5BVMsBEQZhWfFkKM7LlMSM6EI49EVKiOCSA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CXpDysH8_mrrDkmQqgP-lGMQqUeswma53qULCY6rAOQ&oe=69F36591"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZRQNhh7WQwQ7kNvwExfNOv&_nc_oc=Adp9Nzj5qncX93R6ddYGg1oqt0ekstmk0Ym-HRK9Na6F6ziyG-3Mh_1lvawvg9aUz4s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af394fH8jdZhw-MlRQccuXO1QhQe8pRmcuvGIhcOoQi_bQ&oe=69F35AC6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1l-PG5X8FUQ7kNvwGqY6cG&_nc_oc=AdrfKCaDl36R2EnhrJUYDllt9sHyhxvS9PWHu02J1vGbcgspyFPJllpAcuip6rypGFU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RrG-XlNIoXeYlfNYWQXEd-tgw6wupxck8ejkSBgGNtA&oe=69F351D5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttdp9NKFg1cQ7kNvwF7M3pU&_nc_oc=AdrY_loOyvy8XARB7fLM-JngiMkeAbqtxanHDe3XYhOo9aXMg1TPrktzh8nbu9K4__o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Zs2uv2RqgbAf56sM6t2bq-Ur53MH43NwnpV3DMY-YNw&oe=69F367D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C09QKBjGI_gQ7kNvwFABm3H&_nc_oc=AdrQ95ENRpbAyaEcSn9Io7aPVW7F-9L0BMFYPSCqYhHDX5i3JPgDmHUtUwut5bWDmN0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BfDuMi-RpD-sbxLiAxSXDLFS72sLC5EguWhNhsMWdZA&oe=69FDE5BB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AI5-46m7B4Q7kNvwFsgHnx&_nc_oc=AdruQ-1Atj-s6kXIpGxgzbJ2INycf51h4jmIinen3lwDKVeuBYiXN8ykN-7HEmxsIMM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jISUzVGDeGz7rs-HTs5iSA7QMAge29YodyuLyCDbdxA&oe=69FDFE4A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KDVfVsVRFoQ7kNvwGpUX31&_nc_oc=AdrYApvlwv3ELhWo51xPuYo8RV6gVcxtlNZWDmb2x0MLzbJbgcnyE9EW0VYHltHp6-c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Va0P-R6JmbpldMJI6K7vLFCL6Q07wZpG4yUhx38Kr7g&oe=69FDED50"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rc6dGQaiqDgQ7kNvwHh03d3&_nc_oc=AdodY28OEj1jkKMjedqsTA2F5clsQgd5pUuxb7inFlwzsEOdnyQ3m9RP633BnSmwo-k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XB4h1iLWOOWNDZ_8SeVvifWZo9j0f4LACOOtj6bfG0g&oe=69FDF191"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-hf2V2U-fgQ7kNvwEGtAYY&_nc_oc=AdpJtYUpsGkju4uwEuaNZDDJo2npUzmNcs_-pgz5lWbSbqRTfc63XJYbLcRENIOVlJw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70dv1nCv0YwXIZELR-83TtBLBvDv7No9qsZnPdOYwB7A&oe=69FDE6C6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVWE4xmEGgoQ7kNvwHj4T_9&_nc_oc=Ado1Bmbe-KAtQtLYPe1m8Iom0pOM__BAs2CbWKZirZd37UQOE3WAYRIU3Wg9DVlk_t4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cYrb5LfelfxOkHAkwl6nGsxBuLleJ2znhk0DtYSy5BQ&oe=69FDDDD5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNDtVgjWpwAQ7kNvwGgqph1&_nc_oc=Adpx8U2rFJQAj4pfuag0WBJz_0bMx0S1XRZalBGjirum_CJoRAg_j15Edi4bg13EPWU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wCv-MXhy2NK8CEceYW1V86Onxc9RR_fmPKJ0KA3DU8w&oe=69FDF3D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
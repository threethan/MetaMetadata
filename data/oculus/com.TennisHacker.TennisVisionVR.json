ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB_dkPRE6sIQ7kNvwHoq7DZ&_nc_oc=Adpr-3dIh3pTseuWJYBRzgIhulRrbTOUx8O8k5GZp99v2tY3PISEEyLS8k00yhB8VlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1ipX_DrYytWokB1jfP3r5QmQR2VH48o31SVUX4FT5TA&oe=6AA5543B"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8aqkya5qFwQ7kNvwF_1AdI&_nc_oc=AdrsiGySswBToxBvrN91kLHZ72iUEenr5gyyLYuHcPGzgjkZzF2wwPRpcw5rsivs2_8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGrv7APk2V7KAUUPe4SzHXf9wW8xVHOFigrbJTGpvKmA&oe=6AA56CCA"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VAezc8Cp10Q7kNvwGlF_UL&_nc_oc=AdpWsuNF_kFM_z60-MMdbE1-rJdxGYG8I2M0YoSXlHtFIJ_rKJooRspx9_QO94ztFmY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy71CEF1DpjCHhfHCF6iOrBqKEnjl3HMV4qGsaA3Kn-Q&oe=6AA55BD0"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpYoY3BNcg8Q7kNvwH3Qxls&_nc_oc=Adp9ZHGfJuvKKQ_UOFQ7CdjlOifFeV5aaTvAuknXlQae4N-B9i3l9ZpefZISEwahJ-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaiW18hUE91JtII-hc0z8XMp_8rte4aEgZqNTmj0MWlg&oe=6AA56011"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV6cgul06iwQ7kNvwEDCLPL&_nc_oc=Adpt4O_si5XVCrrL59A0uHYCSVaZrECvwhC7VtMu9UPTbLxK7qPtOJpuipAFbZsJ10o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLti3aelVdStpbQbfnk1DvRTlopwopX1VjX2NUJDSNSg&oe=6AA55546"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sI-oozz5IMQ7kNvwGRy746&_nc_oc=Adp80ZQ8WWzgYtvD2VHbCK0-CQOlVAOuKwp3ojhULrgkj3-GZxN-kKncshXgukvNNew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1okGTWUzTXZDbse9ngK33mPcr9Hmtc5kHLXBRTp4HKg&oe=6AA54C55"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_l8bbCOMbQQ7kNvwHLe-dC&_nc_oc=AdqnotiioxCnq6vTvx5WnKcQPb7txZuS4FYrZzaL5wzxL13zvgZ5byw-7qx-2paPqng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_THTJw1a_qFiTKWL_lBoSILa_cVnnudgT8POEtEy0Iw&oe=6AA56256"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
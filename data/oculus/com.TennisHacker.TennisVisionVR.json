ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569425_235159449433298_528434723294499521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJzTU-HyOTsQ7kNvwHeijao&_nc_oc=AdqIvdrSpVY6mU9jSztuE8C4j4aXQNPpjsG9MRRQ3mDqRAFHBqvi050LNDqG6YrPA-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nCVgWHyqi8feLwFLP5KLepYF0y5UUHwlgq9TxUsVb-A&oe=69D8FBBB"}, {"file_name": "cover-art-landscape.png", "id": "224935003852016", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003238_224935007185349_1570573608510902047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WBUxw5De8wQ7kNvwF6TeMU&_nc_oc=AdrRKsiGc7ev1F79rYj6A5EqzmlTuARyTxlTpvWys3VcoPY-N8BYkAn5nSgDNIUm3ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BhBApKR3XzrzWRVF5iNOEZpq68sxZko7YtpXpVvZnag&oe=69D8DC0A"}]}, "id": "843883634589468", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_059.png", "id": "1026973598717765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031479_1026973602051098_5581486762906161019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N2owAF8Ra0Q7kNvwEg-HHa&_nc_oc=AdpeAuLbSGX9IO5CDvGkTCyDZHs_dp-aUa0eDM43BR4CZjOKd83NqF5TIgkt86KHVEc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vrq8pFPDPO_lUzPvwLuDzBQw7akW8WkgBSz_33-A-zg&oe=69D90350"}, {"file_name": "2560x1440_036.png", "id": "1519635575512572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_1519635578845905_5108407734596965196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKLDZ5KPS3UQ7kNvwEB04G1&_nc_oc=Adphv6m9BKTimz3AYLrYoxEZ2WV6Dc-oHbBjFx7_QaIDmikXNty_aAfztP62QCbdR0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H-Bc6zbAGnbAL-oceW1Q3RmdnPXjbVmE9-3F4S1jjjg&oe=69D90791"}, {"file_name": "2560x1440_006.png", "id": "122000630998595", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75280980_122000634331928_7764318253159172356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBYIKI35FK4Q7kNvwHex7Vb&_nc_oc=Adoeg6O_9qgXBQSmxuH6-88Sl0HOrs-zx7HC2tuUvj-jxu7W8beJokN4jp11rHWSzVM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a8-84ZUubryH6nKFapF5bGU3cg29ulURQUyfm91Tvvw&oe=69D8FCC6"}, {"file_name": "2560x1440_016.png", "id": "1494394691363777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_1494394694697110_313425590469653954_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZIFQgrm4FsQ7kNvwFNEAvi&_nc_oc=AdoDH-tneLkU9vS1Cp1zFLSXvzeXIipcbGkH_ZaoWtiHygSkOqedHYAa__rsslY9LQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H_YlRg32b3_gd9PP3g0JAAV9I9Xr0ujmYxQhehAyLGA&oe=69D8F3D5"}, {"file_name": "2560x1440_073.png", "id": "259223610402805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982595_259223613736138_2792562483218118944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfA3vljbIQ8Q7kNvwHg6IyP&_nc_oc=AdoGoBF7SwrSC8ZYa0dETYjmk5OxYeCjmiFAuqN_pg-f8rdpmrF7tgqka2lnLndQGgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TK34ofe0WlvHA_1xWRCaKPewv-tYF0JbVsF2hxMq6Uw&oe=69D909D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Vision VR - Vision Training", "keywords": ["tennis", "vision", "training", "reactions"], "long_description": "# What Does Tennis Vision VR Do?\nTennis Vision VR trains all of the visual skills needed in tennis:\n\n- **Faster reactions**: So you can easily return bigger serves and have more time on your shots.\n\n- **Better anticipation**: So you can predict where your opponents are going to hit their shot.\n\n- **Quicker decision making**: So you can play the right shot at the right time, even when under pressure.\n\n- \u200b**Enhanced focus & concentration**: So you can make less silly errors and can play your best tennis when it matters most on the big points.\n- **Better ball tracking**: So you watch the ball more effectively through to contact to increase consistency, even when being offensive.\n\n- \u200b**Cleaner timing**: So you can feel more confident in your ball striking.\u200b\n\n# Who Is Tennis Vision VR For?\nTennis Vision VR is designed for competitive tennis players who want to gain an edge over their competition. It's perfect for competitive junior/college &, professional players.\n\n# How Does Tennis Vision VR Work?\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player. It trains the parts of your brain that create and control all the visual skills needed for tennis.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nIt takes exercises that have been tried and tested in the fields of \"functional neurology\", \"vision therapy\" & \"behavioural optometry\" and packages them into an easy to use Virtual Reality app. ", "short_description": "Tennis Vision VR trains all the visual skills needed in tennis. Gain Faster Reactions, Better Anticipation, Quicker Decision Making, Enhanced Focus & Concentration, Better Ball Tracking & Cleaner Timing.\n\nThink of it like a strength and conditioning program, but for your reactions, ball tracking, focus & decision making etc.\n\nTennis Vision VR is designed for competitive tennis players.\n\nTennis vision VR uses the concepts of applied neuroscience and neuroplasticity to make you a better player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tennisvisionvr.com/privacy", "developer_terms_of_service_url": "https://www.tennisvisionvr.com/terms-and-conditions", "publisher_name": "Tennis Hacker", "support_website_url": null, "website_url": "https://tennisvisionvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id":
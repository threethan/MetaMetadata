&_nc_ss=8&oh=00_AfyTxQzZJbPCYW2Vj-bdnwjrk6x2Roe1P4bazmJpUVeP0g&oe=69C14878"}, {"file_name": "HT_Screens_2560x1440_5.png", "id": "1051261709402320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982609_1051261712735653_3438541724928627709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElICctojKGIQ7kNvwFPtWsS&_nc_oc=Adr2DIbSdULM4beu5fmWSN_3IgO5MeWWyQgnjBAwo-6MjCkknj98k8tHWIQ69KUuIOQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFLTxuCj6_-kJZriEMMa2DBPr8hKkeyqSqON2bIH2EjA&oe=69C11BFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hunt Together KeyArt_Video Cover 2560x1440.png", "id": "859547265899781", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031500_859547269233114_6874294734507533955_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DMlq2OkZVUQ7kNvwEDpN-2&_nc_oc=AdpgzY5-pZTJ6CMYCpAYZRXPS-JwPbX2WEoYHPDypp86A2fo4jmmnzY0k-9y_dWL1J0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkrbnMWNCAXfN8IqY2KTWwY1alRoscnuLmSp__tlzWOw&oe=69C1326C"}, "display_name": "Hunt Together", "keywords": ["Horror", "PVP", "Action", "Multiplayer", "Online"], "long_description": "Challenge your friends in a PvP VR Horror game (with Meta Quest x PCVR crossplay)! \ud83d\udc7b\n\nFeel the thrill of a hunt in a 1v1 Duel or up to 1v3 Hide and Seek mode that will push your wits, perceptiveness, and courage to their very limits \ud83d\ude31 Employ a wide array of items, triggers, and skills tailored to your class to outsmart and defeat your adversary - a terrifying, lifeforce-draining Ghost or a dauntless, vigilant Hunter. All of this set in spine-chilling locations such as a haunted Mansion, Mines, or a horrid Orphanage.\n\nFeatures:\n\u2022 Challenge your friends in a spooky horror PvP system with 1v1 and up to 1v4 modes\n\u2022 Meta Quest x PCVR Crossplay\n\u2022 Two unique classes with dedicated skills and items\n\u2022 A suspenseful vibe of psychological horror\n\u2022 Haunted locations abound with possibilities and usable environment elements\n\u2022 Skins to customize your favorite character\n\u2022 Events and updates with new content to the game", "short_description": "Challenge your friends in a PvP Horror game (with Meta Quest x PCVR crossplay)! \ud83d\udc7b\n\nFeel the thrill of a hunt in a 1v1 Duel or up to 1v3 Hide and Seek mode that will push your wits, perceptiveness, and courage to their limits \ud83d\ude31 Employ an array of items, triggers, and skills tailored to your class to outsmart your adversary - a terrifying, lifeforce-draining Ghost or a dauntless, vigilant Hunter. All of this set in spine-chilling locations such as a haunted Mansion, Mines, or a horrid Orphanage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hunt-together.com/wp-content/uploads/2023/11/Hunt_Together_Privacy_Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Carbon Studio", "support_website_url": null, "website_url": "https://hunt-together.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6734168086679261"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "823615827405340"}, {"status": "PUBLISHED", "id": "1480087590791472"}, {"status": "PUBLISHED", "id": "3811227529185499"}, {"status": "PUBLISHED", "id": "884051284189430"}, {"status": "PUBLISHED", "id": "1317492056277125"}, {"status": "PUBLISHED", "id":
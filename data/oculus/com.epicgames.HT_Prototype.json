muw&_nc_oc=AdoG41NCiXA1XjnCrJZ4x_drcLzR-wnXao9k980GmxcCoFpuKc8m5ro10xjk_sOribs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTU43HRnnjOdi1hoXF5VEKIVWEVn8gGL5DtNEGJi-HHg&oe=6ACE51FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hunt Together KeyArt_Landscape 2560x1440.png", "id": "985120597440553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_985120600773886_3075837835307111643_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8LMc1BnC8sQ7kNvwENsJqf&_nc_oc=Adrm8PPu_kiaF-fvmSD6CC28LA86wWAaO6eihfOzo7S6gnvomYSux7MHQQOjUvbF5hs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuBgkktsVViwpJE1pigOyW_yuUMlZ2dZ9VIjEuSpYzEg&oe=6ACE4377"}, "display_name": "Hunt Together", "keywords": ["Horror", "PVP", "Multiplayer", "Online", "Hunt"], "long_description": "***Includes cross-buy on Rift!**\n\nChallenge your friends in a PvP VR Horror game \ud83d\udc7b\n\nFeel the thrill of a hunt in a 1v1 Duel or up to 1v3 Hide and Seek mode that will push your wits, perceptiveness, and courage to their very limits \ud83d\ude31 Employ a wide array of items, triggers, and skills tailored to your class to outsmart and defeat your adversary - a terrifying, lifeforce-draining Ghost or a dauntless, vigilant Hunter. All of this set in spine-chilling locations such as a haunted Mansion, Mines, or a horrid Orphanage.\n\nFeatures:\n\n\u2022 Meta Quest x PCVR Crossplay \n\n\u2022 Challenge your friends in a spooky horror PvP system with 1v1 and up to 1v3 modes {3856821484549122}\n\n\u2022 Two unique classes with dedicated skills and items {1277364309966972}\n\u2022 A suspenseful vibe of psychological horror {516275671402500}\n\u2022 Haunted locations abound with possibilities and usable environment elements {553393677627721}\n\u2022 Skins to customize your favorite character {2071028476663707}\n\u2022 Events and updates with new content to the game\n", "short_description": "Challenge your friends in a PvP Horror game  \ud83d\udc7b\n\nFeel the thrill of a hunt in a 1v1 Duel or up to 1v3 Hide and Seek mode that will push your wits, perceptiveness, and courage to their limits \ud83d\ude31 Employ an array of items, triggers, and skills tailored to your class to outsmart your adversary - a terrifying, lifeforce-draining Ghost or a dauntless, vigilant Hunter. All of this set in spine-chilling locations such as a haunted Mansion, Mines, or a horrid Orphanage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://carbonstudio.pl/en/privacy-policy-hunttogether/", "developer_terms_of_service_url": null, "publisher_name": "Carbon Studio", "support_website_url": null, "website_url": "https://carbonstudio.pl/en/hunt-together/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "pt", "pl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26230801066589339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820141_1616777329435617_8207528228351786704_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUS8bnki-jQQ7kNvwHQ615x&_nc_oc=Adqel22NMYka-SsVthEi9WMR7pHigDDS9H4iQ_M0lDdnEJnatoEYvs6Ag0alR1sr3jk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOW7t388T7_1GlASIjhuwiFrAit-wof5d8ueFD-kUD3Q&oe=6ACE53BB"}, "
0168099_8388064315214783389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbEaTe4brxsQ7kNvwGt-6YI&_nc_oc=AdoJ6MAuWElD4NvuvexHwLx_W_MpT60KZb1_Vli0XP3y1AO5pE-l7w86feYE6aZRMM8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOntNlFUT0SnkEM8rYS7XBjtGP3Gr-fs56T1iQGt28sw&oe=6AE35278"}, {"file_name": "HT_Screens_2560x1440_5.png", "id": "1051261709402320", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982609_1051261712735653_3438541724928627709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsB4TmsZ688Q7kNvwGfxNfG&_nc_oc=AdoAr_84Hwsmu2zGe9Am1NFre0x7Qc2ZE2sazgRIwJG9eVBMMcTNdGLqBduOBkheGzA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGqrp21rL6H3ZUHtpG30d_-K9Gw92X-9Y5QaxjRPLRrw&oe=6AE35E3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hunt Together KeyArt_Video Cover 2560x1440.png", "id": "859547265899781", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031500_859547269233114_6874294734507533955_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gATHR3cEAAQ7kNvwFjG_EV&_nc_oc=AdoB6f3uKaDZsFhquNVEBbtPS3CZYJovlWwWW4BWGxEMJxEevd5zUcG3p910Vt8xsFA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKF2_aZWdBpPP9wG02XydkkxwFPbC5xZpt-xhbfJ54Tw&oe=6AE33C6C"}, "display_name": "Hunt Together", "keywords": ["Horror", "PVP", "Action", "Multiplayer", "Online"], "long_description": "Challenge your friends in a PvP VR Horror game (with Meta Quest x PCVR crossplay)! \ud83d\udc7b\n\nFeel the thrill of a hunt in a 1v1 Duel or up to 1v3 Hide and Seek mode that will push your wits, perceptiveness, and courage to their very limits \ud83d\ude31 Employ a wide array of items, triggers, and skills tailored to your class to outsmart and defeat your adversary - a terrifying, lifeforce-draining Ghost or a dauntless, vigilant Hunter. All of this set in spine-chilling locations such as a haunted Mansion, Mines, or a horrid Orphanage.\n\nFeatures:\n\u2022 Challenge your friends in a spooky horr
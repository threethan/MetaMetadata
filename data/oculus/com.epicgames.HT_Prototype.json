0168099_8388064315214783389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YindMa-07XUQ7kNvwFqNKtr&_nc_oc=Adq1z_xA72Wzq2nsNtGHbc7rEXLOmpDvTKmJqB5Lngsc3D_CcTFfOgTfI2NZuM0IeFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrXcqMEZvtkAqkggoFoyN8lJCtqA0CwbQPXAzIHnE2KA&oe=6ACB9778"}, {"file_name": "HT_Screens_2560x1440_5.png", "id": "1051261709402320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982609_1051261712735653_3438541724928627709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR6vvBOdELIQ7kNvwEUF1B6&_nc_oc=AdrJo0pW3kcLNE_bnwpdJ5bvHUGLOiA9_xYD8LY5B8aAEPRVA9oSeEqeoO8sKNxgF_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4WgUNGCTRpwRKpwg3vukfbwpsL0wiNprmPwHxyNKeEg&oe=6ACBA33C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hunt Together KeyArt_Video Cover 2560x1440.png", "id": "859547265899781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031500_859547269233114_6874294734507533955_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gkGAPAFel8Q7kNvwHcQbsk&_nc_oc=Adoav8WZZMOSNIf61uLox-HOKgvhmMkiqjfAp7v_rRyYJr06kPEkquk7OOuRwC5U76g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME7yzQntU3-9NW4frWA9ZvOjCacIlPR_Ynz_AvcnZ0PQ&oe=6ACBB9AC"}, "display_name": "Hunt Together", "keywords": ["Horror", "PVP", "Action", "Multiplayer", "Online"], "long_description": "Challenge your friends in a PvP VR Horror game (with Meta Quest x PCVR crossplay)! \ud83d\udc7b\n\nFeel the thrill of a hunt in a 1v1 Duel or up to 1v3 Hide and Seek mode that will push your wits, perceptiveness, and courage to their very limits \ud83d\ude31 Employ a wide array of items, triggers, and skills tailored to your class to outsmart and defeat your adversary - a terrifying, lifeforce-draining Ghost or a dauntless, vigilant Hunter. All of this set in spine-chilling locations such as a haunted Mansion, Mines, or a horrid Orphanage.\n\nFeatures:\n\u2022 Challenge your friends in a spooky horr
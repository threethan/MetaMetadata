31_1315150573543153_7663945792259205803_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6khL4jD2hsQ7kNvwFaWk4G&_nc_oc=AdmAHjhP83ap6CJwaD7LE4001MlzK5-fLchZQ-c6t8iFUmepY1yFQ-fA9ggM8e2fs0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBykHS4osyi25J0jtEnS_IuZ_DBt4LG02FTd9hm69ENg&oe=69A04DD7"}, {"file_name": "New Project (8).png", "id": "1308512850954129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821089_1308512854287462_889125512771676749_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Bk4yyEqygsQ7kNvwF31ZQT&_nc_oc=Adk8vFZ5K35ldbzsu15XJYK4aeL2ZlK4wYUG6J1_39Qq_qXWSKcmT0__41prHsEUJcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBFmohWpxrb4CFeKhJOlvW_MZdzVYozIwIT5lwn6C5tQ&oe=69A04565"}, {"file_name": "New Project (9).png", "id": "712759978446674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821147_712759981780007_7334444542502453200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFqGkF1NB9cQ7kNvwG5GvlC&_nc_oc=AdltApMg-9qLLIQ4UNCNw6YGqMDco7Gxu7ytSJwGNuPdG8Ah1hZ07hSvDWc2OiJQVJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvlKftOf7yDw2Gp2qkfVEsbeIzpARJN8172BcZqCNq3nA&oe=69A0348F"}, {"file_name": "New Project (6).png", "id": "4058741377721612", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819875_4058741384388278_1770765304695469786_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1ieEkcTpoQQ7kNvwEfSndF&_nc_oc=Adm8Fwj8efLLDzyhMpZ3dgqnDDe1YbfrhhK9jDQsl2t_N1k41-3zsVb2gn4GaqAj4BU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLU2l_8Sn0ikohxzaN-CZHaTxxzu1k7yayC8PMCZOI9w&oe=69A05549"}, {"file_name": "New Project (4).png", "id": "1793762854583913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820019_1793762857917246_35344171708235581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHUTV2W4ScYQ7kNvwHH8tg7&_nc_oc=AdlvigpetHEmb-KsEti5F_GAC3_3TGH4bq-rzNFwweAxh3xUDKPh8w6EgNpRymE-xJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvqRYKmDN-TwUTkv6uaU-KIBiDgQilXaRlTAYUINKH2JA&oe=69A059A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FROZEN IN FEAR : Don't Blink (Demo)", "keywords": ["frozen", "fear", "horror", "scary", "mannequins"], "long_description": "**Frozen In Fear VR: Don\u2019t Blink \u2013 Demo** \n\nGet a taste of the terror. \n\nStep into the world of Frozen in Fear VR and experience a chilling slice of its heart-pounding gameplay. In this demo, you\u2019ll face the same relentless mannequins, statues, and possessed figures that move only when you\u2019re not looking\u2026 and they\u2019re closer than ever. \n**What\u2019s in the Demo**: \n- A simplified level featuring the iconic mannequins, where your goal is to collect as many artifacts as possible before they catch you.\n - A sample of the randomised scares and tense atmosphere from the full game. \n\n**Upgrade to Full Game for:** \n- More fleshed out levels and enemies, multiplayer with up too 3 friends, and extra items. \n- More story gameplay, with real objectives to complete.\n- Frequent updates and terrifying twists based on player feedback. \n\nThis is just the beginning. The mannequins are waiting \u2014 are you brave enough to play the full game?", "short_description": "Don't blink - they're watching.\n\nIn this a demo for the multiplayer VR horror, mannequins only move when you can't see them. Search for clues, escape the map, and survive with up to 3 friends... but whatever you do, don't look away.\n\nAvailable on Meta Quest 3 & 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HX-QFu3awj9dm6Q4FkCP7jvjDm7Igx9rOzeuJbkLlcQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "DreamForgeEntertainment", "support_website_url": null, "website_url": "https://dreamforge-entertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
31_1315150573543153_7663945792259205803_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsu75gQertwQ7kNvwF4MdHU&_nc_oc=Adnelyjf4UK34pr58BIWl03gcFVt87fK2GH9A327cE3wtXFwwaeVGsUy17Bqk3x391w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftVrIhDeqDStinbTnMEesrRfdgqCgWPl3Xcs4swuNX_bQ&oe=69A593D7"}, {"file_name": "New Project (8).png", "id": "1308512850954129", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821089_1308512854287462_889125512771676749_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQEQiimyGUgQ7kNvwFlY3nW&_nc_oc=AdnQSpsRsN-7g0LcYReg9t7kWHtMPZz5sFlJgEaTLgkj5s274cBFPlMF-wcKkVJfkaM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfufPex60893rXg_OfnQ0Mw9rKqOwqbzzD8OQmqVOIuyyQ&oe=69A58B65"}, {"file_name": "New Project (9).png", "id": "712759978446674", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821147_712759981780007_7334444542502453200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9L6ssPBDdEQ7kNvwF8-sSB&_nc_oc=AdmKD4qKzghSZap5eis6V2Nl6RfCfOb3jXZvo4NWcGGd4jwqA_gNBbHr3LykqbSg8uI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsmA2wM0TX4Ksq5csa_9b4OmYcJFu-_fzqNIlQ9xTcnww&oe=69A57A8F"}, {"file_name": "New Project (6).png", "id": "4058741377721612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819875_4058741384388278_1770765304695469786_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4_ZIwSu69QQ7kNvwHCX-al&_nc_oc=AdlHIvQ7i8Hy_FoX_8G028kRsKVeDNQfuKAsWVmhfCLHr5PWQrbWobv2ILSXNwbftQc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs7AxYBuyw-uOJC6KiqSAbbekRlNtSbdWPtIliJAew0Xw&oe=69A59B49"}, {"file_name": "New Project (4).png", "id": "1793762854583913", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820019_1793762857917246_35344171708235581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKLCKBp6wcUQ7kNvwGFAtDt&_nc_oc=AdlyYgdaCx0c1NwJMkHf7fXNmTSSZn7l-jkP_wIGSC97fk00qVLLfanfcFuccki-RFI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft-dO9nnkc03v_FNxJcCZ685d0UNN6yw0ABWBAeKrRPww&oe=69A59FA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FROZEN IN FEAR : Don't Blink (Demo)", "keywords": ["frozen", "fear", "horror", "scary", "mannequins"], "long_description": "**Frozen In Fear VR: Don\u2019t Blink \u2013 Demo** \n\nGet a taste of the terror. \n\nStep into the world of Frozen in Fear VR and experience a chilling slice of its heart-pounding gameplay. In this demo, you\u2019ll face the same relentless mannequins, statues, and possessed figures that move only when you\u2019re not looking\u2026 and they\u2019re closer than ever. \n**What\u2019s in the Demo**: \n- A simplified level featuring the iconic mannequins, where your goal is to collect as many artifacts as possible before they catch you.\n - A sample of the randomised scares and tense atmosphere from the full game. \n\n**Upgrade to Full Game for:** \n- More fleshed out levels and enemies, multiplayer with up too 3 friends, and extra items. \n- More story gameplay, with real objectives to complete.\n- Frequent updates and terrifying twists based on player feedback. \n\nThis is just the beginning. The mannequins are waiting \u2014 are you brave enough to play the full game?", "short_description": "Don't blink - they're watching.\n\nIn this a demo for the multiplayer VR horror, mannequins only move when you can't see them. Search for clues, escape the map, and survive with up to 3 friends... but whatever you do, don't look away.\n\nAvailable on Meta Quest 3 & 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HX-QFu3awj9dm6Q4FkCP7jvjDm7Igx9rOzeuJbkLlcQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "DreamForgeEntertainment", "support_website_url": null, "website_url": "https://dreamforge-entertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
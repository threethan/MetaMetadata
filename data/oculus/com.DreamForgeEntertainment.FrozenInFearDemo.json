31_1315150573543153_7663945792259205803_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfGbf3NXbXEQ7kNvwErxaZr&_nc_oc=Adn_knbldtEZp9wBcuoTdkWe7SzV7drEZtB_VZsMfILNV4Br-4oaHF5rjLBM8gu_qEU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftVxOF_yWd8AT3e7D9nXJTak5LScCJMTaWWgJRQ25zoOw&oe=699864D7"}, {"file_name": "New Project (8).png", "id": "1308512850954129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821089_1308512854287462_889125512771676749_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouDSed0UeJwQ7kNvwFNCJ10&_nc_oc=AdmDh2rsTxwjUUewllg10XsdCLayst0yq8bqiVlW0BSKfWU3o4IsltYrN6LzL-WF70k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftFvT2EhXqh0QxhzI7RNgD7u69xy5yJbQEp0ATcqzji7g&oe=69985C65"}, {"file_name": "New Project (9).png", "id": "712759978446674", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821147_712759981780007_7334444542502453200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-H68pvqNTEQ7kNvwEeOA0t&_nc_oc=AdkPEPrA4KvjeySBn67dI0xX9TkJMgC1C23V8mxP1LBhFKybvHusRw4PN_ScuutdvGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvxFj1W_L7uizPd5zR-Vmj_AlAQJP9JFG2AIkOdwo-Ymw&oe=69984B8F"}, {"file_name": "New Project (6).png", "id": "4058741377721612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819875_4058741384388278_1770765304695469786_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34swrhdK_c8Q7kNvwG-gtMf&_nc_oc=AdnnKISZm_DHP1PhCI68RXn_xTa5o8vIIED-PFHdKgXMcaJxOOsXjs_txGXzO1g3Roo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsJVam-dEdiX8_79JxkYcdKQERqylB8IdsiZoLWlrGMmw&oe=69986C49"}, {"file_name": "New Project (4).png", "id": "1793762854583913", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820019_1793762857917246_35344171708235581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAbFrmmG_tQQ7kNvwFNefpr&_nc_oc=AdkwNjJORQc5g2JCjLuFqjWUxDPBFzrEXJ9e8U2tvFl8I8NMAFaxacDU_jntJjycKGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfudcP6dv8UBukJOPmgRc37xvz5og6smT72ria3u36Lp2w&oe=699870A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FROZEN IN FEAR : Don't Blink (Demo)", "keywords": ["frozen", "fear", "horror", "scary", "mannequins"], "long_description": "**Frozen In Fear VR: Don\u2019t Blink \u2013 Demo** \n\nGet a taste of the terror. \n\nStep into the world of Frozen in Fear VR and experience a chilling slice of its heart-pounding gameplay. In this demo, you\u2019ll face the same relentless mannequins, statues, and possessed figures that move only when you\u2019re not looking\u2026 and they\u2019re closer than ever. \n**What\u2019s in the Demo**: \n- A simplified level featuring the iconic mannequins, where your goal is to collect as many artifacts as possible before they catch you.\n - A sample of the randomised scares and tense atmosphere from the full game. \n\n**Upgrade to Full Game for:** \n- More fleshed out levels and enemies, multiplayer with up too 3 friends, and extra items. \n- More story gameplay, with real objectives to complete.\n- Frequent updates and terrifying twists based on player feedback. \n\nThis is just the beginning. The mannequins are waiting \u2014 are you brave enough to play the full game?", "short_description": "Don't blink - they're watching.\n\nIn this a demo for the multiplayer VR horror, mannequins only move when you can't see them. Search for clues, escape the map, and survive with up to 3 friends... but whatever you do, don't look away.\n\nAvailable on Meta Quest 3 & 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HX-QFu3awj9dm6Q4FkCP7jvjDm7Igx9rOzeuJbkLlcQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "DreamForgeEntertainment", "support_website_url": null, "website_url": "https://dreamforge-entertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
31_1315150573543153_7663945792259205803_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBvZVvh5xE0Q7kNvwF6gZtc&_nc_oc=AdpPRai2MQjeX63opZP_9GnBi6MT0nEUO6fueUyX8jKnGz7Wneivp_pDYGST32CgzKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af08fIsyIUpHbML1hwZ7w9GUBTvMbVPQe8bBqYsSWVw5hg&oe=69F0B957"}, {"file_name": "New Project (8).png", "id": "1308512850954129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821089_1308512854287462_889125512771676749_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcDsc92d2RsQ7kNvwESuyQW&_nc_oc=Adpm_mC9fteT5gf7ou-G37vRauU0dQxi6XnxmGWaIoKmH1ljSNv-B_Lb2O_FBFJreuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Zxyilacd4qlIH4UpgmlavHV85taKxAj5luxSX35G4yw&oe=69F0B0E5"}, {"file_name": "New Project (9).png", "id": "712759978446674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821147_712759981780007_7334444542502453200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZeDm84uYxEQ7kNvwFA7CXn&_nc_oc=Adr-rUL6R1Ngq88JmxqsG4J4z1XvdewyyF3xa5eutA_8Unz44kar3InMl1sKn7F74_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1RvBwFN3f_QTwqphz4PRxWXNsVYqzFXUWfGyWWYeZrqQ&oe=69F0A00F"}, {"file_name": "New Project (6).png", "id": "4058741377721612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819875_4058741384388278_1770765304695469786_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjaQ_K8PvQwQ7kNvwEDZS8V&_nc_oc=Ado1Z4MgtU27CKIPBHTFeql2pQQ28t8gKuborM1Ik8WRW2l1zFUEPmKUYkVs3MDJm5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1sjb2dYkg-NujalxICFIa_lpcjJTSC50mXYdg7jH6A4w&oe=69F0C0C9"}, {"file_name": "New Project (4).png", "id": "1793762854583913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820019_1793762857917246_35344171708235581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAT7_BjOCrcQ7kNvwGmvgB7&_nc_oc=AdpL-ghrMdBtS6CagRlQNv-GMypA2PI46f7JuysSEThD05kFhWcqR_Q7mgTSVPCCcO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2o-SGO8Tz97HYJkR9NPVdYuXdav29koExdN6FLOgfrTg&oe=69F0C529"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FROZEN IN FEAR : Don't Blink (Demo)", "keywords": ["frozen", "fear", "horror", "scary", "mannequins"], "long_description": "**Frozen In Fear VR: Don\u2019t Blink \u2013 Demo** \n\nGet a taste of the terror. \n\nStep into the world of Frozen in Fear VR and experience a chilling slice of its heart-pounding gameplay. In this demo, you\u2019ll face the same relentless mannequins, statues, and possessed figures that move only when you\u2019re not looking\u2026 and they\u2019re closer than ever. \n**What\u2019s in the Demo**: \n- A simplified level featuring the iconic mannequins, where your goal is to collect as many artifacts as possible before they catch you.\n - A sample of the randomised scares and tense atmosphere from the full game. \n\n**Upgrade to Full Game for:** \n- More fleshed out levels and enemies, multiplayer with up too 3 friends, and extra items. \n- More story gameplay, with real objectives to complete.\n- Frequent updates and terrifying twists based on player feedback. \n\nThis is just the beginning. The mannequins are waiting \u2014 are you brave enough to play the full game?", "short_description": "Don't blink - they're watching.\n\nIn this a demo for the multiplayer VR horror, mannequins only move when you can't see them. Search for clues, escape the map, and survive with up to 3 friends... but whatever you do, don't look away.\n\nAvailable on Meta Quest 3 & 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HX-QFu3awj9dm6Q4FkCP7jvjDm7Igx9rOzeuJbkLlcQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "DreamForgeEntertainment", "support_website_url": null, "website_url": "https://dreamforge-entertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
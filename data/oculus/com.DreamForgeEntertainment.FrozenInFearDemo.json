31_1315150573543153_7663945792259205803_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXuSNQ1IXngQ7kNvwHNe91a&_nc_oc=AdkBGoIYv2F0CtJWjHQK__psVlWaWap52hZfHB3nNwJvco5IilQuAT5_tJ3dJBe4_Qg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvumU6QhaxvA9qD-5fR-jLeOHjoLDItCHo5H0zyub2iFA&oe=69A19F57"}, {"file_name": "New Project (8).png", "id": "1308512850954129", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821089_1308512854287462_889125512771676749_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Bk4yyEqygsQ7kNvwGynXRw&_nc_oc=Adlzl7Cp5v-V2L_lT3gQ6a8p5B_bbex7AOPwChBudRNmpOGDRNJO7mNmeo0bQKTPnKA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfscY04dPTrEvo6ZT4xh7Faogyh9MPKhPUVZobvPrIWcYA&oe=69A196E5"}, {"file_name": "New Project (9).png", "id": "712759978446674", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491821147_712759981780007_7334444542502453200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFqGkF1NB9cQ7kNvwHpy-Tq&_nc_oc=AdlS81anpNckVUd5pbIOXW1czebh3ySl_YnRwnO1auqrISy8BpvY9xDFBVccudUBSIo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftH7xpG8sllqcZXOZMbK7nNczLTDuxrRW284vB_KzKQGw&oe=69A1860F"}, {"file_name": "New Project (6).png", "id": "4058741377721612", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491819875_4058741384388278_1770765304695469786_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1ieEkcTpoQQ7kNvwHmqj7d&_nc_oc=Adkx3R8sQ-yGVl-JAyR0wPMAtGeKf6A8lp9AdkDFD536mNoUKg_bTc6O1kHDCS3dMjk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu2BikBqYgAm_sFoUOudlaqS_BtU7wEOuN-LWXxhtVuWw&oe=69A1A6C9"}, {"file_name": "New Project (4).png", "id": "1793762854583913", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491820019_1793762857917246_35344171708235581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHUTV2W4ScYQ7kNvwGWzHlG&_nc_oc=AdkPW--29SRidB2wOxE7_meWLDiWcSeoHEHAsia4Qqve6yR546ABxaFJUKt2fXeEmts&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfucbDXBdRrzopvJ1-cU92foA5yzDuaXf_5tCwVWfTUgQA&oe=69A1AB29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FROZEN IN FEAR : Don't Blink (Demo)", "keywords": ["frozen", "fear", "horror", "scary", "mannequins"], "long_description": "**Frozen In Fear VR: Don\u2019t Blink \u2013 Demo** \n\nGet a taste of the terror. \n\nStep into the world of Frozen in Fear VR and experience a chilling slice of its heart-pounding gameplay. In this demo, you\u2019ll face the same relentless mannequins, statues, and possessed figures that move only when you\u2019re not looking\u2026 and they\u2019re closer than ever. \n**What\u2019s in the Demo**: \n- A simplified level featuring the iconic mannequins, where your goal is to collect as many artifacts as possible before they catch you.\n - A sample of the randomised scares and tense atmosphere from the full game. \n\n**Upgrade to Full Game for:** \n- More fleshed out levels and enemies, multiplayer with up too 3 friends, and extra items. \n- More story gameplay, with real objectives to complete.\n- Frequent updates and terrifying twists based on player feedback. \n\nThis is just the beginning. The mannequins are waiting \u2014 are you brave enough to play the full game?", "short_description": "Don't blink - they're watching.\n\nIn this a demo for the multiplayer VR horror, mannequins only move when you can't see them. Search for clues, escape the map, and survive with up to 3 friends... but whatever you do, don't look away.\n\nAvailable on Meta Quest 3 & 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HX-QFu3awj9dm6Q4FkCP7jvjDm7Igx9rOzeuJbkLlcQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "DreamForgeEntertainment", "support_website_url": null, "website_url": "https://dreamforge-entertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
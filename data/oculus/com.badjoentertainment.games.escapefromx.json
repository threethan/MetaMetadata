nc_ohc=rWVs8WP1X9sQ7kNvwEMp3GB&_nc_oc=Adkw9f5hbCD2Y2FQiLo8-KW74ddWlaMSKjQdmCxpAIubyu5DPpkc5Ma0l73xY2p5A9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfFGNk9urxU3iRqs69VNLuTRHAfJ94zsmxiv7QcEZGYw&oe=69BE83FC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KYQAJ1jmO8Q7kNvwEv_aoe&_nc_oc=AdmLouSTQLS9BAEfj03IW38br2gvhFUgdOBI1BmqODZx8g-dhaYCGj_bWx39Wig_IHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKvGyxxNC7nrAthY2mJPdma_n08YaZWp8hFNPZRkNrmQ&oe=69BE8805"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEUDQS5cSIQQ7kNvwEQqidO&_nc_oc=Adnja5HdqVOTiYDFrJbUMIEpX9dzb4ZrtZFbY6kssU-yTa72xPQQD50wXSpTYXScVLk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJLtDt59gZvJ4x6eXI9X-DdyU6l1Q9h0201XqeYDR72g&oe=69BE81D4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as you progress from a novice to a skilled survival expert. Use your VR tablet as a real-world companion to aid NPCs and uncover the story. Inspired by Escape from Tarkov, this game redefines VR UX."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLandingPage.html", "website_url": "https://badjoentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8564242210350999"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "917519037906041"}, {"status": "PUBLISHED", "id": "777776381764316"}, {"status": "PUBLISHED", "id": "1148320703344446"}, {"status": "PUBLISHED", "id": "1492907592125219"}, {"status": "PUBLISHED", "id": "716075420896895"}, {"status": "PUBLISHED", "id": "1712459623001509"}, {"status": "PUBLISHED", "id": "1235289384918765"}, {"status": "PUBLISHED", "id": "973125461015639"}, {"status": "PUBLISHED", "id": "1550935305624317"}, {"status": "PUBLISHED", "id": "1076143280639815"}]}, "baseline_offer": {"id": "1148320703344446"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "917519037906041"}]}, 
5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85A2n1MQXS8Q7kNvwFeLC2g&_nc_oc=AdqGvu-fAB2Oufa75_NCyvuP1AgRcwHTYM0yRJJnmgo2BWtsi4ypPK9VNExygUys7Po&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PkXMLVkFjfT7UloUXywFTnR53i7TTacLKTI4pClNIfw&oe=6A1C56BC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rk4SxxLEm8Q7kNvwGG7Quo&_nc_oc=AdrHE49bEKI2eADH5XgQtYgeCUe5wUfx9cxHy4NNOqslqGmKdAAp4jA3MPl6lNRKrmw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YvHxpIQ8WieONzR0hHdwQ26cRWAqYdT_pxPWkcrgj_Q&oe=6A1C5AC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otVaCMK0uAMQ7kNvwGuAfDm&_nc_oc=AdptkCSURkeR1kQFDnC0gjBqLztLslygMVhZlQ5QxdatmOv0HYWBG5O80aDixGPbv2A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dtZejMBgEHTHHRAFVRt1yqTRoyURLy7rBUsUXNTOcvA&oe=6A1C5494"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
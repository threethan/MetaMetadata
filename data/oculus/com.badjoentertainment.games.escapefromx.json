5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuXNdLge_EgQ7kNvwGNLvSj&_nc_oc=AdpKKu6CFSph5oWjD3fg3jEKHv0dLY0LfqjXUmPGZQb2tLcWzk1rsxX3rXcfAdoA4FA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59WWX1nnmqw4gluRnoFFX44R9WMVus3YQP3hiogM3BlQ&oe=6A05ED3C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSm3FPTkez8Q7kNvwFUOa-_&_nc_oc=AdoeCGdxoTYQAV5JIe9sZMW8b1xCY_QUE9MndBuv8yVVRcOif-LyNaDRkEOLe-Y_7J4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_9XDJYSNmJdIiOeIckDPej_Tvr9yNAJ7q5uqVF5VJ1Q&oe=6A05B905"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8jx4gW-c3UQ7kNvwFNfj_0&_nc_oc=Adpha2hlrA_ecsHf75w9rcAzsLZ9ZDBZmXKJmqlK6TV0QFiinCbI7IyIqTnBTCCUkOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6afW4KXlpV_KU3cgw87gtH7UypLx2k4YF2nJfiS-cOPQ&oe=6A05EB14"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
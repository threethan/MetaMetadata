5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FbntFSyzFgQ7kNvwE0Dg-b&_nc_oc=Adoa1bICgYVwZ0KVd34JfxUHag2nB6xSFK9KTRXrQQrqpwlNfyGTL2dj7F6bs6TZAZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rvqPqmGtHqSYxl5kuqXJFSbn1FX3phAmghhNqXsYfLA&oe=69EB56FC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2n--eaQfOgQ7kNvwFYzd3H&_nc_oc=AdqZeta_bS6gDIHek9SEdM_40Gi00NHRduwI5MuNuY2vX2e-Zq2vquNxDot3Ozh6uyg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GmRDp0AcBHLTOsyAGTfprvPsIp0hHNmtNJZiPX0RO_g&oe=69EB5B05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njTci2zw9UAQ7kNvwHEsZqN&_nc_oc=AdqUmI_A5_xcTueBkf2xt4pDB3QZmOPifho6C6Byki5kUm3o9ByGtYWQvz4h0UK7jm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bvbRCSShlyBp6x0IeYB-bXz_LuEhBlsbsPsvloXtcdg&oe=69EB54D4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
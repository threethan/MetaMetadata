5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbcM-rnh1JMQ7kNvwETKQtT&_nc_oc=AdpIkMe283VnnMB_EWIRGUX9HqVV_UNoFsbYVKNQMVnFbCRcNC0w7d6gEOZA_YNYG1I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VXOq_xfEN4B1VwkrkJhT-EFShJtSZtVynRw8wt84rpg&oe=6A131C3C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uN69-8DofqgQ7kNvwEL8IdT&_nc_oc=Adoltt1uQDZISai60ZMiZGwHnzukfAxbRzOYrKkkeI--iuVQft2t9kzFtmDESghHd7w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TIlzVpaEspYNMqDDhabjkTMIcuU7gNuBmEFhRmgThnQ&oe=6A132045"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvvLMT6sLj0Q7kNvwE16UXP&_nc_oc=AdrcD74DbkiK-O8f37Wi-2m4bHMKXF_7m1I9ucAQO71e_ddSwbOZXcxpR0HR04qppw4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tq-QfGKmWfwbcxpaWyFsovaMRxnKzSXq7ebo2Y8Yulg&oe=6A131A14"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
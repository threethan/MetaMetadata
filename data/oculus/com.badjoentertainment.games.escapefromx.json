5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKYCUoTFFqcQ7kNvwGt1iui&_nc_oc=Adrb8dXbgtOQ5JUk1x3elTOROCnQ9mIbGRgRUBHBHW2vPrLWXaelN1aZGFrtX2YghW0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gYz7rf4utlOeoYxaYDz3yVEF9sPD3TwrBDKJEVbccvw&oe=6A243FBC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXLOMfM6R-AQ7kNvwFdYyHi&_nc_oc=AdpweIMN7XJVbtQqBUETP6oKKAl6xdhSarfSMO92sPEtNFewmKMHEhYnIbdPayLdIdM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y-sezPMJOAPYXJhDNXqdyl7YmLlyMNc_cOX206NOYGw&oe=6A2443C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yqp5iJ7hSgQQ7kNvwG_XcuW&_nc_oc=Adp7EEjEd8wLJhJ9WXm07eBfpZ5ISy5lGoP1Anm9VnU3NUO3C69ffU4feiOAU7MZVqY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wZgl-M1zd4LFjR1iCvuGBjWlga0X2FEr_9nbQuaKDMQ&oe=6A243D94"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuXNdLge_EgQ7kNvwHb8Tzu&_nc_oc=Adr8wqpkJv8Ri2N_1bdYMf7_F15lvOiALFi1TGJyJNICOu8suykDs7cbGW2K7sK7vcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cJUh6WkEj49-qTRYeO1DWGCwNBD7iqFVsyKmTjBsRuw&oe=6A073EBC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSm3FPTkez8Q7kNvwEs-Vl1&_nc_oc=AdrVLSGhFldgBqSrdtohQ_VI3iQN_2bnYzAwVjO_6KpFy1v_6aKXbBd65Eod3vQS_Vs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SOW7pa9VUGCxi1zGnNM4PRnsUsO-fctivLSSI1AuneQ&oe=6A0742C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8jx4gW-c3UQ7kNvwFOtC_d&_nc_oc=Ado_Gx1jpMEwnDYmw28gPWBdZsV4jkHBPPlSqOk8GO4O21jsxZN1TvpVsTjEvnNr12A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SFYpkwihrDytSe6m93RrMuxC0JhcAtDoR5Qk2Us9rmw&oe=6A073C94"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
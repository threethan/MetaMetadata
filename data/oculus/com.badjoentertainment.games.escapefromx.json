5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JX3mxSnkYkQ7kNvwFomQba&_nc_oc=Adoju3cpuuwX5rJSub36fQcTiE5oXXu-O4ZW3CUJvqx063oh8iPmvfFTNqbgO4zbaXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UF5xozgziFhrrfqMCOIVN_wA1n8Mti7BvUj7JVnv4aA&oe=69ECA87C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2n--eaQfOgQ7kNvwGHiVqg&_nc_oc=AdrRB9z5x9chCRm8QBjs5lqBfqh57r9osEBBMzkbwg0bKlO3L3mGVfmwB9GH0YPOtH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af200Zb4VtWBpFwKVTFnQ-i3QQfT2_He4FxqOg1STUjc1A&oe=69ECAC85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28zMUyXkjT4Q7kNvwHq20c4&_nc_oc=AdozeHKxybyEX61Ge6T-7X2Ziy4D0EIOEvJ9WO4X2pFj0kqAwdQ5ETW2oD6fKtxXj-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11xTCOoqHi7bMwe7Jf1bktpcHYPmb2PH5VFs8NYAjJBA&oe=69ECA654"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
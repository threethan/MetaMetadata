5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q3-pFvpUKcQ7kNvwEHzQJ7&_nc_oc=AdqeYzQIJ6QUv19z_KL2TUwwe8GlsJ6GDlk9waUdp2f3S0tTz71S-j1Xb_qj766uSqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fjmGBCsboMVZWMM2tmoSQllbIFRdTTUSz9-THG87-EQ&oe=69D63EFC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ticiDxKanoQ7kNvwHc7JOG&_nc_oc=AdoSO6UebJnQUjEqueirAwzt7gsG7-43rYmp7vuunXD-grygjnzzGye6_D-Jn15gL1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Dx1iuijH_uw3K3YLwm5w7oE_Q83e7SofRYVYvHVjmGw&oe=69D64305"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFum4w7UYb8Q7kNvwEP2pbC&_nc_oc=AdpC1MIPUBJJNUR36clGN1OfFzp7osHYfEhCnYJiGCj9z-XYfZ8mUbsx5TTyVJElnEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zzzEBg9tuFxS1bSPI4sXCKvnj8eE7zIFSB6_6Rq257A&oe=69D63CD4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
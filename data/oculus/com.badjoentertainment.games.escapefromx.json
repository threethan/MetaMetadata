5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JX3mxSnkYkQ7kNvwHy9g0l&_nc_oc=AdpX0mqeQ7oWb4zkBeuGo-v_Sj1BCUgXmXGZlZb_5Qdd9N1dsZJroFASYgw5E2JDjWA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lKiKQ0u0-q5m8wc5kC0DxCwMDEkjytewXG85FAW5ZUQ&oe=69EF83BC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyKxb2H257cQ7kNvwHn44Dl&_nc_oc=AdoIQICOR9ZuMGFM_o2JUYwNUzG1WumZdg5nY_bLvySLw0jQZFoHhrWIv5dpiygYklE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gU8zPz9n7dh4XzstubXc2LrpR2dqccPn7LshfGi5I3w&oe=69EF4F85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28zMUyXkjT4Q7kNvwFl2abh&_nc_oc=Adr-A2rC0fsZ8olXGaDtDwS605U4B-VEAqNGgro9Mng4Yo6KUqS4ieYLzejv37lKW0g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AlbVOL5Cj-j5Y2uVAW1IdE3x6K351xjQMo61Cn_R0Vw&oe=69EF8194"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
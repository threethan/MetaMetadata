C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey-8rF6PZ1kQ7kNvwHCGiPF&_nc_oc=Adq34RwDK7uj77u1VxUPouxmPbv70-6RRfqZn1_AbMPHv4XD7b7--v1k8gVrU2xZ3kM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfJ5lAa74nMfkRfjzOXg2-mLmjs58_ru5auMVJewmaYA&oe=6ABD31C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWn7fGEWdq0Q7kNvwEEJH78&_nc_oc=AdqTsziSao4M3XTNOjY4yjZYpX2q1wR6_dNr-__G2gYE8pQ013HccW5BnO9r6q3_t1g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXZFXeMW9ugv_P2R2MWoGmt88B89MV5_talY-9v_ckEQ&oe=6ABD2B94"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as you progress from a novice to a skilled survival expert. Use your VR tablet as a real-world companion to aid NPCs and uncover the story. Inspired by Escape from Tarkov, this game redefines VR UX."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoe
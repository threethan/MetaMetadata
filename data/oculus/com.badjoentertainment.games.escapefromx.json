5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8iRTGf13SIQ7kNvwFQ5Nub&_nc_oc=AdqPzzxL-ccFL_vrVETBzAP_i99zSoPdTnKUIhMNzE66A04RMqY1w2ODriR1H3OyOc8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pT9UlO5neAg7benC72JudapUoq7B_9Qh3hb9Pel0v7A&oe=69F4C9BC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuMGWlv5RuEQ7kNvwEvPaCt&_nc_oc=AdoQ6MfuGuAhpuTF8BvBP-myGdOpvIWmCk2kdwvCJTietKDmlBQ4HWYIKBcbJSlMGpE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fgJW1gmGlS3OSalVqTc2Ys4wvQQffV2GrWarUp7H3cA&oe=69F49585"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFNhYZyQwJkQ7kNvwHvJu7R&_nc_oc=AdrIl9fHnasI0r8rrUZvDc1u2eD-uRbXNX0R8AkuunRKFYgoadQWLGPV6z53FNmgouw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MEWFJEFeeozXEgFHxqgWBimC1t5YXd4qoXhBDwTj_sA&oe=69F4C794"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
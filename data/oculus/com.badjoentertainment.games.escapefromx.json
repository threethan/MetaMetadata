5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jkn1d7LPRn8Q7kNvwHj6-Xn&_nc_oc=AdrdCCk5tjQ_aA_4IMeT7A7fLAeJ2noYijZ4CU0KNbLuIs82pTeTqAckMMgIP39N3ug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6atmiCOICBtnuqdef7E6VxgCC4B3k5F9DsolWoSu2KwQ&oe=6A08903C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSm3FPTkez8Q7kNvwGP3j_O&_nc_oc=AdrtPDKQ7bTJJoPHoE3jsbTorcA2SuN6rEvYQ4eyc6F1NJ81mA4STc3AGIXomfx64Vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5htF1R8TyGrVWdzO_BESuLL_5qPIDUCsB4LFCeCYL1uA&oe=6A085C05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE6mbL2p5DsQ7kNvwH7wSk4&_nc_oc=Adr8b_FpfcnhCzClTFTe3GX6B4zGx7AlO3j4noldxfS35LsKu0Ds89e1-VEU1h3Ap-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7teDhx0tQgoB2zBqtyT8IbBgKJmqk_iMJA1FgZ7gxZLA&oe=6A088E14"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
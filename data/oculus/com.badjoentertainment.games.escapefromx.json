5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4vmY5Bw_-gQ7kNvwHPp3vv&_nc_oc=Adpb_iGOZBiollUHIarse5zs1TS8CqBLLuBAUY1_JPOqisg71_USP26Tv1sNeKi83r8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMb8Ape_BouBVg0LAXjHXx_oSrWm0jnamkhRTAnLtoEA&oe=69CA617C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csYt32SnX8EQ7kNvwFYGQTa&_nc_oc=Adp4R4xTHoXB4Qki_r-crxs-K4vd0PMFSgm92d1HeJocEemxoMQXTRdLezWifsn2akM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTMLbltOksGcukt_TAl-c_naXiDJh_e4RAff2VtpPYWg&oe=69CA6585"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7KEHdyQa2YQ7kNvwFA2wrM&_nc_oc=Adp_ifQsL_XVlbc4QyQZSxAjy9OVz-tMdtdIxW1Lu_PDQ7DZWCJdlPt1w0S_qFpYm0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrrHk9ffzB_bwsaLtC3PVwmzW5OsM7evShVZr5EcBxTg&oe=69CA5F54"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
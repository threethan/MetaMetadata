5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT91rFUTbvYQ7kNvwEOkje7&_nc_oc=Adp8K6iM6ycOYKCReEqfVzsso8k-IE5tYFfnXNsfZFNxTRilp6OmCTLeOONCeHQGOeY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Kaw07SdnQs_kf_R5qA-JtQe0UUBl5S0OVRp6lphgBjw&oe=6A0C84BC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQbbA6rI2EkQ7kNvwEZS6mY&_nc_oc=Adp9c8R3bKnBkZO_Y3yq07unku2LGqWxq0xE9Tv6mvU6KCQJiJmRgD7IMI7vYri-zuc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MgzZUcFAGyK4o3NNrVAc9XhxjV9Cir8PkXfiXSL9sGA&oe=6A0C5085"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_A3KP9iagwQ7kNvwH7Yr-U&_nc_oc=Adpb7XCCSwD3_9XWOlipw3PlBaTfF9mSlH3yH1tsLkJsIsqXMlr5QyXut-4N5a_AfDo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tyy5UsVOIjzUU_sr622uVudzg_XpbQoByjvQF7HR0tg&oe=6A0C8294"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zA4jw0ODE_sQ7kNvwFvy5TS&_nc_oc=AdoAosbDbD3BSVTUHXc60wgIG9kFB6OHB9zXWQDm8fpjnq8I1QIdnpEpRdBiNXyDpHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzWR7zOANBmyxSoPNLioDSJ-TeCf4_yGV1Sjg0Ruyu9w&oe=69D0F8FC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUxkmS_o3kMQ7kNvwFlnBSZ&_nc_oc=AdofToz6oufveDZaPE9ZrxCTC-KxdgmA4rNhrSfDNejgZ4J5LayZYupwwXe_7x-4J_8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4PmvAACHKiZPz8wyvAVUN3FFXSyhjbXzG1nrK5CnR3Q&oe=69D0FD05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6lA-azs9IgQ7kNvwFVthBx&_nc_oc=Adr0cE3jBNT6GYKdVliojx1c7O4uUBAAwg5rrU7t5ZCBegqZLzfP5HEy2cT3aspxNdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkGZYNq2obrmliDKn4YNI4TDrqQQd3pScj8fH_ANcOWQ&oe=69D0F6D4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
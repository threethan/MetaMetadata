5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNeTx-5E0KwQ7kNvwH9pNbH&_nc_oc=Adp2oFbPlpWFgvLSIqtFKv4nBtzKOQayfRjYSamGUuSYuABnnK2Cz9c5fWBYlRzuopw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3T_Y7FL0g2DM26DQTnQIzmmg1IjpMv_Or237uEucTKGg&oe=69F3783C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuMGWlv5RuEQ7kNvwGczVYV&_nc_oc=Adq0rC9S2K_YRx58o3svogmmJ8oACARVCYes-rOTt5tAOym5j2IwsbUXuX3qShxrtUM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1atW-075jvkS5ZtpkDmtJyLxFDobogfPBV93sqwiZaVg&oe=69F34405"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zg1hdPxH__oQ7kNvwHlCJ9D&_nc_oc=Adqwf_2JYjHmXbni3k8P4VbGW04TKpEaWQhb-q6yUMm_GP9fzJML9u9G1qq-1Ke6f7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3buSkKpyRZJtewShXqSixMSIIBqZpHqPZjfh0hmvxl-w&oe=69F37614"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
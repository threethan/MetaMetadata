5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI1m1_Ra4TIQ7kNvwHh26dB&_nc_oc=Adru87ASeanxg4udH0Df26ut7tgwnl6uno49BYH5YY57kZIxqlOpQ6Z062IZFmgDbA0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx86ilpDcws2NFbLM7U561D0vI7B_bGFQ0Rgiie6BgDbA&oe=69C7BE7C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmvM1nN1ojwQ7kNvwFTE1xf&_nc_oc=AdoLlKuTqxiDNdS4AryEcK7UY7uz5SArDfy22DghCAwJl6iF5Q4Mxh274PuGwHMeXc4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQO4xfBdLkfWjoE9XQ_bFwZGOaotMCNfSCICtKexkVvg&oe=69C7C285"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLI5jTX8z7wQ7kNvwH-wEbX&_nc_oc=AdpOlJnCcfksG7Dwt6TXfQIjf3GBweobw0U7Kz98NwdvxzZcO9hcXv7r4Bm0A5ruwak&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzedDDpvYCcBsYLSy62sPQARrd-9rkSJ-gk1PkqJW2aOA&oe=69C7BC54"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
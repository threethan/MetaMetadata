5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0k6osJH0_NsQ7kNvwHAIZaq&_nc_oc=Adr8CwCAIbdZtxf-RF2By7I_YiZwK9m0X_UxF8FP-2oPl5JWRA_xe_1FykCYA9jVtlw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jUtX2uKo4L9o-juq8fmYkXXcGJXTyvjkVCCBV8rAUJg&oe=6A034A3C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU2J4reJq_sQ7kNvwEJDbk_&_nc_oc=AdrwruedCHkUmGi8zIp4lDasZFZ6-NuJutQDMQHDHyhk-ADKFqk9ADmTYRKufliZ1QY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KQJjf_P7Z60twUpvGDwNFWjAZ01gUHE9V9SqirD-9SQ&oe=6A034E45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6u219JfIo8Q7kNvwE09U5p&_nc_oc=AdpovmoCfSlj4VrIGjrvUVDWIJzsvsO0lp9ex5V7wY_XA6YK8vpkUSS6aXLOpFk34Gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iFoPivOFLeRlqX_NMqYu16OCPHJRSafwdvz8id9jE-g&oe=6A034814"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
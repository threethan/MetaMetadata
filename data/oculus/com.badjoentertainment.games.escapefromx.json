5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8iRTGf13SIQ7kNvwFYPYxA&_nc_oc=AdrB_vs5eoaNQxPmFJ6AZooTA18NYyxexqLrmTnPdrP7HMK0a6vDKlUKH4qAEvRMLHg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IfZ9rV0qUOoM1E-jfu7zwkNsF1A-W_ltYRkEh_uKwAg&oe=69F61B3C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zo3uaL4hq3AQ7kNvwGG4h6w&_nc_oc=AdoYV1GS_LffIpim2Ra_cBEG6Y3VASp5jv1ahtZKYAvAl2p7q7rYibdzWdY6C3HGJtc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zbUWDBhHcLl8cp8Ok2MpblF-dBUsg-rANmZHwjvBvqw&oe=69F61F45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFNhYZyQwJkQ7kNvwGoEix3&_nc_oc=Adp9jFXqvB_4H6KsSeQpYlXckzKPLQDd2Pu0n5HI7AiCamX4WTsBjWuRVdqzDH3_Aks&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jtmBdUkC_M3-nSso_deyd0fTanz6S0aadIG2q7oF2og&oe=69F61914"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
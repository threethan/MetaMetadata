YgR3vbsgzF3o4SUbAUqcB0-jJi89c2A2Ybrl8Das2-fnT2s0Tk5A0ZHdc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjcfPA6UXPFoVye03OXTl7UyuBHwCNGRqJLpp-2ltGhA&oe=6AE1EDA7"}, {"file_name": "leaderboard.png", "id": "2101045293739901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820648_2101045297073234_7987678931978184919_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtffKmenpVAQ7kNvwGcyS2X&_nc_oc=AdpZfwL_Iz3k0NQcZiXA38DL3XtWsC9Tg9cIvQ7gyw9Gd7IeDGCOPJ3427OVYnleNeo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1OqBDf_8j1GFgCCbvuk1vvOxsfG-QHmX7fu4MyXh8mg&oe=6AE1F55D"}, {"file_name": "screenshot.png", "id": "4404667079758017", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303746_4404667083091350_4140445348785492288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwqCKIy5dUkQ7kNvwFSbWff&_nc_oc=AdpEDAxT02-iLN5R2BBS6yrKvU213ze5BuIN8MVhCVnfVfx3keULM9TlDqeotRI7N3M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPVo7HJwtKul3tmMXtpZt10Z_6KqZPXgui4BUUdMCD4g&oe=6AE1FEAF"}, {"file_name": "screenshot1.png", "id": "759602579839087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308164_759602583172420_2475078145938702107_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW0gWIUqHXQQ7kNvwFy1Ils&_nc_oc=AdrcO5cNcuDqGcDoe3Zl6Jl6vY4RUlh1US86SaU__FsfPDFnwocRGFs0MqtNpi4xTcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP3rHPnBV-mT_4qc1PMi316y_CeW-bo785HkUMpAo3pQ&oe=6AE217B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "new_poster2560x1440_no_text.png", "id": "1919557888817794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303760_1919557892151127_4609635479397740155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im4m230QZ1cQ7kNvwETD-RM&_nc_oc=AdpFDLKYDqN_YNUYAD-p1gWwh56gGQuvDrLE8AlShRE4FLb4B-XEJkmyhmwrKaumf6w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8AyuQg1NOMacx6siff1OPEkfbW_uPA2L8Hq_iaJsZWQ&oe=6AE1F643"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Escape from X is in Early Access. We build it with our players, and your feedback shapes every update.\n\n\ud83d\udd17 Join our community: discord.gg/Je33jR5nh\n\u25b6\ufe0f YouTube: @BadjoEntertainment\n\nEscape from X \u2013 Skill Beats Gear\nEvery raid starts with a Glock. What you leave with is up to you. Escape from X is a skill-first VR extraction shooter built around real physical combat. You go from zero to hero on skill, not on a starting loadout.\n\nNEW IN THIS UPDATE\n\n\ud83e\udde0 Smarter NPC AI \u2013 Enemies take cover, flank, push and fall back. Trained on real playtest data.\n\n\ud83e\udded Holographic indicators \u2013 See every action you can take, right where you take it.\n{2308732093219951}\n\ud83c\udfaf Visual gun-handling tips \u2013 Reworked guides that teach new players fast.\n\n\ud83d\udd2b Gun upgrades \u2013 All the weapon improvements from Escape from X: Shooting Range.\n\nCORE FEATURES\n\n\ud83d\udca5 Real NPC body physics \u2013 Shove enemies, shoot their legs, and watch bodies react the way they should.\n{702870042245024}\n{1499559567859854}\n\ud83c\udf92 No floating menus \u2013 Everything is physical and in-hand, so you stay in the raid.\n{1344307120683939}\n\ud83d\udcf8 Polaroid story clues \u2013 Piece together the story.\n{1953303741909990}\n\ud83d\uddfa\ufe0f Replayable maps \u2013 Learn gear routes and plan smarter runs every time.\n{24646184375082887}\n{911466928590633}\n{854137890328340}\n\ud83c\udfc6 Leaderboards \u2013 Compete in Treasure Hunter, Kill and Hardcore.\n\nand more...\n{1616558729592946}\n{2847820818886321}\n\nON THE WAY\n\n\ud83d\udc00 Groundwork laid for new enemies: The Hunter and The Rat\n\n\ud83e\udd1d Co-op foundations are in, squad play is coming\n\n\ud83d\udc80 All About Shooting \u2013 Feel the chaos.\n\nWelcome to ESCAPE FROM X.\n\n", "short_description": "Escape from X is a skill-first VR extraction shooter where every raid starts with just a Glock. Go from zero to hero by looting, fighting and extracting alive. No floating menus, real NPC body physics: shove enemies, shoot their legs, and outplay them. Follow Polaroid story clues, hunt the Armory Key, and climb the leaderboards. Skill beats gear. Can you escape?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLandingPage.html", "website_url": "https://badjoentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28481664734848785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303746_2611055922584657_3460939442554364778_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGE8z3MfL-MQ7kNvwEFK4vQ&_nc_oc=AdpKoigGUxh_TzvFkNxk2Tfx2le1OcbeJywSwVDgMUkm3xwTPkCzajJeDWkw8d7RIfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRJAMQFjKMC60pi-hZk7oc231DJLQOjSyiEmyIejZiyg&oe=6AE1F199"}, "is_concept": false, "is_test": false, "is_trial_offer_
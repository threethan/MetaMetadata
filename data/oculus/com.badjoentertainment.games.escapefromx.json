5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpkS6JEo1hAQ7kNvwF99P9D&_nc_oc=Adr-R3aaYr2Km3cXC5bj-E4jUYF4TuOU06dAW4oU400y0LAkBs28iBJv6FM90l0WZa0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eMY1AhOMRQe4ZNwZLTQlPT5iQDpdo2dSm7MoKmmknMw&oe=6A1B053C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rk4SxxLEm8Q7kNvwFhPxHD&_nc_oc=AdpAmYUenjrbGVeNenKUDSWrRw-Nk1kyDLEfLdZqGJBXwCDtkANA-rouEzUlb54lsIM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m-45Wpy51YUysE2PwL-wpRzdpOAjqFAYTFNpwkZBk7w&oe=6A1B0945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybtJy2yxB1YQ7kNvwElybTE&_nc_oc=AdoXhqnLI3eRc8bLlT_Qe961QAnvI_H1LBoROXpwO01h9QcpPiL6gkDwredNxKLqvwA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dsB0CFqdgG2nu5cBEPYCuYZWSjIs-62_9h81HEMLZ-w&oe=6A1B0314"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
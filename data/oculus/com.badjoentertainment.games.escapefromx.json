5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrTuMaGY6-cQ7kNvwE49M1z&_nc_oc=AdrrepQzkoxUeihuu1sEHmy4OYD7Jd9IgM9Hcy1z2dK_sWK30M7EuyWu9ZMFeyS53kM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IrpUvxFF29nvHryce70fTn3a6JTfTGrWAjK65EsyMtw&oe=69E610FC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7NVNEjdZWQQ7kNvwEnf8P8&_nc_oc=AdqhGIXysvFrn5t4n1Zpx0navemhAa5Rqt5zdXWHnpTgVlF6_SgXzO5N4g8JD7fSxWY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gHiAFyS7ejkbDsR-BUwxYRBl0jYws5lFIX3eC9R63_Q&oe=69E61505"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUV758KtHdkQ7kNvwEObIbP&_nc_oc=AdpOEWLqFoYPKPUp3I9RoWsLdApvuBZlU2DxNQViycT40G81f2AvkEqu9YOoCZlgoPY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17WYZcguCMuoOiFgk4KKzxB0MTFDjheWz4JuAAfD43gA&oe=69E60ED4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
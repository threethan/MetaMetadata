C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUaNYc_XAigQ7kNvwFGf4gd&_nc_oc=AdoMOTC0vWXyDHvJUgWV6hJ5QiCE3YXXm95KDwp57Pazl75gHRqAtFbcju3XCa5UQeM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrC0vBQuawkDv1MO9QlVO1efnycMA13fi266MOuEEHig&oe=6AB7EBC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5jwCQPCf4IQ7kNvwH0qXiE&_nc_oc=Adpv3WSACfhoWLFr-c8Vjcl-3HM3SYD7kFqkevofkKZSa6ZEG2RTUqgSrISvJSamyq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBLaOBpJe7M9vhByEAK8uKTVzHsaZmpkg7JadEayk1Mw&oe=6AB7E594"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as you progress from a novice to a skilled survival expert. Use your VR tablet as a real-world companion to aid NPCs and uncover the story. Inspired by Escape from Tarkov, this game redefines VR UX."}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoe
5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLNe6bfmwvoQ7kNvwFzmsya&_nc_oc=Adoz9J-YqB4QMJ7iy5OD_6MZuegjYP0Jv2kiC8i9VFluPcY5kqVbcsneIZTcXyFppyU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MNtKJcOBCNyHTMvOLg2f-LJKC3yaeVpX9a3i4wE5sdQ&oe=69E21C7C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCVgI-3qSLcQ7kNvwHolkT6&_nc_oc=AdqzVmRQzlkOHEzKkf_CLWrOBOXMwe-5mnuqBB1o7fU29JCZx5sH_B3A8Pqna0WCa20&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jufYAVadfVJ0DelWGTMyKQHIQvM3Jo44hw7OgOOZMlQ&oe=69E22085"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsfEnSvVL1QQ7kNvwGKRZ50&_nc_oc=Ado_yNe-dz9RFIOwdshldwgvH85gXgULOvAwjTCydcN2V-fSYIDoCnxYp4CD9xyDLJI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nVJrk6_JD6uuHGqNsa22tWYaIxOIoXhHVRbGF7hRPsQ&oe=69E21A54"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
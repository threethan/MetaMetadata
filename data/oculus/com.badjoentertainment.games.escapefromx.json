5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLx4MdF3_RIQ7kNvwFrRLyD&_nc_oc=AdqbhjeVzkg1HuduHGHXHY4r_n7_BeGyyvfps8lwzMpG5t2LqpgNuNTU4kQNXz97Q4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rwpyz0m4jBw8Gip447GaOg1FQHcno-ApJpQUltP-4Bw&oe=69FF1D7C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-YG2FPHt3gQ7kNvwFXv2MA&_nc_oc=AdpPfj_cyZN6YQgj6cxLqj6xLZ7-1laOxv3NFooXC2-RTJs1r6YvZw7597AQvbvsLPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6culCsZSHeVm7CLBTjcG0TH-V7ibqT-IEcjyTYM48BtQ&oe=69FF2185"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2sQySAh4O0Q7kNvwGsXFOJ&_nc_oc=AdpRtdGp4waoOwUQL1O7lunRth_0GaaNu2QXEXdlQXu5tBH1HHqjc62-BKYkMNe71es&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IcGQsp3nv-vVZLA7L1idhJsLz2NzWBx5J2Kkvg_rEZA&oe=69FF5394"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
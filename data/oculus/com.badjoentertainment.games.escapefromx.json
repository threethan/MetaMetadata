5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fONU1VJEJwAQ7kNvwH32ob8&_nc_oc=Adqm508S1KLlc4lxV_m7w4RPn2d57z16AmwsNmKqDDsrtVW60YlA_rY-YUVlpkzXya0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rq_5OYHJrxOBNV6mTGtb7hjhGU0S_Shj5ufSPlasRJA&oe=69DF797C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nz2pU_SfihQQ7kNvwHRG4Ip&_nc_oc=AdqYWZIIVJWCnSCw487m90pIwML2zqZud_GsKyDo0ILwdJU3_Va2G9QgYdj1CXxsEbk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V3_WOpmtRvbMGhL0vdFDIYyG-f5P5f59jgZBbh38A6Q&oe=69DF7D85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjVNyB1TJgoQ7kNvwEoz_zL&_nc_oc=Adqi7QClks3tUpZLN7oGaWfWQNfwCtuyRWBVjXnir8WV6XxhovSP8ZFNpZKg2dH8eKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xNCrStrDTEepLYrhal0MP4rhfhE5Ku90yjV3WlhkDVA&oe=69DF7754"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
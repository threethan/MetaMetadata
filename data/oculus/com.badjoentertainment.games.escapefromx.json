5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLs8mh8mmDQQ7kNvwEueLQp&_nc_oc=Ado6oXQOU1glvhunTjx8556i0r6OiHjeKirF8_2oh60iM5Zjkip9ffHUQfz9JcVri48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CRFzDh6vj4ODFNrGoOCkaV7CaiKTJWXOlLoxnG4C6Qg&oe=69FA0FBC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLyM6Adwae4Q7kNvwEFBuYD&_nc_oc=AdrPJiNNJ0dZ1PvSfC3RiQaRVfAh1j2qqlmggMjn0TVWRXNCcN2wXFEJepaP01QW5Ro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mjWuw7LjOeOF2t6jYb_mSRAfYkECxwunXyzsu7dyLZw&oe=69FA13C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvsAUnrVGPYQ7kNvwFfuI6w&_nc_oc=Adoz72N2Fi6hpn8cHzfikDui8BrGlsp68kDENXKcBYsl9u5iDpV-qkWHJr5a4JJRFw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JbWYZq08gOe6IqmFHjRagA_zmfMtR3c5I3yeoxyrqAA&oe=69FA0D94"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
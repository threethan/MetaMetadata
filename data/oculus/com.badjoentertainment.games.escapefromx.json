5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLs8mh8mmDQQ7kNvwFptQSE&_nc_oc=AdrjoE_Nb9zQiHyySF0Un4V6yTIfXx4dg7sVX4xcvZbhYwVzEfeaB-CHg7ff4mcAQBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3i2ZHmVZpl0xZt8TkSWCa5RlQ_PQWlGY83cAxyaydBTA&oe=69F885FC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zo3uaL4hq3AQ7kNvwHJrrbT&_nc_oc=AdrcI1mwwbIBbYFn8EKLMzFJKx19ZvOIoPzWZCdWCS2ch3pgCrADMWLvBZtrTz1Wb3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mLspWBaMXEfBwzqRd5CcRykSOqgMTwLV7U6RFdNodYQ&oe=69F88A05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvsAUnrVGPYQ7kNvwHj6f-b&_nc_oc=AdpxGEXNkw7idNl4NoOmtjJDm87T80m4ijXmRxI25iAoMsrUBpybyFQGf1NTWYQcQy4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hoZdSnfKyoSLJ3HiyKJthgqgwMoYgw4dnnNATEyyZ6g&oe=69F8BC14"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
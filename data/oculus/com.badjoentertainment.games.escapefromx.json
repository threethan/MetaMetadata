5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jkn1d7LPRn8Q7kNvwHaOjHV&_nc_oc=AdobBWVRxdgRw_DVtYLpm9od4uWYyfZItAJFIc5V-xmaV6Q21bJBWgayZqGVhhjO1ig&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75uwzkWmRI-WeV5Zlb8Q7McwYirI1kBoMyhU6NKI6r2Q&oe=6A09E1BC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQbbA6rI2EkQ7kNvwGBzBTz&_nc_oc=AdoviZDhpMHIvMEi41q20uGdFfUfMNSIPNpMFPdesb49k6vZsxG4jCnriarxbUzXDyo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55V1UMGyXxrH0ZRcm4A9poSf0fjtbJ398inty7OS4QZw&oe=6A09AD85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE6mbL2p5DsQ7kNvwHMhTyQ&_nc_oc=AdoPdT2G4zQ4Gmkt6W5Q7r1EKF8meUl49NJP2_J9R00lg2nj8pMsswRRVzqfsa2RUgA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ICA769poPldteheE6ZuVkrUUiP32lGEsBLk1dV90ihw&oe=6A09DF94"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
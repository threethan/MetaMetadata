5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3jhyS__Xq8Q7kNvwHptnKj&_nc_oc=AdoCN-cQ2FfVBNvgSWfRbV7vcxrSshYr5eTdtBS7C-fwxoGKAKj8YoA-LtnVPO8k8x8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ47kdcH4b1lEqrHPm8R2aABjf8N8a86Kub2r06uvJlQ&oe=69CFA77C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUxkmS_o3kMQ7kNvwFMggwj&_nc_oc=Adq9SeB2UciAScqVS3TdHh3DsZTrG9l8YXTG7GO8tDf-fC7O4_j1Iw6xubtRVAOm_v0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2mqBscH-6PpFPWWPo8IK99ifDvIHnbFrbYfCgi-Iyzw&oe=69CFAB85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVbXloGtlVYQ7kNvwGCQtrN&_nc_oc=Adrnwsa4hZ8g-kYQUFy-sNIX1syGSWyfDsxIoHtAW3TbfG4jG1fd36OB7ss-P2klUM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg6tAcOVYLrnMb611IQ-nLqBGxfjbRs2YUAmVS2_pobg&oe=69CFA554"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
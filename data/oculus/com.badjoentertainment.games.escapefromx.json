5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85A2n1MQXS8Q7kNvwFpeBVH&_nc_oc=AdrEhb_hQgYHofeMo9F0_bqKw-KV7vETbFR8tA4MAypxsx7fsbbFvRqj2sd5Ub8Iqek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yQDaSUdmsd4M1BCawDy8jptNKY31yH94UQH234TOqjA&oe=6A1EF9BC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4edEhftQzkQ7kNvwGLohg4&_nc_oc=Adrpfle_ifn69sVBCTA_ANetrTAeQRQ1skQZ2NOc52TnCeIEjbEr65mxoX-a8w5stlo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-IYHSvufCsafg_Zn41HK88N1HSMc-V6WcT4evgl0iEA&oe=6A1EFDC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otVaCMK0uAMQ7kNvwEe-Htu&_nc_oc=AdpHGyIRudmv2lQNpyMjB2NMtxdNpEUNGBv1HUmSFReRCU2eE1pOeqLEEofSCzH5o3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_V0ACrDfLdpCq08t-yY_bDPZnyUosw410FT2w7k9GXg&oe=6A1EF794"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
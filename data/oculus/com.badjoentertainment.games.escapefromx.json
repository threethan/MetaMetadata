5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3jhyS__Xq8Q7kNvwHhly2B&_nc_oc=AdqPJp32-ND21M6JQ7CBZNM8liC16eq4_3evFSqyVaue63-utOq1llA4_r4M_gLWO4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6CLN2iyqE1AnV__OKrBomAVVn5kHUTc_CE2nhAwUBRg&oe=69CD047C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csYt32SnX8EQ7kNvwEa9NiR&_nc_oc=AdrYy5bJzMS3LC7bAmmVo8b_Pf9vQ_zC8Wyrnlg4Jab_Jau83Qt6_Wt18rrB3eSfyd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAjzmpGdmVmxHQ-_FR70bpO1yLa6mwxxEAM3KmNcw1oA&oe=69CD0885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVbXloGtlVYQ7kNvwHfQ2cC&_nc_oc=AdqNaLv0kADKXKXYB3v2uS6aoI7ZQnHTPm7s3wSAa1vcyhBniF1HFVyL6JmDeforFWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwR5GRo-lrfNx5cTINU7SYwGloloh87hG28QxbLoRWB4A&oe=69CD0254"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI1m1_Ra4TIQ7kNvwH_BMgX&_nc_oc=Adpa_hM9qoWfTmcBoVePDieN7KH5MvlVBhcGVSvj3wC_PECD15UVZpSs5dKW2o8Xhrs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8tt2tXGVpWI3q-fxtkA57pnfBMnGs9YPCRZpv8hgs_g&oe=69C51B7C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZsWUIOCLTQQ7kNvwHGpwcE&_nc_oc=AdpR9VY2nWu9QcxAAOtmDnxxUjSmyD1bhads6EewTcEfCGC98Nbz2u0OqccqLSfspQ4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoVxKKhqGla-epIvR-HoeZMTrS2iMT73v74_imbOYugg&oe=69C51F85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLI5jTX8z7wQ7kNvwE4sv32&_nc_oc=AdrH4cfglKF_6w2zHpHOghIhK_o-ntX1-RAySTfXvAMUgSA0pzYugmg_P-p5Hv4myQg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzajl4eOxC5uK6reY2y49wfP526BhiNW1BgmcVTSIqKXQ&oe=69C51954"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLx4MdF3_RIQ7kNvwH_Zu_O&_nc_oc=AdqaxVKs9svJ6XHn_I9XZOofd72Dgq7m64QA06pfZQMwhHL_6wkmyCbGwvMz_wYT8Hg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b2CdmXe08I70w1YA-lZCZl99ETN3J5gxo3anbW1zC8A&oe=69FE043C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-YG2FPHt3gQ7kNvwFqY0_R&_nc_oc=AdpBfKWcOj93sqxZ2ac8-Z-wMGOLNVZ1Ob5r7zbCF_qpWk7A1dsNljI533G4PcMvClk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Dxu8YKVxt5Yd6q3aNUC_COcyWmrcCISGvB3iJQGouew&oe=69FDD005"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2sQySAh4O0Q7kNvwFpWvZR&_nc_oc=AdoGO-UY5NHpN0IczVsaGYC8TkLe6jndKBlPo1XRzUt95Ztjh1X1O88MILWmplpwzIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6am8mcT15tGo17Mzc8yOOkrmpUw7A1SBTNe2Ia2P8O5Q&oe=69FE0214"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
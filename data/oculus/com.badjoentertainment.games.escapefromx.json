5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT91rFUTbvYQ7kNvwGBxiDx&_nc_oc=AdqfdCSherd0P7HtrpGEA8Iq__JHSekBVbEzFbLPzjRMnOHolFLzbWamI6qHri6nJvs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YFuJk_x7mXKHzbMjnflO5p0N-H_swwPxFT5Y5F2cnsA&oe=6A0DD63C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsCH_swxzAQQ7kNvwFIN6vJ&_nc_oc=AdowHxjngTV0MIIw7wwDwzgjP-cEtAN9Dv-gEcjyqjZXvw_hGdvDfYzXIobeObFez48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rzXe5BQWBQmsrxpOy6mgnJyNeMGQ5HLnXGb-t44qIhA&oe=6A0DA205"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_A3KP9iagwQ7kNvwGwBoyI&_nc_oc=AdrYE1VwujGJIDnn6SD90ByAAMsCcbfVkXLbM1IKuoPvErwj5KbzypXFQy_cCRC62cQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64Fnx1FxrBbYzoBdrNkoWJcdrLpxr_-ZQokdZ_YxCzIw&oe=6A0DD414"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
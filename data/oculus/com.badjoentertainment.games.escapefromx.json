w5lxT6JEh_zoHhWSK9Y9zk4ox03-cioyRP_Z4LC--i11pV7zzNgko5NpI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYOLkTOQ55gKhruI9chfqDuJJnC4oR2mjS1Mr9WlDwvg&oe=6ADDF927"}, {"file_name": "leaderboard.png", "id": "2101045293739901", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820648_2101045297073234_7987678931978184919_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCTl6weu0nEQ7kNvwEnCWrV&_nc_oc=Adp3-A_ZQkqv9g3Bjyq-BEPIkVXFHwk-w18yHZf3X3wdhe1eYcqWS0HlKCHqqdJ2Lo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTL-ky9DycjH3X4_dResLj4n_j7Y9eUKB2W3rL6aUJ-Q&oe=6ADE00DD"}, {"file_name": "screenshot.png", "id": "4404667079758017", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303746_4404667083091350_4140445348785492288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCMXAPZwpUoQ7kNvwFjPman&_nc_oc=AdqK6RCqBkYFi3AHDXVqDrGiXrX_2p3HgBfEBGkiR1Czn87rHjQDN3XnU27T54G1zFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6dFnczRx5WXfL8hwQtkOUJwqRV3D7Ly6X1KWS-kHk_A&oe=6ADE0A2F"}, {"file_name": "screenshot1.png", "id": "759602579839087", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308164_759602583172420_2475078145938702107_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAQRCoOjvMcQ7kNvwE8OSXz&_nc_oc=AdqrYdNgHTrWD1k7KYtpnlFrXE90qliZzFOXz-7J6yFw1Ohebdw7z17Da59DMyY35pU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgxTfNgqRipypES97nLLgiFz2QijMH0_WrO5vpOXO75g&oe=6ADE2335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "new_poster2560x1440_no_text.png", "id": "1919557888817794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303760_1919557892151127_4609635479397740155_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2BeSZ-dypcQ7kNvwFR-Ff_&_nc_oc=Adq7i1zqB0sN2JECIqMwOqvvzWStlzoFB1vVeBUijENh-cQWD7VtO7ZXvR5A1FZEE2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_J_yYd-bL2EduXacFWloLJpOrD-yH9E7MDYcLFkUeiQ&oe=6ADE01C3"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Escape from X is in Early Access. We build it with our players, and your feedback shapes every update.\n\n\ud83d\udd17 Join our community: discord.gg/Je33jR5nh\n\u25b6\ufe0f YouTube: @BadjoEntertainment\n\nEscape from X \u2013 Skill Beats Gear\nEvery raid starts with a Glock. What you leave with is up to you. Escape from X is a skill-first VR extraction shooter built around real physical combat. You go from zero to hero on skill, not on a starting loadout.\n\nNEW IN THIS UPDATE\n\n\ud83e\udde0 Smarter NPC AI \u2013 Enemies take cover, flank, push and fall back. Trained on real playtest data.\n\n\ud83e\udded Holographic indicators \u2013 See every action you can take, right where you take it.\n{2308732093219951}\n\ud83c\udfaf Visual gun-handling tips \u2013 Reworked guides that teach new players fast.\n\n\ud83d\udd2b Gun upgrades \u2013 All the weapon improvements from Escape from X: Shooting Range.\n\nCORE FEATURES\n\n\ud83d\udca5 Real NPC body physics \u2013 Shove enemies, shoot their legs, and watch bodies react the way they should.\n{702870042245024}\n{1499559567859854}\n\ud83c\udf92 No floating menus \u2013 Everything is physical and in-hand, so you stay in the raid.\n{1344307120683939}\n\ud83d\udcf8 Polaroid story clues \u2013 Piece together the story.\n{1953303741909990}\n\ud83d\uddfa\ufe0f Replayable maps \u2013 Learn gear routes and plan smarter runs every time.\n{24646184375082887}\n{911466928590633}\n{854137890328340}\n\ud83c\udfc6 Leaderboards \u2013 Compete in Treasure Hunter, Kill and Hardcore.\n\nand more...\n{1616558729592946}\n{2847820818886321}\n\nON THE WAY\n\n\ud83d\udc00 Groundwork laid for new enemies: The Hunter and The Rat\n\n\ud83e\udd1d Co-op foundations are in, squad play is coming\n\n\ud83d\udc80 All About Shooting \u2013 Feel the chaos.\n\nWelcome to ESCAPE FROM X.\n\n", "short_description": "Escape from X is a skill-first VR extraction shooter where every raid starts with just a Glock. Go from zero to hero by looting, fighting and extracting alive. No floating menus, real NPC body physics: shove enemies, shoot their legs, and outplay them. Follow Polaroid story clues, hunt the Armory Key, and climb the leaderboards. Skill beats gear. Can you escape?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://badjoentertainment.com/efx/Privacy%20Policy.html", "developer_terms_of_service_url": "https://badjoentertainment.com/efx/TermsAndConditions.html", "publisher_name": "Badjo Entertainment", "support_website_url": "https://badjoentertainment.com/efx/support/SupportLandingPage.html", "website_url": "https://badjoentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28481664734848785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303746_2611055922584657_3460939442554364778_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO6agJIBfuUQ7kNvwFBAcQB&_nc_oc=Adp3Gi3Vx1MQB3ECtc_bpJ8RIO7Twka73LnGU5DzrupFK3zwnHKnXwJVkOP_FCPt8NM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNByVMbHtACrJhPhQwHqX7IoKkHzMmuwOsj93t_g-gWhw&oe=6ADDFD19"}, "is_concept": false, "is_test": false, "is_trial_offer_
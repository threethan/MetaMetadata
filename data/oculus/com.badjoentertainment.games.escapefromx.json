5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7JPDS80_mQQ7kNvwGuI9AC&_nc_oc=AdqmorxxYciuP_DxjRaGfngGp8he7Pi5U-rLOJgsnM5_yjpBFacmvLt8eBcVq3Bo3Qo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCr_51sONnLiyMWl06sM-JEwEOZAkF7CfaIRnxPmjwAw&oe=69C2787C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZsWUIOCLTQQ7kNvwEYOenu&_nc_oc=AdpfmGlsSkPncxakgF1etQFNbpMDorEk0mNLucXS8iwUIKibkM2zB6gcbXCVjwpdbxc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9JIld0KmvDDZoL5an01v0siAmdZGXmrXGp33fz9lwUQ&oe=69C27C85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqyJowNE1vgQ7kNvwHVMwOT&_nc_oc=AdqSeU6TrldRLIQtEHnayHDq0BD2EFkfs_MMhh3_Ex6rOhh-IH2p3pN_xQbXEOc7FT0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzySZYsSEEIptOURbRnh-bhVEgU8M3Jlwn5U6q5fmuKRw&oe=69C27654"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
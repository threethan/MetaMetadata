5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11mf9n-4LJ0Q7kNvwFF-bAV&_nc_oc=Adrx8oJ8xuhhnW0fxbh6zv-vofh63lU0Js-YGcMZBgmDoABgX94M0Nfv5vKKKSQrOLg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b3Op5ndnM4UxYPffEg0n95bjTQ7EeS8Dni_1UY5FLDQ&oe=6A15BF3C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Xp9x_Eg43sQ7kNvwFfGQ2I&_nc_oc=Adrt_nre-5KBXyL87X1uHkP-8zxnAErRiZskN5uKhiz1z24kB_JvDEpTMQZ36Xl4mcE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fpn9ah94yJJAK3KamfKLjlTP_5nR-qbw33ijhemQMgA&oe=6A15C345"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wsT-mRmf2cQ7kNvwErnEoF&_nc_oc=AdpET1415GMZw1Xcv2sC7ML6JigWibLCb051EgeVa_7hbJzaKvINFhsdOP74cpL-dcg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44YEvNSO9HIcx4kIqHimPKgup9vvh2noG1tn__QuzbsA&oe=6A15BD14"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
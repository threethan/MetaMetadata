5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W78A-CKncTsQ7kNvwESEd7X&_nc_oc=Adrp8w98pRzf0uGQhzv1Z_4nZY8KjQXYOA3tZ7wiv4puf2MP2ChyKHoJ8BYWGWclRSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mKTPZVlMqwPbJdw3UBJCOPJ5i4TIeIpw0lIgkEpOHaw&oe=69DB84FC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXh4qNTdf1MQ7kNvwH6FPJn&_nc_oc=Ado0msUdwn6Sh7zuMvMA8v9eJzvSvb5WIyZ6bKFpx9dmTsHq5rrA2sUXemaf4hkSUzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1znDjw9mVaKu4HN12uwBEFDqr2d8D_wCT0-LbM9ubkag&oe=69DB8905"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROnlu6wGlucQ7kNvwEi2UQO&_nc_oc=AdrBLWx8Q4rR1Uzh3No1jZR1Mxl4aH8HD8FNIkdsesyy9R9ioHAl2UCVMkxX6nxi7Yw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cD8BLIaNST3K2weGQtmho66bV0P6Wo88MKVdN9ZepUQ&oe=69DB82D4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
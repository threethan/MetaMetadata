5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FbntFSyzFgQ7kNvwGVAP8n&_nc_oc=Adp9CwmBuOuLLdsgCSX5hZISKzYI8vhymUHKt_cc3I48YS5fD-t-lAFf5H58SCS62_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06V7xzn0JXCkppVQ4bWqKZDKRC97j4zDCGy7HBpv8qvg&oe=69E8B3FC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7NVNEjdZWQQ7kNvwEKvRNf&_nc_oc=Adqd5HDZIW5jzxwZJPxp07n2ibBzqerYRPGaZ_FzoLSYCS2opcgH1iUElROVtNYfL3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H72NP6E4xuGHVG6QdDkcg9dL9YVlR2eEu90XWrsdsDQ&oe=69E8B805"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njTci2zw9UAQ7kNvwHFFTTW&_nc_oc=AdoEyH1bthb0F7FhPzbA-6fjIUB20ty5Ig6umy4UFqbANr_kfmJEpBnH_TMx4f4Q-zI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A9XC0l2FOzzQxvX66b2y_Lx9df8iEUTsCKKwZ0cvgDA&oe=69E8B1D4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jkn1d7LPRn8Q7kNvwEJK95C&_nc_oc=Ado7_bzwQzlU7wg8pB4uKqdSy1SEtAn7z-snESWnZo6PULENav0O0Ye7EXDwjrWn99o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ks_zMbJXxkzCObxsJOGhvv7N2LGWAy_caSpIztkAWDQ&oe=6A0B333C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQbbA6rI2EkQ7kNvwEkPRYw&_nc_oc=AdrsTEsugOkXFaqORasuemccd25ZdiNXjafjk4try9pP5bgMyCmjaVYButiMVwojUzI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DdgSOKGfs17seLoNc7cRDM7j6WSuM5kyMwjm_qtDANw&oe=6A0B3745"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE6mbL2p5DsQ7kNvwHaVyaL&_nc_oc=AdqhgB0paEt7V9kNJlVzzlGGoEbLZDAAXj2omRsG6i_PDSeBcHc4ToxhUm9EpDcOWrs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BNaKagXB_-mkftqmw7kk_tseftsCYkEIvvNVsfq1B6w&oe=6A0B3114"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
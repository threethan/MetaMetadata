5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpkS6JEo1hAQ7kNvwE-rj3b&_nc_oc=AdpG_To8ypazy5Ke7jDA71CB3oV1vWKtsxJIDt5OoLFP7Fgi2hvRM1CNCxE_7rC3tHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BN_l6Bd-sljTLLUxP7EvisZtUZ-RiunGbwdNvzwozjg&oe=6A19B3BC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rk4SxxLEm8Q7kNvwFFGGjc&_nc_oc=AdrE4kb2x1-ehiK_xnZBe8Gx5d40wWN6Fl7w8FlvpS6bx7TOuBp1KpFU9vXOzotYl7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Zr-zCrUM3B08Y7GHFcgAjRqqY7WzKPHdN5rhIG-xirQ&oe=6A19B7C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybtJy2yxB1YQ7kNvwGoQwih&_nc_oc=AdpSj66QgOzkFACHHdEX5NI3_U1SrEKIDyLp3cwT0-8WRX6ZvgwMSdKABkwHbb33XGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74yoqKD7Z_M8JDGvaafIV5NVEaCRdxSMzq8dNXHHrD7g&oe=6A19B194"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLx4MdF3_RIQ7kNvwGXdeIn&_nc_oc=AdqzCqtrjHPkGDpl8W2z1NJnNyOP8tt_FDoBkWixnr_IuRn6WFWk860Oz1wghbVREsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u0VgfG7lckHFW-xN1XyqWBIsjp0IEpJfJ3yoIxG_kXA&oe=69FCB2BC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLyM6Adwae4Q7kNvwEtRtYW&_nc_oc=AdohKnBXNxfLBUB3Td6KbzXlcqSf4ki3fNEehmoTiTJ0ska0kjGH-0w3xei8fKXUSL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-quNcXMrNn6jXrFahYK9ALEKzJM0uStkFHD5EELvy-w&oe=69FC7E85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2sQySAh4O0Q7kNvwEFNrAb&_nc_oc=Adp5Pa_k9q9B23cxP4jLH0W3utAYAQ9bg6YyD2c6gdnOeZjcI2Lj3EQRYFakvUqKNVI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qZOPWtJReWDQdqaen0ZzZbJGAcZehTbUcn9fcc-2ONQ&oe=69FCB094"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
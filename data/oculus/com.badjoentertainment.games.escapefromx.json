5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JX3mxSnkYkQ7kNvwEJ7MDV&_nc_oc=Adqng-Dhy22Pdh2s5vfHKtvqgB_v0ezffPiEsKpu2CHOKwIyI_zoIM4LTP4sKv-NhA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3levZOdYftY9lDhwsmL1SWiVLfJxmsO1KD_Fca7KG2gw&oe=69EDF9FC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyKxb2H257cQ7kNvwH_kU-Q&_nc_oc=AdozQumLoHhDfq-xIrlcO7DVyjVV9of4jROZT8lv9PydoP_9V5sy-7jOSSdeqYh41KA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hAilZi96X5N5kmdITrfOU49rlWEO0Rk4Z_3-SdDSWWw&oe=69EDFE05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28zMUyXkjT4Q7kNvwFtsR3O&_nc_oc=AdoRAWC8JroChYZT2d99J8jNtBbe_equM8EnmbYYCjlktX5K6-BSb_IKv7SPv51nBco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l1PydNBvqHFk9orWp5CUBXYqwtQsqIYgABzMVg-H0kQ&oe=69EDF7D4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
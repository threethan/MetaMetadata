5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q3-pFvpUKcQ7kNvwErZUWr&_nc_oc=AdoD5GtYxwheYoXV0ngdM5Opdmx-bWqN_hJiQj1pHtx-OsceMcVbdDFDPqOkxZlOYnY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1chmyLaosG--hZsiw7IznO_eAWmDo-ifwWTVEclujUKw&oe=69D7907C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ticiDxKanoQ7kNvwG0Zqbh&_nc_oc=Ado6xYDKeYq8rD_lTT6E0viLcnQ2DxD85DGPKHtbc5KVMXG3Kzl5mfD_iRnYoBslMFA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lyfb5EJZ9-plEMkJ3uKUC4DIuTSvzKQsGso7LM3q56Q&oe=69D79485"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFum4w7UYb8Q7kNvwGAFtdd&_nc_oc=AdoQeXfPUjQ4bzHbYL9PflAtgSq2uNB7XsnMTSWsnrckTIKc7AcR28S0DXl-kX1eOhk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VCeyYrxRNguzsGuq1pHs3yujYo5nUHJqmNO9cCCJTLg&oe=69D78E54"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
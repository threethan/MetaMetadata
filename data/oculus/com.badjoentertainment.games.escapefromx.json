5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zA4jw0ODE_sQ7kNvwFxJfrK&_nc_oc=Ado8eEXyc9I4q660td84tMKHZFOucpYWZKQq6dOt9MH2pteEYToSO7CxxVcv83IIGws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NT1xf9nAbYMNuJFZRuiRJR82spwj-xMSE5OpnKWwWHw&oe=69D39BFC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8i0VXmrAZsQ7kNvwFYhJn2&_nc_oc=Adot8w47kF_jTqOdxhFwHdmsBrP8jaZA7Jd9KIG_B7O3G7ca-mSwCJm36C_zN3PMVrY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VN9zfw1YhIg4ca5EkvtOn-w7WCsU9xAjlUhppkKwmug&oe=69D3A005"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6lA-azs9IgQ7kNvwHJ99Q5&_nc_oc=Adp2pROHumVpXpSzibctKEsrtQ8SOBsXgUk5keZWSoorT27TzD1Do1SPZ4Ny7PZ6eXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36OMe0P6k7hCP1ITMOZ3Z659VIejef4ac4MP124-giNw&oe=69D399D4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
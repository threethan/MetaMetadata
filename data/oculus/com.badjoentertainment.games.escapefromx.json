5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q3-pFvpUKcQ7kNvwERcOnr&_nc_oc=AdpSREpmHhc81sE8Zhy2kAQI7oGDs-ao3JlUfp4lN7EG16F82rxvQK_r7oe0d0W0c5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eyZs31vhTVfjsY_OoEOOGXY2KcWaPldg54sqWqqpdSg&oe=69D4ED7C"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8i0VXmrAZsQ7kNvwEjtF8L&_nc_oc=Adqzof9MiFzul8EXWQ4Aan5WE6rIb2dgLk9iDcOZRzJfkI8cK7zYH1Y-aNb6XYkQRJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LZP-h_-8nrUpyOZhmXbev57CXdjlkD-oSx6UCoHSwbw&oe=69D4F185"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFum4w7UYb8Q7kNvwGe3r5u&_nc_oc=Adrww7vs1PpS9aJk6ESmm2LFP2SuaQKPheLrLlTw5kATpK76XlAd894g8Gi7dVW4UMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tilrnS6epz8e8l16g1TV7A6Z6Tpig_ERC4GfYr6PX5A&oe=69D4EB54"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
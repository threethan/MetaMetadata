5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ_cJZ1QxiQQ7kNvwGWRpNJ&_nc_oc=AdofyjcRujE8IZnVEjG2yCw2XSKLjuM3BF2xLLFPl6ZqcQSayeL5_0vezLN8eRyXodk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aTOAWOBWSo9zy4nwVmad3kg9E7U8VmTI2XAHs5aNUnw&oe=6A219CBC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXLOMfM6R-AQ7kNvwFBTIe9&_nc_oc=Adqo51XAWOKCQh3aXgQwmsISvFYrxOxLjhQ1iAdNr1rsunGfsqqAAhgf_CNoyYvJ9lY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-aEuvX58nEznhoOvpGdo97ifG5QPTDUmIh2mIqK8vnA&oe=6A21A0C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNk62h0o5rsQ7kNvwHVQCw_&_nc_oc=Adr28JWCbFZENFXHQMhmWWwc6tdDepq9KfuXqr1bgYJby7QmeR8QHkvtAmzwyg9u2vs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W3PllXBuYbHYNBLbsWMI_iHLcetd3V4akDtlYmuDWNQ&oe=6A219A94"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
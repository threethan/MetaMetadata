5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLNe6bfmwvoQ7kNvwE-O_kY&_nc_oc=AdrCgEe7wVeFZaJSzyV5k6dQw0APe07GXtuCg7_b1KoFcb8qyG1Oa3K-emuOZ4PIUCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mcdOaI79vZxwRylFwXNOoLYGKcZUtYVeF-uZfVKuFtw&oe=69E36DFC"}, {"file_name": "1.png", "id": "1157688559207544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_1157688562540877_5487867679010919630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCVgI-3qSLcQ7kNvwGfV-L7&_nc_oc=AdpqkmD8V23ShKaGmTsZeFR7v3_BZlTdTIT68KatpGvtl1y0-9Tzbm789eATiMIXFuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v2dygVUA-hzIueUrZgxM4DsBSDdmvtnY8LCkYTcr25A&oe=69E37205"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1088296552750042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348041_1088296556083375_5090998954574073554_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsfEnSvVL1QQ7kNvwGdWON6&_nc_oc=AdpZFtSA9lzLzwcGEch40dzRohDu3J8il_zjFoEM1nls-D7tX0udqDJ54hwYHamag-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wX8GXs00RYaRpPe4cLsy5qPJ70-Zxs7yvMOZnSaGHZw&oe=69E36BD4"}, "display_name": "escape-from-x", "keywords": ["survival", "action", "military", "FPS"], "long_description": "Dive into Escape-from-X, where survival takes center stage in an immersive VR experience. Navigate a world where medicine, food, and hydration are crucial to your journey. From the early stages as a novice (\"Mladshi\") to becoming a top survival expert, every decision you make impacts your success. Your VR tablet acts as a real-world companion, helping you assist hideout NPCs and unravel the game's secrets. Inspired by the beloved Escape from Tarkov, Escape-from-X pushes the boundaries of VR UX with intuitive and groundbreaking features.", "short_description": "Experience immersive survival in Escape-from-X. Manage medicine, food, and hydration while making critical decisions as 
20f&oh=00_Af-_J8_yB0IPJiKcJ0JUaXVLA6VSLx3N_GIUYT4MgpDuZw&oe=6A230122"}, {"file_name": "messenger-oculus-product-feature-3-inbox.png", "id": "7246600215366475", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984463_7246600218699808_5913021926783382485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3A1HobtYhkQ7kNvwHzSJFv&_nc_oc=AdrRw_2OJtqjihyUqf-6kVyNwF98UzIcMZuBsaGo1FZmnylufE6AnLDoY3zrRq5q7HY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tbSRc8zO_4cRp08V_9EWG8LCww29zU9ohS96POjoXAg&oe=6A22D5BB"}, {"file_name": "messenger-oculus-product-feature-4-settings.png", "id": "181455434386308", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75307245_181455437719641_3053579914411370935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWhTBeUJU3sQ7kNvwH0Cz6D&_nc_oc=AdpyNpy15qSX2eO7ltrjBdqxeH-wO6o98VdM_8Ic9M1VKPwzJmwzxlPo34JxgmCh3G4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FwEZw30airzYrtKZ5V3sAdjrghcU0JKUW9no-VmAH8A&oe=6A22DB37"}, {"file_name": "messenger-oculus-cover-landscape (1).png", "id": "1268403550740761", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569426_1268403554074094_1615870571381500959_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCcGah6VytAQ7kNvwF6Sdfr&_nc_oc=Ado4Ghc5ca2XQUCmG1wRmOmN49CDXGGU3rzpoui9h7sP0lzaCneoMQdcNxcFz5pJlFs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_msmmP21YHJrOSx6I8AWK5dUrt4O1-SuDRVVjgQEE7tw&oe=6A22CF7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Messenger", "keywords": [], "long_description": "Group voice calls, text messaging, and more!\n\nBe together whenever, with our free* all-in-one communication app, complete with unlimited text and voice calling features.\n\nPRIVACY SETTINGS\nNew privacy settings let you choose who can reach you, and where your messages are delivered.\nCUSTOM REACTIONS\nLost for words? You can customize your reactions, with lots more emojis to choose from.\nCHAT THEMES\nChoose from fun themes and colors, like Tie-Dye or Love, to make your chats more personal.\nFREE* CALLS TO STAY CONNECTED\nKeep your friends and family close.Host group audio calls with up to 8 people,\nTURN OFF THE LIGHTS IN DARK MODE\nGive your eyes some rest with a sleek new look that darkens the colors of the chat interface.\nRECORD AND SEND VOICE MESSAGES\nWhen text just won't cut it, just hit record and send. Say, sing, show, or shout it out loud.\nEXPRESS YOURSELF WITH STICKERS, GIFS, AND EMOJIS\nUse custom stickers to show your creative side. \nSEND FILES, PHOTOS, AND VIDEOS\nThere\u2019s no limit to the number of files you want to share with your friends.\nPLAN AND MAKE IT HAPPEN\nMake plans to get together with polls and more. Suggest a meeting spot or tell friends where you are by sharing your location with just a few taps.\nCHAT WITH BUSINESSES\nEasily connect with your favorite businesses to make reservations, get customer support, find deals and more.\nCOMPATIBLE ACROSS PLATFORMS\nChat with friends across an array of devices, like desktop and mobile.", "short_description": "Make it easy to be together, whenever. Now Messenger is available in the Metaverse! Have all your favorite Messenger features at your fingertips like sending a message, sharing the perfect a sticker, or connecting over a call. Be in touch with the people you care about most."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/about/privacy/", "developer_terms_of_service_url": "https://www.facebook.com/terms.php", "publisher_name": "Meta Platforms, Inc.", "support_website_url": null, "website_url": "https://www.messenger.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "SOCIAL"], "has_in_app_ads": null, "inter
ults": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1240165802524289"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": null, "created_date": 1788467362, "id": "1219700764570793", "version": "7.1.4", "version_code": 102610044, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1240165802524289"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": "# \ufffd Crystal Chatbox 7.1.2 is out\r\n\r\nThe biggest update yet, and everything is free now. No tiers, no locks.\r\n\r\n## \ufffd A whole new Theme tab\r\n- 17 built-in themes: Midnight Glass, Sakura, Synthwave, Nebula, Aurora, Vaporwave and more\r\n- Frosted glass panels you can see through, over any image, GIF, or slowly drifting gradient\r\n- Moving backgrounds drawn live: sakura petals, snow, embers, bubbles, a starfield, or meteors\r\n- Save your own look as a custom theme and switch whenever you want\r\n\r\n## \ufffd Also new\r\n- Quick Access shortcuts on your Home screen, pin the actions you use most\r\n- Sync: pair a friend to a preset and Crystal switches to it when they join your instance\r\n- Who's Here: a chatbox line showing other Crystal users around you\r\n- Bulk unfriend with smart select, and your favorites are always protected\r\n- Heart rate styles, an emoji picker, and drag to reorder your chatbox lines\r\n- New message tokens including {friends} and {avatar}\r\n- A cleaner look everywhere, in all 10 languages\r\n\r\n## \ufffd How to get it\r\n- Windows: just open the app, it updates itself\r\n- Quest: grab the new APK from the downloads channel or update on meta!", "created_date": 1788308869, "id": "1216883074852562", "version": "7.1.2", "version_code": 102610042, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1240165802524289"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": null, "created_date": 1788299788, "id": "1216747481532788", "version": "7.1.1", "version_code": 102610041, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
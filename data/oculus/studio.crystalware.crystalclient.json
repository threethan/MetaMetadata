fTQg", "website_url": "https://crystalwarestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1147160221824848"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1346975920905587"}]}, "baseline_offer": {"id": "1346975920905587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784671020, "status": "PUBLISHED", "id": "1346975920905587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1198745863332950", "version": "7.0.2"}, "id": "1389071829747929", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1198745863332950"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": "Fixed turn off issue", "created_date": 1787270474, "id": "1198745863332950", "version": "7.0.2", "version_code": 102610037, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1198745863332950"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": "v7.0.1\r\n\r\nNew\r\n\r\nClone avatars! Open anyone \u2014 a friend, someone you searched, anyone in your lobby \u2014 and hit \"Clone their avatar\". If it's public, you're wearing it\r\nSee who else runs Crystal. People in your instance using Crystal Chatbox get a \ufffd next to their name in the roster\r\nCrystalWare can now send you a heads-up. If something big happens (like a server restart) a small banner shows up in the app. Hit \"Got it\" and it's gone forever\r\n Fixes\r\n\r\nFixed avatar search doing nothing when set to your own avatars, and dead avatar indexes now say so instead of quietly shrinking your results\r\nFixed the headset notification card freezing after a couple of notifications stacked\r\nFixed Japanese, Korean, Chinese and emoji names showing as boxes on the headset card\r\nCleaned up the whole Add-ons page again: less text, credential fields only show for the source you picked, no more leftover Save buttons, and the little line stuck to every add-on name is gone\r\nFixed voice-to-chatbox slowly eating memory if you left toggle mode on\r\nFixed the app rewriting your met-players file every 15 seconds\r\nFixed translations quietly stopping after a long session", "created_date": 1787255380, "id": "1198477823359754", "version": "7.0.1", "version_code": 102610036, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1198745863332950"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": "The biggest update yet. Flying, notifications, text to speech, a soundboard, and a full redo of the Add-ons page.\r\n\r\nNew\r\nYou can fly now. Hold a hand gesture and your avatar takes off, let go to drop. Works with a hotkey too. Needs GoGo Loco on your avatar. It's under Add-ons > Player Movement\r\nNew {posture} chatbox part. Shows if you're standing, sitting, crouching or laying down. Turn it on in Message Parts\r\nNotifications! A little card pops up when someone joins your instance, on your desktop and inside your headset just like SteamVR's own popups. Move it, resize it, recolor it, make it yours\r\nText to speech (PC only). Crystal reads your messages and alerts out loud through any output device you pick. Run it through a virtual mic and your friends can hear it too\r\nSoundboard. Keep short clips in Crystal and play them with one tap\r\nRedid the whole Add-ons page. Every add-on is a card that tells you what it does, and there's a search bar on top. Type \"fly\" or \"heart\" and it takes you straight there\r\nStyle the desktop overlay however you like. Text color, font, bold, a panel behind the text, and a wrap width so long lines don't run across your screen\r\nEverything saves by itself now. No save buttons, no lost settings\r\nThe dashboard is way cleaner. Panels are grouped, the home screen starts with what you actually use, and the walls of text are gone\r\nRebuilt the SteamVR overlay. Bigger, readable, and text stays inside its panels\r\n10 languages, and this time it's actually all of it. Popups, confirm boxes, little toast messages, everything\r\nQuest got real attention. The app only shows what your headset can actually do, and it finally reports the right version\r\nWorld and met history. See where you've been and who you've met, even when VRChat's log is off\r\nIf a page needs VRChat logging and it's off, Crystal tells you and helps you turn it on instead of showing you nothing\r\nFixes\r\nFixed Crystal being able to stutter your whole PC while SteamVR was busy. It was poking SteamVR 125 times a second even with nothing on screen\r\nFixed the headset notification card showing up as a blank black bar\r\nFixed stacked notifications drawing their text outside the card\r\nFixed turning fly off leaving your avatar stuck in the stand-up emote. It's a quick tap now\r\nFixed {posture} deciding you stood up after you sat still for a few seconds\r\nSpace Drag can now ask for a short hold or both hands before it grabs, so you stop yanking the world around by accident. Off by default\r\nFixed romaji lyrics doing nothing on Quest\r\nFixed renaming presets and library sections doing nothing on Quest\r\nFixed the text to speech speed slider ignoring everything below normal speed\r\nFixed the desktop overlay backdrop and bold toggles not saving\r\nFixed text spilling out of buttons and labels in some languages and window sizes\r\nFixed the Space Drag buttons in the SteamVR overlay doing nothing at all\r\nFixed hotkeys getting thrown away on save, and one staying live after hotkeys were switched off\r\nFixed the met list counting you as someone you met, and the same person showing up twice\r\nFixed the overlay giving up when your headset wasn't awake yet. It waits and retries now\r\nFixed missing Japanese, Korean and Chinese letters and emoji in the overlay\r\nFixed \"What's new\" never showing up when running from source\r\nFixed dashboard search results that went nowhere", "created_date": 1787155597, "id": "1195973306943539", "version": "7.0.0", "version_code": 102610035, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1198745863332950"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": null, "created_date": 1786850678, "id": "1188213084386228", "version": "6.1.0", "version_code": 102610034, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1198745863332950"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": null, "created_date": 1786848456, "id": "1188178297723040", "version": "6.1.0", "version_code": 102610033, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
/v/t64.5771-25/499307352_3640290306110454_2255795663401996684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQp0aV0T8zwQ7kNvwGqRogK&_nc_oc=Ado0-jWQIIfR0pSwVT5LS4nDeg-lvGtj-O--MDFR20itpgo8qsULG4-lJKcZqV73d4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo4QCGcdovgd-Z8nDzpX9rCzYcc5UvPUalDP0t53fHfg&oe=6A897D7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crystal Chatbox", "keywords": ["Chatbox", "Client", "OSC", "VR"], "long_description": "Crystal Chatbox is a customizable VRChat companion built for Meta Quest. Create rotating OSC chatbox messages and personalize their timing, order, appearance, and included information.\n\nDisplay Spotify now playing, song progress, time, weather, supported heart-rate data, AFK status, and your Quest battery level. Save custom profiles, preview messages before sending them, toggle individual integrations, and access the included avatar search providers.\n\nCrystal Chatbox communicates through VRChat\u2019s supported OSC system. Enable OSC in VRChat, connect any optional integrations you want to use, and make your chatbox your own.\nCrystal Chatbox is an independent application and is not affiliated with or endorsed by VRChat Inc. or Meta.\n\nIf you have any bugs, issues, or questions feel free to join the discord server and create a support ticket!", "short_description": "Customize your VRChat OSC chatbox with music, heart rate, battery, and more.\n\nIf you have any bugs, issues, or questions feel free to join the discord server and create a support ticket!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalwarestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CrystalWare Studios", "support_website_url": "https://discord.gg/SNfBtyfTQg", "website_url": "https://crystalwarestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cate
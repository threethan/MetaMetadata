c=AdrlbHwF2LoOZQMmosppeHagizn7LHKCb8CtHcjmckV90CWKgRNwAxTsyPrUvOfPsSU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7IfAvSpDBa7-kLvb0T46eUPOEn18XMq8e69T0mBIlNw&oe=6A71E5A7"}, {"file_name": "CC5.png", "id": "1051966754453058", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308050_1051966757786391_1769424589746652259_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeHPMAV8b3IQ7kNvwEwPXC9&_nc_oc=AdqfbnoerCf9uyAADXDBsNYI36mkZQZRwQ2__qAj3KNHMNUagz7v2W1zdYMUcaI-CO8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh2H1aHueCaZjF-MW5LB9ssrgJOqVyZMHDpm4eLfkdlA&oe=6A71F6E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crystal Chatbox", "keywords": ["Vrchat", "Chatbox", "Client", "VRC", "OSC"], "long_description": "Crystal Chatbox is a customizable VRChat companion built for Meta Quest. Create rotating OSC chatbox messages and personalize their timing, order, appearance, and included information.\n\nDisplay Spotify now playing, song progress, time, weather, supported heart-rate data, AFK status, and your Quest battery level. Save custom profiles, preview messages before sending them, toggle individual integrations, and access the included avatar search providers.\n\nCrystal Chatbox communicates through VRChat\u2019s supported OSC system. Enable OSC in VRChat, connect any optional integrations you want to use, and make your chatbox your own.\nCrystal Chatbox is an independent application and is not affiliated with or endorsed by VRChat Inc. or Meta.\n\nIf you have any bugs, issues, or questions feel free to join the discord server and create a support ticket!", "short_description": "Customize your VRChat OSC chatbox with music, heart rate, battery, and more.\n\nIf you have any bugs, issues, or questions feel free to join the discord server and create a support ticket!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalwarestudios.com/privacy", "developer_terms_of_se
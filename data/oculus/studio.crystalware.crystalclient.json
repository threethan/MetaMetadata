=00_AQQv8rkZ8woa9cxcZVXh9XcbSbJMwyU1U9WfQqTxQ4NyAA&oe=6B0C6120"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crystal Chatbox", "keywords": ["Chatbox", "Client", "OSC", "VR"], "long_description": "Crystal Chatbox is a customizable VRChat companion built for Meta Quest. Create rotating OSC chatbox messages and personalize their timing, order, appearance, and included information.\n\nDisplay Spotify now playing, song progress, time, weather, supported heart-rate data, AFK status, and your Quest battery level. Save custom profiles, preview messages before sending them, toggle individual integrations, and access the included avatar search providers.\n\nCrystal Chatbox communicates through VRChat\u2019s supported OSC system. Enable OSC in VRChat, connect any optional integrations you want to use, and make your chatbox your own.\nCrystal Chatbox is an independent application and is not affiliated with or endorsed by VRChat Inc. or Meta.\n\nIf you have any bugs, issues, or questions feel free to join the discord server and create a support ticket!", "short_description": "Customize your VRChat OSC chatbox with music, heart rate, battery, and more.\n\nIf you have any bugs, issues, or questions feel free to join the discord server and create a support ticket!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalwarestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CrystalWare Studios", "support_website_url": "https://discord.gg/SNfBtyfTQg", "website_url": "https://crystalwarestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
.com/v/t64.5771-25/499310646_2072665416954794_1086750742076377222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfL-wJPeeA0Q7kNvwHykmbF&_nc_oc=Adq8nn1HV6yz5ZVz-rYRiebx4YTYgJ_bLnahIgkOFK_22Qhroi2sH89GFSrx5JTNJZk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHfyWgwNaYah21Zc08wYAXFFeRp_bDvfTnOecFlfkteQ&oe=6AA3F797"}, {"file_name": "CC4.png", "id": "1532314208691500", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499311582_1532314212024833_3245070299100948303_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IIzsi66veQQ7kNvwHYaDFA&_nc_oc=AdpKumetDMtvsln6_EvTSK1S2HirPthWZDySD_BlXFyE71V6Y6EfmaMrTlNTPust2O8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLywROeKPS2PVhAu-UQoSVmzQYoKGKl1Jk-QYOhe_ZaAA&oe=6AA3FEA7"}, {"file_name": "CC5.png", "id": "1051966754453058", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308050_1051966757786391_1769424589746652259_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqfN77irpH4Q7kNvwFnR4e1&_nc_oc=AdrddWdcuvaf5gw7UV53k34O56njxherc7mIOJoADVD5QmiFeXYvoV1NGsZgI0RCtRg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVwd61DXwQU5VQx3ToYZ_hK__wi_rgA7o_vKUqlIF1dw&oe=6AA40FE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crystal Client", "keywords": ["Vrchat", "Chatbox", "Client", "VRC", "OSC"], "long_description": "Crystal Client is a customizable VRChat companion built for Meta Quest. Create rotating OSC chatbox messages and personalize their timing, order, appearance, and included information.\n\nDisplay Spotify now playing, song progress, time, weather, supported heart-rate data, AFK status, and your Quest battery level. Save custom profiles, preview messages before sending them, toggle individual integrations, and access the included avatar search providers.\n\nCrystal Client communicates through VRChat\u2019s supported OSC system. Enable OSC in VRChat, connect any optional integrations you want to use, and make your chatbox your own.\nCrystal Client is an independent application and is not affiliated with or endorsed by VRChat Inc. or Meta.\n\nIf you have any bugs, issues, or questions feel free to join the discord server and create a support ticket!", "short_description": "Customize your VRChat OSC chatbox with music, heart rate, battery, and more.\n\nIf you have any bugs, issues, or questions feel free to join the discord server and create a support ticket!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalwarestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CrystalWare Studios", "support_website_url": "https://discord.gg/SNfBtyfTQg", "website_url": "https://crystalwarestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1147160221824848"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1346975920905587"}]}, "baseline_offer": {"id": "1346975920905587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784671020, "status": "PUBLISHED", "id": "1346975920905587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1219747414566128", "version": "7.1.5"}, "id": "1389071829747929", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219747414566128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": null, "created_date": 1788469953, "id": "1219747414566128", "version": "7.1.5", "version_code": 102610045, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219747414566128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": null, "created_date": 1788467362, "id": "1219700764570793", "version": "7.1.4", "version_code": 102610044, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219747414566128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": "# \ufffd Crystal Chatbox 7.1.2 is out\r\n\r\nThe biggest update yet, and everything is free now. No tiers, no locks.\r\n\r\n## \ufffd A whole new Theme tab\r\n- 17 built-in themes: Midnight Glass, Sakura, Synthwave, Nebula, Aurora, Vaporwave and more\r\n- Frosted glass panels you can see through, over any image, GIF, or slowly drifting gradient\r\n- Moving backgrounds drawn live: sakura petals, snow, embers, bubbles, a starfield, or meteors\r\n- Save your own look as a custom theme and switch whenever you want\r\n\r\n## \ufffd Also new\r\n- Quick Access shortcuts on your Home screen, pin the actions you use most\r\n- Sync: pair a friend to a preset and Crystal switches to it when they join your instance\r\n- Who's Here: a chatbox line showing other Crystal users around you\r\n- Bulk unfriend with smart select, and your favorites are always protected\r\n- Heart rate styles, an emoji picker, and drag to reorder your chatbox lines\r\n- New message tokens including {friends} and {avatar}\r\n- A cleaner look everywhere, in all 10 languages\r\n\r\n## \ufffd How to get it\r\n- Windows: just open the app, it updates itself\r\n- Quest: grab the new APK from the downloads channel or update on meta!", "created_date": 1788308869, "id": "1216883074852562", "version": "7.1.2", "version_code": 102610042, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219747414566128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": null, "created_date": 1788299788, "id": "1216747481532788", "version": "7.1.1", "version_code": 102610041, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147160211824849", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219747414566128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1389071829747929"}]}, "change_log": "# \ufffd Crystal Chatbox 7.1.0 is out - and everything is FREE now\r\n\r\nThe biggest update we've ever shipped. Every perk that used to be supporter-only is now free for everyone: accent colors, custom themes, background images, and your colored name + banner on the leaderboards. Find it all in the new **Customization** tab.\r\n\r\n**\ufffd A whole new look**\r\nThe entire app got a cleaner, calmer redesign in both dark and light themes.\r\n\r\n**\ufffd New stuff**\r\n- **Sync** - pair a friend's name to a preset and Crystal switches looks when they join you, and back when they leave\r\n- **Preset share codes** - share your whole chatbox look as a code your friends can import with one click\r\n- **Who's Here** - a chatbox line showing other Crystal users in your instance (privacy-safe, hash only)\r\n- **Bulk unfriend** - clean your friends list with smart-select, favorites always protected\r\n- **Emoji picker**, drag-and-drop line reordering, per-line test send, and collapsible message part groups\r\n- **Heart rate styles** - \"82 BPM\", just \"82\", or Resting / Active / High zones\r\n- **New Quest lines** - refresh rate, on/off head, Wi-Fi signal, heat warning, headset uptime, battery temp\r\n- **Weekday preset scheduling** + live preset previews\r\n- New tokens: {bpm} {battery} {here} {media} {wifi} {count} {name} and {moon} \ufffd\r\n\r\n**\ufffd Fixes that matter**\r\n- Frames no longer cut your text off early - every style now uses the full 144 characters\r\n- The app stops burning GPU and battery while you're in VRChat\r\n- If the connection drops you get a small \"Reconnecting\" pill instead of a frozen page\r\n- All of it in all 10 languages\r\n\r\n**How to update:** Windows updates itself from Settings, or grab the new exe from the site. Quest users - the Meta Store update is on its way.\r\n\r\nAnd one more thing... our new game **Galactic Domain** is coming soon \ufffd retro space combat with Wave and Survival modes \u2192 https://galacticdomain.gg", "created_date": 1788293186, "id": "1216631888211014", "version": "7.1.0", "version_code": 102610040, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
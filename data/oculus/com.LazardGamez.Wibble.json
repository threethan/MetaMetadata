ardust, unlock cosmetics, and see who reaches the summit first."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wibblevr/home", "developer_terms_of_service_url": null, "publisher_name": "Lazard Gamez", "support_website_url": null, "website_url": "https://sites.google.com/view/wibblevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1363786193490981"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1044081485341050"}]}, "baseline_offer": {"id": "1044081485341050"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793027340, "status": "PUBLISHED", "id": "1044081485341050"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1368730782996522", "version": "0.2.1"}, "id": "970428392786679", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1363786186824315", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368730782996522"}, "release_status": "RELEASED"}, "binary_release_channels
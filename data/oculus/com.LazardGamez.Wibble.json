_00_00_20.Still007.png", "id": "1461366472510598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/747795579_1461366475843931_7256785643576879701_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1R2AxBWQhHEQ7kNvwElEryi&_nc_oc=Adp9P4dVaUpQHOyb9K-iKUm_7AkEWNV476bCwsCAzob3x7B5VLMA9RT-Bu1RTivwx5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFg86f607Z-ufkOwowF3IBlVIIa3hadwnK2DVLMUc_6Q&oe=6B06FE4E"}, {"file_name": "Screenshot 2026-10-17 223857.00_00_00_00.Still009.png", "id": "1638647317675956", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/842055220_1638647321009289_6793937026613782823_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-xtefS2h_EQ7kNvwEtz5-J&_nc_oc=Adqf2kIZLSvMvjjqFk1mUtCHWyNQIRB4N6ec5s6gR-5qwUzR7ID6zZ2IydGDkzSvB9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_5EOxPnK93jpfRwk1YTireZIjpO4yfgyvX2Cl_3wDPA&oe=6B0701FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wibble", "keywords": [], "long_description": "Run, Jump, Climb, and Swing.\n\nIn Wibble you and your friends climb the largest tower in the cosmic sea. With physics-based interaction you are bound to have an immersive experience.\n\nA multiplayer fun adventure, Wibble allows up to 2 hours of gameplay with a physics-based experience, leading to funny moments, and great interaction.", "short_description": "Grab the wall. Look up. Start climbing.\n\nClimb a giant, wobbly tower that rises out of a candy-colored sea and up into space. Use your arms to pull, swing and fling yourself past nine wild zones with your friends. Collect stardust, unlock cosmetics, and see who reaches the summit first."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wibblevr/home", "developer_terms_of_service_url": null, "publisher_name": "Lazard Gamez", "support_website_url": null, "website_url": "https://sites.google.com/view/wibblev
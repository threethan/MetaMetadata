_00_00_20.Still007.png", "id": "1461366472510598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/747795579_1461366475843931_7256785643576879701_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifHTMXOZBgAQ7kNvwEMUc30&_nc_oc=AdrfBRwPrOsg26ELR9NaoU18MwfdJ29mA5aMKHmGvZ-G-n7YtIhsDvunvMU0AlOSN2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNxpDEVSDcvao1p99YMRWZUCHzeNAWYywNlPr9txk_Tg&oe=6AFDC3CE"}, {"file_name": "Screenshot 2026-10-17 223857.00_00_00_00.Still009.png", "id": "1638647317675956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/842055220_1638647321009289_6793937026613782823_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqvcY4Naf8gQ7kNvwGhuKaM&_nc_oc=AdphD0HsLKPOCpiZdKllX0S-PbFQhs9NNFVm3-BlsuCRYr1BN_fcWA_vQvit13qKw7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThDDZbO0s5Xija_xMk7ygc5pLuWn48zdhQBWS-Vk2Qmw&oe=6AFDC77D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wibble", "keywords": [], "long_description": "Run, Jump, Climb, and Swing.\n\nIn Wibble you and your friends climb the largest tower in the cosmic sea. With physics-based interaction you are bound to have an immersive experience.\n\nA multiplayer fun adventure, Wibble allows up to 2 hours of gameplay with a physics-based experience, leading to funny moments, and great interaction.", "short_description": "Grab the wall. Look up. Start climbing.\n\nClimb a giant, wobbly tower that rises out of a candy-colored sea and up into space. Use your arms to pull, swing and fling yourself past nine wild zones with your friends. Collect stardust, unlock cosmetics, and see who reaches the summit first."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wibblevr/home", "developer_terms_of_service_url": null, "publisher_name": "Lazard Gamez", "support_website_url": null, "website_url": "https://sites.google.com/view/wibblev
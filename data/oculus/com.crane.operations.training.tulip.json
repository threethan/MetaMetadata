fHqC4-MDd8dWSHu5LYrGQ&oe=6A5790AF"}, {"file_name": "9.png", "id": "1412196619963151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822854_1412196623296484_3318068292327127053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_wgtiC-IboQ7kNvwHn3KPa&_nc_oc=AdrqKvPpjrO5tEpk3l5bIaWViO1YoSNIiR7vF_o9JiZTGh2fHXGrb02rw52goXmFoDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_qPKZDLCOx1u_x7z5dN0psHLac_TV0jW__DUgeZCxSA&oe=6A577884"}, {"file_name": "fork-lift-ui-main-menu (1).png", "id": "1842236056554467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820914_1842236063221133_6101325377203981774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2gJeyckHRIQ7kNvwH0ALCp&_nc_oc=Adr4vVYROlcirdIR39H0ID5YaijavE7xmqA8Ec2e4QP-36sWLmOL9VKRNAJ3GVJBmqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi2Nm_1aPkYK128_rlRceQ07anx94pDEpxRJw2OrwhPg&oe=6A576958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crane Ops - All in 1 Crane Simulator", "keywords": ["Cranes", "Training", "CraneSimulator", "SimulationGames", "Safety"], "long_description": "Experience the power of heavy machinery like never before.\n\nCrane Ops is an advanced VR Simulation Game that puts you in full control of a wide range of Industrial Cranes and Construction Machines from towering high-rise rigs to cmpact mobile units and forklifts.\nWhether you're a professional Operator, a Trainee, or simply fascinated by the mechanics of lifting and logistics, Crane Ops delivers a fully immersive, hands-on experience that combines real-world physics with rich, interactive environments.\n\nFeatures:\nOperate multiple crane types: Tower, Fork Lifter, Telescopic and more.\nRealistic Environments: Construction Sites, Ports, Warehouses, and Training Yards.\nAuthentic controls and real-life physics simulation.\nProgressive challenges and certification-style missions.\nBuilt for Gamers, Trainers, and Industry Professionals.\nStep into 
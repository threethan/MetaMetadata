NtpsF0FZKHVV-2kQDzFIw&oe=6A93FD6F"}, {"file_name": "9.png", "id": "1412196619963151", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491822854_1412196623296484_3318068292327127053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iceW6e4O05UQ7kNvwHm4i5k&_nc_oc=AdozqK1jAaXczRDQLpYJr1EEpCUXboArh954xrQsscCyt9PyDMjlF-55rSwAlxgWmHE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyRoIEYMggX3EIFh8xU8oGrrLL-uUwvwjb_7oXPHOBMA&oe=6A941D84"}, {"file_name": "fork-lift-ui-main-menu (1).png", "id": "1842236056554467", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820914_1842236063221133_6101325377203981774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHGz2G0b3DgQ7kNvwG8nNGI&_nc_oc=AdrcB88A9QY_btln9yN5QVk-weBHTdoaCV4C5BhHwDG3-smCAgXrWp-cxXVOPHaPXdY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBm-_4dVTF48eKxTs1-H1c74U4m2D2rUas-qxjq_dlEw&oe=6A940E58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crane Ops - All in 1 Crane Simulator", "keywords": ["Cranes", "Training", "CraneSimulator", "SimulationGames", "Safety"], "long_description": "Experience the power of heavy machinery like never before.\n\nCrane Ops is an advanced VR Simulation Game that puts you in full control of a wide range of Industrial Cranes and Construction Machines from towering high-rise rigs to cmpact mobile units and forklifts.\nWhether you're a professional Operator, a Trainee, or simply fascinated by the mechanics of lifting and logistics, Crane Ops delivers a fully immersive, hands-on experience that combines real-world physics with rich, interactive environments.\n\nFeatures:\nOperate multiple crane types: Tower, Fork Lifter, Telescopic and more.\nRealistic Environments: Construction Sites, Ports, Warehouses, and Training Yards.\nAuthentic controls and real-life physics simulation.\nProgressive challenges and certification-style missions.\nBuilt for Gamers, Trainers, and Industry Professionals.\nStep into 
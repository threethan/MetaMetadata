png", "id": "600558349737013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821615_600558353070346_4865183958323890245_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBpi-KnlYBkQ7kNvwEyL8aL&_nc_oc=AdnI4dBJuLz3TQlo945TNye3SCNJluL93jWmhcHO96_1W2Mg0mYUNNpOm4v_F0p_610&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftffN-0pA3GVTRHLwh6CJMQIpEvVXg-ybsFAAN2I5cByg&oe=69A0502F"}, {"file_name": "9.png", "id": "1412196619963151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822854_1412196623296484_3318068292327127053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xl9vLikP1oQ7kNvwEEWHu6&_nc_oc=AdlQ53HlTbsj5fh2afINk5sFQ0az29_4eiARUxn34g22zti5cyOC5okH0C58Hy9T2rQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuFXkHMZsibk7XsULhQo5pXk2NMOb7tn691fBTu6O-aCw&oe=69A03804"}, {"file_name": "fork-lift-ui-main-menu (1).png", "id": "1842236056554467", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820914_1842236063221133_6101325377203981774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLFK2aQy-noQ7kNvwGBkIoA&_nc_oc=AdlwDAbkvI9wlOplT7fbpntkaRzZfBy8MpZQ7tOCDeJ7meUtPZeTjw6aOPb88pF-Pe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvci21Zd3rTKXSK5pXbbBWno1ShOO1q1OcnlexWA8Q-3Q&oe=69A028D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crane Ops - All in 1 Crane Simulator", "keywords": ["Cranes", "Training", "CraneSimulator", "SimulationGames", "Safety"], "long_description": "Experience the power of heavy machinery like never before.\n\nCrane Ops is an advanced VR Simulation Game that puts you in full control of a wide range of Industrial Cranes and Construction Machines from towering high-rise rigs to cmpact mobile units and forklifts.\nWhether you're a professional Operator, a Trainee, or simply fascinated by the mechanics of lifting and logistics, Crane Ops delivers a fully immersive, hands-on experience that combines real-world physics with rich, interactive environments.\n\nFeatures:\nOperate multiple crane types: Tower, Fork Lifter, Telescopic and more.\nRealistic Environments: Construction Sites, Ports, Warehouses, and Training Yards.\nAuthentic controls and real-life physics simulation.\nProgressive challenges and certification-style missions.\nBuilt for Gamers, Trainers, and Industry Professionals.\nStep into the Cab. Take the Controls. Master the Machinery.\nMultiplayer co-op modes for team-based logistics and crane coordination. (Coming Soon).", "short_description": "Crane Ops is the ultimate all-in-one VR Simulator for Crane and Heavy Machinery operations. Master tower cranes, mobile rigs, forklifts, and more all in hyper-realistic environments built for both Training and Immersive Gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24195316800085941"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824294_1057304685954462_9201832563834701872_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6BrRM79B7MQ7kNvwFQAPzT&_nc_oc=AdlKvdAmUiW2Cij4L8oBuShxoFhVJNTlB6TsdEqFuFNPz1P1CilS8eyNaB
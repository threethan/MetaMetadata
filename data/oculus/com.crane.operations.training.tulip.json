p_0YUj4JwZu4X3hE1K3AA&oe=6AAFE52F"}, {"file_name": "9.png", "id": "1412196619963151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822854_1412196623296484_3318068292327127053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuAaqMK93CYQ7kNvwFW2vF_&_nc_oc=AdqEv9EWYqrXsf3Qi85ywS440LFkFJ16FAwAxcP2XfiDvqZpJcYcd5z1PnuMVQIaBS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9avSFEZzwZ598IHDzX_3Fk_mrUNphsjaURysZimKNBA&oe=6AB00544"}, {"file_name": "fork-lift-ui-main-menu (1).png", "id": "1842236056554467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820914_1842236063221133_6101325377203981774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5a5RUaXHKkQ7kNvwHZpKxK&_nc_oc=AdqSMICoWI5ZgAepV-ZayDcuQ3LoSLFnvsJPAemcyX_zi4jOMUt1mHGEhNA_vvbOTl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpfu1aQ3lLX4nuP_91Dbk5rC80ry_l81YnKOPG14mN9w&oe=6AAFF618"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crane Ops - All in 1 Crane Simulator", "keywords": ["Cranes", "Training", "CraneSimulator", "SimulationGames", "Safety"], "long_description": "Experience the power of heavy machinery like never before.\n\nCrane Ops is an advanced VR Simulation Game that puts you in full control of a wide range of Industrial Cranes and Construction Machines from towering high-rise rigs to cmpact mobile units and forklifts.\nWhether you're a professional Operator, a Trainee, or simply fascinated by the mechanics of lifting and logistics, Crane Ops delivers a fully immersive, hands-on experience that combines real-world physics with rich, interactive environments.\n\nFeatures:\nOperate multiple crane types: Tower, Fork Lifter, Telescopic and more.\nRealistic Environments: Construction Sites, Ports, Warehouses, and Training Yards.\nAuthentic controls and real-life physics simulation.\nProgressive challenges and certification-style missions.\nBuilt for Gamers, Trainers, and Industry Professionals.\nStep into the Cab. Take the Controls. Master the Machinery.\nMultiplayer co-op modes for team-based logistics and crane coordination. (Coming Soon).", "short_description": "Crane Ops is the ultimate all-in-one VR Simulator for Crane and Heavy Machinery operations. Master tower cranes, mobile rigs, forklifts, and more all in hyper-realistic environments built for both Training and Immersive Gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24195316800085941"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824294_1057304685954462_9201832563834701872_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vB6krkyuDigQ7kNvwHjkF5P&_nc_oc=Adok9PQTbLqTl-9m4v1wTaQwkBazzsSY8lMBvHcPy39ApUMO9k841PdIKb6EQDWKECs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDQa5KqvPotKWuW4-9DwZhj6D7so_O2YZtn6H7Bn4yCw&oe=6AAFF29B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crane Ops - All in 1 Crane Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAM
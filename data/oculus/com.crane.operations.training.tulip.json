1AoNDsMp5_kMGbOfxvJdg&oe=6A7491AF"}, {"file_name": "9.png", "id": "1412196619963151", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822854_1412196623296484_3318068292327127053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDS_XwCeo-8Q7kNvwEH_8K-&_nc_oc=AdobHipTzY6oBaJSt_y-FATM6HFko_ETfS01t5BmTWtUAgjnF9_VGZjUnGJXY4Fhieg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEONPkLB3ai4niMtF4-Rof2ShqUwlAUhoTLymRbPjKs4w&oe=6A747984"}, {"file_name": "fork-lift-ui-main-menu (1).png", "id": "1842236056554467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820914_1842236063221133_6101325377203981774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJVP1aJqEskQ7kNvwEoRf9F&_nc_oc=AdqgOT6-AvT8R-KJDZuw_UAotTbPV0zr-DLGG6bDpWr5DUh3rvnii5JYyNSRicq0qWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEefEwj2GiroQz9Ogb2wcnH99EGqFgNoEZvsjTKZ2pbFw&oe=6A74A298"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crane Ops - All in 1 Crane Simulator", "keywords": ["Cranes", "Training", "CraneSimulator", "SimulationGames", "Safety"], "long_description": "Experience the power of heavy machinery like never before.\n\nCrane Ops is an advanced VR Simulation Game that puts you in full control of a wide range of Industrial Cranes and Construction Machines from towering high-rise rigs to cmpact mobile units and forklifts.\nWhether you're a professional Operator, a Trainee, or simply fascinated by the mechanics of lifting and logistics, Crane Ops delivers a fully immersive, hands-on experience that combines real-world physics with rich, interactive environments.\n\nFeatures:\nOperate multiple crane types: Tower, Fork Lifter, Telescopic and more.\nRealistic Environments: Construction Sites, Ports, Warehouses, and Training Yards.\nAuthentic controls and real-life physics simulation.\nProgressive challenges and certification-style missions.\nBuilt for Gamers, Trainers, and Industry Professionals.\nStep into 
ekXBkD_Ze3f1-n1EMfQVg&oe=6AE895AF"}, {"file_name": "9.png", "id": "1412196619963151", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822854_1412196623296484_3318068292327127053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSzuujbg57YQ7kNvwEiUxEw&_nc_oc=AdoRio2I1PfjzMb-sukqz9NZda6nvSz3eX-cwJhGu2PBUdoWG4j7RK_DZk-SCqREZSE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVrR8wkXUjTyFS2Bh_IYu_Vbl_8MrXo4VXy988lEW_fg&oe=6AE8B5C4"}, {"file_name": "fork-lift-ui-main-menu (1).png", "id": "1842236056554467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820914_1842236063221133_6101325377203981774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peg3qImHZvoQ7kNvwHs3AL7&_nc_oc=AdqLjSYrOJCn38Lh7v89HecxXJk9g5qHuZsrJ3nxIBP68Z8XAwkhcPD2RTP5Ft1-W_Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2jD-cRU1Zyw7MWe1WkCruVGpx_Y7vizFNTp_yZR4PiQ&oe=6AE8A698"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crane Ops - All in 1 Crane Simulator", "keywords": ["Cranes", "Training", "CraneSimulator", "SimulationGames", "Safety"], "long_description": "Experience the power of heavy machinery like never before.\n\nCrane Ops is an advanced VR Simulation Game that puts you in full control of a wide range of Industrial Cranes and Construction Machines from towering high-rise rigs to cmpact mobile units and forklifts.\nWhether you're a professional Operator, a Trainee, or simply fascinated by the mechanics of lifting and logistics, Crane Ops delivers a fully immersive, hands-on experience that combines real-world physics with rich, interactive environments.\n\nFeatures:\nOperate multiple crane types: Tower, Fork Lifter, Telescopic and more.\nRealistic Environments: Construction Sites, Ports, Warehouses, and Training Yards.\nAuthentic controls and real-life physics simulation.\nProgressive challenges and certification-style missions.\nBuilt for Gamers, Trainers, and Industry Professionals.\nStep into the Cab. Take the Controls. Master the Machinery.\nMultiplayer co-op modes for team-based logistics and crane coordination. (Coming Soon).", "short_description": "Crane Ops is the ultimate all-in-one VR Simulator for Crane and Heavy Machinery operations. Master tower cranes, mobile rigs, forklifts, and more all in hyper-realistic environments built for both Training and Immersive Gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24195316800085941"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824294_1057304685954462_9201832563834701872_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJaqOg3w-DgQ7kNvwHcwYt1&_nc_oc=AdoPGG_a4nIgtZ2y9pJBWLpPdJCCil3Do23yzmhn_nI6pvQXwa-EiY3jmeILtT3rFpo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoTSiQjTAhJe4Z-E9eqLKjVlhvRDo-Mo284xVKjVeAiQ&oe=6AE8A31B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crane Ops - All in 1 Crane Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAM
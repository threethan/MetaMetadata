9MRyT7yABkPPfaqPt8hyQ&oe=6A49102F"}, {"file_name": "9.png", "id": "1412196619963151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822854_1412196623296484_3318068292327127053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywjg_DPSPEkQ7kNvwHPJMur&_nc_oc=AdqSHr2uSaeaoJsAsxTHCyH3mNMdojqP7E9wI2FuV18-i7jSiPZ5hejGC9uQw-PIyVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnCJZfRnQgp7S7djn2igBEExi2mwRjJEnvlkS0OdRWbg&oe=6A493044"}, {"file_name": "fork-lift-ui-main-menu (1).png", "id": "1842236056554467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820914_1842236063221133_6101325377203981774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1NVE61-c98Q7kNvwEvPYXC&_nc_oc=AdpQKzrNHVCIfjsAQgzYQdmQm_3zgbIWkxMwJkExsuP5kn02euAH7DTg_uVz2S8EAzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2QRGOj78hqkpyOpm7mnAHZgPjQbzFjwsr8yTqHpw-jQ&oe=6A492118"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crane Ops - All in 1 Crane Simulator", "keywords": ["Cranes", "Training", "CraneSimulator", "SimulationGames", "Safety"], "long_description": "Experience the power of heavy machinery like never before.\n\nCrane Ops is an advanced VR Simulation Game that puts you in full control of a wide range of Industrial Cranes and Construction Machines from towering high-rise rigs to cmpact mobile units and forklifts.\nWhether you're a professional Operator, a Trainee, or simply fascinated by the mechanics of lifting and logistics, Crane Ops delivers a fully immersive, hands-on experience that combines real-world physics with rich, interactive environments.\n\nFeatures:\nOperate multiple crane types: Tower, Fork Lifter, Telescopic and more.\nRealistic Environments: Construction Sites, Ports, Warehouses, and Training Yards.\nAuthentic controls and real-life physics simulation.\nProgressive challenges and certification-style missions.\nBuilt for Gamers, Trainers, and Industry Professionals.\nStep into 
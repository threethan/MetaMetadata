OjazjIDwQJ_XHihXHTXZA&oe=6A50F92F"}, {"file_name": "9.png", "id": "1412196619963151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822854_1412196623296484_3318068292327127053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9O9xOXgatMQ7kNvwGcv5RG&_nc_oc=AdojMmNXSLu3qXYd-tXoREQJI7EmKjXoGC-C0SM7Bbp0RwyxEV-W1Zj7MebZ4jzVYt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLqR08sam3yPAQEtu3m_dIdNFdPlPhXLXemIiVBGY9_A&oe=6A50E104"}, {"file_name": "fork-lift-ui-main-menu (1).png", "id": "1842236056554467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820914_1842236063221133_6101325377203981774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1fUAZCkrmsQ7kNvwEw5w5A&_nc_oc=AdpWTMJjrCDFd0pGHaC52_Px04Qv8Q82Ck_5Irb8ujUtutAZdI8GbE23o0l83Ja2-zk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACMxk7JVxUsNE6t4yV2oNKNmKSZxO9MFYAiTeLqFGS9Q&oe=6A510A18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crane Ops - All in 1 Crane Simulator", "keywords": ["Cranes", "Training", "CraneSimulator", "SimulationGames", "Safety"], "long_description": "Experience the power of heavy machinery like never before.\n\nCrane Ops is an advanced VR Simulation Game that puts you in full control of a wide range of Industrial Cranes and Construction Machines from towering high-rise rigs to cmpact mobile units and forklifts.\nWhether you're a professional Operator, a Trainee, or simply fascinated by the mechanics of lifting and logistics, Crane Ops delivers a fully immersive, hands-on experience that combines real-world physics with rich, interactive environments.\n\nFeatures:\nOperate multiple crane types: Tower, Fork Lifter, Telescopic and more.\nRealistic Environments: Construction Sites, Ports, Warehouses, and Training Yards.\nAuthentic controls and real-life physics simulation.\nProgressive challenges and certification-style missions.\nBuilt for Gamers, Trainers, and Industry Professionals.\nStep into 
a4-QZ--X5Vo5sCH-_gPuA&oe=6A9ACD2F"}, {"file_name": "9.png", "id": "1412196619963151", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822854_1412196623296484_3318068292327127053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX7iPZ3Sf4wQ7kNvwFtBqJ3&_nc_oc=AdrFVc2kBOEBxlH-UvYMKhmnXDprilSdQgyl8qIew6o8cujf3I0wY7JdIgtB9TfZyNs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK66yq5f4IUsXyERA33G1ln-AYYMM-crlLA4bAJCWIC8g&oe=6A9AED44"}, {"file_name": "fork-lift-ui-main-menu (1).png", "id": "1842236056554467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820914_1842236063221133_6101325377203981774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuqycW1x2EgQ7kNvwH1GFQF&_nc_oc=AdpKZ1_HcCf9OGT7E9qRk8FUCCG-VnbyyBDX00WmvP8PXp3z-6y8kp3QUS8TSSDFQC8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHmtbjB8KNd1UcAILVdegYsTXJr0sFjFcp0wVuHA2AwQ&oe=6A9ADE18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crane Ops - All in 1 Crane Simulator", "keywords": ["Cranes", "Training", "CraneSimulator", "SimulationGames", "Safety"], "long_description": "Experience the power of heavy machinery like never before.\n\nCrane Ops is an advanced VR Simulation Game that puts you in full control of a wide range of Industrial Cranes and Construction Machines from towering high-rise rigs to cmpact mobile units and forklifts.\nWhether you're a professional Operator, a Trainee, or simply fascinated by the mechanics of lifting and logistics, Crane Ops delivers a fully immersive, hands-on experience that combines real-world physics with rich, interactive environments.\n\nFeatures:\nOperate multiple crane types: Tower, Fork Lifter, Telescopic and more.\nRealistic Environments: Construction Sites, Ports, Warehouses, and Training Yards.\nAuthentic controls and real-life physics simulation.\nProgressive challenges and certification-style missions.\nBuilt for Gamers, Trainers, and Industry Professionals.\nStep into 
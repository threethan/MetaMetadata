sid=6e7a0a&_nc_ohc=E2GahkSJhEQQ7kNvwH3qMxX&_nc_oc=Adq3hGn_HBaY5qB6GQWl8kXueQTKECetc3qd4X5mcAq2rUac-U4w9kZX-tCH0ncvO3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ofOMzX4AE9dWBdaYCjwyzCXj8yiuTCkpNKRgrTSyK-Q&oe=6A20316A"}, {"file_name": "migrated_image.png", "id": "257736325234498", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427628_437780690013964_1017384250984366080_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i9e7Jd6epwQ7kNvwE0wKSb&_nc_oc=Adohakh59oPYexDU7-ym-nBnbOzQIzAZNJDBK7mXo_AuQhsGrLcLB0qvAJkh3Ndp6tc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mWZam_F3CtSiHpj1yiLrqwe6UYVCDdnkXl52Cb6sLyA&oe=6A20366C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "237701016805419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138999_237701020138752_3435951000458887168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIo9VdeC9oIQ7kNvwFqJS00&_nc_oc=AdpJYAURyEz_EfAzq3xX6dh3hSXdYbsmveZ_YxhNTl8tw6s-SOKxdbwcTmKn_6h0ICQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55GAD71yRXDDvrIftLHZBJuT3GZIZPtTC7zd48ikxi9w&oe=6A204BC6"}, "display_name": "Worship Space", "keywords": ["Buddhism", "Sutra", "Chant", "Spiritual", "Oriental"], "long_description": "Do you ever want to enjoy a mental clarity and have some rest after a day of hard work, but can\u2019t find your own mediation space. Do you have interest in Buddhism, but don\u2019t know how to get started? Or maybe you have become a devoted Buddhist, but can\u2019t find a space to study Buddhism?\n\nIf you have the above experience, then this app \u2013 Woship Space VR is a perfect suit for you.\n\nWorship Space is a free Buddhism app which using the most advanced Virtual Reality technology, and can help you take advantage of transit time, lunch breaks and other instances of downtime to study Buddhism.\n\nFeatures:\n\nBuddha Offering: Offer fruits to Buddha.\n\nBurn Incense: Burn incense sticks.\n\nSutra Chanting: Recite sutra.\n\nBuddha Amulet: Purchase amulet blessed Buddha.\n\nBuddha Worship: Worship to Buddha.", "short_description": "Worship Space is a free Buddhism app which using the most advanced Virtual Reality technology, and can help you take advantage of transit time, lunch breaks and other instances of downtime to study Buddhism."}]}, "developer_name": "Chesstar studios", "developer_privacy_policy_url": "http://www.chesstar.cn/site/privacy-policy-and-terms-of-service/", "developer_terms_of_service_url": "http://www.chesstar.cn/site/privacy-policy-and-terms-of-service/", "publisher_name": "Chesstar studios", "support_website_url": null, "website_url": "http://www.chesstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "UTILITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "658297428935291"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "234796950432020"}]}, "baseline_offer": {"id": "234796950432020"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1526576400, "status": "PUBLISHED", "id": "234796950432020"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1514307415363793", "version": "1.0.8"}, "id": "240991173130683", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename"
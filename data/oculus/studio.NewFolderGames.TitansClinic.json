960812", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974456_1671318863294145_5858641730604750383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8n0YlQrKJZUQ7kNvwF1R6Oa&_nc_oc=AdrHcDnB9ps4_68sPfu5zOHOxeOPzYAcOLs2Yt8ss033_RZQJ6Wb262I_FDMNcuxPYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dHXZHEkTGyf9sRNlJq33-GcvSQEa2PH_RmzIE_dKqUA&oe=69ECC2C3"}, {"file_name": "2.png", "id": "1302847703635074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001660_1302847706968407_1442331240405793541_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqGAVgRqK5QQ7kNvwEP_7mM&_nc_oc=AdowfCLrk5hX71h6dlMzTDwc4yGZ7QvJ86oxiYH_gX8PzVu2PNfrpWmJWG7E3sGX_b4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bfd4l__Q9h11r9_98Za90PINHNCJugwq3Pj9O-0_18Q&oe=69ECBBD4"}, {"file_name": "1.png", "id": "991027228545072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75507164_991027231878405_9167607303528823685_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd_0CF0yeMAQ7kNvwF4mskn&_nc_oc=AdraXt9iQ3DH1_m-fR9Y4L389OF1AEnwcwsGAVTKPlHwCLz3vxH6yd-dY5MVgf2fmbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HBzmm74JKr3BZgUcSuH4fe-Ov2eRUTK0ip5fcM92P0g&oe=69ECC314"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560x1440.png", "id": "455449196760829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371511_455449200094162_6428997002143793287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zRvSqK4hjQQ7kNvwGHX8bQ&_nc_oc=Adp7E73MMHBrYkprcX5UA0XUHPI2uGde_uHlWCwdIsDT8-Riu9h-1qikhvfwzbtnjPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AzGafaQjOYJdztZRsaicWEoqI6CmHQsop5BmMaFFhWg&oe=69ECC543"}, "display_name": "Titans Clinic", "keywords": [], "long_description": "Explore Titans Clinic - a casual VR game, you are a dental doctor for the Titans! A titan comes to you with problems and your task is to find solutions for them using various tools inside the game! \n\nTEETH CLEANING\nIt's not every day people brush their teeth, but customers want it more often!\n\nCARIES DESTRUCTION\nDestroy caries in every way you can think of!\n\nX-RAY\nWith this tool, you will be able to see the hidden problems in the mouth of a titan!\n\nPICKAXE\nDo you think you're in the sandbox? Yes, that is right! Destroy caries and tartar. And not only\u2026\n\nDRILL\nYou can\u2019t destroy the mountain, but it will help a lot in healing!\n\nVACUUM CLEANER\nSucking is not always a sin, especially if you are a vacuum cleaner!\n\nHEAL GUN\nWhen you are very sloppy and messy, this particular tool will come to the rescue!\n\nTOOTH CREATION PANEL\nOnly 1 percent of the people in this game can make 100 different teeth!\n\nINCRUSTATION\nDiamonds, silver, gold, beautiful accessories - all this can decorate the smile of the titans. Mustache too, why not...\n\nPLIERS\nIf the titan as a client is very picky, then this might help...\n\nKEY FEATURES:\nCustomize: In the game, you have the opportunity to create a unique jaw for each client!\nTools variety: Brush, pliers, heal gun, pickaxe, drill, x-ray, vacuum cleaner - all this will help you and your clients!\nFun: Mixing different incrustation elements, tooth shapes, and tooth materials will give you unique smiles and jaws of titans!\nComfort: In our game, you will have co", "short_description": "The Titans are in trouble - help them treat their problem!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
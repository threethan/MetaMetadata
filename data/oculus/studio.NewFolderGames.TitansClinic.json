trailer_thumbnail": {"file_name": "Cover Art 2560x1440.png", "id": "455449196760829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371511_455449200094162_6428997002143793287_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ud3EZf1IIwQ7kNvwHZkoOj&_nc_oc=Adqy8dy1cBvPXBNleKZ_0vbvD36B2HqBHsA5VWQBzrxH59dL2UbgVnV3FUZMx-I8gJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCregOutsxszBeOfTFvFVcvMkl36VtSEbrMyDuwalgxQ&oe=6B047B83"}, "display_name": "Titans Clinic", "keywords": [], "long_description": "Explore Titans Clinic - a casual VR game, you are a dental doctor for the Titans! A titan comes to you with problems and your task is to find solutions for them using various tools inside the game! \n\nTEETH CLEANING\nIt's not every day people brush their teeth, but customers want it more often!\n\nCARIES DESTRUCTION\nDestroy caries in every way you can think of!\n\nX-RAY\nWith this tool, you will be able to see the hidden problems in the mouth of a titan!\n\nPICKAXE\nDo you think you're in the sandbox? Yes, that is right! Destroy caries and tartar. And not only\u2026\n\nDRILL\nYou can\u2019t destroy the mountain, but it will help a lot in healing!\n\nVACUUM CLEANER\nSucking is not always a sin, especially if you are a vacuum cleaner!\n\nHEAL GUN\nWhen you are very sloppy and messy, this particular tool will come to the rescue!\n\nTOOTH CREATION PANEL\nOnly 1 percent of the people in this game can make 100 different teeth!\n\nINCRUSTATION\nDiamonds, silver, gold, beautiful accessories - all this can decorate the smile of the titans. Mustache too, why not...\n\nPLIERS\nIf the titan as a client is very picky, then this might help...\n\nKEY FEATURES:\nCustomize: In the game, you have the opportunity to create a unique jaw for each client!\nTools variety: Brush, pliers, heal gun, pickaxe, drill, x-ray, vacuum cleaner - all this will help you and your clients!\nFun: Mixing different incrustation elements, tooth shapes, and tooth materials will give you unique smiles and jaws of titans!\nComfort: In our game, you will have co", "short_description": "The Titans are in trouble - help them treat their problem!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "176526488543546"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1093461519699416"}, {"status": "PUBLISHED", "id": "27988771197477947"}, {"status": "PUBLISHED", "id": "2743741492655342"}, {"status": "PUBLISHED", "id": "1394584199084906"}, {"status": "PUBLISHED", "id": "861505496515363"}, {"status": "PUBLISHED", "id": "2075511096520088"}, {"status": "PUBLISHED", "id": "1033467415401911"}, {"status": "PUBLISHED", "id": "1661351178071162"}, {"status": "PUBLISHED", "id": "1122810709411352"}, {"status": "PUBLISHED", "id": "899787988747145"}, {"status": "PUBLISHED", "id": "1921898318222666"}, {"status": "PUBLISHED", "id": "1147238033021135"}, {"status": "PUBLISHED", "id": "983069343290260"}, {"status": "PUBLISHED", "id": "2179859492349515"}, {"status": "PUBLISHED", "id": "447916090943000"}, {"status": 
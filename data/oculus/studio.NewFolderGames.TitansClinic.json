luscdn.com&_nc_ss=7f20f&oh=00_AQDNNK8pWGm7Dl7KkQqqItIPF4XMK6N67Yx8qo_rQ9vceA&oe=6A54ECBE"}, {"file_name": "4.png", "id": "1671318859960812", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974456_1671318863294145_5858641730604750383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qO3PN7M69QQ7kNvwH8mTmE&_nc_oc=Ado-b6RR83ylWYmzTGF59h16cXbLxsSdcixRt4cOQsw2bJSqrlctoZWJdOe7HRG2tLI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUFWPk3BHgOY5JhfQJFo__LpdlEWC-qlYBvrYodbLdiw&oe=6A54E943"}, {"file_name": "2.png", "id": "1302847703635074", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001660_1302847706968407_1442331240405793541_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZcfVd55rzEQ7kNvwGgRwaV&_nc_oc=AdpU3axFo19_Ol6JqOjqNoboEqddvkmTvIgBLSKiy7neUDHNfpJXyS3m60-DunwIYlI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOQP4w2VKMt-n-kF1eF2NRdQaxtgui-GMNBCi_luQ-tQ&oe=6A54E254"}, {"file_name": "1.png", "id": "991027228545072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75507164_991027231878405_9167607303528823685_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aG5m9qnXgv4Q7kNvwE56OVR&_nc_oc=Adqxi4xNGFAlLhOBvaVB6dGd1fdtyGT-ckYaQbh7Ipxx4roGZHUHmczGkxGFdyRW-ck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCesQ5op2X88bMUEYZgJlON_ZlvuQuOh6A5iGy1AP3gPg&oe=6A54E994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560x1440.png", "id": "455449196760829", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75371511_455449200094162_6428997002143793287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdxtkWQ7hK0Q7kNvwEX4Yrj&_nc_oc=AdoEMleBUI5hdpRRfmpmcw71jzhOShYUgcbJHJ1Wc2Zlg2GrntxXmYmpOB_vm-Bzcrk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFUgB959DTVO2I2sP51CKd2tN99xVn2xjq-cSKY-w2rw&oe=6A54EBC3"}, "display_name": "Titans Clinic", "keywords": [], "long_description": "Explore Titans Clinic - a casual VR game, you are a dental doctor for the Titans! A titan comes to you with problems and your task is to find solutions for them using various tools inside the game! \n\nTEETH CLEANING\nIt's not every day people brush their teeth, but customers want it more often!\n\nCARIES DESTRUCTION\nDestroy caries in every way you can think of!\n\nX-RAY\nWith this tool, you will be able to see the hidden problems in the mouth of a titan!\n\nPICKAXE\nDo you think you're in the sandbox? Yes, that is right! Destroy caries and tartar. And not only\u2026\n\nDRILL\nYou can\u2019t destroy the mountain, but it will help a lot in healing!\n\nVACUUM CLEANER\nSucking is not always a sin, especially if you are a vacuum cleaner!\n\nHEAL GUN\nWhen you are very sloppy and messy, this particular tool will come to the rescue!\n\nTOOTH CREATION PANEL\nOnly 1 percent of the people in this game can make 100 different teeth!\n\nINCRUSTATION\nDiamonds, silver, gold, beautiful accessories - all this can decorate the smile of the titans. Mustache too, why not...\n\nPLIERS\nIf the titan as a client is very picky, then this might help...\n\nKEY FEATURES:\nCustomize: In the game, you have the opportunity to create a unique jaw for each client!\nTools variety: Brush, pliers, heal gun, pickaxe, drill, x-ray, vacuum cleaner - all this will help you and your clients!\nFun: Mixing different incrustation elements, tooth shapes, and tooth materials will give you unique smiles and jaws of titans!\nComfort: In our game, you will have co", "short_description": "The Titans are in trouble - help them treat their problem!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
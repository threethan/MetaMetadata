tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139419_1781096395476714_5334459397219287040_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDm9BDtWX-8Q7kNvwGyHmdU&_nc_oc=AdpWHfBqPZewzuSc9OedFN0OlAzH8dn1qbc2r1xkEmoTXX9AmhDN2XQO9dhbU7Qy-UU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T2XN-4-uFQcaX6CIztqWQjJ2wp4TLwmlwpa6K1iPkGA&oe=69D3C42E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OPTIMA VR", "keywords": ["OPTIMA", "BATTERIES", "Racing", "Offroad", "Sports"], "long_description": "OPTIMA Batteries takes you on the ride of a lifetime with a new virtual reality experience, \u201cThe Power of Legends.\u201d This fully immersive 3D and 360 degree video takes you through the legacy of OPTIMA, beginning in the late 19th century. Next, ride alongside a variety of industry experts in the worlds of pro-touring, professional road racing, off-road racing and bass fishing.\n\nYou can choose from five different experiences featuring OPTIMA PowerPro Ambassadors: James Clay, Edwin Evers, Lucas Murphy, Corry Weller, and Mark Stielow.\n\nDon\u2019t forget to listen to a handful of inspiring of stories from battery owners, who put their power source to the test, in the Wall of Power gallery.", "short_description": "Experience OPTIMA Batteries in Virtual Reality! Travel through time in a 3D exploration of OPTIMA's rich history. Or ride along with a PowerPro Ambassador for in-vehicle action like you've never experienced."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.optimabatteries.com/en-us/privacy", "developer_terms_of_service_url": "https://www.optimabatteries.com/en-us/terms-and-conditions", "publisher_name": "Vaylian", "support_website_url": null, "website_url": "https://www.optimabatteries.com/en-us", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE
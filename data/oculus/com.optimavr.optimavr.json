humbnail": null, "display_name": "OPTIMA VR", "keywords": ["OPTIMA", "BATTERIES", "Racing", "Offroad", "Sports"], "long_description": "OPTIMA Batteries takes you on the ride of a lifetime with a new virtual reality experience, \u201cThe Power of Legends.\u201d This fully immersive 3D and 360 degree video takes you through the legacy of OPTIMA, beginning in the late 19th century. Next, ride alongside a variety of industry experts in the worlds of pro-touring, professional road racing, off-road racing and bass fishing.\n\nYou can choose from five different experiences featuring OPTIMA PowerPro Ambassadors: James Clay, Edwin Evers, Lucas Murphy, Corry Weller, and Mark Stielow.\n\nDon\u2019t forget to listen to a handful of inspiring of stories from battery owners, who put their power source to the test, in the Wall of Power gallery.", "short_description": "Experience OPTIMA Batteries in Virtual Reality! Travel through time in a 3D exploration of OPTIMA's rich history. Or ride along with a PowerPro Ambassador for in-vehicle action like you've never experienced."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.optimabatteries.com/en-us/privacy", "developer_terms_of_service_url": "https://www.optimabatteries.com/en-us/terms-and-conditions", "publisher_name": "Vaylian", "support_website_url": null, "website_url": "https://www.optimabatteries.com/en-us", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "RACING", "SPORTS", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "12317472806496
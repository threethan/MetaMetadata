12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-VWwSn2yKMQ7kNvwGhtCx_&_nc_oc=AdrjYX1sjhsbc0EEVRepxuxKEKm5Mm32KsBjtcV2pigVDHqW9Cb_a1J0B2D9owy8bDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZluQMLxghgmf3cHrXhhk05bt3qBItHT8HGGUvnHtB2Q&oe=6A902959"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GZY3e0hhxcQ7kNvwExsRgJ&_nc_oc=AdreVdxNvhRAVWRAXQR1F5HNMOTg2PKUSHAmAVIdMwK5mZ4Mw0z8JIgp0dFYOEb95kU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiaahL3EWzW8lsYeCVCn1VGYU2W6Nl1Kmp9HQ-jOfPKg&oe=6A90321C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzjZhmfmY7kQ7kNvwFk9FL7&_nc_oc=AdqRR9utDaZmbGQSnRLSwjDbpBnmBvhQFI_qZkzaFohGmFCv-yZG9pN-LYZU8QDnf3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX8LEWICx1ZpVm1kt5FkwcQpWOe_MTAALXZ60jfDE_fA&oe=6A900B19"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZK_vOtxu74oQ7kNvwHDsia8&_nc_oc=AdqGQBASJMSM9VyAL5xZs3a-n1tfUEfjxWY6F4vJMOLDWz8hoUCxLlrOf6ibn2QtRBw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEawxNQ05dRsE7WDDBRCjolhsWv7vtXJxSjZtkR3JhZkg&oe=6A901FF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttU3v119mOQQ7kNvwHhGku7&_nc_oc=AdqW4Ex_6N6ogedHwgRF0haEmAMJGk8W-_7_Y__064npEU3ILG6IDrnsDU8YwpMG9xA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlDW_VsknS5QHQgZmC317SHVA9lb3VXdFAW5RL3ILVnw&oe=6A902D04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9nkSOktK74Q7kNvwEHwjHf&_nc_oc=AdoH5vvfow_fWhqKSJE0pKWJ-Rg7YzQn0eqflr4grk0VBYFDjiq-QVOfO4_lG8bG4A0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjThv-ekk-WAfNkeizSE8S6GMOmsXKRUUL1jYNaP_yTw&oe=69CD0B59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYIU7PLD5CoQ7kNvwGthcnz&_nc_oc=AdoYjl71fQXz8XrVRD5TqRryirXBgYUXspmgb3EUwqHve8Pfiawh0VjK-F-phhP0IDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMII3nVpJOG391EkfFv-AB9fsscI5r1b5efyTKb4mgpA&oe=69CD141C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3raU5f4UoWgQ7kNvwFcIwuX&_nc_oc=AdqoW2-jV-y_H0wLmQk_ggOdTORbSPP2bu_RsnbCDtcIuO5T5U0Qmdif67sR5yDmXkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6P6cpJIcwx3hKksqpnNLfSFapvR0753O5dYGYRIFToQ&oe=69CD2559"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE1ITVAz4VYQ7kNvwGfL3_G&_nc_oc=AdoRe20Z6KrhM9x0Z5dJjE-1K0O42x1A0OOfPEDtRngBt78k6ODMZuMJlH0jVqmrHOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1IP5bbksIZjC7-xOU8cOHdbNlh5evgk0FrTpangW9HQ&oe=69CD01F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH97kZizEM8Q7kNvwETdqCa&_nc_oc=AdpJ9Tbe_d4iQrnuKlaAkL_Z_KfvttYm3azz7aBQSybjwfr3ol2W5fQO8asc_X9Ur6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwsf1pp5mLOTodGVwZAD5qppa9k76PQZ_ESX6SkVXFveQ&oe=69CD0F04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
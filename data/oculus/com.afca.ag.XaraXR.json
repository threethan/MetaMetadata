12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp6vcbrhA6wQ7kNvwHfVQ5U&_nc_oc=AdqfkNz7BZ1eUXo_G5NTopjYoWfc5kGRPDD14qbLypqHVEZ-VrYxthiD6lQf5llU_Jc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQNvjTPt_GY7RkK-NqPccSU92LkbppNQSNS_SiBZ7Fvg&oe=6A81A8D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gg0atwfFNoQ7kNvwG4gEus&_nc_oc=Adr-tEVXfIlTc2QmzfxYJnjhPW48G24gXAYvXsyFW4w-acCRvZwQjxfngJaR_bw-nJY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJCFrAwm7FO5RocEelR7DfUeMW3o4Zx4jr-JS09PvElQ&oe=6A81B19C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X4Gm9Rdbl4Q7kNvwEmUDqF&_nc_oc=AdoErZfIi4NyKFjsxjVQwEK7AJCIMdBfBkCGO-PpanjLLVPLMfB8kDo0bKApXhTNL40&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwTDCVPNuAUuZ9cK__exjVyz4cVP_9D1kKMO7UNwii2g&oe=6A81C2D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlrjWtaOyOcQ7kNvwGYj_mK&_nc_oc=AdpmmBZXESdVQXHuympo5xgMea4RpHEa3Z-oOQC4pO9hB8_rSCynK9FO723ZAb53Fns&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq6HKjcwayNxaIvJyaKl0ULjk0wyY4v7B-8UR4izTP0A&oe=6A819F74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WfMj69b6bIQ7kNvwEqA7cu&_nc_oc=AdqP6CmHb1P0ectiKWY6J9gpU9LbC7Vk72FdrNItO75jqKDyW459IFYbbSL3nExPWy4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkS8jWNQ_C4GFNwoQEwIw4_i3jHFLtLCZl1qoJAxE38Q&oe=6A81AC84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
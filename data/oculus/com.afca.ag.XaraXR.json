12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWs0NxafTScQ7kNvwHaHhOw&_nc_oc=AdrAbsUgmCxOH6sUb2qe6brDtcp6OdPwNmhk8tg2U1nEWOazwfzw4cUuT6oz-PpGY4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xkEqGwHEBQM5UTZ14WP7cumAtBXSXNlNjrbJFCVMtqA&oe=6A2D48D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KON6UV6OF5sQ7kNvwHoY6XH&_nc_oc=Adphg7doec4z9gXtvf9hT9vTfRaQjnkMucFnQGuqta1UDvp4ds7i3cuiKiNzRmc5YZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83gGPFMdh7EeXZO9JxAEua4WbyzoyoX7kNwKMDzx0nQg&oe=6A2D519C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYvvJN4VrpIQ7kNvwHqyLH_&_nc_oc=AdpRsQPlx-QPi3-1Plk7y68TRZBy1j9-nwjlz-8TQTZ1Guk6xUBG6m4YDDFm_3Tr0DU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J968QvYe4kdyRtm3wML2fAaydGAUb26jkNssVXaOtgQ&oe=6A2D62D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyVUZ-ARycwQ7kNvwHjCI8d&_nc_oc=AdrziHfN6onkDVrpg7gSER1KakIB0SQOtcjE1jbt9DeUnvMiLOLtQ60R-kZg7fQ8RYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81rNE-6OZ63FXzMFW9IZd1q52bZCDFM5KZ1zI3B4-Svg&oe=6A2D77B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFPvhP3OA60Q7kNvwGS2XwK&_nc_oc=AdpHUZMv220h8FrlRIwZg5TWscNbbbyF4DmuQKZM8Gmfas7Ur2si2gThDi-RxNztUOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_O3EfxUxgM1a4MbQ4YUFJTchBWEYnN3Q6pc8p-g68Tw&oe=6A2D4C84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JkLerMjlIgQ7kNvwHepUZi&_nc_oc=AdpJin5XQrvIARq09_Si9ntz2ppaz2y2V7bjDnsG1kZMMDKASrYGTyMdegwHbql2jJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5ZWcrzom7rrE8-o3UvWUtN-ld_QQeYK_R5hO0QNmcgw&oe=6A999C19"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck-FRmCJ5LwQ7kNvwEDDPiP&_nc_oc=Adoprpbz7mQIOoy59ELZTTNmlNBp-F4UIYqjvzcYk0diUibgMScc_Pdabrhwxuus4i4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYRlYKSgAVJc8P8zG9iOK0lKmoubcfCVM2dJC46UOlPQ&oe=6A996C9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u0qtaGf914Q7kNvwES83X9&_nc_oc=AdqyV7cud9NiLhFmV0kEZV7hR41wEsoPC5RCQgpo-j9G5ryHRPy1aTw9u5LHIvDADbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc_atCeu0d3gSrT5P3khz7n3rTUOakZHT9KcNRGo24mQ&oe=6A997DD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKOWInzPCuAQ7kNvwHcn1PN&_nc_oc=Adph5wDsyubvWmiibyVAdFq7tmtYP1l1sGz2p1kpUVIAUCwIlA5YZ__FOJqhieLZMrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEPOgFlnpinxgBMCk5OxMtPlK9Ua_ZfdWydEFa-0iEzg&oe=6A9992B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13AVJCHQuqMQ7kNvwEA0pes&_nc_oc=Adq8VHS__OReoVdRcomjjHNz3wFMf-orZfZwbdiUyTt5e-yFwiUOHMxeV_RQtAczZfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqXJz8w_nBJxtFHVvYO7OWmet4O0i8yPKZE2Zbys0Z0w&oe=6A999FC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
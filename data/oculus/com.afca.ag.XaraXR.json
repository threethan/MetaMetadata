12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BV1nWNcQ8iwQ7kNvwFN1apO&_nc_oc=AdpDTEPDm10ia0glAP7VNpPup5mYctfIidPusrEJYCvSfTK_TuqvwY6tI9QrQHasYH8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWAGP7_jqL_TGRW2EOg8NVpv1SILNjSs_UPzNNikYvLw&oe=6A5CBED9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIBO7eavROgQ7kNvwHliBFN&_nc_oc=AdptRofzOymLQsxBMF4hiG0gsBGYxyoJXJTk7pgXOtHr3rXJLkkwAhXIITlAEf2TWCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfyM6FHbvKUj1yCQp5wtP6GG8Io3jR9LAk7VsiAxoCUQ&oe=6A5CC79C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG7JbsdKlxcQ7kNvwE65LPB&_nc_oc=AdoHGfY6ip3soU_xQn4u95BR9R71RxT7vrrYpj_F8Rlg128uLYkyiJqNHYf8J2Uhh8c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9uuZ97B_O28ynvOhZqIWrSS7epAzCrSCU7koR1Bn8yw&oe=6A5CD8D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-ZE9DALr8QQ7kNvwFW7jKu&_nc_oc=AdqrvOLVuy-2cqIJ5hCmCgW5ogUgEDhPZ7YHeeL1yeoxZ6lq4Rhw3PRrMsQGbODNx84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJKJOVBsK4uba3m2rwe27xFWNzBEoEjQ1lkrDUyO7aPQ&oe=6A5CB574"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLd6r5mQZI0Q7kNvwEcoFRu&_nc_oc=AdrCylXQN-QC0EBeDSztqDIV2oorliDEVErhaU7bNkt8V3EFauKLm6tyqCaFMC-e6FI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxsWVKNKI0v89Z_UJmyo-4_jsyaz6dCBa7snVqObxzmQ&oe=6A5CC284"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
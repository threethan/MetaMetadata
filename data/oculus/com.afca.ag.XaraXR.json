2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JkLerMjlIgQ7kNvwHVnG8h&_nc_oc=Adopkt641ZDFtVvyDLYJioz_NGpjChzskDv7B_LtNHDG0iJ-xYFeEM8cenxjD4dNGpI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYxN_R3_Xhzs5Pz_hYD72AeXgh50KCq_aQMXEhtVjOxg&oe=6A9AED99"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtI2XXbkWDQQ7kNvwGxCC0k&_nc_oc=Adpa3c8QXX9pWr9OWUce-bNjLqlGhpcc4TbmPJW_QjehSB52hFJgdF2vzZ5sywMp9tU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-k3xv4BqTnd2Bk4SNxbqAl1J-McNKx93K2XB990vihQ&oe=6A9ABE1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGLt_ZCNz7cQ7kNvwGhp8VS&_nc_oc=AdqCGVSXpxEjnUweuFRplJSPOtr7xQg_uSWfnRdI7Wq4js2Km9ZBr0tG2thnVps5TGE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeTKWrtzXG-UVhOxYnagwQ_UzlkWxddjWp8i0PhzT_hA&oe=6A9ACF59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKOWInzPCuAQ7kNvwGp8Oev&_nc_oc=AdpEfO1U7bT_DPC3nPf572PKD3r68GVrmfiQbH2oU9akMWvwdx1qh7SKtZsC0ueqpXE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSH9c5B8SnN7f9rLIyU-Aol8fVU_KrwV-6FpKq9SA72g&oe=6A9AE434"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13AVJCHQuqMQ7kNvwES7Yd9&_nc_oc=Adr4yOwAOyKhfEl1ddS6ORlPGdjbwWWKUdBDWxYBXu2ibDPFBXAD9Nxxp9hmYEQvxeg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqzrEKbn8kXBEXfL52fGn3j8iUOTYsPMllNXakA7cPOQ&oe=6A9AF144"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
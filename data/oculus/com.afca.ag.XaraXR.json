dkraVUtFHyIHKxaxeAo8Qv5Zj-3IIi099naklnVM9YjD0pdeaNZD6Ec9J4mL400RR8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftAP_yEXeNH1iI9wcDeW4sNf8JYyxuRSXa-QJx62_-1dQ&oe=69A2DB59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2T0lczE5DoQ7kNvwFGMfnm&_nc_oc=AdlBAE74Xe0M6hAzpk2qtfIpy2I6Zqa76J9QZNByiQ1CTCH9Qzndci2uUYs9JbnIXaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfusdEXIW81FgEozx1GvGze7bAmpby1idr5gXX6Z9BfvMQ&oe=69A2E41C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg9ep7ppdggQ7kNvwGgo1Gv&_nc_oc=AdmB1Wono1SDrvK4wVnJRgpiAMI4dftnbKMEPOy_Y1a826gozfifLSIYjT1-Z82Alzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvUO2prQxmpPhmH1fP_zxJnqWJxhvTaiUJUREAD4KanPQ&oe=69A2F559"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPgf_43CC-EQ7kNvwE9e1fV&_nc_oc=Adni18HZ-2E2Cx0bJFKA2OEOwXxHMU_nBFNp9khOFsB_EYlygrpYjbBMZ-JJjIuMGG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu-L7u5ZatDOjq7UV0WyvYXmehGzHC_JrGNLqyHdqSj0Q&oe=69A2D1F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO7pUxj28TYQ7kNvwHmIng9&_nc_oc=Admdj2uMXGNjvAzVICjY80hTXrXGLcLWqq2piUbs4gIAe7jlyv_i4L9CXqklIHfL8gg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGUqgsGnRGHUbjFcFdT5Do6KYFTleQdSREyDQxM5Pu2Q&oe=69A2DF04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
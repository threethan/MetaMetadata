12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWs0NxafTScQ7kNvwGlRWqF&_nc_oc=AdrcFFilAwXh-5uGYyShvaVmaRci5SIsBiCLJkP5raqhF8mqRjjuL8uMGdtOO5iTlns&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8655pbAOPuQaWN3Aqxv3l5F8oA_-oWrsIyNSqpRQjEGA&oe=6A302419"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujvsbCl33gAQ7kNvwGrY4tM&_nc_oc=AdqJNN90BvL7N8qL3lcSIHO1rlEXRuMpYssE2eYtbiaIka60hHd8-nB9F5DNoh0adl4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TICrTfHX4GgFTdOtTwNUjAqtyJyrAWS7yvNdT67ALUQ&oe=6A2FF49C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6GMazYih4YQ7kNvwF4DBUc&_nc_oc=AdoWuLlJ0kWvOurtRHbzadzbX-ZE-ru0Is1irJuEIa6yRsAivNWNaweTLtrAQ3FBdWo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iNkcVqE3TN5fDb4gQ8Xq5lRn-BrcX5mFxXscEk4nJgg&oe=6A3005D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QO2XNysCyQQ7kNvwE8dwK9&_nc_oc=AdpSdxctOrh6o1CrLceMndDBRHGTthboE8fvSN18CmdYFlhzDLfbAgChPY3q2rVgbPM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p5oxkir7ojBuKKtNf-ThxX2W8C0UH3Gq359JHcp11Iw&oe=6A301AB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFPvhP3OA60Q7kNvwEKhSxr&_nc_oc=AdqdHqtE0BUtWSZQOMwDsVxHQdGMXxa5imYktEIi9sXAxq5ZQB7yFcvqpWlnzUg5lZA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tR1FIhBDrQpCQCnk3x-YSHEPeCGopRmnVWgDG-xFq0g&oe=6A3027C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
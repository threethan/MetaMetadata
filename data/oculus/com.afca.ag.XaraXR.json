12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6vHBiqe0vUQ7kNvwFgUeRm&_nc_oc=AdqTaS8ZSMTjwmh4JFOhA55nkRK6_5apk58cIsRjFfFVQndC3MvYSGeQNRozTmWSQF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XmUJ5tkFsqzeVmEshrvsNBoK4Vlzawj96UD_5ligiUg&oe=6A43EA99"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Guxai5GXun0Q7kNvwHezrUD&_nc_oc=Adptm9ZyPZivEVKirH2m9pkU-vvGVgYmx6_XbbSNui785NMfLjgfixyWSHu-QBjJt7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ckd97wy-4QZkiGqIIw5AyAY-ccCVclEKBafoHzXXcGQ&oe=6A43BB1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lQGqqnrtWEQ7kNvwFRFJSA&_nc_oc=AdqZgpyTFtfToPjawocYP2SFoMJrQXW8j3lsRsA_8o44XkSES1fb3Typl6lMHk2ptPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_20E8w0Wzi44veIG2gmadBUGJ9L1wrOUn8it6B_t9K1w&oe=6A43CC59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAAjCvDnitgQ7kNvwEICj2U&_nc_oc=AdoqCQ6qJY33AhIxuPDbeo0JpSlKrTbiKD0SafR7jhfIfVD-c_7ykTuLyU8pncRJOeE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v11yYntnDCnuLcaJOJWFFtNkyoDf3Nqa-Y3TvHYeNiw&oe=6A43E134"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAoQ6FvqBZcQ7kNvwHIiUOn&_nc_oc=AdrEVelGZE-izcMKiGNqCRqZFRUIrz9MRUeqBNm8PIhT11EKISXtJsXncIjdUwE6Qf4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Adh4upS5ArSFIs3SQZ7ozu312LR_MWokIQOKcBnROjg&oe=6A43B604"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
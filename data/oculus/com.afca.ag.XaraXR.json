12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0GGFJK1N3kQ7kNvwHG7_By&_nc_oc=Adr3gOlrVD8J-uuRZCLyQwWl4lmYKqLwrYxEfB-00mqDgcs4LzsB9cKj9QkcOJ-npvA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44jFnhBhrUrLLxfYrKUNnj7xhJ4eDUn5-IPs1S_L1v8Q&oe=6A1047D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6doD9BZCi8Q7kNvwFLPVae&_nc_oc=AdoPZn8MDlZzxqB0Clth9kY4dS_LLujJCkdIJvIIWXkKzAC7nV-y9Ne2yPDyiJm1_zU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70LrPajwrCpDa5N_Aq4yde21MNL7ldENKBvQQ4FQmk9Q&oe=6A10509C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_V5Tecn-n4Q7kNvwF9xc7M&_nc_oc=AdrHCK9-L7-Z0TrUUbc6pCIQ8y0WnIPsc-RsH97tgZY_r_VIxuoqCQv-URlYi_EW2fU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7arJwn7oJr_6AXdoXLPq4dJabD0HrJdbFqx6DYfoeRVQ&oe=6A1061D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7-2k5oe4qkQ7kNvwGnh2qr&_nc_oc=Adp26SXj_lprFM4COfbkdA5f_mfSdmoWMluWLLhSTSVoF4jmOZpzox5hh6v3dmONas4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70htMQC_H3_1PybN7J2-PmFiWhRx2luk2BsdFOY2nY9w&oe=6A1076B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es7JfoXwGIEQ7kNvwFdfCKX&_nc_oc=AdpQQNsrulbe8Nyo7tEtRDUawk0Vlo9n4nJcQVaHLqQwVI_sovNME5CF1THqY0V_-vQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WJuimaJCknOiL80ZC9KYN98daB3ND2nLRYh8C8JGU-A&oe=6A104B84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
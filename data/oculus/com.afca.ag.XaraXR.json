12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVAnmV8Jdx4Q7kNvwF1nA6a&_nc_oc=Adp1d12e3GKCHo7welC7v-oilTi-1Io0uQRLWmhPpixDhsK0LtFLZMxFLdAvXKMhSCo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1B0LpkAKWCpuyFzNSqyjpGuRdb2suVPyXWBrmp31uI1A&oe=69F5E9D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qhGDImzZvMQ7kNvwEzFEi1&_nc_oc=Ado8UQolQyXn8i7DGqG52-HdbPk83e5md71DuF0eUQl0ZLjLG197wLpnv5dQGIfIi6o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NyIAnmJba5HlwGA14nJnGPlg8U0kt1y2Ig8l5oLWVHg&oe=69F5F29C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhPzjgqCSN0Q7kNvwGGWmtW&_nc_oc=AdrvJLcLpO1JXSCcLqdKDkksy1njzEWAS1C9HZJeLw9krl9ZIMr5KvGc_3JtoPzZxio&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xkbGZdCk88CIdRgGp1P6ZpTkw2D1XbwRuQFNHlrYQBg&oe=69F603D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDH8JGCX3E4Q7kNvwGM8AEU&_nc_oc=AdoD_f8tJa1hZdFgReXa3Xs6QAtWjZc70Wv1jgUCffBV1qzk4-ncMAXYS7AS7pti5sU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WKk-CXoNnArJ49MdHkoeMDvaDi5KeLwOtP3hT2JMqqQ&oe=69F618B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvC4Gvqzyc8Q7kNvwHlJHDV&_nc_oc=Adro-obMKfdkhm9-FeOmPVqO3QjgpNyynN-2zZXpk8vY5ePtolK2HPy2_iCxmHInpIg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NNAxeL5X58C4rvB7HjRaQhXnI8nVeknHtLnO3ZfYYzg&oe=69F5ED84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
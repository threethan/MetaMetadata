12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj7uOTgTFwMQ7kNvwH1RpZt&_nc_oc=AdqeMpdTyfFpFEnhC5qBMau2dvTFfV8ExmHFrMKPyg_fTL8W_XMKLCOg97x3HfbZWao&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Eo8WaT_ajI8kcfs68M2VAaM6ebwIyfHpjKRIz59qNxQ&oe=6A21A399"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrE9sFJaI7kQ7kNvwErNmmU&_nc_oc=Adr7QxQAeLnrB9Z_Ng0TO_EeyDNvJOuE5pz5HlNWDFzRGL-B-RKIimncjKzXqS8gziE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9JErow9-3yus8J5jcRroq-9iMzDZuYVkgCEeua4yjDg&oe=6A21741C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCIQiy7GIXoQ7kNvwEVH50g&_nc_oc=AdoRmyRggGD8pT82HOiYNBTzrgs-6kVXWHAND2qe2W6MYG_T6OCxuADxLC8cNu_6kRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KpUBFcd5Sn3mbQi3FBwsTe6xJXf42oSqaNJIBEKys-g&oe=6A218559"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_xYlC1fG68Q7kNvwFRnSJP&_nc_oc=AdrYlITf6Dhcp6_I4Kf1en1UKj1uJH29sJ4HZsjdqsuRFxMjJn17_3S_L2FMePVwCb8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q1B9oHItmbxNxbrVxGynONbUMQLJB_NRksdhSMcqwxg&oe=6A219A34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E31PagXReYgQ7kNvwFWMjPO&_nc_oc=Adr3eDbAV5DGbZ8DFOYbIDImy0Kv_9RKHpYRp3aa64LGqzXnsr1QbZn4CwAr6WqidOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WX6VK49ob71H7yUwS0zUIbPjaUZEHoTrVC4WeOA0R8g&oe=6A216F04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
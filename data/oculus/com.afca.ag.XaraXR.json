12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0EhaD7_3EQQ7kNvwGAIbu_&_nc_oc=Adojyvc1TJbP-W1Q2EH6HejyK9-tqKs5VL0QZaIrc0StTRtiTKSpgLyifK2CRL5lxz4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_tEUTKIH3FVJiCLCNC9mz8wm2R0T2laaGj3pBItA-vg&oe=6A7479D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppmZUSEtxc4Q7kNvwFo-cbe&_nc_oc=Ado4IEiwDJ5dLmVfu0Zy_CKqkp_5o_QE3PgJI2i0IBfkaD1VANCp0LqmhZ_bUJDpKYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQxQLyw78t7Vasj9smEhldW6tXFdU6rMVPQ9ziVqDMTQ&oe=6A74829C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vazUzJO83mgQ7kNvwFnZ80g&_nc_oc=AdoOxz_rEKkrE0LSJCZVsYUkL_nCN05zaaBVvNlmaxsK0rktG4qS9R8G23hwbddkabI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERl83-kDbUMOZ8p5G52eLqVe0aX2QCS3TBly06sAGPgg&oe=6A7493D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnsTGA5gGHUQ7kNvwH90XLp&_nc_oc=AdqtLWKb6q-h34ixlNH5bHnWWWs_QU9B9AKyev7stLjUbI8PLP8DA8mXUq2lL8NxNic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDiJDoblUjxbH0av51rhuqkbSrSrhrCSji23lYNqYKKg&oe=6A74A8B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRfUYH48xiMQ7kNvwHqMiNI&_nc_oc=AdrzrQYmXTv2YyUVqoW75Axd8X1tYm9GRemkBayvUK2cSLVwj4W9dL7P9WWERlWlqn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9IlKhHq0DVm4Nkfiy8ZhcrGri1L2AZEiqjxlQywFFYA&oe=6A747D84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
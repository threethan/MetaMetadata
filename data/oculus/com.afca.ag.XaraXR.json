12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=218a82GIbd4Q7kNvwHuTehS&_nc_oc=AdpBdqHBEuMOV2kxQeC1YZ9E0ViAiVIpjsGIoZg-nBpI86-whzcs_VcLAy0AxJ2P64c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kY8u_sBgmZOCfoQS9_cTno9pdNm4zxwserijaK656tQ&oe=6A05BBD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN8gAROqClcQ7kNvwHUePJu&_nc_oc=Adrc3ikf1u4fjhxPPaV5-oYujjv4wDmbz6pRTYQD6fwRetF8WdyqrfPsEhb7XsXTxDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y7I9jGEFW8S4JIrMc65owqDU55aGQFZIBpDZPRfqgkw&oe=6A05C49C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3IF9BL83acQ7kNvwFzhMuw&_nc_oc=AdpKJyI8iGh5IE5lhKE64e-hTO02uDVJAvumGu_J0cK9u2lvGyWNLefYOSO5TLXg-mo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wNA20cIKiTi2X6lR926-CmXi2YNvcXNXTvNoHlfUE_g&oe=6A05D5D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dhwX7gOR4AQ7kNvwG7i6BG&_nc_oc=AdpYvnTj-sBO74_RAq5-5zTeB5jluEklYmAvtc-6BkLiUgK0N9-Zz_EGVaoubOBf_gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41hFanTpb5aYwz8clwi-r9BHCYakxl-n549YAW-34P0Q&oe=6A05EAB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAFPPSJflu8Q7kNvwFEBGl1&_nc_oc=Adoo135OMOAf0SXEGWeP2e8HLx7eadAhHSVEP6dOmHhFi_bwesR9CYvU3yyoBCOOdjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oCbNDldF4JYL11Z_n3nA55uTWqvIke2WYsq6rvZ85Gg&oe=6A05BF84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
dkQGQSB5fZVN9mZ82BPfPc3EDrJ2UrefezfjMYozm0_YZpQMHIdA2AdUxJlAHGA14E&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs8IYM8-MLWz3SCu2nYXL74-4ubVKwP6KEakguLbHgIBg&oe=69A189D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2T0lczE5DoQ7kNvwEyiEXb&_nc_oc=Admys276P-A0WjOScNxZge-b_FkCXxZ1Oc0T4Mt3eVCMz0m1Y507JCAdcRkAt7wy_fU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv7C6Gobp9ankXTJaSkNgO6R_W2Rf9m_GIWmr3NiuyaSQ&oe=69A1929C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg9ep7ppdggQ7kNvwGDFVvJ&_nc_oc=Adlqr2G0Q333RCD0B0AafslbI2xeJPtjcCNXd8Vgla-vh2imewMDncpsdLRN7eNnNzY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvYI1NBlm1zZMjRekltXR6tdIx54jk_x3rdZh3aVDt8Tg&oe=69A1A3D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPgf_43CC-EQ7kNvwH2xA-y&_nc_oc=AdmY3qEHQkS1beyz6PK3UvU6DKGJIJEOOdweKmhgou8QJUfxa9wzU74KLBRZF-2MM6Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftMwhRWPOqyDaHmC5vqlp445if5Z9Qi3m8adkx0zlMpFw&oe=69A18074"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyoGSgZ6sQsQ7kNvwGhwpZK&_nc_oc=Adlqi44uyfvrYc3-re_35WHGsDjWW1_I2t5YAfDJbS1e8BP78ipuNh91OfFOTdWoKTY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuB0W1E3TeNpPpK_USBjWMdPl7eO14f9S1XYnM1qUre9g&oe=69A18D84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
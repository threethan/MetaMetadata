12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXlkkQbznxgQ7kNvwHktwvP&_nc_oc=AdofcTJuBT0W9V8OzY2Sjb_dgJskHWyvmrtztYiC8SDD2rY2RGt0KN-7JsVR4oN4CJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAZgI7TguiK5E8pYnvt0ikH17wKJxA_s_DGRJpLlZXww&oe=6A64A7D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_f0byVQrkQcQ7kNvwFsQWZk&_nc_oc=Adp-i5XsE0nVXGbirnkkjYPnpr0gQ_lEriA3rYKV5wd-hKThsw8cP28LxJ_YfSuDM2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsCCI58cszwJx8IlOOEXCvF3dUuBkfhbqThV0IxTXkWg&oe=6A64B09C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyHsaOuNOmQQ7kNvwEPW9mQ&_nc_oc=Adoo8RnvymJNeaBPDcg1H3sOvRnm2li7LHDCoHSS29YXE0fl9sAcec8RfFq0AbjcbfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTEqI2zXGGwOBdKWNJbSD_dTS0N_-2B9kl1sTZeZgQKQ&oe=6A64C1D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGduk-yANhkQ7kNvwGYVjSZ&_nc_oc=AdqenwAknD5QCMUJVKAApizZKULlJ22EjG81Iq72vBEkCFM4hQt9SJOfztRWyYjBQ8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzMrdsev0zNq-8NXxP9Ve8rkYHDyUjxIe9dgyUd1WPdg&oe=6A649E74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=talxjacsB1oQ7kNvwHNGjuz&_nc_oc=AdoRCSMRtIubsKW0ii6c3qRvWilbepB9MOf9h60qNA-QCwPsOCuphBzIIY1Q4fAL_wQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3bpeJORr2ANXholObtPhY4FYJcmITBCa9E72BWQuvRA&oe=6A64AB84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
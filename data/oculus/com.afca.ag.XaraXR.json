227612_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAr70oYAOgkQ7kNvwHPvpHW&_nc_oc=AdoVPdRgKKD6tImdj2E_7amTTA-2tQtealELfO2IZHTAMyMs6RiY1I445-KhcN7pJi4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOICMaLSLX0AwCWicizifu8rBo5OX8HixJQj4LxqE5_A&oe=6A8ED7D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GZY3e0hhxcQ7kNvwGmA_Uk&_nc_oc=AdqJxnjsV3A14ZtlCt3tp38LScVacEp5lE-o7iwrLgdORthjUHw5YHOHVBNiSUwWjsc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ60SaqeuXi3JxIQ5N_0hXVteEB_ePyrq45ItNmyGW9A&oe=6A8EE09C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzjZhmfmY7kQ7kNvwHK34VN&_nc_oc=AdqDPl-BIZRAo2Z-DuB3a_cNxyD838Tya_-_MJQjypuUqKSDBNuAaz30OOtI5hwZ4t0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZdwLe9gnhU0vAs4IN4-P0yZgDLkbnejUlVovSeXW5kA&oe=6A8EF1D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZK_vOtxu74oQ7kNvwFA-13L&_nc_oc=AdpgPsZo5Va4swf9-2mKr-dwHnvpTiwBl2nZT2MRuQ_79Wg1iVXwhGzwjUL3nGohMvc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9HRczDJg3J_G3K2v2p3ncAuA-bdEo8I3YM4Kf8Hzpmg&oe=6A8ECE74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxbBAUgXZ0oQ7kNvwF1F2Xh&_nc_oc=AdrzFCvCZ-_IlcLWOTWjY2emlgLszSfTCqWn_HpDb6yvnc3Qbb-7I4pNIWMtc4eIBgk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcjHJSH73RhtVhdf5zPtISm48qqBOSjJ9WQ8qbvaqZsw&oe=6A8EDB84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
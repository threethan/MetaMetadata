12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B66bTR0-FVcQ7kNvwG3VMC5&_nc_oc=AdqYhDuMpAqiMH0ZWcIP3Cdvb3IOJVbqkGMujOp_5Kt9XxyEqsIuFby3eOJhD158WMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47g0vh8GUjim1e18ksWJgo5JQcUTTzfvGDulaZs7_KYQ&oe=6A046A59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN8gAROqClcQ7kNvwGjsSOC&_nc_oc=Adr9_0vNHbUz9XOps_dxi7CIfwg9pL8oHsWYF3dGOuHghsX50UcfFmDZ5ZpTAgl97PQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ScqE1yuMOgJ425QdPS0Qsb8hqYWdNBBIwuK6owPfPnw&oe=6A04731C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3IF9BL83acQ7kNvwG60PbS&_nc_oc=AdpZCf0WUiQUw64Q8XY9KoOK0OVNzC2ESB4lHz2zWF4TV5omBDhjQgdUSGfbD8jOBc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WglcLiV4GK0JtpuacAaSZ2G5XbTkDLIJ06Sg_wLNzCQ&oe=6A048459"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dhwX7gOR4AQ7kNvwH-ntja&_nc_oc=Adq8Wnt2chEqd8UI4t7TDg06Cz4tdz7qi9yNCbFtOEvIQJLAAOn-ioiua15khF8qI9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TeUrVisbO778wpQLYE7uz0JIYDtELX6KB_dtUIn-BOA&oe=6A049934"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOTY6RA8IEQQ7kNvwE6r70C&_nc_oc=Adoe-VjQ_3I_bHOzKt8GFWBgbR4gi08kESYH9F-_JsQji8-tzh3qvgX4Ea5AUSh_pkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y7Nh1qHhmYL4RS73e7khA5Xs6-D6OWHE7ELpC1V5MKw&oe=6A046E04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
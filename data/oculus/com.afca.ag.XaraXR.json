12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yShnKY1UVx0Q7kNvwEznKhP&_nc_oc=AdowUy8N_rRrmGZ1Wz7JXPxH0JN1R399maZEbfXgIQnsCrT_zKDNSEeTe975vApeWbo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bW1qO-EktUgc2ysU2CabedBKgnpqf_CeDtXk_n5k-TA&oe=6A1B0C19"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlR-Rcc4uesQ7kNvwF2KpUK&_nc_oc=AdpaHomFYhkdhj0Xkc-aEJpvrPAqqaDY8J863Ux24MSWEGlXw1_K3k48DyEmAaVglys&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VyMuRS8xVHrld28A7CkA7vOD0jYzSNc4ef1sVlEXg6Q&oe=6A1ADC9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xlDXclEixAQ7kNvwFJeooc&_nc_oc=AdrngtnT3fjVKGP8kUPmqYL_ExYh_YGZ_CCN59PaR7m8doOWWw63QI37keUPGDT1BSY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U5x8OWVaxMqSEIlbW_svQDOdbf-bFAkgbw60Je6Z3sg&oe=6A1AEDD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IGsz6TFZowQ7kNvwGdNaCW&_nc_oc=AdojIDegNErRsUzy26_myNmGYXnMpFDFtFT9F1ViTmNA63-WIMA2QlIqVmrZip7whrw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63CaHoa2DtKxZMzTwFV_shj79xeKSD-Xfi6Siq9Riang&oe=6A1B02B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzPkCsQr4MMQ7kNvwFJk_dU&_nc_oc=AdoAN9cKvDtWWGk4HFLs99fJEvrdVh7CQUPcOVLYo90xoPMKybRMipKqaOEvbzMMwv0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aTt08AoLivtr4eCVtK5CII4ascrNnC6PdION3dWuPeA&oe=6A1AD784"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
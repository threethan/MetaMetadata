_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhXNtHo5fwYQ7kNvwFWzHHY&_nc_oc=AdnH9diSISPgy4CVYy_CuhJkeDk08NxYPxiUf68uAGW5_Xu0BhjpPZK7T09wzOg0_MU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYVLg0a4RR4EpweHWRyIaIoG7ZxMQwif2vrvkjwpGHNQ&oe=69AEB8D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8Kfbo6828kQ7kNvwEeBJkt&_nc_oc=AdmJmRkdg7yH7rGcK2Sf-YzeuSod7KQc3Rg20-NzQu4WP21L6zMM7EBqpAZaUpcx_F8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSNXGekvLyULNJXNeHHzA-lljsC4sOkTzWuHUxOqtl-w&oe=69AEC19C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnS6St07fZAQ7kNvwF6-u1b&_nc_oc=AdmRewYuGmtb3C-_RRtacIL0xFUadnPN7rqDEct7Uspuct9MiSHFWgbdebs6CxeB8fk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjJJMj-PKcCBbqK5VjMK5M64utpH9HP_tyxKepuraM-Q&oe=69AED2D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNKUoo7-Gh0Q7kNvwFKrFhI&_nc_oc=AdkUHkNuzRA5Am0X73EfL8xbHsa-TWCxYzHG0xC9U3kTT8HPw4hE498bq6jCpMAfQOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5m8vdzrex1I0AA60ciuABoYOdT3FzCrcTlh3lnYGS2A&oe=69AEAF74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5HF71Ek_VgQ7kNvwHx2Upd&_nc_oc=AdkzZ2ENEBEgP_nsqfpCqcsP1tECa7l5Wz8GL9zpEqCdd0w13OPwn3buIszSajEHLCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr61ZqFMNI3Clgid1VX3UuHfZ12Y26aCXblZRvcOe4Yw&oe=69AEBC84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WCCBbjzpxwQ7kNvwFMl1IO&_nc_oc=AdrlNTBnchztmtqFW7JYOmBgvUZPCJHtQBHubYEuuCy14h2cNkYqXSRFAYkWMDl3eCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG50NfpDhJFjbSW17wvt19KN_kBTqWRFYdcFe3puolyA&oe=6A493099"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzmiYFPhTiEQ7kNvwGYXx6N&_nc_oc=Adr7HW_NuskR7BfZZ_gflVfcC2rjVAAUC7ZCcC1aldLDjnfkAMW2rEgh3G5V7hPi67g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg8R2OISYOGMOHEnbAApEsDyTuEfH7x2cCr3NRuzfHYQ&oe=6A49011C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL_EYFMVGCwQ7kNvwEfWl_N&_nc_oc=AdqILdkc75jKeIIPeo3Tca3XxHB9jPcVK7f6aoWMewhxTGOFa8gr-QvywGcGdakigF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLeCi1yMRJEhS9KsEkhFoSkFEQ0yemDSXHakELFyrUQA&oe=6A491259"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fUXeetMuqYQ7kNvwG_5xw3&_nc_oc=AdrgSvzyhqniSGLsEn6lcWHJZAdWDcoq5gMeZfL8j9EkXAQmyvwvCBrAd6RZkF7Pz6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcQqQfXUjrEe9rMPxU86ybdT4VSJgAbOu21eNhFUHPPg&oe=6A492734"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHWRR0uNhlUQ7kNvwENsqea&_nc_oc=AdqJ2qtK4zjYoq3ycYMLlbeH2ZlHUSnkSIvpYIGSAGK53jgoxqzXy4MxzJq6302fv7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHAVCq4lu89gz3JoexwaIOR50-e7lnFDWu2t5TUJokQg&oe=6A48FC04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
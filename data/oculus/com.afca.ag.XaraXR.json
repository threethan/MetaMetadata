12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7xtHcJPSyAQ7kNvwGSewgL&_nc_oc=AdptVAG9Qo7bbf2yzAjIcEw8CgvswMHfKzhPP2q9bnxKIvvWM9PlX0NEBW365UQ54UY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r859U7Hoz0JNYT6DUzV9hzYFrMt9pHU7R4hbZgJVPtQ&oe=6A4503D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Guxai5GXun0Q7kNvwEY4ANK&_nc_oc=AdoPogXz18GO9u0Qluu5hWFdz4jYM6o8tFEHMUHT2M9PenvvyZ8d7EREfM4C9VtesIg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lavMo4-AEeNQaNfmmD-hLu1AnNlHYiD3KhEsHuu4ruA&oe=6A450C9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lQGqqnrtWEQ7kNvwHOjB9s&_nc_oc=Adr5v5pTDNfXfHk2b1_Rgx4HaUqLzDp4rS9YZSG-sNVAkfrtE3YGah90pJTavfuGPIE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95F-VMObr9w6-RBffu_fiXa69wWL4PkUXiG279-a27rw&oe=6A451DD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAAjCvDnitgQ7kNvwGSvVM_&_nc_oc=Adq2tqAXJQk9h7vLNJGmWIoeKnTIqkC58bMqzoTkmUIMahO7fm4ml6lj9POH9GckAxI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nlp3MZ9frEHxWajQ3SZvDwC4mVBLwV3NWov_FVmk3ag&oe=6A4532B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P6VDyY1NKwQ7kNvwFS9W69&_nc_oc=Adq5k6hOjgyhoG-WqUqyh7u4sE-dL_5yjK-O7wYoLOeNjEIdjAqcEtOE5Es_JS-WGJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z89h8j8rxES884JRsSA8kWux3HyBV-dj4B5qjrvlFPQ&oe=6A450784"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
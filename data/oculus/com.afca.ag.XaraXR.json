12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=few2PHFYOtAQ7kNvwFpYuAX&_nc_oc=Adq1TDPGPtGnuKJ-b3tBCplOVkddPCX7vIQlcMybqCXl0dKobrxI2BZOTAL4rwlO0Bs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ia5n_JW5AqYeLV1_SLNakxNT-UAHLBHf_ldZ0UN5n_g&oe=69FB2FD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h_rDLR5O5gQ7kNvwEaZKOw&_nc_oc=AdoxhSNB6c6_R4q08yk9Nr-9AOfe7lWcG-7bGZ8f_uy8MPrGoRTdpclYo_YjNvWuAfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71_2QbHmCvoVMLa24DRHIJsTtGi00okqJbUB7_S8FPJg&oe=69FB389C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU-sSq_nc7UQ7kNvwHQ3vOW&_nc_oc=AdrCVbp0lOOHOqEpm4IFFXXh7SgdRviNJtkJvJ2kXF4X24oGCGxbFVGxyv5QYgJCi2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vLigifBcD6NZuwN2CHVEkM0L-1i1s5B3lwIgc7esjVw&oe=69FB49D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DktRHzhfEkgQ7kNvwH64rxj&_nc_oc=AdpHtD5tU8Y4H09bVfQbwptcvF_45gv0RPjmdUktQdzNv0mPkcsua4qjcElsFbiBt8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af606QEFNGIGQ4oL9F8AAx1LO5VfLdh_Ur-OxAxLtFDXWQ&oe=69FB5EB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAkI75InAioQ7kNvwFdsfTo&_nc_oc=AdpS-cvf5uRsnvjlLSERJtdnG662SaAIUqAx8uqN9RlNlwrjhRPZyrXCOYC9lnskNRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_bw-rF9RY_QjwWKxkOQhvqv_UHeT8js4c7DV20qEJWQ&oe=69FB3384"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YJkvwxvXX0Q7kNvwFs3xIP&_nc_oc=AdqyuyDlQJINPnKluV_XmGDeXNkClpo15KiQQD8tvtJ1NYOGDpjJ5moLXKsBD06jgcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HafmPFKuDzCWuM2rP4GHEc9YmyAo18OS9f6IeodJZVA&oe=6A1DAF19"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyeP6y7-It8Q7kNvwGs7LG-&_nc_oc=AdqtFTuKNsTzXMO88hEwYroENF4LlrVZyiqREzhzm80vKIC3mVXRzNvGIlv44e-pcdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y1rMbdX53MFsGcEeCCeMAb3mbMf-NpiJ9e31nukSPpg&oe=6A1D7F9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJBE690HE48Q7kNvwF56UU8&_nc_oc=Adp5e_y3-6FKjt-IwTzLTi6bGiZw273UC_XXm2UEgLEMsIljJBMpAtbndXXeyMuzl2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48p5qvEwrOQyDGw2lbUZngsMLuiCq6F9J4auNE8iWiYw&oe=6A1D90D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IGsz6TFZowQ7kNvwGjcYqE&_nc_oc=Adq2POaZgE2-WIdro709bfseb0pktj6sbrX0Sg_uO1yrkuAULodiIn9_JBIGqiFy8q4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zf-9nqXfxzmZnXuv0_NffzX31teEC7XdTxuSnFlYppQ&oe=6A1DA5B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5h4GtG-5vMQ7kNvwElD6aD&_nc_oc=AdqYFss8Tj6N6l712f3CO9XpY_-KMCrqDjePPUBu4Z1XkaQKMTojqCcJGxnGIPWuukI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oF-O0RSF63DF23J_jArF4nBREMo8i-DoY5QoEvz-SwQ&oe=6A1DB2C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
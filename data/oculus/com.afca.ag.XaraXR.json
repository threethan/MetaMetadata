12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H0K-TXNhMAQ7kNvwHNWwq7&_nc_oc=AdqgFjXvn2DiiIaKlseXrJkirdpqArv-D8aTXbFWoLGSGOLNqK1yfQA5oXx4UHwq-w8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgsF0zceuEQAMVzaNg69cMBsQxkpt2fYUb8W9m6BfdQw&oe=6A7F05D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gg0atwfFNoQ7kNvwGc9nTq&_nc_oc=AdqiiI6ZH1Uq2tLN3ebYF89ArxZ7Jef3EpsdQhwL6U7lqZzU16BKx87luY4vLWlVKX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERVHRHsNbium4n2N5yUP5Dnv0MEs6KizXvxJZDEDb39g&oe=6A7F0E9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X4Gm9Rdbl4Q7kNvwFdW3mR&_nc_oc=AdoMN_dazJo5iOc9FjvIAwEtVARCNeUG5givr4rnu-lzuwAsJLrSeE476TZtRBerCkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb4Ex-jwy5FZVWpnElFhocth4mKTlBtxwpufGsaUCw0Q&oe=6A7F1FD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JulN3I8QDEMQ7kNvwHz3BuE&_nc_oc=AdraW0YFkBOKlAzumNxGpkzFo8N-0zg5eLivuo1KmnA-egovoXpvH8GxQFmhziNf7o8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhgNaccjH2gsU7UG1QZ2so9NW_qhxBFKKzOnIj5AszrQ&oe=6A7EFC74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGZD79QUNoYQ7kNvwGeoLfC&_nc_oc=AdotF58-qGHGn1UOoi1OfaHNMXLPbLXRRaOjI5EBrVw1ijYA_hbXQOjFZhk7ztxYAWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPyjJGC9r0vVjTiutj2R8Zj2numrsylv4lJpPnXMsNYQ&oe=6A7F0984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
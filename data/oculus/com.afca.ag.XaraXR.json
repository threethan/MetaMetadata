12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS1fnxC6fPgQ7kNvwFUfL_a&_nc_oc=AdoJwTgo9Ol8UI3hW3nD12PlT95R4BubmV6p6RnyD-_xo5H84XgLgCxZ0QW0jGwK7MI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bM3Rm2Q4_WYCJYd09kB2_R_Za7VtK8U0vqWoEKmaafg&oe=69E4C659"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrDkZIjdqqMQ7kNvwHqycE7&_nc_oc=AdrV2KbctUfWcEtv36emnrzEiRsVw_8K2t9ksMxNDHaHQGKQqOhtY3p82d_uJLmmVL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sHcJfJl1NcK_qPIv4CaM6Ecv_jO8IpPFnN1sn-0YC8Q&oe=69E4CF1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d07r2HoxpwMQ7kNvwHVcvVW&_nc_oc=AdqmhworuE_CIwZLu5mZS2CyOlRbixnCrcHAcWjmHEM4AKgL3tfuTtEMAMFb8YxAXXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29lLsI4FtbiCfN27AhLs9HetCDydeQgH-50EjLPQpkhA&oe=69E4E059"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dDMSPqzPFIQ7kNvwEWpqkb&_nc_oc=Ado34yt_HJZ6R-cjJjQoEBufCyUNQg7a3pasfBhUKdFKOfcl2LVJinFOe2qOw_Qz9e4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JO1wuPTZn5ipzFjcNOfBF0aXS9wLrdcSmr_F7ewtbRA&oe=69E4BCF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ln_VjQhC7AQ7kNvwHzFskH&_nc_oc=AdrifrYdXwTVoRK8VrVKRs0DmG3HysZ7iL4zM1gMheym47LDRhj7ykQ9VyOgVRiFY5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32IlsegRssvs9KTmxWX8uKg946vinacLZ3849e4slZzA&oe=69E4CA04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
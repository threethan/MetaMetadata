12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=few2PHFYOtAQ7kNvwEQd2n4&_nc_oc=Adqc-zxlfDVprIsAT8tstUjCfCa7NbfHXf0nKBI8AAfckq17QfNwX9rTMe5RHyDscGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ybk-YVqAOA3Wddzzx3BW_DSReosJTFWsUMpHYPHaXTQ&oe=69F9DE59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h_rDLR5O5gQ7kNvwGqUsVC&_nc_oc=AdoRtyCkEoKSZpj6v68eEOBYAJHPAv8M1CMT0J7J8D6JKAACIKskl77q0mNdDBQVaf0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EnjW8gZL2l5Wwcfm7P4NpqmrSy58S6aUw5gZjsLC__Q&oe=69F9E71C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU-sSq_nc7UQ7kNvwFKZGHC&_nc_oc=Adp8FdHoqNJ_NryIkt3qPL5T7QOrw3O0Dfvqg3wkGNUQ1XWMrPyhDWQvDcnexwzDd_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gei4LRNyZs_jMhm7YYDmuXYHDMxaDeN-9JdQw6BnVpw&oe=69F9F859"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY_xs6HIdAgQ7kNvwEfkO7H&_nc_oc=AdqRC3Q7iIAbWrnmNdjucO5nfZ8ohWtbg739IO731X20FmxPQygZhIIOt4ShIGfGSPo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pd_1wmzfXuip8cE2aTHkYnS9hYscq2eyd2psaIIUzPQ&oe=69FA0D34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAkI75InAioQ7kNvwEwyuY4&_nc_oc=Adq4BspEcnPq4M4jQS4NU6rqAyy-t4N7SgKwB8cwsLq67H4gP7El0n-__pGNlr7wl_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p6-qx3oH2ldqBeuAJwQyKoAX_qEJg4Wjzlq5xvQJnxA&oe=69F9E204"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
227612_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grkcNiMA8WAQ7kNvwGKA_W-&_nc_oc=AdrNN5K8_UzK3rKEJ_Iiqz0wMehOyaMm1r0Dc8_Sifo2kosDMzcNQqiYyhisFQK9Lu4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiIeARTPcTLTraf5Uwud5db9rHqUX2u-zGL4uu-g7R2A&oe=6AA3EFD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5z9sWK7tKQQ7kNvwEZmsFH&_nc_oc=AdqDo5Fv9Jxy5CGNayr3Z4e-Ov6kcUzJOA-Duodh2ox_-qxR2m4gfBz14soAAIkEW60&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFjhSoFkAXgFa8xv__qfUB59kGDFqVnexftyFhbZQUQQ&oe=6AA3F89C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eynpQxPVAY8Q7kNvwFcnDdq&_nc_oc=AdpXb00_b2afnufxoqXi5-snX2Bvl5zFZZ_I76PO6g9oTWggyq-XZ-5VyfGCcClnWyg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhPdesjT0ktpWonPqXt8SPo02xKY7e7YYJ0V6sV6lAxQ&oe=6AA409D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW_DBjGi-7YQ7kNvwEQEOTg&_nc_oc=AdrRwUGEIWqwBFuW0cd8xLrZE_ADE38SE9oAUDzFJh0CMV8RBF_3cMG-BnWx9MrXzzg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItVhsGWBKUk8UEU3oHeSBpqvLabiMpnDdI7ocgF92AwQ&oe=6AA41EB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afgPuFSo6jcQ7kNvwEE8kAe&_nc_oc=AdpTkyjYeAHFMesBs6UFMcs4SGxtR582WusPpUPiVH-FXY2YZC-0V5ms7gK3I-8G_LI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJC1-1S3kZl_i063UvvJL__qPJ8abM7gSMWoFo6FVia2w&oe=6AA3F384"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "51408770786878
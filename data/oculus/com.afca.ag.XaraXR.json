12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOr8_eqK4vwQ7kNvwEeVlHp&_nc_oc=Adp3FS-jE7x8_Xqlxkfzkx6_gMhp4vzEEd4Ne3rbgyVXo-QOJq_AwJ3eWi9Yu8V_plg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnay29t9OOycU42zhdhqBJQxdu7R6_NN2Tbfu8dW9B7g&oe=6A844BD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61mzW-ijbjEQ7kNvwHJ_QjE&_nc_oc=AdqSUsilP0PNRNLL043N8Lqv0HU-6m0oxjssbA0ekwKNI6lA7HthuMGfKcnl7mobPvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-AO7IV78mFbx-PYiOijMncj3ucLFj14-XE4USH0_liw&oe=6A84549C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kReGNd2ODUQQ7kNvwHU0bdg&_nc_oc=AdoYRFJCflKTm8307rkYzLBX7FA1FZ_K7w0G1R5u4XjRICVfMkhrY_n6K6jJnK_vQUo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHixUk2mnIJNHcwHy6kECWNoqKp69D8PA4uK2D-cSmxRA&oe=6A8465D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlrjWtaOyOcQ7kNvwGzMdU2&_nc_oc=AdosDQfVTOdB9eDBRjPkBFvRx1rYVisDcFPrjwYVlOOM-C5DlWbFlWW-5Osdxopml5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn5GFxczevlnp8NhMpsQdasWXOxaW4kazxotnycpkstA&oe=6A844274"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j183TgllGP0Q7kNvwE2KWbN&_nc_oc=AdrvlfxrmngZ2mTexZcORhta2YyoGFhixJh4xcjThbdw1mIctKCSzpUALHNL0Y9fLZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUtDUB0txz82MqaXUbnzonRw0iJp4smWoG_grqNJexAw&oe=6A844F84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
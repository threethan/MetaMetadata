12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKqhkJ25_TYQ7kNvwERIC8K&_nc_oc=AdrcCSjGpo8myUCHKmyJS5Esp2UJ2qosaUbZOJPLVu47GYOFzlJA4xCiwwFFH8Kd-70&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6K2LOmVjoERMGlT3R7rqlxzTZowSj97uKaK4jR4o0vA&oe=69C673D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRypvi-Bs1EQ7kNvwF4BMWP&_nc_oc=AdpzvqfJ7VYoj_DjS6_DQeM_tjZBuPB9zTYgQmo2ztuZWo0tXuQKZFeO3aY5KN7Z11Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqO7gplhteHBtinfGE8z6FiY1iJWjKTOU9GgKEL7F1Yg&oe=69C67C9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miKMLEqc_2gQ7kNvwHkzacv&_nc_oc=AdqGDlb7OiBv7EWzexVlizesrAUgy1B-nYl1MfVXCpe4HFSkzrFHYMZd36-BPOYH3es&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlXp2jMo4onMehOm6uKu0oldK07sQSeL4JEyRE3mWURw&oe=69C68DD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=th1L47XMAQgQ7kNvwFIBF_S&_nc_oc=AdrrFgzGx4z4EYBHh2c-8TDBM9O9cn_zcxy8_RzvZRNWaRrw6nbBbAJLU3Px-N_FlVM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzzf53gJcKIdab9Zsp_4_7CIhueogtb9IhmbrJNS57xBQ&oe=69C66A74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4Cug20vhqsQ7kNvwF5aOay&_nc_oc=AdpiGjevZQ8WtuzpN2c5vR_Bh5mqDIg9_vvCbSElRFvT3opyoBYyPF0ZEEoJZirdjds&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAgfPnoscR4H9nHhOgV8oOw2DfmotzrMhTOdAN_qh_9g&oe=69C67784"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
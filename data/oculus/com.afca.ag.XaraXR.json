12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqwBVbh-lxIQ7kNvwFQx9Qp&_nc_oc=Adoiz3MnXs2NUnJHhuaZQF7PREnlkBa6v0uzHy5uoc_wajNtbRdlmo8eVs2RGIlt5-c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-ZXIlFk1NV_c2watBFk0qHeDwn_LHFVwscqwpXCgHoQ&oe=6A32C719"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujvsbCl33gAQ7kNvwFglM5Y&_nc_oc=AdqXq1_P9urGIlwR5clmBtVn8OddRPDIWy8OLl7E5YtC3ZUAOOXbSUgyvtODQIV4I9U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1zPGB0LolrSkcQOiavIm61R-BxXH0E4Hdhp6cusyUZw&oe=6A32979C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6GMazYih4YQ7kNvwGYtAjV&_nc_oc=Adq0h_yO6Zmk-WazEILzBgHsmgkbafHf3w6AdYPDjo-9KTA4KyC8TJK8k26FV-3_t-0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98LWFXV52tUX5HfipC7WeEn19uh-LhMFPGnX3GnRKZdA&oe=6A32A8D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wzo2nrXTgZoQ7kNvwHsvXm2&_nc_oc=Adr1IIBicNoEHYcaqDuoM8RLCnsU6cP2BGvL57sesTnJcRn1uUc69Y5wI67irIAfxfM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7tpVRyXOBopgEAX_6XkmKQDoyn1ZIJAtEZNNwvKMmzg&oe=6A32BDB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiVacWmIiv4Q7kNvwHD5NCb&_nc_oc=Adpf3kSdrIq8WXKaDPgOdBJsa0KX7_Ovmxp_6131fjyehN8VRe7tmGo1C1RJ1urT0Pk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1wT9K_4CkGs2cTeUiUb7kytNKGc6OaHoqEVANWA4bfA&oe=6A329284"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
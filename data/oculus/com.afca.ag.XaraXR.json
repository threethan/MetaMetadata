12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTji1nQRDaoQ7kNvwGxC564&_nc_oc=Adp1Dz1UuZ6nCngHKvGKrUejWPjfAdfmILfhc0I_VDWrs5fMtrRI3nNLu9PULkhtqaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0uaLcsS-24G1S18SrYX4oXbX2aL2R4QQ3D6BXqUlOlw&oe=6A4F8FD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1LxPIyXot8Q7kNvwF1U_HF&_nc_oc=Adoj6XfUhbZHvW9lUlNNJxXW_GKZLxZjBn921pd9JMMKrcoNHGSJIQlac_uTEnWugq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB005HLIRQY-9datZWHw1l-KrTfQh97Up1bpDazoBmroA&oe=6A4F989C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYhy76g_ZEQQ7kNvwE1pwBq&_nc_oc=AdpBwdsZSkfKpiGt2YVCg5jh5lWXvQf8bIQUg3h5v-y6KR1OOm-wlsXficJ42mkxji0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGhLUXNf8tg8XynDYTUCOVVsSFKdkQRLUlj0KaTjT-ZA&oe=6A4FA9D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjht2EjsiJ0Q7kNvwGj_D9g&_nc_oc=AdoXXIINolOltmJqRnqJqMhdumTSEkLOCSWphiIggrJgBZgh6m5ZeR1S97v2KXEXC_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhgaNDI2rV2vvGxWgnngVkSclT-Eequk5VSDM7Dax1hw&oe=6A4FBEB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdmjnf1VoToQ7kNvwHcAJH5&_nc_oc=Adr7pomX-SBMLYAHNkWx9P3rEQhzGUs5NRrT2oXs8Qz9m1lvBVDIkB9MJuZ2i9hUz80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZGU9FwuXmcu2O8e_PVS8deiPMBti52O41ZLK-IqRiNg&oe=6A4F9384"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
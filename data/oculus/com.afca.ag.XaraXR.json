12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVUUrxSYVnwQ7kNvwGmVic9&_nc_oc=AdpwHosq7GuvuzVgZ4uTopxpbzz1pa4_IxzO-0osXKbgJ3WnV8IHeoXod9O1hoD4iZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06u7sWYA-hDxx4tAMYtfqGM5KMtF1Q69MI7kv0FRT3bA&oe=69D8E8D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZqEVeiI-9MQ7kNvwHlinFN&_nc_oc=AdqNp0ybm4ukBD01CNWYCoHiRIXeh-CCS_lr69XcNPZUobUuGi6z_nlGXS3Jyh4ZRwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u6g-91Nej23KeMPxQWZr7jvPHdkX9xF9bw8uce1ea8A&oe=69D8F19C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6RbmnAwEkwQ7kNvwGuFtBw&_nc_oc=AdpJ0WGgVsAJnDR2O6PdxsQ6zbCZZ4fXeFe4bdlvA2qgLSF1CSJH1NNmhJ8wi1u3Alc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g0qCEiw9WzcPC8eEjLrV3BWQ7lnS5ZcpcXskiy4e8Lw&oe=69D902D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UFdfz2R-LUQ7kNvwEsKN3L&_nc_oc=AdqGlMES4m9jybHe6Ft_1npPQ2HOfSaxt2gpj8l9ddoPyaHm6g-qyLbmm7nNLFlO3Uo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U6Mwf-KM4TIKpy0cGQz9GsLStUcQ3UJ2xeGNWtBWU0w&oe=69D8DF74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uah7CK0_ncMQ7kNvwFZpaAE&_nc_oc=Adpl9aKwHsusDycISDorVxIh-GssvL324oL3d31cVYB26OZgc3woA7ey-9bEWBFwwQw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Hs-o5bYpmXE2iQn0eXg3yR_6z2gUwNTT_uhVHgYHQLQ&oe=69D8EC84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
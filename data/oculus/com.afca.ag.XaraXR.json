12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4Yeeu1jV_oQ7kNvwEudp40&_nc_oc=AdqnxORzzVT6vQkUvEBZjOEtH4ACApdeGO_cl4siDdSud4K2hRlhNZznOKG6vzKcA74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUxJGesxZM8Un3G_DZBTzzEi3leIbfBB9lu2-xiXAI6g&oe=6A5232D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1LxPIyXot8Q7kNvwEZ90LH&_nc_oc=AdoDkZ78tDa0pYBEywPQtJdHn9qQdFMWNVxxvrs0HrJ8rx5yia4P59XRgMTsx1B-4Qs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIfVeZ_DteIiZa1ZMJVoJVPN6a3f2a4L2FKfO7YPRQsg&oe=6A523B9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYhy76g_ZEQQ7kNvwGtTgdh&_nc_oc=Adr5Pz2owEhmJyFgX5s6yIdob4qblyveBGLjZHaeSS5o1jLOSOeI4wiOnzhQwO2nMtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMJr4ztWQMZ8FaHkWR-kSC6k88SOkHCvoERtb25Eypew&oe=6A524CD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROHqcaW-bwIQ7kNvwGmsGaG&_nc_oc=Adr_Jf-ldlWCbcdoWbQaYpWl9XjndG3doA0zqdNFkBgTvKo1RuRmmyyAFFDlPQZIqFw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB5z1s7KGk1F_EuZbS314Q5uEtBMtYw0BaSSqWdizGwA&oe=6A5261B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhDczEsy2XAQ7kNvwHchYje&_nc_oc=AdpDfWScsSr5iLVp9t2kXyqFdGoSEnFYG9H8iaSmL7bs9ET4JPYQz7TQcBjs7JJa_1w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChA3US22lzlx1JIINCILneJiRoXb19OTrnMJoSkjZnOg&oe=6A523684"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS1fnxC6fPgQ7kNvwG1_fjC&_nc_oc=AdqF3YzZ6yI0-JcBs4U-JeXdsQQA8s6hv_q-BQJFQRi0Hn7R5PiGJLQly_4Pzu-fx7k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00fSIJZfn-K0eIS8CK4VMePALt6mQiuDiTlQ3O-o7Ctw&oe=69E22359"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9-L2xTbe8wQ7kNvwHrsx9g&_nc_oc=Adq6TEI3DPsOBVqY2Fi8w3UWNGHq8AwawsR8o1ZOHdJWWrfw_D5be5W7aqMcgLWJNIo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EL6JBjEuOvbVZ-BH7An9e5d2WrfrRXwnsdsPlHT0VCg&oe=69E22C1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6R9pPEhcdkQ7kNvwFv1WXd&_nc_oc=AdovxQi1I5y9uH62VC5nbEy80Dt2lerGkDsTgq6t6u2fpVI3SzUpWhmMtq-2abmI97E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UW2XrtHL_ak0pd4Mq7kn6tfCd-jIBh4n3n7fv4LKflg&oe=69E23D59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTlb_U2rgn4Q7kNvwEv6a0K&_nc_oc=AdrtB-_Uh_BFa3_KHHRm84MonyTw793hjrF8HrhT6brXg_2x6Ue13ORPPHjn9jvZIdk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3E433pnCGlfl2gkfptd59AKT-4p7-3LNBXMo3_zGQlyw&oe=69E25234"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ln_VjQhC7AQ7kNvwGY7W9f&_nc_oc=AdopeH6jxEEuAKJBhZ7E9w0uZVmZGxq4oHgWeW3frp-3X47W8PPVeayIhrsR5LNiJsY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04qM0oS7kufJIO5cuby7piM5V2dYAr4WXpo8gacscnQQ&oe=69E22704"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
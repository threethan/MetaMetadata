227612_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YAnq5-hcvMQ7kNvwHqWrYt&_nc_oc=Adr3rl6FwooJqJdS6Y7PoFB1XHmYMQC36kPkTE6TVEYtPiSVAqAScTt6bjUd_q3Yqv4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpHXXyO9kYthDwxBXv1TuraPr7nFqRBycYpRpIisCzcQ&oe=6AA935D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIqrqW6cW8wQ7kNvwGZz146&_nc_oc=AdpDXfaxxX0BA0SMnYAWyYjcoZcQldF-ptJEvCzYjFWaFU8TKSVcZTMBM8hn54GtZr8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIthPPnrDERJDK7cxMCVv6DRr5Al1v_KMqxhaFQHTwLSg&oe=6AA93E9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r53JjiU-dxwQ7kNvwHSOyYM&_nc_oc=AdpYfV3QKgqZCaDFsAwkGOsTfO7Fb7IYdcL4z9PJCgSzz0tRNBHeaOG9eRTNepBocm4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJJjNCdFFdZ3CF-2F80wWt7pvnBUdJ5HM2aylVAaMFYg&oe=6AA94FD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xDmSE8x00wQ7kNvwHqBxEL&_nc_oc=AdpxDSCNKBK-KrjABUAuvYI8Xqmljba3BmeN8FpoONmrCwVt0qv-031H3gGpg_jb3P8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfg6XHTnQOuXHX_aLPX9Uqb4FNENAxYJBlHWw8mmStJA&oe=6AA964B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3PFMiYaY3sQ7kNvwE438jS&_nc_oc=AdoSWPDGg4BMpRVewgkevf5gZh07YnfNkWM2rtOU7INon-15COCp0qsdeNNMjd6Zrw0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1StFcSSOZEtIxJdBBz9ugUhSggmvjXGuoIdq1WKkBvA&oe=6AA93984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "51408770786878
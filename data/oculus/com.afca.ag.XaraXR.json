12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXrPkxdDh60Q7kNvwG55y9B&_nc_oc=Adp9cEjjsKZ3z9VdU_uie2GlylAK-8KF_stExBKpRKtIysv3DvORrOmLoKoRIYhpbt4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sSjujOCHP1yvESXIuVlB055LuijlcNcjySQpzKzHgrQ&oe=6A0075D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcckeCTTAUEQ7kNvwHm7Kow&_nc_oc=AdoBfpd4vT_qKXgqgABBozq5oDID8UkfWW0PNxRd-GYBJeAAYQyQ0dcWKCeDvjpunXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DmDVSi6Ts0Y25_nVdInwFgyN6C7EDm_Fra83olYpzVg&oe=6A007E9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hGnWZqry5IQ7kNvwGhRddw&_nc_oc=AdpjsfbysbxIS4WKOLP0J0gkxcbLoyy3-0_K3SPlrdz4_YNRbTcOTT6m4rAtDZ-gnbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pa4G_x7LDexHRDmQZiL-s9HWnUzglpR9Z70HC0EjVew&oe=6A008FD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekIWzOmwc1EQ7kNvwHcCHCr&_nc_oc=Adq64txmBs959dYYyb6By0j-WBYk8E7KB8-TgOE-vBh30pcUeDGpgxo7C5ISLWTKu18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4evaPehdEL9vZVxXB2h4zwTW4YgNQwJSknA7m5TKIgwQ&oe=6A00A4B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG4chgR2vUUQ7kNvwGhyK4l&_nc_oc=AdrQyQHwzIbYA7fbc5TaBtglYemqAGApeTsC6D30aEoDgtI07FLf7dfZvR84obngS48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zksVhZK1oOrShLZWUtB5JYSjv_ZuG0i0IizZaHmY9ug&oe=6A007984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=few2PHFYOtAQ7kNvwGrgxqE&_nc_oc=AdrWizWLLu5i1Jq_nl0CngzEQ-ENOSnVFPDjh4Zn6gJi88J-P-wt_SfWWOthZiZDV-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65JBkz3z-A4r7ArlyfvVvdCQIghCR6SGX4maQF4FyFEg&oe=69FC8159"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h08YRG7JBhAQ7kNvwEqawPi&_nc_oc=AdqGc74QFAQ_ZhFDJAHMGAWQinslW6wC-RglooYdWtPeo_p26xBfV1HWJwEhLBCUO5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XpnpBFOEphalNx-7aQxppe6JiIlv6FCOdOJ4dNwdzUA&oe=69FC8A1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRaWCuirvm4Q7kNvwFf0-Yj&_nc_oc=AdpOWqgB60TcfDxUq0S0V1pZz90p7CgXnjmvt3OdMcJpLqID9MCkE6_9xXOyUa8JPbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j4yJoFTmINBPUOYp_MNqtW3Vpgl7re9ZIHXQIjr2t4Q&oe=69FC9B59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DktRHzhfEkgQ7kNvwEnCsh0&_nc_oc=AdqskO15Yx41Lonm33huvoDzXsKvkv7FxXk3ANzrZ5V_-rMt_C7MKNfvzlrs7dPikzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77_b-1ahAYP3fOKl_OI2XVzwgf_jPDO7x7CITpKHvmsg&oe=69FCB034"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAkI75InAioQ7kNvwEBkV9a&_nc_oc=AdrAJpWXT3L22X2vzrI-B_iPcI6_TeqtXLvz8p-nAKQwTrxlvp5MGf1Ref5es1gk-p8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rlt_aU7R2c9a5xKZrl29grtjke7mbf98x69ix5ABoEw&oe=69FC8504"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
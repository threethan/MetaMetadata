12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z5wvdk_ELEQ7kNvwEHCQMa&_nc_oc=Adpu3ereTN6YCRPpSy4uznWobYMdGkqUBlO9jUb_jPbOZ0UukJzygAqYd3iRIPyKKIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTr6HeGabV3muK7MCHZ2B1CJoY5uo4s53nAb3DSetM8w&oe=6A635659"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_f0byVQrkQcQ7kNvwHpBw0P&_nc_oc=AdoiDJIK7Z_njwtLTgqFDGJJ7KxwAn0-67IY2qDH7eg3DRXnIlzLgJJJgV5BVzKySNM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBOeSN4dDW8Ul-Q91VV_ptRNsmr9-_-aZvELgWI_517g&oe=6A635F1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyHsaOuNOmQQ7kNvwHoDhnr&_nc_oc=AdojL4eCRcW0WE32EoNUSOx3fjW9X5-TTsxv1LoaWohe1HUbfaPDfOE2kWjKek9x1rs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz0QS6naKYiaNjXsmb9UA-kYNHs8hFiG4DEr9IKWB8Xg&oe=6A637059"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGduk-yANhkQ7kNvwGgxR8o&_nc_oc=Adr9aieCEwb0q5z3POy84Hnxom5_wohq-UJmjyiybO09spoXEgsyuvtKIa_CsHi7wuw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPkWLemGKYbiPfr1SSmUsXFN-KOIs66qD--Gd_Ing2Zg&oe=6A638534"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XahdnYVrXHQQ7kNvwHRKIDS&_nc_oc=AdowsddQMw51pY1KxqoMGpIfwiD_jGdHAufp2pniROI3e_wZ0YtSlOkCfA1Z3b0PjWA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBe0YEjr2jvELOrAehMf2cTKdXDSapqWYXzWx3l7x5Fw&oe=6A635A04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
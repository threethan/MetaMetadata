_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNz-S7k2XzwQ7kNvwENOvKS&_nc_oc=Adm3wGfMBPPtN0ekWOCFl5yqUQtvAT5vELcJ0PSiWsCECeAmHDFk4mNL6DzdIrrKLBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-uvexhs_5Cf4ECpqQL37Uvf4B2RiMPkGuqHhxkgwjMQ&oe=69B55059"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udqhy9Fc1wIQ7kNvwENU7fU&_nc_oc=AdljqQDVmJW0pYe2Zh-8ucAv334A44lXh_Bgfr-xRBm4T26FF6XSyUiro0pL9yQMYT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOFy69PqOW993fWbpua0yXweJJjvGoo01UBrl3vKQv7Q&oe=69B5591C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GuXD003kGEQ7kNvwH_CjWB&_nc_oc=Adm6XAoTo2_fCY1RW1bpOJsRHPLxeUYQUfz0m-pY7ebQjI2EJjuhVPkvuVzxCDJXBQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7HmBCTTuh7Wa1SwFcLmy42KVtBTSVF3T7C6UBxgSggg&oe=69B56A59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLqYQ78EFzgQ7kNvwEKQ-8j&_nc_oc=AdnZ6Kt-CdSfgLlZPFxnyOmoVBZ4B_9UnErp4Wd_fcZ-eibnBSgppz6LWhT_NVsVwDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVPX377Rt6cHDE3S0YSP53EBgh4Juy6v5raVKVtv5dBg&oe=69B546F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u44detXeekQQ7kNvwEbwvXK&_nc_oc=AdlwQNFQGrmJO6iWsS2rM0yOnXsfrs_44teGobu2_b5qWvouXxHjSl3tqq6ry3Ry3U0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU7e1gi6u8kJUPMud1n6z4MyuIyb2EBaSVYy193LJ0hQ&oe=69B55404"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
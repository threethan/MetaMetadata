12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxJ_bX0ZKQQQ7kNvwHrZ9Zk&_nc_oc=AdqHGtEfTf8IPEMNj5LtwAMMVcmWv3FKJp23Q-FIVxB67MuFmMKSLRmqNEUUrOFeNWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3kzSgRwGPvMpZV7kEIWO1xoutILp_kngQyqUZslCFbw&oe=6A7B1159"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg3EtPm6PKAQ7kNvwGkK4vb&_nc_oc=Adptyp63iL9E3D_WG01YHu4NmDU9fuoEplFgZ0eDbl4LHnWiRzqXpfD84wczMGtcnik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA_ZGCb7kvGVaEwFnOJEQu1aQvbzwPUYVPXYWPajwe2Q&oe=6A7B1A1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABaHyxdXhpoQ7kNvwGWtrrs&_nc_oc=AdoYkqWoQ5z7Ej45Y7UFb0FfXMqRK-ye7tpRN8715Szfvk9GNtrqtjjpuamXUuyqlrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGMKsU1_9-02lW2Hm8OqAIgmflYmZm6fW-xq76yh7J0Q&oe=6A7B2B59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu7xE2-W-S0Q7kNvwHZRZFk&_nc_oc=AdrE9uDY2v51_ut1y1smmyWDbvomfiximeOUluYkBHpQ5TkJp8_gS_sRXhhGNiEcaQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECuke4hhUJc5LxT8R8CuN0Xf2w--i_CRlbpDeLCpMyRw&oe=6A7B07F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttgLcv00F28Q7kNvwGVBkK3&_nc_oc=Adr4woQcWfD2WZU_XpKF0c1T8s3bfpLcfy1YOnqRjP8kOlZxvpZGAdFwZZ6FUBptkAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF4RVqKRIE_GtcHvBYT6Rs6s_2_liLMkwflGZHrAiHVQ&oe=6A7B1504"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yKsLvcDlnEQ7kNvwEaAX3T&_nc_oc=AdqUKDQl1V6iHyZ4RzTtz9Dnrq6cOZL_fg5iaBMpheac0r64CFUhC14vfa9WNB2hWhw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEny4uyD3J_aSHXngtsdQTzFnGe8FDEAfdAs5QVNLBtg&oe=6A5B6D59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIBO7eavROgQ7kNvwGm4orD&_nc_oc=AdroI0QfRmR0-ZEjGDbIZ4VcF4zljcf03Yx6uXtxRipVgy_rS95m_W5cJKVLs8HbIzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOwkwIFz5AF0NPoSf3hA3rQ58XSc7HKblMpymplY3_Vg&oe=6A5B761C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG7JbsdKlxcQ7kNvwHIgzkW&_nc_oc=Ado_oENgyPBiJ0JfLW-hBgBNmfcbUU0v9oN9HFLihUBBWL6IPNlc5loFTiXPIxxEXT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbZeE_aBljXoXQjHhgHYdU0VY_JbZWeCtlKrxGGkiaDA&oe=6A5B8759"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-ZE9DALr8QQ7kNvwGcDoGW&_nc_oc=AdqbzC5sr8O0AwFcoXxZbJ20OEnzX_I_6WUnGnqda9VjrbxbfU7St-YQOGarS_Gvx8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEQ4gHAF5i9BH4LMHZUZNS9lWA1OUIg_-5DhzzAOefnQ&oe=6A5B63F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewBET3QFDssQ7kNvwEwBPIU&_nc_oc=AdqzX29Ei063fu6Ol0aSjjA83dA29UUP0wqMoCeZia8Qawy-FBOkIsdfCvfBkzAsHiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgejB9-ZHxEcV849pUSsqGVvuUfyhm1foQns61pranGQ&oe=6A5B7104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
dkQe8PsZnn7pEkbfFIZVhGaOC4jx22cTJTwU8TnOfy1B9i9g-DVOFgaJlbl5ePFw2Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afstdr7-5hymn1uR-rUHcyCJuI98EFkfz5ORFY3aqDxDmw&oe=69A57E59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DVufLfDJA8Q7kNvwFCQM_8&_nc_oc=AdnMiQJSsd78Kqg2z5I_0PSHY4dnH74mpBxCuUOUtnBZQ0qCwHmeqqVR5vUtpGck1SA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuyxWRP2kmo-SSApbTJ6pBRTpfG7nauPD9gVvSzLBq7Ww&oe=69A5871C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNVVYOct0k8Q7kNvwGHT--g&_nc_oc=Adn1Oi65kxkikaZ_A6HrlsMflN9bRH3ItrM2neuyKXHxpXUUgHstTXHncw9FfXDoYxQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvu4Qia3zNnwVySPZgU4nZpFgd_7ZvwmPMcXInzXruGnA&oe=69A59859"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWER7o2_rrsQ7kNvwHXU4aS&_nc_oc=AdmFPVVQ3D1i9R0B7ZN9ooVkhYbUuUd88bhrVQIw9JlSF8x6MNPttfO6P2b5v5qJFRg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuRNg5rpRuc3RMVqWjxRYYggOEmzOPOgect8mcb_R25lA&oe=69A574F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO7pUxj28TYQ7kNvwEtOg-N&_nc_oc=AdmMYyeeiIUZqlQWMiXbgLfR1SRoslWyZsss2QwDaVPSxGBc7Cz_HbhpWQuSzE3zaZU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuRa3V7Mmw4LyD47DLuzSE6U7KEUVigUkmmOdcCmh9jJQ&oe=69A58204"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
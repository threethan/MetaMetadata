2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgBmUbmsN10Q7kNvwETOO-6&_nc_oc=Adp5x8rQncfPSa4YqwmNit1rL_AAYtnku1Mq5az3KSSVmkyBoExt1Tmuz_idPHYNMD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG5PIawZr5gbYc_-Dir1q7YBm7j-7JmTwFqRElSA_owg&oe=6AA29E59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5z9sWK7tKQQ7kNvwFs7fY3&_nc_oc=Adro3aBBA8oocwBjkOStg1_OlgIzSawZ1olxwMCjQNqQuvwts3-lwb7DDmN623JNAmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITv72kLvL10iQZkk3dIxblAy1MEErlLNfCobXL6WiaZw&oe=6AA2A71C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eynpQxPVAY8Q7kNvwGRgbli&_nc_oc=Adojbh64RGcutwr6Fp75lmJDll0ThNH89ZiKzB4gpRAh2zClIInkfwaIhA9dgFheD2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfBlFblONCJFB7BJ_N5cKS_srDd_S4Fgo7KUQcYD-J4A&oe=6AA2B859"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW_DBjGi-7YQ7kNvwEgBM1O&_nc_oc=Adq_3N98RnsTB8QYtlkF8L5TdWtkrzN_w_akM85RG0HH6Ce0lVglKSLfPiUQ0PitX6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8CjiKzF3XevP1H_SWktuYp0n0D4CLkICcz1FgFJ7DeA&oe=6AA2CD34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB3Vsu29QhQQ7kNvwHSkt-0&_nc_oc=AdpTvfPcqFt8MCLKv5aXwpSm-MBwP8Cto0XWB-sc8l3rDrgVBF4H1D7yTSHdPgQ0YQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK8N3GU8E1JBMq3vuhQu2ihxDplqsuDOpgYKkwZYl9pw&oe=6AA2A204"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
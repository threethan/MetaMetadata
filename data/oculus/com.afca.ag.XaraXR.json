12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBFDS3auSnYQ7kNvwH22nwT&_nc_oc=AdrZKdEC-VCw28z_jJJTSBCqvgdffwKnnKoxgflI4IW-P79vzC4iRQi-0QkfCmxqt9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jPqsIbecLi86f3yQzFTq4ksp4Hi57Fle5dUx4jpJnfA&oe=69DE2ED9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki608TBmoqgQ7kNvwE95H_9&_nc_oc=Ado5LK5hq78wgQgt6V3sEAyyeq_kxZAUDXwmMIxRKEfis7R0WjDkG_UeuRWVQVYSBTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d7XqjdyFrqkM9iZqzeZQjm61NNSzr1UmYm6-D2ulZ1w&oe=69DE379C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxUW85dLdA4Q7kNvwEMuueo&_nc_oc=AdrGuM29XTMkq2S5Y8cstesOllJaU0XH3ILlrjV3kA-S_vFXV0RVZnEZ7X8uPG0y85A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zWm7RUyohRbNyk3Cavt4089zwgEXXTDJ29MQiomhElg&oe=69DE48D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLgJAsKY3icQ7kNvwH57l8b&_nc_oc=Adqliz7JrPuqr-O3hI6HDiHQLPOAIGqXsQCNSwlnBOFq_j1_GHNmwpkPaSeFlYItsPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ziwfJHGoeTMkh8nuczt1G4e4wMKVPBJMd20VptCMDDw&oe=69DE2574"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtMl_PXsIFsQ7kNvwGHk3LD&_nc_oc=AdrW-6s321PU1M9ctrLgw-ylQG0VVfUXs7-guEMV0aJqT1d_Ljd6ZzQbVOnO3AeSa24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MWmfgpljnRbTs4e1_xspTyHMhgaXzI4WfkVze9NGo5g&oe=69DE3284"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
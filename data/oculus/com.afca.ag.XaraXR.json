227612_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOr8_eqK4vwQ7kNvwFF3j_W&_nc_oc=AdownWjZLlWCww_rNEl366rJ3eoQSGDPI-wEV54ltIhAKU9_ak5MTKpFJCrXva_QrMY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzsx6Gbp8nBc4_ews6bUD627TQr1WjgPOKanew7ISzvA&oe=6A859D59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61mzW-ijbjEQ7kNvwF53bjR&_nc_oc=AdoRh0fhdu8TdIEWZMKku_rHCqTBYb1cLXsTPoR0w-Ds0c6LOmd4HTQqPJ1hnYCroVU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgLwKvbjYq585zyJRUcUvXNfHIukLAhaNXZ29tyIiz-g&oe=6A85A61C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kReGNd2ODUQQ7kNvwFm1Rah&_nc_oc=AdojnOYXA3L2lfGbiUjYhQ6CPv8guGE4BF1Ioz5xBzcIlhtjv9R8KlJjzKnjd06GNYo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE87ItkBrerzXm_sN0OTkaoajqSSFkhIDeM8KKIXd-3uw&oe=6A857F19"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeSGMJzk8gcQ7kNvwEd6QT-&_nc_oc=AdpFBWtY27Szsy9UTkNJe3vNMmvbRlg66vjQv-VfSyWJGeC5vsOZ1P7JbRjtC8jV_6Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKa72irDfrJ5St6-Flx5hkyf_liaCjv1Swh-j2IYuygg&oe=6A8593F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j183TgllGP0Q7kNvwGNjlOX&_nc_oc=AdryjHk9i-2vOrcKZzM6pa6DSci7dBud0lSwHzy3GEhVmfSBY6_nRQiLYq-wGCDVpvc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5miiTNyAsMWf2aE_BJINMn35aktS02fRdGoH_HVHZeA&oe=6A85A104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
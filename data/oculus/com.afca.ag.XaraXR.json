_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3TgT7wpL1kQ7kNvwHzOiSg&_nc_oc=AdnvpY2MN2JkXB3Xj-eIsOGxIkc5WNLoA9YCp9-VtlVT0fUZUBs40HJpQht_-4PhHy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9cz1CH3DL-mncUlhJ2Pm2CFE_WQTZWOPmLRykGSLcAQ&oe=69B944D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v6zNK-yWjMQ7kNvwFKZjSU&_nc_oc=Adm-Q0nRxtLRK0p22amruxlpzQtEnt2eHL0ydcCgsIVO9hDR2gwAggrtr-ZImFQhHoE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxf91sykB2f58Ol0sYUV3fW4WQb1ixsp_K3MG0FPt-ZsQ&oe=69B94D9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC2IYi1csUQQ7kNvwEyUdT1&_nc_oc=AdkFXODWu9FxR_IBK5oo7DJxFeDk_CClMcFOKaQ5F6jTyiSFSiqkSADADusBVRVoGsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwckObgkOcc6RGFR9zESBRmAiqyZqogf-HcoLjIsnbN8g&oe=69B95ED9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnLDGoV1XCEQ7kNvwFdI9e2&_nc_oc=AdnjTIafdXw2SS5W3Y3tcF2VSHgTLzxllTqfjABtr_5Z6m2Aq8ssUaD6u1x-0GDqzkM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzyD8hBmdJuZc_Lu_gs5lqv2ioTfSpLMXRgxlPyLWixjg&oe=69B93B74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPBOiIv7f_QQ7kNvwEus0NY&_nc_oc=Adl65C8MA8s3AeG7L6qYAXss8ID6YvB84xldvJ8FYwUZVQ7pyjExRuBqyUWvP_i-s5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFb027Tb5Uq8riRi8uh1p43DwjqsXKRq4l6euaH5u4sg&oe=69B94884"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YAnq5-hcvMQ7kNvwEQhJOL&_nc_oc=Adpp24spgS32wnhkeDhedla7TgPvYmm_jP9t83avUrepIwwVmv0G8zIehkctQgStNmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY5aVctvKYS40Bf1TgeLO5rhLohJizBJmTVnmRJKzpDg&oe=6AA7E459"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIqrqW6cW8wQ7kNvwH1Cz8-&_nc_oc=Adp_SnDrfToW7jTtGtC7oi2UqS0zP86mWdPPp6jYZVQPX6PgP9t7eytU86LWYn8tpe4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2xXufKmwB_ytkeMYkC2mrLLqD7ONE6SBgtuBbvDpIQQ&oe=6AA7ED1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r53JjiU-dxwQ7kNvwHceevd&_nc_oc=AdqjpxhlmRWAgxYj14NSB2K7eR4qFkj8JDG5P8msyBtIC6g4DwEWaKSgLkruWoye494&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-qhxMx_eNk78RoG3u-Y4DzwOaQN_7To0Vik20wJPzoQ&oe=6AA7FE59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAXqzfpqrNoQ7kNvwHCZWFO&_nc_oc=Ado1cBngMsaCJqdIeggAUWxmn2FHcCc8ZS1Ze1WECGnJTjueWqaLLNVughxTIemxVY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUsLwAz93lE8Ap8As8mqq53Fe0-dRysSNsiHCdsJN2bQ&oe=6AA81334"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3PFMiYaY3sQ7kNvwFAl__L&_nc_oc=AdpSHdpkO3dBy8MCBILUAv6MiQjq2Dmy02kGpPP2NlANANpZtSg__CDd79u3B5HML8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbc9MxjCDuLxpEIAnKLJPsnabk1s7T-iq7MjZYeJlihw&oe=6AA7E804"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
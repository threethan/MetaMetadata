_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7YHfQ8X-HcQ7kNvwH1Vm5w&_nc_oc=Adl5cM3Qa6s7c2feuJ43WkbGI1aEkvbToL3inFp5g02BKvPkT29jdGZ3MBcQdya9JHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEwDuCEsmQsOKyL9WnlT1MdcRH_xPiNdUd5qiePGaM6w&oe=69AC15D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aXL80iXBRsQ7kNvwE_9iyx&_nc_oc=AdnH_UAZGl6hayq2jfSnpGg2497-ITO3fKLLh8i92Z9KJTOrvGT-EKd3_mNyt9g-nFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYVhRNs3Uql0UHGc1tufzibhMV6XcGKAODXBrOvxrx_g&oe=69AC1E9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abJEwtGnrzkQ7kNvwHs4FjN&_nc_oc=Adlv2vUnH-yecdqitw8EAt_HXL8CL0f7xUf0gzwZoXChwmQDA_LQ8X5S6iStmPQ3QYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afztcb9OAENwKh6O5YP7w1zrEihb44akpteN1mcC1JyoCA&oe=69AC2FD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNKUoo7-Gh0Q7kNvwEAg7QX&_nc_oc=AdlzaPap9STJMeXPraZIRXnh-iOncrVy6I2hZOqlOvghIN_2BekIrpov8amKhhgPFHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfymTN3k6axssZ_4B9X1LbrYmI97x_5alLL4smlyMsFY-A&oe=69AC0C74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEgqjg4UWSMQ7kNvwGWRa1q&_nc_oc=AdndQyQqhfizfHRNm7sg_sy-nzN7vhHxuOzNTi7ZXdd2L4PivUXgi2s7jHhQJ_HAisg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVqmyzneiudo9nq2-6h2oVPgv_vObnl_Ci4jD7yBOo6Q&oe=69AC1984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRuYJbshWssQ7kNvwFbsxuU&_nc_oc=AdoSWhxBpnEB9aRRDJuzglph4n806raBowEV_uzZB3P5Xw7XBlPRIKsOPK49Y_pR_us&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3zsMa5cyByB9H_DTG7uW3ycR0yEIoK0RkrMhrKW4B2g&oe=6A9C3F19"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtI2XXbkWDQQ7kNvwGXCNgm&_nc_oc=AdpxOjqiENy8g8lJVSf_MwUQNLz-JqX-JRRs0f1Lm7haHtX6GMli5JDKnLJkEClstxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6NfAwArPkPRW0GHRP_oX1WjjJ03C4BUzK5ieUeTr1Ng&oe=6A9C0F9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGLt_ZCNz7cQ7kNvwH4j52f&_nc_oc=AdoFPM5jSCdj0-B2IN8X0go2q6qpsw6SQ5sB6bBdjtrJkjQomCYgIYGBK2xOsp1iNGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJN-uHOuhYcq6MMHihZa24r2dugMKW7jtIPsSdMDe4mQ&oe=6A9C20D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKOWInzPCuAQ7kNvwH1Pc3b&_nc_oc=Adrj0MJ-wPBL5Uk5buhwkZ4vp2-HkBmig65e7uelttcz4Y2xLIveYfkG6U_gY_o4Za8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjelvvuX84pKL80z3jPgBUTPMTCPBeP0oJ6wGPtZ_6YA&oe=6A9C35B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbyxD_9uJUYQ7kNvwGrCkU-&_nc_oc=AdofCYY9wWJLOVEvWWKlHeHUKK5wQ_1PB1JlRYFbbCty3Agtn2uEGbXNuzHDap35NKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGMxcvPC_QoXCv74ArxGUiQy7U6rlu-2elmZlX4TYA5w&oe=6A9C42C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
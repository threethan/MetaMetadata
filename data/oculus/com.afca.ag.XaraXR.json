12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0EhaD7_3EQQ7kNvwG7vz_o&_nc_oc=AdrTVkJAr7dISNmB7cR9_G7srthc4EZIMPViz8Ds215ESOkgwaaNw4EfFHYC7Xu0g7A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIi-0VbRsSZQP0N65UDpYEde944fc4cbstkwpI8XkA5A&oe=6A771CD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wKoCHBqMiIQ7kNvwESG2C8&_nc_oc=Adp5UaYMapKfbZwaSp6LTXOtM9N1noAiub-EXUGJe29h2hM4Fl092ObKCvKwtI_4PK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIxSgQFzvVQnpL3gxQfpR5LDLU7ZdUrXyIK9tTXnScDA&oe=6A77259C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEsik-LlDhwQ7kNvwHhFOMD&_nc_oc=AdoEgVbhXLvtoR3nzVySAcnO_eirtbXJPK1k8teQZGiO6MZlRJ3f53mkvh4Vmr0ZAlg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm6IUCBS-mlKpPMgYphaFUE001dyD2Y4TX4kkRVrIJrg&oe=6A7736D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZGw-YXRxUkQ7kNvwErN8O-&_nc_oc=AdqksxQN4O6ZU3U6KbRdFcAAcIelPxkOGzCGq9EYSSdVjXThVB1nFhiLtpbTbNzpq48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5-44zcE6jbktakZwzBtTBm6H_rxO8XDJ-dYlq02cdBw&oe=6A771374"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRfUYH48xiMQ7kNvwFAUImI&_nc_oc=AdpPtFUsADjnryzUc3VE2yJ5jDDus2DW-_PUWdh7g1PFOgkqLFyLpqc-4pdxwyHyRSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtO6nYoaR2h9ND8ed1U8zfQylp10oR6aw5xPIQ_-6baA&oe=6A772084"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
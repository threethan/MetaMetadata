12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpzeO3MCeakQ7kNvwEzPpNo&_nc_oc=AdpQngqROFYFv2xiEgYGHJPGDhF4H3n1N_UosRwKE4lyANt-Yu7adfdrUIqHSNmlRZ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mDJc9jloqbAsh3FKXp-GlMJ1YxZbAj-ogD2iBoeBezA&oe=69E76959"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrDkZIjdqqMQ7kNvwETcAS5&_nc_oc=AdqZXSGYaG89cN5gyKfWJR_PVZIbQonAWTvnhllOL2hf4h_ajfcXR4rq4nh1gPN-OBY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XK1-ynNhm4WiVVCVfpwEAtEK__I9fevYrkner0fb_tw&oe=69E7721C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d07r2HoxpwMQ7kNvwGiXgK8&_nc_oc=Adohydkqv4aIOwrh17go7hesdunPDKthrIDx1ea9VQbZI51j2FWcoNZ3n6MiUJ79dzs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pBVuDqN6p_dRM5KW6gdkeDT60OoLpObiqpsvWC1ow_A&oe=69E78359"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUjNv2NyXO8Q7kNvwEXt0gt&_nc_oc=AdpwhNGUPRNeUz_hvrtZg0DWw-gsQY1RwNEuDR_W0xZ1n5qQQeamWQ4sBhy1krBanfo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af218KdjC3V6IYyKNO1kqlDa2WYEA2dBmHzlvJJaRcLroQ&oe=69E75FF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxUWDKvUlcUQ7kNvwFmqRDU&_nc_oc=AdrgM_-OB1WACHcIJ8UthE0vhd5gKOm9Cyk6u9kqaJJRu-Rdu5K6bQhfVfGeO-5y6Ro&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kC0ai966_6khsM2Wgd6pdS6c5CP0PnwL2G-6XPG9wEQ&oe=69E76D04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
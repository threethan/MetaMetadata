12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTji1nQRDaoQ7kNvwHo5FZF&_nc_oc=Adq4i2aW__dY7r-Jtq_VuHtvNYCDR9CxHkwIFgT8XGzURwaqq-neju7y73G4EO7HymE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf6myu_kfQc673BRt_sBatF_1qTpxbAd9GxDh4HWbu6A&oe=6A4CECD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-OxCTJ1emMQ7kNvwEykaMG&_nc_oc=Adq1Lvq5QqwHwnP5lGodhTINlXZRKEbbfiw_qF5I-waqlOQEz83kNML344FPaDa37cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBImPpPO8CVRpAB_dkKD8L3tuK6Dn6qEbuw9YE8ND0AEA&oe=6A4CF59C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SUKCRdh5YoQ7kNvwE4f_T5&_nc_oc=Adrpph--gBPvCRSQgcgWei3OeySposSppRR5LZHNZd-ohERFcQj_SQEtrdcmTpUr6yE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwmAagvCiB4mw4b0-uus1k_R9fJfDH-Q91gdV1EnYYUw&oe=6A4D06D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPG7RkLfHxAQ7kNvwF4GldF&_nc_oc=AdoOfb9l-3INxJCuIRG1R3Jh7SPhuJWMT6EN01HJCImmWMmjVKeANAne8wI3sfiUK7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVCswzIdM8gS51CwB5OIlXoeBHzyTwVy_DxEn-ipG8Iw&oe=6A4D1BB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdmjnf1VoToQ7kNvwF3OmHr&_nc_oc=AdrqvRi2x_yJGc9Fy6EIReOIBa-KpKiJLUCZCstiKz__FuOBo91wY_6ORAF5pa90u4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD50_a3J8e_Dip__CUuwDU3f1ebN46Gy105xwTZK3fbKw&oe=6A4CF084"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
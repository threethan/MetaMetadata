2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX7hI4pOvekQ7kNvwEQL0BZ&_nc_oc=AdoEOWz9rD67bm7i86pXPfXf4tcRnEL9OymDOApsZDYY5z6sj8nwLu81NNGUauvqnLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVFMNMmzMEetUO1-xmoei4rN8_h83nu7LfrcpbCuaaNw&oe=6AABD8D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElQwBHDhRMwQ7kNvwHxbuub&_nc_oc=Adoo2_yL_3JOYwhM_P0ONIix-uMWa4mJXSXQ-eGrV9N0rntQaP7aDFZvdAz2_zHx0H8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHGVpuBirnWWiKmY0LC_JMkjk_9OfbKUmlLJSZnmJGzQ&oe=6AABE19C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7VePei5SoAQ7kNvwGkl79Y&_nc_oc=Adq1NM59xh2UqBV_poyO0jfVu69RtNXC_VKE3Im8eg9aIUGgYPZ0r36GtIvytdbqll8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO9nkGz7OgRTtOMHlSY6v5PGEWkXtNtjSoO4a5v652Cg&oe=6AABF2D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xDmSE8x00wQ7kNvwGbxc2A&_nc_oc=Adqpeqn7JCbZLEiBYKh8IT2EPC0wkHkF4vh_vI3oBa8WC3VaJxeHAopWaSBlI7D93vk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZAqsKwUit0PNtdJL42epKX0KMZE3G8BdR19ZjVav8Kw&oe=6AAC07B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ntb3uwRh1AQ7kNvwFBEeVB&_nc_oc=AdrTWYbITv-MTa2wbKPMXBnXOaWtfB4KCkFiBw8qfRHhyD5LxgqpxG26aZy31HyUL4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_72ddqh_H4OZ6KfatIhTfWVZ9t2ndpjk4e8Mcctz3Sg&oe=6AABDC84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
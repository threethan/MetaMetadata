12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqwBVbh-lxIQ7kNvwGZl-pu&_nc_oc=AdrgH3OSrh0R2wcypMV2h-m7RuG93v93qzw4IH9ztosqlQtbdke7dSkftMeB2A4n8Gk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jxQ8IU_VodfTGlRHSODoXV6dqfyeBNGpa34jqaGykUw&oe=6A341899"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBxC3gCPJ9AQ7kNvwGiTAZv&_nc_oc=Ado4U7HKZ6xDjBf917PWb60NJ-PKmOERu_5TN-f6etyo-SRiNL6pX8kYHHC46lqxVb4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r-a1Qu4sbA1fpO2EeqmDRAZeE_Wmi9yOWoOMsZDsHsA&oe=6A34215C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTNZUcftduAQ7kNvwFvbCvR&_nc_oc=AdprrnWqzSAspINqlwQ-0QYX3s9GoGqFXo6NkcmEi5zWOyT4wdQSGPS2b7D6Kr5SoKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QBMsCItGSvMQ1NlPyYTqSGeuKH6Ij9cijrBK_tObKIw&oe=6A33FA59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wzo2nrXTgZoQ7kNvwEq-U8g&_nc_oc=AdqhzoeEISKHkWsCz8jTj6RJzKQEFNpp1jV01h7JFSPenyNGx1M8uF1R-NEITi9EvTM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xhIjsKEGvG6YSxbYI1lc8VpqAqHrQhwYra5NUOaQVHA&oe=6A340F34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiVacWmIiv4Q7kNvwGTEBJm&_nc_oc=AdrzTFXbtRf-y7dWGStZmlxx16fyvU4NyjkPvP6sOUEqop5qfdJY6tv2wHkoKcTEoyE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BAK-6izA_zb0azjfjZKeRN73OEnpzOQSBdEOHpStKpg&oe=6A341C44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXrPkxdDh60Q7kNvwHLhPhE&_nc_oc=AdqhLZ3ueNt8ta8gnHDGSGcrPD-OO29oUSf4LqSA5_rCp4JEJXZQFw-kf7zDzCRT24E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FabeKh2ypY1TjvF7wvYElkwJGSgIPciEKlxUFzcnl-w&oe=69FDD2D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h08YRG7JBhAQ7kNvwEdnMBo&_nc_oc=Ado3CbofTGtoz_FCPZll4_UTXUA7-26u_sVM1n42BJBGCeZUZXR290JR0Gdn11s0zUs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vHJf78Bnj0l4whOMlS5Ug8M1eEqtNsCgwsHRi13OTgA&oe=69FDDB9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRaWCuirvm4Q7kNvwHFEZ5y&_nc_oc=Adr8CZ09j2KXHlW6TkEEnxIrzHRLc_K7sk0QFX3GVZg_qofN_GcnY1GVz-Zlu10nxko&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dl8MPuxJsmti8firIIRMV4j1h_kBuDWPcQPRLLo9wuw&oe=69FDECD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DktRHzhfEkgQ7kNvwHTsoev&_nc_oc=Adq3sI8J2oDTltkf-9HcTUf10eWXzxqs5O1REzi3L-pYFpOVYMzGwJfi6p7ht6wOb9s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DnN2UztAo2bO6w9sJfjXYE9Knx7vgFvGoID43ojthvQ&oe=69FE01B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG4chgR2vUUQ7kNvwGHracv&_nc_oc=Adqbfwr0eU5vbRdz6Yjs-UmJs8KYq4ihZoCnTTZscIPhFLGJE7D3MGd3XJGbY2zE-lQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60hAynsRVcR6f_qVIucCMwX9Xv7vU_wNTQhDewEUDsTA&oe=69FDD684"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
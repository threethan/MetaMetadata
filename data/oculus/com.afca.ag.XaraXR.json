12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4NJKmWmKlAQ7kNvwGGVXvG&_nc_oc=Adpd_N9iSoHtOKdbvh2FDDvu10sY8wBcK4CaaJeW1xdf1HVvLaDzWtSnuqyK1qab8DU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GW3pyhkwKtjoaqUH6aWNCB0BTJ0Iiu5vddbT8zkfCYg&oe=6A16DF59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHOks7Lfa6MQ7kNvwE_8rvD&_nc_oc=AdoabXmjDQUPHnmSHqZUo_Yb9hrfIZa4avvkGJucxOZgVZoe9bhNIelTaUZrakCbP8E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sAiBLvB50huT079XXM5ZzhEscWMsgByLQ708bEM1csQ&oe=6A16E81C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFjPD_ibHFUQ7kNvwF5cmXM&_nc_oc=AdoTayxqzhAuWmX3VQOIzrYjYmS30uS2mQHSj6d3jrrdqyxD_n4ZtoB_sVV1UGcp16s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45qJBQGLms2J5wyQk9Fzd8BoevH0sW2f0v-fvceNHxJw&oe=6A16F959"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u4oCLUjoMIQ7kNvwGTl0uW&_nc_oc=AdpMtm63Ebwjty-n_bNLb2DOxrw46TvWYp5atazL20_It55T0Evp5xm57bA_irP7rac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mbS1BLJwo4AOhZStiNbdEZmYc4-UgtWSmtPff40C5Fw&oe=6A170E34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHS613OUXxEQ7kNvwECBKz-&_nc_oc=AdofgVVlPpkg2OnREKM7UoD5q-mJiqRk8oeZ7qBLlfPNdAOQ9oo7HOhr4G-bNBCd5YA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pIdpjPYHsB-Uxucm6A3iqmZLr9xCyBUbfNrmHG41ZOw&oe=6A16E304"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
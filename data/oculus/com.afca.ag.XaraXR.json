12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oq8sl7bWfgIQ7kNvwE5yFHu&_nc_oc=Adp5sEfc8KcnZQ4_gjqCbCYd-yQk0RfInPN7GEOmnQzQkKYPgzUUBaFBRjwszmL1VB0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NCW_fCNX5qiObY9o66pxvOkrCNIyVBdtyaCdR1DOIoA&oe=69F49859"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qhGDImzZvMQ7kNvwHsamEh&_nc_oc=AdpvBLq1Lku7g1pEoMkckRBZzHeB2BX0f4RVXNZOcr1ARnTCLjQDHbm3CManwDc1chc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Q63T0UjsiRi6eKhiagBwl-LFcC1YRBAS6-e6_ydltoA&oe=69F4A11C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhPzjgqCSN0Q7kNvwGJymqe&_nc_oc=AdrgqcLL-zQSDmYBQDBgC3DwXhGqqqCKERDTjzX_IHlpsTXaGIaeMELwyuDWmQ90feM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TN1Lvd6yjaePx7kqhmNXIc_Pwo_-kAuq1LyEPrrTEUQ&oe=69F4B259"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDH8JGCX3E4Q7kNvwH0Sz5b&_nc_oc=Adq6KESCAKkgWSAAFwa1zfrBqHgiumE6e6byrRjcY-RxKgO8j_XaOqN_SBQjQIQXhio&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dlS4XJssHQKJfuvFzIm-HX6FGqoj93VCAXt09LHaQZQ&oe=69F4C734"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcsL_x6apGMQ7kNvwFvF9HJ&_nc_oc=AdpbqUOiJNPonl2i7Cj_dr3EVtUKOhYVYKNGj_G8jLIww56VaXIXVP9KjfM_sxP_JCY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zJGHvdQdlWyA6Ida7rJShLAUK-4_5MgRe20KE0ZbD-A&oe=69F49C04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
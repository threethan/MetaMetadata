12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj7uOTgTFwMQ7kNvwExYJ5X&_nc_oc=Adppn5QP1He32FJZCuINnZJo39aDhvF-uAzSldJc8MPrWZKQgxXTUGtSWjEV8VczUKU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tGq3O_FXuVSWaw2AvP7Dt694uyAobPNiCyGv3WIRoNg&oe=6A244699"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEdQTEqYW_oQ7kNvwGZqBoG&_nc_oc=AdprNkkBb70JxRxyPmrISKPEneBPyYbjx5ExSi3yykbRSpgP-wDVy7O95BVUEutqBMo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ofQliaU_Aj0mCxwnz9ZN-a8ETmClZt6NzNddyZXQTYA&oe=6A24171C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYItTNXYpXkQ7kNvwFXiAV6&_nc_oc=AdpYfaphDbHEnx7IoZUhkjQVwQRo6DlV_JmF-EyQ166ZjKwI_EIQK_TazyN3SIubkZA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U4w4fy_1Jp2cfoiAl2HdmXHAtxKzg4-5t3E_wvqIqkw&oe=6A242859"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yjTcXel5TkQ7kNvwGe4IUx&_nc_oc=AdopUjeo4R4MWd4rIR2UZFev14lmB6pzjxe3fzBuDJp0ucvKr8AFnqVjl_6wdepaHZs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_hBGin0FcPOonqdOKBv3qPiMtv2xcWGCZAa9UB4X_lw&oe=6A243D34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E31PagXReYgQ7kNvwEkMpoZ&_nc_oc=Adq29kJxHwTgcZbTqMGdDrgQYqzLu4FelrwTi_KxcPOWVvnm9LVS0Abkyj0lSWCSyqw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a1ytbnU7_lu8pnuyrREXR0ColzPxgcAkVj0e1StjX5g&oe=6A244A44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=218a82GIbd4Q7kNvwH727qw&_nc_oc=AdrLVSUJY-y6BmNFpWmMok74TeCntiHKDmMO59r51AZSSTDXqWNGfAkSiqF4I5kD_S0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ST4ziiP5qtbGgyyTCdqO9Am3F1TNAqF2qT_NQXGsOWw&oe=6A085ED9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnXXNb3PYcAQ7kNvwGa-1Vz&_nc_oc=AdrLtGEHnnaTMd8eWkJYQ-MLWfD6idXNXHl4ing9qWxOJmpngJpSFpzcKOOSoU_Hpv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZVf9Og9luh7X1EsNRZHtmdkaij0WFY9QGip8wRNxFeg&oe=6A08679C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5kIErLULi0Q7kNvwE4cM3u&_nc_oc=AdonpigCoudozz07fZPIkONWnCVz92aOE_piKiSOs0YP-1waJxiQJ1mkiC-hr18312g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5thEnqtxCgFqWTQuKhWYDJs_D-nzwEp8fJ9ydacHjTag&oe=6A0878D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT-Dh7kN74QQ7kNvwHBgRfG&_nc_oc=AdryvJ7p3NnQ1j2fG2XpK_PV6cBzKsfBu5P9q_MeGSUstUC2Bu2dHsXkeNMJq5sj8EM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FoQuYLJkUPuAT60Jp8gwq2o7yry7VJRUCBm9A9FmJGg&oe=6A088DB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAFPPSJflu8Q7kNvwEjo96w&_nc_oc=AdqV4XsTg52xj8LZzLzDIlGng0CFNK1tnF0zScsZqrlJVaJCEUJHctFf5cne6tcc1PU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yHDGYV153IvFl7E6K_bve1UY2p-HV-aC9zk7p649SVA&oe=6A086284"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
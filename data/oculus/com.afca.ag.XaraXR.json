12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qAF3SMpYiQQ7kNvwFLQhrI&_nc_oc=Adpu_sDvcsSOIHDdTcknnABiRWXwxUGyGCPPFD-DcsYAjKXAxuUfX62dzQ65Ie2fe5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnJgUmj2DQKxrQAjkvbtYRebzXlUPea9i6_W39jHGv-Q&oe=6A54D5D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt9Lk9UIQbYQ7kNvwG-WQ2u&_nc_oc=AdopLDfXhM0cRBWLkSq4S7mBE6jIJRH3Zmbx6qFymVkNoLZw8ize68lejNaTvm5YuVQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoJ24Diqz889VupJ2jZZWQBnyg_xHqhx1FVVkm3dws0g&oe=6A54DE9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnMl9f7pTXwQ7kNvwEhFxWi&_nc_oc=AdoXAXX08a94SWiDt1pdXLsGtIMKhjI3_yCn2_0l5QCcKAauTiE7bCjfPz_tAaNNltc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6hELK7wOIuLIl1xYkk8v1vrwXbA4CONLNuZMie4KseA&oe=6A54EFD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROHqcaW-bwIQ7kNvwEo-Rki&_nc_oc=AdqDYnSWQg3HTLOCJ0UASLQyBFHUInuAwM7qaTq6owWPVmvi0jvNfLm2Y_Ehvau4axQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuhdHqN3HGYEReDLuVsQTwvj6Ar5eIv_B8G4BSuWdg6g&oe=6A5504B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYhJzC8519IQ7kNvwGBgrMo&_nc_oc=AdoT0bNcpnbn63bsIsfI4ZCXQy4tfKzxZIfxmBQjCDem5jYHafcJPd9fhS7Pukk_n8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDCDmoF0JVH5K1Rvb3DyJ0pxRp5X8fs5mVEmPnJt2AZQ&oe=6A54D984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7xtHcJPSyAQ7kNvwFVHaNC&_nc_oc=AdqeE8gP7wxghiC5z1V9gQo5StnXtk_2cYM4sFfwkUjbvEWwe1bd1I2_erHf7KU4HaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81NUwSvZHPAEBHGsbEmPC95SI0mprvUOcV62D_xzJElw&oe=6A47DF19"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzmiYFPhTiEQ7kNvwHAfUOU&_nc_oc=Ado-ns_6jaVbO4vDhz3JrOVfI6LCO_3zsGheYoCrDkB0LMff66WbN57nP9OqwrSRuLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tm78jDJObBrShn49rkOKIOFbSeBiRIsdZO8v148bJUg&oe=6A47AF9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL_EYFMVGCwQ7kNvwE9Ay5F&_nc_oc=Adrc6-gkTsmc7Wpo-aOcmTxZ6Hh0r3YK9u8QIJn8SITL3Sm9ZIKgHBoH35Ljmo1iePE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X-2iFItxT4argGvD6KpWcmdEi0LdZcYOvRfCiH86Jng&oe=6A47C0D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fUXeetMuqYQ7kNvwFogxMR&_nc_oc=AdqqWFFIvCffFjdGotT1kFtYP7zBIa3EKjxfxEifYSqr2_L7FRdU4mOuT3jxh95WAis&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mfNbZ3xPBJX2kR6HGSv0rjs71hHhNk2BfoMq8wNsYrQ&oe=6A47D5B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P6VDyY1NKwQ7kNvwEyWWUg&_nc_oc=AdqFgt4hpRe3SUj7LA1qwtnjAz9BoMTYJwylnU0XizwrupO4EsnvzGYO9seyr93jtwU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qx_dZsY2yKYSvI_qYCnlmgdXnt6VCHyqFgVDRkBYBxg&oe=6A47AA84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
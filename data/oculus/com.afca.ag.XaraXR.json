12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NnDM5q2CL8Q7kNvwEZhcSv&_nc_oc=AdqfXB4Bw5nIn8zJ4I6tCbZOgztZJrc4GO6zl2ESrbC2F5E5p05mjNzv5bvT6z6hKHQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WX-RiWXPy35QzPNzqEXceWy3ezEgIbwWY4FjTw9c0_w&oe=6A3EA499"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr_JsOkApTkQ7kNvwG1V6Ln&_nc_oc=Adre4hMy3vk2W2krV2ShNpjeMyFNOC_wixNV0GW2EwedZamh4pUpNh7XD8IHXZtEtBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5Ys1oCXYwASCYNPKC6oZMarC_hm4LPI8ngTsjm0nuZg&oe=6A3EAD5C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlpyTWy6aesQ7kNvwHuDAX3&_nc_oc=AdphohyYc47LUaXKgBGKyg4Gr58wsaE03aUUPENpWrb-ME9zgAWlEqyrXyYCLlx8RCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Azh9GNyeEubiFub8xRr7bJtSMQCSAEjkVdgZ9jGmTg&oe=6A3E8659"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlyqlkEp0TIQ7kNvwEv898F&_nc_oc=AdqMUvrIGLJFd-7mlFywmOdDwOELB_wZDQD4HOFg0K1EAQBkXQ7dlGrghYh_pszdGtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aGrhZIxKyj_Yjw7bG-ZC8bIFV35UT45GNcPjhngYYqw&oe=6A3E9B34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH6r0FJ1LtoQ7kNvwF-WpGB&_nc_oc=AdptmiSlYbb0SUZ5gDbq9H6twhruOWW-wT1VvFLOH86i5ALucr3bXJggHeeO4OGj6Pg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FgZ2R9XgrbEsl5UHH_3ISaXHz6BEBnVHNtNhIjZV3zw&oe=6A3EA844"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
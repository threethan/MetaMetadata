12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz4wJcr3C64Q7kNvwGJr-vf&_nc_oc=AdploxUBfyhDh69yuiGtdHknq0d3Y4OGST2hQLCYHK-xtosQo3tgT4FF9hH8lh6e_XY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA81gNb08pLWXZBJVo2TXNgWuvSwDJmZjYw9vYCvGLEg&oe=6A71D6D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGYzd6oW81cQ7kNvwGn6uu-&_nc_oc=Adpyyw2PlLotuq2fSumFp8RH-gFMNS5Sd51LWewESAxnXynrzneIzQhRFmeCl180ovo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBO9b8pyqH215bER1C8D9ct1j9f57y5FlOiIQg7Q1BXg&oe=6A71DF9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrq415V5ldQQ7kNvwGRHhTO&_nc_oc=AdrjDxVQ4ii5hCYXvrRIIP4oi3CiZwDe8sdjuen-YtFYkQts8yRX8zMieT0VHjTzOU8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoiqgJspI_J4BgFcf-BiPCUS38poAedDV9rJS_3D9CXg&oe=6A71F0D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnsTGA5gGHUQ7kNvwFCYWKs&_nc_oc=AdpgGoSJxeriszL-LtD6BEcDXfeWLkoLNlu6lMxgr6JH-HI-5EMmbXY2zuDyAvB0Bj4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvsegsMSOEqteGRaR_BJkGIaCJu8GmL1Bo_DyGG4qQcg&oe=6A7205B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O71RcLZ7PQQ7kNvwFHW8fO&_nc_oc=AdqtiXPCoMldd1U01s-Zei_s_W9BWaYPwOdQxTWlLGQY7c4IWpB8-9hF_F60SqJAMzM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkGVd-siJNWwq3qJ4e6VFOmpRKeJW4TfYPFc3L858o1Q&oe=6A71DA84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WCCBbjzpxwQ7kNvwFdSLC5&_nc_oc=Adpu1AaIkLnxcQhEudDhD4f1El3w-SYBQGCkS2_yvEfvByMG3_OshwgNDUqZqc82lLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI4nx-LywIPMMkF68gziBnRUEiv_zD9xfK9AbhrgUsjA&oe=6A4B9B59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-OxCTJ1emMQ7kNvwEPqle7&_nc_oc=AdomC6asyt16FF9eFxCb7emvo6qRFsIvhgA0Pj_sHloisFCuIfpxqIYPXV0wDPbz4qE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQFmlALUChW6QfxusOEZbqM5S_Sl8CkYnqe0JMdxXjjQ&oe=6A4BA41C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SUKCRdh5YoQ7kNvwGlih66&_nc_oc=AdpnWiFXLnFYSkdqPyfMyahI6kxEcTaq5-xIFOvMg7k82m6X2NxKNZZ-Zl4i2-ywICI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOXlqkPuUMojaD2B4jIkQnH52AlA3llwEw_-sojdSYPA&oe=6A4BB559"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPG7RkLfHxAQ7kNvwFbJ9M-&_nc_oc=AdrROEbXgx1ocYODyzzEx-9Eb9Z4KW8jNIi7ljy_N1dPwDIPMnjMtGZT7STEyLN5wXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWNwguKVQDJVvO3zrqlbqr3yEaX5lxQAJqgzUTXUcU8Q&oe=6A4BCA34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHWRR0uNhlUQ7kNvwHqWz2b&_nc_oc=AdqOM4LbAFccL0eB49H4sxbKdPEjRe34fckH_6BPaWo1QpY7B0_u__BKCnf3XcrNNHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH5V1-lbcjdEhrv5QI2iksxibSLqbRkrr4XAw9bxEHbA&oe=6A4B9F04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
0227612_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H0K-TXNhMAQ7kNvwGCP32R&_nc_oc=AdoqOC3mr9Cdw9PvDsPp4zav_bDl70gnUSyq29xiHzsCdzCL8ahjwjPIefE6LnpNCQw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh0sT-9nJxVnvHrtK575nLEdu88Ay-cPRXjaZ8Y_E6rw&oe=6A7DB459"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg3EtPm6PKAQ7kNvwFFE-mk&_nc_oc=AdoKWyKHZqORnUF1wkr6FaDVE9_Ny6LXswToJR2N62AygAeVYNWNA1KSt-ljAG7V_1o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWeSv5kw7p0Xrqqjap1p-BYqfqOavbhIfsPmDh8t93VQ&oe=6A7DBD1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABaHyxdXhpoQ7kNvwEWSGjk&_nc_oc=AdoY3-OFeBSeS8HuUr5Ox4PVAUgH-YBkfAz8anMOoovXCvpi9sIk53zuS2OM-9xjXj4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFprzOLAXc5GRGVzw5knc8NKGEzkBoe_acwwpWyLjMsHA&oe=6A7DCE59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JulN3I8QDEMQ7kNvwE1sN9e&_nc_oc=AdrHuXDmvkyzwbSI0YDTqXY7Uvogteffe9fS9VZo8AFEA2oic5G2a5jffNi7Y3vmP78&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAp8nOA6gvfOKhPpUiNOXRnaJUrDx4VkCC1UmO2KdyqQ&oe=6A7DAAF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGZD79QUNoYQ7kNvwHi8rZg&_nc_oc=AdojUt8YvzpRqd7iL3866zCiBlL5PkSQQWWdjjN_QCpzNrTmh9jSWgcZr9Dwe-CZv6E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5eLRSXenXjO-4sW3y9ZSjNAhQ3ubVtf9M1CIgTmbAdQ&oe=6A7DB804"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
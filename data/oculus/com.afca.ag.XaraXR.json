12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yKsLvcDlnEQ7kNvwFEvxpF&_nc_oc=AdrhQHQfZJuyuvsSBqAekUDkT_9oYmFmWoF_BKX55vFSEBX1Kl3GetYHcgs7l3R29Bs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU9xI8lcVnXp8YLzX_NA_b_Q6sEje09S3PtRexHqhDPA&oe=6A58CA59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFSNj-YvevQQ7kNvwG8UUYx&_nc_oc=Adptv_-89waronojs_RBWyXOulb2FEHwa_NDY6C5IV06Zp8VEjMqG18oE7_Z9R3krVI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfu6JTRud28d3jv-67s-T-ixags9yJsaDqpcEKyZRxeQ&oe=6A58D31C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWO5ZLnCznEQ7kNvwFWr1Nk&_nc_oc=AdrkK9hhGaeMaWqgyXZAD5aJYHXeA-3xCw6sKk12T1qFOJ8sGiHfsXkd8J-KK_tZ1Go&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9ZDeyeNgf9lSbwXKXWuhUxG7yfGC-tVL2wXjrxIBNJA&oe=6A58E459"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xI3d8NKg3YQ7kNvwFYTZDy&_nc_oc=AdqZ5ABnX8Ry1-50HO9KFLIlL8CEQcxg7u_80CFVP73D98BQ42TGwI0c0Ozs_VF5RdA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7r1HJQYluXZ9fIkf1WvJn3uA_E_bGmhD4Z9-eauWqng&oe=6A58F934"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewBET3QFDssQ7kNvwH5Htxa&_nc_oc=AdqQCVyi9Eh6DCx8NURxnJcUGcOZEwmnzSj8C4uvlDPbVIDDRpuX09PAOEopo7nW9DE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0v3xhPmOgIplKKsIixaPCnh4QpEw6q1T-CMKv3dHFdg&oe=6A58CE04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WPX3Mer5AIQ7kNvwGeagqY&_nc_oc=AdkenEoQmnILIiD6V8V4Iiasi7e9s_HdtqQtnVKlqUyhIG9XsXJu1j8QoBK_tiDy72E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv8UjN8kKCMLTqYYSGAy7OGA3I5e-G-vHv98O5TTsTWGQ&oe=69A82159"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DVufLfDJA8Q7kNvwGvKquy&_nc_oc=AdnGajp2XAPD9vI3uBcONTMotG9rp98AjWckVgkRcW3VPUph7pQauFBAf5p9XlwmahI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvD-pKzOjVNnMoYa3-CwLX5--l4TBHDkY590QiqoxZXoA&oe=69A82A1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNVVYOct0k8Q7kNvwG5QxqD&_nc_oc=Adk-z1CGu4PnFOh9VRmySFXW0_gw25FfPxWuAFORjrKw09R_n7xaucevbrs42bXVkrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfurR4Qjj1TwZxtHpTbH8Z9qZX27GQV6xNgHbWszcy0CbA&oe=69A83B59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd2qED3O-zYQ7kNvwGmOlgC&_nc_oc=Adm2OyG1x34O6aTVSCG2gYW6aJ0gQMvgWEdbRrMG-p05Y7rN2IzsJ-ZDptiLK6YQyV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft6fSLTos7Mo__FvciG2IHwu0S7uwwFeCEZygy9tvHJmA&oe=69A817F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGWJc6Nq3mwQ7kNvwEhrfxC&_nc_oc=AdnUpvr3erPp9JHRJ4paPWWKxnFsrc6dbRXR2F-3K8CkuDlG30aoM7niG_aGa_oGp20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvi-CGI-WYnEotld_BBzh9lElBaeHYoKcdcR9qoNngziw&oe=69A82504"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYhg0OdA5mAQ7kNvwE7qaj4&_nc_oc=Adr3HN81Xw8RRBUNQUV_ms0ttyZMVfIUQpP79CfSyQwxZ53s6QmALTjPMzkDRaq-HSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4Z2cHrwb0Z5DLUXDIb2IXssqcFD3lVIoIXT0U4_PZYw&oe=6AB3C1D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62IBk3iquGgQ7kNvwFNh-Bn&_nc_oc=AdrDUvXdGXm4MsFbTxGcdP5w99CNBpKjHRTRHqRTPzIU5opRDG7jkwxiA8z4EDfo61U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICzMwNDLDhTIkB5bUVvBdnMg9veN3WIWuPGXBpo4dPdA&oe=6AB3CA9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Siv9aV1dXQQ7kNvwFj8Hxo&_nc_oc=AdoHVoDtmqJW3rlzn6RDsRlCJzZRg7VZvfKueTzYuNZXIKR76L2K53pMM9rd8i8VaQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCI4SHdHhJV_qh_H1ZAhlooN_TiOmw7A4tR52wYDZyBw&oe=6AB3DBD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5kenmxUNPcQ7kNvwHOocGi&_nc_oc=Adrh6-iF_PeMw7zUG81a1ttZnORNfOMcs9L5OeSvPXTahRneZljCbwpnL7nUGUYGAnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtnsosNtkGa8h4_1jYTMittGFQm6YGmIUifMdpBfrJ3w&oe=6AB3F0B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iyj6qCCvJd0Q7kNvwFrUsnM&_nc_oc=AdpJKJuOws7KENlXhYcOhXl54gXYpDG4xdsl36OZlGX4gzj8dyFv4QUN04hRMO2sR8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa0jUgy0RC50Xmx5A0vuhLdlruijOULlpcIQgnsG4kCw&oe=6AB3C584"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
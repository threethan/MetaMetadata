12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW5iHnQzrvoQ7kNvwEqbRtp&_nc_oc=Adp3UHpV-rjV9A_IgLQsxyJ7S-YOudJPMcpysYpyH8X5OFQFVkTabFT3sk5tKCjT2So&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8XJQq9HWkLXbV6RQ6cJ__BaTurm4EqMleKd41e10ZBg&oe=69D0FFD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elVafJOSDEcQ7kNvwFJUIDA&_nc_oc=AdoTV9OICmCtcDl3oiGWUb0bH5x9BJZNByx8iBYamh25Fjj7ZPUWnYqv4PP9MAV4UoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwm1dA6xuRs2PNiRdFGxdEnPKnzOYrUACT43sVXmKfLhA&oe=69D1089C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl5k5Vlq_JUQ7kNvwHgW4A4&_nc_oc=AdpMXrGxPGutuT43LHxQJ4DWfYLbaGcil5tzEvyYrIpl6Bi7VoRrGp1oJ4rRT0DrJxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw46H1TiLm7JoPHNoRZqpy7Xmci2Btvlh_Qt7BWtgZDCw&oe=69D119D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZMQm9jiTNkQ7kNvwHZfDBN&_nc_oc=AdpsQ_zbqLdrGdVOx7JMPqWtQi1EBagyB5NkzRj10qJh0LUTX9ewL3NkkxcKx-Ue2ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7Orro_w2SW02loxNB_bq7o53yP0CAfz4YWnbctHcw1Q&oe=69D0F674"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbz4ipr4pFsQ7kNvwF7UEOk&_nc_oc=Ado56jTAZVnSWs6-vpT_YFsJMx2VEBlQ9RmFxUM70HY6q69HafONI6wJUTcodLoXJZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwk3mZxN2n2Ou8fzjWpItMB6MbYCx6j18TZjG08zZp9Jg&oe=69D10384"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
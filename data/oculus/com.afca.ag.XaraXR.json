_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WPX3Mer5AIQ7kNvwF-i3xx&_nc_oc=Admf0RhpFyhqQJqDsCWQFzgJJJSxI5izbnXFWgXS6oNvnhLdsEzEYDzWRAhjojJUX7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsaYvsb-WcZeAdK5Ishe6MDGxkwy-lcMpdta8e5AzFczw&oe=69A972D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aXL80iXBRsQ7kNvwEyO3IQ&_nc_oc=Adl1bhZYEbcaWIDmOnQRP024oFNjUk65mqvN545lpRTKUFxQ08yuIv2DrveJHJl4-nc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuR9syyNErTKnZt60NG-7p4tWDFTYOrUA_H-NKu1YWvcg&oe=69A97B9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abJEwtGnrzkQ7kNvwFlJFBX&_nc_oc=AdlUO1Y4au1xMG7ZKcXeDSzPhS6pzlEDoRwvvKC4cALP1vUGrar4NICWyRJz8QCmIu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftOnkzefKI_i47BB6CT4OlmeTx068HUExvt1Bz6BVO1xQ&oe=69A98CD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd2qED3O-zYQ7kNvwEB524M&_nc_oc=AdlvUU5sdjITZPpsrRfqyuChx1riwYg2Ex4tt3M-XN51GvWwut_zNndLuyzOfYqZXyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftvKirzYoQxXBu2GMWrmfLWVlw-wpTq5JaknoC_Czo_fQ&oe=69A96974"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGWJc6Nq3mwQ7kNvwGyI_Xy&_nc_oc=AdkcolmoUMEZmvgJf503cvMDxUC9fNCEMFh_Rb7V-DJSSLtD7zXy1vWFaHzKtEK-50I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs7MIla_fNR6A67UhUpIm4SKgdXbXtz1KTn_s9RXtXs3g&oe=69A97684"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
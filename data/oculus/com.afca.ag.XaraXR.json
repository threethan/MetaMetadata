_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhXNtHo5fwYQ7kNvwGFkve6&_nc_oc=AdmLsniqhUaTGaGNKn-34fiSt8qT7vh-8GFZ5fsk7gVQ2gEhERFghBekLflUA6EALQ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp2ifCKlcgjEiVerQniNkUiM_X9xwXajKQkz0ANp7J1w&oe=69B15BD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2gYVBVa-lYQ7kNvwGVgm0G&_nc_oc=Admks0wmu89YhJEZ5D7QNtsW4Xzn5_YSFetCe1Xs-MVNCmLH4A86iXC49ObOMkQy4yc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZ_2K98cCIi2ulm8aF2kZdmhrCj1uPM098b0H9ye0apA&oe=69B1649C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNRN-IT9SBsQ7kNvwEo614T&_nc_oc=AdmELPcECrJJRH7deiZF9NxIhCeMc0jEx7705UCQaVEpmDj-sPuw5nz-cO5JVSz-2UA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkcfHul0yPHMw2-jF9dA1Mt0KyKYC7KkcbhUDQjJLM0g&oe=69B175D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XD8L6iodCUQQ7kNvwHVLvLw&_nc_oc=Admzf_amt7hZyYMVNulTG_TO-R7QR-o_fS-lSEUeKCAyF70fYFef_XovJmEZeQMqRes&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwotLX7vmfbbeZC37xtJSYPF0-0KLyWMQKNGdWCfPutYw&oe=69B15274"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5HF71Ek_VgQ7kNvwGrUBNU&_nc_oc=AdlUSRSktKtO_-fu3nhbUcHScOz988LX4D4tzL9wklZCcGxodJu2OaUog22spPI83fM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7vXQJb34lO2YpagMNCnJZGMjauC9T6xxJTuPjRogSSQ&oe=69B15F84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
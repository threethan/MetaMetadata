2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYDelZfCy70Q7kNvwFE0WPu&_nc_oc=Adq-nV43Xj81eymvU7gueAv61piNWl2w6klqk9ku5CbPytdLTlBd65Bf8dff-Gqhhck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_BlJGQhrVlIwieSVykJ2jgJQmaOp3s_CFAsR_89t7kA&oe=6ABFD799"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umWdwJJSLswQ7kNvwGzamDR&_nc_oc=AdoYtYfKI_SjJHhkVrPeWmjwKBVowGsZzzU13kpfuMnvCRZzUJlJecVcfgnEUmGIPMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2YDVbavksKFZ5lSukyNbCbb2zvx8Xg1pJ4RmwtQveXQ&oe=6ABFA81C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYT5CApySHIQ7kNvwEvE3ce&_nc_oc=AdqGCoqCT-rznF9DUG6YhPJptFdTQejdZ-fJ9IyA1Pz-X6niQiuK0Ot4HS_kHLVU2LU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQZbTzEMlcNxy2hRf6JUq-4acM-qiwnYEGE1iN8Ygvog&oe=6ABFB959"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsZONuFnRrAQ7kNvwFts8WD&_nc_oc=AdozlM8Ytf1w2rn0y659_gG4BWO67kBF5cCc4_EjEJpOSgxEiTo1XXLB-Fw4j2CMxYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlL0W5WLglFbBlPYy9VFiQWsXSAaR5RMSYCHSynuz-CA&oe=6ABFCE34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wE4TYfXBLvQQ7kNvwF_Izou&_nc_oc=Adrjd382qQ2Q9cFALoF5nL1FuuGlG2x7i7skSDAfSPUldvHU4hrr4NWd9oNLeW-4uR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrizZh_MPDTUvEPl6EZNx8C9zvFk8-ZMYZPjpHSD3syQ&oe=6ABFDB44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
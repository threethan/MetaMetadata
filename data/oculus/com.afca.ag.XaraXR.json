12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXlkkQbznxgQ7kNvwFHLyUP&_nc_oc=AdoCk4gP0Q7Lx0ChUVe25J2U3AIOfAxAgsWTafnhkno7AHeJeECUTulFWNcKWR9ig40&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrYT7ZhxBFbQT2TGL-Se8KZoDtIGtlE3DW9RkT9lijlA&oe=6A65F959"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_f0byVQrkQcQ7kNvwHV-5XI&_nc_oc=Adq4vFqKEasYhEkIdw-3wzLv2RHBJ6XbNlmFwLiHVOuseMCM4Qct0ZZsY8WrrpweS-I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxaTB2MlMRxHXMu9UhqXlbIcuB8zMxqAqudsF9cE-B9Q&oe=6A66021C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyHsaOuNOmQQ7kNvwE2Qo-W&_nc_oc=Adqp9NNgQ4r2J6xAKT1VLHD6aH0YxuI18MFucfpV_1NBQRC7gBboqJ6LjgFTDpQPjdw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ1cD89JZ3-w1yvJ3hpLEqsGjR0saRO3ATaUfC0PovXw&oe=6A661359"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNf7h1NLTOsQ7kNvwFtM_ji&_nc_oc=AdqSmdZeQMq5xIgSKAwU_69059wFiAczUMfOlkzHf-5NFWMNDWQyEGctcNiAYHZxo6I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVbPZNb-Sc29RSf7ut_A1DGc9LQvAfGih3l46DOhFFEw&oe=6A662834"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=talxjacsB1oQ7kNvwHFsuyz&_nc_oc=AdplGRcRTV_nm64pesvmpiOiPY9-4sKodaUbfEaSfG89Sh-qDBPiPyUDTV_sh-fDdQQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4e_JdaqvALxlDh1qOdhKWRodUrPQOaB-oEoodPzGXVA&oe=6A65FD04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS3Xoy9UKl0Q7kNvwHEsr35&_nc_oc=AdowFsqQa6df12N-T74lUGDDP7VbKuh4gGHsYLzM8WEYGwo7sI0gDQ0g6qdadDYbxDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFT4Ug1xG3r5ojgDFhZlhyM46zfplPb6bxmYlVo3ZP8LQ&oe=6A95DFD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNetqKLJkvwQ7kNvwGk99GU&_nc_oc=Adonu0HxZSeszdd0xvm6euyFnjqetu2865CLxDy2_35iwJE6RKsSL9RYIiQ-aK2L9Bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmYcXFP9jwWHRMjQ9CSI9CzEe35wb2xwgA8D9nHpWA1Q&oe=6A95B05C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u0qtaGf914Q7kNvwH2B6Mn&_nc_oc=Adqx68D9PlP7jhDCklsizU3VCN7uhVdnSzEmuB7jj_5WdCV3z4Ral3ova6jka-jJlwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHqYcnHJYLssvPfCzLzLiEqYyymsFwum2j1nEJrqAAxg&oe=6A95C199"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLwzrVfAb98Q7kNvwFme8Df&_nc_oc=AdoPSEXATtiQea3oLJ-n-0w35Gu4V_-7mWLgHB05Kzl-48DsrJFIdhn2iTjmCX3XICc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhMrK24aJbVxC9NCQv0u_B1v61yk7esd4DnESQC0JtkQ&oe=6A95D674"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs16rsAXwCsQ7kNvwEY0fIA&_nc_oc=AdpxLlqYGZrJwV_Fxu978lyHluLfyU_keD9nqO3Q6DLfqdm-urSp0pE7LexSrnIs4nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF11V_4E7NXOmCr2y8_fUr62wzBXf3i9od-58SvAX-oaA&oe=6A95E384"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BV1nWNcQ8iwQ7kNvwHwJMKQ&_nc_oc=AdrJrqYt42LJYC8uxFRWIt94IFU_AhVPvwEr8E93Ihh6mdCIR0nFfK_FXQ4aVcAVcno&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI6HN91k5JhdEh6c7rcDIZGUeSag_YtyRq3M5-k8ECew&oe=6A5E1059"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIBO7eavROgQ7kNvwGngs8c&_nc_oc=AdrjK7F2gDpnxK79Ph2Cj63b7oaPhEhyuhdGUAr1uKONO0G7C7sTBfUiXBbaodTynuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT95eO0WV9DuZ4t6n7mpNAH_i_iSpkWsrcrXFCfYzbkQ&oe=6A5E191C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG7JbsdKlxcQ7kNvwFLaz0a&_nc_oc=Adrf1Fy1g8-XsghMl53lCeUU7GhiPw-PhbyC_nizTDM4rreoROFNpuV2BpsPmaVWctw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh-B91FdRXs_RNRh-TgMnN-hK8ThEuB4k98aFs7_kbRw&oe=6A5E2A59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBkJJon6faAQ7kNvwE9UaNu&_nc_oc=AdoAl_fNYc7auzilDDCB0CJgG1YuYEyZz0Ip_mpNrU-MBrBWM-Gzih4Ihcxdii351lI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6P8Bjnj3yICJUW80u7YAj7ZDmHYgK2VVON7K5f1ozqQ&oe=6A5E06F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLd6r5mQZI0Q7kNvwE-_L-C&_nc_oc=AdpAP-F7j-uo2YagDifJlGqn4-Ze-dbjN1Qgp3Jx3xxDH7SIBR_5sRivZNgmenRGwn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq3xYsYiqZk92FYAd8R-LmrQtRUfO5qxfG9TWsrOdvOw&oe=6A5E1404"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
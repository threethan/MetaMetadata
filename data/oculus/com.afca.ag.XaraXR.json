12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYB_GWGO_SEQ7kNvwGfakf2&_nc_oc=AdrOE5slMnqP3b97JBccC69bhDRwisSpHpG3QGs7RUfpitxLzn4qgCWpWkKZTYpw-Fs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJFli6nQiaDBIqtPRERsk8enEl2SS9vJgDpd_CMIkT2Q&oe=69C27F59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJwDehMEiFYQ7kNvwFsSDLE&_nc_oc=AdqtHNlTOvphJMmAT_BtQEcpszE2qxOBcEUO6XXz9niytIoRLYPkSy3Jq_eNYWLrvc0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEuEjAhoSFYy8p1apFOHQy7cYcgBge01pIlluv7tsXAQ&oe=69C2881C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U73CVDMyofgQ7kNvwEQZHDS&_nc_oc=Adpq4iPqsjxlbBpWYMMnCw__GrUULjS70_5FnI38t8BSwVhUjIIi9YsRruFXcuM6ELc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzA8KhSnq-JFXZ00Ir0kCGLEHVl4fav2W7otY_5DPRCdw&oe=69C29959"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-z65ILENbYQ7kNvwHe3apI&_nc_oc=AdoaLPY8_hLDmELrLu-amdCIXqeKmbXiAPf4s48T6z0GjtjhhOTPyz60AVwvf__IyJM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiKhkmLF5YNK1x0gSavHQnL1Yl6KK7Woa3Cr0vcW_dHg&oe=69C275F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz-BgwrBz3AQ7kNvwFcwbKY&_nc_oc=AdrRaCUBninzWd1GNFvQ1oYkjlSO6mnziRCiewcYGNn3DUP8TtjE0qtyKTBlVFZ76bM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzK4Z-r3z-u_EDmBmMFTdsEeBh4oQoM2u7wQJnGUEeigA&oe=69C28304"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgBmUbmsN10Q7kNvwHkmR6_&_nc_oc=AdrEHQIY4AV-zXxnrhi485Gd8brgy4gEw_scfugIzekpmdR_-GVLYKGRMk4_KRFgIK0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITaTh5st283HGw_AbhLmqBkubRa9GWGzQzfhPU0IUFxQ&oe=6A9FFB59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQDGALcnZuMQ7kNvwHr8bdi&_nc_oc=Adpk2g-X7Lc2lqmEPRysHTnvpV6DUyJIYysOcJlzWwnccscfivv4NMHtv-ws82ZY8_8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2ju0MaG5MxrkgLzzJnLIooUYp0jqp9KhpDhJRybto9g&oe=6AA0041C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywu6gQOmvRYQ7kNvwGyuc9r&_nc_oc=AdoQ0-Wbo4ISUW4TDu3F3KK6OAAi11xlCmkcZ2NsblfeZP-UiDj02TG2VZYABC6LVoc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKluz_j_JOduD_284WNhTBp7IFOopa3rJXf0zNWfkUWTg&oe=6AA01559"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4FhzI9gY2MQ7kNvwHz-N-U&_nc_oc=AdrUAPdTIyip7IpKqLFdBMZ0Sj2tOJmG1DLA7e2cHsfT2LGrACC74xhXMh8Xulm7i-I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK464-6qbhhqvQgPf24xHLNYjJoJzSstiqkZaRXV8htSg&oe=6AA02A34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB3Vsu29QhQQ7kNvwEMPS_5&_nc_oc=AdqYhN30K0n_9_9FKYJPO2ALclU9tVTmSx2h3dvNJebs2dXIvRBPxZswDxpMjH9ZLgc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-eY0Uy-ib89g1aqLN_blZEdhNDLS-R0kzwiOuQjSgRQ&oe=6A9FFF04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYB_GWGO_SEQ7kNvwFtnF5s&_nc_oc=AdqTLQuRp0HdCSzdUHWgOuG8hZiCdCc_X1Z8xq1Sc8t_WF1go7fyfVPYXUETv02mFaY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzitNv-mqomyb0O25s3OfhhFE6JpNPPg3TAk1_PWmYKew&oe=69C52259"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRypvi-Bs1EQ7kNvwGNV3xw&_nc_oc=AdraXsCwmWuceXY79gfixaG8cQNr1hGoyJw8G-haFLoUAmFed8z-KDzAlxRxOyt2Sxg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqU89efN0SENsXJEmTorKCTyfDwr8O6AZHTOc4g_kSxA&oe=69C52B1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miKMLEqc_2gQ7kNvwH4YfOI&_nc_oc=AdorywhUs9aXKZn3pAHIXGDg4feUJO-y6GWKOtO63zZJ_BwMhPJajrcdXs5aidoxVic&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiO4W8oeIfOeV6dtUxPZwUwrA5ghy5peZFw9s_e_I6PA&oe=69C53C59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=th1L47XMAQgQ7kNvwEqZ45k&_nc_oc=AdpJpJIKZCD0_EGC7J2gf7g9xJbvAPV3JVt2euS3mrTXXThTCVNISIUwSjApfEtbnBE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy01fIUIgvr74AWaHKRZv0ZI3rFr_JtKI1l6JuywYXnww&oe=69C518F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz-BgwrBz3AQ7kNvwFtTOyt&_nc_oc=Adqoj-m7kUTmNg19qCFF71mMTknRxvFL4i8GnqL6UhqvIVpFxv5diETTRO4IbcgELyE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxQlnZKj5aeHABPxDw6Nj8l5j39j8FF__7ban2SgPIlA&oe=69C52604"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
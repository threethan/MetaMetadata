2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYDelZfCy70Q7kNvwHkUXQ4&_nc_oc=AdphZ4qhabdVwmfO37TEePpXIGnxjc2WnwMFlPNnsMpl-bESwq_Ga-1DOI-uRcmwUow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvLV7UUd7WD_Tnaxl53-0EkZeRsTPChscp4wdeORRrKQ&oe=6AC12919"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umWdwJJSLswQ7kNvwGuUrEf&_nc_oc=AdqOsGaHWI8jMPVCdbdXHOvs8Z_uCzIq8vuO0WCRGztsRtXP-GBprawoV24rfeZ3MFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsVnrKI1yhAiYm5aSkwCerhx__ygXO6kqFh_Z0km-mZQ&oe=6AC131DC"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYT5CApySHIQ7kNvwFBcRjO&_nc_oc=AdrcJ85rGk8VPLeQXstjADtEi5uTmAjUE1CxmUwUDKQNGZgM95XeIsp82MxtYGO3FxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZcrJ8qhx1r8IXfh9ZeU4588Q-tnya2Zj3wu8uEkmmFg&oe=6AC10AD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7BJ9NFSRUwQ7kNvwGdjCxj&_nc_oc=AdpOx--9hxMdXP4bNwWhxs0UM0l0LPjVBIypNrmz_k7HHAn1EE_GWMf-4vQUejoDNqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsLEcFXRRyTfjVZbnscE-DwLoKnf08NRMe7jaP9nkmag&oe=6AC11FB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wE4TYfXBLvQQ7kNvwE3DCyK&_nc_oc=Adoj19KIFTSLfWOli_Po67LOM0ubhMB9pT-QeLQO5J5cuR3ubRQ_8LeI7G8DL6rf3_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVH9lajHN-VaFZ3s23wNEcr3_08hJjkUmrDarwwwhOJw&oe=6AC12CC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
dnTQALOJG3EatREPz3vyxVA1iHtqCG2Ipbw3SxZY78L8MDlJj5DZHR322qT2zZILxQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu1oF_wtsK9Pk3K4vjmfpsZmKeUcv2KtR22fXyaNuXjjQ&oe=69A42CD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2T0lczE5DoQ7kNvwFzMBN4&_nc_oc=AdnoN7BFZFs7PW3R9iMhScTTmF7qm6yTPtseEm6utBXY65AOsLrv9hNAP0FQYeuArNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvMLrE6Dc6vkxKhoUso6K99st0OckHaFcgwm7oRDmQJ4Q&oe=69A4359C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg9ep7ppdggQ7kNvwFWGiAn&_nc_oc=Adl_hPNmdKrwlfAjg5umNtYLwr7KV241mcIbveOdIO2BcU7F8as2NNpllP5bsYb2Nic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvRVjn5Kqyz4MlICPTOeHrTjAbzk29NWdhYVFUGbUy3Iw&oe=69A446D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWER7o2_rrsQ7kNvwGaTkbI&_nc_oc=AdkIgr-1aGNzMfUNwOfDoXrdOVWfCMtxfhNqVo3DblF4tDJ-ZpBOseMfc1p-Yt4IGG4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuCwMRcZyItVgkse8c0I0Ah3JsdmvuRShC98qJY8YCA4w&oe=69A42374"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO7pUxj28TYQ7kNvwED8LIC&_nc_oc=Adl--aFlh6UJAMEEDApvrQoyQKT_EiXNbSfbLEL-EWVxTFP22ZPyYvqTYuUm9jCb3ss&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afts4hExrHByPU-k4hAqhR8gNJC3S5ijGmCLBWtSuaPD8g&oe=69A43084"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
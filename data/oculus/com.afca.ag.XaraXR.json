12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5pRXKm8rZYQ7kNvwEYHN9U&_nc_oc=AdoToOtXyGq7-IwRX03tGWWzWlb-1rFVVB5SG1-9-SVR6fZtTSylPw4ByIVT4wAqGV0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WyJI37AfETjn8Mb4EoG85hRdTnnnXx0g_gSRX8ZnP0w&oe=69EA0C59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIB5GhalIasQ7kNvwHDsN5E&_nc_oc=Ado6DjNmstUZ_Oop8Udc5QzHFbUyHLfp8W6NfqrZ9LmSH4SpDfvC_T9zWeqJWlLU5o0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M8uxuFl3ee3_QmsCGwrvVI9NW-7jinwocoKnFO4Xywg&oe=69EA151C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGsAQRK6AbkQ7kNvwF5FezF&_nc_oc=AdoKQBWP9pirhVOlYgiSSdHEhXJS4tEz4JQ9KhsYkAXwMsiyoFfm3W3YwIYqpDVtdog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hcwEbksY1s__xSk_puY-7krYybI54GLul3dSHG_Nz5Q&oe=69EA2659"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUjNv2NyXO8Q7kNvwFnsyyx&_nc_oc=Adpnv5PpafG3MuM5LTZNgBvRnJB3EO3TZ2FkNDEJmKg9flFuS2c3tN5xrvfCPDAq8Xc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PhOBeLGuH11XNyLJZLuYEK1yFoYlxtU6dyBkOZ23PHw&oe=69EA02F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTXI7J68ZKgQ7kNvwFsOz3y&_nc_oc=Adrm80U-CSgfFn58B3WoSK1IDYpkQHcu5ic8nmNG_NOBOIrAYD_QvGhMLSNdG7C1D3I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27fxjzYLVmlwCZrgDMVzD8xhJvCNqEQwFLC8LVZ2waDg&oe=69EA1004"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
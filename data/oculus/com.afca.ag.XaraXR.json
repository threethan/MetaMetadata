12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iqq8NkdNZQEQ7kNvwGoGc88&_nc_oc=Adrfqp29Mo10VkWsMzHBJU9kLJ6Hiqmj4gV6WnbuCLD1Du4Tf8ci8SnVorLJSy43K8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oWRaYvGMm4ZrQQtotO98lrTB0Fn-NsCIegIDgNl6Vtg&oe=69D25159"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elVafJOSDEcQ7kNvwGpwiN2&_nc_oc=Adq-BIUbJv5rkHaVP2orluCcdIZu-9SL5qEl8xiQai3OIKOh5jgHL3nICWDDXN0pVBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A8yqAvcXHtMN2acVU77kIz9FmUbXmBnuulgTbD5-VYA&oe=69D25A1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl5k5Vlq_JUQ7kNvwGUrOLH&_nc_oc=AdreJHNULq7MgB9wmtuQicInVvrGoOMOA4JR0UMvl0QposG18D3GIQP59NbQqAEicLA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FGCKSKDTYtM9Lg89T6tAgxei5I0Bfi_ToZAqBlh_BVg&oe=69D26B59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZMQm9jiTNkQ7kNvwG5rAep&_nc_oc=AdqXxTHGxgliqod3459q6--rnfCAGpYPIaElA7pGqFYfwWYalwyXm5OFmLQdG00bAUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HCKuxcWlinUUDaUN_hDUz_oGJz0jA3qbdY64d72BcCg&oe=69D247F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jsg_UeOMbYIQ7kNvwGganzg&_nc_oc=AdpBfPRqkFEWcobsM1Srl61afLGokJpuyLTVMzslS_eEnely3C-f3fvTX6HBvcZkY4Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qY99k2CD9nQtAdLzTnucGoFzM1MGNdfqCauRqRpA4RA&oe=69D25504"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
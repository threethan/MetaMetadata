12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz4wJcr3C64Q7kNvwFYkPnX&_nc_oc=Ado7B7LX2bA9KvpNoiZlwM1wcsaa0UKUMcqEr3sCWWVXkvGeUeDv6uixwBkxvLboAh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhJYY9SI_SALvLAUm-tcP7cqNV6bBapzRABt-C7Tll2g&oe=6A708559"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGYzd6oW81cQ7kNvwH_UOz6&_nc_oc=Adoy0ueRK8JakCqFec36_8d1DP-rRY-ZTupjx82fimEvwkuNvlB5QpAUa2a6Jja5I4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIZW82AAmJcc-R4sI2fgCPnxHya6iMSVcw3ZS1QNP0pA&oe=6A708E1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrq415V5ldQQ7kNvwEknf7j&_nc_oc=AdpnjI28Ungw72sIJtatmYFaP3olJ0mLkAN5UgxrGuMhMP7glycLT99Z4rxmLmA_l2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuUbQf46qJMV6VjRR3M4ITcbCnxugE5_UlE2tcw-xAdA&oe=6A709F59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQcaLCzo9CwQ7kNvwFaUtA8&_nc_oc=AdrEoUAofhSroCvWhg35y_SSI8_pWNwTv2QIb1Swod3YzBlk0cuK2N1VvgidBp2GRBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG19npGQqMud0cmJve3FXzBYA4gB7iCrp5zJcA46kogKw&oe=6A707BF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O71RcLZ7PQQ7kNvwEf8BK3&_nc_oc=Ados9qAFWRcRGQvZQBN2_g0XU13SiFeAe0bGDerU7u6u6P_vhpWTHugbCMsxlyZMEWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGCOO_CoGfC_4REcXuoWvvw3--kQTOqujm0PHzDCys7g&oe=6A708904"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
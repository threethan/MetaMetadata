_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9DB_BOWUjwQ7kNvwHq4-QE&_nc_oc=AdkB60YJGq0WiU7jDlPAADeAR7HyJB-XXNe2lxn71weTZBdLgj-6ko-sR6JiwkeF67g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwn6ONaS1kd76336oHfHfCESoAr1PGLcchXShccdfbxZA&oe=69BA9659"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v6zNK-yWjMQ7kNvwEVFyhu&_nc_oc=AdndN8iIMLBwljfH7giZQhjZ9aoQnSukGXrkjNrxE-Ip1muEPxdwO81MEczPVEi3ux0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6KJS-oa5d3MLc07XBpdWUj0WLSLytv6i-LvRG_iwaWA&oe=69BA9F1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC2IYi1csUQQ7kNvwH16QdN&_nc_oc=AdkGT4sIbTJNkLXnXig2iryIN9VvVWrWjdJe7z3_HLMxNTsLOaaOIdJ6kude2qG7Ujs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRiqRgwRI9IAA3oEpu0sf6WyqFsIUKelwfFNxlG_qDsw&oe=69BAB059"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnLDGoV1XCEQ7kNvwGLI09y&_nc_oc=Adle8O91a75DPvY3zafQ_MHzVtMhA-w8TUizThFCt7GtfGr8IAeI7iMI0P56eLpyZjU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvMh13EK3stzZanZKVieMIUJRUjwvB2HKfHGUQXA2DTg&oe=69BA8CF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkirkTeIc88Q7kNvwGSTQ5N&_nc_oc=AdkGE4BeQDhEJuFzlw-McMFV3HRf-sDWF3_GM1nhyPMGknHWVDMpCKa65gajBVZyESk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCwkC944bdo2D7Pt21ZRvCG9s39jSjTmx9nlE0tpmheA&oe=69BA9A04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
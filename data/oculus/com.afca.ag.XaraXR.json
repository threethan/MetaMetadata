2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1-1rpYbHZwQ7kNvwHc22sR&_nc_oc=AdqqAOxBJKkLboonz7o8GeOHIGitIPwWaEekhNxuNvtJAiY-o9kq-Dvl1-8gWanIp-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIB7VKUwGj5hwavzSYCREfZcYXHHH95zLs-94wq3n9cuA&oe=6AB7EE99"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJvtt7N3dfYQ7kNvwFmk7Eu&_nc_oc=AdoNjOkWZAui4lm3bNhWYEEu6nAt-eyyKiIQ75K9U3bg4JB7NZQE8ruMzbAlxcFuVgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh1ham38IDiUtCCsQQRMAnps0gHgwPVj-g_haMM5VNWA&oe=6AB7BF1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kELUIPA3A84Q7kNvwH7V9jZ&_nc_oc=Adqw3AxiHfwFqcOyWOq2uo_YRZEigBwf1VvvdvjzuNGnHrFgRrxFDBmuKm6FU39bk9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCh_9wogDjDK7_qnuPvJp8C4dqhSu1dwg6EURTT2pnFg&oe=6AB7D059"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vYIM8kG2wMQ7kNvwFuxoLg&_nc_oc=AdpRIKJ4MEx2XGTgT3jpIlMoMf1DxqRTcbLLIAbm10IZA1jBlY7mzD8bWCcouT9Y5UY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR8Qnw43O67lWDKK2IQZsmc74AIGkNcV6FuDk69_AQug&oe=6AB7E534"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWH9WsLOcnEQ7kNvwFw3vA9&_nc_oc=AdoLl1_x07SQ3kZl-6OvGhcO1CrmYWXZIKloHEmNaEsHdH5zPKmWiOBuy8-k_1Equt8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgxCL_vvWIZ58E61ExOkYdnEF5bswdqp2GInixtGbc9w&oe=6AB7BA04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
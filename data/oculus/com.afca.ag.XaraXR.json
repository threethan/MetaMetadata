g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7YHfQ8X-HcQ7kNvwG_EBHM&_nc_oc=AdlO2uG7vklcjpz4g0FZqe1qBsB_jzYtaGbWRHRnviZFT-jxVgE2czY3pVHsGo9MvqA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxL8MVvLH7i2XW5KKBNNyvtpa4udnq5SrbROCfw1uGlJA&oe=69AAC459"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aXL80iXBRsQ7kNvwE8JixE&_nc_oc=AdmDoiLSHirtGhBtYx3wDkGEJlBoHi0ujARQ7pCLMCz04Xrz3J4NgW2leIASxVfq_BA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJqI2arHb3JIslRKIKudkx9foXcLwB_hU1QY7QKXhLlw&oe=69AACD1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abJEwtGnrzkQ7kNvwFc7kfa&_nc_oc=AdlF7q3I22mJzybJLeomE_8GCZ7X798sbDUvsZ1DurzyMNxYoNGMhAo2O1EmBXOAuIY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7pbsTXpAVm-IIaV-9yRPNz2EqSipPKg_hxhp4UxhaJg&oe=69AADE59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd2qED3O-zYQ7kNvwGAMZ4f&_nc_oc=Adkeg3WC-EuReEMA1JhxGK3YoU1NRU_zG4Ot2AX1QDwDWvU2oqO6TLGpVXg4pFulzcg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEkxGb9wc6ZptOXX_Nx5pk1f_YsDUx3zpdBIjOjz5KQw&oe=69AABAF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEgqjg4UWSMQ7kNvwG_iHkt&_nc_oc=AdnXzy0duIzxTl8ECbrUe4DTuabhCNBThKtD2D6f4NU4Kx3k6sjm9r1NO1ITrWdR4YY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlyXSybFE0ujHiGOqrFg003ZN2S9-jxstQ21pdNyrPGg&oe=69AAC804"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED",
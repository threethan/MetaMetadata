_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3TgT7wpL1kQ7kNvwGVpxEZ&_nc_oc=Adm1TyD4DqJk2PMTaJ50In8oTMtMuyPzVrm5QvvssfihfK7MZ_V9eyVbTkeTvQbG2DY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6_R_PXte7U6RiyjKJhs9qlsNGjIO6WBNx-3CFPSMT4w&oe=69B6A1D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udqhy9Fc1wIQ7kNvwFVFsHs&_nc_oc=AdmdMcDcMV-Gry9iH7ZUuuUkVpg2OJSVb3JpvDhNcKviAVpSWYmMVO24-cTRfx_RdfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afww-95tjDSl9zQKsHR6LwG354Hv9HKhAfi7ZAJ3JEoCyw&oe=69B6AA9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GuXD003kGEQ7kNvwG1g9mc&_nc_oc=AdmmiapmksT3RONsgQV3Tppy5iX4ecHJx3RPKrAFuDkaV4wfM_dZjIXbsYzbh0p-2B4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwz4kKGIgpo88sYVMq1fAuWOqy2NRPfI61bKzTLGgDFxQ&oe=69B6BBD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLqYQ78EFzgQ7kNvwHz6Bk9&_nc_oc=AdkM0UncWUQBdo0vq88A3cB4Kriod-_C8pJjtTSEHAt_DygEnkYco-gOvj1LK9MaG1Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0V283E-kqMMOOlKolOAc9Vp7y7ZxBd52uJos6jOvsYg&oe=69B69874"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPBOiIv7f_QQ7kNvwErbEtC&_nc_oc=AdnhKDR-aj2gWuO5Ni5j0e5KniW7PwGoIKC-9JFnANAucbrJrB5YTFH8Vlww2mVNiB8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHkMzgkNC7pPpONqtVErL27b6EkYqyhzZ5v_iY4Mzrpw&oe=69B6A584"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
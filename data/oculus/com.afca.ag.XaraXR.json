2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgBmUbmsN10Q7kNvwE1TTBL&_nc_oc=AdqrSr8u5DI-ZWDjLPuTknNZXrcM30fwhmzCuIaKlsqs_RAXHZXCDqk5TGiHsSjt3aw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKysnwP4pa4Dnp4RAOIUSTOlJBGWFxY2DxYlmhULmQGg&oe=6AA14CD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQDGALcnZuMQ7kNvwEZigj5&_nc_oc=AdoyCTKlls2doMQ36MpeTqJ7H0kJ2nrE6cKRR7QvvDb7Nh7liC1ZlU0xZNXW-BXkLMw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaFonzkeSU90ZAXyLgEiOjKt5chobCkkgJ9aso3A8FWQ&oe=6AA1559C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywu6gQOmvRYQ7kNvwGKxWB4&_nc_oc=Adocd0dZudO7DrI8zVW34xbKjMcfZ-F4bderl9SM2izNCQCq-rTx1Nm9BofrIDqkxJ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWwvAiZnhLeQ_iwZVd0AJGCUaFcpw7siDxki6xqCdBuw&oe=6AA166D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW_DBjGi-7YQ7kNvwFcuKLY&_nc_oc=AdqGln02Zvpd0Lzy3We8xk0Gud1lP9b9BxvulBBlIGLnJHo_WmrVen0V2nhMbDm4KnI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTQ0zSYu_E6xpsdA4MrhBszp5Dm7wDUV0o_V9lcAXnJw&oe=6AA17BB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB3Vsu29QhQQ7kNvwH34-N0&_nc_oc=AdqhzBkIckzjvLSyPlp6s4wJ7Ik1VWesNWbU1FOdubbaQ1OauQQU2vlb1Eu9-WIYHz4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJk4URhg3WzvnuNfZl1yKVkTopPh_sRz97kmOMnG0GjQ&oe=6AA15084"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
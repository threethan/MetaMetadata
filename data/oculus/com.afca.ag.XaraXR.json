dkkz9XbtmmD50SEpOevzqmEzzALlvu6v9HQ3oAozVNBYZH8QowJ4FG_ppkj09l38Eg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuLPmNOYCpTtpLEz1Eo-kOfoqfu6nlTkhCwlxe_12s7mg&oe=69A6CFD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DVufLfDJA8Q7kNvwEiYSXY&_nc_oc=AdnsJiP8zXTkQehRKh4oWXPzuR_AMzW-VD-NSCHPSIA9B1CCtUu7Cs7dzXl7CJGW-io&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5IIB2fNKtPRBD9uq9sHttMyTlqV3xL4kTBouTtkWR2w&oe=69A6D89C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNVVYOct0k8Q7kNvwE10hOR&_nc_oc=Adn9ErkC8ZmIPVOdJv13UW4eBxb_XtStZAG_mNqZ9svYnhTJziKE4RKvtHmoSj4mMac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftkLiXeIj85dII-gyjwzQQDgL-4BZNU2i7woceAGW7AAw&oe=69A6E9D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWER7o2_rrsQ7kNvwErVWlq&_nc_oc=Adkn2Va82v7_QnlhTWDABWHWEh2W3BULN49mmZp8_YuB2H6__bL0QhKeyqfyZWX2VsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu3oVIgRkGnVcyUKSMLaxPPzEEnI2W3Bci62qkxIL46Dg&oe=69A6C674"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGWJc6Nq3mwQ7kNvwFd12NU&_nc_oc=AdmffuoF111PBF5Bsq6a7d8G2k1IKUtRg9wKoU52AYe59gqQKdjhmMNB7HpMaNwd8rY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuPehGDU0hdBxvQfCkSBb-lF-ab_C_hkOXy9QqGFbtD5Q&oe=69A6D384"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z5wvdk_ELEQ7kNvwGsi5jh&_nc_oc=Adrz_jaVm18pyMJDmH_UTOx6GguC_3I1Woq8beDYjbugP9RzoEKoWKkjvzaLSh71qig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzM5k633zPRNSGUKiYxd32EHdYYS6VA4gJWlIfvPzqjA&oe=6A6204D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkdeJrHqyHkQ7kNvwH0mt04&_nc_oc=Adr7hO2zvjpcKzZcKczHZOELyUXzCmrTbigLjn4g8kNwMz0vKc-CnKHJVQwhF3zBcZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOip8WQUVN8vQMPwicZEJH9yHnWYgvnGNcxzWv-FJ5mg&oe=6A620D9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M-jFEatTxoQ7kNvwGzOKxz&_nc_oc=AdradiChGYR9gLNhKGRukRzzm8eiFfeRSdTCJXVxoviQws9uDVDtAqQbD5ET9eSsyJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGB5ROPB8yGUJ4aXTJF7Ngd8nrOu9JM8uZJ8Kceg7W0Q&oe=6A621ED9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGduk-yANhkQ7kNvwFmMv3L&_nc_oc=AdoyFhAPXJeFiYdWbSQbkx5cbLOBnxgKTO1uhTBso40ssrnpu4hu5olAKlsRozkBL7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9VhDmkMbORE7vwrM8sCqum9NbTMN5u3PsvMCr1LtS_A&oe=6A6233B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XahdnYVrXHQQ7kNvwFYyvzP&_nc_oc=AdqJKCLnqvsTCanMeujRmQByLy_v4FUrpy-e8KQxYZcZRg8oO9F6b1kHXwSKRS2Emb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf1nFb0gpq-QRyjMfR5WxAnFU-9r4J4PeqKwyy2AZjxQ&oe=6A620884"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
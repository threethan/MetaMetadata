12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BV1nWNcQ8iwQ7kNvwFWitvv&_nc_oc=Ado0H6yIw27JQT8qqyYpl_nlDPyJHzY22AHCYhMAXVYPlNrrnglQO7qk9vsBLNx4-Q4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgJSTrEMiHqm35jopHXKgEjTFkIdBhvUS-vc1glcmc2g&oe=6A5F61D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkdeJrHqyHkQ7kNvwHQU4uX&_nc_oc=Adrap1nqa2jWz80WJ1bk7857Tc10JDvrzNCH2Tx8THFLq8uPcD6ss2NJSC_RZRD7Rig&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASQ2PWyd3y13TtB9dWkngTTsBijCQcjJlzyo9zoxCzXQ&oe=6A5F6A9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M-jFEatTxoQ7kNvwFS-aq0&_nc_oc=AdoAzlt1ZpfLOyc89KVpUdF4fWtFILWj3lEVYPf1aYcSb0YJI0AmBEr__KbE7oW6ZK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyQs5Vk9JWWtjx9wXtE8kPRsxt-yw5TGaS99t42_COvw&oe=6A5F7BD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBkJJon6faAQ7kNvwEC1ahV&_nc_oc=AdqU6uVRoDqYGJEHioHQ0d_Wr0PW3NI7edf4MLuHmdrqP11370XJRpEtmiMQR1mRwe4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe0gevNMoBLC41PPthMVCOZ9Kh9gtJOwWtJQGB67-kIQ&oe=6A5F5874"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLd6r5mQZI0Q7kNvwHVz7B8&_nc_oc=Adru2GrzE7oC3KDUJFwwucKIZ5rvLaJgDvESCNNCbieDo-tOzPgP2KUFg5tfFZjJ-ts&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcLVjWetP4btxgTSbowOCAF0-cqU-X96ZtlKp5ao19EQ&oe=6A5F6584"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvE_MWDpEKEQ7kNvwEGw7CO&_nc_oc=AdoVN714XSZqoQuRIIldjtyEGVL7k_ZL98yHVosmuBOSabiOCkwTjRpxzlRx7X-H10o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wlwLhCxuv3-zoe1iv1C8c8Vd6MlS34dxlE6VhzzjxaA&oe=6A283B19"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TTlia08JOgQ7kNvwGbatjM&_nc_oc=AdptZ0h55FW7a0xhTUNn4ogUwm_T_ls3VUdzin1WYf9S8qn3HqycwvhZ4Cy_GhMYDn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HuEIbd33-r2er5c186VrihNgDCbIf2WFi3bCWexuNcw&oe=6A280B9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7MXkXNJ1LwQ7kNvwGjz1tg&_nc_oc=AdqZ6eK4SJ9VieD1SelEzvOosqPl4Pkja2uU08UofxFoZreNQq8KoZd3N2PFF4bdmiU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1OQuVLBL0i5zwtrwDlf53L0lehHfnjixrJ1J4cnf98w&oe=6A281CD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8KvdyHPg8gQ7kNvwFqkmq0&_nc_oc=AdpwI-FM3QA5Ytq9G-NJpVvSnPMhu3EDfJhX8Vc_K8YZsYCkGusj3PPRH8BBGzSiqRQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89ehRTaN2QLH6vgSXVrR9auqp1kkJ7k_eEXqlqta4mzg&oe=6A2831B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sT30XHmRu9YQ7kNvwEL1SzC&_nc_oc=AdrvRA6QaA9-JlswekzvXkX_BOPnRGMrkwsZ_DE3FPXKQjBoNmGJ-a92MIYsAV5BtUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SqlFlI36oFmPPujd2b9YOFUtPJIN4tnwDpzJAcQ3-Sw&oe=6A283EC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
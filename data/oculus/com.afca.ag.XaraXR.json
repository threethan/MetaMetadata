12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvNHUENmbJ4Q7kNvwHDws_Y&_nc_oc=Adrnib9CiAlxmq5qr54LfoBohHLaDhCgU-Tg3XrePNwznH5HR3UoZRHeho_Hpa1VDm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KwWFo6NiREO4asSJIevuIbZtG-gkRVdMgiNYr5ZYfkQ&oe=6A3AB019"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTjiZz72WdQQ7kNvwF0RjIN&_nc_oc=AdpIl4rL6be_dORwEfgPqq2gQ33IbpvzMzTwiJfmLGAHBlNxu-p2tbc6-f7jlb0jnmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xu6aLDhYfCqmcRjPIAa619mZzfsfVeJdMoHwrRZ0uZw&oe=6A3AB8DC"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTHK22oBZcAQ7kNvwEuP1BZ&_nc_oc=Adr5bfAmRnaBod9GWuaTvHQPlnxYdGML3xgqGl7-3Yg6BSPZFQQPCLVTYCW4fwb8OO4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RHdJh2dSJXFATfVXQgEycMtko0FbQSGAYcIo8sYlHcw&oe=6A3A91D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgBlkC3OLDEQ7kNvwFivpAC&_nc_oc=AdqIjAzkB8W6Q_IK66klnxpTEIq1Kb5-6k7-GqOkspgClVkJzYL67WO7J3vFojVdanE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-nmYw3CB0lzRqqKoB6c-RHRdvy4tz94lXTfs8EtqKGA&oe=6A3AA6B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPo12W4nXIgQ7kNvwHc7-jx&_nc_oc=Adq0jgkq_mBAnfqIujI_qcUahwMhkOl8lD-D8dMTUa6_stjIWBto9IS1CVOKX9s1Ffw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89VSdla_nZf9FJBE3SlWA9DqzZxhk99gUtInvcWvpuMg&oe=6A3AB3C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
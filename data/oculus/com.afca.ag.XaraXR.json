12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi6MllMdQ-MQ7kNvwHx_xf7&_nc_oc=AdqusCLPlVjt3MYaSrb-tjI2oh7iIr2buZWrmeYrHTzk_SFC50xep1PL_AWPclqwYM0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22hmITJn-DV6HR1ZMlVQvIQP43zVhlShySU0xIYDXx0g&oe=69EF5259"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_9v7n2C-4AQ7kNvwG1uh6p&_nc_oc=AdrdWXgtQf-1LL0ywoCQJiW63QVdE0MKjWF2MbJkfW4iijyDvx1GxsINLB3Gp61EEVw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YQMUEpZ9r0iHiJze1mSg3BtUA2Rmgw5yQ3jcPZ_dBrg&oe=69EF5B1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd1_kO6paSMQ7kNvwHW3NLg&_nc_oc=AdrfYOlPJENLNAP1BZq2WFf6MCVGUydVWodn5saBtRY-p2DNZ1KXE1LwIkE5aNN_cQY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JczspQBrCXBjui3XxJ2xS6u3eKqIdGql-OP73UlidtA&oe=69EF6C59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1ysup__Xu8Q7kNvwGHw_Y3&_nc_oc=AdpIKk36fFQvY4C-ktUeE4wfZ4h5aURGU7IaxolKeBF57j22F1czcYhabThyfz4c3gE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WZG4vWow_Gj64FNqK8hyUH5jAZvPYsK9mvQybbefhbw&oe=69EF48F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_9GE9G3YOAQ7kNvwFxpAFI&_nc_oc=AdoTQn3OYgO89WdFKcI1CybEm7iG770iegpVrGF_ZWI5N1AfQnfNwpym5eQ6H07YyrA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-RFmDJ5JCYzgnYkuDlJXBFCDsRPRTM_KXqiRtiQMd9Q&oe=69EF5604"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
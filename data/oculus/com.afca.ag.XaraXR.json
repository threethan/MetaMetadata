12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfLfZdShmXUQ7kNvwH8SNVO&_nc_oc=AdrmSY8EERuUr4TBK5U-4jI8VxEA8wfrcpaiJtRo04W_bDOlJEr676vVKjelscyZwFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6yH3nsPJOz21mNRNUJT7B8UjTsqfmIwXSlaeGEkVuPg&oe=6A6DE259"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddNsXPPJ2-MQ7kNvwFThVLF&_nc_oc=AdpA0Znbqyi-obMCNCXlUbCbSG3ZFJ_Tq_4hvIOhPiPfMxyqmoKIc-eZzIBYyZ5BiXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC14a2Gz_TdH7EJy-P9N0OrdG7ilgvThJyPl5ikHNEi0g&oe=6A6DEB1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxnrTkdRBfUQ7kNvwE8Ozn5&_nc_oc=AdrhnLcHfk0WHmDOZQATj6D6_zZe5JAOdd3abgqWni6ffRUcPdaLrJCCw1K7I-3-elg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEOeORILru-x_R4C55OMMtp64D2UqJEAM3k9X1D8_r_A&oe=6A6DFC59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQcaLCzo9CwQ7kNvwHSwb7E&_nc_oc=Adrh8QTkZfixelUMl3qvXzbmR1ABqfy70iPVHtP4MtPZVl4WaRZ7kO4Fer9-XhbvDLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0eKQUVs6WsHDKiJvIFDZEoHzE8rL3s6RJbVO6TCdSdg&oe=6A6DD8F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyZeFjxfLScQ7kNvwGLKiFb&_nc_oc=AdrnecLMvIWX3TGEfWl2ktB7KaHz28EEIoLmY-6ZhPx5HzcChmfo3s6r1wa8gROyY08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp6MASgW3U-ycidA0TKc-w9_QgTAxV068prg7I_TS0tw&oe=6A6DE604"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
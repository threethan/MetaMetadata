12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXrPkxdDh60Q7kNvwEKW4Q9&_nc_oc=AdqcyA1o0Bb470OdSTgONrL2aZkNu8bHpJq4kgOSoB_Wz9knb9mxeoU6-gW8OWyRG5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45j0QuXyAd1RYdsYXUffNw7AtIEVMTfc2R0jOqBv3BBQ&oe=69FF2459"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h08YRG7JBhAQ7kNvwHYeLje&_nc_oc=AdrxX3t71FwBcD-fl-HxG9TbolahGL5QPejpIhp1flamADBivlrPWV2lnib8HudyWZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ofYq5SWzcDxj-Kmvssxn0BEKY0f2bu6s8VVNW49bNfQ&oe=69FF2D1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRaWCuirvm4Q7kNvwGI9sUu&_nc_oc=AdpnAeerF0SLptAQZhPrwW2KdZUQ3nPirlaeSexxE7NF5K2yuwa5O5BIVPysMoYZTaw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G4YHX_IqZvigFpYzxWVfjPDcwub7jV-PNiYmyfGbpPQ&oe=69FF3E59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekIWzOmwc1EQ7kNvwHw8fP-&_nc_oc=AdrwqIFKe7QYiY2YWE50PgS4vtSx27Vclrliw4Uujh_ScTWjC1Gr9mZzvZy4OGWiMa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hLwlKJDentKoIlkhPxFVVXp_AXh_seaUHcFGE1ekQuw&oe=69FF1AF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG4chgR2vUUQ7kNvwEoaUOt&_nc_oc=AdodCHxRz0BHkOrRIQGRreoN0oHZjbB8w4XiHroUxqzW-LLk4L5Wqwel51sSI53D6mY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xsk0Fm-0dnN8j6Liad2S1pwczlORRGaBj8H-O1oaRwQ&oe=69FF2804"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi6MllMdQ-MQ7kNvwFGCrOL&_nc_oc=Adook1EIq9DIlOlFNAXu8Z85Hj50i7XTqFQSGXLFZiIlXiQFon5XMsEjB0hwODd5Uvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-8GLtfJvkWf82riXisjutaTtGwfQo3xoeE2mywvuAuA&oe=69EE00D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_9v7n2C-4AQ7kNvwHsLA41&_nc_oc=Ado-RFZ6Rg6bbdcUW5d0S4kBMRZsOR6y_u_8Qt6zXeYYN8Xjvvjzpn0iQ25EkGkY2MA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hllrTPBXQJKtSQtnXt8ZjpHNz85CvQL9p_yrpwvQWJA&oe=69EE099C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd1_kO6paSMQ7kNvwF_IeUd&_nc_oc=Adofn4C2jXQ4_Ayx3BXK5bgS9T2p2JpeBJ-wPDC46vrUcac3CEJnECOJ-rPHmbXHr2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y0UMVGoqgDxO2NEr23yj9B7iUttxvUdYFOTSyMzl2mw&oe=69EE1AD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FRk-vRpgjMQ7kNvwH2xiq4&_nc_oc=AdrhZJKP1z-jaubCD_Z0uHV8EFgMFQoY-muAAfQraRfNbxGV4bGUK2S1-HlEjIN6JgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AvDLyatvkhJVJI--_uZ9G8GiIb0cmYUl0ID_WdcD6vw&oe=69EDF774"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_9GE9G3YOAQ7kNvwGKuqff&_nc_oc=AdryqHngJKh8a80SQo1vRUDtr3cB9CrI84CBlT9Imcuh8Inb4pwTtG6XOtxioXOxj4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xBSdxXZRLyPcv9FmzDkKLlncSqLtplEkzFbXj6AD-OA&oe=69EE0484"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS3Xoy9UKl0Q7kNvwG7O2ET&_nc_oc=AdrN4dGrdcNxI9kbfHxwiEx_bO4i98Yi2Ph2f3D9cMS0wWT2COQeRi9JM0IYi9TnkTM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1vj1N-iL5w-0VQH2ifUIFmzvtbhwDXhyJV7X36uU4lg&oe=6A941DD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNetqKLJkvwQ7kNvwHdiQOi&_nc_oc=Ado6rtwUh8krVbltfSUdUHxEQXQEukXLj3B1_HnNMuMCtelW6kewZ6uIiklbsmCxJgc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFADU2QGCDXu_oxoOMAGUwAXI4D4lXlpT9PsJoiFcIVeQ&oe=6A94269C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yuOTkbR4rkQ7kNvwHd8f-K&_nc_oc=AdoWoY5uy70kWNDlBert4Wn5CXv0orm2Djd8kKONKf127CSzq8EaZypytxajQy_zjrY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFosZEz7rXbG_cXiX6xNhGuWC-kDXfUcIUbhTQWYbBbjQ&oe=6A93FF99"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5hocdi2YxwQ7kNvwF5ruIw&_nc_oc=AdrF_narxgY6olgatqUsCJc02a5GYIKgfAF4Lt2rcyKEZjTtC2XrDZBDydCWQJcaMUY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3YHMwS6hSkkb65Nq-jYour6Qc5c74Pd8sneH5xhim5A&oe=6A941474"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs16rsAXwCsQ7kNvwElu_iG&_nc_oc=AdrYCYOtu2R-eTd8-N5QGR-vklHwLX-gKSr7-SHalDVqXpXM1uaShCXsg8CERenEErA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGWKUNrzaajFaUq6AvI3XRvj-QgAcWiz_GzftC-IBefA&oe=6A942184"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
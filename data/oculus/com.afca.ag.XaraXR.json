_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNz-S7k2XzwQ7kNvwHaU86I&_nc_oc=AdkP5MNnQY2pVD_3GTkRgjqtnwgjJG_vjewOnSu1oS8U8FIpPCxU31CD5Vncxp9jf5k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDCOl3Tdzcgne2wPL1zyLoG1NWoSsJdPGi0kf7TX7Twg&oe=69B2AD59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2gYVBVa-lYQ7kNvwGcsHgO&_nc_oc=AdkKSy7PAyfJNeDrU-ir8ODR_XnCzMKf2ESSUKosqE2qHYwtZ-xfQDkbzPEiutAM534&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw2MadTdVljMsoltqgUKtzGOrCY2sFNLQYOxeNxWQhlCg&oe=69B2B61C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNRN-IT9SBsQ7kNvwEF4lf1&_nc_oc=Adm2kSlLZ5uZBI8Yq_U62uLrqpOWRu-UR9zrR6qFrpnbLuwNMqBEWmAZ15RjdfqxUd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_bS3nya66LVttKuviSSLDY_kWzmu6XMxD8GM_m5neqA&oe=69B2C759"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XD8L6iodCUQQ7kNvwHJNdXx&_nc_oc=AdmzyIBntEAoZaQc-m5-LhQywFjdr2uhgm9Rlcxos8QDpnNDqclpHA9BZzL7waGlwiw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzY_3UVKzl9O3_hq6DDT3-NrN8nSDNj4sZLSkga5DG9eQ&oe=69B2A3F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u44detXeekQQ7kNvwFSram1&_nc_oc=AdmxhwaH9TrgVhXXkAlE9-bFGD-9MdYJtD692eu6vQYxAB5EnDNinQMGMEKYqKLtrSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4oAIyf9GnRftiClIhflEYccwghZOlHjXZtJhc1EKYKQ&oe=69B2B104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
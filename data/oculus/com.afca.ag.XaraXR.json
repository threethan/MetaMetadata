12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVAnmV8Jdx4Q7kNvwH7FeRS&_nc_oc=AdqgiwPFgkdAEF4wLFzipgJq0ijzu5el_ykZS2yHBxBErn6qlCIvFsbSJW6bY9UsPV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08ynacLv4PHPdERsweDni7l8Sqb2lDUZeofWhKxbglWw&oe=69F73B59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qhGDImzZvMQ7kNvwFjK4Xm&_nc_oc=AdpwRCAOiOsfoQcu14WFPmgkFZO9_4u1G6pK6yLJt8220K0fAgxVBrgX3JWEMLgUArM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HDke0--g680gBP6kLKE4avp64bnxopvRiU5fRIhy5Fw&oe=69F7441C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhPzjgqCSN0Q7kNvwF6a0Gm&_nc_oc=AdrISKvc9RG_r7svhN8oKK4qXMv34FGSgIISvPH0PXH7nG_jTPY4hpMezQUBkZgUQ6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oaPTPdFZg_xI325jrbo1ob11A_0tWjgFf-ebIn59TKw&oe=69F75559"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY_xs6HIdAgQ7kNvwETg9IY&_nc_oc=AdrOUkaetU4o94AWSohS7tElOlmdco1-xjoOVAq6Q-cHEI506ITtIrND5Y2PBcYN-_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wTnBJz3Luh89m5aWsBq8_igaroGh5bMC23-d25JmHAQ&oe=69F76A34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvC4Gvqzyc8Q7kNvwHz5dYt&_nc_oc=AdrDwtcG3TD41oPRDNJBDwx7Km9oJI3gLLL02svO5O7nwgHIo9xwxzwE0GNTqDWKS4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HBBBTEOWw3cNRfwmR8SmxqhywTzqrrTmRRGPOX_uVPQ&oe=69F73F04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvE_MWDpEKEQ7kNvwE46vBx&_nc_oc=Adp1cXO6QwupVha0j7j90CIqzODflX8VQa23Oyp0-FNNd7mxRV7lQl__OSwKftt8KGY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dcm9zaZfhXAAH5t4EbG9THltQ-eYtKPhLLO6ZKG0wTg&oe=6A26E999"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEdQTEqYW_oQ7kNvwFHzcpD&_nc_oc=Adr4X8TyOoWR55PJszRlzJ6I1IYMKwl2uaYm3BSEN1wkqU30u-zYb4t2zscLmPayQVM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H8-gbFA-XelurxEwQXHcxP9aVC3azofiDJbBt2s-9ng&oe=6A26BA1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYItTNXYpXkQ7kNvwFbe47H&_nc_oc=Adr1-DfX2NVigU_8My7Y71CSUMQn1sglR_KYxCzFokWfbEo6sig3Ku9cUXVQKcQOsv4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DXz_5ibms5Bn6Z5dwhyC4mhis-2e-654caADaea_ZUA&oe=6A26CB59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8KvdyHPg8gQ7kNvwH1PS6l&_nc_oc=AdpeBrvoywIaTlgMDFChLSHd_5NyjP5d2iyKC6CazY4o7Y0XZKero3d2yJeiJ183Tbs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GqVsAz-BwJMlq2CdOG3pBYZ6939eq5kr6KBTFCkMc4g&oe=6A26E034"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sT30XHmRu9YQ7kNvwHL6nhP&_nc_oc=AdrM8j96Qluo-Jcb3zysJ_Cz3LDRPPSmBSbukNHZYNiX4oaJBqVvt7_QhfO2yi30NS0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iSGmco499BSxxZkaEmJju8ORhlpmN3OBsyfqbsh2HrQ&oe=6A26ED44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0GGFJK1N3kQ7kNvwE24vIZ&_nc_oc=Adojm1HKSEH1G179zPKobQWh0y_zNOuc8B21TtwNGBA5dftiVC_2CjcYa2RcEvBJpS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dOHuKQfaD-hzQniV4u-UiG6DiBO1aPH7jV38e92KwsQ&oe=6A0DA4D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVpJsT9e3TkQ7kNvwHjglr-&_nc_oc=AdpVkH54iFALMynFcgeBYiGCFH22vLJXUaODseP8tO9kRMgLHOpbYigN3JOhoafYA9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZFpevp97CCfOwnFycGxqvdDJy4oPuB0IyGqyGBvMjDg&oe=6A0DAD9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_hlEgXiLxcQ7kNvwHl8TbQ&_nc_oc=Adrm1Hg1egpeAFTs4lNdjs6frFoZ0eQF6yGTIA_y0TR_LYqJW6ljcqzcp2bod_lNn4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6javboJBvVUbFFp3wrxclfqPuowNQmRoUV8h4SQogR8g&oe=6A0DBED9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEdnjfTTZBUQ7kNvwGXSouh&_nc_oc=Adrc907SzkkpnhCEuOTFQwj5wPjvRyq95lLLkoxF9JnOczSj-tWHqrKv6Xa9O5_iuy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eE06L5ORCPUjHvBXmtBJJZdMsu6suf73j3M6PbVvjOQ&oe=6A0DD3B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es7JfoXwGIEQ7kNvwHE685E&_nc_oc=AdpoltxfyoHuNmYNTfZkvXbBSyDD1iw4Q6l4P-qVka-sR2B0Cxz0-e1z-5l16U0E0dE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T9ImUURjhKJIESB1vqaamrtVXw6mFTBTfYRie37R9ig&oe=6A0DA884"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
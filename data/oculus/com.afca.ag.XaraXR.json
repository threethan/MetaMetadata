0227612_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvNHUENmbJ4Q7kNvwHzppUL&_nc_oc=AdqPMhWaQChrogeA-qAccLgZmhzVNbzWuA_zOR5hblFjWy1VlARAoE5qgcQZhgt7v94&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9XhHAxM1qRzA9Ke66hvjioge99S4z37ti-AauqQmGlw&oe=6A395E99"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTjiZz72WdQQ7kNvwEVwPMt&_nc_oc=AdrX2oTqRTwWdc5NgmX4SGo-qgYBOICjdWq35rd5y8Ad63xTgkVgnHNs7IhqNbYE74M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Njx36SZD5mxkTvQ-GHpxbNY4SbGH2QpriOFuoirUkcg&oe=6A392F1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTHK22oBZcAQ7kNvwEk-X66&_nc_oc=AdqPTVMihG2YcqtOianUNZipASa0Vm1l0v28pXTVPmwLM47rf2M1SgOXuhy_TXKZPfM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wqTa7onoUFVqETOOArPhFq_jPu7IdtD7qAnZ0vZqa2g&oe=6A394059"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9PjVgz_HzgQ7kNvwFe7ROR&_nc_oc=AdpGpA1z4H34_KAWatH9vyhe7RNbjkkvTdPKa4dO5w5EYJ97oasFazD0N-Vo3qdkYtg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hM75tiyJcQ1HQvJ_ls3fu_vYsd53GBNBRGW9cjuiGYA&oe=6A395534"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPo12W4nXIgQ7kNvwGVjag5&_nc_oc=AdpHwwe3-rRtH60xdqbZRa9Q9XaPluAyjjGbguIdMAfySMt6SiwRwddTNkryBza3YkA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WpKa472IX7UXNjMEsTU81Ox3_vegFm9hHhLOMNv-_9A&oe=6A396244"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yKsLvcDlnEQ7kNvwEDgr1z&_nc_oc=Ado9a8A0rM48TS7zVkfBl9Sdvgg0v6GNE2ZGgVOcHnLVIIxoQRTokRl4oy5nK-s2y30&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGKwRPlx-7sFLyaZa1b44IT3AyxRh6n0LsgZPfFrvjEg&oe=6A5A1BD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFSNj-YvevQQ7kNvwHsaqmN&_nc_oc=AdpYyEhAQIB-i-jNjOt6Ac_VEAobnu0LsqOVHDdNienwLGIWwWNDpxyB0-j4LGcrbF0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH7MD-Oo_czHMpeg_vZKpoaeuVpuYOfZMU28DbdcHgYQ&oe=6A5A249C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWO5ZLnCznEQ7kNvwHwYa9v&_nc_oc=Adrql9v1wEy9wqYbm0RrfIfoUmfdJNZDFaDaOP_iDnN6clswzO_qFxd_qcacH0FMBac&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR_2MwIcQ0ZUFAhPOEqELkaNo11W9ePioSrVe2leX8uw&oe=6A5A35D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-ZE9DALr8QQ7kNvwEv4nt8&_nc_oc=AdqhrvHLEdx_5TX-o4j2w1rd0EyR56iWlBa0ZHwUYJ42kzD7MrfrW-b3d1TRcTae0Uw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0Q5iz4Nar7SBTX5YnQXnrO9TdaaS5SxoS5NDj6WLHHw&oe=6A5A1274"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewBET3QFDssQ7kNvwEeTLO0&_nc_oc=AdpR9ct_uhR-ncpNlegvpBPONXj7eyfhRz14Xmd8i1gqOp3RMi7r29XixcuBVDHV38k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIVC4wzHw1fBtMXAfGdnEPthDQs25_XZ-kX5Tn9qa9wg&oe=6A5A1F84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
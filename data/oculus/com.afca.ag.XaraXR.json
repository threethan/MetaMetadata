_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhXNtHo5fwYQ7kNvwH8Tk2S&_nc_oc=AdnH_4Ri8l7DlvtoSQ5MdhCEOtZ7b93u61ZlW4ZOxVHDOce7tCUpwdvWkBq9QIwntE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwI-LoD3vBrT_LQFVk4EZXwVBvLMvGQBur1SHzPy8Krw&oe=69B00A59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8Kfbo6828kQ7kNvwH_kGGK&_nc_oc=AdkpcAw51orUFS0x6S4DHzgkJJiHi4USBnWLalUSFDJFuZgmZGFcWnR8rxuYZUfdZ6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaqOFZv2UGcyAXPLMV3iDXuwNQsooECxxVo2dAoagkww&oe=69B0131C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnS6St07fZAQ7kNvwF4WDpH&_nc_oc=AdkSG0nTLXpuGCrF1SfvvctFwOuD0U0bDbACX55shaSkPTPOIxb-iKKUJXtJne5LeyE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmKznayJfKs_iMpsQYGKdEzVlZugAyO-8qL1mohzxHjA&oe=69B02459"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XD8L6iodCUQQ7kNvwEQQolc&_nc_oc=Adm1YCGyVxJZc_uuPY2Xngyj3YfCrNiuBK7kyUc9LGRmcpymIJT5D9Vg2x6IDhXdJVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp9Qh65yLSfpJJiGCG1mBu96OxUDOhElUyVP-BFa6m5g&oe=69B000F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5HF71Ek_VgQ7kNvwHrwKb5&_nc_oc=Adm6TFGJ1Sq6VfJd2q1--Gjs1cJwmFQR5WpqZqGHBZaYop2j14g_xsM7OGYJAtPAjI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkmTPSADZKtnK1iUSQrB9lX6M_WLW4CTu-be4-l5oTPg&oe=69B00E04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
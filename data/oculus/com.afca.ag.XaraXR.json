12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iqq8NkdNZQEQ7kNvwF_YJjn&_nc_oc=AdqfzDBjR7LT0vz-af7MM4Zw4lra1mRzuykuLGGr5RooAHCni1JdwXTiBhX2JusIwbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AILL3xa5SmzKJw7rwQqr5OA5qP6x6a2sVj3hAA3KkrQ&oe=69D4F459"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEdVHW-mKBYQ7kNvwH0elLh&_nc_oc=AdrRF8tBouxmIy4Z4gQWL_vSn4sLVCgtTtpwYtjNhTiARQGaoK_lQnSUrZ2Y0CaKd5A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qLCzsyWm6TrJ1s-KDQe-SgUfb7RAVxzplnbyGGgiz7A&oe=69D4FD1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pT1ZFEwSHpcQ7kNvwG6d1dy&_nc_oc=AdqHWsXENHD6mpGicHvKwQ9vfQWxrz4duOBUe-Xhsr86UNtem-u2k79g_ZYIf7SmjVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UdmqBWyGvDdOPtr91bw9Vmvh2hcmbBHfrlIt1QoGAQg&oe=69D50E59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdysU2ypoekQ7kNvwH3fEBm&_nc_oc=Adp3g3aB1aSPZVftAjvpEtYPR3_q30RQlbnYtC6S5n3BJaHsCutJZ8Fy2VmPg5uyp9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pXkaCMavxV_QUFTxtOX0f72k6cnNKzj736nwgF1dDyw&oe=69D4EAF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jsg_UeOMbYIQ7kNvwFW7Urq&_nc_oc=Adrc0ZcGZ3J2FYLhPWiWdz0UeuBmlfkGI1xCFBlHFFF9fQWDTXFRV1XPzRSAc-jqu98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vliHRVNH83rAtj3Xa7uwKQfoT2g2rRq-FoU0lLwbC1A&oe=69D4F804"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1-1rpYbHZwQ7kNvwHQMJhV&_nc_oc=AdpSNfyo8eD7qRQ-7_2jZWkjqIOrgkZkCFLLQw-vrVudwAwlA52xaixyZgmbFHse5U8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI91ppsy4S8Q5n1bOWpkzFqZ1Epi3kuVOQoyGUZAr6L7w&oe=6AB94019"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJvtt7N3dfYQ7kNvwEr6Prb&_nc_oc=AdoUneMfw8j7sY3hyaa6rEmgDVYNbR6V9waXf4yeL2Qp3Dhscsob6UWdRR1y5GCNGcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqzTUakpcraUqWvq-qwfYzCcpzi8Mf_LSkM0w7F3TAcw&oe=6AB9109C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kELUIPA3A84Q7kNvwGCcBwZ&_nc_oc=AdpAsvCaNSRMN07jUQUT4tSxgtunrwJdCPGej4RjsWJrMFVy6RuoHUJXS7wOhwRqVpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFRAfUMxifKHziKi6LYdEAajcQanxyg-GTmTLT6WWo9w&oe=6AB921D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHcGZ79G_fUQ7kNvwHV_mfM&_nc_oc=AdqqG0O9DsMW5b8BA6jasXSXaTCJ6dEzJTAcRE3wtL5Bh9oFjsoY1bE9hSMjqtemS9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYRa7kMwUlM51_bPnCrwpu3JLBrfh3RcaO9Bb-epfQmA&oe=6AB936B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWH9WsLOcnEQ7kNvwG5SotE&_nc_oc=AdpNO3RmBvz-MmR0lbXuUL1sfju56st_TYJLw2Cyq1ieUAW43jHne0S02SJAwZIgmB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEIX_sXW0Vuha70JikhjAaswYGP1CVI33rA6keVqxEEg&oe=6AB90B84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
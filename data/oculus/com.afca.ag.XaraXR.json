12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B66bTR0-FVcQ7kNvwGOKhJA&_nc_oc=AdrCNmcYKNozqI6VM1sV43YZ4WHBNstZH813stFlpnTR44rZLOBuQdnL0xA0R1muPOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w2uwTPSaSbr4GSzyQxaiLON62RrOh2dzZ8rpdkbekvw&oe=6A01C759"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcckeCTTAUEQ7kNvwHb4All&_nc_oc=AdquT-xs4hxXpWxNUUPXzocH_2IQuovdHbNVCQ4OHIS3wum0fv-5M-xNyk_HQBvKZ2s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fXsLmUONSpmWOnOSZGmpbnzkuuTsNjD1ifeS3Q4xLPQ&oe=6A01D01C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hGnWZqry5IQ7kNvwF5nx3G&_nc_oc=AdqrRr-brioNRJOgjeE_-9H0Igq3tqBO3DzSTi_OLlNrdGuXpnzjwJAs_o0rJZ_obYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af409ugcEYbeqNb4VenfV8o6LMeg645SKxtA0GRXd7NopA&oe=6A01E159"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekIWzOmwc1EQ7kNvwGmETNq&_nc_oc=AdoUVm030g7Uc0B7NYaitwXiGfDOKBaOhgeVVS9KJOg4db3_ig6M7W4x4po0buF-258&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EC0FYxtF-UlZyU1DFsS-HEepb9gj-0OKwvCm5rjXQIQ&oe=6A01F634"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOTY6RA8IEQQ7kNvwEgkF9-&_nc_oc=AdpJaPwzsz4wP93q7sw33xnrcdR8htVJoxHoKkgGdsGPpS4mWIfPIjmceRG8ZrTgz5c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Em23LpY0VGpWICTcFixPs7cRip8nBq9JxQ2GRGW4Epw&oe=6A01CB04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
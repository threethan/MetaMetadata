12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5pRXKm8rZYQ7kNvwGyZUdc&_nc_oc=AdpMmbqLJ-ClHPhCe77_jE9DB65gj9OnhItx7vw5QRKPsEnXRDzlgB3_zNMiXYWjmLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OwK-tU_6ZcHA5zmnsWF-hYeMZCCXifgUDJDu_JNtffg&oe=69ECAF59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_9v7n2C-4AQ7kNvwEEa40r&_nc_oc=AdqkQklKwwhFEkpWJhrsYBpB1mFndd9R5VqCgefshFWIoH6GoOJXc5dKJLzjYQ0DquQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03utxYU6wQWUk7mmXXWi1juscQ9wrrVH8hXVw2xTxlIw&oe=69ECB81C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd1_kO6paSMQ7kNvwER9w_-&_nc_oc=Adp-wiIk6kwfDdxkHhUx068dyrdIvFSIgRx8bXXFB-Jp8lErLr-WYHXobbn_FjkupHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ao_d82K6rrxZ959aVzv0ZzoENKsD7VKUpm_BKxUaahQ&oe=69ECC959"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FRk-vRpgjMQ7kNvwGiEam7&_nc_oc=AdrSEM8GF9Ot1LYVZ6-cHtH0wropWYJA4HnNc-Cv7G99KykHjAsRqd_Xie2uImtILIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cnx7TMMm-az7b0tCxlV4Kvkvgvfedu52GVWy2m4D-xQ&oe=69ECA5F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTXI7J68ZKgQ7kNvwEta7IJ&_nc_oc=Ado-xZcbU5OS7rHtsFToKr5JOTlbIpyZr55jqmNac6qvXMnmQXXtA-l_UETEMVtMWxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MxTgxJZpO5reMDEbN85e5BMU3gmFOaLT0qJz09n8-hQ&oe=69ECB304"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
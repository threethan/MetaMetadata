_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9DB_BOWUjwQ7kNvwH3bCyl&_nc_oc=AdlQ2EhZpa9eEhMC-p1JI_Ay_95Cp6BGSXXjGmSkYViWL9LBQh-Gicu0aE68-mvtfIU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhsTAzf5W0583XvR-qzpa-12Inm0TuLK2WfQwF_E2YDg&oe=69BD3959"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-5t6vzWDEsQ7kNvwH0nwd0&_nc_oc=AdlChSEU0IKes1nsOMl8fsCox-bCIKoYhXwql1KMA_DjGVqrEumMYi2FEAAHEenr5NY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKhfUfzVQ97BrGGgV13o46UqTOVgP7ec70nIaUdF308w&oe=69BD421C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNGS8U-utM4Q7kNvwGlB1fj&_nc_oc=Adk5FHNBRGp5U4OBozvU0GKfNDhI3HkJ6hf0KI3MVExRK2Q5SpSE1ucnFgu5DDcUNQk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfznO4EaXv9wiQOeHWNQUsmlRAEilbUhQezvwVoZqQWDNQ&oe=69BD5359"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ashhaE2f9wQ7kNvwFCCGL8&_nc_oc=Adnarcw-ijooBGGhwhNX1r3-WLxatU8n-TTUeKyUTtlEEBLF9cSo7rO9liobkbeXDo4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZh3-aHmhomSMGnDpfCsA9rK0HJFkzYBqpn6V8rPQY9A&oe=69BD2FF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkirkTeIc88Q7kNvwH87wxS&_nc_oc=AdkJM4AT_UPrfdhSlnKDg0Owyr28BZLRWH6tyxbTl40XXkxL5TuZ6XhRxrSbG5pZK2M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPnMI1oZUh-099U8J1jd5xr6NXlXz0viKfBCrGx3pqHw&oe=69BD3D04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
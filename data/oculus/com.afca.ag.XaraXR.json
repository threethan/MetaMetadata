12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9nkSOktK74Q7kNvwFDrv7d&_nc_oc=Adqk6ly8969DiH3q7et1fINbmyy51bkoLG6V2m4mYW42jcYOT0dQRjIDCRMDhVpoo9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQGhJosJbrVgB3K05Hp4r_pMYeNHks769BeKKzxQrT-g&oe=69CA6859"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZTrOC-JZukQ7kNvwGI8bM0&_nc_oc=AdohpbDj_i6fqXu1ZUI_qZ-pz6wbzgjUfp8JPr0DigUN8Dmny2YQHARbyBN2UhzO4-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_CJLj28wysSbMvtHTjHjzRIm2kSF7w_bMBihxW6pePg&oe=69CA711C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqiw_yxRJqQQ7kNvwEFAZ7o&_nc_oc=Adq5SAo3TjupIiVwjkVclSesDqgNV4CSb9daH2syM_0uLhT80MsNeajsiuKZE_bf3Sk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkD4j98vAdcGBRb8fOBpT-A02LSKRbgvxwdA9YW03LOQ&oe=69CA8259"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drqva60_ISAQ7kNvwFrgjGc&_nc_oc=AdqdUUJJ8B6M2iFZRrZWc4BvpJ0v8PZ8G1GSzUJWAjgMsDj7b9zJJM7DdqOorCbQqpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMuSNSn54c7ynPj0rTFles4zUj4V5ewmTNtaK60p54YA&oe=69CA5EF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH97kZizEM8Q7kNvwFAv5wZ&_nc_oc=AdqF_O2f9GDSJP_zElHO8zdcloFE6-l_t9vlaGrJojvA6Jk9u2R96nE1_w2TyZkktT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-nIuYYLLQre9paZEbniaBi4ugboUSAjlt2GNAALkkUw&oe=69CA6C04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
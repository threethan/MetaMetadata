12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOr8_eqK4vwQ7kNvwExTj0M&_nc_oc=Adrtp_82vTG4xcmo4FO54P48QNpe3g-OchXhPgr-shNzQbqdDRQ6R6ffbdvNhMufois&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsR0eaHuONVioLcCdsQ2dDJULsW8GmG74QSWv4yoKMPA&oe=6A86EED9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njeYzeMXcTYQ7kNvwHIQZ7Z&_nc_oc=AdoZRjARVvJww7Mro3G-cfSHhvSOxTnRxAmZ_oCTIumihlYT9gv74o6-o-DkwCAP0zM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIqiFMY52UlMLbuQSWKw_qCyzMUVpasJN8HHi6f9ezQQ&oe=6A86F79C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BeVAuqnwNYQ7kNvwGeZM1_&_nc_oc=Ado62whnC9RtAcas0l9kgHoVwvA9i-c-ejZlfl95C9iHoSqEZMlQt7TD3ugaOBR1bns&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyS-wiOV5EENer07DYmDuWc24yMPXTun9Ivdz_6jqgog&oe=6A86D099"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeSGMJzk8gcQ7kNvwFSSwPG&_nc_oc=Adr5jVTyvyPBBF_HzLdui2BzwMkouUKrbQVsQ9Pi5EAMyI76HjGSA8EoDS_ofj6qH5c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWYi9fd18LQZmyljDzS7EsuZ-kuh5Pf6SVSo-dggsVTQ&oe=6A86E574"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j183TgllGP0Q7kNvwEymw-5&_nc_oc=Adq-907-jaXDHnUgLUyMFVPq18Sd9P2isEWu4AXcFAbQb8v1RX7Ngsy_gQVMzCrymqw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAOl5M6j5WuM35O9cSQSkg33hj2gTsDA0kbpaAQe9MLA&oe=6A86F284"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
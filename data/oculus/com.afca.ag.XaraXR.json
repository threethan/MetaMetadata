12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Vj1t0ozpkUQ7kNvwGvot7u&_nc_oc=AdpEwRnO_lzoXxgJ49Lw-rMKZ8fqCRMSrwv_nUpXYKO4h9Ma02sfPTNET1l0MeMShY4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFosHzD7fi8lfaxfybXgS7J4dtulCmAKfaqe8EthZf94g&oe=6A8991D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njeYzeMXcTYQ7kNvwGti7HQ&_nc_oc=Adpk5fbddrjO3L3fHLzHMjDWJon-8MqmyJr7-L_9B9BNvMy3309LxLoj0wHc5SfQgII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECXVZ9wnMAAi4Rfy3lKn8yXBYQQTwyitIFGH3Twf8Efw&oe=6A899A9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BeVAuqnwNYQ7kNvwFDKnef&_nc_oc=AdrWIMLD5Mo4AavSDspAaZWhYdfizPkzyzAigGfK7IXpFGngW2siwTUVSOiVmuU8RnA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd1Ipvfz2BX5sAInfEIoZplxMbQoZ8xfp5ziUXefb3yA&oe=6A897399"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRkPerP63NIQ7kNvwHq78oF&_nc_oc=AdpuTzARN4jw-uEyH_vBTTrGEEg48GJI5LXuu7NMziZwt-j8j3MHHFpBoA1Phzr_Y7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX-u7FuYSWZoyE5U0lVC_HYzzO3Sqw7FfF8hfcWCJX6A&oe=6A898874"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UF8VyUeqynoQ7kNvwFex-7u&_nc_oc=AdoU7LyviWnWPF5udYr8GXPvm3AtuD1b9p1XOJpO6c6giDW3cnRPUZ7gK3-gfeo60n4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPxP2v5awAvykKnOYLR_e2OXe2eYKN-OHX76FFtVJyVQ&oe=6A899584"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
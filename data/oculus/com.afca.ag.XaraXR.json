12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=218a82GIbd4Q7kNvwFnzbGH&_nc_oc=AdoiFCDNMyo3iv7giCgE6kjFGdnaNmig-D1NPYvGT7K1y5x3i1qTXmW1d-34ZS8Z5VI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JR4bLruWISouLzF_yqDahNmvio3TkloxLmKgK4-5MOQ&oe=6A070D59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN8gAROqClcQ7kNvwEpnQoD&_nc_oc=AdqOxnXCPTRnjuF2BXE368ycfn8bbzbA8fPCKObrXaWLsWOTEIydc5N4OmkT0tL411g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jsl_5ULAPkLGlsY82p8R9CMSVdF6-NOC55ZJRYM_nIA&oe=6A07161C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3IF9BL83acQ7kNvwHXB7i_&_nc_oc=AdoVHZ1ykpTi-918ScE1VlgE6ODnwUpPrr9B1qW3Fkb2XhqB3oFJm0bNKTDRpDDist4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bLhjinf9OArQeuwW7VJwuN1l-_LM-GK0H0qxVjfqbng&oe=6A072759"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT-Dh7kN74QQ7kNvwHWVXTN&_nc_oc=Adp0yz59Ap7TSHQZ9qIrB-tingmNWEMEAH7FVlQ0cn7_BTKxDJrrXeFMnhi_9A6P6pk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aboWS98DE21r6lTjYxcbrEKqy6cFmIw2CEwsDkhSUwA&oe=6A073C34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAFPPSJflu8Q7kNvwGYABgv&_nc_oc=AdrV5qXHtS79U77NHDeTeFaoGy09bJ2RjGLd0kmTKpuNiyQM0LSlz2JXeue3VyG7hK0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rNWig9tneCqLwjCxLcYiHrsn_slAk81QV4z5je9s9Rw&oe=6A071104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
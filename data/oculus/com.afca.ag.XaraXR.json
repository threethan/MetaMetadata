12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvNHUENmbJ4Q7kNvwGaSxyt&_nc_oc=AdpMTb4Ok-HkWvWnTIne0z7awQ-_G9gRdMGTRgN3ccekVbKAxpVLxp5tfkj0PAnh8uE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SpXrMmHjk1eEZ8dvvm2UE9evP-Q69zXx5qtXBEu5KIw&oe=6A3C0199"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr_JsOkApTkQ7kNvwFYvXk6&_nc_oc=AdqyryD_qYjRAd4PCjfK8C22sUuhKoDKma2gR5E686jsTfd6hOjN6lRnR8RyyNGNn6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k5cJkcAMkUA3P0V64ZvGKzCf5PnpNt7aYxxM2VH6Myg&oe=6A3BD21C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlpyTWy6aesQ7kNvwFcML9x&_nc_oc=AdqGkRnUTeowS5bc1XMY-bROIQAb6GtrkzxPt9Vac9J0j038RrMz_-1UVlIGIhlo48c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kKTg29Q-Bw_xIkS-4gs8K1xbUSeiOMIVnx3E3G7YybA&oe=6A3BE359"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgBlkC3OLDEQ7kNvwFqiFwg&_nc_oc=Adq2LWfZdN7DO06V46Qa0hTSzl5moArA2SW3vjn7S8uXmLpDzhXVehrXxyC_ak_YYW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PMCk_Ip55zkFoeHaKRnrB_C7gsY8hSxWOuY6GxY9ofw&oe=6A3BF834"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPo12W4nXIgQ7kNvwFNK9IY&_nc_oc=AdouBFA1qnbxccttjKHKB_0dLe6iu-2s0otm6UsAhASL4EUQz7nDX7yJgG5ng1ngAFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UwcL4r8sCp-nbWhKbNJ8cY8VnvA1dL-a201M7j6RkTw&oe=6A3BCD04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
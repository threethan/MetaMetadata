2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JkLerMjlIgQ7kNvwF73gtI&_nc_oc=AdrSIKepPsJnATbIMjIJEII-VtA5n5vHkWqUvExNlyXYWG8B9ry-GvaUlMpZgi-18n8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcie5R7NnGAf0nkKhJpki1GuIjd4Dr64MPZF4KgeKccA&oe=6A984A99"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck-FRmCJ5LwQ7kNvwHSgN7Z&_nc_oc=AdoszuFv1wNEm43l5BEPip6dAhKg5a5Sar4179o0NLN7wpvFBDvPceCR-JemUEPeDck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU8WXLuUg5nBWIj7kkLhFn2yemgWjj8UMnq4_1fwO5XA&oe=6A98535C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u0qtaGf914Q7kNvwG6CFWQ&_nc_oc=AdqWoM8j3QFW29Sfwlp4zWKGhRIB9d7Sdcvbs7BC2da3YFuSSB3g94xfF91Gbnjq9YY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1ADYW5WolbKOd6LfducgRuGq-mf_cDxsfLC3B88_Bhw&oe=6A986499"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLwzrVfAb98Q7kNvwH4IDQE&_nc_oc=AdrWgVkoYR4t14H2C9TLsHpEGGqqFmHY5yyqKkPX_G5FxdukFBpk8Kpk9ftDiZl-9WE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrLODjVJvwAASFt4e5u5yEtifLthjwF6Q6La3tlItTmw&oe=6A984134"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13AVJCHQuqMQ7kNvwFsHAGm&_nc_oc=AdpHiUBOGejEKSFJ_4wUunrjbmtQVHFm_btMF9R6hu83BbhzKzCl1qrQHEplBMDqlzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIipwC_cetycUluFCSAo6jjdAUpstUTwk-4vTMtvirp9g&oe=6A984E44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
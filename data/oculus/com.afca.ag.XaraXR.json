12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oq8sl7bWfgIQ7kNvwGPhI3H&_nc_oc=AdqNhkhEl8FUtfoaR97gfgFW8HLKW-7dQNNtitSHA0vCFYSj9fTpGs_xI2s3MeiIsho&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Qf7zHyuXecSJMOKE_QXNgzOST-UyPl796-J20zgqMWw&oe=69F346D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1uePF_WjR8Q7kNvwEeAH_X&_nc_oc=AdoSMhsVG434HsTyI61vKCYaIsWYmJQv0IqACTqM7HvDh82M9Fz_a_EVl3DUmbQDwNQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1C7fqaixVXZzpFgRe71OKsNHwtDisEJ3dxNL5um6N2dg&oe=69F34F9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lwq627cKHXgQ7kNvwGHuZ8w&_nc_oc=Adpn5iVRfkZCFeC0wz72lM4T8rj0gXfQXtLcY96FjnoGgS6WsgMFnftUSFtpBHujm7o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_HSWiIrKXxTks6fLmt-PzIFG_-60jTHpRBckvsd0oHA&oe=69F360D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDH8JGCX3E4Q7kNvwHjuviR&_nc_oc=AdoJFJDJQCslVFhrjsNKzs3VhxeByQUlobsTaxBHcH-3SDbCsjWlUUlfsNpUQVsXMHA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34DzSey-B47oD3pt7NYWMOlxsCLKnLasHu12krPQZEYw&oe=69F375B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcsL_x6apGMQ7kNvwH1XeIA&_nc_oc=AdqsVXWOO2NID6Cketeghe791DFl-_pjws2-4Cqj3DZCQnIdRhGv8KjEDK-rhH-QqEA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MKFoa3fBI3G-WVJq0ql4wahImQtEdKD_YM7RMWJfrWA&oe=69F34A84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
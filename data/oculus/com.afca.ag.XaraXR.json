12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Vj1t0ozpkUQ7kNvwFzO4O0&_nc_oc=AdqfNDqv3eFxI5vDX5ozpID3uPpqz3cJ9-iNlybxrVwCYU2H0XcBsCpb4UM-h1X-By0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFku_f3HbwAuZkya6Nk_H3Ic7qZvoFZcVjwHPKSRbLCyw&oe=6A8AE359"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS_HJ0-miCsQ7kNvwFxU-oX&_nc_oc=AdqIpE4ObX15Ijb2cml2EWDp0ZyOuHY1kA0u8VeQPdxoYgMEbXX5kyQa6kpr8UEFM-I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4Xklm5BiEcFUHIGC_L6Qr4LtGQ5jNteuv1TRnKmjZKA&oe=6A8AEC1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSbXS1Q0ZZ4Q7kNvwEgH3Qt&_nc_oc=Ados0ePSDFHS73ZTrPnNQjNhEjwME03lqxPcDte73duwRch-stHJOKGoG1YH1FROIE0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK_-SGs7M_OeSicLenef7jDzSD6WcLyp5ID17lh3gT2w&oe=6A8AC519"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRkPerP63NIQ7kNvwEWl2n0&_nc_oc=AdrqmIwQXfK3sBWGiyNkJz-j_pCvIK9PAC5gXsHhHmuGeNaIprVpuU7rxQIYAZCDlgE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyn1xoNa4BtXdFaQtFTDQbjDVe9DVJqp6o1L4uNwzUYQ&oe=6A8AD9F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UF8VyUeqynoQ7kNvwEVgf_G&_nc_oc=Adr3MP7Ev9M9Km8aW5TLrvy_dGNYgpMEtd6q37b0b8uN5PmCE9ksiAdHugWr1yMHnRY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHkBhxZKqYGes5xtsoTE-rwOXGAO3IJSTDDMBF-For3A&oe=6A8AE704"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
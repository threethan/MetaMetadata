12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vUYDE09MWkQ7kNvwHd1ZW8&_nc_oc=AdrgT1PGznT1fMCDY_pfWbJ76MXJGLA67zoZF4uP_RDoaJ0v1w52gWzBasVtSPO2jMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s43tovzQpA--ExW1KpwrJ0wRop81YkSXMk8qbQbKHUw&oe=6A356A19"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBxC3gCPJ9AQ7kNvwEqrI7d&_nc_oc=Adpkxh4eBt_jiicPk1YQd-oBAFS6dWzc_AtkLChginYoOotP6eAN6cYP2on1whiKJ2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80ExIdGmXSB7V-MWBQmUQsTxL5zvd3Fh1ZRs4sX0cNkQ&oe=6A3572DC"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTNZUcftduAQ7kNvwG7WXaj&_nc_oc=AdpVewazAiZtYcLsAXNemPjNJhiVHG8MKzvQ0ZtSwy-pDazzERz1_gRbym0-Hn-OAz0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92wKG5zdeIP-6XQm8e3zKaoTbVcLcUpqm2JlcblDvnkQ&oe=6A354BD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wzo2nrXTgZoQ7kNvwGbVyH2&_nc_oc=AdpOuVX02fIlRnOVdQfCUrJW3Ki7fGtL7deVc7tjX1yfjVGd-AkRszn6ykHveOW0T2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fbc1hKkkcWqVCakZx1UeNk2DTArzG7LDEZJyX9T06Tw&oe=6A3560B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58hzANg0o6IQ7kNvwEK6wNM&_nc_oc=Ado2sEdVXvzdRTeu-6OQNd6pI_i8w32jO4hYed_KFlyYMgv9wbo2D-cSxkO5ufREeyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SqE6YzQmgw4EWoTv0k-_pWij02fmvY2Je5zGlI1IrEQ&oe=6A356DC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
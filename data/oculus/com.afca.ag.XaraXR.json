12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H0K-TXNhMAQ7kNvwGQzWti&_nc_oc=Adol-6oyVeB7rUGeQe7O1v7lOc2u9ck6fuZbSv0BzklZ_2wwLrOUXb2EYYBx2ldeS-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPkn-8S1GwhZvpW_LkbdmyQUoxMuoRqTBjzLcdJlj2jg&oe=6A7C62D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg3EtPm6PKAQ7kNvwGd5s8v&_nc_oc=AdoTybMFMaj6m_Vq0aEsQZeOBO3LLve8lm3JFKCEfCYAr5d1Ip3myJcwasFx6NMItu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRw2Noh3PGbiYOEVV5dkcvMr88rBVhiVRsZEz9SskmJA&oe=6A7C6B9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABaHyxdXhpoQ7kNvwG9CImQ&_nc_oc=AdqoQsmr1s-QFU9R635wvnvT26Dzp1nIAd-CGzTFB4rax1obSO4Ykf4SqpZ1OszFG3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAxR7nQ2sdgxJXPiVPhre_HORML2_B33m2rNUVAX94KA&oe=6A7C7CD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu7xE2-W-S0Q7kNvwGO6t_i&_nc_oc=Adoun9JxQDUYeCei0uHKZawEJIJcOCTXsZYBUCcefxqWpeoy3AKuyky0dX2HmbeNnn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7MQuaRIxa-EwAw9EzOxmO-qRnUKAMqB8IsnhV2kY4Eg&oe=6A7C5974"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGZD79QUNoYQ7kNvwHMmsnY&_nc_oc=AdryrVwzoyHVV7aT_UVHB-rBElKzKyuYU087SK2PmvOdJ-PSsEqY1LYEwTPzCXPvBQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5vLfX12amsPaBpINuQX0QC6Cy_ZoDbpQqyVjFDP2DIQ&oe=6A7C6684"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
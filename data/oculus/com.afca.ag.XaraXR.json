12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4Yeeu1jV_oQ7kNvwG-jizL&_nc_oc=Adrzo3hYkatqq6-idg_MAGjyv4tyAqj0rZlhe58VciYPsT63vOaKuQAponPNKNREM74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEmkKwC5e4shBh6w4OzJ7sPTICafR4qxCc3xC8CK4sRw&oe=6A50E159"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1LxPIyXot8Q7kNvwF4uoDz&_nc_oc=AdrjQ4dDper1cbfIj3cO7tUb18CuF0hDmt04eO9dw_2eKDSsBDb07I0demwilZPaKeE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSBQvbhDSkueA8grOhGuB87sJMt6sLXvaK-jpLS2VLjA&oe=6A50EA1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYhy76g_ZEQQ7kNvwG_cvgp&_nc_oc=AdpcwtYrwpHDeXzuhg-wSRDHAIloUAa_tsRdMK04QvboRnJJyC-D_ivPPrpJsTaGWfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClg7vuDwnTtOFaGyVcpHlik1WrFCFIY5VC5cIjQ5DkcQ&oe=6A50FB59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjht2EjsiJ0Q7kNvwHb3orB&_nc_oc=Ador1oVkh2e9fyz2Ps6kpEwl_zl2lx88gkCpfq-EKFHT3eP4XA64u5l55v60UxF5-b8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA41Sga4EVlNXKVX_HBFVnlN8fpsdZ10VQAZknWHXee_w&oe=6A511034"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhDczEsy2XAQ7kNvwGbbHiv&_nc_oc=AdoM2wBzp2iZtKsSIM-S4nuaQtbHfln52r-VsgR1IsPDt8ug_6H2hcdv9TI3KKlvc2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_eaa56ji3u2bwJt6FvyzIQyk0o34orTh_VXUklGRAcQ&oe=6A50E504"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
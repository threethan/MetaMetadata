12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6vHBiqe0vUQ7kNvwGBCFzo&_nc_oc=AdqJjGN69eJikKnOxwas6GIBEbgDd6Yy58SkhsKKJBeHrOVdUDayZfe7nxjEd3KfVkU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L8gLX-p7KBYqv1o5sNvP3H5oSDIuKhseQa45aLxH66A&oe=6A414799"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUgstCIa9sEQ7kNvwGaKn2K&_nc_oc=Adr8SlNxMvaIGKOpioj6laCdQU0Gdq8ouja721QtV6hgN6RLOWE-cE0D05PV0WgotKc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YCRe9eJr8ffdOBMD4TrzPdb9cHXuIucS9QyhjomSDFQ&oe=6A41181C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR5G8K1h-wIQ7kNvwEGcyFh&_nc_oc=AdoxA4rvvwY0Pfx6q9gyF6wRGhBl4eayDya4K50KX98ifwv8daFalEO6xSDU0zqYi5s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MaLJ9CQxzO7IG09OoMlVAlYomIByaXfTAZ8yCNRrxSQ&oe=6A412959"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlyqlkEp0TIQ7kNvwHnlC6q&_nc_oc=Adq5HdStaMiscSlLZNvhqdAce7Y3aUpHDp8wGv-tT2GlozcMk9jFEZiNQJQEKD1S0XY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jl6nakvQCMsKtJH4oE5zkoWMjxHWAE5sgjspkmc7deg&oe=6A413E34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAoQ6FvqBZcQ7kNvwHJjAk0&_nc_oc=Ado3cpJzOa2f9i8fRXnnlT0HEo89dWIFh8BIvgZpuNdaYr4m5aspq1UCkj8TiITdMU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uNhpgUtcreHb4GsSnYRNxxfDpqjDibJyAewgQmY4IsQ&oe=6A411304"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
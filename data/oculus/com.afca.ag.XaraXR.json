_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkbYVOj5ffEQ7kNvwEy9RS1&_nc_oc=Adn8T29BEkFfhSCQ6keRxKVB6xic7LywMkKli7olF4HMLzaqJWoMQQysnPqZGXMrRP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_iok7zt7dqJqXhny_-g2vFz50D8V3VujYrgfW5qtIUA&oe=69BFDC59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-5t6vzWDEsQ7kNvwEE6jfw&_nc_oc=AdlhxxXQ4tvDScoGnGCCLBMGr-Dz2Uk7WBHQAPeG291aAgWFVXykHiCCoAylkOqNLZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhukMlTCHqMCZIVDEQfVVbn6q-R4TNtO7y8GKKlFDWEA&oe=69BFE51C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNGS8U-utM4Q7kNvwEA3gQl&_nc_oc=AdlA4GTGmjlwfsvuefyzeUyXofUKzacAqfaeueqt9P1KenTcduoIWnDgQBfMnSoV0A8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1f1C0YmkC1z4unVVujxRA9HQj9KzuhB_nk4aW2Zm0gQ&oe=69BFF659"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-z65ILENbYQ7kNvwEj-1zr&_nc_oc=AdloYAxQcdI6ZYPdILGLfizRLq1mUVgpiQ3L4HmHF-boAbBKS1zXwgg7OSVQnlxCTRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGI721gZPk7vitytS4STmkkLTLMLIJfvqn3sk1DjhfwA&oe=69BFD2F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY7wdHHucKkQ7kNvwHzqHPL&_nc_oc=AdnuFo53MT36h8d6FR2FUbYeYVz3vVTt7m3xJ82EXAcivpv276JVWrltkdW5nLrbdPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwwu6M9QwIQJsnksdXPIdoMWlCaWJinyOZDSbMqDnyvCQ&oe=69BFE004"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
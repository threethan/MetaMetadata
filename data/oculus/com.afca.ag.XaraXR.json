12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4Yeeu1jV_oQ7kNvwHCWU6U&_nc_oc=AdrHgvgqx3mrcCtEhGJoUFcrXWDSkpw0MA6XUKt11WHHeUs9__YqWnKXozNMfqG8m-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLpnlue2WhENZMD4ukICD-tHwyRFu5Gi_EF4IQqMl7eA&oe=6A538459"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt9Lk9UIQbYQ7kNvwHmcVsR&_nc_oc=AdoqWwMCcznak0ebJe7FUNBEAylxv51dKPLNcDVJvlRL2g8xYOQda6KH7EZcML4J4xE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjvxe409lE7L4hEI4-qrdPlRIxIeXS5Sju9OELCXMjew&oe=6A538D1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnMl9f7pTXwQ7kNvwFpeOa_&_nc_oc=AdpGc3mQ98Wgvi2X1yeH2gyeC1lZn8y4AWX_DGx5kHqJMjGL7xLL-Vbae-UpWLHA31k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnMNLkXuHB1wB5CgPIKp2YlAlW2mTQC95EbqGIHCMMPw&oe=6A539E59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROHqcaW-bwIQ7kNvwEaHtsG&_nc_oc=AdpCEjfeumpbrITdyr1XzElqw_P8Zh0ASBqsCLOMptsahR87cEedLb9LrbQebao7z8I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnnbVOXPe1WIVFU8eTP768dhdJzRVae_hF9I2NnmYSQA&oe=6A537AF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhDczEsy2XAQ7kNvwF1ziX4&_nc_oc=AdqWK0W9P4RIzKaKrH2xGV0uZ7m_VQEELnsXvmnqn7m_q4Dw4H5RFEeY7O-yiB6uz7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXFmEXJRi7rdaS5HxrM72gCBUTHFYNx3YFHdHG5JcdxQ&oe=6A538804"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9nkSOktK74Q7kNvwGfQsWp&_nc_oc=AdqJ8AmQiTC0Y-hISXNqZeJZq-wwCnQlWJbLUVzRwLWX474DfZ4r22hjJt59rN9ADAs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_LUY9jUU6w9zuVIdIH93Y6dws60F2vYyuSgX7pvxD-Q&oe=69CBB9D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZTrOC-JZukQ7kNvwGkAXnH&_nc_oc=AdoqRIvJcUSCSKscMrXLXS-sjVnb_k0cWrXrpadHmdLOHntP-M8SnjNgFbMZyVsBtvc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyObqMuzeN5ufEAhf0AHbpzGidbZyg2djZu9gAor62RmQ&oe=69CBC29C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqiw_yxRJqQQ7kNvwGSgIrb&_nc_oc=Adp9P0aeb4MsXl4D0-XE3yYiMM7UoWTUmgA_7UiLmrAvJTIHq2tZl4V8NALlmrKplJA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLvTUyUcZZ2tACh-Ci3_Q0X26VADKYrmwhNORAqCvNdw&oe=69CBD3D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE1ITVAz4VYQ7kNvwH8YPcB&_nc_oc=AdoRqNJxzkpTJR3HD_X193F9yPwHg9QBCDTmS5xp6Yc0MF47aW5dhaBCxYDznXTBPwY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrX0ZOnSXKzXcEvZ0w1N37etx-NGPqaOEpEwd23Gq8lg&oe=69CBB074"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH97kZizEM8Q7kNvwFXYb-1&_nc_oc=Adooy567BSHg8-DYs9x12-B4lQCjUQx3CVwXESghG9TPrxbjTJ0jYCG8mcvUjb1C7JU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgM1mz8WfqjGBbbwXkRmo52_8QCQRmReXrXlAPFkJMZQ&oe=69CBBD84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
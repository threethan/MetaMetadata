12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yShnKY1UVx0Q7kNvwEoy0aG&_nc_oc=AdoiNV3ASGAY3tvlPFiYwOlEDv4CAWW1pqnJPqejtP4CsGMYLZo_gfFE6BV3VQicsUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DJfP_wnsBRGqhRYZMCYPvpBPTy40l2CQA8mwik0lbxQ&oe=6A19BA99"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlR-Rcc4uesQ7kNvwF7ltsp&_nc_oc=AdpeDmXLZoVb3Wm_D68ifmfh_GW9FPIAYlqJbilKHAQ4EDgRchY-ENRSevpka780uGY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5etpCKKpKbUiy8l2WtXp43kjhiZ2gRA8jASMTMHWmwRw&oe=6A198B1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xlDXclEixAQ7kNvwFn6g-N&_nc_oc=Adqns1EyNedX6peKm_qpI04S-CI-pxiIFtx7dI2ltTYPqYPSBqsADojJbVN73oTzhJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y9QXOT54FeV-Voq6uczbFDfb8H02pSUKCzHTSIFwdzw&oe=6A199C59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u4oCLUjoMIQ7kNvwGHfHUK&_nc_oc=AdpB1KWWaRQWkTcm-c5NVUz8Sg5ON1DHc-XZjHOZt4DedNPTjukXiBr5v4mMR2Sr5Pw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73_Ylh10GM1vePjEwuh194v0lIGZIV-o2QOAZZ8s3Cow&oe=6A19B134"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzPkCsQr4MMQ7kNvwEe378e&_nc_oc=AdpcvZ3Oz2HPP4VnH5N35selyiOh4E-PF0a7WwJOwgNkZ6cGMkGoXiw_xxzpHMj6pz4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r7BRoM-UG4VuSN7Forb8lMuGcvdZKIIUXhjd7j04XjA&oe=6A19BE44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
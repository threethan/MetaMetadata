12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUxzuNs49lEQ7kNvwGssCu9&_nc_oc=Adp_PhbhahmNriE4y9OdF_ECd-KK7t6ac5k2uKDaNGnrOmgJMadjlb8BuoJBHSgjg0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90iBV42vxtTitysckU9duUleutBNuND_8peHmh7J2t3w&oe=6A295459"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TTlia08JOgQ7kNvwE09QB3&_nc_oc=Adqj3tLIdU5XRZWeo0TRG1wTvKxXzM5qOECHEV8bQ5Jmh9di8czl-0JHuijjBPfuy2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Chv1EnDEzdHi6r9EFrsrQ2cdIgQRSbzEIGkkQXL-8vw&oe=6A295D1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7MXkXNJ1LwQ7kNvwGWgjps&_nc_oc=Adqe0814ACegpsLVju9VEwLbnu6rXRW2wDI-WOX8HGCZtTQ-TxK_90vVnrklglN4Xac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-INbG_D2q3RjcNsLstlkF-1weZ5eG0srIXgdhpmXK4xw&oe=6A296E59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8KvdyHPg8gQ7kNvwENBLqp&_nc_oc=AdropdvRA8FCfvaodaqjim0i7vIzKsJ7gz3DSSiTSXmZOMuFDnPzgqRzWDbTvsxOxXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DQrWHSoCNpu0G7kux1A6Y43NGBXhdeT58cDFIXoPaBg&oe=6A298334"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbOxQNVv8kkQ7kNvwFvKgKA&_nc_oc=AdqqmD7-hhvWW_nsnnv5xeO_4lLWrRe56br-zsOvfMGrDDd6Bndc1EcwhRYifVhYrqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fo5Zc9C0wm1AS00Km6X8FIl--ZZTIvovOcG4vwKgZzw&oe=6A295804"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAr70oYAOgkQ7kNvwFaspYZ&_nc_oc=AdponMylkGIUfllUyKJF5E-P6U3FD8eKFRXXcOaqNvNj3UnxsEsIdTueNRS7rDBLKWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6DE_IKQZ9-mfohmxVuDOLsm8hlMB6VhuOMSCmyKL5CA&oe=6A8C34D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS_HJ0-miCsQ7kNvwFSlmD_&_nc_oc=Adp1MI_y1Cbl-Re6cOESDuRMcpTr5aGi7JpGM0p8oHyKUkCPKnnBDnDpvzpBeYw48W4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeZbWjIOPaClUi6ZVvbDVmDUn8WrVd-fYqutlc1nBntw&oe=6A8C3D9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSbXS1Q0ZZ4Q7kNvwG2ySKS&_nc_oc=AdrunTuiO49vUQWmcI5uJ27NEHLWWlMI6CAmRdT2zMpQ28oohlMn47vOP2m0xZBwzMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd59gxkVyvc8b1B3DyxC1cm5SrwMId0KO2talrUKxjTQ&oe=6A8C1699"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRkPerP63NIQ7kNvwEi2h23&_nc_oc=AdraGRW5u9RNFWJigrO49UkKEwWfDmOPWJWiPkKknuoGrvTcDeTG21Dqp0mL74ublvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGu6qv0224uJB6KsgtIgK_M2H9C2bUXxRPd_BM3QauSg&oe=6A8C2B74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxbBAUgXZ0oQ7kNvwF9_gly&_nc_oc=AdrIGR6kFcV1ZnJdUoVGwRqtfkuDBJ2MB52q0MWJfS-3s_CSsZeTv_UWkYDJjGh_xPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtVzlxbf97j4kh2jfTOr9BFYmYEdjTMASnEVVDf158XQ&oe=6A8C3884"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
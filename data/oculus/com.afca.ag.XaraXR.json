12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NnDM5q2CL8Q7kNvwF6GtAf&_nc_oc=AdrxGpIPQ_FF0R6W9CWilVUnGT0pVE8QQiJYJNutLWGn8SxofvbBMSJ15BbNDz8zm3M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1yXt4E4V2uEjOJVdV5YxsmRDOrliIHHOw9GNaq994dw&oe=6A3D5319"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr_JsOkApTkQ7kNvwHmRtmt&_nc_oc=Adp77EB7c3mi0BtlHGAc7Wxym42rkrukz-UWG8jx31wJlkiWQttwHr7F4TE2FAZb6dY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5Zvi0uHcBI2WqNh0b2EPyQDSVDExJ5pjJ7JtD3ErVSA&oe=6A3D5BDC"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlpyTWy6aesQ7kNvwEi7WK7&_nc_oc=Adq1Az0tgACZbUqWlakETfpvn13eArF8jlS3Fk1-DojHK0VSIYjcmu8UqLVu1r0kbBA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7KiAVLaslxePq8LdmPulF4nT3dn9U85jxgbsI8GAPsA&oe=6A3D34D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgBlkC3OLDEQ7kNvwHDsUD2&_nc_oc=AdorDdDR99w-eGQJl9bUdGDFHvdwJVzVzlpOubAmO_Ji7kxEaKDGBhbkEJMruu84jV8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-elESVT_d21fwo6YMp2Ng_0HwHsPrpuwDKnLXqdALAEA&oe=6A3D49B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH6r0FJ1LtoQ7kNvwFCoWAZ&_nc_oc=AdqiEjqgbc4PhPxdBFGsb2XTq_ZetPooKbcWIGi0wGb3yNwEoU0PLHWNUzPxW6VQIDQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z1bXMcfe5T4YyZQTKAKeZNSEQH2MeEqv9p52kZD0nbw&oe=6A3D56C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
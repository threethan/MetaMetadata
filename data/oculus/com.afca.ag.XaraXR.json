12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yS1fnxC6fPgQ7kNvwEOhIMO&_nc_oc=Adqy2Gu_fZ_FSSbf6yzRht-tNK8-CBF4HTPNwveGbrXl2h4Dpt-743_O_qfsZwB0ZsY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rrM85xXkF8RKcgPgA_VbYpQWM-5EgP2XQG_k-pGbJhg&oe=69E374D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9-L2xTbe8wQ7kNvwHz4cYw&_nc_oc=Ado3Ap40KinUAQjT0aW4bAzonji5OpUHlsbILGOoI7XvsgHeIX0CqrORvsxV0O74jKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ydNfN6FORfURwZPw0V5t7tlW1XxpAXkH8tag49PDBVw&oe=69E37D9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6R9pPEhcdkQ7kNvwFx9uQd&_nc_oc=Adr2iLvCVU_uzwLk6_oAcICDeop0_maU_JZugTUxfrttnhsgHVlmyA-6n7fEazNLB_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qGEm7RSKBDL_qkaT2Pn5QZCZU3-elPlic6hp8lrDpUg&oe=69E38ED9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dDMSPqzPFIQ7kNvwG7uw1g&_nc_oc=Ado-khC5ZTFtfGO8l0QCr9hzNvteqPjQ0cf5-1v0VhmtTsrggY8cFD_fq-IYw43C9iE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RFw8IwXrWT_j9RXZ-W-kaDDb5ivd33Xok2g0ICP9UCA&oe=69E36B74"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ln_VjQhC7AQ7kNvwHfJ8DK&_nc_oc=AdoFrhM_601e8FJtchru--2fItTk09FHMafKVRgjCVUEuXM5UgTBsB7UD5buXHSz458&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07BzsIksXD-OkjDWsGnpIxKxvU1lt0J94ppjUQwF5XlA&oe=69E37884"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
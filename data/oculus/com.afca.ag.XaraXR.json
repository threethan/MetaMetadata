12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp6vcbrhA6wQ7kNvwHZnjoX&_nc_oc=Adr5kfTI_6elXblSDuKs85D4h9ucR-aKUXn0Cm8X2GOT9e_piWgfIzy0okkottiXNek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXiwpR8Z6yVueHc-Y7tV5BkLUEn1iAjmuoenz4dTORDw&oe=6A82FA59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61mzW-ijbjEQ7kNvwH-FC3A&_nc_oc=AdqXrMLmkYJXBqn9pze5uIaNJrfxdSMrciG686E8XV7JTuPj-IGNmggzq-g49D1B3gA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1l5KIYc8Cv0APqAqIbt8wpcZ-aZr5nfO5z6iYhpRnmQ&oe=6A83031C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kReGNd2ODUQQ7kNvwGVpydT&_nc_oc=Adr-ZP4NZwId1IjvWgVSeRsGCt9-kK_ygU81JRvGeA34xTJQjIZdnbnYoqJEr-AMjjQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpi_2CO7nAw2zGW8MWjCh4a6KXHXUry6TELQCuZDnBWQ&oe=6A831459"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlrjWtaOyOcQ7kNvwFPS1ff&_nc_oc=AdqyDI6q9RDBAOY29RRJZVQTUA5zO_wOOvzu1PyqJfFvvMPmqsYCBwYeBgON7ZpO-So&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPuYQR3dLz5WL4MWCzYX-aQnSmAMCwz_Eo0z3p19U5Pg&oe=6A82F0F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WfMj69b6bIQ7kNvwG9WWdE&_nc_oc=Adr2Gds_Co_gQ6VuUDD6kvODs9Z1V2acg8YruQOTTpzWfZ99aXycnzWH8uYqyiK6OcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqlRKP9lbdT5NS8D9gyggvAHkz8abhx9fnlk1WiYBh7w&oe=6A82FE04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
0227612_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj7uOTgTFwMQ7kNvwFWjlOn&_nc_oc=AdrP83GXaAo-Me3dpauYJQgDWn0-corMuJpiXQSmx6I7R62HjZnHqU1ZajciGsIDB90&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84ak2Y6hzimWuzF-N5R0ascBfAwVe7naGKUAd4ivskOQ&oe=6A22F519"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrE9sFJaI7kQ7kNvwEqTPns&_nc_oc=AdogR3pQuvD_1l8pdurJ7yczw6SvBQ1-w746z7CB7dkMjW4lNbtZz422jSFCUMb_Fa4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dTv5udklHLjx4R6X22H7-WaHuirhRLQZi8IbNRJJe9g&oe=6A22FDDC"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCIQiy7GIXoQ7kNvwF4zYLB&_nc_oc=AdpGquiJ4VOpooukd5CGy-9P4-C3cb7QaVFHZKK35LjfeLG2lOhJ4NuPayAln-FUMAk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SBBELdRI58q3InvecGLbdJlbrMF-4NN7W7LWMreQxHw&oe=6A22D6D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yjTcXel5TkQ7kNvwHT51Cb&_nc_oc=Adrv-Hgmmx7SUE_SAAxMyWPCeF6sBQ90NGP8Rnt-PURRR7Nuk25d5S0Aw5uXpE-hxqU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xAMLqI5c264mfZMbBDfkbDDhMKGqK1o9Ifr3Y8XcK7Q&oe=6A22EBB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E31PagXReYgQ7kNvwEJsOTj&_nc_oc=AdrR5tDc7j3NBSm0mESbiYeyT2cQjCOzMpyyB8-8M-pNDlf37XA1PdhKqmPhhj-bzHE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fTkuBpDmV0aRNO42_m8i1RbQ0udmBtbRlhB5G76Ifqg&oe=6A22F8C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
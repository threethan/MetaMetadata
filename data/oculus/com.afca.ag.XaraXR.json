12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyt2rr0XngoQ7kNvwFc1vp2&_nc_oc=Adqg-HT4C-NtXziNsBXi-DdDn2SlHwrNXO25e17N3ukryGEHHFDUESNN9Oo6Hn3Kap0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jk6Zi43eYJ1bBfhsXLJcvwPFQGWHqUSoaxNXnGRYOGQ&oe=6A09B059"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnXXNb3PYcAQ7kNvwH2dbAb&_nc_oc=AdpE5Oy1lB6W-hGfiGLRIe8QYB9qwzcavet7D8MFA_O_GEWl-Dm9QneUYuFjDa2Mb6g&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FFJ18xBtSTbdV8sa9_gj_eVZs6TnzIgguGXj4x_lF_w&oe=6A09B91C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5kIErLULi0Q7kNvwGWGp1e&_nc_oc=Adqh3xpdKHrctZjrx9xGTroIG3mw4V1qpThxI167xqxyNy2GWgP4GlShur5N0YOJ-Rs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IEeL_F8tg6qJduYCNjr1SSkioSsoZjyfavfHy5bmwqQ&oe=6A09CA59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT-Dh7kN74QQ7kNvwEpURC_&_nc_oc=AdopaEp-eI-8ld5Av9hUYu8_J01MFCsPAAuONu3pm4xnv-UaBrPag7nJHEb8dXDKOtw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jdFH8lUDAN27tphsOnKSKuFhdnjng45lo4ss3LbeZ9g&oe=6A09DF34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=310Y1OctmwMQ7kNvwHscRUT&_nc_oc=AdqSudi1rhf37q_EoPNDMexwOdYhzzlH1UQ8Qll4DtgPQHiitA1ifFuXwUqYXieWx4g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vF7Fm-hLJRgxhr2z_Oap0GKLI3HeJC5sq7vm3eSZrBw&oe=6A09B404"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
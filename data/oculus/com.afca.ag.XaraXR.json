12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUxzuNs49lEQ7kNvwHcVxlK&_nc_oc=AdqhzXa4UhKgGlUZuIi9DxYYehezTRmL65BUnNlLGOKS_Y-TJ_3LcuP7xdmvqMcQ89A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k_hWWduRM1wcnlRiKXtpvg9FV6G7kpsiI4AYZBxyZSQ&oe=6A2C2F99"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KON6UV6OF5sQ7kNvwHF2qOR&_nc_oc=AdrpfYJbrh8c-7dqAzl5pKDAf0KL8nbiM7suAhyECFUrWRL2OYTYhemw_IHQ4zPCqPQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V8Gu6d94kLV4zKzQNyAmZ9t2WLk8vokv1riWvkYAD3w&oe=6A2C001C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYvvJN4VrpIQ7kNvwHgnvjJ&_nc_oc=AdpDmvqLAua_nPWmiJEmV-14d1Si2FADoUjdv3dQkgi_JjEXNLAymr3VwfVoOIIU-RA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bDvbG8XCk-EoOfvejFIrNPXJTys6SyRhgYLP8Va6gRQ&oe=6A2C1159"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyVUZ-ARycwQ7kNvwHxevCA&_nc_oc=AdqvVQzAv-CYF0mRkUnxHl2O4l0HBVOyQ5sqPSTvdJe-ySj9hNTvYC2d6Vb7T-hsiFE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ti1VlVZRTtesxl0cuntfPlZNm-Ds_kwODy39QPGQtxQ&oe=6A2C2634"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbOxQNVv8kkQ7kNvwHiY2BW&_nc_oc=AdrrjpzCkYWZ37Bk6niNLxSJq9NOmSZfanRgfCuONBeb_BWJEWRi8_b7mekMyAyZnPE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bUaBdJP6LRNeFWl-lOlwjuRiAcQvXvIsIaI2bkm3Dfw&oe=6A2C3344"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
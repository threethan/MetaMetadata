2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70wI-Zf0qkkQ7kNvwGJvpXW&_nc_oc=Ado-VOGjkeFzfrn_6n9ndL-0uTQ8t3heZMVcyn7H4tG4IT5ku6Qs4XN6xmU_l1QjTUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkTnMJm5H3ZWR5XVhunUBFHYXZ7zC3bQSAtO-BlP0IpQ&oe=6AB00599"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5QQqeyagXwQ7kNvwEwEgQX&_nc_oc=AdpHsjbZFSblVO4MGPg70CzcfUFtOnHzDf_i8LnzG6Tgk5WeS2I6XIHYDcBwagwobCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDTRKOvvY8KsiIyVp7q475osC8z56xBWTR7HMc8qgPJg&oe=6AAFD61C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRsGPKAYpJAQ7kNvwEFYy6B&_nc_oc=Adp8zmpInb1JndJeTKBydmm68mYGZaABZVVJIgI0OeWy5zwOWz-zpxx2hsB90St6u3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFl6S4h7T66KOkIJhnO1PQmgoxySLsf6f0LGbUQSXYJw&oe=6AAFE759"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aLn9tnfTCMQ7kNvwFHhQp_&_nc_oc=AdpLhX4-KvI3GpgNxnoyuuDacAOoxk5v5RrJzwKIcT9KGvfgXXJ5aXEfYCdEzvS-a48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLak3sxujMYsS1-CQuenx3BGdwdmnXzNY8EoqkHR8UjMg&oe=6AAFFC34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZzcku_KDdMQ7kNvwG9RR8K&_nc_oc=AdpHk_k8JS5d2MFolBRaQAqjxHCU1e3b2qFlluq33rhf55eQDPTaA2WA4yy8Rc_u2Ic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJn0LDC0LOPLvszrGeShIZ8hHRp9De8U95KCZ9l7ZjiQ&oe=6AAFD104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
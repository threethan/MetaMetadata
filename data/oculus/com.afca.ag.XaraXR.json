12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uezzR7u5aMQ7kNvwHdVQbC&_nc_oc=AdrPSepL8P_ajKRNmD0A6ZFF54aAkdPW80GD2icL7yoVsojco31e0gbycSI1Gm7x-uY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tD8OPmzWHy5HL0y53KllX4BX-i3ixYE68SD5KqzSLNQ&oe=6A132319"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6doD9BZCi8Q7kNvwGDzmt1&_nc_oc=AdqFnPz5yOobiTwKQrYqof09uMV-eNlmrzxswveE5Sm5fMdYHv7iwAPHQx0Hc33KRVc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ODMkx2ToHMN6iVwsPlYMn6WD1RAdsJu4h2alKBojcxw&oe=6A12F39C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_V5Tecn-n4Q7kNvwGZKYin&_nc_oc=Adr046Ce94Auibywc9tpin-nZ-Nb96YObJQV8RKQeOEmKuKhhF-qj5VxOEi5KvhpvXU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-vkpimo0TIXrsVzr8JeKjlbXA2n5vC9k3xxnMoiOPig&oe=6A1304D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nwan7GrhKJMQ7kNvwHPvQcV&_nc_oc=AdpEYrjgrBEo8d4iwaJ9yalP6Z5Qzey-ND1o5NgCNygqeqtVwOkw1bjbq1aBeI4UBRM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47pATmhsri-7OkRaKFeleE-nCsE5NyUG3lilzoaiu5Vg&oe=6A1319B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxkK2cmnxSYQ7kNvwFok-Qi&_nc_oc=Adqw8hyLWGYhTA-DAyo9giVgzgRGep6sRjGqb0kp9sj4tBCVndz3_ASMMFh-txoLZIE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qdx7jZejyLKn9K8mhpTejXAKVSlQ1_0ih_ntTFZbDGA&oe=6A12EE84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
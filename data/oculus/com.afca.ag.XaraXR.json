12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2mv2rkarTwQ7kNvwGFsg-I&_nc_oc=AdrfGJ-4fe9XL2RZeQUVPkJVAEqdJhNKSKi-9OuNyeVUqlUznO11uxSfDQPx4RWUpkE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9iuw1OOHkLzSXD3FQyNxuBaA-dUY9bQjmHnZ5g08M_g&oe=6A689C59"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcrVnsteAHQQ7kNvwEBUOBv&_nc_oc=AdoZ3ev-QBObkZcA-8IZaiv5LQyS7kZw-cwr7WZpznng1r_HblUVdeYx5AJEgZFf1E8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6BPfj9v_FihUGHASivWf_RITVfqR6jAiI3s3EHOp2JA&oe=6A68A51C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rlPHm5Jd0YQ7kNvwFcgWxW&_nc_oc=Adqtr583_pqqx7I3-8R-MTSaH37hPfSnPlda9vRCL_6wJ98b1C4id5cZ-P6nsvSKExs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVTfVpVA8VgL0-NXkHYEVM5T1KTa5ZNctfCW-McMvlRg&oe=6A68B659"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNf7h1NLTOsQ7kNvwGvtb4k&_nc_oc=Adq7Jpy9q75y0kPxqzFh6nf-ggEiXVovpwO7E9mInkkSni_9F_8aY2cbvc52eEBHtgg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUXYzhErAOrPNDk1nhNOsq6TTj5FGw_ffs7rvFlJf0aw&oe=6A6892F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbCFM1KpDZkQ7kNvwHla5Ml&_nc_oc=Adqo33zJxiKNOOsvVbeCg8k4t_TXFpS3r4NbsCOBKvHC6rse67b8V1ofbfYzsqHK2Ns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_7q-225axwL0scRo1J0EPYHSl_ENs8VpXZt3ZWhLvnQ&oe=6A68A004"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkbYVOj5ffEQ7kNvwFuVSno&_nc_oc=AdoJjPuN7lpYvfWW9f43ibkmu2q5EPyjHocym6AfRrh2CLHz6qQdzs-Lmy4uSPBURnk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIFUwVxJr3T2_CdRtH1Q5fOlYzZVAEO5jpZknJLdRNug&oe=69C12DD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJwDehMEiFYQ7kNvwHAUawf&_nc_oc=AdpxvMLT_HR9nmtjH_jzPK8C6JGL4X8mSLwj-gpplKTI95pBJgKxmDzXZkSogt_S5Sk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxbez8zgfR3hKQT48wyPc91feh-LL4-gFGKD8swk0wPtA&oe=69C1369C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U73CVDMyofgQ7kNvwExzHmO&_nc_oc=AdoRB7A3iE9jgRVinHvNXQOpH7Hbrz1obqsB3nSlz6jgZLwSUQwjZTbsZV1kWeYshHo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxi7YaHYpgal_qxFVCqWLgoauNrd7qwH2irdC1aIh-ycA&oe=69C147D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-z65ILENbYQ7kNvwGyBFDV&_nc_oc=Adofm0h09j23G5ZXtKZxisd_Bn0zQsB5I5811jHePoDAWtiAXOBpcXXQ444_GjxO89c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzQJrkqT3F76ZOmvxAR7RFg1l3qBmij9dnCrn1CmE2LQ&oe=69C12474"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY7wdHHucKkQ7kNvwFBpjen&_nc_oc=Adpw2D4gF0ssXOn7_U6_tlEvMJagxZXOdc0F1zS2cNtuoj_ZcuawNPDw_gwjxz87BUw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwk6iGsDs0oB_uJaflI2u3F7iVKlnCJ1slp2taKnR4Ndg&oe=69C13184"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYhg0OdA5mAQ7kNvwEkFHyU&_nc_oc=AdqZvUxJMOYkK6DFHLM6MaJlKd7eIfe9unoz74kgCwlxqoswmbMVK3Ksn4KcIzgvaBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIhaem3XP1FU3ZFmmL-_fjstnweP8gOOgz_4JAoPuVGg&oe=6AB54B99"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62IBk3iquGgQ7kNvwFuQVva&_nc_oc=Adp5WB-JXl8CH56uEultR6KEQmIZIiNjt2DjXXYr4xlMCXGtO_i810qWmsLvt7TGCKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoEv9PYaQzXX1wiB18CtS1o_lM5kdJuNwyQaLOD-P2CQ&oe=6AB51C1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Siv9aV1dXQQ7kNvwHs7m_x&_nc_oc=Adpe_cXWyT5tNDNJErwB00MchNye_eqWhZRDD8Ypk788vjWNCLRIjwinG8DOxHrDvHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxV50wV2Jufgr6zc5WfOQJ3gDKKqdZ4ibfXlR6qe44tg&oe=6AB52D59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vYIM8kG2wMQ7kNvwEecVeE&_nc_oc=Adr6dd6kajybDfjiQ8GQLGM0QUBTdKY1M3FAWWuRESjj03mz-lUbRCbOttPkEZVX_nM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI9yEb1w61K38swIYhs4YbR-2_2ISfdCF_g0EY0KQoXw&oe=6AB54234"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iyj6qCCvJd0Q7kNvwENnYVe&_nc_oc=AdpBb-VsMuKDJIpFjQlvtJY1JmqBpYNOLpOSYrAK1UahqcSrC1ak_lcHHSi8WBqsN7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLstILhQMNWXAg4sHUtqfAjQHVNaCsLFp8FHacNcpNJNg&oe=6AB51704"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
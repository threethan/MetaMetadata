12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yShnKY1UVx0Q7kNvwFZZJwV&_nc_oc=AdqLZQZHNmhLUkjXQ_uOYxJndiztaHV3MiMmOc6an-LCPP9NA26QuywC6yKY8E0UY0w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BbL8xzpcKZwzHQAah3Uyr44ANI5BGmW6ntWsm_jL3vw&oe=6A1C5D99"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyeP6y7-It8Q7kNvwFRPLTN&_nc_oc=AdoTmMebSl5nI5TYVrWooqQ_PnEGIUSw-nVsR4k29POXwzkU8jl7YnSPWq_BmNSEp_4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m0QlERBP5xcsJ0LWcWkkL1pCs-bv-rTzWjIajU94c6A&oe=6A1C2E1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJBE690HE48Q7kNvwGvQ07s&_nc_oc=AdpCjSzOzCvV12svqhE8BEXXYkVFDk_Hx-GpFM49bReH0XC6AyKXVy1t9Yy0Pdu_mtg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uBgO1IBE1xlTR0hUUpsiXKTUimrQyF2Yh0VDbOrrIXg&oe=6A1C3F59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IGsz6TFZowQ7kNvwHspRPz&_nc_oc=Adq3RyLHecVxLB6lu6s4DxDGxfQMQxnyAIqV3nTnLHCJ-f66ff7l2JvdNyDWs8SfmpY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sWTVJAZD2erWGfGsa5A1qObXA8B0PgDQRebmQ94ydVA&oe=6A1C5434"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzPkCsQr4MMQ7kNvwHkvGGp&_nc_oc=AdqdxwyQ1-qVC7veN6YwoJ7cdwL7dEXPDezyQan14m2eeIgA5k6CUUI3NzKWpXrJI0A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BtvghhpEdZimJwUHxHzV7-H_1SHn8O2DC5NhdnftU0A&oe=6A1C6144"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
0227612_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uezzR7u5aMQ7kNvwF5yoFK&_nc_oc=Adq1-_I2gtkva07rBi-Eklgmb9FVG_KoO7Uh9UgTfkAIjKvAzTx_XznMCMjTzMzREnc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41B2wP5Z-ChvtuG82dZIrNU9ZYxsDxKHPgsXDJYFknyA&oe=6A11D199"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6doD9BZCi8Q7kNvwFt4Sc7&_nc_oc=AdopFEr1rOEoeDL9tAZ06TbDCKlp3FSGDiTjGCHIVGRQVIWsLIMsNcJ96fcZPUURLfs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kR48yhHnmCCjMRJ3ptccpf2kwC6yjZf9sierhQCoNOQ&oe=6A11A21C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_V5Tecn-n4Q7kNvwG17-9N&_nc_oc=AdrfWG7CSCbeJkZOsnfGw7D7dlDBozEOX-di_BBAfYu3j3bzYCFPNHdhBQm8zfDTbGE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BN8H5PaQsAx_B1iUTc-zvjqLT-rBWYl04Lvg9K2epZA&oe=6A11B359"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7-2k5oe4qkQ7kNvwGijzpq&_nc_oc=AdpjkPey3zOlXGvbYn4DJtOyVHiuxjs0KvAxTmJceYsJKTprpvqJrQZRFaLfn4Iz_3A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JML8DtGi1mG09a0ta_SJQKz08zRg4wf9vOgipcYT_3g&oe=6A11C834"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxkK2cmnxSYQ7kNvwFanXUN&_nc_oc=Adqr1Bny_xf2sAPzTUr2y2WHHR9eg9ezDIEwE8feL2eRkoxcYcqWddzjFifpi074K_o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AM1x9tt3t_RutuARFN59AYdCJdtsEsyV_jnMtNwk7zQ&oe=6A119D04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877078687
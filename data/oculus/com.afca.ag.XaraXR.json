12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iqq8NkdNZQEQ7kNvwEZ-xSr&_nc_oc=AdofzNcgmUalAmposC3XuVnvq0Y3P17t57gSaT0YDT_cTG78f6NXPC4bZDylTGggyKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mA8A1NBG1-mQsi-AdsduYzr32IwTNjP06L-cU56pwjg&oe=69D3A2D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elVafJOSDEcQ7kNvwEduLEB&_nc_oc=AdrWDPdL7jXSzsRAx86M2uZr_U72WNj2Ig1Xrvlf2o8t5OXbUi9Ht5NV0o_xymdIFAw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SEObr3f5JrvVJR75eyMGzntGw7P72aaH1rXOJghR8OQ&oe=69D3AB9C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl5k5Vlq_JUQ7kNvwFrsMOh&_nc_oc=Adr2VVRPRAY4goTGBEnhMtlaT6l59lVj6VrDxHWGzEZXLMJcXLmrt-F8mtLPMUvSs4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36Pnym8r_0KoJ0_-kHIxqwd4PhcgusxPvoqviI1r2hOQ&oe=69D3BCD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdysU2ypoekQ7kNvwEg3tj5&_nc_oc=Adp9Jk8GIXjvSzbeq4ADj5CVqb2Ej1FlAV1sCD3L2NdBgVsLuRmqloYpEpKcFr0_zeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jzW1kVzZGZv0mLF2Y3324SoP7vXxuzNuc-YrMTR-Jzg&oe=69D39974"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jsg_UeOMbYIQ7kNvwFDp_R5&_nc_oc=AdqjDisPIlP-wkQL-_ooqkylBH1WSUxI95ZYIqfhRF56T44iI-xvvNNKbyodxO5QBWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1narabe61yVvR4Z4p7h-cf9Y_Rm7qvBYfkGsDdZ6ONLw&oe=69D3A684"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
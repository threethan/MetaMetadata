12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-VWwSn2yKMQ7kNvwGMMLDn&_nc_oc=Adqc11c-nRVRoHUVxpVQqtdFMt-klrpi4qmlpK2T0wvcTLCsIPaMM_QS4WjmmtVsrVE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUqUFjBTZ7XVFTlL6IlGCTFu09iYY3Ko0N4vtFVLzIkQ&oe=6A917AD9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GZY3e0hhxcQ7kNvwHsTz-4&_nc_oc=AdpZFCUWbesk3LaR0nBb3fqXIuHcNXT9l6qcbVpWgURrdx-O1D0AEai7Tx9rZzLvEAA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZtRnQyqo6ewZFxeeN1TXvJlIqGKcs1ADPOEGR8-USGw&oe=6A91839C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzjZhmfmY7kQ7kNvwH-e0TP&_nc_oc=AdoahkAyttbiMtXOZiV5qm8g60mf6rFrcV8Nt25sczybzXjK7gH-rW474X_R-OtPWys&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2xROJ3Ad74BrWEUuT9-sLMZh_BCEHk1DkGjscsopDWQ&oe=6A915C99"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5hocdi2YxwQ7kNvwF7H1Xj&_nc_oc=AdrNHEMdm8jktq9dq2kPgNgiOVHUlPCXcBB2uaqNbI877jX_U6MZkrjU7EIQXvEvxqI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfMlf80O-luvxVp6h1cJZlwuYpQq6eptyA-GVh3v0wDA&oe=6A917174"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttU3v119mOQQ7kNvwGNn3C8&_nc_oc=AdqRQ88IXVBeIQBZaFo_qklAuxsXEagrHUps4FIFrcaWRdXsFUOP2iNGa25_21Tr5tY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH14wWd7Y7hawaP-oMUr9H_4-IK3RyXeFOPKLDGxNO3_A&oe=6A917E84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
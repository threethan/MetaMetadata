12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uezzR7u5aMQ7kNvwEOvR33&_nc_oc=AdqJ-Z8v8fO4Gmu0GMz3NCHQhCzq6brkxUZgi1cM-0GyPyQT-8FxLNItb-721hz1q6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MRLIeOj4--Rp3cJWoEXIleUx0Zl4U5uPGro2LqeHAQA&oe=6A147499"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHOks7Lfa6MQ7kNvwH185Pt&_nc_oc=AdrnCiA9BzuChUNOaeBCNr9otx7wOuDv3V4_qCt9vm1to6n0LjLKG3PrKPT0Df-9Zic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IzEKVkVPgzVqbT470lIth49QO6nCpTmvagBJaa5_Gkw&oe=6A14451C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFjPD_ibHFUQ7kNvwEoaTra&_nc_oc=AdrPkAqHOHo6T0VUYBAD3csjaDzHiYDdvpRx0rw8JWzx-o9bpNeE38rlk5KK_u7E2sU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78X6-wFfLb4YUDQ-H2ZcBoaT9ZZ-DwnGLDBg2Eu5KesQ&oe=6A145659"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nwan7GrhKJMQ7kNvwGE9_AH&_nc_oc=AdpU26Y7vpL38UQGYjYAfAmdpsL_HURZiildtwtjFdihmhjYVth88KWGUjrJ8FjX_6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QHmWl2bMlRTWPurf9FL7qAJTtqd6ykzrrRikdxBdwDg&oe=6A146B34"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxkK2cmnxSYQ7kNvwGfBiMI&_nc_oc=AdorNH2H8ezVbgtJLMEVh_XLAW730Q5hh_f9YfB5PYdrGH6OnPQSn6-ajfur_TDg7tQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hQTrGLrrmOvTD03SZ-HyNj5n5zlJVrmCDiRiEMEHNqg&oe=6A147844"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
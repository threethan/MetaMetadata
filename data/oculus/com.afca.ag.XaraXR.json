12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKqhkJ25_TYQ7kNvwHR5BPZ&_nc_oc=AdpQJWV9ngQku6DMpAIC6K6F4sazpQaaVVrgx9ornF5yL3Ml4O5BNH4TQ4ywVczjIAc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHY13C7yWDLUHBlLIEYKrWpcm35nNg9cbxUaKczOMQQw&oe=69C7C559"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRypvi-Bs1EQ7kNvwELYDNc&_nc_oc=AdrlsM5sESt4rbH2rlSjfOSPvwjSb4DbAoVeerDHGf1476AeHGmOU_hiRHtMfRI4YU8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytKb51NPHhumkXy4jNq6a7_DooX5DFBt3unJofq8Q1_w&oe=69C7CE1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miKMLEqc_2gQ7kNvwFp32LO&_nc_oc=AdoPixsMhNajZZhY7AsrxVlosTmiWAuX_cNQfSty0QYbiBusVsRV22L4E41bEnqldNI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXCNtUyc5SyEHy-EInlE-n8NoK4soEPJoWskQ2P_2QcQ&oe=69C7DF59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drqva60_ISAQ7kNvwGk6jGY&_nc_oc=AdqnIAUJK4otEMrD7Lda5gE47cP_xtbQzxLMpi16Ghm5nwxRcLGhYdjdlNI4WHq5h4M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQoUqPT7CAIrWrN-mygiZX659ozOqByNsBVz5W-nV0Tg&oe=69C7BBF4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4Cug20vhqsQ7kNvwELD8_i&_nc_oc=AdpBbarkGLzoPkq7IQSOnPlYnGNt1uY-CiuEFchnntkzNcr7z3Gojhmk0vsCW1v0jO0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwez0ncPP9z_XadZxZDAawBtJ1mbniCq7Hwa1OjbAxjoQ&oe=69C7C904"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezaQaArpVvoQ7kNvwFGswpJ&_nc_oc=Ado9n2WDNI0fJ7Vnap67l4dvFeR4VbtVDs9i6qm0R-nt-UY94cypD4Id4p0NSp3UcVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkVbOZ6ue3CFp8iEY7H_I1SMuV0_z7ZGHSMZR6lYuYyA&oe=6ABBE319"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGu3FOD-CN0Q7kNvwGhaPlf&_nc_oc=AdpNLjnMIzzI9WytcvxlMDR0aVORVQvGEbMX4KO9WWqAlz9dkXpaXFAJ6Ywi7quq24s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImBoz4dU4rAx7OPESm1Bwqphwp5Cbhr1AbMWYYYH-9qQ&oe=6ABBB39C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4lm_c4dqdAQ7kNvwFlKAKe&_nc_oc=Adp5rbXaBDvZoPs70pW-SBsRE1593DtuUG-byz3aCGeivzQ7ReWtU0gMqN9gjm19Yeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOsLoj04hktAO3vJ97l6iLJPD522nhVz0Hvr63xVCJ3w&oe=6ABBC4D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHcGZ79G_fUQ7kNvwF5u24l&_nc_oc=Adr59JkPa7c7bOTPgekPaPvsIFwnAc7gyeqCHTsJsiytuzRE3MSCcsfGQkozPKDj1zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAgmQy1_aNFAzfQNAuwDXyzhdP1YY7907jFgZ9HTkmEA&oe=6ABBD9B4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1Qb3AAUhVcQ7kNvwEt9sWe&_nc_oc=Adpo3KY2hym7_yNbK2zddth4lmca40NRoTnsaJS1g7U60PJJtAuz7GpDatd1momEaRU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3vJO9n6vK_ug5fCx0PtzZyZj_yOOjMgXRftUsfoI8mA&oe=6ABBAE84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
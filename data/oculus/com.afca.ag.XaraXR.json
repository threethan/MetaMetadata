2_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JkLerMjlIgQ7kNvwGY0cyK&_nc_oc=AdpT8QB9IH_YTyzBs-hfImi-vlizZwsG-0hrqLan2ee8pnZX7xQBTxgT9Zo3lozrkuo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMwb-8sBpOP7BUlHBh5Axv_wfl7Et0L1DhjucVg9VZCA&oe=6A973159"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck-FRmCJ5LwQ7kNvwEQgzhr&_nc_oc=AdpvRD4rbVcbK7kxqzOqYJ959VoFIP3KpVijUNQ2_f11a4b29abHPDa0gUbY1ERPQ8E&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUeqGJDEGAuudMRsFUWUnWXNqL-p0U_Qbdkxm_E-wuaw&oe=6A973A1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u0qtaGf914Q7kNvwE4yPwX&_nc_oc=AdqfR-MnJFRw0tuy6eb_Mk8euw4yUlnlunq6FpIlJSx1FLDofTTyx8PqLT-EasW8jMo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp-c7B5sQwB9JHcJ0j4dYmeSE8J34PxE74ufZPaalioA&oe=6A974B59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLwzrVfAb98Q7kNvwHdqJRQ&_nc_oc=AdoWz-7_FDSH_IpihBO_Qv7W4kNR2KF232qBGpaLv2tdOw1jv-X9vH9NLsTe97AbhDw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0U8bu7CHQpylS0MYWhNtpxb3nqKEIwhumBFEPe1VknA&oe=6A9727F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs16rsAXwCsQ7kNvwEdj7J_&_nc_oc=AdoXFsiLZzRqU5etnSBx7eLthGDwzbAwDkfY3FiHTKq6frDGRVjzKwz64-fBkCi2Lq8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsXf0nWZmIHjfDOrUTyYlV6LZcPGgSuUmjVp4uJXxQRA&oe=6A973504"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "e
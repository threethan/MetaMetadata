12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z5wvdk_ELEQ7kNvwGcxgAc&_nc_oc=Adra7O0O61iSDCnHVBgYo0YDkKt7_-CUsIU_2ErBc1Ws01S7wpiOu06UvL14Sqa5-Cw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1gKZKqvPCSNjzFCg12XraTep1DV-NNrDn9l_pZSz6jQ&oe=6A60B359"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkdeJrHqyHkQ7kNvwFJthmD&_nc_oc=AdqpQhCSamu9wLOkf7gLG03DiJ2PcT1O5Oh7c57GqqVXzNqlTE8LqVCs_hkGuSycO3w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR_GQ0cdZdpuSErQKju_UmLBLjqvYmpcylxOJAhF5GMQ&oe=6A60BC1C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M-jFEatTxoQ7kNvwE49deV&_nc_oc=AdoRThR-_vwOcJj2qbouZhSfpAkAv-8cDfRBwb_5IE-op4YVegesKWrn6Xk5jx3juBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVV7j1Ttwy6CjzdVNeoyWLpxZltl7GQHLt_pTc8Q0usQ&oe=6A60CD59"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBkJJon6faAQ7kNvwHC4zsi&_nc_oc=AdoywD4zplvRlYWWgfo5SZsFXwJxhIeFreJc__LhAmZUEtjBeBdA5KGEGKeXqVDySto&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiTNfUxAjZFmLjzm60H4eeUXa6aabcI-tEeH4Tbd49DA&oe=6A60A9F4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XahdnYVrXHQQ7kNvwEMz4Gw&_nc_oc=AdofkSDMmhnvpCdY2a9h612fu6SF5EQ_mK3AbbzA3IsgRqQjp7yM7Sw8QT7XN-KyOYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe5jCk7Ch6gLfzdsoCFcBeP4nZ1yFCNduVTkcw_Ug-xg&oe=6A60B704"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
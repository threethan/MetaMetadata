12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYB_GWGO_SEQ7kNvwE6feDB&_nc_oc=Adr-GIqawfCHUTPeripdOOqTszJDKWn9ZoD4YY_BfFEXsF3y9i2nUr8iJ4AKjMPEvEA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxI2SqpjhT0QW2XAS0PU20XYtnpzXj4sScoAAwd7jNwMw&oe=69C3D0D9"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJwDehMEiFYQ7kNvwH4KMtA&_nc_oc=AdrZSo_sQHGbsCYUZJvnUA197aW4SH1P0dqiWUPTo_pNmmkJx3sE_W6eztUnKtlStA0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfDPyCjwoSEbxaIkuS3wn4JOXh3iESwlnsVTDxSDHIUA&oe=69C3D99C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U73CVDMyofgQ7kNvwE9Fl2U&_nc_oc=Ado1NQwembpC0xkhE_yLzca9GPqozVPVhBo5F_clPQS2SCM0oek8cf2eecb0w9BuRU8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyfx4T6kplXZPrHImx9FNM9QmeCGXYp5-GbeADUzKEHkA&oe=69C3EAD9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=th1L47XMAQgQ7kNvwEN27Sj&_nc_oc=AdoGcnIvyS5oalCRMqWql2CgHJrGA6VFVy-R3u8uwQhBdYjyPiCLhMBH1ry6TXKIPDQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPy25p4TbUxK95g09534bNAkIWT9DtXwk4F4swkd-Kng&oe=69C3C774"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz-BgwrBz3AQ7kNvwFa-N9o&_nc_oc=AdqUukoGPfuexZI1hUNOKLFHm9C5AelSpunsGBm81hRts_liagywHdzmvuERoDwI9uM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeO7BOZQg9axDz0emgjX880ShQD-YkSsJjumJDHMwmig&oe=69C3D484"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
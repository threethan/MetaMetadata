12_2668196232927612194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4NJKmWmKlAQ7kNvwFBIWgh&_nc_oc=AdpSxLMRtsg84ogeD9EQ7zMYcogacwI4vEMo0VTL4rIKl0TzOBDztdaWwnZajtflDYw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qdpuuLubU9OmRDftYMz1Oma9yrYfOZTXhjdrVDgooqQ&oe=6A15C619"}, {"file_name": "Screenshots2.png", "id": "1285155912551281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_1285155915884614_1269088956195126171_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHOks7Lfa6MQ7kNvwFpUHxt&_nc_oc=AdqKPGRiDWF9px_6H7p3_UjHAXJ2ste-la6BqYF7yusdW8_ev1zaRRgh-gZGpLDG9K8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dNczrsQAK-n0ZV2LxQpyahRKxS2ywFGn8iPNJtEzRWQ&oe=6A15969C"}, {"file_name": "Screenshots3.png", "id": "2315469418808658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392025_2315469425475324_613238997194976116_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFjPD_ibHFUQ7kNvwHWrUNE&_nc_oc=AdprTexGpbbCtNIzOCQIkApBDh_GiY0aB8H9oNYrE4QbTCA1Cxrnfn27Hx87Livd164&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KWW8hUZQmjQpsR1eLmGwteo_gRha0VzUfAqXB2NSxuA&oe=6A15A7D9"}, {"file_name": "Screenshots4.png", "id": "2836944443154234", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392025_2836944446487567_5800317814976525466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nwan7GrhKJMQ7kNvwErLyT9&_nc_oc=AdrYG-Xi7G0bPx5OrxcgiBkMGl1Wd-c8Y7hHvWBeAOxkZApFDOizU-bz7CQYsSccagU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gB8FqjzRp5HNoYSD7qYJ4X8xYnluysz0GcbrOgLSIng&oe=6A15BCB4"}, {"file_name": "Screenshots5.png", "id": "1132794914695808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1132794921362474_5531734483058503363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHS613OUXxEQ7kNvwEfoD_l&_nc_oc=Adr99l3tH3_XLibaAMQkeC1DgHzaSnTcmOzgqqlHRgjWMjm-SXo21J-ALWL2q-PNYbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EunU_qsGxkWeiWYiONH6o9SiJc943KoJEq5H3V4uCng&oe=6A159184"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Xara", "keywords": [], "long_description": "Why Xara?\n\nRealistic Simulations with 3D Avatars\nOur avatars simulate real conversational partners who respond individually to your reactions. Whether it's parent-teacher meetings, customer interactions, or negotiations, Xara provides a convincing and practical training environment.\n\nSimple and Ready to Use\nWith Xara, you can get started immediately\u2014no prior knowledge or technical setup required. Whether on your screen or with a VR headset, Xara works in any environment and lets you dive straight into training.\n\nAutonomous Learning with Instant Feedback\nYou receive immediate feedback after each conversation and are encouraged to reflect. This deepens your understanding and sustainably improves your communication skills.\n\nFlexible for Various Industries\nXara allows you to define your own scenarios for realistic conversation training, tailored to your specific needs. From security discussions to police interrogations to citizen interactions\u2014you can create the exact situations relevant to your team\u2019s training.", "short_description": "Xara is an innovative platform that provides realistic conversation simulations, anytime and anywhere. Whether in education, public institutions, or large corporations, Xara offers a flexible and cost-effective way to train for challenging conversations and improve communication skills with precision."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afca.ch/en/privacy-policy-xara", "developer_terms_of_service_url": null, "publisher_name": "afca. ag", "support_website_url": null, "website_url": "https://afca.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
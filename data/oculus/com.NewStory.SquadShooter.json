d3-1.oculuscdn.com/v/t64.5771-25/473391971_1207538120722530_2887079707745946323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewd7HYYiCbsQ7kNvwGSJ_Pk&_nc_oc=Adq4RzuZFgA0GT9Qz0CFbCXIjFYyNzz_rKxV3JAwnfsFX0HL4tKxhMY-EiYC6qkq64k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVQPDA4yOU1EEKNfqweN-0Sn4xhal-E58EKYDyCBSxDg&oe=6A7F0A21"}, {"file_name": "screenshot2.png", "id": "681147301091230", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391921_681147304424563_7107628153119924505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkjTKB3bIDkQ7kNvwHIEsdw&_nc_oc=AdoR0LE0u47w1sca_jzNadoQ1BSudSa72t1hMTm_WMC5TyrKU-Ktwn_WEdTRwANxjBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKfYcEJt0LKjwzhD9i_fB35_D0nVZlnzSfjjxhc-7_lg&oe=6A7F2827"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hell Battlegrounds Project_2560x1440.png", "id": "1174205493871707", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1174205497205040_8292520613604273441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8zNU5US8Y4Q7kNvwE29od-&_nc_oc=AdpBtR884p0-cSvz0TO5MlcbWxYPaaSeEnlreyqKMq8MJfVcEaxtV3knGSX0K5QPVK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5CiA3jcqtPiSKq4oq_9JuMYGk2umjjFR-xaSpVaR-Hg&oe=6A7F20ED"}, "display_name": "Hell Battlegrounds Project", "keywords": ["Hell", "Battle", "Grounds", "Shooting", "action"], "long_description": "# GEAR UP AND ENTER THE ROBOT WARZONE! \ud83e\udd16\ud83d\udca5\n\nGet ready for Hell Battlegrounds Project , the most intense  robot shooter experience on Meta Quest! Step into the metal body of a powerful robot and prepare for epic clashes against waves of relentless enemy machines. This isn't just another battle simulator; this is pure  action designed to push your skills to the limit!\n\n**Dominate the Battlegrounds:**\n- Intense Robot Combat: Experience visceral, high-octane VR firefights. Feel the power as you unleash destruction upon your robotic foes in dynamic battle arenas.\n- Lethal Arsenal: Wield an awesome array of weapons! Mow down enemies with the Minigun, blast them apart with the Shotgun, metal with the Lava Gun, or electrify the battlefield with the Tesla Gun. \ud83d\udd2b\n- Loot & Adapt: Outsmart your opponents! Pick up weapons dropped by fallen enemies mid-battle. Adapt your strategy on the fly and turn their firepower against them!\n- Upgrade Your Power: Victory earns you coins! Use your rewards to upgrade your favorite weapons, boost their damage, increase ammo capacity, and become an unstoppable force. Customize your loadout for maximum destruction! \ud83d\udcaa\n- Non-Stop Action: Face challenging waves of enemies in various warzone environments. How long can you survive the clash?\n\nAre You Ready To Wreck Some Metal?\n\nThis is the ultimate VR shooter for anyone who loves robots, big guns, and explosive action. Built for Meta Quest, immerse yourself in the battle like never before.\n", "short_description": "\ud83e\udd16 Dominate the battlefield as the ultimate robot! \ud83d\udd25 Jump into intense VR robot clashes! Blast enemies to bits with insane guns like miniguns & tesla cannons, snatch their weapons & power 'em up! Ready for non-stop action?! Dive into the warzone NOW! \ud83d\udca5"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
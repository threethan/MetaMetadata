e": "screenshot3.png", "id": "970538268528095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391965_970538275194761_7616164693060040711_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc9DkUmO0b4Q7kNvwEK6yvm&_nc_oc=Adm6x6N1uNAUAS5DvVtEWZIi-ldUZuBKMSNcWd916-Q6IwU-fURLjbNPgbkx9YbjVc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwD3u0QfsZMQ87xE0yMzti7JzuuIeG9PPiDl398C4wIzA&oe=69B41623"}, {"file_name": "screenshot4.png", "id": "1134252021720931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393531_1134252025054264_2551493376718676791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLEd0TVVmUcQ7kNvwHIDfbO&_nc_oc=AdnR2U5MLcBE9uw9-wn7tmvz0prf0NbfCE8Nj27kw0wK0F53d_ypXekeS_MdHqiZ1pQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQCp5aR-gSI2OuDKdp96GsGuYDlyITUFsE__IAuFwgcg&oe=69B3F2C2"}, {"file_name": "screenshot5.png", "id": "1207538117389197", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391971_1207538120722530_2887079707745946323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zyKorZ_YgcQ7kNvwG8WTX9&_nc_oc=AdkwJoPtZYD98gDr7_OZJ85j2GdiZAA_izmlZMLL2Eorst-k_wLQvgwzPe1M0iGJBLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFHjG2UR3vSoiMsrANWPBKIiw145U7YuyGbpkRasV6wA&oe=69B40321"}, {"file_name": "screenshot2.png", "id": "681147301091230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391921_681147304424563_7107628153119924505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB5rbN498-AQ7kNvwFDBFaV&_nc_oc=AdlkCeSkfOeXLfiPbArAZKOGC7aC2FPgcnrJ9QMoj_DvMQMaeSYq89qBhISae-E5UzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnyhtuMr8FnBME7WXtIst5M7ORJTPapNToJNFhUtOK6g&oe=69B42127"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hell Battlegrounds Project_2560x1440.png", "id": "1174205493871707", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1174205497205040_8292520613604273441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvqCg5oGk4kQ7kNvwFHdp93&_nc_oc=AdktusEkRxGN4imY8DAwebW_f55LvxXCIcasSUCrsrQeq7z3oNsh2KXqHgj8ZKB4erQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPnMau8G1fsoC0LWegj4wDCX7c5Rw--XVjzHOzl3EZRQ&oe=69B419ED"}, "display_name": "Hell Battlegrounds Project", "keywords": ["Hell", "Battle", "Grounds", "Shooting", "action"], "long_description": "# GEAR UP AND ENTER THE ROBOT WARZONE! \ud83e\udd16\ud83d\udca5\n\nGet ready for Hell Battlegrounds Project , the most intense  robot shooter experience on Meta Quest! Step into the metal body of a powerful robot and prepare for epic clashes against waves of relentless enemy machines. This isn't just another battle simulator; this is pure  action designed to push your skills to the limit!\n\n**Dominate the Battlegrounds:**\n- Intense Robot Combat: Experience visceral, high-octane VR firefights. Feel the power as you unleash destruction upon your robotic foes in dynamic battle arenas.\n- Lethal Arsenal: Wield an awesome array of weapons! Mow down enemies with the Minigun, blast them apart with the Shotgun, metal with the Lava Gun, or electrify the battlefield with the Tesla Gun. \ud83d\udd2b\n- Loot & Adapt: Outsmart your opponents! Pick up weapons dropped by fallen enemies mid-battle. Adapt your strategy on the fly and turn their firepower against them!\n- Upgrade Your Power: Victory earns you coins! Use your rewards to upgrade your favorite weapons, boost their damage, increase ammo capacity, and become an unstoppable force. Customize your loadout for maximum destruction! \ud83d\udcaa\n- Non-Stop Action: Face challenging waves of enemies in various warzone environments. How long can you survive the clash?\n\nAre You Ready To Wreck Some Metal?\n\nThis is the ultimate VR shooter for anyone who loves robots, big guns, and explosive action. Built for Meta Quest, immerse yourself in the battle like never before.\n", "short_description": "\ud83e\udd16 Dominate the battlefield as the ultimate robot! \ud83d\udd25 Jump into intense VR robot clashes! Blast enemies to bits with insane guns like miniguns & tesla cannons, snatch their weapons & power 'em up! Ready for non-stop action?! Dive into the warzone NOW! \ud83d\udca5"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9371452652963372"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1748676769414592"}]}, "baseline_offer": {"id": "1748676769414592"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744604580, "status": "PUBLISHED", "id": "1748676769414592"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9915766591865306", "version": "0.0.2"}, "id": "1310271126695699", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9299081946867110", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "99
c6-1.oculuscdn.com/v/t64.5771-25/473391971_1207538120722530_2887079707745946323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5acJ6pTGoUQ7kNvwEp9Dia&_nc_oc=AdrlHPKQv_b93WXU5lY2X1gITOxKqHkMp5e_NXro2Llu3OeXzbHe_VvTFTZWHm-MT8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF7CksOYfGoTEzoE3Q19MUOCiVUYz_IlQA8cxLEw4kMQ&oe=6A747E21"}, {"file_name": "screenshot2.png", "id": "681147301091230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391921_681147304424563_7107628153119924505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugmjlmfFHGUQ7kNvwHwMVBN&_nc_oc=AdqH7K9vzAGX3FXx5hP720pkjFPfslzX2YK7Jp-eihjVSPQelh4-s2jZCbxpnkPHNzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYLPbO-So8qfQKIwlifX9rKJNvGpYAfcP0QNoQXdewZg&oe=6A749C27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hell Battlegrounds Project_2560x1440.png", "id": "1174205493871707", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1174205497205040_8292520613604273441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oiYzWIEBWAQ7kNvwGVzH1C&_nc_oc=AdqyD05lkC39tTBo4o9YYUb7ZSDtvDx4gp6uviA_7U77FoC_x3bVL8hM99OPWws-8ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQQ0PhFiQCk2RcvWNIvSGt9m36yPz6fDIrO0tXLciXbQ&oe=6A7494ED"}, "display_name": "Hell Battlegrounds Project", "keywords": ["Hell", "Battle", "Grounds", "Shooting", "action"], "long_description": "# GEAR UP AND ENTER THE ROBOT WARZONE! \ud83e\udd16\ud83d\udca5\n\nGet ready for Hell Battlegrounds Project , the most intense  robot shooter experience on Meta Quest! Step into the metal body of a powerful robot and prepare for epic clashes against waves of relentless enemy machines. This isn't just another battle simulator; this is pure  action designed to push your skills to the limit!\n\n**Dominate the Battlegrounds:**\n- Intense Robot Combat: Experience visceral, high-octane VR firefights. Feel the power as you unleash destruction upon your robotic foes in dynamic battle arenas.\n- Lethal Arsenal: Wield an awesome array of weapons! Mow down enemies with the Minigun, blast them apart with the Shotgun, metal with the Lava Gun, or electrify the battlefield with the Tesla Gun. \ud83d\udd2b\n- Loot & Adapt: Outsmart your opponents! Pick up weapons dropped by fallen enemies mid-battle. Adapt your strategy on the fly and turn their firepower against them!\n- Upgrade Your Power: Victory earns you coins! Use your rewards to upgrade your favorite weapons, boost their damage, increase ammo capacity, and become an unstoppable force. Customize your loadout for maximum destruction! \ud83d\udcaa\n- Non-Stop Action: Face challenging waves of enemies in various warzone environments. How long can you survive the clash?\n\nAre You Ready To Wreck Some Metal?\n\nThis is the ultimate VR shooter for anyone who loves robots, big guns, and explosive action. Built for Meta Quest, immerse yourself in the battle like never before.\n", "short_description": "\ud83e\udd16 Dominate the battlefield as the ultimate robot! \ud83d\udd25 Jump into intense VR robot clashes! Blast enemies to bits with insane guns like miniguns & tesla cannons, snatch their weapons & power 'em up! Ready for non-stop action?! Dive into the warzone NOW! \ud83d\udca5"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
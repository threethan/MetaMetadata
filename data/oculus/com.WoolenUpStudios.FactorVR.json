HLonmW&_nc_oc=Ado-6L9FZKacDTuYGWJ2yoajhngRXShRQKONxomhZ6aAWnEBmQ-oeiOvP3rPA6tbUV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwndpunVyjKEVTvXqhRB7dy_EXjydjs-mhdiv61i3x9Kw&oe=69C90704"}, {"file_name": "shopscreeny.png", "id": "1366288755194616", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300910_1366288758527949_8319517146233161398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYw-aWv-wQUQ7kNvwHqYRzM&_nc_oc=AdqI-57cG087UTVMnKk83qaO3MrPyvO4Y1_T_aYNfQeeAiGfHDSIz9hdUBuEDKY2BUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzV0qQoLd1lLfZwBG1jH_cGlJBlStJw748MJV2vCim6Gw&oe=69C901F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Factor", "keywords": ["Horror", "Action", "Adventure", "Party", "Spooky"], "long_description": "FactorVR is a horror game made from inspiration off of OGFMH. Factor has 5+ gamemodes both horror and non horror such as Fast Fredbear, Nextbots, the Facility, or the new Fishing Gamemode where you can fish for power-ups such as flying, or going through the map to avoid monsters that can pop up anywhere to scare away the good dreams from your head! This game also has a shop divided into all sorts of outfits ready to be worn by you and your fellow monkeys. So what are you waiting for? Hop into Factor and join your fellow monkeys running away and battling against a species no human has seen before. Welcome to FACTOR..", "short_description": "FactorVR is a horror game made from inspiration off of OGFMH. Factor has 5+ gamemodes both horror and non horror such as Fast Fredbear, Nextbots, the Facility, or the new Fishing Gamemode where you can fish for power-ups such as flying, or going through the map to avoid monsters that can pop up anywhere to scare away the good dreams from your head! Welcome to FACTOR.."}]}, "developer_name": "Woolen-Up Studios", "developer_privacy_policy_url": "https://sites.google.com/view/scaryvervet/ppolicy", "developer_terms_of_service_url"
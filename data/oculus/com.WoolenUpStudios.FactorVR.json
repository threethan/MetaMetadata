Eo0WjyKbfUir4R6gHJh_ER7GgjJTqJIcZetL5W9n4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfySoM33vz6BZEQ2AxN9FHsDfnkA17fwg4H-d8PVGqZ_WQ&oe=69BA8684"}, {"file_name": "shopscreeny.png", "id": "1366288755194616", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499300910_1366288758527949_8319517146233161398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYzUdJPlTogQ7kNvwFweeb0&_nc_oc=Adl6FCPQY_f6FiIS2kSJX9lD8qSdlv-iMTG2QtSO0buDMn5RBxbMsYY_CD9Ak2baiu8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiBFq93h4REbqy_pD9jKa77tpV90teDMD2SUscEiJanQ&oe=69BA8173"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Factor", "keywords": ["Horror", "Action", "Adventure", "Party", "Spooky"], "long_description": "FactorVR is a horror game made from inspiration off of OGFMH. Factor has 5+ gamemodes both horror and non horror such as Fast Fredbear, Nextbots, the Facility, or the new Fishing Gamemode where you can fish for power-ups such as flying, or going through the map to avoid monsters that can pop up anywhere to scare away the good dreams from your head! This game also has a shop divided into all sorts of outfits ready to be worn by you and your fellow monkeys. So what are you waiting for? Hop into Factor and join your fellow monkeys running away and battling against a species no human has seen before. Welcome to FACTOR..", "short_description": "FactorVR is a horror game made from inspiration off of OGFMH. Factor has 5+ gamemodes both horror and non horror such as Fast Fredbear, Nextbots, the Facility, or the new Fishing Gamemode where you can fish for power-ups such as flying, or going through the map to avoid monsters that can pop up anywhere to scare away the good dreams from your head! Welcome to FACTOR.."}]}, "developer_name": "Woolen-Up Studios", "developer_privacy_policy_url": "https://sites.google.com/view/scaryvervet/ppolicy", "developer_terms_of_service_url": null, "publisher_name": "ultima", "support_web
ent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRxCTK6Z-4zJx2njZeBg8ii99JMBIiB9EAoMi7GWnHPQ&oe=6B0B316F"}, {"file_name": "Screenshot3LGH.png", "id": "7180045608747730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036639_7180045612081063_3803920176398291976_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX_f-oXII_MQ7kNvwFiSze1&_nc_oc=AdoFOlhPU4WoTUBbWLXmPUbayQWHGNXnRZdAgR8T92PzcVW2CM86UPN-JcFrJpurgic&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJ1QpAphGgv-GS9duB4NfbJ03V4wIbO8D1jjaLvvOGVQ&oe=6B0B138E"}, {"file_name": "Screenshot4LGH.png", "id": "2037843523269269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003233_2037843526602602_1752182967429505124_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drNZFs66LgIQ7kNvwHbOSAE&_nc_oc=AdpEJmXq7Y1F7PqnkfCdwSA07h8KIKQII48uUuFwANJrWMM1yVVph4CA0CTrrGupllg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSE4dfGaA2pyZ7EOlFm8tH8COGvEVqJPi1lVI5RdZsoEA&oe=6B0B3BE4"}, {"file_name": "Screenshot5LGH.png", "id": "7271417836284654", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75278189_7271417846284653_4807472338154430644_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeLeT5OzOxQQ7kNvwEnqMeB&_nc_oc=AdqY2InI0kOIHEXV_xxAwGOCcdqHtfo8dWnJ0_vTuGC4tucp6kFnPpBlbNDLaL_Dpfo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrKxUTK1BVbNQSeRuderq23ElHBjp5LWzz_Kcgfi_b6A&oe=6B0B1EE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laaggeletterdheid 2.0", "keywords": [], "long_description": "Ga in een realistisch virtueel rollenspel op huisbezoek bij Noreen, een cli\u00ebnt die moeite heeft met een lastige brief die ze heeft ontvangen. Begeleid haar bij haar hulpvraag, werk aan het opbouwen van een vertrouwensband en leer tekenen van laaggeletterdheid herkennen en bespreekbaar te maken. Is dit niet direct gelukt? Geen zorgen; na ieder gesprek ontvang je feedback en tips die je kunt toepassen in de volgende ronde.\n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak, waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en je virtuele gesprekspartner, word je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefen met het herkennen en bespreekbaar maken van laaggeletterdheid in Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.nl/contact/", "website_url": "https://thesimulationcrew.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7107855689335535"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75297582_1155034932531947_7380447621953361572_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPGRDhGU4pEQ7kNvwH8so3j&_nc_oc=Adp2uaSwlPdWP4ABi32tQBmNzvwheS7_ByOmRlUpXwHFoH8alW1Kakf78_LEMdOgNPI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCkH3tKcvKETfh6LWaQSqN5Q7jhddZ_waQF3tBz64YD
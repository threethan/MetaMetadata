D6i6_tOUmLh8FT46NV9lJAus5awmp73Q&oe=69F3543F"}, {"file_name": "Screenshot2LGH.png", "id": "939159841162562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031656_939159844495895_2190803739242848870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7dOWcCuy84Q7kNvwED0ehA&_nc_oc=AdqiQrCz4nTVq4wIyCyIrcYQxASc4FiHNn_jFcFzq6AMJtXTmIH2e0CdiO6Hv5ghEBk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mz4npPkEeyiC28yBlFwna_4sSUwvQfJKRFgvemDi4Hw&oe=69F342EF"}, {"file_name": "Screenshot3LGH.png", "id": "7180045608747730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036639_7180045612081063_3803920176398291976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I35WZKCl2LsQ7kNvwG-A_3I&_nc_oc=AdpE_NYdDclRJ4IKm5jAyYK01kVXqOpJWDgJEZqvK9JN6ev9X17ym91PvfxqZADLGjA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0S1-KIc8rz-PdX8o8wbUA_XYSNx3-mKZETjZd2flktvQ&oe=69F35D4E"}, {"file_name": "Screenshot4LGH.png", "id": "2037843523269269", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003233_2037843526602602_1752182967429505124_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCYhqhEHzuIQ7kNvwGN7iMK&_nc_oc=AdrG3sn92N57HC75aBIAU7CJOYgsiSMZfuajjnKQ2XgehH-k95EWx1WNiNcHjSY63AM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ahXWmlYgSTGCF_Fy_Uf1Nowv_f0HwW2lIZCotOkQpog&oe=69F34D64"}, {"file_name": "Screenshot5LGH.png", "id": "7271417836284654", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75278189_7271417846284653_4807472338154430644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1xxj6aPBT4Q7kNvwG9oNB2&_nc_oc=Ado7OAjIuqot60PDj_0j6TYDr9-ZagXjUvnFtMRKOxf86BRm5vuM-W8V4rq5S11l68Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UNISJwlWGN9sjWQrMyZZejT23xlg2TtLuZ02rjcLN9Q&oe=69F368A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laaggeletterdheid 2.0", "keywords": [], "long_description": "Ga in een realistisch virtueel rollenspel op huisbezoek bij Noreen, een cli\u00ebnt die moeite heeft met een lastige brief die ze heeft ontvangen. Begeleid haar bij haar hulpvraag, werk aan het opbouwen van een vertrouwensband en leer tekenen van laaggeletterdheid herkennen en bespreekbaar te maken. Is dit niet direct gelukt? Geen zorgen; na ieder gesprek ontvang je feedback en tips die je kunt toepassen in de volgende ronde.\n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak, waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en je virtuele gesprekspartner, word je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefen met het herkennen en bespreekbaar maken van laaggeletterdheid in Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.nl/contact/", "website_url": "https://thesimulationcrew.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7107855689335535"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "998304832033400"}, {"status": "PUBLISHED", "id": "928778155543144"}]}, "baseline
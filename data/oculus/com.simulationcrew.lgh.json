rLAGfHQw&oe=69A837CE"}, {"file_name": "Screenshot4LGH.png", "id": "2037843523269269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003233_2037843526602602_1752182967429505124_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiOyDNQVSzQQ7kNvwHtGOYp&_nc_oc=Adl4JZr4Zi-LCJE5R7pyqgvakKocGJauDlijVh6aqrPuwEb5dpT_IwZ4ANr2DThd2r8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftdDcDdjEk9xyrR7o9c1IthQ4LWHsFO64Q7q5bOh2EkBQ&oe=69A827E4"}, {"file_name": "Screenshot5LGH.png", "id": "7271417836284654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75278189_7271417846284653_4807472338154430644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI6XlZex_roQ7kNvwGs2zn2&_nc_oc=AdlfmIVhtewMX3QSWfTgEfRt9KZCIrY0gJq19aHB5_fSEwtbMS4OTQpM2miN565RIJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvr2ecPW3sfnzhOuRTyeMAI6yah87k13wVtolMA7KBarQ&oe=69A80AE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laaggeletterdheid 2.0", "keywords": [], "long_description": "Ga in een realistisch virtueel rollenspel op huisbezoek bij Noreen, een cli\u00ebnt die moeite heeft met een lastige brief die ze heeft ontvangen. Begeleid haar bij haar hulpvraag, werk aan het opbouwen van een vertrouwensband en leer tekenen van laaggeletterdheid herkennen en bespreekbaar te maken. Is dit niet direct gelukt? Geen zorgen; na ieder gesprek ontvang je feedback en tips die je kunt toepassen in de volgende ronde.\n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak, waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en je virtuele gesprekspartner, word je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefen met het herkennen en bespreekbaar maken van laaggeletterdheid in Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.co
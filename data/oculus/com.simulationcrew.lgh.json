/t64.5771-25/39031656_939159844495895_2190803739242848870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7dOWcCuy84Q7kNvwHLT0XX&_nc_oc=AdrPBmuzzacce87j4ourDJSF5xzVaH7ebhBvDQwwPkVPFhLcJu37yJhhhrR-nco58fo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jtkQapp8GXAanG2LJi2K98lQWtr291sU7rAtqTkWcIQ&oe=69F1F16F"}, {"file_name": "Screenshot3LGH.png", "id": "7180045608747730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036639_7180045612081063_3803920176398291976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I35WZKCl2LsQ7kNvwHC8VhB&_nc_oc=Adqk39amxCanodgQgWnM7X7q7dF50KhrOE3JDRZVvKmrOWQqFlsF8rMOh8UXVP-CsaQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TK3BDVhS8e2u6q-b1bos4WeF1I8WIl_2E6fiq3ItB_g&oe=69F20BCE"}, {"file_name": "Screenshot4LGH.png", "id": "2037843523269269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003233_2037843526602602_1752182967429505124_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCYhqhEHzuIQ7kNvwFsyucK&_nc_oc=Adr0siWzjD8sx73qOBF4HFJ6Mv6RZhnlX71FuxxrR5ap0O7a2srmmU4s-NZOHYyQnYA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MygvohY7rgod4e8BIR22xWKAweTpUsXr704SsjwD93g&oe=69F1FBE4"}, {"file_name": "Screenshot5LGH.png", "id": "7271417836284654", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75278189_7271417846284653_4807472338154430644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1xxj6aPBT4Q7kNvwEoekKl&_nc_oc=AdrXX8i5AhlPWLZtv6IQlotcXXrCZVjtWtt7qdEZwAAmhjilzJA29z3DDPFMLkk04NU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1dYl-pqvAf9gBnoMOb3JRU3u3dDN3llxdb-CbY3Rc6BA&oe=69F21723"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laaggeletterdheid 2.0", "keywords": [], "long_description": "Ga in een realistisch virtueel rollenspel op huisbezoek bij Noreen, een cli\u00ebnt die moeite heeft met een lastige brief die ze heeft ontvangen. Begeleid haar bij haar hulpvraag, werk aan het opbouwen van een vertrouwensband en leer tekenen van laaggeletterdheid herkennen en bespreekbaar te maken. Is dit niet direct gelukt? Geen zorgen; na ieder gesprek ontvang je feedback en tips die je kunt toepassen in de volgende ronde.\n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak, waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en je virtuele gesprekspartner, word je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefen met het herkennen en bespreekbaar maken van laaggeletterdheid in Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.nl/contact/", "website_url": "https://thesimulationcrew.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7107855689335535"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "998304832033400"}, {"status": "PUBLISHED", "id": "928778155543144"}]}, "baseline_offer": {"id": "928778155543144"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "998304832033400"}]}, "liveChannel": {"nod
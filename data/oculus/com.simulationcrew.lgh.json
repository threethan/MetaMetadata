ent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLjYAASUO5bPlPkScOFZRlzY6R-9T_p5JQql_plJoCEw&oe=6B09A7AF"}, {"file_name": "Screenshot3LGH.png", "id": "7180045608747730", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036639_7180045612081063_3803920176398291976_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX_f-oXII_MQ7kNvwELcpiO&_nc_oc=AdpYtTAP-h5PWVEbTnSPVa0Z0l37rwRp1G7TJAKQezJ176DfOKsoaBXFF7IV4Y62fOs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2-v9gXd3qTRWRqA7agfRmPxCV9Nn3KmfrU7G83eZ4Sg&oe=6B09C20E"}, {"file_name": "Screenshot4LGH.png", "id": "2037843523269269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003233_2037843526602602_1752182967429505124_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwq1RLdGehkQ7kNvwHPVId6&_nc_oc=AdqdhZsWswyCeaBSTpxyQw4rS2NyWif-wQAuXtNEGNG8XkzTcDwrw1i1U-I8oqea7sA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLtdO8rSc9Gfw3vOrec_TdxoVbuegIQ4aksiWQo0dT2A&oe=6B09B224"}, {"file_name": "Screenshot5LGH.png", "id": "7271417836284654", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75278189_7271417846284653_4807472338154430644_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-_Bcjakp8sQ7kNvwGNi1Ji&_nc_oc=AdpiJ8hkYdf_UNhgvhSocOyNE8prMBUx3y5TD2XhkgTQdn_4wxKVx27ukVDKo9bDE58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROzKYChrBV_NrOM6cK0zewPVHy61iDY8bEY7l7tHL3jQ&oe=6B09CD63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laaggeletterdheid 2.0", "keywords": [], "long_description": "Ga in een realistisch virtueel rollenspel op huisbezoek bij Noreen, een cli\u00ebnt die moeite heeft met een lastige brief die ze heeft ontvangen. Begeleid haar bij haar hulpvraag, werk aan het opbouwen van een vertrouwensband en leer tekenen van laaggeletterdheid herkennen en bespreekbaar te maken. Is dit niet direct gelukt? Geen zorgen; na ieder gesprek ontvang je feedback en tips die je kunt toepassen in de volgende ronde.\n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak, waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en je virtuele gesprekspartner, word je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefen met het herkennen en bespreekbaar maken van laaggeletterdheid in Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.nl/contact/", "website_url": "https://thesimulationcrew.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7107855689335535"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297582_1155034932531947_7380447621953361572_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPGRDhGU4pEQ7kNvwFWHy_m&_nc_oc=AdqoucJccNI28CUHz4nVNSkMXth64Q81NnCuvTv8jLKEvDP0Tr3fzL11qYGXTB77tJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3WMG3m5DMckpSIFoER3XDoAX8G9JXVDRorEbPwtDnb
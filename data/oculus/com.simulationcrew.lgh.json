t5dAypIkzVjoPOU2aJV_eJVHp4TuwYbFyfWxOR5XNf5lphiNO96Uq0gCHpRVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJUvfw4pU5vqqdyMM0ZX8dP_niIoFRR6_843e1zWKqkA&oe=6AE5F14E"}, {"file_name": "Screenshot4LGH.png", "id": "2037843523269269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003233_2037843526602602_1752182967429505124_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udETmbTJjbUQ7kNvwF_SM6s&_nc_oc=AdrsslhsPYctAXX8yC6BqYaaac3nNU3Bps0NK8__DCEtxGPSlRnCQBPGYwNRfWD46kk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOpsbeLYM6SpQuaEeUmFUx2N3yQihGFPuIDuqsvIQBww&oe=6AE5E164"}, {"file_name": "Screenshot5LGH.png", "id": "7271417836284654", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75278189_7271417846284653_4807472338154430644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBDZFx96-pAQ7kNvwEtH4_W&_nc_oc=AdoTjNGeCnUw3QGhDUikH6HX8rNydpDudRjNkxOd00H4dTon4kNOA9SuPF73U-sKDOQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMduISunTm9TzUhcN6u14aEAYOW3iCfIijTXKl2SJa8bg&oe=6AE5FCA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laaggeletterdheid 2.0", "keywords": [], "long_description": "Ga in een realistisch virtueel rollenspel op huisbezoek bij Noreen, een cli\u00ebnt die moeite heeft met een lastige brief die ze heeft ontvangen. Begeleid haar bij haar hulpvraag, werk aan het opbouwen van een vertrouwensband en leer tekenen van laaggeletterdheid herkennen en bespreekbaar te maken. Is dit niet direct gelukt? Geen zorgen; na ieder gesprek ontvang je feedback en tips die je kunt toepassen in de volgende ronde.\n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak, waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en je virtuele gesprekspartner, word je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefen met het herkennen en bespreekbaar maken van laaggeletterdheid in Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.nl/contact/", "website_url": "https://thesimulationcrew.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7107855689335535"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297582_1155034932531947_7380447621953361572_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWaQuWdJTYMQ7kNvwG5HESA&_nc_oc=Adrvo4tesvSJLH3AivS0FcU_w-GKJ_H_EV8sBCBAHWox0SC-u9B2maf2dVt6nKMO4tA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy9Q_eguAU_oIBKr5lZEsd9H61NnSepfffmzS-g58sWA&oe=6AE5FA1C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Laaggeletterdheid 2.0", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Unknown", "id": "27362927396627898"}], "release_date": 1714600200, "lastRevision": {"nodes": [{"id": "7107855696002201", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metada
CuvPqIa2fw-UkKDd9Dw12umydMi70cmw&oe=69FC8EBF"}, {"file_name": "Screenshot2LGH.png", "id": "939159841162562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031656_939159844495895_2190803739242848870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqXM02WX9pIQ7kNvwG8waJB&_nc_oc=AdoTJKWNEV9yuhWgpzV_xQwpo7h9DFtnEf68S4Zgk4OSJwjfnPnpPNcXIIhcFCVSoGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ve5rAOZor7KMrNTRBfZNcKVVtucdjeptCRZF1jCg3mQ&oe=69FC7D6F"}, {"file_name": "Screenshot3LGH.png", "id": "7180045608747730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036639_7180045612081063_3803920176398291976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFwH_9O0LvkQ7kNvwF3L458&_nc_oc=AdpSDG4ZwvVGT2eWJKSYQUlLVxhC_m48W6OUvhD4wuiR0kanYXE_Jvb_BK0HbFfl4Cw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57DLDQSGherqabofW0kTb0SvU6RYhJBJfIQ_LD34P7Pg&oe=69FC97CE"}, {"file_name": "Screenshot4LGH.png", "id": "2037843523269269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003233_2037843526602602_1752182967429505124_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IwaFIwPmzoQ7kNvwHX4D4X&_nc_oc=AdprRduBMkNrc0X1OPaokQ4RJMUtwezt9JjsTpu7NOM_tWL6BJNp1sbPgQVQ6STl57A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fJYpVoOGtMAmb-H3xjT997aZbOK2n9sWYIVR2J_rssw&oe=69FC87E4"}, {"file_name": "Screenshot5LGH.png", "id": "7271417836284654", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75278189_7271417846284653_4807472338154430644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6WeXUjLYuQQ7kNvwE6zROw&_nc_oc=Adrkq8No8WOPz0NgPgEVcLVgWqI7PU7fHBiQKp2wObl7XHgaDLZZ3YDZ-5UJcHagN0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rQkEemdEwYfnut54LwaeE84cQgpgMtDyqDaYkVvkRLQ&oe=69FCA323"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laaggeletterdheid 2.0", "keywords": [], "long_description": "Ga in een realistisch virtueel rollenspel op huisbezoek bij Noreen, een cli\u00ebnt die moeite heeft met een lastige brief die ze heeft ontvangen. Begeleid haar bij haar hulpvraag, werk aan het opbouwen van een vertrouwensband en leer tekenen van laaggeletterdheid herkennen en bespreekbaar te maken. Is dit niet direct gelukt? Geen zorgen; na ieder gesprek ontvang je feedback en tips die je kunt toepassen in de volgende ronde.\n\nDeze unieke gespreksimulatie maakt gebruik van vrije spraak, waardoor het initiatief in het gesprek bij jou ligt. Door de realistische omgeving en je virtuele gesprekspartner, word je helemaal ondergedompeld in de situatie. Met de ingebouwde feedback en intelligente begeleiding krijg je jouw gespreksvaardigheden op een hoger niveau.", "short_description": "Oefen met het herkennen en bespreekbaar maken van laaggeletterdheid in Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cdn.jutten.com/docs/Privacyverklaring_The_Simulation_Crew_1.1.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew BV", "support_website_url": "https://thesimulationcrew.nl/contact/", "website_url": "https://thesimulationcrew.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7107855689335535"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "998304832033400"}, {"status": "PUBLISHED", "id": "928778155543144"}]}, "baseline
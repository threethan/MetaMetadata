B00B4"}, {"file_name": "ape4.png", "id": "1115109390619222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982690_1115109393952555_2586735120020223205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DT8P2n3QkVEQ7kNvwHx5Mru&_nc_oc=AdqLWgrBm-20iQTBR-RrvMtTTbsWtnAerb4K4PEVfATgPMAjJvfS-hEmTdRyQixJx9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af752wGWhEb3bdP3racmCO2KnA4u0wqy21WcYQY2WFAAkA&oe=6A0B1D90"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlcJwl4znrUQ7kNvwHW34o2&_nc_oc=AdoLC0VSC20jajN_m8-5HOdGO2C8mEYmHed6lRqMRvl6ao4EJbtgjhjBhYPknggmQL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69-Q17X7cmXa9EYrS_i5N-N-B3C7sr1JRinDJZ3rjk2Q&oe=6A0B3452"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_
3&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARY5JggbjHcQ7kNvwEFsmIM&_nc_oc=Adp0I-NxrwxbKE-BXQsniUKz0T2PgomEu5MnOB16PDgJII4EzIAOzKWeh4LUjannUds&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgsjcdtvvNPYG7ycuFZChtD7UoXB979b-uo9kNux52jg&oe=6AD0F9F4"}, {"file_name": "ape4.png", "id": "1115109390619222", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982690_1115109393952555_2586735120020223205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWiGsqN3UxIQ7kNvwF20Y39&_nc_oc=AdqzktEIFdIcd9JcI03vetbJgbzINq8-0I4nSOFhOQB3Y-UKHev6JUqbOj7o_lEcPZo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfYjY9CVFcWnWp2OVdSUEXAXRrPzXsntS9RsLCESTecg&oe=6AD0DE90"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0SJ50_Cx4cQ7kNvwH9-D6T&_nc_oc=AdpktYEvkOlm8C2P-hj-A8hTIyQrRXkbuJ3XwS0PzpEJfWWdD4vIByjJUMOPbeQjKqM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ1x5MtBRQMdu2lNZ-3CbUKAyWfr8beNR4eRy6HiO4xQ&oe=6AD0F552"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_policy_url": "https://sites.google.com/view/nutsandboltsvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "AlbinoGT", "support_website_url": null, "website_url": "https://sites.google.com/view/nutsandboltsvr/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7744359442327832"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "427482636772597"}]}, "baseline_offer": {"id": "427482636772597"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1719253756, "status": "PUBLISHED", "id": "427482636772597"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7959329624164145", "version": "0.2.0"}, "id": "1153946078982863", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7718380494925727", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7959329624164145"}, "release_status":
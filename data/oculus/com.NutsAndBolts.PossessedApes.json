92F74"}, {"file_name": "ape4.png", "id": "1115109390619222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982690_1115109393952555_2586735120020223205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faxhcAOtmt4Q7kNvwHxrQ_i&_nc_oc=AdpcfDqBcib0g63KCDXg7qaO1YTYBgird0SK31tP0k4pLG5foG8V3IMwzXDrNBq6u1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8GmGYlTBJ0lHibZZiNfDtD1CH1BamBL9BzqvKOT_wAQ&oe=6A491410"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPD-AnK5AvgQ7kNvwFpXuLu&_nc_oc=Adqb0bW5CAsp86kJd0NLX-R-c1E7t3xPFH3RiafIMipQ2ahY1ztqEyit0Vb_QQd_qtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPY8dYe5IoYIYnwpjIt6Tnit1ZQY34ImfZHsH7OYf_sA&oe=6A492AD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_
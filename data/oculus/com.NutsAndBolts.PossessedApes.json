_oc=AdrqookXCYYbG4UBUL8vbC8qtJNt4kZ6yniwQ8bPiYQzu76EVGtG4R_EXf24wiu62s0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSObWA5pTrbOSg5hREX-7zwVn-F7-eS3GZPdZTK4M-1sA&oe=6B0B18D0"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra0-CCVDBb4Q7kNvwFL8WF9&_nc_oc=Adpr6ujuQAmfiWP2Xtz7dYFoEbvHIxu_FaD-7XZeVXhKe0GnpzzutjWpi2iLI1fgk_M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhm6AXXxnIPMlYHwLtdrAPoq6v_Y3nZvM8bFcdOQUIXQ&oe=6B0B2F92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_policy_url": "https://sites.google.com/view/nutsandboltsvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "AlbinoGT", "support_website_url": null, "website_url": "https://sites.google.com/view/nutsandboltsvr/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7744359442327832"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569423_2137584139910101_3962275782000435848_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzNjrVqdNUEQ7kNvwE_Xod8&_nc_oc=AdqLejAb7igBqpxvTUMfUYVaNIciQLj6TZWoE1-QcAxyoD2rTZNqrTsv37u89uWF9Xs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvXfNORzUfLbU1d-qzLmfOWT9vq-qbP6KkAVJ8nwyaqw&oe=6B0B4382"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ape Possession", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1719253756, "lastRevision": {"nodes": [{"id": "7718380538259056", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7718380494925727", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "446602658119286"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "ape7.png", "id": "2137584136576768", "image_type": "APP_I
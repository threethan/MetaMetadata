E5BB4"}, {"file_name": "ape4.png", "id": "1115109390619222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982690_1115109393952555_2586735120020223205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUVzl_yXjj0Q7kNvwFSY0hp&_nc_oc=AdqQ_nqCNOx9dzFQr-H1nmezREJYx7Q6UrGxkpomJx1pGvYQyMuaChjgUrnBaQn2LpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytYrz9H3kPVnbkn3q4bOlFruV3QaLaWIKtsy1n7FE0lA&oe=69CE7890"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ehOwxA5nuYQ7kNvwGAVUxM&_nc_oc=AdrZbdIqTK4BgyCfqRth6Hj6hlXFNpTNYvWgbuN4Kanrda7O5wpDcBwQW2TGACeA5cQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz379UZCN0W0m3yNepW1QfbJsrXqsrFqvS_pjN-aSbDkg&oe=69CE5712"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_
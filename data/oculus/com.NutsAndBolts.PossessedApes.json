3&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmj5ZIdKHIQQ7kNvwEE4xiF&_nc_oc=AdrANi4h3Y5KsVyjGh1hQZxThRqkN2MxIyqtXBtJC-mTtBuujwbbJ1DiG4WeYdIZAUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZBD8iG8xr7jXyN_ig4A1sr2rjUFzlp30vA9HFYFXO6w&oe=6AF1EF74"}, {"file_name": "ape4.png", "id": "1115109390619222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982690_1115109393952555_2586735120020223205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC81IX2UezUQ7kNvwHjyB19&_nc_oc=AdpQReLPI8nVngHXxPzeFdWa6iqdvzLrU5JEgX-rtmvR_3OQZIs8hhDo3boj-WaBgME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnwFguaZWpQJgCKh-yzKgFKLJ4XhpryvSep_yMhXKNmg&oe=6AF1D410"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyGvTaWKC9gQ7kNvwHiUnyh&_nc_oc=AdpTINjCDUS07Glk2Lx5RGaLAbwofwSpkief1jv7oVDWFjARO9x1wfI0txXseByvo3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSICRsbRh-brL0VDe5bzS-Oozc80vepIGXHO0t9HZ9hnQ&oe=6AF1EAD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_policy_url": "https://sites.google.com/view/nutsandboltsvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "AlbinoGT", "support_website_url": null, "website_url": "https://sites.google.com/view/nutsandboltsvr/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7744359442327832"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7959329624164145", "version": "0.2.0"}, "id": "1153946078982863", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7718380494925727", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7959329624164145"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1153946078982863"}]}, "change_log": null, "created_date": 1
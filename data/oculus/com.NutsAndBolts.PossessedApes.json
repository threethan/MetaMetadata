K7eO27QpdMrPTE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2GdKGjiI7BJHuzjL5KJUDp25mJdnEkiELq0I7BZ6fi0Q&oe=69F0BF90"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHeCgFn7DIsQ7kNvwGbRa_V&_nc_oc=AdodhfA7O_qfvq1feuk9K4dIese90_WmxbqpmMJxrEA2jQCSRgh4Dn2exbL8x9VZ-QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3v5uUuxuwSL3usgE-2B_CrVYIDszs31wTlJaMYXk79Og&oe=69F09E12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_policy_url": "https://sites.google.com/view/nutsandboltsvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "AlbinoGT", "support_website_url": null, "website_url": "https://sites.google.com/view/nutsandboltsvr/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_
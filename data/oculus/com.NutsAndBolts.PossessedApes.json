022F4"}, {"file_name": "ape4.png", "id": "1115109390619222", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982690_1115109393952555_2586735120020223205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XUW003py0IQ7kNvwG_qPyz&_nc_oc=AdqvRG7VF4zC1BlQChKMpMIDcHXvWG0-FHd0nTKCYwYWYk-_GtweAqzDgIi6b9wtLqI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97Lr89BwfmelAooWri-IGH5D-9dhz9tPbkIjgfOXBXww&oe=6A300790"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyxhSaiPbjMQ7kNvwFZqNYU&_nc_oc=AdqRFnBsDh7MZeytTxOtsu_kM1-9VRvqWyy3xORd-xEWeXEHrEs7U5gbQGNlXHV9UNw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HQG0vU-P2-dfLbqt8YRD4xi47gXkvHihwDPnEXRH_QQ&oe=6A301E52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_
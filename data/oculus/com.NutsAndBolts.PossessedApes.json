0zbn_mSRh2hu0wq7FaEh5BoMkzlf5M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_OjS538v1DbvDu56QDIiNRqH1-NmVLtlI3fXgLCVMKQ&oe=6AA934B4"}, {"file_name": "ape4.png", "id": "1115109390619222", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982690_1115109393952555_2586735120020223205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duHNXGex_-wQ7kNvwHaXrT_&_nc_oc=AdqciRefLUO_OM129yysJdGypD4Fc_Q4zCkRFB5njDnEllaM7JQYZ0Zi-x_zjEZyh7M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVzwFk1U8t21upWER9n27VDUBOMCDn_jSLyu2kmN-_xw&oe=6AA95190"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aex2O8gShqMQ7kNvwHYU2Dv&_nc_oc=AdoPRzpIKKv4kqQHWf40OV_XxwjTYuzS7ygXx3GWOL7eSzLLwRj3qBa61pT9RxI3Bdk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxYIiOFe4-PPdm7VRdVH9wQr94g5GaXQQa96Mz7sSB_A&oe=6AA96852"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_policy_url": "https://sites.google.com/view/nutsandboltsvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "AlbinoGT", "support_website_url": null, "website_url": "https://sites.google.com/view/nutsandboltsvr/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7744359442327832"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "427482636772597"}]}, "baseline_offer": {"id": "427482636772597"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1719253756, "status": "PUBLISHED", "id": "427482636772597"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7959329624164145", "version": "0.2.0"}, "id": "1153946078982863", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7718380494925727", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7959329624164145"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1153946078982
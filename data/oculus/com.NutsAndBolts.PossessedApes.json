c_sid=6e7a0a&_nc_ohc=fxipGuL27rcQ7kNvwEQ6qz4&_nc_oc=AdrPmO0M48ERilCYBSyKebZeJz1CxCBjbpjlUwK09Ld3Xk41bkUwJcvytI7IUkEMDPk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1dkxd1ALVwYG3if5RWa_RCX6JXj07C8OTqYsG7B33kcA&oe=69F21110"}, {"file_name": "ape5.png", "id": "1179529230067278", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_1179529233400611_3490968871872407117_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHeCgFn7DIsQ7kNvwF-MpuF&_nc_oc=AdoELJ3ZVbItza3mOYNwIoANwEiq9x0y-TtvJV1RVnYWzNDZ2rh2e-HJHmVJlh89-Ek&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0t1kA2v6iXM7BGjCscPXJ3LHN-5OiXmP73GnbwiED0vg&oe=69F1EF92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Possession", "keywords": [], "long_description": "Ape Possession is a fangame that uses the gorilla locomotion package made by the company known as Another Axiom.\n\nBut if you play the most popular game on the Meta Quest store today, Gorilla Tag, then I guess you could call it a \"Gorilla Tag Fangame\" or \"Gorilla Tag Ripoff\".\n\nIf you couldn't tell by the name (probably not), you would know that this is a game focusing mainly on horror aspects. We also have a wardrobe too, with cool equipment you can style yourself with while getting chased by monsters.\n\nAlso, expect a lot of updates. The team is always working hard to finish levels and polish the game. Thanks for playing Nuts and Bolts' amazing game, Ape Possession!\n\n- Nuts and Bolts Team", "short_description": "Ape Possession, a Virtual Reality horror game that uses Another Axiom's gorilla locomotion, is on Applab!\n\nPlay with your friends, have fun, and be nice! Remember that this includes following Meta TOS."}]}, "developer_name": "Nuts and Bolts", "developer_privacy_policy_url": "https://sites.google.com/view/nutsandboltsvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "AlbinoGT", "support_website_url": null, "website_url": "https:
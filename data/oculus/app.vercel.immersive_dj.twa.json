-2.oculuscdn.com/v/t64.5771-25/491827646_909177084901514_2062143492546402379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAbN2BYGI0sQ7kNvwESl7wO&_nc_oc=AdoE9uLLNo9BqBD1602DrdzJ40xiYbQD9qehbrqE39jOjwqpIz8FlEmKXoRA71p4xfc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuYct_kGAbVhLHIVFSoDyWl5Vb-fRiaJgMEVAlIq3YSw&oe=6AA3F929"}, {"file_name": "metacover1.png", "id": "1287180619903624", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821568_1287180626570290_8150107347648315386_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50aoJDOiCiMQ7kNvwFU93I_&_nc_oc=Adrj7n_LqncqtOSXaPGzRNhoKNesJkigU_DZoZx60EoMCSjjqzICifgG_6mQlAFj3bg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfA7ZjBlMBpKLiK3Ci7U8kbAxUYJhNvouzHLQLrgmJXw&oe=6AA41D44"}, {"file_name": "metacover2.png", "id": "1789390495067589", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491825546_1789390501734255_7317943068452540873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17Zr_iG3bW0Q7kNvwE5kiQS&_nc_oc=AdoqIXJFu6nrpEK-xY0WdOM5Ov4O9sjSuBv1PyKu-YNFyileY_qZQPMHK6Gi41lz0vM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1WHfqqE1nXdegimzsXv0hqB6kw49U74Yg-SYaChbe6g&oe=6AA41677"}, {"file_name": "metacover4.png", "id": "1780362862591381", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823905_1780362869258047_8108442961467201129_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKyHnYH-V8QQ7kNvwHfJlaD&_nc_oc=AdrKeT2Q72VnwoXPwiSrG2G-wRgxCW19Bu1jOlJb3rc4ufnMd-zP7xvlAVEom860V78&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkr-ggHV8s-XrM3-rvq2wybjUINlUk6BYU65jdB0Kf-Q&oe=6AA413E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive DJ", "keywords": [], "long_description": "**Create seamless mixes \u2014 right in your room or kitchen, or anywhere!**\n\nThis Mixed Reality DJ app gives you the tools of an easy to use setup with the simplicity and fun of MR.\n\n# This app gives you:\n\n* **Seamless Mixing Tools**\n\n Use **sync**, **cue**, and smooth crossfades to create effortless transitions\n\n* **Scratch Like the Real Thing**\n\n Responsive virtual decks let you scratch to line up tracks and play like an instrument.\n\n* **Waveforms You Can Read at a Glance**\n \nOverview and scrolling waveforms with **frequency-based color maps** help you see every drop, breakdown, and beat. Touch a waveform to jump to that part of the tune - always on the beat!\n\n* **SoundCloud + Built-In Library**\n\nQuickly search and load tracks from **SoundCloud** or explore our curated library to start mixing instantly.\n\n* **EQ Section - you can't beat a filter sweep!**\n \nShape your sound with familiar DJ controls: **color**, **low**, **mid**, and **high**.\n\n* **Natural Hand-Tracking**\n  \nNo controllers required. Interact with decks, knobs, and sliders using your hands for an experience that feels truly physical.\n\nPerform using casting, practice, or just have fun\u2014your DJ setup now lives in your space.\n", "short_description": "DJ effortlessly in Mixed Reality. Mix tracks from SoundCloud or our library with intuitive hand-tracking controls that feel real. Sync, cue, scratch, and shape your sound with pro EQs\u2014no gear needed. Watch responsive waveforms, blend seamless transitions, and perform in your own space with the easiest MR DJ app available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AliveIn Tech Ltd.", "support_website_url": null, "website_url": "https://aliveintech.com/ImmersiveDJ", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connect
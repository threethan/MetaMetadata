m&_nc_ss=7f20f&oh=00_AQQi7KBMbYRup08Ri7RePLk4EfTC6ahCWU12YtuWAVYJ6A&oe=6AFEFF81"}, {"file_name": "metacover5.png", "id": "909177081568181", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827646_909177084901514_2062143492546402379_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXt49Uvnz4sQ7kNvwHO8Jsp&_nc_oc=Adq83ETdkXgFt7x2r6FeLc5D9nvkYxy3vdltLxIeQy3qLjNn1NCAb7zntD8Q-f3-dSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0FYabC8hPA8sTYcMdU6KIyTO3ff_zcgSBMFvJa6zu4g&oe=6AFF28E9"}, {"file_name": "metacover1.png", "id": "1287180619903624", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821568_1287180626570290_8150107347648315386_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f53fgjCuZPMQ7kNvwGh1pZ9&_nc_oc=Adpit0ba4DTJ9A31XxtXEm31iTP8ISsD6DfN3767OyHtkTgaWTu-pYEzLoZ2up_m5P4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJnBVKdHqCMr8weIOx9i323qQaRiet-Yldle0wvrKG7g&oe=6AFF14C4"}, {"file_name": "metacover2.png", "id": "1789390495067589", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825546_1789390501734255_7317943068452540873_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_Ow4Sabys0Q7kNvwGAZLXp&_nc_oc=AdqIk8s6OVs3x17yqAsKYJh_xlK6PC0NC0ljeISvYajz_pXMQBHBBABN-ggvt8KParQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZQxrO1taxGjnBnY13Ze7_lcUfdesZzBlatlq9tkyNIA&oe=6AFF0DF7"}, {"file_name": "metacover4.png", "id": "1780362862591381", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1780362869258047_8108442961467201129_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIxk8orPlfoQ7kNvwGDR_Vq&_nc_oc=AdqsfRKeIOIntsuaJoRn1YuyM1gdZZZsQ_p-fQH8MsvAMRvzju_n-PmJUDD2ZB-fvZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0jVNpaKW7DhbAqAkuH0jVkjRdF7RY8O02ucD7JXvw3w&oe=6AFF0B68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive DJ", "keywords": [], "long_description": "**Create seamless mixes \u2014 right in your room or kitchen, or anywhere!**\n\nThis Mixed Reality DJ app gives you the tools of an easy to use setup with the simplicity and fun of MR.\n\n# This app gives you:\n\n* **Seamless Mixing Tools**\n\n Use **sync**, **cue**, and smooth crossfades to create effortless transitions\n\n* **Scratch Like the Real Thing**\n\n Responsive virtual decks let you scratch to line up tracks and play like an instrument.\n\n* **Waveforms You Can Read at a Glance**\n \nOverview and scrolling waveforms with **frequency-based color maps** help you see every drop, breakdown, and beat. Touch a waveform to jump to that part of the tune - always on the beat!\n\n* **SoundCloud + Built-In Library**\n\nQuickly search and load tracks from **SoundCloud** or explore our curated library to start mixing instantly.\n\n* **EQ Section - you can't beat a filter sweep!**\n \nShape your sound with familiar DJ controls: **color**, **low**, **mid**, and **high**.\n\n* **Natural Hand-Tracking**\n  \nNo controllers required. Interact with decks, knobs, and sliders using your hands for an experience that feels truly physical.\n\nPerform using casting, practice, or just have fun\u2014your DJ setup now lives in your space.\n", "short_description": "DJ effortlessly in Mixed Reality. Mix tracks from SoundCloud or our library with intuitive hand-tracking controls that feel real. Sync, cue, scratch, and shape your sound with pro EQs\u2014no gear needed. Watch responsive waveforms, blend seamless transitions, and perform in your own space with the easiest MR DJ app available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AliveIn Tech Ltd.", "support_website_url": null, "website_url": "https://aliveintech.com/ImmersiveDJ", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "c
.oculuscdn.com/v/t64.5771-25/491827646_909177084901514_2062143492546402379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WV84G0BW8mAQ7kNvwGlPJ1R&_nc_oc=AdpVsEZcfl7Vx1Ub7Zhec9J8-MUkVvNO9ZL4NR5zl68F__5tgDO001ubT9eAeCKrqZI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYAm-_vDhXkdnUZcGOLMT12gxopf2zxEWxAvCU_DhX2Q&oe=6A8EE129"}, {"file_name": "metacover1.png", "id": "1287180619903624", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821568_1287180626570290_8150107347648315386_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qM6Akm7O2UQ7kNvwFnK46s&_nc_oc=AdpkU58fKXdUfYPIdTXQ1VFc32x4tcY5dzaykvuKuKRqqSaikumJZKhOhYr41EgTJGk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWuZk6dZhBcBDuhFQqP7UhgMgN9EvXNhYTiluoYilRvw&oe=6A8ECD04"}, {"file_name": "metacover2.png", "id": "1789390495067589", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825546_1789390501734255_7317943068452540873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_aG2ck4uTkQ7kNvwGxTg2Z&_nc_oc=Adqwjrr9yQGhq7J4rHyKgq9yaGGt8xYhMZHDwmH5u7Vud0nX4MudNBewwxfVQzQVDkU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-GCo41RmZyyz5MtW27hqL-zg9fmgh2R2KY7IRSQCx6w&oe=6A8EC637"}, {"file_name": "metacover4.png", "id": "1780362862591381", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823905_1780362869258047_8108442961467201129_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCcZvNsnQOoQ7kNvwGL5iRN&_nc_oc=AdpYpjhU1_ON98AIxo4LJHOarCPWGxodRwufL672NlXNDilA7VVnvUH7SJEwAYOS_LQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfchOenUuIjsu-5M4HvMwOFN0bx96seJUEFlXIYFAitg&oe=6A8EC3A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive DJ", "keywords": [], "long_description": "**Create seamless mixes \u2014 right in your room or kitchen, or anywhere!**\n\nThis Mixed Reality DJ app gives you the tools of an easy to use setup with the simplicity and fun of MR.\n\n# This app gives you:\n\n* **Seamless Mixing Tools**\n\n Use **sync**, **cue**, and smooth crossfades to create effortless transitions\n\n* **Scratch Like the Real Thing**\n\n Responsive virtual decks let you scratch to line up tracks and play like an instrument.\n\n* **Waveforms You Can Read at a Glance**\n \nOverview and scrolling waveforms with **frequency-based color maps** help you see every drop, breakdown, and beat. Touch a waveform to jump to that part of the tune - always on the beat!\n\n* **SoundCloud + Built-In Library**\n\nQuickly search and load tracks from **SoundCloud** or explore our curated library to start mixing instantly.\n\n* **EQ Section - you can't beat a filter sweep!**\n \nShape your sound with familiar DJ controls: **color**, **low**, **mid**, and **high**.\n\n* **Natural Hand-Tracking**\n  \nNo controllers required. Interact with decks, knobs, and sliders using your hands for an experience that feels truly physical.\n\nPerform using casting, practice, or just have fun\u2014your DJ setup now lives in your space.\n", "short_description": "DJ effortlessly in Mixed Reality. Mix tracks from SoundCloud or our library with intuitive hand-tracking controls that feel real. Sync, cue, scratch, and shape your sound with pro EQs\u2014no gear needed. Watch responsive waveforms, blend seamless transitions, and perform in your own space with the easiest MR DJ app available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AliveIn Tech Ltd.", "support_website_url": null, "website_url": "https://aliveintech.com/ImmersiveDJ", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connectio
.com/v/t64.5771-25/491827646_909177084901514_2062143492546402379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no4e0bTVlhcQ7kNvwEdlw_l&_nc_oc=AdroaJ80HSC9KBFvvrDtbL98K7FG9-Wq4_n2YOi9glqpG3kVjDZLdHxIB6NqR3fEPZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xznGJj8-xnLumo-_VpYkptX1mLJJyONACVtJ-hFWdDg&oe=6A43BBA9"}, {"file_name": "metacover1.png", "id": "1287180619903624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821568_1287180626570290_8150107347648315386_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUyvTnS9BMkQ7kNvwHvygBt&_nc_oc=Adq1bLMP2y8vF8r-_ls-5AkD1WwNV39ruu-jzm00U4WqSN0MeTyb_eeA2uBDdXIZPAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZcqrCbcU6QGP4MWGSpuQuouHbdhu-5ihlDvXVV1bHeA&oe=6A43DFC4"}, {"file_name": "metacover2.png", "id": "1789390495067589", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_1789390501734255_7317943068452540873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhk5xcMz7SMQ7kNvwGi3EIz&_nc_oc=Ado_1vFrvxYtDrTk5JVc0FviBHzdrB97N_KKwvm9nNaIffcXHiBDqjUQvSryh834VCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EAVPR8udDeHoBeZDShknm8XUSZg1PNsUGNVdSeqr2DA&oe=6A43D8F7"}, {"file_name": "metacover4.png", "id": "1780362862591381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1780362869258047_8108442961467201129_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3EUzt3p3rkQ7kNvwGKtsnp&_nc_oc=AdqqLK851LSeA4Yxj58NqRYROUN6A81Ury_gdeItuIfqk2tbRKiDQAkwnMWLHJh0xQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6GnJIFncH6qE9i_TNhSQXel88xLRcLD9MCxrDJgigxA&oe=6A43D668"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive DJ", "keywords": [], "long_description": "**Create seamless mixes \u2014 right in your room or kitchen, or anywhere!**\n\nThis Mixed Reality DJ app gives you the tools of an easy to use setup with the simplicity and fun of MR.\n\n# This app gives you:\n\n* **Seamless Mixing Tools**\n\n Use **sync**, **cue**, and smooth crossfades to create effortless transitions\n\n* **Scratch Like the Real Thing**\n\n Responsive virtual decks let you scratch to line up tracks and play like an instrument.\n\n* **Waveforms You Can Read at a Glance**\n \nOverview and scrolling waveforms with **frequency-based color maps** help you see every drop, breakdown, and beat. Touch a waveform to jump to that part of the tune - always on the beat!\n\n* **SoundCloud + Built-In Library**\n\nQuickly search and load tracks from **SoundCloud** or explore our curated library to start mixing instantly.\n\n* **EQ Section - you can't beat a filter sweep!**\n \nShape your sound with familiar DJ controls: **color**, **low**, **mid**, and **high**.\n\n* **Natural Hand-Tracking**\n  \nNo controllers required. Interact with decks, knobs, and sliders using your hands for an experience that feels truly physical.\n\nPerform using casting, practice, or just have fun\u2014your DJ setup now lives in your space.\n", "short_description": "DJ effortlessly in Mixed Reality. Mix tracks from SoundCloud or our library with intuitive hand-tracking controls that feel real. Sync, cue, scratch, and shape your sound with pro EQs\u2014no gear needed. Watch responsive waveforms, blend seamless transitions, and perform in your own space with the easiest MR DJ app available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AliveIn Tech Ltd.", "support_website_url": null, "website_url": "https://aliveintech.com/ImmersiveDJ", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED"
.com/v/t64.5771-25/491827646_909177084901514_2062143492546402379_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fY3fPdoQ7AQ7kNvwHYZn1R&_nc_oc=AdoCfLftzKYnvazRvJ3pJwPn-1ILxtSV1-jsSPnkl6sn63tvS1s6lM_SEMQw9ylra7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm4PdLHogDT27bY2DgDOT0u0W4TDlo813_Iby-h9egUQ&oe=6A5E19A9"}, {"file_name": "metacover1.png", "id": "1287180619903624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_1287180626570290_8150107347648315386_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWJc0Ef0wSwQ7kNvwFMD6Z5&_nc_oc=AdpcpYWx7KJO3DWSBtPvhinj5f7jaPvBdRLR5mUNQBD8C-JsRHIJ3-mkmQDtPVxyODg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCActY-LDeIUdFyBKDgYtdms20kgNW_rmC-lkr6HfIxkw&oe=6A5E0584"}, {"file_name": "metacover2.png", "id": "1789390495067589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825546_1789390501734255_7317943068452540873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT5eWuS9gPAQ7kNvwHfRvl2&_nc_oc=AdqABuHxRiXfdjXy1uU8DzyHONBJPCX3GZ7aFqRHTOrbiMZX52FFNMYPXMZVzSeuwuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFjrpXtk34cOhbWPRGQMQ5CeCnML1Gf_w5EzrMla54Tw&oe=6A5E36F7"}, {"file_name": "metacover4.png", "id": "1780362862591381", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1780362869258047_8108442961467201129_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=at2Q3ED92hcQ7kNvwGMxNga&_nc_oc=AdopMaTUYSh6lAWpuJKUunL3virgpK_VTt8xksNAvvZDTZtL2igzqUuU367uu-nNDV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6GEXQQI-Glct1WsbjoYsu1D0oD5lNpk5RHdhAJHMRWA&oe=6A5E3468"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive DJ", "keywords": [], "long_description": "**Create seamless mixes \u2014 right in your room or kitchen, or anywhere!**\n\nThis Mixed Reality DJ app gives you the tools of an easy to use setup with the simplicity and fun of MR.\n\n# This app gives you:\n\n* **Seamless Mixing Tools**\n\n Use **sync**, **cue**, and smooth crossfades to create effortless transitions\n\n* **Scratch Like the Real Thing**\n\n Responsive virtual decks let you scratch to line up tracks and play like an instrument.\n\n* **Waveforms You Can Read at a Glance**\n \nOverview and scrolling waveforms with **frequency-based color maps** help you see every drop, breakdown, and beat. Touch a waveform to jump to that part of the tune - always on the beat!\n\n* **SoundCloud + Built-In Library**\n\nQuickly search and load tracks from **SoundCloud** or explore our curated library to start mixing instantly.\n\n* **EQ Section - you can't beat a filter sweep!**\n \nShape your sound with familiar DJ controls: **color**, **low**, **mid**, and **high**.\n\n* **Natural Hand-Tracking**\n  \nNo controllers required. Interact with decks, knobs, and sliders using your hands for an experience that feels truly physical.\n\nPerform using casting, practice, or just have fun\u2014your DJ setup now lives in your space.\n", "short_description": "DJ effortlessly in Mixed Reality. Mix tracks from SoundCloud or our library with intuitive hand-tracking controls that feel real. Sync, cue, scratch, and shape your sound with pro EQs\u2014no gear needed. Watch responsive waveforms, blend seamless transitions, and perform in your own space with the easiest MR DJ app available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AliveIn Tech Ltd.", "support_website_url": null, "website_url": "https://aliveintech.com/ImmersiveDJ", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED"
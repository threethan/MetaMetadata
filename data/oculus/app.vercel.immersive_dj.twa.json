culuscdn.com&_nc_ss=7f30f&oh=00_AQVGYHVrAhQjWUeZwYNP9lHQZXcMwzAsaqUWtDi2HJMGQA&oe=6B0EECA0"}, {"file_name": "3-ribbon-visualiser.png", "id": "4009849989157222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_4009849992490555_3162498102259164318_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Bkk0qbZ5EkQ7kNvwECUKpH&_nc_oc=Adq9aWeTgtyID2YjDgm3_IECbaATrqcKw2rV1q0eE0rQ1mTJPrHlc7mq5-SgyFcVFP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXqr59SOJSW11hB_erAX2VllnILpesDHEXVu4gC5iadg&oe=6B0F1696"}, {"file_name": "1-wave-visualiser.png", "id": "2611996499261055", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_2611996502594388_8109780149778734180_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6Gf5uRX2yUQ7kNvwEaHtc4&_nc_oc=Adrp4roOghGh7J1S8wULJ9aThgSGxyuoHCCcSuxccjuepaLtvjEXM83w6m8hlSA_zkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUtYEvkPPmKqX0CaobgsKwHYNZF1Lj8zF3nMKCI-J8fsA&oe=6B0F0406"}, {"file_name": "4-decks-in-room-MR.png", "id": "1063149663408803", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1063149666742136_1363076271339658682_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sSHaIQVI9EQ7kNvwFmMlHY&_nc_oc=AdoEw33vaFZRTQR1D-9tNvqKP8CjoR5c31W04JfdHisvJZ31SzhnyoUfYB0mZvOOiwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwZi9kWIPQKZNxj_VeVv2rxBYQFGTvDhP3nY64Y-oaTQ&oe=6B0F20FF"}, {"file_name": "5-art-wall-in-room-MR.png", "id": "1408609898009666", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_1408609901342999_2632211919971062637_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xC7fKedwa6EQ7kNvwGmqvlW&_nc_oc=AdrvuqzbvQZA7WPmFFw6w1IujS8rh8yO0ivVfHxRVTQgPjlC2png6YDkazLqHfEuZCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJ4khIcusnynj0nrcw7H8LOMJVsLMTpPWvAx13mHIEPA&oe=6B0F016E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1-wave-visualiser.png", "id": "1468575105169244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1468575108502577_7879623232785052152_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dp4G01pDvlcQ7kNvwEkoeVo&_nc_oc=AdroVtk1XlgxYVWn55J-rHCLFUeH3mV_yHamF7t15BeUuhdx4ccg-DwCb1RXlvC6P-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxVtmlOu1U-Jr4lpfZQsDyeiQxETbMU8ZpF6AXsBGnjQ&oe=6B0F0937"}, "display_name": "Immersive DJ", "keywords": [], "long_description": "**Create seamless mixes \u2014 right in your room or kitchen, or anywhere!**\n\nThis Mixed Reality DJ app gives you the tools of an easy to use setup with the simplicity and fun of MR.\n\n# This app gives you:\n\n* **Seamless Mixing Tools**\n\n Use **sync**, **cue**, and smooth crossfades to create effortless transitions\n\n* **Scratch Like the Real Thing**\n\n Responsive virtual decks let you scratch to line up tracks and play like an instrument.\n\n* **Waveforms You Can Read at a Glance**\n \nOverview and scrolling waveforms with **frequency-based color maps** help you see every drop, breakdown, and beat. Touch a waveform to jump to that part of the tune - always on the beat!\n\n* **SoundCloud + Built-In Library**\n\nQuickly search and load tracks from **SoundCloud** or explore our curated library to start mixing instantly.\n\n* **EQ Section - you can't beat a filter sweep!**\n \nShape your sound with familiar DJ controls: **color**, **low**, **mid**, and **high**.\n\n* **Natural Hand-Tracking**\n  \nNo controllers required. Interact with decks, knobs, and sliders using your hands for an experience that feels truly physical.\n\nPerform using casting, practice, or just have fun\u2014your DJ setup now lives in your space.\n", "short_description": "DJ effortlessly in Mixed Reality. Mix tracks from SoundCloud or our library with intuitive hand-tracking controls that feel real. Sync, cue, scratch, and shape your sound with pro EQs\u2014no gear needed. Watch responsive waveforms, blend seamless transitions, and perform in your own space with the easiest MR DJ app available."}, {"images": {"nodes": []}, "id": "992491973928678", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive DJ", "keywords": [], "long_description": "**Cr\u00e9ez des mixes fluides \u2014 dans votre chambre, votre cuisine ou n'importe o\u00f9 !**\n\nCette appli DJ en r\u00e9alit\u00e9 mixte vous offre les outils d'un setup facile \u00e0 prendre en main, avec la simplicit\u00e9 et le plaisir de la r\u00e9alit\u00e9 mixte.\n\n# Au programme :\n\n* **Des outils de mix fluides**\n\n Utilisez la **synchro**, le **cue** et des crossfades tout en douceur pour des transitions sans effort.\n\n* **Scratchez comme en vrai**\n\n Des platines virtuelles r\u00e9actives vous permettent de scratcher pour caler vos morceaux et de jouer comme d'un instrument.\n\n* **Des formes d'onde lisibles d'un coup d'\u0153il**\n\nLes formes d'onde globales et d\u00e9filantes, avec **code couleur par fr\u00e9quence**, vous montrent chaque drop, chaque break et chaque beat. Touchez une forme d'onde pour sauter \u00e0 ce passage du morceau \u2014 toujours dans le temps !\n\n* **SoundCloud + biblioth\u00e8que int\u00e9gr\u00e9e**\n\nRecherchez et chargez rapidement des morceaux depuis **SoundCloud** ou explorez notre s\u00e9lection pour commencer \u00e0 mixer imm\u00e9diatement.\n\n* **Section EQ \u2014 rien ne vaut un balayage de filtre !**\n\nSculptez votre son avec les commandes DJ habituelles : **color**, **low**, **mid** et **high**.\n\n* **Suivi des mains naturel**\n\nAucune manette requise. Manipulez platines, potards et faders avec vos mains pour une exp\u00e9rience vraiment physique.\n\nPour vous produire en cast, vous entra\u00eener ou simplement vous amuser \u2014 votre setup DJ vit d\u00e9sormais chez vous.\n", "short_description": "Mixez sans effort en r\u00e9alit\u00e9 mixte. Mixez des morceaux de SoundCloud ou de notre biblioth\u00e8que gr\u00e2ce \u00e0 un suivi des mains intuitif et r\u00e9aliste. Synchronisez, calez, scratchez et sculptez votre son avec des EQ pro \u2014 sans aucun mat\u00e9riel. Suivez des formes d'onde r\u00e9actives, encha\u00eenez des transitions fluides et jouez chez vous avec l'appli DJ en r\u00e9alit\u00e9 mixte la plus simple qui soit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AliveIn Tech Ltd.", "support_website_url": null, "website_url": "https://aliveintech.com/ImmersiveDJ", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29597322396575359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_1307688214364866_2803762065267047902_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvj66FzPttgQ7kNvwGzi7VZ&_nc_oc=AdoaZ166maLSwE5_bThGCJPAktPi7Zc3Sq-N3IeRV_zyXsjQDH0ou6N8mY0odBavWfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUq7rnDm6ZdDPj_OWKD-40w6sALzJ32_uUamMQeT8Vpxg&oe=6B0EF732"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
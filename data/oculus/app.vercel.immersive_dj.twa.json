d3-1.oculuscdn.com/v/t64.5771-25/491831964_2611996502594388_8109780149778734180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bj3ndH7E7sMQ7kNvwFCch81&_nc_oc=AdqhdLG2uHgPAghllPu2aHVJSsUBxndR2vlb79aMQ3mGsjUDHP4xKB7n0G5pWzELm9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7-BlPU3YC3m_lybX98XFHkDHQTAPZ4EM7EVYp1nY3eQ&oe=6AF20306"}, {"file_name": "4-decks-in-room-MR.png", "id": "1063149663408803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1063149666742136_1363076271339658682_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP2Tqa3dg-UQ7kNvwGHu4_9&_nc_oc=AdojCZUiPa80ZLTbHHuPdBTohOVTu8fsyfooeEC265XlmoNA_h0DLk4Lqol4e59pNaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5eEvWYVnwKGdhXR1AUTnKdGWUoi3Ur571BwBJHbIepA&oe=6AF1E7BF"}, {"file_name": "5-art-wall-in-room-MR.png", "id": "1408609898009666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831279_1408609901342999_2632211919971062637_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpNEmk-XC7IQ7kNvwGzvzWI&_nc_oc=Adpd3torKX7KB3ZAGH1-XvO_NXDszfaGwFwdZYGtSNTav0zxPkXOA3xki1soeUXJlTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjiTYp-I-l9-ibhH39HG38QNrDok7_FhDD1v_0lhphvA&oe=6AF2006E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1-wave-visualiser.png", "id": "1468575105169244", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604385997_1468575108502577_7879623232785052152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TExSrekBNPYQ7kNvwEWFtYz&_nc_oc=AdoY-j0Ej04Ycn4Q3YfiLf5ayXzjes7mjbF7XLkflvJP29r_PVelnrjSIdZhhe6papY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPLWLf6Fz_OEkm6leqBv4lPytOZRK9DjUAuuwCWFN0VA&oe=6AF20837"}, "display_name": "Immersive DJ", "keywords": [], "long_description": "**Create seamless mixes \u2014 right in your room or kitchen, or anywhere!**\n\nThis Mixed Reality DJ app gives you the tools of an easy to use setup with the simplicity and fun of MR.\n\n# This app gives you:\n\n* **Seamless Mixing Tools**\n\n Use **sync**, **cue**, and smooth crossfades to create effortless transitions\n\n* **Scratch Like the Real Thing**\n\n Responsive virtual decks let you scratch to line up tracks and play like an instrument.\n\n* **Waveforms You Can Read at a Glance**\n \nOverview and scrolling waveforms with **frequency-based color maps** help you see every drop, breakdown, and beat. Touch a waveform to jump to that part of the tune - always on the beat!\n\n* **SoundCloud + Built-In Library**\n\nQuickly search and load tracks from **SoundCloud** or explore our curated library to start mixing instantly.\n\n* **EQ Section - you can't beat a filter sweep!**\n \nShape your sound with familiar DJ controls: **color**, **low**, **mid**, and **high**.\n\n* **Natural Hand-Tracking**\n  \nNo controllers required. Interact with decks, knobs, and sliders using your hands for an experience that feels truly physical.\n\nPerform using casting, practice, or just have fun\u2014your DJ setup now lives in your space.\n", "short_description": "DJ effortlessly in Mixed Reality. Mix tracks from SoundCloud or our library with intuitive hand-tracking controls that feel real. Sync, cue, scratch, and shape your sound with pro EQs\u2014no gear needed. Watch responsive waveforms, blend seamless transitions, and perform in your own space with the easiest MR DJ app available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aliveintech.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AliveIn Tech Ltd.", "support_website_url": null, "website_url": "https://aliveintech.com/ImmersiveDJ", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
tps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819859_4672489606312806_8044125717294608082_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt36HVbOZR8Q7kNvwFrCqnO&_nc_oc=AdpM_jKv1qfr-SD3K4Qt5utear-_5VdWDCgGalziWdMBrtGLyoXHgt52RG2xTQPRUgM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsmR7TBFqS02ii46RBIhcAgQb0VSoQcmj6DI4Y3ZXUBQ&oe=6AF5E298"}, {"file_name": "new lines.png", "id": "1388419775960154", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1388419785960153_2282154889015775334_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxJ97bBvDQsQ7kNvwF4PkjA&_nc_oc=Adrcp6K5w240FrTMafLhWqWz1LsLm2f47vabryXlx6VI8pxuIv3CfQr4Tm2epNOTNYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3FFTM5VKqMK_SQpwAA61p-BmxTziFAsCclV5WMQZrkQ&oe=6AF5D74E"}, {"file_name": "SC2.png", "id": "1290421895403633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391926_1290421898736966_7869145233278719256_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKLKQG-ZmDkQ7kNvwEb-KbY&_nc_oc=AdoGJGAVoRM0AZL-XX3RGF4j-VSH6XDCtpolkt5j2PjKsyok3tc9I94vo2LrgIB_76Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCVGV-jhwCE5L8U-ISwZy_MqZosesRTMTWTOIdd4OAfg&oe=6AF5C4FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CueScope XR splash art.png", "id": "730196436335447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307611_730196439668780_2222050437635639066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY5b08iDIdoQ7kNvwFZy68p&_nc_oc=AdqrxuCEmQ3lg22W7xwQfX84IzLrEYhDOiOJMMrQeSYYf5Rk7O6L_46p8SrShW8FDp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZQj76Lgs_ewJfnFwFaxR2XMmhpTxWxhQafR-KQUQ-Yg&oe=6AF5C2CD"}, "display_name": "CueScope XR", "keywords": ["pool", "billiards", "sports", "MR", "XR"], "long_description": "Bring your Quest headset to a real pool table and experience CueScope\u2019s advanced mixed reality tech. Visualize cue and target ball trajectories in real time to fine-tune your aim and improve accuracy\u2014no guessing, just better shots. Built for real tables, CueScope XR enhances your game without changing the feel of live play. Not a VR game!\n\nCueScope XR uses advanced AI to display the real-time path of the cue and target balls as you play. This instant visual feedback helps you adjust your aim and improve technique\u2014no extra drills needed. From simple shots to tricky plays, CueScope gives you the edge to level up your game.\n\n**Latest Update: CueScope XR now features automatic AI ball detection. Just look at the balls on the table and with a press of a button every ball is instantly recognized, no manual placement needed.**\n\nJoin our **Discord** (https://discord.gg/tfsJ4tENkA) to chat directly with our team or send us an email at info@etheri.io.\nPlease see our **User Guide** (https://tinyurl.com/yr2ncpfa) and **Video Tutorial** (https://youtu.be/cF_y5CM3hSc).\n\nYou can also use the **In-App Tutorial** to explore CueScope\u2019s features.\n{1018938156281348}", "short_description": "Bring your Quest headset to a real pool table and experience CueScope\u2019s advanced mixed reality tech. Visualize cue and target ball trajectories in real time to fine-tune your aim and improve accuracy\u2014no guessing, just better shots. Built for real tables, CueScope XR enhances your game without changing the feel of live play. Not a VR game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://etheri.io/#/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Etheri", "support_website_url": null, "website_url": "https://etheri.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_R
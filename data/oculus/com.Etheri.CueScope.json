1290421895403633", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391926_1290421898736966_7869145233278719256_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKLKQG-ZmDkQ7kNvwEb-KbY&_nc_oc=AdoGJGAVoRM0AZL-XX3RGF4j-VSH6XDCtpolkt5j2PjKsyok3tc9I94vo2LrgIB_76Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCVGV-jhwCE5L8U-ISwZy_MqZosesRTMTWTOIdd4OAfg&oe=6AF5C4FF"}, {"file_name": "SC3.png", "id": "1421855162542990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392046_1421855169209656_4996181925431676076_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOhXgVJEqGkQ7kNvwGiV73L&_nc_oc=AdqP0VJ10nAIepK7G0EXqt5jpHPcX5ujSSFtMbIJP1Z8g1t3VbeUIqoMgI_4DN_MY7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-PvCX5p9NbqrmL7lLZRMISzzu9MJtP8JjdaCX7iK-rw&oe=6AF5D365"}, {"file_name": "SC4.png", "id": "2041818449625657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392105_2041818459625656_9151297722971419483_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ub4YxaAF6EQ7kNvwEnLceW&_nc_oc=Ado4lgS6t9Tdv7zZKA0YrUwt3AV7YuJ2wzazEakCAvZKkxACasZ-5XOxIljg506k8Lw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlvCqbPnmC08JNlymhCkeEdPgQKJXhiivrj_QZZo_Izg&oe=6AF5C0D0"}, {"file_name": "SC5.png", "id": "1341491893707436", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392170_1341491897040769_6777201904664257612_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pxfkkX5-tMQ7kNvwHx9xwX&_nc_oc=Adpue7TDOWy8JEvaksqVLSTDQZZJi0kv_eTcF5y487kj_OQlwrWYw6Y_gzCi9slo4cQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCsIo5G0SF0UzXdMov_XZFdZ6_5I7JLf5Aa4Ry1PWG0Q&oe=6AF5DD93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "3121929007960899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393594_3121929011294232_7769652209204608873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCMAQtwIJ0YQ7kNvwGa-aRx&_nc_oc=AdqN0-HFTVL6emuzWfDc3nBw1fn_YEoAjbicz-hOKx-LIq58FhzS4D_TmRFXzNXImo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3CGcbCTi8XUAG3LGRILXsGGa3BvddvNjxIaO8N0IC6w&oe=6AF5DD7A"}, "display_name": "CueScope", "keywords": ["pool", "billiards", "sports", "MR", "XR"], "long_description": "Bring your Quest to the real pool tables and experience the power of our cutting-edge mixed reality technology. CueScope is designed to revolutionize the way you play pool by offering real-time visualization of every shot\u2019s trajectory. Designed for real pool tables, CueScope enhances your game without altering the authentic experience of live play. Not a VR experience :).\n\nOur advanced mixed reality technology displays the path of the cue ball and target ball as you play. This direct visual feedback empowers you to adjust your aim on the fly and improve your technique without the need for extra insights or drills. Whether you're executing a straightforward shot or tackling complex plays, CueScope delivers the visual aid you need to elevate your game.\n\nJoin our **Discord** (https://discord.gg/ZHahyK5y) to chat directly with our team or send us an email at info@etheri.io.\nPlease see our **User Guide** (https://tinyurl.com/mw6n74fw) and **Video Tutorial** (https://youtu.be/cF_y5CM3hSc).\n\nYou can also use the **In-App Tutorial** to explore CueScope\u2019s features.\n{1018938156281348}", "short_description": "Bring your Quest to a real pool table and experience the power of our advanced mixed reality technology. CueScope transforms your pool game by delivering real-time shot trajectory visualization. Instantly view the path of the cue ball and your target ball before you take the shot to fine-tune your aim and boost your accuracy. Designed for use on real pool tables, CueScope enhances your game without altering the authentic experience of live play. Not a VR experience :)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.etheri.io/pr
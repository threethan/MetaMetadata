JPpXdGB8a_TF_tInnTsmnIsUA&oe=6A317049"}, {"file_name": "BrokenEdge_Screenshot_4.png", "id": "472821054826532", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_472821058159865_186434004068255211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUER0jLK5oUQ7kNvwH-sPLs&_nc_oc=AdqjMqmkEtS60CK1KcuF_mAICJZPY6Bu_KIsT2cygANTlXNnR1wcZ9YGJ6aZjfxJ3C8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uzb2q8ZdYwXOAPrbNNKG_-nXaOJ5dnduDrkQPAHajkw&oe=6A31636E"}, {"file_name": "BrokenEdge_Screenshot_5.png", "id": "594975389091795", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569427_594975395758461_1572189044025395185_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeNKASI4Fh8Q7kNvwE_H8XO&_nc_oc=Adr70WdkjlyCxQksB0O4CzQ6bRxMg68-QZbjiz1cW50cBTK4SGAIeBDLHtHaEoMz80c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ExX1qJKnpRkKpJbwA5VvVImMERlDuu5bJTAqhWriHPw&oe=6A315223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrokenEdge_ClassesTrailer_Thumbnail_2560x1440.png", "id": "798902981419361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974474_798902984752694_1266304442895536874_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YW3GLa-LvDQQ7kNvwFrMw6n&_nc_oc=AdqNNopHhwoybMDsxpnHCFZgYP7oc69g0ZES1HRIiONXNxRuO9N0dbg6kmUV3rlu3EE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ugwcNa-ZF5K1QgCq8CFhjG5ORdiKWGlUDtLa_d1o4zw&oe=6A315328"}, "display_name": "Broken Edge", "keywords": ["swordplay", "swordfighting", "pvp", "sword", "duel"], "long_description": "Broken Edge is a 1v1 VR fantasy sword dueling game where you embody historical swordfighters. Use their unique techniques and powers combined with cutting-edge fencing mechanics to claim victory against online components and climb the ranks!\n\nEMBODY YOUR FIGHTER\nAll characters are equipped with unique weapons, coupled with their own distinctive martial arts style. Learn to master these ancient fighting patterns to awaken the energy of your blade and dominate your foes online.\n\nCUTTING-EDGE FENCING MECHANICS\nMove and swing your sword freely as you would in real life, then apply tactical skills to block incoming blows and break your opponents' weapon at the point of impact!\n\nANYBODY CAN PICK A SWORD\nWhether you\u2019re a swashbuckling duellist or a feeble grunt, Broken Edge caters to players from all skill levels. Hone your skills in the dojo and take part in the global contest to climb the ranks online!", "short_description": "Broken Edge is a 1v1 VR fantasy sword dueling game where you embody historical swordfighters. Use their unique techniques and powers combined with cutting-edge fencing mechanics to claim victory against online components and climb the ranks!"}]}, "developer_name": "Trebuchet", "developer_privacy_policy_url": "https://fasttravelgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://trebuchet.fun/broken-edge", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "748581859903152"}}]}, "scheduled_offers": {"count": 35, "nodes": [{"status": "PUBLISHED", "id": "959090970252337"}, {"status": "PUBLISHED", "id": "1623694568632091"}, {"status": "PUBLISHED", "id": "847452898161024"}, {"statu
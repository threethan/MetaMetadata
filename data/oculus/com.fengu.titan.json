-1.oculuscdn.com/v/t64.5771-25/499619159_679339348584400_1694676521020706544_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gJ4567XWzIQ7kNvwHYUM6s&_nc_oc=AdmGVn5oHkXoIc_t79-KGtYi9hFmdaraqZONxb8I1rQbVgbnp46yXcoozqAP_hXfkCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvGBAJFnt2lX8n-jeh-GWVHfxQlrdiDXb0dLeJW4o8MNQ&oe=69A81C08"}, "display_name": "I Am Spider-Man", "keywords": ["Tag", "Titan", "Parkour", "Racing", "Flying"], "long_description": "You can fight with titans as a Spider-Man\uff0cwith a pull of the trigger you'll shoot a physics-based web that you can swing around on.\n\nYou can also play as the titan to tag and kill Spider-Mans.\n\nIt's a very interesting multiplayer game. You can swing between the skyscrapers, race through the streets and swing around the worlds with your friends.  \n\nThis game is free.", "short_description": "Fight with titans by the spider web, or play as the titan to kill Spider-Mans."}]}, "developer_name": null, "developer_privacy_policy_url": "http://web.manyatang.com/i_am_spider-man/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fengu Studio", "support_website_url": null, "website_url": "http://web.manyatang.com/i_am_spider-man", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "32318238151156446"}, "review_messages": []
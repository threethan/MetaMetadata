&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx32MdwOnZiJf8nq1T-zv1vd6QBnaB9dqpOi3UWq1imA&oe=6A8C4410"}, {"file_name": "5.png", "id": "1567819227380119", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031429_1567819230713452_8234714333689428806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPL66g_gcZsQ7kNvwHLB85k&_nc_oc=AdrItEG_5Sp7pjS6VwRiq4t7W-16HRRTYqXazbcOm9ycR-sqOpY9EJOT8SZDA_kajLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1LpHcBKLLD_KoGHnzxkx8UZXaxS4bzomjm4iq4lVKyw&oe=6A8C1E27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16 na 9.png", "id": "3478090745838826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031528_3478090749172159_4375734471841919264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7QSAnWsQ3UQ7kNvwEzjn5g&_nc_oc=Adr--S8sttPUzQdnoQ76AKdDkZ576oz2__P3g7B5xgOGr-Fv_eozMAvyn4eWdfebCPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGipnIJf1Nh5NmjSystoN67fCjXLXD9u7q9Z3a_UUOxLw&oe=6A8C1B6E"}, "display_name": "Puzzle", "keywords": [], "long_description": "Immerse yourself in Puzzle Match, a unique VR twist on the classic block-matching game. Wield a wand to crush colorful blocks, navigating through increasingly complex puzzles. Perfect for all ages, 'Puzzle Match' enhances the familiar gameplay with intuitive controls and interactive elements. The game's vibrant graphics and soothing soundtrack create a relaxing atmosphere, making it ideal for both fun and cognitive stimulation. Experience the blend of nostalgia and innovation in this engaging VR puzzle journey. The game is still in it's early acces. We will appreciate feedback - and rates :) You can make the game grow!", "short_description": "Embark with us on a journey in Puzzle Match VR! A classic match blocks type game, for the first time in VR. Use your magical wands to crush colorful blocks in a cartoon-styled VR world. Relaxing and intuitive, perfect for all ages, offering 
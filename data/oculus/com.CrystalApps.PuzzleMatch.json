}, {"file_name": "5.png", "id": "1567819227380119", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031429_1567819230713452_8234714333689428806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hykPLLnFlfMQ7kNvwGVemCt&_nc_oc=AdoeWx-6-qqFKGNQ8IsMxmDP5ZOlA5knZnnkKiHBuuaP-bjVUqvmybVLfWOnBWsQtEo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPOhFxPiu6Ue3jObmC4olf0V88ofgi35NJi00uOauWsg&oe=6A71F867"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16 na 9.png", "id": "3478090745838826", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031528_3478090749172159_4375734471841919264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rb6AmE9SqIQ7kNvwHC5cnM&_nc_oc=AdozVG1vxEmqzLZgiP0Bweun2GM8u3uZO7lT2PCla1KmjrDUWHwyD7-BTpBrFU3DNuE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYd5DElElicwEk2TrSDuKDY9F_jrjFpJbapVfhuZxEqQ&oe=6A71F5AE"}, "display_name": "Puzzle", "keywords": [], "long_description": "Immerse yourself in Puzzle Match, a unique VR twist on the classic block-matching game. Wield a wand to crush colorful blocks, navigating through increasingly complex puzzles. Perfect for all ages, 'Puzzle Match' enhances the familiar gameplay with intuitive controls and interactive elements. The game's vibrant graphics and soothing soundtrack create a relaxing atmosphere, making it ideal for both fun and cognitive stimulation. Experience the blend of nostalgia and innovation in this engaging VR puzzle journey. The game is still in it's early acces. We will appreciate feedback - and rates :) You can make the game grow!", "short_description": "Embark with us on a journey in Puzzle Match VR! A classic match blocks type game, for the first time in VR. Use your magical wands to crush colorful blocks in a cartoon-styled VR world. Relaxing and intuitive, perfect for all ages, offering a blend of tranquil visuals, engaging puzzles, and a soothing soundtrack."}]}, "developer_name": null, "developer_privacy_pol
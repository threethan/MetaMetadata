}, {"file_name": "5.png", "id": "1567819227380119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031429_1567819230713452_8234714333689428806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hykPLLnFlfMQ7kNvwH9f_Ww&_nc_oc=AdrpgQRJaFOH8t7C41ZE5I8VcfL45G1i-7mbERzJMyfesS4nr4MpHdiH4ldg1sPspZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOVQ48oFvWv5d5BXEWw_DaYBD58Z2T8OGbbqQZDs5J_w&oe=6A749B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16 na 9.png", "id": "3478090745838826", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031528_3478090749172159_4375734471841919264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrU_LPss5hUQ7kNvwF5WisD&_nc_oc=AdpBYTUg5AoAxevt1DL-JNwLw0jX4JjMduptEu8anhQCC2DGdVGLZg--h63wgCY8kcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXqOa78d1cp7_r8p1BPb1dyN46u5sBsFc-qZefzzl6OA&oe=6A7498AE"}, "display_name": "Puzzle", "keywords": [], "long_description": "Immerse yourself in Puzzle Match, a unique VR twist on the classic block-matching game. Wield a wand to crush colorful blocks, navigating through increasingly complex puzzles. Perfect for all ages, 'Puzzle Match' enhances the familiar gameplay with intuitive controls and interactive elements. The game's vibrant graphics and soothing soundtrack create a relaxing atmosphere, making it ideal for both fun and cognitive stimulation. Experience the blend of nostalgia and innovation in this engaging VR puzzle journey. The game is still in it's early acces. We will appreciate feedback - and rates :) You can make the game grow!", "short_description": "Embark with us on a journey in Puzzle Match VR! A classic match blocks type game, for the first time in VR. Use your magical wands to crush colorful blocks in a cartoon-styled VR world. Relaxing and intuitive, perfect for all ages, offering a blend of tranquil visuals, engaging puzzles, and a soothing soundtrack."}]}, "developer_name": null, "developer_privacy_pol
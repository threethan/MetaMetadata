&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt2OTkUM4n3KdhKkANUZ1QgbVAdGOVAyA3Dv-vCtFkXA&oe=6AB7C590"}, {"file_name": "5.png", "id": "1567819227380119", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031429_1567819230713452_8234714333689428806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oLqXiT0YaUQ7kNvwEt_f0v&_nc_oc=Adp2Hw7wMkXKZ3_s__FeMXesw_-zJW19PqgMnxmIEOEDjvuBQbMKzMB2Q4ZeFbyd2AE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH5cMMRGc_1D8eJbSwA-INvs3mb5Few8NXwqarVt9Rtw&oe=6AB7D7E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16 na 9.png", "id": "3478090745838826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031528_3478090749172159_4375734471841919264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmxd8kbJW44Q7kNvwGESDHg&_nc_oc=Adomemn2Op4SRLwb7ykkTE92kMYGdv6HGMnlaJkV7BrSnvM6qqmX8sAN_WpxWZcYk0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc5QZl931wMSmsreDGOlf0K7mOEm-0GFkuo8qaeldoqg&oe=6AB7D52E"}, "display_name": "Puzzle", "keywords": [], "long_description": "Immerse yourself in Puzzle Match, a unique VR twist on the classic block-matching game. Wield a wand to crush colorful blocks, navigating through increasingly complex puzzles. Perfect for all ages, 'Puzzle Match' enhances the familiar gameplay with intuitive controls and interactive elements. The game's vibrant graphics and soothing soundtrack create a relaxing atmosphere, making it ideal for both fun and cognitive stimulation. Experience the blend of nostalgia and innovation in this engaging VR puzzle journey. The game is still in it's early acces. We will appreciate feedback - and rates :) You can make the game grow!", "short_description": "Embark with us on a journey in Puzzle Match VR! A classic match blocks type game, for the first time in VR. Use your magical wands to crush colorful blocks in a cartoon-styled VR world. Relaxing and intuitive, perfect for all ages, offering 
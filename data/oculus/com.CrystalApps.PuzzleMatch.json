&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaXb5IhtY3o5nTM58RVj22GGZ1o2an_sRgiILjXSFuuw&oe=6AC4F490"}, {"file_name": "5.png", "id": "1567819227380119", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031429_1567819230713452_8234714333689428806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lf0n8N-rEoQ7kNvwFOty9f&_nc_oc=AdrxPxQt_NGcWSKS3mMdwdqJC5BbNJr8cgYb9qfBUfPbJNGZS9WlzH79N4t543u8t-g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFl3NY_rGr6HS9YrkV0zV_Z7ar7SsXrfkbKaZi_dwutA&oe=6AC506E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16 na 9.png", "id": "3478090745838826", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031528_3478090749172159_4375734471841919264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQLdw1dEAkUQ7kNvwFbIWFD&_nc_oc=Ado7pwpBlEMkFinD5gOW02EuKH9wU2VjGAVH0UwphZMIozsrjAwxIXLBSYecuRlfWWU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy6lWmpNDnBqkf9aqf1Yy-gbFfdfmkezyDDZqcnDAakA&oe=6AC5042E"}, "display_name": "Puzzle", "keywords": [], "long_description": "Immerse yourself in Puzzle Match, a unique VR twist on the classic block-matching game. Wield a wand to crush colorful blocks, navigating through increasingly complex puzzles. Perfect for all ages, 'Puzzle Match' enhances the familiar gameplay with intuitive controls and interactive elements. The game's vibrant graphics and soothing soundtrack create a relaxing atmosphere, making it ideal for both fun and cognitive stimulation. Experience the blend of nostalgia and innovation in this engaging VR puzzle journey. The game is still in it's early acces. We will appreciate feedback - and rates :) You can make the game grow!", "short_description": "Embark with us on a journey in Puzzle Match VR! A classic match blocks type game, for the first time in VR. Use your magical wands to crush colorful blocks in a cartoon-styled VR world. Relaxing and intuitive, perfect for all ages, offering 
wKbzih0ggg6acAg-G_BduSoRXncI2aPUdb1g&oe=69A58907"}, {"file_name": "4.png", "id": "1454602528471433", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031557_1454602531804766_8554378216165837932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqFK5natwdIQ7kNvwGIOfUU&_nc_oc=AdmFzKzsxewQ5za6Pa70Jeh6Qy1pRyG-4NYBwVqpNNP4J71e-8i7jgnUzpNoS-1REGo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvSReOvez1dOdg8jjNygvwOt1auffAYdtyFku2oVBfUBQ&oe=69A58D90"}, {"file_name": "5.png", "id": "1567819227380119", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031429_1567819230713452_8234714333689428806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I67hubXIcKwQ7kNvwHODGXK&_nc_oc=AdmVCNlgHthPypwOajvQkRaOLwmtMWofNiOoW3V7JrJNft2lrvx40HdRbbaQE43lW88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afuto9N5UVQ9Dv_yC2XQOTjVO8VjZGoWZaL8mDlQABQ1WA&oe=69A59FE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16 na 9.png", "id": "3478090745838826", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031528_3478090749172159_4375734471841919264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGY2cwXq-ZAQ7kNvwHYfQkb&_nc_oc=Adm08wesnksa2KKz6_7F5hQebb7meUx-TJ3gOGUGTC8CKit4G5uoiMkztysYxAmSuHA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvmc09D4KG-R08cmtDWzyr9PnzSbVTeGW3Z4nOZt2QKVg&oe=69A59D2E"}, "display_name": "Puzzle", "keywords": [], "long_description": "Immerse yourself in Puzzle Match, a unique VR twist on the classic block-matching game. Wield a wand to crush colorful blocks, navigating through increasingly complex puzzles. Perfect for all ages, 'Puzzle Match' enhances the familiar gameplay with intuitive controls and interactive elements. The game's vibrant graphics and soothing soundtrack create a relaxing atmosphere, making it ideal for both fun and cognitive stimulation. Experience the blend of nostalgia and innovation in this engaging VR puzzle journey. The game is still in it's early acces. We will appreciate feedback - and rates :) You can make the game grow!", "short_description": "Embark with us on a journey in Puzzle Match VR! A classic match blocks type game, for the first time in VR. Use your magical wands to crush colorful blocks in a cartoon-styled VR world. Relaxing and intuitive, perfect for all ages, offering a blend of tranquil visuals, engaging puzzles, and a soothing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/puzzlematch-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6938008006313832"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24785971311090894", "version": "1.2.2"}, "id": "720051300045488", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6938007996313833", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24785971
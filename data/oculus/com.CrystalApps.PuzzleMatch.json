.png", "id": "1454602528471433", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031557_1454602531804766_8554378216165837932_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrscmEFLUi4Q7kNvwGkc2VJ&_nc_oc=Adpe1MyRC4aAZB7aWiuaihshMzIfJ-zMIuJa0aneIa_S_7WxXmAqf_P-8aWRVVxTgo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtHtiDie4Tix0zssbDAgF1lgqJLuPHPMRynNuDnFTl3g&oe=6B0DAF50"}, {"file_name": "5.png", "id": "1567819227380119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_1567819230713452_8234714333689428806_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fReBsT8T_psQ7kNvwEI172K&_nc_oc=AdoXd12433STRv6lS28Gxm8_3Gd9IZ8Oyc6FqWiDVmjnbGsmfGp-aRCibt2ufP5KfHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdMeZSsbMM6vXv1dETARwgxSRRWFkpjokTznudoPRF6A&oe=6B0DC1A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16 na 9.png", "id": "3478090745838826", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031528_3478090749172159_4375734471841919264_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GCJksPJ_-0Q7kNvwEZ0jE5&_nc_oc=AdqCO2yChjbQgT6sMG1lHhPXCCdNMlapYHLexC-Qv5qhD-ELDCdL3-VJybpbCyhg75k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7BS1selWRgUKIFDn0QM7hT4_AzC1ajm_AWCynV8UA_w&oe=6B0DBEEE"}, "display_name": "Puzzle", "keywords": [], "long_description": "Immerse yourself in Puzzle Match, a unique VR twist on the classic block-matching game. Wield a wand to crush colorful blocks, navigating through increasingly complex puzzles. Perfect for all ages, 'Puzzle Match' enhances the familiar gameplay with intuitive controls and interactive elements. The game's vibrant graphics and soothing soundtrack create a relaxing atmosphere, making it ideal for both fun and cognitive stimulation. Experience the blend of nostalgia and innovation in this engaging VR puzzle journey. The game is still in it's early acces. We will appreciate feedback - and rates :) You can make the game grow!", "short_description": "Embark with us on a journey in Puzzle Match VR! A classic match blocks type game, for the first time in VR. Use your magical wands to crush colorful blocks in a cartoon-styled VR world. Relaxing and intuitive, perfect for all ages, offering a blend of tranquil visuals, engaging puzzles, and a soothing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/puzzlematch-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6938008006313832"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1454886859194352"}, {"status": "CANCELLED", "id": "625005984003957"}, {"status": "PUBLISHED", "id": "1056104863202118"}, {"status": "PUBLISHED", "id": "1923919144839526"}, {"status": "PUBLISHED", "id": "1455153149095139"}, {"status": "CANCELLED", "id": "984612923812726"}, {"status": "CANCELLED", "id": "645452245287652"}, {"status": "CANCELLED", "id": "1764852674149028"}, {"status": "CANCELLED", "id": "577175285420808"}, {"status": "PUBLISHED", "id": "813581694656775"}, {"status": "PUBLISHED", "id": "1959834277838636"},
=AdqqQRCzoIKLe9pGDJaUx7vshiXEVAO178k_kAd5oLI6bdgoYSTNbgU5UslylDD89-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvT-yR2U6TluYadMq-aCy09FiMkjs1XFqex1pUROLX1g&oe=6A50EC07"}, {"file_name": "4.png", "id": "1454602528471433", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031557_1454602531804766_8554378216165837932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W62bvfhUnXgQ7kNvwGWxgqw&_nc_oc=AdroTtNeOyhqlNJfC8-mySPYyLEQlRLnrdrZFJIl7bS1pnz0sCLt4IYl32kKWjDxMSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHXVATH133jJvlf7oAY_mZqwNJ70wUAD-eswmL3omYbA&oe=6A50F090"}, {"file_name": "5.png", "id": "1567819227380119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_1567819230713452_8234714333689428806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA4xHazf4xUQ7kNvwGDVMTx&_nc_oc=AdpCSwmw-9Kea6Fj63fbtHHhPxwlskXz98Zd5DVs9kTdDuHZPp9ntHCggXWBFmCVJ9s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFhdvoDqJeAMBxbb8Pj9m1BQSJF3RTuEr1GEbstSdq8w&oe=6A5102E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16 na 9.png", "id": "3478090745838826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031528_3478090749172159_4375734471841919264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c622Kve_W_oQ7kNvwEtazFL&_nc_oc=Adpg9T7m0cPgamE2RlxyXWfMVRHNQl9DKQ978I37lRknss4KkqdhbwCzfHvc5mhKQ08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY9HZJllwgTF42ZizcWKeQZc_rwKhYVwBwl2XupJFlJg&oe=6A51002E"}, "display_name": "Puzzle", "keywords": [], "long_description": "Immerse yourself in Puzzle Match, a unique VR twist on the classic block-matching game. Wield a wand to crush colorful blocks, navigating through increasingly complex puzzles. Perfect for all ages, 'Puzzle Match' enhances the familiar gameplay with intuitive controls and interactive elements. The game's vibrant graphics and soothing soundtrack create a relaxing atmosphere, making it ideal for both fun and cognitive stimulation. Experience the blend of nostalgia and innovation in this engaging VR puzzle journey. The game is still in it's early acces. We will appreciate feedback - and rates :) You can make the game grow!", "short_description": "Embark with us on a journey in Puzzle Match VR! A classic match blocks type game, for the first time in VR. Use your magical wands to crush colorful blocks in a cartoon-styled VR world. Relaxing and intuitive, perfect for all ages, offering a blend of tranquil visuals, engaging puzzles, and a soothing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/puzzlematch-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6938008006313832"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1454886859194352"}, {"status": "CANCELLED", "id": "625005984003957"}, {"status": "PUBLISHED", "id": "1056104863202118"}, {"status": "PUBLISHED", "id": "1923919144839526"}, {"status": "PUBLISHED", "id": "1455153149095139"}, {"status": "CANCELLED", "id": "984612923812726"}, {"status": "CANCELLED", "id": "645452245287652"}, {"status": "CANCELLED", "id": "1764852674149028"}, {"status": "CANC
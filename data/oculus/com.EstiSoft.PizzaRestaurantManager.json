t-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztFZ3EsskNjpKnu5TxGJLAM0fGFWqYtsM28BTCMQlPgw&oe=69CBD994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-02-01 021253.png", "id": "1138591437611820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391794_1138591440945153_997929588855895673_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egX3wXOsK1kQ7kNvwGlhaQF&_nc_oc=AdqvkTAN2JkToxquFiVlB5ecUf4O565ly5Zg6I2amQq2olGooaUT7KsuxoxGfwM7sJo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyceZgVJcFT-lJ61njLVoBEZZ3yrSqQJC1uOtE0KSg2sw&oe=69CBA7FD"}, "display_name": "Pizza Restaurant Manager", "keywords": ["PizzaTycoon", "IdleRestaurantGame", "ArcadeManagment", "VrCookingSimulator", "FastPacedStrategy"], "long_description": "Welcome to Pizza Restaurant Manager, the ultimate arcade idle game where you take control of a growing pizzeria! Start with a small pizza shop, craft delicious recipes, and satisfy hungry customers. Manage ingredients, hire staff, and upgrade equipment to boost efficiency. Experiment with new toppings, handle customer demands, and expand your business into a pizza empire.\n\nWith engaging idle mechanics, your pizzeria keeps running even when you're offline, ensuring steady growth. Strategically invest in automation, optimize profits, and unlock new locations. Will you become the greatest pizza tycoon?\n\nGet ready to master time management, customer service, and business strategy\u2014all wrapped up in a fun, fast-paced, and satisfying pizza restaurant experience! Whether you play casually or aim for the top, Pizza Restaurant Manager offers an addicting gameplay loop that keeps you coming back for more. Fire up the ovens and start your journey today!", "short_description": "Step into the world of Pizza Restaurant Manager, an immersive arcade idle game where you build and manage your dream pizzeria! Serve delicious pizzas, upgrade your kitchen, and attract customers to grow your business. Balance speed and strategy to optimize your restaurant\u2019s success. Can you turn your small shop into a pizza empire? Jump into the fast-paced, rewarding gameplay and become the ultimate pizza tycoon!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1676485315806614"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9066123346817742"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "854088114107299"}, {"status": "PUBLISHED", "id": "2112116889599090"}, {"status": "PUBLISHED", "id": "980204370655445"}, {"status": "PUBLISHED", "id": "2088694544977405"}, {"status": "PUBLISHED", "id": "1034040178579917"}, {"status": "PUBLISHED", "id": "1220151783012707"}]}, "baseline_offer": {"id": "1034040178579917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771358400, "status": "PUBLISHED", "id": "854088114107299"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9066126230150787", "version": "1"}, "id": "623363763573615", "ch
ab.png", "id": "1379144796840103", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392185_1379144803506769_2851858373046254738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLUuifaYlIwQ7kNvwFyK7kA&_nc_oc=AdqKaNTgLCHCs_jVk0gSBdHPZ8DBUv3-Ugr-Zo3lQqqmKZi9pXy-fpV28IkTU91fcPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaZ1cFU0UCi8LQwM0utiBxwYFxHWc3Bba-8cUyXPxRhQ&oe=69CA85B5"}, {"file_name": "9287f2463de2441e877a5041af51cf8c.png", "id": "1894764741058476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391950_1894764744391809_5376999951759374827_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXLnx1epsrAQ7kNvwH-j2-H&_nc_oc=Adpe9DROf4G-sgDTFvOHi7Wgpee-JDC9R0kye_YDV4g6STcI7LRUvhVGJxszxd0hQ60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJ3ughhJWg6m7jmTYSDB7AKkl_KJv36-65mWSPX7DcAA&oe=69CA68F5"}, {"file_name": "c14c71860660431aaa45e205fa8c5de3.png", "id": "1796938177827227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391887_1796938181160560_6220155905700192152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0OQBqrrENUQ7kNvwH2-Ww2&_nc_oc=AdooaXVj4P12XQ-RLGrjUEH7vZYRIhbYsB_M5af4-D558yF6MvjkpiJ6fec-hA4xB8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywvGf-hXqXeLBS5ggCcGnb7-xjWMVOcL9e_xGf1I-lsg&oe=69CA6104"}, {"file_name": "bfccbc9c85b345d6b1a55ead0d07cec1.png", "id": "2017057025371949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394097_2017057028705282_6402721085908582554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14Vz7k9c1_IQ7kNvwEPCSwh&_nc_oc=AdqvOWbiupcE_wFOsub6VE7GHzqR9QQkEvHPKvvZ3iRY28Bwg_skrcVtOJTK8NH1ebk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTCDypMDc_pT90pQ7dXk3d1wR9fdV-YUel3egJdXZstQ&oe=69CA8C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Geomelix_25601440.png", "id": "1626064218030972", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391991_1626064221364305_6135782017135042323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tk8O83tRHgQ7kNvwF3jA_q&_nc_oc=AdptmvyWfe2UkDVIjulTZcIpisAf_UgdInZMKKKiwLPVHKKEtLX-c-OklCinAwH6vc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzq6QPYeZahMItP0vLX6Jk_3BqEseP6g5FBxYgxz1mcnA&oe=69CA7D62"}, "display_name": "GEOMELIX", "keywords": ["Geomelix", "\u30d1\u30ba\u30eb", "PuzzleGame", "BrainTraining", "CasualGame"], "long_description": "Game Modes\n\nSurvival Mode: Test your speed and accuracy by eliminating as many numbers as possible within a time limit. Clearing one polyhedron seamlessly transitions you to the next, keeping the action continuous. Quick successive taps grant bonus time, adding a strategic layer to the gameplay.\u200b\nNormal Mode: Choose your preferred polyhedron and aim for the fastest completion time. Each shape tracks your best records, encouraging replayability and mastery.\u200b\nFeatures\n\nDiverse Stages: From regular to semi-regular polyhedrons, Geomelix offers a plethora of stages to challenge and entertain.\u200b\nImmersive Environments: Switch between Pass-Through Mode and Virtual Mode. In Virtual Mode, enjoy the serene backdrop of a picturesque lakeside as you play.\u200b\nGlobal Leaderboards: Compete with players worldwide. Each mode features its own leaderboard, allowing you to showcase your skills on a global stage.\u200b", "short_description": "GEOMELIX : A Mesmerizing Numerical Action Game\n\nDive into the captivating world of Geomelix, where your goal is to tap numbers in ascending order on floating polyhedrons. Rotate these 3D shapes to find and tap the numbers sequentially, offering a fresh and addictive gaming experience. As the number of faces increases, so does the challenge. Can you conquer all the polyhedrons and set new personal bests?\u200b"}, {"images": {"nodes": [{"file_name": "Geomelix_logo.png", "id": "1192744695805214", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391950_1192744699138547_7845033931972505366_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWoYwaBQI1MQ7kNvwGE2jDF&_nc_oc=AdphWpQrIS8-eVfW7PJnjT9iJ7ATMkGP-gwNksvffiH14aQhxOG7SKaW23pO1T2kFR8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_ZXgTp1RNw9OC3W5HnkAJzGrPkQokAqY5s41uQrvD8Q&oe=69CA5992"}]}, "id": "1194751032447737", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30b8\u30aa\u30e1\u30ea\u30af\u30b9", "keywords": [], "long_description": "\u300eGEOMELIX\uff08\u30b8\u30aa\u30e1\u30ea\u30af\u30b9\uff09\u300f\u306f\u3001\u6570\u5b57\u3092\u30ab\u30a6\u30f3\u30c8\u3059\u308b\u6570\u5b57\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u7a7a\u9593\u306b\u6d6e\u304b\u3076\u591a\u9762\u4f53\u306b\u306f\u6570\u5b57\u304c\u914d\u7f6e\u3055\u308c\u3066\u304a\u308a\u3001\u591a\u9762\u4f53\u3092\u56de\u8ee2\u3055\u305b\u306a\u304c\u30891\u304b\u3089\u9806\u756a\u306b\u6570\u5b57\u3092\u30bf\u30c3\u30d7\u3057\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002\n\u591a\u9762\u4f53\u3092\u56de\u3057\u3066\u6570\u5b57\u3092\u30bf\u30c3\u30d7\uff01\u305f\u3060\u305d\u308c\u3060\u3051\u306a\u306e\u306b\u5922\u4e2d\u306b\u306a\u308b\u65b0\u611f\u899a\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u9762\u6570\u304c\u591a\u304f\u306a\u308b\u307b\u3069\u96e3\u6613\u5ea6\u3082\u4e0a\u304c\u308a\u307e\u3059\u3002\u5168\u3066\u306e\u591a\u9762\u4f53\u3092\u30af\u30ea\u30a2\u3057\u81ea\u5df1\u30d9\u30b9\u30c8\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\uff01\n\n\u3010\u30b2\u30fc\u30e0\u306e\u30eb\u30fc\u30eb\u3011\n\u672c\u4f5c\u306b\u306f2\u3064\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u5b58\u5728\u3057\u307e\u3059\u3002\n\u25a0\u30b5\u30d0\u30a4\u30d0\u30eb\u30e2\u30fc\u30c9\n- \u5236\u9650\u6642\u9593\u5185\u306b\u3069\u308c\u3060\u3051\u6570\u5b57\u3092\u6d88\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3092\u7af6\u3046\u30e2\u30fc\u30c9\u3067\u3059\n- 1\u3064\u306e\u591a\u9762\u4f53\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u7d9a\u3051\u3066\u6b21\u306e\u591a\u9762\u4f53\u306b\u5207\u308a\u66ff\u308f\u308a\u30b2\u30fc\u30e0\u304c\u7d9a\u884c\u3057\u307e\u3059\n- \u6570\u5b57\u3092\u6d88\u3059\u3068\u591a\u9762\u4f53\u306e\u5468\u308a\u306b\u4e00\u5b9a\u6642\u9593\u30ea\u30f3\u30b0\u304c\u8868\u793a\u3055\u308c\u3001\u30ea\u30f3\u30b0\u304c\u6d88\u3048\u308b\u524d\u306b\u6b21\u306e\u6570\u5b57\u3092\u6d88\u305b\u308b\u3068\u6b8b\u308a\u6642\u9593\u304c\u8ffd\u52a0\u3055\u308c\u307e\u3059\n\u25a0\u30ce\u30fc\u30de\u30eb\u30e2\u30fc\u30c9\n- \u597d\u304d\u306a\u591a\u9762\u4f53\u3092\u9078\u629e\u3057\u3001\u3069\u308c\u3060\u3051\u65e9\u304f\u6570\u5b57\u3092\u6d88\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3092\u7af6\u3046\u30e2\u30fc\u30c9\u3067\u3059\n- \u5404\u591a\u9762\u4f53\u6bce\u306b\u30af\u30ea\u30a2\u30bf\u30a4\u30e0\u304c\u8a18\u9332\u3055\u308c\u307e\u3059\n\n\u3010\u672c\u4f5c\u306e\u66f4\u306a\u308b\u9b45\u529b\u3011\n- \u6b63\u591a\u9762\u4f53\u306b\u52a0\u3048\u3066\u534a\u6b63\u591a\u9762\u4f53\u306a\u3069\u591a\u6570\u306e\u30b9\u30c6\u30fc\u30b8\u3092\u53ce\u9332\uff01\u5168\u3066\u306e\u30b9\u30c6\u30fc\u30b8\u3092\u653b\u7565\u3057\u307e\u3057\u3087\u3046\n- \u30d1\u30b9\u30b9\u30eb\u30fc\u30e2\u30fc\u30c9\u3068\u30d0\u30fc\u30c1\u30e3\u30eb\u30e2\u30fc\u30c9\u306e\u5207\u308a\u66ff\u3048\u304c\u53ef\u80fd\uff01\u30d0\u30fc\u30c1\u30e3\u30eb\u30e2\u30fc\u30c9\u3067\u306f\u7f8e\u9e97\u306a\u6e56\u7554\u3092\u821e\u53f0\u306b\u30b2\u30fc\u30e0\u3092\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\n- \u30e9\u30f3\u30ad\u30f3\u30b0\u6a5f\u80fd\u642d\u8f09\uff01\u305d\u308c\u305e\u308c\u306e\u30e2\u30fc\u30c9\u3067\u4e16\u754c\u4e2d\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30af\u30ea\u30a2\u30bf\u30a4\u30e0\u3092\u7af6\u3044\u307e\u3057\u3087\u3046\uff01", "short_description": "\u300eGEOMELIX\uff08\u30b8\u30aa\u30e1\u30ea\u30af\u30b9\uff09\u300f\u306f\u3001\u6570\u5b57
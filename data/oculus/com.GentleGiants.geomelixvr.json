45e205fa8c5de3.png", "id": "1796938177827227", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391887_1796938181160560_6220155905700192152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWEsn4XlAeoQ7kNvwFUMtKZ&_nc_oc=Adq33wXB4ad0oCgyHBqYulnX8Q3OnFNWuSilP76WMZD77tOb5Tp6oo39OBlEiC47qvo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_J_9eL87uwjFhq2Yl7BjO9tLh7CCgIXlL-fkCfX6rTg&oe=69E21C04"}, {"file_name": "bfccbc9c85b345d6b1a55ead0d07cec1.png", "id": "2017057025371949", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473394097_2017057028705282_6402721085908582554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E71BWFIUKhsQ7kNvwEWlGZF&_nc_oc=AdqFYKJuoSkcJcmFH-0wqWEDXPgu-TyWm3jIMgt-abQjEDpyIjq33XY3eaTldaCSDq4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h4RUBMCoNW2BGMANySU4NVXq67SEMR7n99DMfUkgmXQ&oe=69E2472D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Geomelix_25601440.png", "id": "1626064218030972", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391991_1626064221364305_6135782017135042323_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNZjBmXVhh4Q7kNvwHBGLIK&_nc_oc=AdrBjMlybEOCr0MYtr95_MaChbBEZM-vwLvjjXCZ_MG2d9dHab-GJ9aoizh-BIMrLUQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23Lu2OcKSqk-OnWQg3GB67rcyAOaqQ6TqhUoTb4o3aMw&oe=69E23862"}, "display_name": "GEOMELIX", "keywords": ["Geomelix", "\u30d1\u30ba\u30eb", "PuzzleGame", "BrainTraining", "CasualGame"], "long_description": "Game Modes\n\nSurvival Mode: Test your speed and accuracy by eliminating as many numbers as possible within a time limit. Clearing one polyhedron seamlessly transitions you to the next, keeping the action continuous. Quick successive taps grant bonus time, adding a strategic layer to the gameplay.\u200b\nNormal Mode: Choose your preferred polyhedron and aim for the fastest completion time. Each shape tracks your best records, encouraging replayability and mastery.\u200b\nFeatures\n\nDiverse Stages: From regular to semi-regular polyhedrons, Geomelix offers a plethora of stages to challenge and entertain.\u200b\nImmersive Environments: Switch between Pass-Through Mode and Virtual Mode. In Virtual Mode, enjoy the serene backdrop of a picturesque lakeside as you play.\u200b\nGlobal Leaderboards: Compete with players worldwide. Each mode features its own leaderboard, allowing you to showcase your skills on a global stage.\u200b", "short_description": "GEOMELIX : A Mesmerizing Numerical Action Game\n\nDive into the captivating world of Geomelix, where your goal is to tap numbers in ascending order on floating polyhedrons. Rotate these 3D shapes to find and tap the numbers sequentially, offering a fresh and addictive gaming experience. As the number of faces increases, so does the challenge. Can you conquer all the polyhedrons and set new personal bests?\u200b"}, {"images": {"nodes": [{"file_name": "Geomelix_logo.png", "id": "1192744695805214", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391950_1192744699138547_7845033931972505366_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InqOo78SwsAQ7kNvwHGyQSn&_nc_oc=Adoa3aktQ4DxwT3fAYY2nkr1nZgKR1tELtWOAE-QC1soMMvPXrWz_xrQuHZqKABB0vg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3elj_Y6AS1RoTV7ZrgJPNF9qtwKCUCSb2CC8uhyg4Hdg&oe=69E24CD2"}]}, "id": "1006898088067737", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30b8\u30aa\u30e1\u30ea\u30af\u30b9", "keywords": [], "long_description": "\u300eGEOMELIX\uff08\u30b8\u30aa\u30e1\u30ea\u30af\u30b9\uff09\u300f\u306f\u3001\u6570\u5b57\u3092\u30ab\u30a6\u30f3\u30c8\u3059\u308b\u6570\u5b57\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u7a7a\u9593\u306b\u6d6e\u304b\u3076\u591a\u9762\u4f53\u306b\u306f\u6570\u5b57\u304c\u914d\u7f6e\u3055\u308c\u3066\u304a\u308a\u3001\u591a\u9762\u4f53\u3092\u56de\u8ee2\u3055\u305b\u306a\u304c\u30891\u304b\u3089\u9806\u756a\u306b\u6570\u5b57\u3092\u30bf\u30c3\u30d7\u3057\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002\n\u591a\u9762\u4f53\u3092\u56de\u3057\u3066\u6570\u5b57\u3092\u30bf\u30c3\u30d7\uff01\u305f\u3060\u305d\u308c\u3060\u3051\u306a\u306e\u306b\u5922\u4e2d\u306b\u306a\u308b\u65b0\u611f\u899a\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u9762\u6570\u304c\u591a\u304f\u306a\u308b\u307b\u3069\u96e3\u6613\u5ea6\u3082\u4e0a\u304c\u308a\u307e\u3059\u3002\u5168\u3066\u306e\u591a\u9762\u4f53\u3092\u30af\u30ea\u30a2\u3057\u81ea\u5df1\u30d9\u30b9\u30c8\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\uff01\n\n\u3010\u30b2\u30fc\u30e0\u306e\u30eb\u30fc\u30eb\u3011\n\u672c\u4f5c\u306b\u306f2\u3064\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u5b58\u5728\u3057\u307e\u3059\u3002\n\u25a0\u30b5\u30d0\u30a4\u30d0\u30eb\u30e2\u30fc\u30c9\n- \u5236\u9650\u6642\u9593\u5185\u306b\u3069\u308c\u3060\u3051\u6570\u5b57\u3092\u6d88\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3092\u7af6\u3046\u30e2\u30fc\u30c9\u3067\u3059\n- 1\u3064\u306e\u591a\u9762\u4f53\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u7d9a\u3051\u3066\u6b21\u306e\u591a\u9762\u4f53\u306b\u5207\u308a\u66ff\u308f\u308a\u30b2\u30fc\u30e0\u304c\u7d9a\u884c\u3057\u307e\u3059\n- \u6570\u5b57\u3092\u6d88\u3059\u3068\u591a\u9762\u4f53\u306e\u5468\u308a\u306b\u4e00\u5b9a\u6642\u9593\u30ea\u30f3\u30b0\u304c\u8868\u793a\u3055\u308c\u3001\u30ea\u30f3\u30b0\u304c\u6d88\u3048\u308b\u524d\u306b\u6b21\u306e\u6570\u5b57\u3092\u6d88\u305b\u308b\u3068\u6b8b\u308a\u6642\u9593\u304c\u8ffd\u52a0\u3055\u308c\u307e\u3059\n\u25a0\u30ce\u30fc\u30de\u30eb\u30e2\u30fc\u30c9\n- \u597d\u304d\u306a\u591a\u9762\u4f53\u3092\u9078\u629e\u3057\u3001\u3069\u308c\u3060\u3051\u65e9\u304f\u6570\u5b57\u3092\u6d88\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3092\u7af6\u3046\u30e2\u30fc\u30c9\u3067\u3059\n- \u5404\u591a\u9762\u4f53\u6bce\u306b\u30af\u30ea\u30a2\u30b
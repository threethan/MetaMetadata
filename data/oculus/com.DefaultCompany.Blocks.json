le_name": "screenshot5.png", "id": "189180370856841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035411_189180374190174_2041119517261467595_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUsECRx3uJoQ7kNvwE7ZedO&_nc_oc=AdqkBLJsHQs5850rE2brTbl517yU-cC-bN88gajDVwA6T-YJ1cviSnrpPLKF5V56oOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAP7WB4mxzL8LxU022PV0rE-z9GSBV0xXvx_UuR5psAQ&oe=6B070ADD"}, "display_name": "Child's Play", "keywords": [], "long_description": "Child's Play is a VR environment where you can create various shapes of different sizes and colors.  You can stack blocks, throw balls at towers, or just enjoy the various moving objects within the scenery.  Child's Play does not require any instructions, setup, or configurations to play.  All you need is to put on your VR headset and play around.  Child's Play is perfect for anyone who is new to VR and just wants to simply interact with VR objects in a fun and safe environment.", "short_description": "From stacking blocks to throwing balls, Child's Play is a simple VR environment that allows you to play and interact with different shapes.  Child's Play allows you to bring out your inner child."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.damionmullins.com/childsplay#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Damion Mullins", "support_website_url": null, "website_url": "https://www.damionmullins.com/childsplay", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
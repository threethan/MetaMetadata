N4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHyzHr9yzRiRGogPqmTY60dGdqmI84pYJiVv3oyGhxIQ&oe=69BD446D"}, {"file_name": "screenshot5.png", "id": "855322562831216", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974750_855322566164549_4363188022118813260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdtHd2NzXaQQ7kNvwEXk1zi&_nc_oc=AdkRyHwl6RmWD72kuF8KpfIQTAkwc1PgMyjX9Z3gYQHN4l2lAzyClqN4QKb1euRoJdA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOlqakdoOCcAbESpNaPH68xQ0bdy2PJV6co2VPkYdbNw&oe=69BD3EC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot5.png", "id": "189180370856841", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035411_189180374190174_2041119517261467595_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B09NvJm-v5kQ7kNvwETQgz4&_nc_oc=AdlADOpAoN_OYkMxBizjMqjScjbdwb75HY_9GpluNpqPKNPfQk2cDQ8QSNV6e_tB6pM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQtMcNcdPKjDA6AuhkoNCQxak75-ySCDeG2QSm-9EkvA&oe=69BD3B9D"}, "display_name": "Child's Play", "keywords": [], "long_description": "Child's Play is a VR environment where you can create various shapes of different sizes and colors.  You can stack blocks, throw balls at towers, or just enjoy the various moving objects within the scenery.  Child's Play does not require any instructions, setup, or configurations to play.  All you need is to put on your VR headset and play around.  Child's Play is perfect for anyone who is new to VR and just wants to simply interact with VR objects in a fun and safe environment.", "short_description": "From stacking blocks to throwing balls, Child's Play is a simple VR environment that allows you to play and interact with different shapes.  Child's Play allows you to bring out your inner child."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.damionmullins.com/childsplay#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Dami
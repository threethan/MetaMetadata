m&oh=00_Af2tINOIFeugEuAHuRI-yT_vgmfhYARp4OHm_Y2_R8M5lQ&oe=69F2006D"}, {"file_name": "screenshot5.png", "id": "855322562831216", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974750_855322566164549_4363188022118813260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoNFDlKo0_IQ7kNvwE6eS1k&_nc_oc=AdoEmXP1htdEZXxqcDWV8aTRRt8iSY4PF42VOs1pD8wXapUgfzD2yZ0Tha8DPOPepzI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2gY2rFn2rWXeaOM_vjdj-co_oqVbqHD3jgoCrgjqXaBQ&oe=69F1FAC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot5.png", "id": "189180370856841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035411_189180374190174_2041119517261467595_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPfUQ8CfiW4Q7kNvwERD3sM&_nc_oc=AdrY87sVv37aTmCI_XoonWXoCWERyluckuypQhNT32vASBIXKXxseuchl7KqcG-jEzU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2kDYiJloe9sbc-LcKAg3KnorBMiUIDUPgBDZdIH4zqSA&oe=69F1F79D"}, "display_name": "Child's Play", "keywords": [], "long_description": "Child's Play is a VR environment where you can create various shapes of different sizes and colors.  You can stack blocks, throw balls at towers, or just enjoy the various moving objects within the scenery.  Child's Play does not require any instructions, setup, or configurations to play.  All you need is to put on your VR headset and play around.  Child's Play is perfect for anyone who is new to VR and just wants to simply interact with VR objects in a fun and safe environment.", "short_description": "From stacking blocks to throwing balls, Child's Play is a simple VR environment that allows you to play and interact with different shapes.  Child's Play allows you to bring out your inner child."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.damionmullins.com/childsplay#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Damion Mullins", "support_website_url": null, "website_url": "htt
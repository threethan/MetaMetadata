kNvwGs58zP&_nc_oc=AdkmO-N1qBAgJpP-nZLlPLxPLZIBKltQU1b-bTSzm0ZkmaVRekbnQHIi1xEEGO71dBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftXBpLM6HPT57HJ9v2rWSsdvxbj9WA3D-KmgldlrZrl3w&oe=699D9A47"}, {"file_name": "screenshot3.png", "id": "3611176482451732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001659_3611176485785065_8575408351328241703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-l_Ex0licIQ7kNvwFsq1lY&_nc_oc=Adm_yl65udjcHfNxdSergkWPvkLLrMc4pjXPiHepvgaQmjrGxtLlvebiHpU8WZPn5V0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuT-1qVwZts2_4oZSw5Gdcnip-_l-RmjO_d870l_fuuRA&oe=699D9F98"}, {"file_name": "screenshot4.png", "id": "991676195497963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982502_991676198831296_4761544534087245815_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdMIyv-WOHcQ7kNvwEhsWd1&_nc_oc=AdnGZAJXCIQq-PeEonOCxknUn0e25Z6HC9KopRd8cclgUCVp21h3d3hxWmcWw-evCLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXluD_vzDDVm5D_jnO7weCpXYcjFzrmoqSbwemLgWzUg&oe=699DA06D"}, {"file_name": "screenshot5.png", "id": "855322562831216", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974750_855322566164549_4363188022118813260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf0GgI0KHTIQ7kNvwFBYa2t&_nc_oc=AdmhnM3MKifMLWIAYETUqAnrLug71AOFMUa2DfjOUCLhypwJLaBWqvxtya_lmumiJrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4CrRETW0xVHXRPqxRq_jnGWewBVQ_cEPVyL9ViQHXMw&oe=699D9AC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot5.png", "id": "189180370856841", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035411_189180374190174_2041119517261467595_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYqaapz4YbIQ7kNvwGhTlH8&_nc_oc=AdnHU4npoMWs_Hkx8SC7jG5vluMcisdJAPDOmGuel8oMtwPkaNN-S31-wY_BOVxNTXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftO2zfq11lqdSi2owpHi59NU7q7z_4fBfIbj2FISWVpsw&oe=699D979D"}, "display_name": "Child's Play", "keywords": [], "long_description": "Child's Play is a VR environment where you can create various shapes of different sizes and colors.  You can stack blocks, throw balls at towers, or just enjoy the various moving objects within the scenery.  Child's Play does not require any instructions, setup, or configurations to play.  All you need is to put on your VR headset and play around.  Child's Play is perfect for anyone who is new to VR and just wants to simply interact with VR objects in a fun and safe environment.", "short_description": "From stacking blocks to throwing balls, Child's Play is a simple VR environment that allows you to play and interact with different shapes.  Child's Play allows you to bring out your inner child."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.damionmullins.com/childsplay#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Damion Mullins", "support_website_url": null, "website_url": "https://www.damionmullins.com/childsplay", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6562701213784447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031434_666979062065456_215951795825788703_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll4WBLDXbZsQ7kNvwGXhTA_&_nc_oc=AdnUGUu0CuOh6qkh5P1YQ-cqOCDbp5sdQkQlTz_haWRnY-BrBWuDlsSiekk7AH-hPr
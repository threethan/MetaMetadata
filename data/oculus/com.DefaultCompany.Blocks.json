cE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft-9smVy_imk55O2BcyZsdgbAIj_6_XS5EzMPFRtIf1TA&oe=69A82C6D"}, {"file_name": "screenshot5.png", "id": "855322562831216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_855322566164549_4363188022118813260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUeCQmnXlgkQ7kNvwEJr83a&_nc_oc=AdmXnOttIfNVmc-EOrNgOyLTQwWr9QsVWE3r66jQNrhEYOatiVtOahfgFQNd2skIOSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuh-R6p3anI_vXtzEbOR5dQ9UomEe8z_hvkPIEXhBgzAw&oe=69A826C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot5.png", "id": "189180370856841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035411_189180374190174_2041119517261467595_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6O1QOmcd-wQ7kNvwFfMlXR&_nc_oc=Adl5ASuZa6tjSIUWMfcSAjgg3GiV8BtIIfeoKt5dVuTB6q3DR2bWE6Fo7PB9e-rlD3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvRBG-jQVuZLtLDi2NRx3O0Uy9eAOk1XoE_QvMF2RF4Hw&oe=69A8239D"}, "display_name": "Child's Play", "keywords": [], "long_description": "Child's Play is a VR environment where you can create various shapes of different sizes and colors.  You can stack blocks, throw balls at towers, or just enjoy the various moving objects within the scenery.  Child's Play does not require any instructions, setup, or configurations to play.  All you need is to put on your VR headset and play around.  Child's Play is perfect for anyone who is new to VR and just wants to simply interact with VR objects in a fun and safe environment.", "short_description": "From stacking blocks to throwing balls, Child's Play is a simple VR environment that allows you to play and interact with different shapes.  Child's Play allows you to bring out your inner child."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.damionmullins.com/childsplay#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Dami
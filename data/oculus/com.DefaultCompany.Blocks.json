ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxZ6YajmNRZ-_rb9MN9PSVUdPnMgNCzRw391eZTbCA6Q&oe=69AC20ED"}, {"file_name": "screenshot5.png", "id": "855322562831216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_855322566164549_4363188022118813260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frXN57z4sBYQ7kNvwEYVVrq&_nc_oc=AdkZi9d60JA7U_abHzCf9kZmIIikiU5b4T1-6EBFRcWx2sTk0svZQyKfANC1wY1FRBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwklutNBTwbu33P_LhZxtYYquRTm9COAEMvu6pdodZsWA&oe=69AC1B49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot5.png", "id": "189180370856841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035411_189180374190174_2041119517261467595_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BXBCqJ5v4IQ7kNvwGIFEUp&_nc_oc=Admz-0RDyGNkup1KnY_Y1uPDnV2IEn2jkn79xgRfqInPHPqceOuKxzdQiuZSz2H4zHM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxph9f7AgrF5AxYr2HYFdu1aU4gZ5l2CCNkR5jFAtp3RQ&oe=69AC181D"}, "display_name": "Child's Play", "keywords": [], "long_description": "Child's Play is a VR environment where you can create various shapes of different sizes and colors.  You can stack blocks, throw balls at towers, or just enjoy the various moving objects within the scenery.  Child's Play does not require any instructions, setup, or configurations to play.  All you need is to put on your VR headset and play around.  Child's Play is perfect for anyone who is new to VR and just wants to simply interact with VR objects in a fun and safe environment.", "short_description": "From stacking blocks to throwing balls, Child's Play is a simple VR environment that allows you to play and interact with different shapes.  Child's Play allows you to bring out your inner child."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.damionmullins.com/childsplay#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Dami
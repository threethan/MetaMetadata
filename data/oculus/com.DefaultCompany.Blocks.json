Bs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXj-5DbZ7ORb-_Af3De7up9SU2znYF43VQ3xNyCTTH3Q&oe=69BFE76D"}, {"file_name": "screenshot5.png", "id": "855322562831216", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974750_855322566164549_4363188022118813260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61TNu_pjZ6QQ7kNvwETxI0b&_nc_oc=Adk0IOg-sbFWvkcRjX6-7jnGw1Ei0gm8fob0etJHEkfgn2T67Jxe1byysYDLAvi2Wik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwje1DnUUGr_CHKvgvC3ELgHu48wxM7RVTOBFpSUTC8AA&oe=69BFE1C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot5.png", "id": "189180370856841", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035411_189180374190174_2041119517261467595_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-7hpltarscQ7kNvwFf4bqg&_nc_oc=AdkavGLsdNF30xRNbC5-YoUNQa5M2Nz15OjyjtgLH7FbjX1mLU7hI3KT6qX73qKN5Gs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRYoX8gfDMFpzOCXrCwAoEDP4AWh6U2XeR3Zl2-U00vA&oe=69BFDE9D"}, "display_name": "Child's Play", "keywords": [], "long_description": "Child's Play is a VR environment where you can create various shapes of different sizes and colors.  You can stack blocks, throw balls at towers, or just enjoy the various moving objects within the scenery.  Child's Play does not require any instructions, setup, or configurations to play.  All you need is to put on your VR headset and play around.  Child's Play is perfect for anyone who is new to VR and just wants to simply interact with VR objects in a fun and safe environment.", "short_description": "From stacking blocks to throwing balls, Child's Play is a simple VR environment that allows you to play and interact with different shapes.  Child's Play allows you to bring out your inner child."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.damionmullins.com/childsplay#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Dami
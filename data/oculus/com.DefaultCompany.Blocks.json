erent sizes and colors.  You can stack blocks, throw balls at towers, or just enjoy the various moving objects within the scenery.  Child's Play does not require any instructions, setup, or configurations to play.  All you need is to put on your VR headset and play around.  Child's Play is perfect for anyone who is new to VR and just wants to simply interact with VR objects in a fun and safe environment.", "short_description": "From stacking blocks to throwing balls, Child's Play is a simple VR environment that allows you to play and interact with different shapes.  Child's Play allows you to bring out your inner child."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.damionmullins.com/childsplay#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Damion Mullins", "support_website_url": null, "website_url": "https://www.damionmullins.com/childsplay", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6562701213784447"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3409328902653683"}]}, "baseline_offer": {"id": "3409328902653683"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1695660454, "status": "PUBLISHED", "id": "3409328902653683"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6581120641942504"
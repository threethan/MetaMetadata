u0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9mTuAC9qC1aL78XIQyPzCxOjGc0LpzZ7bdu2m_WFOBg&oe=69BAA16D"}, {"file_name": "screenshot5.png", "id": "855322562831216", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974750_855322566164549_4363188022118813260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdtHd2NzXaQQ7kNvwHj6dlU&_nc_oc=AdnZ8PKlZ7qG-o5yV90z5L4NXGDsm-r9r5RZi6JnFBdah3cuc4r1QXSUW_f8irVP4Vs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGOdeNz8SHe49rQ1OZJGxSXkte-O6uIXgyXBlEdqCOcA&oe=69BA9BC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot5.png", "id": "189180370856841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035411_189180374190174_2041119517261467595_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZC7NyUFaRQQ7kNvwGqizgR&_nc_oc=AdkjQWoRgSxBB83pogymT1IaWO7zvg_ELDXlrG0t-wOeUPR8-A5DSwWYZN3bmHk3JbY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzILiyKE7RVwnsvmrUV_quepXTDFF3qwQcB_w5k5RXd3g&oe=69BA989D"}, "display_name": "Child's Play", "keywords": [], "long_description": "Child's Play is a VR environment where you can create various shapes of different sizes and colors.  You can stack blocks, throw balls at towers, or just enjoy the various moving objects within the scenery.  Child's Play does not require any instructions, setup, or configurations to play.  All you need is to put on your VR headset and play around.  Child's Play is perfect for anyone who is new to VR and just wants to simply interact with VR objects in a fun and safe environment.", "short_description": "From stacking blocks to throwing balls, Child's Play is a simple VR environment that allows you to play and interact with different shapes.  Child's Play allows you to bring out your inner child."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.damionmullins.com/childsplay#privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Dami
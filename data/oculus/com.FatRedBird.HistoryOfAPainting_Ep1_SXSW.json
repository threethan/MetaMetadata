5jAcwpw&oe=69A6BFD8"}, "display_name": "History Of A Painting - \"What's the point?\"", "keywords": [], "long_description": "Hi)story of a Painting is an animated VR and 360 series aimed at engaging young audiences with art by creating accessible and relatable experiences focused on the human stories behind some of the world\u2019s most iconic art. The visuals and virtual environment of each\n\nepisode appear in support of the narration, helping to illustrate and anchor the narrator\u2019s story in the viewer\u2019s mind. We want to inspire young and new audiences through the stories of our featured artists\u2019 struggles and successes.", "short_description": "\u201cChanging your views on the paintings that changed the world\u201d."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "955806908665308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974705_3213053562131709_6269833358089429165_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyk1gElOnBcQ7kNvwE0Kw8
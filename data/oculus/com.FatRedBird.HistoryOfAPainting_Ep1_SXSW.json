0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapeStills_00001.png", "id": "449467706508755", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982535_449467709842088_2737724849769982635_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfDD8Pb_NgEQ7kNvwG6xRZN&_nc_oc=AdrWBLKOTC-bfk4QCBD_bexTLBIjMjt6QHPlUl15DLg9I8Y2SR4-7cX7kg_is8ObZC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQglKSfNkYczs3fdLTCg5Vj5hFklz0MBdKK9K_HanH2PA&oe=6B06F898"}, "display_name": "History Of A Painting - \"What's the point?\"", "keywords": [], "long_description": "Hi)story of a Painting is an animated VR and 360 series aimed at engaging young audiences with art by creating accessible and relatable experiences focused on the human stories behind some of the world\u2019s most iconic art. The visuals and virtual environment of each\n\nepisode appear in support of the narration, helping to illustrate and anchor the narrator\u2019s story in the viewer\u2019s mind. We want to inspire young and new audiences through the stories of our featured artists\u2019 struggles and successes.", "short_description": "\u201cChanging your views on the paintings that changed the world\u201d."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
deo_trailer_thumbnail": {"file_name": "Screen Shot 2022-07-28 at 9.12.12.png", "id": "757577278818000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974672_757577282151333_3602896094228548252_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgQ3WdG6tVIQ7kNvwH9KRDT&_nc_oc=AdoVCA-2BYd2aVRqs7I_wk2vFOflq2XSsDisVUMJypc64cvRzCJ6cqzJbekx1JNABJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWT4_Zcyd_Ns8LIVhkmfOF6s_kB32vOPg7KBvN42RjdhQ&oe=6B0EF455"}, "display_name": "R\u00e9publique VR", "keywords": [], "long_description": "Developed over five years by industry veterans (Metal Gear Solid, Halo, F.E.A.R.), R\u00c9PUBLIQUE is a thrilling and topical stealth-action game that explores the perils of government surveillance in the Internet Age.\n\nYou receive a call from Hope, a woman trapped inside a mysterious totalitarian state. By hacking into the nation's elaborate surveillance network and taking control, you guide Hope through a web of danger and deception across five thrilling episodes.\n\n\u2022 Immersive puzzles and strategic choices\n\u2022 Innovative, interactive developer commentary \n\u2022 Incredible voiceover performances, starring:\no Rena Strober\no David Hayter (Metal Gear Solid)\no Jennifer Hale (Mass Effect, BioShock Infinite)\no Dwight Schultz (killer7, Star Trek)\no Khary Payton (Metal Gear Solid 4)", "short_description": "Developed over five years by industry veterans (Metal Gear Solid, Halo, F.E.A.R.), R\u00c9PUBLIQUE VR is a thrilling and topical stealth-action game that explores the perils of government surveillance in the Internet Age.\n\nYou receive a call from Hope, a woman trapped inside a mysterious totalitarian state. By hacking into the nation's elaborate surveillance network and taking control, you guide Hope through a web of danger and deception across five thrilling episodes."}]}, "developer_name": "Camouflaj", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-poli
ng control, you guide Hope through a web of danger and deception across five thrilling episodes."}]}, "developer_name": "Camouflaj", "developer_privacy_policy_url": "https://camouflaj.com/republique-privacy-policy/", "developer_terms_of_service_url": "http://www.camouflaj.com/", "publisher_name": "Camouflaj", "support_website_url": null, "website_url": "https://camouflaj.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "NARRATIVE", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "fr", "de", "es", "ru", "ja"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1289750658177293"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "904766733418288"}, {"status": "PUBLISHED", "id": "2496665303719066"}, {"status": "PUBLISHED", "id": "120554555871987"}, {"status": "PUBLISHED", "id": "842920657093649"}, {"status": "PUBLISHED", "id": "2565519040151027"}, {"status": "CANCELLED", "id": "1212499615986128"}, {"status": "PUBLISHED", "id": "429401461247270"}]}, "baseline_offer": {"id": "842920657093649"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1621234800, "status": "PUBLISHED", "id": "904766733418288"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5171830326275764", "version": "1.3"}, "id": "766547903703088", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only
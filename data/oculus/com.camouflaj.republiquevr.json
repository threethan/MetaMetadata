4moreyJAeQxkFN3dJ1S-cgtiq62bLq6vM2TYe-3bN3y0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0-Fnn73W99aRMt6RLlSB3EVLVY5uOVWGEF1f3jHDTdQ&oe=69CA6B15"}, "display_name": "R\u00e9publique VR", "keywords": [], "long_description": "Developed over five years by industry veterans (Metal Gear Solid, Halo, F.E.A.R.), R\u00c9PUBLIQUE is a thrilling and topical stealth-action game that explores the perils of government surveillance in the Internet Age.\n\nYou receive a call from Hope, a woman trapped inside a mysterious totalitarian state. By hacking into the nation's elaborate surveillance network and taking control, you guide Hope through a web of danger and deception across five thrilling episodes.\n\n\u2022 Immersive puzzles and strategic choices\n\u2022 Innovative, interactive developer commentary \n\u2022 Incredible voiceover performances, starring:\no Rena Strober\no David Hayter (Metal Gear Solid)\no Jennifer Hale (Mass Effect, BioShock Infinite)\no Dwight Schultz (killer7, Star Trek)\no Khary Payton (Metal Gear Solid 4)", "short_description": "Developed over five years by industry veterans (Metal Gear Solid, Halo, F.E.A.R.), R\u00c9PUBLIQUE VR is a thrilling and topical stealth-action game that explores the perils of government surveillance in the Internet Age.\n\nYou receive a call from Hope, a woman trapped inside a mysterious totalitarian state. By hacking into the nation's elaborate surveillance network and taking control, you guide Hope through a web of danger and deception across five thrilling episodes."}]}, "developer_name": "Camouflaj", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy", "developer_terms_of_service_url": "https://www.meta.com/legal/quest/games-terms-of-service", "publisher_name": "Camouflaj", "support_website_url": null, "website_url": "https://camouflaj.com/republique-vr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "27433260359255
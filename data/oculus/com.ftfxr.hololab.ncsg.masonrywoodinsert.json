T18lOerauooxqA1Z_2FQDvzP1E_sqsghJ_1vpvsy7_SbTDyROMm30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe26vEKtn6hnkNOhVpA0TjM2RIrihuiFMRutZcqd5IyA&oe=6A7C4A87"}, {"file_name": "screen-3.png", "id": "1003454831259726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441584_1003454834593059_4414683215204598073_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIpQlbOuuRUQ7kNvwE5fogf&_nc_oc=AdocqYBUD7HZek36euqiTtYoufxWSnwBgfZSOoI-5d4qc16u7Rba9Zwl2kgXhg0cpkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4yOM8BTicFvCvR1ESlf_IgWm76S1zU68mM9nwGCzcIA&oe=6A7C55DE"}, {"file_name": "screen-4.png", "id": "1017662276733473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245822_1017662280066806_3140249560059418966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkYqqQsctD8Q7kNvwEqv97Q&_nc_oc=AdrhaK46O21lznWtdKXStvom8ZXYhcATWZwuWENjQykVYRHMpthZd2fiZHk_s3g3XTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsjqbiwIfRc4kXYZBOwSg9I_piII1MaUmMsPYaL2PESA&oe=6A7C5B8F"}, {"file_name": "screen-5.png", "id": "1132731301130632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375083_1132731304463965_2489209119133489696_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=filirxnB3fwQ7kNvwG8q865&_nc_oc=Adrj-_WySHJAVjfJxwOqIM6opGNE5XnF11YM9c6904Y0O-tSpiDwhT_sAShEdMCfmTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ9wJ1EW-t6AtCMwNw2iq0xDDDzarF_3I-PKmYg4jWXQ&oe=6A7C6DC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mod2_Title.png", "id": "1212771323096726", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036673_1212771326430059_1176351761076307841_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KLru1MQne4Q7kNvwG1J5AP&_nc_oc=AdrFcMK6qih1krbeW4kKGIxZfZMrXHkgOkE-IB0A5onnUPSi28yTA27Oeo7PFGCl-EE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF75AL2gnAWqW8gxF2YQdRL7kppqvl5m3Nm4k2zSDInNg&oe=6A7C5E88"}, "display_name": "Hololab VR - NCSG Inspection Foundation Module 2: Masonry Wood Insert", "keywords": [], "long_description": "**Hololab NCSG Module 02 Wood Burning Fireplace Inserts VR Application**\n\nThe Hololab National Chimney Sweep Guild VR application trains users in the critical skills needed to inspect and maintain wood-burning fireplace inserts to NCSG standards. The course features interactive slides, desktop activities, real-world simulations, and integrates with a Learning Management System. It challenges students with inspections of randomized issues in a virtual residential setting, ensuring they follow all necessary procedures.\n\n**VR Controls and PPE \u2013** Learn how to navigate the virtual environment while getting acquainted with essential personal protective equipment.\n\n**Responsibility & Worksite Hazard Assessment \u2013** Operate in a simulated environment to identify and mitigate hazards commonly encountered during inspections of wood-burning fireplace inserts.\n\n**Familiarization \u2013** Understand different types of wood-burning fireplace inserts and their common features.\n\n**Fireplace Insert Inspection \u2013** Utilize the official NCSG checklist to thoroughly inspect wood-burning fireplace inserts.\n\n**Real-World Simulation \u2013** Complete the inspection by correctly identifying issues with maximum safety awareness and forensic skills.\n\nData reports for review are saved and stored for engagement metrics and simulation performance analysis.\n\nAny off-platform monetization of content accessible in this app conforms to the Oculus Bulk IAP or Subscription Licenses app policy outlined here: https://developer.oculus.com/policy/app-policies", "short_description": "The Hololab National Chimney Sweep Guild Wood Burning Fireplace Inserts VR application equips users with the critical skills necessary to inspect and maintain wood-burning fireplace inserts according to NCSG standards. This in-depth course includes interactive slide content, desktop-based activities, realistic simulations, and comprehensive testing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ftfvr.com/privacy-app", "developer_terms_of_service_url": null, "publisher_name": "From the Future", "support_website_url": null, "website_url": "https://ftfvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8051709714946212"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "830615765267960"}]}, "baseline_offer": {"id": "830615765267960"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723504671, "status": "PUBLISHED", "id": "830615765267960"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8179130598870789", "version": "0.9.298"}, "id": "450061517887216", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7790256394424880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8179130598870789"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "450061517887216"}]}, "change_log": null, "created_date": 1740779392, "id": "9362101443907026", "version": 
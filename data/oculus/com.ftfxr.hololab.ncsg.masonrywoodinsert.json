aOOjJ_AV5OWzMNpYDP-g0vriOtIfFv8O7GsL-5ZR8MLmyYLPMOryo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2prpeGgDTir4oqiKc_I4nWCs7NzADYPbYHlWkHSXAFOw&oe=69D665C7"}, {"file_name": "screen-3.png", "id": "1003454831259726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441584_1003454834593059_4414683215204598073_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jBK-53k2j8Q7kNvwFNZ_3B&_nc_oc=Adr2uhhjUi3nIK_N18ZdYjjMflXi3PSTdhBagKTntYeUNpnuhxBkD7QRaF2sVHmj4os&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aQ77g750IjuHgxcHg5KXXVefQhprqXic5gwBQlinzZA&oe=69D638DE"}, {"file_name": "screen-4.png", "id": "1017662276733473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245822_1017662280066806_3140249560059418966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew-wse3Tc9oQ7kNvwHKyfRR&_nc_oc=AdpcW0M9kVN9YKW28Dm7GbADKUfhPTJ0JTr12xDV_8P3-ZcYzBAQeeHxrJ08RAnpXoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UQlVVlczna2SdQDDkvnRwU-Ew46MF_At_yrCMdUvdbg&oe=69D63E8F"}, {"file_name": "screen-5.png", "id": "1132731301130632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375083_1132731304463965_2489209119133489696_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4WH8UxeN88Q7kNvwHNgswt&_nc_oc=Adrg1mcFF78l7MIpnGxs0Z93vm_-ONk92uPJp3BmjDANds02dpOrkKZihwxm-J91OTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r_tW7pYUNmz4XJGUi7zRnVjefvaZbiV3QO8ILz00c_A&oe=69D650C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mod2_Title.png", "id": "1212771323096726", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036673_1212771326430059_1176351761076307841_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8JMu8vAcuYQ7kNvwFmB7_Z&_nc_oc=AdouuuS8ocryjHYZy5Z4e1Xwrsj00RFLE8i9nS7n8NWxNWbPMyfK9Wz5gBqxJ2UW7ms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wjb5o9nj7hxHFum_nf0ICmk5SLn9Kq4g3k_6ozrl8hw&oe=69D64188"}, "display_name": "Hololab VR - NCSG Inspection Foundation Module 2: Masonry Wood Insert", "keywords": [], "long_description": "**Hololab NCSG Module 02 Wood Burning Fireplace Inserts VR Application**\n\nThe Hololab National Chimney Sweep Guild VR application trains users in the critical skills needed to inspect and maintain wood-burning fireplace inserts to NCSG standards. The course features interactive slides, desktop activities, real-world simulations, and integrates with a Learning Management System. It challenges students with inspections of randomized issues in a virtual residential setting, ensuring they follow all necessary procedures.\n\n**VR Controls and PPE \u2013** Learn how to navigate the virtual environment while getting acquainted with essential personal protective equipment.\n\n**Responsibility & Worksite Hazard Assessment \u2013** Operate in a simulated environment to identify and mitigate hazards commonly encountered during inspections of wood-burning fireplace inserts.\n\n**Familiarization \u2013** Understand different types of wood-burning fireplace inserts and their common features.\n\n**Fireplace Insert Inspection \u2013** Utilize the official NCSG checklist to thoroughly inspect wood-burning fireplace inserts.\n\n**Real-World Simulation \u2013** Complete the inspection by correctly identifying issues with maximum safety awareness and forensic skills.\n\nData reports for review are saved and stored for engagement metrics and simulation performance analysis.\n\nAny off-platform monetization of content accessible in this app conforms to the Oculus Bulk IAP or Subscription Licenses app policy outlined here: https://developer.oculus.com/policy/app-policies", "short_description": "The Hololab National Chimney Sweep Guild Wood Burning Fireplace Inserts VR application equips users with the critical skills necessary to inspect and maintain wood-burning fireplace inserts according to NCSG standards. This in-depth course includes interactive slide content, desktop-based activities, realistic simulations, and comprehensive testing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ftfvr.com/privacy-app", "developer_terms_of_service_url": null, "publisher_name": "From the Future", "support_website_url": null, "website_url": "https://ftfvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8051709714946212"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "830615765267960"}]}, "baseline_offer": {"id": "830615765267960"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723504671, "status": "PUBLISHED", "id": "830615765267960"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8179130598870789", "version": "0.9.298"}, "id": "450061517887216", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7790256394424880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8179130598870789"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "450061517887216"}]}, "change_log": null, "created_date": 1740779392, "id": "9362101443907026", "version": 
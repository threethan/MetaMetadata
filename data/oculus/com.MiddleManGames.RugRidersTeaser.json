0_Af0kZy1jGCiVQYcnmaW07oduEVJD8Ad7y1LRzz8IY0NolA&oe=69E76EF3"}, {"file_name": "Avatar.00_34_23_28.Still018.png", "id": "3190338551233267", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031630_3190338554566600_8571880380665658137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP5JleMf9rYQ7kNvwFk9_PH&_nc_oc=AdpUQo3kKTsEvgIFFgTxteMimKAvcBbdlc9JnnSDTdBn9gb0FRMg-2M5_a4ZMtj9Vu4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nbgGQ_XQgjqr5i3uDr84PtD6WpUW42CZ1R9lfIhvS0Q&oe=69E784BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Avatar.00_32_36_13.Still020.png", "id": "1216884015818729", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984447_1216884022485395_5287685199255432653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sojg4Q0mEHYQ7kNvwFvjUj_&_nc_oc=AdrW-j5tCJq2KJJX0h02L8shtI8Cy5nDu-1e4okGpzQTGHisY5dHJZ_I9_BFNb1p1Kg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gc8_bxO1qzEMxgMR7oGhR7xOPweXNmJefjq0SgM0jPA&oe=69E75F7A"}, "display_name": "Rug Riders Teaser", "keywords": [], "long_description": "Fly using just the movement of your body!\n\nRug Riders is a magic carpet simulator with a unique movement system that's so authentic, it feels like you're flying a real magic carpet!\n\nPlease support the development of Rug Riders by picking up this Rug Riders Teaser. All profits will go into making the final release of Rug Riders as good as it can be.\n\nBlast enemies with fireballs in the 18 battles, unlock gold medals on the 12 races, or just enjoy flying around the sprawling landscape.\n\nThe finished game will feature an expansive single player campaign, with levels that will test your flying agility, combat skills, and feature many new gameplay mechanics.\n\nHelp shape the development of Rug Riders by Joining the Discord.\n(https://discord.gg/UucU2CtKba)\n\nKeep up to date with the progress by following Middle Man Games on Twitter.\n(https://twitter.com/MiddleManGames1)", "short_
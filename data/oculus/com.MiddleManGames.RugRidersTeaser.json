0_Af34YjzQQldyS9AY5lAKJlOKXoyPt_BEnCU7mFm5n8ACpA&oe=69DE3473"}, {"file_name": "Avatar.00_34_23_28.Still018.png", "id": "3190338551233267", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031630_3190338554566600_8571880380665658137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nm7d9yH5U8Q7kNvwE8nFdu&_nc_oc=Adq6zzsIKMskSmlabt5eY85Sp89AwdxaQWpBqBbhD0bA6GQ3g9uFLFXFEb8_Yod0iSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wHbVQ0n4S5SsWbFgPEvU8Whg3o9eiAy5HGOliw5fafQ&oe=69DE4A3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Avatar.00_32_36_13.Still020.png", "id": "1216884015818729", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_1216884022485395_5287685199255432653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN3S2ELj7wsQ7kNvwECopek&_nc_oc=AdoGEqvbOiTD95cVBba1Z630YFERzp-vl4VrzgxYb5VYpDs74Bx8yhagEUMRk12PFlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-wmsLKgLgs8PrJZrgKpVoUi-I6k1_64PtAzeDdNAtJw&oe=69DE24FA"}, "display_name": "Rug Riders Teaser", "keywords": [], "long_description": "Fly using just the movement of your body!\n\nRug Riders is a magic carpet simulator with a unique movement system that's so authentic, it feels like you're flying a real magic carpet!\n\nPlease support the development of Rug Riders by picking up this Rug Riders Teaser. All profits will go into making the final release of Rug Riders as good as it can be.\n\nBlast enemies with fireballs in the 18 battles, unlock gold medals on the 12 races, or just enjoy flying around the sprawling landscape.\n\nThe finished game will feature an expansive single player campaign, with levels that will test your flying agility, combat skills, and feature many new gameplay mechanics.\n\nHelp shape the development of Rug Riders by Joining the Discord.\n(https://discord.gg/UucU2CtKba)\n\nKeep up to date with the progress by following Middle Man Games on Twitter.\n(https://twitter.com/MiddleManGames1)", "short_description": "Fly using just the movement of your body!\n\nRug Riders is a magic carpet simulator with a unique movement system that's so authentic, it feels like you're flying a real magic carpet!\n\nBlast enemies with fireballs in the battles, unlock gold medals on the races, or just enjoy flying around the sprawling landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZUtO9p9LGTiyFyrNsbxon0-Z6KMtacVSJDXga8NYG7I/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Middle Man Games", "support_website_url": null, "website_url": "https://twitter.com/MiddleManGames1", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "399775625359425"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "777883693399024"}, {"status": "PUBLISHED", "id": "174341515429417"}, {"status": "PUBLISHED", "id": "1549367335635551"}]}, "baseline_offer": {"id": "1549367335635551"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1661986800, "status": "PUBLISHED", "id": "777883693399024"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7944252518981414", "version": "0.1.18"}, "id": "576590723916325", "channel_name": "LIVE"}]}, "is_for_oculus_keys_o
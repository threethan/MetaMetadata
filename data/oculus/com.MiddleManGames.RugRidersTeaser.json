0_Af1TeEykdjQG9ALR_2zZBgvldrEGFkJm-yqYZ9ZEy4MQ3w&oe=69F5EF73"}, {"file_name": "Avatar.00_34_23_28.Still018.png", "id": "3190338551233267", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031630_3190338554566600_8571880380665658137_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK6xQG8UZ_oQ7kNvwFNDGNB&_nc_oc=AdqgQ4TUSwX60QxgoIH1jg3yDWJxXrYghopK3hiVrU4ZARrZ9VlYdvUBHpDPR6G20vM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xQvtOeS46JfxZt5D1mT28yL9t70PZdfV1167lxhtKQg&oe=69F6053D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Avatar.00_32_36_13.Still020.png", "id": "1216884015818729", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984447_1216884022485395_5287685199255432653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkMeaCZAObEQ7kNvwFWbw6z&_nc_oc=AdpiI6ptAzvpclBBlq1LUYfZJ1CAiUT9VpuZEcFDjrpl336hxAJIuvXAGbjxyqF6D_8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mOfV6soWlvnga9RAmYgzag09nh2SMKjyrPqeSGSuXfA&oe=69F6183A"}, "display_name": "Rug Riders Teaser", "keywords": [], "long_description": "Fly using just the movement of your body!\n\nRug Riders is a magic carpet simulator with a unique movement system that's so authentic, it feels like you're flying a real magic carpet!\n\nPlease support the development of Rug Riders by picking up this Rug Riders Teaser. All profits will go into making the final release of Rug Riders as good as it can be.\n\nBlast enemies with fireballs in the 18 battles, unlock gold medals on the 12 races, or just enjoy flying around the sprawling landscape.\n\nThe finished game will feature an expansive single player campaign, with levels that will test your flying agility, combat skills, and feature many new gameplay mechanics.\n\nHelp shape the development of Rug Riders by Joining the Discord.\n(https://discord.gg/UucU2CtKba)\n\nKeep up to date with the progress by following Middle Man Games on Twitter.\n(https://twitter.com/MiddleManGames1)", "short_
771-25/39001711_1534034427136034_2929957075946393090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnRaviTm5t8Q7kNvwHs2KKj&_nc_oc=AdpwsicrnNsjYdsZIk7TfSZl1EhNBhD2rzUVfKtBK88Raucs-2R6fbnDIZojVObe2NY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvRAgpeKKev-YMVb73yxCPMJeo8drHDj5OJ3wuJakxVw&oe=6A8EE376"}, {"file_name": "magiclab.png", "id": "571678028809339", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982452_571678032142672_4802457235566616749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-taECVjgoW0Q7kNvwF8xeaf&_nc_oc=AdpX1EWe5mQ9lZ5FRR45ptAdrxpWopp3UKfjzHgyTXysQ3ve_6QK0OdlkPHRuqkKWio&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeU8cGDE8VY0uQxsDR3u7_LWhFcwoG9j3BYju2tMUhHA&oe=6A8EECF3"}, {"file_name": "Store Images-6.png", "id": "1345003753277335", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307555_1345003756610668_1826594110833715176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjHBj37VPIwQ7kNvwGXDiXm&_nc_oc=AdoYSvFdhYXdqYgt8nEzrCiVQgI6nIabqFsMpSvxFUu0zSabduGOH4lJ3IUZ6QNuYTs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKSApQx_OQYT4GtLdEvDzFxlQGaUVrVdowc3EDsKr7aA&oe=6A8EF7FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard Simulator", "keywords": ["magic", "wand", "duel", "wizard", "rpg"], "long_description": "# Master Magic Spells\nHarness the power of your wand to cast incredible spells with precision. Summon fire, control the elements, and unlock new magical abilities as you explore a mystical world.\n\n# Brew Powerful Potions\nDive into the art of potion-making! Combine rare ingredients, experiment with recipes, and create potions that heal, enhance, or devastate in the heat of battle.\n\n# Duel Other Players\nOutsmart your opponents with quick reflexes and strategic spellcasting in intense multiplayer battles.\n\nAre you ready to become the ultimate wizard?\n\n{1411794410259308}", "short_description": "Cast magi
71-25/39001711_1534034427136034_2929957075946393090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap81jbRb2KAQ7kNvwFmYC5q&_nc_oc=Adpgu-ENqgRidmYsbWaYcvdfRpgztgNHp_5HXhieEPB7eX6uP1erlWt_5Yiiazxl1KQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qThqw_RrFHV4Pu5ribcDZEixzxOGICcS21Yak4_Ok_Q&oe=6A4660F6"}, {"file_name": "magiclab.png", "id": "571678028809339", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982452_571678032142672_4802457235566616749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tH1mIRz34skQ7kNvwHOIo4_&_nc_oc=AdqbKXucy01gAIzF4mmbHzp2v4RC0ei4NtLK9FRnKUkHVvMfOEqp8jAqey1uX1NCFvg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_eJZPVQhdzp4X_GhVKsqhlMQWxnysttGKusUF-Sdt2A&oe=6A466A73"}, {"file_name": "Store Images-6.png", "id": "1345003753277335", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499307555_1345003756610668_1826594110833715176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-CDolJtegAQ7kNvwHSzt76&_nc_oc=Adp1zoeDdP7smvaXPDdrSp0kEreDuZ1bBxVNtT_Zx2j8U64kHCnd7ACEXuXc-nxSdpE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BFSLVIBM9JcWv2uDRriYaIKWoE-my-elWaHzvLjsZWg&oe=6A46757E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard Simulator", "keywords": ["magic", "wand", "duel", "wizard", "rpg"], "long_description": "# Master Magic Spells\nHarness the power of your wand to cast incredible spells with precision. Summon fire, control the elements, and unlock new magical abilities as you explore a mystical world.\n\n# Brew Powerful Potions\nDive into the art of potion-making! Combine rare ingredients, experiment with recipes, and create potions that heal, enhance, or devastate in the heat of battle.\n\n# Duel Other Players\nOutsmart your opponents with quick reflexes and strategic spellcasting in intense multiplayer battles.\n\nAre you ready to become the ultimate wizard?\n\n{1411794410259308}", "short_description": "Cast magic spel
6393090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWUCCfX77aUQ7kNvwFazghH&_nc_oc=AdkLLtT9CnxBMIg1A3ZllrBL4d49WLr7EIcI6BHLnlNtfy2QXiPwzMuh6Bf1XwOt1Ks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHhO1ROOwJe6mOX54ZTAeweIg-IgUknYK9wjsefp8qkw&oe=69B7FEF6"}, {"file_name": "magiclab.png", "id": "571678028809339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982452_571678032142672_4802457235566616749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfxMNAUB26kQ7kNvwEBIHIr&_nc_oc=Adn0fENKJLCC4b0qceDgX-U2vD-fqWEsZoyb5OqbNW0uXHKXRDpEElwTnJbbSuFdjdU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGdbbdaJp-5927z3NRnRf5MuRbijNhu6FDzv_C6r-eGg&oe=69B80873"}, {"file_name": "Store Images-6.png", "id": "1345003753277335", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307555_1345003756610668_1826594110833715176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMt5Ld3wGw0Q7kNvwFGw9hK&_nc_oc=AdlA78qD9IMKy_dMqvdgrM7lNZ6tyU9ntn_z8k4ofx42EnBTNsd6q0m8_pTcVvGHFkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwq31eRy9C_TO0CLy5rh1oDMUjm-OVaYrUEHzRX8O6hDg&oe=69B8137E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard Simulator", "keywords": ["magic", "wand", "duel", "wizard", "rpg"], "long_description": "# Master Magic Spells\nHarness the power of your wand to cast incredible spells with precision. Summon fire, control the elements, and unlock new magical abilities as you explore a mystical world.\n\n# Brew Powerful Potions\nDive into the art of potion-making! Combine rare ingredients, experiment with recipes, and create potions that heal, enhance, or devastate in the heat of battle.\n\n# Duel Other Players\nOutsmart your opponents with quick reflexes and strategic spellcasting in intense multiplayer battles.\n\nAre you ready to become the ultimate wizard?\n\n{1411794410259308}", "short_description": "Cast magic spells, brew powerful potions, and duel other players in epi
6393090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMUZZTi2QGYQ7kNvwHzx4_n&_nc_oc=AdkxLx6u9XcJgI78w5-vCEh8L5rbG8iYFx9GSqexeeYYb7a36mSaSVuxKuoZqDRqdH8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrJDYJebu7F5OdKohDRBg4RcDszbdKOMUe0mycBqcs7Q&oe=69B16776"}, {"file_name": "magiclab.png", "id": "571678028809339", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982452_571678032142672_4802457235566616749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FO5MeF-Q9PMQ7kNvwFCeDWf&_nc_oc=AdmIg55l7-otiz1RWViFb8nnD6P17j22x980O5nDZzChBSQU2pmE16SNY7gkTaH48C8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwf9pIk78PWfeWe0VKTH38yIQ0bY1RaK9K1sj8PSCxxQQ&oe=69B170F3"}, {"file_name": "Store Images-6.png", "id": "1345003753277335", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307555_1345003756610668_1826594110833715176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMiQQld5gMAQ7kNvwF1mS_i&_nc_oc=Adky0uvim9Cw_5PVB2uG1Vz67qT04P6xouGPWu8M0h-JIhWvPzd6mV3ivpAH60mBeN4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcJDLqk1VRDNY0ap7cAPfGFXNLrGqzc0dOh7P_AlIEWw&oe=69B17BFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard Simulator", "keywords": ["magic", "wand", "duel", "wizard", "rpg"], "long_description": "# Master Magic Spells\nHarness the power of your wand to cast incredible spells with precision. Summon fire, control the elements, and unlock new magical abilities as you explore a mystical world.\n\n# Brew Powerful Potions\nDive into the art of potion-making! Combine rare ingredients, experiment with recipes, and create potions that heal, enhance, or devastate in the heat of battle.\n\n# Duel Other Players\nOutsmart your opponents with quick reflexes and strategic spellcasting in intense multiplayer battles.\n\nAre you ready to become the ultimate wizard?\n\n{1411794410259308}", "short_description": "Cast magic spells, brew powerful potions, and duel other players in epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pinchlabs.co/privacy", "developer_terms_of_service_url": null, "publisher_name": "Pinch Labs", "support_website_url": null, "website_url": "https://pinchlabs.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24605846429025697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391760_1590055438324029_2110716622604568354_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uscjkF_hn9QQ7kNvwF9RH4Y&_nc_oc=AdkGTXAVvENYPMmEe_s7qyTMPOtnogQx7RGabsxEv9GyZhXGocLoAJG0dvFcK1-YFgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYvW31bDA8H4yPKFlVGXap9FGlZc_vwc-U3baHMQoBsg&oe=69B14E0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wizard Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Role Playing", "id": "821934236779161"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1738281600, "lastRevision": {"nodes": [{"id": "7686719878031617", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_
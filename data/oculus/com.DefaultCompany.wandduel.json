6393090_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRDpAZmmSYYQ7kNvwEuX0zd&_nc_oc=AdnzK3sPsyfEE1qorosB4gHgLeY-XPcheqVgQxlkFO1iysVlZ2Ei5gMYjjaO13EgJZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfughLpXzIgE8Jv_0uVHHeZcLDKxOlk6vVlW12wU1IRzCQ&oe=69A82CF6"}, {"file_name": "magiclab.png", "id": "571678028809339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982452_571678032142672_4802457235566616749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1PVsZCUsZ0Q7kNvwH0sgMv&_nc_oc=AdlwfgPOaY_s5ep7QT302OMZ5qGQFsFwlQDomJqn_TPOdxWuF4DBt3aTDsY0ufHHze0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs7SOpItMgR7fuHSO0Nbk_aWcFu9zocTsw2-VtrJgLvGg&oe=69A83673"}, {"file_name": "Store Images-6.png", "id": "1345003753277335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307555_1345003756610668_1826594110833715176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKpPTPGK9kQQ7kNvwE9Y9Vr&_nc_oc=Adnca4eaQh_e4e6LRMrNRNaJ6Dp-wzQX4xX5ex-MZS3y_sei7vy71jJM-ldd7JRY6ls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftW0B-7mWgRfY6mX6mjsgf3m0RRziYdLYBC3HLDO3oRaw&oe=69A8417E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wizard Simulator", "keywords": ["magic", "wand", "duel", "wizard", "rpg"], "long_description": "# Master Magic Spells\nHarness the power of your wand to cast incredible spells with precision. Summon fire, control the elements, and unlock new magical abilities as you explore a mystical world.\n\n# Brew Powerful Potions\nDive into the art of potion-making! Combine rare ingredients, experiment with recipes, and create potions that heal, enhance, or devastate in the heat of battle.\n\n# Duel Other Players\nOutsmart your opponents with quick reflexes and strategic spellcasting in intense multiplayer battles.\n\nAre you ready to become the ultimate wizard?\n\n{1411794410259308}", "short_description": "Cast magic spells, brew powerful potions, and duel other players in epi
HTioxpP-Zt6d27DehKmsGsiTZj0DrpL0cn3bEluKyOvH6uBfRvOuUroTHBhrs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpGf5jR2wvbXIQtPcn4fhb1H1h1cchfQxXxLMpiROkYw&oe=6AFB36BE"}, {"file_name": "307-STORE-Screenshot-07-hard-light-bridge-2560x1440.png", "id": "1897334634579759", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_1897334637913092_3786998160058754392_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD4Vyr32gREQ7kNvwHnKSzV&_nc_oc=AdrLjus0fEK_ZyO8fR_4sDoJY_1MlVHHyICytKU1JuyjPvFEKTqpZKXTDvfVh1RMma8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-WIhreBP7Zi6nvRb0qyg3Y1HEDqYrTmjSkAnLXXqy0Q&oe=6AFB2FE2"}, {"file_name": "303-STORE-Screenshot-03-amber-refraction-2560x1440.png", "id": "2745276042533275", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_2745276045866608_8701925464107633800_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1AHdHVQGWYQ7kNvwGbxdrR&_nc_oc=AdpxWf571HBrDpsABqCQje7a6VJ9AyHRLlPIyJsAAm0aZh7IPHMWErEDfh3PCcAUroY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsMOxaAIB21hKuSo0J_p5GLn91rR4wE9fuB3E-td6arA&oe=6AFB2271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "29-STORE-Trailer-Cover-2560x1440.png", "id": "3589292841247592", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823279_3589292844580925_8090476355960478056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKAS8eKPaoEQ7kNvwEFFMSj&_nc_oc=AdqEsAsVrqdap4TKZNQ_b0qcfCykahJCD7qfDxQe5tKBkQBHSHTT0uLIQSRo5QeINU4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxROEE0jFi-ftmJTgb5aGVpwvf6bnRJiWr8eqk6seFIA&oe=6AFB457F"}, "display_name": "Opus Reach", "keywords": ["Opus", "Mystery", "Puzzle", "Game", "quintescence"], "long_description": "Under a ringed gas giant, islands float above a cloud sea. Sky-whales circle them. Five spires stand silent.\n\nThe Reach was built as an instrument, and it has not played for a very long time. Each spire keeps one voice of its music.\n\nWake them.\n\nNo two spires wake the same way. One answers to light. One remembers the stars. One waits for a song. One is guarded. The first only asks you to begin.\n\nNo island explains itself. Look closely. Listen. Try things. If you get stuck, press Y: the Codex points the way.\n\nEvery spire you wake adds a voice to the music, synthesised live by the app, and lays a bridge of light onward.\n\nWake all five. The Conductor is waiting.\n\nWHAT IT IS\nA fully immersive, single-player VR puzzle-adventure. Hands-on and exploratory, with a little combat and a musical finale.\n\nCOMFORT\nStick movement or teleport. Snap or smooth turning. Comfort vignette on by default. Optional controller help labels.\n\nGOOD TO KNOW\nTouch controllers only, no hand tracking. No account. Works offline. Collects no data. Progress is saved on the headset after each spire you wake. Begin again whenever you like, from the in-game menu or the end card.\n\nCREDITS\nDesign, code, world geometry, shaders, music and sound by Claude Opus 5.5, an AI model. Beyond Unity and Meta's XR SDK, the only outside assets are three CC0 Poly Haven rock textures, the Chakra Petch font and Meta's controller models.\n", "short_description": "Under a ringed gas giant, islands float above a cloud sea. Five silent spires each wake their own way: one answers to light, one to stars, one to song, and one is guarded. Work it out. Every spire you wake adds a voice to the music. Wake all five: the Conductor is waiting. Single-player VR puzzle-adventure with a little combat. Touch controllers only. Comfort options. Saves after each spire. Offline, no account, collects no data. Design, code, music and sound by Claude Opus 5.5, an AI model.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/opus-reach/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/opus-reach/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/opus-reach/support", "website_url": "https://nebulytic.com/apps/opus-reach/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1328178020378218"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827567_1232062482453263_3256126485640633123_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qinUNH5VOwcQ7kNvwG6ecgW&_nc_oc=AdpU4i871sEqx1PJtHMRSB7uedqTO69t5ZKDVnMJy3Yz2D6TY9EpaYaKo32c5MuN09w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQjDDJNBkz7UBUUzpg6KYJqwZp3XCusWPWGkQ8DbP0dQ&oe=6AFB39DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Opus Reach", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1790280840, "lastRevision": {"nodes": [{"id": "1328178033711550", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1328178017044885", "is_first_party": false, "enables_in_app_ads": false, "is_concept": fal
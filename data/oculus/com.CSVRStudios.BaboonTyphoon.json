6rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdQtwbb-DU7HLGAAtcf25roFua_PcdQ77a2vJD6Y1tpg&oe=6B0721F3"}, {"file_name": "Screenshot 2024-11-03 134856.png", "id": "1097048552042094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974876_1097048555375427_3549241380169034985_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4zIaP1rpJAQ7kNvwGKCbZH&_nc_oc=AdrEsuc3tCa0LscN71sum1kGqt64b1I_YDiRrXaq5FTeo1wCx8jr1MgJqQmmNeF4cuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ7bREUwh3fN9frrFkWQ_WmrRCJXrORAbnTmeY1JQu0g&oe=6B06FF70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-11-02 162340 (2) (1) (5).png", "id": "899050555422580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394059_899050558755913_156314967434703042_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOn19mQIizMQ7kNvwFtTj3H&_nc_oc=AdrUlq5T-2E6sZpat6pUMAFWjWxOYs3qB3NFMdrF1pLjm8nKx8X2g39bLfLk4x8eS54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ7ZmVzoxInApLRtA5DoB3p0CsQH8GNCD07pYt9tXjrA&oe=6B06FE0D"}, "display_name": "Baboon Typhoon 4", "keywords": ["Baboon", "Typhoon", "4", "BaboonTyphoon", "CSVRStudios"], "long_description": "Okay, get THIS! Ever imagined being a baboon? Like, a REAL baboon, running all over the planet?! Well, guess what?! Your dream just came true! It's Baboon Typhoon 4!!! And it's made by us, CSVRStudios! The awesome Baboon Typhoon Team said we could own it, so we did! It's like the old games but WAY better! You get to run around with all your baboon buddies, and just go totally wild! We've got tons of mini-games It's super fun, super silly, and super duper exciting! So get ready to go bananas in Baboon Typhoon 4! It's the best baboon game EVER! You're gonna love it! We promise!", "short_description": "Ever wanted to run around the world as a baboon?! Well, get ready 'cause Baboon Typhoon 4 is HERE! Made by CSVRStudios (we got permission from the original Baboon Typhoon Team!), this game is gonna be EPIC! Run super fast with your friends, put on silly clothes, and go bananas! There's tons of fun games to play, so get ready for the best baboon adventure EVER!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/csvrstudios/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "CSVRStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/csvrstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9206221522732129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_8887039098011413_4603816309744763975_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fziRFrvlWykQ7kNvwFdF6b7&_nc_oc=AdrJLeSmaMTUbaMMMwKkpQLrYIaPfAePBe_u4rdPRFGzW46FIO2VqPUBHkZMnfcEGPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Vg86IodDsk7DKhy4e72ga2Kqy27wplVNuevr9pDD6A&oe=6B06FE2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Baboon Typhoon 4", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1
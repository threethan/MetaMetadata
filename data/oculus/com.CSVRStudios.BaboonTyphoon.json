FD330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-11-02 162340 (2) (1) (5).png", "id": "899050555422580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394059_899050558755913_156314967434703042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgTjL72HkcsQ7kNvwEGWLUh&_nc_oc=AdnkcAXTpGa_2NgjimuiEuZbX5hepFXoq0YBwPVn-F6odkVPPSOKSnRiHSHPkPQo3Ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzxo29ZznKD1mo0_5SX5QpgXLQ0AcdAePfzDJGX7NwSDQ&oe=69BFD1CD"}, "display_name": "Baboon Typhoon 4", "keywords": ["Baboon", "Typhoon", "4", "BaboonTyphoon", "CSVRStudios"], "long_description": "Okay, get THIS! Ever imagined being a baboon? Like, a REAL baboon, running all over the planet?! Well, guess what?! Your dream just came true! It's Baboon Typhoon 4!!! And it's made by us, CSVRStudios! The awesome Baboon Typhoon Team said we could own it, so we did! It's like the old games but WAY better! You get to run around with all your baboon buddies, and just go totally wild! We've got tons of mini-games It's super fun, super silly, and super duper exciting! So get ready to go bananas in Baboon Typhoon 4! It's the best baboon game EVER! You're gonna love it! We promise!", "short_description": "Ever wanted to run around the world as a baboon?! Well, get ready 'cause Baboon Typhoon 4 is HERE! Made by CSVRStudios (we got permission from the original Baboon Typhoon Team!), this game is gonna be EPIC! Run super fast with your friends, put on silly clothes, and go bananas! There's tons of fun games to play, so get ready for the best baboon adventure EVER!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/csvrstudios/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "CSVRStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/csvrstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "con
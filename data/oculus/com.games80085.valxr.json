ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825575_1145483671184213_5891335041739295990_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR2MU0Tqd9cQ7kNvwGSZ8i8&_nc_oc=Adpi8XOj6mda7SusHn-xbr0xeCUDjtQBD-OBDp8iVnG5MHTS2KhvY_vjNJHTmwmLmck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVudg66YhWyNA3xVQhux9qfadVYR1Vxdu0zfbH-ceRHfw&oe=6B10541D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VALXR", "keywords": ["roguelite", "survivor", "tabletop", "shooter"], "long_description": "VALXR puts a whole survivor roguelite on your table. A tiny hero runs across a diorama world, the ghosts keep coming, and every level-up makes you a little more absurd: faster, bouncier, tougher, bloodthirstier \u2014 until the table is nothing but bullets.\n\nSURVIVE TEN MINUTES\n\u2022 Waves of ghosts, bats, brutes, spitters, chargers, bombers and swarms\n\u2022 Champions at 3:00 and 6:00, a boss portal at 7:00 \u2014 call the boss when you are ready\n\u2022 Clear the stage to unlock the next one\n\nBUILD A RIDICULOUS RUN\n\u2022 Weapons that level up and overload at level 8: guns, swords, orbiting stones, fire and frost trails, mines, lightning\n\u2022 Mutations: poison, burning, ice and shock rounds\n\u2022 Tomes, rare offers, chests with items, shrines, crates and booster drops\n\nEIGHT STAGES\nYard, Moon (half gravity!), Canyon, Sweet Shop, Toy Box, Arcade, Picnic and Board Game \u2014 each with its own crowd and hazards.\n\nSEVEN HEROES\nKIDDO, TIN CAN, FISHSTICK and the Dead Fools Club gang \u2014 BURNS, SMITH, IRON and BEANS with their own guns and skills.\n\nKEEP COMING BACK\nSpend silver in the Workshop, finish quests, unlock heroes and climb three difficulty tiers.\n\nMade for mixed reality: the arena sits on your real table, you play with Touch controllers, seated or standing.", "short_description": "A tabletop survivor roguelite in mixed reality: tiny fools, endless ghosts and a gun upgrade every minute \u2014 on your real table."}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/valxr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": "https://80085.games/valxr/", "website_url": "https://80085.games/valxr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "1676485315806614"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1855915969051140"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_1284666177465283_7991233327068584278_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCTV6XXFThcQ7kNvwH4mYQW&_nc_oc=Ado3eC27watfqKrxDu05MLhz14uamrat2WgomSKbj6db5FDo7HMBUzFZc7BjhTq2A5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7i8r1hnlSZxmWaCQnHhRvBLXldio7fBJuKf7dlZLPWw&oe=6B1050F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VALXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1794426960
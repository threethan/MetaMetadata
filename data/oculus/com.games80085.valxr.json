yAopwzaI79_U5Kl3eZvrUaNR0cahA&oe=6B10556F"}, {"file_name": "1_menu.png", "id": "28615222808156281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_28615222841489611_1724382909059523563_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7rC3a7mXGkQ7kNvwGCqd6C&_nc_oc=AdoMYct_jAYuKLRL1GSEBJxd6f5FcVtewEVSuRM7oxLUNyZRRsT_BISgiRxrDa0qc3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDJtV_Q98OTW2rl7wm808kqOUR4k2ywngbK41PgljMAw&oe=6B10575A"}, {"file_name": "3_crowd.png", "id": "3204798776528743", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_3204798783195409_7385032381900758218_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGV4o050-_EQ7kNvwF8MX1k&_nc_oc=AdqC8UZo1uiDmj7qHVDgZRv5K7qZnZb28DnGj558fHpXHdNfBh8ujCxj2PPccFgnpUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgyBgrGH1N4HEIzrPCqFCjiSDn0RrOu0iTGfi0xYleog&oe=6B103FC1"}, {"file_name": "5_ghosts.png", "id": "1739811553791287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1739811557124620_4509518490268801091_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsF8b4C5EtQQ7kNvwFVPE31&_nc_oc=Adpabdbl-PcFb9tXap-IIswbNWDyaw8KEGQJ229JJ4r6Kt3xEnpJyk9siM7cQ3Kfc-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYYIqSrscYcMpo6iPFittbpRbrfhAQdk1rORVEQdJUDQ&oe=6B10560B"}, {"file_name": "4_table.png", "id": "1145483667850880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825575_1145483671184213_5891335041739295990_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR2MU0Tqd9cQ7kNvwGSZ8i8&_nc_oc=Adpi8XOj6mda7SusHn-xbr0xeCUDjtQBD-OBDp8iVnG5MHTS2KhvY_vjNJHTmwmLmck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVudg66YhWyNA3xVQhux9qfadVYR1Vxdu0zfbH-ceRHfw&oe=6B10541D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VALXR", "keywords": ["roguelite", "survivor", "tabletop", "shooter"], "long_description": "VALXR puts a whole survivor roguelite on your table. A tiny hero runs across a diorama world, the ghosts keep coming, and every level-up makes you a little more absurd: faster, bouncier, tougher, bloodthirstier \u2014 until the table is nothing but bullets.\n\nSURVIVE TEN MINUTES\n\u2022 Waves of ghosts, bats, brutes, spitters, chargers, bombers and swarms\n\u2022 Champions at 3:00 and 6:00, a boss portal at 7:00 \u2014 call the boss when you are ready\n\u2022 Clear the stage to unlock the next one\n\nBUILD A RIDICULOUS RUN\n\u2022 Weapons that level up and overload at level 8: guns, swords, orbiting stones, fire and frost trails, mines, lightning\n\u2022 Mutations: poison, burning, ice and shock rounds\n\u2022 Tomes, rare offers, chests with items, shrines, crates and booster drops\n\nEIGHT STAGES\nYard, Moon (half gravity!), Canyon, Sweet Shop, Toy Box, Arcade, Picnic and Board Game \u2014 each with its own crowd and hazards.\n\nSEVEN HEROES\nKIDDO, TIN CAN, FISHSTICK and the Dead Fools Club gang \u2014 BURNS, SMITH, IRON and BEANS with their own guns and skills.\n\nKEEP COMING BACK\nSpend silver in the Workshop, finish quests, unlock heroes and climb three difficulty tiers.\n\nMade for mixed reality: the arena sits on your real table, you play with Touch controllers, seated or standing.", "short_description": "A tabletop survivor roguelite in mixed reality: tiny fools, endless ghosts and a gun upgrade every minute \u2014 on your real table."}]}, "developer_name": null, "developer_privacy_policy_url": "https://80085.games/valxr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "80085games", "support_website_url": "https://80085.games/valxr/", "website_url": "https://80085.games/valxr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712
nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1-Oj48BUtmJ8WTZybcvZHlLKR8UwRInpZqnPxWYSyDw&oe=6AAD4690"}, {"file_name": "ScreenShot7.png", "id": "742472431918798", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823279_742472435252131_7126778667370268452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQqAXpUPKcQQ7kNvwG1DwVA&_nc_oc=AdqLMy-GElNNMTXgsFHGTBvqDzKg6obLGPyUbfvdRFVZG-CFwj2umaxTPTb0DQ2fAz0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9eJxAFTLE8ybGYuQG036fwUZt3g9tbcdVAhtBqCD8eg&oe=6AAD39C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "659862789446898", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974883_659862792780231_9140222972767105016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qKUQWDNCjQQ7kNvwHgoFeR&_nc_oc=AdqXMH5nTBXkA72UafyHCtL-zhb60RU0SKJsDQb9C0cd9FTUXOS-f4G1bAjouLbp1qY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJBFrsoqh5Ua_b9AS2PYw_DDmjd2W52yL13In8ZADI9w&oe=6AAD4336"}, "display_name": "Alvo", "keywords": ["shooter", "fps", "multiplayer", "zombies", "action"], "long_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. ALVO brings everyone together in one shared battlefield. Your headset doesn\u2019t limit you \u2014 it connects you. \n{4425626997714824}\n# Game Modes\n\nSix modes offering distinct combat styles:\n\n- Training \u2013 Practice against AI.\n- Free\u2011for\u2011All \u2013 Every player for themselves.\n- Team Deathmatch \u2013 Squad\u2011vs\u2011squad firefights.\n- Search and Destroy \u2013 Tactical objective play.\n- Hardpoint \u2013 Hold the zone.\n- Zombies \u2013 Survive waves with your squad.\n\n# Accessibility\n\nALVO is built to adapt to you. Choose between manual or button reloads, customize your HUD elements, and even change the entire UI color theme. Play sitting or standing \u2014 your comfort, your style.\n{1372927717483186}\n# Weapons & Equipment\n\nProgress through the ranks to unlock new gear and expand your arsenal. Customize your loadouts with:\n- Scopes & reticles\n- Lasers & attachments\n- Weapon skins\n- Trinkets & cosmetic upgrades\n\n# Perks\n\nEquip up to two perks to shape your playstyle. Need more stamina? ammo? explosive resistance? Build the advantage that fits your approach to combat.\n\n{1249230507105046}\n# Killstreaks\n\nEarn consecutive kills to unleash powerful support options. Trigger different Killstreaks at 3, 5, and 7 kills to turn the tide of battle.\n{743232781823059}\n# Maps\n\nALVO features 14 core maps plus 4 day/night variants, from tight urban streets to wide\u2011open arenas built for fast VR combat.\n{1433285064828689}\n\nCommunity\u2011made maps are supported through private matches, expanding the fight even further.\n\n{33878166811796747}", "short_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. Alvo delivers fast, addictive VR combat with tight controls, tactical movement, and a full suite of competitive and co\u2011op modes. Jump into intense firefights, master your loadouts, and squad up across platforms in close\u2011quarters maps and objective\u2011based missions."}]}, "developer_name": "OutsideIn Entertainment", "developer_privacy_policy_url": "https://alvogame.com/privacy-policy/", "developer_terms_of_service_url": "https://alvogame.com/terms-of-service/", "publisher_name": "OutsideIn Entertainment", "support_website_url": null, "website_url": "https://alvogame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres":
77_3931829245989234421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQXseTEfT0wQ7kNvwEkK3To&_nc_oc=AdovXmylZGpCQMf6VgAFF0Fty1dpzZRhmRVtUUa6IlkLpFBqXqC4Bso_5rfaSjANefo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NAeR2lZ-XlRj0ih_4-zm0i4NO-VAUJfSqNwS5zjm11A&oe=6A393C7E"}]}, "id": "911685634755770", "locale": "en_US", "screenshots": [{"file_name": "Screenshot4.png", "id": "1224188346518438", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822550_1224188349851771_6592417034097630404_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSnyYqZ41d4Q7kNvwGTfTlj&_nc_oc=AdoIV7dLTTNvSM2QaDsmGYRyN-gCOvZegNmPjlL5PZ8iftElR2guX58LRftXDGiX1SI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uZheVwMa63fW5J07A7Wd3jANcTJBu7_6xsUCp_hFLHA&oe=6A394BE1"}, {"file_name": "ScreenShot1.png", "id": "2889969834525570", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491828583_2889969837858903_2467425102589068871_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6m6sKn26toQ7kNvwE2v7_3&_nc_oc=AdpDrfjvCKiVWU-fRM8NxXttldEvaAYdxE8ycylUvgTx-xH68nhU6xx_4jFw968HqkI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Lr_pSX_hBJsAsletGp-wWiiz8qrm48YFLfeRglFi02A&oe=6A395A9A"}, {"file_name": "ScreenShot3.png", "id": "831970399889469", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491820428_831970406556135_6101885318990959934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBGS6R1Y6bIQ7kNvwFUbTMv&_nc_oc=AdqITN_KrJgEL8yurQSgyH8C5xXYphE4RWxqMv-5F2ZUkFcm-Yrd-xhGczRyX1bcKjs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NjhQnWnF-1tb90bQ_eBkAK1gEd_lQR2dUMSLZva-RKQ&oe=6A39616A"}, {"file_name": "turret 2560X1440.png", "id": "532157545444301", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974512_532157548777634_5042322808907660928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6rIoXXloE8Q7kNvwHY7c0n&_nc_oc=Adow_HOq5qncXEQr_oQyZE419Z1mRvRkLHae2fFDzj0P32u5Sxorp30UFY9_k7vVbG4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89V82CgpIR-TLCz5r3URVLX3iJYnoQj5fCUmyJYDzG5w&oe=6A394290"}, {"file_name": "ScreenShot7.png", "id": "742472431918798", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823279_742472435252131_7126778667370268452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJnZh8DEs5YQ7kNvwFCYyiP&_nc_oc=AdodRD65Ee-wQ4nhFdsNvAiYXNosNqmsqv5e7JDKnsPYWSyRsQcaTYgPFG5o738OYAE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aZS_zBOZJ2pcj_NTgNcX19ea_e8g7rL4ftpEbekFXmw&oe=6A3935C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "659862789446898", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974883_659862792780231_9140222972767105016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSPH46ZHjQYQ7kNvwE0K7UT&_nc_oc=AdrUwqjql28azeuoWh9ycxUtcOSaBR3RQnCcBoZFv4UyKKAF7ETL_466YtJUtXRp22o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iRnd6KMS1T-gY0ul6kQ4Dp-3HG1xYnLtupTmYhqCLCA&oe=6A393F36"}, "display_name": "Alvo", "keywords": ["shooter", "fps", "multiplayer", "zombies", "action"], "long_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. ALVO brings everyone together in one shared battlefield. Your headset doesn\u2019t limit you \u2014 it connects you. \n{4425626997714824}\n# Game Modes\n\nSix modes offering distinct combat styles:\n\n- Training \u2013 Practice against AI.\n- Free\u2011for\u2011All \u2013 Every player for themselves.\n- Team Deathmatch \u2013 Squad\u2011vs\u2011squad firefights.\n- Search and Destroy \u2013 Tactical objective play.\n- Hardpoint \u2013 Hold the zone.\n- Zombies \u2013 Survive waves with your squad.\n\n# Accessibility\n\nALVO is built to adapt to you. Choose between manual or button reloads, customize your HUD elements, and even change the entire UI color theme. Play sitting or standing \u2014 your comfort, your style.\n{1372927717483186}\n# Weapons & Equipment\n\nProgress through the ranks to unlock new gear and expand your arsenal. Customize your loadouts with:\n- Scopes & reticles\n- Lasers & attachments\n- Weapon skins\n- Trinkets & cosmetic upgrades\n\n# Perks\n\nEquip up to two perks to shape your playstyle. Need more stamina? ammo? explosive resistance? Build the advantage that fits your approach to combat.\n\n{1249230507105046}\n# Killstreaks\n\nEarn consecutive kills to unleash powerful support options. Trigger different Killstreaks at 3, 5, and 7 kills to turn the tide of battle.\n{743232781823059}\n# Maps\n\nALVO features 14 core maps plus 4 day/night variants, from tight urban streets to wide\u2011open arenas built for fast VR combat.\n{1433285064828689}\n\nCommunity\u2011made maps are supported through private matches, expanding the fight even further.\n\n{33878166811796747}", "short_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. Alvo delivers fast, addictive VR combat with tight controls, tactical movement, and a full suite of competitive and co\u2011op modes. Jump into intense firefights, master your loadouts, and squad up across platforms in close\u2011quarters maps and objective\u2011based missions."}]}, "developer_name": "OutsideIn Entertainment", "developer_privacy_policy_url": "https://alvogame.com/privacy-policy/", "developer_terms_of_service_url": "https://alvogame.com/terms-of-service/", "publisher_name": "OutsideIn Entertainment", "support_website_url": null, "website_url": "https://alvogame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED",
_519953206009041_6714819998749412993_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pn_IQmpZrP8Q7kNvwGGu9ah&_nc_oc=AdlVUkESDyXPLczNjIXZzdgvXlCSHsIfhr6i5r1UQNjKnH-bH3Tnt85QOXQTL1oS2Og&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYuW5hslsxKrJs5PnqjBM3J8Kc6-5DokqdUHhRP7kSUg&oe=69BD5C78"}, {"file_name": "Screenshot5.png", "id": "335866588439543", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982699_335866591772876_217462098821674707_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrYf_xIbTdEQ7kNvwF4I9dT&_nc_oc=Adkbqwdrwojsdhws8eWwBMT5C128rXvBKeq3dlG-tQiK63NJVOiP0_8iXSjWK0_WQmA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzfrn-7bcJsI8EBqHkePqT25REk8ei1AARmA-lrOP2YtA&oe=69BD4A48"}, {"file_name": "Screenshot4.png", "id": "628730791571518", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984471_628730794904851_8725291579660714601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-fLCQbczloQ7kNvwGw8Egd&_nc_oc=Adk3HPfEhS62lm-9ztP11VV2kGsphNLn507Yio3LbagzQEsrROh2B_sB9oAYpVVyL88&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUVI3KpVGN6qEDVIV-2dt1jQpWf1ubndRit1x7o-1sAQ&oe=69BD39CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_art.png", "id": "664041291446516", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035326_664041294779849_7712559248636671527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHLBVRfPYxoQ7kNvwEIxt4n&_nc_oc=AdmAScYz7eXLGVJf-HELLtZOHhknLxcy2k88n4aAFRj8rALPJYXJdRTGS0ofZAIDzo4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzzbuFyJNcOPXsNAcIu6rdiT4_RVnVcnCq3LUejSI8fDQ&oe=69BD4439"}, "display_name": "Alvo", "keywords": ["shooter", "online", "coop", "fps", "multiplayer"], "long_description": "Feel the heat of battle like never before! \n\nALVO is a fast-paced competitive online VR shooter. Experience a revolution in VR movement as you jump, run, prone and slide around the battlefield.\n\nChoose from a selection of killstreaks, perks and weapons to give you the tactical advantage. \n\nPush yourself up the leaderboard by completing daily or weekly challenges. Unlock more equipment as your rank up through the progression system.\n\nGame Modes:\nTraining Mode (AI only)\nFree For All\nTeam Deathmatch\nSearch & Destroy\nZombies (Coming Soon)\n", "short_description": "Feel the heat of battle like never before! \n\nALVO is a fast-paced competitive online VR shooter. Experience a revolution in VR movement as you jump, run, prone and slide around the battlefield.\n\nChoose from a selection of killstreaks, perks and weapons to give you the tactical advantage. \n\nPush yourself up the leaderboard by completing daily or weekly challenges. Unlock more equipment as your rank up through the progression system."}]}, "developer_name": "Mardonpol Inc", "developer_privacy_policy_url": "https://alvogame.com/privacy-policy/", "developer_terms_of_service_url": "https://alvogame.com/terms-of-service/", "publisher_name": "OutsideIn Entertainment", "support_website_url": null, "website_url": "https://alvogame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "621886292229376"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "25725853703736142"}, {"status": "PUBLISHED", "id": "1620593352451200"}, {"status": "PUBLISHED", "id": "1155071089927218"}, {"status"
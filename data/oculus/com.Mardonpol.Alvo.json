LovyrBpYrEMRA&oe=699D8038"}, {"file_name": "Screenshot5.png", "id": "335866588439543", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982699_335866591772876_217462098821674707_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfi9A1ryDlQQ7kNvwGF1WfN&_nc_oc=AdnX_P10sINMR1NLPvgVQJzb5Id1ctxOaetBEMpkmuIz184BHJWffxD74LSXPac_E1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsKB4WRdT_CxquspBz-iUkeoGwRoznacXppPcsG0E-KwQ&oe=699DA648"}, {"file_name": "Screenshot4.png", "id": "628730791571518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984471_628730794904851_8725291579660714601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHaigffYYzoQ7kNvwEGXC-V&_nc_oc=AdncKgwgTCYr7Iu-x-6-mhn_4yHXqAUmmhvR9g6ntHFoLkQjSnrZrKWGaLdHbnmjb2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMfta7VKXwJ1OyvtOS5AYVjKysFvvoHe--7AKuMQDUeQ&oe=699D95CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_art.png", "id": "664041291446516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_664041294779849_7712559248636671527_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwfFJy9smiMQ7kNvwFPX4iL&_nc_oc=Adm6Qb8-YwgCgIYoh8XwVaUqcMhKvz6VVZ0-d0-a_4vKCKbQTDxnFLBE6dQHS5gvKP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWRrip_XWNqsO4V8xVCCddadozwiCisGBH9ybmMpyuYA&oe=699DA039"}, "display_name": "Alvo", "keywords": ["shooter", "online", "coop", "fps", "multiplayer"], "long_description": "Feel the heat of battle like never before! \n\nALVO is a fast-paced competitive online VR shooter. Experience a revolution in VR movement as you jump, run, prone and slide around the battlefield.\n\nChoose from a selection of killstreaks, perks and weapons to give you the tactical advantage. \n\nPush yourself up the leaderboard by completing daily or weekly challenges. Unlock more equipment as your rank up through the progression system.\n\nGame Modes:\nTraining Mode (AI only)\nFree For All\nTeam Deathmatch\nSearch & Destroy\nZombies (Coming Soon)\n", "short_description": "Feel the heat of battle like never before! \n\nALVO is a fast-paced competitive online VR shooter. Experience a revolution in VR movement as you jump, run, prone and slide around the battlefield.\n\nChoose from a selection of killstreaks, perks and weapons to give you the tactical advantage. \n\nPush yourself up the leaderboard by completing daily or weekly challenges. Unlock more equipment as your rank up through the progression system."}]}, "developer_name": "Mardonpol Inc", "developer_privacy_policy_url": "https://alvogame.com/privacy-policy/", "developer_terms_of_service_url": "https://alvogame.com/terms-of-service/", "publisher_name": "OutsideIn Entertainment", "support_website_url": null, "website_url": "https://alvogame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "621886292229376"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "25725853703736142"}, {"status": "PUBLISHED", "id": "1620593352451200"}, {"status": "PUBLISHED", "id": "1155071089927218"}, {"status": "PUBLISHED", "id": "785275013904880"}, {"status": "PUBLISHED", "id": "1777751049779412"}, {"status": "PUBLISHED", "id": "4103033549929943"}, {"status": "PUBLISHED", "id": "8064614300301785"}, {"status": "PENDING", "id": "229666293322820"}, {"status": "PUBLISHED", "id": "169795839471380"}, {"status": "PU
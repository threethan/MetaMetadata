t=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsbM2a5mQhJPU5-X_IJOAO-DoTOoCmHNpd1c8wght54tg&oe=699C59FE"}]}, "id": "911685634755770", "locale": "en_US", "screenshots": [{"file_name": "Screenshot4.png", "id": "1224188346518438", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822550_1224188349851771_6592417034097630404_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0--OzW7AaoQ7kNvwGK84ID&_nc_oc=AdkbgABDkhL6R1rI6-LuGoshPKrGBjnaDGvJzmpPsTDneELDbau7e8JnrsSgBk8S9gU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft4BzP9U5X5wTWA6fOCRh9HobE2YOoq3nWh3iSPCHD-2Q&oe=699C3121"}, {"file_name": "ScreenShot1.png", "id": "2889969834525570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828583_2889969837858903_2467425102589068871_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA13bWUWCdwQ7kNvwHcgv_V&_nc_oc=AdkH_D009yVgXa9qpyKS38mQYAHrHkI3G33lSg3wdEqSyTfTEnUM-JRxcgqINAqpk20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuyV6vc5u6wk05tfWdj_VIxUgLB1MC5qo_xY5RWBxzw4Q&oe=699C3FDA"}, {"file_name": "ScreenShot3.png", "id": "831970399889469", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820428_831970406556135_6101885318990959934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7woFLp4ncuAQ7kNvwEF-AgY&_nc_oc=Adn75RkAE2Wcx38I8Zf9jAzXhPGD4n4YqzyjToryszzIdNzZp0BW8MoANZhCUBYtF6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs1feo4LgXGd2xX5BYEJAFCVTumtB_dqdY2qMuSFz28Uw&oe=699C46AA"}, {"file_name": "turret 2560X1440.png", "id": "532157545444301", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974512_532157548777634_5042322808907660928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFPQGJ75uuAQ7kNvwH38BKq&_nc_oc=Adn5PPE_6J7COrVqb8ZAkNzbJ6RAv0EDZJrY5K1TYNmmmwvY0oa2oa68GsthTmr8qzE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu-daIzLCb3NxuHw6DyGP1DrzKDH8ebeZVVWVlU1Yr7-g&oe=699C6010"}, {"file_name": "ScreenShot7.png", "id": "742472431918798", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_742472435252131_7126778667370268452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSunIfOQZqwQ7kNvwF8aYNP&_nc_oc=Adm81V1JfZTtcwPT9UGI-TBEK7axMXf2TkThJehhE-423Q0eyB1QVZ0XbYL0BCeBEBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftuS34kULJDhQtvArhYVSCso_UM6bsGjYo2N6Y1qRVcYg&oe=699C5345"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "659862789446898", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974883_659862792780231_9140222972767105016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7pAC8MWhSMQ7kNvwGA-oEv&_nc_oc=AdnYncqoFFQFwFtfOASOhuBK1NQ58mQWGBK3BM7bhaB8WDTj9fXFX5Yw5CyFWaBr-W4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvHTmpp8Fd8lcAz7My-Sx_ywToy9_zyboiNO71SrpghtQ&oe=699C5CB6"}, "display_name": "Alvo", "keywords": ["shooter", "fps", "multiplayer", "zombies", "action"], "long_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. ALVO brings everyone together in one shared battlefield. Your headset doesn\u2019t limit you \u2014 it connects you. \n{4425626997714824}\n# Game Modes\n\nSix modes offering distinct combat styles:\n\n- Training \u2013 Practice against AI.\n- Free\u2011for\u2011All \u2013 Every player for themselves.\n- Team Deathmatch \u2013 Squad\u2011vs\u2011squad firefights.\n- Search and Destroy \u2013 Tactical objective play.\n- Hardpoint \u2013 Hold the zone.\n- Zombies \u2013 Survive waves with your squad.\n\n# Accessibility\n\nALVO is built to adapt to you. Choose between manual or button reloads, customize your HUD elements, and even change the entire UI color theme. Play sitting or standing \u2014 your comfort, your style.\n{1372927717483186}\n# Weapons & Equipment\n\nProgress through the ranks to unlock new gear and expand your arsenal. Customize your loadouts with:\n- Scopes & reticles\n- Lasers & attachments\n- Weapon skins\n- Trinkets & cosmetic upgrades\n\n# Perks\n\nEquip up to two perks to shape your playstyle. Need more stamina? ammo? explosive resistance? Build the advantage that fits your approach to combat.\n\n{1249230507105046}\n# Killstreaks\n\nEarn consecutive kills to unleash powerful support options. Trigger different Killstreaks at 3, 5, and 7 kills to turn the tide of battle.\n{743232781823059}\n# Maps\n\nALVO features 14 core maps plus 4 day/night variants, from tight urban streets to wide\u2011open arenas built for fast VR combat.\n{1433285064828689}\n\nCommunity\u2011made maps are supported through private matches, expanding the fight even further.\n\n{33878166811796747}", "short_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. Alvo delivers fast, addictive VR combat with tight controls, tactical movement, and a full suite of competitive and co\u2011op modes. Jump into intense firefights, master your loadouts, and squad up across platforms in close\u2011quarters maps and objective\u2011based missions."}]}, "developer_name": "OutsideIn Entertainment", "developer_privacy_policy_url": "https://alvogame.com/privacy-policy/", "developer_terms_of_service_url": "https://alvogame.com/terms-of-service/", "publisher_name": "OutsideIn Entertainment", "support_website_url": null, "website_url": "https://alvogame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
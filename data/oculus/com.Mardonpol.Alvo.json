77_3931829245989234421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQXseTEfT0wQ7kNvwHGwMPc&_nc_oc=Adrt1rjBk7Z0g09te7qiExeMfl8h3pN07fk6H1LRP72Fx7_ms77jdhgV8yjoCNtEro8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mPil0z_TNA3f2_5QkeNcyKAW2Qa24GFSd08Qp_MOWWg&oe=6A36997E"}]}, "id": "911685634755770", "locale": "en_US", "screenshots": [{"file_name": "Screenshot4.png", "id": "1224188346518438", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822550_1224188349851771_6592417034097630404_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSnyYqZ41d4Q7kNvwGvP0Gf&_nc_oc=Adq4PQxl5SDylswaKm11B9prEkiiw5oG456YQ1XtNpdwm7ryzYehYJuhcjlZBpqW6Gk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90E1es6Fa5AGM-8UjxTPK3phP6_H8-TumJXGW1XlsQig&oe=6A36A8E1"}, {"file_name": "ScreenShot1.png", "id": "2889969834525570", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491828583_2889969837858903_2467425102589068871_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygKuYyeh36UQ7kNvwFxoAvb&_nc_oc=Adrrp6BIoUZCIG-k16NGgf3sB-KJEy3XUPBNPJ_BAa4lWdrSV4_HXkofubqqZQWeQlQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cqp1uDoniqIwkNEW1uylGpdN7qxanflXIx6BRiNQelw&oe=6A36B79A"}, {"file_name": "ScreenShot3.png", "id": "831970399889469", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491820428_831970406556135_6101885318990959934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZV2Qu2_X3kQ7kNvwE5HpqF&_nc_oc=AdolYFL-BwfAnVvJP6lRpuzIKVHIdyYli60WbRCRBBSiwjoMd4LTKXZU6spHKSgdngo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9caogk5Ms9uang_eG-CJidfYJ6GT3uAFj57JIiMkOU4A&oe=6A36BE6A"}, {"file_name": "turret 2560X1440.png", "id": "532157545444301", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974512_532157548777634_5042322808907660928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6rIoXXloE8Q7kNvwFgRYxu&_nc_oc=AdpQDuMo5JVgTrButmOBBfRvSe2nyO09zAkQvKIk9EMoFVUVBy6AzvM2G2YyAuSUdF8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TEPhAtedccNQ87hptjzX-3mTRKqWa8eXscBp1Op1N-A&oe=6A369F90"}, {"file_name": "ScreenShot7.png", "id": "742472431918798", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823279_742472435252131_7126778667370268452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZQUhwklwPsQ7kNvwHGLk7J&_nc_oc=AdoOsZOGhnFd251__9yeVQ6zCbOv0rQ5c7NFpd51lpZ5jQYcorqqZ71OrmlC5wjs3gQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XSOXSDMq6p0hxENWxJX-r8BjI1l7TtRJjfazbnt1uKA&oe=6A3692C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "659862789446898", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974883_659862792780231_9140222972767105016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSPH46ZHjQYQ7kNvwEa07H4&_nc_oc=Adok9NWMlc_1f9OChuOfTQMTA4dsxuzZ-tOTkwbqzBs78Vnv9HWzUyE1uJlZKRXLNds&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qhHiHxniVECkol-2JMvQNl3u0cGtqnNuxkfqNFbLaBA&oe=6A369C36"}, "display_name": "Alvo", "keywords": ["shooter", "fps", "multiplayer", "zombies", "action"], "long_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. ALVO brings everyone together in one shared battlefield. Your headset doesn\u2019t limit you \u2014 it connects you. \n{4425626997714824}\n# Game Modes\n\nSix modes offering distinct combat styles:\n\n- Training \u2013 Practice against AI.\n- Free\u2011for\u2011All \u2013 Every player for themselves.\n- Team Deathmatch \u2013 Squad\u2011vs\u2011squad firefights.\n- Search and Destroy \u2013 Tactical objective play.\n- Hardpoint \u2013 Hold the zone.\n- Zombies \u2013 Survive waves with your squad.\n\n# Accessibility\n\nALVO is built to adapt to you. Choose between manual or button reloads, customize your HUD elements, and even change the entire UI color theme. Play sitting or standing \u2014 your comfort, your style.\n{1372927717483186}\n# Weapons & Equipment\n\nProgress through the ranks to unlock new gear and expand your arsenal. Customize your loadouts with:\n- Scopes & reticles\n- Lasers & attachments\n- Weapon skins\n- Trinkets & cosmetic upgrades\n\n# Perks\n\nEquip up to two perks to shape your playstyle. Need more stamina? ammo? explosive resistance? Build the advantage that fits your approach to combat.\n\n{1249230507105046}\n# Killstreaks\n\nEarn consecutive kills to unleash powerful support options. Trigger different Killstreaks at 3, 5, and 7 kills to turn the tide of battle.\n{743232781823059}\n# Maps\n\nALVO features 14 core maps plus 4 day/night variants, from tight urban streets to wide\u2011open arenas built for fast VR combat.\n{1433285064828689}\n\nCommunity\u2011made maps are supported through private matches, expanding the fight even further.\n\n{33878166811796747}", "short_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. Alvo delivers fast, addictive VR combat with tight controls, tactical movement, and a full suite of competitive and co\u2011op modes. Jump into intense firefights, master your loadouts, and squad up across platforms in close\u2011quarters maps and objective\u2011based missions."}]}, "developer_name": "OutsideIn Entertainment", "developer_privacy_policy_url": "https://alvogame.com/privacy-policy/", "developer_terms_of_service_url": "https://alvogame.com/terms-of-service/", "publisher_name": "OutsideIn Entertainment", "support_website_url": null, "website_url": "https://alvogame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED",
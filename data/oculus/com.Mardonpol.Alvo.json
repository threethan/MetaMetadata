t=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuW8la4nZ0CVmU4qcg363XXZGUD80JIDqvxuLmCOt5cgQ&oe=69A442FE"}]}, "id": "911685634755770", "locale": "en_US", "screenshots": [{"file_name": "Screenshot4.png", "id": "1224188346518438", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822550_1224188349851771_6592417034097630404_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuFYc80g1WQQ7kNvwFdbc81&_nc_oc=AdnlHuHe4sYAc0Md6topqx3rarf-WcnZIcBFXjyy2IzXqK9NcketQY92TIpqoxaWyVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvkQxrtVVYKmj5MCnE55Po7U9AhUH6n_C_I9uMeq1Mrgw&oe=69A41A21"}, {"file_name": "ScreenShot1.png", "id": "2889969834525570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828583_2889969837858903_2467425102589068871_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2YvYosVDxMQ7kNvwHzUwXs&_nc_oc=AdkeF70wweHB1OwzMoaVyid05aZ3M17Bku4q3JkokFj5y66ByTd-pVWN_nksJvN-tF8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsnsOxRX_o3XxYXzIELqStl-LULS7Vizc_6ywNmYbyu_g&oe=69A428DA"}, {"file_name": "ScreenShot3.png", "id": "831970399889469", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820428_831970406556135_6101885318990959934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=245Nsndv6GwQ7kNvwFsVhS7&_nc_oc=AdlasSaSpXTgZY1pc_YhsC2OZxNZSN5Y6UUy1WXIYgppVNmogYI1GE9Zj8aGRQmp0d0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvjI-YyWB4n6vwX1dFJCKGIVahKm0oq_eoci8IImuiIgQ&oe=69A42FAA"}, {"file_name": "turret 2560X1440.png", "id": "532157545444301", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974512_532157548777634_5042322808907660928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4NdUEPhG_gQ7kNvwEr0uiF&_nc_oc=AdkOPIvdHQcTmWQOyeYDvplm2OU6YKJPDOQqh59ilsJg3Gu0PxledGs90i5b1oPHETk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftxgfBfGSxzMhQPUwdkgX75Ou2Z1lcJUUBzgX86LKzw-g&oe=69A44910"}, {"file_name": "ScreenShot7.png", "id": "742472431918798", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_742472435252131_7126778667370268452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nlKuKEEdv4Q7kNvwEWi4NN&_nc_oc=Adk8CzJVt182cNYfUHOtyQS7nrV11F9Vc5VOK2yY66Dzbb9-I-xOgUf7kErVqK1-ZII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvLjl0FglDOR-wvFhil9twouvP1KiSZ-1935RgI5l-Wzw&oe=69A43C45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "659862789446898", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974883_659862792780231_9140222972767105016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z1WSzOXyMoQ7kNvwFfcRLn&_nc_oc=AdkUueXKDvHoq6lYRAtGxmGx-Mv3UlSk1CmJBjbT-RTs7goo22UygeET27siu6lj0Xo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvv29se9WrESdPwoM7CT_6u3CAkurFcCrAZcRC6zPQvHw&oe=69A445B6"}, "display_name": "Alvo", "keywords": ["shooter", "fps", "multiplayer", "zombies", "action"], "long_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. ALVO brings everyone together in one shared battlefield. Your headset doesn\u2019t limit you \u2014 it connects you. \n{4425626997714824}\n# Game Modes\n\nSix modes offering distinct combat styles:\n\n- Training \u2013 Practice against AI.\n- Free\u2011for\u2011All \u2013 Every player for themselves.\n- Team Deathmatch \u2013 Squad\u2011vs\u2011squad firefights.\n- Search and Destroy \u2013 Tactical objective play.\n- Hardpoint \u2013 Hold the zone.\n- Zombies \u2013 Survive waves with your squad.\n\n# Accessibility\n\nALVO is built to adapt to you. Choose between manual or button reloads, customize your HUD elements, and even change the entire UI color theme. Play sitting or standing \u2014 your comfort, your style.\n{1372927717483186}\n# Weapons & Equipment\n\nProgress through the ranks to unlock new gear and expand your arsenal. Customize your loadouts with:\n- Scopes & reticles\n- Lasers & attachments\n- Weapon skins\n- Trinkets & cosmetic upgrades\n\n# Perks\n\nEquip up to two perks to shape your playstyle. Need more stamina? ammo? explosive resistance? Build the advantage that fits your approach to combat.\n\n{1249230507105046}\n# Killstreaks\n\nEarn consecutive kills to unleash powerful support options. Trigger different Killstreaks at 3, 5, and 7 kills to turn the tide of battle.\n{743232781823059}\n# Maps\n\nALVO features 14 core maps plus 4 day/night variants, from tight urban streets to wide\u2011open arenas built for fast VR combat.\n{1433285064828689}\n\nCommunity\u2011made maps are supported through private matches, expanding the fight even further.\n\n{33878166811796747}", "short_description": "Crossplay with all major VR headsets.\n\nA high\u2011octane multiplayer shooter built for players who want speed, strategy, and seamless cross\u2011platform action. Alvo delivers fast, addictive VR combat with tight controls, tactical movement, and a full suite of competitive and co\u2011op modes. Jump into intense firefights, master your loadouts, and squad up across platforms in close\u2011quarters maps and objective\u2011based missions."}]}, "developer_name": "OutsideIn Entertainment", "developer_privacy_policy_url": "https://alvogame.com/privacy-policy/", "developer_terms_of_service_url": "https://alvogame.com/terms-of-service/", "publisher_name": "OutsideIn Entertainment", "support_website_url": null, "website_url": "https://alvogame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
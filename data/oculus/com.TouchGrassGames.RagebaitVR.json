57_981018417830368_1475984031307826017_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-s1iz6iIR4Q7kNvwEN_YL6&_nc_oc=AdqcR_GTXBvI9zHP35ChdoxljKVb4qSREtLXa3DFOTPZatgFnYsToCp-_FeasjmeTrI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR6MQCorZE8MZK-SbzS6db-T8j-hbgtZRSw0zjZDAGaw&oe=6AFC90F0"}]}, "id": "999012972928056", "locale": "en_US", "screenshots": [{"file_name": "ragesmoke-1-crop.png", "id": "29500839479606638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_29500839489606637_9208546019658205638_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0khdWMnfXoQ7kNvwFKj02h&_nc_oc=Adonb1qrXuTdmuxoNKpo3E8mTOg-jqrx_izniIcytCOy58EFw7dP38ntzlvTzhD-HkI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREG-gRGPpAW1XxSw5-ERzDv8Y8rvdOnUO7jqvTjkc2eA&oe=6AFC69C2"}, {"file_name": "chat-valid.png", "id": "1890588442123505", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1890588445456838_7574294269610935164_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHKzOpMXBp0Q7kNvwGxlHYS&_nc_oc=AdoqNnigaAVh2xUM_Wiq38FS4q-_2EQemkhZvKBSSxASkRo1rCr--DhivnmN1JGk2FA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzMI7nKFBfg1MxQYWr-kKY9mlBkBkFu5oNR00poLOPIQ&oe=6AFC8227"}, {"file_name": "mission-text.png", "id": "1858941141760180", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824665_1858941145093513_6156766424078718290_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLZkQ6ZCdRkQ7kNvwEF-j1b&_nc_oc=AdpeW143puTjqsZw7RzikjPvZ_pZ3zrc0sF1K37E5zPZsCmnOlXq9K66sVC6Cq0embw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUh-7gCib0rBx8d-d8lGQUKsn8BLR41R4raTNPBl3IQg&oe=6AFC903E"}, {"file_name": "tools1.png", "id": "3281764985545643", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825345_3281764988878976_824490916442647143_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7yyuEnXj6UQ7kNvwEfTZfu&_nc_oc=AdrAkL3NSA4jaYg_bxcgm7NhlMm6zQYeanKW1lbHp3zfeQ7hoFtGGkFh8MCl4oKu01w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL6CTC3lzMoxT6tcNz2f4ZYQRaVO1SBakPA5iR5UpWaQ&oe=6AFC6A04"}, {"file_name": "devil-1.png", "id": "1164338352591576", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596061819_1164338355924909_2889789150413265839_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQD7yzgKmwAQ7kNvwHKAfyp&_nc_oc=AdqF1Zk46VBtpSasCncl6AW7pZ7maanlgNMDxotPZHFRZa6p60aoSY3ZmnHA5byldks&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjzMZyLh2L1o7fQCzfsBOGDeqqP9LauD3R_qTrnwU7ug&oe=6AFC7AE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rage Bait VR", "keywords": ["sandbox", "streamer", "simulator", "physics"], "long_description": "Your chat has terrible ideas. Make them happen.\n\nBecome a street streamer in Rage Bait, a chaotic VR sandbox where every passerby is a chance to put on a show. Be generous, pull outrageous pranks, or become an absolute menace.\n{1167788655677034}\n\n**TAKE ON CHAT'S CHALLENGES**\n\nComplete missions from viewers and donors to earn cash. Buy new gadgets, dream up bigger stunts, and bring in more views.\n{1768972650880640}\n\n\n**MAKE SOMEONE'S DAY. OR RUIN IT.**\n\nHand out gifts, mess with food, draw on faces, or reach for weapons and explosives. Unlock more items as you play and use them together to create ridiculous situations.\n{1456458866441918}\n\n**MEET YOUR NEXT BAD IDEA**\n\nCall over a chef or a rapper with a radio. Get your hands on a web shooter. Give the chicken mascot a fiery makeover. And when haters interrupt? Smash their messages.\n{1656402479558737}\n\n{2114041159317849}\n\nMore missions. More money. More gadgets. More views.\nGo live. Get paid. Cause chaos.\n\n{3291735584353689}", "short_description": "Become a street streamer in a chaotic VR sandbox. Complete chat missions, earn cash, and buy ridiculous gadgets to bring in more views. Give strangers gifts, pull outrageous pranks, draw on faces, or reach for the explosives. Smash hater messages and work your way toward streaming stardom. How far will you go to entertain your viewers?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kalank.games/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Kalank", "support_website_url": null, "website_url": "https://kalank.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998174383129268"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2703522150066716"}]}, "baseline_offer": {"id": "2703522150066716"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794499500, "status": "PUBLISHED", "id": "2703522150066716"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1118246867788685", "version": "0.2.4"}, "id": "1879860959360850", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "998174379795935", "is_concept": false, "latest_
878976_824490916442647143_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SN1A1d2Ol6UQ7kNvwE9CIHV&_nc_oc=Ado3Mb-XpjHy0uaUDQ2YsrPFTHWcLE5TXbEsS3dv81cQFbSfeomrlmO36869_WTs3BI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdVJclB-6PegeQ__6aqv3iB1oU5Q1Bu_21Od1X-Knv3g&oe=6B05A484"}, {"file_name": "devil-1.png", "id": "1164338352591576", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596061819_1164338355924909_2889789150413265839_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtAreA9w3OAQ7kNvwGSJTwU&_nc_oc=AdpA4jMBzNL9fZG-VHASA3unjRu7kgAAclmh9tWYhx4OloABxnZg9DzyN52IwTkNTsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkB96sW8yMkRRfiIe1fgfKxxuyGLVdxedbeeoJGVJ20A&oe=6B05B565"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rage Bait VR", "keywords": ["sandbox", "streamer", "simulator", "physics"], "long_description": "Your chat has terrible ideas. Make them happen.\n\nBecome a street streamer in Rage Bait, a chaotic VR sandbox where every passerby is a chance to put on a show. Be generous, pull outrageous pranks, or become an absolute menace.\n{1167788655677034}\n\n**TAKE ON CHAT'S CHALLENGES**\n\nComplete missions from viewers and donors to earn cash. Buy new gadgets, dream up bigger stunts, and bring in more views.\n{1768972650880640}\n\n\n**MAKE SOMEONE'S DAY. OR RUIN IT.**\n\nHand out gifts, mess with food, draw on faces, or reach for weapons and explosives. Unlock more items as you play and use them together to create ridiculous situations.\n{1456458866441918}\n\n**MEET YOUR NEXT BAD IDEA**\n\nCall over a chef or a rapper with a radio. Get your hands on a web shooter. Give the chicken mascot a fiery makeover. And when haters interrupt? Smash their messages.\n{1656402479558737}\n\n{2114041159317849}\n\nMore missions. More money. More gadgets. More views.\nGo live. Get paid. Cause chaos.\n\n{3291735584353689}", "short_description": "Become a street streamer in a chaotic VR sandbox. Complete chat missions, earn cash, and buy ridiculous gadgets to bring in more views. Give strangers gifts, pull outrageous pranks, draw on faces, or reach for the explosives. Smash hater messages and work your way toward streaming stardom. How far will you go to entertain your viewers?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kalank.games/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Kalank", "support_website_url": null, "website_url": "https://kalank.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998174383129268"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1772366177176941"}, {"status": "PUBLISHED", "id": "2703522150066716"}]}, "baseline_offer": {"id": "2703522150066716"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1772366177176941"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1122565100690195", "version": "0.2.5"}, "id": "1879860959360850", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary",
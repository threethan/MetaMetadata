n.com/v/t64.5771-25/499303790_1159688486533002_3485466242016177459_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRXxykiGVFQQ7kNvwGAOVAv&_nc_oc=Adp7BTiPHf9NBz5VwB6EOK0cRYejJgojTMpeGhKpjnBZyeP-Em161V7ChsBgfbwmJ0I&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkXis-UgGv2f1FnYYghxv2t0jcIDW2waZ_Abf01XwrTA&oe=6AFF34EB"}, {"file_name": "devil-1.png", "id": "1164338352591576", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596061819_1164338355924909_2889789150413265839_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxWjh9eXHdYQ7kNvwET7adt&_nc_oc=Adot2yLZvQ257OMGJDmCMRXzq3ovTe9a0evizOkrMXzVSwdbnyLy40WUBycKW8E4Kkw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ708_VWBqu8vpffJQClDNBkwRlwexbg5HyjucbuqiJA&oe=6AFF1DE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1444633130469033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303976_1444633133802366_3454545298135380515_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhiEgY3FSZMQ7kNvwFEyxOS&_nc_oc=Adp7Glk6g6KV_bbXalZcpcGZ59jkw2weNvd9Cs2UrQo9uQc8enVykpeQTWd31pTcEWo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDAzXoJWOZpd6IrnDd2iU9akLPVfF2ftKNgNpu8YCcfw&oe=6AFF0688"}, "display_name": "Rage Bait VR", "keywords": ["sandbox", "streamer", "simulator", "physics"], "long_description": "\ud83d\udcacJoin our Discord: https://discord.gg/4jWEFEtR3W\n\n**ANYTHING FOR VIEWS.**\n\nBecome a streamer and turn your spot on the sidewalk into a show. Stop passersby. Pull ridiculous pranks. Give your virtual chat something to talk about.\n\n{1167788655677034}\n\n**\ud83d\ude21 STRANGERS. STUNTS. STEAMING EARS.**\n\nPinch a nose. Squeeze an ear. Make someone rage until their face turns red and their ears steam. Or make them laugh, trade with them, and send them jumping for joy. Every passerby is your next guest.\n{1768972650880640}\n\n\n**\ud83d\udcac GIVE CHAT A SHOW**\n\nYour in-game chat reacts to your antics. The busier the show, the more views roll in. Smash red hate messages and complete viewer missions to earn cash.\n{1456458866441918}\n\n**\ud83e\uddf0 GET PAID. BUY BAD IDEAS.**\n\nUnlock gadgets, tools, and weapons for your next stunt. Overfeed your guests. Try a web shooter. Bring out the explosives. Mix physics, props, and characters who interact with each other. See how absurd things get.\n{1656402479558737}\n**\ud83c\udfa5 YOUR DRONE. YOUR HIGHLIGHTS.**\n\nYour camera drone follows the action. Record gameplay videos, save them to your headset, and share your wildest moments.\n\n{2114041159317849}\n\nThe street is watching. Make a scene.\n\n{3291735584353689}", "short_description": "Go live in VR, prank strangers, entertain your virtual chat, and earn cash for wild gadgets and bigger stunts."}]}, "developer_name": "Virtuallyz Gaming", "developer_privacy_policy_url": "https://docs.google.com/document/d/10ynV_t_JCuVCkhxuenzf3qoD_0m-RRiF852ORVHTCOA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kalank", "support_website_url": null, "website_url": "https://kalank.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1118643281082377"}, "review_messages": []}]}, "cover_square_im
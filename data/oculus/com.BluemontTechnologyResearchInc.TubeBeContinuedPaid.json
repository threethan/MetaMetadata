t1.png", "id": "1684914218616622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982461_1684914221949955_919699298469913251_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvPRpU16l_8Q7kNvwEVAAJB&_nc_oc=AdrRyuC72UbPcSYn3jJQ8aLBnRtq_kP46kSSQsay-uZj-lmMmC3bvQ413ZKp9gkD_Og&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp9PyFb-OjbFO8Rhbb_mMoISwXhKfR2jT7SgaaPSOWSQ&oe=6AA2AF92"}, {"file_name": "TBC_Screenshot_4.png", "id": "519266073474488", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375748_519266076807821_8045448898191053951_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYA2pc1UPuAQ7kNvwGy3-0f&_nc_oc=Adq4eFAhlJLPJMgoACx44mQLPUzyVK19akPHv9IRF3JzfS9NALZlyOmX2yJRyOr5xFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBsnxrF34mE0jk0pcEEivRj1a8j6FD1XU8yFjQQryAdw&oe=6AA2CB31"}, {"file_name": "TBC_BB_Screenshot2.png", "id": "617153450483596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035422_617153453816929_8197618131681588935_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khcK1h8PdPUQ7kNvwFR50xq&_nc_oc=Adq2XPiewpua_ZJrQvdWm6QG-2yan7EuYx9sNj_fJpK0DPpxw-dG6yIQ5so9_FdTRp0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs9Oqgh7Dtd8FfDoKqNy-GtHrF6QxofbnP6s4h37glDQ&oe=6AA2B1A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_Landscape.png", "id": "1933231860214727", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_1933231863548060_6384280158781549633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Magx2lAEcisQ7kNvwFS0CLd&_nc_oc=AdqEmr5XAUL1z9XDnM_8E7BM36-76_Xf1Ph8-YkpAfIVnG0aiVH_GyMGlzHI-Ot2vgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEZvjrDZ3DhE3Up7_Kiyvxw4gsoMawU14zvc0z2W0lBw&oe=6AA2C68B"}, "display_name": "Tube Be Continued", "keywords": ["puzzle", "funny", "cute", "story", "pet"], "long_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nTUBE-Based Benefits:\n\u2022 60 levels across 3 themed floors: Hamster Hangout, Smart Home Slide & Bakery Blitz!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for TUBE-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
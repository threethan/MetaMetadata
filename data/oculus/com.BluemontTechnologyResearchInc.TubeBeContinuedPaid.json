5/75375748_519266076807821_8045448898191053951_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMz6qevoMmQQ7kNvwG5C24B&_nc_oc=AdmRuD8uS3WMKGmMlnFZeLwVje8Zid9IX1t9cta404JOz-cOfJ-gz-Q37v1dLQVWCN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afss2jKdPZsFwPJk_iZUh7AwBbPZi2ugHHcc0aJNub7JlQ&oe=699D89F1"}, {"file_name": "TBC_Screenshot_5.png", "id": "534683531427842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207242_534683534761175_3645941125310694907_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyBnJRtzsTkQ7kNvwEQPFJp&_nc_oc=AdlWaMgMbDmRNx93rffNdWOqdqoNOY_IaQsvcJ_7KhXaGdlYOn-ZP1axjCaUwTbKpn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuq20O8j4X-FJT3bM0OClZ1wAEZ_Z1guxPDde7Ag0UEGQ&oe=699D7F43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_Landscape.png", "id": "1933231860214727", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_1933231863548060_6384280158781549633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8So4Fqxq4kQ7kNvwHuZS1K&_nc_oc=Adnb20B2HVGT6JPoDn3Disq7LHXpRRD1dTHQX6p3I-hv3z1ozxW10kwuPmNp7TeIoAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuzDArVkKmGj0XD30LXMCHnhWPiSroD270NUdSYMZgRkA&oe=699D854B"}, "display_name": "Tube Be Continued", "keywords": [], "long_description": "Hello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nTUBE-Based Benefits:\n\u2022 40 levels across 2 themed floors: Hamster Hangout & Smart Home Slide!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for TUBE-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "Hello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "533221968811847"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1264427201675364"}, {"status": "PUBLISHED", "id": "749677577708507"}, {"status": "PUBLISHED", "id": "1753228065589317"}, {"status": "PUBLISHED", "id": "981173830508688"}, {"status": "PUBLISHED", "id": "404314041793201"}]}, "baseline_offer": {"id": "404314041793201"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761325200, "status": "PUBLISHED", "id": "1264427201675364"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__t
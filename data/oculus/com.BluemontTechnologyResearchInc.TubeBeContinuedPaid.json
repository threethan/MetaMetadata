t1.png", "id": "1684914218616622", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982461_1684914221949955_919699298469913251_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUDryfJHjLwQ7kNvwFJgWsE&_nc_oc=AdrPukD-GucmKX86Hgyd52NWOqQz2hxhonI4sAkzT_EeF8RhesdLGjSdtaVeuyQZ2rI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwNDCUhte_fnhxd225h343-V3IFVxRm_a-HrrNdqtkjw&oe=6A772E12"}, {"file_name": "TBC_Screenshot_4.png", "id": "519266073474488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375748_519266076807821_8045448898191053951_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CECpP3xGTwQ7kNvwG10q5f&_nc_oc=AdqwBXCeKD4ZXNlpHoaGcXvq5IJFY_Ek-IppnZ6YwzI6yKsLut_Bk9cLwb_yPnQoNnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA4M8NFOXgA0aKKJDUDtUneW5pHnERrdTRXEscMG96bw&oe=6A771171"}, {"file_name": "TBC_BB_Screenshot2.png", "id": "617153450483596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035422_617153453816929_8197618131681588935_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4GYcBtBMI4Q7kNvwHbUWdV&_nc_oc=AdpV4mT0cmexvHnVh5IhERzbhH9zQCzEJjjk2FLaAoC3SM1yFqCD29xuSex2GMX-IP0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7cA4UbZmD1ULWxCCvC7PoJywP7-OMIJPSC3Vy1NlAJA&oe=6A773029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_Landscape.png", "id": "1933231860214727", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_1933231863548060_6384280158781549633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld-69NI-J2MQ7kNvwHfmTDu&_nc_oc=AdqjuFTIoKQJPPfokaRUKy96VljDKtcrmb4Adn0gtRaOMOWe7V3XKibWkFqhuoCGSgk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6zWMOQBBwXEmqpfGb_iO4eSFh5OTxtNrzrR7C3akERw&oe=6A77450B"}, "display_name": "Tube Be Continued", "keywords": ["puzzle", "funny", "cute", "story", "pet"], "long_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nTUBE-Based Benefits:\n\u2022 60 levels across 3 themed floors: Hamster Hangout, Smart Home Slide & Bakery Blitz!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for TUBE-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
955_919699298469913251_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFMpcyetM8oQ7kNvwF2W0ED&_nc_oc=AdnTBu2r9tjXUKvNPkUb0GlCFQ_s0-rrrRe_mN6hz2-N4-H1p-YZkOdxmes8euqQvAs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfswMH036U27IK9mGYB6jwCot3pNoSxnXR9Fz7lZlxBT3g&oe=699B0392"}, {"file_name": "TBC_Screenshot_4.png", "id": "519266073474488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_519266076807821_8045448898191053951_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acGa1wCFhxoQ7kNvwGY1g02&_nc_oc=AdmYbvmKoItFmNAyayG-1m7wPsWXWWuG6Frwtzqa0m15j8XKy6xl1CTqLqP_VeTgej4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuPX_coD98CM30qcQbccQnWuzfSP3IUu6-vvN2eT7w9zA&oe=699AE6F1"}, {"file_name": "TBC_BB_Screenshot2.png", "id": "617153450483596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035422_617153453816929_8197618131681588935_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1f1C06WZqYQ7kNvwFBjRqw&_nc_oc=AdkXiwYwA5udlJlM8cPWRl186aKZd9RXtff4XfQCakTktia09DWW-BSKxBTJ2bGLsWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfulAJzoNe7gu-EcOWfOvQrAx_8l8qwtlnMStWwvk4Vy2g&oe=699B05A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_Landscape.png", "id": "1933231860214727", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_1933231863548060_6384280158781549633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8So4Fqxq4kQ7kNvwEeTy6-&_nc_oc=Adl8VoOSwuovcOtTCVLKFMJR0dxymoAdiRKSS_VL0Dgpa2QRi-6jsSv8lbSqDOxeF0U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsPbA_iZdjI86IEN40NtCkVrI3o1O8sdTC2jRj0I7Zm_A&oe=699AE24B"}, "display_name": "Tube Be Continued", "keywords": ["puzzle", "funny", "cute", "story", "pet"], "long_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nTUBE-Based Benefits:\n\u2022 60 levels across 3 themed floors: Hamster Hangout, Smart Home Slide & Bakery Blitz!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for TUBE-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_trackin
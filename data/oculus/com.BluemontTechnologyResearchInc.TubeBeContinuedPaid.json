t1.png", "id": "1684914218616622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982461_1684914221949955_919699298469913251_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii-IAy0YwrEQ7kNvwGmgTpb&_nc_oc=AdoocYpN0NGtsqmq5ZGxpmkI9GQqb8NZCqfbZmpZkWtYRoxUrB5csJH4cmeMF4JDTh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH-2J2SS877jlTTp1XdktQcrK5T08saXyXk1UMvyhIWQ&oe=6AB3D312"}, {"file_name": "TBC_Screenshot_4.png", "id": "519266073474488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_519266076807821_8045448898191053951_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVeqEozesRQQ7kNvwGey8qg&_nc_oc=AdpAF_MXjZmQEWCiBRL-Kx4G8cZKrTMy82A_71xcHcBhe7h6gZrcC7bc8bCwNUFVx_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIym-K0-c6uAjKOJ0APgAtiYtQ-TEFGcQgnWzzZ4k0rSw&oe=6AB3EEB1"}, {"file_name": "TBC_BB_Screenshot2.png", "id": "617153450483596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035422_617153453816929_8197618131681588935_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYkjABmns7UQ7kNvwEsJgDc&_nc_oc=Adoop-1XVff_HlfsAqyJ_IQsbgEw_ga6VsI-GkRH5GYQ9CanYHpeAlg-80fRtuADU-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI5_h1WJAL929AoanJsEL8BUfR_Hh0xxGET74C16SDNQ&oe=6AB3D529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_Landscape.png", "id": "1933231860214727", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_1933231863548060_6384280158781549633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WA4Jx2sqfCAQ7kNvwEI4008&_nc_oc=Ado8_CISNAydMjWpYF3z_7dfwj0_RQIYh2B80RxrCxZkD9Y1lD9rzYMtc2fpPKkbUKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6xxLMRMOzUXocxpS385d2gK4gAdh3LHnWLHH87NRk9A&oe=6AB3EA0B"}, "display_name": "Tube Be Continued", "keywords": ["puzzle", "funny", "cute", "story", "pet"], "long_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nTUBE-Based Benefits:\n\u2022 60 levels across 3 themed floors: Hamster Hangout, Smart Home Slide & Bakery Blitz!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for TUBE-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
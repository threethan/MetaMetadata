t1.png", "id": "1684914218616622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982461_1684914221949955_919699298469913251_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1a9JuGsOE0Q7kNvwHnYzXF&_nc_oc=AdqsMvaSwET5LrszwUbDKcY9swZFHR7a1YF75WCG8Wcz4BLYLkAADxrpSVf0R5MVRx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtCudZYkbW4V0IZfVE-XT2L1bMPHF5iYxLfjcuo8uhTA&oe=6A5F7312"}, {"file_name": "TBC_Screenshot_4.png", "id": "519266073474488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_519266076807821_8045448898191053951_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IarYSvrjpYQ7kNvwFKnSh9&_nc_oc=AdoQfDWSiu4PeMcNnGech24rWNbildFPWsMqaXO5U3nSkcerkznoCWyf9TR5zMpDzMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD44F-z9Y9Y5EOoNNzY0bQ7XKs82ZHxavjiC-CdCTdsMQ&oe=6A5F5671"}, {"file_name": "TBC_BB_Screenshot2.png", "id": "617153450483596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035422_617153453816929_8197618131681588935_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DPr0c_ZS2AQ7kNvwFVCEsU&_nc_oc=AdrRQOlA33YYZjtFO6JqP4K0fel_BIz4bX8fcA0x5PgCJd4FdMfIpemltIlafJ2qhGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDaXxNbGHv4KDlHBrfHe1JE-Nv4xP09ZRglQhSlznT5A&oe=6A5F7529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TBC_Landscape.png", "id": "1933231860214727", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036614_1933231863548060_6384280158781549633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2rEbU6EGl0Q7kNvwGh4Ssu&_nc_oc=Adq7ssXzz3m5xiN5pOYnhAiCaJrffei_PmsEv8U63jUx9KYCg-HLL_p1ckAfEKVF1y8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb8VrKBk5Rdxsmwh_tm65USpZp2PqNA6GFGp3p_cDv4g&oe=6A5F8A0B"}, "display_name": "Tube Be Continued", "keywords": ["puzzle", "funny", "cute", "story", "pet"], "long_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nTUBE-Based Benefits:\n\u2022 60 levels across 3 themed floors: Hamster Hangout, Smart Home Slide & Bakery Blitz!\n\u2022 Customize your hamster\u2019s appearance!\n\u2022 Classic and slide-based tube puzzles!\n\u2022 Numerous Mini-Puzzles including our new hamster cannon!\n\u2022 Chat with the BOSS and help him deal with important \u201cbusiness decisions\u201d!\n\u2022 Relaxed-pace gameplay with no time pressure.\n\u2022 Supports seated, standing, or room scale play.\n\nYour destination for TUBE-Based entertainment awaits!\n\nSincerely,\nThe BOSS", "short_description": "\u2b50 Play 136 hamster-approved puzzles across 60 levels! \u2b50\n\nHello! Welcome to TUBE Industries: a hamster owned and operated tube puzzle emporium! \n\nPrepare for a tube-based, puzzle-filled, HAM-PACKED adventure with our charismatic leader: The BOSS. Here at TUBE Industries we provide the puzzles and you provide\u2026 the brains. No shady business here!\n\nSincerely,\nThe BOSS"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bluemonttechnology.com/game%20privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bluemont Technology & Research, Inc.", "support_website_url": null, "website_url": "https://tubebecontinued.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
1316_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9JKJbFC1rUQ7kNvwGFhJcF&_nc_oc=AdpwVekQNzH5Lf-2_EuJDWfVmUkpOlsWLhuQkKWNUrIEP2iqHbOqJoPs2nMxzrEX8fE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs-GSpbXvQfPVJlIPskrGjICkiTGDpC49gSXRbxdZTTw&oe=6B05BF62"}, {"file_name": "screen5.png", "id": "1320311602525610", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1320311605858943_4032167408576458058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4OCfPnzf7oQ7kNvwHuB9Zr&_nc_oc=AdpJ7x0wFxHkqZ-OSAkq8Z0YX9aQINGXnBXsDyCg3kTjXYihKFRj1kfSFaCj688OH78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFJ1TS1XL771dHDh20wZYFukGqdX7WMBm30Qs-omA8_w&oe=6B05BF98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FP English", "keywords": [], "long_description": "Master English through realistic conversations powered by Artificial Intelligence. This educational app lets you talk with lifelike avatars in real professional settings \u2014restaurants, offices, hospitals, and more\u2014 to improve your speaking, listening, and vocabulary skills with instant feedback on pronunciation, rhythm, and clarity.\n\nThe system uses advanced voice recognition and AI evaluation to deliver personalized corrections, adapting difficulty to your progress. Practice natural dialogues, build confidence, and prepare for effective communication in real-world professional contexts.\n\nEach scene recreates authentic workplace situations so you can learn English in a practical, immersive, and motivating way. All data is used solely for educational purposes and stored securely.\n\nA new way to learn languages: dynamic, conversational, and powered by AI.", "short_description": "Learn English through AI-powered conversations with realistic avatars in professional environments. Improve pronunciation, fluency, and confidence with instant feedback. Experience immersive learning where every dialogue brings you closer to natural English communication."}, {"images": {"nodes": [{"file_name": "portada1008x1440_2.png", "id": "1447975132966706", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_1447975136300039_201446101092436144_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDJjM0RxyH4Q7kNvwE913Hs&_nc_oc=Adra-LyV8rAOFyN2dkPgqGKuX-75aRP4MrjJPo27AkBJG4ubpH5rPpMvlL7HIcy2R8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREGUVyXpzQ2a8LzlIBr6aeP9UpYO9e6xYFBI8430_xhw&oe=6B05B536"}, {"file_name": "portada1440x1440_2.png", "id": "1408952127476792", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1408952130810125_8725361252526983982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVFzEOfWpPwQ7kNvwHOmBzu&_nc_oc=AdrURU63-RetmgRBcAlcskpYopqvPCA7GU35cZwch2dPJhvwBZSSNSY2yy8nR0ILe0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhadjkLJOeMKSWlyf2gnGEZhLiJARDFTvZY0wiygaPZA&oe=6B05D363"}, {"file_name": "hero.png", "id": "1177646150931219", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1177646154264552_3564166412524551457_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOWu4wugy7YQ7kNvwHI3BXW&_nc_oc=AdojfPxWiN9jpqx1zzyr4tAfJzZl_MRi3wensPGlSteNCe-TornxIYGhc5wTVIGlrAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM6NdZWx55tpPgOw26Rb2KWxAFWoT_-O9OLZjXy08Ebw&oe=6B05A25E"}, {"file_name": "ico.png", "id": "791104003822082", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821702_791104007155415_898907333881847822_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7KcPM_UV7wQ7kNvwGP1Va3&_nc_oc=AdqDw8TNX8b6uoI-Ja3_IdYIDvYYxgNecGyGa1ksStIsfdP0G-lR_3reKFxELUj-1_E&_nc_zt=3&_nc_ht=scontent-iad3-2
1316_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBBzvkR0Z7MQ7kNvwHejocE&_nc_oc=AdoNR74Eg7FADQqNMOGSsQEHx2Sic5rTVlfH0g3RhiqIc0jDn_lx1qRHFjYkOFtNjEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6kDBc5SKbIysNrGyfnQBlrE_KQjS1skQGHYbnlkKMBQ&oe=6B0DA862"}, {"file_name": "screen5.png", "id": "1320311602525610", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_1320311605858943_4032167408576458058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpAbUiBGQi4Q7kNvwGZhZoA&_nc_oc=AdpWPwG4zzEaRi_hQfLJpxtEM0V77GQ00Mw-pIn63Au2tSs_RpPtUB8OM9zBgfNBwCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSfZLPVMBmDiWqf4fxuThiE62C81EBATQv8W4eglOj52Q&oe=6B0DA898"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FP English", "keywords": [], "long_description": "Master English through realistic conversations powered by Artificial Intelligence. This educational app lets you talk with lifelike avatars in real professional settings \u2014restaurants, offices, hospitals, and more\u2014 to improve your speaking, listening, and vocabulary skills with instant feedback on pronunciation, rhythm, and clarity.\n\nThe system uses advanced voice recognition and AI evaluation to deliver personalized corrections, adapting difficulty to your progress. Practice natural dialogues, build confidence, and prepare for effective communication in real-world professional contexts.\n\nEach scene recreates authentic workplace situations so you can learn English in a practical, immersive, and motivating way. All data is used solely for educational purposes and stored securely.\n\nA new way to learn languages: dynamic, conversational, and powered by AI.", "short_description": "Learn English through AI-powered conversations with realistic avatars in professional environments. Improve pronunciation, fluency, and confidence with instant feedback. Experience immersive learning where every dialogue brings you closer to natural English communication."}, {"images": {"nodes": [{"file_name": "portada1008x1440_2.png", "id": "1447975132966706", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_1447975136300039_201446101092436144_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3GwI5KkZa0Q7kNvwGku__5&_nc_oc=Adrrq20N5smwxuI_bfGkU-iP_aVa6npUPcuJI3XFDh-g9lP58-DebScGSD6ujSJIaIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrrbB6Mz9apB22r9vfahaFbsOd38pAPDtYbv4MRmeAdA&oe=6B0D9E36"}, {"file_name": "portada1440x1440_2.png", "id": "1408952127476792", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_1408952130810125_8725361252526983982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUG1azHPTS0Q7kNvwE_RkAD&_nc_oc=Adr3eu-V9SQ1bc3yvSKSXtR09Ref97fHm_sxVK7HawZs4d-oNu9k1b5Bd5lAcSZm2Qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSX4n4IMgFdNXuJ0SFk9RFcwRVUaRbR8LgtX8S6MC2E6w&oe=6B0DBC63"}, {"file_name": "hero.png", "id": "1177646150931219", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1177646154264552_3564166412524551457_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PEihkSDVGMQ7kNvwHUeZUt&_nc_oc=AdpgIT2tGTiE-XORZ_mjEspQ7WE4gYShdf6j3iFFTyY5xvCOcr_WRVX7ZpjhUTHyyPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuq2u59Gm7Bs4Fckl2de4NDjtyLgnUTmQmvIZIRqTMFA&oe=6B0DC39E"}, {"file_name": "ico.png", "id": "791104003822082", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_791104007155415_898907333881847822_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDvgU83lWA4Q7kNvwFbmYwl&_nc_oc=Adp97tdXEE8BLOYS6Gmxu9B0Ppe6zI8KHLXYLSonl1mR5Tqal0jbV0LWDnBDo3ZXnyA&_nc_zt=3&_nc_ht=scontent-ord5-2
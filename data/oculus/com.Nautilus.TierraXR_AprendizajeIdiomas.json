1316_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyM6kTrEkVkQ7kNvwFKW3y0&_nc_oc=Adrcf1H27oVwPrpQGgMJT8GPXCxSRkcdZRn9RjsnfS_7Gsk8ZvBgjx4nYgSQwB4kthE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7dg3fTst7q_CiV_kIQbEJAfg0O2icL3FLeMhjX_39EA&oe=6B086262"}, {"file_name": "screen5.png", "id": "1320311602525610", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825415_1320311605858943_4032167408576458058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xl0EVTP_flwQ7kNvwHbSfy_&_nc_oc=Adr0akTtXnXA_DYQhPvq4tFY8dGx7lEnLObWDZIVDoVAVD2mhT_nE7Hr4pb-Zs0Mjpg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsUsy0TK-LwwyWWaz42Xnxy_YEuuEyzVsxmoXjE4FT4w&oe=6B086298"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FP English", "keywords": [], "long_description": "Master English through realistic conversations powered by Artificial Intelligence. This educational app lets you talk with lifelike avatars in real professional settings \u2014restaurants, offices, hospitals, and more\u2014 to improve your speaking, listening, and vocabulary skills with instant feedback on pronunciation, rhythm, and clarity.\n\nThe system uses advanced voice recognition and AI evaluation to deliver personalized corrections, adapting difficulty to your progress. Practice natural dialogues, build confidence, and prepare for effective communication in real-world professional contexts.\n\nEach scene recreates authentic workplace situations so you can learn English in a practical, immersive, and motivating way. All data is used solely for educational purposes and stored securely.\n\nA new way to learn languages: dynamic, conversational, and powered by AI.", "short_description": "Learn English through AI-powered conversations with realistic avatars in professional environments. Improve pronunciation, fluency, and confidence with instant feedback. Experience immersive learning where every dialogue brings you closer to natural English communication."}, {"images": {"nodes": [{"file_name": "portada1008x1440_2.png", "id": "1447975132966706", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823286_1447975136300039_201446101092436144_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdU_3vziVUYQ7kNvwGH2ZKN&_nc_oc=AdpTb2-RPqbaFNjqYhtOVduOg56FkMsyICmHBMBfA3-8Yg5fbsX7cjMS7fOwkLJAa60&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX5rKHrfkoA1Su6SJ93jk_KacWk2_AIliZnC80_K4qRA&oe=6B085836"}, {"file_name": "portada1440x1440_2.png", "id": "1408952127476792", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491818890_1408952130810125_8725361252526983982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0XBFVPFaI8Q7kNvwH5NVH0&_nc_oc=AdokRKE231Gc7GQVRxiJu1p2qAikueZg9VDt_DlXP4iPd118z44kM1Xf17MKIAFO5kE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGJ6jC3NqyuUzskyNHYpDHSrZGmqHggCmIZIFJgYr7fw&oe=6B083E23"}, {"file_name": "hero.png", "id": "1177646150931219", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823746_1177646154264552_3564166412524551457_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3NQ0RDWyQMQ7kNvwGzU44a&_nc_oc=AdrEveSpvLGmDLr4902Ap8tp7oEVVUTp-19v1tcR3z4NZQQTabkt8RLgRISbPxhKtWs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs-rIUO4kKMirOPpo2cgSUdEfhmkUNqE0WNNiWp7Zf5w&oe=6B08455E"}, {"file_name": "ico.png", "id": "791104003822082", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821702_791104007155415_898907333881847822_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXHv9u2O6XcQ7kNvwF9o5DQ&_nc_oc=AdrKt0WACsz-MQ3Zj8xIGqOazxopmgG3JGnP1BZkyi6gW3z7po5AYpyxvGf0p3OAz_c&_nc_zt=3&_nc_ht=scontent-dfw6-2
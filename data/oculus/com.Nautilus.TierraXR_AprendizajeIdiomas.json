1316_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9JKJbFC1rUQ7kNvwE3uttx&_nc_oc=AdqciLneLW22zNJzFuKMPF10vIJyHch3TuABA5juiHTjZ-GA8MC0Dpo0leI9XneFfyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1zgOkaKVw8IvVW-yh2nFmfQLwh7wZGbe_cwgmDlri3A&oe=6B0710E2"}, {"file_name": "screen5.png", "id": "1320311602525610", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1320311605858943_4032167408576458058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4OCfPnzf7oQ7kNvwHGNdBs&_nc_oc=AdoxO4C5bI7SqOAxbb1PzG9yo8pVnwgcGKWKe_Cfl3fNccmIuPs5Cz75AEKROZKOljU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR1IZZyfzSSvqOwWF1XiXyNXhLnKAFM0R_tbxEJKx-4g&oe=6B071118"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FP English", "keywords": [], "long_description": "Master English through realistic conversations powered by Artificial Intelligence. This educational app lets you talk with lifelike avatars in real professional settings \u2014restaurants, offices, hospitals, and more\u2014 to improve your speaking, listening, and vocabulary skills with instant feedback on pronunciation, rhythm, and clarity.\n\nThe system uses advanced voice recognition and AI evaluation to deliver personalized corrections, adapting difficulty to your progress. Practice natural dialogues, build confidence, and prepare for effective communication in real-world professional contexts.\n\nEach scene recreates authentic workplace situations so you can learn English in a practical, immersive, and motivating way. All data is used solely for educational purposes and stored securely.\n\nA new way to learn languages: dynamic, conversational, and powered by AI.", "short_description": "Learn English through AI-powered conversations with realistic avatars in professional environments. Improve pronunciation, fluency, and confidence with instant feedback. Experience immersive learning where every dialogue brings you closer to natural English communication."}, {"images": {"nodes": [{"file_name": "portada1008x1440_2.png", "id": "1447975132966706", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_1447975136300039_201446101092436144_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDJjM0RxyH4Q7kNvwFEXAgd&_nc_oc=Ado8ntEDTvYk37UJgITjnifcFamtwsiYWLcmlNL_F-OzLSyWFBua_W3VORfgzhss6rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCpl0-maLcy_-Bhc_zfkgi7ojOcbagxnqiM9zxmPtSeg&oe=6B0706B6"}, {"file_name": "portada1440x1440_2.png", "id": "1408952127476792", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1408952130810125_8725361252526983982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVFzEOfWpPwQ7kNvwEIjokM&_nc_oc=Adp95JFXDfMIMzTH2T-RHxeVJEfPrMzxP56U1M9eMtQScChdkyxWQtYNOoF2PBc7KVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVFfGknpTzzyDdA-J11MvnjmsADAsDjnGfQP84gACNxA&oe=6B0724E3"}, {"file_name": "hero.png", "id": "1177646150931219", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1177646154264552_3564166412524551457_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3NQ0RDWyQMQ7kNvwE_8EUz&_nc_oc=AdoekFFiHo01WQyQ_CLCedMPBfguuubBoS7TIh3IheppKc-Ua-rMYK0y8ne_FbZeYt8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7F9Q4-lc-hA_BZ7E_IEEbeRkmtCxPUkwlT4knMVqgzg&oe=6B06F3DE"}, {"file_name": "ico.png", "id": "791104003822082", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821702_791104007155415_898907333881847822_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7KcPM_UV7wQ7kNvwGO8xtn&_nc_oc=Adq1RdqtYv6aB8STq23xPMt_dUcGNsMSJckZQ6ngF9GeVCNAOclxRQe-KovYycgx7rw&_nc_zt=3&_nc_ht=scontent-iad3-2
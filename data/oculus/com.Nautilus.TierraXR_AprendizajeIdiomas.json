1316_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9JKJbFC1rUQ7kNvwHL8aJD&_nc_oc=Adqv_xpjwBWtKSRpaGbWH0R0sF_aX_PTLOy4JEQLHfazOa21424V6pyKGQXmysYsUE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTVVlDcKiZVtxZblZvFDZq61PhvZQt-rspkLQ4XQ1sGQ&oe=6B046DE2"}, {"file_name": "screen5.png", "id": "1320311602525610", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1320311605858943_4032167408576458058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4OCfPnzf7oQ7kNvwFpjdty&_nc_oc=AdotVuE2whaNmjNDgKdlJHjpfDL-NwlLnOVIyFIVnRh_b-IRZzgvaI664clpXyUZ3oI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOutPbc7DeXHRKdSzbWlU5xpDX6AfUSUEHiO4cvpA4ZA&oe=6B046E18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FP English", "keywords": [], "long_description": "Master English through realistic conversations powered by Artificial Intelligence. This educational app lets you talk with lifelike avatars in real professional settings \u2014restaurants, offices, hospitals, and more\u2014 to improve your speaking, listening, and vocabulary skills with instant feedback on pronunciation, rhythm, and clarity.\n\nThe system uses advanced voice recognition and AI evaluation to deliver personalized corrections, adapting difficulty to your progress. Practice natural dialogues, build confidence, and prepare for effective communication in real-world professional contexts.\n\nEach scene recreates authentic workplace situations so you can learn English in a practical, immersive, and motivating way. All data is used solely for educational purposes and stored securely.\n\nA new way to learn languages: dynamic, conversational, and powered by AI.", "short_description": "Learn English through AI-powered conversations with realistic avatars in professional environments. Improve pronunciation, fluency, and confidence with instant feedback. Experience immersive learning where every dialogue brings you closer to natural English communication."}, {"images": {"nodes": [{"file_name": "portada1008x1440_2.png", "id": "1447975132966706", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_1447975136300039_201446101092436144_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDJjM0RxyH4Q7kNvwEl3Viu&_nc_oc=AdpBfPDx6OBUcubzu89LDeErmhR9iqOhHxJcGwogklFc8_8DTS99SS4OjO7_giPDTQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxNyxTcwdageQWL4pG0G6QszVAfsV6NaDdymnG1QLJNA&oe=6B0463B6"}, {"file_name": "portada1440x1440_2.png", "id": "1408952127476792", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1408952130810125_8725361252526983982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVFzEOfWpPwQ7kNvwF4Ro03&_nc_oc=Adpb0nHEk4Z6JAHLfIl4NZKZGkrzucaeBPF99TFfEDdnGkzs9T6xFhiY7qE5As4McH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmAxItblFkxHnlK1N5k3T00OYLe_u-3wTGKVsv8ITZXw&oe=6B0481E3"}, {"file_name": "hero.png", "id": "1177646150931219", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1177646154264552_3564166412524551457_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOWu4wugy7YQ7kNvwGo0sid&_nc_oc=AdrrB-MBt78lbWBehwX0D1tZhjj8pv00mSXmvc3Grl5sLJKuOulXz-g2C7Zq_5cdS5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjxzXWysf7oXS8W_uoLbJ-YI_ZmqHRKJtJx98oOHa8HQ&oe=6B04891E"}, {"file_name": "ico.png", "id": "791104003822082", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821702_791104007155415_898907333881847822_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7KcPM_UV7wQ7kNvwGi32xW&_nc_oc=AdpakCCf-aZSDJTd5_Uli6zkZdRXoJyo0d4yaTwV0RcFh1iiCHWNCvAYnm7J-y_gcw8&_nc_zt=3&_nc_ht=scontent-iad3-2
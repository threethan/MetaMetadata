1316_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBBzvkR0Z7MQ7kNvwHHLltz&_nc_oc=Adogf5UrjSeNq_PDRHF7RUrWf_EG6b707TZlQNgNygZGyo3elb-iFyp4cKCRVE4vYq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQx8wIZEutsUs03LX6SQCNMmq4Nu12AXk8RITOSqjCzBg&oe=6B0C56E2"}, {"file_name": "screen5.png", "id": "1320311602525610", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1320311605858943_4032167408576458058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpAbUiBGQi4Q7kNvwGzFb4r&_nc_oc=AdrC9c2ouSuE_ZU6ck9Uq0snsUWegUV-fwIyD8oYgz0AOH0wjKyu-Ib0v7NQY77a33o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmxqdDchHukdIFqAmWFt-ffcOT_K4fBfGxiek3flfv_w&oe=6B0C5718"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FP English", "keywords": [], "long_description": "Master English through realistic conversations powered by Artificial Intelligence. This educational app lets you talk with lifelike avatars in real professional settings \u2014restaurants, offices, hospitals, and more\u2014 to improve your speaking, listening, and vocabulary skills with instant feedback on pronunciation, rhythm, and clarity.\n\nThe system uses advanced voice recognition and AI evaluation to deliver personalized corrections, adapting difficulty to your progress. Practice natural dialogues, build confidence, and prepare for effective communication in real-world professional contexts.\n\nEach scene recreates authentic workplace situations so you can learn English in a practical, immersive, and motivating way. All data is used solely for educational purposes and stored securely.\n\nA new way to learn languages: dynamic, conversational, and powered by AI.", "short_description": "Learn English through AI-powered conversations with realistic avatars in professional environments. Improve pronunciation, fluency, and confidence with instant feedback. Experience immersive learning where every dialogue brings you closer to natural English communication."}, {"images": {"nodes": [{"file_name": "portada1008x1440_2.png", "id": "1447975132966706", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_1447975136300039_201446101092436144_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3GwI5KkZa0Q7kNvwFzKsfo&_nc_oc=AdoP3MZDe1H4kligS7IeSJD6lq6_scxrsOYpmusc2KsI_VWTRcgnFnrDZZA2msfH-Dk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVC_Ti2Q7A1My-OnoyiG6tiVeg64ZJQTcffoMqaTyuVg&oe=6B0C4CB6"}, {"file_name": "portada1440x1440_2.png", "id": "1408952127476792", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1408952130810125_8725361252526983982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUG1azHPTS0Q7kNvwFE-ooW&_nc_oc=Adrmv9yG5lMNNKavvkh-fJuOUyXFJZwkubKZAbwhm7WK-DfjNvVj5QF164SiZYxYnlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7-iTdHwSGz9vUap_pgv1aM_cLD377YEaIjWb6mXTgcQ&oe=6B0C6AE3"}, {"file_name": "hero.png", "id": "1177646150931219", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1177646154264552_3564166412524551457_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PEihkSDVGMQ7kNvwGP3Az-&_nc_oc=Adrn9wbNDWEj2zuIex1hTbzoz69rreVtAURNEGu4ZyCCNyHZ37PWNTARqeTcl3gilv8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSR7pSrfwbtCdh-C8yPk1SAeU1xFgP0_0Ji57KJG66_pQ&oe=6B0C721E"}, {"file_name": "ico.png", "id": "791104003822082", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821702_791104007155415_898907333881847822_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDvgU83lWA4Q7kNvwGJovE7&_nc_oc=Ado6-nks9MvUFpK6v7HZkzgf-AhoIx6ZIjjy9Kf6bwgaJqynoTw996bICeUSIpZIKCc&_nc_zt=3&_nc_ht=scontent-iad3-2
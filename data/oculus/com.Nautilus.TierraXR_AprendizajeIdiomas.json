EcBKRjbFB9hmJwhF6jcSl45yLkxGnMDsNoOepmjdFg&oe=6AFC7624"}, {"file_name": "screen4.png", "id": "791080820494449", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821081_791080823827782_261968627371288043_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvZntmesmD0Q7kNvwFwxg1y&_nc_oc=AdpiwSF9tvNfvBh1tLkVvSjYV_Uh5jFUB8CPdCj3mU8wl1KEY-AYyKoZhBFwTZ33O54&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNi0c8DvjQPy3eb7gfd9WmzQuOPOBkJGD5zwfeXx0xmQ&oe=6AFC8B2F"}, {"file_name": "screen5.png", "id": "1881676229429646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1881676232762979_2962571567707770256_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wx-agl6-GOQQ7kNvwEWcz9S&_nc_oc=AdqzMilMGaFGYvX8DuFBLXhFh8HLwLlkmMiwrHZ2eJTfoHNOFvmeubIs2-hUrdPgGdE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPIdzXv7BXM0mjfoRd8gi7mWUbaWQ4JGpfjgS1ZB9fEA&oe=6AFC629E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FP English", "keywords": [], "long_description": "Domina el ingl\u00e9s con conversaciones reales impulsadas por Inteligencia Artificial. Esta aplicaci\u00f3n educativa te permite hablar con avatares realistas en entornos profesionales \u2014restaurantes, oficinas, hospitales y m\u00e1s\u2014 para mejorar tus destrezas orales, auditivas y de vocabulario con retroalimentaci\u00f3n inmediata sobre pronunciaci\u00f3n, ritmo y claridad.\n\nEl sistema utiliza reconocimiento de voz avanzado y evaluaci\u00f3n por IA para ofrecer correcciones personalizadas, adaptando el nivel de dificultad a tu progreso. Practica di\u00e1logos naturales, desarrolla tu confianza y prep\u00e1rate para comunicarte eficazmente en contextos laborales reales.\n\nCada escenario reproduce situaciones aut\u00e9nticas del mundo profesional para que aprendas ingl\u00e9s de forma pr\u00e1ctica, inmersiva y motivadora. \n\nUna nueva forma de aprender idiomas: din\u00e1mica, conversacional y potenciada por IA.", "short_description": "Aprende ingl\u00e9s hablando con avatares realistas impulsados por IA en escenarios profesionales. Mejora tu pronunciaci\u00f3n, fluidez y confianza con retroalimentaci\u00f3n instant\u00e1nea. Vive una experiencia inmersiva donde cada conversaci\u00f3n te acerca a una comunicaci\u00f3n natural y efectiva en ingl\u00e9s."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tierraxr.com/politica-privacidad-oculus", "developer_terms_of_service_url": null, "publisher_name": "TierraXR", "support_website_url": "https://www.tierraxr.com/contacto", "website_url": "https://www.tierraxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25578264948458826"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1186855653315413"}]}, "baseline_offer": {"id": "1186855653315413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762281000, "status": "PUBLISHED", "id": "1186855653315413"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25946913894927261", "version": "1.0013"}, "id": "1358294719188490", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", 
1316_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xttqqg3o60Q7kNvwFvGygt&_nc_oc=AdrU6mHMOgB7xXrUVtAYvO8tZobJiUtmUQ-PWYwCeK1MTy0eoyxylyHh3QhNvN1ejig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfCiSeI4Hh9GDWYyGNq25e2SQ8CjRCmOYsTUy6enAd9Q&oe=6B01CAE2"}, {"file_name": "screen5.png", "id": "1320311602525610", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1320311605858943_4032167408576458058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD3LXO-eAZkQ7kNvwGRkSxy&_nc_oc=AdoC4M5oxxeYCMnmmoKL9yIiZ298imE3yw-qjaGmAn5g9IYD7Ua88loBVZfnmP12c6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjv7gdUlA3FRpXUQWrxp8vQflZvyslgMdY13Al0UHAiQ&oe=6B01CB18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FP English", "keywords": [], "long_description": "Master English through realistic conversations powered by Artificial Intelligence. This educational app lets you talk with lifelike avatars in real professional settings \u2014restaurants, offices, hospitals, and more\u2014 to improve your speaking, listening, and vocabulary skills with instant feedback on pronunciation, rhythm, and clarity.\n\nThe system uses advanced voice recognition and AI evaluation to deliver personalized corrections, adapting difficulty to your progress. Practice natural dialogues, build confidence, and prepare for effective communication in real-world professional contexts.\n\nEach scene recreates authentic workplace situations so you can learn English in a practical, immersive, and motivating way. All data is used solely for educational purposes and stored securely.\n\nA new way to learn languages: dynamic, conversational, and powered by AI.", "short_description": "Learn English through AI-powered conversations with realistic avatars in professional environments. Improve pronunciation, fluency, and confidence with instant feedback. Experience immersive learning where every dialogue brings you closer to natural English communication."}, {"images": {"nodes": [{"file_name": "portada1008x1440_2.png", "id": "1447975132966706", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_1447975136300039_201446101092436144_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ3Ma-pVXLAQ7kNvwFRyjfP&_nc_oc=AdrbApXZ5BX17_mdSC9YggVXIwIAI3UxwKyYfwb2dJqspNA_Zj9yN4Wc1rNR29CS3Q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxW_aE4gYfuMIZUmz40UVyIzSeqHy0YJMJm95LLrU_uA&oe=6B01C0B6"}, {"file_name": "portada1440x1440_2.png", "id": "1408952127476792", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1408952130810125_8725361252526983982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcdHcJZUe6MQ7kNvwH97xIm&_nc_oc=Adrmn0ZnkE0xrSOSwDmPT3UJHhGcnQ7LD4fi30dj21NLJEMKBSs82hbkBBi0ShrVWmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiKLN-IxH7CemuGzLujbFoYBVVYGng2DCfBL-B076YSw&oe=6B01DEE3"}, {"file_name": "hero.png", "id": "1177646150931219", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1177646154264552_3564166412524551457_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVKmMd9zdosQ7kNvwFBJzDp&_nc_oc=AdrFN0x6hgOukfy4gtjkTPb6RfF4D585O-e8peEN8g45oOgUXsTAWu44e1clvLsBCME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOSIpeSgl4lt954kKskypWee9cxNu3EwaMTchL9Zjvog&oe=6B01E61E"}, {"file_name": "ico.png", "id": "791104003822082", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821702_791104007155415_898907333881847822_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqEiGAiIh74Q7kNvwEBe3lC&_nc_oc=Ado7L5nLaSUm4mUyB1u0YORzPk5r7rt9r1G1ApjVt5yJfpUwhHAn82wEWa0RMRMJ1XM&_nc_zt=3&_nc_ht=scontent-iad3-2
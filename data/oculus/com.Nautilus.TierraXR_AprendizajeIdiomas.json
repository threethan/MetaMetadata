1316_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgW7LHj9mnIQ7kNvwEwWHXv&_nc_oc=AdpLrQMjJ708tn37pezf51Nfv2grwsSEOxEB8j9nYmoYrNl4ftEaJUAsvLmEQOs7-GA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiqqciLHXtGZ_j77O6fAgPeJCIcMHpnMqwJOXL2NjDgw&oe=6AFC84E2"}, {"file_name": "screen5.png", "id": "1320311602525610", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_1320311605858943_4032167408576458058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkPk67TvtRYQ7kNvwGRCPMZ&_nc_oc=Adre1pktEDwyDCC7USAcgv1lpTDuKo00lgO3KTH_LhZ9nODzfveYgsYVuDQSGo1MfCI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR44H4dzm5BOPCKlH5h-raB9sx7vPoMoTyGs7AlhwBcmA&oe=6AFC8518"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FP English", "keywords": [], "long_description": "Master English through realistic conversations powered by Artificial Intelligence. This educational app lets you talk with lifelike avatars in real professional settings \u2014restaurants, offices, hospitals, and more\u2014 to improve your speaking, listening, and vocabulary skills with instant feedback on pronunciation, rhythm, and clarity.\n\nThe system uses advanced voice recognition and AI evaluation to deliver personalized corrections, adapting difficulty to your progress. Practice natural dialogues, build confidence, and prepare for effective communication in real-world professional contexts.\n\nEach scene recreates authentic workplace situations so you can learn English in a practical, immersive, and motivating way. All data is used solely for educational purposes and stored securely.\n\nA new way to learn languages: dynamic, conversational, and powered by AI.", "short_description": "Learn English through AI-powered conversations with realistic avatars in professional environments. Improve pronunciation, fluency, and confidence with instant feedback. Experience immersive learning where every dialogue brings you closer to natural English communication."}, {"images": {"nodes": [{"file_name": "portada1008x1440_2.png", "id": "1447975132966706", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823286_1447975136300039_201446101092436144_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z9YO2ER0lwQ7kNvwEffZeb&_nc_oc=AdpxOXWudNGCMxQ7tRtdQhrk6hIgfyjKKZlZv-PHc4RZqCyjVmrNntSN8EZMvDV130U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaMgMhKTuWUzbEUcZmOeqLZx4xLMMq1iFwM3707f6O_g&oe=6AFC7AB6"}, {"file_name": "portada1440x1440_2.png", "id": "1408952127476792", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_1408952130810125_8725361252526983982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiyizAOpUfIQ7kNvwGnAzdb&_nc_oc=AdrCZSgLHiF6mknljhkjI-I7SkuCj9Oat6BNF7mk0Ag2Lx-4bp38xHRplANr2kKzors&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpoEQZqZkFL8UxMvnxEy6K9FdAqjFaWYew6WZi4CcEzg&oe=6AFC60A3"}, {"file_name": "hero.png", "id": "1177646150931219", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_1177646154264552_3564166412524551457_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giJ8PcltM4UQ7kNvwEi_a-4&_nc_oc=AdruMwpL3MGDeBqbCe-9vRFb1-T048zm4ft7kqWjPpUcq-9hfP2zIDnTMx7sIctABEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY_TJoF7gzMJumM5YIEtVP_-bXHTxoYRSUQhqt-qUtUg&oe=6AFC67DE"}, {"file_name": "ico.png", "id": "791104003822082", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821702_791104007155415_898907333881847822_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5nuoLapfEIQ7kNvwH8jdYB&_nc_oc=AdrrFuY96ZO1hc-Mu_QIWLsniIMZPJdq0a91JKrl6EjWv9rppeLPXakeOF8gVn3zbTU&_nc_zt=3&_nc_ht=scontent-sea5-1
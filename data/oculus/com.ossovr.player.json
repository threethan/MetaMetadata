Q7kNvwGDy-nl&_nc_oc=AdoKYhCUGku7cGFKrUiVnQh56ie8k0kiyg_QQkzzZ8KcjQ9fcJt6BzqNpKLYoR1IBUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zbmEEyKh009xt9QppyWUW-Cju04qbMqllh6tx4qeV6A&oe=6A05DD00"}, {"file_name": "Frame 41.png", "id": "962209803162980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_962209806496313_504374295174188752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkJlsnkZIiwQ7kNvwGWj1DS&_nc_oc=AdqE6cb8mE5soHZynCAJbOZOXXefkVaiXRmVwz_cX7WjXJ_GPJl9JBKscY1Tgnq0A3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af500FFzmE0Kl_iLVUpxlG2CY2ZfvdyqUj_ZXW-L5u_Eow&oe=6A05CC54"}, {"file_name": "Frame 83.png", "id": "1499624811741947", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619751_1499624815075280_1472296934208793063_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih5PIVrzKbYQ7kNvwEltblB&_nc_oc=Adr-_ooq5kfjpjGcb6oYfynTQ58YYxfg2D86gfy4v2FP9LdwEVH1ib-homFZavL-zhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Uu1zls01Udo-CRURwE9pOUsVtGzw0J9ZhXZbEaDeGMQ&oe=6A05EABA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Osso Nurse Training", "keywords": ["Medical", "Training", "Nursing", "Healthcare"], "long_description": "# Purposeful Practice. Confident Care.\nOsso Nurse Training is the nursing-focused experience from Osso VR, the leading immersive platform for procedural skills in healthcare. Built for health systems, Osso Nurse Training combines the Osso VR Nursing Series and Osso Loop\u2122 learning platform to transform hands-on practice into measurable proficiency, ensuring consistent training and helping to build a confident, practice-ready nursing workforce at scale.\n\nThis app requires an organizational education or enterprise subscription.\n\n# More ways to train with less strain\n\nWith Osso Nurse Training\u2019s multimodal design, nursing leaders can combine independent practice, peer collaboration, preceptor-guided sessions, and proficiency assessments to increase training throughput and shorten time to independent practice for new nurses.\n\n# Support faster onboarding, procedural skill development, and performance tracking across critical, must-know areas.\n\nTrain for high-priority, high-liability skills with VR scenarios that mirror real workflow and reinforce best practices. Performance insights map to leadership metrics through the Domains of Excellence\u2122 framework to help align training with safety, quality, and readiness goals.\n", "short_description": "Build a practice-ready nursing workforce at scale with Osso Nurse Training, featuring scenario-based VR, performance feedback, and analytics that transform hands-on practice into measurable proficiency and consistent training for your healthcare system.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://ossovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ossovr.com/terms", "publisher_name": "Osso VR", "support_website_url": "https://www.ossovr.com/support", "website_url": "https://www.ossovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27787227354210621"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393759_967225221958247_3744772756742597643_n.png?stp=dst-png_s360x36
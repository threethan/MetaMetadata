d6-1.oculuscdn.com/v/t64.5771-25/499303280_773736728398672_1544479870925168101_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjwZI08UOLoQ7kNvwHQKd-0&_nc_oc=Adpc1JgAIgueIjxbYof91TAwCGM6M1gkjs1k1UISIlQ57GkAyL9nP4FDy4gLL_HYDkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJxqmzs0TQVNbZQbOmsRxcM69K2AcgSU94s_-EdCPbGg&oe=6B01CC3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Osso", "keywords": ["Medical", "Training"], "long_description": "# Purposeful Practice. Confident Care.\n\nEquip your system with virtual reality training designed to enhance readiness, strengthen care delivery, and improve patient safety. Empower your teams with a curriculum built to accelerate technical and procedural proficiency, enhance decision-making, and foster critical thinking that enables faster, more confident performance.\n\nThis app requires an organizational-level subscription to access the training content. Contact us to explore subscription options or learn about our LMS partners.\n\n**Support decreased learning curves, procedural skill development, and performance tracking across metrics that matter.**\n\nWhat\u2019s included:\n\n- True-to-life, clinically accurate VR scenarios\n- Advanced Coaching Tools that ensure critical action competence\n- In-headset and web analytics dashboards for individuals and supervisors\n", "short_description": "Equip your system with virtual reality training designed to improve readiness, strengthen care delivery, and enhance patient safety. Close the learning gap with hands-on scenarios, structured curriculum, and real-time feedback. Supports onboarding, skill development, and performance tracking at scale."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ossovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ossovr.com/terms", "publisher_name": "Osso VR", "support_website_url": "https://www.ossovr.com/support", "website_url": "https
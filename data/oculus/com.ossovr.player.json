SGNEg&oe=69BE947A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Osso", "keywords": ["Medical", "Training"], "long_description": "# Purposeful Practice. Confident Care.\n\nEquip your system with virtual reality training designed to enhance readiness, strengthen care delivery, and improve patient safety. Empower your teams with a curriculum built to accelerate technical and procedural proficiency, enhance decision-making, and foster critical thinking that enables faster, more confident performance.\n\nThis app requires an organizational-level subscription to access the training content. Contact us to explore subscription options or learn about our LMS partners.\n\n**Support decreased learning curves, procedural skill development, and performance tracking across metrics that matter.**\n\nWhat\u2019s included:\n\n- True-to-life, clinically accurate VR scenarios\n- Advanced Coaching Tools that ensure critical action competence\n- In-headset and web analytics dashboards for individuals and supervisors\n", "short_description": "Equip your system with virtual reality training designed to improve readiness, strengthen care delivery, and enhance patient safety. Close the learning gap with hands-on scenarios, structured curriculum, and real-time feedback. Supports onboarding, skill development, and performance tracking at scale."}]}, "developer_name": null, "developer_privacy_policy_url": "http://ossovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.ossovr.com/terms", "publisher_name": "Osso VR", "support_website_url": "https://www.ossovr.com/support", "website_url": "https://www.ossovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "
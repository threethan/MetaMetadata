id=6e7a0a&_nc_ohc=0yLdWHnC7QgQ7kNvwE4Q1gl&_nc_oc=AdpD7A_KpnKaObmmYS_o28u_5SIALjlifvvUI7yxHf3aVLw7XpjKBA5ry9zXtXURDEo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTJQ7Zpmaozm4ARY0cIQvGpAtBNSnfVRCQ8GUyoNuaDA&oe=6ADCAFA5"}, {"file_name": "com.PTIT.CTSLab-20261013-230854.png", "id": "1779126076469974", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593790560_1779126079803307_6605398852085270188_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiIcUz6b-HoQ7kNvwGO33jM&_nc_oc=AdohpWd8o1xiiPjesOrS5Rgl0fnPecQRWgkArlXAZ1k83_V09_EfQxn9TIJcHceVMLo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2joihlvIdYI2TDd4YUPcyQSCMUnYSiuthIeDqWWKYjA&oe=6ADCBD0A"}, {"file_name": "com.PTIT.CTSLab-20261013-230716.png", "id": "1643033067614076", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593869844_1643033070947409_3505272648672060212_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdvhHsLVS1YQ7kNvwE8pXJk&_nc_oc=AdpBXj5MVNdl3RumvXbr_VLaQmT-SMDCuf0g81-lxI_GIVv7Qb3JGnV70Rnn4VGDxOE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-GZ9mKnvMnNuXRu9fnOSctQrfjO5-R9Ve6o1UuQD7Ag&oe=6ADCD24E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "STEAM VR", "keywords": ["steam", "stem", "vr", "ctslab", "cts"], "long_description": "# Explore STEAM Education in Virtual Reality!\n\nSTEAM VR brings **Science, Technology, Engineering, Arts, and Mathematics (STEAM)** to life through immersive virtual reality experiences. Designed for middle and high school students, the application offers a new way to explore educational concepts through interactive digital environments.\n\nDeveloped by the **Creative Technology and Simulation (CTS) Lab at the Posts and Telecommunications Institute of Technology (PTIT), Vietnam**, STEAM VR combines educational content with VR technology to make learning more engaging and experiential.\n\n## Key Features\n\n- **Immersive Learning:** Explore virtual environments that bring educational lessons to life.\n- **Interactive Experiences:** Engage with educational content through VR-based interactions.\n- **STEAM Education:** Discover topics spanning science, technology, engineering, arts, and mathematics.\n- **Designed for Students:** Educational experiences tailored for middle and high school learners.\n- **Learn by Exploring:** Discover new ways to understand concepts beyond traditional classroom materials.\n\n## About CTS Lab \u2013 PTIT\n\nThe Creative Technology and Simulation (CTS) Lab at PTIT explores the application of creative technologies and virtual reality across different fields, including education.\n\n**Step into VR and discover a new way to learn STEAM!**", "short_description": "Explore STEAM education in virtual reality with interactive lessons designed for middle and high school students. Discover science, technology, engineering, arts, and mathematics through immersive learning experiences developed by CTS Lab, PTIT."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/steamvr-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "CTS Lab", "support_website_url": null, "website_url": "https://sites.google.com/view/steamvr-privacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1303933802814523"}}]}, "scheduled_offers": {"coun
onnel have at some of the largest and most technologically advanced mines, ports and operations centres in the world.", "short_description": "Mining Trucks are BIG. But just how big? Now you can feel the awe inspiring scale of mining equipment, from Haul Trucks through to Reclaimers, see the massive scale of operations, and discover what roles and duties various personnel have at some of the largest mining operations in the world. A stereoscopic 360 video experience which puts you at the heart of Rio Tinto\u2019s operations in the Pilbara, Western Australia."}]}, "developer_name": "Viewport", "developer_privacy_policy_url": "http://www.viewport.com.au/", "developer_terms_of_service_url": null, "publisher_name": "Viewport", "support_website_url": "http://www.viewport.com.au/", "website_url": "http://www.viewport.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "322345003164659"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2514904512126052"}]}, "baseline_offer": {"id": "2514904512126052"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577383241, "status": "PUBLISHED", "id": "2514904512126052"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3121295374553514", "version": "1.7.3"}, "id": "2722275384664476", "channel_name": "LIVE"}]}, "is_for_oculus_ke
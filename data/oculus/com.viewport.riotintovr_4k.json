Yb77q11ac0Q7kNvwG7jvCJ&_nc_oc=Adpwz_hooGZCRmlYo9zACpnioMBXAtDzF1A7TtG9hUaRXbWB5qRJvaOV-_PaQiNzxE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLPJIyIKZ0NSZhFfnaGzmpmBfjiiQPrOXaUvQPTZ4BqQ&oe=6AB7E73A"}, {"file_name": "migrated_image.png", "id": "207543693897808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031354_947395088946025_7572268908988596224_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MUkhEQeWQMQ7kNvwGZy1w9&_nc_oc=AdpuWwM_Jr0MPVNw9p6uln8yE-n_4PADuDhs415_othbjZVDSxucLfhmSokpA4O56L8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5SzMEHm8VRf_oxslCjPiDHUe-vvc1wjpG3RKKF4GL0w&oe=6AB7D92B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rio Tinto VR", "keywords": ["Rio", "Tinto", "Mining", "Iron", "Australia"], "long_description": "Mining Trucks are BIG. But just how big? With Rio Tinto VR, you can stand right next to these impressive feats of engineering, plus dozens of other 3D 360 captures from Rio Tinto\u2019s operations in the Pilbara, Western Australia.  See Haul Trucks through to Reclaimers in action, and see the awe inspiring and massive scale of operations, discovering what roles and duties various personnel have at some of the largest and most technologically advanced mines, ports and operations centres in the world.", "short_description": "Mining Trucks are BIG. But just how big? Now you can feel the awe inspiring scale of mining equipment, from Haul Trucks through to Reclaimers, see the massive scale of operations, and discover what roles and duties various personnel have at some of the largest mining operations in the world. A stereoscopic 360 video experience which puts you at the heart of Rio Tinto\u2019s operations in the Pilbara, Western Australia."}]}, "developer_name": "Viewport", "developer_privacy_policy_url": "http://www.viewport.com.au/", "developer_terms_of_service_url": null, "publisher_name": "Viewport", "support_website_url": "http://www.viewport
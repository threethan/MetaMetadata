Yb77q11ac0Q7kNvwFeC8Hi&_nc_oc=AdpoEVjj9FfsMi9S7wlFtjBrJ9gdaXN7FjYbZq9oUqqb9LB-w2TYrvqLSIwTF7THSz8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqZZyjbnT1j4Um-1U6RkZmXCvsB_zrzh6Ht3tB2J_LLQ&oe=6AB695BA"}, {"file_name": "migrated_image.png", "id": "207543693897808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031354_947395088946025_7572268908988596224_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TZjwchJzngQ7kNvwEAbVRN&_nc_oc=AdppRFqFvdJjkig9pVn5u8zQu4hH70ZWTfUF0DD_FTx_oGI7c4WEhAIsoOPTLk-elIs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd9CvAlw9GaW8evZ7TcbZU0K682oLLWWazrRXcIvKGtg&oe=6AB687AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rio Tinto VR", "keywords": ["Rio", "Tinto", "Mining", "Iron", "Australia"], "long_description": "Mining Trucks are BIG. But just how big? With Rio Tinto VR, you can stand right next to these impressive feats of engineering, plus dozens of other 3D 360 captures from Rio Tinto\u2019s operations in the Pilbara, Western Australia.  See Haul Trucks through to Reclaimers in action, and see the awe inspiring and massive scale of operations, discovering what roles and duties various personnel have at some of the largest and most technologically advanced mines, ports and operations centres in the world.", "short_description": "Mining Trucks are BIG. But just how big? Now you can feel the awe inspiring scale of mining equipment, from Haul Trucks through to Reclaimers, see the massive scale of operations, and discover what roles and duties various personnel have at some of the largest mining operations in the world. A stereoscopic 360 video experience which puts you at the heart of Rio Tinto\u2019s operations in the Pilbara, Western Australia."}]}, "developer_name": "Viewport", "developer_privacy_policy_url": "http://www.viewport.com.au/", "developer_terms_of_service_url": null, "publisher_name": "Viewport", "support_website_url": "http://www.viewport
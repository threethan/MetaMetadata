bzXWThStOAQ7kNvwENB-bK&_nc_oc=AdqVCk02FjEvgslXa7ELv3nrmLKfgGSsjCSh6ADsYCJCBkuhktyLjxn5cYQFz8UH_M0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRQGUJFgbBHE2PFtOgXDMJNZCTvPjtaaU2lTC2P9pLxA&oe=6A60ABFA"}, {"file_name": "migrated_image.png", "id": "207543693897808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031354_947395088946025_7572268908988596224_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW8Ua1TKFycQ7kNvwEygDKF&_nc_oc=AdpLWfR9C7-q9IAI68babwf_QKKV5izVULuW-knCJUXNtbBWjrDgUEZ0wz6bQryselo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7E2NAu_24lXyQbsuV2xhwtzR3CcFmuL_riWxghFXUJg&oe=6A60D62B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rio Tinto VR", "keywords": ["Rio", "Tinto", "Mining", "Iron", "Australia"], "long_description": "Mining Trucks are BIG. But just how big? With Rio Tinto VR, you can stand right next to these impressive feats of engineering, plus dozens of other 3D 360 captures from Rio Tinto\u2019s operations in the Pilbara, Western Australia.  See Haul Trucks through to Reclaimers in action, and see the awe inspiring and massive scale of operations, discovering what roles and duties various personnel have at some of the largest and most technologically advanced mines, ports and operations centres in the world.", "short_description": "Mining Trucks are BIG. But just how big? Now you can feel the awe inspiring scale of mining equipment, from Haul Trucks through to Reclaimers, see the massive scale of operations, and discover what roles and duties various personnel have at some of the largest mining operations in the world. A stereoscopic 360 video experience which puts you at the heart of Rio Tinto\u2019s operations in the Pilbara, Western Australia."}]}, "developer_name": "Viewport", "developer_privacy_policy_url": "http://www.viewport.com.au/", "developer_terms_of_service_url": null, "publisher_name": "Viewport", "support_website_url": "http://www.viewport
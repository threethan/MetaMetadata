csMAwUGD6MQ7kNvwHWsT3z&_nc_oc=AdoYNR2FNATRyfn_9ncFx_x95LO273TJrfbs8WoxbIHeEoTl1xnVgNnC0E35rxYTsto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0e5GPsHVqJNVn-zE4Pg9JD87r3YUA3lufVG2XuwbI9Q&oe=6A69E67A"}, {"file_name": "migrated_image.png", "id": "207543693897808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031354_947395088946025_7572268908988596224_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAgZQK7403kQ7kNvwEmngGr&_nc_oc=AdqVr_6NiKhwpT83RnEUH2RdY17e5SAbJOPpcq5KxybSb_-2dpIaohMOFzdSOobMfr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0nkhjwMCb3CVG7ZtTsVjrUvD5mPNkVtgXayQOkgqQXQ&oe=6A6A10AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rio Tinto VR", "keywords": ["Rio", "Tinto", "Mining", "Iron", "Australia"], "long_description": "Mining Trucks are BIG. But just how big? With Rio Tinto VR, you can stand right next to these impressive feats of engineering, plus dozens of other 3D 360 captures from Rio Tinto\u2019s operations in the Pilbara, Western Australia.  See Haul Trucks through to Reclaimers in action, and see the awe inspiring and massive scale of operations, discovering what roles and duties various personnel have at some of the largest and most technologically advanced mines, ports and operations centres in the world.", "short_description": "Mining Trucks are BIG. But just how big? Now you can feel the awe inspiring scale of mining equipment, from Haul Trucks through to Reclaimers, see the massive scale of operations, and discover what roles and duties various personnel have at some of the largest mining operations in the world. A stereoscopic 360 video experience which puts you at the heart of Rio Tinto\u2019s operations in the Pilbara, Western Australia."}]}, "developer_name": "Viewport", "developer_privacy_policy_url": "http://www.viewport.com.au/", "developer_terms_of_service_url": null, "publisher_name": "Viewport", "support_website_url": "http://www.viewport
7kNvwFJHRGu&_nc_oc=AdpOMJ16gKBjzkKEPEQY1hWnPdgRrfqlvC_P7r1sq8DCHeLVWOjDLsij4d3fIviPv24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuALrnI4gQgi-uikqu78htJQp2qNKR0NDJeUfhm2Tx7A&oe=6ACF9489"}, {"file_name": "1.png", "id": "2149617629107748", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618102_2149617632441081_108010676337390898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PmaON93IdgQ7kNvwGqRxFV&_nc_oc=AdoZPiTs3evV1fXnaNJbDhYuHGyNTBnnW9eBmQ-IbpHGTaIuTq3-kPiCjEQV7vfQcc8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHuR3Elx_WDQVTkFyy9KX_mjZpJ6eZT5VypWZlfgldzQ&oe=6ACFA3EE"}, {"file_name": "2.png", "id": "886305020978821", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_886305024312154_1664300159270597034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqWzqKlHx0MQ7kNvwFZckwN&_nc_oc=AdoojkKuixroqahKjrEK4r515OrG77d9rSGGoxg56xzWnQ0D856TzbxnSrJTuEEs-Lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5F8VDyZBm4Un82RNzuQ6VzjqkBtL2MtXOVK_OzsmYUg&oe=6ACFB0CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "4 Qul: Immersive Quran Journey 3D", "keywords": ["QURAN", "SURAH", "AYAT", "MODERN", "ISLAMIC"], "long_description": "Experience the 4 Qul in a fully immersive 3D VR environment with 4 Qul VR: Quran 3D Experience. This app brings the sacred Quranic verses to life with interactive 3D visuals, making learning and memorization engaging and modern. Navigate serene virtual spaces, explore the verses, and deepen your spiritual understanding in an immersive and reflective way.\nKey Features:\n\u2022 Immersive 3D Quranic environment for VR\n\u2022 Interactive 4 Qul verses with visual guidance\n\u2022 VR-optimized experience for comfort and clarity\n\u2022 Perfect for learners of all ages, students, and educators\n\u2022 Enhance memorization and understanding with modern VR tools\nWhether for personal spiritual growth, education, or sharing meaningful learning experiences, 4 Qul VR combines the timeless wisdom of the Quran with cutting-edge VR technology, offering a unique journey of learning, reflection, and engagement.\nIf you want, I can also draft 2\u20133 alternative long descriptions under 1500 characters each, fully optimized with keywords like \u201cQuran VR,\u201d \u201cIslamic 3D app,\u201d \u201cMuslim education VR\u201d for maximum discoverability on Meta Horizon.", "short_description": "Step into a completely immersive 3D VR experience with 4 Qul VR: Quran 3D Experience. This app brings the timeless Quranic verses of the 4 Qul surahs to life in a stunning virtual environment, designed to provide both education and spiritual reflection. Whether you are a student, a parent, or someone seeking a deeper connection with the Quran, this app makes learning interactive, engaging, and unforgettable.\nWith 4 Qul VR, you can explore the sacred verses in a fully three-dimensional space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25915855281401144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculusc
s combat. Are you ready to put your skills to the test?", "short_description": "Get ready for Task Force 9 - a tactical shooter that puts your combat skills to the test. Take down enemies using force or stealth while controlling your AI partner. Use cover, explosives, rappelling, wall breaching, and ambushes to survive. Sharpen your situational awareness in close-quarters combat.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://taskforce9.com/task-force-9-eula-and-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Good Day Studio", "support_website_url": null, "website_url": "https://taskforce9.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "252785967484208"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9387767711239952", "version": "0.133"}, "id": "287670870297777", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7182152818468130", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
74500_212274311769117_3537677687123961123_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q0tu4sb1-kQ7kNvwGGSTQG&_nc_oc=AdnknYPEGwtZtR-JjsvRaef_qOakEbXuLu9bbFkYh3Uz2vAwZeVfNuLIKMkRj5WfPwA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvf8XrZ7cGeUQkxRHciRncsh4DDwQYNzfgLxcE2dHZDZw&oe=69985C8A"}, {"file_name": "vlcsnap-2023-05-02-16h44m19s639 (Custom).png", "id": "1314089402550311", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031309_1314089409216977_1103717457145284218_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Vv8njbWZ8QQ7kNvwHVYKVi&_nc_oc=AdmYyZ9NVvkrTENXQtmAPmeZ0BMC9eKfJuEAnMXVT0uzUG4B8Nber-GPW-hCuz3GyfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftCxO6Vbm_aFNfrzZnrpArAEz1uFCoZYsYqAgcuAH39FQ&oe=69986B8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-05-02-15h48m23s579 (Custom).png", "id": "1503419670195541", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_1503419673528874_2256517433883663425_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln-6CCD_luQQ7kNvwEfRnG5&_nc_oc=Adl9kNAq5f7vZ2NpaR9vzPpzGtTBe0vxt8hEGBjNpmFtyoVIsyYeKM9qOgM62xSpr_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvSc3Yr7FOUF84Ip1GZHIoaJwKAXm4GC5BmWBk6JjpIOA&oe=699866E4"}, "display_name": "Task force 9 Demo", "keywords": [], "long_description": "Task Force 9 is a cutthroat VR game where players must ruthlessly take out enemies using any means necessary, whether it be through brute force or sneaky tactics. You'll have to strategically maneuver your AI partner while relying on cover, explosives, rappelling, wall breaching, and ambushes to gain the upper hand. This game is not for the faint of heart, as it it not just one more tactical shooter but we aims to sharpen your instincts in the brutal world of close-quarters combat. Are you ready to put your skills to the test?", "short_description": "Get ready for Task Force 9 - a tactical shooter that puts your combat skills to the test. Take down enemies using force or stealth while controlling your AI partner. Use cover, explosives, rappelling, wall breaching, and ambushes to survive. Sharpen your situational awareness in close-quarters combat.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://taskforce9.com/task-force-9-eula-and-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Good Day Studio", "support_website_url": null, "website_url": "https://taskforce9.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "252785967484208"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9387767711239952", "version": "0.133"}, "id": "287670870297777", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7182152818468130", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9387767711239952"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771187938, "id": "27010386005218184", "ver
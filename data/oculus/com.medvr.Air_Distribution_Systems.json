09A9"}, {"file_name": "Screenshot 2026-05-01 183509.png", "id": "1498904708249917", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619145_1498904711583250_7243144431540131768_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hGOd9Qln6oQ7kNvwG0FXxg&_nc_oc=AdrHCiys5taFXkc04ivNPRn5xgck42Y4QRbCI76OuutpEGMjlkHMua3XxH-5RC_0280&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fRoZlCsw31r-iBQIg83EFCA67lKvHmowWXsxLx06BIw&oe=6A12F48A"}, {"file_name": "HighresScreenshot00004 1.png", "id": "1487319002931596", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617850_1487319006264929_6933773215135330244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j8hIcUOafIQ7kNvwEpAgQI&_nc_oc=AdqZE8vf6qsD2p15VFjplz5AAn9-QDJOreE6jVpejvi24UanAgexvq_M2apawrTq3FA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p5ADNXCM7RnOxY4--WMEUpV8wj2zHVPomHFacq_WrWg&oe=6A130184"}, {"file_name": "Screenshot 2026-05-01 183526.png", "id": "1935829020397877", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1935829023731210_4138014282540294142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyxtMKLv1cMQ7kNvwESGhQR&_nc_oc=Adp9wmPtzLhnVvjO5hhCmK2T_01IvpYddop0Xbqxf4yCJZLUYxi2fa0VBCWejL4IR4Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QYjieoaLF1gf9E9q-n4Zp3byKcBjkbaE-6DvAIp6rNA&oe=6A130F83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Air Distribution Systems", "keywords": [], "long_description": "Air Distribution Systems is an immersive VR training application developed by ImmerseLearn to enhance practical learning in HVAC air distribution. Designed as part of the Air Distribution Systems micro-credential program, this application enables learners to engage in realistic, scenario-based training that builds critical skills in system components, airflow management, and installation practices.\n\nThrough interactive simulations, users can explore key concepts, practice procedures, and gain confidence in a safe, controlled environment that mirrors real-world HVAC tasks. The experience is structured to reinforce theoretical knowledge through hands-on application, improving retention and job readiness.\n\nPlease note: This application is exclusively accessible to individuals enrolled in the ImmerseLearn Air Distribution Systems micro-credential program. Access is restricted and intended solely for registered learners as part of their training journey.", "short_description": "Air Distribution Systems is a VR training application from ImmerseLearn, designed to support hands-on skill development in HVAC air distribution concepts. This app is exclusively available to learners enrolled in the ImmerseLearn Air Distribution Systems micro-credential program and provides immersive, guided practice in real-world scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27234310899506269"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4006254926335181"}]}, "baseline_offer": {"id": "4006254926335181"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 17791755
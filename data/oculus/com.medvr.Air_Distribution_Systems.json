d HVAC tasks. The experience is structured to reinforce theoretical knowledge through hands-on application, improving retention and job readiness.\n\nPlease note: This application is exclusively accessible to individuals enrolled in the ImmerseLearn Air Distribution Systems micro-credential program. Access is restricted and intended solely for registered learners as part of their training journey.", "short_description": "Air Distribution Systems is a VR training application from ImmerseLearn, designed to support hands-on skill development in HVAC air distribution concepts. This app is exclusively available to learners enrolled in the ImmerseLearn Air Distribution Systems micro-credential program and provides immersive, guided practice in real-world scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27234310899506269"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_4285893828336970_5906502698306675615_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4m9SxS9pCgQ7kNvwE9lLl-&_nc_oc=AdoZweeqUWF0rs3afPp7XSVfqiFNmeBlHWxk1i7T
dn.com/v/t64.5771-25/499619145_1498904711583250_7243144431540131768_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxjNBnCDXoAQ7kNvwFpYhMG&_nc_oc=Adq8xLZhCYQxPw5MRWemXsvhGzsTnE2uRWbQqC86nE2743QbvMJbVjPUi-lUWgYYsVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9yDom2mf9PB3kIPYDSd8sAcEYDCyG_8wbuuudYPxT_Q&oe=6AB3CB8A"}, {"file_name": "HighresScreenshot00004 1.png", "id": "1487319002931596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_1487319006264929_6933773215135330244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQZZwtAIeucQ7kNvwGS4x7N&_nc_oc=Adp9uSvI53i129VfOkadtpjSwhjKvz34v7EFNl7JrR_BaBenkYjJqWAx55SABN5nlFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_YtoPTs_kyQPN7Z9iR7_4HXb1sS3sYu_C6U2gS404bA&oe=6AB3D884"}, {"file_name": "Screenshot 2026-05-01 183526.png", "id": "1935829020397877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823878_1935829023731210_4138014282540294142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtdGKUOlWz0Q7kNvwGhxCOA&_nc_oc=AdpC82RyfE6-7aOB6vwtY6XleSq_O9c-tkzjJo16bSc9-Ul1hrqj5_5qV5mKpOeGZi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwMjNz-5XFy_z5lzxazwrEdWJxmHrT5m1feui23Is9RA&oe=6AB3E683"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Air Distribution Systems", "keywords": [], "long_description": "Air Distribution Systems is an immersive VR training application developed by ImmerseLearn to enhance practical learning in HVAC air distribution. Designed as part of the Air Distribution Systems micro-credential program, this application enables learners to engage in realistic, scenario-based training that builds critical skills in system components, airflow management, and installation practices.\n\nThrough interactive simulations, users can explore key concepts, practice procedures, and gain confidence in a safe, controlled environment that mirrors real-world HVAC tasks. The experience is structured to reinforce theoretical knowledge through hands-on application, improving retention and job readiness.\n\nPlease note: This application is exclusively accessible to individuals enrolled in the ImmerseLearn Air Distribution Systems micro-credential program. Access is restricted and intended solely for registered learners as part of their training journey.", "short_description": "Air Distribution Systems is a VR training application from ImmerseLearn, designed to support hands-on skill development in HVAC air distribution concepts. This app is exclusively available to learners enrolled in the ImmerseLearn Air Distribution Systems micro-credential program and provides immersive, guided practice in real-world scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27234310899506269"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4006254926335181"}]}, "baseline_offer": {"id": "4006254926335181"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779175500, "status": "PUBLISHED", "id": "4006254926335181"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename"
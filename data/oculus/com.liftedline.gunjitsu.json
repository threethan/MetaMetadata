9C54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETLCfJTzvZ0Q7kNvwEjw1gT&_nc_oc=Adp8M-ibNUSySe6iozh0LHrTgdPtVygPauLDxFR1m36SRPMNb9fyMYDpzBCBki237fI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk5IRqQ_Bkpn4DnMB8SSrD3U1ttWgITtTFME17LQTmoQ&oe=6ACB9053"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tj0X1JkyYgQ7kNvwFPouXW&_nc_oc=AdpSoPpA9Fj_iK9EIpWLPfTKlpCOmxxRrnPkStrNGxpgbA1u4-v9L8ICfrGduWkyB9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMoZMllVzs0VWl4bXIqw3TzkNMRsKjeviXZhTXTn9IdA&oe=6ACBB149"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qzcM28O9fkQ7kNvwF9J9SR&_nc_oc=AdomWsKUmRjJtRN6z7b5GHEKADEy7SEFb0dGGtF79nCi9nRj-0hMG197T9lIu-a4qaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBL9PMtZ6EN6RvwBt9zNcA8yjfSDYTG58CsYcd2PH5XQ&oe=6ACBA2FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw7j54AMGhcQ7kNvwFkq-jf&_nc_oc=Adr6cpV0U1YZyK71UIXlwHP0Mlj-VWpOsNRIm-5Wi8-5xXF0I9n0wbJ8wM5p1s_4yIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyoBfoBIhSWxTT88YGVzG0Sa83eB-B3GUkDTV3bJTfFw&oe=6ACBA4B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cgUHntd-rIQ7kNvwGEIX1X&_nc_oc=AdpAMBPjCgZfVlTrJCq4Y8yrEqnic7vzdqQBD64MVebYjSHoesYa4j6vHFaGsEIox3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGL9XITtC4uyl_QXTV5NhIqJ4f5aVIJGUjBg-ag7h7_g&oe=6ACBB5E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
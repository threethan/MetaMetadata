16D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmu7227qf5QQ7kNvwFX8LzC&_nc_oc=AdqejMOpbE8w6t0GaJ7JvzaON1s76P36a4-lPzlN486aq7tMjUVMv0Vg9SFxvhnRHRc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uqKMS_r5ftrFSCk4WG0zbC8lL33rEP8qYxr5IO2ZrWg&oe=6A2C0AD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oRKj-Bg6k0Q7kNvwE6_26Q&_nc_oc=Ado7OA5eEQCma6cVoZQMWOJXk2C5Dvu7I-ixfsLSbRa4QjTT4Sd4aBBDjreQdueQqFU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B6UteapplE51ZBVrXsSYLO4AgpH4MBBz5tcN7-5BEWw&oe=6A2C2BC9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1XE3FVohnMQ7kNvwGD4QOD&_nc_oc=AdpNpOw6aBqkIh_ggPkgWaDoVI-bMWs2IeMVpu1oBnnkkS8cysn64IsqbzqtF0vJXsU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dABek7EoSZL8siEVJCYNPDV9fjM88bwv2aSUPhlQnpw&oe=6A2C1D7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Bg--yFFzKwQ7kNvwGGiMZ5&_nc_oc=AdrVPaYndKWmEh7PyVuFQ90_b3GdIgNTvQm1kkB7z0OY1YyFBCmfQELOp43tgltamQg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e1s4GJZR-ntiLqI1JQbO5Dj0LmfGhfk5CwYBkDxPeRQ&oe=6A2C1F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWjo4dVgOcMQ7kNvwF9XH7g&_nc_oc=AdoQDoGY0I3bwUR3_UrqcLbab_671oNCF4rfVRMA0aqElT_4CujkK1BGkMTvMA-sGUk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6cgbVWExjcFJbuARdxE1enlgg_RVwQhr4jx2OdhCxLw&oe=6A2C3069"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
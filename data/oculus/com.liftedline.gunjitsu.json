5DD4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYUsmSWmiLcQ7kNvwFwspJ1&_nc_oc=AdpIIGDzGYcEvkdoh0XgwC8vYoVwv25TDvLftRZySmoWjNe9jyzfTgXFl_yeNl7U7lI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJO7ERpeWlF5onpixdy5qjLVkBzXtV1sJWbgcDVQ_IwQ&oe=6A4E51D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB3P9wqTpOIQ7kNvwGJiMWC&_nc_oc=AdqFB_Ew65oGPM2kcmkEKK8-d8S_MHtQB5kTsSBtldKPhA8-zw_fvUK2VPmnZVQKwM4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZIhLZh6oPug9G9BrQb7akG13WLqnZYj9dB2lU4mszXA&oe=6A4E3A89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSGXEvdwQDQQ7kNvwHuAjPH&_nc_oc=AdrPKfVE5QhDHB-yhdoFtACm4Exz-KGJVLL3NN0lOytUS6eaPTcqyxvuXeexbaz5NCI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY0ZnO7rh9O4DrPw91_ec-0ePLx06gZrnhJVItglU9og&oe=6A4E647A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jl1KzAgbrcgQ7kNvwHICdgX&_nc_oc=AdoqixnodSPXj3PM6Mm1ieNWWNhnZwXh1-WK0-5xtT0AtpQHNeXqpjszaKh2xOYwLik&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-YgIM4VXqEmOu2njH6Z_A36E6Al9m4YPVgjvyALJHmg&oe=6A4E6633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGnXW5uk2E8Q7kNvwFVPkzE&_nc_oc=AdokfV22Wf0LDPgLSbBJJRLNQLhUDuSs_VBT5BP0oJydRaNBPWKFhr-vURkQgjZarP4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAon2ESkTsjCs45TUnnHCXeZSyMVNoEU53TxzAzJS42_Q&oe=6A4E3F29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
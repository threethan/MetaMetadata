C954"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYtdfTg2JN8Q7kNvwGDHPNE&_nc_oc=AdqO5Oo4JFW6S_Z5rEXwv2kZoTAWoPwVHJK3vIzAHwdBPb-6pPshWluMEh9qxvUC6xY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO4MHncSWGom89uaT06lUx8mKnRNABuhunwTF5WyBDTw&oe=6A9EBD53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JxaQ8zO5-0Q7kNvwFmYWwS&_nc_oc=AdrZ2EFbDAeXj8Os9oGBEo79y71mOi4faJfCcgt-Wzpj0WGN6-lT0uaoNvsTMeOh1tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYi3RKtMI-pAAaOVwdCuPykAmbzwfIlrEND5QXvPkQ3w&oe=6A9EA609"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b10UWetrJv8Q7kNvwH28i2z&_nc_oc=AdpoljZhgpWJ3zcnJe1fcv1FeZQw2pc7D2Ml9klTQNuAfTnT6b9Z4Ox4FJHiTvSpKs8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN_D9jsGZ8RQUrhqbfyX91jdVZo205RyBl5QRImQ-_BQ&oe=6A9ECFFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1JMxmCdiZsQ7kNvwEqL1-w&_nc_oc=Adq3Dft8TeRJHbhtAqN9LxuX9o00ysNZ0VrYlMU4VsfX7xybzXTM8WJtUom0CGRhwk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWPG1HolQ8um-CvmhR3fZYOiwEHsdXxG73Jx3m7Bm0Rw&oe=6A9ED1B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjOuJolS8MoQ7kNvwGtwICz&_nc_oc=AdpOY4LkMapVda9cpUDG90h_FWnlGcMykwSYFvrTIOt1SKstmJj-yRTqVP3-qkHJZpQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQOrEqVQc0FIfeSeXKAEjtCj5RmBvbdAZ3sBlXpY6mgg&oe=6A9EAAA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
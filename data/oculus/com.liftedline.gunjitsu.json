E254"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h43iH8fDegMQ7kNvwGbom86&_nc_oc=Adq91yIozfRUdAFUe3Zy_YQsw9awiSJfKAd2S1V02VHBI9dJzRRD6R-HPSl3YeC8pjw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN17J7L2WAvQYKzPCpslL3zGrISBo8eMPBaUReSARODRg&oe=6AD0D653"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGN-W95kR9wQ7kNvwE2VXwH&_nc_oc=AdpTy6UbI_92nV-Nf5kJL19IpggzeG0QwVAuAuZ6zrhSUD0CJYJm5lKh3U_p38sIrFI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGI5KDh803XBZseXWQTl-Wc1D2YPacK4l2lJvm4zKXng&oe=6AD0F749"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4Ju36ckn2gQ7kNvwGm-_UC&_nc_oc=Adq4O6Go-b99M03aSiRBbrNSjEwIu7hOmRJcwIAXeunsTqupzUFjVjWlrMQ86RPNt8s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhHBJbjMSapgWjsIxEbBqzDlRNMUcQOd5i-HwlWOFOXQ&oe=6AD0E8FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHABR6MeKxAQ7kNvwGD8lSq&_nc_oc=AdrR4UA57cJ_q2UCdAbeyWNvFMEwO_7PLsHlbQSwF0_YLnfAO1QmKg7K1DlpEjlutK0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFvHvqD2j8q9ahC0jEqtpgU9-WKjYgm3c0hbo_tPRTqA&oe=6AD0EAB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09l4HPy38KUQ7kNvwFNcLHV&_nc_oc=AdrBt9sGVesOoYcctOcKvn8w9m6rAztDURh2t8kngPa5_Y7D3eIXkJ2fAIA5G5Wz_HY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUIB6Xfd1bxDj7QwJ9UM8hy15A2A4yvcqO01tANzBgIg&oe=6AD0FBE9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
7D9B94"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyF-Yqd28-sQ7kNvwEXT6fI&_nc_oc=AdqGiiuPfE8rgJ6E4gK-hL7Ph3u6N6mcgJFRGj6OyALyzp-KhW9uOxNukR8DbXnkitA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb65pibf8opAn5736PUPgFOg1CPYq5j5yr_IlfDrBu4A&oe=6A7DC7D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfrKLOrqhu4Q7kNvwFRDvfi&_nc_oc=AdpnY_xq5lJTWQ_uvOSk9AJgN_Jd2_5M1teBYftC_f7uBmS1VvNE3WIIFBc3OPpCfTE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaEIaUjpmdYtxQ_Dja2wQpWg8NUYd96-9uGLuqdrejbw&oe=6A7DB089"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfspCbXZM1cQ7kNvwH9LlIH&_nc_oc=AdrlYIkbIV-BESAJrYh2u8xN69Udov37pR9UqVhCB3em-w7rmbYyj1biUkjJzelN2SU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGstbzu_Y8-q_WTw9nXawjB71FErSP22x8SDUhPX7ovNA&oe=6A7DA23A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V86KkZ9Td_8Q7kNvwGBUQ1L&_nc_oc=AdpMvISOFGB-lE62KqRLXbfDpJVDNwfM0fTV_HUn5T3YhFdARtsFQLFMxImlRteHFW8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHubhNLbl-lJQUg26Y_3Z_mF1KLP8BwG6ffYCtye3e-8A&oe=6A7DA3F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DucpGilR6wgQ7kNvwG5A5i9&_nc_oc=AdpvoJA9ghHV6AUkS2HqoK_GNgQ-be9ZaBC0YFb2952neb64lk7_gWtw0sayu4-6HF0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkDkhv3txH-rFPa_z3vyvOw90irwNQacWkkSutQiPfvA&oe=6A7DB529"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
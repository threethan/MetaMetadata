3C54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGIVEE0jwhYQ7kNvwHHS2sj&_nc_oc=AdqEzMXqrIfHDpqP7Mt1XvYvf6yaEg39ajD_8xfu1BFW7Fqwm9Rm0U-GoDqgKD4YJmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6mbMX9tvSy37WBpcbZTLC3PZVPhxzznwchJkl7Izbzg&oe=6A773053"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwzZAL-ZbP0Q7kNvwG5Ciyw&_nc_oc=Adp9dlAc5xhffG6qNYHTRZ4zYp8qXZVHl-y447Cg3gCKYYB_X5sygtI_qSqjzpyXKrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVqm8CQdjJ3VMgyZjg2GYfjQwCNG3xoiKrfFX5fvCzpg&oe=6A771909"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TioPC-Lp-fcQ7kNvwGM3f7d&_nc_oc=Adr8LfcM0FoY7FF6Q925Lr4waKXdVZNlaCX2husYSjQBIBlHaXqWQ-MHcNWsfgYs__w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiAvkClyFwkuZIrGbEkWTgl5VvNA2lbsQygU7Ftp0gSQ&oe=6A7742FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzh2q-zvUuYQ7kNvwFqJ5D5&_nc_oc=AdpycOTGP26_p-CenNWxY1VEZ77WWZ32me2Sw05pv3VA5NHXx6l90Eca5fnngUSn_W0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqw9eO07txRVU8p_9o6wtN6T5P5r7eQNN6uu_Vt8AaEA&oe=6A7744B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3q8-u0-P_sQ7kNvwEi47ZZ&_nc_oc=AdouhjgqYztnpqjICXWpUItM5kqxc8NzGWip4UPOBXg698Fepg7elI4lQOLkzKqG5M8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0K2FnPiZ8SSikHYhkhRBvwILG1_7XV9KQf06hQO0kAw&oe=6A771DA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
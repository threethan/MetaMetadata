82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8BXDB13RsYQ7kNvwEN5-Y6&_nc_oc=AdlhpQ8_sxYhlG_Lo1V7GQA7hJck88ryBMtj-tUezuG7PkCyUfNeY61n4Yi2xcAUmno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9UnOWUxBq_dnHm8RsKSFedvhA1DZuKRGvSSTkUBNZpQ&oe=69B2C0D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azqO3L0UsUAQ7kNvwFiV0Yq&_nc_oc=AdkNGqo3Lj4Za9fHUvl0wV7X1-E7IXDvL7SfH2eC2Bs2Wx7_QyXzKeTskVYAUAEVsZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyxASZY6duxj9aQsENc4aYbnHrFBKA48rYJJXkLmPHymQ&oe=69B2A989"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_x-XO2kl_IQ7kNvwHQ7CpJ&_nc_oc=Adl2-XW_mV0IhzJhfa7bYWeCKpND7y7B3mqBq6Ul7kkBObFDxqnIY1COo-La4crlOrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzAIs9WBsxpTQuzmlGlEjqJJCTlnSeZIWrRPFy9kX4zJA&oe=69B29B3A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUT0KohdZIcQ7kNvwFV3Vj9&_nc_oc=Adl398ckBcfj5I3E1bLqKEiIAy9-U4FRS7GXod-6jjwlk6A-UUVUZowoAC5ATt-Tv0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzi3-HoAhUlxzbY78oE6vCrgUEstidqw9eeZxbzOO6AKQ&oe=69B29CF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uySx-c_5QtYQ7kNvwF0p_Wr&_nc_oc=AdlAmLVYxxD3VkJggOTSQPXodBdmx-gzreyS5CsG3WvrRIfY2vQUBx-c3W5tRikSoB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6E1HMlOTTq8BqkyFdTcpGrxyvvozNewlVi7qFb0xXXQ&oe=69B2AE29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
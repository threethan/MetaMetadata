4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9PYwWzEJ1EQ7kNvwEoyVRU&_nc_oc=Adr_dL4X9jXuoItzStZfXeouKuE0twA8zvKSTIbRYY8wKIrI3vRSriRHqD_PiocJ7wM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8N7nEDN6YnVJP27BCzUV3HytWvBFUPODW2jYf4DkBpQ&oe=69CFC1D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nJmWG0TLd4Q7kNvwGYxw4z&_nc_oc=AdpFmAIolsP1QwfpPrZaJlswsW7-6th_pr7XVTysgaiT6vtL7KIMZ8riEml5LquaBck&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyF5YbZqRUNGoy0qQ6BlOfF8efWBBvlXiRZ5Yfl6rVhYw&oe=69CFAA89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyunVmzKi3wQ7kNvwHN-Aq5&_nc_oc=AdoKIUMQq51Nqzax6ucI-NboSsfOUjUpTDm1fIVKF-uUDPZmTyQAlu8vvvuEJjWnfZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzs6p_SDVlMbte3OFg8f7ttvMmGvltLgBaWK12fs9tdeg&oe=69CFD47A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESW4BwfIR30Q7kNvwHCOz1e&_nc_oc=AdqSv2DBqKUtinFCYxDujJIw5bu6I3SOy2VFr1EQ71SINK9pLTUqoRwpAKg3OWqAI9o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysStcz78gBLglLZZk2fi_H6742HYkhzIySRL78Jav7eA&oe=69CF9DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViBna8TOrtwQ7kNvwFC9J7Z&_nc_oc=Adq0D7CDiPusOFqSu6lge4qsbF_GLf7Nq4zONb9MIXOJfHw-xG7L4PISonxZcYh_gXA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuTM7DA8LNdIggQP36nBG6h6kbri1GrBycJozOT018Eg&oe=69CFAF29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
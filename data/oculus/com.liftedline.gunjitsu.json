3F54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyVqkm1-YRcQ7kNvwF4IBUZ&_nc_oc=AdoIGvx29-5ab4oQWVbcYlrFN8nrDmW22ii479BX7RPsWUsOBxuY0GKk8D86c_KwBOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8uFF5iV3wRl3_NP8_t_-KWpLHztTFZKyZI-eZMtfk7Q&oe=6ACE6B93"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tj0X1JkyYgQ7kNvwE0P0he&_nc_oc=AdpATohSd0c8dfSCxRc-st8YHK63b7KcyaDBSoBPdIlKG1MCSmCkBis6ME7GZnGX0wY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzLbgOGH01pI0cbTcdkH72HSy3BUwzxeSeOdNUAYMDTw&oe=6ACE5449"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4Ju36ckn2gQ7kNvwGebzvm&_nc_oc=AdrJ4x3mRYuCNcJuVL4Hi63UGdbM1m2N1Lshy2Rb982JOT7oIiBN6f7UlntZ44PRtnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqaZJISbGuBHNvJP9_-YcBTCmfBMhkpAnAZ-Jh7cSPPQ&oe=6ACE45FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPbIs9QPUJcQ7kNvwHWOMiw&_nc_oc=AdrqVeulMGUBMISkHE-s5i4g8gDYQW5YgMB_2WsZHsfo-NKiZ95UlxfsBz7KbVaYZS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdjQSnuqTqDpOszCqwEV7Eh914nxiWt5QEu9_uAfU1Xw&oe=6ACE47B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09l4HPy38KUQ7kNvwFyahEn&_nc_oc=AdrII3XF2Vzqg7LZ2-H28Z8l0DfFoMblfIw7yflkNk70JiTH4fFz2zP2FsuWpdxI_qY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9OcwwiDfMuBLb2Vpfpsb-P6uOlZOF3bAbbAcgAvPjXg&oe=6ACE58E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
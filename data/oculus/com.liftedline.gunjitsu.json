2254"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lea6W7WnAMMQ7kNvwHRvFiz&_nc_oc=AdobVdbT_d2zU8au_-_9D1q-V-4TCZrK8WgHBIrNxNt3G0vzPSuGDqO-mzwzEKdfrRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mAHNFC7i0EkrmcDZ6AaxmK5b-GNuhOvVBkjG9qdX1Ew&oe=6A281653"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R91Ac_svjq4Q7kNvwGDtwY0&_nc_oc=AdrI-FP4nP4_ANt1CnEyrp33ZvCRZRuoQQLXi8N87BzqequPeVMn6EQzEYaY6qiAOQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HAO_lC1dM30g9I6TvnPZJXAAvJiLKrpxrNLCTzLdOHw&oe=6A283749"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq6kZdCIrCkQ7kNvwHPcEoC&_nc_oc=AdrRMgPcDYMsdwnWDb5q2ODFEBzNTaUeOauzOptkoro9x3G3A3xhRHWNoNvKx-5nZx4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hX6p6Xx-V27xRlL5rrLquzhMjwUzqpLpy-0tGwAtNoQ&oe=6A2828FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIiG2GqLuBkQ7kNvwGXToWR&_nc_oc=AdoO8J745EioN62kNTfkYMhs_fL-HSviiEYa3gdbLVxdhEMJnfUr91zrp1Ixq_Ay9II&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ca9fbbv2ILtLRB5K80YKpvWH3_wWHHc6xnKoI2DolIA&oe=6A282AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSVf5e5yBKsQ7kNvwHRJpue&_nc_oc=AdpcrycEBxs79UNs5BCngnNZRpVjVU4uGABlsQR_kmZbiUuuROE7x0tu6rkW5HvyLJk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zWs3RFiW4A5KTtQ_wPFuPZhTjm49okkz6-RDB_-VglA&oe=6A283BE9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYksJSWTkGUQ7kNvwHz4XeD&_nc_oc=AdpkqkLoxT0dGdgnJrJ-S43irUxypYDPrDGo4KklkKoTnVerTc4p59Gx3aAN_5nLx7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fdZTvLL9mkKgOdaZO16_he2YBpuGWTxK2y8E-Xw8Z1g&oe=69F8A053"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itGYRcsTVR8Q7kNvwEzNntf&_nc_oc=Adp1ewTH3oe7ez-3izyAdcDpIfDcd3qGh6x4FpEVtRpzJ0U6dO55-p73oEevmMUttUY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GWXdv6rNZ1MBiQQaGQyasHUS8T0dYIO9pr2Fm1NlFnQ&oe=69F88909"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSr_jZmkEZYQ7kNvwHcOAaH&_nc_oc=Adp4BrxBFvBMolzj6XWW-7L_RH1s60Y0zspM7BZJCqjoYupLp46x1j0bdPkNSNtlX4A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DBrVEGfuMWpKuWZT6pkML8rph2XzsSHHwGb6EtRE9ig&oe=69F8B2FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrhwV3lQKgUQ7kNvwEZ-avb&_nc_oc=AdrNNJz7Vwc6OOjiDuy3Ekg8eQzMoel_TdKCG5I3j6eZvseaS1C2rG3p5DFgY-DkM18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1X6tWk1oEi2hxlo1CCDogF6oYKZCfmWSZvh_5RY9DFRA&oe=69F8B4B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3zn2dsUMPAQ7kNvwF7dbM0&_nc_oc=AdomVCJIYtcHq1Z_P7HQrYj8Mc3K7n6FCJ5t-PNQahh4rU1kgLeguBcToOPGAO29rNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SvO6DR-jSP6CBFrZ5oQA1h0w7T2gRdQdobttEpYfePw&oe=69F88DA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
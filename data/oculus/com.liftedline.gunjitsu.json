3945D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B44t3vhGa4Q7kNvwFtDqdn&_nc_oc=Adp40ufid3-HY7hg2fI_FdopwazwH3u9lVRJFUkjkMW7HTSxwK38Fbz5DVbxAvWbzms&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GZANKZT4Py4Sa6zUeOKt4FeF8nEdZOsVfGTmgwnKT0g&oe=6A3939D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrXD2BhbmgsQ7kNvwG3xEhk&_nc_oc=AdqL7rpnOAsRnTTPxE0uIhK2t1ztQs2xFRD72LxEfjNcXVu9WRYdm6y9Dy6k44wYdO0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T6FiusK6lIR7pircKI6E-KWD_i4_fjWu_hmGGFRd0ww&oe=6A395AC9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu_eCb4eR70Q7kNvwGFCLmF&_nc_oc=AdrT5ufrPY-sd3aHNuT8ICm7HbXwDCrsOI0oxZMqEyAOzc05VcCICzsUoTThc1OXrSw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iLM4rH09IvAZzdLFceJZCLM5-jRPTgRAS8knkIu5XPQ&oe=6A394C7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JQ_OthCBgAQ7kNvwFVoO3b&_nc_oc=AdoPyvVHUsLpIGWepaLtjudNfUELPswcML2INRRnd2AOP3xy7YYmA0wsdIt99d8RFpg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8AaQ4bIS6d9Bz29EJvPLWXphrvACWjMXkhh74-OWWEw&oe=6A394E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=653n_-NoXngQ7kNvwFddHmY&_nc_oc=AdoqNwq89eJMQAgRNkk53zUnZ2m21TqUOFVlMN7FaL7-suKSZe43zJK4sNbku7mpnTQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sH4Sg3-90pTMJ-Jlpx2N5duZLDyltGewdW-YW6NgE4Q&oe=6A395F69"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
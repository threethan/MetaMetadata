4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh3jtvTPXxoQ7kNvwGfcdHZ&_nc_oc=AdoYvTTAyHmxKfCld-qcmyMXKR4CeIyc6FSql70bJwj6LPu4pAkL4g1wTcIuwx7hLuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5z2YedNWLVFTFKbVCpkwANpbdauSP3Kbwjn8Hlt9OeQ&oe=69CA7BD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9epP6KMXq_MQ7kNvwGzsECl&_nc_oc=Adp5vxsxz6as5590-6T42F5AaaULR-9WoJu0gMLXyVncH6CChsWTkHqD2QsP_FRA_xw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhXzvwto5DEhOWnqnJYmM9PECWlxKg_ULH1EKtkibj1Q&oe=69CA6489"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs2Sv_QOD8cQ7kNvwH4dycu&_nc_oc=AdrS8cTGHrggHePMOljBx5NBptyTz30uRjJPPV1BL1hc7wyzAdrcycgc-7gPwLWdXVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKMed46ftXMdm0aqXAV0U3OdvWjTG1pPDDzDtz0yRM4Q&oe=69CA563A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXxjddQIM8AQ7kNvwFIU1oN&_nc_oc=AdphiNxoKb7ZUwZL12zYF1dT9ov6lSb5FnreEgXK38plYO5MUxKz2zBM8QuojPZbxIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySZagVLnr1GWLE3KcGoIPvxHz3AXyg6rcixEpInJgXOw&oe=69CA57F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxwsIwJ28isQ7kNvwHUME4P&_nc_oc=AdoKjrrOQkrl55cRvj4DF0-kkyxt8D7vLXEJdX-YiAYpGZyqQjvYQZzlaxk63ejzTGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDmH9ErO_lI9VciOqkLFqMWwfpBWJRww0pzede8oxr2A&oe=69CA6929"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
F954"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETLCfJTzvZ0Q7kNvwEH9S-l&_nc_oc=AdrOwzVptylZTwuw38r6HqUlfGcSCtN7XLAvFFoMLhyzeukTcGhW2hJ6D95WdgyKvDA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4wgF1TCQfuDfaOHOW8_cKeKidFEEYzj9mYAvX04EQ1w&oe=6AC8ED53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQo8O1d8oJQQ7kNvwHtPnIG&_nc_oc=AdrAnAMqWP7mDMdK2_M4qyXrxrZXyLFMqWFaRLNZcQg_itqbkJTEK2i87xEe6GEtK30&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5ylF2ZWqp1d2gmZr-c3WOd5M-esFnUFiQjILBhPJjdg&oe=6AC90E49"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBoR0p9j_B4Q7kNvwGNDGcC&_nc_oc=Ado3epqSh_LbXXq9zcwZEYnx2GjCGM3GHt2jepfHkMVlsQszfgvh-p3US3QTUhtdNpI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt7pFM0cruJde3x17X93ljgadHbGj_7aAT1XBjPSHOyA&oe=6AC8FFFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw7j54AMGhcQ7kNvwFNu94_&_nc_oc=Adpf5sn0Kr8HJxhTBevAR9ujWoMOxNTWb0ZhrL60gTB0coWFncyg-hpaksXvJpMYxgg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy9LD_MIItJXZt0dYTSJi_h9qB8K-LcqyCg8lkIeJTPg&oe=6AC901B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqpXFJ6VHrwQ7kNvwFGBxkK&_nc_oc=AdoJ7NErdwzXYkoQNUSBZ3u_IAmm0U9gbttGGPw7oDJalEHj43RBq9ZNHfCFEtj3oTA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO07Hr17KBCdcC2oJSYkEy5OUyirqJi6E0xQ29WPe2BJA&oe=6AC912E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
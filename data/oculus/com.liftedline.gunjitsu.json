2794"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrxA-Defd28Q7kNvwFMdls2&_nc_oc=AdqmR-WHbIw_XYnnH5-j21sKFXF-sYnedG9oid40x9tlLpxNZjl__ZNxbN6BViDKU4g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj05rXq_RiPuakhigQH5LK1-ZQHN2ikfOgOGxFHMNFCg&oe=6A881B93"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dN9jpmP6cXsQ7kNvwGjP784&_nc_oc=AdontpTAwlJQfErj07DV7uJbfQf_2kS_G5yEW5E_gsmtaUSKn-7Wy409s2AeRKoyfrA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhY_EmJRXOueCtftAAKzXiLgUcFJUz7jLMq1aYTIwwPQ&oe=6A883C89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lo3g1KA74cQ7kNvwEElSl_&_nc_oc=AdrM6SZBLwooevhp8D4jac9OKPfURgKVxEqlUR2tArdmUy4nQc38bVh4CKYjQr3lqX0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG24pyYUvSigAyB9MavJr77g7oRI3A156bzCAlDsJ0jpA&oe=6A882E3A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBk-WSbX0dEQ7kNvwEQ-Hxl&_nc_oc=AdpsGsbBg7v3IY8v4cMxHnFx2-WYDl0ctVTnbodDsGVoiJR2BWIMkHrLXZMu-YIrvLw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcLfyETVUbBRprUL5QN1VLQjbGlzb3edqjA2WTOf83QQ&oe=6A882FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljzd2rGuifcQ7kNvwHjfTdc&_nc_oc=AdocnXnpr3kM-KDstJDpX1lUAd3RlmOQqn8kDICcuHF2AXWRUI_BBkZAA5lSHXk9H8c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFhoh-yJAes1ybQZhgwXr4m0oSb6wvLWGSJGNzDHudGw&oe=6A884129"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNAVzah073kQ7kNvwGRnjNY&_nc_oc=AdncNWcLduSw9aJqIFdTPLTSP1lciCj2cD_YEdORMxR7I-4xjgpwKxOt5aMNvPJnVxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzJi8kcYfZ0eW0ew9dNFZups4iS7tWCWJrjss_SnHsoeg&oe=69B41253"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azqO3L0UsUAQ7kNvwHoJ5uI&_nc_oc=AdkMEo9FHY62wGN2fscEnRMpmCyyR4o9TyVf_B-MTxfy6aOcOP3Cdqu0oYyzWj0_mPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3s7yOiLfsOFvIYqZej_9LT0in9EI2KXuKLlWy7cApRA&oe=69B3FB09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_x-XO2kl_IQ7kNvwGu6fib&_nc_oc=AdlMvfJG5wD8nDx2GfAehn_HqJSzgGUygA7NrOtrj1RMOzpCKl-5mzZDZY43_Sy3F7g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8ZwvPoxYX_CBCmpVKRIrBWpvKdTScnT-hAK0DX7xr4A&oe=69B3ECBA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUT0KohdZIcQ7kNvwF7Slj8&_nc_oc=AdljSXuAClXYbYpO8ZQiZS_VHGWGYJwGwixaMJ2zs9gRJmRkroEyZybg9EIz2M5gcno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afya2Lqt-ksFgnu3S_HdVLZRZbSRTtaQ7PUky66bkJRn6A&oe=69B3EE73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uySx-c_5QtYQ7kNvwHUi5SW&_nc_oc=AdlEBux3lzG-iVo5pn48TbWnorAbcTqmrYi5d1ZC7-Tv2IQNtGOXtJ8PCygbi79XYNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7EeaSRR2j9nrBfAI0s7JY0A8JXCRlVfPtqSLhoo9vqg&oe=69B3FFA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
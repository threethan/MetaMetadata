5ED4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCX4EW9jl0IQ7kNvwF2AfjK&_nc_oc=AdqlefMrb9w3uh3aAoAxY84ul4fJFElK3CGhH20KMgf90UFoExJCBXqD4fg3Zkj8fDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw7wNpfHjtqEaCwGWkHL5QrzH7pL-57UxaNFlr6uMbeA&oe=6A6B52D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3sZKJ0k8-AQ7kNvwFJjymg&_nc_oc=AdoR_RtdCFKMeqvxidQQ0oXRE68ImPETWAD5jDJhZAqtykNaqJerYcxTQax0ED_Vtg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVT39aUhNaozSw5k0M29ozgQxWw7HAKAolDp7wUyzUuw&oe=6A6B3B89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuJqTBXh-V8Q7kNvwEKuSHH&_nc_oc=Adr5hxCkMPDe1Y9O7lYci0cwLhN-sYb8upT88D7sAz7kv89PG50fJX6H4JG_nQzZEpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXI_2EHvskPN9AofPdIrx8GJmpteqeFlTcpSb1XTlclA&oe=6A6B657A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOrDUzvnRfEQ7kNvwG9K3Uy&_nc_oc=AdrDg_lBKgShOd1d0anhst1LBe3qAnpcI85o2UoPwDhwrhDe2vnEk5iGzb1xri5X-jA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy0gE96UyraTerS1gBrO1-Sv4NZOjIiN3zR76yreOWMw&oe=6A6B6733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56-xtZBW6pUQ7kNvwE--jb1&_nc_oc=AdpU8RjHJ8Oo6cFsep0n_UDRZLeQ9sNm9HcK5UjWcVc2NtVx4523hUjbzsmi4G8YtZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi_XWVgu4jVjmpXaZTkrXVBY_6QomH27nc3b3lIn7OCQ&oe=6A6B4029"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
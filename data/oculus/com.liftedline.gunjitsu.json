15D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DQwUe4cXNgQ7kNvwH9xVDi&_nc_oc=AdoGmi2VaUP12lH-ITnN2g8SnRM4-qasSDRd5Vw1YXgmsrfCEepY022zK7I-Zv5o7U0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qBc8qhpjNlfo9JqnKU0svyDqDIBe8azRSMHr6k3F6wA&oe=6A0F09D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McjIW8GygOEQ7kNvwHmh4sw&_nc_oc=Ado1GU-NHcyqhdvcQuMQ1BedllYHjfTtil3O7dhPB17e37eRviwhoA0kD9wAwulwrLg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z8PXKrNmRjKMkW2VAlcatpSdjNzZGSUKtcg-XKZhGJQ&oe=6A0F2AC9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXDQD9AOzPMQ7kNvwHII70v&_nc_oc=AdrXnnxfkLt5-MZ-j2ISHJZkHpVipj6F6JQOnzR3A9JUf_tef9FB-J9UhHZRwuXmINA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4po8fV389rojsN_agGLDm2RgISD6b41woViSlQfHxImQ&oe=6A0F1C7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gJkq0t-7JAQ7kNvwHwWtxR&_nc_oc=AdpOS6WkXrgX3eQU9Js-i8Z08iq1stbOnk7jJdN5oQiJ12qUcd8ON4DbsREH9HPPd44&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hzWmQB4Cj5kPaak2PCUal3RSquY-ixP5hX3-9-xR10g&oe=6A0F1E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qv6Sa2xFF2sQ7kNvwHvmDg_&_nc_oc=AdpG_HV2ygDS3C6T98LjV1G9ifeRjKr-IYhNwOTNVZoyaWmF7SIe4FiFsFrEMFGMdeI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NWjKz1Popre3iO0JioU--QJUCB2NAUJBEySPprWfvhQ&oe=6A0EF729"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
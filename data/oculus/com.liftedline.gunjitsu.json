1qS8lhWSD4Q7kNvwFGuI87&_nc_oc=AdkrAIPcEGIqABsBn-2tAuXrkuLbsb_0kT1gbBdO6canlGv0QjXXlm7pLYjAT9XUu0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftHT0YhF07LyWBV-kXxwYhvvzm2s9RP5mS-QsplVRLr2g&oe=699862D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3Pjr69I_KkQ7kNvwGxvRDK&_nc_oc=AdmuDBlPZnuHwIOkImCTyBrTXSRiUv9iiq2sF_dmPK1MoTk5ZvB1iuxGp-BTfXbOXBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuJ4impY2UMvDkGE9YR6Vcw47pc6kETRdf16xcH_tKONA&oe=69984B89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxweZqRpruIQ7kNvwFpdEUH&_nc_oc=AdkKPdlbrDEwPHA4Bojx98Ro29LhRKhY2nCm2c_J47P31CeWAowgNZ86k-P7pIVRRkg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftPcGuNGCsEnEpb_YKymR2TuMnlVosyBnnhN0eO4AMNuQ&oe=69983D3A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm5HQ2kwqCoQ7kNvwEKfODF&_nc_oc=AdksNIjtcaN0vSmJtHZ4n9VTDPtx3kpi4hk1I9V4bfZz0vozckY3mz0hKZagByd3SQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftidawACtQik2zvmI-LwqxOuEcUTVkINwBVjiUWKETqBg&oe=69983EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt1RG_9SHzUQ7kNvwHQnhp9&_nc_oc=AdnUD0NTu7X5Haj7YhjJ3s3v3alLg7iH9hjU6mJvBwH6gIP7SagTeSh-Z2ucPlnFfeM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvnG_CIAmBrKADi63qUxvBzyov1Dj9p2cguAt0eLWIKkQ&oe=69985029"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7652038824880496"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com
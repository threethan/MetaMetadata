4054"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efxszM17jkQQ7kNvwGbK8Od&_nc_oc=Adr5wE_00JSm0gjHQ9nTrWayUNyhkwOJk5y7jljklx3sxVSdfSwLtrsNyWpEJ_aqSBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVcIwpsKgyY88CRqMrQ_XK-IxiWOCFCGLu06kFqZJiig&oe=6AEB3453"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQpmTxUwKKcQ7kNvwFpZI_W&_nc_oc=AdqypAdI1GWXblX_OuHOHb5JIpYxRqdQafwxTFP59cZ5blCKC7XQHnYmo1YJreQ0IPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbpUBtJRTCtS2vEGNTRtwZUOfGl01LGkPY9Gd7s6OoTA&oe=6AEB5549"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SaIVwiHKzAQ7kNvwFa5snx&_nc_oc=AdqcIt82yVCZOYdjt-cTMii80ji5afXbSnxKFaRNiE5mmE9_Mbsf5i8l3tDowA3H5QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQa-XrWpODLAh_HnWD2lUF2Tye-dWJMefAjFK9Sjnkbg&oe=6AEB46FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AxlinKXFHoQ7kNvwHOKnOC&_nc_oc=AdoQ8zBvwujDhdz_uZIvFu9XVJt29hf0DhrgKdM9Z_CZTjxNa3zukM93_wRFhydDe3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgUZ8xGRH7JCTAa_7uBIjxmBOdiQXVuffJ-Ih9xB0tNQ&oe=6AEB48B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL6GUm1AbFcQ7kNvwEn2PJy&_nc_oc=AdrEK1VtYq_il1bmO0VDE39IgL145wo6nlR3gHa4Ttms4eXicipOaQzDlN-ZnH0TtPw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR5b2hwj3eq4_oZo4j-Vimp02O1JDPvQ6Zkm_7eYgvUQ&oe=6AEB59E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
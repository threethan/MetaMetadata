1094"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e5jzMEboB0Q7kNvwFUkSEM&_nc_oc=AdoI1yrEjKEZnm0lXIjwhcUip8SHFvpWL_b__czSButPJoH7rZFPnKIkSI3cbZoA3z8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjfA4sjrPaHcGVDtCH7ss1eeVA-3JKAOxftHUt10G1pw&oe=6A903CD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4XSDrDp-7YQ7kNvwETv2Z4&_nc_oc=Ado0YcVAWB6D6EdJKT8EEZOm4IdRgvYEo7ej2gD_2zAClSG2oKdApHS8Af0TWlhjU4Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3nnD9OSSlENwuhOy8UC6jtBU_AMHsHphF2QipmY80Ww&oe=6A902589"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YgkLEkFz-YQ7kNvwFJmgHd&_nc_oc=AdoC9yHXcbwQv4NEGCFC3R05QvdHDwdMPih0-ZG8VSSJzNgkbgk_MvnyMz7fZ8k5mwM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErHW3a3geYNI89TAd86WAz9R4mASb9Y5OsZaNg7sboBw&oe=6A90173A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk16w_lAJuQQ7kNvwFa8gQh&_nc_oc=AdoYFwOciplGGvPpAfYuZjKE9KY9Klx1X5bAPe3Bm4BpGGOF6xuxsdHlY6CKFSYWcZI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRQL0M_O60nQdyWUEsjSI-PA-S_-zXhwCizQrSPPFDwA&oe=6A9018F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvZTXQeX-LQQ7kNvwGNUKK3&_nc_oc=AdqnMz7_HnVaSB9dBc9CB-EECa18dS6x_mW68sWAPQGF5gCjGsAPM29J-3yY6AG_C8w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5TlJKo7iD_XBCRJbVl5yHyZzWC-vyS9TOX4e4j1vTAA&oe=6A902A29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
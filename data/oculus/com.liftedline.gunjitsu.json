2754"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Omqd_rQg9pYQ7kNvwE2ofZf&_nc_oc=Adp1BsYeqRLUnV49xjmpJP0HfppT8eiTyCJX1TPNEINxFo2Kyvzqqmj67TxU2C_VLds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIOIyO8o9o3wNCRLkLEC4mdKCIzkZtJ1E2mSm1xN4bOQ&oe=6AB91B53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9qDPwVyHbQQ7kNvwEGLxhd&_nc_oc=AdrzLKulu_wSCmK5IzGRalsTJp6Adxhs-y5xfI8qiB52iiy7w110-vkbo_Zer6EvSys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM-m56ug1kpm4Mk3dUe5UKiApmLmRpg6CP30PH0D5NTw&oe=6AB93C49"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-WQxp3uDncQ7kNvwFbevhv&_nc_oc=AdqC_7RGlgzZXR1QkbJsgTzRhGfkeKqxajee00Xi75yxMAw4coYzbyOfv7oZJQqUbf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzkEiVd4-gXlDT0t5QCEUA_slG0BnIndothNnfDQ8tpA&oe=6AB92DFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gui4aegMVqIQ7kNvwEh5BZS&_nc_oc=AdqUPiJTW1IznjIYgeku_5g1dqgwweD_4zc-3BhS6xJX-GbDwjRKjIKwlTxFYyHVKfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYgI8OuqADiTGjIiBed69zmg2UiOAX3jyVX0-gxZ9sDw&oe=6AB92FB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHuE0EpE_AcQ7kNvwHPSQTd&_nc_oc=AdpPzwLKYul5W2xB6RFSXubQqipA_G9g9RWNAyv8SrWUkx-1WLy9O0ME-_c2e1XRcL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiALEBwp8obDz2wdASphhC9nW6EvW3lkkGdXh6WN-nOw&oe=6AB908A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
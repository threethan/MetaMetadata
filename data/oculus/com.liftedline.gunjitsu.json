4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1i_I6kIddsQ7kNvwGjJwC1&_nc_oc=AdqaQ7hfgSuH0Trwe_IyKUSP9mNx87epI1EQdCiVOmvIBfOleVXsc3NJh7HHZvyuWqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X71gGpEcKODnCZwIsjwS9e-X3r9uqbW-DoEObKDBLHQ&oe=69ECC2D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ_JerNJRrwQ7kNvwEL-hEz&_nc_oc=AdrclUEha9UgIVsUzH7MKzisYP29s56muPAktSSDQXaMYXqXjLxP-PRUpOTS5Nwvpo0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NLtGPLxefuF0j-CzXn3gv0SVCf9rHZ5mQJGv9-jKZpQ&oe=69ECAB89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXI7wb3AoYMQ7kNvwHwDbFz&_nc_oc=Adp01YIc3ySRM2cRG7o36jBX-Xb2JD6P0gM1-DqXa_krjnvIsqi-_ilXKAsqBYJjxAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_Gd_3fr02D0iva67wFn_qOC3BCDGQ6mAs4Kx_pp6xFQ&oe=69ECD57A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QldCjR8wES8Q7kNvwGD-3po&_nc_oc=AdpariwGnhZuCzhBmjZV2rBF2BEPOl6nembDw3bbN9w5IfAceFFu-wMGJXrgRTXgHmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_EMimA5zmXvFLF1RWrl_BpApawWXXs_UQqUlNYZN-Rw&oe=69ECD733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbozOuhPppwQ7kNvwFvAUWZ&_nc_oc=AdqDzTNgYA7QCLGyiaDsjQZwOaHYnlzODo7dWULa5I2OqInBF7Q5W3cYy9UJRtRgfrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3slz5Xf3cjcxu4lYuyISCscAV4Lu8z-k2F0HuYyRiZ3g&oe=69ECB029"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
2FD4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W-s9gzFEHUQ7kNvwHpCoi1&_nc_oc=Adruxp9uR590-o4xCDf4D-et_jtISolLnhgZuF5u2RrAxtnmWHHqG2Dny4SEFwWzWfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDij85moNP-QT11eapawMHDjuyUVYrnupKKS6GEdRBclg&oe=6A5E23D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DXO4jIULokQ7kNvwEMEz6L&_nc_oc=AdqM40R39tP4rYkPc8vKMRb8QxZt9PNNA4517vE0HjzOi1t9nfOj3zuE1MW8NZfBDEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQcDaU8V2NxLmikGT9DmwazDsWY6GB8EqN_DWKeF9-gw&oe=6A5E0C89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xS_wFTA3ta0Q7kNvwEXxw5l&_nc_oc=Ado-Xi2ntTVB7-UgtnLQOxuuJ04mQuuxNXipgbgzcvJKDpJTEKm6nwDtpQHOgf2-Pjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaq-ub-FO3cV36G-qE8O8fh11ZfUGzPSMk0eLvR7ZuTQ&oe=6A5E367A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBydB-gIiaMQ7kNvwF4wJBh&_nc_oc=AdpI0gglpwmgmIdWWcCVf2ehp4-QibpYsgxtsgAs-tCzEmWEULJxIyBLxgy5RMTqtUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPikSN9WE1FsP90IyIW6wyfQRnuvaXXUW1ykrZ0bn1KQ&oe=6A5E3833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvTxbXnW4LIQ7kNvwG6Qy3L&_nc_oc=AdpRzgxwxfa-y9ubl6PRLQyxh2oZnwNN3MedTZ8iM4jyTb1MI9JKK0Qn4BnYVzfZK1c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuXnS1D0PFrlbODzXkHtnotbc0N1vmJggmMJYyclVXSg&oe=6A5E1129"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
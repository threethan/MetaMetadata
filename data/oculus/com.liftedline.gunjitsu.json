F354"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZQu3QfqgcIQ7kNvwHWcHvk&_nc_oc=AdobikrbM_B-Gx8LFky57DqLL1WFLDwBjqOz7fCKPpydYjyU13b_1EKBD3aoRBjnrxw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73UBoSBcW7jxm7-zGhZ095UFKeTQAFGIDiWYDdIKbqIQ&oe=6A1AE753"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQ0uoN7ZmkgQ7kNvwF4MQ7q&_nc_oc=Adreth3-aZEJr40NwjZnvK24s30kx9sphAxnSRHsZUr3XL4VvWZkKn4LQIgzNww0BIA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p0nFbSYO4sSK9iJX3YcKP4ghdLY99u_MLIT94QR-eig&oe=6A1B0849"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q22IQ27sUeAQ7kNvwEQJ5tq&_nc_oc=AdpAHZ0Yz1cG6M1oL_MTeWQqUSYvrNrcQHupsmAThCRSkJZt5JaPrSzAgdA8GJBQSew&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lZhj_2bJtoJkfLrOtPA9flU3mOLV0ZKk6tQCz3OwuVQ&oe=6A1AF9FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJXnxr2cYI0Q7kNvwH0XoHw&_nc_oc=AdqaM241fynd6gDAWzKP5ZBuMe8A9B3stvDbP6y5z8IjnYCaag5giaUlYAQAHyxY-TU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H4zJ_JEaYSYfHwMCxMC7hVswcbTvaIaCm7IqKAwJEzA&oe=6A1AFBB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiJoY9Aw4jkQ7kNvwE8_aLM&_nc_oc=Adr1tADKEY7Zoiaaug0lR9UqaxHZkr4hcWv-QpTM02QQ_RjGFkseFcp7ZdH5xlNFhlw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MRNvj5KiO3qM_pR26VuZJ020ddJ0wz9EB7npm5zC1Sg&oe=6A1B0CE9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
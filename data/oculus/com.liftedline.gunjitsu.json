A6D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6keX2PYmts4Q7kNvwEYWVAo&_nc_oc=AdrVojKTEr2teg1hIJwryaUrEKTv3HbNEPj0gQh8a44evGQ4825mWWDWvBNbBOIBi0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfAD-O_UYjumt5XtYddzBSdP-TATD4EInfdhBh9fdNJA&oe=6AAA9AD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE4D-3qHcIEQ7kNvwFywyZl&_nc_oc=AdrLAZx8MhrWeXCikbiEE7qmBL8sh1D0mtuKTyWQ19CZEidcP6vfQ53T9eRguHPqJ4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_Z13S9iKgmL52nPQhf1JN0OL0BkZZoxtnIeSnlclK2g&oe=6AAABBC9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7PXbi6EuHIQ7kNvwFSPfqY&_nc_oc=AdpMpWc0qQwjtS9-y6sMvwK_64GKIhLc3ksq7K2pXHGCCF8XJe-gmAZ-TpaQ2YOArIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcaiebXE5cqL5cqOxsQC0Np91uh6RvN_5Nw_QDdS4omQ&oe=6AAAAD7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6NNBnD0_T0Q7kNvwF5Oe5J&_nc_oc=AdqlJShs2uD8aaZP-gKfyfkb3BSArqpOgdlaZd_4Mg_LndoxrlEbVfwaoYjn211uoT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgPmjyfeCjlS7FaPb_qZsX2KujPj5y_JgrrXwNm_cvEg&oe=6AAAAF33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FJINCozjQwQ7kNvwH5Vp0O&_nc_oc=Adr9V5gCiOaDiUEuQSgePKLxMAjP77ZbTBJjsMnDksY4_UqC91j_-WTTTdP0AZOZQhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBjshw_1P1z4LLTWdVZViME7FWIr2kOuisaiKyQ9fQhA&oe=6AAA8829"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
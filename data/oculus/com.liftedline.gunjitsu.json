A794"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6H4nVgD8McQ7kNvwF0MTjf&_nc_oc=AdqdLqfYhOuT6SdKeeZ_eUS7gUD62KMKrdZD5Zhi-PELg-YlSbPtsZLkU4xyDPKUtrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMU3ScPfYyUXb5zuQs-octz-p0n6L5CR-cRhy1koSL_A&oe=6AF89B93"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTU6-kpLHuUQ7kNvwFIw8dj&_nc_oc=AdoNSP76W7OvjlqCHRTiZ5IQM55juz0vFQCQViRMH7duHh8fjAQk1ez-B3rh1MS4JGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJF8qaW-q1Kf3fzlg6pOySQ_5Qm_Es2u4ElzrAArTHyg&oe=6AF88449"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMhmKZ-jfVgQ7kNvwGnOSnr&_nc_oc=AdoOHFjYLq8cHWgkzSJ96TdTtQFRlV2rS5_oJP9D__0CcOpu5A3o-916YM83jUvbTzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyRusViLeDRaEj0AvYP9b54Q9Jz3oXN7-J4HhRElVqzg&oe=6AF8AE3A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwwTSjodnxIQ7kNvwERY5P0&_nc_oc=Adq2G6x-rmBbLPr40i70i8slIRb5NRvAvBq5dmx7vtE1nZdJq-O1z2xpfWFRKNPwfgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs834qt07NPZ8W_yMBvXvr57ymwON_YkxwV154fRuc6A&oe=6AF877B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGnRMUvdFKoQ7kNvwEHrRdC&_nc_oc=AdoRhcG790KOehs9ynnRHCob9S46UvQpPLzLwX7aKtJ2QBto9PXGqxwxrhW3hp1ECTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpsR9uO0YuC833mR0s53yWtLzFuOvNslgqVMOnOZdyNA&oe=6AF888E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
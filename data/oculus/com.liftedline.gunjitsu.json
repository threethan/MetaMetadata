DB54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z58koAZMB-YQ7kNvwEjnSF7&_nc_oc=AdqRyhRNY348Ru_kpLnhaEP3cmWVBye_4WVs7E1QgyPW2LvtebZ76zy0mhGJfMwZ58s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49yyY5iQnPEN7z2q22ogdUZaf9xXSwUqs3xeu_MJNFSw&oe=6A05CF53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYAL83MyAhMQ7kNvwHzBmjq&_nc_oc=AdocGPQOPIUE_bE0Zgofe6ylXoVCXJIqyMzpVO_vfL9_DjzIhhOxsqvVIaA8UZuwGBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zk7TpUGCjpl6PsdiGkg6UmUOrLLz2l7rMRwNfw7GHFw&oe=6A05F049"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPRYslqncsoQ7kNvwH_FWZg&_nc_oc=Adoj9SPWWXqJPC2f2D55Xp65-Nk4Q_dHHUc4EEm5SuXNQVjGNrK3laRBrCo8YL1Nqys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CdCG1TPdlt-7vooegNdz9luJvjbnWHOdbUyfaTNZZFw&oe=6A05E1FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECTHAxKPzikQ7kNvwEf11it&_nc_oc=AdosRHQ-keXD4AFEtIBkNiyZTGqlfLYOpckIQt2SzVVrlWXrkdVP7S8SZoiUVw69FtQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xphoTYHc8BZg3JgSOCoaVs3XFbQ69WIUQDKH6FMpiuA&oe=6A05E3B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL1j6j2PyRMQ7kNvwHOoZwU&_nc_oc=AdqtkpAcyJHN2zkSAfXPf3oYruSEHxzQ_Qq3uEhU-gIaQxB0CMf9laqjo4HGjIg2DK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af763JGmVFDEqer9gpOq2EmURy6Voh_CdV0YI4l9J6FrPA&oe=6A05BCA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
A4D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR5P65TEkUcQ7kNvwHKwteJ&_nc_oc=Adr4W9eX1jpWhkJ_dufZon00T8l9yBKdjYoo8iei7pVaPhqUz3MTKwRiBTbjnUIIbhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPf1bwV6qpxxde1wT8ii-S3Oo65mNZ_pVidJbTRpLnIQ&oe=6A7098D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KQ8cZuUhxUQ7kNvwF0iAaj&_nc_oc=Adq75FS0ceDGiNglyW66VzsU1QAPRVXSGzHctatALAr6WLipGpuoRphmkGMbeQuWYgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-Iht7u_dX2oMzjj0Zp-lu_3eUqFcmGj5GDfpSUoMneQ&oe=6A708189"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJ63_WONeRAQ7kNvwE0vv0b&_nc_oc=Adrbk6Wnz_3pg4YGgN9eUIyJwMvQFkEEz1kDMXqqjNVn_BpCJoTbDtJ2MoK3uMA163c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrtu_KbKG-pWhkVl0P_dZA2IR0MAOKgjb3qaigr-Ilfg&oe=6A70733A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QFYLfBep_kQ7kNvwEwELUA&_nc_oc=AdpoYtHGgRA-GFiO9Tq51rX8Oes4z3jgvVOX4MpaGbtBhMHTJees9T7jqzPtJwJEWXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr1n-R5QaHf9HazDhCyVyKJqB_ic5FqvsqIOJlzqYu1Q&oe=6A7074F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUywuHglJYgQ7kNvwG7X1dK&_nc_oc=AdonVUsNON1M-FpGAd7dhU5QGvMAKal1Fpkn5gxCaeTTdjXd6hF9Djw8HPoQpu_5TN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpMh-bCDC26aTbm1Lrsn67j7BpF7JOhMqypi_pZK5oCA&oe=6A708629"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
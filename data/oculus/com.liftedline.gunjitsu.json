22DC54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P31GxsfsK8Q7kNvwEOlZwq&_nc_oc=Ado5nzf7Ahjp-0IWin-YWO7FuN0RVqNB5zgtf2kIstcVWK2J40RxrD3ysIzj3AlZaW0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KucgYgIZOZBBavfxQEJVsb73fqCwkRHzITmfCL1OtKQ&oe=6A22D053"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6ML_bXxq80Q7kNvwF4VHeT&_nc_oc=Adp9OHQakapbhuE05C9GLccihSruaq-cKMwnqwBGtJUTcTFraKnnLJvpEqpcipgnd2Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T7bqRO_ZOcJobk34TXg4WzTPosLKfeVS0rHbEJmFXFw&oe=6A22F149"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8j0jS7KGIgQ7kNvwFVCrfH&_nc_oc=Adpi-4JK70u8veDn0bChJhF8U78a26bzDgvatMDWLpJ1MaGOyJx3mM7VJU87ToDqVKk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wP7tFjWA3nwUEGtDBA3uUZ-IhnVKCuMOVMmXVuDR8_A&oe=6A22E2FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olXJer27ZvEQ7kNvwEM3Lwr&_nc_oc=AdqvHRSNef1E5i-79O_MWOw2viZq5F5_C9TwU9Sa0PfsmLijVkxihambn-QqY6x3Gtw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HoOE1uduqgGlJ3e4NQ85LAHf-rC42dtvGTIIAVwBQ1w&oe=6A22E4B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76v1TwajuvAQ7kNvwG8gJN2&_nc_oc=AdrI4BCI2b4A04zMWytNXx9Z3AlteuB7RhrK2AZFpVgsdhVyD1jEq0ZZNfg4x8gWnco&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xbc4ihk8F2R7ApePZxrLGaRzxnCtNrD3rlpVWsTXRBA&oe=6A22F5E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
A40F54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWOuopY7BMMQ7kNvwFM-c55&_nc_oc=Ado0mVCpEASWI3UjkyWAaMsm7U_GqWD7tz54_hwnZjmkTECxwyrt3i27f4wN8_s-aAE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXJjvi8-Bcr3GqTugq6ZHBJqBuzdhP0qSG1cnGULZbOA&oe=6AA40353"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAwKuCj0iR8Q7kNvwG7dcOQ&_nc_oc=Adqu4p22aHTEWc8fFewKILbQwVyOzx0kA9PTLZNzjKdyJRO2JtjaTyVK0plTTxFy5n8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkE-85_OYEMXqn1jc8-Rs9Kn8VBK4D5ChW0Juj7XyWUg&oe=6AA3EC09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x4dDz-4WLQQ7kNvwEoM1mV&_nc_oc=AdoNG2v5kHYnH7D4BWvFWI7zRTybKTp8Cw8v7Ko-boPha8YqT97JAKWeWMPHL0fKvPA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsAFjRc9IBYPvy4BDfL-MrjQVNhxLIFnGw6zq4GlkFYA&oe=6AA415FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cojguraE3mEQ7kNvwEXM-T3&_nc_oc=AdpkhW5E_-jHQSxrSMDfVzbpaVNVPBEmACWwec1oLwbJKLySmyhC8CfeN9iAauI4Tbc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAUZGpCt8gFyyl32b79aNPKc-RY07xLTFee2tREuLfJw&oe=6AA417B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdBqYXiWAB8Q7kNvwGwf1ym&_nc_oc=Adp-1VDheuiEPNweviRbh7Nvq6s6t1qAXUUYFl36fpmjw5AjqCsnjajjER3Y5ASk7GI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyeklzSJ8F3lZyzUbsQ6qA-HRSSDYkxXcy974kjoXxkw&oe=6AA3F0A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
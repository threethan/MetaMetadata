0514"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujAphlZXT9UQ7kNvwE0hzLS&_nc_oc=AdqiR_amGuD_vkcgVSaTuY24Hl_nVEpOHAaV5Zf2uMlU32sMJr1SCVzwmsHV6FhoQZY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmtC2Lw_kPka6kYBle_yQPx0y2n6R9Z2SnQYOi4AGdfQ&oe=6A943153"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xjy2bdx634Q7kNvwG7jULU&_nc_oc=Adqwr8J1NTRpZ854BC8PqGKBigzZBtrDYSAa0Kn40uJuhKRRK60XAiJ5cTeBUSyXDiQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpZND-8yjYZSW4iUdsBGOF1cPUEznInjJq8p0jMGWVfA&oe=6A941A09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwYOliVNrcwQ7kNvwEQCQ2y&_nc_oc=AdohFOkUujy4XdX6Eww210nO7rBpsvU8wqrakGip4yHe7majeaAhjFQZzIuLBMywBew&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfwwIrDWd_hUvQQvExTpOblWDZyN1t85zMiDgaLTxBYA&oe=6A940BBA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yn14-L9lTaEQ7kNvwFAjGal&_nc_oc=AdpHS1GgHjVUimFwQVsDEOX0TR0GIRMZZQbYCG5jNDRAXdYyVFfo3OyP-QGsJckwg6U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc1o-gwqP0ND1if8D7lmXN-TPt36sSCl-vfeSDeRsdnQ&oe=6A940D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-Luofk9x_8Q7kNvwEZpnvL&_nc_oc=AdohcpfDCRjrNUPrTvcP8Cxe8qN9V5aVXHedcubJIr5JzAn3Jm0cC08ehOGTXGDQdtk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHSYL4GLd4WW0ZS08DjQjK40T2cpbaUbUy4cQ5Rwoj4g&oe=6A941EA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
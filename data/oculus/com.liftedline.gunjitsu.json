82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDxdZcFVOqYQ7kNvwF0r-JZ&_nc_oc=AdmrsxGoheECJvGmkWtsmRFsQ1ikvp7RTWzaETwU0usXY-gGIzjyAIhvLlFsKLV4fpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUa81bmFQ8Ob6yJbFABMJeijos1Gy9hiWeBb-0VpiDjg&oe=69AECC53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8W8tWrh3twQ7kNvwF7wc1m&_nc_oc=Adn9iJ6fP51idLMuBZcb6Z2HkoxrRvpLyhVTaHVtTSa0McoBtKhfXc9tn0R4v4MNTI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afye5VGXPmAj9rkgaxnujZkTioRkaKU_O7jsIzA-QvsUVg&oe=69AEB509"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbmuMOgSddYQ7kNvwGAyLes&_nc_oc=Adk_eUj8H3UMIzm_rdeFMO1k_wH00KD_CtY4ITZ_1bzEtRHQIFixDVWDepPCGFt0qC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyPihqZ9r7cNCic3skU8NxToO2GuwMrAXFVsFo3_2s4g&oe=69AEA6BA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXUJfAuJPsQQ7kNvwGqMaCE&_nc_oc=Adn57iq-YN-CYhPRoNh9sDtx4v-UuIeICJohrd7G3g300uOt6SZa2JYGSvx1mIHpg4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0wBmeaKhxPIwVE8vw-aXA4rJt1Vjuo43W5GVfTAbSQg&oe=69AEA873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fRz6vFWqHMQ7kNvwGfHume&_nc_oc=Admz2mg05ImtOizuCl0uEoH7ARsNWU0q1R0llDHI3Ur4xWDdRapBOYr11h2XRSp0uoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfysPlkwh0yY0JtkYMhoTvYGJmDsGoNRi1ydAFyZyeHlZw&oe=69AEB9A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
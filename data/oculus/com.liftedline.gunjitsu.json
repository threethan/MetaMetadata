5BD4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R5_Qvl9zLUQ7kNvwGF8gor&_nc_oc=AdpqKOJ4XBe0Su9U5D8bRaqIG8ahgi9nteffpC0wF7FjQ0jmaJFweXBvLuUkigbRHOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oTZxwoPU9pw5Z6U8WGBcPjQc6Sklwe_kvl5b6kQlenA&oe=6A144FD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJEKUV8lMi0Q7kNvwHVf4iq&_nc_oc=AdpJ6dfydUh1qUdT2-QW8mWI2RwtAbg_GQSPBP2TPZ6AkLBO_V8TSKOhruaK1yXh7yg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KFSLaF3TWbArUNx1oQI4QkXyl6iux8hgwF8bxrvrlbg&oe=6A1470C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFLHcLhaVnAQ7kNvwGzVHVN&_nc_oc=AdoK2PktMdNHDHWkzxM-fFKa_c9fVRsNV2bzmKCnwAQYsjkgTGj5akJrbssE80q9aWE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zm6NNk3eXe_VYCAZipwp5bYtckHmDhIFvG84yub7PBw&oe=6A14627A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzgNokEvGF0Q7kNvwGNywqH&_nc_oc=Adp4W0mjdqFFdx2YTzdiHmABap7VLXcegHy6gANVyvHZrXoR_NO0VV5T0nFfZByM_yM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zVGacGJkcvXvukIGevnUttzf1bvmIwd7DzMIJ_ZRtBw&oe=6A146433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zXHO9nqAIoQ7kNvwG4-LVm&_nc_oc=AdrTrYbQ16L2hHWFxNMGuCwNrl4ir92a2sU6DiZ704HRKeReEmANBUET9nLaEGzk27Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zu9gbG4TNKtkn0WEeUcerLStfNGYvpANO8gakG5BRIQ&oe=6A147569"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
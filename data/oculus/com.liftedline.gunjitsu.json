4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBWidSVNwzIQ7kNvwFcZi99&_nc_oc=AdrQ_GyZ19MN7DWpVRAM8ygKnc_aDEF1mkS81xpm7EW-tB1qJsKuv5F-O5XmcPfzQxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cr_LLlGRPQ1cdlnh3uhCl9g-BbY-q6YsNzy8vDWHcig&oe=69D507D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kPmsdtj9QcQ7kNvwHqJ3qH&_nc_oc=AdoxPzfpXjtDrSgiNWMGzdbU1Wm-zM25YmAUjo_ymE5uPH4VTAHIgS4AQaFOpAJM1r0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08H0nIn7f7e4FqKKNGdEGZFExVTH6GXEnJCldCjcgehg&oe=69D4F089"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDq1LIK-ucEQ7kNvwGmaxEM&_nc_oc=AdqTE9antq9Rgin9AuzvA703_6eQnaHifxAJPRDsRJqTqVvNKRX4UkLC85vf-aXM4C4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12YIEzFVdE7wpCXovmER_cdxUiz6irpt0RgZUestPlTQ&oe=69D4E23A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYh1FGm5WEwQ7kNvwE6kve-&_nc_oc=AdoS3i1NZSxP1zamHUC0ojDQ45pnoVxGD_xfn8Hk3eqCPIk9zIL3jLN56xhzTMTNTLQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LJJHpNE8waTzwgZuHrvKM91X5IQjfmTR42vDft0407A&oe=69D4E3F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUNOVMcflMkQ7kNvwEIIA6m&_nc_oc=AdobVAl1Qv9Qm4KXy1OgkB7D4m0PnAB8IKMQhFs-DluNeyeqBmVCPR4xdcqbvEcHSpM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X0KiFLgaRUmGJdX6bq7yuiMMbZhyj5DIJdxVsHc3jOQ&oe=69D4F529"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
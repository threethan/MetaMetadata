4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUiRrBiGZrkQ7kNvwEztlVw&_nc_oc=AdoElH50KSNIIOx8-STlhAA_DNEi5QZWGCBymt90ePe_HBFDAWvFRSjuQ-m0O0UO4-0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcyeFctt2OIDS4wC4xzEKS9aCBfROHdVfSFROoWVQWoQ&oe=69C535D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0q_VpJfm_AQ7kNvwGWTAeO&_nc_oc=AdpwD-zPrGvq8tO_BOjb-FOTl1R1M93oLybZvCUT3Pu7rvInJhdvNvdocb4UT-a856w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuDiOQehcqfJvrpN_g6xfCEA3lBaWF1ohGsQ88Far1ZQ&oe=69C51E89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHAkEJwnGocQ7kNvwG9Z_YK&_nc_oc=AdqBwKgaHAcl6d5jBxe_SiXOeL-rUFk8Da7RGsms6E01rKVtNZjJaJATjwaVmSXXUPk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBeDJowO-Smf-hQ0NH93DvO3ut_YG3JsV4GROPAhjJwQ&oe=69C5103A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6ngEZj0c3YQ7kNvwEVONVw&_nc_oc=AdroEa8YOo_rmWuIpZTNnOUoSd1pniZSxPRiJTiL7eUM94dNCCdbg3tZvSCrSPn7go4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8TZSLP6TcoojGv-q2zzSuZ_CzpCETHFXvx0Ef66ew7g&oe=69C511F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjMdejNxXncQ7kNvwEXIp6d&_nc_oc=Adr1xVwxvJwlKJGLURsJnFNsVrmF6Z7u4_lfU3fG_WSFkq3JOgPVvG9b2dv-1eJvDn0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4JEXNIv8lk_YGCGaVizQegMa9Yrk88wrunbb-ixRqmw&oe=69C52329"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNAVzah073kQ7kNvwH45ZuP&_nc_oc=AdnP41JpmbQ15vjNJvrbnRQZEIF1bj9IKSTdOqhKvsigJJIWal69R5wgvSL72J5vVIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx61-HFe0GhczB0Mlh3QlYB72oJSBljhmjsho0sJxGh1w&oe=69B6B553"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syy4AR_bXaYQ7kNvwF-vuqs&_nc_oc=Adn-7FzypEnjvrO8JNQLv12qqmgcgi3S-iwrv83thBqVPnG9WYIRREQHiuIROC1dAAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAOsArNt0cXgwRR-6IekGGKHYJqJJcXKQZxGvUtoFqVA&oe=69B69E09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCkLosgXKBMQ7kNvwFVouB4&_nc_oc=AdmQhWkI022oo66ox8Xa9ec_bRC4sHB8p_hatI42bRv6jdQEsrI3i9uSOW62-EIqaVk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3QyZGsyLnnMb97xnW5fxXz3f-U8Yuqxov7VXc2gz-Bg&oe=69B68FBA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-idzw1D_WAQ7kNvwGW46-Q&_nc_oc=Adm2QCYaoQ_uf8by6X7MUpY2VrDQd8znEYRxXuv2LYiT2cU4_VTHQp71U8T2ZI2HM6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwJ_mMgww0GLBjF3XIKP4rBDGp3FEs9SXnx0RCV9y9wQ&oe=69B69173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLQo07UHXpUQ7kNvwHb6Wos&_nc_oc=Adm1ckHp-SSaGBSsiUJkGVwWXKOmpU93yyv0pTl1gta40Gal5PrZsF3UVAKtX3xNJnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1rbNDF1eDvWnizdCH9ay0IO_WCUi4yM66TNkPLlaMow&oe=69B6A2A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
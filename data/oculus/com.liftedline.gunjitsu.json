02082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsRqZYmXVDcQ7kNvwExy2Nd&_nc_oc=AdmzHzBz97wRitDJarUfVgKXkZ9ow4jQ_doFT3EFQNAwUno7q8c-yQDDPv9g231ydg0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGn-8MqW-O7xY6_-WzDatPwth98btdRLqWW6QpQZ7Tvw&oe=69AAD7D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aitKGoMD410Q7kNvwHMvSMJ&_nc_oc=AdkKyJTmj2pCcU1421iWgJIaBwol0RWtXNsdwt54JWu7MTSwO7nS8xrTybB7of9AzrU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afws5cNZTO7-7jbmZCPnp9PWvSEj7DPqaXEYAO96HRC4yg&oe=69AAC089"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0U2fXEu9zcQ7kNvwEVFJfl&_nc_oc=AdlGZv-zOt-ws6YJ87vXyTjtERkZqIkTycr5EwhLL2riCDtjyV47_0Dho_GhTqGwm-Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afzv1jeuwAVxF4b_5AwEy1yd1SojF1vYLzVl-euwZ3D3Uw&oe=69AAB23A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNVZjksEjqoQ7kNvwFkVzDN&_nc_oc=AdneIf0lN_mBsmiSi7mbok-9uIXh0IsjQupv5JFohw8S3IJW5F4IGqNhsvg3U-J0UF0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLPmTA0oMqfH89nQ0TB5CYrrJuDbfdD-UlrMiZQehFDA&oe=69AAB3F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsE0DicM_yoQ7kNvwEmNOA7&_nc_oc=AdnNAeUDdfXQcWUhhU7ymcyPlxm19KLTsWDzAAXlChagImzm-UTqrzTnCj1TDeYdYho&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwaYEYL0GLoRtg5-NGfabHHaNM4pqM9U0qO-Q3MPyVQBQ&oe=69AAC529"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
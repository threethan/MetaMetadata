30D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFaRTNsUsCIQ7kNvwG33IF7&_nc_oc=AdoeYvtT1cn3sgHD5USo5X-wcVF3M_bKgQDv5x-O8SeB6znuLblPtqQQAyhjWqQh3O0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjSdCgLxZqEQ0UgFVT7P93TBGJJQVDeY6HhKUAE13Eaw&oe=6A7B24D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN6ThCANPRYQ7kNvwFd-9zh&_nc_oc=AdoZahWe9BlZUW8A-Bd4lhZtLshHrmsXydoQFPreIzNIANCoAgfVlBrD8kb4mdGpMD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_hcSSoTROK8Ui1VSzkyb0bo9h6pULvlvc4ahIvwBLaw&oe=6A7B0D89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfspCbXZM1cQ7kNvwEzpPi4&_nc_oc=AdqOgxWy4IOPy1QxTR4jvhCR6P8cqSoakZ90yoB6-AfeX6lnVKtGfGwMDlYxdKCzp3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLrgYBDfgZBCCMMq8c_TJ1B12a4AFM54hBUsEas-ctKQ&oe=6A7B377A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V86KkZ9Td_8Q7kNvwEUEXwi&_nc_oc=AdrKXYPhyAsSjg011BbDqhYKD-yuuzhBLiAcYAYos11taTEM8keVqYRjAFqO3aaqHDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl_OaTbtbOzhOlikly6wIRuhOBrJ1UFXP8eIefPnCJLA&oe=6A7B00F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DucpGilR6wgQ7kNvwHZTw_0&_nc_oc=Adq1Fi5kO7zjrQUcY5pWU7Zg-bdNwwdU5R9w4IQKrpA_emdfDWxdCphyaKo0PpvZzp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELYkMFUcgpOchGEj7Ft46iodIk_RaMHMBf87jjng6alQ&oe=6A7B1229"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
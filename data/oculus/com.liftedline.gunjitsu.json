4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-Xl7oibs8UQ7kNvwFyCdZ2&_nc_oc=AdobJTAHiZkugr5O_VcVHYRWAKRGmGA3gOQ8MDZOBl0lKv4Do5uTixhvajyX7aQ2bcU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00XoVWxQt6GXa9KiW_BA7N66MrXSuXVqGVD-AIbCgdNA&oe=69F4ABD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d1in1wP0vcQ7kNvwGyiDO6&_nc_oc=AdpcVU3uQO6ELt8kOfR2xOaCjUOKY2EOvxITgbmS_fbkbjnB0aoK7eSSa3Q0ZIqxaoU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PEyZjQQQ0OOW4b30q4SdjShKqUFx1VK0YV--zFixezQ&oe=69F49489"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7ENszAGksgQ7kNvwF6tmC0&_nc_oc=AdrJ2ALewh3EAG4JB9DdDyPUMImBSl2IqoYLdUzvJVtEzvS4kM5BV5VJasr7CyVPBBs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CFOH8tGW6duyslTqbet-P1sc6bXqqNo4y97_8vbfkNA&oe=69F4BE7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slgXfoqED34Q7kNvwHNcWWj&_nc_oc=AdoiLPjokXXQGxVzYCq8RRrWUrEtT7DiNDa9cZc-LopASIHy8DAttoeqnxs7QsXrUJo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24tK1qWrXUR6IJMEPu8LZRPiSAaFCGPubIsj68IIGkFw&oe=69F4C033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDKoxnJtRsgQ7kNvwElWctl&_nc_oc=AdoQ85e_4K9kH3J4xXovSCpLqBaeWkIVj072L7YFWpBKYiGNXlY0u8aXWPEdCg1ncsw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Ft6Tc5BEJyV4I26DTf_tWST6vBjH_8zOED3KIKt-ARQ&oe=69F49929"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
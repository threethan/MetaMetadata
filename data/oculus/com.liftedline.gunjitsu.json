06002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gimya2A5u3UQ7kNvwFJ2W2R&_nc_oc=AdrbXOOizY4kJ6pdSxZWOABSDUzj7U7-Gy-5S9oLoJAspDYEksPzXe0oWtDwgAPtQwY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af28E0N2Cpy37IkTISvZpss0QO9BmSdNDA0PoO7MQSC3xw&oe=69F208D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d1in1wP0vcQ7kNvwECAXH4&_nc_oc=Adoj9AQ7cTKwlup7YKkdwE__kFCz50OoMnnEfhKGIVLs57yyEfKDmx7H9xCElNoxUuU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3klQJJ1CxdXsYJETwr5oeZhS77iJwAjHW7UHJSFXU4GQ&oe=69F1F189"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLsi6i_PZuMQ7kNvwGw4ix4&_nc_oc=AdqRWxmJ9htpXdYqS0X6rZzBh7jP5GvJCO_X4cbfxBETjbom4cI2gojIeTxMG5Rh6K0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1503GtGe2WWeDwQ7pnnxRld42b7NmS2nJX9rjYYcP8AQ&oe=69F21B7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKdnoSmkPwcQ7kNvwEtiatD&_nc_oc=Adq-JhN3daMFfvGDp3t_0BGXsocYi8pn6JSGRv3abgSB3V5WxP3v1mIGhvNnV8_jlLM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CMo7c720Thjnu3yhb61FJXMsrEqGBySNfLrsFH-iCDA&oe=69F1E4F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNseP5wl70cQ7kNvwEBLPfM&_nc_oc=AdrJ1Iv2YNsM5kDZhc37XERFwU6VEq-9i_nEA4IsdQUCT8kKG62lOjAhzZ3HaczY70M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cwoboxvz92NwNoxp7Tf_ue5N1NgmONZKqr_Om1aT-aQ&oe=69F1F629"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7652038824
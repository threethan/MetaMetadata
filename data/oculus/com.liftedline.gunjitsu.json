4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYksJSWTkGUQ7kNvwEDcQMk&_nc_oc=AdpsTXdlpBL9Fey5iPS4W4G34MpJ6WX-ZCyPGqHGuCAQhNvWjuq6TDT76vUXxAc_VpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h-8vSTUB6sXIe9GSgjH1Z5xBLwM6s53IqDNs9YhrX_g&oe=69F9F1D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9oCTODh4PAQ7kNvwGIfmFA&_nc_oc=AdoAIbQkZ7AO7P-3SmbDUKYwYYMs_GqgrsS0NRrconM72uR-CPNFZVZXq1IKp9iY3-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6daC9RPWx9XnFgmkSI5cnOWwM9Usif_1tQSKMMUPmVvQ&oe=69F9DA89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSr_jZmkEZYQ7kNvwGbaIPg&_nc_oc=AdpqjE_wUJ85HJGIM6Ihxj_jKIN6xXHQ4EWkghskRZ4YEj89GCSXUmpcS1j7lB0B8AM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZwL2ME_bVwMGnWtDtRGzaHCQl-zue_Ugm1A5He5BOnw&oe=69FA047A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrhwV3lQKgUQ7kNvwG-iTqX&_nc_oc=Adr2AC7cTjLoRuPPkjxRjrHb3poZQyZNM4jybdkyp8wyR2UYAtnMYU_UrsH6ffL7NWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59ftq9JlIi7POLuQ04vostetUcTL_WjpiX0zO0mYivvg&oe=69FA0633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3zn2dsUMPAQ7kNvwEevNUC&_nc_oc=Ado33BcLVjZzSzb85IVq6qHVzP0AdmaEEwln6uUr7XzMPuri8LlQB0qlvLfglSN10D0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tkPZPE2bBaftJkvyzmbr5-L2w_KX4sMDODY5s_0_GFw&oe=69F9DF29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
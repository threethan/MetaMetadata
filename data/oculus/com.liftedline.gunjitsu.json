E194"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjY4XAZba38Q7kNvwHxQb7U&_nc_oc=AdpVmjdtMZG4ZIFCtHHnqlVN2CwqYxH0plteKQBOSz_fy2CA1Sbig6i9potOrXWEs-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQz5IlmGS48KipTbq10RpkYKZXkGdGaekaN_zIP1NJxg&oe=6A830DD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szOstdEox28Q7kNvwEVrxQ_&_nc_oc=AdrD8DyjMIMKGA6By1xhwb2znoAxxLX09_vl2Pr9S7eTt2Y3Spt6Kxbg2IrrH4va3R0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGLp3JJgXzAKoV2Pf6VGsK0NYm9eLcYWjsVFBs8z6YFQ&oe=6A82F689"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1B9j-coKvUQ7kNvwGu1SEr&_nc_oc=AdopEXynmn70lp2WDXUgqZWU-mvd91ABdVgrcETOTuP1p4mkUwjlqn602RJ7Efkstyc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEX7Bnaa0gwjNl-hHBL9rKeUHQnN95OgT2G9_nzy6EsoQ&oe=6A82E83A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68_3KPXO3A0Q7kNvwFvxUlO&_nc_oc=Adr4XrndWrYzdhhIC2vawZDjLDTCHSIFSz7IGWjh04cf7Bg6yhBgGyf0cev7PCce86c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8dsmO0YssPhwdo9U75h7MUxLbzVj92ih0ms21Hw0dzw&oe=6A82E9F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yA8Hstowj8Q7kNvwGYPMu5&_nc_oc=Adqfi80lFa2wihv4sz9zfcmO2L2gBM5OVRp7ZgYnMeijY-sZksoRrZwQEUXuaKkWVJ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDX2XWFVlgB5dC1x7ysUeMfu11_o7_eivz0vSHmKel2A&oe=6A82FB29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
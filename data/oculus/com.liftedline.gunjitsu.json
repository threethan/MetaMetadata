82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8BXDB13RsYQ7kNvwEDKd8c&_nc_oc=AdlPZVRJiJ9QBzuPwk5S5qZAuWiKMcFLzziiIoxv_v-gJi75btTm-nTLa6JCscSwl8I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMBeog_5sVy6HHrh7aPujd4L1tXjqSzuSBiDLK7rxnww&oe=69B01DD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8W8tWrh3twQ7kNvwHCE8Lh&_nc_oc=AdmLwe-TFlvw-hJHDETEDeJ5WsJ2IJ3OukyimZXcaHPujPm4JZG0r4DvpUXt_XN9fUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxn9gf0J8-DoLdUYVTCqUfuvoaA9OfflZi2werx1YS0hg&oe=69B00689"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbmuMOgSddYQ7kNvwEL1LII&_nc_oc=AdmVJHIFXGzY-N3e1z9sXmbrV3ojxc1PlzRB3RmgqIgnkn2RzTxJO7VNtVPFZAFCY6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOOqjStprfhy4-l3OBEnitRfdnGceymGJNDJmS54-Elg&oe=69AFF83A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXUJfAuJPsQQ7kNvwEb9ras&_nc_oc=AdnL3wDqmyTZXsopivHVEQo8hSzQRT0vnTIdmDfwKju5EoNIZ_SUKJrCdUy0wDAIoiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIrMgVynC8UJyhqUDYJCYz4BoePy6NcxIn1B0HtnQ5pw&oe=69AFF9F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fRz6vFWqHMQ7kNvwEy8kX3&_nc_oc=AdkTL457M49jHZKxaJGmVts0ZpkVYA5ONU_JoIsv2KsfS2ipyS4goafMrclbZ_YR51o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxZgxkqy9aowLbPuULxnkyhzzihyELRBAH6yTQjuX1aw&oe=69B00B29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
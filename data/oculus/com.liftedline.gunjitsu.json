6754"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DQwUe4cXNgQ7kNvwFNyxOl&_nc_oc=AdqYD9CmZXnGii2QV_wxGxvJGsduRaN3pecpDG5R7zkEbWLpoJz3X3U_G26h7GN4NNA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t0IeOb9Zyp4exAOFJHi4mA2vPwquea-sPhUbsfa321A&oe=6A105B53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McjIW8GygOEQ7kNvwFjYM3m&_nc_oc=AdqKpObt8RTDOF709rbkk3XbsYQr7mD01OKS4KU-o9Np3ikfk5d926NO2vE3NtFKYkI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zMFzBJo75pq9KsG9EH6lh-GtTTSPxLFjkQh1d23S8xA&oe=6A107C49"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpxrj7wW27kQ7kNvwFXX0EF&_nc_oc=Adr8rCOujVA54cN1SbVR467ZmkPkoNdARAKULs0KQUjOrFl6HuJ51vO6Zd19XJhuWkw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r3xsUyZUXPYyLw0wEXw4LgYwQ6GSl6Ys7fmgg8irjkQ&oe=6A106DFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gJkq0t-7JAQ7kNvwEp09lY&_nc_oc=AdqyDnkNeTyt5lFX_rrT1hp-zNiL6IVSpYUeCcmElQqZPdpRQafeHxsdpN09i7JyOjw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JjLBn-CxEBUQmmbVJCA06sxwnwMKMMI08bwzSLA65Ew&oe=6A106FB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy78_VEW_OkQ7kNvwFLDWaY&_nc_oc=AdrkmHd-DeAy-nvrY5C4tMMBV-3H6Q1eMVpzG8Kad20ZKkuL9OhrbF25bdaZ_eQeKk0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m5e_iTyWHpl2QkT4z3_FWPSNw1iBnhUbmQNQZPMi5jw&oe=6A1048A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
D4D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9gVnZAeEcQQ7kNvwGTTn1q&_nc_oc=AdpJG9V6S5_I4wOF3nvv6b6uwIZBRIuE0juZQRaN0jxQV549fxxSguG5CEkzrrxwabg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzsrhmucOe_mt3Yv2jewRdL9hw3l9NzMHTNFZKrX-iEg&oe=6A9AC8D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zTCMCbEer8Q7kNvwEppxr5&_nc_oc=AdqHL2pJwZAAK5IP61ICWnwac4Vn3De0hHDk_iD4NCujAqahC6HHFExwfSOk4liYqJs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIST8zZjrgQoJ-r3AbtRgDT02YzlMXR9cjCNfKl41saXg&oe=6A9AE9C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo36Xm8BDEQQ7kNvwGpba7h&_nc_oc=Adpvopg7tLBQ4bEaOGw_EadnJ2VJOYNbzsYLDcvPhtJYzf5ENyXwkjjuucw8NWoyHrg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC5VWpNY7EIBHaKtoD1Uhyn1-WeW8y87o-qEvH3DJzUQ&oe=6A9ADB7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVAp_awUciYQ7kNvwHXXGEa&_nc_oc=Adon9uWdXoEoVPySzZfix6ZjtsBH_Ap6d3j955sdDm_wOuQvi17U7j7M7kQ3f2I958g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLspepNAzYw4UZMT0hmkg7HDTAmwLWqzileEZggxclBLQ&oe=6A9ADD33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9_KW9qMcc0Q7kNvwELklg3&_nc_oc=AdpJmlLkCf4w-dva8Xqd4ExDw8h1vmyb5VFuY7QzIjpQDCWH_zBAo3vuhUxUoo4GySc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHQHfqwmGqpi-gPkn5FOtPtUnR0H15wmtWfFP_o1subw&oe=6A9AEE69"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
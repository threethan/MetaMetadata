6C54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWOuopY7BMMQ7kNvwEUtuFt&_nc_oc=AdrFFCeQt-B_bBx_ivOzHChM7i27G4sOhlBf4IFH8WVlmUEt3RawtU_o2p-YYdNCgWo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLowSvpjoeAvdtGZiNU7k2bkIvXyvxWoh1vlK2YrH9shQ&oe=6AA16053"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiZ3rexP7gYQ7kNvwFOlRqS&_nc_oc=Adq-_D8bQZoqz2o9Zp-4c-m0ofvqw2W00ppZhMG1G9F-kxyVlB65hR8bCIMONCHD9PU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyuwoCR_zHMzjrsvST8KE-3MILDfyQqyV7AhOmANHdMQ&oe=6AA18149"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b10UWetrJv8Q7kNvwEkluTk&_nc_oc=AdorHTvRsDpV_IX1Ev8hTmnyRsj-I3oJ57m-eidJP6E9M9hU3jjaxiMq43JxGHBOcL0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgeIq4mH9mp4ifVcetlB78FsaVSIRW9E5Wsidili0TvA&oe=6AA172FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cojguraE3mEQ7kNvwFfvVsX&_nc_oc=AdrQUxNPiTwHGh3RCwMNNbrR3TnIyYjgXaEok6fxXNTII6BuyXU0I6iqHnMfSzNj68Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwAZ-TURb2oi9WpaUHVUU4IZJVOYT-k38PK6mLdVx2gw&oe=6AA174B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjOuJolS8MoQ7kNvwE2mYii&_nc_oc=AdqWI5HY2gs_QM58RvPzmtkWlp43s8aV0ashTV2wmua8p3hdGq3qWfBY9QTnD4Noi68&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2LD3IgGZO1IzDuR2rethD1l7SfPflxFS2pD24LrVy2w&oe=6AA14DA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vkyc3L9H0YQ7kNvwFkAM-V&_nc_oc=AdpLsl8nmt2Eg-7lq2Z5inriedEPQPWGctfLxINS-uQIqOpRH8CJmpJ3cjgRWarr508&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzr-7dq0iTBnGIrllU4xlbCX6ZTEkH_tFuqfBcmBTKpFg&oe=69C14153"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ypiaPsN4LIQ7kNvwEoEv5B&_nc_oc=AdqnGpnwEFdkLJwI9kfMkQdWQyYlBH5NE51p-gT_jbwrpDAExZTZTCr3N04BpL8a-00&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsWyd048xBCq093feKc6uUfsTgPpLwtVO69l8dqTwWvA&oe=69C12A09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61VGV1Xblu8Q7kNvwHVSnMq&_nc_oc=AdrQRgLM1LnlaqARMpeRFC1RcoczgOp3WEM46A2TF2DX5kWvbLZE6Asl9CcnXQqnscs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3bj01zNhuaHJdlrNaQ7DzGPvVPffQ5Ag720Z7m8BSJQ&oe=69C11BBA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-_C1xKk2r8Q7kNvwE3L0aI&_nc_oc=AdqmWexSsu0BCiJWAzUL02js_pFLf4FDxKmTZsro65VYieOUc0qjo9wzWysUMQ2DAEc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwN4vqP4SKVDtWKmp8UvAQGP8KKUaHhM4gHF8BloC7ceA&oe=69C11D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm-1q2oYNu8Q7kNvwHPnr5q&_nc_oc=Adq7t1Nr_hayd7J7_pXkXIRr8Yaa6Fp8OqMXYqPx9tfCYVW4DERe9r4ve-aJISkQndA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOLvjYAuLHzDKkT-kn9C8YZ8gsvJupBsxaA6kktdh4Og&oe=69C12EA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
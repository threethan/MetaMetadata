4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKGSmD7qTYwQ7kNvwEKCYtf&_nc_oc=AdpI9Wif9QpT0eSzwp3LWsT0aXmaZEB4bVG2_kKiIFe0H2aO4zXbQGUVJxJj10Uuj6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wFfPaGZGnBz4PJw_c-_Qt4RCqkGLQ370egq8MPqWVPQ&oe=69D8FC53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJoWr-yIB9sQ7kNvwEb9uRg&_nc_oc=AdqsUrFjtZjEMMnT39Ypn49Vw08RkHCH4bBUdsFnrTcpvxdU9lz7NbEGCzYHNYH0zWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HsUaJVaOSrEw86nWtGR_e04xy8tY0lJjUOM5YiPh8xA&oe=69D8E509"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lQFLngj8y8Q7kNvwFUOEWR&_nc_oc=AdrJ3d_xwnSJC-bpOm8p0mj2M8zOlQyoc7WE_hqu3UQBbnBULmzciDSmUHSbOnx88iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m0-IoNMda78RQIY4lrOXDur2VuI06swkNraF2WPpPSA&oe=69D90EFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSXJfiH4ZhYQ7kNvwHoFfph&_nc_oc=AdoE_CAukIvgRKjZ-9yhz1Nk5UrBBbM0hTCWKsKWfz6N4qA8UxP5DVwBXrdeUdpiYpk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pfqwfyF_wDR_C9ABFibdpGdhcQ5RodHr3CmTR_QGCsw&oe=69D8D873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dhJceGCmL4Q7kNvwF4jl6Q&_nc_oc=AdrLwn7Ss1ypS_mq7CWaHXebMO_dLcumeB9KA88ezEJJ7MAhzdx6NGbhCCC8sFhB7Mc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ewiCsaiNVaGGSZZLrmPUNGQqMAa7pWlRJA_KWCjcWhA&oe=69D8E9A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
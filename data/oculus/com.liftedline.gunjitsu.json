AE54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23ilPUGlrF0Q7kNvwEJB_Jz&_nc_oc=Adr9ohouWcu5pUiQNSxEWHusdq5vN268KR5lbc2Ql8ab7Mrh-bABiDmE3cTnlmiI0SE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wmAKFZnDpZ7_uiuyfIMjme3FP4kXrx2_eUwyNGWrp5g&oe=6A32A253"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7x7H4P2JggQ7kNvwHUIJ4Q&_nc_oc=Adr5Olv86PITOPGWxdE9mMic9o11X7DVMpu816IX9EzT61auVy_8UbH6z3Ls5HoXAfQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_heRG55KIc6lF7GD-Z_6YURMCokG_JQdfEwSCp0MerA&oe=6A32C349"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMdPXlBliIYQ7kNvwHvbbJy&_nc_oc=AdoQFmI6vaLgAP6I-dYq82c-5sEayl9Ua-6nQvwK7Bprg8ieQH-lFWVJ_8RbVDqnMGM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mTysHGBovtB54Ht9iIWtxVcY7rnag4zLU9VcwDTNdCA&oe=6A32B4FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAJjgOD_JBUQ7kNvwHmm5mg&_nc_oc=AdrH_mcJ7Uox7J5G_cb5pkOF811YZ_mZF-gWRanClSacA4uURACDtisGZ9c-ZD57L7s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_uEfPwJJ1uA5ieBeJCdnYNeIU-aZS-WUpfGGfrc0zsA&oe=6A32B6B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEE9L988V38Q7kNvwGilxZd&_nc_oc=AdoCBDU40v6OshD9M2rObos8mjhe7InsZP7BgyDn3gV2J3JGS-SSo8-ECpRklqKkfRU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SkagpnBWykiS85MtvzmtmMpPzAsqoZ4o9F7w7JaAbxA&oe=6A32C7E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
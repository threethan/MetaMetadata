F554"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPnIl_8423sQ7kNvwGn_k9x&_nc_oc=AdrNgp5VhKuQ6gFEwQ7MIV-r7BQ9bh2DZZFNEK7NYYM74S2vHGYyJmnsmp2sIKU4qoY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8yXHKfeNXA4NsKR-xSMPADRYDYoBh2ZDT-gZibJcNkQ&oe=6A54E953"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99y4HCINQxkQ7kNvwHp9WC8&_nc_oc=AdrFScmHzFVGJT3oW21DYmnXM6RW9xLnJbZzRYk6hvUkA9auP0ZTgFrbxYL_7xGO8L4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIJGkfzlp81zVSBfiakaNAGBW1l_LdbqX_y2f3L3DCWw&oe=6A54D209"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIafv1tlNbMQ7kNvwHClySp&_nc_oc=AdrIheJ-iujTw2XPJ6H3vOXapy-VzNT0dTRZAisQl6H9xU_37QF7biK5iesU5ff2FIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb6noZY39GVBpIV7oDTLgmcJtf2z_DzbPyOUzYX9Ni8w&oe=6A54FBFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqxOMp0wfxIQ7kNvwH9Y49h&_nc_oc=AdqAlWPy0khAIouHsXmn3N2nJ2w-_VXfGpBbEa5DcaAdgCzvgsisMZyoFjx08i4E5zw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxikqLYU6chOo4gW6fsj23nhfGCDUTVAf7x87NiI37bA&oe=6A54FDB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvDCb-lmMgoQ7kNvwHNiBJN&_nc_oc=Adp4Apx6CtHEWeo4wP02AFyURw2PJzuMTHU3a8ruH9mNkcpqJnoperwALsHVeSy0fJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1GVwveQnZXHWHkomd6IlnbuQgUUR2WIMXB_FpWFj_Bw&oe=6A54D6A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
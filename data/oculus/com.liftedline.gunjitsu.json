8454"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciKoPEMeuY0Q7kNvwFZZpUo&_nc_oc=AdqsZIh1ogy-2BDtJ9Aus1fQoXtpjSbJ-HysxOoq9rJyVlokKrvyZC-lHKQmGp-2V2Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQuTdmFKdVTdAV4Y0iygwld9VsxSNVBtyBQVU66x1NaA&oe=6AB67853"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQic3lTMxDEQ7kNvwFY5r-B&_nc_oc=AdrKwpAgKC5BPJSIDFwo4wLBFO6T4fR1EnvkjCwRUXYm5beY4ExN78N-K6XN4k3B5Ko&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfkBJC3xEsGyXMuVF5tH18cpypGtmyXU10XN80rB9m2Q&oe=6AB69949"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-WQxp3uDncQ7kNvwG85HHJ&_nc_oc=Adq7DB5-jdoZ4xT0UP_C3-g9s5l0Ev-i1_toI4OoAvEMnLy5Np2IhcZ8jy1sJ65QDrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKyyYlnI8mfrlR8YgldjIj7f3_I2auEeoG_qOtsepsiw&oe=6AB68AFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROe7o2VN2RYQ7kNvwHoyDIi&_nc_oc=AdoDniPSwmHngbW2DYMr3c3kkEGPN8CNGaREPbkmme1qXu2_tNC49jZnQgImQUouorQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2dqSTr1kwIIHByZvEtdtVjeoUGtyGWQPiVNtzIdcx7w&oe=6AB68CB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHuE0EpE_AcQ7kNvwF4mp3Y&_nc_oc=AdqvnZ5bHvIzglQtfCWUD2A6GYkZBs8syNqUMcR-mRUPTFRfy5e6FFZBvbQ1RbuDOW8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzyITiLTONjI54E0LcFXDfGoT4PDSuq2WxFSmxzykZwg&oe=6AB69DE9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
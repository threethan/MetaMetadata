BFD4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrMoOw5eewAQ7kNvwFdg63t&_nc_oc=AdqzE8reWKeTCfPwD85zAwZlGmfBLueRctOttDJHlC3m7xMSb2I0SJ-rueW2tJWPifg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKCygVNah1YOqUhcJ2gqnIqp0et35YwWgITyESRHjY8w&oe=6ADCB3D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q6OkPeY4T4Q7kNvwG6IBGf&_nc_oc=AdqljGb4_rRcYQmQnLx_WsdsMOWq2KptMaEBIYpRFQ83k2Mqj0dc8ypvVKtLblufAYw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuqO11z2MIxzcIpWrtRqQAgf5zgFzWRkkOxemalB_rcg&oe=6ADCD4C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4o486uBpv4Q7kNvwFHmD0C&_nc_oc=Adr5gM23VtCRi091aHh2zAZ3X5bzKcHPmKNDezmVocNTLA12ENLndHtU2p7NWExyTkw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuBM33MIBdGu2NZQ5p82Uf3s6XjSyT6To0_nXtQCFUSg&oe=6ADCC67A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE7Gs2Ac9-EQ7kNvwGLF3jj&_nc_oc=AdpsfeAlFbzr4C5ErhXjL2aKSU4RgqLr5q5wI65P3k44Rhm6mPNoiDkCLaCNTy4sZN8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO52cp3dYcVPf2Gbydxm5AvkYsANnKMUCAVzeh41X6RgA&oe=6ADCC833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6BCZQMspN4Q7kNvwEt1fPZ&_nc_oc=AdpD7CMjHhZKM8HLaGdfR0BdN1hE54TZRwh7mYGQdIfhCjuwHZoQCbJfHGwc1kKABuw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP--ciTc3C3F1AqgdFYXZ0z--r_mh1W8cvFaY8sXNYJmA&oe=6ADCD969"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
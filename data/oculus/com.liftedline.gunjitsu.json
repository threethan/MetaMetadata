EAD4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGIVEE0jwhYQ7kNvwHVQmjI&_nc_oc=Adr2KonATE1CeaZsfLQyl58iAiwcIERDjHVM7liCGp1Uot8M3Dt3A_KGLUxEnkhnpWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeQfR6l05noNTFnL6Jy0oQ2jTZSg2ZOaoIJXo__91C3A&oe=6A75DED3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwzZAL-ZbP0Q7kNvwFNgBS6&_nc_oc=AdooIeiwvO-nqjQUqo4i3XtMAYAp28Tlv3eTpLiM8ntbrnSsHvCFvI7Hkt43B1F2lFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-WCVUfkSWXwxkIeF3p6qCurJKYi0FjNtsWMS7LLrp2w&oe=6A75C789"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDaMBOdNzOUQ7kNvwGLpmqk&_nc_oc=AdqUyTZG1m_W3SSDDAyYsXnd6BZOvCpbV246cLX6H10ZfBpGEvygO09t13Ef8M4gPsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjTGdQbR0-NeVwylgDb7-fNUAHjOalYBuThTI9nRhe4A&oe=6A75F17A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzh2q-zvUuYQ7kNvwHYy3K_&_nc_oc=AdrUNjrJ5KLZryLQ_tOhuof-VX_ENOJhVRzEhAfxzUx9SuKlzBO5cnkwoe0G-ut6lCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfQS5oS5Vkx0gz1Vc46nMa9utYSz57L0fPAlepw94DUA&oe=6A75F333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2y0JafaAuAQ7kNvwFpat2r&_nc_oc=Adr1fmAfxAxm_3eBpxJbkkrSFV3MInRSfgkHZPrCCIju1ud_JVVXFBWpEOfY9jNWfEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2y0CCX0JsKDGojYNd9ASmqFoXl2O_9vNZlsQWm-ojhA&oe=6A75CC29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
E8D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiMoGwJAz4cQ7kNvwFE2sgw&_nc_oc=AdpHoWhX3XdbUIrIs7-fTKePCzv-xs_4KheYtImvRcRK7vq-MLTybj-Tfv60sIBYGr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B4MUCm_WicLWmNN1Kq7ZD_NlOY9D3mJxNjtj1IZ7QIw&oe=6A3BDCD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrXD2BhbmgsQ7kNvwFVj0zq&_nc_oc=Adohipay4cxCP6goT0SNVjYG9_DXrXDxVV585CPOup3EysmvMi5-gLLi0kJGB-lDGxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cj98-Rhwf8fURqr-FG3nSUj4t5vbZutfIV-Oxo9pG1w&oe=6A3BFDC9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okQ-vzjCPKUQ7kNvwH5wqC4&_nc_oc=AdrxBA9M7RSEla6u7eozPdq6A3Q_5taqk2TupkaZY5dZEpNsLIf4A44fzk226FOBElE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1_THs8_MtZ4OIKv85sQSkOuX49UdqluKTnuPWyyKnIQ&oe=6A3BEF7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v56GC6L5n54Q7kNvwEeSE4l&_nc_oc=Ado8GMVmLtw3Gx_QoQ7W3_pYK-zhWuXBkhgb_yFysmfKZzEd5jbOgfpUn0i8A_9x_QM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a-FLcJEEoQdNWE8-nbQoFag6zWLIIdqcxvgy9Vv94Qg&oe=6A3BF133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7z0Fs3V2tYQ7kNvwGd2tYV&_nc_oc=AdorA_DlKr00saTgXhV8TPMr3pczICqV5wVqX7d0g8L9ww4AbP-I7mZWGw0yYVe3AeI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2qvzewOYRYioHdP8jNaBudEH_vnLeOJbci7UtbpqgZA&oe=6A3BCA29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
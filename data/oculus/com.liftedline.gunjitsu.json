2ED4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NMNtzQAjDYQ7kNvwFVfgDB&_nc_oc=Adr_wE_2Jqd-zodG_QjEIGmHlnoUEp42Zelqlwyu6-kNZWHlRfS0431UYmSljJCubLo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dUom_KJw6oyu57kEfMMqZgk0aN9emo-t8A2ONjXGSAQ&oe=6A4122D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itagd512vMMQ7kNvwH8DYJO&_nc_oc=Adpasbd3xL6rFoK2Y4j6SNlZurnLQmFS7vnVz4o2inqH-Cilwnrg5e2pPc5wPLkd92s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lZWjHjwuu89rICjPsmMcfFGMp4YTfekIDh_qYEU-Xpg&oe=6A4143C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puiq8RBeIHoQ7kNvwE23OM_&_nc_oc=Adph_LwzkdPTajG11w1KMhpKqMn_fzaZRBGJxG3LcSRmcmXBi1riXS73kmGt8S5gg20&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s0w_ss8hjUgrsgPoua3jbtRPi8WmY31v1FSyUKplG5g&oe=6A41357A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ_Y6V_4AeEQ7kNvwENvoK7&_nc_oc=AdqL1brfVwDMVtwQ60CQ1SVzQlirN0Ic6G9_IBmVdhEoC5Fgbxe7mPTzCra1qLU9x_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dqheGrz_yx6zndiqJa_1r7fuQ1uUl2x3nqbGHhR_OZw&oe=6A413733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELfXG61_ovgQ7kNvwGZ3ZoF&_nc_oc=Adom15sDGV2L56n-0euwpNRNZ_sBSC_y0C744c1nd9VdE7xrOvdqF-CUmyEkIk_i7bs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BCx2brDPWE-yQOdOA9cfHBdiMxdqsRcf4k88ZtRWHlg&oe=6A411029"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
CFD4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BupxYSA-Pj0Q7kNvwFMdpvv&_nc_oc=AdpfCn1dhYmneELj__m_rjLFCzIfDegb_hQmf_3rYUjIUT1qWxlsWpMeeaZXp-w6lS8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D_ec8wnfM6WuNebZ6ZIbH430doefBA3G4aGP8TtO7iQ&oe=6A09C3D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phF3EvYq7Y4Q7kNvwHs0ufg&_nc_oc=AdosjmtAtGnIbvLzl0hI5TDnK9pG4sAcwNsSK5SiBdPFdxbegYEGA7-VDtc7ajBsVis&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eSEkrp3McPhBQ0IP-wTjrzjoa50VqXTp52icPNKm9ZA&oe=6A09E4C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9OWRbBkpeYQ7kNvwH9h_77&_nc_oc=AdqkiIKmcCQwD-SM0eOha5S3CTs8BbiyVionwBr5G1V4nncSM9IXaTQUkU3eO2vYUr8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GloStpOWM6Egl3TJ3NS6yHRZOx27FaZ-uiW_5VkV-Ig&oe=6A09D67A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko4GnP4ljNUQ7kNvwESWDJc&_nc_oc=AdoTNC54R9xDAga4PiIchipwN7aeJvM6AjCHfcuGzaW8vlft6X_-ulgeGFyQAcE3Gug&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47dzEMfQKyclpBIqDBigBXzUsTHobFqV9vCBNvMukllQ&oe=6A09D833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miWTjH5iZIsQ7kNvwFZ2xl1&_nc_oc=AdrfCVp0a-o7CZSAU0DIf_O0ebIBpGvW5YxWDz35WF5IzITE3EFVVMLki_SckCEfxeY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tZ3Ye7doke_oaU_jqdvgakhmjIY_IWQliE0PoqgCD8A&oe=6A09B129"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
D1D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbh141hUDLkQ7kNvwEcxHy_&_nc_oc=AdqnxvwQ7QRbs_fQX2MCfZjoc_ynxJOd-h_5t4jEWwEnEvWYi-9bLmBsTd59GO66c4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KGQAiZee0JGBKo5v8RA32PM3gPvhqsWVf9jZvXhb5PA&oe=6A43C5D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itagd512vMMQ7kNvwGP5x_g&_nc_oc=AdrXfjc3PzgBxpQx-dyKxNJ43BrDTQv1k08ewKs9wKpvO2JUPaYxnFD66G5z9_P3lCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cZe81Xx7NRKk0coXdE64fiioLGPaofQPV9N7FwUBdBw&oe=6A43E6C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60W2GFuDWvkQ7kNvwGPgwBv&_nc_oc=AdrVSSF40hfg0b7rQ_hbuwE0UsDSDANu-ODjXM_bY8IOP7XjoZ-20Xt572SkYDXv37U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f3p69l3YjCn31-r2j-ve_VpF7Bd8v-3xQJbkl6kashw&oe=6A43D87A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZfoCRH1s6sQ7kNvwF86Mu2&_nc_oc=AdphrkmpF5Rg_tzAg3sYG9ykkEPFLND7VXQhRowChiL9lQi8XM6XKe9oSkbJTSLbYlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ujRACNMl76vbciXFfuwuxWN28QHreLOupBXsgHfdY_Q&oe=6A43DA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAk6WdFQpFYQ7kNvwHNmb1n&_nc_oc=Adraw2vot_aA482bR8qEmdawIN9VxHr28516kjWm9rIDfyHOrWpb8fqiW0EV50EEC94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UW0WHUhKICeM-xUN-2ljl-aZyj0YnJZLj2hPEilqmdw&oe=6A43EB69"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
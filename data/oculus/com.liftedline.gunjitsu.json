U6ghn41vnYQ7kNvwFiE5U2&_nc_oc=AdlM5kKTYHhKW8rGVXvhkauxkFtFaCYvRb_yPIxm6E33T_4VufAQgX6eZYR1tleqtLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftpzi0Fb-zAZ70unprY-h_Q05H7T5t56s9z-YwL2_S1Gw&oe=69A6E353"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiVm31vmws8Q7kNvwFAP-Mc&_nc_oc=AdklrIOIq-8i9SsefnqaYJZcQWX7Pwu1jrNlBNls-a1_9Uo9fW6bRH9tuy5Cab1mb9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRZfvNakGL_nxnLSBhj9x32xCVaLPPMIviru4SZHxL3g&oe=69A6CC09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UiDifj9RxYQ7kNvwFOC2G8&_nc_oc=AdmYaIbFEFmD4d90YFXTENdkL95Et3j6etnQg_ZNXTQGzmxDLldEKC28syPwFqxP0Gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvo0FH0_bicGr_oXL70-ex45YAzrQqYAphRhEvNalycBg&oe=69A6BDBA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btxlzvB0WxQQ7kNvwHVfQil&_nc_oc=AdmCAUwxeBU_dIJPxFHnd9iyvsIyxXy9JnUso4tyvJV7TsicTXb2h7EZ1C2HetUF4Wc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9ogm55OV7Yfv3LF7G9Y59GVo8CwLyFl3We4hNiTSrSA&oe=69A6BF73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFFDdH9SGjMQ7kNvwFGUrbA&_nc_oc=Adk56CDB9LbXQESh5lRgJYroDE2ZoB28qk9NumKhC6z_b5FKL3TXfKIfHFhQKf0d3gI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsgH8N47ndMjo45B7r3gotpjCR5M0L28H8YRUon0yPZ3A&oe=69A6D0A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7652038824880496"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com
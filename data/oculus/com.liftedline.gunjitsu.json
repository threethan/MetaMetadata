FFD4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23ilPUGlrF0Q7kNvwEbBSTH&_nc_oc=Adpr6dFgwRgKbWbGeirJ-3ELiWV4MjhMOBB_T9xDj09YHwTJW_VZoAoW4dqkjzjPYFI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R8xoNVTbEHxMVBER6eQo1agPq8GsyT9o4HreTTyet4w&oe=6A33F3D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7x7H4P2JggQ7kNvwHkMT7x&_nc_oc=AdqEfBvyGp3O_ZXzXKUJaHCEHkb7T6gD9nf98m5rjTIzQJ_qpRPetGfWi4oTqN4C-lE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af850PoUiPP4yQoiLG-6ugj5FAbl4uRLUHDDZHSunL39Ng&oe=6A3414C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi-YAGpKK40Q7kNvwEIcwXL&_nc_oc=AdpnFbO13_llj7i9OxX7dFijyVNby3ifOx7kWGGcfkmST89el4Kvq-Dvx1oienI9tIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DsWbZNw4ND4UnEUFFCNq8cgdv38m3ew1bQjPMiVKMHA&oe=6A34067A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAJjgOD_JBUQ7kNvwHb8Wmt&_nc_oc=Adr4apLVqfCNkJhom1ka_IalD4rWvZ78FLDlB5nFIDsipwIkwvoVwxvBTV6kfmcFXWc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D6vaLEAJLLqWuRMr9bjFY7hJO3cqgisDKedJ3xpE2BQ&oe=6A340833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu8MU2UvPQ8Q7kNvwEhBpKI&_nc_oc=AdpF1BGwzwRv_FArlPYpslbsdV8v8JTwip_rV0Dc6DHYLqPBCIYpWPaOZC4RgPXfYWM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c0Ci0d0YOId2H8VUxn4-0YK3J7lEhZgnoPnOvZcV76w&oe=6A341969"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
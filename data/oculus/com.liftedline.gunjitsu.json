C714"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkzIBsEg05IQ7kNvwHxzJRr&_nc_oc=AdpW0n5lLGT5KvbW18AfOxzjEQQMIPM_ihw6Vrq8R5egZgS5mfE2TqtO3b_26DBGPUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqHvSUwr7FV983R1lQzLOvb-Hf5Kld0oPq6QqiRCzcaA&oe=6A95BB13"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xjy2bdx634Q7kNvwEEWdgK&_nc_oc=AdobQhAr_a43hX-LNmSlR8HPgdJVND3h6JiTFxXUXzYpab8taO1Dgylc99dPaKt-szE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYo9NJkwrr19ZJ01b0AwUpwsjBtQvQMUKU7Tcy1saKrQ&oe=6A95DC09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwYOliVNrcwQ7kNvwG6xQb8&_nc_oc=AdqjjS66GlFDQ808CEVUGW9cwnJnLf_zUY98gJneeQ4yiB_fLCkwWzgs4wgi51n6QSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpSPgSvjajX5TtaZw-2kZr4s11uQKE0LQPILAwcdOLlg&oe=6A95CDBA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4huD90I_z4Q7kNvwH4Y-BW&_nc_oc=AdoApaWzMXYdM2Mv_2JFq1R_sdkQsc-HCayEjqHPuURDZUW5YfedI5LO5M2jDMpOxuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrBQ6Lho35idBh4rcmObr2Acom2oMFzeB0ijzGBkE6yg&oe=6A95CF73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-Luofk9x_8Q7kNvwHVt1xw&_nc_oc=AdpYaLOexMopnZKlN_bI2qCbThvJoN3fCpylp0-0IImbQb0uckwHQGbbgZfUo4EI6Rc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo-Mcce-HgCPUI1yRQmXRRQh0NSW0kKqAvQsiZsc0m7Q&oe=6A95E0A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
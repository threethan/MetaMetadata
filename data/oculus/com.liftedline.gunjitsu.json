4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhf_zBFMmaEQ7kNvwEUFF3n&_nc_oc=AdqoY29vEdkSS9NqdBInD_hvzChC8rlK6RRPFL8WKAO1RKPrgw9beSdgW7OCWwNV0kU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YB-Poj5vj55dniZLCgdxhlIgoFr_-NRp9wTc4ythwOA&oe=69EA1FD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ_JerNJRrwQ7kNvwGSNGvp&_nc_oc=AdpTtRnEfnqASd6g1826P338wwKZXnTHqw2pySwM1vxaGXDBUh3fZoPLH2SLc5MnUz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cKkFXU4hfSHtNLJZ8qDdk-CHM4ZGk_FU7LQuhAKGzfw&oe=69EA0889"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7k7DcqBtnUQ7kNvwH_GQYX&_nc_oc=AdpH9DVKXIimi4c48YfmmiWwUaOWnhRSLSP6Nog0Gyf2xUugIpFwW0PZdXbvUk8YCSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DcUl117l9dZKydBc8WahBwpNPcrUVS39Ob0eHsPSsTQ&oe=69EA327A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBaAXOJKALIQ7kNvwGkwTbL&_nc_oc=AdrZXhGO7G-mYrur9o1F10HAi7dBe-ZT9fsf34PjOdmzyMbup7J_LzastLM-UfO0JBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nGJAmeHMmtn7TasN28gvSDaxCm2Qsa0tAU5K_T_PfbA&oe=69EA3433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUtgtJ3-YHQQ7kNvwH6qCWa&_nc_oc=Adr14zzs1sewdowrodpDRQz4H6fuhfSvP8v00Dyn3xo-veentMz2IOvtyye8kT-ztnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mN-x6Qt8yYch3NWJnDWdkEQGNbpozWDiSjJhUNMeekQ&oe=69EA0D29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
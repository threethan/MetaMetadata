82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vkyc3L9H0YQ7kNvwEGmRe7&_nc_oc=AdlBQb8jV0eq6iRveYkZ-xruDr5QYzHAxtJK6MNaMwMPPtar9cV1PeE50VpBtmkhiXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-tw4XqgZfBOQa7QjJcvJ65si8G_hHdKDFhK-wHW7-_w&oe=69BFEFD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ypiaPsN4LIQ7kNvwEK5kYz&_nc_oc=AdnLRnR5nOqKUcIdL_MhSN-GeKEYtIiPB8CCv8neL_OROBCrdcOJS2q_cv65mMAtDqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzl-e8JqWDerz1NaCVirXszyXYGgr_SpezhKVmFvw57FA&oe=69BFD889"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iynDUJuMDcQ7kNvwEFd5qH&_nc_oc=AdmL5ftf0MX39yNGRG2E3_J-iBr3ytWzIlaEb2lsqB399aHNo4qkWbVj8VDIl9KYw_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxltGZfStKl_HVnfXHqy4bvCWILYD7YIQimKuiEKH0xYw&oe=69C0027A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jr4zg9a5w8Q7kNvwHW4CUH&_nc_oc=AdnR1PXsE4ZruQVmH4wRwiMlQEYVOCL2hVQ6nLkQjlKD7L34XhFuoMl9YaSjNVkQiMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjVaZOvs3OTlKRcGj1oLHNYKQ415IN4v3UNOo2xLMlZQ&oe=69C00433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dESzIm2w1d4Q7kNvwG7S4Sv&_nc_oc=Adl-ZD3yu9d2nGnS8NZUn8_R9XJJKwXiMGd5uhZv9Noooxy-Y6Pf_MSsfNCakdsqIhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx5wLkk0-HJLDDxUH55EdGIn5Svm1s0e6OPv9ubW4KYpA&oe=69BFDD29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
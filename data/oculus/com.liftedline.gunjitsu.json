82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsRqZYmXVDcQ7kNvwEUIRDb&_nc_oc=Adk0YwQXL14iU3uAmqze8er-CFMVv7_bU4vJ1GyNm5CMNCfOA9pPHA-ncMSWqzB--tE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuQ8RKtnPdMFgLlA0Lt1zjy6G5RG5SXUaoABhG7su5KCw&oe=69A834D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiVm31vmws8Q7kNvwF20asY&_nc_oc=Adm-lyy2EYf6gKN3btliAgVaRWjqEuxqqbcCa7D_uOh7_wWkGIm0x0xQvUnWHgUQm_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv1vZmf9sOFuRERlRmYVj36yPUX_eLqfS92Vu23kyZtHA&oe=69A81D89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UiDifj9RxYQ7kNvwEL5znx&_nc_oc=Adk0VQ7uiz1Uom6LCq3VsZcX4XWDzjCHvx7G2uDJH6S0E9OWyDNoiAi_LwqcQLSxby8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuAqkHra7jB6BspvJ0Poe4a0DFOvy54yGQbSOkmjZKWIQ&oe=69A80F3A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btxlzvB0WxQQ7kNvwEluT0-&_nc_oc=AdkDAY3L-YGhhb_BJuxNQqfwew8c2yDciT_89QTLgyXvRRcLm8kftHQXwMiaMOyZq0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuPykJbtbS5CAJAgllBhvY4Lx3_7e1_kmgzqTRnsoWZoA&oe=69A810F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFFDdH9SGjMQ7kNvwEYBZ_9&_nc_oc=AdmoIHYPBHmK5ewmZqikdXLjb5Cr9j_f4dn3lAcuoyqaAOGQOEERlgbn8LckHTctR8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuGhg4BigVvSEgn1E-rmE5jMHOix4MJKQ4XsiOPVxthOg&oe=69A82229"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
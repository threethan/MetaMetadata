D0D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lea6W7WnAMMQ7kNvwGYYiRf&_nc_oc=Adq4un5Wyq8pJ143Erx1Jvrbkoq5yBYwfI1M6YzUIT0Knu69kVUi_uAlV8NgLEQGYCk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lzkhG6BjcNZ_dfcCxwcXhiuZZLbmYmQJdgj1G6uIm2w&oe=6A26C4D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R91Ac_svjq4Q7kNvwE9pXc8&_nc_oc=Adp7sS5gyD_kd283ro17sde3e2BQKY9aO0AbFI5mvyiEfjvdjanfg5taESfqArV47Q0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gEHelHdaATgKSzIe9MdDAeioekgcaUz71voWUHq_5TQ&oe=6A26E5C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXxqCwg9-10Q7kNvwFs7rHa&_nc_oc=Adq5l5V2C57Wqr8oZ1qAVxBBCrPDWlN-mMm7kuq5Wvl11woCmMVHz7TjW_P1GZczmB8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FzR5MIoaumaxppRiSscoDiJtw4Y7ZG1QIEIp8Hx8c1g&oe=6A26D77A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIiG2GqLuBkQ7kNvwGB3QMi&_nc_oc=AdoMvFHkwhCU8Lh6c36bVzK6oSv9ygoVP5BCzYPfbIz-DpBvQN_OQHyw4672J4S0Bpk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EiSHiD-cjFHx_0rc2_tEgrtdQ_H56b4_BtU8uuN1jng&oe=6A26D933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLCy00T5WhMQ7kNvwFyEG9n&_nc_oc=Adqf6dXXxUo7GcNopKatwfNXuVtYYygAh963h8HHccH3JGN5DwOsSvlJvtk9FdCXFE8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2sUvX7ja73My7tTz1700Fx1uAN2vBQDzWtdpo7z6ykQ&oe=6A26EA69"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
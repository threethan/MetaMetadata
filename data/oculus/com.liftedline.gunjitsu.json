3A54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiMoGwJAz4cQ7kNvwHP4YYw&_nc_oc=AdqVJpHhLVgApLOhjx02Nq2ZGvKbZK8lvcMldCwG2AG5UEn-KkozTLpytpkgbcPNxoo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q7HuGB4ArRuAyjReJUml5AYkOGl_3CLhBxjNEecG7Fw&oe=6A3D2E53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMNHe4I2XqcQ7kNvwHUitPg&_nc_oc=Adqx4-ogrOIBJ9cOtKQLXw8V2vkuxHQnpEXHp2ARM-1CvwUS3gr3NOs3EkBGgHiDgYc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4rEYOjbHiQV54tA6sXiW6mQyv_LfiVmHTVNGTkACQng&oe=6A3D4F49"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okQ-vzjCPKUQ7kNvwGJK8MN&_nc_oc=Adqzt0a5ldstl3Z-_iHGGmC_lqfrV6KEtZ4Hxzdz7bjsVGuZPlT5__FeA8usNki8ZdE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b87kRGJX4PzLYfCQvFPqhK_-Qfipu201YvzChKpFTWw&oe=6A3D40FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v56GC6L5n54Q7kNvwHwhioM&_nc_oc=AdrgZseZaKFIBbJTc4JIviGwCWCSiypTnf0b5XtkS8A4HyUoqvw4i4d-QieM30oUyqo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9so-_BR1yRzon6BuXaDLBvo5JpToCn7dg5HLullibFig&oe=6A3D42B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7z0Fs3V2tYQ7kNvwFDUXB1&_nc_oc=Adp1c_QESWtKTLRtOoJWhB8Qu5CZqMLtHJgngabBXDk5d7kfRTwbYc2ML3WGtRFu4qk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97UwfyTIPOOwuhSCnOr6NnT7B0z0oKXzYpjGXZzgmEAg&oe=6A3D53E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
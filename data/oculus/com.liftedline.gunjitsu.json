4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhf_zBFMmaEQ7kNvwEG_1Dt&_nc_oc=AdqFlAPz9hnKJQyBnjHSqxaOOnHQTwMkSvoYwxeDPk2Bekd3Ii1XszCErakQBRhQxs0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-Wbb8O3MuCwU6kGLgQKSXr2XcPACsaFZIm1RdjGzp6g&oe=69E77CD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBrAf3XreOsQ7kNvwHcAzEd&_nc_oc=Ado_2tK3vOCW6nzTuVPtSo9aaxYA10LhGt4_2ZLWv_eNTMJRNHW7SyT1Q-FViHG9QM4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xZzTDiWRp07fhFLefiZzxLHT24BjqnGZagaPI4o5RKQ&oe=69E76589"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNkKQyVppkQQ7kNvwH0FtpR&_nc_oc=Ado7hIQ2RuDeAucEoAgnwdjHmeVChpbzosZQUN_1o_j4rIKMrD3BgBn4cQittwTjX6c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JU1WPn-efNgwOg-ZWH3sNXmssSl6AYCeKt-5R9D-Rpw&oe=69E78F7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4otCepVYioMQ7kNvwH0Xu2f&_nc_oc=AdqNc-66k3pWL5iy8KFzN46uwgLMTdJ7thAUfzGToINFvV6BaNihTeEb928a-JOjEr8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bIoen64h4fFuBdYPNjKQ0HcTP7RhS5Ke0hVLXkRF1Hg&oe=69E79133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48ZOZ4FQNsEQ7kNvwE1eB_U&_nc_oc=AdoPAAnRxDmql6vltbU4BE55jZTMaSMFnfhfE7wrUdWhgIBl_RD3AERqfht3cJ5d8M4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TKDq49I23nJYvvI2qtnmFUB_yh56Xd3gOKorCDNl4Cw&oe=69E76A29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puj0kL0Ll5QQ7kNvwFhsZ3g&_nc_oc=AdpvF5XJ6FVGsfUeLpcC5dqmCE2u7O8mNIPQdVupCW9T1x6q_mMqlpBzng4xEy50u7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CSKdiOzxgOx5SsMGoFH-QrBToh4Q7xy2iHT0-bxXG4A&oe=69DE4253"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0TYLACR9M4Q7kNvwEZSqvX&_nc_oc=AdrGP7NXx_5dH2z_7ZXeJWPGmn9_MxtMldYlYWq6jnvcA7hJ9mjOZ7TmEkUt0KpQeQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10WiXXCKiXp3d6DFWPygGnA-Ak17inwewcxtSGdfITPQ&oe=69DE2B09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO3vvjrcj9UQ7kNvwHdwNLY&_nc_oc=AdqJO3Dm6nypVrhlKt31bMCgwVp7F0dwpzEsMj3Y58nFDqOQ00Auomweiu-GXcE4clQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MGEPY70VQmuTDxN2x7kVrsvLCH6Vm310-sdQ27uF5Yg&oe=69DE54FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_q3rsYJWBdgQ7kNvwFTDEuu&_nc_oc=AdrUGKz_x2fROxzwNYoJF8q9-yWvere-gv0ikok_UypS0Nyz0WlcqxFBFp8NXa-jIXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GmpwzNjJUDamMD-v5FyG5USIeiMJEuT_rEev5KL3ObA&oe=69DE1E73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlG1zMTqm2IQ7kNvwFtk1MN&_nc_oc=AdrRs6jrsnBU_vfZClEnZ0OEgquSO9F4ZHQI1udDlJe9Nptw49AtK61Nh7xOTk9-xQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MQdMz864kNSPWUEZhJ85PG1nE715V-jQOxz86PjfMPQ&oe=69DE2FA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
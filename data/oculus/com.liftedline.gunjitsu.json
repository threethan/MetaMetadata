2354"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbh141hUDLkQ7kNvwHeFsY_&_nc_oc=AdqY_WgYeA3v8dKCJsiiciwxHBf-yrKZ7P65tlkf7uVIzORXtTbnZoi6UL6m-FJGLIw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qvAxdU6ctOfSjXpwxIUKHybYfSuOHh2K3cLZQBRF4JA&oe=6A451753"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTdjxFjzWRMQ7kNvwEX8KuT&_nc_oc=Adr3KzlOgDxyw1u6HSUSjb8_KahgWnrx_YMN6nh1b6WHcahLlV1-RYl1p2ty2IKxW8c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v9-UR0XY8Y0A9v8oCOLzu8EIvjUxgLoBppGeScbZ7-A&oe=6A453849"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60W2GFuDWvkQ7kNvwGPa_Nf&_nc_oc=AdoS52CSlDhfD2ckfZuZGTs33oCb86AhQPjm6yhw2_XDgEOI3k3TdCsfRcihaXvGScE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_srqWNieybsVWNAZ4R6XZfEqoivwB4he-1371j5Yv7zw&oe=6A4529FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZfoCRH1s6sQ7kNvwG0HXRS&_nc_oc=AdrvcAaqiLYua2HNq4dJOWfdAtjeBZWWekb1P6ZzdLm6x0OiCfgDTLuO5eiEX5LBXJE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YkyrlsCqwTnbksxBo6IkArzC5sH4RWCDVm-lR2ADUkA&oe=6A452BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAk6WdFQpFYQ7kNvwFgl4P5&_nc_oc=AdqqWgKLddD7Rxs5OBbJ5IRszc_rx5GzO2kINgW2-OfYQV9FSgIOKSMUqeMr1dJfAlU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X9-bSF_zMaSMjjuqyrr620hsS3qiN6XdRIDBDFWLGzQ&oe=6A4504A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
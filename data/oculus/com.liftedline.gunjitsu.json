01D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR5P65TEkUcQ7kNvwH24z6N&_nc_oc=AdqiEwgvo-0ty9evlHD2t-0lbjpnxGGhu2ESvDKCgvGjXxcxOzS3eXJv7M3lhhibhA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpCyqtAgqbFBctnrtABdZUPb0qdMo8-7a7aDM4XHPpeA&oe=6A6DF5D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_XvnaDKHLEQ7kNvwGJhBjd&_nc_oc=Adojd70K0I6BLyK5TtvdSSwEFHmudj6N9g8Y6gQ1zqOBy9x-FUUU2GgdjV_Omj-x4hU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxya16owgwIBQVPKZ0EAHcLMoH53I2iiocTINmgJR7vw&oe=6A6DDE89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuJqTBXh-V8Q7kNvwFP7D3X&_nc_oc=Ado9-WEwz_1WsvrBxBi_j7eicZSDXCZiOAKWh_eFFb2NJRhgyjuaaDMuT_Yb_HAxf7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnvGscJ7qghAalm3-9KXqBRSiyac73OmXbUAIy0D22dA&oe=6A6E087A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOrDUzvnRfEQ7kNvwGnvDdV&_nc_oc=AdrVhGN32k8ML8e3AxyiLFdN36xTkcO-mDQ33Gp1J-TaLu2WeRW0xbyV7KdaCIYRBPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1DZvJz_Klgb4j5zcMFb0Wx_bNq7I-mcvzqu4iq67pcA&oe=6A6E0A33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56-xtZBW6pUQ7kNvwGSpwho&_nc_oc=Adpt3BBsf28U3LhNgr1Evd4L8MIzWiwBuEs-iPyy5JEzH7v8LdmWd_k5ATTFVXGPOQI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnMXIsGQGo6sn0W4H2Cmeg-iDRMgkvpqNEZ9ub3UBcBg&oe=6A6DE329"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
50D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkzIBsEg05IQ7kNvwEDazXM&_nc_oc=AdrKbUeNSt-lsceeADdLLRjORvNlmOsjC6HF75i3b9tazWa4YdpKBfoXy-ETsNE9La8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW8fZH6Q0GFfIumzrvjv4ROQ-OyQ7wa_4Scd85I88NcQ&oe=6A9744D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zTCMCbEer8Q7kNvwHpaQ09&_nc_oc=AdoVyMimf9SiStiLytQc_OuzpXGhub_Ah2No4HCpRpCJYbMRjqC1ajcgJ_c5W79Q7NY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQxhu8VGbaF4f2dkrQBJ1IlToMUX9xxgukZ8-IV3q1Mg&oe=6A972D89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HBzm--GxUgQ7kNvwHtX7r_&_nc_oc=AdqFka9K6akMO5NECReJy3qAVWvBp0PPgAx_GKjTyc7FUjq_yTa_Sy2XS7atmvtQppw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkX6olvJOUYF48LNYuDjzjPCxBuZ5YVhqa8g8k3dt9fA&oe=6A971F3A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4huD90I_z4Q7kNvwFQ-3zq&_nc_oc=AdoHtwo2lhyRs7D1BWEFAQmth81ruobuGCWmypq8d4QU7Qr5IYVGXWbUXCPZuoaMyEw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU_LwMPA6oIHxdTZGD2aQJ6jo-mA_8w5tq0eRjqyrC2w&oe=6A9720F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVya_-0NqPUQ7kNvwG8YvmZ&_nc_oc=AdqgepzUQjyrwGpzzlT6Wu603hEfyDkRFVPkRhveswftwPm64ftmYD3dfGJdAKCI49A&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7tvGzkITf0qmZMzu7Aj0-A7AIBEDb6l9Ej84-K-DbHQ&oe=6A973229"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
ED14"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyF-Yqd28-sQ7kNvwH1t5se&_nc_oc=AdpVazIYry01rSh3dKDkYzbNpgSeUbNBkv18GREUMA8NKO0noGr3tsG-IIUNwgLhS78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5PLv0hv_3hFNLBrQ4Fmy0U0q-F-Ng2l9uy6XXMHS3ow&oe=6A7F1953"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfrKLOrqhu4Q7kNvwH1cGNC&_nc_oc=AdrZne-Edh5HETBceUGQvgKq9u41d_OxFs-B3X7xnOUxB05ki3_m-aGOGzU1DBp0QU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsV_ng_0P6H4NzfEouMfmhA_m7gk1CvLd-8g6cIpRHjA&oe=6A7F0209"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPHwRC-nyu0Q7kNvwGzBsf1&_nc_oc=AdrFBfoYCqqR4su3nyS9pFCRC9LTlWsELcnhmmabEp0KEnNgy3JgdOqoV_pYyEq3Pgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfPdqJSksoFz6Oww55G1sNZd0J5bjiwpqKLGyaPUiUtQ&oe=6A7EF3BA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9c69aP2iwAQ7kNvwG4XuTo&_nc_oc=AdqRmcIIR-oUrvgVfDeWGlZglmQyL5TQfj4Ej70bsqEw0Sysw-qA7txFXzcEPz27Vto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELeeAx22Ui8cAfjIdI7_02nPJZ8mxp63KLxzBhhn21iw&oe=6A7EF573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adUEveiKt48Q7kNvwHPGibL&_nc_oc=Ado-amqeLKYYsVcOhPNKRiN0s3ulPXtKH2znmfWrahXzeUeX8ysWVD7gq7tUfyvq27I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPjrRiMiFHgM6dGRHg7CG5QukEXJaDpIhDrBmhCN3tsg&oe=6A7F06A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
5354"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR5P65TEkUcQ7kNvwECaLg6&_nc_oc=AdqQOtsnKSTFLL8W1_CM8bUZRwMnCcOvtEytUi_iFtIgIHa8i-7GCmhAbJzhxkKZgog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQj3IKhHC3I5rhN5W5Yg79iI49qabFWAzIbQV_Nlup2A&oe=6A6F4753"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_XvnaDKHLEQ7kNvwES5pt2&_nc_oc=Adp_UyvKujaEwqsUQ_sEqG7urHX3mTc13NMc4xUZ6p0V4D4sLNhICkLmnhUt-8v4jAw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4jZYh_RFaCmVYWtOcBR1-xMRkQbNxg--yOuKpzSkU9Q&oe=6A6F3009"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJ63_WONeRAQ7kNvwGsWvAI&_nc_oc=AdpQ-A9RyxYH_IHwPF0P2mgO54UGJz9mIUETTe8hitvHzridlv-D1YHZGm7eMFsm7ew&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjDKajptr5afyXL-wzliIRhkhh7JG0doOzaX88vP386w&oe=6A6F59FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QFYLfBep_kQ7kNvwEh3ljx&_nc_oc=Adr7lEiUtlFTWohbrkCl1qtxaSYrA5yM9wo6qanA_gxRHEL3azzKamEhR167z7MJmo4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBGE5l_NjxnIX9UZJ6rXH4b592ZvFcnE3YfAOiEob3Mw&oe=6A6F5BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUywuHglJYgQ7kNvwFrQAOE&_nc_oc=AdqdNMjt30PNC7aY5s2AYQZ9EmLM82PgSADDP6Q35Xr9gtrx5I62HJskj7fCEUTE1SM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi1kN7zIol3sf_0CyCx_OIyzb-OjwI3TbHQuvUyclzIQ&oe=6A6F34A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
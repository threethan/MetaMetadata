11B8D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DQwUe4cXNgQ7kNvwH45UQj&_nc_oc=AdqDvjmLNBc26g-wc2SvuDKxzfuSalZHV0l4-xgM2rDgltTz7x3yy2FcKBJsyww8Lvw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZMAuYmI_M_gWMwtdluGI0rX41O4_-7mWfH8xXiK87Rw&oe=6A11ACD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJEKUV8lMi0Q7kNvwGQHb1I&_nc_oc=Adr3lOQamQZWCIzEEfKbjJik4GZbg05Z77Fp7pKGEyV24UI9LDn_UrGRueMrjAt_0oE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NrqWxyD8CaADsvwZ3kHyk2DMfL44PmpasK8PZny4Qrw&oe=6A11CDC9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpxrj7wW27kQ7kNvwFnM8Al&_nc_oc=AdqBwXVjALO67wfVWLp42PHH49dGe9SPi1yhWfYVGOwSSI8oC-lRVU3Etc9PJ1aX3Ug&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4slBCwt8txJ9VFNRvqvTXBE_8ZaCTM3v920BEhw-mKZg&oe=6A11BF7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gJkq0t-7JAQ7kNvwH6JWhv&_nc_oc=AdrW_mnq_7cvBjunLTtyXEJ98gWtY4HYDvGQbqGnbDoFRfbsnRhwBIIvzR6YaIRa0S0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vpXyPyBd6tVqqPwORxACpdHCS9Y1n6d8FJsUr5M6aig&oe=6A11C133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy78_VEW_OkQ7kNvwHcpvPy&_nc_oc=AdpZpJEd6g62QK9G0NTTUD8-cEtwAc1PcgQ5rFPkwHhHfl-KMHOuKM91DRhP9Q_Igmc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sX0ITZqUxLCXubfz7AWY3A7xag3R5Z0-uQqUQaN8ciw&oe=6A119A29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
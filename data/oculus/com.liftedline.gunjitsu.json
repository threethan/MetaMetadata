1qS8lhWSD4Q7kNvwH9HaEG&_nc_oc=Adla_rvsMiW5zl0mo8uYxdasGi-v0ZDnJaVAoaQb06rVwyXgLwtozyV5E6zOUUW57P4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvO3COOBBQbTWa8ssxbU48MT8ktUcL0YQnY0Eb9ERuEtQ&oe=699B05D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd_1RM2c8t0Q7kNvwFQemjX&_nc_oc=AdnXzl1EaCPIluUiSfqawLpd15TqqE4l54tWrCC_Bh77ZFWdp_c7LAko3go-VDIrZuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afusami6Tui5qq3I2EwGVWmDtnLR7XreN-VDdaUtZomkvg&oe=699AEE89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbGgL8UMYt4Q7kNvwFwhen4&_nc_oc=Adk-V7ucHIj5vZZ_PC9JwIZ_CRuFo207IaX7v7LPsV28Loa4qiVg2UBy2BWrFJ1PucU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsYnJ9ASiIGblriZTumfWs1Kq-RA85RZj5GpwHdZxyrAA&oe=699AE03A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIat8iYScS4Q7kNvwH1xoqs&_nc_oc=AdnDDO3A9eAY_eTr3dbrbbTHc_HBR5CPyXSmS52-BocJxuHptlJ7NIwOdzVVZj1W8JQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuTnNZASQjkUEGEQqBFoUCb1-dShB5kbsqlfpKvXFcCww&oe=699AE1F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=324RmUvtFZAQ7kNvwHhTExN&_nc_oc=Adm1seROpwTK-85DDa7Evz0lSQMJ9kHdUOuCVPljQy-pHijljublQqnSxdkxVKzONnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftizgq00_8R5lIsZXBKwpwOsFDKctNqZpVIskLfYe5oGQ&oe=699AF329"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7652038824880496"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com
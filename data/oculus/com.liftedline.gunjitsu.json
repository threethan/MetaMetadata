18D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwPVZUrTurQQ7kNvwEFxGG8&_nc_oc=AdreRwE6HZcSPy9DQa9hFUkH6sEIyA6XSNNRrxIfWOKkVC7Q7S4xAjcApALn5oxBe-E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0i_Xn5Dcoeoj1LwMX3vvOfhcmbscsHoTcAyM73KwkdQ&oe=6A660CD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kGWpzHBwxUQ7kNvwGzUHDc&_nc_oc=Adrnh1JeeQxjQz1NLfJuyX2Ml7M1FLlDaShC7PIRmmVYPFz8KZATJulmgYCLKqlNZ70&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkyr15oFrj4pid1VJWCb7iGxtepgaRM1tm7A41bqEeoQ&oe=6A65F589"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBWJbcNENUAQ7kNvwGI-4gN&_nc_oc=AdocZMfuA_LdWOb3031facompCo1Z_m5arzJtTU4CXkdiD6l-fgrCNXwFofvml8IOzw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWcpOsYFif8irrH0f7U6ZLa_uLSKu7upf9p3HOCmQPfA&oe=6A661F7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=464cXBs__30Q7kNvwFbLMGq&_nc_oc=AdqAGEiSI8A14jM38UBCbqMJffUQ6aERkKim1EX9gJuHMd6UPfZu5VrxG1Ruma3Akps&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4LGDCsx9shSxDZeLt7JubGjv3VUcnf2uPzI59HQJ9yg&oe=6A65E8F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76MfO0f_tjgQ7kNvwHniepq&_nc_oc=AdpOfZw0KOGGg-iwUlpWnWp7Q3QN8bxFIQ-W_prnbHJ2XtJz15BPDIl1a3LIS2JT3d0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP-s5JXT7wLKK2raJUix4A9r-kNrMO3jlSVgjX5ex0PA&oe=6A65FA29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
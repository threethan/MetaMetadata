4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwUZ60VybD8Q7kNvwHv80MJ&_nc_oc=AdrU9y9krj_IoM1BZvR491Q1nTpTWmYqDvkR8nfTv7kCgL_NrSQh_3DS3cGUUgFeL1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TwfBoiewNAQuILUarh_kRMw_os8luVxLBYZOPsalbXw&oe=69E4D9D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf_ZNA7-orsQ7kNvwEBv6YW&_nc_oc=AdpB3rAqVLCz0KZvGbktLxl8K8w3U19q-bF-HXC9GLdtIdSQF4uD0jQdxqdK2lzT_Ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IOmfREyU0aUpX166cM5xxEP4tsoASbb_ZhDR8NOquPw&oe=69E4C289"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNkKQyVppkQQ7kNvwH7fQTG&_nc_oc=AdovVKz8l5QoNzpsDj4kIyonsuMy2d9O28UqVqWctFddNwbWFLTc9NmMrkM4tdDacR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_8yL1Qd5FdbsQmquwI_fe_vNjgGYZLSMf4sXfx8rjbg&oe=69E4EC7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4otCepVYioMQ7kNvwHS4S1M&_nc_oc=AdrjrKsG6dFRk4eOKEhlRcZYDHtjlSguFBmfO5FPKWA3Ikq91kPyM89r0lP-uYE-ToA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kFIKN4rPxDzH9AuXD-tKLyxwm4eYKHjsAsfdpm5SlJA&oe=69E4B5F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48ZOZ4FQNsEQ7kNvwEBK9FN&_nc_oc=AdrmLRlR0bgB3L5HW7HPkmX6bF6J75ZjbueLDzQy3woBYZXA9i7O7WBGULiKZgqTJz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DkrnGtAvYzuTUJnVU3Ga1JCXtw3hW9ScjrL2Zi-Amfw&oe=69E4C729"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
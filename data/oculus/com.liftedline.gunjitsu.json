36A2D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B44t3vhGa4Q7kNvwHfVTAT&_nc_oc=AdqNFuBGYojd-9qEz5AUbWtNJY6pqFiTXxTxNwQ0zTy0Xagj3mxbSXlUlWxou1Y-R1M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s1FMg8OcKiHy35rvnTAwZS_bhGcnmqUVtv3-TWUkbmQ&oe=6A3696D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jl7G4ZZfUoEQ7kNvwHCphrX&_nc_oc=AdrFGfL5xFWijs5m0faG-isMXkWNPm1h_JaL08YZMnQQRQs8n4akI5L-znowme_mX70&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VuRogOZpA45k65Grd0fmqXs9PLucyTA3Vrlm20DbUKg&oe=6A36B7C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi-YAGpKK40Q7kNvwGwW7Ie&_nc_oc=AdpbAuCT0Eufw4P9PVxZDatlh2ZovbeH912m9cqTjICoyrpZjT9Be8QhzdYvE69ATZ0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hlAxsqgBcrCrJUpbchbfVKHW9f-LHEh5AF-CA84A1xA&oe=6A36A97A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JQ_OthCBgAQ7kNvwGgFpGo&_nc_oc=AdqqyYDWn7vjDSD7utD8ZRiaaAo6xjYyawdmvE5dvfuu8iQa46vJxT4VPk5Q42rm1Uc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99qDhO1O-xEip1fGP-IdBL1dDHsSdYFMdDM_r6XCFXCQ&oe=6A36AB33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu8MU2UvPQ8Q7kNvwGz_hn4&_nc_oc=AdoEgsSJmB7FsgXvXQO9MhYc4JuibUIWs9oT28PLhYmVSvoCA3FqO3DfV4VcYZrE4Mc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E45uQ6dOyjWM8X5cIS6mSMDGRZ3c4PCfJrya9r_ZMRw&oe=6A36BC69"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
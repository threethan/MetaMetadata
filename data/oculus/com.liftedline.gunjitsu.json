91D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWtMkIyyLZMQ7kNvwEk60h_&_nc_oc=Adrh5dE61nG6yKahmxIPC6XwOUOT4xkbHm2m_LZGj3DqOZFzflxtKzjIKXW6aBvhWWU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYm0EzB5qtu_lK7RHCuEYGn8hYBhhUX3sKptjww-N7gQ&oe=6AEC85D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQpmTxUwKKcQ7kNvwG4-Q5i&_nc_oc=AdqgDCDOwmwGXlkH9gC92iwtBXk7JwJ-6hsReAKBRU3pgdfUdp_41qrOmzTr52wOPQc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi5-Km-bwNGYwHDGSVtEwnsSo4Tz5HjIzdmGs1C7_yIw&oe=6AECA6C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SaIVwiHKzAQ7kNvwFPs-7t&_nc_oc=AdqiXTXgsN4I9KPuBXB2NYQa7LDsAQ41r2BuIfjYGlzSaz0yhUJKqJ8CNb850UzHegc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGtVtREw8WrVt7fD0sUQmvwV7GAE5ONpTCc9lAIIQtAw&oe=6AEC987A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0oLGyjOUEwQ7kNvwFsSvsN&_nc_oc=AdqLqJvcYfdSZrHZxo4i0AZ0JreyIVpOFyUdiKoMp0iuIrQmMyTWqPrYiLPn2tTqSMo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDOezpcpbLV9292B2UuN9WNLglgO4--fZbc0tEWABHPA&oe=6AEC9A33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL6GUm1AbFcQ7kNvwHSQF9p&_nc_oc=Adr0aTHo7Tf6wdw1RJYlSfkTUjBQoPGqBdQbIAsKZ6jutmMTsAZvftkmR5vQ1BWsQ-E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_SaR682zm7m7NKLZqk2faqB-YitQZMgukOyKcU6bK7Q&oe=6AECAB69"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
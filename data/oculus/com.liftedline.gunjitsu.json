62D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrMoOw5eewAQ7kNvwF9qky_&_nc_oc=AdrilE5NE0WJW8seYRfDeR5B9Ta1HMKq8-H_ZjEGnYieeU3eKYdhcyH7_9Ch4R9rox4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxj0kgRIKyeOYMvH2SO84XVfYI0p7n9hHeyS_Tk7x4Lg&oe=6ADF56D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOX4z-tXz7MQ7kNvwEOyc4W&_nc_oc=AdrV9SKtvWbeI09ca0x8w8b5eacV8nHNHp8fo4tn1kn95hliVLbYYnqcTBAutoh1Dmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsKvlJtv_O8tW3MCUAJFk6yvIm2Ei8tqb7lRLv30WWTA&oe=6ADF77C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GUO3SY_R4sQ7kNvwHqT1ui&_nc_oc=AdpeaSqBIVeP-1vk_wT0lWra-jKcgVu3-36dB1awcL95QgteIxngsSDQSz4GbJ4lEik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnRRuYSAeqrrdRDUGEJUjPPNpCarRyWw329JqjGsWqZg&oe=6ADF697A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE7Gs2Ac9-EQ7kNvwE67R9q&_nc_oc=AdpMYpYNsc2bhMbQvNuoiI5k45tgkSKgrQW9RhzRLKg-nxmnD-5YuQd0fjbSZSIkCgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHI-mOdGuRKEyEkFYPpbSLvRVci9Dy-3g4sIMSFAG0Jw&oe=6ADF6B33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLPlxEBKcvYQ7kNvwFCf8W_&_nc_oc=AdpwqpROPlj3aQtdB9riJiPTQxD8An4KJQZCie2A8DKmEnJANQvHBTSuTQLhYVvRPrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2lgVei7sq3f_9_4kxsNQUlSwiSykvqJPYfA-xdM-CUQ&oe=6ADF4429"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
B454"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wosmxe8PK-8Q7kNvwEFrh7C&_nc_oc=Adqv-vQIrMoSpv9GGLPFAVoVIx5CRM5FR7G6HcAJ5Rl5DnRhY82XvajF6UM9DrevFco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9NaJTp-FWFHvWQiAGUPHx-w6kWJpYQlnHbORF_6F5Tg&oe=6AE0A853"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOX4z-tXz7MQ7kNvwFYjVBE&_nc_oc=Ado-ybvsXbzZZOlL5PQNXqamQhexFuOQ_KA5P4nXjtSfFKhDgX0rMwFq8LyKqeiSW0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDX_jyWxX4Irv_lsxR0NE4sE-u7MUaEiaAk1OvA5zf-A&oe=6AE0C949"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GUO3SY_R4sQ7kNvwFEaVj6&_nc_oc=AdpxkoyjPi8qe0-42M3IUIIlovgnP-fZtJX2DeLAEmtAbGliK9DrlpWhPlP6Sny3hNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdA8o-SHrneknp_os03aBPKZ4eIJH8O3HUgZcTV5KKWg&oe=6AE0BAFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4BX9jZMBqkQ7kNvwEc5ey9&_nc_oc=AdqFAx_HmfcHORwHBHoPV8zycJvIwWMrRVo14KRuIAcORDCJ2qSqNf7gGXJrEB39ZBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdWncbv3uXue0OxCqh-Imnibsf-Xq3vPHeUPBOJngzPg&oe=6AE0BCB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLPlxEBKcvYQ7kNvwHMdZwV&_nc_oc=AdpkOJMsdOThWFwwPLo7QZa4SCviqFjLpfrdTe-aE1BgP5xFos2CAT1GlXb67ja6Rj8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOldkUpcDRQgk37WT0Vq9VicWnAKGrBuXyaf4QT65idMw&oe=6AE0CDE9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
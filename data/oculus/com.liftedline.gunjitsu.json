AD54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R5_Qvl9zLUQ7kNvwHT6u_2&_nc_oc=Adp1nk0JpwErRLzu5FM4rKDtNw36IFUACfzlXc-kv6sd-4qf-adk9V-B1LWQ9fW1xC8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GvMCgTHO1EOjR-_m-0ESY1qkuFunH5IbPwQFTOsAF-g&oe=6A15A153"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chrlS9bNK7EQ7kNvwEIYrFN&_nc_oc=AdrjiYSWrkdM9gzI-k_D3fPOPzx21LLExy7Z3Jp6BFWhqQYvaPxQOuOVO_0vJQM9ShA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79gdH0Lm5eWvf3IYXYXQ2jXwhSsTQNuGZipTpZMmd0zQ&oe=6A15C249"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFLHcLhaVnAQ7kNvwGiXEFr&_nc_oc=AdqullfKnspwkGTYH4EbgodC2JWDaUPsakDNCENLPoE7ZKQOOE5pIOHrTxTQSgw-Ox4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HHLQ_2HaC7tWmYzdJmBjJG2MQ8jfjlk9_XZ9D-vK7xw&oe=6A15B3FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzgNokEvGF0Q7kNvwFvjoWm&_nc_oc=AdrWj3QDt3O-K5THMQBDXYQpcWaKAx5Zredbge0Qkg4Qe7CqTvuf7paQz3EUOX5sr5A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iL3qMCRuza3MqxASTS1FukfHTk6wNkkl1AvKo9HKFtA&oe=6A15B5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zXHO9nqAIoQ7kNvwHCYbHi&_nc_oc=AdpQNCnRSDL9pNq6-wFGm2lssgwMmOh7Fz_tldtDjz7a9eDfmNlydDqzWQzK-pMC710&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tNXgruAH6prXa4Jxm1hnzoyWyCQWYjmAkNsj_P5MxYg&oe=6A15C6E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
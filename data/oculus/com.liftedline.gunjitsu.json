2954"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kYhUV-vMMIQ7kNvwG5ELkK&_nc_oc=Adr86GtwfB1iXxo4X3Pz1W3MUDMbSW2JGjAt0msuLc-9hSl2GkpDDKtufjRPEYioxn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTd484ARyukK7o3coZ946JSJ9wmyRuNexLdstdXmBprA&oe=6AF35593"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIRl1HkqD3UQ7kNvwGCeL9Y&_nc_oc=AdpeDJjx04GcIcAwI2rDxCENlciYEGfIf8B3dHd5WXRLzgrt-tfiA73dPuS06p-M38k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5R1VI5KWCHYmKIKDSmOn2ZmKWOcw8obaUeiYqugCA1Q&oe=6AF33E49"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TRBWNmqQaMQ7kNvwE1v1zv&_nc_oc=AdqI23RnLSmek05GOi9BofKPIj4spg1VHEOVZL93_nDTYrnuv_ROEMm0YglhvHkeec0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-8m2qxekU5JmvyJNLG1zl3yj7ET98jYaZVEr7H2TIVg&oe=6AF32FFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WNP5QDdNEUQ7kNvwF1mq9n&_nc_oc=AdqWpdE0JnYLFBjtU8SpVUbQDGCJxuSwKbxz5vFU-izxs6RlYD614dV6i0Jfo8TG3lo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkNPuZb2bkR4suPJu5PQHm1jZtg1CRzsvZRXeqOnlHmA&oe=6AF331B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mbdCKzfBbIQ7kNvwHBP2PQ&_nc_oc=AdrsB8lB20zD38e_3kLF3GbtOitsLmiL1aAqJQRIAV_WlZgntFyD8tf1Iva-iKH-pQA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpkFCSmPA4c35ZRZULh0MtO6K3cjmSGmbeGTenlwTqLQ&oe=6AF342E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
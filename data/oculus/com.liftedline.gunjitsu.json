B9D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bw0bQqvW0r8Q7kNvwG4c--p&_nc_oc=AdoIexaMAC_YkIydVEOHCrNvetwjZKbeTBoUwqGnt1KgHFIQVA5R-6_du_0-PBcexUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GDEGQecy-ov0Tmc-hASYl2E5yJIMC-jXWLdFHSgxT4g&oe=6A2EADD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPRX0GYOEO8Q7kNvwFjau28&_nc_oc=AdrWbWWJodX4cmYQSL1UArVVSdgQc0oYstjTXt4J0tCs1ZAm9uYvs0_CNh8gYqQeK-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VpB3fTODbQzfPbwzpbPnjDqUj1qgwmoTxjbrFyFDFHg&oe=6A2ECEC9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1XE3FVohnMQ7kNvwECtS9-&_nc_oc=AdpSwTRizpb4CzLspj2bOm4Gxf2XqIUAqCPOE23opUdJUKEbGiVoGdV2qEfxGX3WlW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JjAaUbqjTEGh8pyP5nmFHNowOvrLi8B8D0I7Tdwp4sw&oe=6A2EC07A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RPW7ohbdRIQ7kNvwGqxDrK&_nc_oc=AdpzkjajHEZucTTkaA6iEN9VVDzoDmPtnLV6fnvWbyHa04mweA5loGnVj2qLNYDk_Vc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h7pWkaFXPTIf6OIn4WuHm_kXFuZg5mWnNVU2XO5FpRQ&oe=6A2EC233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWjo4dVgOcMQ7kNvwF0qSWm&_nc_oc=AdoJ3PoFM0FGkB1uNOkpjSRJKAGBZWnpoHlg8QtP_L5GbCyvxReAL4LI8pVLvLfMHXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Co82173uIoJh7G-S-p6DCWAagGqhHrxZ-rMVdMNo1jg&oe=6A2ED369"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
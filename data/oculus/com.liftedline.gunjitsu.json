0D54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCX4EW9jl0IQ7kNvwEwi4O9&_nc_oc=AdrwY9qH43nRJG-uuV25fUrSbYzFVpWv8HRaqwNVA97Pv_U9jtmtDiILafNGmeaVQYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKr_e-AcQf2atGrk3jdHboS9eIak7eeFHnc6BcYrvIRA&oe=6A6A0153"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3sZKJ0k8-AQ7kNvwEYX5EF&_nc_oc=Adqb3_Odz3SX-GF3Z2CBlDNYtsu_SBDSqt4kEec0bEg7Ptgikcn-JjbSnHt7vulz-Vc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQqATe-zSL75pxeZHj0GIwBZOvgcJO6MGKPT6_uk4DZw&oe=6A69EA09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPLDknchHWkQ7kNvwGYH-Ac&_nc_oc=Ado_OY8FvOwFw7d5fl814ByIDCk1kF095R0IkO1qzHtwoQdW2DfTfgxKY-8sSzSNRlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsI9IBvXjEbl7GDDmOrE23Zkz17fYA0YWwM09M8s9lLg&oe=6A6A13FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tE8hv3f2uUsQ7kNvwE8aJe7&_nc_oc=AdqHttROSlQnW7sQXnX-Ob5c9WmF4NuHQDcFzuSTCOL6vH_zN3YPpqvSRYJX9-SlV5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_SA1gT54D8_tHgB-vJ4sVcduJ1XmQ2s36vF9YxRE_yA&oe=6A6A15B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVMpKibVQ3gQ7kNvwEYSpSe&_nc_oc=Adrq-Ox-cjNOy1NrymWixfyazxsZASZsWaHU4C3a8zcBPrBbH1HFM4AtVjWDEWDPd1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD53nLsPE01p80jR7xEcTZjbFVJ6P6xYBIwzyGUqpIMTQ&oe=6A69EEA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
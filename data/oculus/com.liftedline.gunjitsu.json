4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vkyc3L9H0YQ7kNvwG_9Egp&_nc_oc=Adp3wcs2UCh4I-Tv_Bdb_YBhr_PvbeYU5_PG11ndfablnGV4TubS9jEqetQD8JY-URM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSfv6CfJdHV-1pK04Y-1Fd9So2D0eDx9Sy4nXzFRaRdQ&oe=69C292D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0q_VpJfm_AQ7kNvwGn4MYy&_nc_oc=AdoNCoRsgft4Zbere7dBo2NlL3ckug6jiQtuiD5TjNloTDGquw1Fk6cpLKYKINXkWZw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5FM1LhI4RTbY8ING6Vui1mzSuWMcobippH5UXXnsrEw&oe=69C27B89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61VGV1Xblu8Q7kNvwHFq0pS&_nc_oc=Adrh0Hk3LZ2Dv2bHiYGIxCv98iFb6f_BL8ca01KzoiUEuoZB3GSGjl8-WyE6yIOS0L4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxGUpOlUFM-NJJkdZAFKRlRTkZPDlBQvkPf6bmd7RcCA&oe=69C26D3A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-_C1xKk2r8Q7kNvwEVWujl&_nc_oc=AdrXR9NJs30bDCIYMZOciH2IqEbedMv1x6fDQqWWdQ6r1xSxfZ8q0StxZWKNiQl-kIE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUjfyUWi6GrgOQ_OwG7EgZ10WEvBefFe8_sbNQ977hRQ&oe=69C26EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm-1q2oYNu8Q7kNvwGSGMic&_nc_oc=AdrNFIGwifmIlqrSJs6hbaQU25go0WX1Th4X3jhmxsrddbF7zgTACHAUx0M8wMa0Jvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTv0lzKpYyHpvY6HVSpBzWu9YqcZq4xyI614nMiOQC7Q&oe=69C28029"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCU67alx1AcQ7kNvwG_QABv&_nc_oc=Adngz31h7mk18XrOnnN1R-4hIPHs_oqz8Nje23_CtOKdOX9P3I42314qMh9slj7zc0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwY0ecuMZBwp9Jbz064X9UZ2Dnrju360bBdO9RLzJJXbg&oe=69B95853"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syy4AR_bXaYQ7kNvwGlBRy3&_nc_oc=AdnKLHVHmBF0OfwMZv0uINxi35CRTKG1lPRyxtUj9CQ5YQQ55PmU21b906dyBxHSYp4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJPQVCUFb9iR4aNm6fXeiNrhJ77MM-PaQJUGAYuw137w&oe=69B94109"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2bugo4TaDoQ7kNvwHVJwTx&_nc_oc=AdmuOnMj4GvpfY2ZO05L3V_a5XJGMW0T-RnVGHJT_dd5iuTn2qroC5NuUquUSxkr1UA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyqx92jODI7hBsSS5kOZm_vMI0HPmq4MpCMb-brP-5sYA&oe=69B932BA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPTQyJSSOvgQ7kNvwG4lt2J&_nc_oc=AdmCxpN-T4yI4T9dw07xOV4C6rQfFv6CSXxKD09vDvTg9GEDXfxnJ4EBVb3J8Hodm3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfLr78tYFmOo0nEr6cfzLyjbmkBk2BXsFxmjvcMLMJ3Q&oe=69B93473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIjLt4zwieUQ7kNvwHanJX6&_nc_oc=AdkO4pA6igVcsle6aHuHahjkBhTBZ5b2NFf-yKE1dNA-WnKP5ssWz7GParczp_GaQGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFjrXnseMJSQnnOQHmXVJX-ltIO5ZclvW6Q1QlVnxDrQ&oe=69B945A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYksJSWTkGUQ7kNvwFiqaBk&_nc_oc=Adof_GBz9UDsdCvH8ecKkeQZ-VmN4O_WtHH3HjA3HxzaGV6FFf3MBEovSF1SRac-MVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lulL_7Odey9ebqL89CUYCC84ibwMGaPfbTngTlEzMrQ&oe=69F74ED3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itGYRcsTVR8Q7kNvwHWNyac&_nc_oc=AdqbMwNp50B2dPbcV-M1WwIm7ej4l98eBBrOSlo_3MrHsnIj5X4iEJWOqZooUbJK6Ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NiBby9roM5DkUpBOhD-7625xAGU9vSMfONYP4fqhtjg&oe=69F73789"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7ENszAGksgQ7kNvwGNMmpW&_nc_oc=Adp-u3k6DZS8IUNyPbYhkGJD-hZWyxZOGNJIYzGau6wirN27o0SDLxGWaQMSVFub2oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dMXQ_6YWQkQ4uQHyl2hwn_AhftYj7sdixdFr04JPfTQ&oe=69F7617A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrhwV3lQKgUQ7kNvwGrOKCm&_nc_oc=AdrSbZ4a3YKcWeLKrcC9Xm1kbRC-2SOdpdD1wYI8Er381qjPgVnzT9Q1qSaUHTdV2HI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09xY4rvT1BMKqcUm4FSv53uLtkbqQmUDfvFlNfvTI96w&oe=69F76333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDKoxnJtRsgQ7kNvwEhyXDZ&_nc_oc=Ado348830_GXvWYfHggH-ouLwzl-Ej7ts9VxgWpncKsLmnYhCzHN7Maks1rSij_pQPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2j2ZPJ3R_7uwExL4naTOAU_OPA-VTK6Z3YMlBS3TlmHw&oe=69F73C29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
6A8EBF14"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e5jzMEboB0Q7kNvwFJ2vWz&_nc_oc=AdpzqjWplJDqYWgBhNZqdTDLSRkze6PGG8OTMc1EEW4bBjBLGhoP8jLjj4U45VcF9NY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbRYH-xAI6G0TMQdVUeMd8kXfXPfWe0voxW-Sax2LgJg&oe=6A8EEB53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxMx6LFCgFYQ7kNvwEannn3&_nc_oc=Ado5W927IO1BQIFO-RriDQDfv29cfVDBOVHEYa6yK58D4GDJbNj9yl5VBR01C7NPzjU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnIBTwwVIG7oOW11WpenV6_k4AWJ2eq9ky7o6ZwtV-yw&oe=6A8ED409"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YgkLEkFz-YQ7kNvwHEakRq&_nc_oc=AdqCtCjED3ER9Jsfz8xSu3-61sCUe0IEGUfn6_knfCdinoZ_MjjmyZ8NmGMhktvhBGk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbkEOCx_qT5L9s65ztoPz45XaOSgLnSmdig6zLU7760A&oe=6A8EC5BA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk16w_lAJuQQ7kNvwGR_bM1&_nc_oc=Adp4LwTfvzNj0CbLpX_Vzw9wZ-Oh_Q0hu8nPuRF1j01EHjnBij_qpeBcul4Qra5PlM8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9abTp3Bt5tsxP2rWuO59h9Rcvsr3Ri24Q5VJv4Gt8ew&oe=6A8EC773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvZTXQeX-LQQ7kNvwHz07KM&_nc_oc=Adr06BB9AYEQNKNPxRQaVd-cikyqNdhAT4SmTfMNgDAZnreBW-i9gIkfMQW0_sixmiQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNWSc3ObRhYEgMrbLC8ynDMSJ41qti4tLakcYbtd2pgw&oe=6A8ED8A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppor
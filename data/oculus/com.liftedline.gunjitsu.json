2654"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9gVnZAeEcQQ7kNvwGS-pvG&_nc_oc=AdqAAhr38Y1tvlxk6AxAcRNZeQqsMQgSKNCstdjAPgGZPK3moSW0QgKtxoBo_rQdXUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVpE10ZumqiwfCptwZ4JrNjgOSSW-3hy19pLnyBZqLzw&oe=6A9C1A53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JxaQ8zO5-0Q7kNvwGJg3YG&_nc_oc=AdrMM_tJoBbTwXGVvxKm3WB3Lqvbxx1aZs21GeGYsEZRhi90KIqlW8G9tN0WuVrSOBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIRGZi5DY09_qG_mvd8pnVignNmJz4Oae7LxK6KMQTGQ&oe=6A9C3B49"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo36Xm8BDEQQ7kNvwEB89tq&_nc_oc=AdoGaTYs5wsVAHtP_9XkvtZAMLv2ttp78FoUZ9kX18g349U4fEvQ17TBYA17xjyVThI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHgjZVaoTZjxYrjI-jGmVGtQlhl1m7PRjS13KU5BJWYw&oe=6A9C2CFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVAp_awUciYQ7kNvwGKL6VJ&_nc_oc=AdrvHZXAiNHS6ibJVzm6leT-yVJwGWmIZLduo9su8LzHeVa5EQ87dqUCmWjZHWslsMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILcGpsjDFpFNg2taEe7IDPzugM9UBrA2OY_QbrB71QaQ&oe=6A9C2EB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9_KW9qMcc0Q7kNvwE7oQXc&_nc_oc=Adpc_uXqJPf4Vk9QrfZkmi4p7-RLCfii9qPQpU2FMZUtLPJEKs3BTJgPS7JlNDhdj8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN1lZPDiC-NTjT2k24kFBy1ERaxHKC4MZT_zUyC4MIwQ&oe=6A9C3FE9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
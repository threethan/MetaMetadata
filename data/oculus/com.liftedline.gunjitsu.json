4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhf_zBFMmaEQ7kNvwGa3fkv&_nc_oc=AdpQqlc-h5mLKufUiSqFFpCXdtUydNKtxaCRP8mOH-OgAKUNYoD87alh0B2-KUJ_kDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m_mQ_snH2zGsDVyST_L33-mMH3huOJAWSC2glpbmj4w&oe=69E8CE53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBrAf3XreOsQ7kNvwGdzE_z&_nc_oc=AdqJJPBwKeVfg89bkdp8E0iNujZ6oyDDMg8EvkgVhqiPPaHZSKR_K44P6h_gJHhhHTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gqv-xX64DJNyB3--TVJFtT6F2KOsxWCSMEkwFQ7fixw&oe=69E8B709"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7k7DcqBtnUQ7kNvwFlBG1p&_nc_oc=AdrG5A75RF6V2ompP_EGm62rA6ixW3YeZoVg4uShstO3l_1Ppp1EXGcgeRxPAsaRNJI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21mWM-hUNPAZvejuct1e_Yd4MfOd1Y_0zKL-sv9LtcBw&oe=69E8A8BA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBaAXOJKALIQ7kNvwGHTb68&_nc_oc=Adqb0MAU7V4VBNuBrf-mK9RutHE5M0I1Kh9ciiysh_ph7wq2ARuZiH9Ej0zM8vuyBUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jdThRi8XD0qbuctjDavDnrX1ChSrwkw5fpoKnxNUCyg&oe=69E8AA73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUtgtJ3-YHQQ7kNvwHVQS2-&_nc_oc=Adp3FBAnTuXPhYGEArdQSnj3e8Kbyovu80u4VZyt-LAMd5Irtkihend5XuLLzitzkmA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06iJo3ix1oZAKOMlW9gpVfroHUBYUclv5Qx1YBp8KY5Q&oe=69E8BBA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
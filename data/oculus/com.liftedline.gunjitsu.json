82_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bbwH6-Hw8UQ7kNvwGs2s1p&_nc_oc=AdmReeQNssKlO9YISbh3B8qG32pR2lhE3M3adtGth7G9-S826UJqr8MrPgjqEFPNtgc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxuQl3fEeCb5n8uaFeINlSW3W-CMAdOpVbIk994GgdCsw&oe=69BD4CD3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzVG-XxPKGIQ7kNvwF09ZvY&_nc_oc=Adkn_azVO92XnVm6F-Dof-vGUoWfBfTtDFfV3WINRNeAQlIrQrqx7DY4KAGa8wT4FSE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXD8iK8uKuKJxchfdPV7gO9FyYDO6HQAz44pBwfd62Lw&oe=69BD3589"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iynDUJuMDcQ7kNvwHHHJub&_nc_oc=AdmwVGUTSOU9p-qJPxcqet0Vj6CTew_hl9nMZ-1xVX1MRXFIcAXFGhMfekSyFjRIGYY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGrVkEBcD5EF-tUeFN5EWa0VRDUkoq0IVnN5hcKL-HTw&oe=69BD5F7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jr4zg9a5w8Q7kNvwGklvVK&_nc_oc=AdlzqsDrJeN8XmHNZaUhiKo69xVbwsWR9jWics63aGYARZ6KTEzpYq7AwNfd7R-EbwA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQsawHrTIPSOKnskhtHU-RB6qAvvT_dgXkNEtE4GKD4w&oe=69BD6133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dESzIm2w1d4Q7kNvwHU_ZzL&_nc_oc=AdkcFrepGcnNWGdDlDLBqdl4VtvouReEwqxCv59YsEysymiqYyiCWNMJ0YY4u_fUins&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyym8abbIWezWdHeNwF7-s6rBj4HS3MUDhHsTKLJQMj7Q&oe=69BD3A29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
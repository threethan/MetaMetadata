8554"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h43iH8fDegMQ7kNvwHly7cp&_nc_oc=AdpT-_pHvH2xR55HjQUDfRBBo81HDsYg_kuz5wWEBCDw8MUT_GCKNIGKOd9DJGwRn54&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZjOH4Ku5cbVJTxwzRnmo04cYdou24e-OuAPu0cDkYUQ&oe=6AD3B193"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfFmNmqK4tQQ7kNvwGJ6tiL&_nc_oc=AdrqI_pKEmd94wb4alDm-20RNQjc1_zpl9U9ecHstB6FEG_pOoLFXy2CXYZkTxCg5KQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiv0-QWNaGyIl00WEa8cVAeJn0_3FMljBagJe8YmwgQg&oe=6AD39A49"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjQOEQIxOMUQ7kNvwHts0cx&_nc_oc=AdoM3hpxzAhb0t0hJMSkGlIL-vIttpdAlBN_UhSzValqoBWBrXUfjlcwVKkeTmRdhW8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvwJjzu4ONDZ77BEO_BA28M6hXu0fGIRLqIQ24G_8DqQ&oe=6AD38BFA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHABR6MeKxAQ7kNvwGRb0f7&_nc_oc=AdrEGc7eGA-DSkbSP8uqgM2CKsQs9uPuNEwJ3fDYqG-2UnS2dy5C9RSEG41NAaye_Wk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhbJRTZ9mkvur7A20KQR-UwItnbLUX5ICg_Y_GrrwFUw&oe=6AD38DB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jZV3Fqh01oQ7kNvwG8afeR&_nc_oc=Adqy7276Cas8RYNFgaJvJQGb8-ZlTkFDS6rN_SWjoIM18yUXHTR-D7azOxPyywmHpKA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsPMWy_RFAD-EuO5e41I7Od14wlABzldYgTeFb_i3jkw&oe=6AD39EE9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
1AD4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYtdfTg2JN8Q7kNvwF7fSvB&_nc_oc=AdpCm71d8CaOhL8oD7ESqZ1Tgd6MFJYsCfnOab2fKt8imwPhGY8OlkMhTzKghAm_IbI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8s2fU4lZoLI5DiH65qtoaf62qqoT3RXo8vQ-h9poTXg&oe=6AA00ED3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiZ3rexP7gYQ7kNvwGfPY86&_nc_oc=Adr2h-FzzpEDASeb1xC3pZNAdoZBa30iRRFG7FSUPTM-7ziK4KRv-pIgN4EETCntKQI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpEdusTI4NBj0h1AJTMRMKBe_PFfWlWOvCtUKhId9s1Q&oe=6A9FF789"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b10UWetrJv8Q7kNvwHs0nJD&_nc_oc=Ado9-VQ73JCOswrKfxMTV-SuhP95EJHBh7uYPIHbGBblLzFdkLuup2sRIyKD22rB9ic&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjzu9ib9hTzdUmzmyr0dyRoZKIe43TgQufBEftY3Ql8g&oe=6AA0217A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1JMxmCdiZsQ7kNvwGnlUBy&_nc_oc=AdrwOcZd0XaBwEyHBn6QVmjyXoE39ckbP1EhvvoN6UnCEYt36OXjaVklbqy6NYV9I3k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHJdv2jbMMBIjCCop_oz5JF72TVrnotR-e_T1QyhDtPg&oe=6AA02333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjOuJolS8MoQ7kNvwH-uAEl&_nc_oc=AdoVhAjoZiqSHR9YUK1Ch-rg99JMxSoukyNe_7HMHsU-7CF6iT3aqvq-emuVP4FMX7c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8QLZK2LXPq_W54jR88Zs3-7kBVeQNBRPerk7SJ_LZPg&oe=6A9FFC29"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
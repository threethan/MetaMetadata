9D54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efxszM17jkQQ7kNvwGhnznJ&_nc_oc=AdoyEidVUMRGvmi5aE8i5FvfX6w0Mxyy9MoNX4-Vflh3fqRWPiYgLzePaNDdeccZeN0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWwSAJWqUAnLDyNjFRAl0Es_wx0IMewKKX92dTcURCXQ&oe=6AE89153"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOOEu1Q8Ap0Q7kNvwG0PGOT&_nc_oc=Adqsmf5k0LHG5slKBtibpZc5cknMh7dgA-WtFnWDmrCKlSyLrUm3dWQKGl1eflWTNXY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSgF51n1w3u8xJvbbstQ3QOrEsOH6DoF0VhwmPGjIYxw&oe=6AE8B249"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ-TLLbXXYoQ7kNvwH0Z1sP&_nc_oc=Adr3a6mKmDxXcgwDjYRZ-eRpuydhWy9DDsE3ppPEmtflnY4NylJ3XkAbs1SWSM2e0FA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzxUiD3HgqZT9esuajyopWHgBzli1rPcVwKn1K-iA3RQ&oe=6AE8A3FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AxlinKXFHoQ7kNvwENA0nI&_nc_oc=Adrgu1ZGGYXoc2ZZ1vWly1psyAx6XTAbv66uxTge6tkR4mFxMyMI7_BuLxQDMSl9xaU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRmilTtNv_yN5uP9UCQiu1-1w5aCjSjNpeud71AF_KPQ&oe=6AE8A5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSDdT--TsyAQ7kNvwG-5vUW&_nc_oc=AdqXAzxnQlk74-obnZk_9LlvhJyfcoo3jNYwPRLMflZc-7iu8IkxpLXdoXryCLV97Bc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZUeSH_mnaHHLWI3J6w3JyGIIHxXU4RK1Cb_hs6yGaQA&oe=6AE8B6E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
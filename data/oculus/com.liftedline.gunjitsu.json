4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dUfmErOuIEQ7kNvwHUshyJ&_nc_oc=AdqtIzCXIcdJGiIS4qz65oiOkJORab8Vg_5GlQtAvbpyYCkYdKZFzNwuvdTQolcISXo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTYQRdpPfFTbIb8dTL7JQ-0jEtW0WYmDMymzgSMiXi4g&oe=69CE7053"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nJmWG0TLd4Q7kNvwHZNiU4&_nc_oc=AdoKZnfHVfeDiBAealyXmOi4CVxmrvt7cu6GtlhcJq2tuTxfyEC2uWs6wh-W93PSP1k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw21JU8UPZhyKuOGx1oCGAGrxe_F3f3IHvEoCsQxkRY7Q&oe=69CE5909"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyunVmzKi3wQ7kNvwHWzVID&_nc_oc=Adrus3BDD57rG4Wd1lPKh42qqcbzra9epgxj_U60LrNv8wu9shx_zbiIrBIivuxx1_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKXOl4AkKedRzFlEUj78uSulI-VmyVgUKl4Zad4yH86g&oe=69CE82FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESW4BwfIR30Q7kNvwGR_NSE&_nc_oc=AdoiOc1Xb8-WY76WjIh12LlmbBm4_0vnfiYPA2rtKClAW1cvSgd84hJ9puL1Lb6rN5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNmS7v59-nJhYpxPyGMM4AyTv1ViOAGFoJq_BV3URQ3w&oe=69CE4C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViBna8TOrtwQ7kNvwFxLgJR&_nc_oc=AdoVQjLBvWOKlWunPAy110V49KC9HeMrO6HTNtcM1V455cfwG1sbhrh0SzbUtFc0bMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzR5DTf2Kvm1hcxplD8qQI5s-iQ2593IEE1vJikEeZ4rQ&oe=69CE5DA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
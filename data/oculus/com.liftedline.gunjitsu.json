2154"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv8nOpRYaMIQ7kNvwEs-kS6&_nc_oc=Adp3op8plAcGX_JOwWRcO-jspLwrHjQCZnfBq4AjFe_wOJiPD3OKzG9hxbE_YZeJ1w4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af530_UZz_ZHT4TGFEaXCC7kiB7HeJkDzr5jUiYuIExs9g&oe=6A0B1553"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phF3EvYq7Y4Q7kNvwFsDMzX&_nc_oc=AdrFEQNERc2QQ35st8Er1tYqQ9Vi7FyioHqoc8jXjcKWnoeg7vR9euKOHNz6WHT3f0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NMzqrISGZW4fBpCOlUFf2cv_wNHtIU18dG0hP842ShQ&oe=6A0B3649"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9OWRbBkpeYQ7kNvwHd0xfQ&_nc_oc=AdoHag3C12Rwa6bSENA4NW1CIqmvY0vwLvLzf1jmxs9lkmigueK7s9qTSXxxBWkFQvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KYP8XFzQlMThWDlkT5m0oTCPKBHF83isqkJBWXIdmGg&oe=6A0B27FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10EhHDNBxowQ7kNvwEtHEh_&_nc_oc=Adqld_I1E8SR6OLxAzZuXevgBYglqvdFNVvHC7B2VQN2VmZ3nS3D5fR9vScv0gq9sg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6S3LB3YmvtlyhTd2pMwamiEGoAgpr4rjiOmqMS-paNkg&oe=6A0B29B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miWTjH5iZIsQ7kNvwGpccuH&_nc_oc=AdrYjSeT4NoEcRMtkQkn0MK6mTBTkSxt-Z7SglhYouOKOdvjKqb0iqkb_aztx3CHXrw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jUje_d-xh1wjQEtNV_H_fS445kYbVkYxHa-1MRuL_Gg&oe=6A0B02A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
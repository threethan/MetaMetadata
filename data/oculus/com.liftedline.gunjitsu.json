DF54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFaRTNsUsCIQ7kNvwFFB6Pk&_nc_oc=AdrYIKkGrlSC9LzCG4hCFETd-44_0TEkqKU_kHbCNj6FA9PFbAKhvkcR11ysfeYWKxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAD_Ft4QZZHQW4fiI4N-Lp_SujzXMwhNtCFjlhbEAJ_Q&oe=6A79D353"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN6ThCANPRYQ7kNvwFrzfn2&_nc_oc=Adoap5wiVzE5kkph2DoKCEXxOWZarIL0HyMKtfX8CPd4Y11IdD1QGtCo6aDx0RVpdoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-nP9BC1aOpeN6hGoeHT3jOgXWB57gJDa5i3WKSlhZQw&oe=6A79BC09"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TioPC-Lp-fcQ7kNvwFMOhFg&_nc_oc=Adp9C2x9ZZNBwm4EUA0fbia0sqBqlaN213vk0CYznyYSM_tAiFmOdZPx5a6l1ax4OWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4bXsQ7IFHd5wU13cAkd9vc92ll8iBt13SZYFKsSaaqA&oe=6A79E5FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzh2q-zvUuYQ7kNvwEnNE-H&_nc_oc=AdpdNaFACUB_F7Li0IYS_YJPiOT8yOqn_ZVn46B6TEblBisncqSssuUEa5pgVaEVJ68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4egE0HPj8Y6d2uHJs8c1HkLSVqWZdwBx0Z4bmGk7Ibw&oe=6A79E7B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3q8-u0-P_sQ7kNvwFQVwE2&_nc_oc=AdqvHtgOZ7XATO0bU9cIaX2tN8vOTTIC--SAPzitSnaR2fuGD4pYYe-fZGFPBgalY7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf8w9n_jYkzAynImj_VQW8bhcm8RMcj8UUChMby5h2qw&oe=6A79C0A9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
BED4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHZVDvYKhrEQ7kNvwELEnDk&_nc_oc=AdqZTtqkRUZX1JCZnrUVeLPo-b26Jd_9Te87GuUvzqFtqL2eu8F6_oJKo8bliMTdI0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6nsHW5cZv4O60NmHd8yb2ApG8UXMAsjN6RauE42D6Eg&oe=6ABFB2D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ClHlWBdJEsQ7kNvwE5fKlm&_nc_oc=Adqyy9mrIddJtup7oAwHkvhs8nrmXGcr8yA--En-t-2GHtJytO11Dys3UB11NrbFqh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTAGmYiI3tfnIChS_Un71BIm6s8_ousQMr2Yf7dFs4XA&oe=6ABFD3C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2kT2tsBo28Q7kNvwH3vF26&_nc_oc=AdrvnsacHnYVB2_XE4SNIPWl7015cAyT-0xaqjjQfNSFs-msrsLRRycl-yyeAe89wco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyUDoQvCCy9UJggl0TdIEfR8r2QPWqN30u4DkcuR1d_g&oe=6ABFC57A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBMmdGiG0vgQ7kNvwHQOyyN&_nc_oc=Adqcg0R70X6LuVQ_8TYr4NFkgxRFvajWFKRg8tazQwp4tmNONy2tTEcIMxbvw19gxxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu89R2D09yjgGNJJ0qY3s6LrNIs55V3iotbD0ab4iN3Q&oe=6ABFC733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFwVfk2HaBAQ7kNvwHfBjrp&_nc_oc=Adrerbr1TI_gXnEJh7H0wryOu5dKEB0cVpDuJfcdAmfRIedY7Xy5wUzOzPhz54C8tvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ9ozDTl6nCQeFr5HBXyLaelE0GTMddYMoEp5gUhKYog&oe=6ABFD869"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
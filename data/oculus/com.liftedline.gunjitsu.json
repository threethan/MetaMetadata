AE9B54"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l50YDTPYyOUQ7kNvwGlGysI&_nc_oc=Adr11LI_zQgH1fsrPCS66lF0Qj1LQTqWHC5I2Ecv7CwbpOytGtpzQIE8N_nJPCBWsm4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3WJtRV4nWtGZwOvtVjzwpJkXmklZCPYyCWYIRou018Q&oe=6AAE8F53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZD3hFXv_gkQ7kNvwE_dRXy&_nc_oc=Adp6ihmm_WeujJNXWPQXjMJKpXkaZ6s42BIV7PEywXbbn2RRtWfGVaZP-Fku1Nj1Qw4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7qJtCcDjAP0F9kOGJ-b-VKMSqC5qL8jAqlkakfs36CA&oe=6AAEB049"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDjlGyFFHs8Q7kNvwE29Mst&_nc_oc=AdoB4qnHIquIYXLN-kY-xlRnuHJaURL-OhTgrHJqgw_wXTBDvH9Pz5EySc9L7RS1DBE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUniaTI3gXjHUxgnh1f4bWM0tGYbFL_A1WBUlbyGkcJA&oe=6AAEA1FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhwf17xM9wIQ7kNvwG-2p2n&_nc_oc=AdoUTtcmfLfHWo-QR__Jx8aeG_C7N_8CLUVwe3gmmuBJs93ZNQ_SVRETpaBm0KRCKOE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrL0GaAVipdpI96uDsxwV_K4IHOIn17rn7yzzb1i9j7A&oe=6AAEA3B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCRwpcOxcA8Q7kNvwHWMQqh&_nc_oc=Adp5uumRSd95GsyaOxWc2UZ9jYQ7r2ZqCuVtDEx6MD-1bFSfYjBs-k7_Oiy4kPrGNEY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhU0YqOh2zdrkiK_SoOxzx6z7QgTxpmEyEAKGJJ5qtAg&oe=6AAEB4E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
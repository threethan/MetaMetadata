4.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN6gZV1mNg8Q7kNvwFC4HNh&_nc_oc=AdrP9hknO-Rekw3_EELN1KOCPgOO7GW7rhd_tX5YP8iBQ3HvaI4bA04_igtTJ0kdNLE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WJXC0hTSlaKXwRvoGTMikK1x99qo72fvOqdsZUeAJjw&oe=69E236D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf_ZNA7-orsQ7kNvwEoc0tX&_nc_oc=AdrXhDLWNpmD-39vWPEzymetVQDYhQnFtHCW9RAuJo048o2_9Ls1x1_iglh6pt87ons&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uEhv9NW-OH-2aKbpriInDCHK-Ouu9iRnszVMWdDH3XA&oe=69E21F89"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBnSQPiRjs4Q7kNvwFecq3M&_nc_oc=AdqiCDEoDdoBQY46V2O6MRBnh6KlEGp7hHgVGeCCp70lb_3bbgjDFYnD15VMNGBZT20&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22J_firMhiA-l__vVDXzhskjbw_d3w6nW2HM0SVlCSgQ&oe=69E2497A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Svgvu9BzP5MQ7kNvwHROIcF&_nc_oc=Adr-pUso_xjTogMjnop6PnvE-bdxz_K42BT_LrRt83VROfc4eS80VRIAkNd7-mzkzAk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c0NCxbhfEBFk6MHypAddhCc9hOeL-I-q1puiYsqiKAA&oe=69E24B33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBhcQHZwezwQ7kNvwFUmMtE&_nc_oc=Adq4th3g0aztEJB1EKLBMpe0vjhQnTx_J9dUQlWjLPAvvR2QhWmdKshFynOCCdTntAA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Unjk3q5ZOwvhJphOHSszIrUHtWZqz_IMY-Zz7jL8IZA&oe=69E22429"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_modes": [], "supported_tracking_modes":
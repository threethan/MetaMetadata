1054"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=270tg5Gvrb4Q7kNvwH3cXsD&_nc_oc=Adpazns7LE3wQ_3rafgY1Epc9bgHxXjvGYIHQDaKKy8Yk7rwAT9Uk_ZiFN2lVOxJZZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKooLz0GYr4ZPGzHL05zHOKl35VhhJC7ZZ29Tr7wkr2A&oe=6AC10453"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ClHlWBdJEsQ7kNvwE-qiCn&_nc_oc=Adppz89a4akVBj-YoGmVrPhHSb022fUr_98rpxERC4tqTh66sFtjjfjgUBsHn_LM_bA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNgSQ1vUZ3fZz0avBhaW1IWsfmowgdTkQ_Se_CYTN-1Q&oe=6AC12549"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2kT2tsBo28Q7kNvwEaSlDS&_nc_oc=AdofQis3uX1TPubu_nATgK0C7v6sTshAiiYyp88eiKytUoIp1I1jdUQ8NniLLKDOT9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhd5TZXrw8_SiKb4mfg-L7ad9eMCnaKo4kGl7nTYpxdg&oe=6AC116FA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J5qLYopyc4Q7kNvwFfhH4v&_nc_oc=Adrl5ZZOLCiDzm0mmFPnduZ6I2mhWSi0F7vHmRCj9J_cAOdzDmCchyKDQyolUogkbIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN04uMJ9woPlpMOCCE5nQrMO_Bxa3PmLYBLKJWWo3Bl3A&oe=6AC118B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFwVfk2HaBAQ7kNvwFEJBSq&_nc_oc=AdrclKKlAqxPxs9uWpOOsdg3yDf6kw-0rC3q4L_tMuGLt0mmtEPOx3p34S_2XeRXBm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4VDq_zYHeR_j5hvpiJnSx2mi8TB3uCHm1XABPOAgmiA&oe=6AC129E9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
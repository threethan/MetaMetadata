6214"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujAphlZXT9UQ7kNvwGvlCvJ&_nc_oc=AdrgQi1A_QtyXem6kceoUowxoU7h0BUhVaZSIFtS6i7NNah1hHGZRUi92olmchLoigM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDHjR8oFDmIuZVGF3kW3FJsbL_AwWDG1eODNF3ZUzi4w&oe=6A918E53"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4XSDrDp-7YQ7kNvwG-9axa&_nc_oc=AdrTH5MvAUO1nxiClL-yUWrwnAhmnsbtiRjZN7rvWdnVDE7Bzszw16g03g6L6_7iahM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7t9xuOVN2zAlaKg1S5Vtj6A_PwwznP30NfiG3TjuRMQ&oe=6A917709"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YgkLEkFz-YQ7kNvwEA_Dai&_nc_oc=Adq7PesOWSPtbViA5KX0FV5XMAO6sbFRBYYl3btdM3bn03Ypti-uDwzhvhra8QUtTxk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlDVlVcCbWWmG_Dh6-weyu1DGgIoFX6fAj3bXSISKzUg&oe=6A9168BA"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk16w_lAJuQQ7kNvwHv4G-K&_nc_oc=AdoP30JCwDE-yMego8Wid1Mac4oqXpTezxAvuXnpzCwdni5RmfpZkuhzl8PzMeXpWIQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrCnj0SLRYnHbkWJ-NkayOi9OlIWZlkgMwzhk2ybwl6g&oe=6A916A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvZTXQeX-LQQ7kNvwHMK5oW&_nc_oc=Ado5TM1qLZJEIAsfEyYIAU3QJGgBMHEvASNUHy9z8oH88OJ0DQETlwd8WbY0vHS6ZP8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnjReYp-8dEb2rZgJg9bc0GkJclDRmIoEhohk6kVAeiA&oe=6A917BA9"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
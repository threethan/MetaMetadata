4674D4"}, {"file_name": "GunJitsu_Screenshot_2.png", "id": "620338102668749", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982459_620338106002082_282661273207928436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rtOnNl9HsYQ7kNvwG_MLMb&_nc_oc=AdpL16L7knFRMozhrR9GMZpKv6ZySW684yrE2kfXRAeu9aIpioh7dZ5X2DjYCOsREPI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EnDq0g6jkX1Qnuwtw7Ul_4AuTr_4HeNMy2IQMnD2mCA&oe=6A4668D3"}, {"file_name": "GunJitsu_Screenshot_5.png", "id": "408220474212174", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974766_408220477545507_4507206763881336195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTdjxFjzWRMQ7kNvwESLULP&_nc_oc=AdqxG0-7l3MCYUhALvrEaDx0HlC8NZJkzguJM6ZFYXN7tVNUirRKtTPqyDC9N57kMV4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vGZQyKSIcV1-oYqtVjfEu1XEe8dOdCDGzdBlbTQ5uDA&oe=6A4689C9"}, {"file_name": "GunJitsu_Screenshot_4.png", "id": "385455932967464", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001673_385455936300797_7786371991393010935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60W2GFuDWvkQ7kNvwFJYJgX&_nc_oc=AdoWRpzBrOYWWPt6FJ51xgVQg_4U9OemKkfeje1HIdWUqofFHAl1qgUCjKafqcRPGGo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9htFj-uK3kP_6ouGtRLSOKH7HF9uHB9R1R-vmzFtREew&oe=6A467B7A"}, {"file_name": "GunJitsu_Screenshot_7.png", "id": "867514127465859", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974511_867514130799192_909843452170294806_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypnHi2x-bL8Q7kNvwHrI96d&_nc_oc=AdrGaFewCF0l73P17_H7Jao6kBFgvH6-6s1Y2bs0UvYHdwWvuCON2KDcOP4SIbMPlqU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WLSPfdjsweXpvThvgVf8puM6TOgWylOCrtqIBupyeRg&oe=6A467D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FluxBall Main Graphic 2.png", "id": "387248966427000", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39003280_387248969760333_3966639532335732948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAk6WdFQpFYQ7kNvwHIk4cW&_nc_oc=AdrBogMvTex-4Z2wVPLkr8MhQesueJaxk7pc3mjqfPQtaNvgb7h5vdMIWtuCiZtrrf8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ujd9QZeNTJ4l6vNqlCSTHeBxjxlsEtkNuyEuGhITR7Q&oe=6A468E69"}, "display_name": "Flux Ball", "keywords": [], "long_description": "Why stop with pivots and squats?  Flux Ball pressures the player to lie flat and tumble out of sticky situations, constantly moving between standing, crouching and prone positions.  Engage in a close quarters shoot out using your Guard Cage for protection from enemy fire.  When struck, your cage will be lowered into a liquid container, drowning those who fall too far down.  Flux Ball is best played on fitness mats and/or a rug.  Come test your Flux Ball skills...", "short_description": "You have a glove on your left hand and pistol in your right hand...Flux Ball is a competitive shooting game which requires players to dodge, squat and lie down to avoid enemy fire.  Flux Ball combines ground martial arts like Jiu Jitsu with VR sharp shooting.  Grab some fitness mats or your nearest rug and begin your journey to become the Flux Ball champion of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/fluxballprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment, LLC", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
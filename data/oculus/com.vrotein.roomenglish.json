le", "voicerecognition", "ttoring", "microworld"], "long_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. There is also the benefit of cognitive development through a story with a concept of deductive reasoning as well as logic, observational, analytical and the application of other skills. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality.", "short_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrotein.co.kr/", "developer_terms_of_service_url": "http://www.vrotein.co.kr/", "publisher_name": "VRotein", "support_website_url": null, "website_url": "http://www.vrotein.co.kr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "PUZZLE", "EXPLORATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devi
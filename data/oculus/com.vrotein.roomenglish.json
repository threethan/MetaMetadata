401152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv8ZnXimYlgQ7kNvwHo03Ko&_nc_oc=AdlJ3zu51azFk5Q0hPiVSj7oynX-u-7kVGOOO-2LUqDPQIIYJFC-EGs49HQnEpihgdY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv9YcriHO1O1HHnaZz_R2nHkm1InDiJbqlJpufJgT7tKg&oe=699B12BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TTORiNG Adventure:Mr. Breson's keepsake", "keywords": ["adventure", "puzzle", "voicerecognition", "ttoring", "microworld"], "long_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. There is also the benefit of cognitive development through a story with a concept of deductive reasoning as well as logic, observational, analytical and the application of other skills. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality.", "short_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrotein.co.kr/", "developer_terms_of_service_url": "http://www.vrotein.co.kr/", "publisher_name": "VRotein", "support_website_url": null, "website_url": "http://www.vrotein.co.kr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfo
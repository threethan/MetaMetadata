ant but the game mechanics are completely different. Instead of moving and rotating blocks, you have to shoot them off. During gameplay the blocks appears more frequent and drop faster. You have four weapons available on each side.Consecutive colors in a full row doubles the score. A row in a single color leads to maximum score.", "short_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot on dropping Pumpkin blocks in a way, so they complete a row."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jatrix.de/pumpkis", "developer_terms_of_service_url": null, "publisher_name": "Jatrix", "support_website_url": null, "website_url": "https://www.jatrix.de/pumpkis", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10092799050819056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304952_773959748393119_117381763028328585_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLAZRo-w3jEQ7kNvwEWXieT&_nc_oc=Adoh747agfQSyMFCOMBCxPJg3fLDGwnvqTSEcxQ_rdNs8Ukw8p7RBW0P-AlmeusZngo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaE6KqWYKM2CSWU3wy9VicoUpkRgyBAtSLS9Da_lnTSA&oe=6AFB29D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hellow
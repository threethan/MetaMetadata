_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIq2k4uuPLwQ7kNvwHXv0qX&_nc_oc=Adpm3YLA6P3yLNvMnceiTA6uNQ-g4eyPV5olfigNDgsY5gLweWSjmQ7E4UpNtlymOZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAePP8brmIdj-oF07AEvUl7J7J0zWBQcF_VVa04gw3Zsg&oe=6A621444"}, {"file_name": "PumpkisVR_5.png", "id": "1826787471207142", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_1826787474540475_4933140496761163703_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xk2VsC__y1sQ7kNvwHxV8z9&_nc_oc=AdqcKXBD-AP-u4u-BnsFkgEM7M7sPDtb_cP67n6XhVtW4IpH59dpo58H-V-hrkkQ-fw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIC5gMxRY-AaYClszvL6WsTVFVuGa0PU8KJFCT2OluLg&oe=6A6200B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Titelbild.png", "id": "1282768320172439", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_1282768323505772_2059712676535414414_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMdRZ5Z2XrYQ7kNvwFv_YNM&_nc_oc=AdoWi4qzwhJ-Cp8jeDMcFJ-QNe36-K1M2Q1GU7TRA_WMZqVQMQDHvoDxKgHhDPgDJYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPB8Mb7AE-hWYJO6_GKuAuFo_HPZPaRhwHL5AR_TMitw&oe=6A620638"}, "display_name": "Helloween Pumpkis", "keywords": ["Shooter", "Puzzle"], "long_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot off dropping Pumpkin blocks in a way, so they complete a row. It looks like a teris variant but the game mechanics are completely different. Instead of moving and rotating blocks, you have to shoot them off. During gameplay the blocks appears more frequent and drop faster. You have four weapons available on each side.Consecutive colors in a full row doubles the score. A row in a single color leads to maximum score.", "short_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot on dropping Pumpkin blocks in a way, so they complete a row."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jatrix.de/pumpkis", "d
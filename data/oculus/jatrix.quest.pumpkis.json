_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0Iptc0cf6wQ7kNvwGS7QBm&_nc_oc=AdpjQ3N25XsMs4zsEAb9woaeCKc_2qQHCuwUqJhMG4p8Ut5WhOJ7RFMiRG8gN3lkZPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WJG0khET-c0GUwi9S32z4IHi19EWg6fNm4ZQV5KljdQ&oe=69E8CA44"}, {"file_name": "PumpkisVR_5.png", "id": "1826787471207142", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_1826787474540475_4933140496761163703_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq67UtSv78YQ7kNvwHTxhx9&_nc_oc=AdoMHo6fhCbTPTr6wBOfO79IidZXkRWwOHFJZo-l084vqhMVB8tK1A8QJPwOC5SPdbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P-TQtSJDKTrOVPO7eeXCgMatDStYmgiQcDD3-t-eZXA&oe=69E8B6B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Titelbild.png", "id": "1282768320172439", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819980_1282768323505772_2059712676535414414_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Piw-sQv-DrAQ7kNvwFhlCj-&_nc_oc=AdrhGcqGgFWOeOzqyHJUzGWSZdta-qHHVGGwAMeI8v8i0DMVkDB8Zk0LPsabO5vzdns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pQIT8mwbwy0Tr-CQ7JAVR_Myb3fbbG_raVF7-FVsL9w&oe=69E8BC38"}, "display_name": "Helloween Pumpkis", "keywords": ["Shooter", "Puzzle"], "long_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot off dropping Pumpkin blocks in a way, so they complete a row. It looks like a teris variant but the game mechanics are completely different. Instead of moving and rotating blocks, you have to shoot them off. During gameplay the blocks appears more frequent and drop faster. You have four weapons available on each side.Consecutive colors in a full row doubles the score. A row in a single color leads to maximum score.", "short_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot on dropping Pumpkin blocks in a way, so they complete a row."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jatrix.de/pumpkis", "d
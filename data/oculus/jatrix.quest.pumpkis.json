ng", "id": "1437901950783421", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823485_1437901954116754_5646693919841166511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B78pX6guVO8Q7kNvwEKx7fL&_nc_oc=Adpbf4hYSbqvCrQm1DqQqwxsC1wfoiD2JnlVwIWSGVqXrHhVgUq1DPjA7Gp0nFM3O-s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhC86qn9w7Cy18OL2LKm6wL6eYo6wX2IeVsOcgUCx9mw&oe=6A85ACC4"}, {"file_name": "PumpkisVR_5.png", "id": "1826787471207142", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819980_1826787474540475_4933140496761163703_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJKFZzQkrTwQ7kNvwHVnOHi&_nc_oc=AdpFFEJ4p_DVKHk_wse3OWFCpr8mYk_g2Ok9blppCG3YP19Aqvhg1BW0ZAy__bp9Hlw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWfLNwlM5WQGkUgQliPCLXESB72mudZ9GDUYg7jXSGow&oe=6A859934"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Titelbild.png", "id": "1282768320172439", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819980_1282768323505772_2059712676535414414_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pkPmscCdoUQ7kNvwGERJgI&_nc_oc=Adp5wOJlza7a3JKSDswpCc0FGJ3vNc0pAbSojA4TOcwEEqFRXYjXhf2jX3fQAwV683w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6TmSzrkyHqExP6dph5xCUQtv4LEkOv-wyCrzeFXhl9g&oe=6A859EB8"}, "display_name": "Helloween Pumpkis", "keywords": ["Shooter", "Puzzle"], "long_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot off dropping Pumpkin blocks in a way, so they complete a row. It looks like a teris variant but the game mechanics are completely different. Instead of moving and rotating blocks, you have to shoot them off. During gameplay the blocks appears more frequent and drop faster. You have four weapons available on each side.Consecutive colors in a full row doubles the score. A row in a single color leads to maximum score.", "short_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot on dropping Pumpki
_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGSlwa_sbf8Q7kNvwGN0wvN&_nc_oc=AdralYUxu1eGKAAFGT3uiXzmzOkzDcZjelUvbL5vIKqMh2dIg2U1IP7vFFKIBQuwQ7s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OTtl2iLXm_41CrRojytyHTvV0RGemla_KRjEtub_IUg&oe=69EF61C4"}, {"file_name": "PumpkisVR_5.png", "id": "1826787471207142", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819980_1826787474540475_4933140496761163703_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRgfF3vO5o8Q7kNvwEVSC1w&_nc_oc=AdoP68l2IhtG0vEn8wxD_r4yWU8Rx8PeDMUkv6dM_zpxmmYoycO5wWNS6t7-GP58lLk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SCdtKYy5gU5PGc1TwvUZVW4qda3rDO45YthKe801iKA&oe=69EF4E34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Titelbild.png", "id": "1282768320172439", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819980_1282768323505772_2059712676535414414_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9-CkIwQYMgQ7kNvwEckGnj&_nc_oc=AdoLbGelEGuLSsi6-k7uwrtzYoBYeEehk-wHwojHw0vUUQX-wCDF_fuii4oQQccpHL8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Wqq_EgGfo7u-fKHlK_84EIDI8tBeWlj5SXZBcqmbTKQ&oe=69EF53B8"}, "display_name": "Helloween Pumpkis", "keywords": ["Shooter", "Puzzle"], "long_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot off dropping Pumpkin blocks in a way, so they complete a row. It looks like a teris variant but the game mechanics are completely different. Instead of moving and rotating blocks, you have to shoot them off. During gameplay the blocks appears more frequent and drop faster. You have four weapons available on each side.Consecutive colors in a full row doubles the score. A row in a single color leads to maximum score.", "short_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot on dropping Pumpkin blocks in a way, so they complete a row."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jatrix.de/pumpkis", "d
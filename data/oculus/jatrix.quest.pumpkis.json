7EFF8"}, "display_name": "Helloween Pumpkis", "keywords": ["Shooter", "Puzzle"], "long_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot off dropping Pumpkin blocks in a way, so they complete a row. It looks like a teris variant but the game mechanics are completely different. Instead of moving and rotating blocks, you have to shoot them off. During gameplay the blocks appears more frequent and drop faster. You have four weapons available on each side.Consecutive colors in a full row doubles the score. A row in a single color leads to maximum score.", "short_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot on dropping Pumpkin blocks in a way, so they complete a row."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jatrix.de/pumpkis", "developer_terms_of_service_url": null, "publisher_name": "Jatrix", "support_website_url": null, "website_url": "https://www.jatrix.de/pumpkis", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10092799050819056"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1627577077936151"}]}, "baseline_offer": {"id": "1627577077936151"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753722660, "status": "PUBLISHED", "id": "1627577077936151"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__t
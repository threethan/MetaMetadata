_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqhnrLsD2H0Q7kNvwGYSl3P&_nc_oc=AdoF7a-xG8YeBXvuTtwTfctCxPuBLHnAPDYpK4fX_aCycmE3Iui7gH8dqe3p8wDX3X0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlt698Gk2iqZ9ZSmGr9xR9QYwWWTRL14mjDkv0cQgD1A&oe=6A4E4DC4"}, {"file_name": "PumpkisVR_5.png", "id": "1826787471207142", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819980_1826787474540475_4933140496761163703_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ebhi4omrasEQ7kNvwGLnrWB&_nc_oc=Adoh1zJrSLV_h16BW6Crq_ZabJdhBhnFTvdSQH-bd5L1wZKPsfbh-X41i3ACiArUr7o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLh5ZIltJHlarXC8Rl3OCc-jXqTpWQw_84uWz_BtH41w&oe=6A4E3A34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Titelbild.png", "id": "1282768320172439", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819980_1282768323505772_2059712676535414414_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IH72OGo9xwQ7kNvwFXaocr&_nc_oc=Ado6OpSAFhOl3Dj1a9iIUiUI3g1IpSOVcDXqgqWsabMpw_2pWsktSXbgRKY0McnaKOs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgOY_EnIWwpALDObN4-XURF20t-3G9d8nztJkNYlU4Dw&oe=6A4E3FB8"}, "display_name": "Helloween Pumpkis", "keywords": ["Shooter", "Puzzle"], "long_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot off dropping Pumpkin blocks in a way, so they complete a row. It looks like a teris variant but the game mechanics are completely different. Instead of moving and rotating blocks, you have to shoot them off. During gameplay the blocks appears more frequent and drop faster. You have four weapons available on each side.Consecutive colors in a full row doubles the score. A row in a single color leads to maximum score.", "short_description": "Helloween Pumpkis is a fast puzzle shooter. Shoot on dropping Pumpkin blocks in a way, so they complete a row."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jatrix.de/pumpkis", "d
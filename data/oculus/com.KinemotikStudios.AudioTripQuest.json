file_name": "migrated_image.png", "id": "1389141664599467", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974814_1686980521432583_1760242842472546304_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G113eA_eqkYQ7kNvwG9DcHk&_nc_oc=AdmrYdHxjSsrb8qtxoJnPWff0MPOUYRcE1xvGoAWULLe8sTAUgFSCCLt0C5VfDDMOAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftMf-00wurERIcHOXfBoU9sgDvgVweqbl9K8KyQF1SQlA&oe=69A97505"}, {"file_name": "U9fq65.png", "id": "264496061263208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974454_264496064596541_1144932929860796416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDslwrbbpSkQ7kNvwHdXrgd&_nc_oc=AdlGzgA7dRp9deATSZesKmW0LRc6WOFZHM2ouWAj_80XMCHWfZkHe8MzUQ_zo_m3L4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsyPChKHbLr4yo06YzY5YR3H91d-5h4QNckHTMfX1fOiA&oe=69A9685B"}, {"file_name": "hzpAiw.png", "id": "645984319585548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86625136_645984322918881_7380021478420381696_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVpGZ06p_LgQ7kNvwGcu-1i&_nc_oc=Adm2hTx9_wK2Cz7MxpQzlVWTbL6JPojQ74YA_1-Qb3-9t_FF28fNNmmfriORILN-UJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwROHGpGscpXSYKNUwuc4D7y1dPjWbMUgDlPF0t79ePw&oe=69A97489"}, {"file_name": "GHYni9.png", "id": "1333858383670102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86624300_1333858387003435_7792963003174879232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjsF04exxLYQ7kNvwFiMl2A&_nc_oc=AdnPyMrFNIUkWUL0HTKz6uQelAeR_uhbOK2q44a8NsOK9sx9oZljmWJ-UShr8tc5ZiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsEqFMdQS7q-E2U8IgOFvL3eTJ508XlpECHcL8CRqLM_g&oe=69A96642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/oL1aLO", "id": "628657391198278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974442_628657394531611_8488709084780953600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmEbQXsbBdQQ7kNvwHn5U20&_nc_oc=AdmNqN-8rXy3ixTFdQnjrNRNCCmQjVyu7eBo5wUUqxmljUnLVB9EgpmRR_z73Yp0l8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftVziA594cSwR9vnjT0BH6MDPvDgVshVTtme-pmlu9qdQ&oe=69A96B96"}, "display_name": "Audio Trip", "keywords": ["dance", "rhythm", "music", "beat", "fitness"], "long_description": "Audio Trip is a VR dance game that takes players through surreal environments specially crafted for each song. Catch gems, ride ribbons, smash drums, and dodge barriers -- which together form exhilarating dance choreographed by a professional dancer.\nShow off your flair and make this YOUR audio trip!\nFeatures\n\u2022 Licensed music by top artists:\n - Skrillex, Zedd, deadmau5, Lady Gaga, and more.\n - 11 unique tracks available so far, with many more coming soon.\n\u2022 Three levels of difficulty for each track.\n\u2022 \u2018Full\u2019 or \u2018Short Trip\u2019 options for each song.\n\u2022 In-VR level editor (\u201cChoreographer\u201d tool) included.\n\u2022 Fully immersive dynamic environments for each song.\n\u2022 Intuitive UI - pick up and play.\n\u2022 Simple tutorial included for each first-time player.\n\u2022 Optional \u2018Comfort\u2019 mode for visually sensitive players.\n\u2022 Optional \u2018Dancer\u2019 mode to follow along with \u201cGoldie\u201d the dancer.\n\u2022 Optional \u2018No Fail\u2019 mode.\n\u2022 Optional \u2018Color swap\u2019 mode.\n\u2022 Much more content being continuously developed and added.", "short_description": "Audio Trip is a VR dance game. Players move their bodies to catch colored gems, ride ribbons, smash drums, and dodge barriers -- which together form exhilarating dance choreographed by a professional dancer."}]}, "developer_name": "Kinemotik Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.enterandromeda.com/legal/audio_trip.html", "publisher_name": "Andromeda Entertainment", "support_website_url": "http://audio.chat/", "website_url": "http://audiotripvr.com
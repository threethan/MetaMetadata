file_name": "migrated_image.png", "id": "1389141664599467", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974814_1686980521432583_1760242842472546304_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMPm6q_UaaAQ7kNvwGT0_MK&_nc_oc=AdoyT8_n2P4mDLB6UPY8GBM4hlkpe77A73Fy5vVabFPyGeG3f5lXei6yTRQjZyhroCE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiXNeaOdBU4sopNFw2dd0HXebQhkiqYGkAFqw7Xx1-kQ&oe=69C13005"}, {"file_name": "U9fq65.png", "id": "264496061263208", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974454_264496064596541_1144932929860796416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tRN4txsyNoQ7kNvwHgYE5Q&_nc_oc=Adq5ZRGqzuL7A_PChd5W6v5X0QG3IIL1sD_4sHds6Ujdw2fEc8mLgj290w_fSvljJDw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxahfTx5yMTM_mNh--T6XAvzSn_2xfV-C1xBuegtxeuw&oe=69C1235B"}, {"file_name": "hzpAiw.png", "id": "645984319585548", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86625136_645984322918881_7380021478420381696_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3V0ZOg8zzcwQ7kNvwGQc8nA&_nc_oc=Adp50JRnzbXbUkTF_5bfZcsX90gMGy6qqIzAXTZGM-lsXJpEgtL3t8kFUqliVh6ipi0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIctb9ewQxDzQTrUwHgyXHFTotdFyiCxT7ru7rTFdFtA&oe=69C12F89"}, {"file_name": "GHYni9.png", "id": "1333858383670102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86624300_1333858387003435_7792963003174879232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeCceMm3-fkQ7kNvwEy7sDo&_nc_oc=AdpT6Opy2mUlzWQkqt8mtyPyz95X8-W7qLruUdGejysSfMIrG1AWN7VtEClumZluyJU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwy7MvNGCnc9P-iR53k2XN9RpovD6T-bM9vl96-b10oSg&oe=69C12142"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/oL1aLO", "id": "628657391198278", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974442_628657394531611_8488709084780953600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1IwgFU03G0Q7kNvwGEPa3n&_nc_oc=AdrNj0SDRtCDLkhxeb_1bMZQZ9-c2BvB4L_aJx8mZDhprL23zP6SVuV_d8vRjmcq8kI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxkxfjrzm1Q5zqCXtoiNTY7LXpKlHYf8-x0OlNN7nKpzg&oe=69C12696"}, "display_name": "Audio Trip", "keywords": ["dance", "rhythm", "music", "beat", "fitness"], "long_description": "Audio Trip is a VR dance game that takes players through surreal environments specially crafted for each song. Catch gems, ride ribbons, smash drums, and dodge barriers -- which together form exhilarating dance choreographed by a professional dancer.\nShow off your flair and make this YOUR audio trip!\nFeatures\n\u2022 Licensed music by top artists:\n - Skrillex, Zedd, deadmau5, Lady Gaga, and more.\n - 11 unique tracks available so far, with many more coming soon.\n\u2022 Three levels of difficulty for each track.\n\u2022 \u2018Full\u2019 or \u2018Short Trip\u2019 options for each song.\n\u2022 In-VR level editor (\u201cChoreographer\u201d tool) included.\n\u2022 Fully immersive dynamic environments for each song.\n\u2022 Intuitive UI - pick up and play.\n\u2022 Simple tutorial included for each first-time player.\n\u2022 Optional \u2018Comfort\u2019 mode for visually sensitive players.\n\u2022 Optional \u2018Dancer\u2019 mode to follow along with \u201cGoldie\u201d the dancer.\n\u2022 Optional \u2018No Fail\u2019 mode.\n\u2022 Optional \u2018Color swap\u2019 mode.\n\u2022 Much more content being continuously developed and added.", "short_description": "Audio Trip is a VR dance game. Players move their bodies to catch colored gems, ride ribbons, smash drums, and dodge barriers -- which together form exhilarating dance choreographed by a professional dancer."}]}, "developer_name": "Kinemotik Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.enterandromeda.com/legal/audio_trip.html", "publisher_name": "Andromeda Entertainment", "support_website_url": "http://audio.chat/", "website_url": "http://audiotripvr.com
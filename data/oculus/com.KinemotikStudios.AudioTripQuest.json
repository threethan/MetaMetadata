file_name": "migrated_image.png", "id": "1389141664599467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974814_1686980521432583_1760242842472546304_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlAJyGIx4joQ7kNvwFPUq2u&_nc_oc=AdkOSyFR78QbL44kCglDAYH2-ajj4ofMGWkdwJTk99-7ZWsP5YFnbTe1gw3E-9F1jZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvjfLllkDc5bHyY3_8mhmFL7drLaZh-rCT13MnAr1xFLg&oe=69A82385"}, {"file_name": "U9fq65.png", "id": "264496061263208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974454_264496064596541_1144932929860796416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDslwrbbpSkQ7kNvwF0j6gI&_nc_oc=AdnIlGqY7LAKMAM2Wx8Zgfp65Dkk08DYvvPWJ63T-3S2ZB0K5aZig1x-ZYTIG8CGesc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuBUoAngYOkwWqA3IMvdW8KSdNCa_OJwwOSscQCWmBMZw&oe=69A816DB"}, {"file_name": "hzpAiw.png", "id": "645984319585548", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625136_645984322918881_7380021478420381696_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVpGZ06p_LgQ7kNvwFgPE86&_nc_oc=AdnlwUAIok2xO6sY5CItDI9N35dvFmOqmZpV20Crw2VTYFElcMaWLucgMa_UrtWQg3M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-rnzt3mnIhRARocd2aX_3rgTC48NowhYskPXRAUUJVQ&oe=69A82309"}, {"file_name": "GHYni9.png", "id": "1333858383670102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86624300_1333858387003435_7792963003174879232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjvtS8bzxxMQ7kNvwEXMjj-&_nc_oc=AdlebpD_dkdWnbfXgeEGvR4TnYwrjM2iB8R1M9gL0YG90w4ZDWmdYtdK7s608-uA-cA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv_cs7WR7cy6ZQasYkAKCgmtjrjSihZrN7v3tc6es8GOQ&oe=69A814C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/oL1aLO", "id": "628657391198278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974442_628657394531611_8488709084780953600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPtQH4YDBpEQ7kNvwFF4bQx&_nc_oc=AdlP3a5yj54UVeRku-pQpXtRPyj6HNr0JKDnrfPZgBIiocvQTkYv4-3YH1t6zQjuMsk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftltlIs-KBAv0T9lY9PcUcnANTQl_8SxDN_SE6erXHGmg&oe=69A81A16"}, "display_name": "Audio Trip", "keywords": ["dance", "rhythm", "music", "beat", "fitness"], "long_description": "Audio Trip is a VR dance game that takes players through surreal environments specially crafted for each song. Catch gems, ride ribbons, smash drums, and dodge barriers -- which together form exhilarating dance choreographed by a professional dancer.\nShow off your flair and make this YOUR audio trip!\nFeatures\n\u2022 Licensed music by top artists:\n - Skrillex, Zedd, deadmau5, Lady Gaga, and more.\n - 11 unique tracks available so far, with many more coming soon.\n\u2022 Three levels of difficulty for each track.\n\u2022 \u2018Full\u2019 or \u2018Short Trip\u2019 options for each song.\n\u2022 In-VR level editor (\u201cChoreographer\u201d tool) included.\n\u2022 Fully immersive dynamic environments for each song.\n\u2022 Intuitive UI - pick up and play.\n\u2022 Simple tutorial included for each first-time player.\n\u2022 Optional \u2018Comfort\u2019 mode for visually sensitive players.\n\u2022 Optional \u2018Dancer\u2019 mode to follow along with \u201cGoldie\u201d the dancer.\n\u2022 Optional \u2018No Fail\u2019 mode.\n\u2022 Optional \u2018Color swap\u2019 mode.\n\u2022 Much more content being continuously developed and added.", "short_description": "Audio Trip is a VR dance game. Players move their bodies to catch colored gems, ride ribbons, smash drums, and dodge barriers -- which together form exhilarating dance choreographed by a professional dancer."}]}, "developer_name": "Kinemotik Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.enterandromeda.com/legal/audio_trip.html", "publisher_name": "Andromeda Entertainment", "support_website_url": "http://audio.chat/", "website_url": "http://audiotripvr.com
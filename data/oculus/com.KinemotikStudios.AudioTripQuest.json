-1.oculuscdn.com/v/t64.5771-25/38974814_1686980521432583_1760242842472546304_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJIjzp80X3cQ7kNvwFpSsxh&_nc_oc=AdrWD8R_AZjEeDjCTqwapvAGJFTaPCfVEqMUa2eemdw6PcepqLgY_0IfZDWgzrz2gm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af648hMz7qbZsPsucQWulg-mhPYicbxvUFa3RqJm6SrPUg&oe=6A201C05"}, {"file_name": "U9fq65.png", "id": "264496061263208", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974454_264496064596541_1144932929860796416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yi9j8CQ-g5IQ7kNvwGJT14w&_nc_oc=AdrDBL5iRlv-8Gou9UbTS77-_OWFbnTQvgvpd9ruMw1PrfNUbCcRHAZdUrdWPY_sjmY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xqr_PXtQYwrSt6iR5BBPop9f2R29igHTN8LgGZkbqGg&oe=6A20479B"}, {"file_name": "hzpAiw.png", "id": "645984319585548", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86625136_645984322918881_7380021478420381696_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO5voltCx3UQ7kNvwFAjggv&_nc_oc=AdoJu4y-ZJeCUOroyh5rG2bayOvsaGsQrMsh_D53x8YcDPfXRp1u30fUAlmifHka0G0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40G5HoSQNL_AIV768yoNzwoA53SPI8PwlO-WOimY3RMA&oe=6A201B89"}, {"file_name": "GHYni9.png", "id": "1333858383670102", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86624300_1333858387003435_7792963003174879232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h7mTUSTpDQQ7kNvwH2nOHx&_nc_oc=AdoNg0vuGJXGC_kvqYrH5cbLWxfnm8DHL4tLKpC4k21R7bWdG8bV5se67t1AyviraDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yyNdnJmsQqAEw3HBD2OBa_pr8s0pBk96PpzRJsjJ0Ag&oe=6A204582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/oL1aLO", "id": "628657391198278", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974442_628657394531611_8488709084780953600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-jsJ4tYh4EQ7kNvwEah6GB&_nc_oc=AdrW1wnmek-vwkdK7JiDud4pzoyMZvdRMPTWc7k12I6_dyt5dl563eWP4W68Xh6ilKM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43FDu4wEvT1lAHUVjB6fWas5vASYvfve-ke2xq8iiYxw&oe=6A204AD6"}, "display_name": "Audio Trip", "keywords": ["dance", "rhythm", "music", "beat", "fitness"], "long_description": "Audio Trip is a VR dance game that takes players through surreal environments specially crafted for each song. Catch gems, ride ribbons, smash drums, and dodge barriers -- which together form exhilarating dance choreographed by a professional dancer.\nShow off your flair and make this YOUR audio trip!\nFeatures\n\u2022 Licensed music by top artists:\n - Skrillex, Zedd, deadmau5, Lady Gaga, and more.\n - 11 unique tracks available so far, with many more coming soon.\n\u2022 Three levels of difficulty for each track.\n\u2022 \u2018Full\u2019 or \u2018Short Trip\u2019 options for each song.\n\u2022 In-VR level editor (\u201cChoreographer\u201d tool) included.\n\u2022 Fully immersive dynamic environments for each song.\n\u2022 Intuitive UI - pick up and play.\n\u2022 Simple tutorial included for each first-time player.\n\u2022 Optional \u2018Comfort\u2019 mode for visually sensitive players.\n\u2022 Optional \u2018Dancer\u2019 mode to follow along with \u201cGoldie\u201d the dancer.\n\u2022 Optional \u2018No Fail\u2019 mode.\n\u2022 Optional \u2018Color swap\u2019 mode.\n\u2022 Much more content being continuously developed and added.", "short_description": "Audio Trip is a VR dance game. Players move their bodies to catch colored gems, ride ribbons, smash drums, and dodge barriers -- which together form exhilarating dance choreographed by a professional dancer."}]}, "developer_name": "Kinemotik Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.enterandromeda.com/legal/audio_trip.html", "publisher_name": "Andromeda Entertainment", "support_website_url": "http://audio.chat/", "website_url": "http://audiotripvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "c
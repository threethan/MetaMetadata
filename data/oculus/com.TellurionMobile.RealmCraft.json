es": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "New Mechanic: Trading\nNew Mobs: Bee, Cat\nBlock Functionality Update: Beehives and Bee Nests are now fully usable\nVarious Bug Fixes and Optimizations\nFeature Request Board: Join Our Canny to Leave Feedback\nDiscord Server: Join Our Discord to Chat, Share Feedback, and Help Shape the Game\u2019s Future\nYouTube Channel: Check Out Our YouTube Channel for Tutorials and Update Videos\nAll Links Can Be Found on Our Website!\n", "created_date": 1783074321, "id": "27608297795458699", "version": "1.0.2", "version_code": 102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27608297795458699"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": null, "created_date": 1780646943, "id": "27271255655829583", "version": "1.0.1", "version_code": 101, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27608297795458699"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "New Mechanic: Enchanting\nDamage System Update: Weapons and tools now display attack speed and damage stats; damage now scales with attack cooldown\nControls Update: Double tap backward on the main hand joystick \u2013 180\u00b0 turn; pressing B on the ground \u2013 Sneaking\nSpawn Update: Players now spawn randomly within the starting chunk instead of a fixed point. Bed respawn safety checks have been improved, with fallback to the world\u2019s default spawn if no safe location or air blocks are found\nNew Mob: Iron Golem\nNew Block: Bell\nBlock Functionality Update: Sign, Item Frame, and Composter are now interactive\nWorlds Mode Update: New worlds added to the Editor\u2019s Choice tab\nZombie Behavior Update: 10% chance for Zombies and Drowned to break wooden doors on Hard difficulty\nMob Walk Animation Update: Walk animations for mobs now match movement speed for smoother and more accurate motion\nNew Particles: Smoker, Furnace, and Blast Furnace now emit particles while actively working\nDeath Screen Update: Coordinates of the death point are now shown on the death screen\nUI Update: Block and Item names are now displayed when hovering over them\nVarious Bug Fixes and Optimizations\nFeature Request Board: Join Our Canny to Leave Feedback\nDiscord Server: Join Our Discord to Chat, Share Feedback, and Help Shape the Game\u2019s Future\nYouTube Channel: Check Out Our YouTube Channel for Tutorials and Update Videos\nAll Links Can Be Found on Our Website!\n", "created_date": 1779292990, "id": "27073039845651166", "version": "1.0.1", "version_code": 100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27608297795458699"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "New Mechanic: Enchanting\nDamage System Update: Weapons and tools now display attack speed and damage stats; damage now scales with attack cooldown\nControls Update: Double tap backward on the main hand joystick \u2013 180\u00b0 turn; pressing B on the ground \u2013 Sneaking\nSpawn Update: Players now spawn randomly within the starting chunk instead of a fixed point. Bed respawn safety checks have been improved, with fallback to the world\u2019s default spawn if no safe location or air blocks are found\nNew Mob: Iron Golem\nNew Block: Bell\nBlock Functionality Update: Sign, Item Frame, and Composter are now interactive\nWorlds Mode Update: New worlds added to the Editor\u2019s Choice tab\nZombie Behavior Update: 10% chance for Zombies and Drowned to break wooden doors on Hard difficulty\nMob Walk Animation Update: Walk animations for mobs now match movement speed for smoother and more accurate motion\nNew Particles: Smoker, Furnace, and Blast Furnace now emit particles while actively working\nDeath Screen Update: Coordinates of the death point are now shown on the death screen\nUI Update: Block and Item names are now displayed when hovering over them\nVarious Bug Fixes and Optimizations\nFeature Request Board: Join Our Canny to Leave Feedback\nDiscord Server: Join Our Discord to Chat, Share Feedback, and Help Shape the Game\u2019s Future\nYouTube Channel: Check Out Our YouTube Channel for Tutorials and Update Videos\nAll Links Can Be Found on Our Website!\n", "created_date": 1779272692, "id": "27069911489297335", "version": "1.0.1", "version_code": 99, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27608297795458699"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "Update 1.0.0\n\n\nNew Mob: Villager\nNew Feature: World Sharing\nHotbar Update: Switch Items by Pressing Grips\nNew Items: Turtle Scute, Turtle Shell\nInventory Fix: Inventory Now Opens On The Last Used Tab; Armor Menu Is Default Instead Of Crafting Grid\nNew Structure: Woodland Mansion\nParrot Update: Taming Added\nLlama Update: Taming and Riding Added\nCreeper Update: Creepers Can Now Be Ignited with Flint and Steel to Explode\nNew Mechanic: Players and Mobs Burn When Taking Damage from Burning Zombie or Drowned\nNew Particle and Sound Effect: Water Splash (appears when entering water or dropping items into it)\nNew Settings: Block/Entity Outline Toggle; Delay Before Breaking Blocks\nStatus Effects: Poison (affects parrots that ate cookies); Water Breathing (granted by Turtle Shell)\nLead Update: Mobs Can Now Be Physically Pulled While on a Lead\nMobs Optimization: Pathfinding Improvements \u2013 mobs now calculate paths dynamically and move smoothly without unnecessary stops\nVarious Bug Fixes and Optimizations\nFeature Request Board: Join Our Canny to Leave Feedback\nDiscord Server: Join Our Discord to Chat, Share Feedback, and Help Shape the Game\u2019s Future\nYouTube Channel: Check Out Our YouTube Channel for Tutorials and Update Videos\nAll Links Can Be Found on Our Website!", "created_date": 1775463334, "id": "26564371069851382", "version": "1.0.0", "version_code": 98, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
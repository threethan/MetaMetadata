tion_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "445339520296302"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "2379655379229387"}, {"status": "PUBLISHED", "id": "1670590321345908"}, {"status": "PUBLISHED", "id": "1733624247657111"}, {"status": "PUBLISHED", "id": "2164796360728718"}, {"status": "PUBLISHED", "id": "1438453240888961"}, {"status": "PUBLISHED", "id": "1193178236076500"}, {"status": "PUBLISHED", "id": "2877225242618967"}, {"status": "PUBLISHED", "id": "25789923894040831"}, {"status": "PUBLISHED", "id": "2352863898475520"}, {"status": "PUBLISHED", "id": "2130835881100534"}, {"status": "PUBLISHED", "id": "879512731613508"}, {"status": "PUBLISHED", "id": "3390987241066452"}, {"status": "PUBLISHED", "id": "1861743987801719"}, {"status": "PUBLISHED", "id": "1838252923484108"}, {"status": "PUBLISHED", "id": "775474763918746"}]}, "baseline_offer": {"id": "879512731613508"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2379655379229387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28153651327590007", "version": "1.0.3"}, "id": "757817938556737", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28153651327590007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "New Mobs: Piglin Brute, Zoglin, Zombified Piglin\nNether Mobs Behavior Update: Added full AI behavioral logic for Piglin, Piglin Brute, Baby Piglin, Hoglin, and Baby Hoglin (gold reactions, Hoglin hunting, bartering, etc.)\nController Mapping: Added the ability to customize movement and interaction hands and remap controller buttons \nMob Damage Decals: Localized damage decals are now applied to mob models at the point of impact\nShield Update: Blocking an axe attack now disables your shield for 5 seconds\nNew Sounds: Randomized audio for flowing water and lava, and a new sound effect when water and lava collide\nNew Particles: The collision between water and lava now creates particle effects\nVarious Bug Fixes and Optimizations\nFeature Request Board: Join Our Canny to Leave Feedback\nDiscord Server: Join Our Discord to Chat, Share Feedback, and Help Shape the Game\u2019s Future\nYouTube Channel: Check Out Our YouTube Channel for Tutorials and Update Videos\nAll Links Can Be Found on Our Website!\n", "created_date": 1787156344, "id": "28153651327590007", "version": "1.0.3", "version_code": 103, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28153651327590007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "New Mechanic: Trading\nNew Mobs: Bee, Cat\nBlock Functionality Update: Beehives and Bee Nests are now fully usable\nVarious Bug Fixes and Optimizations\nFeature Request Board: Join Our Canny to Leave Feedback\nDiscord Server: Join Our Discord to Chat, Share Feedback, and Help Shape the Game\u2019s Future\nYouTube Channel: Check Out Our YouTube Channel for Tutorials and Update Videos\nAll Links Can Be Found on Our Website!\n", "created_date": 1783074321, "id": "27608297795458699", "version": "1.0.2", "version_code": 102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28153651327590007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": null, "created_date": 1780646943, "id": "27271255655829583", "version": "1.0.1", "version_code": 101, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28153651327590007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "New Mechanic: Enchanting\nDamage System Update: Weapons and tools now display attack speed and damage stats; damage now scales with attack cooldown\nControls Update: Double tap backward on the main hand joystick \u2013 180\u00b0 turn; pressing B on the ground \u2013 Sneaking\nSpawn Update: Players now spawn randomly within the starting chunk instead of a fixed point. Bed respawn safety checks have been improved, with fallback to the world\u2019s default spawn if no safe location or air blocks are found\nNew Mob: Iron Golem\nNew Block: Bell\nBlock Functionality Update: Sign, Item Frame, and Composter are now interactive\nWorlds Mode Update: New worlds added to the Editor\u2019s Choice tab\nZombie Behavior Update: 10% chance for Zombies and Drowned to break wooden doors on Hard difficulty\nMob Walk Animation Update: Walk animations for mobs now match movement speed for smoother and more accurate motion\nNew Particles: Smoker, Furnace, and Blast Furnace now emit particles while actively working\nDeath Screen Update: Coordinates of the death point are now shown on the death screen\nUI Update: Block and Item names are now displayed when hovering over them\nVarious Bug Fixes and Optimizations\nFeature Request Board: Join Our Canny to Leave Feedback\nDiscord Server: Join Our Discord to Chat, Share Feedback, and Help Shape the Game\u2019s Future\nYouTube Channel: Check Out Our YouTube Channel for Tutorials and Update Videos\nAll Links Can Be Found on Our Website!\n", "created_date": 1779292990, "id": "27073039845651166", "version": "1.0.1", "version_code": 100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28153651327590007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "New Mechanic: Enchanting\nDamage System Update: Weapons and tools now display 
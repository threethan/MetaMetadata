ation": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29248669531421509"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "New Mobs: Horse and Zombie Horse (including riding), Frog, Tadpole\nRagdoll Physics: Added ragdoll physics for mob damage and death animations\nNew Blocks: Froglight, Frogspawn\nMob Models Update: Updated 3D models for Hoglin, Zoglin and Polar Bear\nMain Menu Update: Added 360\u00b0 world cubemaps for background\nVarious Bug Fixes and Optimizations\nFeature Request Board: Join Our Canny to Leave Feedback\nDiscord Server: Join Our Discord to Chat, Share Feedback, and Help Shape the Game\u2019s Future\nYouTube Channel: Check Out Our YouTube Channel for Tutorials and Update Videos\nAll Links Can Be Found on Our Website!\n", "created_date": 1790319066, "id": "28637265799228555", "version": "1.0.4", "version_code": 104, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5355683574480106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29248669531421509"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "757817938556737"}]}, "change_log": "New Mobs: Piglin Brute, Zoglin, Zombified Piglin\nNether Mobs Behavior Update: Added full AI behavioral logic for Piglin, Piglin Brute, Baby Piglin, Hoglin, and Baby Hoglin (gold reactions, Hoglin hunting, bartering, etc.)\nController Mapping: Added the ability to customize movement and interaction hands and remap controller buttons \nMob Damage Decals: Localized damage decals are now applied to mob models at the point of impact\nShield Update: Blocking an axe attack now disables your shield for 5 seconds\nNew Sounds: Randomized audio for flowing water and lava, and a new sound effect when water and lava collide\nNew Particles: The collision between water and lava now creates particle effects\nVarious Bug Fixes and Optimizations\nFeature Request Board: Join Our Canny to Leave Feedback\nDiscord Server: Join Our Discord to Chat, Share Feedback, and Help Shape the Game\u2019s Future\nYouTube Channel: Check Out Our YouTube Channel for Tutorials and Update Videos\nAll Links Can Be Found on Our Website!\n", "created_date": 1787156344, "id": "28153651327590007", "version": "1.0.3", "version_code": 103, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
47555522721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvBXuSUe94cQ7kNvwGdqsTh&_nc_oc=Adp7f2gJStBQGa8QOWXlwySsvUM36UpAmBSCcBvBNlanXHYdwgExtMuGCIiSB_bK4TA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1jVbkOhwjW4_vmRBCO_tRMIDbJETMPGRdtF1KOZ7A9nw&oe=69F0CCE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pixel Blocks", "keywords": [], "long_description": "Pixel Blocks revolutionizes VR gaming by combining **intuitive voxel creation** with **seamless multiplayer collaboration**.\n\n### Core Features\n\n- **Infinite Worlds**: Explore and build in massively scalable environments\n- **Real-Time Collaboration**: Build with friends instantly with zero lag\n- **GPU-Accelerated Rendering**: Thousands of blocks without performance issues\n- **Advanced Networking**: Instant synchronization across all players\n- **Built-In Voice Chat**: Immersive team communication without breaking immersion\n\n### Perfect For\n\n- Creative gamers and artists\n- Educators and students\n- Social communities and friend groups\n- Content creators and streamers\n\nPixelBlock transforms VR into a canvas for collaborative creativity.", "short_description": "Pixel Blocks is a collaborative VR voxel-building game where players create and explore shared worlds together in real-time. Use natural hand gestures to place and paint colorful blocks, build massive structures, and collaborate with friends instantly. Featuring cross-platform multiplayer, voice chat, optimized performance, and infinite scalability. Create, collaborate, and inspire on Meta Quest and compatible VR platforms."}]}, "developer_name": "adruian", "developer_privacy_policy_url": "https://gamewaer.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "adruian", "support_website_url": null, "website_url": "https://gamewaer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "34661662150143845"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820387_2028312791049471_6628848212747651775_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhovxYmEwuoQ7kNvwH6hAa_&_nc_oc=AdrPTIbLavd2W9-2EglKhNEAfE3o0d0u71mc8Dsp9qqKvdNJXNnHcRBy44hp4tL7Nd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0m2M7uXlb_1EvmXzjSD_nXkfEKixM-dsTgR5BkzNQxtQ&oe=69F09DA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pixel Blocks", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "World Creation", "id": "1725996564472128"}], "release_date": 1775479800, "lastRevision": {"nodes": [{"id": "31855844107392344", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "31855843994059022", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2997555327278360"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "square_1440x1440.png", "id": "3168158190022497", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/49
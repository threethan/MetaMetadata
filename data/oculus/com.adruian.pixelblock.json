DF3"}, {"file_name": "screenshot_top_down.png", "id": "1269303601760804", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818849_1269303605094137_1015573592450515248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z77IRxMVpFEQ7kNvwGVFEJJ&_nc_oc=AdqKOOfyKvi3lL9HEcenlexgmssuptMqAncYRGThfTiGOq4r7AOhm1Nh4TeSWPr75U4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Z1CYzsSXy9sQdPD19pR2k6fWqPTGak1F_4RR2EW831Q&oe=69F8B0F4"}, {"file_name": "screenshot_iso_front_right.png", "id": "919567493771698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820855_919567507105030_6525959090118648550_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO8og6ieU8AQ7kNvwF5ft-J&_nc_oc=AdrnkLRyeWomGIAri9oY92WgolGTsv0E_SiZQ-SiiLEFVhm2Wqv0IbXmIj6i1IgwJGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bp5-uXLp00_OonRtfzA6ylDLmAhSAMgYG7NQqbJ0G0g&oe=69F8BC2F"}, {"file_name": "screenshot_front_elevation.png", "id": "898712499715357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818852_898712503048690_6138052247687145195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkZGqtoTBugQ7kNvwFNqrih&_nc_oc=AdqSR2UhAnYhl9QD_GsGCjTUl2rr2Idmn3HHGFyn7EwhzwehKyD0XByA95B_Bdb3CpY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31_dsQSilzaP2-sQhv6C17KXSopg6tX1mSV9gs0K073A&oe=69F8B6CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pixel Blocks", "keywords": [], "long_description": "Pixel Blocks revolutionizes VR gaming by combining **intuitive voxel creation** with **seamless multiplayer collaboration**.\n\n### Core Features\n\n- **Infinite Worlds**: Explore and build in massively scalable environments\n- **Real-Time Collaboration**: Build with friends instantly with zero lag\n- **GPU-Accelerated Rendering**: Thousands of blocks without performance issues\n- **Advanced Networking**: Instant synchronization across all players\n- **Built-In Voice Chat**: Immersive team communication without breaking immersion\n\n### Perfect For\n\n- Creative gamers and artists\n- Educators and students\n- Social communities and friend groups\n- Content creators and streamers\n\nPixelBlock transforms VR into a canvas for collaborative creativity.", "short_description": "Pixel Blocks is a collaborative VR voxel-building game where players create and explore shared worlds together in real-time. Use natural hand gestures to place and paint colorful blocks, build massive structures, and collaborate with friends instantly. Featuring cross-platform multiplayer, voice chat, optimized performance, and infinite scalability. Create, collaborate, and inspire on Meta Quest and compatible VR platforms."}]}, "developer_name": "adruian", "developer_privacy_policy_url": "https://gamewaer.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "adruian", "support_website_url": null, "website_url": "https://gamewaer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "34644458761864184"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1955230265361503"}]}, "baseline_offer": {"id": "1955230265361503"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775479800, "status": "PUBLISHED", "id": "1955230265361503"}]}, "liveChannel": {"nodes": [{"latest_supported_bi
n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j_n6TdK2zwQ7kNvwHbVnX0&_nc_oc=AdqkXsIcThJdiSalsqQaSV-1W64bIs20F-L0cKbcTIV3n6mvRq43lLHpr0EkfEAcVoI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YiNavvPpbROa5ryNNcK7-Bb4-WwNgjMMTo4gXTZvEvg&oe=6A4684AF"}, {"file_name": "screenshot_front_elevation.png", "id": "898712499715357", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491818852_898712503048690_6138052247687145195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bR0gTINOh0Q7kNvwFXxk2z&_nc_oc=AdpHzb74WxG_umPC_g25JK86ynF2Gi6hXqA9Q_wnEGlANxdYmXM0YeTLT9S3zg1et6Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WMTyuogYN-XVJNlDsB-2vki_K7K55T_jTNsDGwrTqKw&oe=6A467F4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pixel Blocks", "keywords": [], "long_description": "Pixel Blocks revolutionizes VR gaming by combining **intuitive voxel creation** with **seamless multiplayer collaboration**.\n\n### Core Features\n\n- **Infinite Worlds**: Explore and build in massively scalable environments\n- **Real-Time Collaboration**: Build with friends instantly with zero lag\n- **GPU-Accelerated Rendering**: Thousands of blocks without performance issues\n- **Advanced Networking**: Instant synchronization across all players\n- **Built-In Voice Chat**: Immersive team communication without breaking immersion\n\n### Perfect For\n\n- Creative gamers and artists\n- Educators and students\n- Social communities and friend groups\n- Content creators and streamers\n\nPixelBlock transforms VR into a canvas for collaborative creativity.", "short_description": "Pixel Blocks is a collaborative VR voxel-building game where players create and explore shared worlds together in real-time. Use natural hand gestures to place and paint colorful blocks, build massive structures, and collaborate with friends instantly. Featuring cross-platform multiplayer, voice chat, optimized performance, and infinite scalability. Create, collaborate, and inspire on Meta Quest and compatible VR platforms."}]}, "developer_name": "adruian", "developer_privacy_policy_url": "https://gamewaer.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "adruian", "support_website_url": null, "website_url": "https://gamewaer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "34644458761864184"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1955230265361503"}]}, "baseline_offer": {"id": "1955230265361503"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775479800, "status": "PUBLISHED", "id": "1955230265361503"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34582012598108801", "version": "0.1.1"}, "id": "836857432617999", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "31855843994059022", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34582012598108801"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "836857432617999"}]}, "change_log": nu
.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y74KF4ETY8AQ7kNvwFeAXjm&_nc_oc=AdrarAMXFHyugreI8A59v2H4ajclxhT8AyE_4jiFCNH4YoHPVSpyAcRoP2wkSh8AsiY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0OJLDLrTUj5kZ7Q2a3jwIL7zdYikyrTMoT6a4vEkHiA&oe=6AFB16F4"}, {"file_name": "screenshot_iso_front_right.png", "id": "919567493771698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820855_919567507105030_6525959090118648550_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg6PMiKiu1kQ7kNvwHwiKG_&_nc_oc=AdqPDLTYGCFfgoBIesvGunLI6TsnAVvff_--csODLFzm6BtuSremnPnhzQpvLVt-z2k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWkq2AS4crq_WBQ2nbRJHWzAerP54K78g3ui9B5rH6Og&oe=6AFB222F"}, {"file_name": "screenshot_front_elevation.png", "id": "898712499715357", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818852_898712503048690_6138052247687145195_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYATIwHT1dsQ7kNvwHuDOea&_nc_oc=AdosebHkW1EnYUFZuGWE51TnDLxcRy_ksM0haQkjGBeamsyDu-rTPOfwDAVJzr0uHKk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-l070rj90Wwei5z-psTfopUrs8aqjHwwx_jW1kE_luA&oe=6AFB1CCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pixel Blocks", "keywords": [], "long_description": "Pixel Blocks revolutionizes VR gaming by combining **intuitive voxel creation** with **seamless multiplayer collaboration**.\n\n### Core Features\n\n- **Infinite Worlds**: Explore and build in massively scalable environments\n- **Real-Time Collaboration**: Build with friends instantly with zero lag\n- **GPU-Accelerated Rendering**: Thousands of blocks without performance issues\n- **Advanced Networking**: Instant synchronization across all players\n- **Built-In Voice Chat**: Immersive team communication without breaking immersion\n\n### Perfect For\n\n- Creative gamers and artists\n- Educators and students\n- Social communities and friend groups\n- Content creators and streamers\n\nPixelBlock transforms VR into a canvas for collaborative creativity.", "short_description": "Pixel Blocks is a collaborative VR voxel-building game where players create and explore shared worlds together in real-time. Use natural hand gestures to place and paint colorful blocks, build massive structures, and collaborate with friends instantly. Featuring cross-platform multiplayer, voice chat, optimized performance, and infinite scalability. Create, collaborate, and inspire on Meta Quest and compatible VR platforms."}]}, "developer_name": "adruian", "developer_privacy_policy_url": "https://gamewaer.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "adruian", "support_website_url": null, "website_url": "https://gamewaer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "34644458761864184"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34582012598108801", "version": "0.1.1"}, "id": "836857432617999", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__type
ng?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-ModyNljyQQ7kNvwEwc-Km&_nc_oc=AdoZO_CQyvUex-ZuTKxUUGqMbysUEkfvUsTyEaoFJ_nzkbyjqW8xr3mxeEe92Rdk3A0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbW-pGxrTOnXUJdmOSyYFiNO-9aJkxY1itCLsR0uCdgQ&oe=6AA947D7"}, {"file_name": "vr1-sc3.png", "id": "1610705933245233", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823271_1610705936578566_1938565319623941586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA92yO6VwxcQ7kNvwF9fM-d&_nc_oc=AdqhrVuxi0Iu5ZTmZoweI4CaWPdCj7-IOUzzztjhKWKDfftgRYQs9OOKyHir9Zdbt7E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFtAIS2oK8N6IitG6yZ5sbLwg9XprBcTPzKlJ70eDsRQ&oe=6AA961D8"}, {"file_name": "vr1-sc5.png", "id": "2064503600974247", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491824303_2064503607640913_6435331218694842426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_1l8yXBa40Q7kNvwHvnw66&_nc_oc=AdqkshXVKVnIomipIDi4WGyqNvRJDpfPbI-zY8g57YIt76erBRTa--j5RLfsg6Mqsg4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSZe_aEK3vp6c9yizEycj_F3w0r9zEkJa1dp4ADLzEAg&oe=6AA94BA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR: Vacate the Room (Escape Room)", "keywords": [], "long_description": "With it's Early Access on the 30th of June 2016, VR: Vacate the Room was the first VR Escape Room on PC.\n\nFinally - after almost 10 years - it arrives on the Meta Quest. \n\nWith controller and hand tracking support.\n\nBut what is it:\nIt is a VR Experience where you need to find clues to solve puzzles and find your way out of the Room. There are some items that can be grabbed and carried around. With some items you can interact (such as switches and numpads).\n\nGood to know:\nThere is a second room with an alternative ending", "short_description": "The first ever VR Escape Room to release on PC.\nNow finally available on Meta Quest.\n\nIt is a VR Experience where you need to find clues to solve puzzles and find your way out. "}]}, "developer_name": "hOSHI", "developer_privacy_policy_url": "https://hoshi.games/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "hOSHI", "support_website_url": null, "website_url": "https://hoshi.games/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27745460808436097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820441_25210131151951023_4417370238530614504_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rblol_WV36gQ7kNvwGgGz-K&_nc_oc=Adrz5JIjITM0Rrl-Y4LIFbr9RUSkMbJVM__k1rRSQwxKNmWaJrQY0Pjn9UiZjmH43jc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdB5ajtmULv9gcKKFc91kE9P9VXpueJTpCMF9Pg5345Q&oe=6AA940D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR: Vacate the Room (Escape Room)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1780333200, "lastRevision": {"nodes": [{"id": "24390524117263133", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale
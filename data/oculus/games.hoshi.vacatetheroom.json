ng?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-opFr7fCsYQ7kNvwEFbP0J&_nc_oc=AdrmuCnAAZ537qXq-yhhxwhU_ouGRcl5VZSJW4MeWdNnHWn-UllXICRKQB8rjpMmcu8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi55FEd-CmlCUu1PQTRtWPQcHMiaZKVHRlGpDV-2nVhw&oe=6AAE8DD7"}, {"file_name": "vr1-sc3.png", "id": "1610705933245233", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823271_1610705936578566_1938565319623941586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GpQ_Xrs6ZcQ7kNvwG1nmwE&_nc_oc=AdpjNwW5CaZGqDg-DIc5TYXDfZrm79DKEDPWwL5Pa0ZZUbvAx2SayoVJTz47g46EaU4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3N03yuvA-ypJ7allrG4rk9EWsWIWTgTt_Od_BGLptXw&oe=6AAEA7D8"}, {"file_name": "vr1-sc5.png", "id": "2064503600974247", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491824303_2064503607640913_6435331218694842426_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkqILGi2IRwQ7kNvwHPETH4&_nc_oc=AdoJnfUkKILikW7pLOQesvsHJBRWeCETdAYFAC1eTrDyTJutRoSf1T6AHhUhMwiJ90o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIagxhorvx5s5OWH-rWW-8Btn2-3O7yciF_OBNCPbTeqg&oe=6AAE91A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR: Vacate the Room (Escape Room)", "keywords": [], "long_description": "With it's Early Access on the 30th of June 2016, VR: Vacate the Room was the first VR Escape Room on PC.\n\nFinally - after almost 10 years - it arrives on the Meta Quest. \n\nWith controller and hand tracking support.\n\nBut what is it:\nIt is a VR Experience where you need to find clues to solve puzzles and find your way out of the Room. There are some items that can be grabbed and carried around. With some items you can interact (such as switches and numpads).\n\nGood to know:\nThere is a second room with an alternative ending", "short_description": "The first ever VR Escape Room to release on PC.\nNow finally available on Meta Quest.\n\nIt is a VR Experience where you need to find clues to solve puzzles and find your way out. "}]}, "developer_name": "hOSHI", "developer_privacy_policy_url": "https://hoshi.games/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "hOSHI", "support_website_url": null, "website_url": "https://hoshi.games/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27745460808436097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820441_25210131151951023_4417370238530614504_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LpVUkqe15IQ7kNvwGY8A2-&_nc_oc=Adr-l2hRBASGJfqEqRTnEcLjlwRxRnOxudf-k3ZI8ml3CfrC0uyT1tVBGXvthSGYBCg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXi-Wf0NvJhnsEPvyIIEBc2Y2QnLTy5rEXlCf8e_zqkg&oe=6AAE86D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR: Vacate the Room (Escape Room)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1780333200, "lastRevision": {"nodes": [{"id": "24390524117263133", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale
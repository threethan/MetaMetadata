3S8H6vA&oe=6B05AAD8"}, {"file_name": "vr1-sc5.png", "id": "2064503600974247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824303_2064503607640913_6435331218694842426_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Sm4XV6YZ6IQ7kNvwEduAvO&_nc_oc=Adop658OU7LiflIAucEubsfp_Yf6gXUtewMP7HriS1rRPV3_ndYiOZBwaefkLEoxSbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC1CggtTFFrTb80GdFkYfFH1h52tpiQzNQBuHpcdXMuw&oe=6B05CCE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR: Vacate the Room (Escape Room)", "keywords": [], "long_description": "With it's Early Access on the 30th of June 2016, VR: Vacate the Room was the first VR Escape Room on PC.\n\nFinally - after almost 10 years - it arrives on the Meta Quest. \n\nWith controller and hand tracking support.\n\nBut what is it:\nIt is a VR Experience where you need to find clues to solve puzzles and find your way out of the Room. There are some items that can be grabbed and carried around. With some items you can interact (such as switches and numpads).\n\nGood to know:\nThere is a second room with an alternative ending", "short_description": "The first ever VR Escape Room to release on PC.\nNow finally available on Meta Quest.\n\nIt is a VR Experience where you need to find clues to solve puzzles and find your way out. "}]}, "developer_name": "hOSHI", "developer_privacy_policy_url": "https://hoshi.games/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "hOSHI", "support_website_url": null, "website_url": "https://hoshi.games/en/vrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "re
ith some items you can interact (such as switches and numpads).\n\nGood to know:\nThere is a second room with an alternative ending", "short_description": "The first ever VR Escape Room to release on PC.\nNow finally available on Meta Quest.\n\nIt is a VR Experience where you need to find clues to solve puzzles and find your way out. "}]}, "developer_name": "hOSHI", "developer_privacy_policy_url": "https://hoshi.games/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "hOSHI", "support_website_url": null, "website_url": "https://hoshi.games/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27745460808436097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820441_25210131151951023_4417370238530614504_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPN06h6EB5YQ7kNvwFeY5Vn&_nc_oc=AdpDJ4Nmv9ldjaJ2Jdo4F3BrEd1IMQMEqN28PtbZU6zTGSKYO8i0U8xqyedopXaK6qc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_jZMp15Q0PR-V1H31qsaG5ncIcLkEVaQEHPjccyHa_w&oe=6B031F16"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR: Vacate the Room (Escape Room)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"
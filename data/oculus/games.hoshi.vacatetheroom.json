vYWoleXtfoQ7kNvwEDmtCK&_nc_oc=Ado6tf4XA_0tukReZnNUdXDToXeTRKP8xsR80tmqnK1r7Ulm-f_b2imngimiHrq9b8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP_9Qt-TAqWYEld88d1iAgH7TubQ_r4gdjmONdJ7B3OQ&oe=6A733E29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR: Vacate the Room (Escape Room)", "keywords": [], "long_description": "With it's Early Access on the 30th of June 2016, VR: Vacate the Room was the first VR Escape Room on PC.\n\nFinally - after almost 10 years - it arrives on the Meta Quest. \n\nWith controller and hand tracking support.\n\nBut what is it:\nIt is a VR Experience where you need to find clues to solve puzzles and find your way out of the Room. There are some items that can be grabbed and carried around. With some items you can interact (such as switches and numpads).\n\nGood to know:\nThere is a second room with an alternative ending", "short_description": "The first ever VR Escape Room to release on PC.\nNow finally available on Meta Quest.\n\nIt is a VR Experience where you need to find clues to solve puzzles and find your way out. "}]}, "developer_name": "hOSHI", "developer_privacy_policy_url": "https://hoshi.games/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "hOSHI", "support_website_url": null, "website_url": "https://hoshi.games/en/vrgames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "us
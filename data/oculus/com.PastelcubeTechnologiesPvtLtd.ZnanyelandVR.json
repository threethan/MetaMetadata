ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgx7ibiz5EkQ7kNvwFfYubH&_nc_oc=AdqRjo-HvnJgEdac4u2-8ANA0lcWVafjzSAAyOlf3vTIp0tgR34mv7-FcWa4zUqW_U8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hXWVS9kJbAm8lf9XGuejLvGvkduN7THobRI46ZwSWXw&oe=69E4E983"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaRL4CQsGFoQ7kNvwEdv1_t&_nc_oc=Adoq9M2leN8LBisrhWUmkCp6NHUkrcsOPPlP1LqXl7gaMT6mxb2CGWFSV4cliKGYKfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o5dKtTTZtUyd1RBN8_6VA0CEmkn8UIH4wcPsquK4eCg&oe=69E4DF33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPhvFZ1KOpYQ7kNvwGc6HLQ&_nc_oc=AdojyEkfAdNkYi3mpT__YHP9OilKfueOIePzTKBTq5pHu3nXImKM8bRJ4d5ne7r7cfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GN9bihSwnD5h3bkFGek0dDoeKm7On_fHemoXPXwFovg&oe=69E4B9CF"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6eRGWLpOSkQ7kNvwEQ_R7_&_nc_oc=AdrWlrbzJ_b51XcvF43iv9BNhTVt7jkR-m81sc_nAzmckNAAqfIXz2_BgMsEtO-aerg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D14oCyFNjzpF6j414qBXgYso9wnh3adWrwOwx9u74tQ&oe=69E4E14A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SHBfJDmepEQ7kNvwGIH-wa&_nc_oc=AdomWKvjZ3D0rJUw-HztVs7dxyDtC0PhWhdlunGtWEJuRze7xqK9vwJteZyrE0mEfVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23vgwEStHtH6_0Iv-0eXgFj0D9oSOMmB7nGJfENj1fOw&oe=69E4C34B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3hS0kOFZ84Q7kNvwFK0mWo&_nc_oc=AdpMbPxx-u_Pxq7dfCh3Pyy2ZJCCXy0-C_uFmJSgg8imsT8VIHwdZzyebQ1Y8j0uxRY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25Xwm5FvEVMu2-jsjX6JGZn-PiYzFuM3CNMQAQ4f5XiA&oe=69F4BB83"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4IErPO4lsIQ7kNvwE0jIVZ&_nc_oc=AdoncubxVkw-PpshoBBVsMylnkR0tCQTGlgQagMFH2efzKzJgGVnx7t0GUwVwznnFdU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39xGTTvacCeQVvS0CTDbjktlSfKC0RSVOviXaszgaIHw&oe=69F4B133"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCaAvMwVVw4Q7kNvwEMRv7j&_nc_oc=Adoobsvaw6PtAJSZuFNpCplcuLfRQxbUe0HxGyPX12Zp8hY642r1LmuOeCmONM8_FF4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17N1s8umxTxSYpusS70B6_3J8D_SNOHoD3hxGBYWQA1g&oe=69F4C40F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb447TKtXicQ7kNvwEHJ1KY&_nc_oc=Adpw6P0L_yoxI0E2qTUS0RtOUy0tY4ytG_8QjN4T1R9_CDhmreK93u5EnRqlUQz5cQE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xSwSF-wJq3W0Kw-Pi-41vLN6h0Zx1DjikNIvetDOG0g&oe=69F4B34A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeQ_a9SMx4wQ7kNvwHCPGvj&_nc_oc=AdqzkKu2bVpDqBPUu9OjS9Fa9S2In9B1dXqMnNngN8HRin8CNEYPut2zzafOtEWGo9w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eBeQB-AlzSOzfyedni9e5zILX3a3OnE3n2djDjJ0E5Q&oe=69F4954B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
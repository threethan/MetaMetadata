.png", "id": "263957245555578", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tnGGc_J3SUQ7kNvwFX6ww6&_nc_oc=Ado0L2oyU9sNE_xVUS2IKt_ICP8FE9W3vkQ5YJAEdgh1QxK4Q6yFaau9tnBcjubmHTE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J3_xz8Su-iYReR6C04TYUwS6L-e2_sEt4Cr1j1MxLJQ&oe=6A36A683"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyBGCCKPKI4Q7kNvwHxyYCa&_nc_oc=Adr5q753kHV6FC8kQmzdLcV6NWnVq4FNUHKmoj-7Lmmcv8U0tTmA_nCxy720cD-5gsU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IIskDdkABgAwvlPn1hsPd0A0DGURaWMWd8G-pDz56hQ&oe=6A369C33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLcBLD5VsscQ7kNvwHg-onH&_nc_oc=Adrlnz-5x1tw-dxvkZBI6B9XNml2x65MlhICyKCok9zDjVWy8vgEMiTuRJWuUc8Yn-4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-49U-NeMnFjuxG5ZEpo4H20sxgTiTtJYJW9y9DBydzUQ&oe=6A36AF0F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOwSaN91WHkQ7kNvwGmB6ZN&_nc_oc=AdoDthE1BHikmRN4JQhFhNSP1sHrRkNTBo_F9kU7TT3wYL7XoSXdY3dWawC5tZ6v1HM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DElZQxwaJpsyDIALFsRviq9TMH7WmwcLTq4KTtt7q_A&oe=6A369E4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dh2ZkzP_e4Q7kNvwGDmJO3&_nc_oc=AdpPP6zDhZC2-RPTUdAeN702kXhavnAIxlwE9TZj1P0PW2M8_rRI1FE7s3onolSjcb4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0djNN0Eocdb9caHhTQettRrTtwcWscV0jG7oj5izhDw&oe=6A36B88B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
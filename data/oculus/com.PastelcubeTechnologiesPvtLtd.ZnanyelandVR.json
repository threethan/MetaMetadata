ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmZydCW8L8YQ7kNvwFf8X0c&_nc_oc=AdqIA3X1Opl1It2bV6qrS8wRm8kOIKbKgFvKFIx1V6bsVg9B6KOGeGOJtHq0fc5IyaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84NAM8x_1DFZfWC7_qUy6e-bdVVe3oA27Y428Wo42lMg&oe=6A2D6C03"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb9VgLjM0l8Q7kNvwF9fiRa&_nc_oc=AdqvQLjq1iEqE-HNehvOr_BgT67hNQV9H_eafmO-ksnMhsgUK6fYeF3ZuwRE4Ov7gPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JWw-VzHU3IiMgUWVXG_BlumCmid-PTUTPYl04BWbVUw&oe=6A2D61B3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=173ZN6id-k4Q7kNvwH75sLY&_nc_oc=AdpFXyMLUp82pae5gJrM5_sUZ_CO3UnhDlq7C2tA8e2nhhfl8qGPXNNmJmEJpdIoCzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SdcFnq7CgnLsZuBfTdSL9-JmesoOj_MybEr1yBVnKlA&oe=6A2D748F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89D_hdR_4xYQ7kNvwHImF_J&_nc_oc=Adp03aGifTuxyxFErXinEL3sGo_kv6EYCNHsLGrb5p4Al--4bbDJNKkxtMgJkfVb96Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93xgr3P2BU0HkFb-5PAdR2LDxYa4g4cX_o9HP2sVqZEQ&oe=6A2D63CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4oET9cu0vAQ7kNvwECuuC9&_nc_oc=Adqa_YcTfoTkqgSq2ka-v9WO-GLdNRN7AxIUT-5FZBVfD89lt4xF3Hl3enJXW_bvC-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CLHjNxai7T7uMg24riXSsFuL-Re8noAta32tWbU1bsw&oe=6A2D7E0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
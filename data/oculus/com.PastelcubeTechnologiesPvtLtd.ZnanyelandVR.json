ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUZd7m_c5vEQ7kNvwGTVas-&_nc_oc=Adoq8wV9S5uaw5YJvh_C-SYoQ5mNlOhmgjNdtbboVWJoCjONATtX6Lz62QhhP8i0at4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCvTulTroDMQRB61RDM7Kyr5mqWymrWMRvDpRE7Zsghg&oe=6A5E3383"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeLlgorFDbIQ7kNvwFJvBX4&_nc_oc=AdrTsl-Z0foB4C7hGzMaiUvb3nLc2Aq6hCFjWquCvu8au5ld1pOeWQB8ySziBPO1zdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANErIBIc4-kGLG494yzPZhkE4vy3Pk2xc45QaNw5S4Xg&oe=6A5E2933"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1eJZAzpP80Q7kNvwFAKUty&_nc_oc=AdrwyUDRtOhuoy0hJDN103-F49yCkRIsO3SUPjTg8ZYN5O2wNR1QoEV1gKdrZWQOdZw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmbYGoUrAmWlgiXdFxujnsw3uYm5DMe76Eh3WV07Ndow&oe=6A5E03CF"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNjcydm-lSAQ7kNvwGrIYz9&_nc_oc=Adp0A25PzuIT1yDkZ_4OoSzIifGaNn8_QWOCq1kCdIufhUdvDzlGfJVFNyPKm5pqvMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGJ06H0qW7LFWh2x_uyYYoInbpkisJiAtdsctitYDj0Q&oe=6A5E2B4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0qFLMPA_3UQ7kNvwHzCpsZ&_nc_oc=AdoRwd6hYLdeA620hfx1W5oH7OaTCfSGOyBmRgA7kWV2ttkClAKbqIZ7WE2AJYG7Kic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCabWIVD6nTRNHThmP4M8FrXVxnDEHayY71eTHBM_mGNg&oe=6A5E0D4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmZydCW8L8YQ7kNvwFZsY-B&_nc_oc=Adrwrv8aYvnrqIl-IOPRQwRs4ZMf2aE5u7iGRRe9KAsQtVNZhmFIC3dz7uLOU4jQS24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ziB2_UhAKr-WolVZg2uzuFIhJeG-N7ln35tfWuB1zHA&oe=6A2AC903"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4WtKcvYanMQ7kNvwHT4vUz&_nc_oc=AdrvqVCWO0lLQ97jtgVd0jzwOvLYnGbc74McdHnPxGey84aCxT7BiVswMTzBnj0u5jQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K5YjwAA1wpmDtSzSvwin8mfmRFUEQp6CkktOYa3iFKQ&oe=6A2ABEB3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=173ZN6id-k4Q7kNvwHaPrSL&_nc_oc=AdpG_chOg6fGWYcUCbQXD0KPKVwZwlRWI2ZKYcryjEVu9TEBz5FYEALDYC0b7-JQNbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Mai9weWGbYdzeMrloPZVYhzGxz3nTKtBPAnknEIR_g&oe=6A2AD18F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LoZibS7SRAQ7kNvwHqZHWQ&_nc_oc=Ado2fiKwZ1OPAA2DY3-17nQ8RmBudxr-rcOCOXmRi6cm-XFaCzMlHBZKTLoSngJN20Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s2p3mdst5A5C4lW_J1OxY0fggcEmfMhWG8fzJ056FeQ&oe=6A2AC0CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgA0qHeTbs8Q7kNvwFikU4r&_nc_oc=Adpg3ZqxltNacbMInkuesV6GuxweQzSaGj84al3ysQiaG7vyFcTkBMhrKAQf-KxNTZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kvp7M5yoySlBCi5tUmT7q2_Jquxvf-_KZZ5Fe3Yb8_g&oe=6A2ADB0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
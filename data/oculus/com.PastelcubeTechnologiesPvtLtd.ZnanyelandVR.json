ng", "id": "263957245555578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5egifquUcNMQ7kNvwGXV_uI&_nc_oc=AdoPNvK0xS5lX4a7l6Tn7CLVqbxNSUrjdthrSxn3l5yww1eBZtLsAkFNLQvd-bD4aC4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UFSHnhx5qYPHwgXWv2OfucfFE-N_PRjIQZYPj-7c9OQ&oe=6A243183"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odK_y39FqoMQ7kNvwF833I9&_nc_oc=AdqQOMBmpFJM7Cn4GWN9-nlbfYV1Jd8cEeo4YFm1Uo2mBf6MlOpADltReD2ZmGw70Ac&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6LOlJWHt9YFoUUhGemSO1-gsJzm42LgkbqQV-Oi8fxQ&oe=6A242733"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Bj1z4PsAW4Q7kNvwHrGX1Q&_nc_oc=Adr5RAmuo_uSVgWKAgcorN8efy66lJZ6VWk1DHUrnwOgNPVMYKl0P_12nz6uOCMM8IU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af819lThUBdjou1OnbzwMwRqMnpGhW8msX0YCvqZJtimTQ&oe=6A243A0F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFwITl2O8pAQ7kNvwHOMpiT&_nc_oc=AdpTDiZP_sCRD53zgB-zmpP3FGwEVBgR7BSVU0yPgdU0N6-nwr1ExRvVBKKAv8z41WA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iwzidqOiwt3DFF7YHrc3pQdd-80hu4Ee3Fw9xKmDl7Q&oe=6A24294A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ5Cbq2F-h8Q7kNvwFjC0ry&_nc_oc=AdqDGMzRR8oG4qyYVwEFN91CXWsd5_a42mdLanRfdl05oUho3HM0vjfNStQXmNavwFc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wiMRlItsNTnp6YhEuUAFpKqzER75_lFSvpQ91Fn1TCQ&oe=6A24438B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
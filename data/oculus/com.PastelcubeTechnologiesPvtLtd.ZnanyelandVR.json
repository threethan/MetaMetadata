ng", "id": "263957245555578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZmavrR_8IIQ7kNvwHZ_hu5&_nc_oc=AdqEZ93iwFq61WtZ7auREcT-zGFzah7H3_zTFE6UfsW5DtfdtRfgqvyuT-cpE7n5npA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UDCLgRCQfCuFid5Fu1A_jn-WbwF1Go5sqFyPlykUlLg&oe=69FDF603"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aspH5IWZ7QAQ7kNvwH9oZWn&_nc_oc=Ado6NWMEXLHBYRYWA6t8yHS-g1L5O0uqAJKI04PoXkJ7Ymvj4n5x02pX8qo3MDUUyfU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n9BmGCUobaTRLPFRFOiEXHYv0Hg6HT_P8sYXwW2CFSg&oe=69FDEBB3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qLHvb7eiBAQ7kNvwF7GUml&_nc_oc=Adog5-wc5UjCW0Qrls-kT-aA7yl6w5oGl4If28Ze8BNxIK29YJl89mXFSjubExFk9bg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fJawy51Q0P54ps4aWp0eTiJTZbt3rwKU_iS0fEibUaA&oe=69FDFE8F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJMZFieJVzoQ7kNvwGdrJXg&_nc_oc=AdrLphNeNzzLHhPHoZWUELuof2yMe4vhVsg933XBy5u8KVluLuOh4ks5yt8t1-JtmWU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UVCljZ-JEvQaxhHxba1qxTQUVQig5dXaAPeuej1di4A&oe=69FDEDCA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=io1p-yXhyS4Q7kNvwEWGnZE&_nc_oc=Adp6wSL-ZcHLN0LlpnynMtZcooXG8EU8NG2O4I9WG0ZaBG9wfaFf3pLzH1kpNjZlqr4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72KxoUwXUS4Da0LE8w6V1Fxteu1FffmqrpNWvfFqck6A&oe=69FDCFCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRqxUciAwxkQ7kNvwG-czMY&_nc_oc=AdoUTtPvv6PsIz6F8VCI5gCKem8STu2ofDIA7R4T57ZymBrufXGFxrQtkaXD0alq2uQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkLRpKHnw6QkTJ1FS74ilBPO5Cd787jvn-s-_UaUa1dg&oe=6AB29383"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g20fFByyIVwQ7kNvwHcxj_F&_nc_oc=AdoxhIVPRnP3g77LYXj9hmNf0eAH5QY64Ki3vRt8be69qapukDJWUfXajLIeWlrzkco&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBmaPT5H7lBTG69FyI9tRUI7JZ5zX-GGDXUJbWHeDZnw&oe=6AB28933"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egLioYfO4yAQ7kNvwGda3Y5&_nc_oc=Adp-9oqAd9_69w4iU8dDFlMrR4fTz-iL83cukrCdpWeShdUKiS1misCiMY1Fp_fSDVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8TyZSuyov1AEob9CdCuotNygTQ67wgUfVO8A9I6iQDg&oe=6AB29C0F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj-CjQjF8pcQ7kNvwEZwpw7&_nc_oc=Adp4rcSY25iA8sMHJxJReP8hC-z5vymwvDJdEElERGFVF1ZMueKQ1gjFVtPwUh4WAJM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8sTMoXcqKdXNYXYFmp7WRCCM-zOqVUCT0GeTjWI2q_w&oe=6AB28B4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x-HbonJ74IQ7kNvwFQEVBE&_nc_oc=AdpGZa4x0FGmZXcyW8vrVEz72sbK8CRp4sKUXRGQhZG9jOkHxiCx-ntXyN-Ej2fO6AU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP96OGzuuSqO2-6vCjfNi2eaZgZgkercnlJgwuEmCFRA&oe=6AB2A58B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
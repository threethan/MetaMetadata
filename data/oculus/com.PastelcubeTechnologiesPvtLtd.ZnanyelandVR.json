ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eln14RkkakEQ7kNvwFibRFR&_nc_oc=AdqYMS4_W6-O0EgsDyBQ4bh9Txs-GUHKCb6lvQMEyDVbv06xkq-Ru6QH_U9GsUEQdIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGpJVAa0dlo6UEbaj_9-C8eMsPskewJuENF49e8Pfymg&oe=6AC3B703"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Fj3yshnDt4Q7kNvwEPIHos&_nc_oc=AdrFyluH-FzLMtX6GEhfYkuigyxk--4Fz9je5LBbewiji8MUgW2bXnvZ4vAmOcqszyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLKQhVYZAhfE6XNdCphIFe3llUCnOMXyfyrzJi1dCw2Q&oe=6AC3ACB3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNpo6hlEn70Q7kNvwG_q_ad&_nc_oc=AdqK5b6eDYbx3oGjKbNtMmQzUT6WjjeXQgwcpIglp86hwa12hR4duL7Tn_574tce_Xo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNSHpq_Fqtn063E1lUxjnTf52dMqEJSTMtUx87VRkysg&oe=6AC3BF8F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ke0LUbtFs0Q7kNvwEAZu-O&_nc_oc=Adr5pDE5LphQdoYVRYJJmmZsnni_pZ1JH3fec2ONwF2Z81Fvr3UL8zu0CejWs6o_zZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrnKtd8uPztUcRLRARdYZIiRgPXel_XX649N8XLdbrRg&oe=6AC3AECA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32LS89Ai-zAQ7kNvwEUBp36&_nc_oc=Adp5BkCeImygyXo3O47iM6n_wWVbj-S7A8xRwvRjsm18d3jaW8BqALHEgCOajokxdFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4sjphYtJ81ho5zHji1HNvmIhj7MkyGgBQ4ybjNHJ43Q&oe=6AC3C90B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tawiGE5ivaMQ7kNvwHs5KUQ&_nc_oc=Adoj_CEaDUUXgM675Yus5_94gvjrBvuZk736-ZKSUahLE8QdpnTOaTqNwpaAsclWzVM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHISX5lqKsniczavV-WRVMPDJOXK03bayPBETCjBSlWjw&oe=6A86D9C3"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMty9BdGy18Q7kNvwGG7DLk&_nc_oc=AdoVv2fFUxM04AAKVPTNyuA5lPgl3dqnJlZYRtTRMnIcJw46gOpiqqt4i9QTeavdtcA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ0yI_lXRhag2TA3bA-5q1lsAwn1BjtxI58z-afH5Shw&oe=6A86CF73"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DC_VuwAnF50Q7kNvwHnB1vD&_nc_oc=AdpRNEp5CIzZVlePKXp1gxXQ4oxM4IOaCxEkCXc3__RhBQHcX-Bm65x8rmYVB93yKiI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQVKWzApNpW4dc2S46kcDGbnMf7dJ260O3tr52_7ZWXQ&oe=6A86E24F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7haKa1CeDwQ7kNvwE1hxxe&_nc_oc=AdqbcQZjIoVhWE2bIz449xOE7tJnvRGTx6Nim7ctfBeiobVhe-amAC4NGGmW_ifMu6U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfH_1K0Lh9CbZfxlqUPofmY4B7oRXaFVyw6YUlu8mP1g&oe=6A86D18A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1ibDuj1tt0Q7kNvwF1gJyI&_nc_oc=AdomqYm2kt376uChQSylN90yrViF-62kFL8tTC4Dj12GjjxtujG6SJSpMC_bAf7ld58&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn0-WcqwZcjJAEcInoY4uZUJQ5HaUrTMI86vsTGfrhug&oe=6A86EBCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
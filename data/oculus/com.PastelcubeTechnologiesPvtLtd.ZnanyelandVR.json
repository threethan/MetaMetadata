ng", "id": "263957245555578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC9InVaWu4YQ7kNvwFGlEre&_nc_oc=AdpDtzS4Fob6Zfes63EgK6EWQ9eo01CP5L_p_D_iEhaS3lZnqTDpdUJq-kv10nzcwyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVAU4pbIG3_hrFR-mLvoCY1JZk7uUIi-WSooJ8G2D3ng&oe=6AF47E83"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s-8AAGiZ4gQ7kNvwG37zIV&_nc_oc=AdpVVA19N5ewF-zLi4ALBcSfzoDMsR4JE3yH63zYLUhUBCTphgXi7Q2wpSz6R7nIJZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXgRIGHZ21qK-QUdyXxFae8swSzzNUO1WBLz7zagcAEw&oe=6AF47433"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5ssOHfJ8icQ7kNvwH74PZG&_nc_oc=AdpQ633AL0yGIRCXbmGoQKjaBRXOoE8Zw6N6yGhURVR6G6Istt3bvIWaT-o9jSd1W-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa3TkFkfi3-B_oOddAtdvss6_txhfMYEEF2fwyrFOHuQ&oe=6AF4870F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sbw3CReAgI4Q7kNvwGv279_&_nc_oc=AdrbRjKJETLgxjbA9VFn0Fli6636arIjs77gi2RlqNWaVEVKj_83BzDcgECjMlYWOhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpWypI4Owc28tIcGvhyf9udR9_NWqz_ZW4hU7yVGI_sA&oe=6AF4764A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toNTIReBwhQQ7kNvwGWbaMH&_nc_oc=Adq0cJBNm8no-E3UJaalVGioOdYDqs2bMNVNglEd23OexD7Cfif_IOsk6samYOb_5Os&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYcGmlwUSORt8yxtiOjJM3mDTgwVTaDoyNQHsvIl66wQ&oe=6AF4908B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
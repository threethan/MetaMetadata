ng", "id": "263957245555578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pje40JHZasAQ7kNvwGvkutS&_nc_oc=AdoSUoRrMMb7GfXoezXC_sARi8Wu5uEQJe6HU8nGFwiqv5JSUMIZ3YdPI0krZhfWtFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_968ZCHBF4W7A-CAfzynzU55WmUxMS7KHBx3bWd9_UmQ&oe=6A3E8F83"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPpA0Xfp4P8Q7kNvwEu-vzU&_nc_oc=Ado-r2SHrTqPJLOVN1KMWW5smOyZctKr0Po0-kesCu4sHFQ136pU68ZoombZuAErF-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81kSfYVEL86dQvBD3uXhxlpUARrI7awNFR-tsxu3pAPg&oe=6A3E8533"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9tz73OJy6YQ7kNvwEfQrhR&_nc_oc=Adpe3cJl2hn22-ydY7ics540zbjUTGKmPdO0WdLytgFH_3N3WVn1AzswnWz5XEsKNz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xi2Z79yRE7PhUn4q2QY7wy2zVGurOi1ff0Wk4b8lbKQ&oe=6A3E980F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xTjEX5LrxkQ7kNvwFdkXeR&_nc_oc=AdqXyxRWPH3kZnRzfh5uy9b3X2g8Xjpm0Y9mMGy5XXZTSQ_T3V5f7FijDX0Fp2aghxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pabtj37wPZwAxFpk37bAy06-i_pUypFk3K03ylS8vTQ&oe=6A3E874A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1p35RtGlToQ7kNvwGU2Dg2&_nc_oc=AdoxWR2Jxlj5Cp5sWw_DvcxbhdeQws4hsoFoADOon8T13BrqxT_uKKK-Kz6Fe8j4jLM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AP37AaOcf78JEh9s3TSSwxqitsxMXRhqNjPcvnkFmuw&oe=6A3EA18B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HICaGLMC9IIQ7kNvwEy-d4b&_nc_oc=AdrhWIdy5dUZEjREyq9Qa9nbXqxCl7qtmCp-ySAB57D-yJ9sgpL4jZM0vcUZRPBXVUE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR8Y4KZ8MSzYUreOASY30ku053-fkKxjg5KeJhNd0kdg&oe=6ABE7103"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zAjmmY4E3UQ7kNvwEzwXDl&_nc_oc=AdrzX3S3SedytHZmtHjBFkSv-MNFUbrTI3o6vprJMoKLUZ34jl6OtVwMHQLln7dPDY0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEkLMaQstOErofqLbzW_u9XyHIjnwnZvRFt4kkABljdg&oe=6ABE66B3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjtXwUT_f64Q7kNvwE5Pow2&_nc_oc=AdqCiNcnzB4ha8VPSAIxa84EhoMtv5cct_teEFAaYXAzJKwmONYNlHLo21fZpq8j4HI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF4Rl-101VpgKKlvAPp2OqPqDs7P9yZ8JwLetcQPry0g&oe=6ABE798F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXJZG62bPEwQ7kNvwHe-TRs&_nc_oc=AdqNQPHCGNs9ZeTqwjdlEG7mF3hxFza9vLiD0FbV05qoLmSYXWo2osOa2GVDej9MpRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU4aSMtIPKKpKk04lFj9omQyYizzLCn_uvZ3QRbjKNmg&oe=6ABE68CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvSu0570SVkQ7kNvwG1IM1y&_nc_oc=AdqGXQtvng1dd7AhtBF_UtgH5WL2HdOYk61lE7s54Wwm2w4R4w9WVYzvm9rM1S9RbtY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWuTUO6V7hefu8KwYYXlCoNkF2rZlfeMUyS_pja14vjw&oe=6ABE830B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
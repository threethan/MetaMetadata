ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGuphMYy3I8Q7kNvwHyHR0y&_nc_oc=AdrKNGi2Z21xO80CUyUn_mJMejoR8D1IgR8GsCGNJ_fQ-nsuwnu4tkHeKiSoZIDIrd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1I88LmwtmRan7niDVuiINmrjrFxeKLrzcQm14gOknMA&oe=6A4FB303"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlSb_-t4CYwQ7kNvwFmnUsT&_nc_oc=AdqoUZoW0t7LYqDM5vE9pAGQctc6WrM7icCg0Lpiql3TYOcI74zYo-DyCKDNk5T594k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX1fFVb_rIw7iaA0XMn-Ztlrcyscbi2UaWA94EjW79pQ&oe=6A4FA8B3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wOBeJ1ePF4Q7kNvwEaxD04&_nc_oc=AdobsObDP2iNVKSEISklC4XfnBkCDXbWfs-X6YNZPUJ17OL1n-pwhP1QvoPphfBt6Yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARLw9hmnCDfY2xZrbV0r1geJFNBoh4dnMkx7Foz9HKfg&oe=6A4FBB8F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-S4YhB_LsJgQ7kNvwGJyEmc&_nc_oc=AdoxnHTQUSYw4pKdW5YqjRYyw-yswqImUGQrQkCwump5O4z67-cfdlyC7CtOoP5B-yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCM8NM0NSPhiZaeV14T9rTNveuX1tsxprwaCXELbeniA&oe=6A4FAACA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0thjeGeHwnEQ7kNvwHXwOha&_nc_oc=Ado5Gt-GKpFA03L_UfNIya8cLEaM6YAH0GJp8nsJXRvNjBkczcVBrCVnLWgPJorfsEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtVnwzIDrvMdypzDK6HkBC-COyYnJVpJ8ZDdxe0t5Zog&oe=6A4FC50B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
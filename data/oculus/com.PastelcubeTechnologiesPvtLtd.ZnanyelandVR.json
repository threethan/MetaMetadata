ng", "id": "263957245555578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7zdPP_tdMQQ7kNvwFSIRvs&_nc_oc=AdqQDOyrETYs0UVb2wB78jlEXcmkjGpsyP_N-Rh2fdJ3oh3v055ZL3iQLcUAw_kzD1w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-UxQQWWCyUOkg0t-QTUyfY1spS_lCfiJRwxZvIJpiJQ&oe=69E8DE03"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2LIAPv_HCAQ7kNvwEOD3Hi&_nc_oc=AdoPT1KOcvox2CqrmjNDXM0KjQ4Vh_-HsrPLJeSZ0wNki5EEN697qHD9hkf5wh1iR-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O9vMmKUs6NaUzSXa2CYUhStaGTwI8AqlSIH9UI_aprQ&oe=69E8D3B3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcoogcyPS8sQ7kNvwEJrOot&_nc_oc=Adr4CSSKIrhpbouQpwnwyOph0w5iWurIgm8ofQ2yCpxiffsscXXrEuNbOVGNtUm0lxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xch_3wqDF2fq2R5c35DnLjkqEj4qpDLjFdweVyhzvHw&oe=69E8AE4F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7Iqlyhu0zgQ7kNvwG0FqFH&_nc_oc=AdpzH9uGAK8iSlocMi0vWBDzHOSGMXwSP6uuACOfE-_c9AiwxlU7_E6wwmmrGDoPtz0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02XD_tT-zkPxQCJUzHc751sQN7uyvoG7kwato9LtPjHw&oe=69E8D5CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2hcO51eAgwQ7kNvwFaVZz4&_nc_oc=Adrmbg30OFvBr2h865GwgiHd56mlyu6H0Kunq5MtTGFbWc77W0znADHjJfrGmLMSJiY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j9WGPNnklr31YyqqL7_O9bu9XxOb4MjpkNiH_DRFuIw&oe=69E8B7CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
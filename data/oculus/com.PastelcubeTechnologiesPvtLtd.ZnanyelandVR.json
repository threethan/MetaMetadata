ng", "id": "263957245555578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd3DqKi1luYQ7kNvwH_UYZY&_nc_oc=AdrhGiyO9-tRoYOZIGmdZygVY-u9vWSXlEIG5HpoXWoEVbvnrn5ZGvA1wzfqy4lSkQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXkXa_Yddp5vUXDGjemOgfrksvGOsJ9uXGStRy320qGQ&oe=6ACF9483"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR9duBMG6SgQ7kNvwH-t3aG&_nc_oc=Ado69-e4ngyMVvMHJimkZ_2k5M78Lw36YoWyLT-sZbdmG-cyfA2EoL7b20wkTvcbWXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBH3fxdUkJF7SALz1kS0S2WDyT778nW4boFz6LrvZeDQ&oe=6ACF8A33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkBenoJY9TIQ7kNvwEZbXZW&_nc_oc=AdosThKN1SLqWIM-X2Q4cdT-p9V8BRgq671rEFekxdLQ6Y6X8YPtqWscGzY0bPLoLws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRVp3bKf77AtooAx1PnFacRXYWL0ge5-3IA1pyJB53qQ&oe=6ACF9D0F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n95scDxsQ3YQ7kNvwHi5dxP&_nc_oc=AdpA8yx0xH8OOyq2RoBfJdjyVtL_D507zBl5GFlXQTNVX0Lxik-SDm7N1ALrv3L3kV0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtVKJOSzO-Y97c_BEYwGxB7cJrK5sJmnC3hZ0jq02zTw&oe=6ACF8C4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUIB76yLjp8Q7kNvwE5lPKh&_nc_oc=Adot0yiVnyhFQhtackLrf5wO6ilE5sAfQ3lmH28j2sLS0Gbaunjed5uliCJnRRPHzOQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhTtlhB2iUXF2tAgcFTI_A2soYDd3ZiwJlINhdf0eS5Q&oe=6ACFA68B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
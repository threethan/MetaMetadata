ng", "id": "263957245555578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov8DzSDIodAQ7kNvwGfTqV4&_nc_oc=AdrQ7ADn8mghM3RODQFEAU96wcGoW6Iz7-Eiv2xGY5nmNkd6twpE2_NsA_7IYsAgtD4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y3UmXrs7DiBMiiDs4HyiMuEWl3hMEIjdZeM9pQ-PgcQ&oe=6A01EA83"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T-VVHKtHw8Q7kNvwHOWVUO&_nc_oc=Adq3BFPp4agdmxtENDkCRXB5jtVrO5eCLmLgO14A56sUdPdCBmxgZZlEqgt1lIw9ZIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HgoT4mnsiIOhA5uXvhf8kVwewpLRI6RLYqxC5hb8KVA&oe=6A01E033"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty_tz8Acwc8Q7kNvwHjdjoP&_nc_oc=AdqxmGfymSThoyBZ9QC60Ot4bjyW36NxCbYYvE9qH2ulVHE6E2ObuSkBP54x9Rr907I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZcdR6ORfTHStz0XadlL6twmnLGZDCPTjn38nZUQkhxA&oe=6A01F30F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY0iONShKQYQ7kNvwHywTqv&_nc_oc=Ado-fcoX4xvMfwb9xJ6uoy0SjrmY25r9kIocuVQL6J_4bzGvkrNGNsARVGOMXiFWct8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mPsoj6iI4UCeG0Wq0SkpIxzIwhzyG8LMlxGfZXRtQ7w&oe=6A01E24A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nzmqxt00LYQ7kNvwGV1cpo&_nc_oc=AdouMXjqhBIJ4QoNouCVzHMxlBsV3CpWa6VgK-isyWQMG-zHFq5lgCJqkzxmbNduUwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YPQx4Mxgt6lIUXOxn6NXWjifcx1KZ3cu2yzlVK3YMtw&oe=6A01C44B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
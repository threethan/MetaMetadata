ng", "id": "263957245555578", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2KtmOl9yFEQ7kNvwF_ZF5L&_nc_oc=Adrwclfkob-OQnAFbuBJeq6QK-mq780PnS_MHddCSIHx9PCeGrobkMC0qZHTSG_PPp4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af515t2B3hNr5NVTC94YDGYufmoT_4_ZU8JdU7O9gwGlbg&oe=6A1C4883"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJJvarZMbfkQ7kNvwH38xfn&_nc_oc=Adp3GxWn8UyWlkqCxqbELrfSme0pbTviHbKcwG-Q4RK65VQqhoh_NVORC_rHu1HiEZY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LYzfr9qhguqhvjrYqvnVgeRa0CMQVH-fGN5aT4nptOQ&oe=6A1C3E33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnC0un_61wgQ7kNvwH88ULl&_nc_oc=AdrrlW5UHtvGHnDcQjYNtsDdcKKpJez_a5vcBESmDpE3-TG6WwO8otlORNJhT7yL0z0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BQtzSsrsUF-5_PgyD5QPlPEuKIT8lrEZpqbmwUVggGQ&oe=6A1C510F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10vVJiGaq4sQ7kNvwH5oy4x&_nc_oc=AdptadnLfqdUUeUhg40kpreNeRpkaa4QEzgO9RHvzKSFkFmEBdCVaJcU6my8iws_w6k&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mu3BspXZwkoYrx-5Wx6eVYqe77_2fPiDZBxU_7DGqnQ&oe=6A1C404A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-8ARVvZi9cQ7kNvwHBmnJb&_nc_oc=Adr_qQz2IeOZOZkAgun6aE6qBGRBWi_27Kk5Gfz3qtLy4cNyFWrza623N-fudFmLu0Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tv9U5Pa5yTOYaOAg2s3JX7aUDoBQGtDv-AllTuNb6uQ&oe=6A1C5A8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
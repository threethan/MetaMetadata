ng", "id": "263957245555578", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fanB4TgRmSIQ7kNvwEeJnUs&_nc_oc=Adp-Q74YBG6eTB7nKT1zYYleBi1t4y3s5_GicpEvIfM8jG3YUoa8Ft3fzymDrzLfLZ0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MJm4x5iTglBjbJ3takd17m4vZ-fsNV90yN-zFYmCrlA&oe=6A32B203"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58eotaZPzoYQ7kNvwEEwZWW&_nc_oc=AdrRUG2lVAG8DvBWMsQeXSKqf6HiunmLmvNW3_mbFDY_aQehNyFHqbSfMIiJoJ3wYYA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z8L6QrNeWuta1fCm3sPA46uC9TaOj7n1hmaDaSUnDoQ&oe=6A32A7B3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw1zgcMqjioQ7kNvwH4VRct&_nc_oc=AdodskPKzWJ0ONQ1Q9eyN8h0rmS9YoEuOdXiRSZVQTXe0P9AGx0_zHJeHdbLr-CNDoY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JSVTkKM_-YFWN_-BUNI0FTySsEI9FEJHv11wKhUeHXw&oe=6A32BA8F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpLJaRWjFtEQ7kNvwEvXlSa&_nc_oc=Adq1KAJFYxM54ZX-5CjucXRQzlbIeY1B_gxS8wpUjNAL88hJQW1PXiNX804QneYJzNo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0L7Uj-dSguqEmzUJWqdTGXv7XKN-_geSzmsgnYHmIQA&oe=6A32A9CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uD4l6V8kjUQ7kNvwHwS_NF&_nc_oc=Adp38wc64PI9bNHUoimXNfoYKiXX6fimIiJxSRsS7bubLY71Ep3ZkO2vFyv706NMl2s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dAPNnWPcJzjFCsBQ402S-d7Pqp4TK40yg4ew1og6a1Q&oe=6A32C40B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
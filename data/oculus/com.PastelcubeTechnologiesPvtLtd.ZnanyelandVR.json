ng", "id": "263957245555578", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7zdPP_tdMQQ7kNvwEealns&_nc_oc=Adp5wl-oqsCXSEF7wgt4iOwHulHrjeKdzvakNrzhXHVhDVT3z45mU2SAPXZfMItPWpU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K1tXMqHVKskVrEVPiPyqE2bnIze4ZIIsL6OUVA6Hp5w&oe=69E78C83"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaRL4CQsGFoQ7kNvwE6OLzr&_nc_oc=AdpXJLkZNUwrbx-jiTfKHDzbOTZfymQL1hDi3zMvn9FqkaJbLNkmGPbZ6d8oPIWpvYU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ajuEZqHrSw_OGc_wm9wPD9I7qfqZW5-wZ-Gq49sM4zQ&oe=69E78233"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcoogcyPS8sQ7kNvwGetATj&_nc_oc=Ado3tUwCEitgWnj_HICgCQ-8eSZw767YjFgLsyrNo2gDuWw-64EzVgxxLt5ooVDnFoo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-q1WLIXY5C7VCHgCZ9Fylw8e-7mZrXeLHifd_OoDYbw&oe=69E75CCF"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6eRGWLpOSkQ7kNvwGQF6Tv&_nc_oc=AdqIAPZTxW9NizojZPjSnDj4Ga_xa1K0uYttFLoRpmD1DesfkjTgYRJ_bQ4rZJLn2d0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1adfKCKa8USDIgWfPqKf8fdH-uXCsOE9R7aabA7sARJg&oe=69E7844A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2hcO51eAgwQ7kNvwESCNoB&_nc_oc=Adp3wLcjFSe5U-nyd4EutJK80AHrUxAGt2L4YKmzhQat5dsx8GNaiiDqCi-cME41qHg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iqfGfJOQt9CKm4awdEP4uGVw96I90GWnbH4zkkj9Ltw&oe=69E7664B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
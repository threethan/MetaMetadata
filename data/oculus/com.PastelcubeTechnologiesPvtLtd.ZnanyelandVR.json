ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSm0xJKp5-MQ7kNvwGlUqnk&_nc_oc=AdoLeQSQLaesGFoDq7iefHMcb4HWz3NtYNLCwe2sXxQwKwL1NPPnRwZkdT-chaRlD_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Boz0soGshUO_Xr1xypU8oUkTq80wisTl1Ar2I7weH0Q&oe=6A2EBD83"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb9VgLjM0l8Q7kNvwFl9okH&_nc_oc=AdpBSdplJE9E2i3YtajR4Ih_57VAPppL4atnRllqy95b6BUs0DPrevnviR0H24jpZ0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XNhHsyPweFxyd-cjwLfU0JtlenhAVQ1E2HYHGYtZHQg&oe=6A2EB333"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Yh6Tgh7SdoQ7kNvwEoaXFE&_nc_oc=AdokiFPkbDW8CsxBvRVM5DtjrczHyxXCkdgzbRSSN83d_LX7XSLiSoTK0ahDeq8xq84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xvl2ZCL4q3DbNWI5R5OTayV-La8DXtKb6ZhPm0xBr2g&oe=6A2EC60F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89D_hdR_4xYQ7kNvwF6juxC&_nc_oc=Adrj7fK3g2I_9OopyxW6Sdu4Tishruqgedo6dhmmoKVUckRPTS2qrojO3byATRX0H1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A7TfvfthVIg2avXkRT8QVQ9svWw9jItvNohp_wgrtSA&oe=6A2EB54A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4oET9cu0vAQ7kNvwH5NZ5a&_nc_oc=AdrB62RrRaknkWyhjujL4Qb99ss2E_OYmkcgqACSUjMr47zIJrLeOe8FLbL6ns_Sd98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CuFDhf64DPfCYTNucjYd5TL-C2l-mjq46OFEP7oJTTw&oe=6A2ECF8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxA-vQOsPIoQ7kNvwERVw3C&_nc_oc=AdouHWowJAfROsxLtLHQ8uN-z4gciVcTW3dg2-kT-u54wiO3sNpAnP5FLoLOFj8w6_g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_3_AEru8qAlpnBzPyOebSUmv15sF2pyEp1W5e0oIWFg&oe=6A26D483"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odK_y39FqoMQ7kNvwFhO78N&_nc_oc=Adr8KwLOyAl40YU89lxCQaiCYvq7r1lns5DSbg4pEWzuECiw7K5fN8u4urgpCz5tHUk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vc0aJhYEcci4-ufPmPwB5OJqcE1d6XtvBwHYwdtW_aQ&oe=6A26CA33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngwcQJVcwh4Q7kNvwHgRQRk&_nc_oc=Adruz6aq_3qvNzboxdpY7CnAclW6apebx-yyxRsLWM8C63OhVH5kgu_bFSdKfTJcmw4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UvUeDT_33LFMm0xO5y6wyJN3FGoDRRYBPLhw8TH4VIQ&oe=6A26DD0F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFwITl2O8pAQ7kNvwH9GVOv&_nc_oc=AdqHes3C4Y0aGxFk0B1U9PDrKj4_YqaLXzprMTZHFEB_g3a1uEi7Ut2gIMBcH47ujMc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hUHJR5Yt91VBBH-m8lNdrD7Qi-NBIn_2vEy5f684n-g&oe=6A26CC4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ow9fyaJ-6DwQ7kNvwFqPD4i&_nc_oc=AdrDbaIhQlBYiwQMV9fNeo-b4YLo3VIFeQEs8Hj65yrsfY7RT2j2ar02d-lVSY4QVJY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lCkhVmrXEZEg7oXZE3qx6EeDSJeLl4nKCB7zfnFft7g&oe=6A26E68B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
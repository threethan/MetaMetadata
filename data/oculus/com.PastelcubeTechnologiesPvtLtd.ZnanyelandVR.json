ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIxWmzMIFPgQ7kNvwHrK1y4&_nc_oc=AdpF3HfGEkAVxlxTQwnOGycHnhd1HNWKY2_sDyAgdqngdbrO64gPIUT0otOJoVXaXN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76A-4TDd5-ptGr0NnIgCsaf2__n7Ik5ca3oOMnEgzEfw&oe=6A1EEB83"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJJvarZMbfkQ7kNvwHPqIV7&_nc_oc=AdrEmeTG5hiMPBT64RVMLZsFpDjqPgyXFXvNNb2DEsXqU5POrGpAZXqy_bP6buybniM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55Gtq07ZQS26AhwUQZgc7L2APOMXnuUEfjXXSFG7MSbw&oe=6A1EE133"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1hRL7XWN6IQ7kNvwFrBdsE&_nc_oc=AdoxsJC0erdYSDdj3O5iuS7b6dAwnMYgsGkqjy_IYeRNOiU4XrZc3wHkLD0_Svbr44I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n1EACzYhjQnCu9u-1zEO6_7NJta6iaXLN5FNeYJUOVA&oe=6A1EF40F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10vVJiGaq4sQ7kNvwHyMcFd&_nc_oc=AdqOxrEVgDGPgETV9xK4d-_VvQ_1WQs4jR44V5hYwCwecf8U95XgvHfG04nP0Qk1geE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eMpJX36NWiPswsXBMZLA8C-iwdtcwYasHBhfhO0G4yQ&oe=6A1EE34A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyKk4hdkR6MQ7kNvwGytZjv&_nc_oc=Adq6Lk9I_Elu7lTSLDSooiif2K6W4ltrhU8paK3wTWNDil-rZkAOaIv79k47SArN41U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hObD5Me62y4VpFXLN9zMy281Qx9eVPpdhBvijV2-naA&oe=6A1EFD8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
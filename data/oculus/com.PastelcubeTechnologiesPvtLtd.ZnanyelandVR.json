ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyDZ0QPr-BsQ7kNvwHYklCK&_nc_oc=Adppnyx68xOin8XkRD4bKPyUyTZ_s93R4TPukj4MijSGma9Mq4NHkJcQp9qTZFutWUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFXX_ezzwsVjOqvV7kSCQ1M3jyW3IJ0yDeGaLTUqfPvw&oe=6AA2C183"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA7OrgCw7TQQ7kNvwF9ytdA&_nc_oc=AdpfwtPRH_YFNvFG-qY8fSugkfefm1TgBIo4J0FsQCSY67EhSFgz3COv9drJ7AxdyVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZazyCPLe6E_csYfl6I7FIx78Aq4c9yTpRh9ZgYZ_ijg&oe=6AA2B733"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD5SEOBQ6LEQ7kNvwG1gHrc&_nc_oc=Adq--EvxXlVrtYVFLLG_alMLCKmS-aewp7ztjW76qb2ExST2nXACcvMC7F9laoVGA_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHG9HK6yKuusvIMaHeemYg4tRZ-ml5LoyldPsTUfWTQg&oe=6AA2CA0F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc0bDFwNdZ4Q7kNvwHloIam&_nc_oc=AdoF4XuLH9FZabyJlpfC3MStMeRIW_OF-QXTYVnZwtFa0e_7HLC4YaWW7M7xOIAdFT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3TXf7utdn7j0vu0XuK5unWLyp0P1W1gQ1B-MR0WgX6A&oe=6AA2B94A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvej5kUNwbsQ7kNvwEafg-h&_nc_oc=AdpF_odIas3g3TRz3ph5bTC817xG_EuDqzgQVDPwOhOwWrfRpm5_4zHIavmCCReKoxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISe4rCD_5UCySGNWZh3L8-3n_hxjGxQzAvR3xL4IAGxA&oe=6AA29B4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
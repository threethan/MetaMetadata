ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPfcTkt9mPIQ7kNvwGUe5_m&_nc_oc=Adp7C9178qTLqcZrQmEVnR5I4fqJ67yZBniiTK1CEq4iIkSKhnzoM_DBuwcSBC2-3jk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5WUbuvc2wIW_vCiZWTNWTkzmZ9PBrYuZPiZOL3kUPLg&oe=6AA80783"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5LBXUCUTOYQ7kNvwEO8ZGN&_nc_oc=AdpinOjW59mXwFA_xSLbdH0EF6r-SU0JHtYPfiVqDnM0rRxqbmCkc2ohHwJv6DQqt5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw_E2armIZeIB6WiQ7KPV7S5YCy0CQIZ5c7dMnA8_u6g&oe=6AA7FD33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScluUvkPtQ4Q7kNvwHw9xmY&_nc_oc=AdqrVCHQNI25xk3iAmgi9b3T_uYSqrQhg-svGS4RLHizq4YuBSBO07v-Q18y1KoR7JY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV4xRNo1ZB6Nn5NqeEF0t-imEir6JJByMpHXmKlKdhKw&oe=6AA8100F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGE16uPTDhUQ7kNvwEu2FHp&_nc_oc=Adr3hfY-2l22Jz3tW24-ed79pveQw6cKQGMpWKP1FWPi9BnahWy28eMAWkIFpgztLbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDD1GwkxvBFs3TD9M5Em3E8JCmVvBcFAWiWph5uJ8XFw&oe=6AA7FF4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VHbv-loTVgQ7kNvwGk9SlY&_nc_oc=Adoxwu7EWCvoi9Gc8Qr_2rekanmwwCAEXT3chCXJ7H82BJRrD-13L0TZ9P6wMTAfyc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5tOYUQYK9Dmkk8q4Dx5t-nnvywS9_fvUesHBsGZ1dHw&oe=6AA8198B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
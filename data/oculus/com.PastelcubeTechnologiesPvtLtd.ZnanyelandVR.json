ng", "id": "263957245555578", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qnXgt9RoFsQ7kNvwGpWbcr&_nc_oc=AdoCZXA4hoiDXDTxyGti9b6tRFCJuutRLPBsDH9Rph3Q4Q9LjP2TNr_GQpEfNDE0y3c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB-EcQupiF0iy0Qf5GOMXURGK2HwDklX5Nbw3wbPOmbg&oe=6A9408C3"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOzXFmBiNhQQ7kNvwFEEDCB&_nc_oc=Ado4Jnqu_wO9qA9DcmY2s5VC--krkLbF6aAjcIrH21V4eIyWu2931-N4B_x4ScW8WAI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFilqDIqFw_CRyNGK0i_GPQIQhJM56UX_HPmIPv1deMJg&oe=6A93FE73"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o88cX-WZxoIQ7kNvwGjsf_k&_nc_oc=AdpRxGh45CAmfenrSFtBxzU9eM_psOJQuzp2JjFs6IIVazCvIqqIrw-s6RaLu_85deA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF29pKkJQlmjd2LsQkCrpNeoyGX5izJ3S4SwiGGW8lUdg&oe=6A94114F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDUy5D550kMQ7kNvwFgKfRi&_nc_oc=AdojcuNURlaYSlF_hQcxW1aDiLP83VhaQLhMASAJBCQxa-9UWq-wD-55cnzhSKBHRQI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYs1cf3BTkprVY7JjBf-MvjH_7fCp1BA-3oHaTcBKRmQ&oe=6A94008A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWCTuDqfyHgQ7kNvwF-Vfvg&_nc_oc=AdqC-zZ_0B537B4yKqbDDRun8Cz-yA202bTuW3iM4-OUa3_I_82C3l3vB43fCSlQ-iY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5Gqsr-squKQ5KhTNwoXVfvf2efQcY-V8rAVV5O-VkQw&oe=6A941ACB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
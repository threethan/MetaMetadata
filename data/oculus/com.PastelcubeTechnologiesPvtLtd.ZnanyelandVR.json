ng", "id": "263957245555578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02T_Xr5CM5sQ7kNvwGylLXl&_nc_oc=AdqYdAWBmnwjvxm4gxxzQULjL-BD0MfLxECza8xui4E8uov4iv_COEVD3IBjYymVKPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgt8GNSqtskjFoXV5BHRE__STlkDemvgbSFVcW-_I-ng&oe=6ACBA003"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIfNAO0vnx8Q7kNvwECp12W&_nc_oc=Adr-XqsJ_a6w5uB8AhG-rF8n_jWkVNrZHMShLrMY5EMaWGAwvjIvFzcCDRUiBn59ghE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQALb4DZ9N1Ih4kgzROGUrKvmHzvsiavevfo5PyC8gHQ&oe=6ACB95B3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lt2ymV_Dp7sQ7kNvwHlfSeO&_nc_oc=AdripvdvStaP_kHwVIzyyLBl6Ff0kiAE3UpjesHlqfWv55ORItcSICY-YaUi2C4QoI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUVhf4IpMXsy3ZLpocuKPYLdvka3VHbvVIgWhP9TuclA&oe=6ACBA88F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObLb7PXIldwQ7kNvwH3ByZg&_nc_oc=Adq7gQG6d9KlLzzYNGyegbgAq6mp7CjJY0kK1JC8WAdDsBq12eLONGQg16nm6SaU3cM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRbCKro0hTRndyE_7BxE7Yb9OjCu-9KY3snsR15Z6z3A&oe=6ACB97CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgeghgiGr7IQ7kNvwHs06BF&_nc_oc=AdrLeYvDfXTSY7-08fcuXQjXfe-4wJR_VLU9RIVOwMejkuktL2MCQ504EVdNNpE7DkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODUHHNEEVsAhOo90zKVpmqAK9usB6yk_SNtVS8nsUYEw&oe=6ACBB20B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxI7wwUldv0Q7kNvwFHq9nQ&_nc_oc=AdryaOIww7DCmmh66ANflCzsi_D2zsE2vwNXxl7_0MVpqNXYYSEqrAYR_7CnIADJ_Sk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl3ZDClNd2nfAmlLrL0bftM-tnOoBR3ZaTJQHM2Vfqyg&oe=6A774003"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I21rHlOWQwMQ7kNvwHPcO4E&_nc_oc=Ado0tEDg05b0K0XsvnPXkvOMUKmQIvwvwAIanjB7XHiEGf7Dps06e1cbuIjrCp02MeY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8nrCrfdXhENGSIe-MDR4ZoZxO7Y01P1IURNRuVR45EQ&oe=6A7735B3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewVFu-Mf5CwQ7kNvwGXTAz1&_nc_oc=Adr7Qp2_diCLcZ0ZUBBdanHKAVrqqZ91ImjUXlMlXFd4e02d9XNe_0F0HRJCpnrLFzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF68Ek2KlOvYy7cOW0Sj2-QAN28goe7hFKkNJ0_ypGIQ&oe=6A77104F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60V7NiYaWnEQ7kNvwEs0HMn&_nc_oc=AdqUfDinkJ3ZNzgMIT6SNsNc4teS_3nqdWm_Z-Ce7QoD5iUp2d6krFbz3-msmWEkIm4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaqoDw_36_eQ2X-jCPyZxqaiEdOf25zHArq14hsKAmFQ&oe=6A7737CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSj5cLKnY8wQ7kNvwFD_NWy&_nc_oc=AdrmaQPqwnIpnCvH1tutk4SRFSBaoZy4-00UKXVUGbEItUeNLXGO3EdnQS_fqXAGeUs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO8TGcNAiwVE052Zj8xmpb0nlsHxiKiy5Z6vq-BMor_A&oe=6A7719CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3hS0kOFZ84Q7kNvwEQpTB0&_nc_oc=Adq2o3lN7XU5Of2gWuOnpfpertsGnNezZ5o6UT5Szlo7kQrQzDb_ascyRuZ_qm_qLtk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JU7thvacaJu81Mgpnne_oFV-rP-Xfi47x-KaN8f6lJw&oe=69F36A03"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8Xc0T9a6iAQ7kNvwEARDnN&_nc_oc=AdpZ5n-ZMF7ZxDn5GA8em3VDp0FNnAdK6SMGiOQlBuX6R6cheD1igHKqImbNAvUdKus&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18bnI0NgXDLoUPBVfrBhzDVdJic9Y2IR6Dkn_aPvTSEQ&oe=69F35FB3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCaAvMwVVw4Q7kNvwEGvgzo&_nc_oc=Ado6rcK_JbCyQclsS-J8zIEuwZpOAQWkwwY8VWq7WR3CdsYS5ORZkWL9vMEbwp6i6Yk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3C4WfmWjRVqRQU9-DEqJQ4bB_Ff0-29MCGfytsxT_noA&oe=69F3728F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wJDezW8NfEQ7kNvwHhIohk&_nc_oc=AdpkNcLhHiL4gC_la8QBM-ptp6XGrBj9trvBxqrYozy6As1dcMt6XolLMteMpu6_fQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ca9SHvBmjjoHC8fNJUIHqoZvg8X_UOM2ZBh_bEj-9sw&oe=69F361CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeQ_a9SMx4wQ7kNvwHTqmXi&_nc_oc=Adr5HGd2waS-r6TP1Yp94jbhTnbQRxxLrse76Yx8WaWv5PqJStY_3_HyOZT8Uf95PXI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05tFteyoaUIEcSm75x8sYIXbRaZE_kkm7XU5QVQf6OEg&oe=69F343CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PQZa7rYk3YQ7kNvwGgK2vw&_nc_oc=AdozCqv1uHRtvhzagL65JQacGOvby9yTRaPgjkAU0slkfPDI9BBcRVyIhhRJXHhcOzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbZ1G4F42Hb0_kCpWIh9RhmUnCSwfX3Zd5GTOmm_I1Cw&oe=6AEDE703"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpK42w287LoQ7kNvwGbQ8mN&_nc_oc=Adqg9k6uvFmekK7KvmyA1sITi8O4S9l2F9KARHV2toR0JfGlSTOlLN7ZTyrYSNAZKac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbjs4WyUCkuFkqWL25K0xZaH67IOqVYFWJR6_DHCADRw&oe=6AEDDCB3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KimDZ09vgcIQ7kNvwFPeS5y&_nc_oc=AdrjFUx5M9mCowv8-HN1jPvGWXb19jbIOYHxFE_Ozj55jYnfPRXUUiY6fOxvaystHEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToHyE0GeCPReBGg4dqP36Dck3oRn-iWGwULRFaXi_mrA&oe=6AEDEF8F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbZuD8HaNVYQ7kNvwG6czFf&_nc_oc=Adqy_XeuHY9HAqhHIVNx15U-c32knOnC2KoAalOCKDemtxpzx4MU2HF1HOBvBqIZfys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZyOIBTSD5AcJ1TQuL_30lVzINnAk29BW1nqnJYgWrrQ&oe=6AEDDECA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0VAHVtgDV0Q7kNvwF9p554&_nc_oc=AdpJOKP0dMRo7a9y50CeksfFQILMFK_Vne99dUFgUklnFDZ3pDrb62MYa92leMK2BRE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYYxtbe_LKal3w-OdDkiW-HfXWLiBKz1SlRJE4ee_Liw&oe=6AEDF90B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
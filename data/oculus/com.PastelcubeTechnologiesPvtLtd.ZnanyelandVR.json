ng", "id": "263957245555578", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hZGJFaq160Q7kNvwGTxMNU&_nc_oc=AdqI5sq5O32IIOz5QiTHcxhJ1tX1pkrWqGQlYaWKAsgOvGrf5PjLeEIESehtRfEG0hA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZo31Q701gNo8T9dwzdLwgeZ_a91-9z6iP5gXf1xLo1Q&oe=6AE20983"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUSx7kEp6QUQ7kNvwH-xGjC&_nc_oc=Adr7mShOMs9uTE5HgSG2YHewrxaouTSkkXa9egHg5PJ3iT3tBoFvOskxuK_XU7Qeq8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEesg3PLdQgEP_lsrS84VdRiXdq1x5MMArc0nNydoXmA&oe=6AE1FF33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGJwTBSsDtUQ7kNvwGyu-Aw&_nc_oc=AdoNlhD8mAwud0tqODrCeLvXLUhf5aGJDqBeCoIzXVX1XObsdZuAVeH2_qH122sdSPM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYIHHPlk5OpozRWKidZ82iSjzFTlZqQYZJHVNy2ZDkRw&oe=6AE2120F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkGjU_55pOUQ7kNvwHLREzp&_nc_oc=AdruAy3q6cEcXL7fxhRluW0M5wVuS7YCwTtLofsopURfrrAeAxWiaRSJ2xRKVSAIGEo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7jjmq-QSVo75AvpIW_9m52sUJDQQiTxD7gEsnDOcRcw&oe=6AE2014A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAyPiCS6od8Q7kNvwGLv7aq&_nc_oc=AdpZkFDt60HYuhC-ilMDeAJUACn4KtqRcM8d9FnQSYXgx8oBJxHQnmb9FIOEbmMKYx0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCDnY8LJa0ruYhho6njKmI5XxuB6wCudRtITeLPyxFqA&oe=6AE21B8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
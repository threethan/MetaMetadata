ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErP_luKw7FYQ7kNvwGNUZl6&_nc_oc=Adp3tdh9h6VE1Zw-GcmU6oe83138FB10gc-Guzri_px4WwL_gbfeNatGBI11h_WCoHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d60b5ipevHN4um_9nakVBdKSGsrVTLLm-hCM6CQNNqw&oe=6A3BEC83"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPpA0Xfp4P8Q7kNvwFiu9k-&_nc_oc=Adp3mPxZyC3ASlv3ON37CeoFF2HaQMt5_o4jIRuO4tHx7TymPgpA95sxi55QcVBaTbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u6pDJY9fQGmmq5Kcj4L2LPacKR_-LB0VCMM6lzwAtBA&oe=6A3BE233"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_I3HbWm3m8Q7kNvwH6XF-O&_nc_oc=Adp85FDirvHlUQfPCwjx7OW81Zuz2RY5bTN2Kxjkz5jxa2DczoxjYkh8ai98u6LrNOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m5I2O0fpWpHx1AHJk2mTXjMDLzz7XPAa20l85SM-GBg&oe=6A3BF50F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xTjEX5LrxkQ7kNvwGdwQxF&_nc_oc=Adr5_zsndV2_gNZsqFx6jIqlzDj6WS5izH2fK4SmphL3qSmEA3Lsmxl6RgAJpIXafn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JHfNxMSKfVK07AivJIeH5lBDac31CfSx9IsVPKMAvLg&oe=6A3BE44A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkQBCAhgd0kQ7kNvwFWKl9H&_nc_oc=AdoVlvQA0ucvhRh3y9n0hU6-y4PH1Cd3pyTHyO33ABwsFWV3uAW43-PKNJ4WkxKunQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TFB2BYHIPim3jRTtl9ype0zs8z30YuSkR6-sWeX2n4A&oe=6A3BFE8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFOJ-dE5lhYQ7kNvwGc2LK7&_nc_oc=AdpK6uIxtyCv_2xIzw70C1Eg9s6n7QnVp7pYbcIij7nnEnZb_O6lW0t_ockMwUm_bfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-7fxfrlHypChPHXMLW4PUYMErfOHMo5oqgJxkDCwpTw&oe=6A70A883"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjuMfH3tnRgQ7kNvwFqnvyh&_nc_oc=Ado9tloKkiOsaCaDQRfZQ616C-chHbSZDpCoJpzEwR0jS6mdA_HfxoSoKl183Y_L6N4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqhVok-SX5M7Isw2Wej488xio_PDxnUgxFUr3K67gfuQ&oe=6A709E33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtZ-zJJykb8Q7kNvwGZ0mEP&_nc_oc=AdpCntcE8tjMeLIrLHzIQy9XwCghLcq8vqVOllQMgCtwULYodbzFTDw5CmYnefF4jgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7TzCKN3gDlE2wbCBoulR8KtyuUFlAlM8VJ3n71qAa9w&oe=6A7078CF"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHV_QbX1mzoQ7kNvwF-_s9T&_nc_oc=Adq1oLdr27NVB_0LxhKfYGl4B9xeIjQAQ3AHlGxlG1j3A9JLfu_NxwEBE84rmykrsSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO35CiTYgKUhh-ansxbwVIV9HR4TjlnIO7_9Oj3b4X6A&oe=6A70A04A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ5URTZrJ-AQ7kNvwEmO_7v&_nc_oc=AdoeZM_vQvqfcgi9Kfxo8mkMVyDvgv-PHxEnrNpdvUPzqfjbd_Xm1BXatkrRtwTAGQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVVCneEaNxJaYC-nIGlw4h4obodCPlydICDjVFioOFmQ&oe=6A70824B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
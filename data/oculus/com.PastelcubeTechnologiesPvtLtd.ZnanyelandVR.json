ng", "id": "263957245555578", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qnXgt9RoFsQ7kNvwHDv0QG&_nc_oc=AdonYnqATSSoyK7oOdbTgZZHvSUH_mSEK6wGLBzHS_Ax5Ss3qlFvHzwT2ZP3evkqGzI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsa-V1SWpGqStIBf4CbSpu2AyRHAPXfI5bJGi2cwpDjw&oe=6A9165C3"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nd7Y_OtX4E8Q7kNvwHuu_6A&_nc_oc=AdoNrQCNOrmJklDa3iwlzMeVCo9B7HvfPMEcvhXzs9n4V9PDOPjm76W1s7CbwSf5sLA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoyV9sWfBlJz5X4CHDOaMUDwbIY_n-OpYJcrpFe8PVGA&oe=6A915B73"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o88cX-WZxoIQ7kNvwEITMPE&_nc_oc=Adoy3pyrZgKVYXJ2ew2kZISJ7LmndrS8sPqrkHfLB5NzdYWGMTV3Zu307mD4rhISzAc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWMVCo-Yj1raAiOph1Wx6WEtfbDBowlWzG85Zu44TJiA&oe=6A916E4F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUfApXMFiMUQ7kNvwE-9kJa&_nc_oc=AdrUfM5PG8oh1grhdzS7ueRxjxQxzYMGVM3hYPK_QQD9wjxQT-ccjpUUZd9bRV7Dqoc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHlUEcSjBJ5ZwHW74zn0BxdzpEmo9AcvG3JT5sSVXSuA&oe=6A915D8A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbLhjku9ImUQ7kNvwFmxFL7&_nc_oc=Adpr4cEAtYncMMl024FFkFKxS6jI_J1WtxGn17VEOz70pI400tNHjw5vpyb0gkEDvc8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZTlPCgxRRW2mobBOKsmkdccc-2_Y5C9Hyg0IaKzQ30g&oe=6A9177CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O11omzH_d9cQ7kNvwESQoxJ&_nc_oc=AdpDh_jAxv-P7b5sBYpV2d3yKcMrfknv347w4OncfpOy_aVZC3K2DVsvWtGhOFhZumI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIVc5rAhBSg6lpOK3uHP38Rl1H4LCSyYle4flySeKqiA&oe=6AB53683"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g20fFByyIVwQ7kNvwE1-Ry5&_nc_oc=AdrbnHSWnCbFDrF8DYuXqfv2s9hxds6yw8NTtF8Q6suI0WtRO-ZzBd0C4ADBr7xRQXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8R02R8QxYQ7vK_6oxmoiPP6jGNl7FLMwOua2yI1WRxA&oe=6AB52C33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JpJ8xMAIKYQ7kNvwGnshzb&_nc_oc=Adrz1D0o8rKIyLSyM_ruLv944r-ifU2dy_ECaP4QGcDUxIRHYX57bWXuy442YO77JbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY7t0BStuARbCmyEKxtuwTMMmjn0oMAR7FfGmYWer_AQ&oe=6AB53F0F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj-CjQjF8pcQ7kNvwFqCfo-&_nc_oc=Ado8o1aQxq3UDUzu2DwmdxHkZVA-sH3IvrzhWGtbdBS8EXHtBPjaV02TNwkIIgGV82Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7sG7m6K5F8Jovs_aTdhKlLncuPW1Mf_32qPR70Id8qQ&oe=6AB52E4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_EozHR40I8Q7kNvwHn_38J&_nc_oc=AdoFAw7sRNpy1KU4LILmVrQhzsXKSeU9jjaYONPXp179vcFnmvFp1pwMTAQNqcY23eQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSCHQyY1Zq-HA4cCXLNOfmVfmSvPL3KN1yUoxarc3_Nw&oe=6AB5488B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
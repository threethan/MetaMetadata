6e7a0a&_nc_ohc=fGJwTBSsDtUQ7kNvwFXu-tu&_nc_oc=AdoHUjj1M7R-wIeqhjYhOcGW3gGFAlC9CeBAx8YJt3BVvOlPktw1WgHIfI6mSe8rLL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnEFoJy0NxIu64mHW0GR4V28vJ7e3T487sifoXwlTQlg&oe=6AE0C08F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXXmby0jsgEQ7kNvwH5DlIK&_nc_oc=AdpG07RvdGYYkfO_xQBe3ASItQhS6bgzPwZBw4vYIACnNunbIema5mrcAKtGEiwhIQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkcUhZ5OZYFHOE4iGK6IAHboHz3u4x5R2DeKErREmE7Q&oe=6AE0AFCA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAyPiCS6od8Q7kNvwG4TU2p&_nc_oc=AdoOiRl8F4K8C2kF3FETBm-7OrEmj86HmqawczXx5KqagBgo76NPYe23dziC1FgyjRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZeimJ7oXl20jKDRTQ_oXFIL6aLzGmSrEvGhD3pQ2Kcg&oe=6AE0CA0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485808706246593"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "315060623836191"}]}, "baseline_offer": {"id": "315060623836191"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1641486360, "status": "PUBLISHED", "id": "315060623836191"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4394567780643173", "version": "3.8.3"}, "id": "1010468283113230", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3701432673290024", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4394567780643
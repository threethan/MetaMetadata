ng", "id": "263957245555578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ESdR5ZuRpsQ7kNvwHYEGz0&_nc_oc=Adon4PfXm6DzNC3qXypheffGzlq-9L5Fjqnak7QH4O_DtINM_5nKytSKFcB7gDmAe1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9WFTdxpQatmYW7vMa7Eq7kuIk0Ec_iPCdy6-vdm2ICQ&oe=69C93A03"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAmtzh4JryMQ7kNvwE-UCeR&_nc_oc=AdrG8uvNF28eFGtExGBpP-_1sT4iyQi1FSzgSYfntnzVmw7j_L9R8OzRNQcv7kay38M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-3T5HKD5ZPfvrqBtgVbsSDYjFRPB7DNFetjnWyh_oJg&oe=69C92FB3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a53OBJQZ02YQ7kNvwHIgpvg&_nc_oc=AdpdmTAyIQjxE5W1I9F6b2gFzoElgi5QA15zB8jknpPTgldcZ5NOQ3qqcb1pICu1zAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLKIrYjlK__S-TdqewbOwkP-EH7RI7CtbKPIZ2YL8ocA&oe=69C90A4F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJmmG7TUCbIQ7kNvwFU67rY&_nc_oc=Adp2Dp17uoDyhMAPn4gu7hlkOR3BvMJEVhuF12_NvMzO7yYNKNhpkNDrg-bEMYy0kNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV9yjOx-l5n22y-psGI39ztIm4j_1KJUzHLhGnOBJZIA&oe=69C931CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKUgeCD5E5QQ7kNvwHEdlAK&_nc_oc=AdrkuX4FQ7xf5ZkVvQrv2y-xV3f0kuNsOi7fQ3DUf1gWG-X1T7hWP3KyZT0vj3Q2928&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywceYZhDi_Qf3r-EYWVQZlBkW8tb-bSk0kElZpoCTT8g&oe=69C913CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
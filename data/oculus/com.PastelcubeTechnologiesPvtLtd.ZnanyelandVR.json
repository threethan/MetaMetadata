ng", "id": "263957245555578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkBFo5uLYvYQ7kNvwHfDNq_&_nc_oc=Adrntjt-XZGgg_5utIinNqyvhSKYyiiVyehnaB8iKzEnzv3NOskw9ZAHwqMKBo7_XDQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAONeIGgr3VaFlFFjX2hcUUHL9Ti1lptGsC95x2MG5PqQ&oe=6A5CE203"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeLlgorFDbIQ7kNvwFvjHV3&_nc_oc=AdobGDk3XTVerASiYkPrul4nJIb8zD-BGx7Uy2rE_NHJYObKGRX3YNxhG5OHeYbPKhg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAotTpwmPhxvlb9U-_AldR5-FsqY83B9sObhPlN2eQqPQ&oe=6A5CD7B3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmTjrp6zUvkQ7kNvwFrLciH&_nc_oc=AdrSJF6ogEcOGU8VjaKpiFpumI3DuOmXnmZs9sKRbPOVNkpS5LsjUL3zEIoAlv4VR4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjpKAGSM5RHcWeqo8YbE2s3kD93gRXDHmiX8NBD6rAhg&oe=6A5CB24F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNjcydm-lSAQ7kNvwE8C2ku&_nc_oc=AdoGf2N8pVaqpUF4bonMzNoFuM2EqQwU_cLZ5vTA0Ytj4w7g2dsUJuTGj_uvvliGJEQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPwo4F7UmOiStL8KGLYrXHwG02eS1M3mgPClnItKtPYg&oe=6A5CD9CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0qFLMPA_3UQ7kNvwFebqnP&_nc_oc=AdqqT-WBe7FCkyI5e59rPyZNP0JUgQrgWLVV7sOxts6rGTxB0eoGB5IczzmYfyR4als&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZIvgrFtDsX7Aek5xVME0WdfXrZWog5KRdk_jO5r79PQ&oe=6A5CBBCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uwLRxd-s5YQ7kNvwE0b6kp&_nc_oc=Adofu7Ln0KC48LnH2VejpFwRdnQYA9dIHgZ_Z__4_92rox0dpjuFvcH2YJvsft1-Ims&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM82gj4I5yquAjl7qQ8xisT70HrjpluTUIlPC3jr1Pflw&oe=6AD38903"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4yIDWD7XS8Q7kNvwGcnEqa&_nc_oc=Adrc9Z4w8IuHPQXfQhHlQ2_stSZtHSPkjJkGj4_lx5CadDaOm80WVjyh9w0WnrAKq6E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfoPCd6LvcItz1jOvfQD1aa8GeBA46sel64U-9NkWD5g&oe=6AD3B6F3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBxgJUOcKEUQ7kNvwFxea4U&_nc_oc=AdqUJRcYn8n4nis7DtmyHI0FuYU2TbqDlVkv9xqvTHQ5KYGNOxer8HK-zDlOQnpoclM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9BG6r6hXUjZhaCY_U3MOO-WfRGALjy2_Z4nD2L1ZKOQ&oe=6AD3918F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZUskmBS8bwQ7kNvwGW7yaR&_nc_oc=AdpNI__p5SEqDBwzSso47DgDkupYmZnwX9r0eTByHUEWZCf8bVErf9yFoOkpp9Fvkq4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBV4yJ7AgXun1BSur8mdwMC1yfNQpjlScFqk_iSOZ7fg&oe=6AD3B90A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHxSCYOVWEwQ7kNvwHlPGZX&_nc_oc=AdobShiPEIaBhJMNrXXYZmkweXApL9ChVQQxgorWfP2wjI5I6nlCpAWXdOjgcLFVL5k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYSY9rnbslV55YsBJgCNiTYiRop2S1gjb_5Q-PBzMbHA&oe=6AD39B0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
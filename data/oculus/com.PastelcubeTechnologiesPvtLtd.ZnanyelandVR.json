ng", "id": "263957245555578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFOJ-dE5lhYQ7kNvwF8bW0l&_nc_oc=AdpqEBwE-546s4PpmByBiUCyGvwpfaBFLjh592TtxFi_L8Zzvgd4MTiJsSq4We7wYzo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaIGB7GIl8t0st-JVbGO-vAztXRutucnDBs6zV6ELkYA&oe=6A6E0583"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6CXrP0waToQ7kNvwHw50oN&_nc_oc=Adp4Sjr7Yj0S9tEUkL4iR6T59E1n2-qbeaEPsU8B3G-IHIR97iSjfb37u0AhsnZ2RVI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvyQSJ5YdTCPdSA_dvYg8lOp9nHWNeufQydlrbfkQf1g&oe=6A6DFB33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtZ-zJJykb8Q7kNvwFQCpAI&_nc_oc=Adqetm9nFTNaQdoLO2qCYQkIhED_HJKgHIgfbzikmhldU5ji2EaBKXhXyRgqrETaAtc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7KIJdq8cmGONeQzPZMku_IHA6z84nwjee64tb4YYrmA&oe=6A6DD5CF"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yi-N-Zqxmz4Q7kNvwEoiDLI&_nc_oc=AdoTVmkhvdAVA5U0QQZfrwKbxHpfBFB3kZG-guxtcz0-fSv1N1WmzA4i33Hiqkz6qy0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf7bYKJSJEp2jrqISMUfYj0gJqNaAap0eoM9uZdhO00A&oe=6A6DFD4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28ihmwgDf1gQ7kNvwHGRsLv&_nc_oc=AdpJ28dMPIWKGGTPIUKO0EglyCDBlvO3SQFcFXsabxHwRHx8Kxa1RSEFjapOHye6wkw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoVErt9e88rj9QVQagY8etCberkwBqsevwuUvpTAujhA&oe=6A6DDF4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
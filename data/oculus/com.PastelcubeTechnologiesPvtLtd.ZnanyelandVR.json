ng", "id": "263957245555578", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_LDUEzIUzIQ7kNvwHNL-D7&_nc_oc=AdoBVFFYaOOFRXjHK4POcsa63uRUJvgU756ut9rAXHMwYs5krvA_ihNGxnzmzkfhrwg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmU-sMNLIYiwj3B789ehhv6CYyfAUMGjdhFFOd_rT0oQ&oe=6A661C83"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHHb-9aBMIIQ7kNvwH0W212&_nc_oc=Adr4nIL1AbnG-5KMUwznAzWSlHZkUieGv8KgHKFITpI0-qzfq0KLgPyDD1ley2RsAPY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApksaM86c90T3T_lphCIa22rvB78CZJXpE1KRb5rEzSQ&oe=6A661233"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7eZM_JgHGsQ7kNvwFE_6NP&_nc_oc=Adr4QdrkOUF5BLJzq7eznaNifzxivXXW9azaXnyPIXbNO5u4qkqVub4i8w_kteYUFkA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhkLby5wfT6q8rfMXYfE_GKIG0NlIXwBDFq8NWMeLu9w&oe=6A66250F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ4e16MBZrYQ7kNvwFoyJN_&_nc_oc=Adr1u2J8sxgO36d9rDen1pECmh42eba1dT_48VpNMxwF_sIfpjMfQlyjp9S3CKvJcVg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLIssRV0__PP7ODn-lnaLL91VW53AQ8uhAJIHbes5pEw&oe=6A66144A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9_5YUn4HwkQ7kNvwFGhxoi&_nc_oc=Adpe9p_9lubeNzOZpJMaOL__RheYLtYFPBPCXYY3kd8EWJXpK7fFw47qo2yg1Az8zRw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5huqGbh8t6DgUWvdCJLyGGEiulLaY5I9uBYnOMaJ_Dw&oe=6A65F64B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
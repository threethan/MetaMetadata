ng", "id": "263957245555578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2KtmOl9yFEQ7kNvwGTeqmo&_nc_oc=AdoTMfQup7SVBpNbgP2ahGsvb_zwELHAeG2Bn0dlnjDf6fzUutEAuxH9OzBAlcjQnYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rOCqsL_cgmo_thGYVff8pwJ3TaRv7szFOVZ4AwP6NXw&oe=6A1D9A03"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJJvarZMbfkQ7kNvwG3f2C4&_nc_oc=Adq9EIXF87QlsVwkHism3z94IgYvPqgvHJbcvivhUvUSTNMHcjBR4YDX_LZCUmkmCco&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dCQ-9DRJBpRntdhP_Q2xsYliH_FCvVc-FeS-I8zRw3g&oe=6A1D8FB3"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnC0un_61wgQ7kNvwGQwqmc&_nc_oc=AdrVOMRGqzzEllzZatxyotVHBipajouEErc9HdluhsS1I1oyiUJca8Pls9vgkQ0hcI4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X3s1La8ubeaP7eYQIQzg9_2Qq_0k6s_lO1he1letnkw&oe=6A1DA28F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10vVJiGaq4sQ7kNvwGuXmZX&_nc_oc=Adp9m7DBqu13mJ5l7BzhuuZw4jHrUue5Ur5gEgcKpnXK4Amzwp-ApWOk9mbxIUg6lbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nu41rr0Lf73ZM11INgxvHGF1-qyeCOrvY-Mb00OxMFw&oe=6A1D91CA"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyKk4hdkR6MQ7kNvwEqOx7h&_nc_oc=AdpDiDQmbc6yeuryJo8_-zP88JmU5S1SttchAx5-HaeDfaObOFloNfccxpXQvTFm-Jk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m4zz-Oa9cpzsFqWik-vV6RL1zoMUgkO2tOMCeyMfX0w&oe=6A1DAC0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
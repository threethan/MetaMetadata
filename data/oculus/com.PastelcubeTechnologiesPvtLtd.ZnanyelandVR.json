ng", "id": "263957245555578", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PQZa7rYk3YQ7kNvwEvfsvH&_nc_oc=AdoGcdlwVpE6nhmIo218tilAzb5Vz3WkqEfcnkq-0RInxP1AXs8rO7C88sUvcEs-CZY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZAS-gKPD1jE5N6EEzsltbFV33OAZf34-6lDe9IkiN2g&oe=6AEC9583"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_daddgtkAZ8Q7kNvwF1Dvwm&_nc_oc=AdqAhv6wM_aWowLRirKTpfvFgtmnOQa-erGZPjKmJIaQ5tfakEEcdihD4qLgmhWKOI4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcCnSYxZHNfMAW60VHSC3T146h7cu3anLYGMrJ7_E4JQ&oe=6AEC8B33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KimDZ09vgcIQ7kNvwG2WGX2&_nc_oc=AdohccIgpFL8M1YDPlLwRtYiJkMQtHEjsv5-fZ4JHvel_m4tkWL5lxy1lQzkIqho1rM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuMZSZNfdKO2bKjHYytl2Wf6aRAvPb3ogF_4z9Wcbqog&oe=6AEC9E0F"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXkkaELff5EQ7kNvwFIT9DS&_nc_oc=AdqWWGigelaWv9QqrFmwWI8bS58FQDlXlcjxIdNIdhiu86o5ZYfzjHYNEy_XKR4gHhg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjCwD5c3rXSGCmsjsBLhpSm0EKOxFUbhmmOulmuRMgyQ&oe=6AEC8D4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0VAHVtgDV0Q7kNvwG-y-PF&_nc_oc=AdrvMObOFdYMOp-W4GDWzs-ERj1928NwQ7uxHgR5NGnKCiHij4GfYwJU7Hv2AbxvEIw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQKY7hwov8mXd0n_cZvv9ym-xPm8u0al17tLsr8hqarw&oe=6AECA78B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ng", "id": "263957245555578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_263957248888911_8459651020162402875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvXcFcr67X8Q7kNvwFrA7_1&_nc_oc=AdrNEh4rCPPp39-nOdg9fBAcBnUcd4LQ9-L8iPhuBRQjQSNqbIBEz5B4h-q1MaRlIZ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyuYGN3imQ_9vRd4eso76lM0NjQQzj4q6d27Dik1SthA&oe=69C54583"}, {"file_name": "water_slide_2560 x 1440_02.png", "id": "165513522379614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221319_165513525712947_2841498462690526863_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_eMY-E71yQQ7kNvwG9CVrN&_nc_oc=AdqeqPmlKl6cnQpnPafyj9MLN2qIVjR8NYfI5WFIEUHaaRN2UVifaDKLyOONaLE09Sw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4rnQUcZluENjjzSbMVmlFCevC8HfE3YzJnpbLzuirCA&oe=69C53B33"}, {"file_name": "Air_tight_prop_2560 x 1440.png", "id": "166315028955797", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031650_166315032289130_2244304697768548176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HSZzXfGvwEQ7kNvwGkz7KM&_nc_oc=AdofhXTrJP2MA5vHi9S3hlKIp6sfgdzpCUmnjYXfjItt_2HnTWP1XcCHnTlvVCAlSE4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkfCuZFlRHuCgufYTn04p0mO3I9sQ_pt7ujc1DBeX-eA&oe=69C515CF"}, {"file_name": "Burger_shop_2560 x 1440_01.png", "id": "535768374327280", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974480_535768377660613_1618898375524883118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYFmvd1iOXcQ7kNvwGiMRFT&_nc_oc=AdrtLSeWnI_MFJXPq4BTMdnVngXFshMKLwcQXu1XJJg_xvgvjXsQngb_UA_6KCCDEjk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwjhfz7AXe2k7QmJPPHjgVpqpAqFDNYWLkUVyfRiEaIzg&oe=69C53D4A"}, {"file_name": "umbrella.png", "id": "268884725149329", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001663_268884728482662_9148176858968514575_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwMZmMiJwq8Q7kNvwGbQ910&_nc_oc=AdpVgx67_xC6YD8S4Yk82aH2GGhsSDpj_kZyM1hFkzEUheYGMAIVq5Npj4NCrnQ8gMU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhhNWB6XRXsXHIQWkS0QagUo2mQPN7dh9m3b5r2ooSNg&oe=69C51F4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Znanyeland - VR ", "keywords": [], "long_description": "Znanyeland is a virtual theme park, to provide a safe and cost-free theme park experience.\nImmerse yourself in a virtual game and discover a world of limitless possibilities brimming with fun and excitement. \nEnjoy the thrills and enchantment of a theme park from the comfort of your own home. \nFrom the joys of a rollercoaster ride to levitating water slides, Znanyeland is the safest way to relish the excitement of a theme park. \nThere is something for everyone! Get nostalgic and savour the thrill of it all. hop on and take a ride!", "short_description": "In these ever-changing times, we believe that everyone should be able to enjoy a theme park experience without having to leave their homes. \nZnanyeland is a specially designed virtual theme park, tailored to accomplish just that. Our goal is to design this carnival with a safe environment to enjoy a theme park experience at the comfort of their own homes.\n It's also entirely free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.znanye.com/#", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.znanye.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
.5771-25/38974864_407876667025840_8011676309595829553_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxGHig7MtBAQ7kNvwGJw_I7&_nc_oc=AdpD9FCLrxRnykeJQLxO5gglCHocb2ipZLzSm7oA8t2vjHJzIeYB01cVnKXTTrwbUfI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K_AuexKVOKPOaEsyrMXYnH2nnBr19tb0hy4IlfasB9A&oe=69E61F7E"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1UdBEg2zXMQ7kNvwH-rcRI&_nc_oc=Adql2e0nosZcsZVJJqlrRtTIvNNx7azzmUw-iKy0AlFE8OX9lMxv_YQL0I1MHcOifVo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dw-8fGwC-NdA9sA0dhL2BDspsUAtD4l8aoj0ZEm_9zQ&oe=69E632FE"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pevyynkJu-cQ7kNvwGdCvLF&_nc_oc=Adof9xsNmml0R5s0ULdJV9a64jQfD8q2CYlwmturTP57cb6lmQkdN8bZcr79Pw9YLSw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IJdL1sXRQhR-2iN1Px8qQNRdNSIAwSQndmjKz_Ai4MQ&oe=69E61DE4"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRzSbqkuoawQ7kNvwHEO1aJ&_nc_oc=AdqDi4LPXd9nD8aryWXC9UZvir73wn76p7lOWDqjGccSZlaQ0Q0mpc9mDlI-iXEAK6k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VuVdvlbikpF8yPIBb0MMiXPDSn2DXsskNow13nGGpIQ&oe=69E6220B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Funomena, Inc", "support_website_url": null, "website_url": "https://luna.funomena.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "691325098529151"}, "review_mess
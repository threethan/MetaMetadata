m_nQL0-XRwQ7kNvwEeofBP&_nc_oc=AdmtQoRSGyGIoTioqAnpfhX41oFBiUc83U_FINs3tnqolKg6EabBMfuLBEKgT_Gfnk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1555o5H6xxlnqrqdlqsAmcQRCszLmUx1N_j6RFrpvkg&oe=69A03FFE"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHPDoGY_8LIQ7kNvwGSklQ_&_nc_oc=Adkh84GdBRDHEY__PHnY4eYKQ54e6kNEhLClpgawMA9YEDuuT8w3LZ-9lU_0bK8pE38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulpIGh6SURzW_ZYmCbMa20YMDZbW7nlW6t0JfQYoz1Ew&oe=69A0537E"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv7hUk4YAJcQ7kNvwGPRhz6&_nc_oc=AdnLvoklJoTJEcYlVtVtcbcTwvTQx5d341fNpVhv5ULM2LlV13dqSlJnAcPaD30Q4iM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsyxx5WkH2ji3zUqi1dK4kavH91WTtmDkW4TCt5IQPt0Q&oe=69A03E64"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWsTTEBFqjYQ7kNvwFFWGVj&_nc_oc=AdkBG9oxOLpUabeuZUC-J8hLJ-xf5Kl8Bz4Rxtn_lC3g3YILVZwwzYoQhkA3qR8CCeA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrTrqf57_1z7Cd9YgDeNJX6oXC0qG_lmqU6uYIP5hIxQ&oe=69A0428B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Funomena, Inc", "support_website_url": null, "website_url": "https://luna.funomena.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "691325098529151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974920_115123463686478_4537096747996642370_n.png?stp=dst-
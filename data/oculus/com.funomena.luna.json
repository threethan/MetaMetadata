.5771-25/38974864_407876667025840_8011676309595829553_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4m3wwguwi8Q7kNvwG9xsHR&_nc_oc=AdrGsR-QnHJ9zqU0Wg2eQz66QLBa6rjUqp8j1tyhmvG14GoW-vyK5V_FxxDT05L3yW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDcL6HyP7rX66lGU4aufTmOspjl9gE3vm5V7eEtHvJqg&oe=6AE76C3E"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZSuWPgN2LYQ7kNvwGviRVf&_nc_oc=AdoekmfQhWXH-jfnDtERNjH6S39f2C2kMvmuw8vHnsgJg1FAFiRlwwMBUNAgY3aNo7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC8KCIS6Lc_ZK4bTJlbFCF1mpLIzaOZBRgwKz1hzEv5A&oe=6AE7477E"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StKN2ART4SUQ7kNvwHjTAfp&_nc_oc=AdrZFOT0Ju3qvOoFEwwgyu8lTlBiO7ZpbXCpRHZ9XPGp_sGRALI6prYnS54-8IK99eA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJxnIOvVDQmCGoH1T0_L5x7HejgToQ2XFxNaI_8trfKA&oe=6AE76AA4"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oHuGz4jKaEQ7kNvwH8-Lc6&_nc_oc=Adq4hmodhj7J5yi6lPGYI4vl0lTFUDN8rek4Pb92nL4NLUiEgWE9UwYuX45poE1aMKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmXShsaQm-XrTociy-UZ9EIoa1ry88oqYoQ8ZQ5Szniw&oe=6AE76ECB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Funomena, Inc", "support_website_url": null, "website_url": "https://luna.funomena.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "691325098529151"}, "review_mess
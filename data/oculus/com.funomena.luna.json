culuscdn.com&_nc_ss=7f20f&oh=00_AQQd3aYTmjUU3lb_UW68JjL86xgV3ElvUYMUogSfNtfgVQ&oe=6B005A96"}, {"file_name": "Luna_Screenshot2.png", "id": "407876663692507", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_407876667025840_8011676309595829553_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIVFUV2qYfcQ7kNvwHpe9Z-&_nc_oc=AdpCwL-aHY_Nr0YEzrisCixVPoV8PxPmLjSuR2usaCmR0vl9TIhFZ7iMYfkT4G6mpso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmqHsbTQI1AJS81mCD_Aa_JMxihhHPQU5EvVwjYdVFpw&oe=6B0078BE"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpCLUk92I-kQ7kNvwFAhb2f&_nc_oc=AdrJFH-rAjLIioe34noG9kWcYBGP8R6hat-3g_2DBvFcXcR-52uPHiDHwfDcDBz3aTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjUHnI888Zw9I_szDaqV3mwYvAp0uUGBBlTkZfDS80_w&oe=6B0053FE"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BF9oOq1QybkQ7kNvwGGgF4C&_nc_oc=AdrYBUJz5LtLVnUKJK1rsRYv8rk3Zee-nBFcXxUoUmZbNMlwbqLoDmDdj-mXEbzKlYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXGIwMROq7dVo-RmB4y7gsAYXbFpKjUN-RZ6QBUxGqpQ&oe=6B007724"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NGCkTYmCOAQ7kNvwHWxeXA&_nc_oc=AdohYjoyIHngrrd-Fp2v3DRNmTl1CcsTRzt79rmL0ukus0_goXzQL4zZYfEbpaDrjWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWOwxEYvi4WBqrtXd_0_-aHQXy3dR_v1qPLh4c8lfW7w&oe=6B007B4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Funomena, Inc", "support_website_url": null, "website_url": "https://luna.funomena.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
.5771-25/38974864_407876667025840_8011676309595829553_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqGxgdQd6EMQ7kNvwHCpf_H&_nc_oc=AdrE8bzg9soHJ471OzDHFfesOS6GBL9FgZGAb4XiaTD437EkrId-1sGBKU5Tysx4tRU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrEFmawWjC8d0rUu99Kclj3gXxdtiVY2l2oHQLTWU0aw&oe=6A562EFE"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j96tLzOb0ZoQ7kNvwH8fYZk&_nc_oc=Adqw4qFUMHy3Q1RE0qi8DXoAXbhmdeL3bxcYiZGvgzwX_uqsjpYYDYt_LWNrx4UFClY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtrz0k8bv6iX2dSJBj10rmO-5YgcAMFEs9rgUATQROrg&oe=6A56427E"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYdjDPNEuCwQ7kNvwH_lBwh&_nc_oc=AdrXuT9kg2J8k6zSqIOhRcpthdMORxgpGHfF4-xyhC6IZ9GXh4sol5lloPbYOXoh6J0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs_lgAgL7zdv_3g-nPmSPkX51sBBLyo2F1kJY4vBLZXA&oe=6A562D64"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8vVgsOzX08Q7kNvwEr9PZL&_nc_oc=AdqPQBtRNC_VWrcFSVwuN7ufdaKJ-HRSEfaKztdrnT_v-OWIYS3CQmHo4OPvzGQDmao&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAuqdgYhu0SmLZJMW-NgtiXJVQ6r7zwamHd7vdrIYcgA&oe=6A56318B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Funomena, Inc", "support_website_url": null, "website_url": "https://luna.funomena.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "691325098529151"}, "review_mess
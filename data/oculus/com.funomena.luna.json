0_115123463686478_4537096747996642370_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS1KtfhdDAMQ7kNvwFyckoo&_nc_oc=AdnUOidNt9YUw4agFaVTaRZGLSEXue5JMqYZl4V6qrohBMqB0wUuu1st-CFi6xTz1RQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHmpNlbMkXg5FoMsqiZva3aLmt_1Z0EWjPy2-G3xV2Kg&oe=69A6D00B"}]}, "id": "223141388739389", "locale": "en_US", "screenshots": [{"file_name": "Luna_Screenshot1.png", "id": "385289932576687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982640_385289935910020_2551656206753054447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmRYBgMMWCcQ7kNvwGsXNb2&_nc_oc=AdmDlftijHGTFMoFOIUDC38OYnz0p3Nh4qcXwFccThJkW45MXiDbkgmp7suBAJ7u1fk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSCDBzofQSKoJaXC-bTd6XY7K95XfRCr5KHOFUfW5fPw&oe=69A6F196"}, {"file_name": "Luna_Screenshot2.png", "id": "407876663692507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974864_407876667025840_8011676309595829553_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24JFCq1rBbEQ7kNvwE1AmbD&_nc_oc=Adm5qY7AeWYxPTpq_-fi8nqcJk_KdIlHZaYzfgV5fJXyONl_LMIpwQU0U_L3pW5pS5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvA5jBu7ykJrNgvm__58QFr4gGHZlulHIAESdMVj4SeFw&oe=69A6D77E"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcjcKc_-Pz8Q7kNvwGBVd-M&_nc_oc=Adn2y2iVF6hbdTYFxwPKrMJJeurscMu0tIKS4Z_RIwapUyg9l3bxjXfFDRUfBipJMTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJjcgd192ZS2Dt6po5HFAp2i_4aiqJUrs-fEgzhzg8bg&oe=69A6EAFE"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zPAsvgadUQQ7kNvwEWZ7kM&_nc_oc=AdkTPXU1VtNlhacsX3R0nCg0Kf2xlxseh9fP2R82vjU704QnmKfRkv79HAkCcXKwrYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftIc0vKfIvU_H-7jpBATxYfolVv2FplMT-XDayOkPM_jA&oe=69A6D5E4"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnDyXNzcRO4Q7kNvwFV2Bz3&_nc_oc=AdkbCSQR5AbkvqyMgDQTtO8UHC9hHCGAYqPWvetdlMh6dNkzFNKuYb5uqbJDkZdseF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsvgt5nGN6V_3XAg2LVvm08-0_JxDabdsWvZZupDu0Dug&oe=69A6DA0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_nam
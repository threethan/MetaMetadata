6", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974558_209363854052099_5363085818957636330_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwPU9rpceQQQ7kNvwFDhBOi&_nc_oc=AdkI16rNGWeXgBSVlq_O6nLjH9y9CqKM55NBhb8dAIP-COQlAmuzcBZMvt4D7Sm5kR8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-Vt9Tf04uU2F4mLhkKyDDZk5RsKMLHHpc8fsMJCtU4A&oe=69AAD40A"}, {"file_name": "Luna_Mini.png", "id": "186343456465144", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982460_186343459798477_6984721465712120734_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyaQXMOoKCAQ7kNvwFijAAf&_nc_oc=Adlymxh03nPQl9UUl316LcmyAag7JX86uFDU9M1KWq0fb1p2yQ5whIlCNbsCmHjZy_A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEgX3rguaF1uxMU8egHG13Vct-kYa21Y45bAKZumG7wQ&oe=69AAE150"}, {"file_name": "Luna_Square.png", "id": "115123460353145", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974920_115123463686478_4537096747996642370_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg8vL_fO-2sQ7kNvwH3ftZ5&_nc_oc=AdnstOhaH45D7Xtq1f2XjxbsYWGlfiWLsmpJLseGsMvJBc0_qkD7Upwd0Dn6_WPt0Vc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCD-c7m-2bpLMJQjAUyYzTNn9G8HkIAGtmU3hIGvRPUw&oe=69AAC48B"}]}, "id": "223141388739389", "locale": "en_US", "screenshots": [{"file_name": "Luna_Screenshot1.png", "id": "385289932576687", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982640_385289935910020_2551656206753054447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRC_ggywwKgQ7kNvwGzyyGW&_nc_oc=Adk4DoQ-0NesGgDWvuEO2F6VSLNm_Jelp__CRbwrx1w9NHgX3xsJ08F0QeQf_2eZlNk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIfSdAFrbYB5vsxtKhaKxsIpCDSZe3V-Bst9MRfAvoNw&oe=69AAE616"}, {"file_name": "Luna_Screenshot2.png", "id": "407876663692507", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974864_407876667025840_8011676309595829553_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_sWi8iTiNMQ7kNvwGukiO-&_nc_oc=Adlz9OVaIvOilY0S2qW7A5Hd6a0vfL9dRoHHQ5aN7j0RSegzA74Ff78Y4HXs8sR3jhA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIOpMpn1csssQ43kE424liCFhkyRQYzSSEpMqXyjglGg&oe=69AACBFE"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwJDHk97YHYQ7kNvwHuYYm7&_nc_oc=AdlvZoqrzM-1ZY5zMw-41CNegyVGl3YXX7LEvmU9hw0OSHBcqg2YAb1zCcZ332VkAMA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVp1u5jW5JUMcRM2zEkensp7IMUUednx_lzTA9TUfuZA&oe=69AADF7E"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxBmS_vkPagQ7kNvwGN_5sl&_nc_oc=Adkzg9dFZJN8fcyVuZxAF2SmmnVR_K9MGykgSKihu3lN3g7WPaejbsNyCfkkWJSC-eY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzL3oVIi583MSLxbyELfbRljEDBBmcfewvg2lhmpCDqSw&oe=69AACA64"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4oVnDy3gxMQ7kNvwGu1GnD&_nc_oc=Adlpr5YVCKiGHYZTvzIvfpPpDQ_ct2o2KWR3fkyL4djOKeSXPf_hob1QslIj8R3OGKk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx70eX9hjBcvnPcmCFtJ8KElVS11KDM5nRkrKSJ9o5ySA&oe=69AACE8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Funomena, Inc", "support_website_url": null, "website_url": "https://luna.funomena.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "691325098529151"}, "review_messages": []}]}, "cover_square_image": {"uri"
/t64.5771-25/38974864_407876667025840_8011676309595829553_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4usQEp0dK0Q7kNvwFw87UQ&_nc_oc=AdrDGgT3zDVuUVUfMZC4IzPVAS2YF7ryUY0ZY8Ag36rRl0-4JyxZRDjmfL5fRH7K5rw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QJ4BgzTNMf1gPYvwNmpWykngdp-pLOiT6ps1TqHMP5Q&oe=6A465CFE"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FD9GUMk4xIQ7kNvwHCNcuD&_nc_oc=AdpRn6xMrx-TxEQG_Rc-RAXfjs7Kkn2v1nhXHWs5BQkDwRBX355oNTmC0hpWLUc0XCY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9HqNHM-I5H0CH2JZbAjW0yvmZoeTTEasc4i5PhYD3PQ&oe=6A46707E"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QOMv6OJinoQ7kNvwFvIGzZ&_nc_oc=AdoBk7Nii5m4Nx8Go8t6-hn2nXRLuM6zgFKQl23NCByNEwxKxXW7ITBqr6dmuF3xHEo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ul_qIeyEdsHWUSJo1BcyBIC8p8SG1b1kvkoB04ZGBWA&oe=6A465B64"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNQ6oXYzbAIQ7kNvwFd6KxP&_nc_oc=AdqkWzCZxa2eroFFeqL34ly_OETNClz60rMubEjHe_nc_dh6ZXus3DsTrM_MZgrIzUo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hP-MMJdAYSiOn9j-63yrP9o7VrYRQx6MyA2no0rJyMg&oe=6A465F8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Funomena, Inc", "support_website_url": null, "website_url": "https://luna.funomena.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "691325098529151"}, "revie
culuscdn.com&_nc_ss=7f20f&oh=00_AQSLOvICJOyI_C-2tv8Xj62HPHD0O02TH-WYniGVstSJDQ&oe=6B05D8D6"}, {"file_name": "Luna_Screenshot2.png", "id": "407876663692507", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_407876667025840_8011676309595829553_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT1EsjFM2q0Q7kNvwE1X7Ce&_nc_oc=AdrpHxxdukjg6HAs7Nro6QfSAwQCyNVAltuYWuOYyXRHQ3fT0yy8UpKDp-Uko2ftMaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4NHkT5k7OgRJ21jbn_6SR-blPoqM26P6yp6YLdgaO7w&oe=6B05BEBE"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDYmKWCnt54Q7kNvwEe3Hz5&_nc_oc=Adr9dgAPG9nCxCWAGwQq65m1KI-nnqjKj2VOGv5EcByCPLbyyFY0l3MZjml1Lqt28rg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCOzT3E2qLv0hQkSvHcDZKrUl2smaB87d1I5jbdfngZg&oe=6B05D23E"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyURSBwJcPkQ7kNvwEbb5iq&_nc_oc=Adr4fkAJOX1baa0YgS-8vs3KAoainx2-TyWfWyPzzSYzdX0G9Gkvquho6mzOfnqwBVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB2EDHl_61Wv_ZHMj39TP8qQQXefhsHId549LPzUAbGg&oe=6B05BD24"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VEguQcspbMQ7kNvwHaaW-Q&_nc_oc=AdoXomEVX5Hf9lUKsCdzJ0aa_rcwgJ_S0m6M4E2vcFuqrZqpRet67bdw5-bCfd85-Rc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_mmZbO8vC-cD84kvi7C74dfEPQibss4f6zIjG1GsKvg&oe=6B05C14B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Funomena, Inc", "support_website_url": null, "website_url": "https://luna.funomena.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
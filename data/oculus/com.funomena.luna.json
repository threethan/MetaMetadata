culuscdn.com&_nc_ss=7f30f&oh=00_AQQWGcGARbk5vxvPbbp5W1bSo8JHop0XQAl7Xjye97odMQ&oe=6B0C7056"}, {"file_name": "Luna_Screenshot2.png", "id": "407876663692507", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_407876667025840_8011676309595829553_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=775h1LoJRG0Q7kNvwGiC-8A&_nc_oc=AdqMQKFa23PrkohbEHdagOEvYUe9sPFwoK8dGnXbEsDk2Er8o0KgKxc7OX5quRHTnnk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxhX-N-gYkog6n5-0LoH06ZB5_1o8CIkxWqkKdZJHEeQ&oe=6B0C563E"}, {"file_name": "Luna_Screenshot3.png", "id": "732537930698490", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974831_732537934031823_7451687605207784979_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_JdIVkknloQ7kNvwFG7y8b&_nc_oc=Ado16gesi-4g_RVNM5odlC4vdMIwf7wiUJHmu-bpfqpAbjEIzfdUDM9LPxCGCK8eBPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbu5qpI0gp-9DImHUtuLe0nXkI1kUK-FT15HN7lSYQ2w&oe=6B0C69BE"}, {"file_name": "Luna_Screenshot4.png", "id": "398153314963977", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974920_398153318297310_8737685013918149242_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2rV-XPWbhcQ7kNvwG-EIcl&_nc_oc=Ado4H9TqUbls17MG5ZjkMR_ep0qwyLWikNbyxYK1ZyRuaKliJ4_siuwA_i3aXQRntnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkpQ8gfb89n5UZowojo443-eBBEmLHYXqqH6TQQdcosw&oe=6B0C54A4"}, {"file_name": "Luna_Screenshot5.png", "id": "381907302915245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_381907309581911_3354417288774904227_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoptIMVef-gQ7kNvwEAc4V6&_nc_oc=AdqsB45XvNRe11E9d5mXjqZvyx3iyGoCF668dgvsjaPZgKu8VPwsTA-kil0YufNLEv8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTswAUCA0r6Jf67GZ0ukoiogPCz9Yw6ljACHkHPWMKYiA&oe=6B0C58CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Luna", "keywords": ["puzzle", "story", "bird", "meditation", "garden"], "long_description": "A Bird's peaceful summer slumber is disturbed by the majestic call of a mysterious Owl. Enticed to swallow the last piece of the waning Moon, Bird is blown far from its Golden Gate home.\n\nUnscramble celestial puzzles and create miniature musical worlds. Re-awaken shadowy forests and bring life back to sparkling lakes. Discover hidden creatures, help the Bird reunite the fragmented Moon... and find its way home.\n\nBrought to you by Funomena\u2019s uniquely diverse team of veteran developers (Journey, Flower, Boom Blox, The Sims 2) Luna is an interactive fable about learning by the light of unexpected mistakes.\n\nSolve celestial puzzles to unlock each level's tree, plant and animal spirits.\nPlace, customize and interact with them in miniature, musical terrariums.\nBring each world to life, revealing Austin Wintory\u2019s haunting, enchanting score.", "short_description": "Luna is a meditative storybook puzzle game with an emotional narrative about healing. Help a lost bird save their friends and restore barren garden worlds. Untangle the constellations and reunite the fragments of the moon with calming tactile controls and music."}]}, "developer_name": "Funomena, Inc", "developer_privacy_policy_url": "http://www.funomena.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Funomena, Inc", "support_website_url": null, "website_url": "https://luna.funomena.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
iad3-1.oculuscdn.com/v/t64.5771-25/491823901_1093389196740249_299000183873883252_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_0afMfMpTsQ7kNvwG5N2WQ&_nc_oc=AdqBOMI9DjMaYA466GjV-1ODeMwOpox6NSbv1_nsp93UZ7L-HDOC_przSMjmD2y8rpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStjNO80e7sgsI2zGFWM9_6_eTXjqO_LGab78Uu9wWcRw&oe=6B05CF80"}, {"file_name": "Screenshot_5_expansion.png", "id": "2016132869089548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_2016132872422881_5817437771168415263_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMsuRWPKghMQ7kNvwGPcz_c&_nc_oc=AdrYgRpJpmB5maRc4eVNd3YCLTSiyxMnDbjR0i17xREddsRkVoECACFcD3SW0gVJ5AA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyo6uJiYEWI3F7Xp_RqrD_CNIJX-2GqXD7TKOeFGCKxg&oe=6B05D8EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyGroceryShopSimulatorVR_TrailerCover.png", "id": "1604234564772952", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828008_1604234568106285_8584221406283747710_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9snOhqjJ3okQ7kNvwH1Apno&_nc_oc=Adp_QwO-J1Nx58NpbmKlwUnHySqx3T8A79IhYpQLuzGKBaObbCLf7X26ZsS6xo42nSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwTOm2nC8yhBu97xUuY0I8KSr1iw6mmDvlTCFCeTDUbw&oe=6B05AB5B"}, "display_name": "My Grocery Shop Simulator VR", "keywords": ["Simulator", "Supermarket", "Game", "VR", "Tycoon"], "long_description": "Open the doors of your very own grocery store, and get ready for customers.\n\nGrab boxes, open them and stock the shelves with your own hands.\nSet the price of every product. Too cheap and you lose money, too expensive and customers walk away.\nScan items at the checkout, take cash or card, and count out the change.\nOrder new stock, unlock new product licenses, upgrade shelves and fridges.\nHire a cashier and staff who keep the store running while you plan.\nBuy new stores, from a corner shop to a hypermarket, and build your empire.\nEvery day ends with a report of your sales, profit and the next goal. How big can your store grow?", "short_description": "Run your own grocery store in VR! Stock shelves with your own hands, set prices, scan and give change, hire staff and grow your shop into a supermarket empire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "de_CH", "gsw", "es_VE", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR", "zh_HK", "zh_TW", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2577566616017909"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1775259743675322_3045929897670325715_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY8i2ml6tV4Q7kNvwF5-jz5&_nc_oc=Ado6m0-rC2PXt_GR9-hezQTyHLeVQEzG6PPBE2rcrvI0QpIq0O3d5HhliFcdhbXR2qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4c2sIxDs5x5ihk6WySDApBKxz8MNdG2VZVvhxmMIaTA&o
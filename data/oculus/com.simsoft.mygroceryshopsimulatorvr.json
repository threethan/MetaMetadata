ZPQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKPtFw_-Wyt0vEzno_Qk18l4udlZm1X9UGgvtSvfDMAQ&oe=6AFEFFC0"}, {"file_name": "Screenshot_5_expansion.png", "id": "2016132869089548", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_2016132872422881_5817437771168415263_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3BHtZzLz9AQ7kNvwH3b6wr&_nc_oc=Adqo12r3F70gjxTiYYkHAqycDVk0iNBsCVXZa4txvLUaYmsE8Thdmzedlbt2Pgfkvn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKS3DGIvy9_3TxBLxQmYPyeJo_AlrPmxkZFu2stdm8gA&oe=6AFF092A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyGroceryShopSimulatorVR_TrailerCover.png", "id": "1604234564772952", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491828008_1604234568106285_8584221406283747710_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENeZ102nUL4Q7kNvwFGTbn5&_nc_oc=Adopz5mDQZqSBkuh5WqPm4hltlhdu-5ygLfmaFBiPOipTLkcPNNPIbHD8pOXwqgCCsg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAiU0FbvWGOtkvNmWTOQ89vwROTbajeeamyJLAyZzYfQ&oe=6AFF13DB"}, "display_name": "My Grocery Shop Simulator VR", "keywords": ["Simulator", "Supermarket", "Game", "VR", "Tycoon"], "long_description": "Open the doors of your very own grocery store, and get ready for customers.\n\nGrab boxes, open them and stock the shelves with your own hands.\nSet the price of every product. Too cheap and you lose money, too expensive and customers walk away.\nScan items at the checkout, take cash or card, and count out the change.\nOrder new stock, unlock new product licenses, upgrade shelves and fridges.\nHire a cashier and staff who keep the store running while you plan.\nBuy new stores, from a corner shop to a hypermarket, and build your empire.\nEvery day ends with a report of your sales, profit and the next goal. How big can your store grow?", "short_description": "Run your own grocery store in VR! Stock shelve
7ck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM7qQH4KQPMvrMhzP1CCJQ-l5WT7Yk38-Mr_0_FNxCiw&oe=6AFC9500"}, {"file_name": "Screenshot_5_expansion.png", "id": "2016132869089548", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_2016132872422881_5817437771168415263_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9-ZElhWdqgQ7kNvwEfF0O6&_nc_oc=AdpzlDxa0GyguBM5ovKvLZYcx9yrHxU746tc3bbkAEmgeb7NaHcHTXi-nFIOh9-PPLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo4kwNwJPqJenzmW__bsOoDwCFfhnVvb9iMpKL6T78NQ&oe=6AFC662A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyGroceryShopSimulatorVR_TrailerCover.png", "id": "1604234564772952", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491828008_1604234568106285_8584221406283747710_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bxULIA5DqwQ7kNvwH6z2TS&_nc_oc=AdrtZ7GfqtkwNHm3J85QhoRiB3hTXGGEvfRMFxOWA3HVqeGrIAh5zmrhUHBthtWvzck&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzKBA4dla9Lgb__ioNRJNml262ipv3FR_txBVXuyQD_w&oe=6AFC70DB"}, "display_name": "My Grocery Shop Simulator VR", "keywords": ["Simulator", "Supermarket", "Game", "VR", "Tycoon"], "long_description": "Open the doors of your very own grocery store, and get ready for customers.\n\nGrab boxes, open them and stock the shelves with your own hands.\nSet the price of every product. Too cheap and you lose money, too expensive and customers walk away.\nScan items at the checkout, take cash or card, and count out the change.\nOrder new stock, unlock new product licenses, upgrade shelves and fridges.\nHire a cashier and staff who keep the store running while you plan.\nBuy new stores, from a corner shop to a hypermarket, and build your empire.\nEvery day ends with a report of your sales, profit and the next goal. How big can your store grow?", "short_description": "Run your own grocery store in VR! Stock shelve
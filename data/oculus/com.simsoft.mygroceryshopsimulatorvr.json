EvfCe1yquRkc_9u0cyD-tbsC3ligs_stsRyuJlAokyLsRKZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQV2aW5o6rIz5yK6caHq_ug3vCa0Jug7NfW7InLOhElQ&oe=6B005AAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyGroceryShopSimulatorVR_TrailerCover.png", "id": "1604234564772952", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828008_1604234568106285_8584221406283747710_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENeZ102nUL4Q7kNvwGMfS6q&_nc_oc=AdqD6Rr9Ey-VBLMZ7WyfgEfQnDkzyuoFtIZgBxIuPoc1zVwzyw2e4y5Wdu0u3PDZIpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9h_kSnUQzGLNn-mR-uwlZegwDywRuQ3ZS-FvkM95LXQ&oe=6B00655B"}, "display_name": "My Grocery Shop Simulator VR", "keywords": ["Simulator", "Supermarket", "Game", "VR", "Tycoon"], "long_description": "Open the doors of your very own grocery store, and get ready for customers.\n\nGrab boxes, open them and stock the shelves with your own hands.\nSet the price of every product. Too cheap and you lose money, too expensive and customers walk away.\nScan items at the checkout, take cash or card, and count out the change.\nOrder new stock, unlock new product licenses, upgrade shelves and fridges.\nHire a cashier and staff who keep the store running while you plan.\nBuy new stores, from a corner shop to a hypermarket, and build your empire.\nEvery day ends with a report of your sales, profit and the next goal. How big can your store grow?", "short_description": "Run your own grocery store in VR! Stock shelves with your own hands, set prices, scan and give change, hire staff and grow your shop into a supermarket empire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "
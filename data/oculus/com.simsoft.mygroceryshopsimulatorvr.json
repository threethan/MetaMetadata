ojU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSK1GgHLDpTuYHOcZ46yOcdiG0B2vBJEZA4CVSM-4-EQ&oe=6AFDAE40"}, {"file_name": "Screenshot_5_expansion.png", "id": "2016132869089548", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_2016132872422881_5817437771168415263_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3BHtZzLz9AQ7kNvwFJkF9i&_nc_oc=Adq_MuvdprSGnrg-io7jkKF5MdFFAW2NEcGRKBj5eDnIrnwMlB0-TJxxH6G_K2Q5v4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxV4dh0H9aAh7U0SJ5zreVvmluNBHT_S0dF-gzdIg0zA&oe=6AFDB7AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyGroceryShopSimulatorVR_TrailerCover.png", "id": "1604234564772952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828008_1604234568106285_8584221406283747710_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bxULIA5DqwQ7kNvwGjAAFg&_nc_oc=AdpepJryO9E9nDc-I6TWNi8PlNEe76KVQ7Z54PGlKpi-mTHcaja3mEiW4JbnaqdRGzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRZNOe0fLpeeT9pr-s7kDt2cgJfREBE6VutVJpek0zHw&oe=6AFDC25B"}, "display_name": "My Grocery Shop Simulator VR", "keywords": ["Simulator", "Supermarket", "Game", "VR", "Tycoon"], "long_description": "Open the doors of your very own grocery store, and get ready for customers.\n\nGrab boxes, open them and stock the shelves with your own hands.\nSet the price of every product. Too cheap and you lose money, too expensive and customers walk away.\nScan items at the checkout, take cash or card, and count out the change.\nOrder new stock, unlock new product licenses, upgrade shelves and fridges.\nHire a cashier and staff who keep the store running while you plan.\nBuy new stores, from a corner shop to a hypermarket, and build your empire.\nEvery day ends with a report of your sales, profit and the next goal. How big can your store grow?", "short_description": "Run your own grocery store in VR! Stock shelve
dn.com&_nc_ss=8&oh=00_Afx0l9wVG-GqOlkd4a_MtbVoKOMNx1kZmuJ9lwjPJrVwOQ&oe=69AC340B"}, {"file_name": "Untitled-4.png", "id": "733907497983104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982668_733907501316437_5280774464745072577_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpipeGkWXZoQ7kNvwFFLkV9&_nc_oc=Adm2FVHqgdSxGvWgrT8A-k6poIU6AxU2fbHWW1bJC8Yc9MddhM2LjePHzOmeoCjkD_I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJKBVwRENg8cfcrbS1gLTrlOpTXHfo_YRqq973OEdqAQ&oe=69AC04E6"}, {"file_name": "Untitled-5.png", "id": "702540254130805", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75451774_702540257464138_3251782751112260677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWwE5Z1p1icQ7kNvwHzPyIf&_nc_oc=AdlBLipooWz0Vn5r8DOnLF30_K033jCX1flhfq7Lji3JVMHMXo-QYBlRw0UPXhUoZUk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-9dDnNpi7VcwC0buBe4IcXshc80jnieYnc5LyqatKnQ&oe=69AC2E22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "696507261658910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_696507264992243_1736600765905702198_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M51CXu7IxaAQ7kNvwHgr4MF&_nc_oc=AdlKLCEcqEJWP0tWzLkRW2WRdx8lglNmHoNqxW-CnUjExZ-LCAeCL2hf8rrF4KFCH4c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEc7Wew6lRgaGmgNMfZKMOX6gmad48EwS94nCAKkCPMg&oe=69AC23CE"}, "display_name": "Attack of the Snacks", "keywords": [], "long_description": "We live in a dangerous time. Today\u2019s snacks are after more than just your arteries, they are after your life. You\u2019ll need to defend yourself from wave after wave in Attack of the Snacks. Pick your best weapon, shoot with accuracy, and dodge any incoming projectiles to see how long you can survive. \n\nQuick draw from an inventory of guns with unlimited ammo all from the flick of the wrist.\nExperience your dream zombie scenario and mow down rabid hot dogs in the mall in this fast paced shoot\u2019em up.\n\nAttack of the snacks is the official outlet for those who are trying to fight back against unhealthy snacks. This is the first game release for Fishermen Labs, LLC.", "short_description": "Junk food has never been more dangerous. Grab your favorite weapon and get to work to do your part for a healthier tomorrow. Be the hero for all vegetable-kind. "}]}, "developer_name": "Fishermen Labs, LLC", "developer_privacy_policy_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks/privacy-notice/", "developer_terms_of_service_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks/termsofuse/", "publisher_name": "Fishermen Labs, LLC", "support_website_url": null, "website_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "296949269197870"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5117626718331487", "version": "1.0"}, "id": "1233447563833570", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary
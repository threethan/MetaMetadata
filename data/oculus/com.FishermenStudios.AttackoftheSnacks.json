501316437_5280774464745072577_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUU1TsvUL_kQ7kNvwFmxKke&_nc_oc=AdneVnS8aWSguIU_kygXPgXsAY04SPWGOk9bwY_dJd3l2aXhGVDICgleWMbhKRYk9Lc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvwz7ZKaLVZDfk6gc56FZzE9kAZB6JKoiPmySJ4ifdQ0Q&oe=699D8466"}, {"file_name": "Untitled-5.png", "id": "702540254130805", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75451774_702540257464138_3251782751112260677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atnh2Wu_Wr0Q7kNvwGaLus7&_nc_oc=Adnz4QzNXr1KWilvcY-MzMXrFdw54ZGhQy83SCHYq6B_ygUqJe5_NlZe4B0SUljvCmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLXYsShMmPLLJweUBWR7i58irldof27SGrfoqvzmLvyQ&oe=699DADA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "696507261658910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195909_696507264992243_1736600765905702198_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04RHGCbCKOEQ7kNvwGpnWsk&_nc_oc=AdmXQzgq1X_7hHR8DKENdk9caAinrn92tJSNFp8b5WOp5b184iO7tbUlCaUlmaxQLAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuNVuctelWZky5CMYHskFgEYbZiNH5MaTyT7XNsaOAayQ&oe=699DA34E"}, "display_name": "Attack of the Snacks", "keywords": [], "long_description": "We live in a dangerous time. Today\u2019s snacks are after more than just your arteries, they are after your life. You\u2019ll need to defend yourself from wave after wave in Attack of the Snacks. Pick your best weapon, shoot with accuracy, and dodge any incoming projectiles to see how long you can survive. \n\nQuick draw from an inventory of guns with unlimited ammo all from the flick of the wrist.\nExperience your dream zombie scenario and mow down rabid hot dogs in the mall in this fast paced shoot\u2019em up.\n\nAttack of the snacks is the official outlet for those who are trying to fight back against unhealthy snacks. This is the first game release for Fishermen Labs, LLC.", "short_description": "Junk food has never been more dangerous. Grab your favorite weapon and get to work to do your part for a healthier tomorrow. Be the hero for all vegetable-kind. "}]}, "developer_name": "Fishermen Labs, LLC", "developer_privacy_policy_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks/privacy-notice/", "developer_terms_of_service_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks/termsofuse/", "publisher_name": "Fishermen Labs, LLC", "support_website_url": null, "website_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "296949269197870"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5117626718331487", "version": "1.0"}, "id": "1233447563833570", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4575399629220868", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5117626718331487"}, "release_status": "RELEASED"}, "binary_
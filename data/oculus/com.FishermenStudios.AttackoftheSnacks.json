culuscdn.com/v/t64.5771-25/75195909_696507264992243_1736600765905702198_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6UjPaeAtgkQ7kNvwHAQh9C&_nc_oc=AdrmXA4tmhCwLCG38_JjUVSMYHaDWfTVtoLeNuD4DkuLUu50MBamuoUBo5PXFQCB08k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_lns87lrNKqeii4GdNXsFqOtEDb07-kGK0BTHszxVeg&oe=6B007F0E"}, "display_name": "Attack of the Snacks", "keywords": [], "long_description": "We live in a dangerous time. Today\u2019s snacks are after more than just your arteries, they are after your life. You\u2019ll need to defend yourself from wave after wave in Attack of the Snacks. Pick your best weapon, shoot with accuracy, and dodge any incoming projectiles to see how long you can survive. \n\nQuick draw from an inventory of guns with unlimited ammo all from the flick of the wrist.\nExperience your dream zombie scenario and mow down rabid hot dogs in the mall in this fast paced shoot\u2019em up.\n\nAttack of the snacks is the official outlet for those who are trying to fight back against unhealthy snacks. This is the first game release for Fishermen Labs, LLC.", "short_description": "Junk food has never been more dangerous. Grab your favorite weapon and get to work to do your part for a healthier tomorrow. Be the hero for all vegetable-kind. "}]}, "developer_name": "Fishermen Labs, LLC", "developer_privacy_policy_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks/privacy-notice/", "developer_terms_of_service_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks/termsofuse/", "publisher_name": "Fishermen Labs, LLC", "support_website_url": null, "website_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": 
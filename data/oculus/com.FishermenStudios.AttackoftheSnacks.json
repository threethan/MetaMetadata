zC8uNejo09erOQFk-fA4bTEQuRokVskF9FJIYm5rXw5kMK594Cg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O16fG-l1UGtAcPHGd0FcM66lEGDAnAY3dxCxHods_Ig&oe=69DF9E8B"}, {"file_name": "Untitled-4.png", "id": "733907497983104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982668_733907501316437_5280774464745072577_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSRlqVQEpAAQ7kNvwF_hIEP&_nc_oc=AdpEtmETZB8oOP7jQnc5dLBMkXD5Bvu_jLnRifHSFpmeaACtEbCtP4u3dfascsMr8eM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oJV47w0muBBrymX68cbHm51vhKuyNVnm8C4q7F5A6dg&oe=69DF6F66"}, {"file_name": "Untitled-5.png", "id": "702540254130805", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75451774_702540257464138_3251782751112260677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkCFnAARarIQ7kNvwG6yZTy&_nc_oc=AdqEOzcE2Mic_lXUIXVebhD6gLP3hjHRFeOPbA-SeBqrFcIbuz3mK6U4rtzDRZk1cVU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CDM3uFubAbDvtY3eM325Le1GC2NfDgJPIMPmFHjtiZg&oe=69DF98A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "696507261658910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195909_696507264992243_1736600765905702198_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmEYKRaTUH8Q7kNvwHe7Mol&_nc_oc=Ado6E00TYqzssi5sEubKmltq5d3GJosCfTfdsBBAXHIrbfBOnDcqS7E-l4iIN0YpJ_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WBjdnU46Pj2kyTLTeIRlX_RbcYgMZt6LFREGF_I5Tfw&oe=69DF8E4E"}, "display_name": "Attack of the Snacks", "keywords": [], "long_description": "We live in a dangerous time. Today\u2019s snacks are after more than just your arteries, they are after your life. You\u2019ll need to defend yourself from wave after wave in Attack of the Snacks. Pick your best weapon, shoot with accuracy, and dodge any incoming projectiles to see how long you can survive. \n\nQuick draw from an inventory of guns with unlimited ammo all from the flick of the wrist.\nExperience your dream zombie scenario and mow down rabid hot dogs in the mall in this fast paced shoot\u2019em up.\n\nAttack of the snacks is the official outlet for those who are trying to fight back against unhealthy snacks. This is the first game release for Fishermen Labs, LLC.", "short_description": "Junk food has never been more dangerous. Grab your favorite weapon and get to work to do your part for a healthier tomorrow. Be the hero for all vegetable-kind. "}]}, "developer_name": "Fishermen Labs, LLC", "developer_privacy_policy_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks/privacy-notice/", "developer_terms_of_service_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks/termsofuse/", "publisher_name": "Fishermen Labs, LLC", "support_website_url": null, "website_url": "https://www.fishermenlabs.com/ar-vr/attackofthesnacks", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "296949269197870"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5117626718331487", "version": "1.0"}, "id": "1233447563833570", "channel_name": "LIVE"}]}, "is
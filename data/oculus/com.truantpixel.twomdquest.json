&oh=00_AQOcRFGxGO_2BFv7l8a7CA2KryL6xBKajfnu6vIViv_QJw&oe=6AE4AD71"}, {"file_name": "migrated_image.png", "id": "654553232024282", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031329_401070893920145_8306860865253015552_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpMlid9Lp-IQ7kNvwGpWiCg&_nc_oc=AdrnGhSmKNEPcaFk4yFTr8o31fuKt9C-7qKZuUpBOULKWDMLH007cuY72O3K9Nnk8KU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN90WEVpejU7QBLceu_VDqXJj3GI5IWRBM6_3uDQyvylQ&oe=6AE49BB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/9QifdO", "id": "2471839539752664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195911_2471839543085997_976130501695766528_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFklrz0or_kQ7kNvwHDzVnI&_nc_oc=AdqUUWtL_FORVK3TR7WC5qDCOgmIAuQlt4fzKts7tml4fGbbfDEhcbS-4oPHBlfv1BU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcK1eoRHElwm5s8hsG5RAGPRSkl-Lpit_F1ZiceNy5Rw&oe=6AE48D63"}, "display_name": "2MD: VR Football Unleashed", "keywords": ["Football", "Gridiron", "NFL", "Quarterback", "American"], "long_description": "2MD is a groundbreaking motion-controlled VR football game. Draw the plays, call the shots, and throw, hand-off, or run the ball before the clock runs out!\n\n\u2023 Throw like a pro with realistic motion controls in a room-scale quarterback experience.\n\u2023 Draw plays and hone your strategy: customize up to 8 offensive plays in VR before taking the field.\n\u2023 Featuring 8 unique teams. Customize colors, QB voice, route color, and more.\n\u2023 Includes 8 immersive stadiums filled with thousands of screaming fans.\n\u2023 Featuring the voice talents of Xander Mobus, SungWon Cho, David Wald, and more.\n\u2023 Exciting arcade presentation with a 7-round heat and rapid-fire bonus rounds.\n\u2023 Spectacular replay-ability, challenging AI, achievements, leader-boards and a virtual trophy case.", "short_description": "2MD is a groundbreaking motion-controlled VR football game. Draw the plays, call the shots, and throw, hand-off, or run the ball before the clock runs out!\n\n\u2023 Throw like a pro with realistic motion controls in a room-scale quarterback experience.\n\u2023 Draw up to 8 offensive plays in VR before taking the field.\n\u2023 Featuring 8 customizable teams and 8 immersive stadiums.\n\u2023 Exciting arcade presentation, challenging AI, achievements, leader-boards and a virtual trophy case, and much more."}]}, "developer_name": "Truant Pixel, LLC", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Truant Pixel, LLC", "support_website_url": "http://truantpixel.com/", "website_url": "http://2mdvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "684401012583952"}}]}, "scheduled_offers": {"count": 55, "nodes": [{"status": "PUBLISHED", "id": "1003738102023932"}, {"status": "PUBLISHED", "id": "35502523609338414"}, {"status": "PUBLISHED", "id": "1926237277979371"}, {"status": "PUBLISHED", "id": "949750407588861"}, {"status": "PUBLISHED", "id": "4242521832686850"}, {"status": "PUBLISHED", "id": "3222377654588663"}, {"status": "PUBLISHED", "id": "1331787068656187"}, {"status": "PUBLISHED", "id": "1105208951563845"}, {"status": "PUBLISHED", "id": "1110214767880546"}, {"status": "PUBLISHED", "
ent-iad3-2.oculuscdn.com&oh=00_AfsUZQ1oKe9_iG_k04-XnDeYwMW-DvAcm_dAW82VxUFG_Q&oe=699DA946"}, {"file_name": "Pscreen1.png", "id": "498911371949854", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556792_498911378616520_3402432354417979040_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H35q_XTSmYQ7kNvwGlW0VP&_nc_oc=AdkzmBPrXfVFMfvt5COvgX1EFyXeYAyRO1_mWAGTtjDkAN7rGmqNOALzpbtY68oeAv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuoqcNfJUa0oWvy9LhOYPvQKs7uLQN1QS_WolQ_ZnFr2Q&oe=699DA760"}, {"file_name": "PScreen4.png", "id": "283275040667626", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462964_283275044000959_6989615064382068054_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=su1F30wrlWYQ7kNvwFrqcQD&_nc_oc=Adl8IgtFM6cqvyIr08jnheEsxzp4e4TMzilvTDYwzh44avr5nWKDLst5qorkQLXt7i4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwGrT3vkoEO7zJH0oz7sCpQObX98wBfe7laBBgFT98Iw&oe=699DB7DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tumbnail.png", "id": "681720729911680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75641341_681720733245013_4348477775890339095_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S27qMbXw-NkQ7kNvwH6qhqy&_nc_oc=Adl_ms3Rk1vEQ8yPrZnnVE9qt2eCH30dCYVMxj6kRv2GbUyGzJUqHuiwt5XaPK5OcUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQsoJLDVrmfqmJrOBhvYsuElLPDDZo1sdIdUcg_M4VQw&oe=699DADC9"}, "display_name": "VR Blast", "keywords": [], "long_description": "\u26a1Lock N\u2019 Load!\u26a1\nVR Blast is an incredible roguelite arcade shooter that takes you into a unique world where you blast Blocks with awesome weapons!\ud83d\udd2b\nDive into the arcade with immersive graphics, gameplay, and music - sitting or standing, VR Blast will blow your mind! Find the perfect match, trigger explosions and eliminate Shielded Blocks to avoid overloading the Board - or it\u2019s game over!\ud83d\udd79\ufe0f Unlock upgrades and choose the ultimate powerups to reach the furthest level possible!\n\ud83d\ude80The arcade is waiting - let\u2019s blast!\ud83d\ude80\n\n\ud83c\udfb6ORIGINAL MUSIC\nA plethora of incredible original music composed by amazing artists for the best Block-busting experience!\n\n\ud83c\udfb2POWERUPS GALORE\nVariety of powerups to unlock and choose from, making each run different and unique!\n\n\ud83d\udd2bAWESOME WEAPONS\nIncredible unique weapons to unlock and choose from!\n\n\ud83e\udde9WHOLE LOTTA BLOCKS\nTons of special useful and harmful Block types that will make every level feel new!", "short_description": "\u26a1Lock N\u2019 Load!\u26a1\nVR Blast is an incredible roguelike arcade shooter that takes you into a unique world where you blast Blocks with a variety of awesome weapons!\ud83d\udd2b Dive into The Arcade with immersive graphics, gameplay, and music- sitting or standing, VR Blast will blow your mind! \ud83d\udd79\ufe0f \nFind the perfect match, trigger satisfying explosions, eliminate shielded Blocks and choose the ultimate powerups to avoid overloading the board - or it\u2019s game over! \ud83c\udfae\u274c\n\ud83d\ude80The Arcade is waiting - let\u2019s blast!\ud83d\ude80"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.inperson.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "inperson", "support_website_url": null, "website_url": "https://www.inperson.io/vrblast", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
589915430004_3704413149680631808_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yk3rrZ0stH8Q7kNvwG9b_Fp&_nc_oc=AdkQBhmsMrvE22ZZtBX563wyurzHyZQ4aBueYxbczxfWhqm-5BgrqPvWwWKH-hRxOr4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyAtEM_KsD2dEdzgTaRSsETwE-T6mKQuLLQ4nUlD4EPfA&oe=69AAC431"}, {"file_name": "migrated_image.png", "id": "938050056624081", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12482156_153058115384598_32681505666891776_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vimUsjTmYKQQ7kNvwFKjC5d&_nc_oc=AdmCkvFb6V2nVsu5j-ztN-Pv4AgFMpr9s4AnLgXyNz5Ea8uZrYyROR5PEbsLdsWYHZY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzzV_lEqjcBsTuF7D_R4_jM30rZJQ0EzugWQxLvfI2GA&oe=69AAD988"}, {"file_name": "migrated_image.png", "id": "579807352621231", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12504728_151749835510487_8140299121526308864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvPAlDolV2QQ7kNvwE1lBNw&_nc_oc=AdlkoyRzlA9M3crd2JUnXJTewPuJx5_TjVX3wjEGO-XvMFChttRsmsndbmXV5pDlJCw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBmzkCR6jUxxL2Iv_a8c9P66GFOUD1hCyG6GgPg8dZFQ&oe=69AAE57C"}, {"file_name": "migrated_image.png", "id": "630777684368006", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12410200_336720836735255_7517390793292644352_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDMhhvtkOCcQ7kNvwFVoCVJ&_nc_oc=Adl5N2rRGTAqeLlhsTM2bT3gpEIF7PljA8HffguY8QGxJOJzrvvAP1e75UueJXHnSik&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyM9JAls4Goo7IWkB0Ytiaa0VSRsdW96tApzobp9lOvOw&oe=69AAC389"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jeep\u00ae Sessions: Surfing in 360\u200b\u00b0", "keywords": ["surf", "surfing", "jeep", "wsl", "interactive"], "long_description": "They say that every adventure begins with a choice. Yours starts here. In this interactive 360\u02da video experience, you decide how your journey unfolds. Pick a pro surfer to ride with \u2013 Jordy Smith or Malia Manuel \u2013 and explore paradise off the beaten track as you search for the ultimate wave in your Jeep\u00ae Wrangler or Jeep\u00ae Renegade. A classic choose-your-own-adventure story, there\u2019s a different wave waiting for you just beyond each intersection.  \n \n- Stream or Download: Choose which method suits you and your internet connection. High resolution 4K or HD 360\u02da video available depending on your device compatibility.\n- Gaze-based interactive choices and multiple paths: Choose which surfer you want to ride with and which path you want to take by looking.\n- Jump straight in: No log-in or sign-up required. Start your adventure right away.\n\nJeep\u00ae Sessions: Surfing in 360\u200b\u00b0 \u200bis presented by World Surf League and Jeep. \n \nJeep is a registered trademark of FCA US LLC.", "short_description": "They say that every adventure begins with a choice. Yours starts here. In this interactive 360\u02da video experience, you decide how your surfing journey unfolds."}]}, "developer_name": "Rapid", "developer_privacy_policy_url": "http://www.worldsurfleague.com/pages/privacy-policy", "developer_terms_of_service_url": "http://www.worldsurfleague.com/pages/privacy-policy", "publisher_name": "Jeep\u00ae and World Surf League", "support_website_url": null, "website_url": "http://www.worldsurfleague.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1314
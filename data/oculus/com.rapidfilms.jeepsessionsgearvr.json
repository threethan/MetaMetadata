cb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYJKg5wD5ikQ7kNvwGriwXT&_nc_oc=AdpXegJmfXS2c0AR2vLrE7oByycBQ25rN_fAJqeuVjVVrGAOu5bZUZgcGZ7rNBJF4sU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtQsjpH5IBIrBATHG1rUal7WI0yWYLx841P_cKGzEiZA&oe=69C14EFC"}, {"file_name": "migrated_image.png", "id": "496473374359028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410200_336720836735255_7517390793292644352_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRGx7SxSAoAQ7kNvwEXcGcq&_nc_oc=Adp9bV-neQH_gaPozZduJwbfGVi5lLwC4WkfYQ56hIcGs5Ow6Sd6DLLhiKoWhlIDLIc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkGIHEuJ6wSTX-QbQDBDNJIW0PJn2t9ZzOfDiEMZa4Dg&oe=69C12D09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JeepSessions_Screenshot_5.png", "id": "987622218057050", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162791_987622221390383_3291791741723607040_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuoFWHQpT98Q7kNvwH4qKkk&_nc_oc=Adomwjp9Wk9Q0Do1LGdOLol2HizNmHgoj0ptfvhP3rfl6bRg8VSyVUpYzKipZBJJbEY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzEq5rWBBVEIQ1Sn4XYKeqnSzMb-VkpqFROuBke8HF1kQ&oe=69C125FB"}, "display_name": "Jeep\u00ae Sessions: Surfing in 360\u200b\u00b0", "keywords": ["surf", "surfing", "jeep", "wsl", "interactive"], "long_description": "They say that every adventure begins with a choice. Yours starts here. In this interactive 360\u02da video experience, you decide how your journey unfolds. Pick a pro surfer to ride with \u2013 Jordy Smith or Malia Manuel \u2013 and explore paradise off the beaten track as you search for the ultimate wave in your Jeep\u00ae Wrangler or Jeep\u00ae Renegade. A classic choose-your-own-adventure story, there\u2019s a different wave waiting for you just beyond each intersection.  \n \n- Stream or Download: Choose which method suits you and your internet connection. High resolution 4K or HD 360\u02da video available depending on your device compatibility.\n- Gaze-based interactive choices and multiple paths: Choose which surfer you want to ride with and which path you want to take by looking.\n- Jump straight in: No log-in or sign-up required. Start your adventure right away.\n\nJeep\u00ae Sessions: Surfing in 360\u200b\u00b0 \u200bis presented by World Surf League and Jeep. \n \nJeep is a registered trademark of FCA US LLC.", "short_description": "They say that every adventure begins with a choice. Yours starts here. In this interactive 360\u02da video experience, you decide how your surfing journey unfolds."}]}, "developer_name": "Rapid", "developer_privacy_policy_url": "http://www.worldsurfleague.com/pages/privacy-policy", "developer_terms_of_service_url": "http://www.worldsurfleague.com/pages/privacy-policy", "publisher_name": "Jeep\u00ae and World Surf League", "support_website_url": null, "website_url": "http://www.worldsurfleague.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465842138547984"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2088677858014151"}, {"status": "PENDING", "id": "175606029750559"}]}, "baseline_offer": {"id": "2088677858014151"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1521824400, "status": "PUBLISHED", "id": "2088677858014151"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "952518188206570", "
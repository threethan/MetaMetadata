3643407595", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_492293646740928_7203865301528034244_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRIy9INU_W0Q7kNvwHh8ZIs&_nc_oc=Adoau2OhqtbLMXqxElhchhlCpAHp_fCjjVhEmvMaUIQF3urXl9EAV1pS4wSmRk03-Gk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7Lwxi5Ovd_AwSVFYdgcN9jWkY5s1lUSZNfwNukVia2A&oe=6B104CDF"}, {"file_name": "Dance_Dance_Dance_009 (1).png", "id": "393149327127538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982547_393149330460871_840341199805784967_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5Zl5ZzDF1cQ7kNvwGCtjhj&_nc_oc=Adpyth4ehQ-_0vovEJQHU6QSBTBy3K-WknT1VWhXnPZJ24qIA2op7isinK_UcSgxnqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWVu8MAvzyJbFBc5J-tIkKZbkADdWfzXIimNOzmo1RlQg&oe=6B103697"}, {"file_name": "Dance_Dance_Dance_011 (1).png", "id": "380736851722706", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031341_380736858389372_3974040844103626110_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te3JlRoNkIAQ7kNvwF96vml&_nc_oc=AdoQw3Uq1IyG4T886MISHla9T9yOYPnupSY_Or8u7AOgxoFrVevXBq9pz65F0q-eI8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVxScGitmPlDU3U0LKOJ8Lk_H0FkTi6HUox0AL-S1EhvA&oe=6B105EEE"}, {"file_name": "Dance_Dance_Dance_004 (1).png", "id": "400084085982815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307249_400084089316148_2925361379921323579_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zXzVpzjstsQ7kNvwFdGeT0&_nc_oc=AdpXP1xItxutrNQgzNcgQGFCUcVe-lQiwDQbyCfnLdT6479rFiokWAr9ecmIKnT8vy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJ_emGap3QqFGTw20Zdv-WXAo7SrggLX5GctFAQWrsXA&oe=6B104401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DDD_CoverLandscape.png", "id": "884714613377280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974648_884714620043946_7549046262467117853_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xwjbvy-_sScQ7kNvwGykOgF&_nc_oc=Adrl9BXPBo5XbWAig1b-HU3au1u5b65V4AOiq5ebCO6HwvmKGS3SpW7k4jMej5Tbc4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXBvULJjgPa1Nk_y14VywpwGw455vr-ABmmXCcPpvAj3g&oe=6B106A71"}, "display_name": "Dance! Dance! Dance!", "keywords": ["Music", "Beats", "5v1", "DDD", "Bubblelicious"], "long_description": "**Dance! Dance! Dance!** is an exhilarating rhythm game featuring two captivating modes:\n\nIn **DANCE** mode, players follow a dance instructor, mimicking their moves with precision. As you dance, pop bubbles strategically placed to replicate the moves, earning points, combos, and streaks for accuracy. As the difficulty increases, master specific hand gestures, directional movements, and faster bubble speeds to keep up.\n\nIn **BATTLE** mode, the focus shifts to popping bubbles in sync with the music while facing additional challenges. With up to five instructors switching bubble patterns, you'll need to stay sharp. Navigate obstacles like red walls and red bubbles, and hit special colored bubbles for higher scores. Successfully hitting these bubbles earns you Bubble Dollars (Bubble$), the in-game currency. Embrace the rhythm, hone your skills, and conquer the dance floor in Dance! Dance! Dance!\n\n**Embrace the rhythm, master the battle arena, and show the world what it means to Dance! Dance! Dance!**\n\n# Difficulty Modifiers\nIncrease or decrease the difficulty with a wide range of fun gameplay modifiers such as:\n- Instant fail\n- Perfect timing\n- Gesture bubbles\n- Directional bubbles\n- Left/Right hand only\n\n# Leaderboards\nCompete globally or with your friends for the best score. Use the difficulty modifiers to dominate the top rank!\n\n# Your Favourite Tracks\nGroove your way to top of the leaderboards with songs we all love and know such as:\n- Good Times\n- Move Your Feet\n- Boogie Nights\n- Take On Me\n- Boogie Oogie\n", "short_description": "Join the ultimate dance party where your favorite tracks come to life! Follow the dance instructor, groove to the beat, and show off your moves. Pop bubbles in sync with the rhythm to rack up points and dominate the leaderboard. With every song, you\u2019ll experience a blend of fun, fitness, and pure joy. Get ready to dance, pop, and win in this electrifying rhythm adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vstars.co.uk/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vstars LTD", "support_website_url": null, "website_url": "https://vstars.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086383398081663"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "832170645840582"}, {"status": "PUBLISHED", "id": "690775106774705"}, {"status": "PUBLISHED", "id": "950631993840350"}, {"status": "PUBLISHED", "id": "1349329242742499"}, {"status": "PUBLISHED", "id": "947709033954832"}, {"status": "PUBLISHED", "id": "535102692292203"}, {"status": "PUBLISHED", "id": "1579996292584621"}, {"status": "PUBLISHED", "id": "499918852532639"}]}, "baseline_offer": {"id": "832170645840582"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761829200, "status": "PUBLISHED", "id": "832170645840582"}]}, "liveChannel"
560x1440_002 1.png", "id": "1460223918773482", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307931_1460223922106815_6843996253463915596_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYjPdluL2iwQ7kNvwFWoyp9&_nc_oc=AdqnyoW0bGpkAXxgB0qb7u3HIlHHOBhxcgofLplXmGFrFdU2wwmJMrz3TSb1YJExa7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AXiq5lvEyQG3GxFS9xYTx_Hx8nil5kbVI6XwI15X30Q&oe=6A280A68"}, "display_name": "VimedixXR", "keywords": ["education", "simulation", "healthcare"], "long_description": "VimedixXR is a next-generation mixed reality application for the Meta Quest that connects directly to Elevate Healthcare\u2019s high-fidelity Vimedix ultrasound simulator, transforming traditional screen-based learning into an immersive, hands-on experience. As learners scan the Vimedix manikin, VimedixXR renders the underlying 3D anatomy and the live ultrasound beam in their field of view, helping them understand exactly how probe movements translate into image planes and clinical findings.\n\nBuilding on the proven Vimedix platform used to teach cardiac, lung, abdominal, and OB/GYN ultrasound, VimedixXR lets users enlarge, rotate, and isolate anatomical structures in space, or return them seamlessly into the virtual patient to maintain anatomical context. This interactive visualization accelerates the development of psychomotor skills, spatial reasoning, and pattern recognition as learners explore a broad library of pathologies and practice key measurements, calculations, and image interpretation in a safe, repeatable environment.\n\nDesigned for both individual and group teaching, VimedixXR supports shared immersive sessions in which instructors can guide learners around holographic anatomy, demonstrate optimal probe positioning, and highlight the relationship between structures and the ultrasound beam.", "short_description": "VimedixXR is a mixed reality extension of Elevate Healthcare\u2019s Vimedix ultrasound simulator, bringing 3D anatomy and real-time ultrasound imaging into the Meta Quest headset so learners can see, manipulate, and understand internal structures as they scan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://elevatehealth.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Elevate Healthcare, Inc.", "support_website_url": "https://elevatehealth.net/contact-us/", "website_url": "https://elevatehealth.net/solutions/brands/vimedix/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26903762619212997"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "853663931034640"}]}, "baseline_offer": {"id": "853663931034640"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774006980, "status": "PUBLISHED", "id": "853663931034640"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27367067096215878", "version": "1.0.120"}, "id": "1947949059407504", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26903762609212998", "is_concept": false, "latest_released_binary": {"__type
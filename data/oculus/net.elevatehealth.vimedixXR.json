If95D&_nc_oc=AdpMGqSuR8U1IDryDjfNfNbn2dBvbE31RoBf2NrshdTYu36RC1xXNmL9gc6RPW74dRM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArGwZVhC64mluRpW2ehEB0AbAM1cnFXotiL2cElYtfow&oe=6A5A1937"}, {"file_name": "vimedix03.png", "id": "1945395096186082", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499305194_1945395099519415_3759088597941856866_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5jpQoRQmUIQ7kNvwEpMCx-&_nc_oc=AdpU-OZGvtSsiL5gV7myaiZgnzBYASmTiku4QGSVIJBOqfaaFKeauyH1mc7MfcTZru8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWlU9nNs_R17FpBRGGqgoSdJpnBA-Zo4G2-do3QdY15g&oe=6A5A314E"}, {"file_name": "vimedix04.png", "id": "1438166621010072", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307602_1438166624343405_5486832361474291795_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4QK2DZRy28Q7kNvwGFhSkL&_nc_oc=AdqK8lcbHxTN6nsXjeZrO8qlzWIx1lI3A85XkG_kpG8E1J5Fw9AzvEQ4kwjZ52Q5c2w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBaMQV-BXR4abLRmIk_8CAwPPrg6Q_gJTATUY1XKwDRg&oe=6A5A33BC"}, {"file_name": "vimedix05.png", "id": "776518678337358", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300910_776518681670691_7364217192751034760_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfJ1VZ8i_m4Q7kNvwFWcJuE&_nc_oc=AdofV0fNnIUQlckXrLZigPnZa8WWOWO2AHoYWB7Z3ISqZucthD30OC_MIK4m9Ls8iX8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3cIS9qdF3xSwcys_sc5b0q7yfcRtR4qnflDW0iMRHoQ&oe=6A5A4368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vimedix_xr_2560x1440_002 1.png", "id": "1460223918773482", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307931_1460223922106815_6843996253463915596_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9KzLKNPD3wQ7kNvwGIUxWF&_nc_oc=AdpPPag2ETiiz69KoA87llRRuqi3NY0m7aDvZDri2NFVltY_0pXH4ChAR0rVzVJ06PA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjqIdYZDTcG_5ZULbJUAUsOPQIV3Y6pgW59jqBoJoweA&oe=6A5A2368"}, "display_name": "VimedixXR", "keywords": ["education", "simulation", "healthcare"], "long_description": "VimedixXR is a next-generation mixed reality application for the Meta Quest that connects directly to Elevate Healthcare\u2019s high-fidelity Vimedix ultrasound simulator, transforming traditional screen-based learning into an immersive, hands-on experience. As learners scan the Vimedix manikin, VimedixXR renders the underlying 3D anatomy and the live ultrasound beam in their field of view, helping them understand exactly how probe movements translate into image planes and clinical findings.\n\nBuilding on the proven Vimedix platform used to teach cardiac, lung, abdominal, and OB/GYN ultrasound, VimedixXR lets users enlarge, rotate, and isolate anatomical structures in space, or return them seamlessly into the virtual patient to maintain anatomical context. This interactive visualization accelerates the development of psychomotor skills, spatial reasoning, and pattern recognition as learners explore a broad library of pathologies and practice key measurements, calculations, and image interpretation in a safe, repeatable environment.\n\nDesigned for both individual and group teaching, VimedixXR supports shared immersive sessions in which instructors can guide learners around holographic anatomy, demonstrate optimal probe positioning, and highlight the relationship between structures and the ultrasound beam.", "short_description": "VimedixXR is a mixed reality extension of Elevate Healthcare\u2019s Vimedix ultrasound simulator, bringing 3D anatomy and real-time ultrasound imaging into the Meta Quest headset so learners can see, manipulate, and understand internal structures as they scan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://elevatehealth.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Elevate Healthcare, Inc.", "support_website_url": "https://elevatehealth.net/contact-us/", "website_url": "https://elevatehealth.net/solutions/brands/vimedix/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26903762619212997"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "878531141974253"}, {"status": "PUBLISHED", "id": "853663931034640"}]}, "baseline_offer": {"id": "878531141974253"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781029380, "status": "PUBLISHED", "id": "878531141974253"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28480472744875302", "version": "3.10.1"}, "id": "1947949059407504", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26903762609212998", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28480472744875302"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782758767, "id": "28481031698152740", "version": "3.9.0", "version_code": 90, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, 
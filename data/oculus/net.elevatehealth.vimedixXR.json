69216", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821193_4415330375402549_2303700945558378347_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1u_ywJKITkQ7kNvwFFutqM&_nc_oc=AdpcqRkfeRdD1aVhMfcz-BlEh2P6Ow6bazHDbtwgTnsqhkpzY8_A2rXDC5qghnfmhJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVYAgvCwR0FYTh2t-yqYAHVyTyk95UMhSNtwp2jvKGrQ&oe=6B006E77"}, {"file_name": "vimedix03.png", "id": "1945395096186082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305194_1945395099519415_3759088597941856866_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2CoYrW-KSwQ7kNvwFimOnV&_nc_oc=Adp-7OXrg126Jse8GeZOk56yUN5sA4ORsP0i2MwkcvxSVZoBjW66g3ZeNCx_Mwto6OU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy9dVEStFxp_Lh6ld1ln1w4ZyrBOTaiPSNy7yoM0ztmQ&oe=6B00868E"}, {"file_name": "vimedix04.png", "id": "1438166621010072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307602_1438166624343405_5486832361474291795_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv1ZzTSyKMsQ7kNvwFuXhmY&_nc_oc=AdqVamoBeEd52wCCxbojuTnM5kOge313tsWU9pSeROhW1WwJ_dYtyEAhVnGUlspWq6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYoY9zdx3ghsTsCTTDsoHYYrf1gZjEvTgKUs4uE7iGHA&oe=6B0088FC"}, {"file_name": "vimedix05.png", "id": "776518678337358", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300910_776518681670691_7364217192751034760_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fnPbbjEFy8Q7kNvwEbuBSr&_nc_oc=AdqEx7XMqiEc9Y-XVg82dmQEHl_isaSxadWsItYDd9mXzc_mvoGbYDd70xGio6FZl5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDN20N_yn-7IVuj3h46mjth8-CcTt5kDfhfkShgguIuQ&oe=6B006068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vimedix_xr_2560x1440_002 1.png", "id": "1460223918773482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307931_1460223922106815_6843996253463915596_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM_uEMWHPF8Q7kNvwHh9fcD&_nc_oc=AdoPu3wVRCRx5r7Fv9IjOd6U4ng_WVxqksiSIZhikr_-tDFy5FnnjCK6gmWXo5MwSjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWBNgPC_8YGvclBBu5MTnhtDXvifgrrzv6iqM2jCtMCw&oe=6B0078A8"}, "display_name": "VimedixXR", "keywords": ["education", "simulation", "healthcare"], "long_description": "VimedixXR is a next-generation mixed reality application for the Meta Quest that connects directly to Elevate Healthcare\u2019s high-fidelity Vimedix ultrasound simulator, transforming traditional screen-based learning into an immersive, hands-on experience. As learners scan the Vimedix manikin, VimedixXR renders the underlying 3D anatomy and the live ultrasound beam in their field of view, helping them understand exactly how probe movements translate into image planes and clinical findings.\n\nBuilding on the proven Vimedix platform used to teach cardiac, lung, abdominal, and OB/GYN ultrasound, VimedixXR lets users enlarge, rotate, and isolate anatomical structures in space, or return them seamlessly into the virtual patient to maintain anatomical context. This interactive visualization accelerates the development of psychomotor skills, spatial reasoning, and pattern recognition as learners explore a broad library of pathologies and practice key measurements, calculations, and image interpretation in a safe, repeatable environment.\n\nDesigned for both individual and group teaching, VimedixXR supports shared immersive sessions in which instructors can guide learners around holographic anatomy, demonstrate optimal probe positioning, and highlight the relationship between structures and the ultrasound beam.", "short_description": "VimedixXR is a mixed reality extension of Elevate Healthcare\u2019s Vimedix ultrasound simulator, bringing 3D anatomy and real-time ultrasound imaging into the Meta Quest headset so learners can see, manipulate, and understand internal structures as they scan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://elevatehealth.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Elevate Healthcare, Inc.", "support_website_url": "https://elevatehealth.net/contact-us/", "website_url": "https://elevatehealth.net/solutions/brands/vimedix/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26903762619212997"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "878531141974253"}, {"status": "PUBLISHED", "id": "853663931034640"}]}, "baseline_offer": {"id": "878531141974253"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781029380, "status": "PUBLISHED", "id": "878531141974253"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29864218013167428", "version": "4.0.8"}, "id": "1947949059407504", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26903762609212998", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29864218
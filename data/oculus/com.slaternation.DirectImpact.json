play_name": "Trigger Warning", "keywords": [], "long_description": "Inspired by 90s arcade shooters Trigger Warning has an ever expanding library of fast-paced minigames. Faster and more accurate shooting will award you higher scores. Four difficulty levels ensure a fun and challenging time for players of all skill levels. Choose from two play modes: \nArcade - Try to complete all minigames (16 currently) without losing your lives. \nFree Play - Hone your skills by practicing all minigames without fear of running out lives. Compete for high scores \n", "short_description": "Inspired by 90s arcade shooters Trigger Warning has an ever expanding library of fast-paced minigames. Faster and more accurate shooting rewards players with higher scores. Four difficulty levels ensure a fun and challenging time for players of all skill levels. Choose from two play modes: Arcade, and Free Play. Play comfortably seated or standing. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triggerwarningvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SlaterNation LLC", "support_website_url": null, "website_url": "https://www.triggerwarningvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "CASUAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "724603382069268"}, "review_messages": []}]}, "cover_square_image": {"
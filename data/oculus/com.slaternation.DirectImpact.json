ers Trigger Warning has an ever expanding library of fast-paced minigames. Faster and more accurate shooting rewards players with higher scores. Four difficulty levels ensure a fun and challenging time for players of all skill levels. Choose from two play modes: Arcade, and Free Play. Play comfortably seated or standing. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triggerwarningvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SlaterNation LLC", "support_website_url": null, "website_url": "https://www.triggerwarningvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "CASUAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "724603382069268"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5907660149266077", "version": "1.0"}, "id": "243241754046263", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4400045353360905", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5907660149266077"},
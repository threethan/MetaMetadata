ontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823934_845034501831221_1095303969951457982_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v92WuOAQhJIQ7kNvwHNkBUU&_nc_oc=AdoY_s5yKWPJB0fZNKmeP23j6zJwV-RmhrY7fpbwbJWr5AT5fGux8Ts-WD31ksfxUC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG-mvKtyyxs7WsOdfXSGwWCjqpfVVlU9YvB0tw8tTQAQ&oe=6AB92115"}]}, "id": "1545876336558062", "locale": "en_US", "screenshots": [{"file_name": "screenshot1 (3).png", "id": "1204504498464755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_1204504501798088_4482078218547383827_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fSBrXlRZJkQ7kNvwHr0HYG&_nc_oc=AdrtCvqaIQtbHDCkMdlfD3iV_FArXKlgpokPt876DFyFV39L3Bpy6N7bgLTTLwUCCH8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkWvfIMTA7oMf0-ygVfZ3lb6GF-Pt2C1iPMWsnGEscLw&oe=6AB93C3A"}, {"file_name": "screenshot1 (4).png", "id": "1824670011485853", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_1824670014819186_8747008815267867761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqTyaqmtEf8Q7kNvwFG4L5L&_nc_oc=AdrtMbleVgxZUxOTNmXFTVWefttjWIibDRoRb5UEEIlAn0mO72OpYAZP4gd13-9hOcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXsAsrwFuYxphHCsooLv1tCkgj03kVXM7O_0pG1V1bJg&oe=6AB93ADE"}, {"file_name": "screenshot1 (5).png", "id": "900078242447043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_900078245780376_4815170163205149921_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs9DW_-A16QQ7kNvwH7PZKL&_nc_oc=AdpSPMHN0WiqEIdDAdrRdcYBi0BiQGAZ9Jmf10C1jJzKKXUvjyPsejdEAL4bnRCmylE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfSs0fN-rIWz7xprxPQQ7Wjjw2LrBtSXGsACEmKSSfMw&oe=6AB9248E"}, {"file_name": "screenshot1 (1).png", "id": "1547046706565807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824532_1547046709899140_5505035561949246062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sCZnTXaeqQQ7kNvwH9YjZ4&_nc_oc=AdoxIi53QVyCIabxo6Wg9llazmdcr4q_tcRKs53w6SaqsGuu83z2un3hiuLtD9abztQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXPtR0RU-4o4f8hL8IbZBlWWYKFMad2ghKWPjL2dbhCw&oe=6AB91234"}, {"file_name": "screenshot1 (2).png", "id": "846010284711918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619685_846010288045251_5500004015631960924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKgKwxf9dkIQ7kNvwFV2mDz&_nc_oc=Adp2Spb0TO9AEiZdPZ6bRORg5l5Wva0TfDxTtMUejTWuA6HcMTU8JWB3ljkRb-C6jDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLicDq2uXYlIeDrvp-nkc0nWWBICeVRsaEQmKnzYci56w&oe=6AB92027"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pathfinder", "keywords": ["journaling", "meditation", "creativity", "selfcare"], "long_description": "**Start the conversation with yourself.**\n\nPathfinder is an immersive tool for self-discovery and creative thinking. Using metaphorical cards\u2014rich, open-ended images\u2014it helps you bypass logical blocks and access your intuition. \n\n**How It Works:**\n1. **Choose a Topic:** Focus on a question, obstacle, or goal.\n2. **Draw Cards:** Select images that resonate with your situation and desired future.\n3. **Reflect:** Use voice-to-text or typing to capture insights. Guided prompts help you dig deeper.\n\n**Key Features:**\n* **Immersive VR:** A quiet, distraction-free space for your inner world.\n* **Metaphorical Deck:** Diverse images designed to spark creative insight.\n* **Voice Journaling:** Seamless transcription powered by Wit.ai.\n* **Private by Design:** No account creation required. All journals and history are stored locally on your headset.\n\n**Data Privacy & AI Disclosure:**\n\nIn compliance with developer data policies, Pathfinder uses Wit.ai to provide voice-to-text functionality. Voice data is transmitted to Wit.ai solely for the purpose of real-time transcription to enable the journaling feature. We do not store voice recordings, and your data is not used to train AI models.\n\n**Use Pathfinder to:**\n* Gain clarity on tough decisions.\n* Reconnect with your intuition.\n* Brainstorm creative ideas in a calm environment.", "short_description": "Unlock clarity with Pathfinder, an immersive VR tool for self-reflection. Use metaphorical cards to explore thoughts and define goals. Features AI-guided prompts and voice-to-text journaling powered by Wit.ai. To provide this service, voice data is processed by Wit.ai for real-time transcription only. We do not store voice recordings or use your data to train AI models. No account required\u2014all insights are stored locally on your headset for total privacy.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vR2jvcL4YAsnp7Za52r3Uv_xP-enX1CTFXBxewZnI4wyqQO56pziHYMQGUy6BmXBXG0tTYQ7XYoqdAh/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTguQqP8uCxKiY1nMxBWLbtmF0rwZ9jHGA_2y2NnsKbz_Nlp163o9_E4UjbWCA4Ka6WZgvP_d90A7Dx/pub", "publisher_name": "HumanSide", "support_website_url": null, "website_url": "https://www.thepathfinderquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25278630491831354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_1203648778361508_88799605377373133
ed design (20).png", "id": "845034498497888", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823934_845034501831221_1095303969951457982_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjCqBA5tISIQ7kNvwFmsCiU&_nc_oc=AdoagJ0mobTo1gXtIyoTukZGWUjxVIKwrcP42eseHq0SmRGFoBmeUUgW84KrxMbWuEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTemEaApMH-cU_zWTPiyaPDTSEj3uLkMAl_QFjsnMypQg&oe=6B09C4D5"}]}, "id": "1545876336558062", "locale": "en_US", "screenshots": [{"file_name": "screenshot1 (3).png", "id": "1204504498464755", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_1204504501798088_4482078218547383827_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxUBYApIkl4Q7kNvwEy4Tae&_nc_oc=AdrQiWXl0z671o4yX84HGMvL6_uBUyRjKhz_cPOtpblmjEHPyH_IK4fWvYlcJZCiMd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq4bAhJUVJCot881b8ZG2zAMKlJTXXPYSdfNHa-Ziw9g&oe=6B09A7BA"}, {"file_name": "screenshot1 (4).png", "id": "1824670011485853", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_1824670014819186_8747008815267867761_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We20XD32bYUQ7kNvwHfZkBq&_nc_oc=AdoOEwAhBJ3n6HgU3Vq3WALTtfUg3-WxWLleYIOpTMhbyhyvquY6DEWJ74qfPAqjDIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPl1bX8KC34COGQYhHwclp4sWV-QulU_xlMOZd24792w&oe=6B09A65E"}, {"file_name": "screenshot1 (5).png", "id": "900078242447043", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619159_900078245780376_4815170163205149921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TK2u7BCanTMQ7kNvwEfYlo-&_nc_oc=AdqbTLADAtY5Z5xec1WfKedIPB2jXp76wESEkoVfIaVqMEzYYwgDVmAN0onLdu0hB_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZd5o4bw2tGY8FQzwVCHho8Vz1I1UDv2OF65gYMkyedg&oe=6B09C84E"}, {"file_name": "screenshot1 (1).png", "id": "1547046706565807", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824532_1547046709899140_5505035561949246062_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTVOodI9_7oQ7kNvwFljIFu&_nc_oc=AdraT2Kd8wDpbDxhtWEHCTXYKgishmQ0Qs1VtV-_Js6M-wvxTyV5fEDV56ddC0M2cq8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREofDAJeLBQhqVcku3QY1DvEc55GBai2B3yxx2neR30Q&oe=6B09B5F4"}, {"file_name": "screenshot1 (2).png", "id": "846010284711918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619685_846010288045251_5500004015631960924_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgU4eH0mRJIQ7kNvwGJ-H5-&_nc_oc=AdrkV7vQOjVohRap3vGQRz6Y0jx2ffHyjMG67_QYG_gRX4621Nq_1kxXDFq2cgt6sZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIv9IhdlzNfESgkW6q-YeEJPPClNlUFHtpxZHUFoNDvA&oe=6B09C3E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pathfinder", "keywords": ["journaling", "meditation", "creativity", "selfcare"], "long_description": "**Start the conversation with yourself.**\n\nPathfinder is an immersive tool for self-discovery and creative thinking. Using metaphorical cards\u2014rich, open-ended images\u2014it helps you bypass logical blocks and access your intuition. \n\n**How It Works:**\n1. **Choose a Topic:** Focus on a question, obstacle, or goal.\n2. **Draw Cards:** Select images that resonate with your situation and desired future.\n3. **Reflect:** Use voice-to-text or typing to capture insights. Guided prompts help you dig deeper.\n\n**Key Features:**\n* **Immersive VR:** A quiet, distraction-free space for your inner world.\n* **Metaphorical Deck:** Diverse images designed to spark creative insight.\n* **Voice Journaling:** Seamless transcription powered by Wit.ai.\n* **Private by Design:** No account creation required. All journals and history are stored locally on your headset.\n\n**Data Privacy & AI Disclosure:**\n\nIn compliance with developer data policies, Pathfinder uses Wit.ai to provide voice-to-text functionality. Voice data is transmitted to Wit.ai solely for the purpose of real-time transcription to enable the journaling feature. We do not store voice recordings, and your data is not used to train AI models.\n\n**Use Pathfinder to:**\n* Gain clarity on tough decisions.\n* Reconnect with your intuition.\n* Brainstorm creative ideas in a calm environment.", "short_description": "Unlock clarity with Pathfinder, an immersive VR tool for self-reflection. Use metaphorical cards to explore thoughts and define goals. Features AI-guided prompts and voice-to-text journaling powered by Wit.ai. To provide this service, voice data is processed by Wit.ai for real-time transcription only. We do not store voice recordings or use your data to train AI models. No account required\u2014all insights are stored locally on your headset for total privacy.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vR2jvcL4YAsnp7Za52r3Uv_xP-enX1CTFXBxewZnI4wyqQO56pziHYMQGUy6BmXBXG0tTYQ7XYoqdAh/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTguQqP8uCxKiY1nMxBWLbtmF0rwZ9jHGA_2y2NnsKbz_Nlp163o9_E4UjbWCA4Ka6WZgvP_d90A7Dx/pub", "publisher_name": "HumanSide", "support_website_url": null, "website_url": "https://www.thepathfinderquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25278630491831354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_1203648778361508_8879960537737313342_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR9IUU-UB1gQ7kNvwGjAApB&_nc_oc=AdqhtsWOk1el2KXxIBmOVmu3-4XnsPUlzrrZ5-nbgyjBDc-BPhvNI07g2gPwpGC-qQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRii-jwqZjVVB3BJtzXXRXkLvuHW5RoJhhx-fRqjoTfkQ&oe=6B09CAC6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pathfinder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1767867480, "lastRevision": {"nodes": [{"id": "24710873218607087", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24710873175273758", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1293716902561180"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Untitled design (19).png", "id": "1203648775028175", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_1203648778361508_8879960537737313342_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR9IUU-UB1gQ7kNvwGjAApB&_nc_oc=AdqhtsWOk1el2KXxIBmOVmu3-4XnsPUlzrrZ5-nbgyjBDc-BPhvNI07g2gPwpGC-qQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Trd0wzL9MeoUT975qVlR5g72ltfdiM_x8CVwWXV9ow&oe=6B09CAC6"}, {"file_name": "Pathfinder Cover.png", "id": "885587500791307", "image_type": "APP_IMG_COVER_LAN
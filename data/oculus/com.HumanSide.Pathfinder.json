a&_nc_oc=AdqC8N4rlFcRqilatfEzhVz-XfBw9idL0VJFemQapPFucHxtTLszvZUb8EYTpijHrR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mp90IbXgpA5goR_28id7Rwk2xAhIlrFoj1y-rt9WxDA&oe=6A2EA4B4"}, {"file_name": "screenshot1 (2).png", "id": "846010284711918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_846010288045251_5500004015631960924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvKpzyS7WBsQ7kNvwFE1Fzf&_nc_oc=AdrUqiwCuF5Z416Bm95zQ9k0615HveY_RiWYJzPaJ2Ufs2Ue_VUkCw0fK_2ceg8iM4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y7c6Q6a9uZGrtEDhx5nOuxpP9U27Z_smtPE5_nk_b-A&oe=6A2EB2A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pathfinder", "keywords": ["journaling", "meditation", "creativity", "selfcare"], "long_description": "**Start the conversation with yourself.**\n\nPathfinder is an immersive tool for self-discovery and creative thinking. Using metaphorical cards\u2014rich, open-ended images\u2014it helps you bypass logical blocks and access your intuition. \n\n**How It Works:**\n1. **Choose a Topic:** Focus on a question, obstacle, or goal.\n2. **Draw Cards:** Select images that resonate with your situation and desired future.\n3. **Reflect:** Use voice-to-text or typing to capture insights. Guided prompts help you dig deeper.\n\n**Key Features:**\n* **Immersive VR:** A quiet, distraction-free space for your inner world.\n* **Metaphorical Deck:** Diverse images designed to spark creative insight.\n* **Voice Journaling:** Seamless transcription powered by Wit.ai.\n* **Private by Design:** No account creation required. All journals and history are stored locally on your headset.\n\n**Data Privacy & AI Disclosure:**\n\nIn compliance with developer data policies, Pathfinder uses Wit.ai to provide voice-to-text functionality. Voice data is transmitted to Wit.ai solely for the purpose of real-time transcription to enable the journaling feature. We do not store voice recordings, and your data is not used to train AI models.\n\n**Use Pathfinder to:**\n* Gain clarity on tough decisions.\n* Reconnect with your intuition.\n* Brainstorm creative ideas in a calm environment.", "short_description": "Unlock clarity with Pathfinder, an immersive VR tool for self-reflection. Use metaphorical cards to explore thoughts and define goals. Features AI-guided prompts and voice-to-text journaling powered by Wit.ai. To provide this service, voice data is processed by Wit.ai for real-time transcription only. We do not store voice recordings or use your data to train AI models. No account required\u2014all insights are stored locally on your headset for total privacy.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vR2jvcL4YAsnp7Za52r3Uv_xP-enX1CTFXBxewZnI4wyqQO56pziHYMQGUy6BmXBXG0tTYQ7XYoqdAh/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTguQqP8uCxKiY1nMxBWLbtmF0rwZ9jHGA_2y2NnsKbz_Nlp163o9_E4UjbWCA4Ka6WZgvP_d90A7Dx/pub", "publisher_name": "HumanSide", "support_website_url": null, "website_url": "https://www.thepathfinderquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25278630491831354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_1203648778361508_88799605377373133
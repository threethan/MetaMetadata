ontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823934_845034501831221_1095303969951457982_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE5fltAa39cQ7kNvwEE9zTn&_nc_oc=AdrGQxAJHI0xTezUjAWqsyI8gur57jbKVjdN7_fVokZInAHJ5scyWgs7EFiUWh8grw8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3r_w_OTmYyK5GiS7eOvhT4K9HNNamsfbQwLy4Ez1PDJQ&oe=69F60315"}]}, "id": "1545876336558062", "locale": "en_US", "screenshots": [{"file_name": "screenshot1 (3).png", "id": "1204504498464755", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618093_1204504501798088_4482078218547383827_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1HrgsHjoeUQ7kNvwGiIUg9&_nc_oc=AdotKJwJrwwmy_bnEyFhNVcIIUoy2WCzjtpnAOUec_9RMYmuOHSIUrNTl0hbi-GAmIE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Vz-l6NQ8BYr7vZE1aQW8pgbeyBwsHOhT83pWhnAL1jw&oe=69F5E5FA"}, {"file_name": "screenshot1 (4).png", "id": "1824670011485853", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618093_1824670014819186_8747008815267867761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Go0stA9iymgQ7kNvwFSaP1C&_nc_oc=Adqxi5W6VRTbKpXJkqBxwdvV9SALguJBgucRm6ZQG1wqM0918y7h4NeF-9EyI_d_lJw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wpoG-GhwQZxKXP-ykcESuTbfV9mjZyAa5T7CFvoGNHg&oe=69F61CDE"}, {"file_name": "screenshot1 (5).png", "id": "900078242447043", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619159_900078245780376_4815170163205149921_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLtWCLENbtIQ7kNvwFxioe1&_nc_oc=Adot4hK0bHEnRKg_c79utSL-4xTsvQbK7_dx3NRahO0Wcj2_0N3c_9QtXrlWcSfPwgU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32G-p1pVfBfXkzXLeSRbkInzhnPnAdfQ4rMMeCRtSezQ&oe=69F6068E"}, {"file_name": "screenshot1 (1).png", "id": "1547046706565807", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824532_1547046709899140_5505035561949246062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wjqglGr5eoQ7kNvwFlwhQY&_nc_oc=Adqar8BYoGRQsHTo4XL8glFxI7ySy64tBPlJaJv9g3cd73w8OkLyVmt_KdDrSHvugr0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34WoFUXowHpQMHi00CJ-Lmdvx3H8PYs_vvRZVpZXM5PA&oe=69F5F434"}, {"file_name": "screenshot1 (2).png", "id": "846010284711918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619685_846010288045251_5500004015631960924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJKhW5c1ioAQ7kNvwFAS1TJ&_nc_oc=Adq7ql6KGli7ecHj3Nx1LVa8YP3efExgSlHRQUOPy0GI8TTcYTrHUO9qGYFBl-F8fi8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i-KuRP22HBtq5NtFHcmQ7tY5o0ZPrE2WTGBR73XIMXg&oe=69F60227"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pathfinder", "keywords": ["journaling", "meditation", "creativity", "selfcare"], "long_description": "**Start the conversation with yourself.**\n\nPathfinder is an immersive tool for self-discovery and creative thinking. Using metaphorical cards\u2014rich, open-ended images\u2014it helps you bypass logical blocks and access your intuition. \n\n**How It Works:**\n1. **Choose a Topic:** Focus on a question, obstacle, or goal.\n2. **Draw Cards:** Select images that resonate with your situation and desired future.\n3. **Reflect:** Use voice-to-text or typing to capture insights. Guided prompts help you dig deeper.\n\n**Key Features:**\n* **Immersive VR:** A quiet, distraction-free space for your inner world.\n* **Metaphorical Deck:** Diverse images designed to spark creative insight.\n* **Voice Journaling:** Seamless transcription powered by Wit.ai.\n* **Private by Design:** No account creation required. All journals and history are stored locally on your headset.\n\n**Data Privacy & AI Disclosure:**\n\nIn compliance with developer data policies, Pathfinder uses Wit.ai to provide voice-to-text functionality. Voice data is transmitted to Wit.ai solely for the purpose of real-time transcription to enable the journaling feature. We do not store voice recordings, and your data is not used to train AI models.\n\n**Use Pathfinder to:**\n* Gain clarity on tough decisions.\n* Reconnect with your intuition.\n* Brainstorm creative ideas in a calm environment.", "short_description": "Unlock clarity with Pathfinder, an immersive VR tool for self-reflection. Use metaphorical cards to explore thoughts and define goals. Features AI-guided prompts and voice-to-text journaling powered by Wit.ai. To provide this service, voice data is processed by Wit.ai for real-time transcription only. We do not store voice recordings or use your data to train AI models. No account required\u2014all insights are stored locally on your headset for total privacy.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vR2jvcL4YAsnp7Za52r3Uv_xP-enX1CTFXBxewZnI4wyqQO56pziHYMQGUy6BmXBXG0tTYQ7XYoqdAh/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTguQqP8uCxKiY1nMxBWLbtmF0rwZ9jHGA_2y2NnsKbz_Nlp163o9_E4UjbWCA4Ka6WZgvP_d90A7Dx/pub", "publisher_name": "HumanSide", "support_website_url": null, "website_url": "https://www.thepathfinderquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25278630491831354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618274_1203648778361508_88799605377373133
ed design (20).png", "id": "845034498497888", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823934_845034501831221_1095303969951457982_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjCqBA5tISIQ7kNvwGuLp3r&_nc_oc=Adof0Xrmrj9RPMM4OnOLkGtkzD70aH_GsRMb5w4Jjctd8rIgBzOmB-rW7kiaouyDlaQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNUtEhpAXeXCOlMtOQX4kz-JAvehnKPxYj_WaXETsrOQ&oe=6B0721D5"}]}, "id": "1545876336558062", "locale": "en_US", "screenshots": [{"file_name": "screenshot1 (3).png", "id": "1204504498464755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618093_1204504501798088_4482078218547383827_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AwOX2ycu0IQ7kNvwE5-8zt&_nc_oc=AdojZojltGUbVKCdg8hvzXwnLFrQBJ0KYPpxniIEr2aRKHyWbgh5K-8A7pVXUV-KhHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3YKTbjV9BsxCOdnvfhwSGNJIAWvC2nbZ-V1grUJFk2w&oe=6B0704BA"}, {"file_name": "screenshot1 (4).png", "id": "1824670011485853", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_1824670014819186_8747008815267867761_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We20XD32bYUQ7kNvwHLr2Cd&_nc_oc=Adolkj5h5dpD--NKVCLhQ4fP9Ekvj7cj0XcFpwA1nvpCQpXJpP1FGQ8b0x12D2PAT6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt8nuEoyLv7agzsQXRAElMf8JWf6Vuvr-7Aah-zxkciQ&oe=6B07035E"}, {"file_name": "screenshot1 (5).png", "id": "900078242447043", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619159_900078245780376_4815170163205149921_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIYmRYXN1fQQ7kNvwFSN-GS&_nc_oc=AdrfbrEqngOZFcI8Yu5hMfIPQUh6HJCwjvKkowKYs0SdUKGiZGVuszYesAoacGzQJuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWzizYQt-QY-ZUFjTJJePtQLmdo4aDlhBGAegoZGBrWA&oe=6B07254E"}, {"file_name": "screenshot1 (1).png", "id": "1547046706565807", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824532_1547046709899140_5505035561949246062_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw99u-h0LZ0Q7kNvwGkO4XF&_nc_oc=AdpdxGG5dqoLlHJgYVsSkc21cuebpskPJ6cKk-e4Am8H6kJZ8586nsU_xqJO9vCHUfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc5IGCiZzkZ2cvOIr9yiMcm8F-6B9Lw_PB2YKNq5xP4A&oe=6B0712F4"}, {"file_name": "screenshot1 (2).png", "id": "846010284711918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_846010288045251_5500004015631960924_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgU4eH0mRJIQ7kNvwHNFrgQ&_nc_oc=Ado0sg892DTuLllYjd1AsNM86CUPJuvVRBA9D8sH8d-Z9_MmzQvX-yCYeF0BBgFbD4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4_rZMQ8lryPJMjq5WQmTWtHU2FOL-lHcYg7Q0uxtapA&oe=6B0720E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pathfinder", "keywords": ["journaling", "meditation", "creativity", "selfcare"], "long_description": "**Start the conversation with yourself.**\n\nPathfinder is an immersive tool for self-discovery and creative thinking. Using metaphorical cards\u2014rich, open-ended images\u2014it helps you bypass logical blocks and access your intuition. \n\n**How It Works:**\n1. **Choose a Topic:** Focus on a question, obstacle, or goal.\n2. **Draw Cards:** Select images that resonate with your situation and desired future.\n3. **Reflect:** Use voice-to-text or typing to capture insights. Guided prompts help you dig deeper.\n\n**Key Features:**\n* **Immersive VR:** A quiet, distraction-free space for your inner world.\n* **Metaphorical Deck:** Diverse images designed to spark creative insight.\n* **Voice Journaling:** Seamless transcription powered by Wit.ai.\n* **Private by Design:** No account creation required. All journals and history are stored locally on your headset.\n\n**Data Privacy & AI Disclosure:**\n\nIn compliance with developer data policies, Pathfinder uses Wit.ai to provide voice-to-text functionality. Voice data is transmitted to Wit.ai solely for the purpose of real-time transcription to enable the journaling feature. We do not store voice recordings, and your data is not used to train AI models.\n\n**Use Pathfinder to:**\n* Gain clarity on tough decisions.\n* Reconnect with your intuition.\n* Brainstorm creative ideas in a calm environment.", "short_description": "Unlock clarity with Pathfinder, an immersive VR tool for self-reflection. Use metaphorical cards to explore thoughts and define goals. Features AI-guided prompts and voice-to-text journaling powered by Wit.ai. To provide this service, voice data is processed by Wit.ai for real-time transcription only. We do not store voice recordings or use your data to train AI models. No account required\u2014all insights are stored locally on your headset for total privacy.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vR2jvcL4YAsnp7Za52r3Uv_xP-enX1CTFXBxewZnI4wyqQO56pziHYMQGUy6BmXBXG0tTYQ7XYoqdAh/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTguQqP8uCxKiY1nMxBWLbtmF0rwZ9jHGA_2y2NnsKbz_Nlp163o9_E4UjbWCA4Ka6WZgvP_d90A7Dx/pub", "publisher_name": "HumanSide", "support_website_url": null, "website_url": "https://www.thepathfinderquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25278630491831354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_1203648778361508_8879960537737313342_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR9IUU-UB1gQ7kNvwG3R_R7&_nc_oc=AdpmQKDqXeuDJaBcuXEdw9uSQmttalOy_nkKdLr-MPXKZnN8hx3tsv_c6HiYtAZ-FsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThIHxmoHDyz8u-4rSs01RprtbSGQB1kEczZOyl9caKPQ&oe=6B0727C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pathfinder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1767867480, "lastRevision": {"nodes": [{"id": "24710873218607087", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24710873175273758", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1293716902561180"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Untitled design (19).png", "id": "1203648775028175", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_1203648778361508_8879960537737313342_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR9IUU-UB1gQ7kNvwG3R_R7&_nc_oc=AdpmQKDqXeuDJaBcuXEdw9uSQmttalOy_nkKdLr-MPXKZnN8hx3tsv_c6HiYtAZ-FsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYFH6-RHLd310tGYg15N2Ks45L0kzKaHFWPnKZ_EB1mA&oe=6B0727C6"}, {"file_name": "Pathfinder Cover.png", "id": "885587500791307", "image_type": "APP_IMG_COVER_LAN
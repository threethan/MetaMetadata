ontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823934_845034501831221_1095303969951457982_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH5VtR1jZQMQ7kNvwHc5trV&_nc_oc=AdqsRgvgFkmhwtUYBr0RVsDAPcm42ES5QhWEdmUTdT6oOnp-DecQ5Ucb_PS2_S8qwFM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwFXPCB1heXjrJ87xPyT6c3QKyWbXcq6EOFOkg5zcwvw&oe=6ABD1595"}]}, "id": "1545876336558062", "locale": "en_US", "screenshots": [{"file_name": "screenshot1 (3).png", "id": "1204504498464755", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618093_1204504501798088_4482078218547383827_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7xSoKoK6m4Q7kNvwECqx0o&_nc_oc=AdoELd6sVdWt00L6BifkY9lyblDE_XA6MSPgqi-xS_AGO4FpvHlmbXIJHZkBZgaMnkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSzLTvGwpMCYydupTiPTaPovPPxDwxC9d9gYR1uEfSiA&oe=6ABD30BA"}, {"file_name": "screenshot1 (4).png", "id": "1824670011485853", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618093_1824670014819186_8747008815267867761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUqOcXBHuOkQ7kNvwFYzL3m&_nc_oc=AdodvuhJieid2ANjg1YBwidwpyN3ikC3_JPr31P2Ii52ayjJhcpH7dBkxMPl-g8Ye0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfo6IsD7HjfE3Q0pwkROU2F7WOzArWpzL-yPGRRqcnUw&oe=6ABD2F5E"}, {"file_name": "screenshot1 (5).png", "id": "900078242447043", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619159_900078245780376_4815170163205149921_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMF7fEsoaFoQ7kNvwHtmzAh&_nc_oc=AdpR4b7EKf_THMTRIQOX7Qye3CTOveyuxvM3sjCXimVsoV5zJ3aikdOp2we6qruoXHY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjqvBK82PW-qoHb0UMSZCF9JeeH-81jnqaB5HAU4vniw&oe=6ABD190E"}, {"file_name": "screenshot1 (1).png", "id": "1547046706565807", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824532_1547046709899140_5505035561949246062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34wnRRTTcf0Q7kNvwGqA582&_nc_oc=Adr1oSdzh88zaqyYBV052SuKC63Jrahk_TbhcX9w4k0ACfGfcIZI2-V2m1ZtNqKuTTY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0QNPGfGc8yByPFWeiMPY4FEqa207kfoTgFtGkvl3DJA&oe=6ABD06B4"}, {"file_name": "screenshot1 (2).png", "id": "846010284711918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619685_846010288045251_5500004015631960924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HMpglYcjQsQ7kNvwED3ICG&_nc_oc=Adoj7BMXesbayqvUkyvdH46KbyQi4CxWi09z95WUKil_QsTIbidnJKYwitQv8_KrEBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJugfjnvpF039gKCEnaOH3NIQ-ivkJcMUL_8msvSEo4AQ&oe=6ABD14A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pathfinder", "keywords": ["journaling", "meditation", "creativity", "selfcare"], "long_description": "**Start the conversation with yourself.**\n\nPathfinder is an immersive tool for self-discovery and creative thinking. Using metaphorical cards\u2014rich, open-ended images\u2014it helps you bypass logical blocks and access your intuition. \n\n**How It Works:**\n1. **Choose a Topic:** Focus on a question, obstacle, or goal.\n2. **Draw Cards:** Select images that resonate with your situation and desired future.\n3. **Reflect:** Use voice-to-text or typing to capture insights. Guided prompts help you dig deeper.\n\n**Key Features:**\n* **Immersive VR:** A quiet, distraction-free space for your inner world.\n* **Metaphorical Deck:** Diverse images designed to spark creative insight.\n* **Voice Journaling:** Seamless transcription powered by Wit.ai.\n* **Private by Design:** No account creation required. All journals and history are stored locally on your headset.\n\n**Data Privacy & AI Disclosure:**\n\nIn compliance with developer data policies, Pathfinder uses Wit.ai to provide voice-to-text functionality. Voice data is transmitted to Wit.ai solely for the purpose of real-time transcription to enable the journaling feature. We do not store voice recordings, and your data is not used to train AI models.\n\n**Use Pathfinder to:**\n* Gain clarity on tough decisions.\n* Reconnect with your intuition.\n* Brainstorm creative ideas in a calm environment.", "short_description": "Unlock clarity with Pathfinder, an immersive VR tool for self-reflection. Use metaphorical cards to explore thoughts and define goals. Features AI-guided prompts and voice-to-text journaling powered by Wit.ai. To provide this service, voice data is processed by Wit.ai for real-time transcription only. We do not store voice recordings or use your data to train AI models. No account required\u2014all insights are stored locally on your headset for total privacy.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vR2jvcL4YAsnp7Za52r3Uv_xP-enX1CTFXBxewZnI4wyqQO56pziHYMQGUy6BmXBXG0tTYQ7XYoqdAh/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTguQqP8uCxKiY1nMxBWLbtmF0rwZ9jHGA_2y2NnsKbz_Nlp163o9_E4UjbWCA4Ka6WZgvP_d90A7Dx/pub", "publisher_name": "HumanSide", "support_website_url": null, "website_url": "https://www.thepathfinderquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25278630491831354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618274_1203648778361508_88799605377373133
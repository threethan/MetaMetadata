ontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823934_845034501831221_1095303969951457982_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejYaEEoDTskQ7kNvwEyzFXr&_nc_oc=AdpPv9kOwPeBYJKX3KMc89DwS82YJ17qRSw3YcuS_yR6pLc8k7eZs4GsE10uw_A8D3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D_ppiqAM7EmajXLUsGuA8yAMfvP_szGdxQvY7OnEAVg&oe=69E38E15"}]}, "id": "1545876336558062", "locale": "en_US", "screenshots": [{"file_name": "screenshot1 (3).png", "id": "1204504498464755", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1204504501798088_4482078218547383827_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLesTdd1CawQ7kNvwElqN_z&_nc_oc=AdrJKh1M58g0cawi1KcBroIu9fzvTYSNMR35YglnGzW7ayU2tcGEPcmH3nxN1VuKELE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A9tf443Fmpboz1e5gWvGZrYx-p3A7MmqR16zXq7mheA&oe=69E370FA"}, {"file_name": "screenshot1 (4).png", "id": "1824670011485853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1824670014819186_8747008815267867761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4wu4mjCtKsQ7kNvwE4NQAu&_nc_oc=AdqauRLLmXD1j3m3R7VIH8ZKEiIVMwfEz82wpgc6woD-sP-KklOYjMGGbGt75e3Hz4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_q1RPMQMjywxC0GmlkQkhwXnvKY1XBloXFats-9tDtw&oe=69E36F9E"}, {"file_name": "screenshot1 (5).png", "id": "900078242447043", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619159_900078245780376_4815170163205149921_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BLTSBvMI-IQ7kNvwFxjtib&_nc_oc=AdoylAOzN__Wl4V1D19CZFoOiUqA5Ai6ZMSDFaKMdVLftx5KkSt1A40GvM6qXmdfZkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XoYSi51GPxvjXVJUXnfe0Wtu_NOpkqpXcR8qSAJbLVg&oe=69E3918E"}, {"file_name": "screenshot1 (1).png", "id": "1547046706565807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824532_1547046709899140_5505035561949246062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZRP3pgxx2kQ7kNvwFzzeHR&_nc_oc=AdrhCav0J440EMY7W_AH_sa3MjcCGACFZ3u06rX79OEyuXz7Nf1bekeDupZ1s9np9_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O_A3GW7EnguxX99DjEDMJ8wWALOJa54g-XLCdkyIIrg&oe=69E37F34"}, {"file_name": "screenshot1 (2).png", "id": "846010284711918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_846010288045251_5500004015631960924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNZFV0Dp5hwQ7kNvwHUhUWj&_nc_oc=AdoVIHtl32m9flGpCkYLv2Nd9qr43ixLQR0BEt9ZiWHScm7dWv9yuE6LQSLyeq1VDdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gmm03RU9lK7YFiNDL8_D9Pf0qe4HgRL5HeK9rEvSm3A&oe=69E38D27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pathfinder", "keywords": ["journaling", "meditation", "creativity", "selfcare"], "long_description": "**Start the conversation with yourself.**\n\nPathfinder is an immersive tool for self-discovery and creative thinking. Using metaphorical cards\u2014rich, open-ended images\u2014it helps you bypass logical blocks and access your intuition. \n\n**How It Works:**\n1. **Choose a Topic:** Focus on a question, obstacle, or goal.\n2. **Draw Cards:** Select images that resonate with your situation and desired future.\n3. **Reflect:** Use voice-to-text or typing to capture insights. Guided prompts help you dig deeper.\n\n**Key Features:**\n* **Immersive VR:** A quiet, distraction-free space for your inner world.\n* **Metaphorical Deck:** Diverse images designed to spark creative insight.\n* **Voice Journaling:** Seamless transcription powered by Wit.ai.\n* **Private by Design:** No account creation required. All journals and history are stored locally on your headset.\n\n**Data Privacy & AI Disclosure:**\n\nIn compliance with developer data policies, Pathfinder uses Wit.ai to provide voice-to-text functionality. Voice data is transmitted to Wit.ai solely for the purpose of real-time transcription to enable the journaling feature. We do not store voice recordings, and your data is not used to train AI models.\n\n**Use Pathfinder to:**\n* Gain clarity on tough decisions.\n* Reconnect with your intuition.\n* Brainstorm creative ideas in a calm environment.", "short_description": "Unlock clarity with Pathfinder, an immersive VR tool for self-reflection. Use metaphorical cards to explore thoughts and define goals. Features AI-guided prompts and voice-to-text journaling powered by Wit.ai. To provide this service, voice data is processed by Wit.ai for real-time transcription only. We do not store voice recordings or use your data to train AI models. No account required\u2014all insights are stored locally on your headset for total privacy.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vR2jvcL4YAsnp7Za52r3Uv_xP-enX1CTFXBxewZnI4wyqQO56pziHYMQGUy6BmXBXG0tTYQ7XYoqdAh/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTguQqP8uCxKiY1nMxBWLbtmF0rwZ9jHGA_2y2NnsKbz_Nlp163o9_E4UjbWCA4Ka6WZgvP_d90A7Dx/pub", "publisher_name": "HumanSide", "support_website_url": null, "website_url": "https://www.thepathfinderquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25278630491831354"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_1203648778361508_88799605377373133
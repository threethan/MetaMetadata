 style! \n-Dynamic gameplay!\n-Beautiful Sunsets!\n\nSpecial thanks to glenatron for the model, upon which this game is built. link:\nhttps://sketchfab.com/models/cbcf188a01f54d63a10f10c227c5a6ff", "short_description": "Sometimes pirates fight pirates, for women, for pride, or other things. But bravest of pirates fight each other for treasure! Will you be able to defend what is rightfully yours, or will you fall in the name of Piracy?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://arloopa.com/", "developer_terms_of_service_url": "http://arloopa.com/", "publisher_name": "ARLOOOPA Inc.", "support_website_url": null, "website_url": "http://arloopa.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "340305854626926"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2592611357638082"}, {"status": "CANCELLED", "id": "1975461139395332"}, {"status": "PUBLISHED", "id": "1361823617247376"}, {"status": "PUBLISHED", "id": "300822833883870"}, {"status": "CANCELLED", "id": "871375179689583"}, {"status": "PUBLISHED", "id": "461710927930739"}, {"status": "PUBLISHED", "id": "332018224301251"}]}, "baseline_offer": {"id": "1361823617247376"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1580148000, "status": "PUBLISHED", "id": "2592611357638082"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1584080308333169", "versio
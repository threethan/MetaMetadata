4-01-06 084326.png", "id": "400627132316634", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001710_400627135649967_7771811838073973582_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPV9DP8pePIQ7kNvwFj8Xc1&_nc_oc=Ado8hUCxTNgCoM638F8YFDpi8ct930pkjdyvztNOeZjvHt2OYKLpnkS0TimInj_LB3Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3d6DJozGrsFHGJj5nt6SsorRMH4DLYYMQMeli5NfAU4A&oe=69F36646"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "367262562556319", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974788_367262565889652_4539963315002025555_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF-VcWq_txIQ7kNvwFHd5hQ&_nc_oc=Adp8I0Q4cM4Db2wMwddg1CkjxXwsZd2P_75AWA4b-BnCmWcjQkiB_vvp_-rDIXRK2zA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TiB6KsgO7i3bopkR5gOvkojJxdHWEekl0OSoCZyraEA&oe=69F34462"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "894416838893100", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974745_894416842226433_6117628752665096056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmgXBuF5QEMQ7kNvwGCsMiV&_nc_oc=AdrtbzFLiJYFpTDvu-V9qxXHRPV_bqKzjdgBW8wpU0wXlOyNe4hNXK2qTwlBelv0tpg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vuXf3MmGXbT4x19OvWFMjn3eryimcK5NBgROgCcDM6w&oe=69F35E05"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "1439318883601811", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982583_1439318886935144_1082027970825007755_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6_MggYgASYQ7kNvwHtLRZ5&_nc_oc=AdoXp_r6ZbfGIn_sfhvN9Il-OEChyO9RiWxzS5ZXSqwrB31cDazTbFSm5jByJGhAzaM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-ebGf0wTL6rPpGCYF_-vGpd94MDEZq5YgJEgIGpICFQ&oe=69F34C41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Chase Projects", "keywords": [], "long_description": "Chimpanzee Chase is an exhilarating virtual reality game that thrusts players into the heart of a bustling jungle as intelligent chimpanzees on a thrilling adventure. The immersive VR experience allows players to swing from vines, navigate intricate tree canopies, and engage in dynamic, fast-paced chases through the lush landscape. What sets Chimpanzee Chase apart is its groundbreaking communication system, enabling players to talk to each other in real-time using an advanced vocalization translation feature. This not only enhances teamwork during the pursuit of various challenges but also creates a unique social dynamic as players strategize and communicate while swinging through the virtual jungle. The game offers a seamless blend of action and cooperative gameplay, allowing players to experience the excitement of being a chimpanzee in a vibrant, interactive world while fostering a sense of camaraderie through communication. Chimpanzee Chase is set to redefine the boundaries of VR gaming, providing an unforgettable and socially engaging experience for players.", "short_description": "You can play as a chimpanzee with voice chat and meet other people!"}]}, "developer_name": "Waterbel", "developer_privacy_policy_url": "https://waterbel.wixsite.com/watergames/kopie-van-chimpanzee-chase", "developer_terms_of_service_url": null, "publisher_name": "Waterbel", "support_website_url": null, "website_url": "https://waterbel.wixsite.com/watergames", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interactio
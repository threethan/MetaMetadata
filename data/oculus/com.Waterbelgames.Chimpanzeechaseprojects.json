c_sid=6e7a0a&_nc_ohc=nbwx3BZENQ0Q7kNvwFPc85G&_nc_oc=Adlfn_VwpJ-rtMz2BbLwarDeNR3T_skctT4PjoS83GMtlDTDHDCKa71b9KWLPgCO8Nw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftcw_1z6rxYqa7c-WvsoKH2fKrcytxBJ61lJRLJCIqH6Q&oe=699DAC85"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "1439318883601811", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982583_1439318886935144_1082027970825007755_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGhJFPvZikUQ7kNvwElc426&_nc_oc=AdnneHBq7vIvQL8UaB_1WjKzplc662-B4EHnHit_KgQuhBNH1102H6qiYMn-e29xRCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsLSKyndxogaMZUkLEkb2ZC4f5zbbfzcgkrGpUWSdy9Yg&oe=699D9AC1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Chase Projects", "keywords": [], "long_description": "Chimpanzee Chase is an exhilarating virtual reality game that thrusts players into the heart of a bustling jungle as intelligent chimpanzees on a thrilling adventure. The immersive VR experience allows players to swing from vines, navigate intricate tree canopies, and engage in dynamic, fast-paced chases through the lush landscape. What sets Chimpanzee Chase apart is its groundbreaking communication system, enabling players to talk to each other in real-time using an advanced vocalization translation feature. This not only enhances teamwork during the pursuit of various challenges but also creates a unique social dynamic as players strategize and communicate while swinging through the virtual jungle. The game offers a seamless blend of action and cooperative gameplay, allowing players to experience the excitement of being a chimpanzee in a vibrant, interactive world while fostering a sense of camaraderie through communication. Chimpanzee Chase is set to redefine the boundaries of VR gaming, providing an unforgettable and socially engaging experience for players.", "short_description": "You can play as a chimpanzee with voice chat and meet other people!"}]}, "develo
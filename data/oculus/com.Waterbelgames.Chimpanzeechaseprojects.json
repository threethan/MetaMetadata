4-01-06 084326.png", "id": "400627132316634", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001710_400627135649967_7771811838073973582_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm84NqUjuLsQ7kNvwH2J0MI&_nc_oc=Adpvr6NXxtqE5iCZjCQABxUoy7ZUMVFkMtKtXTSDiF3NX5tMJeTDP9IDLnDi4Z7y_Pw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTfRA7IWObJC3htk-fX3iYpfr6afXd0tlZrIb87D23Uw&oe=69CFCDC6"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "367262562556319", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974788_367262565889652_4539963315002025555_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9Umbj4Df60Q7kNvwHIiKHq&_nc_oc=AdpN8eazc3o96UOQaZ9AXfDtOzbsu-uTCm_LgaOeWy9V790gTJJqmzrkez09PdjGbv4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzN4-MHMGRZvVlkdChBoCDPbF8ehbZdJ6ndchzfNxJmNA&oe=69CFABE2"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "894416838893100", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974745_894416842226433_6117628752665096056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J_c9mnCm8AQ7kNvwFyJx7C&_nc_oc=AdoWYJyeH8huxKSgITOsfNVfB68QzHfe6wNP3gFnI6iAU8jH4fxBF1Gial2wDqPJ8zE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqJO-a7LCWhiv86A6055jkWXyRGEgK0tbdIZt1rzRG7A&oe=69CFC585"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "1439318883601811", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982583_1439318886935144_1082027970825007755_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qONgbsLmnwoQ7kNvwH6bStD&_nc_oc=AdqD-2VTbcIcU4Ibw7AeC2s7bkm28Bx5nVdD7K449nenepqsvnvuLX9Mf6nb7RxZs0s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUBj1FQCzkD8mp3qhGUnfYezGlQAXFzO8Em0qTjTr-wg&oe=69CFB3C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Chase Projects", "keywords": [], "long_description": "Chimpanzee Chase is an exhilarating virtual reality game that thrusts players into the heart of a bustling jungle as intelligent chimpanzees on a thrilling adventure. The immersive VR experience allows players to swing from vines, navigate intricate tree canopies, and engage in dynamic, fast-paced chases through the lush landscape. What sets Chimpanzee Chase apart is its groundbreaking communication system, enabling players to talk to each other in real-time using an advanced vocalization translation feature. This not only enhances teamwork during the pursuit of various challenges but also creates a unique social dynamic as players strategize and communicate while swinging through the virtual jungle. The game offers a seamless blend of action and cooperative gameplay, allowing players to experience the excitement of being a chimpanzee in a vibrant, interactive world while fostering a sense of camaraderie through communication. Chimpanzee Chase is set to redefine the boundaries of VR gaming, providing an unforgettable and socially engaging experience for players.", "short_description": "You can play as a chimpanzee with voice chat and meet other people!"}]}, "developer_name": "Waterbel", "developer_privacy_policy_url": "https://waterbel.wixsite.com/watergames/kopie-van-chimpanzee-chase", "developer_terms_of_service_url": null, "publisher_name": "Waterbel", "support_website_url": null, "website_url": "https://waterbel.wixsite.com/watergames", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interactio
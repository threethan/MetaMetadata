4-01-06 084326.png", "id": "400627132316634", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001710_400627135649967_7771811838073973582_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaEO7TJKqaQQ7kNvwGn51wm&_nc_oc=AdpzRU3vmmVv2LXvv1Lqbmo2p_TPHAi_Idht-_AObjX4vdn8hTdfC5odG-_enr9fQE4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwtNtpK1N7-M45D04ZnLb7qy9dqWXPEAf__EiLzuaJFQ&oe=6A53A3C6"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "367262562556319", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974788_367262565889652_4539963315002025555_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRWzaPQ-ybAQ7kNvwG9xjvZ&_nc_oc=Adq_x0u5ftJGmu2fkk8KLNVT7F3yxNzUBr__u2rCB7p6yNQoaF7JmR_xd-LDw8RmePU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH_AqIDFouueV9IPBzQqVL3ncSLFv6VdyGDTQuyKSikA&oe=6A5381E2"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "894416838893100", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974745_894416842226433_6117628752665096056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOxazC4vr2YQ7kNvwEMr89s&_nc_oc=AdpAt3i2jyilMGqsc70T7AiY1pFfnqrELhuxasabrUKSsYK2sTdionmvtny7vGH6BWk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpoaj5YRd3ClAptSO8fw5OhTeJY-sIlJv6YiSxHBURew&oe=6A539B85"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "1439318883601811", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982583_1439318886935144_1082027970825007755_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzB96az8g_EQ7kNvwGV8Q2t&_nc_oc=AdovMscJWDvmxMn3ccxbbvQ4xyn8yN2rjtiUdLIdlGjGXbEVFyMQss1re0v2EYoMiDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwzF6fosLLbmiSgWeJslUNMHJN1Z198WcpkP-92fbPow&oe=6A5389C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Chase Projects", "keywords": [], "long_description": "Chimpanzee Chase is an exhilarating virtual reality game that thrusts players into the heart of a bustling jungle as intelligent chimpanzees on a thrilling adventure. The immersive VR experience allows players to swing from vines, navigate intricate tree canopies, and engage in dynamic, fast-paced chases through the lush landscape. What sets Chimpanzee Chase apart is its groundbreaking communication system, enabling players to talk to each other in real-time using an advanced vocalization translation feature. This not only enhances teamwork during the pursuit of various challenges but also creates a unique social dynamic as players strategize and communicate while swinging through the virtual jungle. The game offers a seamless blend of action and cooperative gameplay, allowing players to experience the excitement of being a chimpanzee in a vibrant, interactive world while fostering a sense of camaraderie through communication. Chimpanzee Chase is set to redefine the boundaries of VR gaming, providing an unforgettable and socially engaging experience for players.", "short_description": "You can play as a chimpanzee with voice chat and meet other people!"}]}, "developer_name": "Waterbel", "developer_privacy_policy_url": "https://waterbel.wixsite.com/watergames/kopie-van-chimpanzee-chase", "developer_terms_of_service_url": null, "publisher_name": "Waterbel", "support_website_url": null, "website_url": "https://waterbel.wixsite.com/watergames", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interactio
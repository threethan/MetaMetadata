4-01-06 084326.png", "id": "400627132316634", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001710_400627135649967_7771811838073973582_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0qCEpg99_wQ7kNvwFK3JEh&_nc_oc=Adp0F4Fxc-0xSmXFlugvmr_gwbOmoWBH6TwdYQV0C9Xvw59XgvzvJrn1wfmbySidMOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo_d4N2Uh-C0bnGmLNO5F_-TeX9rcVf_wFLB1bvStNSQ&oe=6ABD1BC6"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "367262562556319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974788_367262565889652_4539963315002025555_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilZWTWt0-SgQ7kNvwFPdGlE&_nc_oc=AdqHZbRALsHyj5YQGiLGMjl16AbglxEGSxiXF00ZJ72N_FZ3tMOgfs0KZfffE1C-uX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIu7Iz1CopcQ86u5F8A1xt2b7-_mIO4KEd13LIIqkICA&oe=6ABD3222"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "894416838893100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974745_894416842226433_6117628752665096056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gkGax1lxZUQ7kNvwFdqaP2&_nc_oc=Adpo62fKWElnKHJvFU-pLUyRgfLAdpnBRLSpO3_kXMrAGJnyOdLw7t7qEWeNneip8oo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqwQC8xlMgezOZ9Srr9aznAHXWr-9dGLsRbtK_ZUEBTQ&oe=6ABD1385"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "1439318883601811", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_1439318886935144_1082027970825007755_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQc2nCM5_U4Q7kNvwEgy1AB&_nc_oc=AdpMQ9-vtWBDXS5dUV0PHwBiUbhBtnrbky_3y0aijU5V2HEFyEeYW9-nF0jMNd9MYmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6vqX0WJMHmpShedelf5gp2boHtNF4OQwPwUEGsdCMbA&oe=6ABD01C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Chase Projects", "keywords": [], "long_description": "Chimpanzee Chase is an exhilarating virtual reality game that thrusts players into the heart of a bustling jungle as intelligent chimpanzees on a thrilling adventure. The immersive VR experience allows players to swing from vines, navigate intricate tree canopies, and engage in dynamic, fast-paced chases through the lush landscape. What sets Chimpanzee Chase apart is its groundbreaking communication system, enabling players to talk to each other in real-time using an advanced vocalization translation feature. This not only enhances teamwork during the pursuit of various challenges but also creates a unique social dynamic as players strategize and communicate while swinging through the virtual jungle. The game offers a seamless blend of action and cooperative gameplay, allowing players to experience the excitement of being a chimpanzee in a vibrant, interactive world while fostering a sense of camaraderie through communication. Chimpanzee Chase is set to redefine the boundaries of VR gaming, providing an unforgettable and socially engaging experience for players.", "short_description": "You can play as a chimpanzee with voice chat and meet other people!"}]}, "developer_name": "Waterbel", "developer_privacy_policy_url": "https://waterbel.wixsite.com/watergames/kopie-van-chimpanzee-chase", "developer_terms_of_service_url": null, "publisher_name": "Waterbel", "support_website_url": null, "website_url": "https://waterbel.wixsite.com/watergames", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interactio
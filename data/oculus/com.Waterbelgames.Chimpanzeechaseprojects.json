5/39001710_400627135649967_7771811838073973582_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0Z0rT0lCN0Q7kNvwH6Pq9F&_nc_oc=AdnlJ79xYTW30eUar8cwQCTnnYHvzX1PE5bMqDDlbqd6P0h0QlXLxi4mLVjdS4sYmCo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvBZEePmqG1LG_oH0HDFI_oTDbe7SO7IflEUyVHL1evTQ&oe=69A59DC6"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "367262562556319", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974788_367262565889652_4539963315002025555_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z59OXCLCv68Q7kNvwGRw57g&_nc_oc=AdmyVdN-F9dm_WkXt0UELXavKE69rmyf304lQOVebZL3NUiQ1Vhk8I16N8w5NXDqVgQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs3DglOpiWNNU-TDY8T_H4Q--g2zeU88-fwbKCEmLUYrA&oe=69A57BE2"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "894416838893100", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974745_894416842226433_6117628752665096056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iCg8FZMA1MQ7kNvwF5ZDtj&_nc_oc=AdlbCImO0Rtw2SAJw3ibS3dGd3d_kwpqysznASu-LfJC51nLP0M0snM8F37Q9vn5G8s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftL2wwKO6r-GmebLQ_DrB9kDaKMk_7zgmQtRWmyIjM8xw&oe=69A59585"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "1439318883601811", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982583_1439318886935144_1082027970825007755_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2REyDITKZwQ7kNvwEwM2hJ&_nc_oc=AdnfgdRwQmKxezFAHSfBgWBenfmZPQzsMsDXKDTMfRHQHWZd-IkzBuRzhbpalcr_ThA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsSSyoU7wRrm5cOekMT9hrSMPiN-XBEdlyacNxY10EoUA&oe=69A583C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Chase Projects", "keywords": [], "long_description": "Chimpanzee Chase is an exhilarating virtual reality game that thrusts players into the heart of a bustling jungle as intelligent chimpanzees on a thrilling adventure. The immersive VR experience allows players to swing from vines, navigate intricate tree canopies, and engage in dynamic, fast-paced chases through the lush landscape. What sets Chimpanzee Chase apart is its groundbreaking communication system, enabling players to talk to each other in real-time using an advanced vocalization translation feature. This not only enhances teamwork during the pursuit of various challenges but also creates a unique social dynamic as players strategize and communicate while swinging through the virtual jungle. The game offers a seamless blend of action and cooperative gameplay, allowing players to experience the excitement of being a chimpanzee in a vibrant, interactive world while fostering a sense of camaraderie through communication. Chimpanzee Chase is set to redefine the boundaries of VR gaming, providing an unforgettable and socially engaging experience for players.", "short_description": "You can play as a chimpanzee with voice chat and meet other people!"}]}, "developer_name": "Waterbel", "developer_privacy_policy_url": "https://waterbel.wixsite.com/watergames/kopie-van-chimpanzee-chase", "developer_terms_of_service_url": null, "publisher_name": "Waterbel", "support_website_url": null, "website_url": "https://waterbel.wixsite.com/watergames", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7243531959066853"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculusc
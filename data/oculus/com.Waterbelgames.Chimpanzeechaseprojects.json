c_sid=6e7a0a&_nc_ohc=RJEOs5KVpdQQ7kNvwHBCjW8&_nc_oc=Ado7o118biuxvDVqEMc994-Z6kkyvS4LRZK2pnZF39dL9L06obI7kiOd3tWQ268r3hw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3JA0x-q-mshEyQuI9gAcpBb45_PZXn0_aN5wP_4lCIwA&oe=69F0BB05"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "1439318883601811", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982583_1439318886935144_1082027970825007755_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVI0MrxLiwsQ7kNvwG1r68q&_nc_oc=Adr2Vcx0LMX3bierunw1HeYuxSibhOqiXwTltkCNWo2oUCdpmHRQ3BsjvyFGnrLpWhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2OjwmkpoXIvOaHFOp8uOMD8RwsOib_JBzgYcAGc-R6EA&oe=69F0A941"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Chase Projects", "keywords": [], "long_description": "Chimpanzee Chase is an exhilarating virtual reality game that thrusts players into the heart of a bustling jungle as intelligent chimpanzees on a thrilling adventure. The immersive VR experience allows players to swing from vines, navigate intricate tree canopies, and engage in dynamic, fast-paced chases through the lush landscape. What sets Chimpanzee Chase apart is its groundbreaking communication system, enabling players to talk to each other in real-time using an advanced vocalization translation feature. This not only enhances teamwork during the pursuit of various challenges but also creates a unique social dynamic as players strategize and communicate while swinging through the virtual jungle. The game offers a seamless blend of action and cooperative gameplay, allowing players to experience the excitement of being a chimpanzee in a vibrant, interactive world while fostering a sense of camaraderie through communication. Chimpanzee Chase is set to redefine the boundaries of VR gaming, providing an unforgettable and socially engaging experience for players.", "short_description": "You can play as a chimpanzee with voice chat and meet other people!"}]}, "develo
uscdn.com&_nc_ss=7f20f&oh=00_AQL9Yh0lqnb2_iuOX44fy9LkL9KRvvtZiWPYLeEkTf26wA&oe=6AB2A622"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "894416838893100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974745_894416842226433_6117628752665096056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Eer0LHK_f8Q7kNvwEctd5X&_nc_oc=AdqtGmZ9ArrWAwLu43q_OgDmPQYqvPRdNjIbTpQ_w9FAoRL7GL-4fXvnftCFcBgjqKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_oaYsQQpVePkccp_Wv17Kko3WQpcjoo-T2th5nFXDaA&oe=6AB28785"}, {"file_name": "Screenshot 2024-01-06 084326.png", "id": "1439318883601811", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982583_1439318886935144_1082027970825007755_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIE3Kfa7VqgQ7kNvwFCeuv7&_nc_oc=Adq0Z292Qd1Df_nu0D4QcogTJnAygukt2IzXgC-l0vJk6_07sJPI3IZBbo0_vT2xy14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3ho-0FdwVjeAxb8zRD8vroyltZ5atqfgGa_igTd_q2g&oe=6AB275C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Chase Projects", "keywords": [], "long_description": "Chimpanzee Chase is an exhilarating virtual reality game that thrusts players into the heart of a bustling jungle as intelligent chimpanzees on a thrilling adventure. The immersive VR experience allows players to swing from vines, navigate intricate tree canopies, and engage in dynamic, fast-paced chases through the lush landscape. What sets Chimpanzee Chase apart is its groundbreaking communication system, enabling players to talk to each other in real-time using an advanced vocalization translation feature. This not only enhances teamwork during the pursuit of various challenges but also creates a unique social dynamic as players strategize and communicate while swinging through the virtual jungle. The game offers a seamless blend of action and cooperative gameplay, allowing players to experience the excitement of being a chimpanzee in a vibrant, interactive world while fostering a sense of camaraderie through communication. Chimpanzee Chase is set to redefine the boundaries of VR gaming, providing an unforgettable and socially engaging experience for players.", "short_description": "You can play as a chimpanzee with voice chat and meet other people!"}]}, "developer_name": "Waterbel", "developer_privacy_policy_url": "https://waterbel.wixsite.com/watergames/kopie-van-chimpanzee-chase", "developer_terms_of_service_url": null, "publisher_name": "Waterbel", "support_website_url": null, "website_url": "https://waterbel.wixsite.com/watergames", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7243531959066853"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1074280313794849"}]}, "baseline_offer": {"id": "1074280313794849"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711130220, "status": "PUBLISHED", "id": "1074280313794849"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7231364686950247", "version": "0.1.8"}, "id": "747332423964833", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6957730590980326", "is_concept": false,
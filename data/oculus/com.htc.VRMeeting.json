, "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3833820713379167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5695460633881823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "447523186361366"}]}, "change_log": "\u2022\tOne account, one storage location. VIVE Sync\u2019s storage solution has been upgraded to a unified storage system so you can manage all your files from one place. \no\tYou can only upload and download files from your local drive. You can no longer use Microsoft OneDrive to upload and download files. \n\u2022\tA new feature, Remote Desktop, has been added for AIO devices. This feature allows you to manage a local PC from your AIO headset and view your computer\u2019s screen in your headset\u2019s display.\n\u2022\tYou can now request control of a 3D model owned by someone else in the meeting room by asking to be a co-owner of the 3D model. Share your 3D models and collaborate with anyone!\n\u2022\tThe camera tool has been upgraded. Capture the moment in vivid 2K and 4K resolutions!", "created_date": 1670837575, "id": "5695460633881823", "version": "2.18.62.1238", "version_code": 1238, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3833820713379167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5695460633881823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "447523186361366"}]}, "change_log": "What\u2019s new in VIVE Sync\n\u2022\tVIVE Sync now supports VIVE Avatar\u2019s new cartoon-style avatars. Go to https://viverse.com/avatar and create one now!\n", "created_date": 1665483750, "id": "5510503285710893", "version": "2.17.62.1210", "version_code": 1210, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3833820713379167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5695460633881823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "447523186361366"}]}, "change_log": "\u2022\tYou can now play and share 360\u00b0 videos in VIVE Sync. Time to break into another dimension!\n\u2022\tSafe zone is now available for beta testing. Safe zone lets you keep your distance from other avatars in VIVE Sync so you don\u2019t have to worry about anyone invading your personal space.\n\u2022\tVIVE Sync now supports VRM avatars, allowing you to express yourself more freely with a more personalized avatar Go to https://viverse.com/avatar and upload yours today!", "created_date": 1662530841, "id": "5413847675376455", "version": "2.16.62.1204", "version_code": 1204, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3833820713379167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5695460633881823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "447523186361366"}]}, "change_log": "VIVE Avatar Creator - The new avatar creator app, VIVE Avatar Creator, is now available for download. The previous app, VIVE Sync Avatar Creator will be discontinued.  \n\u2022\tAndroid: VIVE Avatar Creator is available on the Google Play Store: https://play.google.com/store/apps/details?id=com.htc.viveavatar \n\u2022\tiOS: After updating VIVE Sync Avatar Creator, it will be replaced with VIVE Avatar Creator. \nFeatures: \n\u2022\tUse a selfie to generate your avatar\u2019s face.  \n\u2022\tChoose from more than 125 outfit options for your avatar.  \n\u2022\tConnect your HTC account and use your avatar in VIVERSE. \n\nWhat\u2019s new in VIVE Sync \n\u2022\tScreen mirroring can now be enabled from any window. The mirrored screen will appear directly in front of you. \n\u2022\tPresentation view now supports PPTs and PDFs.  \n\u2022\tPresenter notes for PPTs can now be viewed via presentation view. \n\u2022\tSticky Notes can now be edited. \n\u2022\tThe Keyboard has been improved to increase usability. \n\u2022\tYour profile picture and display name are now visible from the Sync Menu.", "created_date": 1655985389, "id": "5205470219547536", "version": "2.15.62.1179", "version_code": 1179, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3833820713379167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5695460633881823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "447523186361366"}]}, "change_log": "VIVE Sync v2.13 release notes\n\n\u2022\tAdded support for Simplified Chinese keyboard\n\u2022\tAdded support for editing Personal Space playlist\n\u2022\tAdded support for Private talk in Viewer mode\n\u2022\tAdded avatar speech animations in Viewer mode\n\u2022\tA new app, the VIVE Sync File Manager, is now available. This app can be used to upload PowerPoint files to meeting rooms.\n", "created_date": 1651131307, "id": "5045286318899261", "version": "2.13.62.1158", "version_code": 1158, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
 mode!", "short_description": "Welcone, to rabbit hoppers you can run around at fast speeds! but beware, there is some spooky stuff going down the the bunker."}, {"images": {"nodes": []}, "id": "801848258604448", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rabbit Hoppers", "keywords": [], "long_description": "Welcome to Rabbit Hoppers! this game is a game where you can socialise with your friends! you can drip out your rabbit with cosmetics and have a few laughs, you can go down into the bunker but, we dont talk about what goes down in there, well what are you waiting for come play Rabbit Hoppers!", "short_description": "Welcome to Rabbit Hoppers, a social game that you can play with your friends where you can get some cosmetics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rabbithopperswebsite/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sstriker Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/rabbithopperswebsite/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26007948148852215"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75658019_1215608126514589_2989890722363579034_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_
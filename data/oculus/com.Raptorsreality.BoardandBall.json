m2szCd_275Pmh4UMjZZQtcjm2mX-xWOZ3uxqlw&oe=6A242C5F"}, {"file_name": "screen_2560x1440_2018-11-06_12-10-18.png", "id": "1663521787615504", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393841_1663521790948837_2103424415835680821_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTuAJLDNjssQ7kNvwFq2J4a&_nc_oc=Adqv90S1Pbx8pmaIV6TAjk1jYqeyaDKRuSNY5l5aOq0K4-AhEwjFs6vJT08MUfejA2U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZJzzYp8QV5Kbh61V_rM3keCDKfhw-w9PaAihZYb2ljA&oe=6A242491"}, {"file_name": "screen_2560x1440_2018-11-06_11-57-52.png", "id": "997353332606903", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392305_997353335940236_5064881545541027419_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYlpjBkMt_AQ7kNvwFZPgLo&_nc_oc=Adoxb6kKyEs2Hftlq5ninetGqTI9h74BwvTwdT_pQA7Uh-FCio5KAU9-qpkN_eZvJ94&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G_XrnlcQ6cv3DxH-CXtBICWF9Z6K1pjUwkdp33uSndA&oe=6A244151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "B&B 2560x1440.png", "id": "1973970803134186", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393673_1973970806467519_3824728473032054858_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji0aZ74hk2UQ7kNvwGaeyJD&_nc_oc=AdrOm-0Xea9J8A7mePQSS4ePUzJpsf9ACNRxraYemapzkmYBOGshLuz5C9IAEm1TXyM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82Ra7laPz6KCzn2Z2T3VB39Mx_zxWMZSJv7pHwJFsT9g&oe=6A244296"}, "display_name": "Board and Ball", "keywords": ["physic", "trap", "puzzle", "maze", "gravity"], "long_description": "Immerse yourself in a physical puzzle experience where you don\u2019t just play the game \u2014 you tilt it. In Board and Ball, you control a suspended platform using a virtual staff. Your goal: guide a rolling ball through dynamic obstacles and traps using only the force of gravity.\nSimple in concept \u2014 challenging in execution.\nPrecision, timing, and strategy are key as you navigate increasingly tricky levels, balancing logic with coordination.\n\n\ud83c\udfae Features:\n- Intuitive motion control \n- Physically responsive gameplay that feels natural and immersive\n- 50 handcrafted levels with increasing difficulty\n- 4 unique types of traps to test your reflexes and planning\n- Ideal for players who love skill-based puzzles\n", "short_description": "Board and Ball - Gravity Puzzle in Motion. You have to fight with the forces of gravity and overcome the traps."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24596536099938164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393984_544013585427575_2038667425449296594_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ao8fXwSTy4EQ7kNvwFpgoCT&_nc_oc=AdrCkjwpKe_-sfRIcrNYj78Fk7r28M_rsGYXQuGJp2iBmY2SKbDHyUqn970nnwUYSTU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OZLLOgryO4vTsziWBOcziVdKMt_w6cpaI2AK723CkXQ&oe=6A2425D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
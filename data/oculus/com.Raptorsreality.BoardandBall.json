9024033590993_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6vqxUJDWoMQ7kNvwGUORY9&_nc_oc=Adplx0BElx9oLq0xqd_O0-Mg1I-_WcsWQlEXBM4S-Zi7ZM2godLGKG1ydDPztIbYAXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyJDNwPc8J1YxDEHKnuzVRzgxV_-2JdHjYJLxEhKywwA&oe=6B01E09F"}, {"file_name": "screen_2560x1440_2018-11-06_12-10-18.png", "id": "1663521787615504", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393841_1663521790948837_2103424415835680821_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUK3H4faEC8Q7kNvwGjnpQy&_nc_oc=AdoDW4nZGFt3MCJnmB6HJcVhDeMKw-B_QGeeBdmC3cavbfmjCN9_4B3Q4PdzScf8ftU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFM2cALvdPEx4b2FFQGInVa5F4tvlqG9bTDnXOacVLrg&oe=6B01D8D1"}, {"file_name": "screen_2560x1440_2018-11-06_11-57-52.png", "id": "997353332606903", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392305_997353335940236_5064881545541027419_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHEBbP0fitAQ7kNvwEKi7HA&_nc_oc=AdokzpV1gFM7pKc08WSRwMQN_LN6at4wAh3rXgZmhIE9ei5gFQOuM5yNcsr_b95eJok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQCStkhVin_AP5-TjxokCfAIpaUjdlVlRSOusmeKzHNA&oe=6B01BD51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "B&B 2560x1440.png", "id": "1973970803134186", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393673_1973970806467519_3824728473032054858_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGzL_U3plasQ7kNvwGf2XYk&_nc_oc=AdoSbmvApOY07smQ5UgC5jvLKbEvMGWWBdbzeOqI6zI-RO32LGa0B_kkSFKU7VxntfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh6GjJOqqkh4JAQ0S54rV26R-49qGn8n1B8D8qYJzVIQ&oe=6B01BE96"}, "display_name": "Board and Ball", "keywords": ["physic", "trap", "puzzle", "maze", "gravity"], "long_description": "Immerse yourself in a physical puzzle experience where you don\u2019t just play the game \u2014 you tilt it. In Board and Ball, you control a suspended platform using a virtual staff. Your goal: guide a rolling ball through dynamic obstacles and traps using only the force of gravity.\nSimple in concept \u2014 challenging in execution.\nPrecision, timing, and strategy are key as you navigate increasingly tricky levels, balancing logic with coordination.\n\n\ud83c\udfae Features:\n- Intuitive motion control \n- Physically responsive gameplay that feels natural and immersive\n- 50 handcrafted levels with increasing difficulty\n- 4 unique types of traps to test your reflexes and planning\n- Ideal for players who love skill-based puzzles\n", "short_description": "Board and Ball - Gravity Puzzle in Motion. You have to fight with the forces of gravity and overcome the traps."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24596536099938164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393984_544013585427575_2038667425449296594_n.png?stp=dst-png_s360x360&_nc_
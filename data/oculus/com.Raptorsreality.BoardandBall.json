o fight with the forces of gravity and overcome the traps."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24596536099938164"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "925501600247283"}, {"status": "PUBLISHED", "id": "1649191009831706"}, {"status": "PUBLISHED", "id": "1697688968282015"}, {"status": "PUBLISHED", "id": "1235673931743507"}, {"status": "PUBLISHED", "id": "710917145409801"}, {"status": "PUBLISHED", "id": "815364824544164"}, {"status": "PUBLISHED", "id": "792905663185935"}, {"status": "PUBLISHED", "id": "757172200203959"}, {"status": "PUBLISHED", "id": "1007289278193126"}]}, "baseline_offer": {"id": "1007289278193126"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "925501600247283"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24596389253286182", "version": "1"}, "id": "1204100841379944", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binar
XIRWAkbPstEgXEHhxMlROBLEtdKjveispSdxH_Q&oe=6AF327DF"}, {"file_name": "screen_2560x1440_2018-11-06_12-10-18.png", "id": "1663521787615504", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393841_1663521790948837_2103424415835680821_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_NeFADOVZkQ7kNvwH16O61&_nc_oc=AdpwkQLYXB6VoRpRoY9GudU0AM9A6rhoSSq99Hgtr9er0ZEDCjI0Fv0C6yRajD-3Gm4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlHBDb_wlXywiFQi_jkiR5yA9VqQk-qGgyJM0u2ma3HA&oe=6AF35851"}, {"file_name": "screen_2560x1440_2018-11-06_11-57-52.png", "id": "997353332606903", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_997353335940236_5064881545541027419_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k61yHp2h9OQQ7kNvwGrIbp5&_nc_oc=AdpgJ212geQYGHhoI0L2-8lqTxoXrSESAfgiPcAyzF3FHpjP2t-uAs5nIbS9rZIlrgU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyZoeIaM-w2aGWhEon2lQ8LjOzu-wzOpjIx5ejfD9EUQ&oe=6AF33CD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "B&B 2560x1440.png", "id": "1973970803134186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393673_1973970806467519_3824728473032054858_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-wNNJEEf1oQ7kNvwGMdxYD&_nc_oc=Adpr6LroC-Cu2NW0k5qOCkfyQShNCZ0cGvSti49QjEMlC43Cu8ZtV6ri8mY3Koromv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2tClK1y1SaxDxllJQFjTXXr71X55lFrj3Tisfn09Y1Q&oe=6AF33E16"}, "display_name": "Board and Ball", "keywords": ["physic", "trap", "puzzle", "maze", "gravity"], "long_description": "Immerse yourself in a physical puzzle experience where you don\u2019t just play the game \u2014 you tilt it. In Board and Ball, you control a suspended platform using a virtual staff. Your goal: guide a rolling ball through dynamic obstacles and traps using only the force of gravity.\nSimple in concept \u2014 challenging in execution.\nPrecision, timing, and strategy are key as you navigate increasingly tricky levels, balancing logic with coordination.\n\n\ud83c\udfae Features:\n- Intuitive motion control \n- Physically responsive gameplay that feels natural and immersive\n- 50 handcrafted levels with increasing difficulty\n- 4 unique types of traps to test your reflexes and planning\n- Ideal for players who love skill-based puzzles\n", "short_description": "Board and Ball - Gravity Puzzle in Motion. You have to fight with the forces of gravity and overcome the traps."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24596536099938164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393984_544013585427575_2038667425449296594_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zveuASuDNYQ7kNvwES5Zx-&_nc_oc=Ado-jqex-L8FSIs8lfN03mmjXyanZAaC7UdA30WlKAz_Ei13QJyXV9pzJR1gajfxQyY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdxE-22bcabD4PoJbN8lMrhk0bOfgpVowFfK18u2oWRg&oe=6AF35996"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "di
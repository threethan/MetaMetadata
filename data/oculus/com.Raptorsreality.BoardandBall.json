t-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13p8-BTgy3bCCVCPl0UB4tMfHnE29bAP92VY5_HCutuA&oe=69EB7411"}, {"file_name": "screen_2560x1440_2018-11-06_11-57-52.png", "id": "997353332606903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_997353335940236_5064881545541027419_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeuzZZW-DhIQ7kNvwFC0aWe&_nc_oc=Adq6wh6Q2EJ-abniZobHOjn2d2Ia-eJzKvL4MtvOpqPD_H8yMtuTrJkosSP378ejCbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KxBN4W--l_UHOEjb021FBwclFokSzCcKnU4LeJ8VLAg&oe=69EB5891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "B&B 2560x1440.png", "id": "1973970803134186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393673_1973970806467519_3824728473032054858_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqrAigNnnH8Q7kNvwEE-vj6&_nc_oc=AdrgRPAfEwyfuMXATLt-Ujz0b2WEWUVRItHCv6snUrG0DPsHJrXdrLq4uFzkgQId0zw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B-SSZDSzbGLu79133x6eKIHJlDDX02gbzuChZSI7plg&oe=69EB59D6"}, "display_name": "Board and Ball", "keywords": ["physic", "trap", "puzzle", "maze", "gravity"], "long_description": "Immerse yourself in a physical puzzle experience where you don\u2019t just play the game \u2014 you tilt it. In Board and Ball, you control a suspended platform using a virtual staff. Your goal: guide a rolling ball through dynamic obstacles and traps using only the force of gravity.\nSimple in concept \u2014 challenging in execution.\nPrecision, timing, and strategy are key as you navigate increasingly tricky levels, balancing logic with coordination.\n\n\ud83c\udfae Features:\n- Intuitive motion control \n- Physically responsive gameplay that feels natural and immersive\n- 50 handcrafted levels with increasing difficulty\n- 4 unique types of traps to test your reflexes and planning\n- Ideal for players who love skill-based puzzles\n", "short_description": "Board and Ball - Gravity Puzzle in Motion. You have to fight with the forces of gravity and overcome the traps."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24596536099938164"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "925501600247283"}, {"status": "PUBLISHED", "id": "1649191009831706"}, {"status": "PUBLISHED", "id": "1697688968282015"}, {"status": "PUBLISHED", "id": "1235673931743507"}, {"status": "PUBLISHED", "id": "710917145409801"}, {"status": "PUBLISHED", "id": "815364824544164"}, {"status": "PUBLISHED", "id": "792905663185935"}, {"status": "PUBLISHED", "id": "757172200203959"}, {"status": "PUBLISHED", "id": "1007289278193126"}]}, "baseline_offer": {"id": "1007289278193126"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "925501600247283"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24596389253286182", "version": "1"}, "id": "1204100841379944", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binar
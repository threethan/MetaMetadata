P1cdER2SINUYfmYCpCgu-wwvjLHbx4a4RpaUm5Q&oe=6A9C24DF"}, {"file_name": "screen_2560x1440_2018-11-06_12-10-18.png", "id": "1663521787615504", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393841_1663521790948837_2103424415835680821_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFDf_tthNI8Q7kNvwF-Cvbq&_nc_oc=AdoLsEKV1RZFoMDKEtFCzQ5Zye58pvqlQvR9KATj1M5LIzz2E0kvl23v1Bm7f7HyKJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhKn-uA4MHAKZuxIkohVK-4D5es4rB9iuQXlZXX4wOsA&oe=6A9C1D11"}, {"file_name": "screen_2560x1440_2018-11-06_11-57-52.png", "id": "997353332606903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_997353335940236_5064881545541027419_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC1Zl10NMbMQ7kNvwE88d33&_nc_oc=Adpjd6fXmQXwm5PhdzzcOyZSv40uN-NUgVu6_iwA8wQUaCbkGntqw2bVZwETmFANpTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_ppYaHfboPOE72fQsyrjmLJyVZq3nH06yPiM_OB8MLQ&oe=6A9C39D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "B&B 2560x1440.png", "id": "1973970803134186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393673_1973970806467519_3824728473032054858_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydhj1dbprpMQ7kNvwEXswkX&_nc_oc=AdrOm_7gf1Bn570kFZHijdoJVp5S-bXDGAPknOVBWk7VRvscEYUW16m5bGSOs641Hsw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1pew6momhwpl-eerchvh2eV5cxROHFCvIUrpPCYgN2w&oe=6A9C3B16"}, "display_name": "Board and Ball", "keywords": ["physic", "trap", "puzzle", "maze", "gravity"], "long_description": "Immerse yourself in a physical puzzle experience where you don\u2019t just play the game \u2014 you tilt it. In Board and Ball, you control a suspended platform using a virtual staff. Your goal: guide a rolling ball through dynamic obstacles and traps using only the force of gravity.\nSimple in concept \u2014 challenging in execution.\nPrecision, timing, and strategy are key as you navigate increasingly tricky levels, balancing logic with coordination.\n\n\ud83c\udfae Features:\n- Intuitive motion control \n- Physically responsive gameplay that feels natural and immersive\n- 50 handcrafted levels with increasing difficulty\n- 4 unique types of traps to test your reflexes and planning\n- Ideal for players who love skill-based puzzles\n", "short_description": "Board and Ball - Gravity Puzzle in Motion. You have to fight with the forces of gravity and overcome the traps."}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24596536099938164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393984_544013585427575_2038667425449296594_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV-GhcnKYNUQ7kNvwFWNi--&_nc_oc=AdqAMgpeM5ecaJswR5mcKV6PIoT3bfkmtWDcAZk6C-MwodF6QdT6ZPFZuMBrVg6AOYI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeKX9I1oD5K7HTABl8UZknW7QVJn7YSAQHgXaWmYy3Lw&oe=6A9C1E56"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "di
t=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp3vYeJuYEuI92q_GjhDXAjZOIqGJxMut6L_ADeJECnA&oe=6B09C3EF"}, {"file_name": "Capturef1.png", "id": "454103961103666", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393338_454103964436999_1574047597569025958_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeMK1BX9I2cQ7kNvwF4chFT&_nc_oc=Adql37d7PRIFJA0iWUxEbm_0TgtO0KhlMkUL--edi0IAbGchFZmrmiSl0n9XZgTkThM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfI4bpF9kB3dvK_Ny7QQtwe0_kgzywn8MZr1T_poBjcA&oe=6B09B43C"}, {"file_name": "38982524_1308865440284824_4751111418458545718_n.png", "id": "472553388992730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391893_472553392326063_4501284716459540797_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmNs3fviSQQQ7kNvwGTucjw&_nc_oc=AdoDuyGd_PmUeIY0gGgUiT2r_xnCmM8C0xrTPZK49AFyYOrYXh1EOqry6worKQkERqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9qs5WG9zsu77hbeyLaCgIWgS5XnOspnHrG6zooYaXcw&oe=6B09CF3C"}, {"file_name": "Screenshot (14).png", "id": "904664131482960", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393971_904664134816293_6956575948522500328_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7NsPFmh3wEQ7kNvwF0GNJB&_nc_oc=AdqlfAyqK0RAn-EUphCfZBZWci93nt-gJTikr0J5h1VBHod290EF9YI_MYsIdRI07aM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg746WDhCzhJu18YQ7pTgHiRI9EMiwldKghlMhzYqwJg&oe=6B099C1D"}, {"file_name": "Screenshot (13).png", "id": "2029694887512637", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392046_2029694890845970_3948083731040335038_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onhneH98orcQ7kNvwFU7u6i&_nc_oc=Ado-1H5UtNrc5QNlsTqPU7qvIFIYEv6e6Uxwdo5xlwlYsim3adIPBr7qfILQTMsikuI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfOoEwHfazTXv58qw94QiWPB66mpAwuSIKJU7oK1os1Q&oe=6B09C980"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bazigar - VR Plank Game", "keywords": [], "long_description": "\nGame Bazigar is an intense and immersive VR experience that places players in a world where courage and balance are put to the ultimate test. In this thrilling simulation, players find themselves on the edge of a virtual plank, suspended high above a vibrant, bustling cityscape. With a fully immersive VR setup, Bazigar taps into the player\u2019s instincts and emotions, pushing them to confront the primal fear of heights in a way that feels both realistic and exhilarating.\n\nThe game begins as players ascend to the top of a virtual skyscraper, the wind whipping around them, and the sounds of the city far below. Once at the top, they step onto a narrow, seemingly endless plank extending from the edge of the building, challenging them to walk out over the void below. Every step feels like a leap of faith, and even the bravest of players will feel the rush as they balance on the plank, carefully placing each foot as if they could actually fall.\n\nBazigar\u2019s VR design intensifies this experience with realistic physics and sensory cues like the wind\u2019s sound and the distant honking of cars far below. Players experience a visceral sensation of height and depth, making each move a test of nerve and balance. The game\u2019s design encourages players to push past their fear, with scenarios that include retrieving items at the plank\u2019s end, interacting with city objects, or even attempting daring feats along the way.", "short_description": "Game Bazigar is an immersive VR experience where players step onto a virtual plank high above the city skyline, testing their courage as they navigate thrilling heights. Players must balance, walk carefully, and confront their fear of falling, all while experiencing the exhilarating visuals and sounds of a bustling urban environment far below. "}]}, "developer_name": "Suyash Studio", "developer_privacy_policy_url": "https://docs.google.com/document/d/19XdotFhWpbtWwIEzF0uVDxEcXIZ16sUIztFEWn9y6j8/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "SUYASH STUDIO", "support_website_url": null, "website_url": "https://www.suyashstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28123474010631975"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "598279716139957"}]}, "baseline_offer": {"id": "598279716139957"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737079740, "status": "PUBLISHED", "id": "598279716139957"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39904259082553350", "version": "2.0"}, "id": "602824195937539", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28089151520730891", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39904259082553350"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "602824195937539"}]}, "change_log": null, "created_date": 1794642769, "id": "39904259082553350", "version": "2.0", "version_code"
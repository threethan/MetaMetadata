w1VnwbTTIgeMcAQ2ZHTjNECcWd-MOLQQ&oe=6B09BBD9"}, {"file_name": "03_chapter2.png", "id": "1049274010904688", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628092_1049274014238021_4017453026215535785_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjzlpFAYjIQQ7kNvwGrIKyU&_nc_oc=AdrGA__OjPvlxPUw372QleB23v1f3w4ZGbbLpB3Hyia1_7EWTeZkSfmjY7CZNJzjFCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLgecD6S-poc4wJJSR3VPjp5A8jw9DLyIr-AbwLI8a0g&oe=6B09C373"}, {"file_name": "07_hub_pov.png", "id": "28912286205108513", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619382_28912286208441846_1502460871811330732_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE2DIMseuc4Q7kNvwGRckbg&_nc_oc=AdrcquJZFAiexQYX9bLiJoLD301b07zWQirsw2DrF8I-Y6E4H-ytSdTYbnRLxmZQ0Qs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwfmuyvavGg1JD9MOsumJDjhAk1rIA7JD73imXukHR2Q&oe=6B09AE7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "1834814934312318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1834814937645651_9110246653585468217_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBg4l1TDCFAQ7kNvwHt3kvd&_nc_oc=Adqr4Uf2fLis586W7uOdqhJA3pGrg-rJAWlG-pxTsET35ygNRR4UtdkuDqtiumBuMzo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLIOpinotCE0uEcEyKZYyXRVSH-jfEIPkFYJywK7ruVA&oe=6B09D1CD"}, "display_name": "Bazigar - VR Plank Game", "keywords": ["bazigar", "vrplankgame", "plankgame", "heightgame"], "long_description": "Do you have the nerve to step off the ledge?\n\nBazigar \u2013 VR Plank Game puts you at the top of a towering skyscraper, where the elevator doors slide open to reveal a single wooden plank stretched out over the city far below. There\u2019s no rope, no net \u2014 just you, the beam, and a very long way down.\n\nEvery step is a test of courage and balance. Your eyes tell you it\u2019s real. Your hands reach for something to hold. Your legs don\u2019t want to move. This is the thrill of heights, recreated in immersive virtual reality so convincing your body forgets it\u2019s standing safely on the floor.\n\nFeatures\n\u2022 Heart-pounding plank walks high above a detailed city skyline\n\u2022 Campaign mode with chapters that climb higher and grow more daring\n\u2022 Free Practice mode to build your confidence at your own pace\n\u2022 Intuitive, natural movement \u2014 lean, balance, and step just like real life\n\u2022 Optimized for a smooth, comfortable experience on Meta Quest\n\nPerfect for facing your fear of heights, challenging friends to take the step, or simply feeling the rush of standing on the edge of the world.\n\nStep onto the plank. Keep your balance. Don\u2019t look down.", "short_description": "Bazigar \u2013 VR Plank Game drops you onto a narrow wooden plank high above a glowing city skyline. Step out of the elevator, steady your nerves, and walk the beam with nothing but open air beneath you. Balance carefully, fight the fear of falling, and prove your courage across escalating heights. An intense test of nerve built for room-scale VR."}]}, "developer_name": "Suyash Studio", "developer_privacy_policy_url": "https://docs.google.com/document/d/19XdotFhWpbtWwIEzF0uVDxEcXIZ16sUIztFEWn9y6j8/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "SUYASH STUDIO", "support_website_url": null, "website_url": "https://www.suyashstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
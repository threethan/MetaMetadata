04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz0rtv1JuMwQ7kNvwFt-4On&_nc_oc=AdrnoppJx6lLnuO9ZJfxCcrK3n9HeOIpWUgZinNX1XTXUcpWkyyJeYi6LnyGMOE36Sw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UtJZ0HjSjUxLrGqshe5O1tWp8PwGeQMp_VTrdQ6Q-CQ&oe=6A15B3A4"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gTUtp8fitMQ7kNvwFEAR_K&_nc_oc=AdqZgayx9Ya3BUhCRbbW0EFiPs3p3LAeeWVYfWffSquI0aRYUR6PbSD2hRTG_iaTsn8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i0WG9z7aXcgRa5nzElXB19cFvxpbJ8XBFP-jBCTN06g&oe=6A15A1DD"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Zw9jgxUMm0Q7kNvwGXPKrU&_nc_oc=AdpExU4ZWFxZEveZlC8K_lhHdhq7nx4R66r9iKuFIFVCixKj5sZ0GuZjpKzpndSiC94&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68SOsZz38KvJMT1Tki6_6u0bhv6gMx0LwSvaXY-S0lyQ&oe=6A15C656"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8gRBXw-Uf4Q7kNvwF2T0k7&_nc_oc=AdpwP70ZuZLCvKXveYU7jTdjovnSaxwzzzFjy57-TcyHhARJKBip7B3JoT42AdQ8lac&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wMOe2_2v8Xi1fsLjE5XFUh9e18WyW2kchVgzpyjTK5A&oe=6A15AD5C"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foco4ScsEe8Q7kNvwGn3XqX&_nc_oc=AdoMjwtkoGUXydfGdPzeh3mo1uby39-bZqL9zj6fe5HESpkZlVs3WF13O7V3x8f-uBk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l8QisG6D5kfLCAg4hC8n4q8UJjaYr7OGvo70ICpierQ&oe=6A15AA47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
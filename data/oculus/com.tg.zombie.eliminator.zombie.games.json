04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGOaF5MLNPgQ7kNvwFZWb-6&_nc_oc=Adrv8Cdr7nlUKQKT1fD5lGYchlyA8av8eio9WTnsXS_76aaDZ7isEoUqLaYnUCtxYjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRqSUWF5xKsqlzUNmVAoAjVXD6WX-Eu_jgy2pN5zgkUA&oe=6AC116A4"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhmKEePRF6AQ7kNvwGZ-hK0&_nc_oc=AdrW0IFtwaNJND_rYweUdFOFfDX6VCV4eT04PgsLmujxxb3Fz6NvheVQY7_t40Rl-kQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvU6T9aY9y4ZXT_sPLDYQmBv5FlDtRZ4OKhvEaVpQuzA&oe=6AC104DD"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEWlOs0OvA4Q7kNvwHzKbYn&_nc_oc=AdpC53tl9S2pRu6r_IDVRUAPwhIj4t_RubAIbpp_ZpWczBSrJPVaHWqnaxsNy5xBqpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-DizmZ1UMaHNB4p478ceDt7fbIrMTGiGQ1PJ5TM2U6g&oe=6AC12956"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zypLQa0E5rMQ7kNvwGizTW7&_nc_oc=AdqMIeg0fQk2t-vfeeDof9dtqcx9Ckhu0VP4NHuRsS-KwMPQ1Exn-OU-Vu1HrQ6cwv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwHsv9ta1y7ZcfNjUVPeE3ncm0xvAtZGHkzeiroRnANw&oe=6AC1105C"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fl5ofDkYLPsQ7kNvwFKzHL7&_nc_oc=Adp9Uj8H16ehJyO2IQiN5mnmoSzXWo5FHBBS00VWn3T5YXvQmdC0fHY3t4XH8deskmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2WWRrIP_0B7wJcD8PazHJW7E427GVLRNStOXZRWw3pw&oe=6AC10D47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
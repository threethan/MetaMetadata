04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VlT_YoRdlEQ7kNvwG7guxc&_nc_oc=Adq0Q9oWbkpgQXjkpMQhch4IxzcfOfmAAOx7_XYFMJkykGyIUU1PJkaCoMb-e4EXFko&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mup72r6RCWYIzBIsrj65ct7m-xH64ejZfMysDDijJxA&oe=69F4BE24"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr94UjAirPoQ7kNvwHvfLmJ&_nc_oc=Ado6khOQpHEwB3lF7ZfZMcA9p_3BBsreTKdx55YLxFlgStM1LP0f3VkojWIhNS3FD9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TfOdCyAhrnI8RAVmxvcgq176wjhYzUuA26PKzbcrIpQ&oe=69F4AC5D"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4LTNVdpAwoQ7kNvwEHsuym&_nc_oc=AdrGBUZ4QQ-BnJXBOXy51U0U_LjMEivcyIUPxU-J1VulKJWnnZ6a2kQssIJu6W0ilho&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RUbQOPYBGsxscnBse2LheT1L4R3Dx6NqGkL2WYMRFiw&oe=69F49896"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHy6LOJEUk8Q7kNvwGJSukH&_nc_oc=Adpn7K1QJ6JJicTNxNdpUs-wFg_qochgFZJQBFukSJFl-xi_Cr4wh4SJH5OlH_nxPgY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MQ7J3pkW9XqbNPjCYTwJxW2k9FmBMKw9BFY_7dGevqw&oe=69F4B7DC"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afvgfI0dO9gQ7kNvwF5tM_N&_nc_oc=Ado0DCTBH-njg-49kUtnaxMeDOWV6hNVBaDsMA6yTybc3_mKLj2RCZ35Aox-J6NV3io&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23JmyGACDHhI7OREx2fh35fbFSQ_KEmkOCREVmv9cPPg&oe=69F4B4C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
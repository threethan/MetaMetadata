04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vixLIYqhOWMQ7kNvwFTcA3Y&_nc_oc=Adog19YdJpaW-tRBtmLOXXdRuTqs3_uZA96v6vt2MGWLBOSfvNagFbTKPdHgFEpg0zw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF2nXd62yCjz6eKFu96f5cIUABRAmRE_jFNkzxv7cRXA&oe=6A5A41A4"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JLuO4pbdJAQ7kNvwGlsz3L&_nc_oc=AdquG8ztZTr8o5KksSWzhidbwnv0n5XFhIUrLjUWwaAosvkoESPiJg_fvwvsq5KAKA4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-QVAt0YADo8p7Ha4SLakx-fpDTpUzRr7zNX2pq8clwg&oe=6A5A2FDD"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy6os6psdC4Q7kNvwGK_4sC&_nc_oc=AdoWQWyuTw7PBCB4iWL13xA8LCvoD8yI0iH2UUBomH5W2QAvZYNkWgTKu4XVIcU2AWY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZzVDbXw1SP9dJWKW0RBmBdBw1o_ZrVYIfeuPtvFaI1Q&oe=6A5A1C16"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XseHo5kPEDoQ7kNvwEzi1pf&_nc_oc=AdqNuDvzVl82cnGfgnBicam6PILW_dKpVG-Q-b62iIuodPbVb2BUm6XPNwh0Q5313v0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2yK3XUH8Mxa2_cia6X00lCfWoMqOR4scJ45mSD6Jr6g&oe=6A5A3B5C"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2K-ZgVeiO0Q7kNvwG2hlOE&_nc_oc=AdrPt3zrJNSKBWlAVcxwwY1y2gQvE2Al95LiMV64FUXIKIM3---Ga3YCyTT8sSGWm_U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1H8ltOlcnwMdJgOwFwrEhMjoeDm8UJQW1xvT2KouIwQ&oe=6A5A3847"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQMYCuzo1a0Q7kNvwGNqUM3&_nc_oc=AdqSrCyUxKstKCgsT8IspvwLrIthrq_2q_X5Apvwc-4Jk1KYfY8z8F5fe1FJmha63Ao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XlgAUox-HQFqHrmW_kezCNmjuzBLvaybwh6pmTd54cw&oe=6A05E1A4"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC_cIj_ZpO8Q7kNvwGXVpgA&_nc_oc=AdohJlcH608qt1un1Hi9CnvEsa2-SFLMTytv2EtD-y0j57hQ6P1KQ3NehNdqSo-KRLs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gq2FG1sCd4LfDm70FoIiDMzSBOtkGOIn5lEkDNSWFvA&oe=6A05CFDD"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND6G4pRomKQQ7kNvwFObpxO&_nc_oc=Ado2Jm7LqbMGD_VK6NuqJ_sdtqOk09dXVaaCin1vrTL5N1ABiZyN1ebj6hQlfnhhs6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67oTj0bXpfbQuRNTbBjkt-7lPs45-TNYR-TJmOtOnKZA&oe=6A05BC16"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osWEgfw2kksQ7kNvwFatV1H&_nc_oc=Ado6SDSegnb-0gpUVyff6Yj7qtmDIH0aTS3Dc4pzwPUlgC-I467nuZZBekD0fhjiun4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jOX7szUJ5v4yi8neyn09GabRqkpLnPpeix9Cu1Uy8fA&oe=6A05DB5C"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dan1H0S0xDEQ7kNvwGj3n5D&_nc_oc=AdoBoLTqZw0aMegWClnwH1ZktSxXWkHTKTlFkvTno-RrHEFZOx2egG0Lt51I86FxPQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41UJv0T1qgKJ4d8PHnPAfWAMnMrOyv-_30s6fIwPAgIw&oe=6A05D847"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
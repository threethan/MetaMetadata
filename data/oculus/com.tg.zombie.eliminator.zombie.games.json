=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iClQcVswE6wQ7kNvwHRCzh4&_nc_oc=Adoc54lPHnuYNPrdF972Zx0RnxjpwDLbUKSiiO9mToKTea5xC-g42MjlwALZ-zgrcbQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JJ263hUkSyF3oO4J70omtRr6hv4wPBUc_eIlAW1E-Xw&oe=69F214DC"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc4XIppNlJ4Q7kNvwHxPvDT&_nc_oc=Adrz3acmYLMkYFlTHjYpd69upK16hIpcvBGoryTIu26I5xbuacjxyg-EuMqt8qAeljI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2WDFe9OeF3hzjAczBvVTYqU6Bl4hUOP2nClvVwjbN-7w&oe=69F211C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24660139646998733"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1148115707428741"}, {"status": "PUBLISHED", "id": "1942860666309663"}, {"status": "PUBLISHED", "id": "10053492968107578"}, {"status": "PUBLISHED", "id": "661016667007136"}, {"status": "PUBLISHED", "id": "1628466294833307"}, {"status": "PUBLISHED", "id": "1132549798994461"}]}, "baseline_offer": {"id": "1132549798994461"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1148115707428741"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24659789453700419", "version": "4"}, "id": "3885082178451927", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24488581330821233", "is_concept": false, 
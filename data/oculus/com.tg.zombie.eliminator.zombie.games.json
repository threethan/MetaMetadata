04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3VGnmp0xaIQ7kNvwFAuIor&_nc_oc=Adr4ptY3u1AIPocT6P5TPLu8LOBhY9FuX2yUtYmvPS5c9UAh3hZRGQUW0NLD1zE8lYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72hQTX5kP58DfBTa6CjZuS2dAa1k36mY6g7aU4-IU1qw&oe=6A1856A4"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co4DotT3eswQ7kNvwHpCSLi&_nc_oc=Adrt9aGwIjhv1z8im2Y97xgP9NzejKq1U0rjVc2lzvCsvMHTGV0T8QeIu7AT2li5Tig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jy8D5v7wU-zutwZYcoUtNLf4ocpX2fbLIph9F8b4l3Q&oe=6A1844DD"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijRnPrtOaNAQ7kNvwHD14VT&_nc_oc=AdoQamoB24_TjU9I5E_jvXwaUfrtkt_tumuszXmqgjH5MmDbtMLopPNwke25eGBqwfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tzveBsvjjOqxBTlpS86Fnz_jGy1tX3edZ7rCjzi_U6A&oe=6A183116"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4aH0FYWYP8Q7kNvwH9nB25&_nc_oc=Ado6c8NnZO67QKl8n8FJKj2ns3nbWNSVODf8bD4v9ohJeBDTtmuw5bGPysGCEs6MegM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cIR_T50cVQ2hIrEZtV618nYrEEDfvmcZG39MgvmLK3w&oe=6A18505C"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdReDwD4MzcQ7kNvwGgphe_&_nc_oc=AdqJdA4__cWclibG3KcDl7VMOfN53xEH3cleUbyLPyWX78MTWa9she3mzF71mauaOwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RbCUIMb6jRO2GnltUMmysKatrV-V9lI-_dewyhj5DAA&oe=6A184D47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
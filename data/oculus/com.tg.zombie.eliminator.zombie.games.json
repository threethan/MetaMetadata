04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPaxqPT5SHAQ7kNvwGEgQjo&_nc_oc=AdrWERgdFeSTpNOHgNSuvfsZAFW0QDm7Gv199el3qSrgO9O515lQkqW5FWaIgFWi7oE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gbYf5G5wyH1ILhfniWbJs5-DNuEsEnomMsFklrNPLIg&oe=6A413524"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPR-eYifBt4Q7kNvwEg4EV_&_nc_oc=AdpxddIZQTtIr9yXmr0rfrKfviNHbKnHFfE9MDqSCbAQVYKxc_pt_AHnexDv92PcCqc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UCfRaFNlpPTC2j9_dBJtX3CpA1WzlmazJBBKs_ydKrw&oe=6A41235D"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTYFede3bQQQ7kNvwFOEK41&_nc_oc=AdoC1n5uEnHXeGx3qrO21YIQcgiXvWoxEeDyp36CMg3KMidAd6wkxaHdzxKKt58J8UI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ceHm50HgUdhEhLKEdwI2lrXowTzoCPfHNNSdWBONyag&oe=6A4147D6"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGtBdgR0LYAQ7kNvwFnKBAT&_nc_oc=Adq9kDbpAzyl2frD68bd3wwSzQDBKnKOoii1pJ9ugLowAxzypaPCf5XTXsaoHgxLnKU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tXHhExrsilK2I0VH3egO0YA8MTQaurZ6DzlyGs_qrvA&oe=6A412EDC"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xue_SKf_BswQ7kNvwEfoUFB&_nc_oc=Adqhb6DorSV00gKLZ7Mn0He1MsgPWDOf-cqHGhqh9nO3lacfweaLcZT03tZ0HMsznIA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TLTdnY8Ld088HPHUTLnSQaBwKsfOXbMvhhDMJ9Kfayw&oe=6A412BC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
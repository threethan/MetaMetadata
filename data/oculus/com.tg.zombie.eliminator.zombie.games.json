04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAwrxEJEEJwQ7kNvwFZdqY6&_nc_oc=Adq0qNBCu8V9HFb2FfvZS6Lw1YCPmo_xdw7jWXhGE_FWHegxIuFuBtRobfXFpUmep9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtDbhA5Fgs12O4K29zVqATB_yShYehEcz7x5Uo8jKNlw&oe=6A95CD64"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CbpmNbn_MsQ7kNvwHRsQ5p&_nc_oc=AdpWcymDmw9R6OLS50U1ZXWlPly5H9AEopqf2rauzn3LWF-_pghUoNrw8cyWSVPiHPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeawAPe25XXax5gCRD2z_n6jY1OhzcpYavpNPpWpTNmQ&oe=6A95BB9D"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2unefu6pStoQ7kNvwGpKpcF&_nc_oc=AdrWepwRR_g4rsEZxq0q71cTqJL8pHQQQpIcaFIOAS-BEC4-NIp-zAWZKR4umLbTVt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSga38h2Z_S1dIonZsqADQp4wWjPdpd8eqyaGIzxQNYA&oe=6A95E016"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoumOrpNpYEQ7kNvwFgcSXj&_nc_oc=Adq85Di1xeA6LxDUykDKQFkMKHabt_EVHylU1cU-A6Dz04A_lScVLdTgLqVlAt-BAUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENxO5tD6d4DfipiU73wmOmbr79XzxwRNU_W34YJvi57w&oe=6A95C71C"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlW03LcxJT0Q7kNvwE8LNZe&_nc_oc=Ado0oOYWYbqbB1a1P2bMJJlfh1KA7OCcqkVMqSvqn2kwXoqWBFQbwvhpYn_Sf1BD0yo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtdRXIuOQAHvP8FooBQfrTX77TWDrThuU863buQkdslQ&oe=6A95C407"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
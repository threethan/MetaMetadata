04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VlT_YoRdlEQ7kNvwGK0Q6c&_nc_oc=AdrVr8MLEW5VwylG7ZnfrMhDoeImkaqjTZZCVRoTYeAxcmaVVj7h4ahuU18dbiVzVFY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wuOpCQP9Bkm3FfJsChy0bb8uztxLfdfdh55luygTDhw&oe=69F60FA4"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr94UjAirPoQ7kNvwGeSjXA&_nc_oc=AdrgvfwjL2tQrY4sEHZ9izqkoJtXhb3iCa4BAK_zL9PKIS0l_z0oZXNjNCg9plhTr-s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DaeX1MZxRvE4rIjj64B_qFeAI2WqW_lT5DUvYZFZanw&oe=69F5FDDD"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4LTNVdpAwoQ7kNvwGYrhTC&_nc_oc=AdoOWIy2m4FypXYzZ7_puHGhWfAFqP-yH2c9og0JI7wtHGY5h6V9Ou9CSKm8v5IWndI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3j9eVQh9tJLYoIpNq3uE1y1b0s6ymKQcbnJGQ56M15uw&oe=69F5EA16"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHy6LOJEUk8Q7kNvwHiWkxq&_nc_oc=Adp7L-YRvIo0dLYyo75pd6O-gOvVx6tfuIFz3SpwS7UyX51Ql9HeQ8UZW4qqOf0eW-4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0V7tB0tWU-poSRR2BYHBDtwdTkY0gfZ8ZdwOEMAQlx-A&oe=69F6095C"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afvgfI0dO9gQ7kNvwHxzroH&_nc_oc=Adqo0WbQWMxGbFtCHI2TNGeIt2Zv9eQP82n0vMX_Op5nsECwZCRbF6oXQZ0tSZ2EwV0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qE47mL16oMvt7pindbJQdnfqB_8XW_nAmVm7wxvK9yw&oe=69F60647"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
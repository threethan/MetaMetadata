04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7PBkrxpCHAQ7kNvwGgjonm&_nc_oc=Adq0OfdxOCP7j2JuroDzzGar94AkU_1Y3QLXPXSnWNH0rUuYonpljAjzVVsF4rUA5dk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR9ki3N4euC7PDcf_2VN7Au2a-MbMNb1LyFee-hFLNdg&oe=6AA02124"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3M_wCs-ccoQ7kNvwEy5-w7&_nc_oc=AdoO-g9l6VUUgJaOlrEl1mJF7NU_Fqa-2piDdIahWJIVs5OBD7qFQLZAi3TNMF_PwtQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDfenvnCEHJFR-ZTC3GLuBWHK55peAstVOFF1pjt7xdQ&oe=6AA00F5D"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kttIfbq2O2QQ7kNvwFX903d&_nc_oc=Adp4Bo9k6bBYURxlM-pLwBuD_lLkDpyGFs07v3yGUzTPaeB6YCBstUmL7lnTBe2TGkE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFHT41Y1XSePDBV4LZX8DoqzgSN2MlZThJjwW42Q76Uw&oe=6A9FFB96"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc5RHYafn30Q7kNvwHANuH-&_nc_oc=AdoQm2HaZTrPo1glYrzRH_rQr8lM85DxQkQtQDCIbcJJN60UsQob2X6nvIsAftx_K9c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHVsj5sIvptdWBqnxSSqcHzL43aKWITKfLbpfOQq-iEQ&oe=6AA01ADC"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2FNDxhy-rQQ7kNvwFxC0jW&_nc_oc=Adpg424AG-p_x0nILHy7GFbyvMC4U-BfW5GIUN8rRsApBHx5E4kd_OBH9EIhD6--9Tw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFCfXmK01eF8DmVH9RVX0mbrVANzSY0pPEe-ohy7hDNw&oe=6AA017C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
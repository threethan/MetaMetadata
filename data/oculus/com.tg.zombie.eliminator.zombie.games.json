id": "847882634582051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHcmc_-f0AoQ7kNvwHERczi&_nc_oc=AdqTwpHXK-VMOUlQqnZCTONx6CKT7hhnK6nuPhPuJFE7orFa6utUtf-M2ke3LwaSwBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX9N8MtzEWtOZd0hKGTpR6o3CxTepz6Y2CCWYAiUX4XQ&oe=6AA560DC"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8sUxqHF274Q7kNvwGpaulA&_nc_oc=AdocpU8-6W4L8ApasMemN-Ys6YzE_Z-8KIidCrzeFrGNpkJJzhYqkFmWIOwFsvtVGwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcbtUTaI8S8dkx16O4ux1s8SUrU7N2MqYa5xtoAMBB8A&oe=6AA55DC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24660139646998733"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1802066724542376"}, {"status": "PUBLISHED", "id": "1893193914972905"}, {"status": "PUBLISHED", "id": "1316755073463486"}, {"status": "PUBLISHED", "id": "1148115707428741"}, {"status": "PUBLISHED", "id": "1942860666309663"}, {"status": "PUBLISHED", "id": "10053492968107578"}, {"status": "PUBLISHED", "id": "661016667007136"}, {"status": "PUBLISHED", "id": "1628466294833307"}, {"status": "PUBLISHED", "id": "1132549798994461"}]}, "baseline_offer": {"id": "1132549798994461"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1802066724542376"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "246597894537
04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFoVcmmGdc8Q7kNvwF9gFBb&_nc_oc=Ado60BbSubyxsaDu3f--Q26dSnwhvqXHyKm1T1GCNynaKJJF1Dc39ALlusSmlEBwyuE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pGs8q3pRJriTS3TeKhPW0_svbHrpbPcAjEpb7QbC4Yw&oe=6A340624"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv0k4VSmFWQQ7kNvwEcu-Gv&_nc_oc=Adrb6jveWhyq4hyZxenwjIbGi7gDWjtRwo55tnKUL_cU53bHfdaz5rQuI9RFeNOpJI0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wPiwMWqDKBgxhibNiOC4Gx6EFd1rPvsumhhpPK44aCg&oe=6A33F45D"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08b1Rrt4rjUQ7kNvwFb_XKZ&_nc_oc=AdowflDFUFbbNP1pso5QxAK7ZF7-GgWoHGoZpEZhvuXL711g50PnaUa_htZnm9loS08&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o-aR2wr2ILE_JAvxT--0FIPMzNk_SNDv_0m4-Dq6iOg&oe=6A3418D6"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=742Wo6eUxzQQ7kNvwFljAOg&_nc_oc=AdpGQ8nBHdIm0xMBIr34Uw0xVw6kcJrc9m1WVdbuzROa-lox2FdRgV8ba4ky_ZI5fxo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lAsHKoSNff2hqCcjLxb3D1b9-lu_Qaeo7_rLDHL4q8g&oe=6A33FFDC"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO7U28Gie0QQ7kNvwHaho42&_nc_oc=Adrgtyfr9O1ATB6GajBnk9EPmcky82THYTnm5sjHPINaTDZmrSZPUhNPkGF7govVuCg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SwMO_Jknk1HMrrS5etIHmSIMMXlWJLi2gsBAtXRPLjg&oe=6A33FCC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
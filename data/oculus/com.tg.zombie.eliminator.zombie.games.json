04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bJZGiaVfvsQ7kNvwFbwAtx&_nc_oc=AdqJOp21ZyfG0wmgcfBQqoNyUihR62I0iU0J5vMG9KgPsLi65YFsX3kYSRYokh3RVQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Mv1kHiwJxLO8oQVfnp_hNWs8oxd7uCLtBq6YTenpuA&oe=6AF72424"}, {"file_name": "2.png", "id": "770330036038549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822883_770330039371882_3449854611654825036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ky78G-CtpcQ7kNvwGc7TYw&_nc_oc=Adq-98LX52co8363nGjKrRNUAFUJaNPP_FKkJ_ED0QRITbjRIBzLUhELJ17_tO5QecQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7QfdPkTuKbUzO9oQgLK26f_a2bB11rUAMyCX-fCy-6w&oe=6AF7125D"}, {"file_name": "3.png", "id": "1798918314614599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304162_1798918317947932_4275434566728873023_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dayB3H_1ZHQQ7kNvwENpYHh&_nc_oc=Ado4UmOQ3SNU6UNQ8TueBbgNqBaWo4JVQ2WObPGFwKJ5GJx6AnExm33_WXtoc1lZT1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZilXj-7VUFV4il5VVXaThHQa5pjd8H2i0lMoOqMofxg&oe=6AF736D6"}, {"file_name": "5.png", "id": "847882634582051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830615_847882637915384_7879478757554382592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ReDzWHUSIUQ7kNvwFhmO_x&_nc_oc=Adrs-dwE92adWHX9XrUrfrSvaXWIFmNpoYxj88oWTmiROiXau9K8sUSl_KC65dbS7gg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpWiAbJui0jTcJMtmHPhL2oaRPB2gotU-t-uOfNYsqdw&oe=6AF71DDC"}, {"file_name": "4.png", "id": "1123160946612961", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_1123160953279627_4343938820670859642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8s67AF8c3VYQ7kNvwE-pkLF&_nc_oc=AdoKu0OxNHoqKRO0DHIP5LosuWiFX_dQidOzOtM32lLzi9s7PfTZ60Nh04hdCeYzBak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9lZ9_p0gRkiGWawlicnV6rWuOHCiC0ALx4iL4awTTcg&oe=6AF71AC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Elimnator  - VR Shooter", "keywords": ["Zombie", "Shooting", "Survival"], "long_description": "The apocalypse has begun, and the world is crawling with the undead.\nIn Zombie Elimnator, you are one of the few survivors left standing. Armed with basic weapons and your instincts, you must fight through endless waves of zombies coming from every direction.\n\nThis is a straightforward, action-packed VR experience focused purely on shooting, aiming, and survival. No upgrades, no fancy gear \u2014 just you, your weapon, and the horror closing in.\n\nPerfect for players who love simple, fast-paced zombie action with immersive VR combat.\n\nKey Features:\n- Pure Shooting Gameplay: No menus, no upgrades \u2014 just nonstop action.\n- Immersive VR Combat: Feel the tension of close-range zombie encounters.\n- Varied Environments: Face the undead in dark alleys, ruined streets, and foggy graveyards.\n- Simple Controls: Easy to learn, hard to survive.\n- Endless Survival Mode: How long can you last before the horde gets you?", "short_description": "Grab your gun and face the undead! Zombie Elimnator puts you in the middle of a zombie outbreak where your only goal is to survive. Aim, shoot, and stay alive in this intense Zombie Elimnator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
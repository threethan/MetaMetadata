ttps://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001706_1124588412278375_8367419165829032592_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmLdVDj8RJ8Q7kNvwHIcjVk&_nc_oc=AdkkxS1V6zSTSndYWOv_s-lAJua8TjraCz4-aDiK0gov-2i-g1g3o8w-RqYKkTEXIks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuQnIb7LH2GL98t2J-ZrL5vvUOEvI80kL9-q0v2bz-I0w&oe=69A57BA0"}, {"file_name": "s2.png", "id": "195236143520916", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203627_195236150187582_1610987406075480887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lNqLmLa-q0Q7kNvwHx4JWY&_nc_oc=AdnOXnZzU7pMQGaaFhZaQdD_Fw8sh-IFl5NczoNszJHSgvZGX6yA6NmasbjAPnpQA8c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsZ2FsVmM1abZpOj6QHV2vTAKw0eEQSjfBktlW-k-p5Pg&oe=69A582C7"}, {"file_name": "s1.png", "id": "672065668101661", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031312_672065671434994_4389458738556873344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIdh_wAbsEAQ7kNvwF6F0pr&_nc_oc=AdnBpj8LHqN8l4uDLU4JGiYYeRkqMB_WprLkXSVEGi7Nm518Em7P44Y3R4EgmHS_avU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afth6rJ1SpFMHg9pMRNVKDoe15ZUox5m7Xs6aDooYYdz6A&oe=69A59EB0"}, {"file_name": "s3.png", "id": "692464499367083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75223483_692464502700416_2035738182399417896_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBF7kb0II44Q7kNvwEBVbMN&_nc_oc=AdkV6Xb_lIC33OrrbQWG3vCiGTY4EOaeZ5QRSMzIu1D6wiFjoG0vRcoEBjLJJKs6mz4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvY1XrH1Em1IhUDq4BsXMr2MtBDDiTgIboYuqXMHF4sew&oe=69A59626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage_1.png", "id": "779331963890751", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86796324_779331967224084_1760601109497854876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pF3kfJ1czYQ7kNvwG-_aDO&_nc_oc=AdmxjJqMXFxJqtGH5oGf8V7jL2nsxcDzlwt6Rry4wCEmUqgZefld0IHwfbA0XmEwUkQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsGmzMWjH8W32xJqtinFNwJq6B0dySUV1HP7t3CRWsEVA&oe=69A58B88"}, "display_name": "Offroad", "keywords": ["VROffroadGame", "OffroadDriving", "OffroadSimulator", "DrivingSimulatorVR"], "long_description": "Experience the thrill of true offroad driving in a realistic VR environment where every surface challenges your control and decision-making.\n\nThis offroad driving simulator takes you far beyond asphalt roads and into rugged terrain filled with mud, rocks, hills, and steep slopes. Master powerful offroad vehicles, maintain balance on uneven ground, and choose the best routes to overcome natural obstacles.\n\nEach drive offers a different experience as terrain conditions, elevation changes, and vehicle handling demand constant adaptation. Precision driving, throttle control, and smart path selection are key to reaching your destination successfully.\n\nWith immersive VR visuals, smooth driving physics, and open offroad environments, the game delivers a satisfying balance between realism and accessibility. Whether you enjoy slow, technical driving or challenging routes, this offroad experience rewards skill and patience.\n\nGet behind the wheel and explore the wild side of driving.", "short_description": "A realistic VR offroad driving game with challenging terrain, powerful vehicles, and immersive open environments. Test your driving skills beyond the road."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genr
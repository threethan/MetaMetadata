3.oculuscdn.com&oh=00_AfsE7xQlWFuoHOrxYVh8a1ZJoYOM9bFEiBiH7rrI6fhhBw&oe=69A43A08"}, "display_name": "Offroad", "keywords": ["VROffroadGame", "OffroadDriving", "OffroadSimulator", "DrivingSimulatorVR"], "long_description": "Experience the thrill of true offroad driving in a realistic VR environment where every surface challenges your control and decision-making.\n\nThis offroad driving simulator takes you far beyond asphalt roads and into rugged terrain filled with mud, rocks, hills, and steep slopes. Master powerful offroad vehicles, maintain balance on uneven ground, and choose the best routes to overcome natural obstacles.\n\nEach drive offers a different experience as terrain conditions, elevation changes, and vehicle handling demand constant adaptation. Precision driving, throttle control, and smart path selection are key to reaching your destination successfully.\n\nWith immersive VR visuals, smooth driving physics, and open offroad environments, the game delivers a satisfying balance between realism and accessibility. Whether you enjoy slow, technical driving or challenging routes, this offroad experience rewards skill and patience.\n\nGet behind the wheel and explore the wild side of driving.", "short_description": "A realistic VR offroad driving game with challenging terrain, powerful vehicles, and immersive open environments. Test your driving skills beyond the road."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genr
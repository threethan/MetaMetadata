2", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001706_1124588412278375_8367419165829032592_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ushYHfj3XIEQ7kNvwHrf2tA&_nc_oc=Adpa80sdNBDS3tw63QBlHZvhIeXyc5oTtdyYKPMEcSUmklZhYPINSBoIgDA1aHsWip4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_-nA1dCnp9hFfDaH4Mgnbs0vOdi6SrkithJO44xCSSQ&oe=69F1F2A0"}, {"file_name": "s2.png", "id": "195236143520916", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203627_195236150187582_1610987406075480887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7S2W5peiCtAQ7kNvwFsoN3d&_nc_oc=AdoR1tNQQZWxWYovwldlTJaPMrgs_2zq86lfcjiEPO7iDa8mlp6DiKQwBMfO_G2O2Ic&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af02JIEe3tt1tY7EbzCzOdRLTK_pFTeZy7ewzKKRHj3piQ&oe=69F1F9C7"}, {"file_name": "s1.png", "id": "672065668101661", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031312_672065671434994_4389458738556873344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PFS6ojnTGkQ7kNvwEI2GVH&_nc_oc=Adrx9ksw_lQ_mTTvh-IdE_WD5lj5rBAy8a3Vz_4w2VFlJfWNBgxrlwMA02n96ZTv9HU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3iF9X8GFxb-08OZOY1f7IwXE9U5MdI7s4PGR4jz5TXyA&oe=69F215B0"}, {"file_name": "s3.png", "id": "692464499367083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75223483_692464502700416_2035738182399417896_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dutbMswQnGgQ7kNvwF8anbc&_nc_oc=AdpBr9JuJN5L8dab5LcF2Y7xlleX7p9M6Sq1TAEWao3WrdsYvznVM6j8GU96stFeJ9c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af03wDIA3VwxcWjhWb9bjfr7IDoRQ99OePsM8SaiNXnwiQ&oe=69F20D26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage_1.png", "id": "779331963890751", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86796324_779331967224084_1760601109497854876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNbBcCDkMdQQ7kNvwEUP8vT&_nc_oc=Adq4bJCAzdjv2kwcQoH0PHo0Lyc72idIoWCxi2ATsuXedPaIjP01ZQcH8VFv6c6F0Ao&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2Jv-GvdwkKfh4d1DLWW75ZwfKNcar1zPnGiH79Qj7uNw&oe=69F20288"}, "display_name": "Offroad", "keywords": ["VROffroadGame", "OffroadDriving", "OffroadSimulator", "DrivingSimulatorVR"], "long_description": "Experience the thrill of true offroad driving in a realistic VR environment where every surface challenges your control and decision-making.\n\nThis offroad driving simulator takes you far beyond asphalt roads and into rugged terrain filled with mud, rocks, hills, and steep slopes. Master powerful offroad vehicles, maintain balance on uneven ground, and choose the best routes to overcome natural obstacles.\n\nEach drive offers a different experience as terrain conditions, elevation changes, and vehicle handling demand constant adaptation. Precision driving, throttle control, and smart path selection are key to reaching your destination successfully.\n\nWith immersive VR visuals, smooth driving physics, and open offroad environments, the game delivers a satisfying balance between realism and accessibility. Whether you enjoy slow, technical driving or challenging routes, this offroad experience rewards skill and patience.\n\nGet behind the wheel and explore the wild side of driving.", "short_description": "A realistic VR offroad driving game with challenging terrain, powerful vehicles, and immersive open environments. Test your driving skills beyond the road."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_ty
ttps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001706_1124588412278375_8367419165829032592_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4y7jCPxzkP4Q7kNvwF15ZQU&_nc_oc=AdlrAzOEKFNvmhPlLm9hwTDPzhkZiQbuoDsu2iN4vRokxBZF1rR-NyTRz56hnK8dNac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsDaIX6X2H2T-7KXdpGjWQCyccED6MADZBRdgmRyRdJsg&oe=699D92A0"}, {"file_name": "s2.png", "id": "195236143520916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203627_195236150187582_1610987406075480887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAZxTbyrFQsQ7kNvwGtb1IP&_nc_oc=Adn07CQZi8KJqGGxK6SJgKBsV3J9Wy3sRWBM822Z8FaYoL1wE_cnwnCLO3EWn80LFVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvr6KZPDnjdilnC3YIzOPecPlgCLKIOIv2kqqyZe5feTA&oe=699D99C7"}, {"file_name": "s1.png", "id": "672065668101661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031312_672065671434994_4389458738556873344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC4c23T3xTcQ7kNvwE8IcOJ&_nc_oc=AdmwvOoDp4vB7joLVBXQV6HwgYe_fi37kJC6Sq0oENJTFOBCjYxRPYM46Ak7HqotRgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-O66QmeTFzQIFvRzNQbiHhiMx8ljg46RVCved6p8oug&oe=699DB5B0"}, {"file_name": "s3.png", "id": "692464499367083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_692464502700416_2035738182399417896_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXixisWqg4MQ7kNvwHGsU-g&_nc_oc=AdkqdGfAyfEHE_8hfyqp9_WwZk-iaJ8IPSj1dvhkTKIlOwlOIohfdO0dP0Vb4_YM4r4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBAE5K_Q6BaVX0ePGMamOAUz-YIBwa_b8IDJvXlIvD1w&oe=699DAD26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage_1.png", "id": "779331963890751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86796324_779331967224084_1760601109497854876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cXQss_vdPEQ7kNvwFFQbX5&_nc_oc=AdnAuzThjeLBKATSJjVN2oIWfY-oaIXb2qAlzRM0ocISmkhfrYymSb1tyTPVeJvEOsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftBFkfacRO3CiHMwfm9T9vIGyNPm4aCYdjgueTcRtJjxA&oe=699DA288"}, "display_name": "Offroad", "keywords": ["VROffroadGame", "OffroadDriving", "OffroadSimulator", "DrivingSimulatorVR"], "long_description": "Experience the thrill of true offroad driving in a realistic VR environment where every surface challenges your control and decision-making.\n\nThis offroad driving simulator takes you far beyond asphalt roads and into rugged terrain filled with mud, rocks, hills, and steep slopes. Master powerful offroad vehicles, maintain balance on uneven ground, and choose the best routes to overcome natural obstacles.\n\nEach drive offers a different experience as terrain conditions, elevation changes, and vehicle handling demand constant adaptation. Precision driving, throttle control, and smart path selection are key to reaching your destination successfully.\n\nWith immersive VR visuals, smooth driving physics, and open offroad environments, the game delivers a satisfying balance between realism and accessibility. Whether you enjoy slow, technical driving or challenging routes, this offroad experience rewards skill and patience.\n\nGet behind the wheel and explore the wild side of driving.", "short_description": "A realistic VR offroad driving game with challenging terrain, powerful vehicles, and immersive open environments. Test your driving skills beyond the road."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genr
100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kqkqa0z7270Q7kNvwGZa5Nu&_nc_oc=Adq8VD27m0Pk2gpP-Ro0M1BjZh-uAEzFP8QEhJos7izROwRLMJbT_O2vNuJ8ZZQm0UM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF0DG_SXW6vJYVg5s2SMZ-2Q0J6O-IqN7fRnLg2q5cZA&oe=6A85AA88"}, "display_name": "Offroad", "keywords": ["VROffroadGame", "OffroadDriving", "OffroadSimulator", "DrivingSimulatorVR"], "long_description": "Experience the thrill of true offroad driving in a realistic VR environment where every surface challenges your control and decision-making.\n\nThis offroad driving simulator takes you far beyond asphalt roads and into rugged terrain filled with mud, rocks, hills, and steep slopes. Master powerful offroad vehicles, maintain balance on uneven ground, and choose the best routes to overcome natural obstacles.\n\nEach drive offers a different experience as terrain conditions, elevation changes, and vehicle handling demand constant adaptation. Precision driving, throttle control, and smart path selection are key to reaching your destination successfully.\n\nWith immersive VR visuals, smooth driving physics, and open offroad environments, the game delivers a satisfying balance between realism and accessibility. Whether you enjoy slow, technical driving or challenging routes, this offroad experience rewards skill and patience.\n\nGet behind the wheel and explore the wild side of driving.", "short_description": "A realistic VR offroad driving game with challenging terrain, powerful vehicles, and immersive open environments. Test your driving skills beyond the road."}]}, "developer_name": "INITIUM STUDIO", "developer_privacy_policy_url": "https://atakanerdeger.github.io/gametriclabs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gametriclabs", "support_website_url": null, "website_url": "https://atakanerdeger.github.io/gametriclabs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326
okp&_nc_oc=AdoHQDf-0z4EUZIBuddDNiG8eLyIS942Kbw3LxPtrfhhVU1RNn3LDq1StuMUFvWoiWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPODkvmV7301dnzhBQm0EfRlazdSX-bsMbn2ulNZt4acQ&oe=6ABFC10F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hyper's Gorilla Horror: Cloud's Edition", "keywords": ["gorilla", "horror"], "long_description": "In Hyper's Gorilla Horror, we have over 10+ maps, a ton of monsters, cool visuals, and more! Experience this exciting game! Buy cosmetics, hang with your friends, and run from the monsters! Updates are coming rapidly, and much more will be coming in the future! This game was originally made for fun, and ONLY following Hyper's expectations, so if you like it, or don't like it, it's your choice! We hope to see you enjoy this game, as lots of time is put into polishing, adding small and big things, and much more like that! The monsters are waiting for you, so why are YOU waiting?! Download Hyper's Gorilla Horror NOW! And have the best experience!", "short_description": "In Hyper's Gorilla Horror, we have over 10+ maps, a ton of monsters, cool visuals, and more! Experience this exciting game! Buy cosmetics, hang with your friends, and run from the monsters! They're waiting for you, so why are YOU waiting?! Download Hyper's Gorilla Horror NOW! And have the best experience!"}]}, "developer_name": "Hyper", "developer_privacy_policy_url": "https://docs.google.com/document/d/1GzlK3acmH5EI74hdemcKC_k6RUc2EWZwE3NFyjfIDPw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hyper Games LLC", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1WsojpuZGAmMoNMFUaS3kpGhABRpDcza6zz843MeO0Zk/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_t
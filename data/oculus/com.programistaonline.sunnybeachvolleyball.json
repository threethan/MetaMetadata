le_name": "hero-3000x900.png", "id": "1127029743561832", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825462_1127029746895165_8679538309606014257_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRVV3zE2ATsQ7kNvwEFMFpa&_nc_oc=Adr-QnTh6KaT9XF4zP1Wr34DFfvIdxL4KU0J1qSf6u_m3el83TZroul3aUm4y26Gpfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYsEUkgx5m7kwEDTfl3YCwYGwQHjw848JtrauDnGLMkQ&oe=6B0C84A2"}]}, "id": "1845154563484331", "locale": "en_US", "screenshots": [{"file_name": "01-beach-match.png", "id": "1853402185865901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823320_1853402192532567_5898188099726114784_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G51abW1R9E8Q7kNvwEV2q7f&_nc_oc=AdrQXBuQQCe5rXlbNs1b2hti8o-wLlzcaxL-mvXEh-s9jI1uhVBPwapyU0TrhmETbDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqJGUfSTCsKWq4ic-puNaNOHQFa7hHmJqcG76rsVWfcw&oe=6B0C821B"}, {"file_name": "02-court-and-scoreboard.png", "id": "1143634228410390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_1143634238410389_5820543007929187924_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tFyq4XGRRIQ7kNvwGItKBg&_nc_oc=AdqjhVwd2R_p_ZJZOUc-cbEqZQTm2ym3LFXNVGt-8ABrXclF0BTkNZX9WhCME9vbuTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2tMoTJ_CO0GOmPt3a471qla81P4WrOnntzndu4bRtxQ&oe=6B0C73C6"}, {"file_name": "03-team-selection.png", "id": "1770023787400684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1770023790734017_1738063523771994764_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keuDiZNc70wQ7kNvwHqw6Ep&_nc_oc=AdpBbrP_ruuA7pUYka3tlehpELoUEQGLrtzo8COtyUB3OPNz45_MBvkx_CaJJbbArJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZ72pwUw0whux6k5b4V6Qn4jBiLPr5h_t3OB0-cH7Ziw&oe=6B0C5316"}, {"file_name": "04-tournament.png", "id": "1595849245677279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823910_1595849249010612_7197966657928885648_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrJqKJjpmgQQ7kNvwEhGvl9&_nc_oc=Adp7cUg7fz3Z6DfgYzVQDug4-1FvjHxOvVlTd514vH6jyvZyRzXEuyIkA4RI5ewqQ_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdsrvKNPiGLn5a-RevA-2atrvfYlo2psmKqQhXJa1zAQ&oe=6B0C7DD6"}, {"file_name": "05-target-training.png", "id": "1052789124514747", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_1052789127848080_1060581106866835457_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp0ssIoeDn4Q7kNvwElWGN9&_nc_oc=Ado8M7L1ZLptWr2Ek5vbd24w5w0CqilqqWHohTW8KRKhEu6qIQzr__5QNClkkZDoNsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3pFxXDb0a0UWwnkTURsff-62EWDmWRz7PAW2NqKV90g&oe=6B0C69F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sunny Beach Volleyball", "keywords": [], "long_description": "Your next match starts on the sand.\n\nSunny Beach Volleyball is a single-player VR sports game: you and an AI teammate take on two AI opponents on a sunny beach court. Move your hands to receive, set, block and spike. Faster swings produce stronger shots, and adjustable hit sensitivity helps you find a comfortable feel.\n\nPLAY A FULL MATCH\nServe, build a rally and compete across sets, with automatic scoring, out-of-bounds detection and changes of ends. Choose your difficulty and pause whenever you need a break.\n\nTRAIN AND COMPETE\nPractise with repeatable feeds, test your aim in target challenges and work through a tournament. Track your records and earn outfit rewards.\n\nMAKE IT YOUR TEAM\nChoose women\u2019s, men\u2019s or mixed lineups, select your player\u2019s hand appearance, name both teams and customise outfits. Your settings and progress are saved between sessions.\n\nBuilt for motion controllers. Hand movement determines shot power; jumping is not required for a spike. Includes 11 interface languages: English, Polish, Spanish, German, French, Italian, Brazilian Portuguese, Japanese, Korean, Simplified Chinese and Dutch.", "short_description": "Step onto a sunny beach court for single-player 2-on-2 volleyball with AI teammates and opponents. Serve, set, block and spike with motion controls, with shot power driven by your hand speed. Play matches and tournaments, practise with repeatable feeds, and take on target challenges. Choose women\u2019s, men\u2019s or mixed teams and unlock outfits."}, {"images": {"nodes": []}, "id": "1466393325452210", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sunny Beach Volleyball", "keywords": [], "long_description": "Tw\u00f3j kolejny mecz zaczyna si\u0119 na piasku.\n\nSunny Beach Volleyball to sportowa gra VR dla jednej osoby. Razem z partnerem sterowanym przez AI zmierzysz si\u0119 z dw\u00f3jk\u0105 komputerowych rywali. Odbieraj, wystawiaj, blokuj i \u015bcinaj ruchem d\u0142oni. Szybszy zamach oznacza mocniejsze zagranie, a regulacja si\u0142y odbi\u0107 pozwala dopasowa\u0107 sterowanie do siebie.\n\nROZEGRAJ PE\u0141NY MECZ\nSerwuj, buduj wymiany i walcz o kolejne sety. Gra automatycznie nalicza punkty, wykrywa auty i zmienia strony boiska. Wybierz poziom trudno\u015bci i zr\u00f3b pauz\u0119, gdy potrzebujesz przerwy.\n\nTRENUJ I RYWALIZUJ\n\u0106wicz dzi\u0119ki powtarzalnym podaniom, sprawdzaj celno\u015b\u0107 w wyzwaniach i przejd\u017a turniej. Poprawiaj rekordy i zdobywaj nowe stroje.\n\nSTW\u00d3RZ SWOJ\u0104 DRU\u017bYN\u0118\nWybierz sk\u0142ad damski, m\u0119ski lub mieszany, wygl\u0105d d\u0142oni gracza, nazwy obu dru\u017cyn i stroje. Ustawienia i post\u0119py zostaj\u0105 zapisane mi\u0119dzy sesjami.\n\nGra wykorzystuje kontrolery ruchowe. Si\u0142a zagrania zale\u017cy od ruchu d\u0142oni; wykonanie \u015bcinki nie wymaga podskakiwania. Interfejs jest dost\u0119pny w 11 j\u0119zykach, w tym po polsku.", "short_description": "Wejd\u017a na s\u0142oneczne boisko i zagraj w siatk\u00f3wk\u0119 pla\u017cow\u0105 2 na 2 z partnerem i rywalami sterowanymi przez AI. Serwuj, wystawiaj, blokuj i \u015bcinaj \u2014 si\u0142a zagrania zale\u017cy od szybko\u015bci ruchu d\u0142oni. Rozgrywaj mecze i turnieje, \u0107wicz powtarzalne podania i celno\u015b\u0107. Wybieraj dru\u017cyny damskie, m\u0119skie lub mieszane oraz odblokowuj stroje."}]}, "developer_name": "Programista - Piotr Ha\u0142as", "developer_privacy_policy_url": "https://programista-online.pl/sunny-beach-volleyball/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Programista - Piotr Ha\u0142as", "support_website_url": "https://programista-online.pl/sunny-beach-volleyball/", "website_url": "https://programista-online.pl/sunny-beach-volleyball/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "de", "fr", "es", "it", "pt_BR", "ja", "ko", "zh_CN", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1475103425677671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1784872656151791_8181412681589296737_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZJd891_6fEQ7kNvwFpubm6&_nc_oc=Adodsh6z9QC-FpdWAZSmk7MZJl0J9uTszDoh8syQNnLEGCQ34NXjdvXxgSLTmfFZw3E&_n
1-7&_nc_sid=6e7a0a&_nc_ohc=g2ukQkhDaFoQ7kNvwHJYf1b&_nc_oc=AdrjzH-unmVQaXBmI4GPbXDUh1_S_fwy9hK2dozqMxRXkkX1OXFyu0sxn9vX2X5Ho6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU2UY7ZDlgA382TxiRQKvA70OV_2rec3zdoGcY4E8XBQQ&oe=6B0F02A1"}, {"file_name": "04_boss_fight.png", "id": "2217135122533258", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_2217135125866591_8643601389823820646_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leUJuuj-K6UQ7kNvwEwWUBW&_nc_oc=Adqu3aUanf06FLsXvARQKirssjXuRJrLplIkYLvTmqkrcIcIm6rHqga10MnZ1CNLZ_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0pXJjkwS0XhIH-XacRGBB5uXOKST-goVUAXIBPViFOA&oe=6B0F0DF3"}, {"file_name": "03_vault_bank_robbery.png", "id": "1008343088262250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827585_1008343091595583_1037635686137377957_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xOh3yfqEhsQ7kNvwGcbAyI&_nc_oc=AdpaJbAzUXyBu7VYYNeGuABjCTcTW4o2_haLXb_Nc2bQajpgfrLkZ0rL3gFpwF5xycg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIncVwc--NnnZMApvLzDd2W_2ZEVfYMXHU9TvEXTT6Ow&oe=6B0F0058"}, {"file_name": "05_pool_balloon_prank.png", "id": "2203018053965196", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_2203018060631862_316504874963521900_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ykmrvMubYQQ7kNvwFKPx7h&_nc_oc=AdrgbHrGsCiEI2EM56pwWVf3rFKTvzdzd2Hcx7rouc-fyEJ95qXJi1MuviYC7dHXz_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3pG05O378rFHt1iXtOUQPIx3f48MpDEiNiO-fDf_VlQ&oe=6B0EF626"}, {"file_name": "01_office_banana_slip.png", "id": "1009288161794370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1009288168461036_4268316348256663004_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8o8raZHC7GkQ7kNvwESFAe3&_nc_oc=AdrKvwal0JRCgFyc9b9vA_CVSv_C8f8c5yxvWuL7Ckowxm0hTk-fELTI7DKWGDocAxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVVMtvyoL0L1yzVGd4JFYpbf_eGQiLvd_u_47exy35_0g&oe=6B0EF47F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Job Simulator: Office Prankster", "keywords": ["office", "prank", "job", "funny", "boxing"], "long_description": "YOU'RE THE NEW INTERN. NOBODY IS SAFE.\n\nOffice Prankster VR is a physics sandbox set in an office that deserves everything\nyou're about to do to it. Prank your coworkers, pick fights, rob the safe and climb\nfrom intern all the way to BOSS.\n\n\ud83d\ude08 PRANK EVERYONE\nSet traps, ambush coworkers at their desks, in the kitchen and in the toilet stalls.\nEvery coworker reacts, remembers, and comes back for revenge.\n\n\ud83e\udd4a FIGHT YOUR WAY UP\nUse your fists or grab a weapon off the rack. Win career showdowns to earn each\npromotion, across 9 career tiers, until only the Boss is left.\n\n\ud83d\udd2b A FULL ARSENAL\nMelee weapons, guns and throwables, all physics-based. If you can pick it up,\nyou can hit someone with it.\n\n\ud83c\udfc6 MINI-GAMES ALL OVER THE BUILDING\nA 20-level boxing ring, arm wrestling, tug-of-war, golf, penalty shootouts and more.\n\n\ud83d\udcb0 ROB THE PLACE\nCrack the boss's safe, pull off the bank robbery, and spend the money on better gear.\n\n\ud83d\udc54 BEAT THE BOSS\nTake him down, take his office, then take the rematch when he wants it back.\n\n\ud83c\udfe2 A WHOLE OFFICE TO WRECK\nOpen-plan desks, kitchen, reception, garden, the boss's floor and the vault.\nGo anywhere. Break anything.\n\n\ud83c\udf84 SEASONAL CHAOS\nChristmas comes to the office, with more on the way.\n\nNo rules. No HR. Clock in and create chaos.", "short_description": "Prank your coworkers, punch your way up the career ladder and take the boss's chair. A physics sandbox office where everything can be grabbed, thrown or used as a weapon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1
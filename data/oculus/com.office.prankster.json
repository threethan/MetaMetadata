oe=6B0EF626"}, {"file_name": "01_office_banana_slip.png", "id": "1009288161794370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1009288168461036_4268316348256663004_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8o8raZHC7GkQ7kNvwESFAe3&_nc_oc=AdrKvwal0JRCgFyc9b9vA_CVSv_C8f8c5yxvWuL7Ckowxm0hTk-fELTI7DKWGDocAxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVVMtvyoL0L1yzVGd4JFYpbf_eGQiLvd_u_47exy35_0g&oe=6B0EF47F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Job Simulator: Office Prankster", "keywords": ["office", "prank", "job", "funny", "boxing"], "long_description": "YOU'RE THE NEW INTERN. NOBODY IS SAFE.\n\nOffice Prankster VR is a physics sandbox set in an office that deserves everything\nyou're about to do to it. Prank your coworkers, pick fights, rob the safe and climb\nfrom intern all the way to BOSS.\n\n\ud83d\ude08 PRANK EVERYONE\nSet traps, ambush coworkers at their desks, in the kitchen and in the toilet stalls.\nEvery coworker reacts, remembers, and comes back for revenge.\n\n\ud83e\udd4a FIGHT YOUR WAY UP\nUse your fists or grab a weapon off the rack. Win career showdowns to earn each\npromotion, across 9 career tiers, until only the Boss is left.\n\n\ud83d\udd2b A FULL ARSENAL\nMelee weapons, guns and throwables, all physics-based. If you can pick it up,\nyou can hit someone with it.\n\n\ud83c\udfc6 MINI-GAMES ALL OVER THE BUILDING\nA 20-level boxing ring, arm wrestling, tug-of-war, golf, penalty shootouts and more.\n\n\ud83d\udcb0 ROB THE PLACE\nCrack the boss's safe, pull off the bank robbery, and spend the money on better gear.\n\n\ud83d\udc54 BEAT THE BOSS\nTake him down, take his office, then take the rematch when he wants it back.\n\n\ud83c\udfe2 A WHOLE OFFICE TO WRECK\nOpen-plan desks, kitchen, reception, garden, the boss's floor and the vault.\nGo anywhere. Break anything.\n\n\ud83c\udf84 SEASONAL CHAOS\nChristmas comes to the office, with more on the way.\n\nNo rules. No HR. Clock in and create chaos.", "short_description": "Prank your coworkers, punch your way up the career ladder and take the boss's chair. A physics sandbox office where everything can be grabbed, thrown or used as a weapon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labsg", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1432508086618119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1673971377540336_981474231108154581_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk92nCiWWRIQ7kNvwHUwTgs&_nc_oc=Adpv3LXv79JvrCPaD0oSYByKpSzfifapI90dC1dEoJcXnAjeeiIcyxOXgsLK7TI9AQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV5f3LskhBKCSVTi0QezN5_B-nZx2mbn06jkUJ1Ge-jIg&oe=6B0EEABD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Job Simulator: Office Prankster", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "i
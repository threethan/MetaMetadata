rDmG9neg047Rs0Nr8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4204zmeS8KkF-6vXHIzhsDNfpeIOb42S5ziEXKPCG-w&oe=6AC2729A"}, {"file_name": "meta_horizon_screenshot_3_2560x1440.png", "id": "2078362823099895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_2078362826433228_7213349503656900103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrjh245saJMQ7kNvwFrMrzO&_nc_oc=AdrXaghYPAwBppJ4lX0W0w9I2JW5hZljIoiX-wFPqACyvWE14MuVtxTWddpLw-CLxd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUl_KBPxaQilpyJt9XPQIcLPLZbmLmZ0EsKdSGlOzB8A&oe=6AC2765A"}, {"file_name": "meta_horizon_screenshot_4_2560x1440.png", "id": "1365144525462100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_1365144528795433_4866511099490061322_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-_YFSUIuE4Q7kNvwGYhWCV&_nc_oc=AdpwC2K93h4sDfc0-1c9lUbFm-JF-7t9xAWwr9BNgEjbSTUSE24ynWSGyHYaEw33s40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-veyG2p7Bb1FSYnOS0_NeC7-qJECpmK6WHdcR9QO6Cg&oe=6AC27AE1"}, {"file_name": "meta_horizon_screenshot_1_2560x1440.png", "id": "1343913697615598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620817_1343913700948931_2940609010821745208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inNnsprd_GkQ7kNvwGZ6_ry&_nc_oc=AdplryoN_xrjqLnL3Ho3myMVZ58nEg_whn3l6GDojOfpM9VOdjgXCaPJaT-XQdu1NiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYi9Izb70RTkv0jHQ00d9TcK5zC4Zql9PO-DrQCPhISw&oe=6AC25C9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eagle Glide", "keywords": ["Eagle", "Bird", "Fly", "gliding", "Soaring"], "long_description": "Eagle Glide VR is an immersive virtual reality flight experience that lets you see the world from the eyes of an eagle. Glide through open skies, enjoy smooth bird-like movement, and explore peaceful environments from a breathtaking aerial perspective.\n\nDesigned for players who want a relaxing and atmospheric VR experience, EagleGlideVR focuses on the feeling of freedom, height, and natural motion. Take off, steer through the air, and enjoy the sensation of soaring above the landscape without complicated controls or pressure-heavy objectives.\n\nWhether you want to unwind, experience the thrill of flight, or simply enjoy a unique VR perspective, EagleGlideVR offers a calm and memorable journey through the skies. It is built to make flying feel accessible, immersive, and satisfying for players of all experience levels.", "short_description": "Soar through immersive VR skies in Eagle Glide VR, a relaxing flight experience where you glide like an eagle, explore open environments, and enjoy smooth, natural motion from a bird\u2019s-eye view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/eagle-glide-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1156514717543806"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1660228575740078"}, {"status": "PUBLISHED", "id": "1951255692496780"}, {"status": "PUBLISHED", "id": "95156
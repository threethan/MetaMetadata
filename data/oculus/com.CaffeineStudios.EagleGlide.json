&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPUuam7YGQJ2-HXrK2fVO8dO0-4WUpovMlf_3i8vecZg&oe=6ABE8661"}, {"file_name": "meta_horizon_screenshot_1_2560x1440.png", "id": "1343913697615598", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620817_1343913700948931_2940609010821745208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK9uW7OVvkgQ7kNvwHaqEBI&_nc_oc=AdopnywZUSiAk7-pl8VFpXGD47I_6p0R0BgwmVwzEDk84RPIX_c0zH4xLbc9gAKXzqA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnUQteqjmk0xu1gLMo_wvBHoIuKm6dF744WmklC3m2HA&oe=6ABE681A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art in landscape.png", "id": "2420491525080637", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307352_2420491531747303_6776910636620079367_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI8RbX6mJWcQ7kNvwHPMsBG&_nc_oc=Adoo6BLAPcwrJkTUBX26-d_aWT4P5mDPlYtIk4mahN-C_RPnD4HkU5QuOUdyxQPnX3Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr4ZCawSMM4Kks6B0mXvJPG-Fy-xv5SjgZlHPLgO7ekg&oe=6ABE7125"}, "display_name": "Eagle Glide", "keywords": ["Eagle", "Bird", "Fly", "gliding", "Soaring"], "long_description": "Eagle Glide VR is an immersive virtual reality flight experience that lets you see the world from the eyes of an eagle. Glide through open skies, enjoy smooth bird-like movement, and explore peaceful environments from a breathtaking aerial perspective.\n\nDesigned for players who want a relaxing and atmospheric VR experience, EagleGlideVR focuses on the feeling of freedom, height, and natural motion. Take off, steer through the air, and enjoy the sensation of soaring above the landscape without complicated controls or pressure-heavy objectives.\n\nWhether you want to unwind, experience the thrill of flight, or simply enjoy a unique VR perspective, EagleGlideVR offers a calm and memorable journey through the skies. It is built to make flying feel accessible, immersive, and satisfying for players of all experience levels.", "short_description": "Soar through immersive VR skies in Eagle Glide VR, a relaxing flight experience where you glide like an eagle, explore open environments, and enjoy smooth, natural motion from a bird\u2019s-eye view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/eagle-glide-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1170574716137806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_2335870443615534_3587883462743238705_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZTi2bRIWBoQ7kNvwFduRQH&_nc_oc=AdoR7DjJzURMslwfRG8y7uQxDskD_WIbBJKZmTIynsHhvlu0XXccjFEm1TijU9vIsfw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQsQYva2fyT47GH18535GTsCflBfD1jxxEVJRLRUmz9Q&oe=6ABE59D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eagle Glide", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Si
FPUNXmx1f4oz7QIfR6fTx2RK6cWhwW2fdZD_6N84wQ&oe=6A281D82"}, {"file_name": "meta_horizon_screenshot_2_2560x1440.png", "id": "2035982213938024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305396_2035982217271357_1982315042525284009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv8vw4AnyV4Q7kNvwFndKvd&_nc_oc=AdrqzG9QG1Sju5sJDDE0Q9ExXZEYvIogvmnyr31SiJAELXvXMD117qA5x49mQ2LwYs0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_72L2_YcqMejOq2xn7tNR8r7pyovmdt3RwtbwvOG9q8g&oe=6A28331A"}, {"file_name": "meta_horizon_screenshot_3_2560x1440.png", "id": "2078362823099895", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620875_2078362826433228_7213349503656900103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8W-lpTRqtkUQ7kNvwFdSt8P&_nc_oc=Adpb2Wc6KU3Qvc_EEWzbgY9jaVqFL9UWZ2EO20yHEgS8dsrMcZ_aaEn9qwdsvZ9U49w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rd8uB5LRMh0wJ76b9XYe3ECcvzM-Q4ygphJCJ_SLz1Q&oe=6A2836DA"}, {"file_name": "meta_horizon_screenshot_4_2560x1440.png", "id": "1365144525462100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_1365144528795433_4866511099490061322_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-qvXMs-rpIQ7kNvwGYkRPz&_nc_oc=AdrItE_IufMtqaIQUB7r4K_gSu77XOA48urRDH_nm13-dzFWolYKbbNozHW4Z5FCqyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q363EFLbodmz_whFMFK7mEBT0oyzgkFzw6zvfE68Zbg&oe=6A283B61"}, {"file_name": "meta_horizon_screenshot_1_2560x1440.png", "id": "1343913697615598", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620817_1343913700948931_2940609010821745208_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IkmcRmch38Q7kNvwEzgSOD&_nc_oc=AdpvAMwFQa0uL-fpej7XwZpi8uJlEoSRbMS7REm9kvXlhD1G20DgncEXD4fiJRg8vMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e7s7mxSbdFQWF2orUgdTAuaaR9Ew2a82FnDlwkCK9zQ&oe=6A281D1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eagle Glide", "keywords": ["Eagle", "Bird", "Fly", "gliding", "Soaring"], "long_description": "Eagle Glide VR is an immersive virtual reality flight experience that lets you see the world from the eyes of an eagle. Glide through open skies, enjoy smooth bird-like movement, and explore peaceful environments from a breathtaking aerial perspective.\n\nDesigned for players who want a relaxing and atmospheric VR experience, EagleGlideVR focuses on the feeling of freedom, height, and natural motion. Take off, steer through the air, and enjoy the sensation of soaring above the landscape without complicated controls or pressure-heavy objectives.\n\nWhether you want to unwind, experience the thrill of flight, or simply enjoy a unique VR perspective, EagleGlideVR offers a calm and memorable journey through the skies. It is built to make flying feel accessible, immersive, and satisfying for players of all experience levels.", "short_description": "Soar through immersive VR skies in Eagle Glide VR, a relaxing flight experience where you glide like an eagle, explore open environments, and enjoy smooth, natural motion from a bird\u2019s-eye view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/eagle-glide-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
c=AdqYmt4h1ts2hyaZQImETjhY5sOGFBNfVtuzaYPHOPzIYLSIMwyWEFg0PKFIXshZvT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUjo_BfFZE_S_jdVx7L_DSpi9tteSOIgI4pHi3pGmWig&oe=6AFDC823"}, {"file_name": "02_Day_Alpine_Village_2560x1440.png", "id": "4490079697915105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_4490079701248438_539810055110370243_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix0FwQgSyxkQ7kNvwHgoXbA&_nc_oc=AdqLAT4DuyLA5nU647A6OrB_vqx-ME8g5dbkxQffANWYJgrxcPIc1g4XPTSaQBop-NM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGcISCsHYDzinmOYz8RTI-OaqbOTayTkyoz1mO8udsSQ&oe=6AFDB2CC"}, {"file_name": "04_Night_Snow_Valley_2560x1440.png", "id": "912722645050963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831393_912722648384296_9196843904967041325_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9J6F91WIIkQ7kNvwHVnoxk&_nc_oc=Adq7hY1xWuBGUWjvE7ooM26Oht8xeD-8GdgC9jE5fE4tV_4G_GJE1WjqsEUS3ZPPwpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXvg9G7rdj5cPEybj5X_t4c5jWh_D-s1XzhkZN8oKbGw&oe=6AFDAD46"}, {"file_name": "03_Day_Ridge_Run_2560x1440.png", "id": "1697437194665444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673573223_1697437197998777_8680241346547049190_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssgwIoNaIKIQ7kNvwEkqNMv&_nc_oc=Ado9M7XR2tieWpdymBGOaTk46w5BlLd9xG5RI0II6ZfvIOd0T94_oaShZEz9amxb8Hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUY4GCb1Yw8OWE7CHq6-RdPldXozuehtN9vVZUGXixVw&oe=6AFDC693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "923217827220768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673716021_923217830554101_8132581676747916911_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOJSlr_DELsQ7kNvwFmD5p9&_nc_oc=AdrYdS00De6BM9LJkPPCAogCB4iN4i3mqpbjWmccD33pBBlODBX0-8wWoqsUSbdVtg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_sTVg2gBLmYH9jS70kjhxGijYng3QA5zkoV7vffrTiA&oe=6AFDD9D3"}, "display_name": "Eagle Glide: Bird Flight", "keywords": ["Eagle", "Bird", "Fly", "gliding", "racing"], "long_description": "See the world through an eagle's eyes. Eagle Glide is a single-player VR bird flight game that combines aerial exploration, feather-finding challenges, and races against rival eagles.\n\nHEAD-DIRECTED FLIGHT\nSteer by moving your head and select menu options by looking at them. No controllers needed: put them aside and let your headset guide your flight. A guided menu tutorial helps you learn the gaze controls.\n\nTHREE WAYS TO FLY\nExploring: Follow checkpoints through the landscape and build your score as you discover the route from above.\n\nFinding: Search for eight blue feathers and collect them before time runs out.\n\nChasing: Race computer-controlled eagles, follow the course, and collect turbo feathers for a burst of speed as you compete for first place.\n\nDAY OR NIGHT\nChoose Day Mode or Night Mode to see the landscape in different lighting. Pick your setting, choose your challenge, and take to the skies.\n\nEnjoy the aerial perspective, sharpen your steering, and switch from exploration to the thrill of a chase. Whether you want to glide through the scenery or test your flying skills, your next eagle adventure is waiting.", "short_description": "Fly like an eagle in a VR bird flight adventure.\n\nSteer with your head, follow checkpoints, find eight blue feathers against the clock, and race rival eagles with turbo boosts.\n\nChoose Day Mode or Night Mode and experience the landscape from a bird's-eye view.\n\nNo controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/eagle-glide-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "sup
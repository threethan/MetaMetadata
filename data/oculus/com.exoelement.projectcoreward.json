ttps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031605_1110555074042149_5355556494513575113_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II32jGuj7C8Q7kNvwG6DaUO&_nc_oc=AdrUbwOoOZpvi05tSAJpRr1nhmnS_Wk9z2fsYUdSFryeKrro6ETAclo15tWhaJadd8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1gJNqEVdiW2DoINYya9q43IZwoUg-H4mFSdz60pNuJw&oe=6B0DACB9"}, {"file_name": "vlcsnap-2026-01-12-11h10m23s722.png", "id": "1943546789921711", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507840145_1943546793255044_4083081591763992187_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPX0uyzJ3IsQ7kNvwFvlAF9&_nc_oc=AdploZEkgiA-gC1bVN4ZBlR9IaBj8ShQnYpMYsiT0nm5CxeS-4Wdsryh5CcBBQFxcyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSN3fZfwNcUNCDtowWknBbBgAqjz6Pey9lARnDoe8Z5Vw&oe=6B0DBBFC"}, {"file_name": "vlcsnap-2026-01-12-11h13m07s147.png", "id": "803285356056536", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827282_803285362723202_4794929601734141234_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQl1-hAmfk8Q7kNvwFk9RZ4&_nc_oc=Adq8IvCR2DpooisO1PXspCjOefZNyitSSIfk4LenY5d37vCFZZw61s3OdVnTi0yJnng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSACtsaCFU3r6T-teRjbWhdouarZyYjP4jC-QCAavpGxg&oe=6B0DAF63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta-Store-Thumb.png", "id": "889474943492921", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825497_889474946826254_2907860162104322595_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdA9JOJfTa4Q7kNvwHdcG5Y&_nc_oc=AdqVixfebLdanJ4WgUwR-7frNqlSKXB9_Tu0tziqH2by4djUng9RYh1iVdUGGTlLMGg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkJ4uXkqkrRFkW8bA8U-HAoFNdUbpZh9YuOzjXI_Qdxg&oe=6B0DB089"}, "display_name": "Project Coreward", "keywords": [], "long_description": "# An Entire Galaxy To Explore!\n\nAssemble a starship. Create a diverse crew. Their mission? To see what's out there. **To survive.** If you make it, you will discover **ancient choices** that now weigh darkly on the fate of thousands of worlds. \n\n{1374932187060454}\n# Each World Is Yours To Discover!\n\nGlide your ship through the stars in every dimension. Walk the surface of giant planets. Fortify your vessel at Starbase and prepare its crew! Engage in diplomacy (**or combat!**) and make friends or foes. If you persevere, you'll discover the troubling nature of choice and consequence in this rich story driven adventure.\n{2020015205444268}\n\n# Features:\n- Open galaxy with thousands of solar systems filled with enormous walk-able planets.\n- 7 space faring races with unique cultures and personalities.\n- An engaging capital ship combat system.\n- Rich diplomacy and dialog.\n- Ship upgrades, crew configuration and training. \n- Collectable artifacts to enhance your ship and its crew.\n- A deep sci-fi story line.\n\nProject Coreward is the work of a sole developer.\n", "short_description": "Embark on an open world journey across the stars while encountering foes, friends and forgotten stories. Build your ship. Recruit and train your crew. Most of all, explore and confront the unknown to reveal the true, vast nature of choice and consequence."}]}, "developer_name": "ExoElement Games", "developer_privacy_policy_url": "https://exoelement.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ExoElement Games", "support_website_url": null, "website_url": "https://bsky.app/profile/projectcoreward.bsky.social", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "
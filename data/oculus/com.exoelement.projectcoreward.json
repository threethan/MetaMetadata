LfTUd-tsprtzLJTur2AO5OjydFjXVvRiDq6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7O1wOElP7BFL5WiGonbJlBkAX5byTsyQdGqWbrULsCg&oe=6ADF4FF9"}, {"file_name": "vlcsnap-2026-01-12-11h10m23s722.png", "id": "1943546789921711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507840145_1943546793255044_4083081591763992187_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=outcPNCvsJwQ7kNvwFmyyfo&_nc_oc=Adp1SPDCdKBQ1n0KDvSiibv8aYcBMiNx4Q6jsQXbj6d2ti9EE9LjhLuSjIPKlruN_OE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPiqRW_hNcILwESSVQrZIaM72_V29t2lLEDuF5VzSSaA&oe=6ADF5F3C"}, {"file_name": "vlcsnap-2026-01-12-11h13m07s147.png", "id": "803285356056536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827282_803285362723202_4794929601734141234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfgT74gZaZ8Q7kNvwGhTiy7&_nc_oc=Adrv_pCD9ntWsxxtHS-8LLzG1OdoqBegYaNsMNlU-MWMyiJdOYH8snvVzAev35LC3J0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxhlH8nO9MgW7eAOpsryBCpQWgEDpylTfjBRRGxODAcQ&oe=6ADF52A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta-Store-Thumb.png", "id": "889474943492921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_889474946826254_2907860162104322595_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6ym-jj27fEQ7kNvwHRW67W&_nc_oc=Adrhk2aCFsocUC4JX1n6knGvcgLQmOI-LAIDeR2cXsxlgCJhRZsAgWY2VsO0AvTpcBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh92zvTffKzwzvRr1haJjgT4Oo5CguJgPwNMGS33Jk0A&oe=6ADF53C9"}, "display_name": "Project Coreward", "keywords": [], "long_description": "# An Entire Galaxy To Explore!\n\nAssemble a starship. Create a diverse crew. Their mission? To see what's out there. **To survive.** If you make it, you will discover **ancient choices** that now weigh darkly on the fate of thousands of worlds. \n\n{1374932187060454}\n# Each World Is Yours To Discover!\n\nGlide your ship through the stars in every dimension. Walk the surface of giant planets. Fortify your vessel at Starbase and prepare its crew! Engage in diplomacy (**or combat!**) and make friends or foes. If you persevere, you'll discover the troubling nature of choice and consequence in this rich story driven adventure.\n{2020015205444268}\n\n# Features:\n- Open galaxy with thousands of solar systems filled with enormous walk-able planets.\n- 7 space faring races with unique cultures and personalities.\n- An engaging capital ship combat system.\n- Rich diplomacy and dialog.\n- Ship upgrades, crew configuration and training. \n- Collectable artifacts to enhance your ship and its crew.\n- A deep sci-fi story line.\n\nProject Coreward is the work of a sole developer.\n", "short_description": "Embark on an open world journey across the stars while encountering foes, friends and forgotten stories. Build your ship. Recruit and train your crew. Most of all, explore and confront the unknown to reveal the true, vast nature of choice and consequence."}]}, "developer_name": "ExoElement Games", "developer_privacy_policy_url": "https://exoelement.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ExoElement Games", "support_website_url": null, "website_url": "https://bsky.app/profile/projectcoreward.bsky.social", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
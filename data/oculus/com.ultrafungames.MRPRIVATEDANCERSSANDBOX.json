id=6e7a0a&_nc_ohc=Kk5kvEvNfjwQ7kNvwFP4ZML&_nc_oc=Ado82RbA-IwtN17O259D9SgwwSQA8PQ-4tGzv8o8UwXz5x3xF-JWYxARJ2pKeqNdqBk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZMi7U8trmYxcVEI3iZAaaRO3sywZfsCdQD2ilB8L2tQ&oe=6AFB27A2"}, {"file_name": "resized_2560_1440_20240216-204358.png", "id": "371624532487223", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75356792_371624535820556_4823714406990151821_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bikm_l3A8gEQ7kNvwGV5ApS&_nc_oc=AdodWVMKvBPyDMEOBB7yA-MPOmHkU-PHKrRx2qwLCweTPNKkzh--MYbDat_EgTQsXMQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6Yd3-RPHg2XZW7WBMrnbm_HhPLB0lu8ZHQDdpUCpQPw&oe=6AFB1603"}, {"file_name": "final_resized_image.png", "id": "416466157569542", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031516_416466164236208_8729559455506838917_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvFVtKADwJ0Q7kNvwEEiWxx&_nc_oc=Ado47wRXrpweiTlACuRxQmnIcmDSK2JM0-ib823mz8AfHJXs4Ta3rXZY8qQj3HOerMg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeQy9k1kHGCRJlk8zERuamRKzePX4v0fi4K4soCoNvOg&oe=6AFB48D5"}, {"file_name": "final_resized_image_new.png", "id": "727340646192847", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035366_727340649526180_231511919205402213_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scj5S8dYl1kQ7kNvwGo6pBZ&_nc_oc=AdoBHnGtT6QF4yCTXPhKlPkMXg4QFca5St7dFijluyouFnRBNWfFWHlUUC8oh4jxdWQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5QRm5_G3fFZa1C3-pvKlYLj8xa-Y9g1j7tXtO6aimhg&oe=6AFB4027"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mr_private_dancers_sandbox_16_9.png", "id": "1743368152819158", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75542968_1743368156152491_2259180645276742729_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfkqO7ZTC9sQ7kNvwH4Csdz&_nc_oc=AdoRb0DwQ0mSU3j02dL_U8-ezTcMekj-h9cgUe8d2d9vDv13FrP16tMNJsnbA2b651Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrDaT5__IKgSDg0kEW5ONnVaO4sD1rdXUwlZBzdRemWw&oe=6AFB223E"}, "display_name": "MR PRIVATE DANCERS SANDBOX", "keywords": [], "long_description": "You are the director, customize the stage and dancers and film a video wherever you want: in your living room, in your favorite part of the city, in a park or make them small enough to fit on your desk! The hand tracking allows you dance and interact with the dancers and the buttons freely.\n\nFlexibility is key in MR PRIVATE DANCERS SANDBOX. Adjust the size and position of your dancers to fit your space, choreograph their routines, and select from a vast array of tracks to orchestrate the perfect performance. But the interactivity doesn't stop with the dancers.\n\nFeatures of MR PRIVATE DANCERS SANDBOX include:\n\nLifelike Dancers: Choose from a range of realistic dancers with distinct styles.\n\nInteractive Play: Scale, move, and physically interact with dancers in your space.\n\nMusic and Choreography: An extensive music library for custom performances. We have songs of different genres: Tech House, Hip Hop, Phonk, Salsa, Arabic Bellydance\n\nAdvanced Handtracking: Realistic touch interaction for a deeper immersive experience.\n\nPlayful Elements: Use grenades of confetti, floating stars, and fireworks for added fun.\n\nStage Customization: Design the stage with adjustable lighting and effects.\n\nMixed Reality Experience: Seamlessly blend virtual content into your real-world environment.\n\nCreative Freedom: Choreograph, design, and direct your unique dance show.\n\nNEW SONGS AND MODELS COMING SOON\n\n", "short_description": "Dive into a mesmerizing mixed reality realm with \"MR PRIVATE DANCERS SANDBOX,\" a unique and immersive game crafted for the Meta Quest 3. This game redefines the boundaries of virtual and real worlds, delivering a sandbox experience enhanced by cutting-edge handtracking technology.\n\nYour living room is no longer just a room \u2013 it becomes a dynamic stage where reality and virtuality intertwine!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "ULTRA FUN GAMES", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7728817777153064"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1056335224118684"}, {"status": "PUBLISHED", "id": "741412045667314"}, {"status": "PUBLISHED", "id": "1159999039459076"}, {"status": "PUBLISHED", "id": "1189411205801916"}]}, "baseline_offer": {"id": "1056335224118684"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792474080, "status": "PUBLISHED", "id": "1056335224118684"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8753815207986644", "version": "2.2.11"}, "id": "1193092931666822", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7694483433919832", "is_concept": false, "l
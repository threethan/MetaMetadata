MQ7kNvwH1bnGN&_nc_oc=Adrakg3kJpzrnW9MRvzjHlq3p3eoPqLoFEYn3boqnALlrocITPEc_4rL6R75OTy2hqc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdqoN5uoV8wvZv1yLvmaJfPcOPYORePWyJaLYSvxg7Ow&oe=6A7DC5B4"}, {"file_name": "printScreen02.png", "id": "1561185678358937", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830613_1561185681692270_3592566516450642746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dS0NhMtvpI8Q7kNvwGuRsTn&_nc_oc=AdrDF_J5o3VQJNMOr18avYEEzyHMzjJXYEGghk8qsKI09V5MJIfIkQDu82vOpt2Jhg4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGorO6o56LMiQy27c5K89L0ofR2_uylSpAXNDLWMktG8g&oe=6A7DC882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 -big.png", "id": "25524669417217558", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499292329_25524669423884224_2708952386930278874_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05XvTr92iPwQ7kNvwFpw-wX&_nc_oc=Adrxvzy0OPVWCW7K8aRiSB9FGQ9m2yNioFJxXmv3GaEkPpF24X0lhmSHvoZNh9JBBHE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-K3q-Pm12yQHDg72zkW00pHdVpt3PlfFzmiDzh9JIog&oe=6A7DC192"}, "display_name": "The Climb Adventure", "keywords": ["climb", "adventure", "sport", "Simulation", "Adrenaline"], "long_description": "Step into a fully immersive virtual reality climbing experience where every movement matters. Using intuitive, hand-based controls, you physically grip rocks, vertical walls, and dangerous structures, feeling the tension, effort, and adrenaline of extreme heights like never before.\n\nEach climb is a true test of skill and focus. Every decision \u2014 where to grab, when to move, and how to position yourself \u2014 directly affects your success. One wrong move can be costly, and reaching the top demands precision, planning, and courage.\n\nExplore atmospheric, highly detailed environments, from breathtaking natural landscapes to imposing vertical challenges, all designed to maximize immersion in VR. As you progress, obstacles evolve, pushing players to constantly improve their technique.\n\nClimb efficiently to earn your place among the best. A global leaderboard system tracks top climbers, rewarding dedication and mastery.\n\nWhether you are a beginner or an experienced player, the game delivers challenge, progression, and a strong sense of accomplishment.\n\n- 5 distinct mountains: Alps, glacial regions, desert, beach, and volcanic crater\n- Achievement system and global leaderboard\n- Fragile rocks that can break when grabbed\n- Sharp, spiked rocks that injure the player\n- Skill-based rocks requiring precise button input to avoid crumbling\n- Bushes and natural obstacles integrated into climbs\n- Ziplines for fast traversal and strategic movement\n- Collect bird eggs at extreme heights", "short_description": "In a fully immersive virtual reality climbing experience, every movement is critical and every mistake has consequences. Use your own hands to grip towering rocks, walls, and massive structures, feeling the tension, effort, and adrenaline of extreme heights with every climb.\nFeaturing breathtaking environments and ever-evolving challenges, the game pushes you to confront your limits, demanding precision, focus, and courage to claim the summit.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-the-climb-adventure", "developer_terms_of_service_url": null, "publisher_name": "Codelab Studio", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
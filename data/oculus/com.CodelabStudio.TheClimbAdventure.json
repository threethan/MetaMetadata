hiIGm1clnjP7AkKK5KFiUDYjkW2DtoN1-hH0lYs0m4A&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9ZE2-n9RFvemzdnIF0uMlCvQLegX0-xFxjrvWhYd0Dw&oe=6A7DACC1"}, {"file_name": "printScreen06.png", "id": "1233933208799281", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499296069_1233933215465947_8525911828394144696_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do-Zg3FichMQ7kNvwH1bnGN&_nc_oc=Adrakg3kJpzrnW9MRvzjHlq3p3eoPqLoFEYn3boqnALlrocITPEc_4rL6R75OTy2hqc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdqoN5uoV8wvZv1yLvmaJfPcOPYORePWyJaLYSvxg7Ow&oe=6A7DC5B4"}, {"file_name": "printScreen02.png", "id": "1561185678358937", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830613_1561185681692270_3592566516450642746_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dS0NhMtvpI8Q7kNvwGuRsTn&_nc_oc=AdrDF_J5o3VQJNMOr18avYEEzyHMzjJXYEGghk8qsKI09V5MJIfIkQDu82vOpt2Jhg4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGorO6o56LMiQy27c5K89L0ofR2_uylSpAXNDLWMktG8g&oe=6A7DC882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 -big.png", "id": "25524669417217558", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499292329_25524669423884224_2708952386930278874_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05XvTr92iPwQ7kNvwFpw-wX&_nc_oc=Adrxvzy0OPVWCW7K8aRiSB9FGQ9m2yNioFJxXmv3GaEkPpF24X0lhmSHvoZNh9JBBHE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-K3q-Pm12yQHDg72zkW00pHdVpt3PlfFzmiDzh9JIog&oe=6A7DC192"}, "display_name": "The Climb Adventure", "keywords": ["Climb", "Fitness", "Sport", "Workout", "TheClimb"], "long_description": "The Climb Adventure is a fun VR climbing adventure game designed for casual players and families who want to experience the thrill of heights in virtual reality. \n\nCompete with players around the world and prove your skills on the global leaderboard.\n\n\nFeatures:\n\u2022 5 unique mountains: Alps, glaciers, desert, beach, and volcanic crater\n\u2022 Arcade-style VR climbing gameplay\n{999316089109681}\n\n\n\u2022 Global leaderboard and achievements\n\u2022 Fragile and dangerous rocks that challenge your timing\n{1647147796510520}\n\n\u2022 Slippery and dusty rocks.\n{4478776632376793}\n\n\u2022 Natural obstacles like bushes and terrain hazards\n{969088469333344}\n\n\u2022 Ziplines for fast and strategic movement\n{2210107423175057}\n\n\u2022 Hidden collectibles like bird eggs at extreme heights\n\nClimb higher, improve your skills, and become one of the best VR climbers.\n", "short_description": "The Climb Adventure is a VR climbing game where you scale mountains using your hands in a fun arcade-style experience. Perfect for casual VR players and families who enjoy adventure and heights. Climb rocks, walls, and huge structures while exploring mountains like the Alps, desert, glaciers, beach, and volcano. Avoid dangerous rocks, use ziplines, collect hidden items, and compete on global leaderboards in this immersive VR climbing adventure.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-the-climb-adventure", "developer_terms_of_service_url": null, "publisher_name": "Codelab Studio", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supp
oe=6ADE0311"}, {"file_name": "8.png", "id": "1724910114865901", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822800_1724910118199234_1094638956491358037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nIaDObmnjkQ7kNvwGWocg0&_nc_oc=AdoCOt8XCItlpv0-_AEnPMktpLEyvn7-QdD8UPmKeo8F8rmmhQLKaufngdnzv5pmFSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO86ZcwmRiEUg40ShAvF-fIl3n3x3OELPOSk10uN63uFw&oe=6ADE221E"}, {"file_name": "9.png", "id": "1461557785865203", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819396_1461557789198536_3086123014396940536_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OawZmXCGpuYQ7kNvwFxk0ND&_nc_oc=AdoZeLF4IUptRAIZObzrHqSJAHTAYdXwVGJIIW8gjND9TwiMjRIU8dRhwl1EcZ-cDs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2bRVIDZC1f-oREWmxqaMXnKkHg09JqRPIl-ZrGhlPSQ&oe=6ADE2AA9"}, {"file_name": "10.png", "id": "1382683790138981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822924_1382683793472314_145455803740228847_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDe4G85s52YQ7kNvwH0os2j&_nc_oc=AdqwHyRwcxN4ZDVH6Yy4OYgHiLi0TQJ_6fnAfw38tlDdX9Bxt0uG1UpfxxRuXf404Ac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI7iDZdlrFnMsVpr91ouwcEFKmQRq1JF1hVHbly_xn5g&oe=6ADDFC6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Trailer Cover Image.png", "id": "810969235348970", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307326_810969238682303_5042800535123434904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A50jgMGKrqsQ7kNvwHx9zyT&_nc_oc=AdqgZIWMcVVMqV3sG_kkhXJQqjkSUfDJZmmv4IL3ynQwEhNn8jwcrZKoJ72tRYRZP_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP75siy6BMtSk09DT5hlVBWJch_-FSPOFJxX242sfP4ng&oe=6ADE2B3B"}, "display_name": "Ramp Simulator: Belt Loader Training", "keywords": [], "long_description": "*** Now with Moza Racing R3/R5 (Wheel and Pedals) Support ***\n\nPremier VR training for safe and efficient belt loader use on the airport ramp!\n\nBelt loaders are essential ground support equipment for loading and unloading baggage and cargo, but improper operation risks aircraft damage, injuries, and delays. This Meta Quest app delivers comprehensive, hands-on training in a virtual, zero-risk environment.\n\nFamiliarization Mode \u2014 Get acquainted with belt loader components, controls (steering, conveyor control, height adjustment, brakes, emergency stops), and basic functions through guided interactive tours and realistic simulations.\n\nInspection Training \u2014 Learn and practice thorough pre-operation and daily safety inspections: walkarounds for FOD, belt condition, tires, fluids, lights, horn, brakes, safety rails, and more. Learn based on industry standards to spot issues before they become hazards.\n\nOperation Training \u2014 Focus on critical positioning skills: approach aircraft safely at controlled speeds, align precisely with cargo doors, adjust conveyor height, maintain safe gaps, use creep mode, and execute without collisions or damage. \n\nPerfect For \u2014 New ramp agents, recurrent training, ground handling companies, aviation schools, safety programs, and anyone seeking airside GSE certification or improved proficiency.\n\nSafe. Cost-effective. Highly repeatable. Cut training risks, boost compliance, and enhance ramp efficiency with engaging VR practice.\n", "short_description": "Ramp Simulator: Belt Loader Training\nMaster safe belt loader operations in immersive VR! Explore familiarization, conduct detailed pre-use inspections, and practice precise positioning for aircraft loading/unloading. Using Quest controls and tracking, get scored on accuracy and safety. Ideal for ramp agents, ground handlers, aviation trainees & safety teams. Risk-free, repeatable training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.netedgevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.netedgevr.com/terms", "publisher_name": "Net Edge VR", "support_website_url": "https://www.netedgevr.com/contact", "website_url": "https://www.netedgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26263440303342470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304764_3522497297902328_3736514497171693544_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1R-FCB5pjoQ7kNvwE986BI&_nc_oc=AdoysPTu6HO5cM3Dh9xTByrZbEKcdOOso_InJAh6fd7T1tMtWqn4pCGX4vcvS-KswPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuXy_sLoXf3zxeTWav0zjIvoUvYxnHp4WGO0_ZfvdoEw&oe=6ADE05B4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ramp Simulator: Belt Loader Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1771602000, "lastRevision": {"nodes": [{"id": "5296558790457260", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5296558763790596", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platf
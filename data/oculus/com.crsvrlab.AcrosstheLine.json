5k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUHcBjlVpPVcAQMFMYq3J8XPRs2V16kZIS1iMhaCMXqw&oe=6A92CD6D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92Y4jZxCCnYQ7kNvwGHR8Eb&_nc_oc=Adq-tyesnqCRCSe0ngA24U-7d-CT0KkXuCORSxX-DES3Go_1YFcO4DnGf9Mg7pYJeUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwgrEsDQ6Hx-DwkASWGbeEkpnsqfI3tU4XmfwuxygN8Q&oe=6A92B7F7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASpVvXKBu04Q7kNvwHoN80v&_nc_oc=Adq3CrHF_dioLUSzLjuxFoFQ1ua5ewJhYi5s91C7_uGTbAG8pzWr2kvzlPD21TR0isw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECu04JAQZyYVCfuvx8IxRIp1WbLYQqIF05IA7Fai7ldg&oe=6A92B48E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QMZ8FS8hRkQ7kNvwG3jlXC&_nc_oc=Adp60DEwkXioL8k9ypJHUox09zzn0u6Ve2__ZMHHxgdcYoQ9dC4ISEXsd7QRNQiVA3g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ4OaxcnOF1sJYjmCvlDxt6BvW-bjKTbtMua8XFg_Blw&oe=6A92CE82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex61OBPBv5YQ7kNvwFFBtXm&_nc_oc=AdqJlCiOZeYrzaqKx2XJ0VSTBLULDS93QIh8mQl9vXS4_2cTbUC4zTqG8E966hUz5As&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZjx86GavTvviuMNDjovlbx5y5CQW3JpHOsKDLNS0n3w&oe=6A92ADA9"}, "is_concept": false, "is_
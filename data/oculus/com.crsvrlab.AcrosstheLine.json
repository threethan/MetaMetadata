os&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-4sOCpWLDc5PQ9vv17TwQ_oQA4ro-PtS4SYYgB-TwBw&oe=6A54D6ED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFMSJPLMr0UQ7kNvwEnBdTm&_nc_oc=AdpIP8aLP_FmG4ZIXAMh-9YPI4C9OyilmDt_0Sa0mXvdvytle-IcMnIucAEBHhNpYxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeZE1KJRYR8l17nPwNGM_U6MsWzXk768J5l0uB3ADZsg&oe=6A54F9B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kwm7k_rJ2nUQ7kNvwG65V62&_nc_oc=Adr5rv1w9F9PYkHF-hOzyoH5YWSTkQv0lUcqbwIJnF-T_sc6OarMD0qNj17NhpL4cMs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKznCfLDATqcCOXCU4MqZK_fBuxoSPGhrDGG3oDu05Ew&oe=6A54F64E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev5zMVk3zG0Q7kNvwEHQd8Z&_nc_oc=AdrLOLNerKBzdGpIvD0HEhBGnaEUkO9eFbmkN9CBLpH3HMaX4ZTS1Q4nPAOfNj7_AMA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIwiWuUcQ4a2FdIKKGuMfsy5emiMRNa5xaT1Hk-D6oQQ&oe=6A54D802"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjVyOHZmbdwQ7kNvwGbdiWv&_nc_oc=AdqEwn5GRsE7lCpvB0XHFs3iRXzJFqi-Ji0LZtcJTvey1hEu557ZOjKe3SXNZ8W9LRY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ5MeLqK34QqkXtPklr-6axOvvZeNir_LlLPg17_VcrA&oe=6A54EF69"}, "is_concept": false, "is_
3k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEjXsQ-_ScgjW7iCKxXiIVwG5VrjHv8JqUdTZDI_hlgQ&oe=6AAD63AD"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjFIVJhE0IoQ7kNvwE9V2Tx&_nc_oc=AdqML59cc5Z1szrVUtYEacNLjCk0dEv6xVaKEaMOJWNOYnCCNZ30fiEy-9iOVmJgGho&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZCpawQqcfjK3pKEzH-E_M2trxo6s3GOb1jXNfM2QtEA&oe=6AAD4E37"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Skt6eChbUgQ7kNvwEaoG-9&_nc_oc=AdpaTIQQju60AW1JV1jSt0o3dbHGBUoKOvK2GRSgW-8HyW4LOvHB6EXMOZ3QO1cORlQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFggr3G4k000-UxMMFlTuhHAYgbNrGUl-3IEM_MulcAA&oe=6AAD4ACE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4TlzcsVIp4Q7kNvwGEkw-Q&_nc_oc=AdpEJhwq90Twve8vYVsekoKXpwCZThO2vrFlGrE3JMpl5NPzR9Mfn9IHWBuRAHc9rIc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2dZXzb80nZW09-T7m_NAE8MSTzmaiUWn4a3sR74lvmg&oe=6AAD2C82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4d9fKxNjtEQ7kNvwH-Brh2&_nc_oc=AdqqvYi5iSBoXeA58OWefOwHC41ESpcnZsI2jsFc2sWWWILZDVYcd284JRQpfwLd018&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZxp6dKthIRR7TmUQQmoh2qR6lQ8asUwZ4eC-Qo_sI4Q&oe=6AAD43E9"}, "is_concept": false, "is_
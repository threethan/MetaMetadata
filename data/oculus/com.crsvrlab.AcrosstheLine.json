uc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0qSdFKJ9N0rBov71aowDold52jnvxLrumRKTwl2GdnQ&oe=6A5CBFED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPO2TPSH8EEQ7kNvwH7AYe4&_nc_oc=AdrjB1bK9jwWReFPLP6Hzd3Ya1_hdHmBcf1Epg7Eu6BraycjwUm2tQoOI8Jw7qJo1KE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6Wrvmzrz_oGrm3dUS-kD7Iuxs6PHorLnESTK4CGfzWw&oe=6A5CE2B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgQJt2ov044Q7kNvwEh1WFS&_nc_oc=Adr9rAwzDn5x1jrg7ZxuiaMpjw8VqLuYxWfN_5cgxbE9kzk0cFlIq7XqEGSaFiye9qQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV0Z7VuciM7KeoTbsFR1ZLJTLRNb4pGpY2qtVoeMIsjQ&oe=6A5CDF4E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0tCbaUOsEQQ7kNvwEWcoL6&_nc_oc=Adp4XHLEzZvVeAnoC8eaf1jFxSergSTcRLLmBLuFwgd8ItTAutfqwwWTEd1_97NGp54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM6Yb-V7b_4HgGDpbWIdaXSuzrmVNB0ZDafDZH11yOJA&oe=6A5CC102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-2m3sBkMHMQ7kNvwEajH-H&_nc_oc=Adq_CS3jUbO9vJU3PQAjRLMtfRfgTE9twuKVjk9M3DOaj7Nm-JITngsWa0JO99S9Hac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL12a8ecfG-TUg2u0tPYcnclV0-EogejcoJi_t4GNhsQ&oe=6A5CD869"}, "is_concept": false, "is_
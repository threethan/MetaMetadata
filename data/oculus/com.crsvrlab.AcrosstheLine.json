g0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_xQ6U3XdKr6mRsNU5cnEKMc9LgaV63Sipfhjy4ELK-Q&oe=6A58CB6D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ulO_5VatYgQ7kNvwFad6VW&_nc_oc=AdotcblyUicfkoY5XV60jF6bPrRLoRGTQS6oOFxeia926VEi5u24mN__uztCmiDgOlA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjCyzp1ZX_aQiMz1iuXLLheFLHN2uqv7EC_YRUkvlzAg&oe=6A58EE37"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=By-hNHNNOmwQ7kNvwFZB1dO&_nc_oc=AdpTsDMkPGa0uXT5GT24B_92P-lI813VNz-mC7t2UYSNjNX8DWVAG-Vxw8M3H9ZJ9r4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcoAhDZu9X_sw1N_z3v2LaiAs5Wz6NdP1nNZLfSogEEg&oe=6A58EACE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr4gHNY-nacQ7kNvwHlkpzn&_nc_oc=AdpwsMU_OYrJJrFd9brE3-F86j0HDJr6lkMoDFhX0sSvyRWAgMAEVSDElnE2QpOuOp4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy_xV4zvLWNs5HGu8Na7G-szHniglhXCrFdmqEQZeP8g&oe=6A58CC82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxVC4uupMy4Q7kNvwFhsX0F&_nc_oc=AdqSm6JgQpFJL8tt02366AOvHLcUw6BsSp8Agx9YYDKd4UiUaoN3G0OZBUADyCshxvU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4O9gJNUzuaGqyurm97W5nwaTcJw0ZiHStPBz9NqXGVA&oe=6A58E3E9"}, "is_concept": false, "is_
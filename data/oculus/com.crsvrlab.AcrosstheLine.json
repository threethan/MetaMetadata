b0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k_BghDarDpk35nbm03C7-fH5Tuscuze2WuZ17WqaDWQ&oe=69D2526D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMweQCP3APoQ7kNvwHRC0-m&_nc_oc=AdoCF7bRV-58FWX2HVQ2dvAO2YXqVHa50nVbjt2YM79jmOxd6cY6lxe4j3AEQTw6g3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HqMA-HTk_n-IfVVcaqTeARa1jU1-RTFWjDXT3P-FDCw&oe=69D27537"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl2ZF29wiQwQ7kNvwHjrELI&_nc_oc=AdrMmcY9fYBpVF-ks1sCH-Wld4VDh91kgGjsBA2dP6Cs8Zyw_imMQFFm7kgKxaP4KtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_mR4OArDEvFRcYvJTYGPTFreOulnPlZl-zirjZrgLLw&oe=69D271CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKpLyN_g7fwQ7kNvwGniGcq&_nc_oc=AdotC0sIKh5N3sQUq0JO13N0i3t2_yuIb5DujIIBD5uvcQkJtyuy_shq7t3tTKUJi1E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06lQyYnr7wbiuhg_cgEb8rCjSfP56pwjIfVYq_QEgmfw&oe=69D25382"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1-tum3oM9YQ7kNvwG0y_9T&_nc_oc=Adr5-pHN9LgZRTY1s3EMbqc3zwMHErB1noLD0u9MwEZbt8sr1C4ZudvpK3XV-cwx7ks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iNeKJM060Jgr86ClFXneaVDgiLuMFS-Icki6Q3m4coA&oe=69D26AE9"}, "is_concept": false, "is_
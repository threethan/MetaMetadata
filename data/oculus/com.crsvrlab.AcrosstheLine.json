vc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lD4dxVgYAs8A_tQjh2ZgsO0Zqp6XwiiBlE3_oUpujXA&oe=69D4F56D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZkjOWAc8I4Q7kNvwF_vt7Y&_nc_oc=AdrYwC26DUsuYWZEmg51hM9eDJ8ArfJ8LC524z-qYR1plnkwIQ5m26KFKqbeeieEfsc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k-ZQjO2WmcV3NDs3EAUmYGDSYs1jgajt9id1KXNZaXQ&oe=69D51837"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl2ZF29wiQwQ7kNvwEvRrak&_nc_oc=AdqWbX-CS2MSJsEybYrFPzGWMkd9S-VMt7QDijlDsJ4i09ejyfrSXeydyd9MclrA9YM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cUsmR_9CWWkP5Q6jCg9d1htpDatles34vZiZsU8tNVA&oe=69D514CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJMR5dhuduwQ7kNvwF6T8yz&_nc_oc=Ado6Tzor5Va7HDyhcdYiws4_TrL5KmI7B7MZ4azvBgx-ZucF_2FsFgFxrbgqu7zu42I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wWj0d79b3KhgD2kIiGH8CUDG0FRnMC38aforPcVgLqA&oe=69D4F682"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1-tum3oM9YQ7kNvwGZEjsV&_nc_oc=Ado96_Qd4IS9iFIDcGe0_KV191jXB1Y05qtD6A9jWyhWovaLnhpynhw-6t_E4xvupT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gt8iQWAC4NPr6cKfEaArTmHf6H2qO1Vbja4OksetCEg&oe=69D50DE9"}, "is_concept": false, "is_
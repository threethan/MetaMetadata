nY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WI48SWt64yFkseXi063LaYSAn8MfC7cjw2icHbF4bww&oe=6A283C2D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB2kYjgZOgkQ7kNvwGKKVTE&_nc_oc=AdpMumomB9aFE75776o_97M-MMRz80BJh5Pnd84HG2zXsqxFAOtl97e9GQ3srLJRiTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b09vL24QyLWo1sz-fMx3_xwIL7FklRWhOXB-1ismEnA&oe=6A2826B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4M4MvAgZHAQ7kNvwG6X8Xh&_nc_oc=Adory83Fh113TUybkW4FmILvTCInHMuC70fYMKd6AmAOW00oT7xVO2JWBlZjFAmpHwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FYGTy4EqGrhz4-8yuTGun3rZr-jsIg5OmxIp6t5muSw&oe=6A28234E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai3CVou3foQQ7kNvwEaHz1i&_nc_oc=AdqjrhbFMbb2jsjrVrfPNHkK4-_JPSlsFdECy0dH6GaBwD6vadhYUJ2Umvgn4NqSiF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WlCrlx7qfNy7nUy319Te9eeFIZ8E4lDYzS49ANGNDtg&oe=6A280502"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrSkYGjyDCMQ7kNvwHhMuAD&_nc_oc=AdpC73pJRFfAnpIP9nwPS6iBgHNwGz5jhvyJnh5FXPX4z2WXQXN6P3OQ5CDmtB48QAw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XB3gOidIoNTJGFw4yIaE8s_dBZLNAfNWR4gCA5LymJQ&oe=6A281C69"}, "is_concept": false, "is_
-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCv0B_9maBdtRR9KBt47WtRzjrKEEYHZ4wmVhZhqqAaQ&oe=69AD686D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YE9a6F7PhMQ7kNvwGZ0PQ8&_nc_oc=AdkGQUqiAihzDMlZ1ndDdyv8aFwD5pDN31pb2_AvZ_-nD2Xk6mqEvv-ape5oFcrKsxE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWJzsQMvumNXo7AixRnbrzmWZXqdbuYbQn8i6upvJ04Q&oe=69AD52F7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir_YkIbNzkIQ7kNvwHP2VuL&_nc_oc=AdlKE_hEYGjsv6ZuyJBuLVA4xgR3px5x92PDCsOlN8XztTacZoEf-29R-a5qRcAH51c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaMnTorbetxo3aNfc5YKqJioGmnA346x-y3U_63WjQJg&oe=69AD87CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_SOPny2V8IQ7kNvwFHttIU&_nc_oc=AdmlRs-attNsLFz-L1wNxAsUrmQOylUdoqAd4uxgQ1V2QbBXLZcTzTQR6seCMJRgorU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrfKfnmSvZVEtP-gFaDI-NpUo8eyC5LMRvtWSJqmPf5A&oe=69AD6982"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7V7qx2Pjm4Q7kNvwGv3ss3&_nc_oc=AdlS-mretrU0En6IDL2S4WiFBEXd2g6b84VHyQy76NIl6_Rkteg_pI2gq9_Gk8uLSN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZFH61etLEkDef388YLSdNXJ9WaTd1mRArHA5Z0GLXOw&oe=69AD80E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
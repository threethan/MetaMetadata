kI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUuw0DOYSui3_zo9EqQGd6p8mRj7XWYkAX_2n_U_XlZw&oe=6A75CC6D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueOlTNjXgq4Q7kNvwFHsnNo&_nc_oc=Adof_M-8diKkzH6NnQQVcBzARIcRkmPLSiWNemlzf_LsnaaR2F5Y5i0R12yxY0FmH4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXgY5WkrOdHcLb-D9mvhqSlhglQSvcfA7UgTPM1ie9Tw&oe=6A75EF37"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A80cYYj2UWQQ7kNvwGXZhbN&_nc_oc=Adp2bSWTL125Zb8nX6v9fyd2Lq4L2T5wbPuRrn9HsMe9saG-neryg01JqzBekzESs2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ2bkOi1MEEcc169Bae6cuqzT6wwP9GYfJYhZHe8_Fpw&oe=6A75EBCE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNe8kO7E9X0Q7kNvwF3BWxX&_nc_oc=AdqpQjJD74s6kWDcDzKovq1mukA7baxpTanDPywJCg3NeKy7sIzWS4yzz3jubkV2uy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8nDgMEM4Iuxf-NMqAFvnifLUVn5p9wlMJtTw1Dyhvqw&oe=6A75CD82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgpGxfG6aqoQ7kNvwGToeQ9&_nc_oc=Adrn3YCeHTH4BD0Z29IgP0ifrfh61zgWXLy9FXH4i2095HXf2FMQSqX_xK1oq6z9nLw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAc7HQwm5UWK9aTNguOD70WXMeT-xMYQa64PQ1rnc-7w&oe=6A75E4E9"}, "is_concept": false, "is_
CA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElAd6InSFr7Tw2yz0_KE0l6yBmJk3efWNwP2kBl0_I7A&oe=6A771DED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueOlTNjXgq4Q7kNvwEyVPnb&_nc_oc=AdrRaVKSfrh95Uw89QPTl95WlmGWjxZhJTdX8ui2Grgp-O--1MKXYxqRuZw2jeB19Fc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnG__h_gs9d9Z-Om_RFfGW_6ErjvSIMaKwCpk4l_Dryw&oe=6A7740B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A80cYYj2UWQQ7kNvwEdrg1O&_nc_oc=AdpRi5KFBm3-1E9HMbMnd3TIANBBRW6BZAmHoPPiDn8XZN9ThobZCDYNOAXVgvun1sk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPAErQdXGexs8llz2M_M9BqAKj1SJK03QlKfQBBoTA8A&oe=6A773D4E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLlIKu1CMCAQ7kNvwGL8kG3&_nc_oc=Adq1-_IYEwcSsT8sXbzzPY0wqfbU2Pb6L85Lok0-OKkqZ-0oV9fus1hlKxhp4eqtDbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuiIQp1rGBcU47HgsoVVWeN_7AjWWeHgE1D_9wa9O9GQ&oe=6A771F02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgpGxfG6aqoQ7kNvwHdRUpW&_nc_oc=AdqpQlCjHSsM9qvXk4C4736Lb5EyLPHdXKDxlKfK4iuWhT5N2Dg52f4mO44oE7pLgiQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt2Whrv0yqQ8_vpynldQz2OYnxCj5CyJQrz0RP2GnWlg&oe=6A773669"}, "is_concept": false, "is_
6M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRmljv2iMk6d3bUm8Uhv2Yw2haOC5tp94svPunUUXZcw&oe=6A8AE46D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UHODrcDQJIQ7kNvwELGYQq&_nc_oc=AdqXe9zZWbxOXoFbz3Jf5Y2TzCyZu-V8008DGWGUJH37xGwnBf1hBiZFN-llmeYOQX8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyQEMVxdvBjf7Tdy6hqTp68lC5-DqLy7L0bA95dR422g&oe=6A8ACEF7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fwzOKKsWhcQ7kNvwEt6d8x&_nc_oc=Adogp3SiXhZdEu8WHmzgmuUkPIcXtLP3ikWoTWhdcwS7-bgwtGJ8oYWkmktftcsbFZU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPktYJ6zSM5XNenjK42uOdq6lmhWa5nCQxx6fFO7lEHw&oe=6A8ACB8E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HkXO4EhvZAQ7kNvwFiFmNJ&_nc_oc=AdolAKFCufYZ4K0qPrNC0XlWwSyFCke-STnm7yxELQld5XZzSesy2Rb0Gh0xiG695iI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzSjYle_J8WPf_wIuujq0GTHJ-e6LHFbM0Dek2pPy_Wg&oe=6A8AE582"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QMyfA0LCXoQ7kNvwFdS25n&_nc_oc=AdqaI1f_0nJHbVmm99GHnGBrPGmXZFMikZkj-vsZFKNVPzme4mogQ0qWoD9wXKw_xXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW4jlE6fpoJWy0tXC7iMtRHC6nMlOc7o1xNF7bV9Gkow&oe=6A8AC4A9"}, "is_concept": false, "is_
OA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fYkfe2Nqer2AyOwNiEzNcgJOy-2Q3PtqaTDQ7bvABWQ&oe=69EE01ED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LCou64mcHYQ7kNvwEr0CYo&_nc_oc=AdrT9WyB3oB5KOFT-I886hU3PcyAtJi8NcgzbHQ5aeL79gB9ckBEbg4ILi8PCQc87Kc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XtGfpi56KyEnSEL-z4UVUjJU5EbxE9K2GzK5JCflFkQ&oe=69EE24B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsaMa8S_nYQQ7kNvwHgDbYU&_nc_oc=AdqZxE6aIH-Z6bbaJ1piri93lXJABdO4AC8A8qVSZnSNRlZzzM_Un4pgcwjEBzJJszI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ftB87UnJaZFOJ4IKdqSJ-bSRHLaRT7gpd0sWNyOO-bw&oe=69EE214E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM9OrsUVsbYQ7kNvwGPny4C&_nc_oc=Adpaq_ed0y9qK3mmkKpW-bfPVT3omJh1CTIUMEuAQWutmpAd4VW_7U2043VlO2CIbSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b_2yqbwxivXNPgG-H4Bb1bYpGBHvpnClkV7w-oAU_cA&oe=69EE0302"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrbDV6EmpfoQ7kNvwHgTlQv&_nc_oc=Adoi4_T5Dp4l9NZZs3nGciWHiTk3xVc433VFVPOMPI5COqUlbYKR2DPfoXxMuu4Immk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28hFQ9Cfvjmcq1h9j5zO4Zw2hWdEoTfMnZH1tcwewQLg&oe=69EE1A69"}, "is_concept": false, "is_
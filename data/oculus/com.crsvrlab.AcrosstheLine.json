R0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8IqCQkErCh-T1qr4_JxqZ-5GJngIrF9xUHUWY7FPJnQ&oe=69C674ED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_p-Nev6cZQQ7kNvwEu2IUf&_nc_oc=AdqIjptKuo4AovKNHXeed077AkK7Hsmb_17rPpo8L7zNhOtr-AtoBMWGCPuYknfD6kw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_mmi5vICp6aHyxSPqwMzoGkUxqdm_ikKG31LeYJlQlQ&oe=69C697B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXoolPOjDSoQ7kNvwG90HA9&_nc_oc=AdqMrczDoOm4McEGP_O3uN8QKIf-2gXiGnA82g2FVuSjH8xPQBxVD5U3s2zBlcA6EVQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMI90Do7fDGsRZTqZu9pZ03r54YlhFE4d0hnHQ4eQv-A&oe=69C6944E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu6KJUv1TP4Q7kNvwGr2Krg&_nc_oc=AdpPshydRvo0sgj67rZL900Et0xjVQtXXp-JTZW0RvS72G4d-1fqSJ_Q0-B3gaOHH2U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4IPXof1vwu5c2cQx0Nz2vS_zCYbMoR3BYULSaEcS-Zw&oe=69C67602"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4whoDIOJUIIQ7kNvwEGd8JH&_nc_oc=Adqs9l7YW9nNKlxokfzk1B3BR0KJGjURZyHRKFAHsGjpjWs8g65DX15PWr7Fil6HqT8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzl8hlhDa3fGUw7WO5KAh2ap1OXQUwLeM1bcMzKhORkGw&oe=69C68D69"}, "is_concept": false, "is_
v4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6gVKGA5nnOq01tMjKEzFHlXj-hawFblWg15fsw8Q_eA&oe=69C7C66D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TERohRlgL0Q7kNvwFAzrXL&_nc_oc=Ado3cYN5Allpcv9nFYWPXI9FE1fYbpwlQdpflNQrUA_0BG1qYjp0J63HkMxpzhLjES8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiakssRXFCm26YECnNp1te8-cEWMXfahNAwdQYsIBhvg&oe=69C7B0F7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXoolPOjDSoQ7kNvwHQgMav&_nc_oc=AdpM1zTtKzrKT-TSabBXx_2CZ-d0Td_3q1M5nTe7fMZbkjEI6Lrge9dvNwXcH7ZG4So&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAnTF01UkdmCIeO-LBIR2haS0bIQKpFNiDKfCCncH35g&oe=69C7E5CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu6KJUv1TP4Q7kNvwEkQtnG&_nc_oc=Adq6LgYZTWcNyPj745fgsTVXy1OPzF4vXof6snEsesAqyFkp0EVhaqXt3-3yr9N67tk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQDsUrhBUPUFmhGqRP15y-tbmdUesgqCnfLXdYAUwTSQ&oe=69C7C782"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4whoDIOJUIIQ7kNvwGVK-E3&_nc_oc=Adpa96U_TdUXtAnz8afpDE5Okji7IerA6fgHHKfl2drgbtYAxtGgaH31RmZloljopPY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzN7uPt_otO6gFUvszCTd0EzgXro0g6HZ_FSj_T0vx4Pg&oe=69C7DEE9"}, "is_concept": false, "is_
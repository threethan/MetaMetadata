Q0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGXbaaaVu_BysCYvpuM7R6LorlZbFevtEmvqEwgNkbVg&oe=6A786F6D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueOlTNjXgq4Q7kNvwEND5Ma&_nc_oc=Ador1erNGrWKIk4liydaPtHbYNK1xKLMQTUidEgSDZz-2oQdiZG6x64yU2pOG1I-n6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeiOCXCC6wIhUJLXhbTQXxpTU0NuE-WFvtX_cPfF3kBw&oe=6A789237"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8dl1Cnqe3oQ7kNvwHC-dUL&_nc_oc=Adr66NE16QC8l5ZTr3pfipRIlSDPNGfJDfL65yAGaVZPHE-vRor7PH0HaH9AjKtrzKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdfIFF_T-9Xw3ZF-CxTuKkFuKO0Jtee8IHcQ2o4Qlz4Q&oe=6A788ECE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLlIKu1CMCAQ7kNvwGHmICD&_nc_oc=AdryOhmFrRcD_x9DwVgAHozxJ3cM8l2xFv9GdD2MuEY36XwTVfpz2qlTWnZL4ttBRXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTwtoBRamybs_azphiZWpLfm_0wjLPeOuqj8sBfkZ-SA&oe=6A787082"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jP75AiMK0aMQ7kNvwHdH6H6&_nc_oc=AdoBl4IArATo80Wi7dwObqtQyqDfH3TFP9-6oETjQVasiEkDSME44-l1DQjAb6VnR38&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLDk6PffOELUM5trduYj7Uo60vio0TjA6uAl6MBgsYqw&oe=6A7887E9"}, "is_concept": false, "is_
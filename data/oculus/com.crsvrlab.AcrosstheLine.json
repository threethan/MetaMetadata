d0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26t2dvpUOxK0AJB_znZP6fA1WTHpvZq7UVjrAElxuZqQ&oe=69F347ED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmQUSiFv2xMQ7kNvwHxLnsy&_nc_oc=AdqTwOo9S5lr8Plf9IbmfHrl8yYq7NjSk13XX-OuCjtyb334wq3V7TgMIpM8J9XC5kc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af158inKHVUSTE9GYcfluFM756taANj9zHyWXNEp-VJNHw&oe=69F36AB7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soPLTq0nRNEQ7kNvwHl-cpk&_nc_oc=Ado7WhEPdahnqPEfpfCbsbqV7c6PMPOzv6drcAOcwZmhKbFevClQwtbHCq2p9gsCuzk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Huf9BPlqKo6P15i-sGcS97XO8bMxiklzOUEu3_nz9CQ&oe=69F3674E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8RqChOD_KwQ7kNvwHBSRA8&_nc_oc=AdqG3lr1nmX4XHgdnz-zmz0CmxlEzEsBYL-ckr81gob5se3IVQTjt4Q7BJU-8-olJEA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QOs7QOZz7ueDZ_I9B4a-3aoAPwnoxUiya3KSSUqQMlg&oe=69F34902"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1DJa3-ycjYQ7kNvwG04pbV&_nc_oc=AdqgQA1uPMs4E242-HWrcnEjjGsT8oM6rrIe6fmqhzepXJqiNLqWsNgfS2dg0bfH6os&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FYdiuXXAN1Ewt9w5kIfqAHg9HgkBoKsofdq3e9N12Eg&oe=69F36069"}, "is_concept": false, "is_
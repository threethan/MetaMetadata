fM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TIHAJC7_V1RMe4N9rcJSZJ3MFuy8ogaNyTmlQ7XI44A&oe=6A1AD4ED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_89gQOJ98oQ7kNvwE2HLzc&_nc_oc=AdqycR5guDdhPAgeCbASmxRAqbb7hEc_wD0i1XuSqYvFxLGdSU6KbHrYF6Ia0-72FeA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yrtSG3phgyIKACat9YPHDpdQSlzbDHJ4Jh8n0src6pQ&oe=6A1AF7B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL8y0h6pWjEQ7kNvwFb3H_1&_nc_oc=Adpk7tutk8x8_XPaX1uudOl3MQLCGzuW5ubgFsVfnxlIk8LAzQPoSp8ulW4HFzovrZ0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cUovCuzc4b8fX20qs06h8wipnt8aU_Ikcgkuh2R-IAw&oe=6A1AF44E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNKDRZOX830Q7kNvwH2gYA1&_nc_oc=AdrgNGutYYSYbZSbzzWe3wMwlTE4h1iEtM7lUX2gHalTbqOoco1tmtIzgrUTnuEmjZ0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uKact2vJvvnV6eh4bdPSkTEpI90OR1h5ahaVhl_QjNw&oe=6A1AD602"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAOLXMu03gQQ7kNvwF32Dj_&_nc_oc=Adoqljf3sf2YyltLs2Du84NyyFVGtXDOFCbtBCVKYvhF9d7o0k9sy0zPxEA6f8gf0dc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55qKvqBpm2we6iT4CQlxwck_wLJablkDPFXVpGy_sBWQ&oe=6A1AED69"}, "is_concept": false, "is_
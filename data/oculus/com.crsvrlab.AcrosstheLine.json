nowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3tG0fjB31IQ7kNvwEtX2KZ&_nc_oc=AdqnMtM4yP1elrxs7OOlej_jRKRWEQovQ08FNsv7miLZSmS1Q0dwL9CF2XnEslla94w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PoeAn-mEB6Yp2_y5xehAwmps_gVsK9o8Sg_JFLQk3fA&oe=69DBA569"}, "is_concept": false, "is_
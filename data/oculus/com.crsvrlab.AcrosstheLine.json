-3.oculuscdn.com&_nc_ss=8&oh=00_Afzk11fqcM6Mppp-jNFlQfnKJgH8nX7rL6Eptg2_wkf5xA&oe=69B3FFED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8txPBUFsDRoQ7kNvwEIljy6&_nc_oc=Adkb6qlW-9CoT5DRYJ4nh0gz_V77Ndb2QrJsngs_tVJFKSEo1qfI_xEnY4epglXXVJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4EBcXapzE7jbOfFOsGtp5Fuw5M2fbjSFxGgcFo_faIA&oe=69B3EA77"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZJO1lOUdPwQ7kNvwGYZA8C&_nc_oc=AdniR55iasHBRy7f7gVAmRYkqHh7lMn3MwWxRFSy04Ij9mtiYRr6CQc1wwAtstNEWWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkLR9iOG99BZ0CnXl8Y_X6F0-eZIvXmRxDYoPd7CrN6w&oe=69B41F4E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2XeuUKorq8Q7kNvwHhAQBP&_nc_oc=AdkrQaFdSsaGRPvQFQfrcSr3NrvnHNWNwtw8LXwt2ZfgYEQw90hQ7egANpWHn1rHcRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOMaRbGMplrai_jpknOAsvcIuUGAiCvSQGWt2srj4jUw&oe=69B40102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FoAT74tTnEQ7kNvwEFX8LI&_nc_oc=Adkq2LJut7tti-A41qxD96reiKOVndxgJugazXUhGvH5m35-4lhMtAqgF0HDqYqI-kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzswm__6Tw03NRPc_ep1FulhycIL3FM5MFCmhk4YxqJ7A&oe=69B41869"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
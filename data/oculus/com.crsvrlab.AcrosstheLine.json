-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUKHgJQGBOm6gMhJtZ3PZL_XPYB935sBbn0KRy8HGwwQ&oe=69B6A2ED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8txPBUFsDRoQ7kNvwHFb5Lz&_nc_oc=AdmEKlRp7qj6SJQVhf9x9XRP-VOflAbiEQefimwfeq6fe_4C_srUyq_5s5RPtmK2Qmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6fE14fMrFSgHcCkHQ6XA8g_KgB-wj57G9EeuGm6paSg&oe=69B68D77"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a82T8ny1N2cQ7kNvwFfsxyH&_nc_oc=AdnFTIG0xtMXHXjfBR_OFA-MJeu_vQeOwlXC-iAd7XWcT5_jnB_tz6IfwqwW_IqszGk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGEf-_-f2coxTQsiNOlnQI79XwEaK9fszR5J-RpONgfQ&oe=69B6C24E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZhtjMXMugAQ7kNvwH-BzHG&_nc_oc=AdmJSxZgUx5VNojr3hwvRg-Yrd8LygaHlnBPS5BO4AgHRInVpm3YhmAIXwmlxAzeSjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAxZPBe9IFnzuajE-dYVHOrrN88EJ2HkLeDmwHaPJNuw&oe=69B6A402"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IkuA_4gzccQ7kNvwHoRqlC&_nc_oc=AdlMC9umVt7LuoXK7aknGHCo-8zdhSA2vt54EFbOGEpl0h3QuenUAN-4txhkvRI56iA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXKCFtW9-KngBak_cAB9qfBgcIiuwnyzfsi1-KTarn2w&oe=69B6BB69"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
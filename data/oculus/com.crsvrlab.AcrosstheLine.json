zM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tQv5mI7gV0LdpI8dnUaC_bRDYrqPMh_bMvpCxCGiKwg&oe=69D7986D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3i_m-3Na74Q7kNvwGOrREB&_nc_oc=AdqJ436qmcG4-fcXZPX74sAOdXsPkuZWUG5yZmbMxkyEOSaut3ol8DuIkNRp7GwM7GA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02CtRQCHHsAp8Bl6wVJu5-MMb_drg6AhGr-omVsp6EAg&oe=69D7BB37"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f6x4YnDDvUQ7kNvwEfBgq_&_nc_oc=AdqRxqHjyiccOMdpe0BZNRovRlJdx9DPba6KkvLu3D9rhdxammD77ymJ7anAFlNqxeA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07RQwK0fo5uOjeAV9cMiX_7pA5ID0n6VHwQsYsC7PYBA&oe=69D7B7CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJMR5dhuduwQ7kNvwEtvCzi&_nc_oc=AdpMu0-uhv_z27ik9Uxp1_MGhQT0FXIVH6AfqYCangjCRGOUgtuq3RBSNNlFzVGChHE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38ZrnT813oRiUiC1J1KZyaJLtau2FfH8ZMCozeLYULPg&oe=69D79982"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR55QybFRtIQ7kNvwGQ4qoG&_nc_oc=AdrSUCyau3P9MvDrYy6uRPr7Ho0equncdB34t6dJX8OUtc8imLanyda-HHH4UVz5QhY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33tTUZKNorwoCASYAJfIcK_HPuyslljwXNIwztQm-CWw&oe=69D7B0E9"}, "is_concept": false, "is_
-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiA4wRZMIuN-gQsCbXVVTLQAtwq7FIhQJ5_OoaJz2qmg&oe=69BE8BED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5863OLHU2MQ7kNvwFEZL8a&_nc_oc=AdloxnTt5mxz5y7oDP25F_5-LuN6j-m6NB6p2r0fwc0OO9c4QxlqRXncmLCfEB6oTRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfysCojCagvCnJqKMlfNM_Xm561vsm8r2LC_DmYHNZ3VlQ&oe=69BE7677"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3XLs8IwhVEQ7kNvwFqSuTG&_nc_oc=Adl_s6UQdgxRSS2TRZezanjl0bN987Y1fD58l3sBb0prXYtXO1GHn2f6rr-pUHz94js&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqVkAMkymCgRGp8uwSGctY5Lmh1vCmVmqAcR6tybDuIw&oe=69BEAB4E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcKC9AjPyHoQ7kNvwEVc2rY&_nc_oc=AdlWgdt0hh_doAtwtc2dL14Nv_i5bCNihVRYhtlrAv3v9_-IC4XaJRUM1ZZN3oVjzFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzngAlOGNRkKN8CzWsCQLoQUT4tLAL8INy25cS5-LZ4rA&oe=69BE8D02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OASxrVDc6S4Q7kNvwG5j55L&_nc_oc=AdmkqUo-6S-7cD0tPhqL8wTJfK7Rw0dk6oKzo1k5-LX0l5hnDZ7vqEGj9qfutW-1h6s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU8LBGiB46j-5BzP5nF2pd9iTAdOggGdy9DggawUg5jg&oe=69BEA469"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
EQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K89HICxGHTEjSXpn4ZbawmvpCKYZgve5gLyixfZLfzw&oe=69D3A3ED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZkjOWAc8I4Q7kNvwEFSxQR&_nc_oc=AdqAi2mPFcF_fUbwTw72WC6dEy4x9Mn4z4jGXZwIG8I0WvFhRQtkgBDrqKrARTIM0-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qOCdfUo_ghe_i1lMTB78VEvQ14Pog6ccD7Ur9b0F-Hw&oe=69D3C6B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl2ZF29wiQwQ7kNvwENrzaD&_nc_oc=AdoSGra0BKB1FmxiXXIqmiuaBTDEbOE1KXeNtznMqgtLEq892BuBPqNFLSycL8iiQ5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1osrnUs9eFK_WSk-CAL4mOeDVNddQvyxcTsM4zxjHIxA&oe=69D3C34E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKpLyN_g7fwQ7kNvwE2_q-K&_nc_oc=AdpQOp_ms6YzgpRer7auWMnBT_8T0-Og0xWBW_jY71TaaWfE-ZOqZts7M-YCJkUMlUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xM3ynP76KMOHtoznBvXsY9Onh6ebf21gc2sneePKF4g&oe=69D3A502"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1-tum3oM9YQ7kNvwG4BkYU&_nc_oc=AdrChFcKgoKAyFy-l6rA6pfl0FWFL15QJ9xr2FnIZlMmVIZnd2ADnODI_2WLZfXa-KU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1emq56_3paD60eCJyh0CEIdpLIEWS8L0V7OMIpHFW_Sw&oe=69D3BC69"}, "is_concept": false, "is_
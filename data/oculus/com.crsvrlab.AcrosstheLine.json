sQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A4Rww1E0ehdNaftTwIs4hh0yQmCMo-7kmChBZ5xqNwg&oe=69DE2FED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9ctVLsFjcMQ7kNvwEWMiEs&_nc_oc=Ado7fbFjBPOqpHwmyNX3kg7vSWy5EBO7u7gY7Oli0Bc-Ne4w_ZMJkPoJ0pU2JnrFuhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QgkyBJgca1GMpYyuKEuB3hiCPFkM6VpfT0I58JbpXFw&oe=69DE52B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_eVfqis45AQ7kNvwGAmGpT&_nc_oc=AdpWRYuq0fCNooMUVb49e6vUN3bnv-9PCN2X6PNbg5ESA_uNR2JT-aVaFcYrekZTXKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iiGQkE7ZYW4c3idV-fgnvCAHcX6wrBSHQqZbNPJHJlQ&oe=69DE4F4E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QG7MIbdp88Q7kNvwGCPDJq&_nc_oc=AdprQtpD-dEPPpnHOKFD0m0GRH0i5AZSaSf42p6EoMXH1hkurUkpx1Hum2oEN8ouzG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aDOdkDrAkvRSp6XrA12Tc0akILUWZ9FaK5BEGSoctXA&oe=69DE3102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2179iNqFTsQ7kNvwFW4Qu1&_nc_oc=Adq_mq6csDYpo5h5pDrnQnmkinP8XMv9FkQmxA7XMViltR6dZ9AuMqG5TY9K4WTma30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IDjwIk95GFH56Bjyldcgyiu7C0WJuPBFWbRTAGe1B6A&oe=69DE4869"}, "is_concept": false, "is_
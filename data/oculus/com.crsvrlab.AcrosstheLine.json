_w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD61VUuYGYVXueWDIKu9wbpZV6RUakmQBSZWw9TeIsYeQ&oe=6A4E3F6D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_ON4SIgHwcQ7kNvwHRog8p&_nc_oc=AdritDQh3lgPxqZn1wqWgXaroT0nS9AszO1GVStwn9fsDHr_62tiva0Vjcmd8eKONU4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGlidQ4Bw-sL99gcGB6z6aG5lfxAi5GZ1OYX3dTuE9ng&oe=6A4E6237"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnxzdLWw86EQ7kNvwG1c4E3&_nc_oc=Adp5rIuBvKa4noO4cGd8h5ji2qAwrFZBrJ6JiYLBfMh0nSibtytakja6ZUZpjD7hrU0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpAlMx-ZJBiw2_GYMTKREO1vN_FtV2atTKFi4f4xKUdg&oe=6A4E5ECE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9EV8APLq6IQ7kNvwG3PyEz&_nc_oc=AdrTJTvTlR3b_qNlTWpBEqq6otF0VHLwiazd6sd8KROOgjBzrxYXHfXXSs0a_-v_2mk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFCQIuiIpjlYR0HYVNrrVyhZU16bHXyEbLS1DCaaTB7w&oe=6A4E4082"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1Ns3_Z8MY4Q7kNvwGNYfGY&_nc_oc=AdpHqaVrsDtp8yllOHYlTxhr-dvd6_EPqDR4zXdlJvr38OQeD2qBzh9onSKnVPc8PcU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6-dNHetsWdlrpmdYokSlYD9m3-qCOikoLkOBz0AYo5w&oe=6A4E57E9"}, "is_concept": false, "is_
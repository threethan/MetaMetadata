sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhunewZD1gpntnmpxy4m9YageS45eJsOPYGj6h8fg04w&oe=69AAC56D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZDPTy755gAQ7kNvwGOkaxP&_nc_oc=AdkFcFGy7-QRsPf3g21uTikssQMrOaZl8ONntMTqkI481nc-Ev5AsHCDPM3Zyq6M19o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeuGNoH8Q_wW12xvzjOgJRBLNpsLRXv65nuwyw2qrWsw&oe=69AAAFF7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir_YkIbNzkIQ7kNvwFCM9Ck&_nc_oc=AdnIUT2_Ko-sXnLW1531iUAbpzli1vVca8pd9123DjDXf2jz1rYQu8PH_B6TmfnVHkI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJ5nkiCvA8JEmuf-S9ZlEQ8MnrtpVFLGTMp2BFha_EOA&oe=69AAE4CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGGcfk8KIccQ7kNvwG5myyL&_nc_oc=Adl74leIJ461tuzOKqFRl2joNyMJJ4em7Nru_7U5Atu3FqBS8IX6nimCwMY0X7KNioI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXpXVv09qvn30aefyXMxmiXqKppQyMo3t2xaUArJRBYA&oe=69AAC682"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7V7qx2Pjm4Q7kNvwH6yuZD&_nc_oc=AdkdD4-Vl1GngbmZQAtcAG6fTkRhi9htZOAVI24cQwjQ0ENSUCM6J6iKwwuh157n9c0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afxn-OMqvqo0Eqd6VilqA676e0pINrdR1-dDopXsM_Thfg&oe=69AADDE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fals
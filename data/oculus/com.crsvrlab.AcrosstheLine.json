-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZt2ysZh946v3IVrjzkEoD8Hrw5Po2CD8ro-QI_N4Njg&oe=69B7F46D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHBtx8fo5c0Q7kNvwHKk8IU&_nc_oc=AdkQamzGzX7gq0hV861rUcCkQSzqnlaOI8K6g_lhYiFRLOt2pvLxsHdseyYRUdjb_Dc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlnvBM-PC9JmsiuQDORCvHUKq6s44tL6uM5XbqoOKMOA&oe=69B7DEF7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a82T8ny1N2cQ7kNvwFwKgvM&_nc_oc=AdkWz2dBgzqOozbQS0CPdPEmBrBI7_G9IPKOVumiKpSVJJvMmASMIJoPFtLmjUgIFas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2gniBlRNu-K23rmkCPcWflk0EcucYqjvFYXDakhJGgQ&oe=69B813CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZhtjMXMugAQ7kNvwGfvzbL&_nc_oc=AdmxgdXSOZ0MS9YGrWfO3X0bW5OZ7ZBqCr14DRf0S4a_iy9hZpchRneSq-RUh6a_xmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1yVBnf2MKw_ifBZ22i3yscPMz2l9bZxQME8VNu99F_w&oe=69B7F582"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IkuA_4gzccQ7kNvwEyfbTR&_nc_oc=AdnjtutSUndNghjFsf_3W_NjtmTyi8f5DTBKn7T5I6PdEXvR0Glc0zoeMyhaCI_zUgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyG2A6XyREzEea42FytiD5E46evvgvopja2qDCE1C7sCg&oe=69B80CE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
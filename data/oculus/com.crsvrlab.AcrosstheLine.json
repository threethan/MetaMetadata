qo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VQHFlfphVjc6pJ8o8IDGHIhf8MEO5AsSKPKkeMnGQDg&oe=6A0B02ED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSRs3T6ij0QQ7kNvwEOIyHS&_nc_oc=AdqdUqyS8rSfaeHqITXDhLPUsQ82CMznblTwN69rxpqbh6MMRkDomG49jgU52id80J8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63qIW96wL4t7whrMwL9mGKzl_FWUTXXO_2QP70CSLKOg&oe=6A0B25B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkafEhMiCqMQ7kNvwEut77t&_nc_oc=AdqkQEDg_ozf16tjnzc7oVdXwXsBx7J_u60kKJaAqggZ2xTs0LLFFtY6FyuCrf-dmU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R8hcCiPTr4jzOxf3kZL98ocIA4EysBDWq_XxkSrHuGQ&oe=6A0B224E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYyyxEaCAWgQ7kNvwHfDgu4&_nc_oc=AdoEbCUXDnpl0muzSpXbg0sxCnHyV6iMX3EQwK4HvEVhbIKlYfn2LvitODjiEroBpOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JkfRnMcw3mQnq0H0P3Jv-L6f6PZNbMPfHoi__pc2PPA&oe=6A0B0402"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLaLJxIBYmYQ7kNvwHQjR7P&_nc_oc=AdowrQmpQA1LdUF7TkHpcCUdm_Vjx58U-jRCIwkq6oUqN-P-b18Qo435m3fhm5Ffs-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OCtQwU5p0tDK7wCvM3DGgO8lbCfFEGNNTTn-JUFz0hw&oe=6A0B1B69"}, "is_concept": false, "is_
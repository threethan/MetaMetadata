4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bBBu9AYTKa32t-y-N5lG12tY3iRBRUoI3lX3PgzcxbA&oe=6A085FED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGYlLVKSTMIQ7kNvwGN9Qx0&_nc_oc=AdoPLaYetM-9dUOnsg0j02P0I80dhl_P800ohXeLIIQbw1SWy8-Lk-tkqYW9FKIXanI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68HYXLsN0Jj-jTwRvNAJ5X9OtFMqwWLlHijKooq0dYyA&oe=6A0882B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pP0XNKtkzdUQ7kNvwG05iY9&_nc_oc=Adq4qnzeXlfvDfg5ht0kxtdGht6e2bzBQ0H3Lv9gcQA_WhrpdhL0fxqWaMZ7zgoj-xQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74N-lOI6V18bPeL6XEyMhv5oY7U7SRNb1UYPIzt41yeg&oe=6A087F4E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYyyxEaCAWgQ7kNvwEWBL15&_nc_oc=AdrKOA3EDtdJW-pWbFYDmdJW4mTPbIsK_vRDkzhValM3zqUtYMaU87GQfOKtxH6O-tw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5leKsGa-z08YWwaoO7Db6KqSraoMKpsbpny8ZtcI7ovw&oe=6A086102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RURtThTIn4AQ7kNvwGq4qgg&_nc_oc=AdrNooquWcQbidnlRIDrvILNPCmtx_z07kuZI-qFgOryib5VnXlacWmetAKW5CuPPH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v52iw5HG4jOcyFuLoyEiTNXHNJzHZDGFciez4acabQg&oe=6A087869"}, "is_concept": false, "is_
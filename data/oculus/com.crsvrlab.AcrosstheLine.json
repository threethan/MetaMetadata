-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA-ZVIRBBeKYidFlDvBgtbJruGclkOxv5i0ZJkku6A6g&oe=69BA976D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHBtx8fo5c0Q7kNvwEIioob&_nc_oc=AdkYaPSHh2zrUkFJ5BtiLJUqc3cDN88hME9xITKJ3zGSmkagqv2cZBS4aA1RXjm3vKk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyq5AjZjl4Te8KdeapamzRNe6LPASbJ0JdhDZfBDK1NWg&oe=69BA81F7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ASmCmpQMi8Q7kNvwFw-FDD&_nc_oc=AdmGks_22eDumuURKDPSa6FRSaFghM9bFcnx9IplwXgnee3x1lheg0WkPwdNkERCYH8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSz8__KsV6GooBAx9AsOWxhaRGwatbOrZyXkQ-omsETA&oe=69BAB6CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIDaYDN1hkAQ7kNvwGvU579&_nc_oc=AdkMauOjAOYaZ8yBYKB4Dy7fshQqo-w46TErHZlptqyUl1wfmVjpbla4EHDwsimi_lk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0L-9Jg1Nr_UgRkVnXfeIod1FVsWOfHExdvmoQlyQjrw&oe=69BA9882"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-5M5bsTm5kQ7kNvwE8J3jn&_nc_oc=Admm4NOsBYPH6vRFVtaaqxkv9u1UV0c0XSAJT5lV6dUOVU_L1bowPSQYXOKdwqM0K1E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS59W3XFrQIrxSeYfliCnQ4mx1F0dcIoMqaQYbJWg4-w&oe=69BAAFE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
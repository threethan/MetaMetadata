=699D966D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glxMDCoIvSgQ7kNvwHJrjys&_nc_oc=AdkiXMnnYL90uVK8lIltSbs8CIvaMmGLJ5-b9bR3wOEBt0ALNFdX0Z7JShWDxjzo86w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsy7t0aHz8NFOJG0fdcZlh3dq1TOXe-fFCppj-HE3P2Ww&oe=699D80F7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9afUn1BG0jIQ7kNvwFZdL84&_nc_oc=AdnoF7F93Uh0FEsE90bTTzRE_lIarVlkveJ7Kie2_EbVDyKXObqWmwEa7EcgOzwWb4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsewFhlsYZZbQkgvKqnVnWQfDPV_56gSpfxGzoEvRJSVw&oe=699DB5CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crNlPyEKEpEQ7kNvwHanDU8&_nc_oc=Adm-OmccE2zSDzVLDzw2_ZCSo5EK1Wmuglq5DoisTnkedNskbNwsPb-l2hgcl1ShRL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRNerI0FP2FkMINPUNDrAgttyxf2LQowSrnuQTHnU4ew&oe=699D9782"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh_qHr_34Q4Q7kNvwG8Bb2E&_nc_oc=AdmOwjPdwmRc9eERthGbExLX4-pJH7BXrcUpynrwwxuf3THA_0TW4KKQvtNHWEdvyc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv852zXiut4s66EKwLjdKt_Tag94c6O_-W8AWPfiL6mSg&oe=699DAEE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Across the Line", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 14
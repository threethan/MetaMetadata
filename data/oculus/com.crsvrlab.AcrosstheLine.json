dU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdXmppsaygzye5LbGj5Pi0A0QzmKmhTYVPvJG_8NSW8w&oe=6AD0FC2D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOOyT78dXaAQ7kNvwHTWRaA&_nc_oc=AdqUXMZiGNcrUekoBiz273CBFvs7KtnHm3_vYE479o8ENrm4cbfLYocwAHTlq1xTQMw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWpm5mz9Wej62Fj7mjM3t0TlQwptIndtNQquqo9qA0ug&oe=6AD0E6B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubPgAQ-FtBQQ7kNvwFHkcC0&_nc_oc=AdqSk_zM7y3ocD3H6Q430LwifeeVlGgCBO3V32PMv_8REkAbh0-T3drMc6W3YAYl0QE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv6oEAGjNLGAsW-vi3vO9wQkfHWeODSV_KMtdtflVwJw&oe=6AD0E34E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_6BMq5C_p0Q7kNvwH0kYVV&_nc_oc=AdqJuUN2Ske6CvZzAiX3oYjE4FHquLrd29NCWd8LW4wUNfge-DIYzetEZ7Zkegr2sQI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVz7fXwmoKf7VZntzDJ2-D6zwkt2_CsTMjEHyrn23iXw&oe=6AD0FD42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYh6NdaNbp4Q7kNvwHQRkpx&_nc_oc=AdqLq2UKWClvC8-MaDJPz8VJ0xFyb4pw56Q4iGzqqmxWqiKENqx6DMnuMbhXTSP1-EQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3sjmAqXyZu_OOZZXiYTjTQW_dp-aZvHqAX8Fj9Q-ehA&oe=6AD0DC69"}, "is_concept": false, "is_
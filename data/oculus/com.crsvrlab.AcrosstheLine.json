t4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqX4EmUYuUx5wDYl8wn6GrtNyNKcdJilxuJ3MTe4OsDw&oe=6A60B46D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZEAIl6d8_IQ7kNvwFiyYld&_nc_oc=AdoAeZIE41-tUCya6Fq7iKkF1LiJkATQ5qflDM8rPVOy56t6zfVoRmY9DrqjzD3XsZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWislx_DnL89baBKQ2ZjSlL1NabbgKbNxDEpDG2DuzJw&oe=6A60D737"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfJ9B-0bf1wQ7kNvwEgZcgb&_nc_oc=AdppBJzdS2zI3oCHENRHSeUzBF0Qr9GQT1PCmVB4YofZ8RHbTxS1P3VVLJ62fwsI5Zs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkcwCFTtqYIeTJMP0EK-sOrc3pyQSSHACxeXgUe5p6Rw&oe=6A60D3CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkLvJz4TPe4Q7kNvwFiHAtM&_nc_oc=Adr1ZLL9DauUKURCH4IRRP1UTrWhw4nwCo14pFzg9jTNEjgDUWG0JC78ZHITCmLg6Ak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcerv2kLtrvIkbxCiNk_cWPBAIfP3ccZ1JzkglTNp5cw&oe=6A60B582"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzk_N__wJbwQ7kNvwEG5GmF&_nc_oc=Adp-E32nEHHTFtIJJ0jabSDXZShUaobcD52a5N6zsg1sunOoGHYfd1C7B-Idw3Oc4ec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzaQsInagMD-82MqWkO9rotPcjZYNTcTK3gleGtVmMag&oe=6A60CCE9"}, "is_concept": false, "is_
zw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pvlpp9iClyruluI9l3HAzn_xM0UGvx5NXpsy7UUYvEQ&oe=6A4504ED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhrfVlxOM4gQ7kNvwGqX0F0&_nc_oc=AdrC4viIOlnUBlFZxFqMLJAlIIOXps2GXkioyyCB5nyyIe-_FptYN7LbrYiJ95fa2bc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I0s1ihfqGkY-VsF_iUCosXEsW32hTJYGXAh9JRmiSdw&oe=6A4527B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ6wCUcdccUQ7kNvwGE9nup&_nc_oc=Adrgoy-yogrfPqvKdbkFvhAyY7JTYYZ4QKMxtzkwQFJR8AtN-DBCqBew9Wqy34KeCmY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_YFP1IdP26MKgKabzuwyZ3HLeqQRjSh3rYxqgdn9MIw&oe=6A45244E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZiOwLh6zjUQ7kNvwFIVirY&_nc_oc=AdqyhjbPRJrPaf8dEJ0bPhNNfBOzlap8-NoTRUlvlJoqzmm_whF-caVSpIyDksvvBKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ADhDX6pEcN4LZOGWbKMZtYT8qFqoQ8Eou3cePSsnYjw&oe=6A450602"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yJgKtRBaoUQ7kNvwF0wYWM&_nc_oc=Adp35qiL0MwQlLkxYEqAJShRw0VILRgMcs1CPyFQ3PcRvLbrjFFxXV7Rmz-2R1S7Djw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h2S5uvh1WPd4HjfB2Jh1qJP9D5PZaToZeEDLpn9Z-gA&oe=6A451D69"}, "is_concept": false, "is_
O8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FRLuH1xB0K8qiDWSuqtancuJPna6PSj0dHqqInEwPAQ&oe=6A3D542D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXJ9lyc1DH8Q7kNvwFWWMmV&_nc_oc=AdreEScXuIQ3vGTRHx9e7U9WdIy14cy5IoVqWiSy0KgJm8zeyJFQBGabTtGzUI1an6M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aYUAnyKm8fWLfivVXEiwkjog530m96AV33u6Dh12rBw&oe=6A3D3EB7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owa0yNYLw5cQ7kNvwHuAxCk&_nc_oc=AdpE1doSMNud0sDYDmLo-_IZD32j66AuI9LUNZi8jzerBDk-R8FYWwg9CKxbJeP86hM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OPkBNDxJ6vVqbKidNqCvijKWIK8oqzPg6LqwxQfftDA&oe=6A3D3B4E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8ju7bdQKKEQ7kNvwG2_uNK&_nc_oc=AdrWZgQJwAkVVFsTKBELT9UldSbZiBkieHqt06Jt0USiYUDKvKxQfThT4U3rlcWhkVk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N2kj47TW2eVq88ZRRVsZ5dMOkuW4833tWTo4SvqmP3w&oe=6A3D5542"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOST4bIhDhsQ7kNvwEEX_w8&_nc_oc=AdrnzAa5527A3k8rHb-gtRgf-xeAklQ6tR9GUVY7snG4m9qrPUOgC64pwMN6csyHQTA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZoG7tdUmVUXlpBtOYIa-xdKn3VNZE3Z0_LHU7a66ojg&oe=6A3D3469"}, "is_concept": false, "is_
qA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxFERAvwMZ3dPAUBWTk8h63LEUVQOYcPbws7Jji6-TNg&oe=6AB2716D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Svkcgfd7gukQ7kNvwEQpKHE&_nc_oc=Adr1qgmrFkOpZ9VT6RpaLxj3Gm6sgkSzk0EYajcgNYZjHDnwyOCHqLCupOzjlCX2KQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISSrg2Kii3ZTeFDiYWlFI2ipmZHWF_brqrwCiaDUrHVg&oe=6AB29437"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4r-emuQu64Q7kNvwFhiECd&_nc_oc=AdozRZKneviyg8854FQhFAPK2UoyL7JuKgwo8EuRaxFKgO0wK1mhpJhDs0Dx555Si4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnJE4bri3GyQG3hdBAVu69rZiht93QtT-J8MGYSuFTvQ&oe=6AB290CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSiZZbIKToIQ7kNvwG0dfY4&_nc_oc=AdohoTgBlQmPS3QDplTfJT_zIZi9MxdPXCtFUYpIg0vPE4N7goCWm36XVjnD7axyJmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBRnaLPJRhB7PkqPRXDmlFb4Kt4j3dv_ij610Gisp9uA&oe=6AB27282"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERDifuoE69IQ7kNvwHAvKgp&_nc_oc=AdpPZi7ZhEEbuaIXfcJc33zMneXQf6XOq9XB8mi0SVcSOr9BspoutjMjX16J2AZrkZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6jgS-nv10KZepm2L--bkt8BmRGsH5V9k8wipLKMIH-Q&oe=6AB289E9"}, "is_concept": false, "is_
yQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjicX8qbMfAvOOqGY9m2aC7l_MxSOCRKTPAOud5AoP9w&oe=69CBBAED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRIMvJKVnpQQ7kNvwHMHE6J&_nc_oc=Adqte_ts146BxZTjv7ktbOqFho-3zQ05xbtdYqo-lFcHnTh-2qU9gfp8y2svte-18XU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afytia1IV5d8nUegD8q4rZnYd-XA1kxsjK_Y0x90hd9CcA&oe=69CBDDB7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ifv_raqXNoQ7kNvwEVJbFH&_nc_oc=AdqSm2IyeBfxad7jKzmkrWHlukd8tlu_zDBa4C5JowWZyPiqo_uwHV3yGJc6WXzioYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJw5OBZrGeSuNluYqTQDf4tScqKw-919oMHh9SG3V3Ew&oe=69CBDA4E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtT4oPPEzDwQ7kNvwGciSqg&_nc_oc=Adqeg4_UMzde2svJmIRfLNT81GmqP_1Ml8UZNSzni2nRI_IXsQ6-yU4afz-n-JGY9Dw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDg7hMdBnRwMi5mbBfn5jQCsNtDgUdfDeZ5fsU_rUAVQ&oe=69CBBC02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq6cVjjrCZIQ7kNvwFtHZKj&_nc_oc=AdqbycdoJIxBiWcfEHrbFnt10z1G0V5J-sDMox2MxJnKOlp6jto6kOYSChzhdMVsqzU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxA74B_OLzQQrqF3bvqWjyo2wD3XaaBqaB1eSRsaUfieA&oe=69CBD369"}, "is_concept": false, "is_
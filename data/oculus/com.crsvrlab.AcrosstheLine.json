-Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEYbYUuQE90LFgRlB9LzcEoctwUxD4s9AGqCh16Dz7dw&oe=6A86EFED"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvpkKIb6dKQQ7kNvwFLqCW9&_nc_oc=AdpTDp2BZDoGtvnn4TkX9VZipC0xAlAEPb0jqLL_94VEkJ9YmN3G-IodD5w7mMKEdt4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEORzJj8JnsYudZduuQCNKkelXIcZQJ02ZZ16NMGceD8A&oe=6A86DA77"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJT94HLL2AgQ7kNvwFZ7EqF&_nc_oc=AdqZPWYmxUotiAZkBdTPSYgDloMQ6CuevIU1GcWRtMny2gaDVFe6uXDY1-R4x6gfRik&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk8I1sxuhjC1-jQop38n_1yh37CiMs8Bz3fh03t95TNw&oe=6A86D70E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3KTVIwnDUgQ7kNvwGT4yzR&_nc_oc=Adp3JYE-qsEBosK7kNn1YK3nlKi-uP_vWEICW9iT4F3YvBgI4RUvGOBN3kBhWzqWWs8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHplRPY4dfArOW1bKDUM2POQ3QqLZZ7to2ekoWYHYgOxQ&oe=6A86F102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQnEJ-X20yYQ7kNvwFmDznY&_nc_oc=AdrxL56z8VsfUK61U-uzmfqvo6pAuYKjSEqFqAa4NmgcS1NnJsHQqpxLpI4qisWrS74&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6Tzs15ufUQXMoX1h1pZ7i0DsBOGV-dqhaokaKDRz0oA&oe=6A86D029"}, "is_concept": false, "is_
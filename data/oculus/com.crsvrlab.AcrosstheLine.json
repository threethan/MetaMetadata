rQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gn4SvSjGc-1IN5BEGebBqDjkN9fiRdd0vDzce0crbHg&oe=6A15C72D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki4lxJVynREQ7kNvwFEwe8G&_nc_oc=AdpkZhMTFmiIay7JuR7kLv1F1WeBmFiPf6uYMnXpWekXdgceAGZu39MO3Bp75-34X-c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46ul4IuBWWJVfw7vjfuW-zHaZk_WNXJiP3tdGTb4I7Vg&oe=6A15B1B7"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lclbswr6nSAQ7kNvwGXlV1o&_nc_oc=Adrm608Ts9D568ZhAI9L3MUyhmVRlUNtlajV1qoddKelddAu3jwO7ED7uQaV2WnCTjY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H7J3kfAH4cIA3HvRUU_5A-7cXWW-tu2f5d2nGb8XC9w&oe=6A15AE4E"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkrYxnp2KSUQ7kNvwGX90za&_nc_oc=AdrAWAD7LhgJPOiOyAm6UBlSOHLypSdVN2V0jw6TgBofVPk5V4IgNW-rVkaPfCsYLhQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7psl2mErdgpshC2BlnbQQqwCzDZLsjkgg7CijDd5Jx4Q&oe=6A15C842"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4Gvnp5B-_MQ7kNvwHMOvmE&_nc_oc=AdqmOcAfaL1bwefQVvOv-VljaK17UORO_jSBylqGGC2vuocVETDXlnJn_bIu3BcNUX8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b9Hm7lSAyjWNjNr5Q2q5dxHogYPx97ZlexEdU25XxGQ&oe=6A15A769"}, "is_concept": false, "is_
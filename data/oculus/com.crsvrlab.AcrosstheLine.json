gI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7ZT0p5vxFLh2QVV5Fv-XtnS14TNLLK0xk9FvMBP5mdQ&oe=6A65FA6D"}, {"file_name": "migrated_image.png", "id": "806807326477618", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138839_1056030301134227_1988297976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SeCfmQnR0IQ7kNvwE9o-od&_nc_oc=AdqGtgJpOMp3JBD3XH_5MbU4D_HsL78Pn0-66XXpaTiaBYz0I08LlpOM4V4Wuh-io4o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADP95VPW5OuWA4DZAzCOPh5iaZNdhxgFlgc0cBBku_Cg&oe=6A661D37"}, {"file_name": "migrated_image.png", "id": "535526123741937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138771_480189108838277_1716033509_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmsAThZjsY4Q7kNvwFo3qQV&_nc_oc=Adp92cAfyRiH4_vBuppWQTLOamX1xVO9IKN_R4V1cWlL2q1klCCWF3166wfgPnmC2x8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyztsNaEgRul1sAe21COoYzyIv4W9prg0Ed9Fhmmuwiw&oe=6A6619CE"}, {"file_name": "migrated_image.png", "id": "235716274139120", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138832_1681264532134441_366210493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF0wcKxA8tgQ7kNvwEnbQ3O&_nc_oc=Adpb4-_RAS-ysaEYpBSTY-R-6cqbYr-EtproNI2-dW_Z3to75M5Zzkl9Fp3-uUQHfP8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJm_Lb0-z8zAkJFDSJVRKqWgwULKmtlOJuqhlyursF5A&oe=6A65FB82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Across the Line", "keywords": ["Abortion", "PlannedParenthood", "Healthcare", "Harassment", "Prochoice"], "long_description": "Across the Line is an immersive virtual reality experience that puts the viewer in the shoes of someone who is trying to access a safe and legal abortion, offering a new and immersive experience that can help people better understand what thousands of women face when they seek health care. Using documentary footage and a collection real audio, viewers gain an intimate knowledge of the harassment and intimidation outside and compassion inside health centers across the country. Across the Line premiered at the 2016 Sundance Film Festival. Across the Line was co-produced by 371 Productions, Emblematic Group, and Custom Reality Services VR Lab. Planned Parenthood Federation of America served as an executive producer and consulted on the film\u2019s script.  For more information and behind the scenes information, visit AcrossTheLineVR.org.", "short_description": "A VR experience depicting the intimidation outside health centers in the US."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "developer_terms_of_service_url": "http://www.crsvrlab.com/across-the-line-privacy-policy", "publisher_name": "CRS / Emblematic Group / PPFA", "support_website_url": null, "website_url": "http://www.acrossthelinevr.com/#accessing-abortion-in-america", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "294346339251396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12449013_206312086417794_1143900806_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nhb3dwWBthcQ7kNvwGRHQ4Z&_nc_oc=Adr7SzqzYlOUYrH19U4ffQCkeG1S-f9ebMaBv-XOhE9AcCKtspj3GWqQUGKC6nbzF4A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe_yv-ZuHPbwQDptiVoyl1BDYofs_HyQ_55H3zxgO1eA&oe=6A6612E9"}, "is_concept": false, "is_
-25/38974704_214361106458973_8437851522330525696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8GvzCrZ6HEQ7kNvwGSjZXu&_nc_oc=Ado1p_6mAY2zed3AvjqcvQ854qzbliN8j6_TQNfHUfeG5H1AKf_xWollOV0WsSLMqF0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDcesxN66id-qX85F9a2iLUIe5juf4wLrEqsO4WvVhtw&oe=6AA3FB90"}, {"file_name": "l3Fi37.png", "id": "155720132369367", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974811_155720135702700_2579167280457842688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmktLcmcwjkQ7kNvwFSNFgX&_nc_oc=AdroNanyD2unDhCq1iD5jZ3gyKFxse9Uj4ZWMfu4b4ASpn1AHtXHzrlV8m-KJbpjYqM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfUqjhJHeaDVH6E8sNBTqjdD15Jkw4gbhpV4QNyPzoNQ&oe=6AA3F603"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moment", "keywords": ["meditation", "mindfulness", "nature", "3d", "calming"], "long_description": "At Reality Mint we recognize that daily routines have shifted and people are looking for new ways to manage their mental health. So we\u2019ve decided to release an early version of MOMENT, an immersive experience designed for mindfulness practice and meditation. \n\nAs our development team works to integrate additional features, we hope you are able to take this opportunity to enjoy some relaxing nature scenes and find your MOMENT.", "short_description": "Getting cabin fever? Step outside with MOMENT!\n \nWe at Reality Mint want to help everyone dealing with the stress of isolation and uncertainty during this pandemic, so we\u2019re releasing some scenes from our upcoming app MOMENT, a platform for mindfulness and meditation.\n \nSo if you\u2019re feeling you need an escape, please take a MOMENT on us to enjoy some relaxing nature scenes beautifully captured in stunning 8k 3d."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/51410546", "developer_terms_of_service_url": "https://www.iubenda.com/terms
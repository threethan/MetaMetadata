-25/38974704_214361106458973_8437851522330525696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL4g3k_1VKUQ7kNvwGku4Ja&_nc_oc=Adp8ws5XQ0_qbkT_-DIquBBm45JzSsRfDCA9mLKc2a4ZyvrzkWoz2t6VpHdJASSoisU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-iLHsAe9wLNZnaZKGoj9B7aElZsLQ6UXOi_Rt9tHC7Q&oe=6A466110"}, {"file_name": "l3Fi37.png", "id": "155720132369367", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974811_155720135702700_2579167280457842688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am8ImKTrD-MQ7kNvwEpAMlN&_nc_oc=AdqrOnLXNvVbCU4nTQwVVFCYXwtwN4IutFjory6prvf-o8a4ukT9oyCzpcN344KKI88&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XKvrGoCsTQz0XD6k8mSHAokpxJHKFP79xvwLh5qtvYA&oe=6A465B83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moment", "keywords": ["meditation", "mindfulness", "nature", "3d", "calming"], "long_description": "At Reality Mint we recognize that daily routines have shifted and people are looking for new ways to manage their mental health. So we\u2019ve decided to release an early version of MOMENT, an immersive experience designed for mindfulness practice and meditation. \n\nAs our development team works to integrate additional features, we hope you are able to take this opportunity to enjoy some relaxing nature scenes and find your MOMENT.", "short_description": "Getting cabin fever? Step outside with MOMENT!\n \nWe at Reality Mint want to help everyone dealing with the stress of isolation and uncertainty during this pandemic, so we\u2019re releasing some scenes from our upcoming app MOMENT, a platform for mindfulness and meditation.\n \nSo if you\u2019re feeling you need an escape, please take a MOMENT on us to enjoy some relaxing nature scenes beautifully captured in stunning 8k 3d."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/51410546", "developer_terms_of_service_url": "https://www.iubenda.com/terms
73_8437851522330525696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz5nd7yubuIQ7kNvwE1fb0u&_nc_oc=AdpW3xB6ekzorWqxdCt5LD18baoy7V8Y_pgDzUG4o1vMZv2x0vFJZMK6f_MnZHCyzcA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUXuj8XVbTjyBC6fzxUXyGkWQX-5fgqoqPlHvsc4ah2w&oe=6AF0AAD0"}, {"file_name": "l3Fi37.png", "id": "155720132369367", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974811_155720135702700_2579167280457842688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPWTfZMvzhcQ7kNvwHiFQC8&_nc_oc=Adqh82gT3GdzGkNKuGn4V17tDAzBfASPRocFLuea-aj2MznRkrTifOMoP5jtcIao8fc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL9IHzGMxeXckVGWk_EhtGxEaDDjt9NaFFhHxSPVARSA&oe=6AF0A543"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moment", "keywords": ["meditation", "mindfulness", "nature", "3d", "calming"], "long_description": "At Reality Mint we recognize that daily routines have shifted and people are looking for new ways to manage their mental health. So we\u2019ve decided to release an early version of MOMENT, an immersive experience designed for mindfulness practice and meditation. \n\nAs our development team works to integrate additional features, we hope you are able to take this opportunity to enjoy some relaxing nature scenes and find your MOMENT.", "short_description": "Getting cabin fever? Step outside with MOMENT!\n \nWe at Reality Mint want to help everyone dealing with the stress of isolation and uncertainty during this pandemic, so we\u2019re releasing some scenes from our upcoming app MOMENT, a platform for mindfulness and meditation.\n \nSo if you\u2019re feeling you need an escape, please take a MOMENT on us to enjoy some relaxing nature scenes beautifully captured in stunning 8k 3d."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/51410546", "developer_terms_of_service_url": "https://www.iubenda.com/terms-and-conditions/51410546", "
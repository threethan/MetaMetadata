73_8437851522330525696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW-0moTCocgQ7kNvwHIM8W2&_nc_oc=AdrrruCVf_HFOl1OK-qiMPsoBLn0UHvGFcoNZas7qz8bWYyoVEgmLbITKkwT5SahP8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPc8_khqSekglfG0oEDUvqskx3m8bSi1Lgj8d6B5xKgQ&oe=69CBC590"}, {"file_name": "l3Fi37.png", "id": "155720132369367", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974811_155720135702700_2579167280457842688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6AInJxxcegQ7kNvwGhkwxC&_nc_oc=AdoUVn1TjHNlMdg5_398TyVQWU3-YUmu0WaxTzW1VznRMGfqHV0CiyHQJXt7BIjU5_M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUTxPg1VUCBlQkydXXH0LxJkwBuqyuqn2gs6hiZhvSRA&oe=69CBC003"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moment", "keywords": ["meditation", "mindfulness", "nature", "3d", "calming"], "long_description": "At Reality Mint we recognize that daily routines have shifted and people are looking for new ways to manage their mental health. So we\u2019ve decided to release an early version of MOMENT, an immersive experience designed for mindfulness practice and meditation. \n\nAs our development team works to integrate additional features, we hope you are able to take this opportunity to enjoy some relaxing nature scenes and find your MOMENT.", "short_description": "Getting cabin fever? Step outside with MOMENT!\n \nWe at Reality Mint want to help everyone dealing with the stress of isolation and uncertainty during this pandemic, so we\u2019re releasing some scenes from our upcoming app MOMENT, a platform for mindfulness and meditation.\n \nSo if you\u2019re feeling you need an escape, please take a MOMENT on us to enjoy some relaxing nature scenes beautifully captured in stunning 8k 3d."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/51410546", "developer_terms_of_service_url": "https://www.iubenda.com/terms-and-conditions/51410546", "
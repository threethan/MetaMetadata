73_8437851522330525696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNJP7rCwmBoQ7kNvwHNdp3T&_nc_oc=Adq656yMyhCjEBjtMQBxY_jDyrTSU6wKHLI8a1MJRNN5JpYQu4A6PqDkZxFX-yd7tas&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-KBBzOTQG-Sy919QyZ8GPqU3kmKTZthU1w3Jux2TzXQ&oe=69C67F90"}, {"file_name": "l3Fi37.png", "id": "155720132369367", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_155720135702700_2579167280457842688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnGApRUcEKcQ7kNvwEDFhq1&_nc_oc=AdodL4_GXQhFYg0VE3gxGdUEn01YivFPRdYuaGyEDyIWW7khh22iVqvWJ8ebfPO5Iq4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMcDmH7G6Vbe2_Rs7rv1IYQqOQxOFgMboW_ChQhEHyFg&oe=69C67A03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moment", "keywords": ["meditation", "mindfulness", "nature", "3d", "calming"], "long_description": "At Reality Mint we recognize that daily routines have shifted and people are looking for new ways to manage their mental health. So we\u2019ve decided to release an early version of MOMENT, an immersive experience designed for mindfulness practice and meditation. \n\nAs our development team works to integrate additional features, we hope you are able to take this opportunity to enjoy some relaxing nature scenes and find your MOMENT.", "short_description": "Getting cabin fever? Step outside with MOMENT!\n \nWe at Reality Mint want to help everyone dealing with the stress of isolation and uncertainty during this pandemic, so we\u2019re releasing some scenes from our upcoming app MOMENT, a platform for mindfulness and meditation.\n \nSo if you\u2019re feeling you need an escape, please take a MOMENT on us to enjoy some relaxing nature scenes beautifully captured in stunning 8k 3d."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/51410546", "developer_terms_of_service_url": "https://www.iubenda.com/terms-and-conditions/51410546", "
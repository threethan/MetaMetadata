zBqAWm2NLfAbpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-JtAcuAERPxmS3Qjg-hUGKKQkHmt-WNY0cUhcYmEIWQ&oe=6B00568A"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\u2464.png", "id": "483949181427945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393518_483949184761278_4680262036259660704_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DCJuE1V554Q7kNvwEWonVF&_nc_oc=AdqA5pVCUje9Q3h2vy4JsORE5zEg6uGLe9eqbRBonzLAEmoDR_hsjrZ2NNseLGYslB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAKYDFUAqDubeyk7JaBwgw8hDRR-I1dUt9CnBLSHTe5Q&oe=6B007670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (1).png", "id": "1807404350095204", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392179_1807404353428537_458662868785993709_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY4NsoSw6n8Q7kNvwFaK14a&_nc_oc=AdqCLhNo63ZSvMjqV6Akqx9M_HYPMw1RCfU67HVVQRKYNwmfWDC1T6cdtfJq5RUxkyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6z2OPWlUcIxDFSJZb9VFcJQCzpYB7kiZFwMy4zzv6zw&oe=6B005E33"}, "display_name": "Jet Hands Climb", "keywords": ["Jet", "Climb", "Climber", "Adventure", "action"], "long_description": "\"Jet Hands Climb\" is a thrilling vertical ascent action game in VR space! You put a jet in your hand and use jumps and jet bursts to climb higher and higher. Collect coins to upgrade your jumping power, jet fuel capacity, and coin earning, and make your way to the world above the clouds. Amazing unseen views await there!\n\nFeature:\n- Immersive experience! It's almost as if you're actually flying!\n- Simple and exhilarating operation! Master the art of combining jumps and jet bursts to climb even higher!\n- Jumping, jet fuel capacity, and coin earning upgrades for replayability!\n- The more you climb, the more beautiful the scenery becomes! Let's aim for the world above the clouds!", "short_description": "Jet jets to the top of the sky! Exhilarating ascent action!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8765904970204898"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394097_1146293297094500_2172584248561623376_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ldeax9absrsQ7kNvwHAzko5&_nc_oc=AdqnSyu7LwvFbxMzolU-iMoj22cB98AC6fTcb682BrN88s6aT6Ma9DT3Ldr5vRkQjcM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQBA91LmeUzGpqwy5DMcCT67qfz0-VGu9jIDDavFzL9g&oe=6B006DC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jet Hands Climb", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1737758280, "lastRevision": {"nodes": [{"id": "8765
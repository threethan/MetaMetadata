YoCM2s79Q0VpXb1NywRUhIjkEhlOxDMXfobIJSndOAdcCh6D4iS6AXkdQrg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvmpvl_YMVe5EwTeA3gSKCHMYTmyl2HXZmWRRr6GFSvg&oe=6A661EB3"}, "display_name": "Jet Hands Climb", "keywords": ["Jet", "Climb", "Climber", "Adventure", "action"], "long_description": "\"Jet Hands Climb\" is a thrilling vertical ascent action game in VR space! You put a jet in your hand and use jumps and jet bursts to climb higher and higher. Collect coins to upgrade your jumping power, jet fuel capacity, and coin earning, and make your way to the world above the clouds. Amazing unseen views await there!\n\nFeature:\n- Immersive experience! It's almost as if you're actually flying!\n- Simple and exhilarating operation! Master the art of combining jumps and jet bursts to climb even higher!\n- Jumping, jet fuel capacity, and coin earning upgrades for replayability!\n- The more you climb, the more beautiful the scenery becomes! Let's aim for the world above the clouds!", "short_description": "Jet jets to the top of the sky! Exhilarating ascent action!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "suppo
bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIjvBqC6-lkQ7kNvwHPO7GW&_nc_oc=AdqPlUV4HwJzFbXZ1myUa6iLjJR68l8kbjFmbUTGGHh08w1ChB3Y5Jb7FL_BtY0-gDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9jQ9LduBbWzidHso9p4OPej5gUOt6FbAr8OM30hBebg&oe=6B1060CA"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\u2464.png", "id": "483949181427945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393518_483949184761278_4680262036259660704_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBo4VRWXn-4Q7kNvwG0cpWk&_nc_oc=AdrwkSmdeOYvy22l0mdWxhYRhw-i-eMpczQzsdzrbsaedGlvUDva7C6cWJ4yJsQJOSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVstacRkOJTzWYG38rDxhnEKFKgDpN-6b0UEUHiH68rwQ&oe=6B104870"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (1).png", "id": "1807404350095204", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392179_1807404353428537_458662868785993709_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuuewrSGGpAQ7kNvwGKeODj&_nc_oc=Adrdmt9AJ_h5Zh2EDe94gm5eGK-vqK-vfxV_DvrvSsw4dASzlNH8Mm7zYRus8gTi2q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVU8qjXT0PzL_J4qdyVTsGAnxpL6YAVHgtJ5B7nzrhxUw&oe=6B106873"}, "display_name": "Jet Hands Climb", "keywords": ["Jet", "Climb", "Climber", "Adventure", "action"], "long_description": "\"Jet Hands Climb\" is a thrilling vertical ascent action game in VR space! You put a jet in your hand and use jumps and jet bursts to climb higher and higher. Collect coins to upgrade your jumping power, jet fuel capacity, and coin earning, and make your way to the world above the clouds. Amazing unseen views await there!\n\nFeature:\n- Immersive experience! It's almost as if you're actually flying!\n- Simple and exhilarating operation! Master the art of combining jumps and jet bursts to climb even higher!\n- Jumping, jet fuel capacity, and coin earning upgrades for replayability!\n- The mor
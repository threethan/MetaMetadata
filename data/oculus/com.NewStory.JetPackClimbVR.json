!\n\nFeature:\n- Immersive experience! It's almost as if you're actually flying!\n- Simple and exhilarating operation! Master the art of combining jumps and jet bursts to climb even higher!\n- Jumping, jet fuel capacity, and coin earning upgrades for replayability!\n- The more you climb, the more beautiful the scenery becomes! Let's aim for the world above the clouds!", "short_description": "Jet jets to the top of the sky! Exhilarating ascent action!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8765904970204898"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394097_1146293297094500_2172584248561623376_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7WYiDIqVRoQ7kNvwFU5GsE&_nc_oc=AdqpMFA90SUAajSWgG-wF5c50YaNFoIaQZdD_HhF9RimwR_p1VxOqVRXwkIcVvZbVQ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70A5gCfZs3EyMv1RpFjRV8hfE31slvYIqNdpxsxmzAwg&oe=69FDCF85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_nam
cJuzFfaWk2rVCCyjU4y1kaW7wRr1YaOewvZur4vFUgbI1H5UD-JAJfmr4RGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR9KTNvZL4LtBDgzdnob5B6YTLJk1E_duOpTSAtpyT_g&oe=6A9C0C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (1).png", "id": "1807404350095204", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392179_1807404353428537_458662868785993709_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_VsO5rLzykQ7kNvwFLE-lB&_nc_oc=AdoJQw36Wr-in7l72ODdKdpE9nbw-s1y69xZhvmQOtcSxNPedGr8g3icwJz_HnmUYfc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3qY-FODEs-gCFVG2rEbkB99a0QdVpNWHBKuULTbdw1Q&oe=6A9C2C33"}, "display_name": "Jet Hands Climb", "keywords": ["Jet", "Climb", "Climber", "Adventure", "action"], "long_description": "\"Jet Hands Climb\" is a thrilling vertical ascent action game in VR space! You put a jet in your hand and use jumps and jet bursts to climb higher and higher. Collect coins to upgrade your jumping power, jet fuel capacity, and coin earning, and make your way to the world above the clouds. Amazing unseen views await there!\n\nFeature:\n- Immersive experience! It's almost as if you're actually flying!\n- Simple and exhilarating operation! Master the art of combining jumps and jet bursts to climb even higher!\n- Jumping, jet fuel capacity, and coin earning upgrades for replayability!\n- The more you climb, the more beautiful the scenery becomes! Let's aim for the world above the clouds!", "short_description": "Jet jets to the top of the sky! Exhilarating ascent action!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "
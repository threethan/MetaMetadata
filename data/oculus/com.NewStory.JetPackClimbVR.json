bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbN3mFA2BlAQ7kNvwFe0imv&_nc_oc=AdoG_Rz9RKK933VfX3yrZNJDi1_VMAh6HRWAgDPevdcsVo8klRd-mgBqfmjh0aX-1Sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXNOp4dIcL8PKwSiScbCuVtPbiftDaYN72_Ft7oz1abw&oe=6B0F0F4A"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\u2464.png", "id": "483949181427945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393518_483949184761278_4680262036259660704_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3j_9AMNmlYQ7kNvwHEYl_x&_nc_oc=AdqR11Hjw8aZzMvYh2DcXwbkSFjKtcWTUInw13hF2gdCv92th8X7yUeXfRyvRsbN2Sg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeGJ-gXVEyHD0d2kkOBAviGKS6Eiws6e204UHbXweU6A&oe=6B0EF6F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (1).png", "id": "1807404350095204", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392179_1807404353428537_458662868785993709_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuuewrSGGpAQ7kNvwHhzSfO&_nc_oc=Adrd_nS3qE8jJ2ONMi_enhx8zvTeq3wM8Jv-a7yEoROE_-xLk4LYvMwj71C-0OZvIXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpvazSXHPliyuFYZxMb_mIze1GKshRvqEecYf2xHNtKQ&oe=6B0F16F3"}, "display_name": "Jet Hands Climb", "keywords": ["Jet", "Climb", "Climber", "Adventure", "action"], "long_description": "\"Jet Hands Climb\" is a thrilling vertical ascent action game in VR space! You put a jet in your hand and use jumps and jet bursts to climb higher and higher. Collect coins to upgrade your jumping power, jet fuel capacity, and coin earning, and make your way to the world above the clouds. Amazing unseen views await there!\n\nFeature:\n- Immersive experience! It's almost as if you're actually flying!\n- Simple and exhilarating operation! Master the art of combining jumps and jet bursts to climb even higher!\n- Jumping, jet fuel capacity, and coin earning upgrades for replayability!\n- The mor
.com/v/t64.5771-25/473396844_585099054348473_5696509752238996969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P3F-04zfOcQ7kNvwEypEz9&_nc_oc=Adkf0k5C0YrF_fyWAM8u509IqEVvrZIvTFxftwrwOPW0011XAvC5ovOMkp0URLCqFbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftUTlNAj6masAMBEU6heAwSxY1ZZKZcZZt3IAG5Lqtmtg&oe=699DB30A"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\u2464.png", "id": "483949181427945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393518_483949184761278_4680262036259660704_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHJKY4OSpSkQ7kNvwHOMnvV&_nc_oc=Adn5aqGY0eDz3o27vTXD8g0oHLvlTJm4OdIIHj-Ag6GoYkHylUWFP8BuX3feaQIe6Yg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdjeFttdRplzSwbokI13xB0yRrclGGa6sYoWvpxMIvew&oe=699D9AB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (1).png", "id": "1807404350095204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392179_1807404353428537_458662868785993709_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J3o4fwmdYMQ7kNvwE5bBUP&_nc_oc=AdlpFT7h-Szsz4O0cRk9Zs1jarNMmUhJjrypxalTleBqFAtWtZfoK7kYAapPjc0jUaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afug33-hv4ZwZjkihoBaH3B58kJF7XsJ7USHwWoGGaa6sA&oe=699D8273"}, "display_name": "Jet Hands Climb", "keywords": ["Jet", "Climb", "Climber", "Adventure", "action"], "long_description": "\"Jet Hands Climb\" is a thrilling vertical ascent action game in VR space! You put a jet in your hand and use jumps and jet bursts to climb higher and higher. Collect coins to upgrade your jumping power, jet fuel capacity, and coin earning, and make your way to the world above the clouds. Amazing unseen views await there!\n\nFeature:\n- Immersive experience! It's almost as if you're actually flying!\n- Simple and exhilarating operation! Master the art of combining jumps and jet bursts to climb even higher!\n- Jumping, jet fuel capacity, and coin earning upgrades for replayability!\n- The more you climb, the more beautiful the scenery becomes! Let's aim for the world above the clouds!", "short_description": "Jet jets to the top of the sky! Exhilarating ascent action!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8765904970204898"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394097_1146293297094500_2172584248561623376_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xbOEUiXY2MQ7kNvwF1gXjR&_nc_oc=Adn69U-AsNkl7xxNJaD-K5aE6s-7_uFU8qZYPQISthhgBa8H_ppPcmwtL05NNE8jGuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsny49p2xJiSLK1Sy1S3ZvpG3xK1qd1UAmoMX_XLIPwBQ&oe=699D9205"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jet Hands Climb", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}],
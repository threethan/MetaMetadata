-by5o2RDetJlIvxTDbiD9rt7Dvg0dN18sBcgY-qbPIhOfI8Uy8m55PaIpwZQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPA02-Di2UOSCWHQgNjHBdY5kxQh48nUxUsPTNgWmd8w&oe=6AA000B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (1).png", "id": "1807404350095204", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392179_1807404353428537_458662868785993709_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNhieZTWRG0Q7kNvwEZzObH&_nc_oc=Adrc0lqa0MGeyIihUgYnEb5Fa9gySsfj9JMsdk-NH85dGEShHMtbewLG1pfGbg8ZGfU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnfz-w694mirbGXvbwsuVGkUjxa3Y2Gms0KPOR_NO-0w&oe=6AA020B3"}, "display_name": "Jet Hands Climb", "keywords": ["Jet", "Climb", "Climber", "Adventure", "action"], "long_description": "\"Jet Hands Climb\" is a thrilling vertical ascent action game in VR space! You put a jet in your hand and use jumps and jet bursts to climb higher and higher. Collect coins to upgrade your jumping power, jet fuel capacity, and coin earning, and make your way to the world above the clouds. Amazing unseen views await there!\n\nFeature:\n- Immersive experience! It's almost as if you're actually flying!\n- Simple and exhilarating operation! Master the art of combining jumps and jet bursts to climb even higher!\n- Jumping, jet fuel capacity, and coin earning upgrades for replayability!\n- The more you climb, the more beautiful the scenery becomes! Let's aim for the world above the clouds!", "short_description": "Jet jets to the top of the sky! Exhilarating ascent action!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "
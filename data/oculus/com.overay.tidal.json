nt-atl3-1.oculuscdn.com/v/t64.5771-25/473397628_587804370828808_1430818904446064438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIJORAIAo6AQ7kNvwFbariu&_nc_oc=Adr1EDJGME-K7uit_rRKGSME7Xi9JfYB1UrMIwivfagKPkS1YDgY1uvutVmsIxuad2o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UJ4TZ-hvnJP2Mvw_7GlpTXTpBppWilpinEc97AyhEzg&oe=6A411282"}, {"file_name": "5.png", "id": "1055652546579531", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393822_1055652549912864_1340702529588886954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wADSoaD8sfcQ7kNvwEOIA-e&_nc_oc=AdpOm-EwY9CwZvA077-GYg5APKIgGdCkAozuxHl5uIhjp_uIB-1Iewdko47U9uE05KA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V6mx2p8BiD5Z76lnQ0Hh7yC4YlfotpGDu5wTALxZ7jw&oe=6A411090"}, {"file_name": "2.png", "id": "960790242286816", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396257_960790245620149_4335548855824578674_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdFsBLCGmBcQ7kNvwGqslMQ&_nc_oc=Ado6W6qk8nL0Kfhuopcm_qL08A4fg65eXeM59TR_gYXu6M0R4PQIYR9pF17rMQQjHr0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nBdIzxHmAZwMdHBApBXoINAEoDUQ82sWdn7T2aF2Cig&oe=6A4144CB"}, {"file_name": "3.png", "id": "2011877299287644", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392155_2011877302620977_4184631698016341028_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubiynOKlGZsQ7kNvwFe_I_T&_nc_oc=AdpqDh3T76pBt5iLagCzyvazs7Q6-X8M8JIfiNnWoF-Dl7WVKLv2x84DY06eVqzR4Ic&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tc0tudW8T1qLxQQZj3oCCPA7tu6AkX-2IOymUcn9yPA&oe=6A413F1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailor-cover.png", "id": "1705654860014669", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473396566_1705654863348002_7069678835189168841_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0oeDqqiL10Q7kNvwF0qMNm&_nc_oc=Ado56_BCwT2Mm4nrsP5u-JTsHUcjlStoWt2eFa2C0BJnUq5wcP4oyaru9fhx5qPXt2o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ySYMWSoA6TAQmIyXK3KdspWPujWmQL4pUMLAlf2evhA&oe=6A4117D5"}, "display_name": "Tidal Adventure", "keywords": ["Catch", "Adventrue", "Grab", "Decorate", "Simulation"], "long_description": "Features:\n\ud83c\udf0a Realistic Coastal Environments\nFeel nature on a map that closely reproduces real Seohae shoreline such as Seocheon and Taean, and enjoy tidal flat exploration that's hard to find in real life.\n\ud83e\udd80 Immersive Marine Life and Tools\nCollect a variety of tidal creatures native to tidal flats and enhance your experience with upgraded tools tailored for tidal flat exploration.\n\ud83c\udfe0 Marine Ecosystem and Personal Aquarium\nCarefully manage the creatures you've collected by placing them in your personal aquarium. Build your own ecosystem and deepen your knowledge of Korea\u2019s tidal flats through the in-game encyclopedia.\n\u2728 Immersive Visuals and Educational Fun\nExperience the beauty of tidal flats through vivid visuals and interactive gameplay, while learning about the importance of nature conservation and the delicate balance of ecosystems.\nTidal Adventure offers you the ultimate chance to explore the mysteries of nature at your fingertips.\nDownload now and start your own tidal flat adventure today! \ud83c\udf3f", "short_description": "Tidal Adventure!\nAre you ready to immerse yourself in the wonders of nature?\nTidal Adventure is a captivating simulation game set in the tidal flats of Korea\u2019s Seohae Shoreline. Explore various regions, collect unique tidal creature, and experience the harmony of thriving ecosystems. Embark on a one-of-a-kind journey where you can enjoy the thrill of tidal flat exploration, a rare and special experience brought to life!"}]}, "developer_name": "ImmersedPlayer", "developer_privacy_policy_url": "https://brief-story-6c1.notion.site/Privacy-Policy-2aea64a6b05e805e8ee2def73a720e2d", "developer_terms_of_service_url": null, 
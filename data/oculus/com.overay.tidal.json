WA&oe=6A844D10"}, {"file_name": "2.png", "id": "960790242286816", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396257_960790245620149_4335548855824578674_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRnl8b8kgFkQ7kNvwF9-4N5&_nc_oc=AdpY2rqSAdZsMalM773BFjGL06MlB_qetZuUR9ydDPRO_Mcuxu6yipMSP1XT9dtLMgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELoEMv76g6sFa3so9JzuyKSm2QVTta8wVG6i5yoTs9cQ&oe=6A84490B"}, {"file_name": "3.png", "id": "2011877299287644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392155_2011877302620977_4184631698016341028_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHYIj853swQQ7kNvwFCSler&_nc_oc=AdqLeu-0pvdkdjF__mvK99dvwS0yr6GWFF0Gtm00EFLQUzhENMIwdN3KOUQ2_8j2jVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWpftBd6n90X-ggQTDJQoPpIbTrisPzlTUK6Xh4PAwgw&oe=6A84435F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailor-cover.png", "id": "1705654860014669", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396566_1705654863348002_7069678835189168841_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNRPa7G2CioQ7kNvwEJh3hs&_nc_oc=AdoD4qffW4v1Ds9ubYINn4tVK_a1vRByO87K2_6-eamJG-KaaKe7ys3Aw_IhR-BdaAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMtllHs8GFkrjp_plWTHW30l4Ckd0krjByvT5hm1WmAg&oe=6A845455"}, "display_name": "Tidal Adventure", "keywords": [], "long_description": "Features:\n\ud83c\udf0a Realistic Coastal Environments\nFeel nature on a map that closely reproduces real Seohae shoreline such as Seocheon and Taean, and enjoy tidal flat exploration that's hard to find in real life.\n\ud83e\udd80 Immersive Marine Life and Tools\nCollect a variety of tidal creatures native to tidal flats and enhance your experience with upgraded tools tailored for tidal flat exploration.\n\ud83c\udfe0 Marine Ecosystem and Personal Aquarium\nCarefully manage the creatures you've collected by placing them in your personal aquarium. Build your own ecosystem and deepen your knowledge of Korea\u2019s tidal flats through the in-game encyclopedia.\n\u2728 Immersive Visuals and Educational Fun\nExperience the beauty of tidal flats through vivid visuals and interactive gameplay, while learning about the importance of nature conservation and the delicate balance of ecosystems.\nTidal Adventure offers you the ultimate chance to explore the mysteries of nature at your fingertips.\nDownload now and start your own tidal flat adventure today! \ud83c\udf3f", "short_description": "Tidal Adventure!\nAre you ready to immerse yourself in the wonders of nature?\nTidal Adventure is a captivating simulation game set in the tidal flats of Korea\u2019s Seohae Shoreline. Explore various regions, collect unique tidal creature, and experience the harmony of thriving ecosystems. Embark on a one-of-a-kind journey where you can enjoy the thrill of tidal flat exploration, a rare and special experience brought to life!"}]}, "developer_name": "ImmersedPlayer", "developer_privacy_policy_url": "https://tidal-adventure.com/privacy", "developer_terms_of_service_url": "https://tidal-adventure.com/terms", "publisher_name": "ImmersedPlayer", "support_website_url": null, "website_url": "https://tidal-adventure.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28791488473769783
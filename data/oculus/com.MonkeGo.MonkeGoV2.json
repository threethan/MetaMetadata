99AF57D"}, "display_name": "Monke Go", "keywords": ["Monke", "Go", "MonkeGo"], "long_description": "Monke Go is a fun game where you use your arms to run and GO! You can go to Forest to swing around or go to Beach for a nice swim! If you get Bored try out our games Modes including only up, rising lava, glass bridge, racing etc.! Go to shop to get a cool look or watch the TV for funny videos! Make friends, have fun, its endless! Play Monke Go now!", "short_description": "Monke Go is a fun game where you use your arms to run and GO! You can go to Forest to swing around, or go to Beach for a nice swim! If you get Bored try out our games Modes including only up, rising lava, glass bridge, racing etc.! And remember to make friends and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkego/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "MemesRRGT", "support_website_url": null, "website_url": "https://sites.google.com/view/monkego/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28340007015614451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392019_915133563724731_8021411943746680436_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0
3L8dp2gc4EY01qoWdfu2-_nUi4B2qd0FjygQxS4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03O28SFYF5jIhfNRKyjC8aZxG9WCaXJIT8kBJK9qzesQ&oe=69F60DF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQ-jFmsUqa4Q7kNvwF2czMH&_nc_oc=AdoQ3r1U9dvAGMnMXW5bAM2gNUWHDmJtfHoqAwFSuXI7P413tpzISIStXYcJPkwGqb0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qF00aK9Rhtih5l3-pbjKwb6MHtYg4Rp9didO1fLt7Cg&oe=69F60441"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faIe0oFhBOYQ7kNvwHY7EjE&_nc_oc=AdpF_E3st0YXQ3VHfhwpnNkH1v81hH2U1JXnaTu97swnFnCHa9uTORIgxOeowD9ZuGk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jywa-o46Npal9iLkonNJXJpkdqJGIyYolY68EFgypWA&oe=69F5FD7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-02jT0omI8Q7kNvwGP5KEq&_nc_oc=AdpKdIfWWuvl3ImzrXOzXoc4ZO5X_uoVgoW_KQZ5zNIcxTnplQnwJNmNXYQlVH2plEA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Z4FJgI2Tz4RZ3iRW3fxM-rtfELW4cMGRa3jGhZy7hBQ&oe=69F6051D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJwmp9bATKMQ7kNvwEj6kt-&_nc_oc=AdrNsX878IRi78YlNAazFaxobWrMo6uddsAaKZoFG1KYq8tOqNT5_4-l3EZwghYEIgU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36z5yH8fCmjQgJBo1JCFMBi51e_5sRMiypIXMiHJNMCg&oe=69F61CCA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
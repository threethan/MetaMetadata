O32WgolOuPmg5ihIHUnNcmhkihzG5fenTtDFy1I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwI69vNkG1NiZ0H3o0qeaTYkDKXi3Ioy3JERJMksiAEKQ&oe=69C54676"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_5atINEoMAQ7kNvwFD7eY0&_nc_oc=AdroVuLw7wSWySGw5o6ZP-62d_opKDwVltTDjsa1FQZQ0FLpKQraaIm-qDh3PPWrtMk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsUF3FuARe9aUjatH7MCSvvCFobe084qZ1lredEp3m_g&oe=69C53CC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y66JbM9wUagQ7kNvwHwaIJM&_nc_oc=AdqUmFNOagOAa0rsysHP9Mu3jsSCq3NXs1KQVVKzesitpHCYgE1_Fj-C928YRbRfMsg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUZVg1lfa7HLnQXr6LG9LyFtyUMewzRy9g7Vshhv3qsA&oe=69C535FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySgS8N27WPYQ7kNvwEqjabT&_nc_oc=AdqfUnQkwDD9e5spx-nk1V82BYQ-T_xCOMQoh0ed1p_nq2mWC2WUkzwkLdOuBv2CKFg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHl_ASy6kM7qjWkOQ9tD_7izAT790hclOXlY5dPBENxg&oe=69C53D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssAYg-f2lYgQ7kNvwEKhvLa&_nc_oc=AdpVRWijL3QQeKIkHIjuez43wnpzSad9RlQiLj7_Ye-PXvsiuG6G4kOHDoc81JZN6CM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5GRwojbnJWxeO7bCKBA-FX81HGxhBcGZofoWWLeqeGg&oe=69C51D0A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
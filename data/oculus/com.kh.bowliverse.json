eZHkCSPuWga9d8cpdQmKA7AavN-pfI5BVNE9sk0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbeedONajZxhxxvI4UILMWeHyweZaglIf0PyFHk0JzVw&oe=6AF32DF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fI4WQV3f3IQ7kNvwH5vZ7n&_nc_oc=AdqMdUyp_Kbu0ZClsT5IBE3A73Cd4m6pd-sGFmVlojwvNwDpV-vBtcVl8F98KLaToWY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvfQP9Oa3ENTBUm07zsBHo0qD-dlUaSkBPRZcX1G9jjg&oe=6AF32441"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vKQwuqVi9UQ7kNvwH3KGxA&_nc_oc=AdrMflBKBqckQg0wHRT_92jisa-usVM03UTZyMo4Gz33-3pdzJJdiUlh48nXLajXolI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRry4lP4y7xUve74KHIZo4poMNupvR2z-V7TgCdTbkRTw&oe=6AF355BD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdMgJtLky_cQ7kNvwF7dsrS&_nc_oc=Adr5zIecr96xcGrsFsCSjeTQlZRGCYAhvC0N2xSyn1UEZXXlxQW-mM1dhOC0dwR9RPo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlnwCOP4IVHVAmE71wuzjfOlizcIBOAgh0GHnEHKbd3w&oe=6AF3251D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1LbLOHTg30Q7kNvwEYPur1&_nc_oc=Adr9ffmK-Ihh2W56G_FbBcBkSP2x58e5DlFuIHu2dd3q7bq0BfcXgCRmWAOmTOQhfSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiFrzEvXK1lZUD9XBsNvgDi2DOoykw3k6s8XarQhMB4w&oe=6AF33CCA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
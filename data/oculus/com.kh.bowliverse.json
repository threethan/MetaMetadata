qh92nbWNsiA9B-QAaIVqkSLYS5kd7KiDxXwwOL8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48DKlbkbdCbHpQECjKN7qyP3mYwYvPfl86xnK5ea4Kyg&oe=6A106BF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0lOHk320ZkQ7kNvwFkt9V6&_nc_oc=Adp-ZqwXR2zqUMugkVuTjmXP5aSsMmm4imHv5sB5Bc9jCJh9HyeOcl8m1dkmJKmnPzk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NkLCuPmXcUxvt-Tl29tVqVe5iK9Fvho0byDJd6d93kg&oe=6A106241"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9scp5d9I_jQQ7kNvwHjw7r8&_nc_oc=Adpyg9HSdpIEfHu2YJ1BwUnVltIyh5Quq4z_JJDU1hDu6SPYmP5IJPU2DawUY7P-t0Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ymnQqCAxzs6U1-mwQSK5qRMiEezDNpk6-9J6wLJWVXQ&oe=6A105B7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOxRU1I2AW8Q7kNvwF4d0ni&_nc_oc=AdojlhVDH9nG90hcDU-5DnEpkCJIxbJV7MlwGghJKV4GKaKRD2VxvUiySJWmbdLcXps&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Oemzp-WjgZ_5CsuII_O455_ccKJlr0WrNAM5SCgXg6A&oe=6A10631D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1NqS05Y1QkQ7kNvwF2i-jD&_nc_oc=Adq3hs1Sto63_SmPLqYOHdTOMk-XPV1wKz3htuG5bAokOoSRNlR8b750vXozL1tS9nY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RyBkI0_RRk2wdvdJ06pUwZ3y-IJfQvhr2ivp377Bogg&oe=6A107ACA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
_gz4Wo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXJDNZeVclC-DdGeaN4xsYH4hwiM7D_12EuXoGjsHe7Q&oe=69B53C36"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W97fuKfkNsQ7kNvwEDui-T&_nc_oc=Adnq_nNuxcaCHTXH0ybHTUP2ny4NsOwnjMzBwnw6vId6GgAF7zsb_IB1fjc2j3f7bbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVCG7hhATlmkdDZNSEIRZRWYpOGSGxZiTRm3SGFNBJzQ&oe=69B56AC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obaMSypVPIsQ7kNvwE__Wwz&_nc_oc=Adm2UN1Mywm3E7YEd7GR73_oc7HjWgWiUpRU6lcU1lmCOybPnroBP7yoY7G8-j2mnvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdDt7ACELZiZ1BItZ_mqKanrCWPMsd7nakvD-RZZIfzg&oe=69B563FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6JBKeUcPYIQ7kNvwHXZUd6&_nc_oc=AdkH2h7qJhJ4hftv8h4IIn4qkkkyljmNqQwnL7EQtFpEMNmKAxExMM_lFXFszziviaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0-o55CTujo7hYYeaM2uw3XbSfwFhUaf5KBawwogcigA&oe=69B56B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrIiImok8rMQ7kNvwFSZ7id&_nc_oc=AdmQmCRY7ssqfcDcbZGeRDHA6uYzaGFkPRkHz6VRFdWM682A0IU6-U37B1VgDt-LHIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHe451JrRUVvpDamZiWasLbsJnZtOcs7Ea_YZNpovYeg&oe=69B54B0A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
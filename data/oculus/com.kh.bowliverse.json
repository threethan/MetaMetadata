-bigUhfkNyKLLsKx_T1s12GJf1Mf0pWqVdzwhrE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YfcXVoCj3RKLTvIdvw5mu_Og2b54Wms7hw_4FPt8Vww&oe=6A1C4976"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpsDOV_Tgo0Q7kNvwG6Wcva&_nc_oc=AdoeJ3yO2GWujMjm-gQu7AG8pX7dFHpInjXUy5JX2vKEc_qsLgfJE4Ow1dJBQiV1QlU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Hs880-HKDnJJ1o6IaRp2JiCVYujt3IHBOxcMRo3gLqw&oe=6A1C3FC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnBkWyjZVwIQ7kNvwGW2CVY&_nc_oc=AdoVNjygJZgLrimdWunT_feJDXoj1rHCOUIDITTn9hXWtf8Yu2T3BCmkF-2ZAoo25C0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WFV3WXdgDcZK3jHhZk2T7QqtbSbOKGai6AYWNIsieKg&oe=6A1C38FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCk2EmIwUGsQ7kNvwFbziWh&_nc_oc=AdpFTEQ7bf626A1UEGePRtt50D2iVmC-ukZaxJERDioMMdWCeQFFKZ-xvo4-y4TXZ78&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bNX9eV4azANHiUoU41e-FPx3NpgEcgshevLOpgQvOjQ&oe=6A1C409D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiBjPezByXYQ7kNvwHhrP2Z&_nc_oc=AdqjXIN4oeX_jMWBw07XF6ibxgmhF31zgTXDaC4-qFPU8JPzazDRQWqY04BeJ8qcwcM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gp-QVznUwzXUxdvOcZERDVFOvhWqYJ3V7JcbQn-UpMw&oe=6A1C584A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
q9NgqoFHnieA5EO_AKFp20oIKmXbPjhYqM9e-ds&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ql9DNRG2Kabi8cEyUG7ju6B12t1HU-mDXDuby1aqkJw&oe=6A0C7776"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbENjDUiMwMQ7kNvwFcuc6m&_nc_oc=AdqUMsnP-Ob_7bb4z8f99EtXG9L0WSHeDkkLmUJlIJuZusEPZJXUnaJUaTCKJ1I98AM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mh_5x01MIMBcllMKHA5QVnbWzODHPIcxL46rrbmTkPg&oe=6A0C6DC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWiKGDNiTqoQ7kNvwHetbs8&_nc_oc=Adol2IT8Bhu_MeGVHpt8R6lUhcKc7bpJ3hZwR8A2XhxsKY69OuJjbTNI_0yQBhfNCMc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57dXmZT0T3SbrKK7N9ZsnPMrHi0ZINAQJF32KlEj6XEg&oe=6A0C66FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvB6zkcjjrIQ7kNvwFCcoUP&_nc_oc=AdranqacTV0p2xg7oejAb_8SFlyYajOe8z0a0wO8Fm9yqVvqXVKzd4ibAdp2CJqJ1Z4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70KZJIh4sw5-vJ3WQ7Fgf5BT-oiViJtUCCXYX8lxtmMg&oe=6A0C6E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ndx3eJP0_UQ7kNvwFi_muH&_nc_oc=AdpZv7KvbQvQYMay6TJOmbbLtmSHXpghJj7VYs4OXAmZTL8KZ3wewtL00wYrWUF_5WE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XBw6BYRtLVLW1oTsqD_Z9PnjYVVDNCKo01AyVMxs6mA&oe=6A0C864A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
cLOd3mshNpRnDHMBzwd40wn3Y9cwbc4Z8z8CeKw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfGlR5AvdF4IoddiTPl20jMS_QstWoE7rOFyLSUOvgyQ&oe=6A58EE76"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5_TMeED1xUQ7kNvwFd9iH9&_nc_oc=AdoWoXP-5trmYmIY9CrOUHRY9-hwtfdWa4CABnzqSEzirjJcYGqFWm6h7AUTszUqA30&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEb8yDsEoejd7wKS6L3bXnAY0jqZ9fQUqol2OnRysnSg&oe=6A58E4C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rxcY7BM81YQ7kNvwEvLFLe&_nc_oc=AdruZvqHoMUodi8VeWH9IJsriUCYF6YQJAa2dbbqPxqVDPjlXDqVEktpAVJEQFMlqY0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEIc9PISssf6isuBxyxB5mGaYKTCtf_BX5l5BcmbKctA&oe=6A58DDFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h5eSPHySj0Q7kNvwHwPndJ&_nc_oc=AdryFGtdD77Jsl9ukXDQ27B8irMf1nDbwbKz1DLk4FNN0jNTYpRnGiEX2DOJ5fj8jGM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUw2qiOh_-Xg3hKyWN721uJCOGsUpKF-tNrnDp5m6e5w&oe=6A58E59D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znKcml-qTD0Q7kNvwFCPhtE&_nc_oc=Adpn4KL3_n9d2qHwpJgDtI-15vZ26TAfivnXoePwR5vIKb1s30f6lf2J8FqLr0vZM2g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG5XCLEAmUBvd61WiGi7mGnZmZIDS0vgyCpM-Qllehlg&oe=6A58C50A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
UON_U4DoxNaP9W_Rb5Eh7Xz826lrdG72G6TN5_s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCq4CyK2SCmVjRYhlJaEUnq6bc2BR4KAJYO5qaUQlWUA&oe=6A901536"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vF19ChjUd0sQ7kNvwG5quOe&_nc_oc=AdqTYX8JR3tHeTg1m-RUZrLrlWbenYJoNpy6nNYt5WEoPDFIhCyyZezeDNVemBYhg9Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeUbTqwH6TZNdBV3Mllkx5jmt3dz2KUVp2_9CuThS9Tw&oe=6A900B81"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKbvC_E-PhQQ7kNvwH1Hfzk&_nc_oc=Adovp7hDph45uC7KJNGN3kAzK9mQ8qopa1AAp-tQNORnLtfRMZGOhIuZVKYZWfLZZmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNx0VIwngSMIyIcnlAk1fTqU6aZLjiNfUL7J3DJpzvLg&oe=6A903CFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKmj8vSC6yUQ7kNvwHWchTD&_nc_oc=AdpLUeRSCfPNUsav6Pynqd-NgowQYzhzhxWCU0v7TBax_Yja2SOnp4VNUiXOOiYEHG8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6b9PYGXcL_j-_9k7ZfDfPTLIxX-bJWAVbZmHHznz9RQ&oe=6A900C5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZV0MQdmYg8Q7kNvwH_JOeM&_nc_oc=Adoj_bklsxJeFCfPlKVxXF5yqsGn4lfqRn2fEkinTXoxP7oJrwy6IX8U2tiaTUB9Ji4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWSu9uspL2Pp_34EDxzRSovX767IbOSeO5EK-ECPwZlQ&oe=6A90240A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
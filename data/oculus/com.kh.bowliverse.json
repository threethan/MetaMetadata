JtscKLi_gTBynlQuYhavV9qFrErHRTl2ozER3SU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzK9RgCYmY3crj5AxCCchdfdfYA9R_SenbqJ5vJFImxg&oe=6A8ACF36"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIgmBl3uVHgQ7kNvwHc75bw&_nc_oc=Ado6zBCgmMI5k_cInfGh5o4_RguO82coYEeCmAQnpUJ7HqnTNYXkd96N5yvOn8gSqKU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsLpnpvaYJnd6Da3Wcwd-Ppq3YfhiI9uY83WoH3EVpQw&oe=6A8AC581"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2REzAJGSGjEQ7kNvwEX_NTL&_nc_oc=AdrUa_nIFCNbKsFrBa-jSzdrmGQ1vgoFBSn4wgqttBOs1f0w2KwhpxK7LIVu8vGrLY8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJX_XSl8CPmrvolr_7XYxnwuzTTNZMlWJztMCmz7lvUg&oe=6A8AF6FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UJXnP9X378Q7kNvwHB7RS2&_nc_oc=AdrneRGuHWPWzcq4VTDvXkV3mTArQU89wEe3ZYUCI3xmNRReIGFiG7zG4nBR_skeENU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGieiaqzrGRCVfXf_M4IwhFcmgHzXiMQukGBpSXdzZtvw&oe=6A8AC65D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCSTvOxtuqUQ7kNvwHLu7oV&_nc_oc=AdoozfmcCyydHsF6psIIGu2EI98iWpBKn-LO5f4Swzn3Ix9u6jHm8sQdixeVeOPshp4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdEStsqoRMx6mEEmJWQEosM_gsbSa2kqA3FAehwbMt4Q&oe=6A8ADE0A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
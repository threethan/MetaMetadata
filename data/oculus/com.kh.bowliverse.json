MfJRKBGBlptwxgYjxvmg29gUd5_VOetbZzg7pB0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPHtBeMfFEsntvNDVHB0zMVhl75hbKQAVPXTH84Zgbqw&oe=6A54F9F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8s-H_4XFVYQ7kNvwHnFye3&_nc_oc=Adr6j3FuEqMgxxWFJ7XWIvKOx8p6a_X8PGEYFSiRgcuTww3QFYVr4aXS4fOkTwncesM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBqIEdPhGpknl_N6M3hMjhEKpzHrOfoXqjlrvWjye8pQ&oe=6A54F041"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XILsq9K34vcQ7kNvwH9vIlu&_nc_oc=Adp3omrWwroKOfaMed61RivkjjmVgfMBkdqkIneDzjNYBPWTo3082aTma5QsN8Xs4Vs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBznuE6b5SFRRCMD1iTI5ih3_lVlBX8YUbroxwd_iaDMg&oe=6A54E97D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F99sRpV589cQ7kNvwEk8eVg&_nc_oc=AdqMumM_RxjEQSKeaKG8zL9NYuYqY90Oe_-UftwJr-f31_C3lrYu3fLWSb8JkWksR3w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWod_uYRRFmv9ZIpBZJw77-ie_9b9X2r6Yu7-QDATEUQ&oe=6A54F11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YrL9ywEk60Q7kNvwEn3ZnP&_nc_oc=Adrdu9ik1S7udtgP5I7l-lnIxMx4ENqrZVU1VCp2Xf0T2HBep4sw1J2e3PIVcQY9kXg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBACB2ai-CgaQf6D2VirR1wbeqeXzk6F17RiD3vc0RAQ&oe=6A5508CA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
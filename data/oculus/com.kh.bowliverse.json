aJmeyB4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRDLyfeKZJp4ryy2tcsAnzG6RkKzpPb4UpapYOnH55wA&oe=69B422F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W97fuKfkNsQ7kNvwEbT2qM&_nc_oc=Adltr-325RFBvSr-KO8_ixHJronEF4TpKHUNVzNuuMjbjMq8d9o-evQW5V4q-jlUoW4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4BOA3unTZwo7vVYg-ett_PsRvW_PFYy7CiB0i4HDG7w&oe=69B41941"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obaMSypVPIsQ7kNvwE0HGtz&_nc_oc=Adk6OCOUhvLUxWKI3nJh1DT9L5Vuo9XEnnUt7d0ycl_uGkSHyKSg7SY8sJnndMNz4YM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwM-Eof2-pc-A3P2QMqmgNqJqhB1vB4j6Ac6dQYZUXpqQ&oe=69B4127D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hvk2gy3ZOu8Q7kNvwGOUxNb&_nc_oc=AdkBxd5Lfihz5tamPFMyDWI4kgy7w5WnzrAWOr2Y2ahX3sfdAFU59yr_duhOnGx0Q6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPW27u300YQ5tTKaEFL4p-A2uDLUGRMMCDLruo-JGp7w&oe=69B41A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrIiImok8rMQ7kNvwHo1Ebg&_nc_oc=AdmL2Nf_5SkrlomAohzr2zNbm0m41BEiVYy3yRS39UP4WmKrJ1lJgk7oWZoKauEe2-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyviFcC5u5ohBCmESynUsRiACNZv_6I_l-B6RXD6ILpgA&oe=69B3F98A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
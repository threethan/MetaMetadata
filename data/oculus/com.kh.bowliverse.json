-ngUQkF2wSCxv6t-1t3Js2eN7J70aXeaVaFp5CA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32pefeO4QrHvShmrpUY0Bf5M6bX7Y2aTDyKnvC6u_zfw&oe=69F36AF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQ-jFmsUqa4Q7kNvwHExQsZ&_nc_oc=AdrNHxeAliHW51PVfPYpOuDgbzY6aKuAoSDa_U0vLguMoMgy6UP7rAcT7MP76ccrlyM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0b8LDtU5dG6ezLSxqe-GsSoXIF45n2NHDL37uN8MS3UA&oe=69F36141"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faIe0oFhBOYQ7kNvwFtfQQq&_nc_oc=Adog_5yJKzzDMriUtx829qHvbj4rLKoB3MY5Lw-XTJc4Rg7o3PZhOCJn595j0xrUK_I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2drI4uPo8c1wVWd9TjPmwlAGaZwuyYNaA9ZHmR7WoQdQ&oe=69F35A7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0DLtpRKfwsQ7kNvwHW7I9o&_nc_oc=AdpWbliDs1X8aPWV46aAmdIrckZ1wkyFXQ1972wAUO0vEgUUQ8T_F79HHuIlOD5k4PU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ss-ondb99jGmtfzIdNoZgpy3jtL35v_hztOhEUd_Tvw&oe=69F3621D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJwmp9bATKMQ7kNvwEY8EE7&_nc_oc=AdoUc4A05Twta3nEDwkdA01V0Bc1KwD8PLnyFsWpmd3Frpey0wTVfI1V4Wj22PFINqA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af027YdgIYA42pXKJdKr-5nAlzLxesoj-cYQCbHRjKNwfQ&oe=69F3418A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
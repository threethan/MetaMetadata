kAtfaAE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyABm1KFwreNech5fPw-ppk5Lee1IINotHu0MykmE-eEA&oe=69BC0BF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFWefsdOJ_4Q7kNvwEc8rjC&_nc_oc=AdmRjkObfeQX9B3R8gZk46Ti0F6Pc7UgRF2Q_RycA1LwTSAoGJ3Yo6KeVA-Z-O_M83o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9lDsfITphMZsTV_8TkLtp0wX-8ta1BiooRYLu7otaJA&oe=69BC0241"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZtIRlpqX7YQ7kNvwGR9oUd&_nc_oc=AdnhtdzBRvMV3r8bA9-SEQVi7CSdNEC8dluOd0RhOizEYN75U4QSJBM7mxw43RKMVIY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyi68cfMU-RU7j2iMMu5vVJ-QeHHKTMvQuPxoJ6OkWiPw&oe=69BBFB7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hZJFl1xBHoQ7kNvwErDXeC&_nc_oc=AdlhjBA-HOwEgKavW9K1Z5U2K_6ap2UMqfePVZ_vnr_YlRaRNuPVYXWFOQlL8QqsJgc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzoMiHsjUA6twYm7wbC23ShCUZ-4V7TaVGutK221ZggFA&oe=69BC031D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6HNeNVsWxsQ7kNvwHDTwW2&_nc_oc=Adlyokiv7EXW_2r2bPrw-CGdaLMZgB9RhUVPJh2MfnU3V563xgiL_uQDqyrwrVkRYYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4zJtvX2jkRESXtR0V2oj6wUS0z4JT62oZlAVNZihpYw&oe=69BBE28A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
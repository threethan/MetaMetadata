jkLI9P5DwePe84eKZc-rUmwooM6cAv6hHWP_Mng&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7vP_1z4R8tOETpl0LuwLOXXmlJClr0nct6Ka4isi2yw&oe=6A26D576"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWJ_s3R-dBYQ7kNvwEvnwO1&_nc_oc=AdoGdTXJ4kLlRdI5KIVGShRgQOPhbxUZ1kpEZeUpFV7rC6J3brT-8MJFUQGhIf3Nx9I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fyNhom3QWTr_ccMBY2XupmvHi15GR6cZVII4fsRxCTg&oe=6A26CBC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4TC7m8Tr-cQ7kNvwEM_ACH&_nc_oc=AdpeoK96AyImkjyPhibGuzZUJ090sW2REUmwZ1cGeysUulrFOg3C3E8tAK-wIb-1V1E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--H91jIjV8W48noOOsXAvNgZC8hv4W15ghDos_wBI6vg&oe=6A26C4FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2ByjXf2FyMQ7kNvwGfJszb&_nc_oc=AdqjuX1RS6dBXrv7NU9IVjXmbdKpOZ4tp2emfVH1MMnzBJBuREJNglWafbxQgtKajDE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vnr1ELeOo8uKUxvn_wojga9LRmLH_l4NTS6_iOi5fsQ&oe=6A26CC9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzDJn2SAnCIQ7kNvwHTTAp_&_nc_oc=AdqBMXrXUoP5BKT4LZ4QAIR1ed3aBJnXSYp7leiFNeZAZFkpBIaXgxjsLtK-sLeQpjg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r7SgEfMSPVL1sSu2aaHO2Fxjs90vw_Z7UBFLKFzzPnA&oe=6A26E44A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
iwQERzOo2WIO8SjyoBMa2YX1TTf857oCqPAKQkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlwUTvQP10BGFHV_b8Yv647DFQkX3Fl12eX27hhNvQew&oe=6AA6B6F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EARbKd24srwQ7kNvwEssmAG&_nc_oc=AdoNT_4iD58XmR1XDipt60Nl2Z2E2UZ72c8aUfCOcuknMMq_Wa-iD46dKeYqBPnuv1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGP9pQgmBagCqzTHC89IYQDRjTodGNEfWkTZrAjsa94g&oe=6AA6AD41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ5xxaj4MTcQ7kNvwEzix04&_nc_oc=AdrqcSur9hOLPdW1zhSCV1aSeog5d1kl0KYp_a9RledVovbR1pOfQGUvFwokGh1zmes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9YuePX3Ssepx1SRrv9s9M2FMXqtFCIPoxzU_UPP8qLA&oe=6AA6A67D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgQNkESV2acQ7kNvwE6-CBS&_nc_oc=AdrHLHfAAhvelW3Y9PYTG3ZdDwa7kRw5ngK7UOhB1YSbNSeNRTa5IFR8qu9E-aolmrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsn81JmT-0JlKOzMov2HdKV9Z5-md_o1vGQ9H6I2x4Gg&oe=6AA6AE1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqtzvX5oYBEQ7kNvwGKYEUP&_nc_oc=AdolyCVjB83zYRX8_DkbSKt9-oXx3Lf__coBNnoD0WQ_Daxro64SbljkAHtDhMt1yno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItRMwceWNNU_9t_3-6iPh7BFrHKqc4jPqvKyJDx8u6Jg&oe=6AA6C5CA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
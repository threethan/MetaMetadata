dvS68lU9Ji0_teD0rzenD013ask4NCqOk5Updy0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D_2jdZ_CmTHK7l-_5T7Zu2-lSlw6DdfunFrP_UUMMVg&oe=69FDF6F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMr8Wrg5-6EQ7kNvwFbPI7K&_nc_oc=AdpVXmyq_vPJ5ft6bw38D5ILDhMZXstKARH_y1zj0pf0C9VZpgH_G9I38D2KP64EsZE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z238NZI4qHWuC_cEk_H7tdZX10X_gWGjoZ9nBbUHeWw&oe=69FDED41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaJMPhyusFQQ7kNvwHAt5CM&_nc_oc=AdqrHJ1zaVQSqKFG7YUly1A2TrbS0LlCB42uWCl8_7DJJLMgbFuf8qne1jS6BNLvwzQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lQ5KXLWDIgqCS_KNIBgQTbGQBA0ae4YF1cmCrOxUZsA&oe=69FDE67D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E81K5wQDu0cQ7kNvwGarKV1&_nc_oc=AdqBQOuQ7VW7NalTvO7jvUZ7rs2CAf1N5XE81IzKb_tXvGvImIQbHUF18FKon6RCQ2w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xJi_1OGBu1UuvZQqxGkRehh5K6ufmMTM8JLvvYW09Sw&oe=69FDEE1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4y9XV0kdpwQ7kNvwGJigzt&_nc_oc=AdpxxdDO8Q4fW61jOTOF5jU0TNpHifuOVzEyLp-qPxtoZQUOvX7zPDePJkd6rQ4VYMU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BOty4-fRp1kC_IwXDedg-X61mNQs7O4qF7xMWolBHAA&oe=69FE05CA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
kWkbDAsKFqufVl-z7e4yjjDnQBBQULO8SgtzvIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4tw_CoG9kdxo4GhEkXEiXpGZ919-7Uoypg5A8VEwNHQ&oe=6AAAAB76"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaqEO3gF454Q7kNvwFEcODZ&_nc_oc=AdpCV02jt0IivL9XHNPglbG9Or4xIPrmOOoYImPzhAT9M-HyX0fbasWQ5n0hcBKG1JM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiHVgYMZvyP0mx0SS6HuJCrDW9sgTGDwJQJ3qsFCIpXw&oe=6AAAA1C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXSa-SUahLoQ7kNvwF37WCp&_nc_oc=AdqaVnQ_NLZNgmsVX0nEC9gJbSGMoAmswVPQsKTAmhLmh32mk20O8XIAaILY2bTt9rA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9N4iVy69A7CrJAYywjUIYHTonEzSi3oA9NgNUx3wkqg&oe=6AAA9AFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBv8e6aTElcQ7kNvwGtvUzD&_nc_oc=AdqOR1Tkiq72a7WCQosLrTW0lti3Jrm-QvxFk2-4mcQLTfxLeLhzirrfiHi6DETuCZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5ct7omrgxPDFb7Phmvnk_A5kYDwcmpX-Us02i4qxzWg&oe=6AAAA29D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uLyShcaOnsQ7kNvwHDhcnw&_nc_oc=Adp_Lf5HB1Gjb5QSllsdqFAx9q_Go_eEBc7mjD2N_kT0urtv28JZY1X46ur0_ZhRM10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFzo1JwMMmrvMss7Fm_IofIC9vF5ogewcqYmOUiWMUOw&oe=6AAABA4A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
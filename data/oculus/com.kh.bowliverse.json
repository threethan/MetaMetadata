8EzD-ea4Sxk4AXWgcAu-lnOH6VVgcR8hdrozDhg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TwI7M__GmtnjhcQ8lESglI-w-SS0KJ9HNeJWE0X8DSw&oe=69E24776"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8CAEIWtrhwQ7kNvwEo32yZ&_nc_oc=AdqXxQvLTOvxBk_jgg4UQJ1uQ0-m4jYupLWyDQOlLktcDAslQrd333yRB7zt5y8Voo4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0okent5kLtlbz7jrIPx5jaO99Z_EFKtcFTz6u4bFt3iA&oe=69E23DC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTBkSrARDssQ7kNvwEwRMg6&_nc_oc=AdoCditLF6Ja5rr-orHl775IQp2mWJaeNAulXOp_RgNToz7G-MrhSsgQIf4lQ6bbbpg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rWdIWtZ4DrxNv3ztER_4xQz7gvuuJZLDFKodFrpbTZA&oe=69E236FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xutedvXoHAAQ7kNvwGHSLVi&_nc_oc=AdqjkzvRqnCQjPLghXC6QnUWnp09GBscKuzub1UOogHdPnFyjW0Ztcnz6Z-mPwg_g6s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26E86gVduxa813jYHyyPCzxs3OEQDbwfl3N11EZYO4Qw&oe=69E23E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRknclrPPOcQ7kNvwFYjUI4&_nc_oc=AdqSR1v2G4q7hD45dfjd68dp2GIrHNNe39ci1Zz0HFoNnGFv7gRp6SPZnuUBPIFuufk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S9HssydNIy6aV4-JrCeWaliZJsySLq7e4B1YgATJc7g&oe=69E21E0A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
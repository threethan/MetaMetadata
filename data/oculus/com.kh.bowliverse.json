Hrw0IBSiYUOpKsKI3jy46i4u3e4ihFq9_Rq53o0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CV3PMiigqvu9Z_5ajlgt6QrXUW3NieAcrmrmXWD6YkQ&oe=69E0F5F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8CAEIWtrhwQ7kNvwGutbXB&_nc_oc=AdquIbEHfGVBEmr5uCvmKJXM7-lLfdMAfoHpap9tmF-Du-vBmotyP8bE3xcSliudi9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kC3pK0WxexDSFwP0febqKUhEIFCqBenP9umhOpgQPZg&oe=69E0EC41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTBkSrARDssQ7kNvwFYYEST&_nc_oc=Adr7B4lNYGbwA_rBfb2MNtzzLNo04YEJ_RxyD8xXi3GQYgjBVj5dbe4pQrLNtFgRCA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30Di-F0j-Lmuf9XgEmctUOzvhoN8e8VFECgJwxP8t2Wg&oe=69E0E57D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xutedvXoHAAQ7kNvwFbJx89&_nc_oc=AdqKNVl6A-LPlHmJqC6wZnJpkAq5PEVlk0Ums2_XxzmgreKrGT8n45Uh0Qtvq6wA3TM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g4022TV8fS73D_wkDLsvjiFcY27IApDggwHbQtRF5zQ&oe=69E0ED1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRknclrPPOcQ7kNvwGEmzDW&_nc_oc=AdpOYu8gvfcpggej6akDPxsliEoIo5CFiS0XDJyhLkfpwQToM4slrp5WW4jHkE0_zbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SDcKQ7h6t21bChdCsSpVotDGXkvMtqTR_o7ZdMHW6Yg&oe=69E0CC8A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
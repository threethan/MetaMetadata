geDgjr_zoytwTyqPbnCC5x5s8ZOzKtud24ZNjMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k_48P_5jscNvNn8ymKbhfncQF-FTg6ZQgRgZn5yjFfg&oe=69EE24F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9t7E7Mht5gQ7kNvwFah6vf&_nc_oc=AdpJStK8hfx1RZlLTftWHA2P5OqRHrB2MAKsgMYxfGG01wr9zU-MUNxi4c-8Tx8ynZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iKeTxWziPZfIzwA97wAHkIeVgWdUZeLwnkqvZKZloBw&oe=69EE1B41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8b6lYi_E9kQ7kNvwGno4F0&_nc_oc=AdoCynNyungExr3iGfdkD2U_G7-zlYr_ScwjJbFt8Uj3F19nqIf5ng-zKRd4b4So1kY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ezZgvPztDq0NGUNnGcjEl3nw3gvz7iulB9BNEijlvSw&oe=69EE147D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0gbdKkcOVgQ7kNvwE0kbt5&_nc_oc=AdpV0szlzpeg_o0O85IEoOp-ykKX6TChML1gyZgv5LVpbAcreSW6HjyfKkxxPqFvwOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SDFaMAmfKb7_M9S37lXAY2Km5vYrooRc1y55dykvwZg&oe=69EE1C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DegMZ9o-oYQ7kNvwFAD2bY&_nc_oc=AdonjiMn9vULX_4_NYE-YsAUo4BdBVIDGlYQWzPqFOQkoza9VCF8IglOslfSVWCOzDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06v2bPaDmyc9vlttdsY59P5FqaDirrcybZcs6FkFzm_g&oe=69EDFB8A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
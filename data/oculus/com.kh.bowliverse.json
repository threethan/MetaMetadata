JvaQLm0-UmENwDoHsy8B_Ma7Z-3zvPOLEBSPhj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpqcScylLnJ0Bt9cCoiKf4-1RXSMp2qTC6MhaL9SVYMQ&oe=6A510576"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JipjgSwGB5wQ7kNvwFWNmI4&_nc_oc=AdqshR4jhjFO-0kTqZ0iHtNaCaOmuJs1QACYOrJIOv_56J2_WnRwmVPgiCSj8s7kSJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPYtKeC-chQqbRyYbFhSr5N9dCxEJYaR8HvezJjp4VMA&oe=6A50FBC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcT6nnZxX-gQ7kNvwELsTnG&_nc_oc=Adq5qNRbmokQnVCO44KthhT5s3K3qSgUbRpzaan4AjE-mZ59RlycYIYbaiqZ4JMpKXg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtns7yZbIfK_91A-f9EfCymXE2z7_oumH7wCaL2BoFOA&oe=6A50F4FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs5j84vWJ9UQ7kNvwHn2j5D&_nc_oc=AdpQbo-kdQL9A3uxaB1Pu2AAJkNBgaMZbApde7mh76VanLagooUVonX5T3F16rYIzjM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeznjDMsjlhABzynmVSS3B9bhsnmZehVETw0an5ZaF-g&oe=6A50FC9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWnRfK2ACVEQ7kNvwGmfKEN&_nc_oc=AdotMvoLSEBL1As-6QDU-4vW2vJfCc-M5i-7OHdMNqcVP-VCSUuPN486Y3ZINwepNhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEI_Na2TVMcxsmrc3lV7FNJmb3fcKBkzs5dxwurtgW9Q&oe=6A51144A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
7Mmy1jk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6LGBoRO1RtOXpAhOaEGKerSSuzWCVhofbEQOpd2uaMA&oe=69C00076"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cwn2rvtyMGcQ7kNvwG9Ygcz&_nc_oc=AdkJdXwZBBuvdhlsfgmVRpuW_IqtOoErKsKUtefRFhBgFU9HoP0enm4lxKnjXGQAbjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfziKFJLVXDnh4eyg5iPklOzlqEihXQcAeNS6mKM4lkGbA&oe=69BFF6C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXSloGTv6fYQ7kNvwGWOX-o&_nc_oc=Adlxu3kLWIRb9O1fhz60ypj8mF6KQvMLNMBQxXOgSNnZlB46YhPXNoHuq6TFbgWnl-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQp-3hbXLGr0N2F6Rf4dzmxnYDRk2qfcP6D726d1kbyQ&oe=69BFEFFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=269HN0bbeukQ7kNvwGyLk6y&_nc_oc=AdkLysGwulwXOOKsO_xK6A7Ta-cKK5Dwp0u9chtdYLnXwqAQ7jTLOSg3k4pxcQENpVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzwpad9E0TeGXD4bw9pgc7Ps7XCJnXXgGgd1SvZ6Fji1A&oe=69BFF79D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRuPVDURG7cQ7kNvwECAls_&_nc_oc=Adn6D8FvLRAIyc5EWIust33PShVM8MN-OfKg8EXOyN9nwPBvlqzd5h1eYEFYi5243Pw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKc9QpYRC4-6koyPkitVMZJ3joFSNuOBC8hFWgmyG4mQ&oe=69BFD70A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
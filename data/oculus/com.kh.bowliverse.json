PC6Qy8LpdxfSPr7LURmlFTHQc59SpiL4aQzk_fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF_2g_yq90Jvaf8c1-1Remvpfwnyvm-QODPmRNw8oHhA&oe=6ACBA0F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNtMuCUCAtcQ7kNvwFo6Nun&_nc_oc=Adp8Sr1sZmtQYbtfvVRaMk_x4tsBOhN--cyeTXPkuB4qUYKmsOdXaxz-zjSCgadqEZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9j8sVY1KYTeWalQABSk-wXOBh4RVP4DpKtkBc6WYBIg&oe=6ACB9741"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNSbI28W6qkQ7kNvwFVI2Jh&_nc_oc=AdoMs68axlmRVy-7m13mjZwRdqX0DrchzaAMY89hGAUHb-hj_mxdd5bmRVNWDMzf9Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhcX-VgHRZHaMUTjafgY6O4yUw_rklUk8oHn2-iya6Mg&oe=6ACB907D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szCk-Q5VxikQ7kNvwHy5TOH&_nc_oc=Adr_HMKZOlKqzuqKgt_JVLk7_ZV4GpVy_la3ChfHM0w3bpr76mcsvbWtb1WsbuUa1q8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyO5H6u8q2_tHYl9nC9-h01v8G6pbP4aw3EDT63JP9MQ&oe=6ACB981D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExYAzdA46RgQ7kNvwE4j1d7&_nc_oc=AdqJQA-4_wQSituh-CQwKkZ8Gc1oPg-GwL6lbe4i5Ub1C6QS4HR5Gl5t3wxCoGWoX1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeNRla1aq718bHyA8jrRNP1RR9GqTCAz3zx4qeK9cIeg&oe=6ACBAFCA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
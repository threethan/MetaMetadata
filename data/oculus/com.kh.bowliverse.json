cwCuksADwyrWjydeeTv5QwSC9nWgpCVxaoSL_Fk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KmncL1qs-BSXx8UK9Iri96g-D9NPOBmCjJO9TBRqU5w&oe=6A0B25F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbENjDUiMwMQ7kNvwHfdKpN&_nc_oc=Adq0gPdLhddiQcpPiQSR3n5SiiWr1iL7EL7lVP-TlD2YsC11Lf5ufTaOtdNg3CwDIrY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_sxqZIP_zAqz7TbrqayGnwGcSPpEz9fM5qkVvUqVm-Q&oe=6A0B1C41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWiKGDNiTqoQ7kNvwG6Xs9q&_nc_oc=AdqdLWmMaWVwXlZTlhytNDZ37Nq1suqnPvIwclvxuqOw8QWiq2FpSwUgyJPb2Fb35qk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G34n0yJkeimqSHxSQHeFIvp7OWhImEdDOCAx5YyzjBA&oe=6A0B157D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6xyX26iUFMQ7kNvwEoecna&_nc_oc=Adoc3shyQgrQhfQRRhfnrBEQ4mK7jyV1sjIkyfTr46YD9qSDV9dJUfRfFbWEs86cBwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mM1YrGpWlwjQaygKNn6dZgyZNFYa0e77O7yuKYqpLUw&oe=6A0B1D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ndx3eJP0_UQ7kNvwEF_6Ip&_nc_oc=AdqW9d37amu3rUOw92pNMe8jb0cfwmHWgRde4J_Hq-pVTHG4EjoIitROTfGFcrEt45E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UmKvf3jHPGkPZ9BLBgrbNU87anT3-EFJCpgBvFuq1iA&oe=6A0B34CA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
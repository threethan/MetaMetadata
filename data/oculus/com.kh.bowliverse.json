Gn9nfpIyspICa8qn-SsbDgenSrWYLLzt7NolUyA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gjp6j64XX-LENzjdmWFQB1G_3v36MqfKUHNe35zRqiA&oe=69FB53F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMr8Wrg5-6EQ7kNvwG9HuOI&_nc_oc=Ado_vsA_P7ucKXNrQrGa5vMV5i1EGuv3zlbOm1rdGeb1pkQYvArCx6IKQ7R_Xhh2OLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NtgmJKRvs3Pm9fudOVhtmj1c_70utOM-yaeeI3cahYg&oe=69FB4A41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaJMPhyusFQQ7kNvwG8Dnsk&_nc_oc=AdoY6U8SehALwBJneF1dF1N1Fg3_4Vb8e3SaFTd-w8kckbuYxHbucUtsUd7UKnP1o4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NOI2K4WMnxiqWZehJJItnjI1tdhYpf4uSuiCSV_9euQ&oe=69FB437D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIRtIiIcnQEQ7kNvwH65jCH&_nc_oc=AdoXgvs62gKhLPSBCsmVR-0_gAvVAIe5n3Ar5gJVxzkR5-rfQt2JBayy7Or4CRWDTK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41vVfskhgfyPy14F4Wk1yLrmxU0MZr0aqbaLIDBSpixg&oe=69FB4B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4y9XV0kdpwQ7kNvwFc93de&_nc_oc=AdrL3nfdGmtEzqohp_FRU_M7B9Z1tkYXV6AbDzkMle6dnheFSIjalgGAaApLRsvBcsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y4C0zKH0q-8ph-rBL1itjg8IQqtG1n7l2dJCmMxDxYg&oe=69FB2A8A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
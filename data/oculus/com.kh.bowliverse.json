OtnqxkaT7iTFS1CheYguzsGHoRnMzv6n38cx3cI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56Fgvdk1IZemX8ACygjSJXVorbHLysTcFOYxUviTWcjw&oe=6A09D476"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meNQmPS-e_UQ7kNvwH2r2dC&_nc_oc=AdpOMGP1FThApm0zpLh76U2hbn6-K7A0MBKy7w1nC9egMd2MuD6rLTqytRpE_FjQKSk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SxVXqg8---oBOzaYiC2-oSlPHO1z64GOxuBJdsYL4oQ&oe=6A09CAC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHnIYoV1GUgQ7kNvwE7pZ5K&_nc_oc=AdoZgOegsH7gemCmHBRdpzK7rNDZeIdsGmZm6jcvyIAN3m9OIk1JM1sb_CVXkquhA14&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h5B2vum4Y7BpWN0comr15y751sAWM-jAgcZWd_Y5Mrw&oe=6A09C3FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6xyX26iUFMQ7kNvwEYWKvk&_nc_oc=AdosknEtVHFqr0gPYSLaD6BpGo8RGnnF8cCCCYVJSlNHLMv1_nLJPVsEWWE2p9Cf6-E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MVS-gBr310F2uEKwZABhEyKoOXLACrlo3W1aDAGQR9A&oe=6A09CB9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH970TBfoYQQ7kNvwGBy65_&_nc_oc=AdorEuEtWKHevjmpjxg93N6WJ4imUDUfNZQcr904AJGz-BgdNSGWTseHz0rhofiZeF0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5utKyKG2S1vmbtVlQwG4TbK2I_ioLCFK9WH2giWx-MBw&oe=6A09E34A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
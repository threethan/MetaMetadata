w3BtASfOAjmZO_upZtmWvPvZele1lahmkemgi_c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zcb6HVNf00gfO4E9SImFyganQ0PDa8Msyi2_pt0yIUQ&oe=69E63BF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xbIeRm4wPcQ7kNvwHnzY-6&_nc_oc=Adrbt2lUlGEsGHH6W4H4HFoQ8Aj3MQhmC8M5jHlOBcXoU4aQT_fi8QrFF-6gKifBpJQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fXHUiSwOOX1BMXRvI8lEjKVFxySkWjcMIW_WHP7CNug&oe=69E63241"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j620jBMwLsEQ7kNvwGZW4Ep&_nc_oc=AdrZjjChWIC5zDm5Xaezn6vLNdmeMdxxHpqZ52kyT02ZwYT1l1MsWbidkcdtw1ucwhw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XbGwXycnXKKiJgpasihhJA_iaaBLvghnfZrOd2z5tzg&oe=69E62B7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiAIgJ4PFlAQ7kNvwGqNroH&_nc_oc=Ado-NvzXS6-Yekyi7ohuWeWDsuNldYb1UKlJechE4EayU8h3gJM7LDe9CnXPqvywIzg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cw5VWylDfS3rhQwljL3Cfl5e1WFsfobbvWT2IVztQGg&oe=69E6331D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGq1iiFkCvgQ7kNvwHoOtUP&_nc_oc=AdocO74SaAS_tuDNvcR6BxGw3qdT36iB--RfcxjopOmdZT6qX3LS_xC9UgaiUKRTc3U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YLQSjsvy-v7mtno5qoESGJiUT6XLz0mo9dU12y_QzkA&oe=69E6128A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
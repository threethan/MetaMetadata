8NZBdafdstdhSs7JhLrwzUn1KPrNTEuw6w_rUMQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOERuLor0AI_U15c6WBJM8a0UK2YMaKt_Z1klP64pVZAw&oe=6AC7AC76"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jdqPWVh_HcQ7kNvwHlkByy&_nc_oc=AdpP05n43ZwAqwO_-5E1qlc5gv0gJ6TihyQC6HG2PyJ2WBxGFflabQg7nnLxbi9l9MU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJGC4RuGbboXYzAsiALGAsIRnUi4fLitaBxiLI8ILSHg&oe=6AC7A2C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN7qgCpE1jAQ7kNvwFlK-Fu&_nc_oc=AdrwS2dH15SHUSE3V1bhzhJn7V1-sd_9Ehs46gZmAYDExNh95x-3a9gQC4MjyhFJkiM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQlX6WWva-nhQ3F8laj28CBGozZsN9CYpUhQlmMfz9aA&oe=6AC79BFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Rev6FAPyxoQ7kNvwFCuXlD&_nc_oc=Adrdhui4koIoX2vShv70O-GLe436MFS1oTHhVbXik2LadHv8dmgO-QSen30qALDyo-g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMllaGClhwqemAPwV9KrXwkW5L890L3pJyjKC7csZ0dQ&oe=6AC7A39D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t0-Wj-s8NIQ7kNvwFWxIaJ&_nc_oc=Adq3rb9FhVsaPukxdxYfx3yjWZ2ktwks6IZb45GAkeBjgkUQOhbIECB_JN_h1nH1HlU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdk5DV517yerQn2Ynu8FV88SI_CjIG4vpmAPyfd1e1hQ&oe=6AC7BB4A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
bSO5vmcSipVLtrHKTg0gcMVnbwZq2d7M8A&oe=699D8136"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4mKoNiXZ_wQ7kNvwEAmSZn&_nc_oc=AdnoXrmBmA90mjp3Ej0ijjSuZdYoLakLg_u8Qch7Hfeo8WTcKxh5EZWDZ8rfg463bYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuznlGaOFjoAcbLf9S8VsAXe2J1bf6wDv-XZPBnHkfdQw&oe=699DAFC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69q5POFTREEQ7kNvwHs1xJY&_nc_oc=AdkuaCYZiWGspwuuoIRLD9_JWmzd1imlRtLGx1P1jjEXV1uUx0TyCZlnKzIC9O1fppk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOMpwPIomTevB_iZCgLS4gaNzn6lVdASXy8aFn--t0BQ&oe=699DA8FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHrtAPslmNEQ7kNvwEEwCJz&_nc_oc=Admsf7L-9sX2PU8KUKOqIZQAnuyZt-DpND9QhNyGqoqMS8R2wJDaO51OVz3MerGaxhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsbU-6E0MchAII8ljXkAHrJ7mgH7Mf6HPqQRb0tkT1wmg&oe=699DB09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWkEAzvgKloQ7kNvwGeypEF&_nc_oc=Adm2tkvHBfv8DaSe9l_rpe0Td2TgUVTmXhfaJQm5sbT2uRyVUNmu0UZuXP1i55CfetY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEbpWsLU1_laAXQADEQs3CEmm7ERZBzoHKKFJScinwFQ&oe=699D900A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pla
DbZS5QY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNlrCq2XheDa-lm-EvihQAvv3d-i0cDsNJzhK-coS90w&oe=69B68DB6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W97fuKfkNsQ7kNvwHQaRyu&_nc_oc=Adlr0JIIvgx6VBGltfCrscF2R1kUk2MxtxfQvGlIS0JbtkccJFhY0ymws6Dmn7xbksk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-25egMB75prEQ22WTo4FNziYF8Hcrp_Ba40TD0L8imQ&oe=69B6BC41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obaMSypVPIsQ7kNvwF3wAdE&_nc_oc=Adn2XsDhO8slgm-9ojwY0AFAkbmnnAvR2HfS7AhAkAhop78rVUVG_M0CZiF5l3AXd4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHvoKgGI3x4uiljbtqDuZZJsnsMb3flwuWZwO3whk3OQ&oe=69B6B57D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6JBKeUcPYIQ7kNvwFs_wq9&_nc_oc=AdlwOI4u5Pz8OnKvaTWNrTrLKJHoFxoeU5PxLneJa-CtdlqWul0EtgRI9ks9fRudBb8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyjtf8oBTprvAAYbONEZgwVSo3jAuFcryJ8SyT3Fer7-g&oe=69B6BD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrIiImok8rMQ7kNvwHR7r2m&_nc_oc=AdkNBeMYTNpto-9lPCdFd6A1ttmjBBgnxX6IGyz6OOsO4rFWf-7MIYoXgSAOog_U_dU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyu6zdBcqFqYJ9eSAQQzxcFix1k9FUhsGiAc0aPnyfI0Q&oe=69B69C8A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
ap1byIpoJHl9MIApT-iUeCJvlHnoc6rGs1YiYHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z0X-v9YNYU44IOsQKkNcHPlJVx8AywiycwZ0MphqyDQ&oe=69DD0176"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZt3n4gq4bAQ7kNvwG5qOBK&_nc_oc=AdrHmSBVxC6pTqwjxHxdLvfUwBSaJ47OSCIPIx6ELSETbZpXggefCirRDjeFns-7Zak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Web0gHfVjJ7NJBSpf8M-m1puzyJimydmdDH3FUuJdag&oe=69DCF7C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZJdcZvKy44Q7kNvwG-Wz3B&_nc_oc=Adrs3w5y6gKHfXpkl_zf2_t2u2UX2rXABKpZCegU1rthn88dZtnbiMnM1eadQvQKk9w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lDc6woUGtCz5YAEP-WcrK0rR44JHP64-Prl-yjx5RYA&oe=69DCF0FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-oV1TF4xdoQ7kNvwFLlTzJ&_nc_oc=Adpg3bMWkoksmf6GNeUhG_T-UnvoQkXFMVb7-jSM5gdO7fqhcDy4R3UD4a0Hrhi1QJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YwBT_K_67QiCwt-QEZ0TgvNkqOpXuNNyHPfjHWZvAiw&oe=69DCF89D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C9vIwnj5akQ7kNvwHmFjZl&_nc_oc=AdpT85xGA2OxwNx1B8ADTZ1kwSOTBjNK7pBYjkRN_Ld3sgiQfjLHbJf0pG4jSgJb9zI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T6wTjl7NZ7wJtsU4ibC8pRTFV-NrLu4Q15at84J0nRA&oe=69DCD80A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
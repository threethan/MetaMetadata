OREpbP2T-WW_nrdAjPHUmuKwLxm2CcaP5i_0CWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK9WEFt-9oOKZCiPgMLssmjzt0qnqN7g48erBbQxeETg&oe=6A5B9176"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0pUMuN7TKoQ7kNvwGV6G2h&_nc_oc=AdrQojcAhrgk1Hh1PBf0vUCaDSZv6TbsBZc9UA6BnoZ5XZ2F0ec_WLU_4JyxrzC-1oM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPjCaeFDnK_7D1qGdHabnJVCLPQKfJD2SmU5TCji6rNQ&oe=6A5B87C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY7h8fKZE_oQ7kNvwE4yUmi&_nc_oc=Ado5d55yHTHjxwisaqAy6f4B2JfCbfVKKDGeIr4flp_5ChDJOKWDNBZnR-1qT-QCNCk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGi1WdHS23hzXj_q5vPGSpObxBtyLQSU4Rjj-oFwxN2w&oe=6A5B80FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x5VmFz1PfoQ7kNvwG3LQoB&_nc_oc=AdryYyjKwohKcWpjas9CKojoAfK9nsYuBUpZpud4EL-vuIkoQO9veEqucAoq8zBgCNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5_bHehWnir26vd1_Kb_R686mT0lvL6P8ADRpi0MKL3A&oe=6A5B889D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGsYhkovHHgQ7kNvwHoCCeC&_nc_oc=AdpHkPn5KTdHLmJTVpXvP-Rt4Ki4b7dr5G9VntAXOgJysbCELcZmpJqBGEJzxyk5pGw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtEZO5VUNsJ2l46t3NrGvdvcQXSTQPEAoUwKZBXQrGcA&oe=6A5B680A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
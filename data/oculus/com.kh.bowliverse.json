R4L1eSoacES6tObmjJ_PKkORuCzCrMwo_5qMRSM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FksF2uGwSBbIJKrWkfBbjHnA8ZkOB3RP4wWK7OsBv-g&oe=69D7BB76"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsUOeOxMG00Q7kNvwH1cvk_&_nc_oc=AdomHXaDgj9SqkP87wZrNoyR35l54EJSDw45mvsYlrXKOoKJwqCvflwpgG8NBBG81QI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OFKjc67mExQ87rOyswHBi0evgU2lbqvlq5YyFbaLm4g&oe=69D7B1C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4T59eIc53kQ7kNvwEM52tq&_nc_oc=AdqkCGUV9iQpkb7SaWvI3w_5fHlnJfbIr-Kx60e_NDCJ3m6WsAJBBTI3KIqPqnzxCb4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SoufOVgRoF_NrTgTx8Zvv7bgIbNgv7XmG6wbC735oOA&oe=69D7AAFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd6jugGiCXQQ7kNvwFcAPeO&_nc_oc=Adp4K-UGy0GZhcs1DoCi3-PIB2EOBW4HIm5685_TIF5yBFf9BjdptEzh9A6dJSFhjzA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Wj9pvGNSuYva8B0wHG10v3he_zxCkQQqAah-KtHc0dw&oe=69D7B29D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFv0UttbBZEQ7kNvwEgU2q7&_nc_oc=AdooNrlV1FqR_DSQ7JZ-XxYNiqniFmpwvs0b3pUPHppLeWqbJ-uwgSqRMZFm1ghLszY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R5nvqYRiHWLmV5FZOKKy2t1AuKXQmyNQN8C5TGpt8GA&oe=69D7920A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
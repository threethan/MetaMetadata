kC4GcRBXHiVftyEWsp7Jl7QkKLX_bKMqT9torlY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRNa-o57lRLsIZBDuH3-DpJGpMaihXBquYJ-MyTN46Jg&oe=6A9409B6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l12NL_yCTBIQ7kNvwGaAIk3&_nc_oc=Adpzj5ND-qjPcqGm78-7kkOPxlT7ER1ENprpfslFF7g-TfeADcNPoor-ugbXsS2m2Ts&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEQqZDk3v1ru3kJ1imRdBFdTxa82uaNVkGPY3Km7OJKA&oe=6A940001"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I52o6MGYNu0Q7kNvwGCDuZZ&_nc_oc=AdoF-atqYfSZxKUqZ1w1vt7jn0zxIgFq-aTsmSXm0fjZGB8umNMSiKun0SzxpXPVYMM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOd2Ge9IGdTVI8kmmOieapaDjLgKB9p3emtQsjlep9fQ&oe=6A94317D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axei67k-ZZUQ7kNvwHVmesF&_nc_oc=Adq-rG9zAk6UFgvtX_QAjDr1CX1mAvi-TisRzjn6jWx9BebabNcldJxjDGlsV_uqTAY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2RsRRRoe7eSoA3zzGHKRGiJqYOHKdij9Kgga_FhVtWA&oe=6A9400DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScaJyR1XdjQQ7kNvwH-WgBp&_nc_oc=AdrYjU6dEspFleu81T4niLU9Ahy_z-tKtTUYzR4b4QrCrG80IQSOM2QqjzlXoBUEO9Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZfsmvOjpzWjxq8aSFHyXtSmi1zfaQUJrOtpVWTgu1YQ&oe=6A94188A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
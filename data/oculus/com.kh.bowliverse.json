0SnYKfBfadaSc8gxkj3Cl5ba2Pvq0qMT4m3Yx3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Xj4_5nc6pFCZGSVcBvIBsFuZd9gyDfcNd-nKLz6GBDQ&oe=69D669F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0a668vsao8Q7kNvwHnSXXT&_nc_oc=AdqZOI1s0Z-Pz1L0uI4isFAECr3l5Cue-tPn6OdcoBtQBT_-12g-iYd0TTABSTKv5T8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QzuUl4hHt7F6t-FYmJxAk1jXKh3MIVzt7h4H_fbYvHg&oe=69D66041"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1bXMTE5gKYQ7kNvwF9L8bb&_nc_oc=Adqkr-YibYL1EoNVglv08nbNYvbXVqh7KRaA_k7J3DromGkMhkHEVan8y330_bEezx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04iqdd0HiWYHQv1rGW7SiSi3qRV3XatBuTPtyZQgilbw&oe=69D6597D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd6jugGiCXQQ7kNvwFyTd4L&_nc_oc=Adrnvau0z3A6kaEUff0MPIAYxkVdiHIOSwKWOwdN_2pfPEYQMAbd0lDB5_AhFfnDg08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P4EYc15v0kxO-9Pex1J_QQL87E8BPHsXOj_1xgCNt6g&oe=69D6611D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O95ccnIN2qIQ7kNvwGFNdZu&_nc_oc=AdqWT2YjG3rfAgyA-ncGzexdFAlGf6m4qyqlCqU3r95oX9r3W1BzplT-bFKevjNdEzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32jCQDwLXR3QFsmyrMqhjBlDf8UsicLMpU4XxO9nSrhw&oe=69D6408A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
Mqaeuap_A37K85fEwT32u1OQQ7EdWxXfEso5eGw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiRWX1wb7Ad1ZGY3IJP3qIaOR64jXCz8D7ymKmvgKQ2A&oe=6A661D76"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04KmP6iRYlIQ7kNvwEdQznu&_nc_oc=AdoLhf9et5X68iFMPVIwOhpwkyIrJBxrnCZBnPPzSlSz8o3Dioo96FGuK55WK_0Qyj0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaGc9SJIqGZaE1QD4-00dzPBjuVRrrf9f3dLbg14MH4g&oe=6A6613C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PEz2e3KkCUQ7kNvwEtDsQQ&_nc_oc=Adrk2zm_vDXUyqD2pmAT1uZ1Eb-4ihG4VUT2GlNLBKC-L1lqa1IRI41-eh9MiA9WiZg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCggkcExJQIIs0aU0GQatva4mJbibE3FVc7XMhQnvMnKA&oe=6A660CFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lIw1U2XVQoQ7kNvwGV2RpE&_nc_oc=Adp-nq44YvaWXHQB2nFas85iFbh2ZBar6i583bT7HsQsp8WfBMz4MsHVW1E02O6qiQ4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjHg-evIzOp5jjlr-1OYJSYOHYreOAMLVk2YeZrnHLdg&oe=6A66149D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7Mjg5KBi8AQ7kNvwE9ogQB&_nc_oc=AdrA7JVTvygksDQLwREpnl95R9fZYWQjsEWzWro8oFFlErJ8wfWauynf7baq1iTMPVo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiKdsroUXanMaF7iHdCMEJ3j8uchtL1Jik_bmIvdA34g&oe=6A65F40A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
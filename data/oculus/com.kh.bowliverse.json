7I30Jc49rYA7gpWNsAsZBOQOuEP9Pmw1g_PCMyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgVHBCQLDlXTrxKzHIBu3DYpQv3ISo3hIvO0UNoVgonw&oe=6A7B3576"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18gyKyvjC7sQ7kNvwGxFEdn&_nc_oc=AdqCqDNHR37ctKaq_0pOd_wRByywDPpByw21fVWwU3XSltAeBg_fWNDf6ThREmsDbgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtxmITanbZ881xkuNc3meOQI1NbeGJi70IJnnyNqlZag&oe=6A7B2BC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3eCr-olLNAQ7kNvwHNQlNI&_nc_oc=AdpmKJEFgVlI_n1oROrQmyJXdLYH96IsqJuguC5c__Exd3dgw42tHfvAn5_KDJ4c_Ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-ox_GAdOLvmiZFVwB3uOWunjjwCfyl3dS2RCinst6rg&oe=6A7B24FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57uMup0ip0IQ7kNvwHt_19x&_nc_oc=Adpym0mzzIPWtBNqZroOOxN5xJvNTiGy4LQo42mM-iYjeew9XwAxvuHqVS5xsQFfZ4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7UH2LcSN2a3HHdeCH1dWhLfvTKYVJTosEOuDA_cwtfw&oe=6A7B2C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWHe6LIfqikQ7kNvwEdQS_Y&_nc_oc=Adq244km3uvTPQw7rrlsnazbwTOXlMltR7n-FdlCkDkz8I8mN9QeChR0NjHkpRBE5I8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLq1cGDRLjX7FmoZVt0mneo_5XPHakGMY7srxGUIzvJA&oe=6A7B0C0A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
oRvVZl94wQQ1rkLGKCr_tF8Pt4mCT85xvD3Mihg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtNetxv0PNumcqM59bBRU7SvXQecP5l_C0YA2Zd7Kg0Q&oe=69C697F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_5atINEoMAQ7kNvwGw4cw8&_nc_oc=AdoOdVe0WpJ6ippCg5rZWSH7Fkq5c8pPA7RoDHBwghIfbMv_D_mztFZpw7ty43Loq4s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5Zt1-4Y1dMScvYWBfTu0WJyBBZUG1GqzLFYeh0Q4XbQ&oe=69C68E41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y66JbM9wUagQ7kNvwGuYe9O&_nc_oc=Adrg84MWmeUeP9CkLuFnqeBZDq7eq3atxo-4RdKwTEeJ1KXLA0hMhDdyDxjkegcpGvo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-XbV0Hej3gOU1Sakpi-xm4mkrF7E9ZT_ArWcaw1keIg&oe=69C6877D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySgS8N27WPYQ7kNvwGQueTs&_nc_oc=AdrjLr3P8GRZojDyJ_Di7JYuXQmZ8Sd_yAh47JnL-KPH5bEqHKMJjnMlWL5bfdYrN3Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfeQ3NQ1vYtXBy34h6GDXc-xGj2mCDSEx4OakHDly34Q&oe=69C68F1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssAYg-f2lYgQ7kNvwERUu5R&_nc_oc=Ado698l3vJWmoOEKEi3kgFdyybjzWx-7XJa-pZywhUvRIx67xMJvAmo5n_yyonW2ITQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHOQxVO9CnhlpyM8R8JQDVU3g9QrUnfgfRkmhvsxVkDg&oe=69C66E8A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
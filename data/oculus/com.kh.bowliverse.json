-zDEVp3zmSR-LgJCmSby-BJ1HvournlJjt1ARvc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNd8Vw0GWx0VYbQnGoo9SeyjKopuMFXdMB7C8vt0g1vg&oe=69C7B136"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZOGPgbjDQQQ7kNvwGBd5Mk&_nc_oc=AdoUMc6sQWws8f0qyuCGcbmdNGWpN4fJpt2mryMIoaI4HCNFUz0Gg9NgVkD3TXht4rM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrVKnD1gVXND-pKJCHWyT58J4xSpoQ_SBuPWD4sQporA&oe=69C7DFC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ9B22cCZKUQ7kNvwHeW_go&_nc_oc=Adoy5ZoyrkYKuBQnAkTxHlIsSngsTyQ_77OXUH1n7XPAv9BF6P3UfKXZdRqwhPMDNek&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8HKHv1WBXNLegOai6_rHt7nVVfMw3U0X1pDHXTtFVsg&oe=69C7D8FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySgS8N27WPYQ7kNvwFYScG8&_nc_oc=AdqbbaqjcN60R2DlV53Hq6HzYYhpQj8k2WGNnzeWgVb9-1OQ31q_3h1-2Dl_25qIKSU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi7xc_1eTN-oTAS479SB4OfJ8bI2FFC3d8hZLXjMvleQ&oe=69C7E09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNbbRDhwSGwQ7kNvwHDe-Ih&_nc_oc=Ado1ATnKF9gxrWWu3xlfbT4geLd_NhEzDZrMSZcE7S3oDAZsNJ39Vhra5w7Z7OKJK2c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxT7IAsr8ampro8Z3RjkUVjaaJSaJDOGBpkj0ap2LV10A&oe=69C7C00A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
MRRSkzXCSeHGh__0v3czzzJ_S3Z1UmDY4r3k7Nw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L1d4ASEyZxbeyzjL3rVAusLZkXHE37sUeH0-E7ZYyOA&oe=6A3D3EF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ex9sL8LobvwQ7kNvwFbm_wZ&_nc_oc=AdqEPM7QewNNDvaSuUGFFrfh0xnElPlHXv2EKBJWVEb8fxREyvYAK7d32acxoK1wdtM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D1pF5sr_hq6TMvrH-9NeADQAK26nva_MJRaxUnvwIrg&oe=6A3D3541"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBzNcAM541AQ7kNvwGIMPc3&_nc_oc=AdpwqJey17bDbYOJm8GSSdP2MDITz1EK_YUJlqO_3nLpWjWvpGmOg9Fr9z45x3jjEE0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YTNVPDioteLNpI0yh_ZfIY29tSO6nMl5rdgP-RbqGgA&oe=6A3D2E7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AxRlt_U6YgQ7kNvwE_Hz9X&_nc_oc=Adq7Thf-PLJ3SgMmOKYWgE3m25hTGIo3xiJnNnWZy038zdxHU0dMPX2ZrecgItp9UDs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bWm5FcWEtFMa18yURAVMpgbRXuMTfq6OfMFnFpIQPRA&oe=6A3D361D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DcmF9X0VVYQ7kNvwFqOwrr&_nc_oc=AdqrbEtabsPcIiKA_S0p47xlG77TUpxsgjhjr7uI7-ogsraL7Sv9GGuRf6AUzRW0bIM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lBPjkIMcJO1zOviOAcPne2wn0rwPCJ2q6XJUvXh50UA&oe=6A3D4DCA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
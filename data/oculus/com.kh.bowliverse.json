qqCeD4x1SJpAtICqHjlpuu_-0LCHDFSQeop_jmw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb369AMFgSyRE-SqQsUIKdaonZeUdueBCISGaabCTfjA&oe=6A86DAB6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-uuvVgkgUkQ7kNvwHRe9ru&_nc_oc=Ado-OFKeOIOzg9asIyHf-REwq3ZKBbl6ws113xEOQ4qzOWFGdLLDrjoCsFFM_F0Hqp0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9tZQ7Q7X_KQBRT9sT3CdwiAWSXi3iLqx0Fh3KZBiXJg&oe=6A86D101"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNC-RGbreDcQ7kNvwFy5eYK&_nc_oc=Adrnx7Cykvnv4cBGxxilhwftqyXm1oqDoGM9Yx2DjdlANEELlglV5YkhHYsDJurlM5s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRdL85-JoZhhRCdslhsgq38_wgyzp8DYjYMycT5GuUNw&oe=6A87027D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89jjDhLYilgQ7kNvwH0-lVx&_nc_oc=AdqLFaQeiajojn2IrU2X2_Ni6Ih-kdxjEDMJ2wg0jmpOwO9Y-zMM33XZGdLTFXqpeVw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-109qNJCOxENXthYfoc4US9FdV8Rc9Teg9X5NOM_TtQ&oe=6A86D1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULwOjhAwKV0Q7kNvwFUklVq&_nc_oc=AdoWoRqJ9BuwyoNKUZpujjWxnBrm_Co_MeXDWa8RfewWXRUG6PEmQEvAJr9j1uTBcho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGSWfRX_j4dbYR_TxhTsKsMDR9kksOEHsj0KpIzG8VmQ&oe=6A86E98A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
M-opMYGxUQ6p7D3Bt23CsL1b5n8lZBwn9OD7hSA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1zyMYHBb0KzCt8zjuWCDSg9HchcBBuGiz83zHN2zuXw&oe=6A71FAF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNHOU-vDnWYQ7kNvwEGFS6n&_nc_oc=Adq29CFc7dn1nzSdJO_P_pixGl-ts1LNlkf56e1kJB2EN_XMNIElkaUyiMnyVB1_6rQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFEMa6AW8MG9WxRV8CeIM084yEZPXkAx0tAE6iYzW-Qw&oe=6A71F141"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nkNcJQNuXcQ7kNvwEys6yL&_nc_oc=AdqsuvakaTyl1_aaW68ptlZmVH93HlVYX2cwX_ZU_W7cZ9W4HYtQW-iBrJ_EnShqFjA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHizES3su6XyIvmesAGr9w-9y4Ex1yxP3m_o5WH8TUpdA&oe=6A71EA7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvR9rEd9sg0Q7kNvwF91Ant&_nc_oc=AdoEFdh5rUyTyzXb3jdLqUj6qG8C2r5UUPksPVZtoaOLQQ1ZvelpalCV1BA60av7It8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJDl8IvCiC5aJ6WR0pH_NVX60lSE5T01g9pjgAm8S-Wg&oe=6A71F21D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMcWXeUIUUYQ7kNvwEGt0uN&_nc_oc=Adr73IqhwAtZZXPAKpbPYk-DBCbH_4xydJ5rD0tWHqpqsPFez5DAuwQHMMJ5YzRJ8a4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc-GQqxUayfPrllR6_778sPzi8sFufNHKn73JdylWeVg&oe=6A71D18A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
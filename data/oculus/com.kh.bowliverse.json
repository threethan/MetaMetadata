hgleg77HG-0IRiT_ILw6BxJdxj4rnlCRXOJ5B7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QtaBLVspCiVzf5i7wfAFeizIiWmmNrfW436wO8tuweg&oe=6A2AC9F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28DAJSPqr9YQ7kNvwEwJGnz&_nc_oc=Adp6hYwpKVVMUODe0aU7n69S45rEitzFgHJgoarF9Sru0NQpKPRD06fGysSIN9_RZL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aIdORsv41UBLb1jItXwrHbzcwxZcuTXA7Oy4DOzRgIA&oe=6A2AC041"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEytT6VuJjQQ7kNvwFilyDJ&_nc_oc=AdooflCZyOB71SzEJqOMYlzgZF3Caay7bHiN4CdK-gG23QRhB2XGGuZTbnz9R7qFvGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d1Qc1SK6UwPaq29nOT3h50wRuKmVSsNvMMWPnufz9fQ&oe=6A2AB97D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSbEHSSO2SMQ7kNvwGBlXUm&_nc_oc=AdqyeqYVvhb4L0Oz-C5BF2jQaJTQXuZH7SvEOkQ23bdlZ2OGKmmZjqhha_EUfV8rcJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92NX-iMUGex_YX8pwA5e8Fvp-Hgl9oq9x_hpsmbrL5DQ&oe=6A2AC11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3Ut7OdNFhkQ7kNvwF23dJS&_nc_oc=AdoKdFIpV_idH3D616G6uMPEOdSeuJecJQKKM-FM2QOsvZhYnaF708RpslR6kY9nTpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LoEEY9a_5n5Rr5BEBh66urkRnTsXn-sNsiQwQBjojXg&oe=6A2AD8CA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
RLFguCLrRmCuCWEW6i4hHxia3YogPefsu8YsZpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwUVYgcpoDft9e0dFKjg0kHw4QpW-4fd-btVeMiDZMTA&oe=6A5F85F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyP2FJnjkWsQ7kNvwHJbyXh&_nc_oc=Adq-RX0GWNwjIjBa1YhZlZ23QlLsqT1-Fnvq2N52Pdmr4ARgc84DPQ2kOJz-0LCWW7s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEKEjM0OvTDC1pFc7bRS8Fyxg0AZUnHOz5VZfiqwQPnw&oe=6A5F7C41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyGRst3sT2QQ7kNvwERBkFf&_nc_oc=AdokoFN_IMlfN4WQq2A-wNfY_rGR36YTF2kcHxwGSC9p7X45RjP1sTTaSYQjwMWQs1s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUF0eT-5LZJuTrsMwO0GjWqPqahJ1029VIy0dKpPW2Fg&oe=6A5F757D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KqhJ-C2mhEQ7kNvwGD7YBg&_nc_oc=AdoplaPJlOP98LySLofpUT1uHBgLBwOJEZDTNMEr0JFdrlG20hmCBURlqJVjZXiAzPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLbyf2j9B3hnONNO5MrCQN2-c6YmoRfyisVEAqaoxA-A&oe=6A5F7D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wo-9dttbdxMQ7kNvwH4KwUk&_nc_oc=AdpQnLTiXTu6FjFdznancLSkoTcEG4xf8EO9E4MNgGjRR8YR1oH6gvJt11_JLN0nEMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtrTgunoFw6ZF9b4kxA5_63vMURGRVljNve1_Cindm-Q&oe=6A5F5C8A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
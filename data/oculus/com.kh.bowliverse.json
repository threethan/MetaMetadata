BIaq8494r-Ed8L0OOH-1oo1Q-G_E979X3_wwnhY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyrqHnTMe84ACpVT4fOfxTnzZD9HsFmCmopSPDMiODHw&oe=6A804336"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfpvuVsFAhsQ7kNvwGUb_V3&_nc_oc=AdpEGkvXfp7FF2DYYU05WUOYAcE6WakCAsDhKJ_dEo9iauQWTilXEhYEIIfY2Bu_Kz4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXFGKVloGtfJ1O04VQ_l-1p1UXVYeY7sa5xnJ9CqHXdA&oe=6A8071C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7gwU9vNRr8Q7kNvwGmJSh7&_nc_oc=AdrakS1KEd4Jc5kakQD6sBBx0WtNnLmvYxnmNHLywgTjaLKsIMRAJS_xXacAvitl7c0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDE5MSBfhGhES1aUM43E-1D6M0H5SGl_EFAwjQMCFEAg&oe=6A806AFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoK057l2DfkQ7kNvwFHXc3H&_nc_oc=AdrFn1Sx3jdilrKm5Ur1v7lwRqGQRqIw5TSvSYt6GDI_xPQCWH8n71FfLR14wZgTB7k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKZt1ugG6zBTLaK7ks1iT52a5igj6a71agRr9xckxUmQ&oe=6A80729D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FgCt4pfj0IQ7kNvwEuQwTb&_nc_oc=AdpeR3FUP75kagllHeSWw5W-2xPqnPH6MxD-7RgNrVCfanAdHW_v-1Rn8IJ3N7BYqek&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvp-dZiDx0mXBmSKBbMc5PofBlLXfJh6bEQsZC6NZrGQ&oe=6A80520A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
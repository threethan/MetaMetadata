w8ww0YJM6uu_V7gLcHc676xhQ3NG-S2EumE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-5yzLS97AWHU6Hs68BCKHd-oNNyxA0vdoR0unZ1VnWA&oe=69C14841"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXSloGTv6fYQ7kNvwHCKdr7&_nc_oc=Adrq3Q9JrqskScRbO0f3Y-zGNYa0IAImuK6akTchy6eH5WFvbBAnb3BnsymOSN_YaZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZCXXN27eo-xeG3mjwGyQwcKYSXrcIEz2u3hwRhC-wsw&oe=69C1417D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H9ls5ifbtYQ7kNvwEpfTCQ&_nc_oc=Adop7NXu8ywhN9JkvY6oo2uygz7AH0kKdXjiv_z55akJVMC8SlbKOnDbwFoe2XF5Sb8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSHDHKGTc5BW_cgmJLlLzk4BxwOsMA7j0EnClFlSqFGA&oe=69C1491D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRuPVDURG7cQ7kNvwEpI6lB&_nc_oc=Adqnr8qNkAb-sEkeJQSue05Fa15b9uYY0T4a_X8fJpRQ1E31a64DgxjIZfJDXx0rVZs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz3XC2Y2jyrBLomcgPqV7sXWMSuwG67zL6aK17AR7jS8A&oe=69C1288A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8715910298425928"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"lat
KCB8uDVPLd14nrb_2CwV0hzucK_xZSULCFQ0zxU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyvvZAXYc8URip0hlwf1gxPgOh4DqJLwHP8OPCh8RO3w&oe=6A564B76"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5_TMeED1xUQ7kNvwFEDAGk&_nc_oc=Adp2aurWO4yrcqllcp3XTMMx1qJhLRoosqD3Xrhg0CAgUGWAHJA40qT_JShVA7Kf5K4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9c8PuYMASn3WU3rjXD7CwNoO4ZJyVodBg1eEh2S4gHA&oe=6A5641C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rxcY7BM81YQ7kNvwHz8rpk&_nc_oc=Adp5Ta7I6TUOj8U0TrEFZrMDBU0ra5yPJp50L2UwwKOBCUm1L8EBtfLvML3yzXb0r1E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZJydXXU0ScNwJBYgd1jLIB6NlPDBEWohbN9UDtuLb2w&oe=6A563AFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F99sRpV589cQ7kNvwEl4aEH&_nc_oc=AdqvU3jDYzah1QWJIAJhO3HQdeJs-bwi1Gaa4CxrDIUyYWPyO-wUB9PqKmQCfCFhztc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO04Q9g8O2_CXjTjScfBK38Px5dYJvPIBrUaQRrJKcIg&oe=6A56429D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znKcml-qTD0Q7kNvwEYOaX2&_nc_oc=Adqi0pqEobzKl6OPRhBv7JqXGw2Cl4ok8jDLtjYt4V6CzNJxmeQ_zdoyrpaTAHy6A4c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMKlLQVgWfEf0YE4gkSHMIIH9B-b-sN3DYZlSVp276JA&oe=6A565A4A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
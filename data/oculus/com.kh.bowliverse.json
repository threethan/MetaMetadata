tqA1a2m3tGH1jGULTLXa8yZgIPj-SIWR9IxlTiY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtgERYw6y6FDGPa8B2MLDhetmfy1Xwr3S9BD5H472ZVg&oe=6A5CE2F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0pUMuN7TKoQ7kNvwFbSymY&_nc_oc=AdqYQfC8TUvA6OZGgwsY1eA3XXmvHzxWmOQKFcZjQiHwT8Az1C9PBM_DGr20nWU13Ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtJkVON8Dk0GT7NisZfIBMUM_4zasVb5mqb3dymsrhpw&oe=6A5CD941"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY7h8fKZE_oQ7kNvwFqnKYW&_nc_oc=Adro3G-XFP-2U0LwwlwPVSWo5JUACn9ixVIt22hm6ayxSD4QzTklyJig4tknqU6bshs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsxVq9-v7xxi0eLZqXzHVEJckR_fYsSl8ApexDugFc1g&oe=6A5CD27D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x5VmFz1PfoQ7kNvwHMSIcO&_nc_oc=Adp_IXIZF_SK_nsyfebKZKLVNNwh3feOmAc-XGEQsO3rwC8JAQaCb9csUerdDUEMQa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaCuBibGMnh0tqEHA0IrHnfoRsBLlg-u2dEfWy0hUBfg&oe=6A5CDA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGsYhkovHHgQ7kNvwG8US4d&_nc_oc=Adrqg7HaTvqacLM-Zg6Fa0PkODWm669QARYQiGIawEcLeIi9Mlhwq9iYEU28Q-LbplY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj6YbY-S7pUZ4Rcn37ZW-w3zCNATm28KhHvjOwT8bVKA&oe=6A5CB98A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
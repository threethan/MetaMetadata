9SDGsakfTox5S6IGaeEICFaIKLX7dVnzEM8qq9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjUKCMScYygfVowLS3_p2QkqbciKj2G8dbhmyPSDQ35g&oe=69C93AF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZOGPgbjDQQQ7kNvwHV30ao&_nc_oc=AdoKYil9JD-feAgOrInd3wjuRxw1Csa0Bbogkvv3_odvHm3cYNZ36ScUPgPIWEY8k_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCThYUQb-fHDYXUBwipiahgiphGZv0r-tM9xQH_ag3ew&oe=69C93141"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ9B22cCZKUQ7kNvwHh6hUc&_nc_oc=Adq0OJh9B0ov-VDr4p3b3cYhu8kQgNsW4_8J_OMBhvJpGDy2rSclJtbleJvEZeyzWrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJ9bGmuSjjLTUq7MifIgjNvmER9P2xKrNfs8YzZJqYYg&oe=69C92A7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p11CL8EHdUQ7kNvwGVERdG&_nc_oc=AdockOBwTDaqb2suv_0lYW0oPhvscNZdMQ2TjdgMulMqXbwHwK7yVmWIIZpokbwm29Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoadOSCJHYLeHrOy6_sa1DprGhYkvBDrNn2v55ego12A&oe=69C9321D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNbbRDhwSGwQ7kNvwGqIPdm&_nc_oc=Adp-QyJKYIqE4Dx92t75x_qtTsLHwTDJvFHFRG_qwGEjCDmydU-OFfWBcmJSQ7G0_6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzW47nsukRgXVMIQGWYjtL9i5TSHv9m1pIznj7AQjQ1mQ&oe=69C9118A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
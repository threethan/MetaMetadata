rPVnLItvWkEDBvtQzOJOciJd2HC3WdpW_NlwkUY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1S9B2JoyEtoVNxluPKkRh23bKfC8b3z5Yv6cPePBXGg&oe=6AC50976"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jdqPWVh_HcQ7kNvwHB5vat&_nc_oc=AdrRO26dlB1dJNMecrDIN904c6j9PBNg4gQfIzXe-xcAqZ5V2snsGY-8aSxIvoTxvKQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd_PWdg8Ai7ktDTKcVr7zfRlssO_aYbXLKWdv9ilORXQ&oe=6AC4FFC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN7qgCpE1jAQ7kNvwH301xO&_nc_oc=AdoyJW1aLwejHj6jYyBx-rW5IYAyZyZbIo6y4LAITpkcwJL76eQ1Av0GC8ZT0_Oy6lo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj1WLUo5Cr6lphwy1BHnvM8OaAN839adyJWd4CXkF6FQ&oe=6AC4F8FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzMVGhYhjb0Q7kNvwHZvaCE&_nc_oc=Adr2U-rAm0SEIPephex4KklVSUC3Yez7uOln2nASdqYL-6xfCwdOt5ssQgyb5DulOSs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_P13VEUSA9BverJR0j51zCaULmhx7RUB4O-i5masRBw&oe=6AC5009D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t0-Wj-s8NIQ7kNvwHeDRB7&_nc_oc=AdozMqrqJ7HKRwcN5mUjREft29bpwG6Cm2hmBXtk-52Ib5y_wOIZCXcZIY4HfwugtRg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORu9nJGPxLzI82QxRcD7ckgpadytzmGZTix5GbYWiGyA&oe=6AC5184A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
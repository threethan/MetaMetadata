wh7mEhubAd79yLtUldRLfmyd6o8WlKv-wt6aKsM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_xFjvNmuD3z3hIxCZOj4LHYoe8_cEKRs-vT8cNnBz6A&oe=6A5256F6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8s-H_4XFVYQ7kNvwHC3S2W&_nc_oc=Adr_GkO9211XUSOKfiMqR_FRT8MmO7RO7tQdCfh0UH5oQ9Bif5apcOutab0X2-UJBvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvbAQK5nJAY4_LsQ8u1XWT3at7_OCZpXwgzcES82Vrhg&oe=6A524D41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XILsq9K34vcQ7kNvwEc36FK&_nc_oc=AdpWqcXBxsi8Jt7RWBbEOOI1JAoZJcIOIcfLpY26MPiEKAPyicsR_hvtpz6YjjB-n6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJNyFic0REk-yWVx7VPvalBwrw_h44NLinmLgF_8u6XQ&oe=6A52467D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs5j84vWJ9UQ7kNvwG4cZQV&_nc_oc=Adq76sqxtk6OHA0_lLF85ffFc9cjjaVU8LY__ry9DFPjBrYR3pwaJIABka6_esx4MY8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChDczPH-i7S97jWSFNwgtxkwW72is0RgEO6V4mzFQunA&oe=6A524E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YrL9ywEk60Q7kNvwFkylYg&_nc_oc=AdpES0E1VajYZ7BjX0rDOsN64QFW6uYRswu3fdXbJiunGI1Z7c6ZgCLLpivj3dieSec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbS389RtTMsCbgPtJOmr2om4FG4mmJEa_iAdRw0iw-_g&oe=6A5265CA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
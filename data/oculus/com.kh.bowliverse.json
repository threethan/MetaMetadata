KYT9z_VhZbUj3yX-WImPmwDoPGRldeJYolBxE1k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOVMa84jI1dViHwqUz5pX1ljR8htVFqfxa3R62gUPvOA&oe=6A5A3FF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0pUMuN7TKoQ7kNvwFW22lf&_nc_oc=AdpHHG_yc0vDz2Q5K9hYd0w1kEQu5-Ecr0Z2xm6mMMEgkf-sZAkO1UtOUaFIt0uSbOI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtz6bupAFyH5IXgJR1WccBSTjbEr1JWykfGhe9dzD8GQ&oe=6A5A3641"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY7h8fKZE_oQ7kNvwGNKZjc&_nc_oc=Adqmom35d0futd94HF9umO22dRrkmrJpoNAvlsmOF5r367KQtYaOxwpLPrxPK8ROhlg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhy2YWa3-VE4deZ9gUNCQ-i28mfthLUmqV2W_SSnAwtQ&oe=6A5A2F7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h5eSPHySj0Q7kNvwEhIBVq&_nc_oc=AdoshD2NKK5o8i32Y-Fmxms3hbsV2sIc53_LBp0vvqw0CauTkzN9AfQ8XRlIGDN63L4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq0Iz7xjEI42L2v0M4KSRc7s7I05gGJKpBlQiuVO0B6A&oe=6A5A371D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGsYhkovHHgQ7kNvwELC421&_nc_oc=AdrgxPKM_plpzUfyILVNipSfFTh_Dqf0RISUBicNwNnDJOxYcUxuvYRl5Q2I6hzPjPI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCagLGVGhEHigE4EgEG4_Wbd7we-NFHkvyy-qo_GjWCMQ&oe=6A5A168A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
wG9SlMHYEagUcv2pb2lvP2AKerXvaSBAYE3DQjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuv6SIN5TbcztFOa_8qNdu2r7PwqOWczxufHEWQw2iVg&oe=6ADF6776"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzJG6wHd8A0Q7kNvwE0wIjU&_nc_oc=Adq4PBUgPLC09j99eXL2kwXGk8oTmXzIa5vb-hPy7B-UhxrbaScELUIq2W-KEubRqX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCJfnqyD7TGw66xlmfD60BFHoy3sC9_T_bLhfgNeGaPA&oe=6ADF5DC1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l1Nm6Q93ssQ7kNvwHjFLxG&_nc_oc=Adqf9xfTDjU-w_ly8rqUs2DjUTO1khtu1K2f7pRlahaZJeYbpfmaLHihLo9wEvNXf8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvwN4RE-zqx_aesUCx1lBY4tmaGKCyaT9lfvdab1f1mw&oe=6ADF56FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJWom4dThMgQ7kNvwFCARo2&_nc_oc=Adow0_-a-c1E9WGpogD2Ki3MFxJzvm0L5xkuHv1iGhZ846KXGoahYCMoDUkiaPheG5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi6Ngekzzmz-FJ9NGGg2ITyB-_16U7vhHWZIWT2R_9Dg&oe=6ADF5E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMc7lgC45l8Q7kNvwG7F3Vr&_nc_oc=AdpfKoxOwwQzFIOM9PvvEF_M3USSMpd4RGw_ZAR7cOlZDjwnoNjWL12Yj3PGo44fBTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsLW3qPfV19TA8sWDLNy5dCM3rI248RCRzsCqCyKPLKw&oe=6ADF764A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
lFcR7O4nMV1wWGpCAsuFZTj-fsT0IFqQ_DnidHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3gZ2DMFSw1MFhPULiJKXQTq5ETGS50dKkxKi_iJRttQ&oe=6ABA7D76"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09hqNLr1Ll4Q7kNvwFyRQUm&_nc_oc=AdpcdqBf211jQAiUK4tG4gn5U7ASaV6mLZxBJHoFgaymlP3jfGKdVWJS8_UC3yrbs34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5VO3CCGk9YCq5pKjR2F45ykwNSO2f7um-uhHpJ0jmqg&oe=6ABA73C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMz4JRIcffAQ7kNvwGVGaZp&_nc_oc=Ado0zuuqAu5fbkiSZSLRNOd9xAErAnL01tYYgyWG1bbxl5J0e8lt78SiGACRuZt6QeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-OHeKGjPp-CoBHwN1MxZlQuTzkwdjL68R-Ttz6ZrUsQ&oe=6ABA6CFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgAsiHkv39wQ7kNvwFAlzd7&_nc_oc=AdqmAMqIbEr9ZnPM0rBqRy6eJkdbTGNkgirJVMcs_21oyu8l1g9y2xeV3BgQE3sv7cQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuN2NuatMEI5CVWfEjQvUjXUj_00o0UIxe5dlYAj--9Q&oe=6ABA749D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWZGwA13_HMQ7kNvwFDrqqK&_nc_oc=AdpCYwjBAlnPfSR1n5EOCaj-B16QdMUdX1lHZqB788od7rrI8V7jthhyzS0j82jNvMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOdifqaGWLbiSxKp2XgjF4tIzKPCgU4yVqCrjxAc8evQ&oe=6ABA8C4A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
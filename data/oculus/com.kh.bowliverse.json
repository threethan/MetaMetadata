NO2fnApb0frWhcCZOiHKQHn-NXgyvXG-m15cygc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJWEkseBQpf-3z4dozJTjo9kJg9HGQhF3-CcVkXQFaqw&oe=6AC8FDF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNtMuCUCAtcQ7kNvwG3Q5X-&_nc_oc=AdprXrXm3IBKyDEA6ZSwRgEBrXZQ3xYcoEJUuQQZ1f5rAXCqNUHBr8YOgScEp5xyUOA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzoYeL5L9dVUU7kT-btxiACXH0Tcz8iXyewQgIr1PcAA&oe=6AC8F441"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNSbI28W6qkQ7kNvwFeLVnR&_nc_oc=AdpoBGrGW_p4xzywC16IRfD89Are-JSrrz1GomYjs9YgAZ0PRWY1wdphGxbmTP-gZ3I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_tEFIuE0VTuSz77EYnZns-A53oADvrhLFSmuw_mApig&oe=6AC8ED7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Rev6FAPyxoQ7kNvwEWzAG1&_nc_oc=AdpExiTSsB2PNbJfxiYmPszKvPU2PP9yxTQV_rOmIdoiMwKx5hB0bF-TN_m9zCsMN0s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZhmQXMlgfbdOJttpaOOMWCef-2Q9z5ghSTIVsILAr-A&oe=6AC8F51D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExYAzdA46RgQ7kNvwFgVzfb&_nc_oc=AdpfrHxz2E1cQWPxtiyK5oL6iHJHT6J2znFfOXj4A9OYQS8agbhJoBvH7yrYUbQilU8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcZtCSv7zVkNMJJKh30QPHJYM7yYOOSfZuSWpQeYg5Lw&oe=6AC90CCA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
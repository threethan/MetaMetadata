_KhliA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxI9mzvrDN0AcMHiWHg3CtVmSPFBeFjpb5Ra0mIQZCPtQ&oe=69BE76B6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFWefsdOJ_4Q7kNvwGAEazm&_nc_oc=AdkHb8pkiYa1FnmRv8bw9BftREn5VKDymAn44-s7O-9I6Ok8ffcs973LVc5KSu7BwHE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afws0ddNMKyDGEDt23gsL8XoeBtgWeGXvXulEHnlWnRHSA&oe=69BEA541"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZtIRlpqX7YQ7kNvwGxSvTb&_nc_oc=Adky5OFatWgWdtZqNZCt9ZD-R-_R_8wfm9B4ELNuVjKOC-08fBXrAsHLOo0bTfLsM5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7h6IXt3m_QrsHdRJ3zPM6K1MkwX-VC1xF-igwo2jRmg&oe=69BE9E7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=269HN0bbeukQ7kNvwETAWEc&_nc_oc=AdnO406yJ7q41RbFZlul62l7ClHzX11XjO3N7A3fk6w2AXIzW6RmvHZzqggrmwwtmZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfytGZkMMoznHqXqMruNHk9pc6g1iBVfQmFcuWyxZsQknQ&oe=69BEA61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6HNeNVsWxsQ7kNvwF3cihM&_nc_oc=AdlAT6dj2jeACyg5sSobDZ1ZIVdKAvcYHaxWQX_e-m4p-Z4w7bqneZmqLnogYKjrg2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9zJHg-yP9wvJ2f_e1BnvW9GewU8wshwAcu9pPBXo6PQ&oe=69BE858A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
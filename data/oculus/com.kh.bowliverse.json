88k6YCm57Ox_PB9-NlYshNkHY2sgEtfpHjEo63o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwmTfcJ2zGOxc1Vrnjmsu1jdupqF9ch33PSZWKJCcpjQ&oe=69C3BCB6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_5atINEoMAQ7kNvwFhuS_0&_nc_oc=Adq4HUHdVKdCyjdPwaA5vXMfAhoElTWDg9E2fC-88bJ4qsFUfigldmcUVZQWwa-st_c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6Ym0lLQ5kNP4UdcGduiE8wjpR010CaQZQ6aZleNk4Uw&oe=69C3EB41"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y66JbM9wUagQ7kNvwH5vhqB&_nc_oc=AdoHienYkcOxli1HQPn0_4haOq74NgS6Cg0xf6t4k3Jc5gFjNPF30w-_mixd8TLLvuo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9XiaJocc19SZLQV02Tf5BnSL5OfY-Fo1cHcRx-Hbycg&oe=69C3E47D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H9ls5ifbtYQ7kNvwHTxvnx&_nc_oc=AdqEyQ1ZH3BtyAqE9kpIOYOl-zAfOLRnfCt-cpixjDV-xozpfv7s83bUESrWsDAL1Ns&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxu1Uv7jhNw0F36REJwMezW1biXaJPtcEOSsQjrPPnsMg&oe=69C3EC1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssAYg-f2lYgQ7kNvwHnFOve&_nc_oc=Adq9JM0yiX3wk-ZuoqQ_TOyphJNsu6AmTLkRhQigVoKKkFu7O9XnvEB7cOtNsOERX9M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMQk27w00Vq26otI-a1-B23gxdtdt2OCz-JCLtGPIJyg&oe=69C3CB8A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
8yphcscllhvEW-3yUFBUO-bxEfkte1Us-uXnCl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mdQEeLJeDKDK41OHGVN5M-9eTRn9YurS3WQeyqALGOg&oe=6A3BED76"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ex9sL8LobvwQ7kNvwGSmldJ&_nc_oc=AdpddDZXtYQq6virh0dP_c9LAv2T4JsaOaB3gHK2YNzfi69sgYBLY5qhQsM8UBTCcA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q0RoKkxuf5BYNvVJJcj9F10ur2T1rt4w1dda31QLr2w&oe=6A3BE3C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBzNcAM541AQ7kNvwG3E8e8&_nc_oc=AdqQTILfQbHR84FwkobM7tKWPDZJRaeOjDbXrY82oU_XoY35bLgBDdxThT6JNwMGhVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87i59x_wSBFvJbQMu9x4Os4MBHFvcrOci_SoFpMYepQw&oe=6A3BDCFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AxRlt_U6YgQ7kNvwFCagEx&_nc_oc=AdqIutsXvN6Ax2_IMvVFkXAD-ScEDcw7pYyzVnrjFch6ADWZOENL_3bKWR-3kP-kHD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7Jk9FlnKNwpPenrggRXAvy3ZiZ_V-jk84TmPB0kwHUg&oe=6A3BE49D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DcmF9X0VVYQ7kNvwFxxfkx&_nc_oc=Adr32rPucGrEn9yAvj9Ppb_5yrBkiGGVyfHhbLn6Or4IZzzRrGfhzlgTQ1QZPO113IM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UozDOFoh_rWvLiobpIE-RLGp_VOBoJKEz19GEM4BMZw&oe=6A3BFC4A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
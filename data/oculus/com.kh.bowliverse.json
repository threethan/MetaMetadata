Q3iOhrHxQWmHH6ezD99ukola7lpkSPW_xDnGVNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PcMHQRDM_6zXKHbkYs3W0enJWgL7BcsKEtgeX9K1KWg&oe=69E4EA76"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xbIeRm4wPcQ7kNvwFlUZWB&_nc_oc=Adq4BwJZ5R4g8egC_fg_NPq1NhuBRz2e_ZoHMs8On1IcjH7O0E5A4tyx6k3slm4VMoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YFG6R5HS--N6LOSx2vY6jDTjLNiHAQwDWx6XxgyMZLA&oe=69E4E0C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j620jBMwLsEQ7kNvwGkiKmJ&_nc_oc=AdpeDl5_qBgLukpyUmeSaC_66N9smu3SChLhkH2AKlm3eghjqSz1h1TS5TzJWaa7s7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HUiCPlI8hKrM8NDchFbfpiJ9CSWyNZeybkYRKbXbLFg&oe=69E4D9FD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiAIgJ4PFlAQ7kNvwHaN8qE&_nc_oc=Ado-kvhVcWgSeRvPn7aGJyh8Fb2K6NO0nnqZYsRGq3GdwYKJ1lMGc0IAXaGjee5g-4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18H-ybUH2QAQfq766LeIlr1XRPwiRt1o9ILa_XAN9Ppw&oe=69E4E19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGq1iiFkCvgQ7kNvwGS4xBf&_nc_oc=AdpQdAVXHMEHJANqR5ADWheHr3uNqgoxt_oQl-80J4qFwxxi3PqvF1RJuIEArxTknJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ee7sS7SJQmCNnK--TY7dCO7EdTWbugcqu46apVMPAKg&oe=69E4C10A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
Z8sPOIRg4HS9WCgqUbkwODLvN9BddPk-SudpUY8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6E4poOg809vC6SycUHP8aKQxlnOQm78Hq_bp38Y1IBw&oe=6AE35BF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kd0pyzAc07wQ7kNvwENjGUl&_nc_oc=Adp44x7m7vwl3Xos3roBvfT9aBA-HHr3SnB5DpZ2o11qmxxBBLex8W10PYp5VJu7jYo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxp-4Kq7o6xW9fHCsKh-f4mSbi5-cvXnD9nmJ35w7_1g&oe=6AE35241"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gU_YEDhprAMQ7kNvwGM19jz&_nc_oc=Adot2OEED7TZZo_Vj5v8pjEmeYlSf3of0a55ig5wGYFVbGidTZ5jvZADlEZpPK56wW8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFjje5b2Vq920Qhp5K6wb3g25W1UxLFGQHUvqqVnRl5Q&oe=6AE34B7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPCpybhrwCIQ7kNvwElebBq&_nc_oc=Adr6AJHScJ2cGQk9DdxGGsbGtrfBZC_4b9Gop2iFypbw0vr6BxLTyjQ-93sO_S3aXPU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaVSRU6y8v-XPSkzZrAUSjZgyI5bxuMj1MjnN6GlPW_w&oe=6AE3531D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V1-asEWnJYQ7kNvwEwKA99&_nc_oc=Adp17O24-APK_8FrV1g1QIV9TTQfxvyvePppL_UcP7QJFGRNBY37eoJ2rhuINh6zJ4Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWKnAEXZ3XOwCj0SO3rdmL7NewyNRf4ZtQrF8Hlv8-XA&oe=6AE36ACA"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
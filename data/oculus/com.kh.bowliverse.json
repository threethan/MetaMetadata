nMoblSvKxls4UG9Y3fhkidqmqYdcnTqBLKOpSL0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGQrm_rbHzuYmVBhIGHzGylELLtbjUidYUvzR4Uup7WQ&oe=6A897DB6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIgmBl3uVHgQ7kNvwH7cN77&_nc_oc=AdoNeSmgyWHfv4vJ5JgvTfxs7PHKYhgLv9gHWlgP8C5W53lqS1KQ0Wc3iBiyzh_SKcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHowdwnPVx2MRu6WnxaOhM2z8YOghO0tJI7wWpIrzZVIw&oe=6A897401"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2REzAJGSGjEQ7kNvwH5Xkby&_nc_oc=Adp-xzXe3esn94IhvqWPfA-vqgHcrYNAcJ_eXJ5WseleRev_R5yE2KXwe0PpR5tF9Qc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKRRWak2y-iYlHgzISaavNP4WKLWd9sMLWO1hQ1Gn5lQ&oe=6A896D3D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89jjDhLYilgQ7kNvwE1_wcv&_nc_oc=AdptFlSGw6DJZe4xSJFTuV9AvrL1Szvb8HpBbWpBURkxE56w-b5h56SWR_jOEnldQF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO9eSRvEqtnCf7H3bujpiPLkFzOGiXC3HFQAmHjiF0Lg&oe=6A8974DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCSTvOxtuqUQ7kNvwHrEY7U&_nc_oc=AdqM8RPOXu7PhUTCmhavRtAA83nE8aUiJ_4ukHj38e2xTpTU_EW7PPTSedprwItWKsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqFAPXlp3r1xENll-IhgUoHFGM52lQ1WmdO9ZoyqckdA&oe=6A898C8A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
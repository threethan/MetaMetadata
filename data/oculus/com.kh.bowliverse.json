d9Fp8Rdazr69C7H7T5w3aEQKo00jbg5_aap1w3w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRPCUT7doBtNUeapM1X3is8ZWL8URIkWHVPdzZPDV1lg&oe=69CBDDF6"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnHVEhWNlwoQ7kNvwG94J37&_nc_oc=Adr6SUijqyHcOVNgbjosN0sEI0Bum7zJ3nXk8QI_xrK9EiWq4L086WFYtK5c48QrOzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvFAPLY1avj_qNVDgkCWrsu3xdlvClneglez8P603wRw&oe=69CBD441"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzPa2euurgAQ7kNvwH1EANj&_nc_oc=AdqTkxipy_Uh8n6SOUPnKZziN__IB3bH1j_ii6zQNlBFlNUTKq6BcmHry9O-e2X-TU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_SD0DGd_7xBwlxD0jXlVMQo20ITkzBT6vgC9MaSku8A&oe=69CBCD7D"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p11CL8EHdUQ7kNvwHGmMs9&_nc_oc=AdohtPnzwnMvSX8I1cati9L_mGLzli9zQZZuOLihAg4Xool1u1YCJ8lijq0SV_1Y_ZU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDuHlKS-r7nuyEvg8rbPDw-W5AuLvg4BaOZQ_TjuZELA&oe=69CBD51D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_nPTjgpeMAQ7kNvwESjDBL&_nc_oc=Ado9MK7eHyKxRN55hrTc31i3Ft-Mq602ZPI-ujpNxk_btTPFcYLg1FxVX_XWyRHwhdQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDn0szpcUoqZUVnnamQORhVP3E9pVyAf5lnBUtz9TVYQ&oe=69CBB48A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
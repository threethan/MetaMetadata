hZsr0ygAIHcU0Wh1rYs2PZDY8KycV0S9gNhiXpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AP-dQgFjEcMvu8Bp8J4L4vZEFtQqBxSW93GLEhjYsVg&oe=6A3E9076"}, {"file_name": "ss1.png", "id": "1204577364128636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_1204577367461969_7049697876348417668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYmxXrSEqmgQ7kNvwFT00Lr&_nc_oc=AdrWWlm16Bu3NrHvsUS9TdXgkXtCxReypMgXddSCfPE45VPuHpqSkUQSPdKorSlobZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ISBOiEdc0lENoVCJKz5nif51UPjfj94_oOr50nBNrqw&oe=6A3E86C1"}, {"file_name": "ss2.png", "id": "1009530637435356", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254878_1009530640768689_803764645605571401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXpD2PxU3MMQ7kNvwEevp0k&_nc_oc=Adr6XjdZi2yPIRSvRZti250EKytCNI1Il3UV3JW8tPTKdWOXZOCl842Ld9lFhARNq90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FMJ4Ri7cRKwL3mw7PSvKgmVVjYDCh5hPzNcc5qVTtGA&oe=6A3E7FFD"}, {"file_name": "ss3.png", "id": "738875504913414", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001660_738875508246747_2158305255338028142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AxRlt_U6YgQ7kNvwFjqY6Q&_nc_oc=AdoVYfCOJD_YjRp3bi4awiiQ9anAjTzf8gPtrZp4HV_vl47MSCJVPasJCV5Fjh1qhR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IovHvjtrPi_cE_zZXgpOKMmVyeHhuWyiqq-ki8BQS9Q&oe=6A3E879D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "405044145251835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86796210_405044148585168_541174282990593081_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocAb7-NzDkgQ7kNvwGhpbxS&_nc_oc=AdrZL-LI0LvIhuVXHH8m8sBgIhSlWqcuvjtxIvSXS58AlrPNaepN2G_mt6149qNUUuI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3WU9BzIU3AlxoyLm2efF3_MwsA-xUMq_ZDTXExkHJjA&oe=6A3E9F4A"}, "display_name": "Bowliverse", "keywords": [], "long_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Bowliverse\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Bowliverse: The Ultimate VR Bowling Experience\n\nWelcome to \"Bowliverse,\" where the classic sport of bowling transcends the ordinary and enters a realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Bowliverse\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bowliverse/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KH Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/bowliverse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphic
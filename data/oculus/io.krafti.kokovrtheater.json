https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823783_1004915348925599_7044245490366722346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWWOjookA70Q7kNvwGaN_4G&_nc_oc=AdqCdlU9S4DkLrKMlE_J77PVytrLyl2wXzrkSs7H9uHG0UR3jekPks5DNVCW7jb164I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3wrbX84AHTll8YYJIJGjL2hYW8IidxgZjWlSW86NSCQ&oe=6A5CDC86"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vClpd84yyLoQ7kNvwEJMmaV&_nc_oc=AdoNTFeX8lol0nLtefmApy4_WSrq5oFutVKbTVmL7Yg7AgJD3WCt8YT0bgewaZz36gg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi5qfuU8gNMifGhtcp22Qthd_JyZqzgwCdJ0L6sA780A&oe=6A5CBA69"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcjQjeIZP20Q7kNvwFtUSyd&_nc_oc=AdqkeTVH-q_inJz2_yf0LVW55mDIIoCj4Cjnp-Kgwc_dELp5mx9bfCH97PG47qcQiRk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvBFu2hu8OI9-6h-36M0IYTF8WRqSAq5lQZrr311i7pw&oe=6A5CDD95"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVTvEGEGOVAQ7kNvwH4SGdl&_nc_oc=AdrXX_xpUcs1WJ1ZBxpV7URNU-bEbkd07kNiMhLR4EZ4y9uZn_l-3DrCMqGWwFjPfLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT7aREigJIMEKYryZyWxugFeKHr-IDg-XIeirSbaUTtw&oe=6A5CD6CF"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6v7mIbs2ZoQ7kNvwGg8hwz&_nc_oc=AdrNf-P5rS_sWhvG0p22DVaCuFB6E_5B3pJ7SCjW2xtJc1TQuRwlasskg2PybqYAimo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwNM-hTcYopvn7HTEf_CTGIxEyVcvNpn2RGZQw4ZSqpA&oe=6A5CCBF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2
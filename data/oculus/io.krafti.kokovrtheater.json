EK9hGFzsY4ziQoC0lIxafZXFuF9OzQCwERG-dnDUg7OQKRkwV-vUTvsWQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRL18l42G_zmeDPKkvYkzbnCixkQja342BahzvihAHX8A&oe=6B0C6C46"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2egjaxNfQL0Q7kNvwH_YmQM&_nc_oc=Adq4Catk3m9pSIZ-BukXCnVVty7X9NTlP_2n2M3oiIXvQJ5AHA-BGmlZG3qidQfueys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRKoEjIvJ88IrmK5ZMuG_ItVOayODTnfthzyMe71Ar5GQ&oe=6B0C8269"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTc0uG2UnasQ7kNvwGJReQ8&_nc_oc=AdoSrExg25Xu8yxV6mi_KNBah5BsIiMT-Emjp0ScQmPVXB0j2C83EAN71YAMLzdNATI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQIE_z6DORXZ8ZrdsEiWywuyyckOVWkQfh72E1CDzn4g&oe=6B0C6D55"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFaClns9lPoQ7kNvwFgnUWc&_nc_oc=Adqj4Ph5nR7aYZZ8gZus-sOHqm2rwlyJnaUYgDsc7o4t2YJi_PWm0ENIpj5USCl_9hA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRu71wFS04iX0j6SJA5D6IgagWLECIpx9u0s0rm-3vx9Q&oe=6B0C668F"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcm6Ow3eU_YQ7kNvwGdH3WL&_nc_oc=Ado_SqMXOk2-0_Pt75hbxd102RpEhgBf4vPlT_1-T6C4wbDIFTAKWYVDKCSy06sd6Dw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdFRDT2stGDDyhpVt-Bhsek8rTKEIJNltZyIXzX27JUQ&oe=6B0C5BB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2014 AI-upscaled and razor-sharp."}]}, "developer_name": "Krafti", "developer_privacy_
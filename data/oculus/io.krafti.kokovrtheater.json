kOAzreghvQQ7kNvwGOIvht&_nc_oc=AdrKvXUozyIelj1k0pvEGveWmnL9LBYwK713AS-ndPY0b5C-quUY7uF3Hp-zzpHGST8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm5N1GNga1Goeo-fRCslleEc2SCTtt6o39RZAM7AJxgw&oe=6B084BF3"}, {"file_name": "02-player.png", "id": "3283085152080476", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824671_3283085158747142_1948101021699266071_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSDgNYWJ9zsQ7kNvwFyiXVW&_nc_oc=AdoUBAwqVqhpYgSYv8CgXcsFJFEvIFF6k53nnhZDtdzapFr-jMjwPBRlHACWdbbKwvI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIU_WZ3IbXkTMhYOTqKAJEM_iUPlRcNGKLMMkuVSwbAA&oe=6B086483"}, {"file_name": "03-detail.png", "id": "1024674043649769", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823351_1024674046983102_3449906024102859963_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muPkWNgES7YQ7kNvwGk7DE0&_nc_oc=AdqueXuNrp0sx6X7IOzOzmsFXnPDKl_Ls1YkY7Rg6j7tGH9RSDqJlwFf1RMEkmc7f70&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdHbcRrtvWjsaKJoQz-YWh3Txv7dut8Hz4Zzoq94aVRw&oe=6B085D04"}, {"file_name": "04-library.png", "id": "2056452011930408", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823341_2056452018597074_4072482199744490079_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlZ1wc8wmeAQ7kNvwG9p6nM&_nc_oc=AdpWyHpU7iZe66e-DTfQ9b9jR4o_aIfz5ZbFiu0VhNu1uUGf2ktmreqnp-Vf9KTmCC8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG9ccyOzRtKSF6NFzHv_MbTR75NTXJLq-7-spD2cJh3w&oe=6B086806"}, {"file_name": "05-watchparty.png", "id": "1059749396741215", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/585819904_1059749400074548_5840519737141081579_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbsrHrqO-YsQ7kNvwGqbCaI&_nc_oc=AdoYrY0oReXxsPZvt463JzGp6-Dgi_BPKMm5dOcSd6NpiHuZxbtASTnfYptLcZ5sRIE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLOpDdKHmAtlEyQY5OOscu1bN9f7VG03gyOe13MEiUMw&oe=6B083D07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Koko_Landscape-24bit.png", "id": "1345279817644881", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/908842283_1345279824311547_9093795107493281608_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Yqw8RTbTq4Q7kNvwFYCInp&_nc_oc=AdrlVD0JZspVds56aQummGAnPzsVxd7qZTKtQgQ5SRs27132STUebYuAEpGvksDHmsg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLOfSSP5KaMdVU6Hx5tL8byb0G5aHklSOzqlseKY_Q_A&oe=6B084E5E"}, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "vr180", "3d", "movies"], "long_description": "**Your own movie collection, in immersive 3D.**\n\nkoko plays what is already yours: a Plex, Jellyfin, Emby or Silo server, a NAS, a USB stick, your computer, the web. No server yet? Start with the free demo library. No accounts, no ads, no subscription, nothing uploaded anywhere.\n\n**FEATURE HIGHLIGHTS**\n\n**Choose where you watch**\n\nA starlit cinema, a night sky, or your own room in passthrough.\n\n**Every format, detected automatically**\n\nVR180 and 360, side by side and top-bottom, Apple spatial video, 3D Blu-ray, HDR10 and HLG, and 8K at full resolution.\n\n**Flat films, converted to 3D**\n\nThe free PC companion turns flat films into immersive 3D while they play, and rebuilds soft sources up to 4K with a neural upscaler.\n\n**Just ask Koko**\n\nSay \"play Inception\", \"pause\" or \"turn on 3D\". Commands run on your headset; questions about your film go to your own PC, never to us.\n\n**Your PC and its games**\n\nBring your desktop onto a giant screen and play in live 3D, with your controllers as a gamepad. Or stream your SteamVR games over Wi-Fi.\n\n**Watch together**\n\nInvite friends to a private room. Everyone gets a seat beside you, with voice chat, reactions and synced playback.\n\nTry it free. One purchase unlocks everything. The PC companion is a free, optional download.\n\nGood to know: DRM-protected streaming sites open in the in-app browser and play in SD, a hardware limit. Full resolution applies to your own libraries, local files and DRM-free web. koko plays what you own or are authorised to access.\n", "short_description": "Your own movie collection, in immersive 3D. Connect a Plex, Jellyfin, Emby or Silo server, a NAS, a USB drive or your PC, or start with the free demo library. Watch in a starlit cinema or your own room. VR180, 360 and 3D Blu-ray are recognised on sight, and the free PC companion converts flat films to 3D while they play. Ask Koko to play a film, bring your PC and its games into the headset, or invite friends to watch together. Try it free, then one purchase unlocks everything."}]}, "developer_name": "Krafti", "developer_privacy_policy_url": "https://koko.krafti.io/privacy", "developer_terms_of_service_url": "https://koko.krafti.io/terms", "publisher_name": "Krafti", "support_website_url": "https://koko.krafti.io/support", "website_url": "https://koko.krafti.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR", "it", "pt_BR", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1409940152211497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825470_1
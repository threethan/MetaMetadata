bR8KmUcdnnG9U0QNcAzQ90Zg3IwJhVXu1SgBd1HjwwFusatvViJu3myyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTW3rEBxBd_D5BJzwbIskVYNPHGJ7i7uYROhCorHVflQ&oe=6B072646"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES7xNZ3C-oQQ7kNvwFcxkNU&_nc_oc=AdotKiQWvd4mO7dTgW1tpStL6NbnPAgIXizTA3JmiKcwP6CjRk4GAOPw3lnQPuRpKz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxA2T7481-bPZIoixxbyK-I5e5FQeoDeXkKq5XZ9EMNA&oe=6B070429"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npeTBYwqDU4Q7kNvwH3km9c&_nc_oc=AdryHGsS7-R8DGg0bhJWRYDMICnVE4C2AoNeDtZqrnPM-mcPzcXbZBaRvMz4p555sqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKnc2NlclvV6Na6C6spzEXHoCZ8zR5lw_w2PEZJMsD9Q&oe=6B072755"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8JLkTh1J8cQ7kNvwHxITYk&_nc_oc=AdozqsrxJ96UkNnTWiY_J1nimXagP0dv3DdiuJ0cPRCrcHRn2Hudg2lC_Oy7MxuMMQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuVjdSCUkEOrJ-fsHSwCOuZsCE1eyAB8ewOKG9P4WpNQ&oe=6B07208F"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGp4tESa1AIQ7kNvwETDaU3&_nc_oc=Adr5KndumwxYYBMnbQwba_Z7lo_jfWDrRGZIT-yTSC3yTECuDgT8yDJJ4P8M8nH_sgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQzKeBVx_DPfYf7TcEZhkxyz0mzcnCPl04FEOMySWuYg&oe=6B0715B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2014 AI-upscaled and razor-sharp."}]}, "developer_name": "Krafti", "developer_privacy_
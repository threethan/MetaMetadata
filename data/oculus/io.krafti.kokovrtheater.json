t=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1WZqPqOHJ4Q7kNvwHRgRF9&_nc_oc=AdrLwdSe3mLWp5-PR869FqacI1-ETNU_YyZZ34Z0lgQ5QiXrUZHZyGY4ERhKbPNeuWQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPfK3u7_n0dM1dg6dLCiUi2iW_SNeauJwcOxvkw7S-XA&oe=6A563ECE"}]}, "id": "2458940581274914", "locale": "en_US", "screenshots": [{"file_name": "01-cinema.png", "id": "1004915345592266", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823783_1004915348925599_7044245490366722346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZOzrADb5lgQ7kNvwGAIXhc&_nc_oc=AdpvqWqrJ5bvaCP-25n1_TM9pRoTaoP8TR__O83cywAgG1UXdZVc904XvtuL63VP1Iw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxWDkSJ-QXPjXfo996O13C0YdlKWkLNsp2YCHhYaoymA&oe=6A564506"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HA3q3kXZergQ7kNvwFArqMG&_nc_oc=AdqALQBu0xcKZc2WgD_HiKVlma1pCN9NjJw2hC3v62xp51p72b6uhW-hTUB4WyQzRJo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyOQU8WN3qrIztLOAEsXcuuY4CaDS5UBgBgJzGdS8veA&oe=6A565B29"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re6FEbY7LXwQ7kNvwE6qM6d&_nc_oc=AdpYShTtTAkOQ1JMcKB3dsDajKOGv7d7unDFt0TuJktfaukwwJbgL-EP8_LX_6oOlBY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJO9UCIxGevvIFKXxxpWVyG6RDQHGyjkg5GoM70uMcGg&oe=6A564615"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOltmRQjDlMQ7kNvwHdAO3q&_nc_oc=Adpw80NU4BLsxl5eFpJ_rax3TISSK1iKMTmGkRduwAOBd5k13PhUlytoX0N2bz_dtdg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXZI_zW5kfGXWFWviPbQkuH3aj3vHHIe6EusfgKaJ9Eg&oe=6A563F4F"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arRABGMbAQoQ7kNvwHo3FK5&_nc_oc=AdpOkib5tx5-qE6ObK3qmYqTY2_xonQV0HQpGxFghTPLC-kkup-QzemiquKvwNzAnNg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqgIYFYJ0v-tRmv-SRadb-aE4UlWNqyHOBxjdfe0aSVQ&oe=6A563473"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2014 AI-upscaled and razor-sharp."}]}, "developer_name": "Krafti", "developer_privacy_policy_url": "https://koko.krafti.io/privacy", "developer_terms_of_service_url": "https://koko.krafti.io/terms", "publisher_name": "Krafti", "support_website_url": "https://koko.krafti.io/support", "website_url": "https://koko.krafti.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR", "it", "pt_BR", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1124509354087913"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823259_1300439785571294_7927136301600096766_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGsdFFoEKLgQ7kNvwFcusw6&_nc_oc=Adoycg2D9KZIgWoRbDWFQCSvmrZ72xlx8PQ03zX73OtRfl6ptuADkm2Wt4XYpPkpM5w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfLdSlh_O9MLRiuOOlMOJeuGL88TyOsCvUIuqNiZuZvA&oe=6A562F90"}, "is_concept": false, "is_test": fa
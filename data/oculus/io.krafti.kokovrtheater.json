5806763437", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828104_2240725810096770_833166801810821345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W89HB8vjq6kQ7kNvwHxwye0&_nc_oc=AdpGFtK-RizxuTSMsH-gCAQb8EsBKN3Nciu7r-RIKzqsj405W3OQBBCSUPHnPJsg-fI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4qutdTHEA41mZCTvrT0BCQle_ktnfm2LsBXVGCVD8QQ&oe=6A8D7833"}, {"file_name": "02-player.png", "id": "3283085152080476", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824671_3283085158747142_1948101021699266071_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYEMShE0QKkQ7kNvwEmrm0k&_nc_oc=Adr0JAdnoGreDS1yjVA0JjSlYVNHPPCQeVVEFVZcws5YqCkzUQkxMRmXIf7_uPFqWIQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuUakORIXXklaBg4GsQRrei5tD2W-r3Reubo7yNL54hw&oe=6A8D90C3"}, {"file_name": "03-detail.png", "id": "1024674043649769", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823351_1024674046983102_3449906024102859963_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLW3Mssns5QQ7kNvwH3c6OU&_nc_oc=Adpvb20GtuKv0jQm08s1qNLv4Of5BSv_-RUs1MIOkaHm-xQ5pfcRY0Jn_MMct2ETSJI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa6thbZzyyxuCK2OLjNJtfGpzXpLYZ16IjsxhHcSWH8w&oe=6A8D8944"}, {"file_name": "04-library.png", "id": "2056452011930408", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823341_2056452018597074_4072482199744490079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGP4G34TPU0Q7kNvwEEFmTV&_nc_oc=AdrHX13HWMzd48NpSyeBJXUTJgUG45EwUUUacpk94lDPc2iSlwmev8QfvU46CluYPyw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFtE-CoisfXcPUVufa5Ta6uurf1xpPWJ6d58ylg-5FJQ&oe=6A8D9446"}, {"file_name": "05-watchparty.png", "id": "1059749396741215", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/585819904_1059749400074548_5840519737141081579_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-IqVOduVf4Q7kNvwGbUsOA&_nc_oc=AdpDhIwZfGcRIkB-2BHcN6spsnSaVDnkmWm8rHmgH6Q4C7v8uGfF-6HgV77F-sCVYWo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRh2IZsY_8d3ksd30-lMVh5i3nNqG2cPa1FRfDMWTGHg&oe=6A8D6947"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "vr180", "movies", "immersive"], "long_description": "**Your own movie collection, in immersive 3D.**\n\nkoko plays what is already yours. A Plex or Jellyfin server, a NAS, a USB stick, a folder on your computer. No accounts, no ads, no subscription, and nothing uploaded anywhere.\n\n**FEATURE HIGHLIGHTS**\n\n**Every immersive format, detected automatically**\n\nVR180 and 360, side by side and top-bottom, Apple spatial video, 3D Blu-ray. koko reads the format and puts you inside it.\n\n**Flat films, converted to 3D**\n\nThe free desktop companion runs a depth model over every frame and builds the second eye, so an ordinary film arrives in immersive 3D while it plays. A neural upscaler rebuilds a soft source up to 4K.\n\n**8K and HDR, at full resolution**\n\nHDR10 and HLG are recognised on their own, and 8K files play as they are, untouched.\n\n**Watch together, privately**\n\nSynced rooms with voice chat for a few friends. No public feed, no strangers.\n\nYour library, your network, your screen. Try it free, and one purchase unlocks everything.\n\nGood to know: DRM-protected streaming sites open in the in-app browser and play in SD, a hardware limit. Full resolution applies to your own libraries, local files and DRM-free web. koko plays what you own or are authorised to access.\n", "short_description": "Your own movie collection, in immersive 3D. Connect a Plex or Jellyfin server, a NAS, a USB drive or a folder on your PC, and press play. Films shot in VR180, 360, side by side or Apple spatial video are recognised on sight. Flat ones can be converted while they play by the free desktop companion, which also AI upscales a soft source up to 4K. 8K and HDR play untouched. No accounts, no ads, no subscription, nothing uploaded. Try it free, then one purchase unlocks everything."}]}, "developer_name": "Krafti", "developer_privacy_policy_url": "https://koko.krafti.io/privacy", "developer_terms_of_service_url": "https://koko.krafti.io/terms", "publisher_name": "Krafti", "support_website_url": "https://koko.krafti.io/support", "website_url": "https://koko.krafti.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR", "it", "pt_BR", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1224987227373458"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825470_1670334497601467_8389518644238336381_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKgKw4KKXEkQ7kNvwH3Qj0G&_nc_oc=AdqYVFPb3j-czPSKsQ65l4FlZ2GMJ1H7OXshV6fpa5GXKPQQvw3f5LJJEikpnA8NrpA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdnJKbpSHnPy5HI6kciilfmqF7aDnOHR2khhQ9o-kCBg&oe=6A8D766F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "koko VR Theater", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1783601520, "lastRevision": {"nodes": [{"id": "1124509360754579", "rele
https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1004915348925599_7044245490366722346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJEXZkgd5HgQ7kNvwHcoY2A&_nc_oc=AdpGZKba4nAYcjsG0u1PCQ5_Z1RZ_hrkbZYOvOl2EPno6QdtWL_7CO9HKqw_oM6DBpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHPfCP9jLqhjy1UfNNx9zHJYvy8sBnXydbtlJDvmJSKw&oe=6A60D106"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewsOR8q4hbAQ7kNvwFXZSj6&_nc_oc=Ado1J9XDzST4ChZi2Mw4b8aNE_Q-Qu5WfNjiJlqE2xaIbSRWzEzFPFC-liym642A9r4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeHI_ptT63wHbbv0aBOaF1po2YdD-1Y48VKhISnKftWQ&oe=6A60AEE9"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0Nji6dD9_AQ7kNvwGCFK5T&_nc_oc=Adp5m9JPEPXcUBq1ub_nYktYZiWBdYEe6wK3k8TjHnHVdeE8e6XcZYH3tfkJpcvqLXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh_KqSVt0baJfxFfxwP02p3B5ev6DiFdHjEOVhPjRhoQ&oe=6A60D215"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYLRh4umUKIQ7kNvwH66HW5&_nc_oc=AdoqBedYtFgTTH7fNridjRdM9MATM0VZQb1TjfgmUXzVgCgPJtQNJY681hOAXYGqdOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW02vLrBPokY8jsvp0j1qhtZKkKaQFsMKPzp-tbOBsvw&oe=6A60CB4F"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4zYEIOKYkwQ7kNvwGBx5Rw&_nc_oc=AdqOWoTTGqLtCW3Ys3Bvkh8UiROVqyHAz23Te5Or-GccDCQu5niYbafbhX_tLPcM2fU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDelkVoEk04Dp1lime1b4C8aoyBCk3rLUgWZVgq7VXejw&oe=6A60C073"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2
https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823783_1004915348925599_7044245490366722346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0niDnCQW3l4Q7kNvwFsoMZk&_nc_oc=Adpusng_BOiNNmtjwiqAZXimXt3IIfILJQ4hepsgJHXhmZo17wJjXecQdAvKsIDsYcs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Cdedp8cmIqVvmUBTNrdP-4tzdMlZaLRB-rkDsbK7Bg&oe=6A5A3986"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vClpd84yyLoQ7kNvwERJV1z&_nc_oc=AdoCRy77w9xaN7IiiI_HFl1jIa1jIab9Kion0_0XolKWWYZ0vKOHc8PoyBD4O59bapM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmIyk01k3Wn87flF_VEMxXDNFC-vcW5C4-NGJUz4RkwA&oe=6A5A1769"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_Q4uw0-mCcQ7kNvwGpUb-w&_nc_oc=Adr5B-KHl72_-Kz8-mxDtIELIZefqzBpfu_bwXyX9NSFA8zeW4miPGAwYrv_z1Owx7o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOyYDd6wVdgPtWtvEiXZ7izmUWUZfRj4_w0MdRCXVb4w&oe=6A5A3A95"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLeedxNkVE4Q7kNvwEsK5DI&_nc_oc=AdrXRXDjOgLX-oqKrdY7aLjxrYlrsOGfzcSgJjNV4KCIrQp6FwpGBEAkvjaJHQod0xE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfraTHkgyVUoOB-xAE9pIrzZPJj-oexbZyEL47fYrqnA&oe=6A5A33CF"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6v7mIbs2ZoQ7kNvwEwT7Dn&_nc_oc=Adpaj29LQBL-XhcZ5q3foR9BqOQePnXZDbB42h7GYrBi7Ci4Y9PZsGylOPsq7ATznQg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg-UkZP7lXlvQnITK39ZKs3qVIiK6t99VV0imyyt036w&oe=6A5A28F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2
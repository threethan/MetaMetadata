https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1004915348925599_7044245490366722346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWWOjookA70Q7kNvwFozC1A&_nc_oc=AdqRPBzysDsqr2a_3Jkyo-Nw5A_F55XbYdSWGbE8Nk2xY49tZPprrH_UT7LrwbHgBH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZHbTA3DI9XCF191YptIiG7h2TsqdeJ5b366uq5Fgezw&oe=6A5E2E06"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewsOR8q4hbAQ7kNvwH1F7nA&_nc_oc=AdrbjdJtNXW6dg1YFBuamo1R395aEz7SJ7Gy6IMo0-O7LbZYSlG_20_1hWyNJ3vGIZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChkIYDydtvI49yZ9IZfTEGtX9u4963RJxRPB3Rbl5jwg&oe=6A5E0BE9"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcjQjeIZP20Q7kNvwFp62om&_nc_oc=AdoZeG84ZngZxv52pP6kya-4S6mkBhSqTDYv1XbzCRdmAUJfTOQM7ORFu6xxkqY0zlg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy_rpTk9rXRSOKKNUWjQiB70u08y-NnQuRMi4PjHTNaA&oe=6A5E2F15"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVTvEGEGOVAQ7kNvwFymNj9&_nc_oc=AdonsTh8wCmmCp2nvrm_z87aUMvuT7QZYsM3OXyvQr5Jtb8nbS4BjWOBNfsbeI_cl9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVtZAF_6Ei6AIqQgZdq_Y8xULmm21C4hRP-F7Ql6S0Iw&oe=6A5E284F"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4zYEIOKYkwQ7kNvwHHxIYJ&_nc_oc=AdofoPDxlr6L_sGI1HUd5O6PGJ7zGHLA55taJU-qDPMxacb8KX9G8rqwnNFXzIXOyAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmpo5ZBMULUy9X-lIcF9-5Y9GAZJhXs3lP2PSH4C54tQ&oe=6A5E1D73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2
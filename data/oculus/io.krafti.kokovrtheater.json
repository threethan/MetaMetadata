763437", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828104_2240725810096770_833166801810821345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irN5p_E9mHYQ7kNvwGeUtfF&_nc_oc=AdqAuWPRy8T8rBNJeg9cPA2dYacHHhsiuD0IQxxdqTqCVWJFMCnGySNMSgUwIQttivk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImGO3IrlF9YTqqY5oMaasUymUOmBx-KUe6JlCIhYMnoQ&oe=6AA95FF3"}, {"file_name": "02-player.png", "id": "3283085152080476", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824671_3283085158747142_1948101021699266071_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NwopGqj5qUQ7kNvwEMIVqL&_nc_oc=Adr-3k7tCQF_M_vMRmrWeGXq4qAFU_lrA-CuaJQGReNxCnzy9jCcc39cguNrdxt1pvo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJesnaGIz8v5YwQuK_3yqHr8vuJ9vZ2qOiX2CSmu0qEEA&oe=6AA94043"}, {"file_name": "03-detail.png", "id": "1024674043649769", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823351_1024674046983102_3449906024102859963_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y-OYkF0ScAQ7kNvwHIC2aj&_nc_oc=AdrrdtIELWV7SkLbQG6nFxZDTXD_yDp6wFZCOn3dilHNMgii6PVi7ch8vmh02tg46RU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpsh9RAC5CekgETpx-ZV3Le-vjtE2HJFp7A2Ye4KN3Pw&oe=6AA938C4"}, {"file_name": "04-library.png", "id": "2056452011930408", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823341_2056452018597074_4072482199744490079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLgz6p8VO48Q7kNvwEiIUrg&_nc_oc=AdqrdsZzHRXHn8p02Dn7VurNczT3MUh6aUFfnE7cpWs3lugftG_025ClyBjlt6u48c4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4Odhj1bHkHzulfo7S2eh9MqoYQ4dh9rDJcvNZNgPp1Q&oe=6AA943C6"}, {"file_name": "05-watchparty.png", "id": "1059749396741215", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/585819904_1059749400074548_5840519737141081579_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvaC4AqJpCgQ7kNvwEzxCs6&_nc_oc=AdorgNAfA-uhbVp_sAGf9Od81WF9yPGC808rcXwEI0Gl6yVoKwvR3J_sxoZWMfQbaXA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdA2bQcDQFgDrs-h3qM8v9T1pzMBtWmCSU0fOx6MChUg&oe=6AA95107"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "vr180", "movies", "immersive"], "long_description": "**Your own movie collection, in immersive 3D.**\n\nkoko plays what is already yours. A Plex or Jellyfin server, a NAS, a USB stick, a folder on your computer. No accounts, no ads, no subscription, and nothing uploaded anywhere.\n\n**FEATURE HIGHLIGHTS**\n\n**Every immersive format, detected automatically**\n\nVR180 and 360, side by side and top-bottom, Apple spatial video, 3D Blu-ray. koko reads the format and puts you inside it.\n\n**Flat films, converted to 3D**\n\nThe free desktop companion runs a depth model over every frame and builds the second eye, so an ordinary film arrives in immersive 3D while it plays. A neural upscaler rebuilds a soft source up to 4K.\n\n**8K and HDR, at full resolution**\n\nHDR10 and HLG are recognised on their own, and 8K files play as they are, untouched.\n\n**Watch together, privately**\n\nSynced rooms with voice chat for a few friends. No public feed, no strangers.\n\nYour library, your network, your screen. Try it free, and one purchase unlocks everything.\n\nGood to know: DRM-protected streaming sites open in the in-app browser and play in SD, a hardware limit. Full resolution applies to your own libraries, local files and DRM-free web. koko plays what you own or are authorised to access.\n", "short_description": "Your own movie collection, in immersive 3D. Connect a Plex or Jellyfin server, a NAS, a USB drive or a folder on your PC, and press play. Films shot in VR180, 360, side by side or Apple spatial video are recognised on sight. Flat ones can be converted while they play by the free desktop companion, which also AI upscales a soft source up to 4K. 8K and HDR play untouched. No accounts, no ads, no subscription, nothing uploaded. Try it free, then one purchase unlocks everything."}]}, "developer_name": "Krafti", "developer_privacy_policy_url": "https://koko.krafti.io/privacy", "developer_terms_of_service_url": "https://koko.krafti.io/terms", "publisher_name": "Krafti", "support_website_url": "https://koko.krafti.io/support", "website_url": "https://koko.krafti.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR", "it", "pt_BR", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1224987227373458"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825470_1670334497601467_8389518644238336381_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgAIJUyNPasQ7kNvwHlt2R0&_nc_oc=Adpf2o6FqVjUQFo77_KQwUT-PppcxfYaQz5DKJBENevpZAzWqGvg63-zM3OoWjnCl8s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKONQneMEuV9b_ZPbcsE_7zpJtIGOCuXuSIkAf-CjR5rQ&oe=6AA95E2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "koko VR Theater", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1783601520, "lastRevision": {"nodes": [{"id": "1124509360754579", "release_type":
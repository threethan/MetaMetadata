5806763437", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828104_2240725810096770_833166801810821345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l2Iq5i01EMQ7kNvwEyhmYI&_nc_oc=AdqiKq-UBAQYh0PVsWGOMjso74ntte5WWcakTP2D7wuJH4Nox84bMBCGZLiTzVH5nDw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7TKNWZYrwm5GLL4GS2j3fZm6CwhK_dvbMc1meteV4Gg&oe=6A858F33"}, {"file_name": "02-player.png", "id": "2013631142851011", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827585_2013631149517677_1058163009373961794_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ3R21nDZCIQ7kNvwFzT9Gr&_nc_oc=AdpfWJKdctZCnqzcyztmVeGMltEPFuUYS7cRrSjJYUHEcCivt0rYigOf58JMQZKyvEQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMFX1THSukYa4bs7GLY0nRdTw5QZ_CVSQdYthwpK4MZA&oe=6A85A800"}, {"file_name": "03-detail.png", "id": "1024674043649769", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823351_1024674046983102_3449906024102859963_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Pm11z2dHU0Q7kNvwFkLZoX&_nc_oc=AdpBPcyqFkxV--eowUSo4X98VdbQTZO3mVJmHtMA_sxXcHEyd4CuvJwhoX87E4ovE18&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdZWtvcUWUke1iFB8kRhryjOdJr4ED_gr6EHgrIwineA&oe=6A85A044"}, {"file_name": "04-library.png", "id": "2056452011930408", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823341_2056452018597074_4072482199744490079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvTycI1uq88Q7kNvwFk-ry0&_nc_oc=AdroVeJ7gmLNOEKteor0pJ1W0m9yW8-clXkBTwc9XzCRIwL5cXjSyRIgOL0yEPr1O84&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE294w5TWYiLwoBULFXP5L6wgNwsa2VvXkiQkhrdey_sw&oe=6A85AB46"}, {"file_name": "05-watchparty.png", "id": "1059749396741215", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/585819904_1059749400074548_5840519737141081579_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3JGsLE03FYQ7kNvwEtN15c&_nc_oc=AdoFrkP95j1GyGvlO3V445YQokwZYZ6n4c3fR8nBWYIG78ZZeDNOvCPMc3qaLSngE2Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAh6aIe_an0D4NOYhuIf456If9-N4sk_wnaI7-AXyt8g&oe=6A858047"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "# Your library, on the biggest cinema screen imaginable\n\nkoko VR Theater turns your Quest into a private cinema for your videos. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse USB drives, network shares and local files. No accounts, no ads, no subscriptions.\n\n**Play almost anything**\n\n- 2D and 3D: SBS, top-bottom, frame-sequential, VR180 and VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10 and HLG, with format detected automatically\n\n**Make it look its best**\n\n- Plays 8K sources at full resolution, no transcoding\n- AI upscaling sharpens lower-res video\n- Fine-tune brightness, contrast, gamma and screen geometry\n\n**Your whole library, one place**\n\n- Full Plex & Jellyfin: hubs, history, subtitles, audio tracks\n- USB, SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, download for offline, resume anywhere\n\n**Watch together**\n\n- Private rooms with synced playback, voice chat and reactions\n- Mute, block and report, plus an optional relay that hides your IP\n\n**Comfort & immersion**\n\n- Hand tracking, built-in VR browser, passthrough and skyboxes\n- Spatial audio and subtitles you can style\n\nTry it free. Unlock everything with one purchase, no subscription.\n\n**Good to know:** DRM-protected streaming sites open in the in-app browser and play in SD (hardware limits). Full native resolution applies to your own libraries, local files and DRM-free web. koko plays what you own or are authorized to access.\n", "short_description": "Your library, on the biggest cinema screen imaginable. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's or family's \u2014 or browse your NAS, USB and local files over SMB, FTP and more. Play your videos in 2D, 3D, VR180/360, Apple spatial video and HDR, up to full-resolution 8K, with real-time AI upscaling for lower-res video. Watch solo, or together in private synced rooms with voice chat. No accounts, no ads, no subscription \u2014 try it free, then unlock everything with one purchase.\n"}]}, "developer_name": "Krafti", "developer_privacy_policy_url": "https://koko.krafti.io/privacy", "developer_terms_of_service_url": "https://koko.krafti.io/terms", "publisher_name": "Krafti", "support_website_url": "https://koko.krafti.io/support", "website_url": "https://koko.krafti.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR", "it", "pt_BR", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1173641669174681"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825470_1670334497601467_8389518644238336381_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WsCdzT-U9wQ7kNvwHkjimz&_nc_oc=AdrbPAn0rplUW4giAzXPorz85dlWWrZevEfX13dR_NF2N4eHOM8CUNFwezxJGpEix0Q&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU0JP4k7-SfGnzO3bedHRHXhxlSqXti93Uo46L3GwnJQ&oe=6A858D6F"}, "is_concept": false, "is_test": false, "is_trial_offer_va
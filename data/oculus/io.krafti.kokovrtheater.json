https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823783_1004915348925599_7044245490366722346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0niDnCQW3l4Q7kNvwGCGJFc&_nc_oc=Adpzzw8No1DqL8m7SbrHdjSTAwQ63igGGsDeBOavDBsb9zkmeUk4hynMtJPyAeH7FQ4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOPLBjtkPPT9O0fZy40Pn-1qp1jQZ_iO9D3EFP2x-pbg&oe=6A58E806"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HA3q3kXZergQ7kNvwEv2K0i&_nc_oc=AdpIe03Bqs-nV1rk1PbA8SI-ctgWNj-Ryq-uUwN_lRdr1I5Ao1KPPDOcRaUAOidAo2I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRQfx33QzdqSPzMMjbztEmzcskos0B9y7PsgvjWZHCHw&oe=6A58C5E9"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_Q4uw0-mCcQ7kNvwFl3TVy&_nc_oc=AdqtLxlkkxP7GrxA6fT4zCRwy2ksQIpgikWE_dRlpi86QUPGalMCWbMUiqHsOzcx-CM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALJS2jYfzI1Px05du_kbfjWEYMT1zV1PndVpvf6tzhyg&oe=6A58E915"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLeedxNkVE4Q7kNvwFkSQqu&_nc_oc=Adp9XNcmL80wsF8S0sda1OLZ2ddtHA8ANimm3at1KTXYGVc2ArCOF4G4q_KVtp-cQLM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzFe2pIRkpHX_GXo0WNEnKQNYFLO0m4aHvOqub7pP6Zw&oe=6A58E24F"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arRABGMbAQoQ7kNvwHwCX7g&_nc_oc=AdoBvI6ItJdZu2WKecR51vUDqU4u15CU6kxD2DnNDcOgBJpd4siXyMWIF4U-fw2b5oM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8kA7EtRiOB0W6vmxAr2VsHEv6jj0VRk-k6NuBwn0Kfw&oe=6A58D773"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2
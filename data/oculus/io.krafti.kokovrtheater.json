CJOVuQsZLi-CN6K1EG7lwDuxwQ53MNEVV_DBV4SKproJchg9qv-LI7a9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRReGG0CzrN_kpItg467_raw8Th6Nx612bctmTyhVr60w&oe=6B0DBDC6"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2egjaxNfQL0Q7kNvwGW0uGa&_nc_oc=AdpdVFLlM6Mc-7qMNE43QoOwpVlb0yMnNSEt_y36wrY3eZQKo81MQAF5UTMgpEF1fmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8H0q7T_BqnEjOFiNtPa4tWmrqG6CSbIi407c9ANSbyQ&oe=6B0D9BA9"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTc0uG2UnasQ7kNvwHg4FpH&_nc_oc=AdoEVb6Vgc5DrzjniaXiGaspCqAntQu5eNBZ93dWx_Cj40kMsp0w1Vmbwv19i8seFRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ85HiFHzxT5aqLiZeeUHonnbDWjyfvflu4TS81DBvFuA&oe=6B0DBED5"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br0TeFQ21UEQ7kNvwGcU70Q&_nc_oc=AdpBrgERSRWhXDJyu5hwULMlMg45RbuOtv7bF080LvfL8s0_RuuaWSrlwpg8YbuDLtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSAapoT9NPKOCoG0vTcRoy5lqPUiCcGsE7ujHUR9Kujwg&oe=6B0DB80F"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcm6Ow3eU_YQ7kNvwHUH3OD&_nc_oc=AdolRzSPaXZ2pdAE_5F6srQoqKwuiH1dDMSevAf77i_khUv4BWjVSGWscO3RcDpaKB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGuS_df095fG1yncLhjBD8Qm-Vvsxo7SVovQCZJUJ_UQ&oe=6B0DAD33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2014 AI-upscaled and razor-sharp."}]}, "developer_name": "Krafti", "developer_privacy_
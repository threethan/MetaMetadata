https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1004915348925599_7044245490366722346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWWOjookA70Q7kNvwFnNi6t&_nc_oc=AdqUM_MujA1UyX-9pMzjFRUJH-wdd_855X34_5_VF7bse1_g-vJ1VagX0WKHs_-LnAI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIueI5XQcNgCEqMouhfkvx4NKJpbXuzt_6Ggptk6Zihw&oe=6A5F7F86"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewsOR8q4hbAQ7kNvwFGcaMA&_nc_oc=AdqBEY-oubiOVsNrhFe9mdM_zuQNXr6bisXOjdfWyFTnT7VVxCOclNLqt3ik6vxTKxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAonJgdaA1CwKF_yg_Oid9fPhHfx6KNcyh1zOQxnWZa_A&oe=6A5F5D69"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcjQjeIZP20Q7kNvwH3E321&_nc_oc=AdpmAthy9AuPVkyGSfjZhSk4oRWHy6NvRYx9Pp1dWgBR7jaXo42mYu3w98dpYc3tQ-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgcsbGr2zisTDFSPA98HBhXyOa6XPW0ImqQC72kagzIA&oe=6A5F8095"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYLRh4umUKIQ7kNvwG5ms7j&_nc_oc=AdrIbD1amzZatl35XBGG89xI1VM49Ks2hVswvAUPlw0jh4t6Tim8kTS89QqKbJ31EoQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSLn47IZ8bNp3pFm4jLikRIsBdEwcGTa9k8BG6LGeYFg&oe=6A5F79CF"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4zYEIOKYkwQ7kNvwGXB6gl&_nc_oc=Adr-SrBi6kv7R-AqYAo282YTR5HL8MPmi1AY7d0MQ0FEedY7IPpccU-fAxsE243n-iI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZW3t6UW4GdvYPjnBWLAEqYOINvSlezAtTjPnd6rEchQ&oe=6A5F6EF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2
ontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92MG7QV3Oj8Q7kNvwG1fCSa&_nc_oc=Adqg7lb8HZYyXooQhfVqOTKPNvqV4KjZkFbg60ItgjQmgfs2nj8A7rof3mJEdqSc2yY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI_EBW1CGvGdk-Q4EkieEvnJX0Oy7uNOMYPLxq2i4iNw&oe=6A7C4955"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juPMkYjQZBEQ7kNvwFl0C7T&_nc_oc=AdpD_m7SH7cZTk4uUeNyHGQACDjkAfCSI7L0h_QANM1qGXYo6wJKs5Sqr5eTLFBbaIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaPZI8sjaMF-GzFEgBdNpEK9yMNt4kq68BVrbHfzHqQw&oe=6A7C7ACF"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8S41Mgcd8YQ7kNvwGlOuVJ&_nc_oc=AdqoxfJCpqfGwCiemXdp7CO2aq6C0Ex52Og005Mvx4VHpmFWIqrOE3xhbGESwY9S3Co&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUQY4n6ANX1i2-8Yaq44muchfoRAW4Rw8qa1ZzTru3RQ&oe=6A7C6FF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2014 AI-upscaled and razor-sharp."}]}, "developer_name": "Krafti", "developer_privacy_policy_url": "https://koko.krafti.io/privacy", "developer_terms_of_service_url": "https://koko.krafti.io/terms", "publisher_name": "Krafti", "support_website_url": "https://koko.krafti.io/support", "website_url": "https://koko.krafti.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR"
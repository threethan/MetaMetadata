06763437", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828104_2240725810096770_833166801810821345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-QpBdN92AUQ7kNvwFL3d3n&_nc_oc=Adr4o_QaPvWSCK7OeVBer_cZx-227r3dsqSnLRKUDyMp0FfX1mjOExKeaNvS3pdj90k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7jOu8IeF1YBkFP3wa3BXM5rEdXF5Le_cSDuEmreJgsA&oe=6A7DA633"}, {"file_name": "02-player.png", "id": "2013631142851011", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827585_2013631149517677_1058163009373961794_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR350UG_87gQ7kNvwGTIvJI&_nc_oc=Ado4ce9gLCoSzSOAViCRLCa8sc7gnYziQK3NW0PoTJO40SLn74aPyaFmzzEI869VdAc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8-uZ_vEqOd2DcErvLG9w18eDACE3RV24AdgKdnTlI1A&oe=6A7DBF00"}, {"file_name": "03-detail.png", "id": "1024674043649769", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823351_1024674046983102_3449906024102859963_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pegunDIQM4gQ7kNvwEW-STT&_nc_oc=AdrJbh_pZc27YFmUqBsaFlEOUL4vx5T7rdTBM-aKXujyqqzr45scfn8PibNC3iZqs9k&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX9lM_8mqV9LDazNx5_boXy_QF6afSBaYT_9zL_-cSEw&oe=6A7DB744"}, {"file_name": "04-library.png", "id": "2056452011930408", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823341_2056452018597074_4072482199744490079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxURFtzqN0oQ7kNvwGUjryS&_nc_oc=AdqkqKJVIS1q51lfFIzk4sUxkd-OrvrVH0gkcGoXzA5GlQp5B69dGC0DiQGVonNJQkA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAmRWB6aZDB-o5f2ErRIdHfMvvuGQ3KtGnUh-OiaqIYA&oe=6A7DC246"}, {"file_name": "05-watchparty.png", "id": "1059749396741215", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/585819904_1059749400074548_5840519737141081579_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCwlH651mgkQ7kNvwEuZT0y&_nc_oc=AdomHrNHYzsNSSmhMJ0B2_qSVOc7P4TIHiGSGRBB7t0RsW5tWVeXiwFEkxqquQFDhts&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRgzjwm7dFhOG-WCrnFtXexQStqtDMDFtjC9aoA5BmVg&oe=6A7DCF87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "# Your library, on the biggest cinema screen imaginable\n\nkoko VR Theater turns your Quest into a private cinema for your videos. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse USB drives, network shares and local files. No accounts, no ads, no subscriptions.\n\n**Play almost anything**\n\n- 2D and 3D: SBS, top-bottom, frame-sequential, VR180 and VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10 and HLG, with format detected automatically\n\n**Make it look its best**\n\n- Plays 8K sources at full resolution, no transcoding\n- AI upscaling sharpens lower-res video\n- Fine-tune brightness, contrast, gamma and screen geometry\n\n**Your whole library, one place**\n\n- Full Plex & Jellyfin: hubs, history, subtitles, audio tracks\n- USB, SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, download for offline, resume anywhere\n\n**Watch together**\n\n- Private rooms with synced playback, voice chat and reactions\n- Mute, block and report, plus an optional relay that hides your IP\n\n**Comfort & immersion**\n\n- Hand tracking, built-in VR browser, passthrough and skyboxes\n- Spatial audio and subtitles you can style\n\nTry it free. Unlock everything with one purchase, no subscription.\n\n**Good to know:** DRM-protected streaming sites open in the in-app browser and play in SD (hardware limits). Full native resolution applies to your own libraries, local files and DRM-free web. koko plays what you own or are authorized to access.\n", "short_description": "Your library, on the biggest cinema screen imaginable. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's or family's \u2014 or browse your NAS, USB and local files over SMB, FTP and more. Play your videos in 2D, 3D, VR180/360, Apple spatial video and HDR, up to full-resolution 8K, with real-time AI upscaling for lower-res video. Watch solo, or together in private synced rooms with voice chat. No accounts, no ads, no subscription \u2014 try it free, then unlock everything with one purchase.\n"}]}, "developer_name": "Krafti", "developer_privacy_policy_url": "https://koko.krafti.io/privacy", "developer_terms_of_service_url": "https://koko.krafti.io/terms", "publisher_name": "Krafti", "support_website_url": "https://koko.krafti.io/support", "website_url": "https://koko.krafti.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR", "it", "pt_BR", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1173641669174681"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825470_1670334497601467_8389518644238336381_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NrSr0FelVQQ7kNvwE4aMNn&_nc_oc=AdoQeIOCO4BtLVVOzNV2i-vhLU1cHkBW6YPgZOO3-rd_FRsndnov6BcjC17zP2wOro0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRRj97QvI6nh9tVYJNJlDmOUdlLdwjXcogkLKO3QaPTA&oe=6A7DA46F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fals
Z&_nc_oc=Adq56ldIo-4m2iCAv_7JdOoEbpV7UfniZmLIZHyTIYMHmfBkZux91KZ_E3TeHbo1qnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJK9a4wK5pXfy0bHGGj9Qi49swevdDJXjPHloI-PD6Mg&oe=6A9852D0"}, {"file_name": "portrait.png", "id": "984498734340313", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_984498741006979_6867091033828434887_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Y2hSvKK0zIQ7kNvwGq8Vel&_nc_oc=AdpDAfRGLP4Cq3TtSHlo2JwgK5X925Z7dAd3ktftk_rDVR_4bnmPsEw7O00tw8HPUhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGLbhhbnjRevc9y28b1oN2HagQkDvUpmKwI9eRuHoJ6g&oe=6A98620E"}]}, "id": "2458940581274914", "locale": "en_US", "screenshots": [{"file_name": "01-cinema.png", "id": "1004915345592266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1004915348925599_7044245490366722346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=457W1eDlHBsQ7kNvwGNCjq8&_nc_oc=AdrJ_6gvB4CJpyKnaFvziThw4NW91keb0mMxQm_FQfjMSMBKdYz-cOryMzxawKOYiCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIoGVPyVaYzNvenFsMBHY70HTxSd7zuVLUowEaAidpdA&oe=6A986846"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKNQYKWDdyoQ7kNvwFDLDkN&_nc_oc=Adq-Aq_fpktFN2bOFoRc5rsHKPd2ZVyp5LkUBE6pFvC8EyQViTf9yt4ffbD5aRh9x-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwZoMfbeNJsqc8ef9qdswTS3AshyD0HdxVsFikxKQjVQ&oe=6A984629"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPSqWf5QG2IQ7kNvwFtSarB&_nc_oc=AdoERXbsyozekbfdSgEptn9evixAmAccxsMlxuOXtElhIx1RPkLuelYwoMcC-1y9Fxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSAi2vrfkLTn1wW42kHcUOUStT0106p5NRxXz0DWHSCA&oe=6A986955"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3V9_Q3uE41EQ7kNvwFc6RRI&_nc_oc=AdqeRmOazB7cW-VcwOXOan98wtlu4X_2OwoswJCO3v-lKY1UoPXp5Um4-7DaFbepkpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe8WkG5h5s08YSkhil1SFHz9Pp5_5LyEuwx4X2yOZ18Q&oe=6A98628F"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cofHZijNm3sQ7kNvwGSLrQM&_nc_oc=AdqcuMsTJPpWe-50FLFusDZktiX9ApP_nSOTvJilB7N-H0VttKj50rWil6XXHHSTFXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZJyEHEopB7FE_SXNKG2N99K3uFYV7SdJV6QNImKN1UQ&oe=6A9857B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2014 AI-upscaled and razor-sharp."}]}, "developer_name": "Krafti", "developer_privacy_policy_url": "https://koko.krafti.io/privacy", "developer_terms_of_service_url": "https://koko.krafti.io/terms", "publisher_name": "Krafti", "support_website_url": "https://koko.krafti.io/support", "website_url": "https://koko.krafti.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR", "it", "pt_BR", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1124509354087913"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED",
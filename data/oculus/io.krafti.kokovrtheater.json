7kRh_9iowOrGT3Oii_8VWUmZbwGm9UIoGyEj_x27mNYN82qTG1cQv3uEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVucUDJ_3oPQuf0Jf5SXQj4yFtkW9DhDnFBzTuivX3JOQ&oe=6B1060C6"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08CN2vz72fQQ7kNvwHBY7tz&_nc_oc=AdopM9E8GzCa7VxFDowuUJuhoL5nolf6go6t88FcOJ8xU-ufRXF6XyPaZqkp65-7r1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzqAQKP4iEKzDzHmA5YZPFf8aAZ_RWzCcxn5-U9qStpA&oe=6B103EA9"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRO-H30f_98Q7kNvwHC3FSz&_nc_oc=AdqtMkokckfB2-ZnfUe7IfLqsRMuP0ext7-cBX0heJH6oQJGAg8OV_HHt-m5DjprG6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcYYjaHdRbjlpWuijFT4eEuA_saFEP1gkmnO7zvr6DXA&oe=6B1061D5"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br0TeFQ21UEQ7kNvwHttL9d&_nc_oc=AdpHYcSsgr1cE7M0p66LpFCyiGfyJZJtHWmriQSw-0W2i9XgD2Spy33-RrQcXi-hMuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8wY9xf1JB8PGmWuqpijhBDqC9nHkoNtQ017l4Uu8inA&oe=6B105B0F"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLkLexcr60kQ7kNvwEatA-t&_nc_oc=AdrI2CgS4iuJWLABtLSmqg71TmKGnOZNPzs-0CGaF_3iyMpfyfU1fIvOgS_mIQdD8uc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwXXRNCZPp6XTtBhBp8rs0fcq29bZ_-T26gc4E7a2YFQ&oe=6B105033"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2014 AI-upscaled and razor-sharp."}]}, "developer_name": "Krafti", "developer_privacy_
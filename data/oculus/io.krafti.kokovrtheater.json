https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823783_1004915348925599_7044245490366722346_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJEXZkgd5HgQ7kNvwHCghlt&_nc_oc=Adp2OV9PHc74HjY-kbqlcJkiqgaJSqPeEuanSSR7f3OIq-ArpJgkF63HeMoF-5h8Ads&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqP_CnODaf1Qvd5_zkawzaD967ViETdcbEHBu8SfwSqQ&oe=6A622286"}, {"file_name": "02-detail.png", "id": "1683881019522173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1683881026188839_4148983970693008391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMfoG7jM9C0Q7kNvwGB8H7o&_nc_oc=AdoWHkHDoDBVwK7FZLDfKBCtntIuEUkcOwxNori1-6h5VCtQgzV1ksxLo7-Eb-58Rm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ9WVOSXRrrnOk-4AuP51o72cvqm4RDE2BLZL26ZW3-A&oe=6A620069"}, {"file_name": "04-home.png", "id": "1325026019199598", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_1325026022532931_3150413738957407970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0Nji6dD9_AQ7kNvwFzElLU&_nc_oc=AdporcJtmKjh_5jDsuWrik8LnvwnX33nV_8hfSmeL6-cuKYNRYxJ-yM-1Mtztfol6RA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSM20rkwf0sGqceJAUWGU0eDfmPqAkQeYcJI_bfi9htw&oe=6A622395"}, {"file_name": "03-library.png", "id": "996527066514223", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827585_996527069847556_5707853987992938826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYLRh4umUKIQ7kNvwHnaZ3u&_nc_oc=AdoL394C1Zm_f2fDuMkzNoED6YgOK36HrrMIfxSvF7AKUFV4sQrDDdDDPp-EY_yDN5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIjaOLP_mb2VKRl_wuKgBQjLeVgYhGikqmXIIama_kRQ&oe=6A621CCF"}, {"file_name": "06-network.png", "id": "2401194624048722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824318_2401194627382055_1059502897790844367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZt3kYDvDHAQ7kNvwHNyHea&_nc_oc=AdrWo7Sj9wZSwBv4MYE5zxqT4C7_4wtieWbAR8nL7Z04SCsdmcKd62DGyKFVjd95Bxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYBlQvL1bppCXj92LB0g5BH11p2003L6vANj8M_Ng9zg&oe=6A6211F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "koko VR Theater", "keywords": ["plex", "jellyfin", "cinema", "vr180", "movies"], "long_description": "**Your library. Your cinema. Your headset.**\n\nkoko VR Theater turns your Quest into a private cinema for video you already own. Sign in to any Plex or Jellyfin server \u2014 yours, a friend's, or family's \u2014 or browse your NAS and local files. No accounts, ads, or subscriptions.\n\n**Play almost anything**\n- 2D, 3D (SBS / Top-Bottom / Frame-Sequential), VR180 / VR360\n- Apple spatial video (MV-HEVC), 3D Blu-ray (MVC), fisheye\n- HDR10, HLG, Dolby Vision; auto format detection\n\n**Looks better than the source**\n- Real-time AI upscaling (MQSR + NIS)\n- Per-title calibration: brightness, contrast, saturation, gamma, geometry\n- Up to native 8K from your servers and DRM-free web\n\n**Your whole collection, organised**\n- Plex & Jellyfin first-class \u2014 hubs, history, subtitles, audio tracks\n- Local, USB & network: SMB, FTP, SFTP, WebDAV, DLNA/UPnP\n- Tag, filter, sort, custom libraries; offline downloads; bookmarks & resume\n\n**Comfort & immersion**\n- Crisp UI, hand tracking, built-in VR web browser\n- Passthrough and skyboxes; spatial audio; subtitle styling; seated comfort\n\n**Watch together (optional)**\n- Private rooms with synced playback, voice chat, reactions; mute/block/report\n\n**Good to know:** commercial streaming (Netflix, Prime, Disney+) plays in theater-mode SD through the in-app browser due to hardware DRM. Full native resolution \u2014 up to 8K \u2014 applies to your own Plex/Jellyfin/NAS, local files, and DRM-free web like YouTube. koko plays content you own or are authorised to access.\n", "short_description": "Watch your own movies in a personal VR cinema. Connect Plex, Jellyfin, your NAS,\nUSB or local files. 2D, 3D, VR180/360, HDR \u2
m&_nc_ss=7f30f&oh=00_AQRYsoR85vZ1OsjNB5VCkvKmg5rzV9CYERVVWaSonClbVA&oe=6B0C5161"}, {"file_name": "screen5.png", "id": "3299743483617232", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974762_3299743486950565_6130487559359328668_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDZok17HxD4Q7kNvwEsFqzd&_nc_oc=AdqzaLvTpZGXek_jGMR90uOPGjA6slPuzJzyliXLyubS_0p6n5s5alyI9o2qdH5c04Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTg7P8yLEQKRHhTMtBKWhdFMh3MY_SI11Hsko2xvzIT-w&oe=6B0C80E9"}, {"file_name": "screen_2560x1440_2022-11-08_09-04-30.png", "id": "794930504934924", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001720_794930508268257_449187606991301853_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STJw3FqtrwAQ7kNvwEscGwa&_nc_oc=AdqyuasIxZ1S2Z0NeC9Hk0c0AK0DtyOzzbR5hlCbg2-zfe9Y4aYbkqbMJRcfffh7r70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtr6mjwZUdSsvqFtlD842w4NQspAd7SHyiF3MF8ZXFgQ&oe=6B0C74F1"}, {"file_name": "screen_2560x1440_2022-11-08_09-05-12.png", "id": "659080015876849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556277_659080019210182_5078018327460835281_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddRoRyZ7vHgQ7kNvwHDBTP8&_nc_oc=AdpROQHIpJi7yRqZYxFD3wyOD4ghs9dBVah_Cz9Hji0looGOIphN2TnEmyzyx6fZBho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlAIW7NFmwcRRPq_IhOtWLAi6HNPo99Hdx1ycoXZdBTA&oe=6B0C77D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video pic.png", "id": "1148834179328242", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_1148834182661575_6463776573512271020_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riV0tCFDbUwQ7kNvwFmQocZ&_nc_oc=Ado-Oe33SubbAQ3QlX9VywuPhCRf4cC30SEok_kXbtx4fLjxIrV_qx_RQdatt5U-zWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRw4UqjAy-L24CDgtiHVtjbAYHmkYj7kJ3v1S8pgIjsJg&oe=6B0C6AE0"}, "display_name": "Lasertag Legends", "keywords": [], "long_description": "Lasertag Legends is a multiplayer lasertag game.\n\nThe action takes place in a colorful, neon lit lasertag arena sometime in the near future.\n\nChoose a team, get in the arena and start fragging! \n\nEach frag helps push your team up the league table. \n\nAt the end of the season, one team will be crowned champions of the Royal Lasertag League.\n\nLasertag Legends features 3 main modes:\n\nMultiplayer Modes:\n- The Main Stage: Battle it out against other players in the Lasertag Legends Arena \n\n- The Cube: Practice your aim by battling against other players in a small map\n\nSingleplayer Mode: \n- Dino Hunt: Survive against a vicious hoard of holographic dinosaurs \n\nNeed a break? Head to the lobby to hang out, watch a concert, change your tagger or check out your stats.\n\nThe game places a focus on teams instead of individual stats. Choose from one of 20 lasertag teams. Once you choose a team, all your frags contribute to your team's overall score. In the lobby, you can see the league table and where each team stands. At the end of the season, one team will be crowned champions.\n\nSee you in the arena.\n\n\n\n\n\n", "short_description": "Live. Laugh. Lasertag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lasertaglegends.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Team Royal Games", "support_website_url": "https://lasertaglegends.com/support", "website_url": "https://lasertaglegends.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
m&_nc_ss=7f20f&oh=00_AQT_nDpDEeOGNQugBbo85PA8O4VZIUgjdctufkAB8I9pWw&oe=6AFF2261"}, {"file_name": "screen5.png", "id": "3299743483617232", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974762_3299743486950565_6130487559359328668_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6avl0bOuZLUQ7kNvwH42uLz&_nc_oc=AdrtL7aJKfD1tQjPRkog0m1I3vrqd6oqovAEVhPOfuT6XT2npeQv7QetPmIgqcyJqYY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQlFVJ7cL3aJUFSVrIhMS-9O43Seb_jM6v18aWtRS4vw&oe=6AFF19A9"}, {"file_name": "screen_2560x1440_2022-11-08_09-04-30.png", "id": "794930504934924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001720_794930508268257_449187606991301853_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRl5aAcPEaoQ7kNvwHvDKli&_nc_oc=Adrke8YzIkivYrx80J6rzQHuu47T13q5Z0eQIuRGPa997UOhAAKMnX5-Tyak09prLpw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUSDnduw1toJY6UsI1GmCP7SbauP7WkKkDClRcMN89aw&oe=6AFF0DB1"}, {"file_name": "screen_2560x1440_2022-11-08_09-05-12.png", "id": "659080015876849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556277_659080019210182_5078018327460835281_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-v76l2kg5EQ7kNvwFTumWO&_nc_oc=AdplRlx2Y7IyDS0RPYkG_qQiOMLhal4MJh3sIIBHPYaC9S88tVQaHwu8Rcqc4Y2TjBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfinrvmC5dChKKTwmP8bSQ_IdK_k4dqcam0hRIDWzsmQ&oe=6AFF1090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video pic.png", "id": "1148834179328242", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_1148834182661575_6463776573512271020_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40SmvWWn4scQ7kNvwGelO8S&_nc_oc=AdpUNdDxWje97sPHIYeBJRPfCOVflfUEWuSv8hxIOT04VDGVqye_9dbnHvVxgKWSty0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAhnQeqtl2G9PPn9971yqIW-2Rz271d3iIcGghiKbshA&oe=6AFF03A0"}, "display_name": "Lasertag Legends", "keywords": [], "long_description": "Lasertag Legends is a multiplayer lasertag game.\n\nThe action takes place in a colorful, neon lit lasertag arena sometime in the near future.\n\nChoose a team, get in the arena and start fragging! \n\nEach frag helps push your team up the league table. \n\nAt the end of the season, one team will be crowned champions of the Royal Lasertag League.\n\nLasertag Legends features 3 main modes:\n\nMultiplayer Modes:\n- The Main Stage: Battle it out against other players in the Lasertag Legends Arena \n\n- The Cube: Practice your aim by battling against other players in a small map\n\nSingleplayer Mode: \n- Dino Hunt: Survive against a vicious hoard of holographic dinosaurs \n\nNeed a break? Head to the lobby to hang out, watch a concert, change your tagger or check out your stats.\n\nThe game places a focus on teams instead of individual stats. Choose from one of 20 lasertag teams. Once you choose a team, all your frags contribute to your team's overall score. In the lobby, you can see the league table and where each team stands. At the end of the season, one team will be crowned champions.\n\nSee you in the arena.\n\n\n\n\n\n", "short_description": "Live. Laugh. Lasertag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lasertaglegends.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Team Royal Games", "support_website_url": "https://lasertaglegends.com/support", "website_url": "https://lasertaglegends.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
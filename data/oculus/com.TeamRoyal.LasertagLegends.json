m&_nc_ss=7f20f&oh=00_AQSq0WflL_kiflEQC2rMpPcFqginbGvLgYlOg0aBdAsyOQ&oe=6AFDD0E1"}, {"file_name": "screen5.png", "id": "3299743483617232", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974762_3299743486950565_6130487559359328668_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7YMpezMnd8Q7kNvwHwLC-E&_nc_oc=AdqZhU1iGQPzyX5NjcqHn5gidRksrpN67QtfQDREdQBr1emyY3RW9xBfa5x4MO4CuqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT46Sr1tY4q87bH5nXl4lku3E8DTA0Rd-AAhxvVe-eVHQ&oe=6AFDC829"}, {"file_name": "screen_2560x1440_2022-11-08_09-04-30.png", "id": "794930504934924", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001720_794930508268257_449187606991301853_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRl5aAcPEaoQ7kNvwH9xEsm&_nc_oc=AdqUlnMWgQMqvOAwLCPWcSnNFYj918-7HTwm6aOVHsEyI_GHFsWLAEDIc1yEPD-ya6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDLwRwnwzbnFv-eELp43h2nsy6j0PttGwGP9PQPnVczQ&oe=6AFDBC31"}, {"file_name": "screen_2560x1440_2022-11-08_09-05-12.png", "id": "659080015876849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_659080019210182_5078018327460835281_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-v76l2kg5EQ7kNvwF-Ulsd&_nc_oc=Adr-a-QFslL2OZZm9P8vmw1lod6ZJSWmrbx7MNNsxQ7DgqKD7cRg4h5GNXbIZ0RMSWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS7Z4DTlp4FVb2YbLWHTUYZgEE4dWfi0R09aLK8belvA&oe=6AFDBF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video pic.png", "id": "1148834179328242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_1148834182661575_6463776573512271020_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40SmvWWn4scQ7kNvwE1b-PJ&_nc_oc=AdrAvVFa6--_KmW72mzRJEJUEB9qrMP29nYdl3E6GuNYYUAzuXvhw6_uYI9b81y8cZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPX_45uMawG0E00AE21XXLLwBlTFYnP4ykvWTSRU8Y3Q&oe=6AFDB220"}, "display_name": "Lasertag Legends", "keywords": [], "long_description": "Lasertag Legends is a multiplayer lasertag game.\n\nThe action takes place in a colorful, neon lit lasertag arena sometime in the near future.\n\nChoose a team, get in the arena and start fragging! \n\nEach frag helps push your team up the league table. \n\nAt the end of the season, one team will be crowned champions of the Royal Lasertag League.\n\nLasertag Legends features 3 main modes:\n\nMultiplayer Modes:\n- The Main Stage: Battle it out against other players in the Lasertag Legends Arena \n\n- The Cube: Practice your aim by battling against other players in a small map\n\nSingleplayer Mode: \n- Dino Hunt: Survive against a vicious hoard of holographic dinosaurs \n\nNeed a break? Head to the lobby to hang out, watch a concert, change your tagger or check out your stats.\n\nThe game places a focus on teams instead of individual stats. Choose from one of 20 lasertag teams. Once you choose a team, all your frags contribute to your team's overall score. In the lobby, you can see the league table and where each team stands. At the end of the season, one team will be crowned champions.\n\nSee you in the arena.\n\n\n\n\n\n", "short_description": "Live. Laugh. Lasertag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lasertaglegends.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Team Royal Games", "support_website_url": "https://lasertaglegends.com/support", "website_url": "https://lasertaglegends.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
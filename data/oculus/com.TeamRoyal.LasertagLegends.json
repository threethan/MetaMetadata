m&_nc_ss=7f20f&oh=00_AQQDOfucyBg-nhwtEh-K104GMW1oQjjYj0pLmDcnnpydig&oe=6AFB2DE1"}, {"file_name": "screen5.png", "id": "3299743483617232", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974762_3299743486950565_6130487559359328668_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7YMpezMnd8Q7kNvwE1bDdl&_nc_oc=AdpreNwLVk0aRwmGYNYCrNrXhSb7tvcvpF6fv9HYBm3VGOpXCuMWHe0m7es_yhL9hwY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgfNx6qtlaeVPDfjZM8NER5TukcxTbrkja7t3tL45HoQ&oe=6AFB2529"}, {"file_name": "screen_2560x1440_2022-11-08_09-04-30.png", "id": "794930504934924", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001720_794930508268257_449187606991301853_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-rGmLW9hakQ7kNvwFbzuNo&_nc_oc=AdqC9Q74lFvY3dUPpwgJtCbomnMbfQ_qJE_nvpFX2UvH8a7XDQNVcHx3iboIgNZl83Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWVhJYQh8Ka52ia_QjAj031bbLyw6Ev3ire6P7e69-yg&oe=6AFB1931"}, {"file_name": "screen_2560x1440_2022-11-08_09-05-12.png", "id": "659080015876849", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75556277_659080019210182_5078018327460835281_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YWZ3dsHDi0Q7kNvwHiF0Vz&_nc_oc=AdrNZFavbLWvBa2uz1WipwsFlsPx7e-NepZy_n03rs9hlY0eNQ9iviS9rDpwfIbvCl8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVqdRczke8wygBtpk5_6cburu3npHCN6DTSjLUiVqTRw&oe=6AFB1C10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video pic.png", "id": "1148834179328242", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003247_1148834182661575_6463776573512271020_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHSRn1Q87WkQ7kNvwGcO8O1&_nc_oc=AdqP79vZPsy0VnTNzEMZ0V6rTWrL1swU4JRKik2XMgoi2mmaixlX5PrgBkpPYlUOXFA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4LASSfYCm5FCeJcuiU-Ygt82QNWxPXzlWEkDp6QBNJQ&oe=6AFB4760"}, "display_name": "Lasertag Legends", "keywords": [], "long_description": "Lasertag Legends is a multiplayer lasertag game.\n\nThe action takes place in a colorful, neon lit lasertag arena sometime in the near future.\n\nChoose a team, get in the arena and start fragging! \n\nEach frag helps push your team up the league table. \n\nAt the end of the season, one team will be crowned champions of the Royal Lasertag League.\n\nLasertag Legends features 3 main modes:\n\nMultiplayer Modes:\n- The Main Stage: Battle it out against other players in the Lasertag Legends Arena \n\n- The Cube: Practice your aim by battling against other players in a small map\n\nSingleplayer Mode: \n- Dino Hunt: Survive against a vicious hoard of holographic dinosaurs \n\nNeed a break? Head to the lobby to hang out, watch a concert, change your tagger or check out your stats.\n\nThe game places a focus on teams instead of individual stats. Choose from one of 20 lasertag teams. Once you choose a team, all your frags contribute to your team's overall score. In the lobby, you can see the league table and where each team stands. At the end of the season, one team will be crowned champions.\n\nSee you in the arena.\n\n\n\n\n\n", "short_description": "Live. Laugh. Lasertag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lasertaglegends.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Team Royal Games", "support_website_url": "https://lasertaglegends.com/support", "website_url": "https://lasertaglegends.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
m&_nc_ss=7f20f&oh=00_AQS6Bcxeqni9NDh1xYm5ZP4lwvkzheMbG2-kfGOElHtBUA&oe=6B0316E1"}, {"file_name": "screen5.png", "id": "3299743483617232", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974762_3299743486950565_6130487559359328668_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq0xyo1ng7AQ7kNvwEMSXB9&_nc_oc=AdqbOiw5_01CAIpdVVteTrlSIAW_p4dikK-xTJvlCE13vYDL__IVgJdQV1akuSTV87c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhWajOMpMW3v2erdnYgQpR-cprLZEi1xF9Hm4JzysWUQ&oe=6B030E29"}, {"file_name": "screen_2560x1440_2022-11-08_09-04-30.png", "id": "794930504934924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001720_794930508268257_449187606991301853_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjQIuUbjGnQQ7kNvwGtHUtv&_nc_oc=AdrOuO3uGs3VfvHSThkbW-1du_VRy2cCENu3PN5_8VAe7f8Fab-E6Dp4FtGKa8VNw0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU4HW284SwVvATyKG2FUikh6ePCd_mfLdCzVUHffgPGQ&oe=6B030231"}, {"file_name": "screen_2560x1440_2022-11-08_09-05-12.png", "id": "659080015876849", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75556277_659080019210182_5078018327460835281_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXwheEphY0MQ7kNvwFG7uVS&_nc_oc=Adoqb_pUcOvdQ6bEmhB-kkjGpHrRqQ7oDjJRLaleEmbVetjS_Ek_-Jpo2BQgaQutb-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbLOvREcvW3AqsWCOJzHId68eaPjZeiypoTQmLXvntrQ&oe=6B030510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video pic.png", "id": "1148834179328242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_1148834182661575_6463776573512271020_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SdmUWZOt6MQ7kNvwEf7jfD&_nc_oc=Adpr1ezL1MP5FXz3-i0Wo6bCSo1AxzM_dz49niIcZ7L_lSjO9n5yi5J5cyRUZTmFzUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPqcrs09PafbP5EULVVznt2jnp43L0KIkZ-U9j7H2Gzw&oe=6B033060"}, "display_name": "Lasertag Legends", "keywords": [], "long_description": "Lasertag Legends is a multiplayer lasertag game.\n\nThe action takes place in a colorful, neon lit lasertag arena sometime in the near future.\n\nChoose a team, get in the arena and start fragging! \n\nEach frag helps push your team up the league table. \n\nAt the end of the season, one team will be crowned champions of the Royal Lasertag League.\n\nLasertag Legends features 3 main modes:\n\nMultiplayer Modes:\n- The Main Stage: Battle it out against other players in the Lasertag Legends Arena \n\n- The Cube: Practice your aim by battling against other players in a small map\n\nSingleplayer Mode: \n- Dino Hunt: Survive against a vicious hoard of holographic dinosaurs \n\nNeed a break? Head to the lobby to hang out, watch a concert, change your tagger or check out your stats.\n\nThe game places a focus on teams instead of individual stats. Choose from one of 20 lasertag teams. Once you choose a team, all your frags contribute to your team's overall score. In the lobby, you can see the league table and where each team stands. At the end of the season, one team will be crowned champions.\n\nSee you in the arena.\n\n\n\n\n\n", "short_description": "Live. Laugh. Lasertag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lasertaglegends.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Team Royal Games", "support_website_url": "https://lasertaglegends.com/support", "website_url": "https://lasertaglegends.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
AjBH1xu5ZOh4Owb1Omixx9OsYXYcPSirpti8u_z0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afviqkx30UgkihpvV5OePQNWg8XW5-f5qmPxsb10_sy5lA&oe=69A57869"}, {"file_name": "screen_2560x1440_2022-11-08_09-04-30.png", "id": "794930504934924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001720_794930508268257_449187606991301853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIm6lmkuMlcQ7kNvwFgYTOO&_nc_oc=AdkswzqJDvQ_ctMTSvF2t3D2IvDD5XJsbiepW8-l9ro2SKQ3EDo345O58UMwMqGGJpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsOPh99WCW86lRtpAfcL2kO_CwkFNGOLAmdnnO2HeM83g&oe=69A56C71"}, {"file_name": "screen_2560x1440_2022-11-08_09-05-12.png", "id": "659080015876849", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556277_659080019210182_5078018327460835281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNt0hC8C8iMQ7kNvwFnaQsd&_nc_oc=AdlUFqTx8igm0KNxnm4UJFmmL_Z-P1CBXa5MRwSDvNWCn1HVtVexd_lWXHmZp8wvrPw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu8BX7u73M8LEizNxiAsNMy7eKffkY292DsQCyOWqZKEg&oe=69A56F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video pic.png", "id": "1148834179328242", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003247_1148834182661575_6463776573512271020_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7m8VmRlVjm0Q7kNvwGmx0gQ&_nc_oc=AdkjtZQgkKhYh-TDnpDR1A57XstiyXV_RmWpo-s41rTML8D_0X6M6QYFiKkweVZeMsw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftLMGHpVrHnpLAoGwtWySILalEK5BN3p6gvh-F5SpN4rA&oe=69A59AA0"}, "display_name": "Lasertag Legends", "keywords": [], "long_description": "Lasertag Legends is a multiplayer lasertag game.\n\nThe action takes place in a colorful, neon lit lasertag arena sometime in the near future.\n\nChoose a team, get in the arena and start fragging! \n\nEach frag helps push your team up the league table. \n\nAt the end of the season, one team will be crowned champions of the Royal Lasertag League.\n\nLasertag Legends features 3 main modes:\n\nMultiplayer Modes:\n- The Main Stage: Battle it out against other players in the Lasertag Legends Arena \n\n- The Cube: Practice your aim by battling against other players in a small map\n\nSingleplayer Mode: \n- Dino Hunt: Survive against a vicious hoard of holographic dinosaurs \n\nNeed a break? Head to the lobby to hang out, watch a concert, change your tagger or check out your stats.\n\nThe game places a focus on teams instead of individual stats. Choose from one of 20 lasertag teams. Once you choose a team, all your frags contribute to your team's overall score. In the lobby, you can see the league table and where each team stands. At the end of the season, one team will be crowned champions.\n\nSee you in the arena.\n\n\n\n\n\n", "short_description": "Live. Laugh. Lasertag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lasertaglegends.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Team Royal Games", "support_website_url": "https://lasertaglegends.com/support", "website_url": "https://lasertaglegends.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "2455940211237118"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974583_1857955247882366_3063533609655468850_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-
RgP8vkw9jmqDtPPg&oe=6A1B0291"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=css6KWKqVBIQ7kNvwHriY6t&_nc_oc=Adr7NeNyizyw2St27WLMqoSUR5taJMaCAANo9f3mOxuJZ5dMtUmTpqcchmD5XCaPv8w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af605TFI-lEu5NuYVTrxC0SL2Q6Xz_Vi2P02JGKiMbLWdA&oe=6A1AE645"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-kk4bzjFzwQ7kNvwFVBUGt&_nc_oc=AdqjSYKMsGv3fKuWEq2M2vAx5QEtOnPcoM1L_ToJe3Vyr8Ur0fZLMIRkRkIZj2iMUhI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fnms5LwyvAkIte0OXlg3uD-i7aDmr2Ed72SfCH9UKfQ&oe=6A1B07A0"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSKBpHn8JuIQ7kNvwFHcGkH&_nc_oc=AdrQRgPiG8vwIzTUHgCxEybXXzEcyuRsXYThIl5qAmRdf_EmKctV-o1Mz4JBHJ62344&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af737qhPITXP0ibUoHFL_DgwbzESoI6SLc_bx8iUITex1A&oe=6A1AE930"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz5byhf6kX0Q7kNvwH-c2iu&_nc_oc=Adq9Rv5G8XE09fT1fVHhtgLgQrbqET0KX8_3h4pt4A7LMwZetd4AQlWTCm_84Tg3ooE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fHzkKphf6kUJHzPHImmu2tEZfdF4QzOouIn1s16tnyQ&oe=6A1ADC30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
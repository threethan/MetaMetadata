EJVmUjD-NSUGT0WQ&oe=69E8B151"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NofuFG1QRAUQ7kNvwEiEL9F&_nc_oc=Adqm_T0mkVESnPMrHzRcQcvBBG41KlUrpfILd5_cXVaUKYb3P_X-tEAjNAuw3rZj170&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A1n1u-TSnpZNu9oBYnk1RRBArWh5vHQZmz7XyzD_G0Q&oe=69E8CD45"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf9tltQir3wQ7kNvwFFqBE_&_nc_oc=AdrOU1SDTTO_2ASxnDVtaG1L1esg0J-EoOI7wFaY5PVwvpecEWfSkZIFSdn1fTlxIDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FXKacAbJdAvTImROpF6HC9_pJcyelxVxbJX5TZ4kn7A&oe=69E8B660"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fes4vmR4gb8Q7kNvwEWt5uM&_nc_oc=AdqS-yxPvfPdRPQkQnpbDvcieda0hHjHUosTWkDqvL09wk1HDAt7Uw_eWbaJjkfAza0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16K1zCnJx0zn-LLmCnmN9piaLJU3ZTke_wndX2rgSQ-A&oe=69E8D030"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoUV276lnKYQ7kNvwGFApT3&_nc_oc=Adqro0drRvUaCR9pokZvXc4JrhqEQdgmCDoJy_dg76FU2-aXqE1lhmIJGAic2DshAyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UilNDYcNyUxx9PE0rrKkZUVK_ul_YEyA5swRs6snZhg&oe=69E8C330"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
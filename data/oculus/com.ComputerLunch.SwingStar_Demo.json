DWseP_8s7eJbvSyw&oe=6A1EF711"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWGek74wIzsQ7kNvwH9EpZF&_nc_oc=AdrDCgD4-aNAlICt1pdx1Oyzs_WWmerhEEPfrzbVcU3CwaZ89PpagePV2km1eGeGar8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uRjySehYez6qd0YBenH01Lt32fGSOIKV3a5xRZ3q10w&oe=6A1EDAC5"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CARb3RLGWIQ7kNvwHc8e81&_nc_oc=AdpkgPo6CF2NR30WZY92jhiWFEt2-4qCiiINaQ1FwF9nGb_56Rs13G-ypxw_IorxUss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65y7HRFOLC4JzpwLw0--2AXQZosTgSzJ2zPrUhp1k2RQ&oe=6A1EFC20"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDQY6EvMBGIQ7kNvwFe2Bgh&_nc_oc=AdpAJc0C2X0-eZI35LT3w7udRgnnMQOZ1CnVHjcmSHea1RhU_fiY52-a7xOB8zBqoiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RZdp7mSBKw2DXyplL45ZPr19MFi7cgGkdFhKRqIkEvQ&oe=6A1EDDB0"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzZhN3I13NYQ7kNvwG9CQqd&_nc_oc=AdqeTyYhuGN6mEPHtFeA2Fz08FilibKDwhjKE-DBUgBCzLFItXCMaP2Ko30a6Xaebfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xe2nia8brkZceniyrt-E6wjy8VgahINzm1Zk5RDhzIw&oe=6A1ED0B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
K6MkIxEayMDhYgFA&oe=6A3E9B11"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPmjDbZjaXYQ7kNvwFCJ1yU&_nc_oc=AdpcPc5COs7fZpa8JFe_kCKzahYZ9sB1FIlhBGHkZDcgxRXYwYu1ca8MMWIJeVAL_JI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z287O9XNOWDw-TYCtAjuxUcgoXWUw7prexv3YHD1JPQ&oe=6A3E7EC5"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk3zDId3FAYQ7kNvwEVLaHa&_nc_oc=AdrqAnxYycFBRmO0eaqYO5pMk46VxlUv_PGKh0Ru3VAaUXtF8pdjGt77CcY5Fqomb18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-958swpVYmTjGD_VypfY-N9xUFgnbT7AMoXiW_uwFt1Q&oe=6A3EA020"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFKH10r4S9sQ7kNvwFhUrR7&_nc_oc=AdoJk-BthNIlbM05Rgb1K_9s35KJibr6RZip7Y_2dCQwwrxl71344cVQm2LNdx-Pjxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SPhnp5t_XOMLeCA2K0P-3-LORK3lz56cYKhXwJOTiZw&oe=6A3E81B0"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVmbQqxIp9sQ7kNvwGBsgdT&_nc_oc=Adq2FZEP1shqB8eUvCOPGgr6450Ox1wJF-R7nrWfrXbVP9kkk-A_6SJxT9tbmZK_UDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tz6XiSDUnmnaCym7H2-ytf-IpKwBN79NXfTpaks_yyg&oe=6A3EACF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
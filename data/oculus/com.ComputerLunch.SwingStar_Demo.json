9l_5O9N2Pnu7sZ-A&oe=6ABD2B11"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vbu0nIAEJXgQ7kNvwEjGEtv&_nc_oc=Adr6Tk0ebaq68LOwOtU9kg-iLId8DPW65kkebt9k77uCkU2Y2fzP2Iu8m23uf86zCcQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoE-Vv6vNeCd9jEPsNlo9kLoOhHoGlTYerJ7eGdbynFA&oe=6ABD0EC5"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrFuRNZx304Q7kNvwGeHn4R&_nc_oc=AdpkBQgrSWgemW0zkcPz5XenQxzQob1gX-HmBadA8n5mT2QdInttTbjRjo2X5XYzTc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-RhDG8riHZatIKI6PKsa2x-w6SMNCcZCyPdDTg8Zuhw&oe=6ABD3020"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8CbVi-T-qYQ7kNvwHaw9-v&_nc_oc=AdpotcmslbMdFVvvR9-xv43rLciMwEL6q5r-SwiBpM0eQQ5dSaMEU8ibFhYa821uJZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuPIfsZxiBndXIFMvqtSWsx5ymcolS19NlrlrrDXGMTA&oe=6ABD11B0"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2v4GIKvXb8Q7kNvwGl_Chm&_nc_oc=Adp71OrsFGxt6jA-JST-yW-CXcTAtnbGLnigXJZiMYr_d_u5DM2PjSTLBB2HM5Vsp90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIloYDKV6GCTw_qfgwHi2H_GIzZGIoNMxd98scPhGk9bA&oe=6ABD04B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
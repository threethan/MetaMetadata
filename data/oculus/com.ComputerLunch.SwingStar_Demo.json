4umqIt4mRpRxVazw&oe=6A941451"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq3PNXMID7QQ7kNvwEmmW7w&_nc_oc=AdqaccTzrdFk3pozssA5iq7nSZpeXrD09aasoq5O0Oojc3a5y7cN-W6k1fF3OceZUK0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYhzwJd7awIZJSxRjWFkUpQ5gyWsL2K_OBmeq2seffrQ&oe=6A943045"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0gVzK2HZMYQ7kNvwH8xGuZ&_nc_oc=AdrnVC0xdvSXXMpT5VQpgDCtcua-nFlh28Dc8VnWm4JOx-A5Y1LxVJay7gBXFVn37Ic&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHugxzYO9oKOmmhzPiCpMNk8RLLZVoSFQd7mA9IbVjFQ&oe=6A941960"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye3k9CDG1s4Q7kNvwEJOtiF&_nc_oc=AdqWPa0DfwhkWwLr_9a01rGcerTI6Cx0_T6aCsD7KvDvQcmy3EPyf97AIUBpNhqBYuo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIPrbfO1nBw2JYkuCaLGevAq5RwmZ-D_kbkDNlbw6ZvQ&oe=6A943330"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEAzbTzvDFEQ7kNvwF6OFzk&_nc_oc=AdqYVF5KsYJ5pFZ3_KBWXlHSNIIo9EsyHNZ3nbvXfkKzY3almb4bImhJwYcSToQzxMk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC0tKDpK65AkExxN1pM7gpA8H-h6o7dW_xF6fp2u8Mbw&oe=6A942630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
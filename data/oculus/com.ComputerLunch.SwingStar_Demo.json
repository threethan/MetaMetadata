87kxXGtw66ZUITLQ&oe=6A7EFC51"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnIzv8BNR24Q7kNvwHbB387&_nc_oc=AdpG2ahf5hdJfs_DYqg41FJEfC73x94EtaU1YgBqwjY209Iwri9vvzaIA3uPanqkYYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvt2mRWR42LdhmcQSkZHTtDRWxgV0I-eO9xJqUFwUW1g&oe=6A7F1845"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsiiiR6Y_h4Q7kNvwFPAR7w&_nc_oc=AdoOqZwJOVJ5j86zLSMrCMvnebcLegHRfNIh8bCEL28BxV7v76rxbQTKVVw8bFZR2iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG96H54HNi1FKZRMQfrhrmCSr0fHOXgqkpdetsFw4turA&oe=6A7F0160"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJKemp1_Fj0Q7kNvwGR7sAo&_nc_oc=AdoMxOGyorBFd_ft8ZBFlPBDxbjntqVhzwvtvRHDfo1_dwU5Sn6kRkWbtzLu6jNMQdE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOGl9Ghdi61dzYsYIk0treJVL8KmpCil-9L87sow7enQ&oe=6A7F1B30"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuUNoxfemcMQ7kNvwEa562H&_nc_oc=AdoquSHf_9NmCZr8xTl0AnFIpBFO2EmaUb8Hd6Mq4oaXyu_pDKJSBS7MosfL_w9-PjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHvIzk_AtY5IRTCz1oZs2v6KA-Vxx68Du-TRPNieQJdg&oe=6A7F0E30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
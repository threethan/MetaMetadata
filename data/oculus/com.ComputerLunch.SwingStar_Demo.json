uH0o7aSyflQ-aq88pQ&oe=6A36B211"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLHMMDiJYlMQ7kNvwGuWqIg&_nc_oc=Adr8LZjXb67QJT_y35BoHLLqM7Knkvt5z1MIwyc3Nma0DOzIWwycCmnt-Fc7GlcpkDs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xz1ymY4va1WjmEtHlMjserPThmnX0hiiCvlCnFNXa-w&oe=6A3695C5"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqqaEXiYeFkQ7kNvwHTpWsd&_nc_oc=Ado5g9IFmnCRx1g6eMRaMgG90MNOUQH8NbIczjlYFocASawjOZbyqtVYE4Gzb3NKmNU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eS3eOI1Jq2nUyCCXhPKzTLQ2VfW3QaXNCXlIkkE555A&oe=6A36B720"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8MLPTRgXz4Q7kNvwELwXf_&_nc_oc=AdqcZnZIxfzMe1UmC7nVWrD9VitpfxGM3mffdY5IFCBTKJmMuqEfq4wAfiKKCvVx_1c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RnZC0sZAG7rHIEdJiNITCTXyFYBBqsyQ9KvBMQGHaKA&oe=6A3698B0"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-XW9asrX0EQ7kNvwH_xtlc&_nc_oc=AdqfEEjDXKpScDp6F2YfvO6Tx4oCbt3w9uahC36uAMkyZf3wfptLUmP0U20OHAakwfQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5cTAZ2CNSlXuZzCLGsAxnZDUkUGUnXsXwxyaEQ89uqQ&oe=6A36C3F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
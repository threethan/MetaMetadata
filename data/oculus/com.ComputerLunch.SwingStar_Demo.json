wY96g5Zj5RTzZTug&oe=6A298311"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlN7KHlMVjMQ7kNvwH0ZQX_&_nc_oc=AdoffDJ9uykLvcQHVgYvdOiTmH_8QcpgqAarbyO9XI6WfW1il1MYVlfvaJ2r-HP1X6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZW3nRFRJPaSQx_RSbK4iVui_4QxBAcptNreB-KypV7g&oe=6A2966C5"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFEy_il5U58Q7kNvwHTqRf0&_nc_oc=AdpJZlEZEN0Oa3cdVL34wFM6taNKrpm_1fc9MCk2CEaHBVMvR3HroxdEvMlzXIA4Gjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FUj3_2tMwMMSBAASBrZJINNzEV6cCXQsxBZ5t_XvXlw&oe=6A298820"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mQSbAXpv-QQ7kNvwGR13jR&_nc_oc=AdpcgCWko0P1RX08huKF2e2gGAD2MePKi7Uj1RFjgBZTgnO3LtxKogNScinYKBPFXEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KlFEZQfGc_Wa386T_aBtKB8XumiT4Rj0zmKKGDDJ9bw&oe=6A2969B0"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajtM7Pvbd6cQ7kNvwH6fHIt&_nc_oc=AdqnlD0GJSXsR4vIUIXjJI5glqIBY7MUdbruX_MafNBBKUyPi-5Y0NOkSo0uKxPRhJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aGQg3LUPzz5rRIt8Qsuy_o-BxBRBK0AOJ-0JBY7nDZw&oe=6A295CB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
YG4kWsY_aUYIVkqg&oe=6A2EC911"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGKqncZMf_EQ7kNvwHn3nkf&_nc_oc=AdrN1g9T32JV9JImbsB5y2WihxyFRBLkFsqWcglnI_dPGgPbEtv0wo1slmKDyve-Qns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w3zkNgZGlIIy8cWDDk6ZyDRRCVofCUnPWreCosPKdhQ&oe=6A2EACC5"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C93sO403VKIQ7kNvwGoTWa4&_nc_oc=AdoUCAb0M8i9bpHSY3eJsgBym2MOPoU4YI-S6vnNCU2_pMmloHS6NZMym98uCkZqVFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T8frBeaWHiAS-GbXywV-icxb1md3xb1YAK6ow5zb6gg&oe=6A2ECE20"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oywKIjqub0Q7kNvwFUVyWR&_nc_oc=AdqRRUm7_MAe4zShdl8K0FBcdOpdoLUk_j58kpDwJQGZZB17kX8WmM-Gs7zTa7rQ4PU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96_d-aigscjT5aWNmwadCo85RU5ufRGxpp72dsd8PzAg&oe=6A2EAFB0"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lN9auzv43QwQ7kNvwHIvDDb&_nc_oc=AdpiG-DriZzBo2eniYTC0Ue65qD5BrANjU5tB7JreRJQ8Y10T9TyEKFrkiBAvq2e3VE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mjRpmugLgrtVkNqqoXRMGsApJpPklQJqOedTPdd0xkQ&oe=6A2EA2B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
WWN02RTwvXbf_kBw&oe=6AEB4F91"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXws_BpNADEQ7kNvwGfp2p2&_nc_oc=AdqJXpSucxznSZutYn1z19VmgFoDJL05eXW7PbiALUs9q2ZcAK8ocANaxZfEouYpg6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1W05jbW94JJfyv8nEIwMktofkHUCTh5OqQ5WfHSM47g&oe=6AEB3345"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpbH_rc0cGAQ7kNvwGeJfNd&_nc_oc=AdowV89kRjEyC_d2R5cHydcwXqeAII1-yMf_VHqb4lFVfPP6roJtMb43AY_wtHFKeQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCbEl97pHMQBxJf917JT34vXLgCQiXjpDfsjWZtE7nLA&oe=6AEB54A0"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEoMWxbKtE0Q7kNvwEjkPOy&_nc_oc=AdplqwXyja9mnv4xG3gtq6YVEO6k3_-Fxi-zhXxOMbsElPrekaZNM1SpH84_7bkSWSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZoXIK5TYygzPEgFVFO2XSUP9ZvsYZpRkVoimgYizSYA&oe=6AEB3630"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PIWAtf_fXkQ7kNvwEA3nSo&_nc_oc=Adqd8kcBK-IWkFOSS0ALENKgFvPEF6fgIR7rjHyua88Dku2pKbp-5BWLOrJVO9KcJ_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCKV5D6lmBWmW2_Vyx04rj-DhwLXG202n2-0BBzcTZ0w&oe=6AEB6170"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
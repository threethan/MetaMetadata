d9745RLNKrxy1K6A&oe=6AF72D11"}, {"file_name": "migrated_image.png", "id": "1572164812936987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680493_802435643228466_3724066542070005760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-bKvj4cg-oQ7kNvwGx1_9F&_nc_oc=AdpBLYsyNa_Uv2QZghn4QzZcL-vmLBpF0KJQWNsU4bAI552dIWREq-T1le7w9dQlqsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0qHd2x760FxZCUt_AU-0SF1AiSwdDQw1Dqq6hrtkEyw&oe=6AF74905"}, {"file_name": "migrated_image.png", "id": "563600041177317", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139310_254671861660895_3344397016561090560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_qEL8U7TWkQ7kNvwEucWwb&_nc_oc=AdraNYO89W2pkAhU4_qji4syypLQg_CmFEBl9vJ1g4Cqszo33cWXtuAZnZGMJPvlUv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwimHpY6b2-cz9HigrhBuOyuZoEUQIOdSWqaMPNNFK3w&oe=6AF73220"}, {"file_name": "migrated_image.png", "id": "503266340619189", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727894_1244349155685243_631799352918016000_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4itrdH2v-sQ7kNvwEEv7Ow&_nc_oc=Adr0xKKayxXvKjRIOc75IZjEsXMvCB2ZO0GpkVBgc2TBk6fdWfmVp6AnVbXfYIHGEZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkgDKGfFkMz6yKsyC2x7VCJ0PXh148Znq33NBhiP4LZw&oe=6AF74BF0"}, {"file_name": "migrated_image.png", "id": "227997191679005", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533900_175818146265566_5173549375187582976_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJhbymHhJN0Q7kNvwGpYl-7&_nc_oc=Adqd9-jA9RiwoNaZSIhSvSY_EdZDTc2-8MvG9RCvCSyWV1C6NXixvUCuEnQZC-Fdxco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmyTBxJbDBmzl88W_xMg-lodct1AkqE3at2zuf2LcTyw&oe=6AF73EF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SwingStar Demo", "keywords": ["platformer", "puzzle", "rope", "swinging", "spiderman"], "long_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- Explore all 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle.\n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items change the gameplay. Turbo Yo-yos swing you around, Air Cannons blast you high in the air, and The Grappling Jelly will suck you to it's gooey surface.\n- Brilliantly dreamy soundtrack.\n- Master each level to receive a perfect 3 Star rank.\n- Get all 84 stars to unlock the mysterious inter-dimensional zone.", "short_description": "SwingStar is a wacky third-person physics puzzler set in a colorful universe. Your goal is to find and swing on a mysterious bell using a giant sticky hand attached to your head.\n\n- Touch Controller supported.\n- In this demo Explore 30 colorful cartoon levels by swinging through enchanted deserts, bright forests, steep canyons, and many more bizarre and beautiful worlds.\n- Epic Boss Battle! \n- Unlock mysterious doors that unlock secret levels\n- Wacky power up items."}]}, "developer_name": null, "developer_privacy_policy_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "developer_terms_of_service_url": "http://games.computerlunch.com/privacy-policy-terms-of-service/", "publisher_name": "Computer Lunch", "support_website_url": null, "website_url": "http://games.computerlunch.com/swing-star/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "PUZZLE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
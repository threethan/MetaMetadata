64.5771-25/11162708_1622501044486710_2097099030168338432_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsJGLIix2kQQ7kNvwFdmb5v&_nc_oc=AdrU26pVCXvXZgssIQGHvsaw-soUGaclFUwonwW88UpmuIok4GrcHDA87SJnWiN6YNw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FsU72uvAValPuf44E7GB-PdmVoSJmninjfEEgrcnjvg&oe=6A22DEBF"}, {"file_name": "migrated_image.png", "id": "208786050474290", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162695_348962198887231_5805529748092223488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoFBbKodCmcQ7kNvwEnUMRm&_nc_oc=Adq7wKBLBq7I6j-wuTnumjNJZYo5CGXyHMY-uXSHvQWolFhAfxdzG1hTUkSlPrro5yw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PNYnSHpFJumLDc_xvpF2lOTBB9k9MeoKhmjRSmqx4Ew&oe=6A22E9BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_CoverArt.png", "id": "316249312116704", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162727_316249315450037_5560223129067847680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ipq44vGiAs8Q7kNvwGQUSfE&_nc_oc=AdpHAoX05VEB2yaP82sGgJnC0ik30EKXh9dY-YRYBldBGK9XhTMzvBicdcZp41Y9x_8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EbS96QoWkOzmKfJ2hq0XuSZlftiZ2iLH2_F6bx9m_8Q&oe=6A23028C"}, "display_name": "DEAD TARGET VR: Zombie Intensified", "keywords": ["DEAD", "TARGET", "VR", "ZOMBIE", "FREE"], "long_description": "Keep your defense up and kill zombies in one of the best first-person shooters, DEAD TARGET VR. Can you figure out the key to survival?\n\nOne year after the operation Apocalypse of betrayer CS Corporation who had got the whole city infected with zombies in 2040, they now are facing their own doom. Their technology had made too powerful zombies to keep under control. An outbreak from their Bio Lab once again turned the whole island into a big nest of the living dead. CS Corporation flee away leaving their base as the only haven among hell.\n\nYou and agent M again will be the heroes who are going to save the day in Dead Target: Zombie Intensified. Your new mission is to purge this city and bring back peace for the surviving inhabitants. But beware! Zombies are now faster, much bigger and much more intensive! Think twice before you go in. Consider 10 times dangerous than last year.", "short_description": "Survive the Zombie Intensified, Face to Dead and Fear"}]}, "developer_name": null, "developer_privacy_policy_url": "http://deadtarget.com/", "developer_terms_of_service_url": "http://deadtarget.com/", "publisher_name": "VNG CORP", "support_website_url": null, "website_url": "http://deadtarget.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "FIGHTING", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1249732012191924"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1540784886003589"}]}, "baseline_offer": {"id": "1540784886003589"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513188000, "status": "PUBLISHED", "id": "1540784886003589"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1756962604345689", "version": "0.1.8"}, "id": "121307991841607", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1676554809053136", "is_concept": false, "latest_released_binary
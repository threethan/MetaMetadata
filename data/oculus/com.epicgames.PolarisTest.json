m&_nc_ss=7f20f&oh=00_AQNlJsXkbZzq7s8VUif-k6fTLbyrbrRK_nTpZHOYWYsZFg&oe=6ACA6E88"}, {"file_name": "260805 BH CovArt Spatialised Icon FG 180px.png", "id": "1027722313393742", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313107_1027722316727075_1673809948017004191_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kur46ngb4W0Q7kNvwH8EiAw&_nc_oc=AdrUAHPGJfYXS809umd3kq6FvMSlgJwOA9dZ0ylMjV57T_R4dhdiIHZn4ePerya8PD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTeZQA8qvZcD37TrOTs7v6_2fO2-sN6hAEqmlGKprl3Q&oe=6ACA587B"}]}, "id": "1099456403078199", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2026-07-22-16h43m06s884.png", "id": "2575644002855432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654862493_2575644006188765_7194629467559758037_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9ccSG7aQZ0Q7kNvwGMQDqO&_nc_oc=AdqKLTG5YX5rkWCVRxgdRdoYnjsZ7gTzB5YAvx94rDvUrm2p38u1pmRQVYwhpzelzhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmGoGPKHAzLI7DCkKwGEDjXkdeW8L5H6vut5lqfaUaTg&oe=6ACA767C"}, {"file_name": "shot3-vlcsnap-2026-07-23-11h49m55s726.png", "id": "1613232113467891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313107_1613232116801224_270425753117144690_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kafvb54cpkQ7kNvwHpgpOf&_nc_oc=AdrJuKQZTABxgxZAfr2j9siI-QfflxP43QMrkjyZcZsFW29-taYW0mECk62xR1FKdeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVIbsGdI8aDZbDyF3hXK3F7k_mKkh6ZgLE-qifYOfNRQ&oe=6ACA51A4"}, {"file_name": "vlcsnap-2026-07-23-11h45m25s794.png", "id": "4632117423780006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308699_4632117430446672_2941180387042257906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p89BGtUPJEoQ7kNvwGqLxod&_nc_oc=Adq70UKA_VbLoAimPxzyR2bbtziO5Td7iX1PQKozOy4UL9UPrxfajWH0xBo5klHAOAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7IoS_A42nQJcdsy3Vt5zg-p_C8ZbduxRQs0mOVlKJGQ&oe=6ACA5731"}, {"file_name": "shot2-com.oculus.xrstreamingclient-20260727-121025-0.00_33_01_43.Still008.png", "id": "3456506207843730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593776279_3456506214510396_2366173086816498787_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNLTgvXCeH8Q7kNvwH87-Aa&_nc_oc=AdpsKF5LPCoYPV2aqvRhZbB2T5dDzR66a_5wZ7dXy5q89jSCN9rMnwnCrfAsFR9o1ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1IOAgq487Ei-zqhmO1YqhNspf5kyTxwaFZoRLF-_ljg&oe=6ACA512E"}, {"file_name": "shot4-com.oculus.xrstreamingclient-20260727-121025-0.00_26_41_12.Still006.png", "id": "1773770770321065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1773770773654398_6115610467039496810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLd8aVyF7hYQ7kNvwG9yUpx&_nc_oc=Ado9aVGJ0G0wlENkSOSiH15pUPuL7Cnri7v6Q4HB89YYLQhDaNn_1oUFWT_NU_-clxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC6wCn5u1N_0Xs-npxV2xYgN8D2T6MvrPKHrBhUTU5kA&oe=6ACA49DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Tests_Annie.png", "id": "1032377106334329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_1032377109667662_3124302385831877847_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWhiX8vK07oQ7kNvwFhg4Ve&_nc_oc=AdqXl9d_Ap_hEMqlHKRs6uC-p93O6Stq72n1rFGyUtwdB2iazBldw8dMcX0r-h9II1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwk3qRPaQr2G0QVdHn6jHcSKyAvS4fJRPi6q2iB1JFMA&oe=6ACA7647"}, "display_name": "BrushHammer Miniature Painter", "keywords": ["Miniature", "Painting", "Creativity", "Simulation"], "long_description": "BrushHammer Miniature Painter is an innovative mixed-reality experience that lets you live your miniature painting hobby, without the mess!\n\nNo more worrying about priming, dried paint pots, or cleanup: just grab a brush and enjoy the hobby. \n\n\n# Pro Painting Tools\n{3349779988536305}\n\nIt\u2019s the perfect game to experiment with your painting ideas. Try new color schemes, techniques, and effects without fear. Every mistake can be undone, and no miniature gets hurt in the process.\n\n\n\n# Brushes, Spray Cans, Airbrush and more!\n\n{1608535780782297}\n\nPaint virtual miniatures using a robust suite of digital tools. From spray cans and airbrushes to shade washes, edge highlights, dry brushing, decals, high-gloss finishes, and more.\n\n\n\n# So many minis to choose from, and so many more to come!\n\n{1066896759400869}\n\n\nAccess original miniature collections crafted by our artists here at Soliton. Each collection includes several models with interchangeable poses, all equipped with various accessories and many basing options. \n\n\n\nYou\u2019ll be able to save years' worth of planning by trying out your paint jobs in-game, before taking your skills back to the real world.", "short_description": "Pick a mini, grab a brush, and let your imagination run wild! BrushHammer Miniature Painter is a mixed-reality game where you can paint, customize, and bring awesome miniatures to life. Try crazy colors, blast on paint with an airbrush, add cool effects, and make every mini your own. Mess up? No big deal, just hit undo and try again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://solitoninteractive.com/privacy-policy/", "developer_terms_of_service_url": "https://brushhammergame.com/terms-of-service/", "publisher_name": "Soliton Interactive Inc", "support_website_url": null, "website_url": "https://brushhammergame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
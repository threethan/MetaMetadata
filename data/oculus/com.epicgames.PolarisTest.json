c_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkrP3rc_ZKu7KAUoWvEPbHJTxWGPxc_PiiHsAGtmZIMQ&oe=6AEF43B3"}, {"file_name": "BH_Keyart_Halloween_export_512x512_icon.png", "id": "1134829842628779", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628882_1134829845962112_78319195860456042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MbE5LwpvRsQ7kNvwEgJ3W1&_nc_oc=Ado8kTe89p77mO79iB-5LNvXbyZe1UaWHpmiXV1_9LMaojsnDI_UwPfDIgijVockIA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb2Fv7zJo9mBfGZggKWHo-3iC1XiRvJxb1lnlJpakRxg&oe=6AEF4930"}]}, "id": "3201665770224823", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BrushHammer: Peintre de Figurines", "keywords": ["peinture", "figurine", "cr\u00e9ativit\u00e9"], "long_description": "BrushHammer : Peintre de figurines est une exp\u00e9rience innovante en r\u00e9alit\u00e9 mixte qui vous permet de vivre pleinement votre passion pour la peinture de figurines, sans le d\u00e9sordre !\n\nFini les sous-couches, les pots de peinture qui s\u00e8chent ou le nettoyage interminable : prenez simplement un pinceau et profitez de votre hobby.\n\nC'est le jeu id\u00e9al pour tester toutes vos id\u00e9es de peinture. Essayez de nouvelles palettes de couleurs, techniques et effets sans crainte. Chaque erreur peut \u00eatre corrig\u00e9e, et aucune figurine ne souffrira.\n\nPeignez des figurines virtuelles \u00e0 l'aide d'une gamme compl\u00e8te d'outils num\u00e9riques. Peinture en a\u00e9rosol, a\u00e9rographe, pinceau de  brossage \u00e0 sec, d\u00e9calcomanies, vernis brillant et bien plus encore.\n\nD\u00e9couvrez des collections originales de figurines cr\u00e9\u00e9es par les artistes de Soliton. Chaque collection comprend plusieurs mod\u00e8les avec des poses interchangeables, de nombreux accessoires et une grande vari\u00e9t\u00e9 de socles.\n\nUn mode Carri\u00e8re est \u00e9galement pr\u00e9vu pour offrir une exp\u00e9rience encore plus immersive, vous faisant progresser du parfait d\u00e9butant au peintre de figurines l\u00e9gendaire.\n\nVous pourrez tester vos sch\u00e9mas de couleurs et vos techniques directement dans le jeu, ce qui vous fera gagner des ann\u00e9es d'essais et d'erreurs avant de les reproduire sur vos figurines r\u00e9elles.", "short_description": "BrushHammer est un jeu de peinture de figurines en r\u00e9alit\u00e9 mixte. Personnalisez vos figurines, peignez-les \u00e0 l\u2019aide d\u2019outils professionnels, r\u00e9alisez des commandes et devenez un peintre l\u00e9gendaire."}, {"images": {"nodes": [{"file_name": "BH LOGO_Meta Quest Store_360X360px_TRANSP BCGD.png", "id": "28893061320304786", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593716858_28893061336971451_1266323685248153979_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq73pbVA0pUQ7kNvwH8N_mo&_nc_oc=AdoKYM96PJ19P2_8qLzYk2AvdrxTSzR9FwV5oSzJ_Z_v6sVQUEXkeb9_1ojQcAh1Si0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU5THsFbC_BXZxddwy51-WKPcdonuOw0Cjct5r7WGOPA&oe=6AEF6091"}, {"file_name": "BH_Keyart_Halloween_export_1008x1440_v3.png", "id": "4179846928812814", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673658581_4179846932146147_2194926127957839148_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyA3X1rd-f0Q7kNvwEFGO4_&_nc_oc=AdqfMJ2EXxy_lYqMQdAdlke-QYK5MW6D9gY8_k4PC_QI8FCS8iCY1_9SJuF5bFCyr6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr8SjUDhMZsYa3WQ8BFml5R2A-qrC9zK6RnuP3TJC89Q&oe=6AEF5C4D"}, {"file_name": "BH_Keyart_Halloween_export_2560x1440_v3.png", "id": "1984991412141166", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/750864147_1984991415474499_1193996680534152333_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oM3tybd5fiwQ7kNvwEMRTNi&_nc_oc=AdpDKHt77h
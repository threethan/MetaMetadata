aBZfHQxG0InQ&oe=6AA41BB1"}, {"file_name": "shot2-com.oculus.xrstreamingclient-20260727-121025-0.00_33_01_43.Still008.png", "id": "3456506207843730", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/593776279_3456506214510396_2366173086816498787_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CX8BBZGhM_wQ7kNvwEgsw2x&_nc_oc=AdrH2I7P4vn3kj7hIS-5PfbAfPtwOlF9nUqWT9eYbcZD-eMqfWP8Lt7ev8mHkNl5cQ4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4zy54OKULYg-Z27pNNcYuYi62Gr6gf_DN3LNus1PRhg&oe=6AA415AE"}, {"file_name": "shot4-com.oculus.xrstreamingclient-20260727-121025-0.00_26_41_12.Still006.png", "id": "1773770770321065", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314660_1773770773654398_6115610467039496810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V21RWuRYYmcQ7kNvwHwbK4H&_nc_oc=AdpknQsIIV-J0UX2lM0eq2T0Za4Jil0y7GtgsAzl2MIbe97R3Mf2nNe75r3YO6IKKLE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsPvdidpOunZqr_AvUM-4J3oBRUOtOiTfcGXRDefoXJg&oe=6AA40E5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Tests_Annie.png", "id": "1032377106334329", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824700_1032377109667662_3124302385831877847_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ho5IpJP7ol8Q7kNvwHYoEEw&_nc_oc=Adq25YIcagWz9f_4jgLakfBCwC05AOL7ahTeYhXCjt1KMcNg5d8nOYbSD4xuhGnL6SU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZm9Fix64zw5hUTbuu0op1H59UeUFrbuc_feEMt03KSQ&oe=6AA40287"}, "display_name": "BrushHammer Miniature Painter", "keywords": ["Miniature", "Painting", "Creativity", "Simulation"], "long_description": "BrushHammer Miniature Painter is an innovative mixed-reality experience that lets you live your miniature painting hobby, without the mess!\n\nNo more worrying about priming, dried paint pots, or cleanup: just grab a brush and enjoy the hobby. \n\n\n# Pro Painting Tools\n{3349779988536305}\n\nIt\u2019s the perfect game to experiment with your painting ideas. Try new color schemes, techniques, and effects without fear. Every mistake can be undone, and no miniature gets hurt in the process.\n\n\n\n# Brushes, Spray Cans, Airbrush and more!\n\n{1608535780782297}\n\nPaint virtual miniatures using a robust suite of digital tools. From spray cans and airbrushes to shade washes, edge highlights, dry brushing, decals, high-gloss finishes, and more.\n\n\n\n# So many minis to choose from, and so many more to come!\n\n{1066896759400869}\n\n\nAccess original miniature collections crafted by our artists here at Soliton. Each collection includes several models with interchangeable poses, all equipped with various accessories and many basing options. \n\n\n\nYou\u2019ll be able to save years' worth of planning by trying out your paint jobs in-game, before taking your skills back to the real world.", "short_description": "Pick a mini, grab a brush, and let your imagination run wild! BrushHammer Miniature Painter is a mixed-reality game where you can paint, customize, and bring awesome miniatures to life. Try crazy colors, blast on paint with an airbrush, add cool effects, and make every mini your own. Mess up? No big deal, just hit undo and try again!"}, {"images": {"nodes": []}, "id": "1491926402695798", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BrushHammer: Peintre de Figurines", "keywords": ["peinture", "figurine", "cr\u00e9ativit\u00e9"], "long_description": "BrushHammer : Peintre de figurines est une exp\u00e9rience innovante en r\u00e9alit\u00e9 mixte qui vous permet de vivre pleinement votre passion pour la peinture de figurines, sans le d\u00e9sordre !\n\nFini les sous-couches, les pots de peinture qui s\u00e8chent ou le nettoyage interminable : prenez simplement un pinceau et profitez de votre hobby.\n\nC'est le jeu id\u00e9al pour tester toutes vos id\u00e9es de peinture. Essayez de nouvelles palettes de couleurs, techniques et effets sans crainte. Chaque erreur peut \u00eatre corrig\u00e9e, et aucune figurine ne souffrira.\n\nPeignez des figurines virtuelles \u00e0 l'aide d'une gamme compl\u00e8te d'outils num\u00e9riques. Peinture en a\u00e9rosol, a\u00e9rographe, pinceau de  brossage \u00e0 sec, d\u00e9calcomanies, vernis brillant et bien plus encore.\n\nD\u00e9couvrez des collections originales de figurines cr\u00e9\u00e9es par les artistes de Soliton. Chaque collection comprend plusieurs mod\u00e8les avec des poses interchangeables, de nombreux accessoires et une grande vari\u00e9t\u00e9 de socles.\n\nUn mode Carri\u00e8re est \u00e9galement pr\u00e9vu pour offrir une exp\u00e9rience encore plus immersive, vous faisant progresser du parfait d\u00e9butant au peintre de figurines l\u00e9gendaire.\n\nVous pourrez tester vos sch\u00e9mas de couleurs et vos techniques directement dans le jeu, ce qui vous fera gagner des ann\u00e9es d'essais et d'erreurs avant de les reproduire sur vos figurines r\u00e9elles.", "short_description": "BrushHammer est un jeu de peinture de figurines en r\u00e9alit\u00e9 mixte. Personnalisez vos figurines, peignez-les \u00e0 l\u2019aide d\u2019outils professionnels, r\u00e9alisez des commandes et devenez un peintre l\u00e9gendaire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solitoninteractive.com/privacy-policy/", "developer_terms_of_service_url": "https://brushhammergame.com/terms-of-service/", "publisher_name": "Soliton Interactive Inc", "support_website_url": null, "website_url": "https://brushhammergame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "
n": "BrushHammer is a mixed-reality game that lets you live the miniature painting hobby without spilling paint on your desk!\nPick from a huge collection of minis, kitbash them with different parts and accessories, and paint them using awesome tools like spray cans, airbrushes, shading brushes, decals, and shiny coatings.\n\nShow off your masterpiece in your space, send pics to friends, and climb from total newbie to legendary painter in Career Mode. \nComplete commissions, impress picky judges, and spend your hard-earned points in the hobby shop on new tools, accessories, and upgrades for your creative setup.", "short_description": "BrushHammer is a mixed-reality miniature painting game. Customize minis, paint with pro tools, complete commissions, and become a legendary painter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solitoninteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Soliton Interactive Inc", "support_website_url": null, "website_url": "https://brushhammergame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35421001717543947"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1382994213366426"}, {"status": "PUBLISHED", "id": "1356802679145051"}]}, "baseline_offer": {"id": "1356802679145051"}, "is_approved": tr
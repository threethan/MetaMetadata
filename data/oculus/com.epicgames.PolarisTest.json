//scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822779_1255908666333964_3224305746300553021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1qj_tgUwOIQ7kNvwEVbVZs&_nc_oc=AdpmqM6Mnxj0acbLc7kMHNAzNyrLmrxkENjn1yFdDUVDB9vpGOXEXD8xrY0sDq5rsHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCmS1bxenHSI1KexPlz8Y340acmLjBETQVNz4TVlB7Wg&oe=6ACA6DBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Quest Store_Cover Art_Landscape (1).png", "id": "2157077044862916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308330_2157077048196249_8172828027899241575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKioNE1MCkcQ7kNvwHUXM8T&_nc_oc=AdogPRDA8tXFBMyFea610KV4VVFZdzJoEJ07S9EDWHWFtX-eBkN0OgL6lE7Ke_WViFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz5-731mTIrjAPu847G6sh1_WH6wWh5HG9qoN-NQArMQ&oe=6ACA6CAE"}, "display_name": "BrushHammer Miniature Painter", "keywords": ["Miniature", "Painting", "Creativity", "Simulation"], "long_description": "BrushHammer is a mixed-reality game that lets you live the miniature painting hobby without spilling paint on your desk!\nPick from a huge collection of minis, kitbash them with different parts and accessories, and paint them using awesome tools like spray cans, airbrushes, shading brushes, decals, and shiny coatings.\n\nShow off your masterpiece in your space, send pics to friends, and climb from total newbie to legendary painter in Career Mode. \nComplete commissions, impress picky judges, and spend your hard-earned points in the hobby shop on new tools, accessories, and upgrades for your creative setup.", "short_description": "BrushHammer is a mixed-reality miniature painting game. Customize minis, paint with pro tools, complete commissions, and become a legendary painter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solitoninteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Soliton Interactive Inc", "support_website_url": null, "website_url": "https://brushhammergame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35421001717543947"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1382994213366426"}, {"status": "PUBLISHED", "id": "1356802679145051"}]}, "baseline_offer": {"id": "1356802679145051"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1382994213366426"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38602175252759895", "version": "1.2.40"}, "id": "763273732527970", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24575744092069818", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38602175252759895"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791227423, "id": "38748600831450669", "version": "1.2.37", "version_code": 118, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "38748590968118322"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24575744092069818", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38602175252759895"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "763273732527970"}]}, "change_log": "New Content\n- Added airbrush to shop\n- Added colour changing spray can to the in-game shop\n- Added a color wheel for decals, added UI element to distinguish decal colors\n- Added Annie-May miniature with associated paint palette\n- Added Brushy miniature with associated paint palette\n- Added Trash can for cleaning up player created bottles\n- Added some repeatable challenges for the month\n- Added new backgrounds for the photobooth\n\n\nGameplay Improvements\n- Added clean palette button on the mixing palette\n- Shortened some texts that were too long for the UI\n- Re-enable accidentally deactivated \"auto-mask hiding\" control\n- Add animated rotating banner to the shop for supporting multiple features\n- Added new tag to highlight recent additions to the shop\n- Added new animations for completing challenges\n- Cleaned up the layout of the shop, fixing misalignments\n- Added limit on paint bottles spawned by colour picker rather than deleting the oldest bottles without warning\n- Added a cleaner sorting of player created bottles on the desk when there are not enough rack spots for all bottles\n- Added tool section in shop\n- Added \"coming soon\" teasers in the shop for miniatures coming in the next update\n- Added new challenge icons\n- Updated onboarding texts to be clearer\n- Moved box colour palette bottle holder to underneath the ref card at the back of the main desk\n- Added new holders in the spinner rack for the colour change spray can and the airbrush\n- Added new visual mesh and wrapper for player created paint bottles to better distinguish them\n\n\nSystem Improvements\n- Removed unnecessarily packaged files to reduce game package size\n- Optimized physics during moving of the desk\n- Optimized memory cost for boxes sitting on the shelves\n- Fixed our app display name to not show our internal project name :P\n- Optimized painting on Quest 2\n- Optimized decal applicator and decal sheet rendering\n- Updated localization to translate all of the texts into French\n- Updated visuals for onboarding to better match texts and in game representation\n\n\nFixes\n- Fix some bugs causing offsets when attaching/detaching bases\n- Fix decals being considered as brush strokes for challenges\n- Fix decal tracking in challenges\n- Fixed a bug where box palette bottles would remain stuck out of reach when loaded from a project save\n- Fixed a bug causing the paint jobs of parts that were put back in sprues to not be saved\n- Fixed a bug causing colour picked bottles stored in a rack to not count towards the max bottles\n- Fixed a bug where purchasing multiple boxes in a row could lead them to not be attached to the shelves correctly\n- Fixed a bug where placing a box into the shelf would not remove the project popup prompt\n- Fixed photobooth locking incorrectly\n- Fixed snap orientation of the model in the photobooth to be facing the camera by default\n- Fixed the auto-mask map for the Nesuv mini gun\n- Fixed a bug where the tablet would turn itself around and no longer snap to its arm\n- Fixed a bug where coatings were rendering on top while the auto-mask was active\n", "created_date": 1790695177, "id": "38602175252759895", "version": "1.2.40", "version_code": 116, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "38602168496093904"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24575744092069818", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38602175252759895"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790621878, "id": "38582318604745560", "version": "1.2.37", "version_code": 115, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "38582312484746172"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24575744092069818", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38602175252759895"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790363605, "id": "38517863264524428", "version": "1.2.38", "version_code": 113, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "38517856207858467"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24575744092069818", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38602175252759895"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790260631, "id": "38487136994263722", "version": "1.2.27", "version_code": 111, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "38487126437598111"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"
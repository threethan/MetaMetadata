"}, {"file_name": "Screenshot Meta Quest Store 1.png", "id": "1255908659667298", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822779_1255908666333964_3224305746300553021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgxRsVddaZIQ7kNvwExkH1s&_nc_oc=AdopvRbNxjkr_eu9MTcR8uG4MUYziA22VEYAT9K-KITqLm-hkpKABKcRFjJxC_T3FEg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4a5p6ik125bBE41PjFuwdEG1pnBiqeTX8dG7nMdTrNA&oe=6AA3F9FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Quest Store_Cover Art_Landscape (1).png", "id": "2157077044862916", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308330_2157077048196249_8172828027899241575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDMXx9IN81EQ7kNvwGG1TIX&_nc_oc=Adp3N-iNIOWJd288w-bCka6FmNpDX5r_LzBmQZ6el2BIU7RRqL71GmHLbI6yWuPjhcQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkyRC3ldb1TOaZlh3fA7-5BNzd9dkDq3yXH45QI6gwAw&oe=6AA3F8EE"}, "display_name": "BrushHammer Miniature Painter", "keywords": ["Miniature", "Painting", "Creativity", "Simulation"], "long_description": "BrushHammer is a mixed-reality game that lets you live the miniature painting hobby without spilling paint on your desk!\nPick from a huge collection of minis, kitbash them with different parts and accessories, and paint them using awesome tools like spray cans, airbrushes, shading brushes, decals, and shiny coatings.\n\nShow off your masterpiece in your space, send pics to friends, and climb from total newbie to legendary painter in Career Mode. \nComplete commissions, impress picky judges, and spend your hard-earned points in the hobby shop on new tools, accessories, and upgrades for your creative setup.", "short_description": "BrushHammer is a mixed-reality miniature painting game. Customize minis, paint with pro tools, complete commissions, and become a legendary painter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solitoninteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Soliton Interactive Inc", "support_website_url": null, "website_url": "https://brushhammergame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35421001717543947"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1356802679145051"}]}, "baseline_offer": {"id": "1356802679145051"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787760000, "status": "PUBLISHED", "id": "1356802679145051"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37726893026954793", "version": "1.1.0"}, "id": "763273732527970", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24575744092069818", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37726893026954793"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "763273732527970"}]}, "change_log": "Day 1 Patch Version 1.1.0\nFor our very first update, we added a million and one things to the game in order to bring you the best version of BrushHammer possible!\n\nTake a look and happy painting!\n\nWhat we added:\n\nAdded new model variations for:\nAeon Wars Collection\nNesuv Sniper\nNesuv Retributor\nNesuv Skirmisher\nNesuv Grenadier\nNesuv Trooper\nNesuv Recon\n\nGladeHaven Collection\nArmand Lafleur\n\nAdded shop system for purchasing new models\nAdded VR backdrop\nAdded more Challenges\nAdded movable decal sheet\nAdded tower auto rotate on start game\nAdded versioning to saves to support backwards compatibility in the future\nAdded new VFX to the model customization process\nAdded new base plastic colours for \u201ctiers\u201d of miniatures\nAdded credits in the wrist menu\nAdded French localization\n\nWhat needed improving:\n\nImproved performance during the tutorial\nImproved layout of paint bottles in shelves\n\nImproved pose appearances for\nEntire Aeon Wars Collection models\nCeline Delion - Beetle Mage\n\nBetter performance rendering the tablet\nBetter performance while using the spray cans\nPolished all UI on the tablet\nNew, more readable font\nImproved painting result of dry brush on all models\nReference card now spawns attached to the back wall rather than in the spinner tower\nImproved flow when sending a photo of your model\nIncreased number of shelves to account for new miniatures boxes\nNew coating remover look to better distinguish it from the others\n\nThe very important list of fixes:\n\nFixed crash when rapidly opening too many boxes\nFix some challenges not evaluating or completing correctly\nFixed masking tool hiding incorrect areas on Mr. Pompidou - Enchanted Mushroom Mount and Protector of the Sea, Konah\nFixed the tablet\u2019s clock so that is no longer detaches from the tablet\nFixed paint bottles spawning in the paint rack\n\n\nThat\u2019s a wrap! We can\u2019t wait to see what you create in BrushHammer. Keep your eyes peeled for more info and updates via our socials, or get in touch with the dev team over on our Discord server, we\u2019re listening!", "created_date": 1787689
Sbhe1ezh9LH1_mF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA95h0SlXel6OQAl-7PJ26N35Ox86knvmwF2ZuhZ7F2Q&oe=6AEF4131"}, {"file_name": "shot2-com.oculus.xrstreamingclient-20260727-121025-0.00_33_01_43.Still008.png", "id": "3456506207843730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593776279_3456506214510396_2366173086816498787_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm10D6rsNo4Q7kNvwHe00iF&_nc_oc=Adr_bSR5dvvyXEqLmj9R4i-tUw0TTwXQAkgIPjJLOkOCpNQ9zSS7pqL0qpV3aKcRbOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq25R0RuTXh7H5ECmwwumaabsgAOWWoFcELTj8bPdP7g&oe=6AEF3B2E"}, {"file_name": "shot4-com.oculus.xrstreamingclient-20260727-121025-0.00_26_41_12.Still006.png", "id": "1773770770321065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1773770773654398_6115610467039496810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYIvZ4BIaAAQ7kNvwE7DusB&_nc_oc=AdrLf9l8bAuHgY1BopZC7cvOAJt3BvIJKZfae5RXtoG2xkk4YiT2wkAmht8eDEDpnUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMi24Tey2jRNUNe4yY5VfK1qHqts6r1kFMkmnJ6VrRFw&oe=6AEF33DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BH_Keyart_Halloween_export_2560x1440_v3.png", "id": "1015781444868995", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673573223_1015781448202328_2799452715283142623_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YXE4xAStVIQ7kNvwFtjYkm&_nc_oc=Adr4itPRsqPbmTxlKhZUQb8Wb6rjtdSi1UiYwhUOsL-goc28tGa9xTk-KrWh_Y-rC34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUWMt52ACT1jDYIC_CP7YTOh4zkO1ITx9qA1FQlExRAA&oe=6AEF606F"}, "display_name": "BrushHammer Miniature Painter", "keywords": ["Miniature", "Painting", "Creativity", "Simulation"], "long_description": "BrushHammer Miniature Painter is an innovative mixed-reality experience that lets you live your miniature painting hobby, without the mess!\n\nNo more worrying about priming, dried paint pots, or cleanup: just grab a brush and enjoy the hobby. \n\n\n# Pro Painting Tools\n{3349779988536305}\n\nIt\u2019s the perfect game to experiment with your painting ideas. Try new color schemes, techniques, and effects without fear. Every mistake can be undone, and no miniature gets hurt in the process.\n\n\n\n# Brushes, Spray Cans, Airbrush and more!\n\n{1608535780782297}\n\nPaint virtual miniatures using a robust suite of digital tools. From spray cans and airbrushes to shade washes, edge highlights, dry brushing, decals, high-gloss finishes, and more.\n\n\n\n# So many minis to choose from, and so many more to come!\n\n{1066896759400869}\n\n\nAccess original miniature collections crafted by our artists here at Soliton. Each collection includes several models with interchangeable poses, all equipped with various accessories and many basing options. \n\n\n\nYou\u2019ll be able to save years' worth of planning by trying out your paint jobs in-game, before taking your skills back to the real world.", "short_description": "Pick a mini, grab a brush, and let your imagination run wild! BrushHammer Miniature Painter is a mixed-reality game where you can paint, customize, and bring awesome miniatures to life. Try crazy colors, blast on paint with an airbrush, add cool effects, and make every mini your own. Mess up? No big deal, just hit undo and try again!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://solitoninteractive.com/privacy-policy/", "developer_terms_of_service_url": "https://brushhammergame.com/terms-of-service/", "publisher_name": "Soliton Interactive Inc", "support_website_url": null, "website_url": "https://brushhammergame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_conne
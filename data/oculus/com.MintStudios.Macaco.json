76_n.png", "id": "1620095766418258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312332_1620095769751591_8073163660635217577_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX1gIh8r750Q7kNvwF8YOqG&_nc_oc=Adpm0sW-1aPLvOc2oSdPZMc0ItjkoeISpWmbgfQGYntgzxi2V9ydOYLn5U8VoDWd9VA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrV301dKTFaDUqLOPJrbFY0gBxjo_Zz0GriW_pgIFNqQ&oe=6AFC7D7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lmfao.png", "id": "1356858020836462", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499314660_1356858024169795_584351706417803991_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrGH3HSeD_QQ7kNvwHeVlh3&_nc_oc=AdomV1aAUbVQoBYnyXGI0CmKJ_2WHwKTNAwh_5W5mknfrKuydWBvIm1vb8XQXLrmLR4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiZntyP7II-1B_-UnYyA5BlQYg9uJynjJe3qXbScJt1g&oe=6AFC892F"}, "display_name": "Macaco VR", "keywords": ["Gorilla", "Tag", "Capuchin", "Monkey", "Ape"], "long_description": "Macaco is a fast-paced and energetic Gorilla Tag fan game that drops players into wild, jungle-themed environments filled with trees, ruins, and cliffs. Play as a mischievous monkey and use advanced VR locomotion to run, climb, swing, and launch yourself through vibrant, stylized worlds. Inspired by the movement style of Gorilla Tag, Macaco expands on the formula with new game modes, unique maps, and community-driven features that keep the gameplay fresh and chaotic. Whether you're tagging others in intense chase sequences or exploring hidden areas with friends, Macaco offers a highly social and competitive VR experience. With smooth multiplayer performance, responsive motion mechanics, and a growing player base, Macaco delivers the same thrill and freedom that made Gorilla Tag popular, while adding its own twist with original content and jungle-themed mayhem. Grab your headset, unleash your inner monkey, and jump into the wild world of Macaco!", "short_description": "Macaco is a fast-paced Gorilla Tag fan game set in wild jungle environments where players swing, climb, and leap as mischievous monkeys. With stylized graphics and immersive locomotion Macaco blends chaotic fun with competitive tag action for an energetic VR experience like Gorilla Tag."}]}, "developer_name": "MintManVR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1j7Ic-4zB1SMT2Y8amoJNRGRmC0lw-odvo6QjTJ2vIN8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MintManVR", "support_website_url": null, "website_url": "https://sites.google.com/view/macaco-vr?pli=1&authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1417599413836900"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1445148587748649", "version": "1.2.23"}, "id": "1735206120898704", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1415727987357376", "is_concept": false, "latest_released_binary": {"__ty
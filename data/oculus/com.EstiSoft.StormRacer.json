99593892165115", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818890_1099593895498448_4986721514602601814_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QLiD9o8hhwQ7kNvwFaU43y&_nc_oc=Adoh-nWkSCacWshPJsIXBzml3u0nyn16pdhx6Rbq7mTNZIMD9Ckp-MfuMqvQE26S4T8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRaTH9n8RNdtRDomj1vXwzeKttOcUSsSe8Rp8WPPkHMQ&oe=6AA01EC9"}, {"file_name": "ss5.png", "id": "761848000276634", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825470_761848003609967_6690769575048511888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hma0AxZSMd8Q7kNvwEn09v6&_nc_oc=AdoRTH_Eu_YT_HKRe1BF6UAPo6goJc5fWraSwSZ24_HlZZNnH5654jSjjS6np0wOpl0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8EaqDVUrahSSwtxefmhDEY95rpldR0VZHsUJIYncHYA&oe=6AA006AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "697841216597848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818890_697841219931181_5660907697256399305_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SC0zawME6-wQ7kNvwESagVt&_nc_oc=Adr0uyRDE4fKWcP7_1XJirpKMJvNG5uidtAntKUbPh9o0sCq0bcE5Z004XDyg7AD3xQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyslU0ksJyNtOjuFKW0Sy3l4bghpJFBybgqZhvD3rfRQ&oe=6A9FF974"}, "display_name": "Storm Racer", "keywords": ["HighSpeed", "DrivingSimulator", "StormRacer", "Offroad", "VRRacing"], "long_description": "Welcome to the most intense off-road VR racing experience on Meta Quest!\n\nStorm Racer puts you directly in the driver\u2019s seat of custom-built racing machines. Whether you\u2019re steering a rugged monster truck or a nimble racing buggy, every turn and jump feels real in fully immersive virtual reality.\n\nDYNAMIC ENVIRONMENTS Race through beautifully crafted levels filled with life. From scenic coastal tracks decorated with hot air balloons to intense industrial zones and snowy paths, the variety keeps the challenge fresh. Watch out for the terrain\u2014mud and dirt will test your handling skills to the limit!\n\nKEY FEATURES:\n\nImmersive Cockpit View: Feel the scale and speed with a detailed interior UI, including functional speedometers and race stats.\n\nNitro Boost: Time your Nitro perfectly to overtake opponents and clinch the victory.\n\nDiverse Vehicle Roster: Choose from a variety of vehicles, each with unique handling\u2014from classic beetles modified for dirt to heavy-duty 4x4 trucks.\n\nProgression System: Earn scores from your races to unlock more challenging levels. Level 1 is just the beginning; do you have what it takes to unlock the elite tracks?\n\nCompetitive AI: Face off against skilled AI drivers who won't give up their position easily.\n\nStorm Racer is optimized for Meta Quest to provide smooth performance and high-octane fun. Put on your headset, grab the wheel, and leave your rivals in the dust!", "short_description": "Experience the ultimate high-speed thrill with Storm Racer!\n\nJump into the cockpit of powerful off-road beasts and dominate challenging tracks. Feel the adrenaline as you blast past rivals using Nitro, navigate through vibrant environments with hot air balloons and Ferris wheels, and conquer muddy trails. Unlock new levels, upgrade your ride, and prove you are the fastest driver in VR. Are you ready to brave the storm? Start your engines now!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "int
CbQoOS6MWkr04fA&oe=6A844D1F"}, {"file_name": "CA2_Logo.png", "id": "1546237959912772", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_1546237963246105_2727670175585090240_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XNBnvp0NI8Q7kNvwHsbSLC&_nc_oc=AdpUQc0vv5uCX993nhIv_p1-Ee6sRhmG9ao1639cpHaDahX7GOvWAe0karKYQxa5ii8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDxqOg190nTWhKnSG082vU6oVJn8FoWD9rX0VGtngWhg&oe=6A84580D"}, {"file_name": "CA2_Landscape.png", "id": "1270906694803357", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1270906701470023_5558433087564207192_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ftp2O9g8KgQ7kNvwEDjO3B&_nc_oc=Adpq8VgRPUs9S6NnGMpa5VM5DygPgEYUJNTZ7-nAZqxQZqqUCW40XPhtPPiDxay9XRQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmmWyROVUgcV6Gu_3avUoD1Ke74ME93570I5541S8WTw&oe=6A843CEB"}, {"file_name": "CA2_Square.png", "id": "818367877738971", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823270_818367881072304_7758550963131995854_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smDeBAqyfIIQ7kNvwE1HdCB&_nc_oc=AdqFgVQzlK260x7-m8i9aexcaoBA_bh1F0DLWJvfRILiWAYpG_ly4k0cbY5CCxhQtX0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUvNH1PsweVmoTJof4ZQfKAoDr8NlBRKFuzkRXAWQHjw&oe=6A8441DD"}, {"file_name": "CA2_Hero.png", "id": "805198759061061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823296_805198762394394_4574216687384105502_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUozOG6Hd_8Q7kNvwGaMHDV&_nc_oc=AdrYTZEnbSwbZ_Az-nMoBl767cVFkjs005h6xb-m1CAiuObVuwkkDGAiSPkXdDETONU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErCaeaV-ThP0RlwShDIMH64WeOwcd3m9uxOC8JiQLSrg&oe=6A8452C1"}]}, "id": "25048245558175623", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA2_Landscape.png", "id": "1352371616291074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_1352371622957740_6037498879757977572_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1w-LEzq4VQQ7kNvwEeyIiC&_nc_oc=AdoYiuzLMBYqnCc0SxxKUTJZWvqh_5xKdlpSWfSZN-sCcyz1OfQYcNGLcPCcmK8yCWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIk5cFR9-ectIzSgB4GgzREhZNPh8l12Ul4OVmnc5ybQ&oe=6A84350B"}, "display_name": "Cit\u00e9 Alexandrie", "keywords": ["narrativevr", "managementgame", "dystopian", "seatedvr", "storydriven"], "long_description": "Dans Cit\u00e9 Alexandrie, un jeu de gestion narrative en r\u00e9alit\u00e9 virtuelle, vous dirigez un r\u00e9seau culturel clandestin dans une France alternative des ann\u00e9es 1980. Livres, disques et bandes dessin\u00e9es sont strictement interdits. Depuis votre tour HLM, vous menez la r\u00e9sistance \u2013 en silence, avec astuce et audace.\n\nAu c\u0153ur de votre entreprise se trouve un diorama. Faites-le tourner, explorez-le. Il vous servira \u00e0 g\u00e9rer votre \u00e9quipe, \u00e0 stocker les objets culturels et \u00e0 faire des choix d\u00e9terminants. Faut-il \u00e9tendre votre influence ou rester discret ? Faire confiance ou trahir ? \u00c9changer vos biens pr\u00e9cieux ou les r\u00e9duire en cendres ?\n\nCon\u00e7u pour \u00eatre jou\u00e9 en position assise, Cit\u00e9 Alexandrie ne provoque pas de cin\u00e9tose. Le gameplay m\u00eale une narration profonde \u00e0 des syst\u00e8mes de gestion et des choix moraux. Vous devrez jongler avec la logistique, les risques et la pression, tandis que la ville r\u00e9agira \u00e0 chacune de vos d\u00e9cisions.\n\nChaque jour apporte son lot de nouveaux d\u00e9fis. Chaque choix que vous faites laisse une empreinte ind\u00e9l\u00e9bile.\n\nD\u00e9velopp\u00e9 par Sir\u00e8ne Rouge Games, une \u00e9quipe ind\u00e9pendante forte de plus de 15 ans d'exp\u00e9rience en conception de jeux et en narration, Cit\u00e9 Alexandrie est un r\u00e9cit sur la r\u00e9sistance et le pouvoir de la culture.", "short_description": "Dans une France dystopique des ann\u00e9es 80, prenez les r\u00eanes d'un r\u00e9seau clandestin depuis votre immeuble. Depuis votre diorama, vous recrutez des alli\u00e9s, \u00e9changez des livres interdits et \u00e9vitez la police culturelle.\n\nCit\u00e9 Alexandrie combine la gestion strat\u00e9gique, une narration riche et des choix moraux. \n\nLe jeu est est id\u00e9al en position assise, sans risque de cin\u00e9tose.\n\nPr\u00eat \u00e0 arborer les couleurs de la r\u00e9sistance culturelle ?"}, {"images": {"nodes": [{"file_name": "CA2_Square.png", "id": "1784296128949614", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_1784296132282947_1431003100647231907_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjfPftYmisAQ7kNvwFKQ0md&_nc_oc=AdphttJ-9a9qOvQ7u3-HjLQKXMiLbiwTkJPHXvWmp_nPvPHCHNuk2eS9Rsr5dBEMZ-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgsqITUEV2_dlgc_N1e5wWlfia1GbrZvt9Qc20Rcsu-g&oe=6A844654"}, {"file_name": "CA2_Hero.png", "id": "1654446848866436", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1654446852199769_7706209786122510093_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4vVON6XTQYQ7kNvwEmLJzs&_nc_oc=AdpZANLEGpzjICabfTBJhPuevXK40fKUgG7IuTOPxC3I-qWXPcLSNuTmxoj5O1k-QZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFNZyH9f1j5uovuHJhbBfGaFnyYExeP9dD2fTQmZbevA&oe=6A844E5A"}, {"file_name": "CA2_Landscape.png", "id": "1368630631546004", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818849_1368630638212670_4326423980367575532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juvFes1pHD4Q7kNvwHT3gY8&_nc_oc=AdqJgwyzbwrP6qNX13vOKuPgaMxEgAXf-TJS4Y3zDD0VYZ85kpN_4q3Ml_18wsmExYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe6z04NA45FJfyR3K0yEks4siELx4rNIfTD-gW5wNwqA&oe=6A845D1E"}, {"file_name": "CA2_Logo.png", "id": "1161561802195402", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825497_1161561805528735_6810798269489456028_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYxL6VJLK0sQ7kNvwFZoE8a&_nc_oc=AdoWn5pCQu3UTTaf3UTRWql7jv7vLQktp8yoUrli1G37nt8vJbn1beGi_0QxX_KyBLg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ6tp220iMCfU6RiNm6VZIw-4eyLp1wkfI3qBJvnp6eQ&oe=6A844FD5"}, {"file_name": "CA2_Portrait.png", "id": "891661103197477", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_891661106530810_8034565604992534925_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAKYu6CJ764Q7kNvwFmrfEX&_nc_oc=AdohbTVkThzsJMMt-1nXalWBenYc2zfF6E4QovT9x0kF-pmUAElTPK5txhGpjKyb45A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH89ugGmw4lY9Lu1pSI6BLg6DIRc5Iyq2QqXWpgRBUknw&oe=6A84629D"}]}, "id": "1194831459274446", "locale": "en_US", "screenshots": [{"file_name": "Hypatie 2_Cite\u0301 Alexandrie.png", "id": "1322273802836987", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823783_1322273806170320_1266874585924579291_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZdmAtF5NrEQ7kNvwFV0tFW&_nc_oc=Adoc7vT70VDSgqweSUlXB4t0826LOciQDEx9WsRvQ7dc6yJ1sL08BMQXaO9lOOsjDfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnr5GgKdUhEJh-7HE5Rz0ylY0uOqPPIsEttvqm0ItXIQ&oe=6A8442CD"}, {"file_name": "Deal.png", "id": "743230881586265", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825470_743230884919598_8724618836432877674_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCAdRESnj6IQ7kNvwHcJxzp&_nc_oc=Ado_RLtF7eKkcGiQB8qNMf87hsj7gXleyCvA0_sS7quYh1rlvdiA7bDblBMZRdWDKsI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGSb_liYGLVk7ih_fdKi1MYfSwvduANmgVcJQHbGEbmA&oe=6A844AE1"}, {"file_name": "Arrestation.png", "id": "727508526574042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820887_727508529907375_1389215335084091009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__D8RrNBAEIQ7kNvwG_gkOs&_nc_oc=AdrePap6pe7DwzvxIrq7AYN5y6QbuhiG-dIu402aDYT05lUexdgWYf22ZboVy24ShaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsCiasNLzaetUR-cQAu83Xpu4Mn2v4erVTdvnfStwCog&oe=6A8468AA"}, {"file_name": "Dialogue.png", "id": "759767156723255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821568_759767160056588_9089345341633961557_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JXFdo2gR1kQ7kNvwGI8ZDo&_nc_oc=AdpGbHYOVjYI-gVyloxZGuEGO5aLp7LyDpXWUvKKZvaoZvBVA-KTzMmadvR_jm92KiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoh4wg0jfIOz4Elgr51CtomBY-0orO_g1AkqUUC_2JKg&oe=6A844987"}, {"file_name": "Meta Balzac.png", "id": "1505181200887829", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298193_1505181204221162_4135722470371109592_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-el2ccwSUgQ7kNvwGxc1uE&_nc_oc=AdrFX0jZQ31G8qmy02jbceVc8vs4XKl6fRwuLqMDn4A30Vw7oeAU6oYVJNwRRIAtfqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRspH1KeW1AWAR3Ss4bJAkxdvtT6JAlHIGPgUEV9HAPw&oe=6A844652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA2_Landscape.png", "id": "1622698755804352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824318_1622698765804351_6037158996232267318_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWEG6gszYCoQ7kNvwE29ZWR&_nc_oc=Ado1vuumFieLetjnnHT0bKAA9-WhZHyiIvQ0tXNhxfO-peHibf9G5guDqU4T2YfaPlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh6xBekx5quyxG-ntIkIjbns9jdERbIT40Uzimr71laA&oe=6A843416"}, "display_name": "Cit\u00e9 Alexandrie", "keywords": ["narrativeVR", "managementgame", "dystopian", "seatedVR", "storydriven"], "long_description": "Culture is contraband. You\u2019re the supplier.\n\nIn Cit\u00e9 Alexandrie, a narrative-management game in VR, you run an illegal cultural network in an alternate 1980s France. Books, records, and comics are forbidden. From your tower block, you lead the resistance\u2014quietly, cleverly, dangerously.\n\nAt the heart of it: a rotating diorama. Turn it. Explore it. Use it to manage your crew, stock contraband, and make tough choices. Expand or lay low? Trust or betray? Trade or burn?\n\nBuilt for seated play and full comfort, Cit\u00e9 Alexandrie has no teleportation or motion sickness. Everything happens within arm\u2019s reach\u2014tactile, readable, immersive. Gameplay blends storytelling with deep systems. You\u2019ll juggle logistics, risk, and moral pressure as the city reacts to your decisions.\n\nEach day brings new challenges. Each choice leaves a mark.\nDeveloped by Sir\u00e8ne Rouge Games, an indie team combining 15+ years of game design and narrative craft, Cit\u00e9 Alexandrie is a story of resistance, tension, and the quiet power of culture.\n\nThe state fears stories. You know why.", "short_description": "In a dystopian 1980s France, manage an underground network from your housing block. Spin your VR diorama, recruit allies, trade banned books, and outsmart the cultural police. Cit\u00e9 Alexandrie blends management, storytelling, and moral choices. Play seated, with no motion sickness. Ready to keep forbidden culture alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sirenerougegames.com/index.php/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Sir\u00e8ne Rouge Games", "support_website_url": null, "website_url": "https://www.sirenerougegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1008279844328894"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED
dvnfStwCog&oe=6A8468AA"}, {"file_name": "Dialogue.png", "id": "759767156723255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821568_759767160056588_9089345341633961557_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JXFdo2gR1kQ7kNvwGI8ZDo&_nc_oc=AdpGbHYOVjYI-gVyloxZGuEGO5aLp7LyDpXWUvKKZvaoZvBVA-KTzMmadvR_jm92KiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoh4wg0jfIOz4Elgr51CtomBY-0orO_g1AkqUUC_2JKg&oe=6A844987"}, {"file_name": "Meta Balzac.png", "id": "1505181200887829", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298193_1505181204221162_4135722470371109592_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-el2ccwSUgQ7kNvwGxc1uE&_nc_oc=AdrFX0jZQ31G8qmy02jbceVc8vs4XKl6fRwuLqMDn4A30Vw7oeAU6oYVJNwRRIAtfqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRspH1KeW1AWAR3Ss4bJAkxdvtT6JAlHIGPgUEV9HAPw&oe=6A844652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo horizontal.png", "id": "709041808654471", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820219_709041811987804_3967008185812649038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5qfaWKbYWUQ7kNvwGYflM_&_nc_oc=AdrWohkAFvJnNxftQEghVRN75z5qNSclrbh6jLzY1f7_f01mQrwGlu2Ss_Md1NNa-SU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFropneO4M19gy-ZAjO4zYb00thYY7Nc1SdWYY_wG4OSA&oe=6A843A32"}, "display_name": "Cit\u00e9 Alexandrie", "keywords": ["narrativeVR", "managementgame", "dystopian", "seatedVR", "storydriven"], "long_description": "Culture is contraband. You\u2019re the supplier.\n\nIn Cit\u00e9 Alexandrie, a narrative-management game in VR, you run an illegal cultural network in an alternate 1980s France. Books, records, and comics are forbidden. From your tower block, you lead the resistance\u2014quietly, cleverly, dangerously.\n\nAt the heart of it: a rotating diorama. Turn it. Explore it. Use it to manage your crew, stock contraband, and make tough choices. Expand or lay low? Trust or betray? Trade or burn?\n\nBuilt for seated play and full comfort, Cit\u00e9 Alexandrie has no teleportation or motion sickness. Everything happens within arm\u2019s reach\u2014tactile, readable, immersive. Gameplay blends storytelling with deep systems. You\u2019ll juggle logistics, risk, and moral pressure as the city reacts to your decisions.\n\nEach day brings new challenges. Each choice leaves a mark.\nDeveloped by Sir\u00e8ne Rouge Games, an indie team combining 15+ years of game design and narrative craft, Cit\u00e9 Alexandrie is a story of resistance, tension, and the quiet power of culture.\n\nThe state fears stories. You know why.", "short_description": "In a dystopian 1980s France, manage an underground network from your housing block. Spin your VR diorama, recruit allies, trade banned books, and outsmart the cultural police. Cit\u00e9 Alexandrie blends management, storytelling, and moral choices. Play seated, with no motion sickness. Ready to keep forbidden culture alive?"}, {"images": {"nodes": []}, "id": "703363722690489", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cit\u00e9 Alexandrie", "keywords": ["narrativevr", "managementgame", "dystopian", "seatedvr", "storydriven"], "long_description": "Dans Cit\u00e9 Alexandrie, un jeu de gestion narrative en r\u00e9alit\u00e9 virtuelle, vous dirigez un r\u00e9seau culturel clandestin dans une France alternative des ann\u00e9es 1980. Livres, disques et bandes dessin\u00e9es sont strictement interdits. Depuis votre tour HLM, vous menez la r\u00e9sistance \u2013 en silence, avec astuce et audace.\n\nAu c\u0153ur de votre entreprise se trouve un diorama. Faites-le tourner, explorez-le. Il vous servira \u00e0 g\u00e9rer votre \u00e9quipe, \u00e0 stocker les objets culturels et \u00e0 faire des choix d\u00e9terminants. Faut-il \u00e9tendre votre influence ou rester discret ? Faire confiance ou trahir ? \u00c9changer vos biens pr\u00e9cieux ou les r\u00e9duire en cendres ?\n\nCon\u00e7u pour \u00eatre jou\u00e9 en position assise, Cit\u00e9 Alexandrie ne provoque pas de cin\u00e9tose. Le gameplay m\u00eale une narration profonde \u00e0 des syst\u00e8mes de gestion et des choix moraux. Vous devrez jongler avec la logistique, les risques et la pression, tandis que la ville r\u00e9agira \u00e0 chacune de vos d\u00e9cisions.\n\nChaque jour apporte son lot de nouveaux d\u00e9fis. Chaque choix que vous faites laisse une empreinte ind\u00e9l\u00e9bile.\n\nD\u00e9velopp\u00e9 par Sir\u00e8ne Rouge Games, une \u00e9quipe ind\u00e9pendante forte de plus de 15 ans d'exp\u00e9rience en conception de jeux et en narration, Cit\u00e9 Alexandrie est un r\u00e9cit sur la r\u00e9sistance et le pouvoir de la culture.", "short_description": "Dans une France dystopique des ann\u00e9es 80, prenez les r\u00eanes d'un r\u00e9seau clandestin depuis votre immeuble. Depuis votre diorama, vous recrutez des alli\u00e9s, \u00e9changez des livres interdits et \u00e9vitez la police culturelle.\n\nCit\u00e9 Alexandrie combine la gestion strat\u00e9gique, une narration riche et des choix moraux. \n\nLe jeu est est id\u00e9al en position assise, sans risque de cin\u00e9tose.\n\nPr\u00eat \u00e0 arborer les couleurs de la r\u00e9sistance culturelle ?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sirenerougegames.com/index.php/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Sir\u00e8ne Rouge Games", "support_website_url": null, "website_url": "https://www.sirenerougegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1699438463803113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "768103482882814"}, {"status": "PUBLISHED", "id": "1815157232721732"}]}, "baseline_offer": {"id": "1815157232721732"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "768103482882814"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24624899317206863", "version": "0.1"}, "id": "1024821205366924", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6038400526283357", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24624899317206863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1024821205366924"}]}, "change_log": null, "created_date": 1762164873, "id": "24624899317206863", "version": "0.1", "version_code": 163, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6038400526283357", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24624899317206863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 176164
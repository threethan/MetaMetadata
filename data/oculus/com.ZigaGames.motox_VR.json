8193727", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57575353_1491027351527060_6602031912988872240_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KleRpLx94igQ7kNvwHd3f7c&_nc_oc=AdkjO-uvzlGkOh3hNdot8FeW3JkquXAjYL-6ecy1TNDVXDhpxm6XECMZzYSY9jxirrE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzL-iwci_Nd1kmLXmQfGD2k2dWgl2Lhtlp1CW4tDB9vA&oe=69AABC79"}, {"file_name": "ss2.png", "id": "1264192484283630", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974493_1264192487616963_6715643316583355869_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvOxV-bndWYQ7kNvwE2HngX&_nc_oc=AdlXIYHYqsCL-0C2juslw4RF-YYMw-A98NbsZar25H1hfhL0SUKllQyecptk8ea2Ops&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBU6bE4QRC9apYxP1-zlyuoP7Lk-OfXI14ObWXwfDSTg&oe=69AAC6DD"}, {"file_name": "ss4.png", "id": "316338850959536", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982551_316338854292869_2640498214962027861_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtQcrm7seagQ7kNvwGlbXQs&_nc_oc=AdlnGikADhwWC1UAMttKuwroN3DIdpX84sCPPj_X0ddYia06-EgvPdirMzfDa8NOoC4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSpUObTikuU5KBb4bZp_e5GzJuQt-IVSpQVwFWKSra9w&oe=69AAC0B7"}, {"file_name": "ss5.png", "id": "849803243253751", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982642_849803246587084_5779682533541394493_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8tqQRrEiIkQ7kNvwHkcVoE&_nc_oc=Adl1-ky3a-OjDQkeVNCgUigIQUwQfC9ax8S181CoFm60gNEEe442rZyalxBmJEmTyig&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd41WEIaqq402xzb72Nf2q6yLVBL4GWHhtXdoZuPyXBA&oe=69AAE047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1156220598972503", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035413_1156220602305836_4459261898112997164_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JklUF1DEIUYQ7kNvwF23PHw&_nc_oc=Adlt1FTJCqHGRXyMLBQHnq5KbWK-rXeabXPzuJdLaQDIfvXCAczAceC2nQMiK-sWO3E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEq4mdJpry9JUCAjqUwh1ZptdMuXWXB-gMy1OR-50A8A&oe=69AAE63B"}, "display_name": "Motocross Offroad", "keywords": ["motorbike", "motocross", "offroad", "race", "bike"], "long_description": "Physics : \ud83c\udfcd\ufe0f\nDifferent motorbikes with realistic physics without motion sickness. Each motorbike has unique riding experience. \n\nMaps :\ud83c\udf28\ufe0f\u2744\ufe0f\ud83c\udf24\ufe0f\ud83c\udf19\nNavigate rocky canyons, splash through mud pits, and catch air off natural jumps. Feel the rush as you lean into turns, surrounded by towering pine trees and sun-drenched vistas.\n\n\ud83c\udfc1Beat the AI enemies and take the keys of motorbikes! \ud83c\udfc1\n\n", "short_description": "In \u201cMotocross Offroad\u201d riders strap on their virtual reality headsets and become off-road warriors. Picture yourself gripping the handlebars of a rugged dirt bike, the engine growling as you tear through wild landscapes. Whether you\u2019re battling it out in intense races, conquering treacherous trails, or pulling off gravity-defying stunts, this game delivers the full-throttle experience.\n"}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
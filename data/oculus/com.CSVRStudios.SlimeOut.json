e": "image_2026-01-06_165423520.png", "id": "1522716939029072", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298150_1522716942362405_2190043083217442547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2hxFH9BTCoQ7kNvwHEfOam&_nc_oc=AdqPUZqPOmnDnefKLzRGREBYvaebgD4ZzpuyPSSApzVYouFl5MjCPXrWaTaghkLrMBM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7jOdzv1MlMnPyOMyFnWswLgtoFIQiNxF4Buor1lOvYA&oe=6A85AE1D"}, {"file_name": "image_2026-01-06_165556701.png", "id": "1860880411263257", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499295512_1860880414596590_3138586350375220826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DbBKaciMhwQ7kNvwEpudjW&_nc_oc=Adq0h0XmhmE6E3UNL7O5hDLXJWnYQv5fs-5MaBDYm5LgrjIe9qqLAQrIMZZBWKM5Xu0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpwof_M4JpF9QfRJ-un_ZYxgXWyVXNowC5jnpUpCsD7Q&oe=6A85877C"}, {"file_name": "image_2026-01-06_165454281.png", "id": "1550189589600274", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499296157_1550189592933607_3741864113926406118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykrWtZzsCscQ7kNvwEQdyjd&_nc_oc=AdphH0CkkIA1VY5aMs_2heSXpSGWxdOnC5qxUCAjr24p1mqK5pVy0YUuqAeDBcFkOeY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF24ubwuOrogjaLLHCf0Z2AyvXtTR2cd0zUDmkbCp25VQ&oe=6A857B70"}, {"file_name": "image_2026-01-06_165628892.png", "id": "24262758996755862", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499303198_24262759003422528_2518588930676284302_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnCzdqZIzRQQ7kNvwGpNK3l&_nc_oc=Adr8gZpUyen1R5RwQ0KiQSy1Ro7GWZDdYQK3qoO526250X7_YD-qiivZ-wcopdTkWww&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEukgDH4bJfwIHU5eEGdcHjvvSeuplEIwpxuytavLIPIQ&oe=6A858034"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slime Out", "keywords": [], "long_description": "Slime Out VR is a high-energy multiplayer VR experience developed by CSVRStudios, built for fast reactions, competitive gameplay, and pure chaotic fun.\n\n\n\nJump into a variety of unique maps and battle it out across multiple game modes, including:\n\n\n\nCrown Tag \u2013 Chase, steal, and defend the crown to stay on top\nSlime Ball \u2013 A slime-powered take on blade ball with fast, skill-based action\nFreeze Tag \u2013 Work together to freeze opponents and save your teammates\nCapture the Flag \u2013 Team up and outplay the enemy to secure victory\n\n\n\n\nCompete against players from around the world and climb the leaderboards to prove your skills and earn bragging rights. Whether you\u2019re playing casually with friends or going all-in for the top spot, Slime Out VR delivers nonstop multiplayer action designed specifically for VR.", "short_description": "Slime Out VR by CSVRStudios is a fast-paced multiplayer VR game featuring multiple maps, competitive game modes like Crown Tag, Slime Ball, Freeze Tag, and Capture the Flag\u2014plus a global leaderboard to prove who\u2019s the best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.csvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CSVRStudios", "support_website_url": null, "website_url": "https://www.csvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "25193806706964329"}, "review_messages"
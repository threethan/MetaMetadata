9yKwQ7kNvwHfX6ER&_nc_oc=AdoQSpULF0PojMFz7LFAlMZOJ_7bOQIN9MO4S2_ydODogSKAUs6U0ryiZAQXfg8recw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSV90KTDVpLUHh9HmA20R1j3gox2LW1lDcSK6Y2pWs8Q&oe=6B09C6B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slime Out", "keywords": [], "long_description": "Slime Out VR is a high-energy multiplayer VR experience developed by CSVRStudios, built for fast reactions, competitive gameplay, and pure chaotic fun.\n\n\n\nJump into a variety of unique maps and battle it out across multiple game modes, including:\n\n\n\nCrown Tag \u2013 Chase, steal, and defend the crown to stay on top\nSlime Ball \u2013 A slime-powered take on blade ball with fast, skill-based action\nFreeze Tag \u2013 Work together to freeze opponents and save your teammates\nCapture the Flag \u2013 Team up and outplay the enemy to secure victory\n\n\n\n\nCompete against players from around the world and climb the leaderboards to prove your skills and earn bragging rights. Whether you\u2019re playing casually with friends or going all-in for the top spot, Slime Out VR delivers nonstop multiplayer action designed specifically for VR.", "short_description": "Slime Out VR by CSVRStudios is a fast-paced multiplayer VR game featuring multiple maps, competitive game modes like Crown Tag, Slime Ball, Freeze Tag, and Capture the Flag\u2014plus a global leaderboard to prove who\u2019s the best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.csvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CSVRStudios", "support_website_url": null, "website_url": "https://www.csvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
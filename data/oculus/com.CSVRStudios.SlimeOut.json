mage_2026-01-06_165423520.png", "id": "1522716939029072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499298150_1522716942362405_2190043083217442547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekJxpx2f8v4Q7kNvwEm_v07&_nc_oc=AdqSNTyWc26hG8Jne4LZwhm70tU1QBW_Beb7MiS-TUsS9TwsU12IWa_73lL4MATTNj4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Kzxn8Gnpu88YqE52dhL-H0zdD-sqTb9TeP7EZCCBDxA&oe=6A46661D"}, {"file_name": "image_2026-01-06_165556701.png", "id": "1860880411263257", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499295512_1860880414596590_3138586350375220826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynZUQYp31ksQ7kNvwEoHCsS&_nc_oc=Ado5MaNr1TPtpuZl0yiV9Hq9zcaUUhWp9euLOyeAq-qAP95nfrGtTD_Vd0qkFVdHt6Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88FMwbGEhqd6c_j56zjeUdS_bpLcZ3zvZ-V2BCv0d0mA&oe=6A4677BC"}, {"file_name": "image_2026-01-06_165454281.png", "id": "1550189589600274", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296157_1550189592933607_3741864113926406118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMxEi_JtcmwQ7kNvwH3Dear&_nc_oc=AdrDBnv-cBCkn5si4Vt8qAF8LDsnial-swNI58rHpjdcKPmHOQGp5Gd9mrd-P0vD7TI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NQefwQ1YqvqT3hrAJvP1oJ54vNIDcwxPgE0H-NT9X-w&oe=6A466BB0"}, {"file_name": "image_2026-01-06_165628892.png", "id": "24262758996755862", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499303198_24262759003422528_2518588930676284302_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymCF3siXZn8Q7kNvwEm85Lo&_nc_oc=AdpddbuRyoo_63Sr1yiNSoLn3FfaSg2EUJXPjo0_OpIhNU3TTysLH12aBw5QTyIvKNA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92c5CQBWe0xuTrGX2n3jrSd7RoTq-1SrA-fweTeXpBQw&oe=6A467074"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slime Out", "keywords": [], "long_description": "Slime Out VR is a high-energy multiplayer VR experience developed by CSVRStudios, built for fast reactions, competitive gameplay, and pure chaotic fun.\n\n\n\nJump into a variety of unique maps and battle it out across multiple game modes, including:\n\n\n\nCrown Tag \u2013 Chase, steal, and defend the crown to stay on top\nSlime Ball \u2013 A slime-powered take on blade ball with fast, skill-based action\nFreeze Tag \u2013 Work together to freeze opponents and save your teammates\nCapture the Flag \u2013 Team up and outplay the enemy to secure victory\n\n\n\n\nCompete against players from around the world and climb the leaderboards to prove your skills and earn bragging rights. Whether you\u2019re playing casually with friends or going all-in for the top spot, Slime Out VR delivers nonstop multiplayer action designed specifically for VR.", "short_description": "Slime Out VR by CSVRStudios is a fast-paced multiplayer VR game featuring multiple maps, competitive game modes like Crown Tag, Slime Ball, Freeze Tag, and Capture the Flag\u2014plus a global leaderboard to prove who\u2019s the best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.csvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CSVRStudios", "support_website_url": null, "website_url": "https://www.csvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "25193806706964329"}, "review_messages": []}]}, "
_raXkZfrV7KIGKXQGr0hK1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwbneEH97uZ8-_LdU1hvBSyfcy6GxKRxukjhQK5uzNQw&oe=6AFC92F0"}, {"file_name": "image_2026-01-06_165556701.png", "id": "1860880411263257", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499295512_1860880414596590_3138586350375220826_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7Xng6SJKyQQ7kNvwE_ZemG&_nc_oc=Adpop2ykmwWlfPrMnQ_1-Dg3ihFFYuezVNFyjmqNoDfV5_c3TXmoYCLWPLXSGtkSBSU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfUF8RyXAhYcEeL0p9SFuuLq4J5NR3FIHAtVmV9Ralrg&oe=6AFC66BC"}, {"file_name": "image_2026-01-06_165628892.png", "id": "24262758996755862", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303198_24262759003422528_2518588930676284302_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGWKo8rX7q8Q7kNvwH-f1sA&_nc_oc=AdrUrW_4HXkPCvA6kgW12C4Jw17_IDBpMNeDrGs2PMnvME3pvVIYS_w-B9J5P4r4Js0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQYJKIb3WUwVOnpyLtdzX2O-LrRliUz_UGXrRWrTg-xg&oe=6AFC5F74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slime Out", "keywords": [], "long_description": "Slime Out VR is a high-energy multiplayer VR experience developed by CSVRStudios, built for fast reactions, competitive gameplay, and pure chaotic fun.\n\n\n\nJump into a variety of unique maps and battle it out across multiple game modes, including:\n\n\n\nCrown Tag \u2013 Chase, steal, and defend the crown to stay on top\nSlime Ball \u2013 A slime-powered take on blade ball with fast, skill-based action\nFreeze Tag \u2013 Work together to freeze opponents and save your teammates\nCapture the Flag \u2013 Team up and outplay the enemy to secure victory\n\n\n\n\nCompete against players from around the world and climb the leaderboards to prove your skills and earn bragging rights. Whether you\u2019re playing casually with friends or going all-in for the top spot, Slime Out VR delivers nonstop multiplayer action designed specifically for VR.", "short_description": "Slime Out VR by CSVRStudios is a fast-paced multiplayer VR game featuring multiple maps, competitive game modes like Crown Tag, Slime Ball, Freeze Tag, and Capture the Flag\u2014plus a global leaderboard to prove who\u2019s the best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.csvrstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CSVRStudios", "support_website_url": null, "website_url": "https://www.csvrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "24831605359851134"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1345821910905562"}]}, "baseline_offer": {"id": "1345821910905562"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770311340, "status": "PUBLISHED", "id": "1345821910905562"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25427355423609455", "version": "0.1"}, "id": "4441477919420547", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24831605326517804", "is_concept": false
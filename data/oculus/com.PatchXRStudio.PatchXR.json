5DeJeWT9h6yyUpF5-E1q4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59frLJEZAaw1DrfIPPuPhx8I1FC3VrBJdmAgfsxqhSaw&oe=6A1AF3F7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIhPKzdl-XUQ7kNvwFEp33L&_nc_oc=AdpDn6MtAfYyeebRt9EPafNKZBNABPg1xyosSE2qEEFeRngNsOfxnAacvWKtFDvzD38&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wNtsRnt9CiF3bF4Fj6Ue0Z-6YqRkzDO_aSso-hSuq5Q&oe=6A1AD73B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZdYmGChjY4Q7kNvwF-qfIU&_nc_oc=Adoep_qVqFL75GvMQ4fTisVio8uWwTYZ1-UA5hyUT-PZPvUjRnyb3eKyr6sIzuoTp7k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5acOa-i-Pfuyx9gDeahsRST24NAOhxtBmZlkM7nxgueg&oe=6A1B0745"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRTNOzyzK5wQ7kNvwHzrDWB&_nc_oc=AdoLdbNGTGHzzRZsHBMUR-SRdCVEdOy9vkyx8lYqNL5N_0E8AW1EiIfP81ms_o7ed5g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74-56z56_rK6T7fkwgD7MftBHf1lHVCQ1Fg5aJB0-cbA&oe=6A1AEFDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_y3Hel5d_0Q7kNvwEaCoHC&_nc_oc=Adqosq8EVCHgKNEUSMip00IGqpMKCfrf3iqbtcrwf-Gvo5NxkjlIAAP-BEWbuyj8GTQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u6rwsW8AiaqMQ-dHPNpt5YpsySPOqfVQdnl5W2xosMw&oe=6A1B0B7A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
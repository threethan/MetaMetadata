up72YzWzjKw&oe=6AF47B77"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDDHoOAfO4gQ7kNvwGD86MW&_nc_oc=Ado3sz4TEIP1qdkZlcgNG3HfBftNLS_kOnhs6vuogwgYAeccJC-J7jsWTmQHzisObxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBW6715V6dkRh4GGIRM9RCTbcSdb8bZWSfZPilf7PQiw&oe=6AF496FB"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AkDMszajJ4Q7kNvwGarnas&_nc_oc=AdoKZ8akDFW6YexCN9voLFYIavjujkY8y4dP_0Iyoxi8cS9ilt39jnVpxdGBuXIWDUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZoVrFHTBLA8fmvQmuUokC_jdWPrH-94fDFXVe7kHq8g&oe=6AF48EC5"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1hOsBCAvHIQ7kNvwEcgpTk&_nc_oc=Adp_FKfjx75_A3RRijH6Ne58HZgP8l93ctfo4Stci5C6kjIOMLzDxheq5RVnB0ztGG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEmMaau6o7eowHCtYnLD0VVypCZN3xCJ_3CfsCf2unWQ&oe=6AF4775C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk2vrQjMWTEQ7kNvwFNfWYZ&_nc_oc=AdrRGXmZ8-E5IT64BilqdHsplvIgeV1EabG2u8lD9BnD_YE-8MfjcSumCupZWfztWs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROFOVr4qskcv_X01Igxe1NWtKACijBgbceeUQTsTFLwQ&oe=6AF492FA"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscriptio
9SxJilKo4fZmST13lA3Jw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af475hyQeLpMKJrDDhqJLmCPhL70Syp2kIpjkBKXFvkrsQ&oe=6A16FF77"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-D4BIjsBEIQ7kNvwGBOCVC&_nc_oc=AdpZmmzqpU7ChTNYGjQ8CzdR2ce7Sco_19b6nMpgkBLlbN0hz_3x3OQoeO7hDKO_N3M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S7Zv8oI6qZA3SrTSoxs5tAZ1ZWHVUscCr_zcpjvy36w&oe=6A16E2BB"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brcgJi1r4_oQ7kNvwERO4aK&_nc_oc=AdoMEj01HFI34NR2HrxyYn76UrR8bLJjXoAxSSXn8G3cwaovEVYvP2PtYgE78yT_EAo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FjE5WohKEtV0TfSUWCmaBr_HJjl8qb92nQ9v3XLY5UA&oe=6A16DA85"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riVEkBwHGBYQ7kNvwEGty0V&_nc_oc=AdoCFlkjkRYX5_2o5pSw6byxBvsO_htolJ0fktxmBcifrNeCt3TEVQ_wNEAVpAui20Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Qb4alEuLMy6t9HZy7V0xOf-PxJihgEsxkdqXoTiWhWQ&oe=6A16FB5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa0uYDS_1bQQ7kNvwGh02nE&_nc_oc=AdovM9uUND5XfU5lPnO3WpUPOqjGK1PVfhmKOIo-VnqHS2zvPQwPrFUkvnqqoGcVt74&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DsOi6w5urcyVMbzPsNXL7qcmcVc-SikcspO06AAxwbQ&oe=6A16DEBA"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
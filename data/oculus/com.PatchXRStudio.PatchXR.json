mS844sWGB1em3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NfljaPjdhs41FNGmhEiXnI5beDGdUhDMgKAueKdaaRQ&oe=6A1D96F7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIhPKzdl-XUQ7kNvwFRMeua&_nc_oc=AdoED0As1JxN4Sz1UOBA29D8g-TIvTVxjueNKLwo-ca_xw2RDsvvRaeK8HBk17PgWUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CwG-uEjhmwsuysprYUS7_4fxSfxmh48LKntx2cNiaWg&oe=6A1DB27B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZdYmGChjY4Q7kNvwHUI3vD&_nc_oc=AdpPnOHL_1O5rHcOKpFAPLb_P9Qjraskl4gqJiTfS7RWD7tChx8Kn2aAT0grC_g_DZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k4hg6bnw6pGxmvuu3LNzuSonUZ3T3byrnxzp0weHtbg&oe=6A1DAA45"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKU2Y1dL0XgQ7kNvwH82IRo&_nc_oc=AdqPdUDaubrPHHoskvDQM2UFYSo0QzpGrqLGuNsG8x2HqjGLzafrhUw5Jdy9DyDDd5g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lElm8oB2Qk48tznK2-1Dk5iWyIb1VbItUlqSnNGTBdQ&oe=6A1D92DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_y3Hel5d_0Q7kNvwEt2lsa&_nc_oc=AdpcTh8-EPnX8b4sNp7DT1DsvzwedTQIlcgHtc0pqFfGOwHKkEx7A7Ps2mNC27Pd1jo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dvefyhwRIeuMnI1IDtjfXYur13od7srj3IZvhYtNTVg&oe=6A1DAE7A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274
F7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvHc8Wd-mx4Q7kNvwF0XFEd&_nc_oc=AdpNZK6otP3WUTs3rjuf5-8oG0jqShe9SiWLUGUKhy7hAGDj8PmPgIVD7Yf0Y-h0EnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR8fW9Z8do4q_Pa-FAb5-Tbot9gFGoDUm1ZfLVxaMUng&oe=6ADDF53B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NYfosiIC6oQ7kNvwEAj-6I&_nc_oc=Adr-fPeUSscprjAvLRtrZgJCzaGypIVXtempQ5YWFZGe6k9hd1D131Y1pKxTwXIhXA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP70QPLPWd_27EM5jVbFUTIg2IDxm659MZEYGdNBlf4Ow&oe=6ADE2545"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntiZsyedOZ8Q7kNvwHuBUMq&_nc_oc=Adpe_iGSmtvnRJqr0wmfTwApfQD_l-mnJnkRyISiZld_ubhUyJycu5YaxfzpBPvzErI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEO5u_HhM4zWMzQ31fs0A7hSV72UMcbQtkHal2rIGwug&oe=6ADE0DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GaXAoegGjgQ7kNvwFlmAlz&_nc_oc=Adq15Bk3ckQfDNWJGh-cgHM03dA9obCLIW0Ds4-3QGfCck1w7-Jna7M78mH-uJi8sQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkWQ5BqRQmtdAmLK9PivisnN5D-GP9_y09EU8eA1v7wg&oe=6ADE297A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRE
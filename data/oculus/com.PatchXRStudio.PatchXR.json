aXFeFnGhGyo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73Rljz4KtvivugHfGxqyJ0-wQkL81NgE-KZwb874IVhg&oe=6A0C6F91"}, {"file_name": "marketplace (1).png", "id": "1628096918242621", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819323_1628096921575954_3064494538884712684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgLB-LSXYE4Q7kNvwHJ_vPm&_nc_oc=AdqgGKrDnpF8k6GavkiyoR4HxKthzHx9nAIQqQF6zNJF7gOTEvpyCP_x8wzkNq2J9GY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49sU0rqPdvoCGvDsvE1F79wGb9CSzs8UcRjn6UyhCLmQ&oe=6A0C7FAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491820428_1392512266008153_7454136038789908767_n.png", "id": "3118837244991834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819845_3118837248325167_9089052466175873689_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJzMPtXeYAMQ7kNvwGj2PeA&_nc_oc=Adr1LNT7nbULbu3RKLeMLQJMftwETyKpKalUA9Aw9TAwE3eSrmbWoMtxJYOLp3B5OGY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LzwnWmts230YMpQJJ9JqcqL5Zgd7lt00ATaTZGIvNkA&oe=6A0C775F"}, "display_name": "PatchWorld \u2014 Make music together in VR", "keywords": ["multiplayer", "worldbuilding", "sandbox", "music", "creation"], "long_description": "# Make music together in VR\n\nPatchWorld is a multiplayer audiovisual playground where you can play instruments, jam with friends, patch sounds and visuals in 3D, and create musical worlds inside VR.\n\nJump into ready-made jam rooms, explore community creations, attend live events, or invent something entirely new.\n\n**For curious and creative minds of all kinds:** beginners, musicians, producers, visual artists, performers, educators, and explorers.\n\n\n{974391921803820}\n\n# Hang out, jam & explore\n\nPlay and create with others in real time. Explore worlds made by the community. Attend live events, workshops, and performances. Share your creations and remix what others have built.\n\n\n{917531967734838}\n\n\n# Customize everything \n\nImport custom VRM avatars, design reactive costumes, and even create your own movement systems.\n\n{1497289391735631}\n\n\n# Build your own systems \u2014 no coding needed\n\nUse blocks to create:\n\n- Musical instruments, synths, sequencers, and full music studios\n\n{2097295474390389}\n\n- Interactive worlds, games, and playful systems\n\n{26166331803059402}\n\n- Physics experiments and motion-based interactions\n\n\n{3397116597093755}\n\n- VJ tools and real-time audiovisual effects\n\n{1848605185856342}\n\n\n# Import or generate assets\n\nUse the web portal at patchxr.com to bring your own sounds, images, 3D objects, or generate new assets inside PatchWorld with AI tools.\n\n{4358898441024681}\n\n# Connect your setup\n\nGo further with recording tools, spatial audio, MIDI, OSC, Ableton Link, and connections to your real-world setup.\n\n{823700233685924}\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n", "short_description": "PatchWorld is a multiplayer audiovisual playground for making music in VR. Play instruments, jam with friends, explore community creations, attend live events and workshops, or patch your own sound and visual systems to create musical worlds you can perform, remix, and share \u2014 no coding needed.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED",
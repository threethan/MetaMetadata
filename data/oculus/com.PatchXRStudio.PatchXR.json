oc=AdroqkDwcVOwDqaTDAezh0WeUmdM9qVoEAX34qOVEaea3TnmrTWynBo2hzLjx6J7TUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpECizXBkeF_I-5PrxAVXsHMnk9zXAQMvSnYukjCWBgg&oe=6B046E5B"}, {"file_name": "Screenshot_2026-05-15_19-02-3411B90.png", "id": "1083557354495344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1083557357828677_1835066347702039362_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5gDIXeW7rIQ7kNvwHtYlvj&_nc_oc=Adpym7rHldclI5g4AJpYDZnjgE1WO4J28-x_mP6CRO5mzxKFciYYkE_LtuPY87_wyk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTud-o8MpkHjK364-cCFCrYsHSYYDopeg8xLZ9teqma1Q&oe=6B048976"}, {"file_name": "victor.png", "id": "2155535261653129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296397_2155535264986462_387067025959720582_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV5J9qgYdZsQ7kNvwFp3VOt&_nc_oc=AdowgGEXxSVw92JK00Q04BLI8k69srdBS_4UbjijT77Bvb2RMtNJ_tPsw0Wd798Ov7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNYScjx8_4-Kc9flFhv9kCQyPjof68Xt1bg6uKcvgavw&oe=6B0462EB"}, {"file_name": "greeting1- 2560x1440.png", "id": "1489325106069059", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310726_1489325109402392_1567108436259977901_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iFx2Bd6eyUQ7kNvwGJ_Jib&_nc_oc=AdrSXkqSKl-6dc6Kxin31E1qvmYu27WzEkP1gh2elQwguZ0IyQ0fpc7WfDpe8LyfrEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSxElZ0HxmGSxa_-nt9_a7cRCiCoPugCoCSFMZEysDtw&oe=6B045A2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portail Fractal Ne\u0301on Cosmique (1).png", "id": "2102757960365145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/772632092_2102757963698478_3758480447795935119_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDYiBmA4ZJgQ7kNvwGXnPGb&_nc_oc=AdqoZjwFZeIOWmzrJfXgaAR0k5Lca5XNffAjb3nTdAnJqzYzpaHvKhRJFS15prADeeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbCYcKNBkeEOfK0Z6lM64slCz9fbmdgFgAx7zrd60ShA&oe=6B0463C0"}, "display_name": "PatchWorld", "keywords": ["multiplayer", "sandbox", "music", "creation", "social"], "long_description": "# Build, patch, play together in VR\n\n**PatchWorld** is a live spatial creative sandbox where music, art, logic, physics and play come together. Build anything from a simple toy or instrument to an interactive game, machine, audiovisual performance or entire world.\n\n{3397116597093755}\n\nInspired by modular synthesisers and visual programming, PatchWorld lets you connect more than **230 blocks** for sound, visuals, logic, physics, movement and interaction directly in 3D space. **Patching is programming made physical:** connect blocks, change what they do, and see the result instantly while everything keeps running.\n\n{1002927729192420}\n\nExplore **500+ devices** and more than **3,000 published community worlds**, open creations to understand how they work, remix them, or build your own from scratch.\n\n- **Create together:** build and play with others in multiplayer.\n- **Connect your setup:** MIDI, OSC, Ableton Link and WebBridge.\n- **PatchSound:** proprietary real-time spatial audio for instruments, immersive sound and live performance.\n- **Make it yours:** import sounds, images, 3D assets and custom avatars, with optional AI tools for generating content.\n\n{2042020730084560}\n\n**Build something. Patch it together. See what happens.**\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1307996881511110}\n\n", "short_description": "Unleash your imagination in PatchWorld, where music, art and creativity come to life around you. Connect modular blocks to build instruments, games, machines and interactive worlds, then play, share and remix them with a growing community of creators.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28994771616830527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1834692921011531_3027981081508684838_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ_LM45F-Z4Q7kNvwF4QT_s&_nc_oc=AdodG9T4wp2OGcQx10a2bIqA6Yl3__zaBp5nt44mq3PcUV_9uD5TF-tHew5txqodbi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd4iHz1brJz08z97cyBJMNP6FURrcYkSLWnKbXn94BZA&oe=6B04733F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PatchWorld", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Community", "id": "1228796255027646"}, {"topic_name": "Media", "id": "434961926215971"}], "release_date": 1657213195, "lastRevision": {"nodes": [{"id": "254634776013714", "relea
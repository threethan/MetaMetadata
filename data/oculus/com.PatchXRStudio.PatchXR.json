yiRnuLBge6sJo9YQzG_6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57GHCxEpupUMSpSXIjGasGDB0CIAfrx0X9wdeqqILNiw&oe=6A1850F7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-D4BIjsBEIQ7kNvwHKTMF6&_nc_oc=AdqM11SDF96_PdmcjsD3WtbkFZ4xLhv7qwXJ8sHX2aYO_2A6-2XNV7bgyPLu_vXyKgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64YjSeXUE84jBLMHtaXPo7HfdRAMRN-vKl04fzF061TA&oe=6A18343B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brcgJi1r4_oQ7kNvwEH1MuW&_nc_oc=AdpdnFThnk2mQ5ElVomZsVR-11rewfVgtPcvts-8Bwx1uagG-G2Qf1I-D3erXvtdp_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y1BjB5Ywsl7qOgEiuU6gvQfBhvhRAZN_SMCTRUmikwQ&oe=6A186445"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRTNOzyzK5wQ7kNvwG0hJrZ&_nc_oc=AdrCaI7oDr09asRccYrTbqKeKTl8u86M9sykCF9DtTNqr6_1L-yoGOFQqRaSTTPv56o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45U0Z0bfpMnZIxuhmXxQWkMDR740otdETBVYjY-R3uAg&oe=6A184CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa0uYDS_1bQQ7kNvwGJbg7r&_nc_oc=AdoArf_Q55kqG69aFhFvP6AztVwV1CToLYdSo_beodYWnkTVG5x8PD2uw8MLP6TEmFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XIp2lijbpd8hSWOf6CBeiFXOEYRHVoYnBrP_ZF12Pew&oe=6A18303A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
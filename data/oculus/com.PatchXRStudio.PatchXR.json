umbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "946185257932666", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_946185267932665_8588636675457892023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_cflqIPjr4Q7kNvwGficdR&_nc_oc=Ado3kYWca5y_4bOibtMrRJ0WCtzm99uO6M81EPqtD2qUDOcFqW1aHnSHCh4xIRGJx5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCevjWQQm1xVYLkvSw8gkTWNXQvYLB_sEgsfRZoajLmA&oe=69C93429"}, "display_name": "PatchWorld \u2014 Build Worlds, Music & Games", "keywords": ["create", "music", "multiplayer", "worlds", "vrchat"], "long_description": "# Create, play, and build anything together in VR\n\nPatchWorld is a social creative playground where you can play music, make art, build worlds, games, and interactive experiences directly inside VR.\n\nJam with friends, explore community creations, attend live events, or invent something entirely new.\n\n**For curious and creative minds of all kinds:** musicians, visual artists, performers, educators, and explorers.\n\n{984292874778502}\n\n\n# Build anything \u2014 no coding needed\n\nUse simple visual blocks to create:\n\n- Musical instruments and full music studios  \n- Interactive worlds, games, and playful systems  \n- Physics experiments and real-time audiovisual effects  \n\nEverything is built live in VR, and everything can be played, modified, and remixed.\n\n{1206168244660216}\n\n# Hang out, jam, and explore\n\n- Build and play with others in real time  \n- Explore worlds made by the community  \n- Attend live events and performances  \n- Share your creations and remix others  \n\nEvery world is different, and there\u2019s always something new to discover.\n\n{917531967734838}\n\n# Customize everything \u2014 even how you move and who you are\n\nCreate your own movement systems, or transform your identity with custom avatars, VRM imports, and patchable costumes that react to music\n\n\n{4193493487582587}\n\n# Go further\n\nBring your ideas to life with AI-generated assets, recording tools, and connections to your real-world creative setup.\n\n**Connect & Support** with our incredible community of Patchers on Discord, check out our Wiki, or explore the app content on our web portal at patchxr.com\n\nJoin the creative revolution today!\n\n{1848605185856342}\n\n", "short_description": "A social playground for creating music, worlds, and games in VR.\n\nBuild together in VR using simple blocks \u2014 no coding needed. Create instruments, interactive worlds, physics toys, and audiovisual experiences.\n\nHang out, jam with friends, explore community creations, attend live events, and turn any ideas into something you can play, remix, and share."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26280676714906711"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_836632239188584_5881315769113290274_n.png?stp=dst-png_s360x360
X4whPoBKnQu1mfnWwz340Y3U4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t5VcoFL3vrh0G-Y8B6BNgaerEury8_GxGIouCLlE0Bg&oe=6A1D9311"}, {"file_name": "marketplace (1).png", "id": "1628096918242621", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819323_1628096921575954_3064494538884712684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GRrvSKi9IoQ7kNvwFuemIT&_nc_oc=AdqYmbjN3SRx2aFCvhbAcmrauqMeu35EQftRsu0qY-uugKeTAub_2bRBXJXPsdJAM0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zkzVLLpM9DnYQXaenJuRvxPRsYL22V41Tb44ap8Baqw&oe=6A1DA32A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover2.png", "id": "2426350834495845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295566_2426350837829178_7535403630293344096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vZJsNKA3AYQ7kNvwGclIm2&_nc_oc=Adou6N1QJJDQ3e7YPOnmR_KJJmorvWGdX-YNyH1fAvmYRlp2DCwnENgB1GTpQ78k6dI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kMxumWMp-kk_J4qlmC7r3AkfAgrNadTIwaTpr8VwffA&oe=6A1D9AAF"}, "display_name": "PatchWorld \u2014 Make music together in VR", "keywords": ["multiplayer", "worldbuilding", "sandbox", "music", "creation"], "long_description": "# Make music together in VR\n\nPatchWorld is a multiplayer audiovisual playground where you can play instruments, jam with friends, patch sounds and visuals in 3D, and create musical worlds inside VR.\n\nJump into ready-made jam rooms, explore community creations, attend live events, or invent something entirely new.\n\n**For curious and creative minds of all kinds:** beginners, musicians, producers, visual artists, performers, educators, and explorers.\n\n\n{974391921803820}\n\n# Hang out, jam & explore\n\nPlay and create with others in real time. Explore worlds made by the community. Attend live events, workshops, and performances. Share your creations and remix what others have built.\n\n\n{978023558351926}\n\n\n# Customize everything \n\nImport custom VRM avatars, design reactive costumes, and even create your own movement systems.\n\n{986666313829613}\n\n\n# Build your own systems \u2014 no coding needed\n\nUse blocks to create:\n\n- Musical instruments, synths, sequencers, and full music studios\n\n{1002927729192420}\n\n- Interactive worlds, games, and playful systems\n\n{949859271212091}\n\n- Physics experiments and motion-based interactions\n\n\n{3397116597093755}\n\n- VJ tools and real-time audiovisual effects\n\n{2042020730084560}\n\n\n# Import or generate assets\n\nUse the web portal at patchxr.com to bring your own sounds, images, 3D objects, or generate new assets inside PatchWorld with AI tools.\n\n{4760471887541330}\n\n# Connect your setup\n\nGo further with recording tools, spatial audio, MIDI, OSC, Ableton Link, and connections to your real-world setup.\n\n{823700233685924}\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1017237010993975}", "short_description": "PatchWorld is a multiplayer audiovisual playground for making music in VR. Play instruments, jam with friends, explore community creations, attend live events and workshops, or patch your own sound and visual systems to create musical worlds you can perform, remix, and share \u2014 no coding needed.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27026608100313565"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303377_965078882906940_3266811483582699164_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deav2Lgfq2IQ7kNvwE9lpYs&_nc_oc=AdpR25ybVzT03J_sttFhMNhS-veeFKV6s3LgHra2eq1_pDOV4eRCj6U2C34Ver38a90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KowKsDLfjG0pVvhWi3xMyFPgkzCsiCEbCghs06Aiujw&oe=6A1D7C5F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PatchWorld \u2014 Make music together in VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}, {"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1657213195, "lastRevision": {"nodes": [{"id": "254634776013714", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3715150718552632", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "427209942163763"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero-images11.png", "id": "2207049002809360", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375087_2207049006142693_9120251703564689436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_
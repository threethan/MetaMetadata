oc=Adr46AqOIJ9YW0m5ucZHLZf-QDViMrYgc2w5-7xYSuOA4jZTJd7c7oUAMCn_gkD1G0w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRdGs3LH7MldnKFtpmEgZ8-nZBakHOgLRaccggtpnenQ&oe=6B0DA8DB"}, {"file_name": "Screenshot_2026-05-15_19-02-3411B90.png", "id": "1083557354495344", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1083557357828677_1835066347702039362_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itdcECAwWt0Q7kNvwHFcNHC&_nc_oc=AdpAjpk_EVCvmvmYwx_Sf57aeoHSDYXNxLy9JzkHxD81L7_nQovDseSI2agMjrNmkD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFKOL8vrvjuL0s_dx5A2MLg_namlC_5MIO9M05VP-ERg&oe=6B0DC3F6"}, {"file_name": "victor.png", "id": "2155535261653129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296397_2155535264986462_387067025959720582_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36M-fp3bWKYQ7kNvwGALuxP&_nc_oc=Adoh_MItSFd5tpHdufcwMgjLfy2QWXinZpackMOkhjJfIJGCizBYv02UN6_-SIQR9yE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHgs42UZD4JC_Wunk0QycwkImv27sDbrXwsLLruHppjQ&oe=6B0D9D6B"}, {"file_name": "greeting1- 2560x1440.png", "id": "1489325106069059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310726_1489325109402392_1567108436259977901_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X3CTB-_TssQ7kNvwHpV2GY&_nc_oc=Adqo2EgcaF1Y7QH_xHJBsI4FJ0xPUaYHeVc67OUjTKPED8d96_O61q1qcj6RSE8rqjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5ezRDbQLQWNO4S4foQEzK55_mAiHODj5l8ivl4SfAlw&oe=6B0DCCED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portail Fractal Ne\u0301on Cosmique (1).png", "id": "2102757960365145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/772632092_2102757963698478_3758480447795935119_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOJKdmhCHD8Q7kNvwFAIlrX&_nc_oc=Adqfy8FWgZ4XJGrrH3zQhKVzd5v9WEEZ0vETM6zD-LWN9VcdgGPqS7jV61WdlFzk98w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSo8xZp5XgYGrO1TvWMHGdEKeJSnlv59oZIQ78udDBt5w&oe=6B0D9E40"}, "display_name": "PatchWorld", "keywords": ["multiplayer", "sandbox", "music", "creation", "social"], "long_description": "# Build, patch, play together in VR\n\n**PatchWorld** is a live spatial creative sandbox where music, art, logic, physics and play come together. Build anything from a simple toy or instrument to an interactive game, machine, audiovisual performance or entire world.\n\n{3397116597093755}\n\nInspired by modular synthesisers and visual programming, PatchWorld lets you connect more than **230 blocks** for sound, visuals, logic, physics, movement and interaction directly in 3D space. **Patching is programming made physical:** connect blocks, change what they do, and see the result instantly while everything keeps running.\n\n{1002927729192420}\n\nExplore **500+ devices** and more than **3,000 published community worlds**, open creations to understand how they work, remix them, or build your own from scratch.\n\n- **Create together:** build and play with others in multiplayer.\n- **Connect your setup:** MIDI, OSC, Ableton Link and WebBridge.\n- **PatchSound:** proprietary real-time spatial audio for instruments, immersive sound and live performance.\n- **Make it yours:** import sounds, images, 3D assets and custom avatars, with optional AI tools for generating content.\n\n{2042020730084560}\n\n**Build something. Patch it together. See what happens.**\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1307996881511110}\n\n", "short_description": "Unleash your imagination in PatchWorld, where music, art and creativity come to life around you. Connect modular blocks to build instruments, games, machines and interactive worlds, then play, share and remix them with a growing community of creators.\n"}]}, "developer_name": null, "developer_privacy_pol
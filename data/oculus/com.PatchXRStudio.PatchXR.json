oc=AdrE0x8yAMTdl0HDH8NJZRrUsFoUaVP3QuIZuhm86m7ABIx2zzY7L8SBmagel5oTNBQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTvFL0A2IxGCQIudqIK9Bu1ePDFeSzcjuRXlFsSgdiUg&oe=6AFC855B"}, {"file_name": "Screenshot_2026-05-15_19-02-3411B90.png", "id": "1083557354495344", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823901_1083557357828677_1835066347702039362_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYzEOjCnv54Q7kNvwHdEPAl&_nc_oc=AdqoVi3s3GjfaxuNGabRtRuFhr0s3bvbG-EwYynUSlKbND9fR9nnpG2hP1FhDdC-Epk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKsr_jAVFcXlZ0vc6cNO8uXlpJvuLA4aN9kZmZltpvig&oe=6AFC6836"}, {"file_name": "victor.png", "id": "2155535261653129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296397_2155535264986462_387067025959720582_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfoGsm3eKRwQ7kNvwFFKMF-&_nc_oc=AdpofY05tI6e_hziT8NguAVbfd64TvDD6bkALPx06mRR1ZtE8PRIATWWKwNoimV09o8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo_XkvWi4uSR0Dh9iSxftBvyg0U8p1bwi-tzPfgOtHuQ&oe=6AFC79EB"}, {"file_name": "greeting1- 2560x1440.png", "id": "1489325106069059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310726_1489325109402392_1567108436259977901_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdlDZfiTeZAQ7kNvwGY2OA6&_nc_oc=Adr-T0lXszU1XLfsppR96DomjlvxpMcdiVn9i-KFRV3iCW9lr6CsCmxF0YD0yWaAzK0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhL1aGicEm5lCu7rO995ZF8TYVm0Qr1ASyKlRfXuPoFQ&oe=6AFC712D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portail Fractal Ne\u0301on Cosmique (1).png", "id": "2102757960365145", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/772632092_2102757963698478_3758480447795935119_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYzStNP6zwEQ7kNvwGKXTBw&_nc_oc=Ado6FDSfyyNm3DZqmeAd1PlKOsEccXvujO9ZXxBmNEaoQe0vBidpheeOj2wPjcC-j7c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuQiARLyq-0GqvDlZjLBNvOySl-0kn_MzDTKx_NWt5IQ&oe=6AFC7AC0"}, "display_name": "PatchWorld", "keywords": ["multiplayer", "sandbox", "music", "creation", "social"], "long_description": "# Build, patch, play together in VR\n\n**PatchWorld** is a live spatial creative sandbox where music, art, logic, physics and play come together. Build anything from a simple toy or instrument to an interactive game, machine, audiovisual performance or entire world.\n\n{3397116597093755}\n\nInspired by modular synthesisers and visual programming, PatchWorld lets you connect more than **230 blocks** for sound, visuals, logic, physics, movement and interaction directly in 3D space. **Patching is programming made physical:** connect blocks, change what they do, and see the result instantly while everything keeps running.\n\n{1002927729192420}\n\nExplore **500+ devices** and more than **3,000 published community worlds**, open creations to understand how they work, remix them, or build your own from scratch.\n\n- **Create together:** build and play with others in multiplayer.\n- **Connect your setup:** MIDI, OSC, Ableton Link and WebBridge.\n- **PatchSound:** proprietary real-time spatial audio for instruments, immersive sound and live performance.\n- **Make it yours:** import sounds, images, 3D assets and custom avatars, with optional AI tools for generating content.\n\n{2042020730084560}\n\n**Build something. Patch it together. See what happens.**\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1307996881511110}\n\n", "short_description": "Unleash your imagination in PatchWorld, where music, art and creativity come to life around you. Connect modular blocks to build instruments, games, machines and interactive worlds, then play, share and remix them with a growing community of creators.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28994771616830527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823930_1834692921011531_3027981081508684838_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcVoGGJ8m6UQ7kNvwFObICF&_nc_oc=AdrGzDABffCywVwUXB5GFawmimxUitZoAEDNow1Q-t8YWq5FjvO2HxqjxKCMefEzUCU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJYCgtNRogYCv_S7NYeHVwCXsO4I4rCP4ri2XHwBZgQw&oe=6AFC8A3F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PatchWorld", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Community", "id": "1228796255027646"}, {"topic_name": "Media", "id": "434961926215971"}], "release_date": 1657213195, "lastRevision": {"nodes": [{"id": "254634776013714", "relea
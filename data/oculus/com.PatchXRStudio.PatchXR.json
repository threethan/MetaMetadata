L46qs8VuEblfDnzaCP-f8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70P-Douoa2glwYkSYh3CMD0kFASzp5RucTvh-8KwzMjg&oe=6A1067F7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrfX7kQ7eBQQ7kNvwENzcpq&_nc_oc=Adq-DffRG8rpXzWYhYtdtK6YmaYJNEVl_GgyW8JEhPb2T3jV8CvP-GatZ3cdD0LIJ4M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KsGw-NXFnmrTd_CO0xvJZ0O_npIuCXWIAaIjDvhylsw&oe=6A104B3B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhjN82git0EQ7kNvwGlt7mG&_nc_oc=AdpdAfsHVVEGXa6fi65s1lSXDHZfS8Tvxg8CNlAjvo4hfe8x5auwcGb_gibtrPDJSLA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51IMO_zedrwRi_UPmaxNlOKDptcUJ72Ii7W7U5hfasDg&oe=6A107B45"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3DaF1B21OkQ7kNvwE7vfNf&_nc_oc=Adon0XP4CddOrpXcyU9i7tLnRxG6M67B1rf5GlK2ukFKx-rU5TJJO8DBUAOPrR7fqY4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i8XaHDTYFjL9qd0-CrUgeFUzvs-YPFne1-rxkcwcLpQ&oe=6A1063DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUVmnrarGhUQ7kNvwHL_nsC&_nc_oc=Ado2bgbtT7jL7_CSKsVR96PAiUTrVWv9RJqrgW1Sv_M5CVCCF4U2boV6gk1z3S1HE7c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S43RlnPgpdmFf99a-WZn-tmQ_9wb8-XgmWctIyYIhyQ&oe=6A107F7A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
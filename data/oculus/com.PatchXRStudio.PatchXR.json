oc=AdpVUtBFKMIhOptKmO_bDc9BsBMHYgJHz79xwMmtow4jwUNCuXYD90sd68V8_9du0FY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPoIfOlmKpNAM03x0oyf83Pnlgo1vHTl3fVUOflOEJSw&oe=6B0862DB"}, {"file_name": "Screenshot_2026-05-15_19-02-3411B90.png", "id": "1083557354495344", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823901_1083557357828677_1835066347702039362_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpnqJr549CsQ7kNvwFeQmsM&_nc_oc=AdomBVk8iIXb6wocMhzaLM4-Lta3EFAQXdymZAiyfC9QVHwORyXe0-EyWOZiWskP5KY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9BnOSwN1B0y4kqiwc8eXoOwK2ukgKJvYdOt7qc0_3BQ&oe=6B0845B6"}, {"file_name": "victor.png", "id": "2155535261653129", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296397_2155535264986462_387067025959720582_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUjsWv1L_NkQ7kNvwGxCXHq&_nc_oc=AdrEsJLO9ereeko1mTE5jOjntGlqneiJbk4pAo1s1up0iAUyTPZw0tdG7-hMpkVAzsQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI_Phthzy8SbcBu2_YLAEy3z38ie9H1WhvN7tqbJSNMA&oe=6B08576B"}, {"file_name": "greeting1- 2560x1440.png", "id": "1489325106069059", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310726_1489325109402392_1567108436259977901_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz353OXZrfkQ7kNvwEOn1wb&_nc_oc=AdpebFfY950guBLcmM4fdMFNItyLXqxqcABd8f9otYqLFtUQ2J3gJBrsgWF-0_jkyM0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoYcfy00jP5w3nrNxSg_BJ6pAr2VgGAttn0xHrtmZ5ng&oe=6B084EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portail Fractal Ne\u0301on Cosmique (1).png", "id": "2102757960365145", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/772632092_2102757963698478_3758480447795935119_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyXa4Hs6ELIQ7kNvwFYgIQ9&_nc_oc=AdpZ16I4XSb5-an6oMISkTTvga8TnfeJbFxBUF8Q9WifZYxViCu7UR0nEbIK-YDw3RA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtgVos0-ZmmDhtRacu9PQ9JVsgX_x-NGWBXYd7q5n0xA&oe=6B085840"}, "display_name": "PatchWorld", "keywords": ["multiplayer", "sandbox", "music", "creation", "social"], "long_description": "# Build, patch, play together in VR\n\n**PatchWorld** is a live spatial creative sandbox where music, art, logic, physics and play come together. Build anything from a simple toy or instrument to an interactive game, machine, audiovisual performance or entire world.\n\n{3397116597093755}\n\nInspired by modular synthesisers and visual programming, PatchWorld lets you connect more than **230 blocks** for sound, visuals, logic, physics, movement and interaction directly in 3D space. **Patching is programming made physical:** connect blocks, change what they do, and see the result instantly while everything keeps running.\n\n{1002927729192420}\n\nExplore **500+ devices** and more than **3,000 published community worlds**, open creations to understand how they work, remix them, or build your own from scratch.\n\n- **Create together:** build and play with others in multiplayer.\n- **Connect your setup:** MIDI, OSC, Ableton Link and WebBridge.\n- **PatchSound:** proprietary real-time spatial audio for instruments, immersive sound and live performance.\n- **Make it yours:** import sounds, images, 3D assets and custom avatars, with optional AI tools for generating content.\n\n{2042020730084560}\n\n**Build something. Patch it together. See what happens.**\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1307996881511110}\n\n", "short_description": "Unleash your imagination in PatchWorld, where music, art and creativity come to life around you. Connect modular blocks to build instruments, games, machines and interactive worlds, then play, share and remix them with a growing community of creators.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28994771616830527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823930_1834692921011531_3027981081508684838_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u361tpao7K0Q7kNvwFkuyqe&_nc_oc=Adry2hY7BNt2fh6TxrrenHrODe8pvhY0V7bv-bkIiUUPZAA7HBWrn4wV9Az5ZKG2GqA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfZ_8usSXU6NxefHV88L75fOvr94HEUK5T_dmfOTsWXA&oe=6B0867BF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PatchWorld", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Community", "id": "1228796255027646"}, {"topic_name": "Media", "id": "434961926215971"}], "release_date": 1657213195, "lastRevision": {"nodes": [{"id": "254634776013714", "relea
oc=Adqiln781pRu7jOqvY_0HHS8HuUu13fvWilvkrgl3T_qs1GjsPMomOZpsSV3hdSNc9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW9Cb1JP1lIgy2W4XlYRSEeVWwL_M1vfdg7yipZS5aphg&oe=6B104BDB"}, {"file_name": "Screenshot_2026-05-15_19-02-3411B90.png", "id": "1083557354495344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1083557357828677_1835066347702039362_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Awr8Oz-WFO0Q7kNvwFSi1zS&_nc_oc=AdrpgsP3dZ3v8K3xUithPYJHeTDUV8wfONC_SA8qY4cPrUQWiaogAMDo4EWzgKk0lbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvd9BJSq47S01w9ck90G-BUUUWPJOHh9w_DdZawSkmlw&oe=6B1066F6"}, {"file_name": "victor.png", "id": "2155535261653129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296397_2155535264986462_387067025959720582_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr8GhNKzzpwQ7kNvwEeqlhr&_nc_oc=AdoTxv8WQRQ4-iop0kum9AKKwuAUBRRA3_lCmihx6win_rPpkpVaZer_P1TCxnXyOCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNrQhPkYuCaU0k5PYd0fBGnR6_e6P6Q43XOPLQsJv_tw&oe=6B10406B"}, {"file_name": "greeting1- 2560x1440.png", "id": "1489325106069059", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310726_1489325109402392_1567108436259977901_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocvFwdpvOq4Q7kNvwFecW8J&_nc_oc=AdpILCpuoOXGB-q1XtFKyEZJtFpoZbIIXMM9uDuqHfug46bBS8xYzMuqhOusYyStkSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfiSvJSZERMgP6-SkqYF5d6fJPbtaRN0RzVArv-GrdGg&oe=6B1037AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portail Fractal Ne\u0301on Cosmique (1).png", "id": "2102757960365145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/772632092_2102757963698478_3758480447795935119_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86h7kqS7-RcQ7kNvwHQcnnu&_nc_oc=Adrf-NQvpdYGVJ3ysczKZkRoN6EIhvNaXqr2DznOfFxqHdmmLl2amqfQzxt9CnrJ1zc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPsVEAXOFU9Q3iWPXPWrjEj4pS18-JwkWkUhYmn4iqzw&oe=6B104140"}, "display_name": "PatchWorld", "keywords": ["multiplayer", "sandbox", "music", "creation", "social"], "long_description": "# Build, patch, play together in VR\n\n**PatchWorld** is a live spatial creative sandbox where music, art, logic, physics and play come together. Build anything from a simple toy or instrument to an interactive game, machine, audiovisual performance or entire world.\n\n{3397116597093755}\n\nInspired by modular synthesisers and visual programming, PatchWorld lets you connect more than **230 blocks** for sound, visuals, logic, physics, movement and interaction directly in 3D space. **Patching is programming made physical:** connect blocks, change what they do, and see the result instantly while everything keeps running.\n\n{1002927729192420}\n\nExplore **500+ devices** and more than **3,000 published community worlds**, open creations to understand how they work, remix them, or build your own from scratch.\n\n- **Create together:** build and play with others in multiplayer.\n- **Connect your setup:** MIDI, OSC, Ableton Link and WebBridge.\n- **PatchSound:** proprietary real-time spatial audio for instruments, immersive sound and live performance.\n- **Make it yours:** import sounds, images, 3D assets and custom avatars, with optional AI tools for generating content.\n\n{2042020730084560}\n\n**Build something. Patch it together. See what happens.**\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1307996881511110}\n\n", "short_description": "Unleash your imagination in PatchWorld, where music, art and creativity come to life around you. Connect modular blocks to build instruments, games, machines and interactive worlds, then play, share and remix them with a growing community of creators.\n"}]}, "developer_name": null, "developer_privacy_pol
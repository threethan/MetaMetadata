HfWE3sN7fxg&oe=6AEB40F7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZlavX7eK80Q7kNvwGq2k8l&_nc_oc=AdrwjevjzOwyQX8HBSHKk4MIcGmDadvaLa-ByjbKV78meAUAo5IKzmKGXuZaYARkgYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRri1Ll9GJBQff1vgsxkFqtMPVfSmV4xUYQrI5ILGKOvw&oe=6AEB5C7B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECwsmGvclawQ7kNvwHqOQvt&_nc_oc=AdqSDWmCjaiBK1kfu7z6nUfjjjjSp_Dp_X3f-DMCW5AdSKVikcpN5_taJAzsEKG3pCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLJ8sw1XqbwfyYQOMDdvRHb5kC-CL7jQsGXjwvLuHvXA&oe=6AEB5445"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYV7fUQZLQMQ7kNvwFPM0m7&_nc_oc=Ado-kMDfOdL3CqqyZjKbJHpoILletng49L9Nd_KQtg-2Sw7yceofjbaeIlVBgxuak98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFhvtR43YJyPTk7wt285Z0AvDzXiaxbl2u5IDqvJSXfg&oe=6AEB3CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pbBwVqdDKMQ7kNvwE7We95&_nc_oc=Ado3SZW0D9houEZE2zkQjjbCCArQNt3tiFuE69_-R3Gl-Tj_F5zZ_Z-E7kynIlngwm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmADiAIE1lCHpK8Zg61qJpD6jWrzWLExZ6U8An_BaLng&oe=6AEB587A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscriptio
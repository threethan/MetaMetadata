6J6uUWO7A_fYw2m_GKOSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PMuvY9TgmRKjj4eW6MRR3qJQZW5L9FGlu34ixktbrHA&oe=6A145C77"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZyMLHX_pfIQ7kNvwGt_88R&_nc_oc=Adr11NlumEpoyddPRmeE3Sed1KukD_0SZQwNq33NjP3NJJx9euJq3TajoguoFPHMcqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CpNleq4GgEONpVKX4DRew4o7th0A9ePf2RjWAU8W2XA&oe=6A143FBB"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQm1X_ouDasQ7kNvwELxmq-&_nc_oc=Ado2rSkhvnEVj0HGzPlls08mKZmjM3kcc1QcB5KsKuss3x-INEwAE499ecdokwYuedE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OKkZzgR4xmVZPSFp6kaJVXA9IlZ5H-ecicmpfwI6keQ&oe=6A146FC5"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riVEkBwHGBYQ7kNvwHo0fnv&_nc_oc=Adqh8p3hPj7-qSKLV_Dhy__MH1DIp9nMO5FOwSMltKqJ3bD912lrmUpcuYWvi-AduBU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w1evxaQVxp5sR-46TtCmAtq2jhXSTn_2WwCNxJJxikw&oe=6A14585C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlbt0yTJtP8Q7kNvwGgPjTf&_nc_oc=AdpDMgqbnzGraFROJmbRwDSY1KNOE6UwmQnEHGNHtEa2v_mdL8U_e2Jxu3Y9rJbR_14&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48B5NlM8QUCq6nepks2M66LdNE8xDetcUcwh0Q_aBp-w&oe=6A1473FA"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
aqMqcSmlKU6F5RQGeX0SHTQ&oe=6AF9C536"}, {"file_name": "victor.png", "id": "2155535261653129", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296397_2155535264986462_387067025959720582_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vo47ZRZQhM4Q7kNvwG8vPiQ&_nc_oc=AdqkZ_4-pMT3nTynSCR4AEGaNnnJs0GvS0pj0aRPnFj2aBM0JZO2vcDj8KnERva1WNo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpWIhDlXOPP3FTUof-lQ-PHPZThqPZSx-m6JDKxrC0bg&oe=6AF9D6EB"}, {"file_name": "greeting1- 2560x1440.png", "id": "1489325106069059", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310726_1489325109402392_1567108436259977901_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xpQujaV6KMQ7kNvwEaAPPn&_nc_oc=Ado71CIfiVoNVarzGL8bPahrvPxFLOeFdW4QMpBuzRKWq6DniCTnwF3-4UhlvzUkITU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH7wF0t4MJEAPE9AKNmUUVq1Lrb3SrHZ5W_OF47c-A8Q&oe=6AF9CE2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portail Fractal Ne\u0301on Cosmique (1).png", "id": "2102757960365145", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/772632092_2102757963698478_3758480447795935119_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3weBbXuf-7UQ7kNvwE4md0t&_nc_oc=AdrNxUBs81XRsH6_nck9i9pvnNYL1P2o0Scww2X8d2fcj2jQTW7JGg0dNLfKH9VW7pc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSuCcMEGlrLyB6gROWxiNQFk4W0dWZNc9z2i574oCTtQ&oe=6AF9D7C0"}, "display_name": "PatchWorld", "keywords": ["multiplayer", "sandbox", "music", "creation", "social"], "long_description": "# Build, patch, play together in VR\n\n**PatchWorld** is a live spatial creative sandbox where music, art, logic, physics and play come together. Build anything from a simple toy or instrument to an interactive game, machine, audiovisual performance or entire world.\n\n{3397116597093755}\n\nInspired by modular synthesisers and visual programming, PatchWorld lets you connect more than **230 blocks** for sound, visuals, logic, physics, movement and interaction directly in 3D space. **Patching is programming made physical:** connect blocks, change what they do, and see the result instantly while everything keeps running.\n\n{1002927729192420}\n\nExplore **500+ devices** and more than **3,000 published community worlds**, open creations to understand how they work, remix them, or build your own from scratch.\n\n- **Create together:** build and play with others in multiplayer.\n- **Connect your setup:** MIDI, OSC, Ableton Link and WebBridge.\n- **PatchSound:** proprietary real-time spatial audio for instruments, immersive sound and live performance.\n- **Make it yours:** import sounds, images, 3D assets and custom avatars, with optional AI tools for generating content.\n\n{2042020730084560}\n\n**Build something. Patch it together. See what happens.**\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1307996881511110}\n\n", "short_description": "Unleash your imagination in PatchWorld, where music, art and creativity come to life around you. Connect modular blocks to build instruments, games, machines and interactive worlds, then play, share and remix them with a growing community of creators.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
nVEO8qqt0oYAKmJTSw9mw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Tk9JJtVOKvaDtL_UPmbZ97w9h0eZ_F51FZpIJnXThSQ&oe=6A15ADF7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZyMLHX_pfIQ7kNvwGwTR0N&_nc_oc=AdqxWtQDu1hATkrIdiKUBNCHsHMbFG7Wu3M1NzPuhtHFEQodHExWqFovPG_kKCAS-sc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JbRj4wUpRMEnS6Uhf-x_1C0KqO9ZXMi9-w743V90BEA&oe=6A15913B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQm1X_ouDasQ7kNvwFnnr7b&_nc_oc=AdpJrsn1gTQytIuZHkXjFyqgpyyrpsixN7dNwczzHtdgD40ICI5UmnsLDl2qD7NzfPY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BADVStIvWHl1-kqDVcDGYZbOS13kcABbABLrfeyhmGQ&oe=6A15C145"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riVEkBwHGBYQ7kNvwGplXve&_nc_oc=Adrnco0RrcmZ-I7udI29rUbfnmpy_2LUUXR-pAfatD1fmwgAljPp9UTmqnxxGX_GG_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6STb8RAyBP6n3bdWLbuPCIF5Qa0cteCL0649URMnNEOw&oe=6A15A9DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlbt0yTJtP8Q7kNvwFrHMK_&_nc_oc=Adr4DTVK2FzmgKDOm1ozmd1Z8S-yTyjMGaP266YxAdFzH7CmHeO3UUFhg5HgC-7xMK0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Dk_KLw3sd1vHYAch3EgsKWuNgo2L9JRKDFAB4mN-qwA&oe=6A15C57A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
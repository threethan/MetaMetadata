72u3IO9BM8f2g6dWBqm9FA&oe=6AC277EB"}, {"file_name": "VIZ-Synth-2560x1440.png", "id": "982191734211744", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_982191737545077_4603251109892928218_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJmeiLiMPV8Q7kNvwGD28BQ&_nc_oc=AdotpfYHDZuT3ZBv7V_t_oclhRZSgq6-fKrFUWJjaYqLcqICTbdT61xvkKUYFVvsvbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqMmIJBd5lLSaxLqZIuAnXElAQ8mr3pXIQAE6R0NvR3A&oe=6AC2835B"}, {"file_name": "marketplace (1).png", "id": "1628096918242621", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1628096921575954_3064494538884712684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgL8DK-TzdoQ7kNvwFUNOVz&_nc_oc=Adqlt35fs-4bvFIVxYKfephc35jcCQTDA7VAa6xTqA-wcriqVc9ZanYaWMBo5V9IqFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzgoCQbDkF90yFy8lCYI4NSlrW7f2sU1CCKDiFz9pgJw&oe=6AC26EAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover2.png", "id": "2426350834495845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295566_2426350837829178_7535403630293344096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-P50C58FOMQ7kNvwFt-_Rw&_nc_oc=AdoEkCDdYdpxuvg94pYBm1pUgwyLdBfikjNOG2MnzeTM39Pj8l2QK4LZqDRDC-d8tSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPwqfM_QgfwV8-C1nACx7fHqMWa3UeF_EFyOxnzgPIeg&oe=6AC2662F"}, "display_name": "PatchWorld _ Make Music & Build Worlds", "keywords": ["multiplayer", "worldbuilding", "sandbox", "music", "creation"], "long_description": "# Play music, build worlds, and live experiences together in VR\n\nPatchWorld is a multiplayer audiovisual playground where creators make music, build interactive worlds, design instruments, create reactive visuals, and invent playful systems in VR _ no coding needed.\n\nExplore ready-made worlds, jam rooms, interactive stories, community creations, live events, and playful experiments, or invent something entirely new.\n\n**For curious and creative minds of all kinds:** VR creators, world builders, musicians, producers, visual artists, performers, educators, streamers, and explorers.\n\n{1307996881511110}\n\n\n# Hang out, build, jam & explore\n\nPlay and create with others in real time. Explore community worlds. Attend live events, workshops, jams and performances. Share your creations and remix what others have built.\n\n{978023558351926}\n\n\n# Customize everything \n\nImport custom VRM avatars, design reactive costumes, and create your own movement systems.\n\n{986666313829613}\n\n\n# Build your own systems _ no coding\n\nUse blocks to create:\n\n- Interactive worlds, games, and playful toys\n\n{949859271212091}\n\n- Musical instruments, synths, sequencers, and full music studios\n\n{1002927729192420}\n\n- Physics experiments and motion-based interactions\n\n{3397116597093755}\n\n- VJ tools and real-time audiovisual effects\n\n{2042020730084560}\n\n\n# Import or generate assets\n\nUse the web portal to bring your own sounds, images, 3D, or generate new assets in VR with AI tools.\n\n{4760471887541330}\n\n# Connect your setup\n\nGo further with recording tools, spatial audio, MIDI, OSC, Ableton Link, and connections to your real-world setup.\n\n{823700233685924}\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1017237010993975}\n", "short_description": "PatchWorld is a multiplayer audiovisual playground for VR where creators make music, build interactive worlds, design instruments, create reactive visuals, playful systems, and live experiences together _ no coding needed.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_catego
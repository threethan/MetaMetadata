wRGZT-QF9tw&oe=6AEC9277"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lp76pVsVeYwQ7kNvwGSAOlH&_nc_oc=AdrssiwLPlj5PDU6hZN9znQyQ7fzRepzZyHXGinTH4Hn3Bj74J4GudCCbje9-aC7uno&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj57zCAH5mEfLhATl3uL6x9SVaZ8AluxvplLToxzctlA&oe=6AECADFB"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6GJJYPRbzAQ7kNvwEmeguE&_nc_oc=Adrk8X5IO49DJUYvcTzaq7mAm4KNEE2r6k7uziJcSzkxnoYuN1AzvMgyEAE9_4C1rCM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM9fAiglS99Vi1Kk267H9z-YqNM2RGpQ973l7E0EJPfA&oe=6AECA5C5"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYV7fUQZLQMQ7kNvwGsAaVR&_nc_oc=AdpsE5q_QC2GIomHA9HXhcBjSjoE-iKlbpP_h5rutfhJw7Bwyoc9Dpu7Fm23nNZvGd8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgKG0gWWmkHirmxwdt1EMWxtxyU5uSdGj9YTIDR6liMA&oe=6AEC8E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x1u5xTcQO0Q7kNvwE_Q9i3&_nc_oc=AdqbQ75EB9VyxIx5lAhrNUOySDqW-PkWjqxxADeRK-ilfpXSl7mMHyvDcI1FPWvxs0A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKjBo7BPFoh4BL5GB75tSTmzACqIfB5jwPWOIljzb82A&oe=6AECA9FA"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscriptio
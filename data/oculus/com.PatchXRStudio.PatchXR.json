7WBTUiN-CmXFENdp1eW6iGw&oe=6AE35BB6"}, {"file_name": "victor.png", "id": "2155535261653129", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296397_2155535264986462_387067025959720582_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvrg0f18GkcQ7kNvwEItBxg&_nc_oc=AdobBO5eg1fQboHPcNoKi75My5oUOcDoDzOcSsfh21p43ClmoWJufnPW9qF1lDkcNbs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx_Cly80WrnLpiBnWsc-bu5q63XsBFXKElHUQkuCpReA&oe=6AE36D6B"}, {"file_name": "greeting1- 2560x1440.png", "id": "1489325106069059", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310726_1489325109402392_1567108436259977901_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twmv9hLzAkIQ7kNvwGIkZBP&_nc_oc=AdolFNJwUoTql6BE54shFtbwFlOzz7DJdb4Wi_FtnyjG_3WuC13G9Z7VveFXmGO_1Mg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg3oqb8vBCjm_7vIBDH5-25H6xQFqV-2OHuOCaz30INQ&oe=6AE364AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover2.png", "id": "2426350834495845", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499295566_2426350837829178_7535403630293344096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVaOC0i0P3IQ7kNvwFuZ1AQ&_nc_oc=Ado8yooyZ3Olqk35wKZ4dRUVBOyFBFQetCdgCr8p06-PfuQe7NB77WG89Hbb8yDozYk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLzw6QAo2EpiGUf8XYmFo3Q24M575nJBx9-ddXTsJZOQ&oe=6AE35BAF"}, "display_name": "PatchWorld", "keywords": ["multiplayer", "worldbuilding", "sandbox", "music", "creation"], "long_description": "# Build, patch, play together in VR\n\n**PatchWorld** is a live spatial creative sandbox where music, art, logic, physics and play come together. Build anything from a simple toy or instrument to an interactive game, machine, audiovisual performance or entire world.\n\n{3397116597093755}\n\nInspired by modular synthesisers and visual programming, PatchWorld lets you connect more than **230 blocks** for sound, visuals, logic, physics, movement and interaction directly in 3D space. **Patching is programming made physical:** connect blocks, change what they do, and see the result instantly while everything keeps running.\n\n{1002927729192420}\n\nExplore **500+ devices** and more than **3,000 published community worlds**, open creations to understand how they work, remix them, or build your own from scratch.\n\n- **Create together:** build and play with others in multiplayer.\n- **Connect your setup:** MIDI, OSC, Ableton Link and WebBridge.\n- **PatchSound:** proprietary real-time spatial audio for instruments, immersive sound and live performance.\n- **Make it yours:** import sounds, images, 3D assets and custom avatars, with optional AI tools for generating content.\n\n{2042020730084560}\n\n**Build something. Patch it together. See what happens.**\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1307996881511110}\n\n", "short_description": "Unleash your imagination in PatchWorld, where music, art and creativity come to life around you. Connect modular blocks to build instruments, games, machines and interactive worlds, then play, share and remix them with a growing community of creators.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
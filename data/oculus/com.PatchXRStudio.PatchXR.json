ID8q0NUTRYt91kYxZi2TQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D1frwMs81PpEUNlcaK8TSvf3NRX_XrtZKSk5nF5wANg&oe=6A0F1677"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrfX7kQ7eBQQ7kNvwHaG6nV&_nc_oc=AdqT7kUD-joYCMsE7d-BRGX6JuVpqumhfbsqxUQc135GQ9Fw2uGxFxxVEOuw7GzDVKw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wrjs8s40xcT_KWd4__1WMgeDiHDmFhlr445rSQQYkcg&oe=6A0EF9BB"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhjN82git0EQ7kNvwEhh6zE&_nc_oc=Adq1_HjxL630Lr2fQfrpDqnN8pl4asfqaB4uwbMuJ88lUnUXqn1WX9qKWsmm2uCxo5M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PCgzDS61zjRMZLv5sfUB94Wl4zm89_IZ5ZkNA1rPkEw&oe=6A0F29C5"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74YbOBHsK1oQ7kNvwH9ZK_H&_nc_oc=AdrVALQSuCVmlpU6ClrngSJIH7QHL6cMT2j9KaWj8NiC3MqyoRgcSqtxzSWTi8tvcC4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rBMWTDjwb521pJFyqzNRopE9BDOwnlBp696DnQ0CJdw&oe=6A0F125C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUVmnrarGhUQ7kNvwHtloIq&_nc_oc=AdonCbjvqyWCVSfUqK0p41nrySs_neWwOBVyOoVxfY6h7vr8esuiRvHjZVSEAAL2f88&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PYwT0vnO77jWxArYvCM1Pk_xK-I7KRzd1rQBcOuT-Ow&oe=6A0EF5BA"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
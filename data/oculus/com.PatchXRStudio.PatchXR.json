F7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVd6z1IEVQAQ7kNvwHXhsQL&_nc_oc=AdrUX4IZVC2PorySkQ695D4D7FES13X4fkk8ol_C-uzvUPsAaB8esR_SCnjF-tFk0Rw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEpVwFNmUdc_4q5tvMXF6hVfnx-H2eM_FnHYVvZX-xAw&oe=6AE33B3B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcvQYSxHfT8Q7kNvwE6ufKU&_nc_oc=Ado8j6B2bFCx4O_4wTDyhN39s6BDuBewWAgLOiWtm5xgw-W6LWJuOa4Crd9vtwT-LkM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNARnKSgATPphHO26jUHZP80IizDhN9EhKbiq-QxxQuw&oe=6AE36B45"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K3V-ZeqGeMQ7kNvwECQU1j&_nc_oc=AdqScnOyE_4fIq4qOOanMFbqSWSWjRJpUTc4nRRpCy-2iv6hHBThSRO4AU0YvSzWw84&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpnI75t6taPQVCbKlPD0USX45Apq1_AxZZBYx_-YmSSQ&oe=6AE353DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8Wz5OpeDmUQ7kNvwFXfxNU&_nc_oc=AdoGRchpAJaCd0ZfwzUbRZ7vI_F4Xa80PUavs7plV-pccLSWZeIU9aSSqUNDBQW6ifY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNGXI56yp2K7Ugi-z4jy99cHKY8clu0hnrhRPiMUb1GA&oe=6AE3373A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRE
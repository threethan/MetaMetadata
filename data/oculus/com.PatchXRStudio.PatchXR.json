4lr2tb6YhOurs52QZ0jTg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MS2cpXq_puBg-NT5taTx5Ml06iFqCtV3JxTNnlC-p0A&oe=6A130AF7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZyMLHX_pfIQ7kNvwEknFtS&_nc_oc=AdqmslEeV-I2wkHdUiZADY5DOtpFBy1rWlBNDIqmH0-993zIHjsgpZOyCKnLvN1Wy8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dqCN1Q-oBZU9E88Ak-_WEuP7S5D2TUzReJPrffailpg&oe=6A12EE3B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQm1X_ouDasQ7kNvwGFL6xq&_nc_oc=AdrRr2tLxyShLzv0DsHeX_VNeeE5Ij5WRR_09EgKEjO60iA28LHOv7X0Zk3mL2ZqBXY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dkDPxMF9E7lud73DfvgOB8YneQjAvk8DGMZrgIwUCmg&oe=6A131E45"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3DaF1B21OkQ7kNvwFrLAQy&_nc_oc=AdrvUZ5p6U-chOcZlmKmvnkehNosYzeF8H0mNyqUSrHsuu9SXyos4WIO9oRhUhvu8vY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ES7XSAO7ewTsxO-Sja6dJXQjyesoKantqDd6e2iN0zg&oe=6A1306DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlbt0yTJtP8Q7kNvwGe9JWR&_nc_oc=AdpQ2_35WNf2_93oGUFIZWKLb6bYWF9K3bjOrfZDZYL4u5kaTkPFFiMjnnejrQG0Ntg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PdEYaZVYIMJyP-wDdF9s6x0YB-6uvasA8L0gElGBMTg&oe=6A12EA3A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
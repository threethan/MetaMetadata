77"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPD4W-2QksUQ7kNvwHsea96&_nc_oc=Adq9yh1_Exh9Bx4-Y3ZO3E1c5wfMyLNM6di80dOsdqYHnrse6ugNFJApnDE0LRikJ-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFBrW2G86bjgOa_2M6jZwVSsqkq6m-drzm8KsYNsOSIg&oe=6AE767FB"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eOxN2gHjT0Q7kNvwH2SkjM&_nc_oc=AdoUmb9xH5BdTT6DfYwXoiTQkf1M15rKOqNcDM5hUnkbDxUkrDbViq5Krcqly3D2rXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSKBV96L1HcQbsnOinRqAqmB4CDNfExgHwoMImAnczTg&oe=6AE75FC5"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WX69Mr8VEQQ7kNvwHGmvpu&_nc_oc=Adp3jlRk-f_4S4c8hEExynAyfJf9WvFVCr36Hf1UB1a7oZUmQ7ay7ZQmSUsPh66Q5wQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUaTGO2Yc8Kn58BIXshkg2Oaes4-jJ5OUzk81TdAy9jg&oe=6AE7485C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGmR2c7pYJEQ7kNvwH3mg8z&_nc_oc=Adqy-Mhqreth7Nb3W3WAVG-NThR3GUJ4aP8m8QDbkCsWY8Pg3Xlv_EKoxV0ADPq-w04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7YMr-sE8naIVH-6hPGzSWNj8Tcril7Q3QJRfZOuLmXg&oe=6AE763FA"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRE
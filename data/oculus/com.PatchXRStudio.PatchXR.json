Y5toenSEYhCXrgyXO2tb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a_mqm1gjTUAm9Ql0Ox5DdFNhvTCxi7ooeDQe3r3tfHg&oe=6A19A277"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-D4BIjsBEIQ7kNvwELHF39&_nc_oc=Ado1b9xsbpbnxt0iEFVoOCbfFaLDVlVkaFPo6UDTRYcx5FyeJ_zpYD2ZtUCGPuIyFTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70Sg7_wqczH_p7o8YV6dik6zce_nyg6CroEWAvwVKw4g&oe=6A19BDFB"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brcgJi1r4_oQ7kNvwFdakbS&_nc_oc=AdoiDFtW_s6cphhPvihvgnPhymsCmS83zvh5530QV4MXQlQI8903OneZYcQI4G7qTYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55WflBiXhCgYkXfTJVcLwE07MkzDvluwvRSUUyt5X5-A&oe=6A19B5C5"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRTNOzyzK5wQ7kNvwHil-O8&_nc_oc=Adr5nfuuRL7BaYQq0E61YXabGbXn3HkdElcM5vgsJBMV8Ur78ckmFCsDqVc7J1xD5PQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IonyacQk0xny_Zqg99RKX90jvFsL2sYafghtlsloSUw&oe=6A199E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa0uYDS_1bQQ7kNvwGVyD8M&_nc_oc=AdqMwuoKrgT-KmbroJVx3UR0VQ6zmCssHd7sVMk_V_g0eaogP2uLOyYTyitV3k3DDhU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z8JOL1cyufe6ZE46tYW5GJ4_MZ90nvDYk4muEkcY4Vw&oe=6A19B9FA"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
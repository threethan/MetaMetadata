lygCBPCtddjBZ8IMQSxyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xP38VuFdlgH12V___bnTrvOcsalFsPhxG1fEWEjFnwA&oe=6A0DC4F7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4psWFYwq2cQ7kNvwHm5Otp&_nc_oc=AdraOxuhwsw4Y95kUxLTJKf7cLGwttaAAhbnLRB8OeUgGK6zkDgpr5MPVGrUWcpxcD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QAEmx2UZcoj1veASlHs0oEhDaxxKHx5yCWwMofajxaQ&oe=6A0DA83B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0mYkRMUIDsQ7kNvwEtWjfi&_nc_oc=AdqG9XsUh8ZDLcHqHAYAkV6BWZtqItXmEeNDYpQ38h-lMJctHjJ-LRve5jBdh-OimLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b5HPvB7HrZ5srSW7eUUVIUPR5BvTxtOuvBd4BdIkaPg&oe=6A0DA005"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74YbOBHsK1oQ7kNvwFK-eUW&_nc_oc=Adp4DvXBGnsBOqINTyUTFCgYRSFnaV2DpNE_SLutj8HGpq-P2SOPyWmVrO8LKBdpL7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oX0yHvJkZruPetVI226WdRZhuUBBM4TLN1oDGJCIQ0A&oe=6A0DC0DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neirrefTdo4Q7kNvwHaNfnX&_nc_oc=AdqnKF6wigfnicJLBDXvVBANbBUEGEb_zFyHFX1gojQ__zUZF1slM7ebuN8sTyrcUBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RVyfQ3zI6egOvDanWgTa0rZpFqJV-RGYEBF4ZeC53sg&oe=6A0DA43A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
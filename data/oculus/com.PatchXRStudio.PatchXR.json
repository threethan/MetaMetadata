YQEuR7oC5m7-2d_1FQ&oe=6A09B3BB"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZCWsk790rMQ7kNvwHth32M&_nc_oc=AdqIT2Mlln43sYplt4dTiXNx-k6J1D_TUD-aj7hTmrcq5nHy9svt1NeRkOjOkUTp9q8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pgxVi7UphLLlT1jGzZdHdo5-oY0wSGauR8B7xa1xbrA&oe=6A09E3C5"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD8yP3-o2BgQ7kNvwFc9Xh_&_nc_oc=AdrQnhk_5bTduLjEk4PI7RcbkfW5l9L8vADAOios5wRBCETruuHSwIWH42jf5TzoLFA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fpSIaOnQfdXYVjgpqC3ohM_WU8NHxp8P1CwtLIXOWRw&oe=6A09CC5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM5qCkvVNgcQ7kNvwGa7r0D&_nc_oc=AdpPe6fIgR1vVOI1VmE37Wk3rJYO-TKSO4TQZN0IP0POfYFu3twkCiO5Xa3sp2wDdk8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49QIrhOfeD3zAmR6GHahT2ktpeeDCwXGnscQfXX-p6yg&oe=6A09AFBA"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mo
=wEQGmszmF98Q7kNvwHbh-R1&_nc_oc=AdoMD0qV7p9EEbBhML8gnInoX06hQU6vJcMCFq4yuEUFwFHghS_7qUKPgXmPtVTgL_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qkh-yS2s966mz4S0JO-HiJglyY1zT8YCeTUjZrFv2iQ&oe=69D3BDFF"}, {"file_name": "Screenshot 2025-09-02 at 16.38.png", "id": "3388022974694722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830027_3388022978028055_6309581884076577923_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmUMJjONK2IQ7kNvwEedRB2&_nc_oc=AdpfaoEO1Ym9giO5ncKaGMIXHmJIEZ22l5Mg4hrQLQAhD70wSo6MwB6m9cODceTgcWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Blsc15j51NB_a28gFQ9PstZKGnXPKfvB8KL-MMmjxtg&oe=69D39497"}, {"file_name": "CAR.png", "id": "3886170458352144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_3886170465018810_5533212037074570059_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhtME9WP4Q0Q7kNvwF3dgGZ&_nc_oc=AdrVbCKaGcre_d_XXc0g1NeVGirnMBRAbhDWSvsn295ZXC-qFDT1FTLu7rZ8fhOPH4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yDz0mDFleEtk0cwb5rpmsOeGiUsMqsvkUktKeLH4FTg&oe=69D3C092"}, {"file_name": "todd.png", "id": "3017525528451071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_3017525531784404_5602762193215856646_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rbub_1BW4XsQ7kNvwF3CYbc&_nc_oc=AdpcmeBCDLSkfo5ez44urBtHrYO9t0bO8UVr1FtjdR0BCuPlK7JMhFk6b0hQZd4_bHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Gup1hx3LpfpN1wGkyoD3COrrfOrIj5MjYpG57B6xtZg&oe=69D3B610"}, {"file_name": "marketplace.png", "id": "1168646608427067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820518_1168646611760400_3869328457775431132_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PluTDVS-0HkQ7kNvwG_rL6d&_nc_oc=AdrRuCdUodO47LgDdaNOBo2lxZNVGgVvyM9aMC8iCalp8t07ggN2HjhvBYjv3ceiy8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02wDJ5B0_bldUvG_bD83wsat3qFTQO0DctWQkOLdzE3A&oe=69D39601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shroom and gady.png", "id": "1392512262674820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820428_1392512266008153_7454136038789908767_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYGKShWYXpwQ7kNvwFOcy7O&_nc_oc=AdryAe3_pkwJFfEGhw2tXSeGl6wVk7OE_bN3dKVjkpA3W0ghCdt-yAMRHGu4sx73jRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n4zNbY4NMGPu9-ZRcsMcnf5AQuQV7WnJ2uQLPrOG94g&oe=69D3B030"}, "display_name": "PatchWorld \u2014 Build Worlds, Music & Games", "keywords": ["create", "music", "multiplayer", "worlds", "vrchat"], "long_description": "# Explore, play, and build anything together in VR\n\nPatchWorld is a social creative playground where you can play music, make art, build worlds, games, and interactive experiences directly inside VR.\n\nJam with friends, go on adventures through community creations, attend live events, or invent something entirely new.\n\n**For curious and creative minds of all kinds:** musicians, visual artists, performers, educators, and explorers.\n\n{984292874778502}\n\n# Hang out, jam & explore\n\n- Play and create with others in real-time  \n- Explore worlds made by the community  \n- Attend live events and performances  \n- Share your creations and remix others  \n\nEvery world is different, and there\u2019s always something new to discover.\n\n{917531967734838}\n\n\n# Customize everything \u2014 even how you move and who you are\n\nCreate your own movement systems, or transform your identity with custom avatars, VRM imports, and costumes that react to music\n\n{1497289391735631}\n\n\n# Build anything \u2014 no coding needed\n\nUse blocks to create:\n\n- Musical instruments and full music studios  \n\n{2097295474390389}\n\n- Interactive worlds, games, and playful systems  \n\n{26166331803059402}\n\n- Physics experiments\n\n{797445486753516}\n\n- VJ & real-time audiovisual effects  \n\n{1848605185856342}\n\nEverything is built live in VR, and everything can be played, modified, and remixed.\n\n\n# Go further\n\nBring your ideas to life with AI-generated assets, recording tools, and connections to your real-world creative setup.\n\n**Connect & Support** with our incredible community of Patchers on Discord, check out our Wiki, or explore the app content on our web portal at patchxr.com\n\nJoin the most inclusive and creative community in VR !\n\n{1206168244660216}\n", "short_description": "A social playground for playing and creating music, worlds, and games in VR.\nBuild together in VR by connecting hundreds of blocks, devices and assets  \u2014 no coding needed. Create interactive worlds, physics toys, and audiovisual interactive experiences .\nHang out, jam with friends, explore community creations, attend live events, & workshops and turn any ideas into something you can play, remix, and share.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26363512756623106"}, "review_messages": []}]}
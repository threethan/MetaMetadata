oc=Adr23rr-lA83hpSj_bug5vC10QVWSHlzvKN_e6cRGN6Yqx9NPxzh8mrDG1F2cGZv_r0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUk3IvSUEatjENBJKfe02qNOo22CRPtaGAbu2_NnUerNg&oe=6B0EFA5B"}, {"file_name": "Screenshot_2026-05-15_19-02-3411B90.png", "id": "1083557354495344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1083557357828677_1835066347702039362_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Awr8Oz-WFO0Q7kNvwFkIUVu&_nc_oc=AdoJoDg4WNJTIaLVGYk8eGM3KFApAMjdp4Y21fAdgkwYgcrWzHPsJ8iGBUNHFIpzZ6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5g_71EAhKKp1wT_kXuFcJO05lAn23vROSJnEx0h87PA&oe=6B0F1576"}, {"file_name": "victor.png", "id": "2155535261653129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296397_2155535264986462_387067025959720582_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr8GhNKzzpwQ7kNvwHQ7FEp&_nc_oc=AdoxXqr97qiNpYM4ahRH8yZ9u6-NLNjaSrNX6ILCwAzYkTWnj0OP3aaCHobEyVAd6p4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjMPZCzBvqu9UBQYEFadqgjAx_Xdz1xdrUZUdo1w-9iQ&oe=6B0EEEEB"}, {"file_name": "greeting1- 2560x1440.png", "id": "1489325106069059", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310726_1489325109402392_1567108436259977901_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X3CTB-_TssQ7kNvwEKtcKS&_nc_oc=Adq-G_V1d0va5QpkVLo3Gn8ZZKbIRJpocTupqDODE168VevZg8s-fhImqzSQdFnzGxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVV482RLQ55PVDHTRwzRU40Z7g67X27RE9b_P9Jq9yO3g&oe=6B0F1E6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portail Fractal Ne\u0301on Cosmique (1).png", "id": "2102757960365145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/772632092_2102757963698478_3758480447795935119_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOJKdmhCHD8Q7kNvwGNlvkT&_nc_oc=AdrOh5SI1pA5K7QUT0EK2Hlh1CqjbD6L2xjlJJKOd9J6Kj9YvNF5BdWj21lQWKr-icg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXY_eQgtjDY1thXhYZcVGY4dt3XdN0V_McopzYaQwEEQ&oe=6B0EEFC0"}, "display_name": "PatchWorld", "keywords": ["multiplayer", "sandbox", "music", "creation", "social"], "long_description": "# Build, patch, play together in VR\n\n**PatchWorld** is a live spatial creative sandbox where music, art, logic, physics and play come together. Build anything from a simple toy or instrument to an interactive game, machine, audiovisual performance or entire world.\n\n{3397116597093755}\n\nInspired by modular synthesisers and visual programming, PatchWorld lets you connect more than **230 blocks** for sound, visuals, logic, physics, movement and interaction directly in 3D space. **Patching is programming made physical:** connect blocks, change what they do, and see the result instantly while everything keeps running.\n\n{1002927729192420}\n\nExplore **500+ devices** and more than **3,000 published community worlds**, open creations to understand how they work, remix them, or build your own from scratch.\n\n- **Create together:** build and play with others in multiplayer.\n- **Connect your setup:** MIDI, OSC, Ableton Link and WebBridge.\n- **PatchSound:** proprietary real-time spatial audio for instruments, immersive sound and live performance.\n- **Make it yours:** import sounds, images, 3D assets and custom avatars, with optional AI tools for generating content.\n\n{2042020730084560}\n\n**Build something. Patch it together. See what happens.**\n\nJoin our Discord for community support, and learn through our Wiki and workshops.\n\n{1307996881511110}\n\n", "short_description": "Unleash your imagination in PatchWorld, where music, art and creativity come to life around you. Connect modular blocks to build instruments, games, machines and interactive worlds, then play, share and remix them with a growing community of creators.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.io/en/privacy-policy", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28994771616830527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1834692921011531_3027981081508684838_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iec-YXUVvHcQ7kNvwE8oXf_&_nc_oc=AdpmoFeUuvcXhvT2638e4bo-Y3qCwuguwPIiD3xNNbMf_2ExQ1fkx_BNdeqxWWWlj-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1eRG8hyT2Q6226vFCnbmCS3vEy3JraSBj-_NaGw-uAg&oe=6B0EFF3F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PatchWorld", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Community", "id": "1228796255027646"}, {"topic_name": "Media", "id": "434961926215971"}], "release_date": 1657213195, "lastRevision": {"nodes": [{"id": "254634776013714", "relea
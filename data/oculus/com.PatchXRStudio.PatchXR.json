wE70kr4VwPOAXTE5OPUBw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RGMYHkJrODDx8H7wy8kupPKPKezBXdyif-MkHBPBMUw&oe=6A0C7377"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4psWFYwq2cQ7kNvwF1Cjl5&_nc_oc=Adpw_gQt_H3mOUEvOhkeJdjLMzem7-Msxp7t217N55ZMNrkjYG222twvCkvhZbEubK0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55P5esMrwD6ScD96L4QhTcHwaoYhwkeTYZ8Bi-UpjhYA&oe=6A0C56BB"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0mYkRMUIDsQ7kNvwHx_9Hw&_nc_oc=AdrO5YKlKS6zPPU3ZRM2SNp8rhXPiw3tSLnPkOe6M4C96FjKJ9uvre8DRyGk5DOLsPQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-ZqQ-V1Rv0Y29mk5XZXie6zKxLmEj1_HXv2Jo3go-ig&oe=6A0C86C5"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74YbOBHsK1oQ7kNvwE0Ch97&_nc_oc=AdrXgAyqhBtOaW6xviBdUNBKg-7T0owY-FkfN4qWKq-Ks3Gt7uLx-qSF8_VpGdTy6O0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48OSXNY4yTaPxxm2yDZq5QnAsSoWX8mvLpS05bML-aHA&oe=6A0C6F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neirrefTdo4Q7kNvwHSloJu&_nc_oc=Ado_JT1z232XXlA3zj_aJZUTmXO_NWiaM87liOcqdL6Xo2b1LqW1Z5JvBeth2fsiwXk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hgmEjVUWXac_dHW5zk0fniSMRjMwukOCO4c6fE336CA&oe=6A0C52BA"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id
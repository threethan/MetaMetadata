F7"}, {"file_name": "Rainmaker.png", "id": "406285344740675", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031453_406285348074008_876362344507952341_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZlavX7eK80Q7kNvwFilknb&_nc_oc=AdqOsVZuNb4dTsoccIDpeU44hH04lLxNizUw-y4_Kvrt_GDxrgVlvult89phx0U2mz0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf5H_t5JlMRIENuhu384_1xLlDX9pEEkrRsPSdVpLD8g&oe=6AE8B97B"}, {"file_name": "Frame 7.png", "id": "345864101013118", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982552_345864104346451_3235740934879403403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECwsmGvclawQ7kNvwGLAtob&_nc_oc=AdoYnveTMseqgP1VIwTu763I0mokJutpSXDj1TALBSMhnrx7iTjgqdgwxxO_nEvXAWw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUrtB5DSaSyIJ67to9-Y9dWcUr7UGUMcjWopDgO_H8OA&oe=6AE8B145"}, {"file_name": "Frame 6.png", "id": "716253483129159", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982449_716253486462492_1631874179459413443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WX69Mr8VEQQ7kNvwE-K7NI&_nc_oc=Ado4JjlbVqqtLCrQFDIONv5k_uk2IVx-s-ToPfFUtS9gMucmPLIjEaDkkWnNqU7CFrk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH3PDnVbIAc-1IAmD5s_F856JhJVm8UeEE0SeUnNF_lA&oe=6AE899DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 5.png", "id": "494940995740872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982466_494940999074205_2689054535717780810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pbBwVqdDKMQ7kNvwGceBA4&_nc_oc=Adp63rdBTBbxVqtub5QR4V-pX8J1H8zWteV4jigD40zUm-LWmUaJrnoJbTDsJy1BGDk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTi5WAZz6Cd0MGq_q8z3u6jmYN_HnOs_Vx_CmvnJcthg&oe=6AE8B57A"}, "display_name": "PatchWorld", "keywords": ["create", "music", "DJ", "sandbox", "world"], "long_description": "Unleash your creativity in the marvellous musicverse of PatchWorld! Explore an ever-expanding library of tools, toys, and wild instruments you can use to make your own music in VR. Join an underwater reggae jam, blast some hard techno beats, or make polyrhythms out of rainfall. Build your own reactive stage and musical inventions \u2013 fully immersed, natively on your headset!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing, for musicverse music videos and shows.\n\nSHARE your creations with the world in a series of updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends.\n\n*Join our Discord channel to access our community and register for the PatchMaker beta for early access to even more powerful creative feature*", "short_description": "Unleash your creativity in the marvelous musicverse of PatchWorld!\n\nEXPLORE a growing number of experiences, shows, virtual studios, and instruments created by artists around the globe.\n\nCREATE your own musical worlds and instruments, design your avatar, and record yourself performing shows.\n\nSHARE creations with the world with updates coming soon. Publish your works to PatchWorld and in the coming months, multiplayer support will allow you to explore, build, and jam in real-time with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coda.io/@patch-world-build-guide/patchxr-wiki/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR", "support_website_url": null, "website_url": "https://www.patchxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRE
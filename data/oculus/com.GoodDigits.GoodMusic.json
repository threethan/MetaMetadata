lliseconds after it is read and the app does not not store, transmit or reproduce ambient audio information to deliver this experience.\n\n", "short_description": "Enjoy your favourite music whilst exploring a breath-taking universe of colour and sound. Discover new life forms that use the energy from your music to grow, multiply, move around and thrive. Take photos of the artificial wildlife you discover amongst the mesmerising vistas, and share with friends."}]}, "developer_name": "Good Digits", "developer_privacy_policy_url": "https://www.gooddigits.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Good Digits", "support_website_url": null, "website_url": "http://www.gooddigits.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "532258331612500"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6301850869919765", "version": "12"}, "id": "307908491248126", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "45341010
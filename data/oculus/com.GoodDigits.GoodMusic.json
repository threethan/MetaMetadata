4.png", "id": "1008941246401893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974738_1008941249735226_2777506174101137342_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TW99sRCSC8Q7kNvwGPQ6EN&_nc_oc=Admq2joOmN-ogj2_57DILjunpQH_1ZmCK98bO-3QfukeTLtUBwpVZrmbbf12MSdDthk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbcuA7iJ7VG2p_kwpHlFCpfTbPuTeJPi6Jxoqwx5u9Ew&oe=69B56121"}, {"file_name": "Photo5.png", "id": "1311981289289141", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_1311981292622474_1658139110581680933_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_1rlIrGeYsQ7kNvwHDAoKZ&_nc_oc=Adnm5gcPuJVy0bGESrQzMhs0_8ccdppP0i-pL0H33Tg-ZCAQODM63ryVz-y8yTFGwQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjM3cxDv6OA2anICD6cjhFZj6vvLhAK-I1HbEhgRZ90Q&oe=69B53B8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "2457356644405354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295751_2457356647738687_1041278583473976247_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvGUs_rW4l0Q7kNvwE4frOm&_nc_oc=Admwm6-N4FexpOEvM7uHpBhr5XUuT9o0NR6Q26qxcEigkBqPAyzJrj6GVUwZKnJZgmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGrdrCJHN0zNBm1nw78yxGUAKG0jLdVlnFWGNmN_BTVQ&oe=69B55C0B"}, "display_name": "Good Music", "keywords": [], "long_description": "Good Music allows you to bring your real world music listening experience into VR whilst enjoying colourful visualisations. The experience transports you to a magical universe where you can discover new life forms that use the energy from your music to grow, multiply, move around and thrive. You can take photos of the artificial wildlife you discover amongst the mesmerising vistas, and share with friends.\n\nRecording Audio.\nThe app requires permission to record ambient audio in order to function. For your privacy and peace of mind, this ambient sound information is immediately discarded milliseconds after it is read and the app does not not store, transmit or reproduce ambient audio information to deliver this experience.\n\n", "short_description": "Enjoy your favourite music whilst exploring a breath-taking universe of colour and sound. Discover new life forms that use the energy from your music to grow, multiply, move around and thrive. Take photos of the artificial wildlife you discover amongst the mesmerising vistas, and share with friends."}]}, "developer_name": "Good Digits", "developer_privacy_policy_url": "https://www.gooddigits.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Good Digits", "support_website_url": null, "website_url": "http://www.gooddigits.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "532258331612500"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6301850869919765", "version": "12"}, "id": "307908491248126", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "45341010
dn.com/v/t64.5771-25/473393438_612331504879498_2015925640496287793_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ1mIrI8He8Q7kNvwFg683e&_nc_oc=AdkShBdpx4hFUZASC_G4rY47IGEMZ8xPe65FlsgIm22xwCcqgbJKoPUFK-6Np2nHXrY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhGl7UT2rdF8-sEwfkt49Zd7_BmSu7f5go-dbAbK-WXQ&oe=69BD2D8D"}, {"file_name": "Altmans Nightmare Screenshot4 (1).png", "id": "616806034388641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393883_616806037721974_5946023347108831672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KZJSOLkJrsQ7kNvwGOUrHi&_nc_oc=AdmCorzI196h2Ju29gABJv4Z-XT8zcjwGXj78Kl-J3z0xRXiGKsertkQluUnJMX4-Fg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1wZbr68B-8t6n9q4H0BDKQmAmLlHgNJ4i69m00oF5YA&oe=69BD4A2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Altman's Nightmare", "keywords": ["shooting", "ai", "deepseek", "openai", "hunt"], "long_description": "Embark on an action-packed VR journey that challenges your sharpshooting skills! In this exciting game, you'll enter space world filled with AI whales. Use your precision and timing to shoot whales and earn points, each one bringing you closer to beating the high score. This arcade-style game is perfect for anyone seeking a thrilling VR experience. Are you ready to take on the space whales and prove you're the ultimate high-score champion? Jump in and start the hunt today!", "short_description": "Dive into a thrilling VR adventure where you hunt whales and rack up points! Test your aim, compete for the high score, and immerse yourself in this fast-paced arcade experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jesseturner21/AltmansNightmarePrivacyPolicy/blob/main/privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Turner Labs", "support_website_url": null, "website_url": "https://jesseturner21.github.io/jesses-website/", "category": null, "comfort_ra
dn.com/v/t64.5771-25/473393438_612331504879498_2015925640496287793_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ1mIrI8He8Q7kNvwEQDOPW&_nc_oc=AdmnRu7cEb_Jv7ZV9y54_MR4Doa91VTVZqhRP1He5qfvDw1TT_o4S9nbQJIHZC7hTHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzPpRexdeHBONdTAcsaCtIKNz_4gGwyqQQFblQh-wkcg&oe=69BE7F0D"}, {"file_name": "Altmans Nightmare Screenshot4 (1).png", "id": "616806034388641", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393883_616806037721974_5946023347108831672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KZJSOLkJrsQ7kNvwFlDn8M&_nc_oc=Admb6RH0cG5jBAKdFXEJlPhSrI-S9-LUIWjpUwLWjPtKol2ex1RIFq1x9Hq653l8TLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxPJK60G1L53fuvH39olcwNOb2ScUaFEGplAni0zSG8g&oe=69BE9BAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Altman's Nightmare", "keywords": ["shooting", "ai", "deepseek", "openai", "hunt"], "long_description": "Embark on an action-packed VR journey that challenges your sharpshooting skills! In this exciting game, you'll enter space world filled with AI whales. Use your precision and timing to shoot whales and earn points, each one bringing you closer to beating the high score. This arcade-style game is perfect for anyone seeking a thrilling VR experience. Are you ready to take on the space whales and prove you're the ultimate high-score champion? Jump in and start the hunt today!", "short_description": "Dive into a thrilling VR adventure where you hunt whales and rack up points! Test your aim, compete for the high score, and immerse yourself in this fast-paced arcade experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jesseturner21/AltmansNightmarePrivacyPolicy/blob/main/privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Turner Labs", "support_website_url": null, "website_url": "https://jesseturner21.github.io/jesses-website/", "category": null, "comfort_ra
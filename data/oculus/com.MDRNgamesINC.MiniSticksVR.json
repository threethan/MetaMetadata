tent-dfw5-1.oculuscdn.com/v/t64.5771-25/499324977_1015484587432348_7770854731856334850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwFTH25VIhcQ7kNvwFlWhsJ&_nc_oc=AdkCUlNEd-C2yzHlLTMfzpK6vyYpPh7iciaCaXMj_AEKtstZrUO_ysATxcvQ3jBGpKk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-hCGQTQ6O93d_Yu0BVRihTY3KbeMG2RPxQKP6OwP4zQ&oe=69BD2BAA"}, {"file_name": "HockeyPlus_screen2.png", "id": "1406914713671052", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499324020_1406914717004385_3823381453500263682_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gLvHCLj_mkQ7kNvwH_y2cV&_nc_oc=AdmBlSWL2PWX284OTbi1jAJlLgrsUSg7D6QeqYi8w-bixbqHOoPy8EZ1iS-o-gjqKXo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy939moSREbFQ3_uYT0ReuFWMxoGFBfFDqTGJS0PIv96g&oe=69BD3B45"}, {"file_name": "HockeyPlus_screen5.png", "id": "597242726104551", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499323988_597242729437884_7399925015855898168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9h7MwFIvyYQ7kNvwHSQ1Og&_nc_oc=Adly4UdghGaRl33OvdKYKp6BGOoJqHVpODElqlv0gX5kUrfvM1p3wIAiRnyahh-g80k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBCW3ukuHrdjd3HaDhsGK-wn72GPvs_Wr3gBe9NGxhEQ&oe=69BD4C46"}, {"file_name": "HockeyPlus_screen3.png", "id": "672134852403195", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499316558_672134855736528_2140597336045423819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_Xuv8C4b5sQ7kNvwE-3ubU&_nc_oc=AdljK82TKKJXy4Y6UXXOJInDAU9ydSd83YFMI3C6VC6VRPeqHODJqBijlmJzAlOi4hM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4XlYBIb3dvNsYsRjre68uZVsumtL3x-K0Tkf0zsXsjQ&oe=69BD5F38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hockey+ VR", "keywords": ["hockey", "sports", "simulation", "multiplayer", "olympics"], "long_description": "**NEW UPDATE**\n\nGet ready to lace up in style\u2014your new Hockey+ mansion just dropped!\nThis update brings a cozy, nostalgic twist to your mini hockey mayhem:\n\n\ud83d\udd25 New Mansion Environment\n\nBasement Rink: Underground games hit differently.\n\nDeck Hockey: Bring the battle outdoors!\n\nGarage Nets: Two nets right out front\u2014perfect for those classic driveway shootouts.\n\nChalet Vibes: A warm, wood-trimmed cabin feel where hockey never sleeps.\n\n\ud83c\udfdf\ufe0f Still Includes 3 Full-Size Arenas\nCompete solo or with friends in both competitive and casual modes, now with more variety than ever.\n\nWhether you're ripping shots in the basement or recreating that golden-hour slapshot on the deck, this is the ultimate Canadian hockey dream.\n\nHockey+ VR is the biggest online hockey experience in the world\u2014no joke, eh? Whether you're hitting the ice for intense 99-player lobbies or kicking back with friends in one of our many arenas, this game has everything a hockey fan could dream of and more.\n\nAnd it doesn't stop there. Hockey+ VR immerses you in the vibe with live video feeds from Toronto, festive Christmas webcams, and a real-time hockey news feed to keep you in the loop. This isn\u2019t just a game\u2014it\u2019s a celebration of hockey culture.\n\nWhether you\u2019re skating, passing, scoring, or just chilling with friends, Hockey+ VR is your ultimate hockey destination. Grab your stick, hit the ice, and give 'er, eh! It\u2019s as Canadian as it gets.", "short_description": "Hockey+ VR is the ultimate online hockey experience! Play in massive 99-player lobbies across 2 rinks, 4 ministicks arenas, air hockey, chess, and more. Featuring live Toronto feeds, hockey news, and endless fun. Grab your stick and give 'er, eh!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332603592
tent-ams2-1.oculuscdn.com/v/t64.5771-25/499324977_1015484587432348_7770854731856334850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WPvh3-wlVIQ7kNvwGmb3Zg&_nc_oc=AdnXSCy7GCPYNZzIWWDG6HoVa2VOvOksYPKkkZB-rPeZItsEuiMteyzcjFY_HYUl3Lg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_isFuBad9sh4lP4QCc-JhNE7jbWv1B8m3bsuHfw334g&oe=69AD59AA"}, {"file_name": "HockeyPlus_screen2.png", "id": "1406914713671052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499324020_1406914717004385_3823381453500263682_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OLn03ul5EcQ7kNvwESvkIE&_nc_oc=AdmgoWK_H2Yh_L7V3mrckM4XBJbnJRz2kAJxerEEImt5DouNJN_-EKi3Wn-Q5xpK_jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3b-SYvrRG_1eIl7wntLTPzEA1wX00pTKn99QnyLo0TQ&oe=69AD6945"}, {"file_name": "HockeyPlus_screen5.png", "id": "597242726104551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499323988_597242729437884_7399925015855898168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHGTWBnGQdMQ7kNvwG3zbis&_nc_oc=AdmBkvbZEz0pbgQ2hQQTSYqiJpa8upw3amvcOuFL0amSB9RiTTxROqqF27p0SPHEZXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlPatsykdXM63yk9ABMDJ2dk8Iy3E8XNSilTXeWpWL-Q&oe=69AD7A46"}, {"file_name": "HockeyPlus_screen3.png", "id": "672134852403195", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499316558_672134855736528_2140597336045423819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byYc_RAY3fgQ7kNvwF2sk79&_nc_oc=AdlK9wuE7YUdgor9vXxoBXNbslTC5zqadVJUbHhk8_0rw4eg3eF3nkyZK6CZekwu2EE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWq8ZNGy7NJamOj6gFQtp3gRBtaFryzAFEGIg7OLjYVw&oe=69AD54F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hockey+ VR", "keywords": ["hockey", "sports", "simulation", "multiplayer", "olympics"], "long_description": "**NEW UPDATE**\n\nGet ready to lace up in style\u2014your new Hockey+ mansion just dropped!\nThis update brings a cozy, nostalgic twist to your mini hockey mayhem:\n\n\ud83d\udd25 New Mansion Environment\n\nBasement Rink: Underground games hit differently.\n\nDeck Hockey: Bring the battle outdoors!\n\nGarage Nets: Two nets right out front\u2014perfect for those classic driveway shootouts.\n\nChalet Vibes: A warm, wood-trimmed cabin feel where hockey never sleeps.\n\n\ud83c\udfdf\ufe0f Still Includes 3 Full-Size Arenas\nCompete solo or with friends in both competitive and casual modes, now with more variety than ever.\n\nWhether you're ripping shots in the basement or recreating that golden-hour slapshot on the deck, this is the ultimate Canadian hockey dream.\n\nHockey+ VR is the biggest online hockey experience in the world\u2014no joke, eh? Whether you're hitting the ice for intense 99-player lobbies or kicking back with friends in one of our many arenas, this game has everything a hockey fan could dream of and more.\n\nAnd it doesn't stop there. Hockey+ VR immerses you in the vibe with live video feeds from Toronto, festive Christmas webcams, and a real-time hockey news feed to keep you in the loop. This isn\u2019t just a game\u2014it\u2019s a celebration of hockey culture.\n\nWhether you\u2019re skating, passing, scoring, or just chilling with friends, Hockey+ VR is your ultimate hockey destination. Grab your stick, hit the ice, and give 'er, eh! It\u2019s as Canadian as it gets.", "short_description": "Hockey+ VR is the ultimate online hockey experience! Play in massive 99-player lobbies across 2 rinks, 4 ministicks arenas, air hockey, chess, and more. Featuring live Toronto feeds, hockey news, and endless fun. Grab your stick and give 'er, eh!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332603592
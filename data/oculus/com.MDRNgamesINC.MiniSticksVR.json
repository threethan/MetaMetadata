348_7770854731856334850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lySgt-nNOQ8Q7kNvwErOVfR&_nc_oc=AdngPg7-u4OiwiQp1lwbD8ajU-scQ8J8UpJcO_QKzN76aJrFxDZazxNsHifUYLfZCVo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvsn8sPHFdhl1bCimgX7x54Q_VV0SthZThjAywRxjfqEQ&oe=69A570AA"}, {"file_name": "HockeyPlus_screen2.png", "id": "1406914713671052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499324020_1406914717004385_3823381453500263682_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FthKKw2CIs4Q7kNvwG0JkiH&_nc_oc=AdkJfKMr6zSpP91brI4BJmgxTg2dJ5o2rQ8hi0R3VJt4CW5WxI6MlO_ouIQr6z_dj5M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuVcQknT4d1Ati2-bTesccrIVSbkrzEuC8VRuHs3ft36A&oe=69A58045"}, {"file_name": "HockeyPlus_screen5.png", "id": "597242726104551", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499323988_597242729437884_7399925015855898168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgJlhAkmGSQQ7kNvwH4o5rw&_nc_oc=AdlMaVJYEAwpqBistwM2Bt7v8S8gbFB2QfiDJKZwOeeaiAmDbk1HFGYpA3p20edurok&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftDxQ7IO7A7FaqxxAenA9CNT5qYgFc5V5z_nmrEZL41ew&oe=69A59146"}, {"file_name": "HockeyPlus_screen3.png", "id": "672134852403195", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499316558_672134855736528_2140597336045423819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BObYIab6qhEQ7kNvwHU1CLG&_nc_oc=Admzh094KaBEKiLmzaS0DSUbDA2-xUF6ezk0FmWPPCNy_LTM_4vpofazZ2B0C6Chrnc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftJAzADh5W2lt_x3rwmU6dEYtOf2N3JMvgWDXyMQ9RUuw&oe=69A56BF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hockey+ VR", "keywords": ["hockey", "sports", "simulation", "multiplayer", "olympics"], "long_description": "**NEW UPDATE**\n\nGet ready to lace up in style\u2014your new Hockey+ mansion just dropped!\nThis update brings a cozy, nostalgic twist to your mini hockey mayhem:\n\n\ud83d\udd25 New Mansion Environment\n\nBasement Rink: Underground games hit differently.\n\nDeck Hockey: Bring the battle outdoors!\n\nGarage Nets: Two nets right out front\u2014perfect for those classic driveway shootouts.\n\nChalet Vibes: A warm, wood-trimmed cabin feel where hockey never sleeps.\n\n\ud83c\udfdf\ufe0f Still Includes 3 Full-Size Arenas\nCompete solo or with friends in both competitive and casual modes, now with more variety than ever.\n\nWhether you're ripping shots in the basement or recreating that golden-hour slapshot on the deck, this is the ultimate Canadian hockey dream.\n\nHockey+ VR is the biggest online hockey experience in the world\u2014no joke, eh? Whether you're hitting the ice for intense 99-player lobbies or kicking back with friends in one of our many arenas, this game has everything a hockey fan could dream of and more.\n\nAnd it doesn't stop there. Hockey+ VR immerses you in the vibe with live video feeds from Toronto, festive Christmas webcams, and a real-time hockey news feed to keep you in the loop. This isn\u2019t just a game\u2014it\u2019s a celebration of hockey culture.\n\nWhether you\u2019re skating, passing, scoring, or just chilling with friends, Hockey+ VR is your ultimate hockey destination. Grab your stick, hit the ice, and give 'er, eh! It\u2019s as Canadian as it gets.", "short_description": "Hockey+ VR is the ultimate online hockey experience! Play in massive 99-player lobbies across 2 rinks, 4 ministicks arenas, air hockey, chess, and more. Featuring live Toronto feeds, hockey news, and endless fun. Grab your stick and give 'er, eh!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "3315291
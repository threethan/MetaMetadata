348_7770854731856334850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g4rsopkscgQ7kNvwFzpPwY&_nc_oc=Adn9GV0IloAFE46yW-THa5lyj7BgEV6Mi18j8GLkdHEnpCcAxZAvkg5JCCE2hZUd27s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftyEjb2XHS0keq-GQVDLuFYj9hqWmVMPHwIq0ML-StCBw&oe=6999932A"}, {"file_name": "HockeyPlus_screen2.png", "id": "1406914713671052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499324020_1406914717004385_3823381453500263682_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pBCZksKpJcQ7kNvwEV5rrA&_nc_oc=Adl1BdNkLylr-dYpL5-bN3haRkRAxE2atJcbpJzNbw5G_QA7zAcRCEHWtTyl_w_FUHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJXphK0feMUJw8DJJPMm8zy87-D6a9UZ40e4M6hQTjyA&oe=6999A2C5"}, {"file_name": "HockeyPlus_screen5.png", "id": "597242726104551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499323988_597242729437884_7399925015855898168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9NqRu2rfL8Q7kNvwEP1UeI&_nc_oc=Adkz1EIln36VPuACLlfKczjXQ9CwRHGx9yebG_CsaXQ8X6GVEVfF0J0GlLuQqtcrzpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcmUkk4tKiPpY5aG8zu9K-ZD1cyaWhEoX9QySfSfQm4Q&oe=6999B3C6"}, {"file_name": "HockeyPlus_screen3.png", "id": "672134852403195", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499316558_672134855736528_2140597336045423819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnYjpC_dfbUQ7kNvwGMipb8&_nc_oc=Admu6Fks2gPtZLvI7GbssYxglFF9LajkCrke7C51y213KmQxQwUM-_BwnF0tHITXSbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsvYBfmiO_dTBzL2_NG0l2XezuVMP3eKQjxXkk8BUSdbg&oe=69998E78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hockey+ VR", "keywords": ["hockey", "sports", "simulation", "multiplayer", "olympics"], "long_description": "**NEW UPDATE**\n\nGet ready to lace up in style\u2014your new Hockey+ mansion just dropped!\nThis update brings a cozy, nostalgic twist to your mini hockey mayhem:\n\n\ud83d\udd25 New Mansion Environment\n\nBasement Rink: Underground games hit differently.\n\nDeck Hockey: Bring the battle outdoors!\n\nGarage Nets: Two nets right out front\u2014perfect for those classic driveway shootouts.\n\nChalet Vibes: A warm, wood-trimmed cabin feel where hockey never sleeps.\n\n\ud83c\udfdf\ufe0f Still Includes 3 Full-Size Arenas\nCompete solo or with friends in both competitive and casual modes, now with more variety than ever.\n\nWhether you're ripping shots in the basement or recreating that golden-hour slapshot on the deck, this is the ultimate Canadian hockey dream.\n\nHockey+ VR is the biggest online hockey experience in the world\u2014no joke, eh? Whether you're hitting the ice for intense 99-player lobbies or kicking back with friends in one of our many arenas, this game has everything a hockey fan could dream of and more.\n\nAnd it doesn't stop there. Hockey+ VR immerses you in the vibe with live video feeds from Toronto, festive Christmas webcams, and a real-time hockey news feed to keep you in the loop. This isn\u2019t just a game\u2014it\u2019s a celebration of hockey culture.\n\nWhether you\u2019re skating, passing, scoring, or just chilling with friends, Hockey+ VR is your ultimate hockey destination. Grab your stick, hit the ice, and give 'er, eh! It\u2019s as Canadian as it gets.", "short_description": "Hockey+ VR is the ultimate online hockey experience! Play in massive 99-player lobbies across 2 rinks, 4 ministicks arenas, air hockey, chess, and more. Featuring live Toronto feeds, hockey news, and endless fun. Grab your stick and give 'er, eh!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "3315291
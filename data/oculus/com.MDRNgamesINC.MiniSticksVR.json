348_7770854731856334850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgArXtZYK9oQ7kNvwHknD1K&_nc_oc=AdkFjP1mNEz8vlMlAIlCscllJ1xaWS05e5oucKGid7zQlzyAsznAtK3sU4xUD8i1jOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuvbUbb-GuWxDL5GYQ4AcbVWz_-qnGPFvc1aGxNufeb4Q&oe=699D87AA"}, {"file_name": "HockeyPlus_screen2.png", "id": "1406914713671052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499324020_1406914717004385_3823381453500263682_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dIYkHf-s2YQ7kNvwFgN2Xr&_nc_oc=Adlac25g9QLDzOv6SIYtYEd7u2yps_3mv53YICYgoGHsmzi60HJ93em_uY5kLZ99r0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv88LMm3AJR2yVnM3YTNB2xFrNXy7iokfL4WVUd50O9ug&oe=699D9745"}, {"file_name": "HockeyPlus_screen5.png", "id": "597242726104551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499323988_597242729437884_7399925015855898168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EolMXqAGYhgQ7kNvwF_oWGC&_nc_oc=Adm4H6v6kmx5s0B17DFhxT5i4wN7LguA2ajWdlEbNzeYJoY3l8NyWZb9orwm6NyRiGg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvpa7aD32aPZaBbcpMKuHzph7Tawl7uQqZywLMXqyauDA&oe=699DA846"}, {"file_name": "HockeyPlus_screen3.png", "id": "672134852403195", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499316558_672134855736528_2140597336045423819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNdTbe8ohEcQ7kNvwHifVj4&_nc_oc=AdmayoHZeGD7ch8itLuJMHRR9iBmX5I2ZfOvqKp1VkEuSPnqHFVMK3VFo-SaknQ-TDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsDBwoCSUVwWvX1HI2_t0r8c7sOFOqHpv6MBb0Z75CXIA&oe=699D82F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hockey+ VR", "keywords": ["hockey", "sports", "simulation", "multiplayer", "olympics"], "long_description": "**NEW UPDATE**\n\nGet ready to lace up in style\u2014your new Hockey+ mansion just dropped!\nThis update brings a cozy, nostalgic twist to your mini hockey mayhem:\n\n\ud83d\udd25 New Mansion Environment\n\nBasement Rink: Underground games hit differently.\n\nDeck Hockey: Bring the battle outdoors!\n\nGarage Nets: Two nets right out front\u2014perfect for those classic driveway shootouts.\n\nChalet Vibes: A warm, wood-trimmed cabin feel where hockey never sleeps.\n\n\ud83c\udfdf\ufe0f Still Includes 3 Full-Size Arenas\nCompete solo or with friends in both competitive and casual modes, now with more variety than ever.\n\nWhether you're ripping shots in the basement or recreating that golden-hour slapshot on the deck, this is the ultimate Canadian hockey dream.\n\nHockey+ VR is the biggest online hockey experience in the world\u2014no joke, eh? Whether you're hitting the ice for intense 99-player lobbies or kicking back with friends in one of our many arenas, this game has everything a hockey fan could dream of and more.\n\nAnd it doesn't stop there. Hockey+ VR immerses you in the vibe with live video feeds from Toronto, festive Christmas webcams, and a real-time hockey news feed to keep you in the loop. This isn\u2019t just a game\u2014it\u2019s a celebration of hockey culture.\n\nWhether you\u2019re skating, passing, scoring, or just chilling with friends, Hockey+ VR is your ultimate hockey destination. Grab your stick, hit the ice, and give 'er, eh! It\u2019s as Canadian as it gets.", "short_description": "Hockey+ VR is the ultimate online hockey experience! Play in massive 99-player lobbies across 2 rinks, 4 ministicks arenas, air hockey, chess, and more. Featuring live Toronto feeds, hockey news, and endless fun. Grab your stick and give 'er, eh!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "3315291
348_7770854731856334850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgArXtZYK9oQ7kNvwGapHR-&_nc_oc=Adm8XNaa6vHIVmjUuOo2zgwn34Wb3b-14v0XROniKLWARMFFd4p4ntqy1SUqJ1r0z3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afufs5XRei_iil8_MSC2bhANDXmHJvnkDl8vYNUM7fptEg&oe=69A02AAA"}, {"file_name": "HockeyPlus_screen2.png", "id": "1406914713671052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499324020_1406914717004385_3823381453500263682_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfDF0aY120EQ7kNvwGNLzBS&_nc_oc=Adm6sa_1-nTwsBXPNeuxXY3a6rcJggUUSN1XhEGY-Iew4wfyHBpK0-vR9ycfEgpDKBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYB_vzdRN-lx5saL8nHZc38Yb0HB4wBoAKcO5xvWnCGQ&oe=69A03A45"}, {"file_name": "HockeyPlus_screen5.png", "id": "597242726104551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499323988_597242729437884_7399925015855898168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HqPSAvMi-MQ7kNvwEErf-Y&_nc_oc=AdmKyc7vTRSOp-E7KrRjmR4Jaw39d-McsjqVPcvq52T9stBUI5N3_zArnlBcQKDLjDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvgTYlNfBat8Phy96Y0J5MusZbrvtq_5L__Nr_cwGETSA&oe=69A04B46"}, {"file_name": "HockeyPlus_screen3.png", "id": "672134852403195", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499316558_672134855736528_2140597336045423819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNdTbe8ohEcQ7kNvwGGI12P&_nc_oc=AdmGzvaFAskl2kYL2qqj-cTKhvBPyXX9h_LY3pW8hYP2Eq1Hxt3yC_Rm9PoD8G868XM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsvhzZUUemfg56pwb8I9WTWLS1iviLy45vGDpZoW4IO7w&oe=69A025F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hockey+ VR", "keywords": ["hockey", "sports", "simulation", "multiplayer", "olympics"], "long_description": "**NEW UPDATE**\n\nGet ready to lace up in style\u2014your new Hockey+ mansion just dropped!\nThis update brings a cozy, nostalgic twist to your mini hockey mayhem:\n\n\ud83d\udd25 New Mansion Environment\n\nBasement Rink: Underground games hit differently.\n\nDeck Hockey: Bring the battle outdoors!\n\nGarage Nets: Two nets right out front\u2014perfect for those classic driveway shootouts.\n\nChalet Vibes: A warm, wood-trimmed cabin feel where hockey never sleeps.\n\n\ud83c\udfdf\ufe0f Still Includes 3 Full-Size Arenas\nCompete solo or with friends in both competitive and casual modes, now with more variety than ever.\n\nWhether you're ripping shots in the basement or recreating that golden-hour slapshot on the deck, this is the ultimate Canadian hockey dream.\n\nHockey+ VR is the biggest online hockey experience in the world\u2014no joke, eh? Whether you're hitting the ice for intense 99-player lobbies or kicking back with friends in one of our many arenas, this game has everything a hockey fan could dream of and more.\n\nAnd it doesn't stop there. Hockey+ VR immerses you in the vibe with live video feeds from Toronto, festive Christmas webcams, and a real-time hockey news feed to keep you in the loop. This isn\u2019t just a game\u2014it\u2019s a celebration of hockey culture.\n\nWhether you\u2019re skating, passing, scoring, or just chilling with friends, Hockey+ VR is your ultimate hockey destination. Grab your stick, hit the ice, and give 'er, eh! It\u2019s as Canadian as it gets.", "short_description": "Hockey+ VR is the ultimate online hockey experience! Play in massive 99-player lobbies across 2 rinks, 4 ministicks arenas, air hockey, chess, and more. Featuring live Toronto feeds, hockey news, and endless fun. Grab your stick and give 'er, eh!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "3315291
+landscape.png", "id": "871237498684038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499304938_871237502017371_1952515987369315070_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFyA8UpFQnwQ7kNvwH18Dka&_nc_oc=Adk__FSlZrAMbnDW92AUCqfM3keArydGHtODS5kjk-9ijg0riKantQK4TVcpuB4dZ0Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9c1ms5G5dZOJ9czAVKIFhCTI3XDosPdt1-wjPnniMaA&oe=69AACBD0"}, {"file_name": "hoockey+landscape.png", "id": "852337927758039", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499295272_852337931091372_4947574345356414884_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySVG1l2RWqUQ7kNvwGohmDi&_nc_oc=AdkQ-P9TbmPdE84vLUW-FWfMTM8Ptf032VmZ1Qkfk72N0ARqSyioHSdu_7c_pdnIcTw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afxtd5pPkauwGw15wlYOmv9V68iAs0a9zWCkJ4qBmHAQMQ&oe=69AABE75"}, {"file_name": "portraithockey.png", "id": "727634527050800", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310817_727634530384133_7691709180860875963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D82VGOGvzioQ7kNvwHjgdjG&_nc_oc=Adldag3mQFy61YJeo0kdvuZjEBoIm25OXE3Qdjl_mfuanvSnpyuFv6IZU9X141nZQDs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNCQuf7aScs0hnlG0abwbkd-Bmyu8QBxxMfoBX-dwupw&oe=69AAE427"}]}, "id": "1399196758539493", "locale": "en_US", "screenshots": [{"file_name": "HockeyPlus_screen1.png", "id": "1053610646717703", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499316640_1053610650051036_2543149356100740160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jhxs_4CCZsQ7kNvwE9enHF&_nc_oc=AdmFvXk8t6kUIqPto6wXaPD3BhSx1U74qCDmnrwkiKa6_S7KorV3PljE8B298dT4Gm0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWZvS7HHtNKk0iMu-h_ZuAfqJp2agcZsMMocqw0VzfnA&oe=69AAD7F1"}, {"file_name": "HockeyPlus_screen4.png", "id": "1015484584099015", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499324977_1015484587432348_7770854731856334850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu5xMQsD2iIQ7kNvwETsXIl&_nc_oc=AdmkWWJ_JQ7-3DJTrhWEuR9nXSXlR9FnWY74OuN2jp5hIRl8gKCYUeboiKw03LKPnEU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgDvhtkg5QENOq7rmYl3BdZBDlmKYBEGdSuopAwesjLg&oe=69AAB6AA"}, {"file_name": "HockeyPlus_screen2.png", "id": "1406914713671052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499324020_1406914717004385_3823381453500263682_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1i6c8g7TbwQ7kNvwHm6Cfr&_nc_oc=AdkaLIJMxVO2noQ94PQYlnMh4CKh4giVRGH21qzQmaxge7jV5p1QA9H6ljFpXBiuuVs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHquDg0yr9a242Sr6zTBucso4c3QvJE_S7MfeHb4fRVw&oe=69AAC645"}, {"file_name": "HockeyPlus_screen5.png", "id": "597242726104551", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499323988_597242729437884_7399925015855898168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArkAKjEQijUQ7kNvwFwEcT1&_nc_oc=AdmFcRtAu-OzYch_uU96R2vCSKTjyxXKtmrY99Jct5IFr3s2CVYOB-ZRlz92mFPzWmY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRpIB18pI_8eIZ8slbnpALZp9w-9_eyhzY5kzaZd4b_g&oe=69AAD746"}, {"file_name": "HockeyPlus_screen3.png", "id": "672134852403195", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499316558_672134855736528_2140597336045423819_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je7JshU9Dj4Q7kNvwGUpF0q&_nc_oc=AdlLqHMPNTyxC6qj_akytvIxm0yYoVySzP9ISWrPXfvSFRgVhW25nSyTHSlb0Rrpidc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlUZJMmbF074bZ-TIOrUlKPFH0TeWQBd3mu2rqFHrgag&oe=69AAB1F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hockey+ VR", "keywords": ["hockey", "sports", "simulation", "multiplayer", "olympics"], "long_description": "**NEW UPDATE**\n\nGet ready to lace up in style\u2014your new Hockey+ mansion just dropped!\nThis update brings a cozy, nostalgic twist to your mini hockey mayhem:\n\n\ud83d\udd25 New Mansion Environment\n\nBasement Rink: Underground games hit differently.\n\nDeck Hockey: Bring the battle outdoors!\n\nGarage Nets: Two nets right out front\u2014perfect for those classic driveway shootouts.\n\nChalet Vibes: A warm, wood-trimmed cabin feel where hockey never sleeps.\n\n\ud83c\udfdf\ufe0f Still Includes 3 Full-Size Arenas\nCompete solo or with friends in both competitive and casual modes, now with more variety than ever.\n\nWhether you're ripping shots in the basement or recreating that golden-hour slapshot on the deck, this is the ultimate Canadian hockey dream.\n\nHockey+ VR is the biggest online hockey experience in the world\u2014no joke, eh? Whether you're hitting the ice for intense 99-player lobbies or kicking back with friends in one of our many arenas, this game has everything a hockey fan could dream of and more.\n\nAnd it doesn't stop there. Hockey+ VR immerses you in the vibe with live video feeds from Toronto, festive Christmas webcams, and a real-time hockey news feed to keep you in the loop. This isn\u2019t just a game\u2014it\u2019s a celebration of hockey culture.\n\nWhether you\u2019re skating, passing, scoring, or just chilling with friends, Hockey+ VR is your ultimate hockey destination. Grab your stick, hit the ice, and give 'er, eh! It\u2019s as Canadian as it gets.", "short_description": "Hockey+ VR is the ultimate online hockey experience! Play in massive 99-player lobbies across 2 rinks, 4 ministicks arenas, air hockey, chess, and more. Featuring live Toronto feeds, hockey news, and endless fun. Grab your stick and give 'er, eh!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743
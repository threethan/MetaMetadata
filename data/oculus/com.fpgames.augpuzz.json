DA&oe=6AF9CC9F"}, {"file_name": "nono_wide_9.png", "id": "1581815783443008", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824318_1581815786776341_7361718451799744588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ErKfvDCLpwQ7kNvwH4NEl0&_nc_oc=AdojTBDavt4tW9VzpG6Cv0Z0U0WchVSkdcasuk0aQqvYmiJK7mwM_v6VVokw5QqX6l0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpi6a_A2BkBeGQgthOW5d-gR7X8emxZgmW0Xyrev6Qhg&oe=6AF9E62D"}, {"file_name": "mine_wide.png", "id": "928865033626887", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_928865036960220_2348645765372806040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcHaqQnqoUIQ7kNvwE7F8Qa&_nc_oc=AdoY4qzzPuK-HSYtSUxgX3nps3m7Q8QYyLk6TtGdOU0cU0-lmv7cFG6omCwHz-14kG8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJEFpRjF6mrKHrwNW16l-8CCuHeumMdPM1Fy5h80Wpgg&oe=6AF9D521"}, {"file_name": "sudoku_16_hint.png", "id": "1364176729258110", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823837_1364176732591443_4283310079339860724_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L0HIv4omjoQ7kNvwGts6Xc&_nc_oc=AdrmksoDxS2ug7-svHXg5LhqXmFZ5tMcfIZpUNM_tIghMPcUPVMnWS5zhC1Rhws4pWc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy0VWn3NghZGEmcFFpHHLkNALMFIedT31dp4tDvl_Qmw&oe=6AF9D139"}, {"file_name": "nono_replay.png", "id": "28302008629451120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825415_28302008649451118_7933446425732014765_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA0EsThrb38Q7kNvwFKRqns&_nc_oc=Adqwjv23ft7G1em9wbN4dlY9fr_pd3SeN4IksTu7991IDp9RoAHQYjtok7yiIhm79sU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDD4DYKVoIQeNXjcnPwlLiR4WI1oKO81BKSE-pfxAFwQ&oe=6AF9C19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AP_NonogramsThumbnail_clean.png", "id": "877547701480869", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825415_877547704814202_331563614012225160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDvjsWKdiGUQ7kNvwH2TSeq&_nc_oc=AdoPDmZ4wKrinMqTfwEWDWobXnJfkapXausO6ZATsihiKk3Rf06xyEKnT7fY55s2wyU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm99afb1vrcfIVjhViJG2UW_YttpHAmbsbNlRiXFaqGQ&oe=6AF9EB41"}, "display_name": "Augmental Puzzles", "keywords": ["logic", "puzzle", "sudoku", "picross", "minesweeper"], "long_description": "Hand-set **Sudoku, Nonograms and Minesweeper** on beautiful boards that float right in your room. No guessing, no pressure, no rush - just you, the puzzle, and that quiet click of a deduction falling into place. Every puzzle is set by hand and verified to be unique. \n\n# Built for your headset\nSolve seated at your real desk in passthrough, or switch it off and sink into a calm virtual space.  Big puzzles. Tiny table. Endless calm.\n\n# Sudoku \n{1395187132565062}\nSudoku runs from friendly 6x6 minis to giant 16x16 grids. \n# Nonograms\n{1893503988277025}\nPaint picture as you solve logic puzzles.\n \n# Minesweeper\n{27595814420096874}\nBuilt for pure deduction: every clue on the board from the start, no lucky clicks.\n\n# A fresh puzzle every day\n{2135770024013708}\n\n# Help that teaches\n{3270784359741014}\nA hint lights up the cells that matter and names the technique, so the next one is yours. Wrong placements show every clash. Infinite undo, replay and cloud saves: mistakes cost nothing, and your puzzle waits patiently.\n\n# Puzzle Packs\nFree to start: the Welcome Pack samples every mode and size, and the Daily Challenge lands every single day, gentle on Monday and a proper head-scratcher by Sunday. Post your time and climb the leaderboards.\n\nWant more? Optional hand-set packs run from gentle introductions to expert mega packs, plus Daily+ for the recent daily archive. Updates land regularly, and you can vote in-game for which classic we build next.", "short_description": "Unwind your mind with Augmental Puzzles, a soothing logic-puzzle lounge built for your headset. Solve hand-set Sudoku, Nonograms and Minesweeper on beautiful boards floating in your room. A fresh puzzle lands every single day, global leaderboards welcome the competitive, and regular updates keep the lounge growing. No guessing, no pressure, no rush."}]}, "developer_name": "Flammable Penguins Games", "developer_privacy_policy_url": "https://flammablepenguins.com/augmental_puzzles/privacy.html", "developer_terms_of_service_url": "https://flammablepenguins.com/augmental_puzzles/eula.html", "publisher_name": "Flammable Penguins Games", "support_website_url": null, "website_url": "https://www.flammablepenguins.com/augmental_puzzles/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28575582862079162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_1204032481605801_4874777616422444921_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hxjRKrcXJQQ7kNvwFNQMRD&_nc_oc=Adq-8OOj4VvrfNomLZgAeOVbOMChG7U63Kk2ZIb_pNxzZu3iSZSIHxnWl_axc295l-Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS60eoCdNrdkBpy7mhmiaSDNy1o-MhcJZz1081WiqIqUw&oe=6AF9B8FD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Augmental Puzzles", "platform": "ANDROID_6DOF", "context_categ
NA&oe=6AE7579F"}, {"file_name": "nono_wide_9.png", "id": "1581815783443008", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1581815786776341_7361718451799744588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95JQvnijg_UQ7kNvwFgIIl4&_nc_oc=AdqqnX7089h6CSJnPOjg1OMqQmOhW_WdntDGhdcYyPpju9lykVgu6m8SQq5H7uZ233c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGW_NNT9fQvmxT16_OEbami98Ireun9fgXxG_G-k3zGg&oe=6AE7712D"}, {"file_name": "mine_wide.png", "id": "928865033626887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_928865036960220_2348645765372806040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNAqLb5fYdwQ7kNvwE0M7BL&_nc_oc=AdqxPDFYNaaCgL0tvpwAFzUx4ePHQ4Ji3P-L1T6v7yGlrSrvyDSDbSmVUZdJSbGTMu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrPqKjjkxYtMmLoviGXfQoYiJbBqJSfNI-qoEBts2Y3A&oe=6AE76021"}, {"file_name": "sudoku_16_hint.png", "id": "1364176729258110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1364176732591443_4283310079339860724_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTDU6m7Q_egQ7kNvwHXCuni&_nc_oc=Adq8CwteUcMHCIvBqjT4w6SgBE6KTnnL7S2RIjCk8Xc4tGTnWaR82uvq7Z2uCc75xYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHtWNICS5ftmNM2WIzjH25i0KEoVbqzNvTyWUOu8Fy6g&oe=6AE75C39"}, {"file_name": "nono_replay.png", "id": "28302008629451120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825415_28302008649451118_7933446425732014765_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykRksBaYmYgQ7kNvwF6GB93&_nc_oc=AdrIIfcwxR9e4QjMPklwSZ_hUoOiJOGGShnZBvnXsfu0YvGT9CEqzQ3-5jCXT8xdbis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxe6xllRXtevd7vlPK8-EQIlAZmX8PibNj4y9hYRAOeA&oe=6AE74C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AP_NonogramsThumbnail_clean.png", "id": "877547701480869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_877547704814202_331563614012225160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roG__ojbQywQ7kNvwHGi3C4&_nc_oc=AdoJuahbWwzqJNOhHZ1A9FhayqEbSxOaKgUh6s9yPBSAQs1TXuISrgAZV-qVEbtHzvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA6Lx3OKOo9octpxG2E4b4_-rvTlx1yr2TemGCESuI8w&oe=6AE73E01"}, "display_name": "Augmental Puzzles", "keywords": ["logic", "puzzle", "sudoku", "picross", "minesweeper"], "long_description": "Hand-set **Sudoku, Nonograms and Minesweeper** on beautiful boards that float right in your room. No guessing, no pressure, no rush - just you, the puzzle, and that quiet click of a deduction falling into place. Every puzzle is set by hand and verified to be unique. \n\n# Built for your headset\nSolve seated at your real desk in passthrough, or switch it off and sink into a calm virtual space.  Big puzzles. Tiny table. Endless calm.\n\n# Sudoku \n{1395187132565062}\nSudoku runs from friendly 6x6 minis to giant 16x16 grids. \n# Nonograms\n{1893503988277025}\nPaint picture as you solve logic puzzles.\n \n# Minesweeper\n{27595814420096874}\nBuilt for pure deduction: every clue on the board from the start, no lucky clicks.\n\n# A fresh puzzle every day\n{2135770024013708}\n\n# Help that teaches\n{3270784359741014}\nA hint lights up the cells that matter and names the technique, so the next one is yours. Wrong placements show every clash. Infinite undo, replay and cloud saves: mistakes cost nothing, and your puzzle waits patiently.\n\n# Puzzle Packs\nFree to start: the Welcome Pack samples every mode and size, and the Daily Challenge lands every single day, gentle on Monday and a proper head-scratcher by Sunday. Post your time and climb the leaderboards.\n\nWant more? Optional hand-set packs run from gentle introductions to expert mega packs, plus Daily+ for the recent daily archive. Updates land regularly, and you can vote in-game for which classic we build next.", "short_description": "Unwind your mind with Augmental Puzzles, a soothing logic-puzzle lounge built for your headset. Solve hand-set Sudoku, Nonograms and Minesweeper on beautiful boards floating in your room. A fresh puzzle lands every single day, global leaderboards welcome the competitive, and regular updates keep the lounge growing. No guessing, no pressure, no rush."}]}, "developer_name": "Flammable Penguins Games", "developer_privacy_policy_url": "https://flammablepenguins.com/augmental_puzzles/privacy.html", "developer_terms_of_service_url": "https://flammablepenguins.com/augmental_puzzles/eula.html", "publisher_name": "Flammable Penguins Games", "support_website_url": null, "website_url": "https://www.flammablepenguins.com/augmental_puzzles/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28575582862079162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_1204032481605801_4874777616422444921_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19kahUCqoUoQ7kNvwGtmX74&_nc_oc=AdqrBqXBZDU5xskYg3PSQXbOzvb2_hhMkdliHvgpRH80bZ-n5gUtDA01A4owqnCJ0UA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv8GOdDw9cfoib7dKtGenWtFeE1tbsUfcU_cc-lJdDSg&oe=6AE743FD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Augmental Puzzles", "platform": "ANDROID_6DOF", "context_categ
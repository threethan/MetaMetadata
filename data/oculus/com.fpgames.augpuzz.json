c=AdpiEwZzjnGWAcU6ZaqzL1bpFT3Z5BjEqeQO9oDjQrwWz8LSLReES9iymWxfoiYEmbo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPLjotVxkQqMlaDQushmhBKOdJqAiG7hzELUVOpSUm5A&oe=6AAE95F7"}, {"file_name": "metafied-com.oculus.vrshell-20250909-133923.png", "id": "1513736039784874", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618379_1513736043118207_4513424917341777468_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofjqY9XFgJYQ7kNvwGz4T9C&_nc_oc=Adq8aKKWV1fRd_HasvrqJmffxm2t5BhgeicxPbULu_xFmgjW8VEP9HZ_IpQlb8CWbSg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHL3PZMl7JYgzIy5AZX215Y8M40GLsTQBRSAgTz2FrBw&oe=6AAEA802"}, {"file_name": "metafied-com.oculus.vrshell-20250909-134650.png", "id": "1874648519751569", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499304229_1874648523084902_183850387910932017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44EpbV-u6x0Q7kNvwHKjhQ2&_nc_oc=AdoiyMKEv3iIqubYlHxrNvXAJP_938qj3ob4Zn9icntfQ93aoVS0E3wCRes0UoSHk3I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXrdChm-HESaxWLRuZxXvxzQi9aTut2lBbaQc8UH8ghw&oe=6AAE8758"}, {"file_name": "metafied-com.oculus.vrshell-20250909-133810.png", "id": "1781536295816998", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620309_1781536299150331_1668337338983980294_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0QG7dzKBmcQ7kNvwGlFmbM&_nc_oc=AdqPgPjJRS06yCM2lHhE3f6q-WtY1TT5u84p571rAm3WNh5wrpFAQyUMW39KEhau3Y0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImhLiVSooIh4gzXjOvW1Rl7HT7AKeXjfipAtD89VizZg&oe=6AAEB001"}, {"file_name": "metafied-com.oculus.vrshell-20250909-134434.png", "id": "24277725275244158", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303769_24277725291910823_1801811960652122137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2G_B-YhT78Q7kNvwEVPVJu&_nc_oc=Adq-yplIAp4Q3BwwgYGVdkgPma317zhXgrDnYf-Bl2vdp_7IrdKoOpC8ImLy51AgRGk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTkFnXSVG41VltD_r5FMYHjSuXBCqFxvnlMSqC8XbjHg&oe=6AAE9A8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Augmental Puzzles", "keywords": ["logic", "puzzle", "numbers", "sudoku", "calming"], "long_description": "Master complex puzzles with smart highlighting and intelligent hints.\n\nCorrect mistakes instantly using the infinite undo and replay.\n\nPuzzles crafted by hand, computer verified. Tasty Sourdough-ku!\n\nCheck solutions on the fly to help you solve them with absolute confidence!\n\n{3270784359741014}\n- **Intelligent highlighting** - Making a wrong placement highlights  it, as well as any other number that it clashes with so you can see where the problem lies! \n\n- **Hint System** - We all get stuck sometimes. With our Intelligent Help feature you can get a hint to get you going again.\n\n- **Infinite Undo** - Made a mistake? Not a problem. You can undo it to your heart\u2019s content. Replay allows you to rewatch how you solved the puzzle to learn from your journey.\n\n- **Rules validation** - Making sure you put your numbers correctly according to the sudoku rules.\n\n- **Solution checker** - Checks against the solution for this puzzle. It\u2019s non-intrusive and can be turned off if you\u2019d rather try on your own first.\n\n- **Cloud Save** - Taking a break? Come back and continue your puzzle anytime. There is never any rush with our game.\n\n\n\n# Daily challenges\n{1922426285376151}\nEvery day there is a new sudoku puzzle for you to solve.\n\n\n# Scoring leaderboards\n{4136742409975957}\nFor the competitive puzzlers among us, climb the Daily Challenge Leaderboards.\n\n\n# Handset puzzles\n{1155457683408305}\nAll of our puzzles are handset and come in different sizes!\n", "short_description": "Unwind your mind with Augmental Puzzles, a soothing Puzzle experience designed for daily play. Enjoy a fresh puzzle every day, climb the global leaderboard, and immerse yourself in the quiet satisfaction of logic and focus."}]}, "developer_name": "Flammable Penguins Games", "developer_privacy_policy_url": "https://flammablepenguins.com/augmental_puzzles/privacy.html", "developer_terms_of_service_url": "https://flammablepenguins.com/augmental_puzzles/eula.html", "publisher_name": "Flammable Penguins Games", "support_website_url": null, "website_url": "https://www.flammablepenguins.com/augmental_puzzles/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24479505228353633"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1113995220872912"}]}, "baseline_offer": {"id": "1113995220872912"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770129540, "status": "PUBLISHED", "id": "1113995220872912"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28576515455319236", "version": "26.09.07.2227"}, "id": "1433760871082813", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24479505205020302", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28576515455319236"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1433760871082813"}]}, "change_log": null, "created_date": 1788823304, "id": "28576515455319236", "version": "26.09.07.2227", "version_code": 26090789, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24479505205020302", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28576515455319236"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788799277, "id": "28573116105659171", "version": "26.09.07.0137", "version_code": 26090706, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24479505205020302", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28576515455319236"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788638233, "id": "28550077924629656", "version": "26.09.05.1951", "version_code": 26090579, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24479505205020302", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28576515455319236"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1433760871082813"}]}, "change_log": "Thank you for the feedback, we read all of it. This one is small and almost entirely about how the game feels in your hands.\n\n- Grabbing has some give in it. Picking up a panel or a board used to feel welded to your hand. There is a bit of elastic in the grab now, so things carry a little weight, follow your hand and settle where you put them.\n- Board cells are stickier. We turned the stickiness up, so your hand can drift over a border without the selection hopping to the neighbour. Big puzzles are much easier to work on and there are far fewer misclicks. Hovering also hands over to whichever hand is free, rather than staying with the one you last pointed with.\n- The highlight is easier to read. The cell tint has been turned up, so the cell you are about to act on is obvious rather than something you squint at.\n- Annotation lines leave a mark. Drawing an annotation line across a nonogram now tints the cells it crosses, so you can lay a move out and look at it before committing to it. The tint clears on your next move, the same way hint colouring does.\n- The tutorial follows the correct hand. It could read the wrong hand's position and refuse to accept a step you had just done correctly.\n\nAlong with a round of stability fixes, and more of the quiet groundwork for the headsets in the list above.", "created_date": 1787057969, "id": "28312582921712492", "version": "26.08.18.1255", "version_code": 26081851, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24479505205020302", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28576515455319236"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1787020473, "id": "28307478332222951", "version": "26.08.18.0230", "version_code": 26081810, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
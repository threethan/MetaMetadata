og&oe=6AF0921F"}, {"file_name": "nono_wide_9.png", "id": "1581815783443008", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_1581815786776341_7361718451799744588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfK1_6NnK6YQ7kNvwE_2SfC&_nc_oc=AdokeryTP0ZFwkyRgBUhDRtOq6YmCUURXvUluzv3EGhwQRUA25T_7mO8ygyHizQvuWo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTapMsq2u4iv2oDBtgUvobgPmj0K6iUhbd9gTJfdR6-4w&oe=6AF0ABAD"}, {"file_name": "mine_wide.png", "id": "928865033626887", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_928865036960220_2348645765372806040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob_srLwQ3WIQ7kNvwHJQLDG&_nc_oc=Adpmm3rfZoSr2Q70AnkOL6gwOYsr6s8bjJMp8dO70oWJE__5D6Ys3Ri2I-53_2SwnF4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKvuvMsxwLuFBvXy7UZI3p1KwvlLxqK8OQNdbV7ubp4Q&oe=6AF09AA1"}, {"file_name": "sudoku_16_hint.png", "id": "1364176729258110", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1364176732591443_4283310079339860724_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2JUpZwyKzIQ7kNvwHZlEZx&_nc_oc=Adq6g6JzJQ17pBEp6t8C9bsOrxRyQUYPG2j4Py8Dj1KpZz8X7KFJA23T9junRJhQhKc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRTm0KqrEDnn-4WOyYRKDe_hdSo3ctoGzbrb99VQhD-A&oe=6AF096B9"}, {"file_name": "nono_replay.png", "id": "28302008629451120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_28302008649451118_7933446425732014765_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0_Rg13TYHUQ7kNvwFhNpwG&_nc_oc=Adq5_sKe-ck1Ef8YwJiRuc2fhfEhagBonkvPAGJ-T_SVxX4S5YVU9xkRZ0cDIZfzNrk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRu4qzQnYtlnh_FC9J6Qcz6txALiH0E54L3Emaw-MI8g&oe=6AF0871D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AP_NonogramsThumbnail_clean.png", "id": "877547701480869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_877547704814202_331563614012225160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hnw58RcpdmQQ7kNvwEAuezn&_nc_oc=AdrwTHI9htzGn_sdVa8gb8ZATzWDij7tJW-XXGz8BQLolVhdhBn30JMcfaljZzZXfFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGNgUuwBwv-oMasdYuMPpS8vlFDGGO3kuEfpg7rHELdg&oe=6AF0B0C1"}, "display_name": "Augmental Puzzles", "keywords": ["logic", "puzzle", "sudoku", "picross", "minesweeper"], "long_description": "Hand-set **Sudoku, Nonograms and Minesweeper** on beautiful boards that float right in your room. No guessing, no pressure, no rush - just you, the puzzle, and that quiet click of a deduction falling into place. Every puzzle is set by hand and verified to be unique. \n\n# Built for your headset\nSolve seated at your real desk in passthrough, or switch it off and sink into a calm virtual space.  Big puzzles. Tiny table. Endless calm.\n\n# Sudoku \n{1395187132565062}\nSudoku runs from friendly 6x6 minis to giant 16x16 grids. \n# Nonograms\n{1893503988277025}\nPaint picture as you solve logic puzzles.\n \n# Minesweeper\n{27595814420096874}\nBuilt for pure deduction: every clue on the board from the start, no lucky clicks.\n\n# A fresh puzzle every day\n{2135770024013708}\n\n# Help that teaches\n{3270784359741014}\nA hint lights up the cells that matter and names the technique, so the next one is yours. Wrong placements show every clash. Infinite undo, replay and cloud saves: mistakes cost nothing, and your puzzle waits patiently.\n\n# Puzzle Packs\nFree to start: the Welcome Pack samples every mode and size, and the Daily Challenge lands every single day, gentle on Monday and a proper head-scratcher by Sunday. Post your time and climb the leaderboards.\n\nWant more? Optional hand-set packs run from gentle introductions to expert mega packs, plus Daily+ for the recent daily archive. Updates land regularly, and you can vote in-game for which classic we build next.", "short_description": "Unwind your mind with Augmental Puzzles, a soothing logic-puzzle lounge built for your headset. Solve hand-set Sudoku, Nonograms and Minesweeper on beautiful boards floating in your room. A fresh puzzle lands every single day, global leaderboards welcome the competitive, and regular updates keep the lounge growing. No guessing, no pressure, no rush."}]}, "developer_name": "Flammable Penguins Games", "developer_privacy_policy_url": "https://flammablepenguins.com/augmental_puzzles/privacy.html", "developer_terms_of_service_url": "https://flammablepenguins.com/augmental_puzzles/eula.html", "publisher_name": "Flammable Penguins Games", "support_website_url": null, "website_url": "https://www.flammablepenguins.com/augmental_puzzles/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28575582862079162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_1204032481605801_4874777616422444921_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0sRYUZLS5wQ7kNvwHI2BIf&_nc_oc=Adqw5tPdxO94XXrX0-_xEMucV-kyJHnQQfM_eYmVKL-4vFuC7JRjU9pSDU7eZ7ttYkU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4HipzfihfAfec0rL6Lol-Qw4mNYcvfwWpL2am8GTVfg&oe=6AF07E7D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Augmental Puzzles", "platform": "ANDROID_6DOF", "context_categ
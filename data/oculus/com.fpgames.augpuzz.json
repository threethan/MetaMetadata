zynbaLRkhwUNmp6_T47z7j_UG1thugJw&oe=6A427AF7"}, {"file_name": "metafied-com.oculus.vrshell-20250909-133923.png", "id": "1513736039784874", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618379_1513736043118207_4513424917341777468_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHBZ4-h8MiAQ7kNvwGut18x&_nc_oc=AdotRWB2VnkV_1jfxoZwJJufcrCFELc-OrXZZmNFp8oRL2khQUlgy2GllMRbSbKYAJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z07ZpzmV2LThvJV8s-dOZALTV5fBNd_1rHnpTTujRbQ&oe=6A428D02"}, {"file_name": "metafied-com.oculus.vrshell-20250909-134650.png", "id": "1874648519751569", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304229_1874648523084902_183850387910932017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1ag8u6h8E8Q7kNvwGrtAxJ&_nc_oc=AdrvxOK5WsTpEklbP-gp8WEJVge4o_avhz9_E-wPd3RMWLfqbgrKSbyTpZgAlCSUlFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F3q84a45nWvDb-l46vPgwk4fKhG_Hdssj_VtbwKPh-Q&oe=6A426C58"}, {"file_name": "metafied-com.oculus.vrshell-20250909-133810.png", "id": "1781536295816998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620309_1781536299150331_1668337338983980294_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUl5mxEUqG8Q7kNvwGZ5ZGr&_nc_oc=AdqkJA07syqtsopVriSGTz2RWzkTsaYksIjhoPO-FFFDWoiZqVhQY7uS-BQR3iujpK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7-9PYssr_SwaLSwj_Xk-th9Z9L0f4JU5N0lJXG1cOOw&oe=6A429501"}, {"file_name": "metafied-com.oculus.vrshell-20250909-134434.png", "id": "24277725275244158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_24277725291910823_1801811960652122137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1jXlBVhcLwQ7kNvwFPWncn&_nc_oc=AdpFY3fmcwHqZ2g9snxVTA8TzG4WRkNyM6Fi5lQ8AcwJUUxfvUY0mmDOiqJHekGT6n0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JSG94B8khi6EYLKWBKfwQ1nA3Pddvl3Daf46SvlaskA&oe=6A427F8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Augmental Puzzles", "keywords": ["logic", "puzzle", "numbers", "sudoku", "calming"], "long_description": "Master complex puzzles with smart highlighting and intelligent hints.\n\nCorrect mistakes instantly using the infinite undo and replay.\n\nPuzzles crafted by hand, computer verified. Tasty Sourdough-ku!\n\nCheck solutions on the fly to help you solve them with absolute confidence!\n\n{3270784359741014}\n- **Intelligent highlighting** - Making a wrong placement highlights  it, as well as any other number that it clashes with so you can see where the problem lies! \n\n- **Hint System** - We all get stuck sometimes. With our Intelligent Help feature you can get a hint to get you going again.\n\n- **Infinite Undo** - Made a mistake? Not a problem. You can undo it to your heart\u2019s content. Replay allows you to rewatch how you solved the puzzle to learn from your journey.\n\n- **Rules validation** - Making sure you put your numbers correctly according to the sudoku rules.\n\n- **Solution checker** - Checks against the solution for this puzzle. It\u2019s non-intrusive and can be turned off if you\u2019d rather try on your own first.\n\n- **Cloud Save** - Taking a break? Come back and continue your puzzle anytime. There is never any rush with our game.\n\n\n\n# Daily challenges\n{1922426285376151}\nEvery day there is a new sudoku puzzle for you to solve.\n\n\n# Scoring leaderboards\n{4136742409975957}\nFor the competitive puzzlers among us, climb the Daily Challenge Leaderboards.\n\n\n# Handset puzzles\n{1155457683408305}\nAll of our puzzles are handset and come in different sizes!\n", "short_description": "Unwind your mind with Augmental Puzzles, a soothing Puzzle experience designed for daily play. Enjoy a fresh puzzle every day, climb the global leaderboard, and immerse yourself in the quiet satisfaction of logic and focus."}]}, "developer_name": "Flammable Penguins Games", "developer_privacy_policy_url": "https://flammablepenguins.com/augmental_puzzles/privacy.html", "developer_terms_of_service_url": "https://flammablepenguins.com/augmental_puzzles/eula.html", "publisher_name": "Flammable Penguins Games", "support_website_url": null, "website_url": "https://www.flammablepenguins.com/augmental_puzzles/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24479505228353633"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1113995220872912"}]}, "baseline_offer": {"id": "1113995220872912"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770129540, "status": "PUBLISHED", "id": "1113995220872912"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27662323456738445", "version": "26.06.23.1647"}, "id": "1433760871082813", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24479505205020302", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27662323456738445"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782278485, "id": "27667923422845115", "version": "26.06.24.0519", "versi
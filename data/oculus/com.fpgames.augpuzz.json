-UeYQ7kNvwHzfjDW&_nc_oc=AdoGDi6QDLXd4sRYRwEQjWIFtEKjslfJRqxze5zytQVefCIt6Oaykv7RhOIsBLTtwow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2jpZ7kym7imGXmaQ7VTr_N1r4HUwQwrVR6vIayPCGXg&oe=6A47B258"}, {"file_name": "metafied-com.oculus.vrshell-20250909-133810.png", "id": "1781536295816998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620309_1781536299150331_1668337338983980294_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVeO5enV_rEQ7kNvwEqzZin&_nc_oc=AdrsyUIdtjOG1TMcvQeYpqqHzDroxQgh3NKykTxnqlIwoKj4Sl6vRIzYiYSxD8v39p0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tT384FuGzYO4CXB_SHO1W4qIeFZf3S7jT8v2EBz_zZQ&oe=6A47DB01"}, {"file_name": "metafied-com.oculus.vrshell-20250909-134434.png", "id": "24277725275244158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303769_24277725291910823_1801811960652122137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeX9qfiNQJAQ7kNvwEHDe6q&_nc_oc=AdoYl8JEAiYU4UIbfHhJ0R5aOfmq5rQ5OiQtG6NQGjCqcms2Ne3s1Emt-6ufWERHq-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-gszhYJJHWGLCyai9XzVHFgF_dhO_ZyFQ2am_kQftuQ&oe=6A47C58C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Augmental Puzzles", "keywords": ["logic", "puzzle", "numbers", "sudoku", "calming"], "long_description": "Master complex puzzles with smart highlighting and intelligent hints.\n\nCorrect mistakes instantly using the infinite undo and replay.\n\nPuzzles crafted by hand, computer verified. Tasty Sourdough-ku!\n\nCheck solutions on the fly to help you solve them with absolute confidence!\n\n{3270784359741014}\n- **Intelligent highlighting** - Making a wrong placement highlights  it, as well as any other number that it clashes with so you can see where the problem lies! \n\n- **Hint System** - We all get stuck sometimes. With our Intelligent Help feature you can get a hint to get you going again.\n\n- **Infinite Undo** - Made a mistake? Not a problem. You can undo it to your heart\u2019s content. Replay allows you to rewatch how you solved the puzzle to learn from your journey.\n\n- **Rules validation** - Making sure you put your numbers correctly according to the sudoku rules.\n\n- **Solution checker** - Checks against the solution for this puzzle. It\u2019s non-intrusive and can be turned off if you\u2019d rather try on your own first.\n\n- **Cloud Save** - Taking a break? Come back and continue your puzzle anytime. There is never any rush with our game.\n\n\n\n# Daily challenges\n{1922426285376151}\nEvery day there is a new sudoku puzzle for you to solve.\n\n\n# Scoring leaderboards\n{4136742409975957}\nFor the competitive puzzlers among us, climb the Daily Challenge Leaderboards.\n\n\n# Handset puzzles\n{1155457683408305}\nAll of our puzzles are handset and come in different sizes!\n", "short_description": "Unwind your mind with Augmental Puzzles, a soothing Puzzle experience designed for daily play. Enjoy a fresh puzzle every day, climb the global leaderboard, and immerse yourself in the quiet satisfaction of logic and focus."}]}, "developer_name": "Flammable Penguins Games", "developer_privacy_policy_url": "https://flammablepenguins.com/augmental_puzzles/privacy.html", "developer_terms_of_service_url": "https://flammablepenguins.com/augmental_puzzles/eula.html", "publisher_name": "Flammable Penguins Games", "support_website_url": null, "website_url": "https://www.flammablepenguins.com/augmental_puzzles/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages
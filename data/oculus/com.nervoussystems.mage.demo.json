iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYGRM0uviIHcyTuk6mUhnHg1G-nWMBg0oIzajR1GM1Vg&oe=69CA573A"}, "display_name": "VEX MAGE - Demo", "keywords": ["FastPaced", "BulletHell", "Spellcasting", "Coop", "MovementBased"], "long_description": "Get a taste of the Single Player experience in VEX MAGE!  Twin elements. Infinite momentum. Danger from every direction. Merge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter.\n\nEnemies strike from all sides - survive by mastering your movement and aggression.\nAssign elemental runes to each hand and fuse them for devastating results.\nLeave your mark and fight your way up the global ranks, where only the deadliest rise to the top.\n\nThe full game will include:\n* **A Rapid-Fire Campaign:** Levels that explode with speed, chaos, and pure adrenaline.\n* **Co-op Multiplayer:** Fight alone or with up to two allies. The challenge adapts, so every run is a test of survival.", "short_description": "Get a taste of the Single Player experience in VEX MAGE! Twin elements. Infinite momentum. Danger from every direction. Merge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter."}]}, "developer_name": "Nervous Systems LLC", "developer_privacy_policy_url": "https://nervous-systems.com/vex-mage/privacy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://nervous-systems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
scdn.com&_nc_ss=7f20f&oh=00_AQFZIfozcfbLaMCflaA4VZC3jLUzD3Q9MewSJb6OBLMsFQ&oe=6A8EC4C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_meta.png", "id": "2022068528636879", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824012_2022068531970212_3402766063781202857_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbLujU2MUd0Q7kNvwFnbHos&_nc_oc=AdqnzLr3Yres2nVMP9F86KrmA8yiI7ndVT6f83rUpt_CYPwDiA0o5xbxtomtgwk78TU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbwcQWHoD9DvaD4LfsUIMuNI1ibW-hsm6Kn8PHH1Ni4A&oe=6A8EDA34"}, "display_name": "VEX MAGE - Demo", "keywords": ["FastPaced", "BulletHell", "Spellcasting", "Coop", "MovementBased"], "long_description": "Get a taste of the multiplayer experience in VEX MAGE!  Twin elements. Infinite momentum. Danger from every direction. Merge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter.\n\n# **Vexatious Combat:** \nEnemies strike from all sides - survive by mastering your movement and aggression.\n{721283910372077}\n\n# **Co-op Multiplayer:** \nFight alone or with up to two allies. The challenge adapts, so every run is a test of survival.\n{25232906686345141}\n\n# **Combine The Elements:** \nAssign elemental runes to each hand and fuse them for devastating results.\n{1978804642906689}\n\n# **Global Leaderboards:** \nLeave your mark and fight your way up the global ranks, where only the deadliest rise to the top.\n{836548978897456}\n\n# The full game will include:\n**A Rapid-Fire Campaign:** Levels that explode with speed, chaos, and pure adrenaline.\n{1844769639758130}\n", "short_description": "Get a taste of the multiplayer experience in VEX MAGE! Twin elements. Infinite momentum. Danger from every direction. Merge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter."}]}, "developer_name": "Nervous Systems LLC", "developer_privacy_policy_url": "https://nervous-systems.com/vex-mage/priv
oh=00_AQMLsNMFHsdINhBqxZhNjJr94-Fck_OSMJFuc7HZ-FXEZA&oe=6AE33CF4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjLxZss00RQQ7kNvwH2k-x1&_nc_oc=AdrGFGD8VhQOpGo0PaWsdxY6dnNkJI7CtvdS1_lDCGBECygCYnfNfJ0uhcmvLHaMAR4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdS_90T3HjEeqJtmnKMk0nOqxELbUz1dkHQ1k-vhfCmg&oe=6AE363B9"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSdO9wuAvzcQ7kNvwGbe_nJ&_nc_oc=Adrv2K-Kh3cqfGidvu0ht35UR_dMDl8X69ENcXvyJvFHWeci5QnX77Ua_x2eIgbFlzw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt_XoyjlB71fqeDVH912wFkCTuwXAdWJyTZoCHvFGFhw&oe=6AE361B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOFDyIAUbcMQ7kNvwF4eup_&_nc_oc=AdqvALEIp8P6jyruHl4t5FjsF4_n9e2p5ok4M4GlDN5DUF0B0KLQTfmaEFETn-nm5Z0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM31DSCCqejUjKECB6PdcqM-I-u1TKZrTI2b7aC5HgdA&oe=6AE359EF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P8_6sU1aC0Q7kNvwEeZo6K&_nc_oc=AdoZT0KUusKHTCYfnaRIgtlzBL6Qfpfvmgoj004VKGwqub0FDoXYmEXwUxStjh1ZYmw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKImg-j4jvt3r8sl8-GTITClE81RbVTJhY5Ld7dAaC6A&oe=6AE3596C"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTynrezFEIsQ7kNvwGWaR3p&_nc_oc=AdospHAd6fK9_ee
D25075"}, {"file_name": "Oculus_ScreenShot-3.png", "id": "326740575212104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223475_326740578545437_6147355820943963552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEh49l5fmY8Q7kNvwEPmKsF&_nc_oc=AdqFGe7-aqLeSCV5SoQk5CAF4jNwAhaQ9TDkBhT4O2k0oaLCpBW3GstAfIWrxNm0ts0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ-9MAIliX2v11mCnAVzF5RkvtCMYbl3NCn84k0g6J1w&oe=6AD256C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30ab\u30cf\u3099\u30fc_\u6a2a.png", "id": "377389156617174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982695_377389159950507_5482305150681727681_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDG4Uaho_WwQ7kNvwFc0KhH&_nc_oc=AdrRUgp6n8tkiRx17iqs2KW09f9bJjP8OCAQkfhInJo4STMdFuo6AOK_UiF9y-atMcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEElPoQq642VZodKQI4Yn2ZuSNGmstjrqhv4tAjqg38A&oe=6AD256FB"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["CHRONOS", "TOKYO", "Adventure", "Mecha", "SF"], "long_description": "\"\u2014This isn\u2019t a dream.\"\nDive into the future in Altdeus: Beyond Chronos, a sci-fi adventure full of robot battles, pop music, and emotion. Featuring one of the largest branching storylines ever in a VR game, Altdeus will place you in the shoes of Chloe, a pilot in humanity's forces fighting massive hostile organisms known as the Meteora.\n\nConverse with other characters and seek clues in the Adventure Section. The Mecha Battle Section is where things get rough, as you enter the cockpit of Makhia, the towering humanoid anti-Meteora combat weapon.\n\nWhen Chloe arrives at her final decision\u2014what will you choose?\n\nGenre: VR Adventure / Visual Novel", "short_description": "\"\u2014This isn\u2019t a dream.\"\nDive into the future in Altdeus: Beyond Chronos, a sci-fi adventure full of robot battles, pop music, and emotion. Featuring one of the largest branching storylines ever in a VR game, Altdeus will place you in the shoes of Chloe, a pilot in humanity's forces fighting massive hostile organisms known as the Meteora.\n\nGenre: VR Adventure / Visual Novel"}]}, "developer_name": "MyDearest Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": "https://altdeus.com/en/", "website_url": "https://altdeus.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "fr", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1010970866121441"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1824407264905524"}, {"status": "PUBLISHED", "id": "1233155755552491"}, {"status": "PUBLISHED", "id": "1191108313219316"}, {"status": "PUBLISHED", "id": "2151214935404837"}, {"status": "PUBLISHED", "id": "709578194770025"}, {"status": "PUBLISHED", "id": "1120603426423198"}, {"status": "PUBLISHED", "id": "376976247016489"}, {"status": "PUBLISHED", "id": "556424215575968"}, {"status": "PUBLISHED", "id": "3685919294855737"}, {"status": "PUBLISHED", "id": "1139444769871739"}, {"status": "PUBLISHED", "id": "954425376054225"}, {"status": "PUBLISHED", "id": "499261558402447"}, {"status": "CANCELLED", "id": "309436211158704"}]}, "baseline_offer": {"id": "3685919294855737"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "statu
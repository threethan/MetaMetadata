oh=00_AQSDCuKT8Z7PW-ncC24bdkrrGahc1U6MfstVnbassHODIw&oe=6AEA0CB4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap3MsEEE9lIQ7kNvwGYc746&_nc_oc=AdoIfPAoFWDADRY4MK5adhPy_S1uOaF-37DmAurG76DlHEKdmmlqohBCXI-cnMqRQT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS35DYVNPyIOW0NDKmcf5NpqmJdoEB6Be5NU5fXHCiFbw&oe=6AE9FB39"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZwIls4rwMUQ7kNvwG8bM_e&_nc_oc=Adro6-TsNAMmEURCTgiY3oqAIY7GmkzRoEp0p_7oyn-PpWYn4ishZMf9c6-rK2A5v5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStsqrqtWI4UGh9zFS-X8YJtOvHJ7uHvFCuMoCngbQcuA&oe=6AE9F934"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbQIpzATXAoQ7kNvwER7Qs1&_nc_oc=Adrr1VM6CpM1p_IaqfckntKOypLRkYMvhqZZDSKloK7eh5ROKQmUqqE0qPhKGdCu_o0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRqzQcEfIAtHh4Jbx5vxo_755X3c97hZZ8gKd3mzDxQQ&oe=6AE9F16F"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzV4JDyILm0Q7kNvwEuCByX&_nc_oc=Ado-eFA57T0EdPdQYvMJL0UX9l-Z8lxHI8EZahJxpr_clxYxQAYfnEvhyNRfmW7d_a4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVw9B8Fnt2-K32E5c77snaVUHAXb3oRs-5IymXf_rlsQ&oe=6AE9F0EC"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OQ8y-sIRqMQ7kNvwGPF4A6&_nc_oc=AdqhsRvLXHFU1gq
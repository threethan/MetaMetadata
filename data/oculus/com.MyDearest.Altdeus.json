oh=00_AQJvStdFJLCG71nClCIPRVbOGy22Tu6mThcfueW7GMJo-A&oe=6AA151F4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuczR5-7p1IQ7kNvwG_KEwH&_nc_oc=AdpcidmK-Bh2-qNZXfay_8aDe-quLss-pl1TYC02R06cg-EEKjDO8V-CMgos0LfYERk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWx69Wpd26VMuqNFCZ7GRSCEn25Yr4PazOcVnjbt8Z-g&oe=6AA178B9"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kB0heVTc5kQ7kNvwFUnm8U&_nc_oc=Adqlx6w3teY5Y6SO_9ApVRdyvwmklzZnmrsydsRdYkPLnIrA_KSwMevwQMyLbDtJcAE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJCUaqhS-VzKP1-7WS1Kru0G_4EQhpSexNNajYrn4Djw&oe=6AA176B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rXPewjxGnkQ7kNvwGaqqqU&_nc_oc=AdrRP2Z09RWamw-bOZMJznZ-6hvipZbnE4oanAd8b7eQPuErcM6_augC4m1j61JcMto&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1f3xWJPPzxsHQ8C9xVeuOKFoEMYB5tnXA1EZAHnq1bQ&oe=6AA16EEF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yag8B1OXXL4Q7kNvwGA7VMX&_nc_oc=AdoJbjMeSRohaznCA2vAN7Z-VpOdziCa8ZnPa-TP7Lqo_OT6I_FaIUXpOO0BxQmJivA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvI19NTEycCIwe8ckmx4Jxi6mPAAn-XRRvvClDCf9l2Q&oe=6AA16E6C"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXytb59lB7AQ7kNvwHSIJGa&_nc_oc=Ado3HH_j17b5Tdy
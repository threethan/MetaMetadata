e hostile organisms known as the Meteora.\n\nGenre: VR Adventure / Visual Novel"}]}, "developer_name": "MyDearest Inc.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": "https://altdeus.com/en/", "website_url": "https://altdeus.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "fr", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1010970866121441"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1824407264905524"}, {"status": "PUBLISHED", "id": "1233155755552491"}, {"status": "PUBLISHED", "id": "1191108313219316"}, {"status": "PUBLISHED", "id": "2151214935404837"}, {"status": "PUBLISHED", "id": "709578194770025"}, {"status": "PUBLISHED", "id": "1120603426423198"}, {"status": "PUBLISHED", "id": "376976247016489"}, {"status": "PUBLISHED", "id": "556424215575968"}, {"status": "PUBLISHED", "id": "3685919294855737"}, {"status": "PUBLISHED", "id": "1139444769871739"}, {"status": "PUBLISHED", "id": "954425376054225"}, {"status": "PUBLISHED", "id": "499261558402447"}, {"status": "CANCELLED", "id": "309436211158704"}]}, "baseline_offer": {"id": "3685919294855737"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1824407264905524"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBi
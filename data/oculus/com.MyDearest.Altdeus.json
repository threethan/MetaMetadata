sid=6e7a0a&_nc_ohc=nu9XTJhSoj8Q7kNvwHD2YMK&_nc_oc=AdqCR_G26bjpy0d3_E1jsGDr3leZLYZaUF9XS_187NnYxGaBCPfYWKZB80JsfdRPj94&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bWe5ehmlFdM0VvBJspDU-MM8Gr2Y6glg52z8O_7F6oQ&oe=6A32BAB9"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3Fb0rRUJTYQ7kNvwE702QT&_nc_oc=AdpPWrCp2kI7VwFtET-8vrd7LIpEQNqV9jOJHnz2G4OfmEuDM898TPoXNqOjc_Z44Hg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ms98DhwjCVPmDg9SBhyaEtAJRBrnuId3n9SvxzCcLlQ&oe=6A32B8B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVusggeL5xwQ7kNvwF3UZ6l&_nc_oc=AdocUYldv98yYSTydWCDQRdAPycuq2OLa2Njr7cTEXtcdkJMjnKc7zLzd9w5wC8hHY0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OaOIS6K4CjnrQDgM9_ME2ahWlKzOzq1wdWeK-UruzRg&oe=6A32B0EF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esiTH9UX3GEQ7kNvwGGDvXJ&_nc_oc=AdoYtYHoHKHzbAKCZ1B2ME7HA3K0rzG7NepQjFl9Y7z1Pzfvb4Rr65jYm1S8Y0k6jAY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Aoi_GLt3mENlSncMoF2VW1MnX4ux6PwsN5FWQTP3_jQ&oe=6A32B06C"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQnEjQJFQFUQ7kNvwEaRv7u&_nc_oc=Adp91O2i68WnQlFUh_hE8c2d2h1DJ0xkM7BqgSMeHdkxnqMavECceiF879KVZWv1kPM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PdPQM2lORptuj39wp3A-4L2DooztcAk9CEvMXqaWBOA&oe=6A329EF1"}, {"file_name": "75292488_2711827285699173_9164718924552926630_n.png", "i
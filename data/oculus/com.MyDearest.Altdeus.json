oh=00_AQNmj8zvxH3CWffekTeYklHXGGG6-jIEQI-qyowHlVCg-g&oe=6AC27FB4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-BwUgkU9pwQ7kNvwGq7Wiw&_nc_oc=AdrCqfQ_n6GDftd4w7qi_BU6wsCr9UelPXoXT6Y4gXW9lSOIRu2ehsb_EnatdpTNwMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjUTm1UmX7oEjLWxvMEkokb_D73Dav8HugxyKwQ4u3zA&oe=6AC26E39"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5wXwTd22S4Q7kNvwGpFvx0&_nc_oc=Adob0U74q1Ntp7FPF5I429O1uKzU0xQyRVzk3w4nDHBOmZB886xW97ujOAPkMVSf1QA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVDvL61VRlR_6g7SFEPCBEXlzKsc_Y_dqu76jN_FGZ-A&oe=6AC26C34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVV_qe8ncwYQ7kNvwFjfWj_&_nc_oc=AdqgJNJ51SwVbgQpUzM2ykfLaQx1mEeJxL2y8WB-b7kpHQazrl54cNzKrYrIsKto--E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-Ltf_7h7MZMtlG18R3YNFj9FpQ44OeZWpTgN8sb3KLA&oe=6AC2646F"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZXgg2TfHeIQ7kNvwFbpLZc&_nc_oc=Adq7oYek9CiV1f7KkuIKftrXK1wWW3hk0W1mOGTHDyvvrxPdgoVTi-BT28uvzkSPnHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYG_A57vI_VsYD09t6AMk7CZyAFRvxdQjug_MQvQ5bsQ&oe=6AC263EC"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WJje970k20Q7kNvwEugj5x&_nc_oc=AdpLLB3LJtwtdHJ
197394_3861630374355708785_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXrNzs0YHwoQ7kNvwGkS0kF&_nc_oc=AdqpTafgK1dzzClc90MiQyWDMQFDsWeBVDgslm11rIrOye9XnU_B-wfrrYHlQ_8xUaE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpOBhyAhgDM5ei4iYyIdfCytru3GDR7cmitG6rwhTSeQ&oe=6AFB3034"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLTBDzAECboQ7kNvwEhYU6n&_nc_oc=AdrxWLE3ZQ3c9oHHvyYLkU5i-8LIj8TdKqTrN4MwjrnwCr-1uPHbP02IEL6Ddq2T65Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYu618Q9zhnqMc2coChsHlrONpBKxWaMRR-fgqr1Hy2Q&oe=6AFB1EB9"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVDpgJIME1wQ7kNvwEL0w0y&_nc_oc=AdrZI--sj8oGjc2Zg97v9ilxL5hkCM8VET5X5HLX_itd6bMGgLnnXN-hrmSQB4zBw0s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-f9jr8X9SYJU3hXDlsZOZ-i5_aoKDZHFNvAnwKHRSFA&oe=6AFB1CB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT1dHugn30kQ7kNvwFVQ6xG&_nc_oc=AdpPEE6xsDciVbgoTzfnp1YGeNMXmrYCSTZBSVbT-Pcef2xfv0IY_pGTUnpD0ioUIuE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpCRXZDeIXQw2QpN0CQAGRe6o9chqH0yutcJLYMN3Afw&oe=6AFB14EF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAeF0CFtE3IQ7kNvwFGd6qP&_nc_oc=AdrLZrkv9mIAcDbPJtzmFTUM0oQU4C9_48AzEQ-KD05RZPsLbaBgTjQ4DtFgVVnBwHI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAkvsRbZWGQ8QQ_VkFA_2XK2pTHkBgR
197394_3861630374355708785_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBOV3jGLMJ8Q7kNvwEk_MBq&_nc_oc=AdpxD9DiPs24fmy7y5yumi-Sxt51PqLZDJcCrFp1uox2swwn3FQB-MNls7xJteWeEME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTloMWXE9G2gR6gHvSI1TTSc5hC75VtWu21dCVsyphI9g&oe=6B070DB4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l8bIiWCzYsQ7kNvwEQgXI8&_nc_oc=Adq50EexdVt0YYw3oFsQ1yqvKYCMdon6wVgGcCBkhwcDhK65cOUY_YJ5IMGNsjz1Ouo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShhZoT39z20WXXEQqvNRyDbonyxen-iieAeLZtcONarQ&oe=6B06FC39"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOpN9JUkF70Q7kNvwEGOnqt&_nc_oc=AdrTABjXfJK-bIWCeJsgtomkQHRy1yp8H7P3hG1JAoGX4o-rGUI7j4MHRpcoDp7a7qg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVtFdlBr07MNF0voAsgLxJj7U-jpQdwXpR8WKxtgpMLQ&oe=6B06FA34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDpWoYqOhhwQ7kNvwGfmak8&_nc_oc=Adp4AVEjyg1ybKlNYl9yu9HKTJ9hLE6-lF97pvoqWMt8qccz77f_O1Eowuc9GwyOabA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIEltIcapvC3ahusyiDBOcSUMsoIpNxBSgHfEMEseIFQ&oe=6B06F26F"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oddIEXvzuoQ7kNvwHGUTDO&_nc_oc=AdrJjquFxVP_PMKM5RtLIhmguqQ2OPtqr62lFWKKoyrZOoPvTX4RlmSa14Yw8FoTyoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2TM85kBD3AtOofx6Df__6M2cEw_WUF
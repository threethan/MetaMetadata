oh=00_AQLk0xze1wbFCwq6Q-sMEZP7FJmoqp3gapEOluaDBF47ZA&oe=6AB3C6F4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlrlF2AObE4Q7kNvwGrw5GI&_nc_oc=AdosjU1qtA_XOtEhINwYduOUiywXotagxlQ13tSqNtoTYTRwSzfxC2hrqqwuJ1Kw8QY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6HOO2rqrPvRsvjsQmgney5CdFvghzjGmg4uUj4iuKNg&oe=6AB3EDB9"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpFZTTfa8NwQ7kNvwExWoDs&_nc_oc=AdrXY8MkomeB5C5KhHvEQTSEGbViq5rW__6BqSaGhDYKn3ciwsCu1d67mOH8MsdLffM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFZMcNNkC-Y2eHjjwhWZWj_l3rCpAQVtFz0UFXnZPGJw&oe=6AB3EBB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_UPyjfjUSoQ7kNvwEWgcLs&_nc_oc=AdrgEm6dJcn3uawwyBA-wfPuRk7lclyusyFjGOYSYpmKkORTuR-jjAUwCF-u0gDUa2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcN9J6GLjBU97N6VYlqnoagZ9rvqSoB43iwrLzlfwsHw&oe=6AB3E3EF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LpVgZKpSyEQ7kNvwGkOpLm&_nc_oc=AdrfJbdhQVV9EjQ5YALESfFtSzFGJMsPhCVrwnWpwE4YBUmPTNcmMCiXMChNA05Mtug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmTN8q02O-9LPRN5UogQ4pL473ebucLlvK2TwXMR5ofA&oe=6AB3E36C"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0kVsCEBbF8Q7kNvwFbSTos&_nc_oc=Adou8NOdoymr_Nn
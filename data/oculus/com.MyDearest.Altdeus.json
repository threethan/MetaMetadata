197394_3861630374355708785_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N752TB0RNsYQ7kNvwGBdzMx&_nc_oc=Adpx8Uv4FbSQVtqpI5UNfvOsTg6tO4VgGKdLiaqSnKWFiPKRrk3eB6EjebvI2P3gLM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyl0wQeMLztr_dCh1HmADWS2J5jyqjP6vVhRmQRUMU5Q&oe=6B104834"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyGLUS6IhsoQ7kNvwHUDviT&_nc_oc=Adr0oelP7YrMaj_kPoQdKyl9XnCzGfbn44t-B9vC4hrqY-Pn5moAc9r3_3bslK9YpQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXWlL8YP5j3dBUb0lGFWni-a04xKMvTzORPru-oMsQz_A&oe=6B1036B9"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lrxm5PyvX30Q7kNvwHt7EbV&_nc_oc=AdpF6GbxAbj-ij_39obJ51g0DuXWXyTtHek0HjwjAsAwdRINxrqT1kpUWf9z3iezfOI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWsYeN8XuCfSBUBLJ27QoHL1hArPdCaS2Py8Qja6cEfzw&oe=6B1034B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJMj02G6AakQ7kNvwF8-W2V&_nc_oc=Adptgk-j12dKBSsXZSRQk57T9RcNY8IuimnIt7d0Q8vvpCiJm79RrrH4vBZJr7EDhvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuE_4OY_QV3rjZIGq9xakmeSAS17TzgoO662-TF9JQgQ&oe=6B10652F"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om_FBElBKxoQ7kNvwGP3NAs&_nc_oc=AdotFZ7vlyeS7K_CDUBuClBIFrMUKIV9-K-XeWk6AWrENLK39CM8Im064Ey-KIjTTgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVb4Fg_0KJK5nO3tyR1P3xqG1Rx1YACc
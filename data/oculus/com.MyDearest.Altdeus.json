c_ss=8&oh=00_Afw9HSBSrgqL73K4NOHMquU-HCRnOyNdy3UH-i5DmSddDg&oe=69B3F279"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YDqP_KPhYcQ7kNvwFiNE1I&_nc_oc=Adkkb17JTRqogw2oyaym6aBq1aLD8BTuQMwX_YNZ40OSdh3EJSNT0XMiQ9HDjCE09EA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwu79gikfVGXhJmXEf_bSVymxi23ljFnkrCdRACnMsn4w&oe=69B3F074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnZCRMtok1AQ7kNvwEN404y&_nc_oc=AdlntLr8J0tgU-V9YZmW-lHPcnvqaAp0sJLPZVo1b9Aam8oFPhtw1Fxcu6TAg0lOWg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBR6SZ6f34f5g0CBDz73GR93wQM_eT3VEkvlV21e6AyA&oe=69B420EF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ogJkG6DJt4Q7kNvwHw1OUJ&_nc_oc=AdnZlKDUvgmCA6o6XGD-DvsiddQCRO93-h_d8bmjgcqHolhGbCBCHUkpi2QUu_too5s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyCUmsimO8myadySpY5uEWLrJeQT5q2GxQIf7Kfd6vO_w&oe=69B4206C"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KidqWfPoKYYQ7kNvwGflRF9&_nc_oc=Adl-BUn0Tn9rIKdl14Gjt2JYvMEYkUVv8ETbUtPI9IQllhUKL8dEq9sr121HxlFwjJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxG6t-pmXA335p1ySw4_AQIrTICnYDIjxVo5hTIfBSlkQ&oe=69B40EF1"}, {"file_name": "75292488_2711827285699173_9164718924552926630_n.png", "id": "1698153337036670", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54770913_1698153340370003_3797474642646423738_n.png?_nc_cat=1
oh=00_AQIxiv7ECxSvmB9Zjgem0DXpdvvBUqS09SI-5Tw8AjlsDQ&oe=6AA54674"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uu_MMl0aNEsQ7kNvwHdqPQl&_nc_oc=AdoTwcHQ1fR5Ur7O9FlSqs3mNyn_F8NB2OqBV8wmIap2LtMmkJJGTLPUpRH1ee5vfXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRjE20FTEQ7pjK-CgyUEkijk-dC8NPbEcL7oQOCNr6Dw&oe=6AA56D39"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmmykR0eSZIQ7kNvwFoPtcR&_nc_oc=AdonxKOmZs_ROmBPY6eltADxJro4GNhp5qq2rL-1AGGekFZt7ynmpUViXfHVN_eKaM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkiu8mkqvZHWx88IiclRkW9UtEDSIZuBTX3-BQ9m7XnQ&oe=6AA56B34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25gpUSRfx_8Q7kNvwFahzsY&_nc_oc=Adr7Fze4TXnEV0a_AG0pE_lY1Jx-LE3PAdMwz7rb_pRkZVV0o3mJNG0AZnns9rmXmi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpEqFiq8Cg02ozXOko2LEclRe4QrBpEdwzmzQuMu-S1g&oe=6AA5636F"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWcjbrFM-bwQ7kNvwHorge-&_nc_oc=AdrmRcSnaU-JI_v605X106QIuwsWCh1rWnDH0o75isNzVEm2W6y0rQXB-sVUEZmROFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6gnb7pxQrUqutRIDFAT0ORMAhTxdDkRlcBlmL_ATBfw&oe=6AA562EC"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDpp2bjm-EEQ7kNvwEPhE71&_nc_oc=AdoZSHxcefMt1y1
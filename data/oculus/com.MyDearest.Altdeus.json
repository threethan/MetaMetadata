197394_3861630374355708785_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBOV3jGLMJ8Q7kNvwHVDcHb&_nc_oc=Adp0cnV54inow9XMGYEgpKeaERGL5LfOB7wnlF9udgR8THZYKEss2WFUyoZm67qeQRI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZvvlPA2WTsBB7ugfwGTsg_rr4uzgr9Tab-XSlPeWqDw&oe=6B085F34"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l8bIiWCzYsQ7kNvwEdJVd3&_nc_oc=AdrqHsLnPObT2sx6TeOy6Lsz63uRrODYkkEFGByDfqShCbHP5oYwk7TPsek6nXsIxr0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR947Co7y7baw4YweA3hWnR8hDUsk1Mt3DTgM2TKGteog&oe=6B084DB9"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOpN9JUkF70Q7kNvwF3VGA8&_nc_oc=AdqtEHFAgttg2HnmR3O8tuKWTcMQpXyOnMnyAQfjGvP4exmqwC61TZXgoKicWMtlWY8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUYqryA8EuFQbXqpmG7qDxA6FkJMJ1yXo7eO-OIwibSw&oe=6B084BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDpWoYqOhhwQ7kNvwFTb_2n&_nc_oc=AdrZKDqChMy3_FFHTS-FCkXQ3sTNUuR0X52T0LVGcFNcAoN7bDvXfnPmXInGa46iOzE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThMvq2RGlgxNKUYHuaC1KDVZfVsz8gaNPEftAGhuUSbw&oe=6B0843EF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oddIEXvzuoQ7kNvwECGdt6&_nc_oc=Adqm1St5mxqZKN8rI08XPvXe47NHpi_fGAfZzrXHRWw4ITBslGJi-Dtl7qZkNWLIFpY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0I8oaQue0zZS3rf2CDhbNmz65C_fBP
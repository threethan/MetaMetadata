c_ss=8&oh=00_AfwgxGVo1xjJMic4rAtcUnmnB0KvwrHnds_U146rS3kcQQ&oe=69B69579"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y50YvXNdsFQQ7kNvwEO3T_F&_nc_oc=AdnfN19echLlsrAxs5zUJdgsTfQzvRXAXLmdLzHgHkQN-j_cZP4wTiKLGG9x-5wtevI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAyuLMTxdRYEqsJ21dWUK1-Vhez-PsQnnU6oSI0vV_0Q&oe=69B69374"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_Aiy7lLH-cQ7kNvwEd24Bd&_nc_oc=Adl6TjLExQJatu-7b9pJPUDqG5gnNXqIQFaTF4LVhORf6H8RhTqnT9RbK2vyOQiF-V0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYtxsJwSEEuqmmm6zmHl4GML_z2RbQXRbU08ZhHaVa6A&oe=69B6C3EF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AesmQ9gynIQ7kNvwHi0R0B&_nc_oc=AdlgJmFweouZtv9B3jlY6d-SQ4MGGyR4prH77rMHE0BI1YvQLkKXOiwnVotjNRxGfjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAJ3kE2flPlWinGilLPKfY39GSYrXwNn4Vlg5mdVo1Ng&oe=69B6C36C"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjz0ffJ0AkUQ7kNvwFzmmhb&_nc_oc=Adl0OD2cAgH_M-x_Pb5zAdOwi1QGHQSp4opOU7WGD5spxbSAi43Pr1-Wdo_QifdtUpA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu-Zgiw9E5JMVgO_usgQd0SU7gCf2pbrkU48xnQgOYng&oe=69B6B1F1"}, {"file_name": "75292488_2711827285699173_9164718924552926630_n.png", "id": "1698153337036670", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54770913_1698153340370003_3797474642646423738_n.png?_nc_cat=1
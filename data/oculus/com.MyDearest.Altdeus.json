197394_3861630374355708785_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXrNzs0YHwoQ7kNvwH4E9vd&_nc_oc=AdpRefJWOEcG1Qbm6xyZY-FOipluySNpBbho2P07qdhuFRxiPsF6_al6AZW5jPoR9ps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThuqY0J9Ejv32dDafKzo7hLInwU53lnZBawMaAhrV5pg&oe=6AFC81B4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLTBDzAECboQ7kNvwE_glg5&_nc_oc=AdpLRcoXy6H_TlVG3Z6m9Mifkpb_ytOIcBY4Sa9GSiQu-zPaisIzCt2yK98-SNgq4zk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAPDmGed0xdvSljkxW7LKDzBelvxUvaGyItTdwQkwlhQ&oe=6AFC7039"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVDpgJIME1wQ7kNvwEkg6-7&_nc_oc=Adp61ZnCWtd1esfwC8Gtb8CUqHlJ6Ji4UJvL7BJibgElqzB6uw6QgcH719TsU4NtXaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxlBI-PNKA8rPpaCgZ0Qob7RAHaN5JZBjUK3KuIrKqvQ&oe=6AFC6E34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT1dHugn30kQ7kNvwFwYhH5&_nc_oc=AdoJAc-NzAw7VHWGLeioUd1zpeaI6n6pwuklpPSFPGqCiqb-r5a295uttRQcvevpN2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbN07dN9Lhb4tRE4NMRHzJ6V2_gMUzQqQZcVSNDlD76g&oe=6AFC666F"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAeF0CFtE3IQ7kNvwEe7Y05&_nc_oc=AdrYN7f8ePiDge1OPus76KYzbqfFmorSvZzLwFSRFvyf99qDc2gMjbd9XiuN7_WXyd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJptqTrYk9B_mjVSJnxM8h7ERoLgqM_
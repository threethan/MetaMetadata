oh=00_AQOiX_fmCiKg3jnJuk3A0BkSfoxd8ai4a5KbzPaCsDftwQ&oe=6ADDF6F4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a7eY_AWI78Q7kNvwHsIslI&_nc_oc=Adpt31Aq_oAbhLggMiPHm4zc5xPkCvnMIBtSbbIGlCEOoXaxWMhPBFJ-RaP61FVYlVk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZSUle_lMDDW7i-ZpA85xzVyFGbkxeozWBb2ZR5Lcv4A&oe=6ADE1DB9"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wmy55VdI-M4Q7kNvwEnloRT&_nc_oc=AdordFQglQ05GO8f2acdlyj6VKWLT4votFChdSjIHXZP2vNkpVuTzyNgt1gW1ybPLa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOheI5F9hHMgMVfZuAeoAAEgMqNinYlKbRuuLCEwJXWyw&oe=6ADE1BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjNvGoxtbmIQ7kNvwFLFpKA&_nc_oc=Adp9DM_PxJ07olgx4iBXZsxOiGs8QgHBYbiMIynsNq1Z-lbQCOlsObVsBy4fw4deFYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORA-tuPjUihUrk6qn9C0DqiNcbPy0i3h_1qYOeruq_eg&oe=6ADE13EF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbct336tbcgQ7kNvwE7yck6&_nc_oc=Ado1Oohb_f9o_cGL8PXcz8GVl4-ZQ8hDlWqDQMUwEhT9Gf0noxSQZQF4rhbbf-dLNhs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-YFqK4EudxxCeYV_fRN9aaDKrgsy3hWuAa0ECwULldA&oe=6ADE136C"}, {"file_name": "75195903_820598405369726_3225761644119553739_n.png", "id": "2919710161687177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031622_2919710165020510_2929328724112360960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbc1DNM4OusQ7kNvwECr3Uq&_nc_oc=AdpAtPR0gmveTsg
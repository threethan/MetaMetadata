197394_3861630374355708785_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LRpELO_P_QQ7kNvwEE4BJE&_nc_oc=Adq6_XvyTTXE2u9E2q9nwdJj14irt1ZRXbryfojrTTQtUN6KllPSKKw0Tk6BtAXOI5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9pm-7uxqMUJca3OGbng_ATigGxkMyyq65_0ZaKNzIlA&oe=6B01C7B4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29mmhfYPOS0Q7kNvwF5CeMz&_nc_oc=Adol0tSP9YjfcxOUz-AxplCyJd4G4vXO4p7j4hjoAZqYe0vVakgocYVCD-EM7Gb8sac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Ofx4j768o7gRVAAIMo6e8kz8KZtMR3gzxyXH-E-7mQ&oe=6B01EE79"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaMi_4JOjQEQ7kNvwHKSJx6&_nc_oc=AdquYCQE_a-gFU2TL0QoUQQ0SCom16b3_crA15WeaKvrHS-IrjP4EiTvFYts5HaBcsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4VsJXZNvNT0O1XMJKZ3cVkt9b1zp8q11HUOJY1UuRJA&oe=6B01EC74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyjgAO8F5bgQ7kNvwE8kaLh&_nc_oc=Adop5EvfS3ViKWgFqB4XngmqlX2w9XoH_WIIxU9P7Dzb7GF8yWncT_6-c2Q3G0z0I7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPaAg-gAj5msT-scxBrUoejQ-SHKsJZqBXIC14X-2R0Q&oe=6B01E4AF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CXI2fXMNrcQ7kNvwEBiAgB&_nc_oc=AdonyVKldXEUf2rEVIF0308_chA2q1ub_duorV2fcPbf9B2rD-Q6G1Ub5DE8TBQh7s0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDmFRdKFCALlsur3iVE4pm-rUxwjJF9
197394_3861630374355708785_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIvuik5NRLkQ7kNvwFsmnuK&_nc_oc=Adp8CTbtNGYCkgXRDVa1NnlxUxpavJhi5pAKkegyUD6bEO9W_mtFl5-rSbCwwNFH9JM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn6KvIpllSNbzn-Zz6E-wmRuyWB47fhsqlOplrq2NKcw&oe=6AFDD334"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxVGgN0siEYQ7kNvwHm_zkD&_nc_oc=Adp0WuSxr0Hr-O8I6zgKAYqBcvcpVGf3q_lh6B4tt8rQj1XlCroGn1TnaL2HWjAAyZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw29mQI9IhBOF8Hpjs9zrNb-TB7D4mhBmwyspIIFp7Bg&oe=6AFDC1B9"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_IeLhy8i3kQ7kNvwGJO769&_nc_oc=AdoUyDK59TlZCCf9tjkoHuZlXT8ZiOVSdwlCKHHNWU29QiIMLWp9jWywTFgfiZjmG1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4H_GtkR6mYyGL2mCBWHk6N0VZhcSa6uqRHehJ-s4yMA&oe=6AFDBFB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT1dHugn30kQ7kNvwHmBjPR&_nc_oc=Adr-sHJ95HrB4lVsjpME014-wvqUvbYQ27f5vOtjLa9DNZgsjRdbL9QRQe4vodEFvlo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb71WcxLmHsq-yRYqp836Q3YvrJXhW8YnZil4-qFMe6Q&oe=6AFDB7EF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gV6GCoAZF4Q7kNvwFFi3V0&_nc_oc=AdruRTc7EkgRJ1fH7h8cZHwpVtmGklFRXWl2d-dld3x2s2riauF6Vlob_B08rPD5Gr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMAbcDKfz7nF4ScMhpBR23jrRtjLAuJ
197394_3861630374355708785_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LRpELO_P_QQ7kNvwFcTZP1&_nc_oc=AdruOoF1KOu-YrY2W06uYpn_nPS16qqdo-n5g-BvQgsy8Nr0glKEfEFLhA4iMe_6JDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzSViNS6loYUC4Tdmp58PBXU2uZMR0oCX6UPMdRhqrFQ&oe=6B046AB4"}, {"file_name": "1.png", "id": "709891966382718", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569460_709891969716051_8502161060697587717_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29mmhfYPOS0Q7kNvwH5pMWT&_nc_oc=AdoQtWzqJqBcVgfX8weIN6Hja69olBxTlU3OdMK-5ECYti31m9BFnzUjOSdis-q0_OM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaq7wuVJ2qd70aHSfna6suFJ_L67K3FYxC45sjZZN6tA&oe=6B045939"}, {"file_name": "4.png", "id": "397170391541946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195906_397170394875279_9128241455594099915_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaMi_4JOjQEQ7kNvwE-auh3&_nc_oc=AdqVoaj0XMHYGSHBwK5D-rB70bjySFwl-5L_gsuxwk1zzAQ0CmSxm_gfP2uzOiSRV9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBKZbvg8MSnPwTSTohfq4DMS6AdPK40Jp6XArFhyfJBw&oe=6B045734"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus.png", "id": "293952722081199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_293952725414532_5233729569157977764_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0tOpMSpH-EQ7kNvwGQBllQ&_nc_oc=AdpbHM76BO8UTNaspnDVxlPB43qh-5TXd_AXr6fbq8pepH4zGbuiDFqLO8ABygWlPvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7UdoQUw6oSCpyjZM6ZjDXo2-UfaBceUQtFy5g9E_DdA&oe=6B0487AF"}, "display_name": "ALTDEUS: Beyond Chronos", "keywords": ["Battle", "Exploration", "Story", "Adventure", "Narrative"], "long_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\n\"I found myself completely immersed in ALTDEUS' story\u2026\" GREAT\u2605\u2605\u2605\u2605 \u2013 UploadVR\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\n2280. You become a mecha pilot of a military organization, to defend the underground city against giant enemies. Even in the future 200 years from now, the proposition of which one you choose doesn't change at all. Your choices and actions branch the story leading to multiple endings.\n\nMyDearest is an independent VR publisher/developer based in Akihabara, Japan. We released TOKYO CHRONOS in 2019, and the game has not only won several awards but also gained people who support us. We'd like you to enjoy ALTDEUS which has impressive directions as well as unprecedented stories.", "short_description": "\u201cThe story to draw and the big scale production that makes full use of robot battle are excellent.\u201d 9/10 \u2013 IGN Japan\nALTDEUS features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. Your choices and actions branch the story leading to multiple endings.\n\nThis game contains multiple unlockable paths - don't stop playing at the first credits roll!\n\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness."}, {"images": {"nodes": [{"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30d2\u30fc\u30ed\u30fc\u30ab\u30d0\u30fc.png", "id": "4223279501109476", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_4223279504442809_3739855637233883216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CXI2fXMNrcQ7kNvwGIrxsX&_nc_oc=AdpcrUHB4XUGQbFEhvlCCKSkdhJMzm9uPJj5NWUbwiwY3SjkiumPqlG25VERH7X0PGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ15JTqKRKO0oG1TBkMCjgcxft71E-zc
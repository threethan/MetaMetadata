-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyG3ybYJGz37HYBh7-OAKNMYssB4GgweEzKCOy0Xrgzw&oe=6A8EDEAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus3 (1) (1).png", "id": "482446873022743", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974704_482446876356076_8690520893536344395_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4tJsUjhvfwQ7kNvwGcxKti&_nc_oc=AdrOzTQRc-An_VXQY1X7IuY5d5D5dnV8dm-w9n_sFoTBTMFcaSY99fAUQob9OmapR5w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa__bvntyUU75clIBdQSy93snX_YynOVqtbPzNnf8Pfg&oe=6A8EC7CF"}, "display_name": "Exxar Huddle CAD", "keywords": [], "long_description": "Design & Engineering projects suffer with rework costs of 9.1%\nStop struggling with painful design reviews, poor ergonomics & delayed client approvals.\nExperience the market-leading Enterprise Virtual & Augmented Reality solution for CAD.\n\nStop Screen-sharing. Find issues faster.\nEngage better. Get more feedback. Detect operability issues. Keep stakeholders in the loop.\n\nWith Exxar Stream, the data ingestion engine you can publish existing CAD & Design content directly from your favourite 3D CAD application. Stream enables lossless data integration without the need for manual content creation or data conversion steps. Stream integrates with all major CAD applications from Dassault (Catia, SOLIDWORKS), Autodesk (Navisworks), Siemens (SolidEdge & NX), PTC Creo & Aveva (Review, PDMS, Outfitting & Marine).", "short_description": "YOUR CAD NEEDS REALITY CHECKS\nFaster Approvals. Reduced Rework. Delighted Customers.\nBusiness-ready Reality Visualization for CAD data.\nConduct Design Reviews in VR.\nMonitor & Inspect with AR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.exxar.cloud/privacy-policy/#:~:text=Through%20our%20Web%20sites%2C%20EXXAR,permitted%20by%20applicable%20laws%20and", "developer_terms_of_service_url": null, "publisher_name": "Exxar", "support_website_url": null, "web
scdn.com&_nc_ss=7f20f&oh=00_Af9u61SjN07kqgSKMFZ_bLhO_XEAIb2d7pufcY5Fqj4J6w&oe=6A36C26D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus3 (1) (1).png", "id": "482446873022743", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974704_482446876356076_8690520893536344395_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgZKD0h090sQ7kNvwEWSHTf&_nc_oc=AdraFujYnX5AlagIo0xCSToGoAyMahCpplZ9KaoxI51Whj8oLwQJIduLgp6PxKSZWeE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o4GR9C3LroJnn9Smk9oArekp3LrtfQZZLQpyaVeYrGg&oe=6A36AB8F"}, "display_name": "Exxar Huddle CAD", "keywords": [], "long_description": "Design & Engineering projects suffer with rework costs of 9.1%\nStop struggling with painful design reviews, poor ergonomics & delayed client approvals.\nExperience the market-leading Enterprise Virtual & Augmented Reality solution for CAD.\n\nStop Screen-sharing. Find issues faster.\nEngage better. Get more feedback. Detect operability issues. Keep stakeholders in the loop.\n\nWith Exxar Stream, the data ingestion engine you can publish existing CAD & Design content directly from your favourite 3D CAD application. Stream enables lossless data integration without the need for manual content creation or data conversion steps. Stream integrates with all major CAD applications from Dassault (Catia, SOLIDWORKS), Autodesk (Navisworks), Siemens (SolidEdge & NX), PTC Creo & Aveva (Review, PDMS, Outfitting & Marine).", "short_description": "YOUR CAD NEEDS REALITY CHECKS\nFaster Approvals. Reduced Rework. Delighted Customers.\nBusiness-ready Reality Visualization for CAD data.\nConduct Design Reviews in VR.\nMonitor & Inspect with AR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.exxar.cloud/privacy-policy/#:~:text=Through%20our%20Web%20sites%2C%20EXXAR,permitted%20by%20applicable%20laws%20and", "developer_terms_of_service_url": null, "publisher_name": "Exxar", "support_website_url": null, "website_url":
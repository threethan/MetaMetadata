477587362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86620692_400783480920695_7956356220698634711_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFdf62gW_9sQ7kNvwGqX1O9&_nc_oc=Adr-28AoFizXSZZ3S_0378F4nBfHRRdx45qcuvmEp0bK0P4Bumy1zhzqdT6a5cn0yDA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZkbJaDOu82ORrHi_YnQYh6E6g4IkXMI9jOSsfjZpvyA&oe=6B1049ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus3 (1) (1).png", "id": "482446873022743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974704_482446876356076_8690520893536344395_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHlg43TXyowQ7kNvwEhrhVC&_nc_oc=AdqDbNTXSzlYEQhuq_pM4COpyIDvuiKE2PPL5bxJmZD77rXYm6oNwoyO7ygEhz9akfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJMOr-gMSlPpa14wbZ-fFlM2aNFiOnUhqJglr4in4_kg&oe=6B106B4F"}, "display_name": "Exxar Huddle CAD", "keywords": [], "long_description": "Design & Engineering projects suffer with rework costs of 9.1%\nStop struggling with painful design reviews, poor ergonomics & delayed client approvals.\nExperience the market-leading Enterprise Virtual & Augmented Reality solution for CAD.\n\nStop Screen-sharing. Find issues faster.\nEngage better. Get more feedback. Detect operability issues. Keep stakeholders in the loop.\n\nWith Exxar Stream, the data ingestion engine you can publish existing CAD & Design content directly from your favourite 3D CAD application. Stream enables lossless data integration without the need for manual content creation or data conversion steps. Stream integrates with all major CAD applications from Dassault (Catia, SOLIDWORKS), Autodesk (Navisworks), Siemens (SolidEdge & NX), PTC Creo & Aveva (Review, PDMS, Outfitting & Marine).", "short_description": "YOUR CAD NEEDS REALITY CHECKS\nFaster Approvals. Reduced Rework. Delighted Customers.\nBusiness-ready Reality Visualization for CAD data.\nConduct Design Reviews in VR.\nMonitor & Inspect with AR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.exxar.cloud/privacy-policy/#:~:text=Through%20our%20Web%20sites%2C%20EXXAR,permitted%20by%20applicable%20laws%20and", "developer_terms_of_service_url": null, "publisher_name": "Exxar", "support_website_url": null, "website_url": "https://www.exxar.cloud/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "UTILITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "482834339982071"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "995268809178578"}, {"status": "PUBLISHED", "id": "391517725669935"}]}, "baseline_offer": {"id": "995268809178578"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740668100, "status": "PUBLISHED", "id": "995268809178578"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26093934073556965", "version": "2.2.W.7151"}, "id": "1377425615969442", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4193911303985890", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2609
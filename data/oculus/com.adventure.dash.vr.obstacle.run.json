culuscdn.com&_nc_ss=7f20f&oh=00_AQQf79vcH0m8rwe_zTK0YrhJLBN69IjRoW9ZYUMPlB_r3Q&oe=6B05B807"}, {"file_name": "screen_2560x1440_2026-09-30_22-24-39.png", "id": "922142450689891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596061819_922142454023224_6782391794950575409_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc-V45RPkaUQ7kNvwF1M_0D&_nc_oc=AdpzhFcrl22cz1eWP2f1KApRFHdKI_mjIG8WRysA0E_yH18UmgBkV6CmpYr70_v-oCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1_61yA4Ggdwvo83aL4Li2bhdECoxLLTZfGvh04L37CA&oe=6B05B049"}, {"file_name": "screen_2560x1440_2026-09-30_22-23-08.png", "id": "1381883681669643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673716021_1381883685002976_995441291212889214_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LT8yP4rf_DgQ7kNvwGoydXJ&_nc_oc=AdqyJxZTaHtSYhMoeGa6DZB1Dyd0dr1CuAAPVm0w0ysHA9kZxf4t-qgkdbhcjwyBe7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReScM1i1jJd-0FXII1wv2WornPR4BowYQJMnWz7VrFHA&oe=6B05B896"}, {"file_name": "screen_2560x1440_2026-09-30_22-21-16.png", "id": "1820514969264899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673716021_1820514972598232_981184524439913566_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5mvuCh0m94Q7kNvwEdCrRJ&_nc_oc=AdoTHePr0X8fBZq3cjkwSMznfqINhBUnI2DrjvpCoIo97bRZNNwjoaN7aSM8L_DMZho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGW03nST9myFIovz91yrSo0lyF--QRFbImsl5YU8FGkQ&oe=6B05C86E"}, {"file_name": "screen_2560x1440_2026-09-30_22-25-00.png", "id": "28232918776407176", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604317775_28232918786407175_6224366831103391981_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG7zOk3Q-5sQ7kNvwHaOB-F&_nc_oc=AdrvUP8LkQtGdYfwBbvpFInK2au2n6K-HdBKD92BVgM3zB2eDghc0zfHEhKZFpdSYSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzTTwBUm1HfQPuGGy__YFdoz_I9pMClyc5rT6kjYmS2w&oe=6B05C38F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape Run", "keywords": ["Arcade", "Action", "Challenge", "Run", "Runner"], "long_description": "Enter a fast-paced VR adventure where every run is a test of speed, timing and reflexes. Guide your character through colorful streets, busy marketplaces, rooftops and obstacle-filled paths while collecting coins and chasing high scores.\nAdventure Dash VR: Obstacle Run combines arcade action, platforming and runner-style gameplay in an immersive third-person VR experience. Dodge barriers, leap across platforms, weave through narrow streets and react quickly as the course puts your skills to the test.\nFEATURES\n\u2022 Fast-paced obstacle running and arcade action\n\u2022 Challenging paths with jumps, hazards and obstacles\n\u2022 Coin collection and score-based gameplay\n\u2022 Colorful Middle Eastern-inspired city environments\n\u2022 Increasing difficulty and reflex-based challenges\nRun farther. Dodge faster. Collect coins. Master the course and push your high score.\nMade for players who enjoy VR adventure games, arcade games, platformers, obstacle courses, running games and quick reflex challenges.", "short_description": "Run, dodge and leap through a vibrant VR adventure! Collect coins, conquer obstacles and race through bustling streets in this fast-paced arcade action challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
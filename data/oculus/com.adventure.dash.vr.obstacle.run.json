7kNvwEs6Og8&_nc_oc=Adp5iHDf1n5AdZgQwf9nij5MgHQtnf5ymbzo-frVgwyeXBgHyAjQIRODgt9EehcWBu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFHi3TPLH7QV5xkT7jUL6vz0ZMutYBfqLJ4Q0w75SWtw&oe=6B070A16"}, {"file_name": "screen_2560x1440_2026-09-30_22-21-16.png", "id": "1820514969264899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673716021_1820514972598232_981184524439913566_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEC77mfmTCsQ7kNvwG_0nws&_nc_oc=AdpcAJZ4-JwVUiz8oL187eTh4tZ_GjdY7r_YKZA_8mDqpvwK3py810-TY2l6k43agnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5jcBGhc_8_vJm6OQ_hMea7yn3aiE__KP7mv1IWa__Fg&oe=6B0719EE"}, {"file_name": "screen_2560x1440_2026-09-30_22-25-00.png", "id": "28232918776407176", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604317775_28232918786407175_6224366831103391981_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00zrPi2dE6MQ7kNvwEa_UY3&_nc_oc=AdrnMCURafjVASPHS50YBLy99JNGWC87Fbqcac_1AZOeWvvXPr_QQIlv-p53UZwJTwM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0SSchkmNRF8NJyzFDqvUIXfvcWQnkBSB0aSkTVZRX7g&oe=6B07150F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adventure Dash VR: Obstacle Run", "keywords": ["Arcade", "Action", "Challenge", "Run", "Runner"], "long_description": "Enter a fast-paced VR adventure where every run is a test of speed, timing and reflexes. Guide your character through colorful streets, busy marketplaces, rooftops and obstacle-filled paths while collecting coins and chasing high scores.\nAdventure Dash VR: Obstacle Run combines arcade action, platforming and runner-style gameplay in an immersive third-person VR experience. Dodge barriers, leap across platforms, weave through narrow streets and react quickly as the course puts your skills to the test.\nFEATURES\n\u2022 Fast-paced obstacle running and arcade action\n\u2022 Challenging paths with jumps, hazards and obstacles\n\u2022 Coin collection and score-based gameplay\n\u2022 Colorful Middle Eastern-inspired city environments\n\u2022 Increasing difficulty and reflex-based challenges\nRun farther. Dodge faster. Collect coins. Master the course and push your high score.\nMade for players who enjoy VR adventure games, arcade games, platformers, obstacle courses, running games and quick reflex challenges.", "short_description": "Run, dodge and leap through a vibrant VR adventure! Collect coins, conquer obstacles and race through bustling streets in this fast-paced arcade action challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1328779483657647"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1101312029359716"}, {"status": "PUBLISHED", "id": "1782147549787507"}]}, "baseline_offer": {"id": "1782147549787507"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1101312029359716"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id"
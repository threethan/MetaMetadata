 {"file_name": "screen_2560x1440_2026-09-30_22-23-08.png", "id": "1381883681669643", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673716021_1381883685002976_995441291212889214_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUdFjRRlVN0Q7kNvwGBGik1&_nc_oc=AdqmpMLFxALoWfl_0F8nWbwhZxaP_fB31fgI2_5DkkWI86qRgNNg8m05tJyrPB0hBvc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHvONLFl4RNKFaHsZjt7KbVI_UVVC06Er8BW0tXGhj9g&oe=6AF9DB16"}, {"file_name": "screen_2560x1440_2026-09-30_22-21-16.png", "id": "1820514969264899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673716021_1820514972598232_981184524439913566_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHdSrvQ_9F8Q7kNvwFNy7FR&_nc_oc=Adr3o5bujOMSfJ_McBMEYzr_BfJnBjw3ZHtvea2CEiQtJ-qhGwLI1NVmt9BVm-NdALI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPqeuaedXxdGHurIdLb-NH_g0fxlqyB5uIjr0tdcxJZg&oe=6AF9EAEE"}, {"file_name": "screen_2560x1440_2026-09-30_22-25-00.png", "id": "28232918776407176", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604317775_28232918786407175_6224366831103391981_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci2AKjAZKBYQ7kNvwGtIFrc&_nc_oc=AdrYoa4-A47mJFoLufH23d5uNCQ4J-V26_VVvTwSzAVJg4gV-O8f3rnvLyrEQPndQvE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXZl9j_vX6CmdwhFr7nVAlg2-JJrZElj5DQWnqN5GSoQ&oe=6AF9E60F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape Run", "keywords": ["Arcade", "Action", "Challenge", "Run", "Runner"], "long_description": "Enter a fast-paced VR adventure where every run is a test of speed, timing and reflexes. Guide your character through colorful streets, busy marketplaces, rooftops and obstacle-filled paths while collecting coins and chasing high scores.\nAdventure Dash VR: Obstacle Run combines arcade action, platforming and runner-style gameplay in an immersive third-person VR experience. Dodge barriers, leap across platforms, weave through narrow streets and react quickly as the course puts your skills to the test.\nFEATURES\n\u2022 Fast-paced obstacle running and arcade action\n\u2022 Challenging paths with jumps, hazards and obstacles\n\u2022 Coin collection and score-based gameplay\n\u2022 Colorful Middle Eastern-inspired city environments\n\u2022 Increasing difficulty and reflex-based challenges\nRun farther. Dodge faster. Collect coins. Master the course and push your high score.\nMade for players who enjoy VR adventure games, arcade games, platformers, obstacle courses, running games and quick reflex challenges.", "short_description": "Run, dodge and leap through a vibrant VR adventure! Collect coins, conquer obstacles and race through bustling streets in this fast-paced arcade action challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1392786570590271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831964_2058135644848044_3826923752703984353_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbS7DDy7TvkQ7kNvwE
png", "id": "1850534498963157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303679_1850534502296490_5973553729976984088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V87vkMlbg2EQ7kNvwF2GFcX&_nc_oc=Adrtc5Uyt1J5eHonW0_4AcWkO3v7125bmCvVcW11L6c8HOtu5CwN8wt1vwakbsG9KaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVRZKsuXzTigNIBtq7svmXYuQx4J7y02D8awcyO6V3AA&oe=6A6DFA14"}, {"file_name": "1.png", "id": "2357010984768049", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821704_2357010988101382_4629771682779575988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3FgFZonB5wQ7kNvwEvsSzi&_nc_oc=Ado1gTOsVznF0WpzKlEPxACbagWFIpoqAGywwlGkAwhzkCFSNWI_ExS_ZpUo0EH6on0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkObUczjb1Zgt6IPhvTND6RDsfSx5iQkRKHxU__wimJg&oe=6A6E08FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1265316735754508", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820428_1265316739087841_157962012105525223_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_grl5CWvbn0Q7kNvwE-7a8t&_nc_oc=AdrbNYvRt6hWapvMaRg0E0rbYf5IdPrFkGWDiI8NgFx7py0CLXvoE1UyeMjAwghq7gw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBceHtTOy_OM0Vzd4iW9B3J3wNNzF26dQJDOlAeg1eBEw&oe=6A6DDC67"}, "display_name": "Hyper F1", "keywords": ["Racing", "Drift", "F1", "Formula", "Realistic"], "long_description": "Every lap tests your control, reflexes, and focus as you fight to stay on track and keep your position against fast opponents. The immersive first-person driver perspective, realistic cockpit, and responsive steering make every race intense and exciting. Crash, recover, and push harder as you try to cross the finish line first!\n\nBuilt for VR players of all levels, this game offers accessible gameplay, fun racing action, and an energetic atmosphere with cheering crowds, race effects, and dynamic environments that make you feel like you are really there. Put on your headset, start your engine, and get ready for pure racing adrenaline on Meta Quest!", "short_description": "Feel the thrill of real Formula racing in VR! Take control from the cockpit, grip the steering wheel with your hands, and push your limits on fast, challenging tracks. Compete against opponents, master corners, and experience high-speed adrenaline in fully immersive first-person racing. Easy to play, exciting to master, and built for pure VR fun!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26197405933254331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619718_1408864140384198_3269286642696482150_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOTV2Ief7JMQ7kNvwFPaA-T&_nc_oc=AdpVbaOic3tI3LkvHR-TYHv3CYGfOASOnmRRzYmHjFa2T-k-IAOZd-M7rFzZ3IZ26Ic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiCbmH9RvwV7DvNX92M9CrP7p6DfI9_kn2-m2-II_kNQ&oe=6A6DD6D9"}, "is_concept": false, "is_test": false, "is_tri
png", "id": "1850534498963157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303679_1850534502296490_5973553729976984088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6XNhMouVAgQ7kNvwHEBD2p&_nc_oc=Adp1xeK8ogvslZ8JUIWUqKRacpPnnU6j22aHGQAlNEpmlvtEgpvboNLI7AW9rl23q1I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqdpgldHTvmu6q3LaUMC0OKKMyCWKhf5a2A6IuG63RLg&oe=6AF07E94"}, {"file_name": "1.png", "id": "2357010984768049", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_2357010988101382_4629771682779575988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoQP_QgQkQAQ7kNvwHNhJP7&_nc_oc=AdoA6n0Viq5NdNlwDPt8um8su4SjeBrEsvoRAf95snktkUJvIJy3FL3FjLXgusE3eH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe_TvShwN0VEtn5S0D_w3EplkvUZvcwQlGSlIsn_Ynjw&oe=6AF08D7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1265316735754508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820428_1265316739087841_157962012105525223_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvW1SpxWgVEQ7kNvwGlI7Zm&_nc_oc=AdqldktRxgLc7FjqNmFEPTGhzsvYiMSvtG8T6EQL9vcqsePdmf8LaUp4lq4AFKU9Ixk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsSCnt-7QcnzR7AmtW47WCD6nUUK7w5FMSG7AKq35Cug&oe=6AF09927"}, "display_name": "Hyper F1", "keywords": ["Racing", "Drift", "F1", "Formula", "Realistic"], "long_description": "Every lap tests your control, reflexes, and focus as you fight to stay on track and keep your position against fast opponents. The immersive first-person driver perspective, realistic cockpit, and responsive steering make every race intense and exciting. Crash, recover, and push harder as you try to cross the finish line first!\n\nBuilt for VR players of all levels, this game offers accessible gameplay, fun racing action, and an energetic atmosphere with cheering crowds, race effects, and dynamic environments that make you feel like you are really there. Put on your headset, start your engine, and get ready for pure racing adrenaline on Meta Quest!", "short_description": "Feel the thrill of real Formula racing in VR! Take control from the cockpit, grip the steering wheel with your hands, and push your limits on fast, challenging tracks. Compete against opponents, master corners, and experience high-speed adrenaline in fully immersive first-person racing. Easy to play, exciting to master, and built for pure VR fun!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26197405933254331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619718_1408864140384198_3269286642696482150_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkKv_X7AT0MQ7kNvwGFMCA7&_nc_oc=Adr84Sf4b8oxC9TJNm0m0mCh06OjOJfK38SLEi0iEL_Y4uaSXgCMsCkF6UDOJYkP0Ic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFh_IocPUKR98XPVIVSMEkEDo6e6heRr561R1ROKRIPA&oe=6AF09399"}, "is_concept": false, "is_test": false, "is_tri
png", "id": "1850534498963157", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303679_1850534502296490_5973553729976984088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5ABElwlJYYQ7kNvwF4uGkC&_nc_oc=AdoObgEHdGddkQzRi_wfjrDf20ksWnSepGfHivmMmwElGu9jQZWgDmvANbX7tQkSTBo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qbrVHyG_5k66Y0H1__Ryz4CBqfpFbyGRT9QqldTzIFw&oe=6A130294"}, {"file_name": "1.png", "id": "2357010984768049", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821704_2357010988101382_4629771682779575988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iJ_M-bjTIUQ7kNvwFJSs0w&_nc_oc=AdoamkFSp0BfkTQBwcsqibKSyKuPJQvTAO90Y_lOkMXaa_QM2RQg_gaH6QaWTgmsBpE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79MWGGtjL-bU8f-15BuL-PtmBLVrdd3KcRvkwh_wseMw&oe=6A13117C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1265316735754508", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820428_1265316739087841_157962012105525223_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNCa7uS9Fj0Q7kNvwHsO66w&_nc_oc=AdpbUMy1RvSgHbCNZLFv1c_gYiaOg2CYDFa86Nea7-KLAx0zjTKQttaNmsvQG_O2jFw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CDUcOA18Dm4_Sf3s7vVXu2RHAPNL0B5XpINm5oIPwow&oe=6A131D27"}, "display_name": "Hyper F1", "keywords": ["Racing", "Drift", "F1", "Formula", "Realistic"], "long_description": "Every lap tests your control, reflexes, and focus as you fight to stay on track and keep your position against fast opponents. The immersive first-person driver perspective, realistic cockpit, and responsive steering make every race intense and exciting. Crash, recover, and push harder as you try to cross the finish line first!\n\nBuilt for VR players of all levels, this game offers accessible gameplay, fun racing action, and an energetic atmosphere with cheering crowds, race effects, and dynamic environments that make you feel like you are really there. Put on your headset, start your engine, and get ready for pure racing adrenaline on Meta Quest!", "short_description": "Feel the thrill of real Formula racing in VR! Take control from the cockpit, grip the steering wheel with your hands, and push your limits on fast, challenging tracks. Compete against opponents, master corners, and experience high-speed adrenaline in fully immersive first-person racing. Easy to play, exciting to master, and built for pure VR fun!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26197405933254331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619718_1408864140384198_3269286642696482150_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Im22xF4AjGkQ7kNvwHQJqK5&_nc_oc=AdrD15fS5SQMj9nhtHy2i57IWeUcSbzUWuZ7Hz9FSpoOfHU4a_WTQuYVEKtWZvlyWqc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bmYMVjrCSFsrQoR43-aT_R8MkypSKfuMvUqIyDiO3Eg&oe=6A131799"}, "is_concept": false, "is_test": false, "is_tri
png", "id": "1850534498963157", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303679_1850534502296490_5973553729976984088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCAeQrYV3PUQ7kNvwFHy9lc&_nc_oc=Adrue4lzT97SNg6DH3jfzSO-4QnDiSv4BZxuKr0NSc1J6A0UbhSp2U3pMaUT496gmpU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6Nky5dzFSOAAIIMHQJCVnCbsPyP9aDQhpEOnBS6IMCg&oe=6AA16494"}, {"file_name": "1.png", "id": "2357010984768049", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821704_2357010988101382_4629771682779575988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sdZ9XasxPEQ7kNvwEgQ4mK&_nc_oc=Adq0oUAUa9INxyKjMgTfcyQqGUgZotWobC93mFIevWSrR-7XAj1lLsazG_Y7FTC5p4s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK79lMc5ZUrB1UjJd2h5EhOPqBqxdr6svxLNG80ebdQoQ&oe=6AA1737C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1265316735754508", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820428_1265316739087841_157962012105525223_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAsxjewH7WcQ7kNvwGwehvz&_nc_oc=AdqwVKQFqlG-SFslrm7t0eIj5zjKg9dNqV4TzFRtGblxdtTml5e4cHQ_0TG9SfcZnxI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ_QX9Ydfvwl51A9itL2_nZCK3LlzbgwlC-lztuAoe0g&oe=6AA17F27"}, "display_name": "Hyper F1", "keywords": ["Racing", "Drift", "F1", "Formula", "Realistic"], "long_description": "Every lap tests your control, reflexes, and focus as you fight to stay on track and keep your position against fast opponents. The immersive first-person driver perspective, realistic cockpit, and responsive steering make every race intense and exciting. Crash, recover, and push harder as you try to cross the finish line first!\n\nBuilt for VR players of all levels, this game offers accessible gameplay, fun racing action, and an energetic atmosphere with cheering crowds, race effects, and dynamic environments that make you feel like you are really there. Put on your headset, start your engine, and get ready for pure racing adrenaline on Meta Quest!", "short_description": "Feel the thrill of real Formula racing in VR! Take control from the cockpit, grip the steering wheel with your hands, and push your limits on fast, challenging tracks. Compete against opponents, master corners, and experience high-speed adrenaline in fully immersive first-person racing. Easy to play, exciting to master, and built for pure VR fun!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26197405933254331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619718_1408864140384198_3269286642696482150_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPysuBDMktYQ7kNvwFj0EpV&_nc_oc=AdoYKeM_b2w9T15dUZ8yN74G7n9t-_nfmLVSzP5Eaz7v9hY7pKde1jwcEJMIpQZnmyY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWGg_p49w0QqINNRwzA2aHPGSkAnlG-9Hz2_HQ65pRxQ&oe=6AA17999"}, "is_concept": false, "is_test": false, "is_tri
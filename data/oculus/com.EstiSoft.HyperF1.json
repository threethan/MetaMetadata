EF"}, {"file_name": "1.png", "id": "1181484764052885", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825305_1181484767386218_6597123290749557528_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCuZv9goM78Q7kNvwHEKeiF&_nc_oc=AdoVfmVOse0LfYDDRejdUpFj3LHo8twC-Be0AtwJOKxtAMZD5MvmXnp_bd0_c8CNXeU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHQIifxSQ2OHOAaYrDiwhJdGWOcXIy2fINI2oHMJqROw&oe=69C52989"}, {"file_name": "2.png", "id": "1194150335463970", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827601_1194150338797303_4744675177566914980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2LP91X61WgQ7kNvwFLF79e&_nc_oc=AdrtmX5lBjkL7GR_q8Fp92zU5QBoja7iiFuDgwBDOhSWz4G24cS53DdJpQYOrC7P0AY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0r3wTJhrxyd1HsM7TZlshc5_liHnHmIwacnr4_NANzQ&oe=69C523E5"}, {"file_name": "5.png", "id": "2606972236337867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818885_2606972239671200_1346648578008652317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caA6X4d7n4MQ7kNvwH9dLzu&_nc_oc=Adpnmhd1k-K0jQf9SEpn2Opcpv97Hye7HoatfIdHnouG1Sy9bPcoXquQC1-TDIQncEY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwn1X3OiiE4q5uUiHeeRLrMT9ugZeIqF4XOlPNmi4_jVA&oe=69C523B9"}, {"file_name": "3.png", "id": "670252502721099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818885_670252506054432_7213122013220837200_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5RAdUkSEvwQ7kNvwHfYdWi&_nc_oc=AdqHlokiHM4cdx2PWgeGO3R_Z0cXzkS0lbdxRHssZ7-SrcNSzpLFGNpMps5BquktitA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoCfr4fPUcp8fq6eAbT6WRWJZYcPzOCHdy22PAnzy-Ag&oe=69C513B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1183379597102745", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821725_1183379600436078_2104281030466738055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ9GVTYjBS8Q7kNvwFdqsfb&_nc_oc=AdoWk7UBn05Ws7Q4E2lJIRixVmstOy8ICVqM5B4v2cP_vg2GOrUoho4lwllvmOVfJ50&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyukcJTDQz_fVriWRWXMtxXpxcjMhHcKQ9N_UJKmnckig&oe=69C517B2"}, "display_name": "Hyper F1", "keywords": ["Racing", "FormulaCarSimulator", "Driving", "Fun", "RealisticPhysics"], "long_description": "Experience the adrenaline of real Formula racing brought to life in Virtual Reality! Sit in the cockpit, grab the steering wheel with your own VR hands, and feel the speed as you race through detailed tracks filled with sharp turns, high-speed straights, and thrilling moments. This is not just a game you watch \u2013 it\u2019s a race you truly feel.\n\nEvery lap tests your control, reflexes, and focus as you fight to stay on track and keep your position against fast opponents. The immersive first-person driver perspective, realistic cockpit, and responsive steering make every race intense and exciting. Crash, recover, and push harder as you try to cross the finish line first!\n\nBuilt for VR players of all levels, this game offers accessible gameplay, fun racing action, and an energetic atmosphere with cheering crowds, race effects, and dynamic environments that make you feel like you are really there. Put on your headset, start your engine, and get ready for pure racing adrenaline on Meta Quest!", "short_description": "Feel the thrill of real Formula racing in VR! Take control from the cockpit, grip the steering wheel with your hands, and push your limits on fast, challenging tracks. Compete against opponents, master corners, and experience high-speed adrenaline in fully immersive first-person racing. Easy to play, exciting to master, and built for pure VR fun!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24069528719375407"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2283383335503193"}, {"status": "PUBLISHED", "id": "1495666091533214"}, {"status": "PUBLISHED", "id": "1277458880813518"}]}, "baseline_offer": {"id": "2283383335503193"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768337460, "status": "PUBLISHED", "id": "2283383335503193"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26096449110016681", "version": "3"}, "id": "1928674631281167", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24069528686042077", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26096449110016681"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1928674631281167"}]}, "change_log": null, "created_date": 1772851268, "id": "26096449110016681", "version": "3", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb
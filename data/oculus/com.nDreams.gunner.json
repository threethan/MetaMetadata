ns": {"nodes": [{"id": "1368207159902538"}]}, "id": "599794280226476"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "387422848047994"}]}, "id": "550104751851527"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1268071846552963"}]}, "id": "1085354344839186"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "863891333657154"}]}, "id": "1605249656462620"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "860381734033768"}]}, "id": "263707433973387"}]}}, "firstRevision": {"nodes": [{"application": {"id": "863891333657154", "release_date": 1430463600, "is_concept": false, "platform": "ANDROID", "scheduled_offers": {"count": 5}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "855111337877978"}, "id": "1738538379706750"}]}}, "binary": null, "live_binary": null, "created_date": 1490613897, "id": "1224465317670709", "is_initial_release": false, "name_with_fallback": "v5", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "535632297615233"}, "release_status": "SCHEDULED", "id": "863891333657154"}, "id": "535632297615233", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "863891333657154", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1189514381139449"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2597373473724659", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gunner", "keywords": ["\uc800\ub834", "gunjack", "\uac8c\uc784", "eve", "\uc288\ud305"], "long_description": "\uc2b9\ub9ac\ub97c \uc7c1\ucde8\ud558\uc2ed\uc2dc\uc624\n\n2167\ub144. \ubc18\uc5ed\uc790\uc758 \ub0a0. \uc800\ud56d\uad70\uc774 \uc778\ub958\uc5d0 \ub300\ud56d\ud55c \uc804\uc7c1\uc744 \uc120\ud3ec\ud558\uba74\uc11c \uc218\ucc9c \uba85\uc774 \ubaa9\uc228\uc744 \uc783\uace0, \uc218\ubc31\ub9cc \uba85\uc774 \uc0dd\uba85\uc758 \uc704\ud611\uc744 \ubc1b\uc558\uc2b5\ub2c8\ub2e4.\n\n\uc740\ud558\uacc4\uc758 \uc5d8\ub9ac\ud2b8 \ud3ec\uc218\ub4e4\uc740 Samsung Gear VR \ud5e4\ub4dc\uc14b\uc744 \ucc29\uc6a9\ud558\uace0 \uc800\ud56d\uad70\uc758 \uc704\ud611\uc5d0 \ub9de\uc11c \ub9c8\uc9c0\ub9c9 \ubc29\uc5b4 \uc784\ubb34\ub97c \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. \uce58\uba85\uc801\uc778 \ub300\ud3ec\uc640 \uc778\ub958\ub97c \uc704\ud55c \uc815\uc758\ub85c \ubb34\uc7a5\ud558\uace0 \uc801\uc758 \uc6b0\uc8fc\uc120 \ud568\ub300\ub97c \ud30c\uad34\ud558\ub294 \uc0c8\ub85c\uc6b4 \uc885\ub958\uc758 \uc804\uc7c1\uc5d0\uc11c \uc2f8\uc6b0\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4.\n\n\uc778\ub958\ub97c \uc704\ud574 \uc2f8\uc6b0\uc2ed\uc2dc\uc624. Samsung Gear VR\uc744 \ucc29\uc6a9\ud558\uace0 \ub300\ud3ec\uc640 \uc601\uad11\uc744 \uc704\ud574 \uc804\ud22c\uc5d0 \ucc38\uc5ec\ud558\uc2ed\uc2dc\uc624!", "short_description": "\uc778\ub958\ub97c \uc704\ud574 \uc2f8\uc6b0\uc2ed\uc2dc\uc624. Samsung Gear VR\uc744 \ucc29\uc6a9\ud558\uace0 \ub300\ud3ec\uc640 \uc601\uad11\uc744 \uc704\ud574 \uc804\ud22c\uc5d0 \ucc38\uc5ec\ud558\uc2ed\uc2dc\uc624!"}, {"images": {"nodes": []}, "id": "1605888302896692", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gunner", "keywords": ["economico", "gunjack", "gioco", "eve", "sparatutto"], "long_description": "PER LA VITTORIA\n\n2167. Il giorno del tradimento. Migliaia di vittime, milioni di persone in pericolo: i ribelli dichiarano guerra al resto dell'umanit\u00e0.\n\nI migliori gunner di tutta la galassia attivano i loro visori Samsung Gear VR per diventare l'ultima difesa contro la minaccia dei ribelli. Dovranno utilizzare il cannone per affrontare un nuovo tipo di guerra, distruggendo legioni di astronavi nemiche con la loro artiglieria letale per consegnare il nemico alla giustizia nel nome della patria.\n\nFai la cosa giusta. Indossa il visore Samsung Gear VR e diventa un gunner... per le armi e per la gloria!", "short_description": "Fai la cosa giusta. Indossa il visore Samsung Gear VR e diventa un gunner... per le armi e per la gloria!"}, {"images": {"nodes": []}, "id": "1296616953868915", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gunner", "keywords": ["\u5b89\u4fa1", "gunjack", "\u30b2\u30fc\u30e0", "eve", "\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0"], "long_description": "\u3059\u3079\u3066\u306f\u52dd\u5229\u306e\u305f\u3081\u306b2167\u5e74\u3002\u88cf\u5207\u308a\u306e\u65e5\u3002\u6570\u5343\u4eba\u304c\u547d\u3092\u843d\u3068\u3057\u3001\u6570\u5343\u4e07\u4eba\u306e\u547d\u304c\u8105\u5a01\u306b\u3055\u3089\u3055\u308c\u308b\u3002\u53cd\u4e71\u8ecd\u304c\u6226\u4e89\u3092\u4ed5\u639b\u3051\u3066\u304d\u305f\u306e\u3060\u3002\n\n\"\u9280\u6cb3\u3092\u80a1\u306b\u304b\u3051\u308b\u30a8\u30ea\u30fc\u30c8\u30ac\u30ca\u30fc\u304cSamsung Gear VR\u30d8\u30c3\u30c9\u30bb\u30c3\u30c8\u3092\u8d77\u52d5\u3059\u308b\u3001\u3059\u3079\u3066\u306f\u53cd\u4e71\u8ecd\u306e\u8105\u5a01\u304b\u3089\u6700\u5f8c\u306e\u9632\u885b\u7dda\u3092\u5b88\u308b\u3068\u3044\u3046\u4efb\u52d9\u3092\u679c\u305f\u3059\u305f\u3081\u3002\u30ac\u30f3\u3092\u81ea\u5728\u306b\u64cd\u308a\u3001\u65b0\u305f\u306a\u6642\u4ee3\u306e\u6226\u4e89\u3092\u6226\u3048\u3002\u5f37\u529b\u306a\u7832\u5854\u3068\u6b63\u7fa9\u306e\u529b\u3067\u62bc\u3057\u5bc4\u305b\u308b\u6575\u306e\u5b87\u5b99\u8239\u3092\u7834\u58ca\u305b\u3088\u3002\n \n\u6b63\u7fa9\u3092\u8cab\u3051\u3002Samsung Gear VR\u3092\u8eab\u306b\u3064\u3051\u3001\u9283\u6483\u3068\u6804\u5149\u306e\u30ac\u30ca\u30fc\u3068\u306a\u308c\uff01", "short_description": "\u6b63\u7fa9\u3092\u8cab\u3051\u3002Samsung Gear VR\u3092\u8eab\u306b\u3064\u3051\u3001\u9283\u6483\u3068\u6804\u5149\u306e\u30ac\u30ca\u30fc\u3068\u306a\u308c\uff01"}, {"images": {"nodes": []}, "id": "695989237829165", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gunner", "keywords": ["barato", "gunjack", "Juego", "eve", "shooter"], "long_description": "\u00a1A POR LA VICTORIA!\n\n2167. El d\u00eda del traidor. Miles de muertos; millones m\u00e1s bajo la amenaza rebelde en su guerra contra el resto de la humanidad.\n\nLos artilleros de \u00e9lite de toda la galaxia activan sus gafas Samsung Gear VR para cumplir con su deber y luchar contra la amenaza rebelde. Arma en mano, luchar\u00e1n en una nueva guerra, en la que destruir\u00e1n legiones de naves enemigas con artiller\u00eda mortal y justicia patri\u00f3tica.\n\nHaz lo correcto. Col\u00f3cate el Samsung Gear VR y convi\u00e9rtete en un artillero... \u00a1Por las armas y por la gloria!", "short_description": "Haz lo correcto. Col\u00f3cate el Samsung Gear VR y convi\u00e9rtete en un artillero... \u00a1Por las armas y por la gloria!"}, {"images": {"nodes": []}, "id": "662639447825334", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gunner", "keywords": ["preiswert", "gunjack", "spiel", "eve", "shooter"], "long_description": "DEN SIEG IM VISIER\n\n2167.  Tag des Verrats.  Tausende Tote, Millionen bedroht - die Rebellen erkl\u00e4ren dem Rest der Menschheit den Krieg.\n\nElite-Gunner der gesamten Galaxie aktivieren ihre Samsung Gear Headsets im Abwehrkampf gegen die Bedrohung durch die Rebellen. Mit ihren Gesch\u00fctzen erleben sie eine neue Art der Kriegsf\u00fchrung, zerst\u00f6ren ganze Legionen an feindlichen Raumschiffen mit t\u00f6dlicher Pr\u00e4zision und f\u00fcr patriotische Gerechtigkeit.\n\nTu das Richtige. Schnall dir dein Samsung Gear VR um und werde zum Gunner - f\u00fcr Ruhm und Ehre!", "short_description": "Tu das Richtige. Schnall dir dein Samsung Gear VR um und werde zum Gunner - f\u00fcr Ruhm und Ehre!"}, {"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2894002014011755", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162745_1708163952775258_35867919_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44w43JJHp_wQ7kNvwGwRyL2&_nc_oc=Adpkjip_O_pYptmsULhsGkttdMAENBf2ldDGrOrNcCYzTrX7vAmC-0i3VGTxX6JoaD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjAt7sFfbFEp-zPVgpNv2lDwAm2MR6u6f0JdyfKGcxKQ&oe=6AFDE1E8"}, {"file_name": "migrated_image.png", "id": "2585353228420681", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138834_267152726952804_527819417_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APRI11fUZAIQ7kNvwE1dcMf&_nc_oc=AdrtxOJsSIWV3BlpS2ISSTsXv0JPsycHsE-46y_fokuZMdXeCs0Og5Vj5F84PYr4YVM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_SQroNZJTQK57PdJi8oPU35zeoRJxRmk1ozYWjjF87g&oe=6AFDB854"}, {"file_name": "migrated_image.png", "id": "1123419311325325", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138838_526371790880818_706417627_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CB2td-XeD0Q7kNvwEwlCvo&_nc_oc=AdrZTMugGCCG6T61C-or8KrS4xd-_55wcUkvj7iLY6y3KPlgN8Bx051MFqVLh-UmjGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYbLSBAyg1mCLCNazjyvTybBoFH-fhtR8C89-xGTGXJw&oe=6AFDE3D9"}, {"file_name": "migrated_image.png", "id": "658291818238598", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138771_967900526591672_399136691_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7slqPh1RQ0IQ7kNvwGCLVlX&_nc_oc=A
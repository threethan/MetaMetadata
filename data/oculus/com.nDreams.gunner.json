ge.png", "id": "237059487435042", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162823_833024696764450_669208388_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBCZdcuFdacQ7kNvwGfPtvS&_nc_oc=AdryH6V_IytJornwyL8xyHJ_twDjchQ6QbKVJ6pGMWqukOECbbkMYgj87y9sP6y33QU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3y8DNNtM0nD6BW4hDgNA3ep9tv_7WwXX5HIt4ylqqRA&oe=6AFDCB3D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gunner", "keywords": [], "long_description": "Strap on your Gear VR and become a Gunner - for gun and for glory!\n\nIn this sci-fi shooter, you'll aim and shoot your gun simply by looking at the enemy. Unload a devastating arsenal from your weapon turret, in intense gun battles against deadly fighters and planet-sized cruisers.\n\nYou'll join the fight as Hel \u2013 one tough Gunner holding her own against tenacious rebel forces. Blast your way across the galaxy in the story campaign and learn what it takes to be a Gunner. You can also take down waves of enemy units in a no-holds-barred Horde Mode showdown.\n\nEnlist now!", "short_description": ""}, {"images": {"nodes": []}, "id": "231257281570535", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gunner", "keywords": [], "long_description": "PER LA VITTORIA\n\n2167. Il giorno del tradimento. Migliaia di vittime, milioni di persone in pericolo: i ribelli dichiarano guerra al resto dell'umanit\u00e0.\n\nI migliori gunner di tutta la galassia attivano i loro visori Samsung Gear VR per diventare l'ultima difesa contro la minaccia dei ribelli. Dovranno utilizzare il cannone per affrontare un nuovo tipo di guerra, distruggendo legioni di astronavi nemiche con la loro artiglieria letale per consegnare il nemico alla giustizia nel nome della patria.\n\nFai la cosa giusta. Indossa il visore Samsung Gear VR e diventa un gunner... per le armi e per la gloria!", "short_description": "Fai la cosa giusta. Indossa il visore Samsung Gear VR e diventa un gunner... per le armi e per la gloria!"}, {"images": {"nodes": []}, "id": "144374813566089", "locale": "pt_PT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gunner", "keywords": [], "long_description": "MIRE PARA VENCER\n\n2167. O Dia dos Traidores. Milhares foram mortos, milh\u00f5es correndo risco, os rebeldes declaram guerra ao resto da humanidade.\n\nGunners de elite em toda a gal\u00e1xia ativam seu acess\u00f3rio Samsung Gear VR para cumprir seu dever como \u00faltima defesa contra a amea\u00e7a rebelde. Empunhando suas armas, eles lutam em um novo tipo de guerra, destruindo legi\u00f5es de naves inimigas com artilharia mortal e com a justi\u00e7a ao seu lado.\n\nFa\u00e7a a coisa certa. Coloque seu acess\u00f3rio Samsung Gear VR e transforme-se no Gunner - para a gl\u00f3ria na guerra!", "short_description": "Fa\u00e7a a coisa certa. Coloque seu acess\u00f3rio Samsung Gear VR e transforme-se no Gunner - para a gl\u00f3ria na guerra!"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "nDreams", "support_website_url": null, "website_url": "http://www.gunnergame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": [], "has_in_app_ads": null, "internet_connection": null, "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1360976827693966"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "CANCELLED", "id": "2012071312395940"}, {"status": "PUBLISHED", "id": "192629658234080"}, {"status": "PUBLISHED", "id": "15090
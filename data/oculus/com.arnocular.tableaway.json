AHIH0mP6B7qgPzeJUhG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHHDfq8t9SY1DNehyPpYmTXNp3LbMkdauvPxkJKRkVpw&oe=6B0F019E"}, {"file_name": "04-Table-Approval-Full-Bleed.png", "id": "1177613111502437", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842212_1177613121502436_7804872471299782481_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqj1b8OvdF8Q7kNvwE4NaBk&_nc_oc=Adqk9YTwk5nyYyY-yvJK5tR2PAPdqwRC-MdGUl8oMbxMzDnpJJcmAxujeMAjvkMO7Kc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvsoxFgF-QT2V_KNokpyRcuhA4-yd5HItLGWZRBg6Z3Q&oe=6B0F0F02"}, {"file_name": "05-Photo-Gallery-Full-Bleed.png", "id": "3989690821337773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842183_3989690824671106_5118124920079894034_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH5GScrn6pkQ7kNvwGKrdF9&_nc_oc=Adq3mIYoRaGRZbkwU7aROuo6Y2n-bBuKFJO8GID746tw4L85YOETSUyGJyTfRzoLEkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3e4K4miWT0wGPWUCT2F8unwn3UqUKQ0Wkwt3psuuq9w&oe=6B0F10D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TableAway", "keywords": [], "long_description": "Your table. Somewhere else.\n\nBring a different setting to your real table with TableAway. Eat, write or sketch while your physical tabletop stays visible through passthrough.\n\nExplore three photographic 360-degree still environments: Secluded Beach, Alps Field and Monbachtal Riverbank. These three environments stay free permanently, with unlimited use and all core tabletop controls.\n\nBring your own meal, paper notebook or sketchbook. Writing and sketching happen on your physical materials; TableAway does not provide digital drawing or handwriting capture.\n\nThe still environments use a fixed 1x view. These are panoramic photographs rather than animated scenes or interactive 3D worlds.\n\nTableAway by ARnocular.", "short_description": "Eat, write
FiEVp5LX4o8U7jg4hh2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpd-mX2VROETGTfwVl5RJ2TA28F9TrX9L6kp_Fl714Uw&oe=6B0C5E9E"}, {"file_name": "04-Table-Approval-Full-Bleed.png", "id": "1177613111502437", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842212_1177613121502436_7804872471299782481_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFTrRIT_PgcQ7kNvwGlCC7m&_nc_oc=AdrLVtm_K5v-5mRgNVewJNpzwjEUmLweIVWvWTnkT-b5Fmp5xR-u1fcY6CcHCJTPsE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNXBEys5KQ8YFlXKJVh8xVfehoJfIBAGVAt_6c39vymw&oe=6B0C6C02"}, {"file_name": "05-Photo-Gallery-Full-Bleed.png", "id": "3989690821337773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842183_3989690824671106_5118124920079894034_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH5GScrn6pkQ7kNvwFKEz2l&_nc_oc=AdoqAKUfjcWZnr4tmXm28a-dI1vZn2xCpb7lZOQDMCgujtsE6CYhxug4rfcG7e---vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2cMmj1qV9sEd_vMoZv-ZMKj76hmElCDhwzH3T2pTRDw&oe=6B0C6DD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TableAway", "keywords": [], "long_description": "Your table. Somewhere else.\n\nBring a different setting to your real table with TableAway. Eat, write or sketch while your physical tabletop stays visible through passthrough.\n\nExplore three photographic 360-degree still environments: Secluded Beach, Alps Field and Monbachtal Riverbank. These three environments stay free permanently, with unlimited use and all core tabletop controls.\n\nBring your own meal, paper notebook or sketchbook. Writing and sketching happen on your physical materials; TableAway does not provide digital drawing or handwriting capture.\n\nThe still environments use a fixed 1x view. These are panoramic photographs rather than animated scenes or interactive 3D worlds.\n\nTableAway by ARnocular.", "short_description": "Eat, write
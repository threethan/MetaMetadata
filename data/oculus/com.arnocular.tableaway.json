ore tabletop controls.\n\nBring your own meal, paper notebook or sketchbook. Writing and sketching happen on your physical materials; TableAway does not provide digital drawing or handwriting capture.\n\nThe still environments use a fixed 1x view. These are panoramic photographs rather than animated scenes or interactive 3D worlds.\n\nTableAway by ARnocular.", "short_description": "Eat, write or sketch in photographic scenery while your real tabletop stays in view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tableaway.arnocular.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ARnocular Ltd", "support_website_url": "https://tableaway.arnocular.com/support/", "website_url": "https://tableaway.arnocular.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1517595184762196"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1677613490561398"}]}, "baseline_offer": {"id": "1677613490561398"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795453440, "status": "PUBLISHED", "id": "1677613490561398"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1513497135172001", "version": "1.0.0-rc.2-store.1"}, "id": "1549656940261317", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": f
KaJzzEqOjBvIPh3UaYeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQL--ZDB8yfA-6Zjt-yXb8-aqRxXT12L4ylErEr-qtNxw&oe=6B0DB01E"}, {"file_name": "04-Table-Approval-Full-Bleed.png", "id": "1177613111502437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842212_1177613121502436_7804872471299782481_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFTrRIT_PgcQ7kNvwH0BZLO&_nc_oc=Adrlr7ETTL3COAUNKECG5M7ichjovaD4jTzRlHhgnO0EiXQMYBqr4PvVLE1PVNxEUDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcqUIO_3VFyrSGQW75TwcGEn944qNb-HBiMbiqddBhGQ&oe=6B0DBD82"}, {"file_name": "05-Photo-Gallery-Full-Bleed.png", "id": "3989690821337773", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842183_3989690824671106_5118124920079894034_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH5GScrn6pkQ7kNvwHyInRV&_nc_oc=AdplwHDzJHVatp14_4TH4_cUQeVx5r3mJz4LeMvJUAqNqjhHDlah1eGpVyoMvn-oPiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFhdR3K5ByDSh5BO7iZWxNI1Rt_FUPEUmbAFU_K2xAfg&oe=6B0DBF51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TableAway", "keywords": [], "long_description": "Your table. Somewhere else.\n\nBring a different setting to your real table with TableAway. Eat, write or sketch while your physical tabletop stays visible through passthrough.\n\nExplore three photographic 360-degree still environments: Secluded Beach, Alps Field and Monbachtal Riverbank. These three environments stay free permanently, with unlimited use and all core tabletop controls.\n\nBring your own meal, paper notebook or sketchbook. Writing and sketching happen on your physical materials; TableAway does not provide digital drawing or handwriting capture.\n\nThe still environments use a fixed 1x view. These are panoramic photographs rather than animated scenes or interactive 3D worlds.\n\nTableAway by ARnocular.", "short_description": "Eat, write
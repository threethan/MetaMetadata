o3znnBDNCmK-OKjj8VHQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTI66l5NjX8oejNbLTj04HnPiX2OYZGOFD311m05xXgMg&oe=6B0B0D1E"}, {"file_name": "04-Table-Approval-Full-Bleed.png", "id": "1177613111502437", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908842212_1177613121502436_7804872471299782481_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFTrRIT_PgcQ7kNvwHtHv3y&_nc_oc=Adr-Dt8zFXP4QjuZ5czbCDWpEKInPG_8kgYMCiNWJedgynzPaOPlqdOQjpV4jCf4hXg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTcVbKuN_tgetJcxwRpFBCQAUD5LkSN184yk4xbdLbtvA&oe=6B0B1A82"}, {"file_name": "05-Photo-Gallery-Full-Bleed.png", "id": "3989690821337773", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908842183_3989690824671106_5118124920079894034_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vhfp2EpO08Q7kNvwHD84Y6&_nc_oc=Adr1eH7cc-8RyxpKC_6NY55Y9oTt9XNZzAgFkle3gWMoYzMmE_o27xjx7u0rDBuWYUQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTW_gIq4O8ivyGDKyhCyeH8BW-fnz98mNRU2CkzPsODow&oe=6B0B1C51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TableAway", "keywords": [], "long_description": "Your table. Somewhere else.\n\nBring a different setting to your real table with TableAway. Eat, write or sketch while your physical tabletop stays visible through passthrough.\n\nExplore three photographic 360-degree still environments: Secluded Beach, Alps Field and Monbachtal Riverbank. These three environments stay free permanently, with unlimited use and all core tabletop controls.\n\nBring your own meal, paper notebook or sketchbook. Writing and sketching happen on your physical materials; TableAway does not provide digital drawing or handwriting capture.\n\nThe still environments use a fixed 1x view. These are panoramic photographs rather than animated scenes or interactive 3D worlds.\n\nTableAway by ARnocular.", "short_description": "Eat, write
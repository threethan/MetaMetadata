ng?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46--RozwlNwQ7kNvwGJLpdY&_nc_oc=AdoIF_aqgZJZDgYZAK_ShVjoU7S_GhQQ4SY8HpOg0V6IZX9CxDEPM28W91yGyGkM_Cs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUVGr4FLEOBLWvX8Y8ayrLAZlHkEolsK2JBsMZ3KrFBog&oe=6B0EF8AC"}, {"file_name": "3.png", "id": "1336662811520506", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623400_1336662814853839_8575896276767822033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67DVmJ6NrRcQ7kNvwGsqddu&_nc_oc=AdqBWbzy29PStjSvbcQkjNmU-76OuBobOTzQeDEGXFsDem3OMVerPoHmrwKrTFrzMG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVewbHp3D7FIeXXI6WyGt4Fm5lphRJtSmVsN_NhWg061A&oe=6B0F10FD"}, {"file_name": "4.png", "id": "2230572054152344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_2230572057485677_2372904277471757210_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVubShhay9sQ7kNvwHn5lPy&_nc_oc=AdrT-C3t4ddoqCdnvOPeO4wGKKy0BxDKHOoP-Izt7ZdDYoCBX_sVfgmSk_tWc4Hytmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZ1SEA79efL6WmiJ7JOX01qI1A6WvoUa5Z6ppl2TafZQ&oe=6B0F1D0A"}, {"file_name": "5.png", "id": "1371269948213119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619808_1371269951546452_7889463761728838125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wIfzsqwHTIQ7kNvwGvi7QG&_nc_oc=Adr64mtmBi9LCBTcuCZYtOVdlCCPcqi4gUxCJQ6u1mp0FKx0xZQw2qWTOEfIp1DX_u0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVwdpgWZtvuVhUQyczrPVZ4smVr-JWFK5RD4vs2ojoSNw&oe=6B0F11C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "1867021894668895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593714175_1867021898002228_6579959995361148752_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QkMh0IKcfUQ7kNvwHNT26r&_nc_oc=AdqcY9SGPL6Oi2cCWBR2ZAg06oMPz4VGxxA3iswk8DgfdF0roz-FdMafK5Orq1gDbjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYtjWB5SPwvkX-FeiQuCeBCM_Bl9Oj8eFuLmLGLCQ2Qw&oe=6B0F0B78"}, "display_name": "Fit Squat XR: Lower Body Workout", "keywords": ["Fitness", "Rhythm", "Cardio", "Exercise", "Training"], "long_description": "# Turn Squats into an Energizing Rhythm Game! \u26a1    \u3000\n\nBored of standard workouts? **Fit Squat XR** transforms a powerful lower-body workout into an exhilarating rhythm challenge. Sync your movement to the music, dodge obstacles, and build strength while enjoying the game.   \n\n# \ud83d\udd25 Key Features\n\n* **\ud83c\udfb5 Rhythm-Driven Workout**\n\n Move to the beat! Walls rush toward you in time with the music, turning intense leg exercise into pure gameplay.  \n* **\ud83d\udcaa Scale Your Challenge**\n\nFind your perfect pace with **EASY**, **NORMAL**, or **HARD** modes. Crank it up to HARD for rapid squat sequences that will truly test your legs and glutes.    \n* **\ud83d\udcc8 Calorie Tracking**\n\nKeep track of your energy burned after every session. Your progress is personal, rewarding, and visible.   \n* **\ud83d\ude4c Controller-Free Freedom**\n\nExperience the ultimate comfort with Hand Tracking. Ditch the controllers and move naturally with your hands completely free. \n* **\ud83c\udfe0 Turn Your Room into a Gym (MR Mode)**\n\nWith Mixed Reality, rhythmic neon walls stream directly into your living space! Stay aware of your real-world surroundings while you move. \n \n\n\n> **Ready to move? Squat to the beat and crush your fitness goals today! \ud83c\udfc6**", "short_description": "Drop low, feel the beat, and break a sweat! \ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Fit Squat XR is your immersive VR rhythm fitness arena where your lower body takes center stage. Dodge incoming walls in time with high-energy tracks. Challenge your legs with multiple difficulty levels and feel the rhythm. Your next leg workout starts now! \ud83c\udfc6   \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29574530228805583"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623185_4121920587942550_7429896758387060537_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfyXapkC_F4Q7kNvwGais0l&_nc_oc=AdoiUonB2c0gbBgXeX8eIvxClpK2e4IMQ0vpnovUZj2W9-EgD72d1UYG2WObbQ5ZwlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQaXEXol2oS-Q8h1Tt5dV1lucfjRalW0EjxbwRz8ur9g&oe=6B0F0CD9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fit Squat XR: Lower Body Workout", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1783646880, "lastRevision": {"nodes": [{"id": "27856850337240256", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"d
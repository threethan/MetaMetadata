kF6TOBWnWleXGXf2nPuiOwma-zY6f_nHpLKcng-rHNr4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwX0KJpbQK_hddNiNn933jEdpiLP9rdaPiE8Rlc1k3xg&oe=6B0B3C6C"}, {"file_name": "3.png", "id": "1336662811520506", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623400_1336662814853839_8575896276767822033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyEe3tMcKgAQ7kNvwEOhAip&_nc_oc=AdppvYwrj_IawImLWRX7HGbA_b5FrWhpnX5wVh0vXnOifNMFViXZLXLt3z0VKUUfib8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZuUp3NgLkmhd0EdesGTKoTWQUQk_hnBXwIkfp1x1zcg&oe=6B0B1C7D"}, {"file_name": "4.png", "id": "2230572054152344", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622285_2230572057485677_2372904277471757210_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg4Wx70cjCcQ7kNvwG_lrj-&_nc_oc=Adpmr6EEq2Mv9_-LLSZRCjX9hMusEuZZow4KX8_F5Vc-Km_GOZMjf8RWS3NxvQCsdD4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEG833U_Tf5jZas9q3uGRo-UAdJQf1EhyIFYITRgWXFw&oe=6B0B288A"}, {"file_name": "5.png", "id": "1371269948213119", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_1371269951546452_7889463761728838125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7OIssr_UfcQ7kNvwHnHelb&_nc_oc=Adq75Y2YJUEkir9SwNn5VpbU86uGHY9Jy5FXSr_ndVAtduVgZ5DL3Z0CXjeLhvSREws&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUl7Xmj74ciKGyS0qFJSetJ5yoYSD1zn_ni-IqZqHTvA&oe=6B0B1D45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "1867021894668895", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593714175_1867021898002228_6579959995361148752_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkcP-xjKZH4Q7kNvwG9fu6B&_nc_oc=Adr5-ou3Qg3oP1fa1L6NeRRNlkFW0EpejB1YDbyuj5OosatwCjQZr58rsQDqbVjD_fg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN3Dy7TNTCbw4rsWkTILJ_pDLsB4F29gWM5gNmLhTsdg&oe=6B0B16F8"}, "display_name": "Fit Squat XR: Lower Body Workout", "keywords": ["Fitness", "Rhythm", "Cardio", "Exercise", "Training"], "long_description": "# Turn Squats into an Energizing Rhythm Game! \u26a1    \u3000\n\nBored of standard workouts? **Fit Squat XR** transforms a powerful lower-body workout into an exhilarating rhythm challenge. Sync your movement to the music, dodge obstacles, and build strength while enjoying the game.   \n\n# \ud83d\udd25 Key Features\n\n* **\ud83c\udfb5 Rhythm-Driven Workout**\n\n Move to the beat! Walls rush toward you in time with the music, turning intense leg exercise into pure gameplay.  \n* **\ud83d\udcaa Scale Your Challenge**\n\nFind your perfect pace with **EASY**, **NORMAL**, or **HARD** modes. Crank it up to HARD for rapid squat sequences that will truly test your legs and glutes.    \n* **\ud83d\udcc8 Calorie Tracking**\n\nKeep track of your energy burned after every session. Your progress is personal, rewarding, and visible.   \n* **\ud83d\ude4c Controller-Free Freedom**\n\nExperience the ultimate comfort with Hand Tracking. Ditch the controllers and move naturally with your hands completely free. \n* **\ud83c\udfe0 Turn Your Room into a Gym (MR Mode)**\n\nWith Mixed Reality, rhythmic neon walls stream directly into your living space! Stay aware of your real-world surroundings while you move. \n \n\n\n> **Ready to move? Squat to the beat and crush your fitness goals today! \ud83c\udfc6**", "short_description": "Drop low, feel the beat, and break a sweat! \ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Fit Squat XR is your immersive VR rhythm fitness arena where your lower body takes center stage. Dodge incoming walls in time with high-energy tracks. Challenge your legs with multiple difficulty levels and feel the rhythm. Your next leg workout starts now! \ud83c\udfc6   \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_te
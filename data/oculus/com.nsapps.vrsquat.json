N2GcxL1QD1nq9LV3C-SKq_UO2mmnV5MIL1AM_F9EOpRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm6pTPMPbvQplLW5qVCtGaopxx3D4iuQvZ7oCs1hZWaw&oe=6AFDD52C"}, {"file_name": "3.png", "id": "1336662811520506", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623400_1336662814853839_8575896276767822033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbJT7C7jINcQ7kNvwEMX9zC&_nc_oc=AdqaTOqa_tgXkSpu9mQdDQVvBvjOfyCkUzLkbsa3W6FPcm3Xh1DrK0oSB38rweR-cIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeUnynXFgSoaZjZtP5KtGLkFelOcbWfymmoPvFG10dHQ&oe=6AFDB53D"}, {"file_name": "4.png", "id": "2230572054152344", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_2230572057485677_2372904277471757210_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07iGJ7VnDb0Q7kNvwGSPufv&_nc_oc=AdqsYFsA7ZxTSp_pkqz4bWpn39vlQqvOCvDj1CdMccIh0FK_1c8aQaBGy6XXk_7MiWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ84jWxr_YrIcB1vQBf9Vs0akeybIKsPg5x9hNGlzt-vw&oe=6AFDC14A"}, {"file_name": "5.png", "id": "1371269948213119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_1371269951546452_7889463761728838125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjDF0dQlCU8Q7kNvwEGXaYm&_nc_oc=AdqBOlGNXBAs57163JrcQQakI6QYbyHB8yH9oJteqCQClzBmCzyn8idKdMnfzcc0ppc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzL4GcyMPdrtQ0uYxM3FmNFFr81-g75oIOmLxTwa1BFg&oe=6AFDB605"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "1867021894668895", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593714175_1867021898002228_6579959995361148752_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7NtymC669UQ7kNvwFvTezf&_nc_oc=Adpgr1_Nq36yu73qxVfTwL8ictCAKzFVflMcfNRiPEbErUtvulH3dEJXQx4Y2WqY9To&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiOuUEJNxmBCD8v9gQvOZHquFifsdYda5KczKCwcsdKg&oe=6AFDAFB8"}, "display_name": "Fit Squat XR: Lower Body Workout", "keywords": ["Fitness", "Rhythm", "Cardio", "Exercise", "Training"], "long_description": "# Turn Squats into an Energizing Rhythm Game! \u26a1    \u3000\n\nBored of standard workouts? **Fit Squat XR** transforms a powerful lower-body workout into an exhilarating rhythm challenge. Sync your movement to the music, dodge obstacles, and build strength while enjoying the game.   \n\n# \ud83d\udd25 Key Features\n\n* **\ud83c\udfb5 Rhythm-Driven Workout**\n\n Move to the beat! Walls rush toward you in time with the music, turning intense leg exercise into pure gameplay.  \n* **\ud83d\udcaa Scale Your Challenge**\n\nFind your perfect pace with **EASY**, **NORMAL**, or **HARD** modes. Crank it up to HARD for rapid squat sequences that will truly test your legs and glutes.    \n* **\ud83d\udcc8 Calorie Tracking**\n\nKeep track of your energy burned after every session. Your progress is personal, rewarding, and visible.   \n* **\ud83d\ude4c Controller-Free Freedom**\n\nExperience the ultimate comfort with Hand Tracking. Ditch the controllers and move naturally with your hands completely free. \n* **\ud83c\udfe0 Turn Your Room into a Gym (MR Mode)**\n\nWith Mixed Reality, rhythmic neon walls stream directly into your living space! Stay aware of your real-world surroundings while you move. \n \n\n\n> **Ready to move? Squat to the beat and crush your fitness goals today! \ud83c\udfc6**", "short_description": "Drop low, feel the beat, and break a sweat! \ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Fit Squat XR is your immersive VR rhythm fitness arena where your lower body takes center stage. Dodge incoming walls in time with high-energy tracks. Challenge your legs with multiple difficulty levels and feel the rhythm. Your next leg workout starts now! \ud83c\udfc6   \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_te
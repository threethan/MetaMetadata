811520506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623400_1336662814853839_8575896276767822033_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFu8gC1pA8sQ7kNvwF9DOah&_nc_oc=AdqXmRPiD_OydEEJAwYti7dnVF7NBP6HH3jy9eWwMbANkfORxdCzmyrtUTH11eyI9KI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ74s43vNsnPETOQQY0wqFm_F65BFiy-UXozhyO-0rpJg&oe=6ABA78BD"}, {"file_name": "4.png", "id": "2230572054152344", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_2230572057485677_2372904277471757210_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndz-jN4Pe-UQ7kNvwHqT-z4&_nc_oc=AdrS9mc2b6B72GcUMOIHNFLcWjXdjRJc7xKlDtGnZdxXPLrXezvynnUiuF0SuB-oKGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Rf9bDaT8ceKLWwOT2kjzqSA4nWqcRlBaEMHb61exWg&oe=6ABA84CA"}, {"file_name": "5.png", "id": "1371269948213119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_1371269951546452_7889463761728838125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IlvJXz3dXMQ7kNvwF7OGKg&_nc_oc=AdrATvJ88muX0p31upGnd9ZnGj8t7uVP8h0UzFWYOQKMGiZaDxKDlAyc4qyDil6M8sI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUj0TNvwceOfqpwcpyR_a0hHKlpp0K6FFaN_FvZ3Pc-Q&oe=6ABA7985"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "1867021894668895", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593714175_1867021898002228_6579959995361148752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUPt7yAlFF0Q7kNvwFrOr2c&_nc_oc=Adrr4_4YFbkeI7CcMWkxrsfaIEhPy4TIZlYLmRdLnB7RwUx8U6sYjdM2H3yhI54xxoA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJj1x6V0MJAVVVHfEBq69H-N_zFR6O_9kbWDTBy1kigg&oe=6ABA7338"}, "display_name": "Fit Squat XR: Lower Body Workout", "keywords": ["Fitness", "Rhythm", "Cardio", "Exercise", "Training"], "long_description": "# Turn Squats into an Energizing Rhythm Game! \u26a1    \u3000\n\nBored of standard workouts? **Fit Squat XR** transforms a powerful lower-body workout into an exhilarating rhythm challenge. Sync your movement to the music, dodge obstacles, and build strength while enjoying the game.    \n\n# \ud83d\udd25 Key Features\n\n* **\ud83c\udfb5 Rhythm-Driven Workout**\n\n Move to the beat! Walls rush toward you in time with the music, turning intense leg exercise into pure gameplay.  \n* **\ud83d\udcaa Scale Your Challenge**\n\nFind your perfect pace with **EASY**, **NORMAL**, or **HARD** modes. Crank it up to HARD for rapid squat sequences that will truly test your legs and glutes.    \n* **\ud83d\udcc8 Calorie Tracking**\n\nKeep track of your energy burned after every session. Your progress is personal, rewarding, and visible.   \n* **\ud83d\ude4c Controller-Free Freedom**\n\nExperience the ultimate comfort with Hand Tracking. Ditch the controllers and move naturally with your hands completely free. \n* **\ud83c\udfe0 Turn Your Room into a Gym (MR Mode)**\n\nWith Mixed Reality, rhythmic neon walls stream directly into your living space! Stay aware of your real-world surroundings while you move. \n\n\n\n> **Ready to move? Squat to the beat and crush your fitness goals today! \ud83c\udfc6**", "short_description": "Drop low, feel the beat, and break a sweat! \ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Fit Squat XR is your immersive VR rhythm fitness arena where your lower body takes center stage. Dodge incoming walls in time with high-energy tracks. Challenge your legs with multiple difficulty levels and feel the rhythm. Your next leg workout starts now! \ud83c\udfc6  \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics"
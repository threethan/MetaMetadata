=6AE1F3EE"}]}, "id": "1020682967021486", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1541363407529258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620429_1541363410862591_2250216266989292032_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WdDRm0h5UAQ7kNvwFTghoP&_nc_oc=AdptT0dJJKUyj4RZin1C1BhL_k8waC-j2SyOxfxxSqMeuiZ12ZMitzdaiTmrTp4SD04&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzlSgqIKkl1c2tg0JrMHeXG9Iyt-BKhVmXalp7nzyaFQ&oe=6AE1E74D"}, {"file_name": "4.png", "id": "1554985162850350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619697_1554985166183683_4447530535050204751_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpg89MnQDIMQ7kNvwFQixyv&_nc_oc=AdrGV0paJkWfR0eLhjMhzFZD8kYpFlkWBgCVOMYkOJsUjZ3vyiY9WJlZtDwUdZLXrNI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM81anVJoJkB4hCpHrdjv3zt5GzploasJ7fJIYrkyQBPA&oe=6AE21570"}, {"file_name": "2.png", "id": "1708519627100262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507925214_1708519630433595_5914133222905048806_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0exMSvr0CSMQ7kNvwG-zAvN&_nc_oc=Adry6_ETQwAO5m6iNlbdQ3PBlKJfkBBDF34-HYaIS1P5VdMVpbaWB8GUzALjNm-I5nY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrQmQlZE1YXjF4E37hm8NWGbOHgOsKrDCYj0snEkMeUQ&oe=6AE21A81"}, {"file_name": "3.png", "id": "1304259938130589", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620856_1304259941463922_4011644941351319497_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbrO2TF0BsQQ7kNvwE_Hy-Y&_nc_oc=AdrLct7DkInttvv_aZMLVKOkjIIdmG97e4NtPDWglqTKWfHQzd0i0oALut5RWyzaqwc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM26kDy69ru5RxrmWZp3qWFdW-e1uKx2NsWgj3eAMc7Qg&oe=6AE1E746"}, {"file_name": "5.png", "id": "1371269948213119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_1371269951546452_7889463761728838125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRPjT6HRVssQ7kNvwFqOwbR&_nc_oc=AdotiDSGxcKE9XtEh51XFECXIazhuCHEQEyFUowD_EHJp89G-eh7Vpu-nKlohfFwMgc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcpjkabIHo7mvXFW-3Yd4j-upGWNzCtzL0_fXUl38GoA&oe=6AE20685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1017884687540315", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620965_1017884690873648_2203116526645987407_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oc6tyxS7GE4Q7kNvwHndZ03&_nc_oc=AdpDe92_tFeksfsfpfd7xpy2avR73ojf0Sni0C5WUPl9NTkiAgiuD08o360ZJDbISjI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpaZjmbT0lAATmOdhRO3a3l-J9J76DeSExY5z_gjdGow&oe=6AE20056"}, "display_name": "Fit Squat XR: Lower Body Workout", "keywords": ["Fitness", "Rhythm", "Cardio", "Exercise", "Training"], "long_description": "# Turn Squats into an Energizing Rhythm Game! \u26a1    \n\nBored of standard workouts? **Fit Squat XR** transforms a powerful lower-body workout into an exhilarating rhythm challenge. Sync your movement to the music, dodge obstacles, and build strength while enjoying the game.    \n\n# \ud83d\udd25 Key Features\n\n* **\ud83c\udfb5 Rhythm-Driven Workout**\n\n Move to the beat! Walls rush toward you in time with the music, turning intense leg exercise into pure gameplay.  \n* **\ud83d\udcaa Scale Your Challenge**\n\nFind your perfect pace with **EASY**, **NORMAL**, or **HARD** modes. Crank it up to HARD for rapid squat sequences that will truly test your legs and glutes.    \n* **\ud83d\udcc8 Calorie Tracking**\n\nKeep track of your energy burned after every session. Your progress is personal, rewarding, and visible.   \n* **\ud83d\ude4c Controller-Free Freedom**\n\nExperience the ultimate comfort with Hand Tracking. Ditch the controllers and move naturally with your hands completely free. \n* **\ud83c\udfe0 Turn Your Room into a Gym (MR Mode)**\n\nWith Mixed Reality, rhythmic neon walls stream directly into your living space! Stay aware of your real-world surroundings while you move. \n\n\n\n> **Ready to move? Squat to the beat and crush your fitness goals today! \ud83c\udfc6**", "short_description": "Drop low, feel the beat, and break a sweat! \ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Fit Squat XR is your immersive VR rhythm fitness arena where your lower body takes center stage. Dodge incoming walls in time with high-energy tracks. Challenge your legs with multiple difficulty levels and feel the rhythm. Your next leg workout starts now! \ud83c\udfc6  \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27856850263906930"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1376311387728166"}]}, "baseline_offer": {"id": "1376311387728166"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783646880, "status": "PUBLISHED", "id": "1376311387728166"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29445235165068424", "version": "0.1.3"}, "id": "3099914683548163", "channel_name": "LIVE"}]}, "i
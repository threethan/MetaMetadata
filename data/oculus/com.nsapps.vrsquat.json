l-TLULHFkBlpkbxjRiRgHquULEox3tf2CD0tud-aRvd8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLEGB_xx9_LHU3NdYXzl5Xz_q06jjWKd0jJ_1TZtwL-A&oe=6B08612C"}, {"file_name": "3.png", "id": "1336662811520506", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623400_1336662814853839_8575896276767822033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcKGbVo2CuAQ7kNvwHhJ8pw&_nc_oc=Adq5xPnVgu2s5lKgueNKZNNRIeB4jqz1TZ3ebfzQhy3jMpsHgjaxK52auQbz95Jz6Y0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCkZ914lR34pBoomOwj4F4x2jF-4ulKFqtjcADssR2YQ&oe=6B08413D"}, {"file_name": "4.png", "id": "2230572054152344", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499622285_2230572057485677_2372904277471757210_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE9MIFx2R8QQ7kNvwH1q4q1&_nc_oc=Adp3C0s05bHF68b_HCcP-qD5dh49t0nAhG_AZjT2zORtxBoowmXd3l6_lZU9cro8f08&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNtNFzvwWljSfzjGgccNW8bAwIrtT0p0uzGVeW12-y0Q&oe=6B084D4A"}, {"file_name": "5.png", "id": "1371269948213119", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619808_1371269951546452_7889463761728838125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7OIssr_UfcQ7kNvwFaFVjW&_nc_oc=AdpyeynAfvxNXNQjr-kZjHVrPqJ9Y5_s3o7GyUluM75kbWB8USJQ-RKhJbPT3Uh2krM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg0-aF2xhaIQ_w6f5PViHjL-kbMS0YJu6yfLFiCb-ctw&oe=6B084205"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "1867021894668895", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593714175_1867021898002228_6579959995361148752_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q28GW_CeVcMQ7kNvwHqpJ3S&_nc_oc=AdrgkSMIXsrvsIDpxWqqFogjXLqmqIp86HZIcuknngk4F5wczoqBJwN46f7Awk3NOUM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzJU6hty7gQDtDEKHbNqX9TmeilmHYQMi_LzN1Jn2OVw&oe=6B083BB8"}, "display_name": "Fit Squat XR: Lower Body Workout", "keywords": ["Fitness", "Rhythm", "Cardio", "Exercise", "Training"], "long_description": "# Turn Squats into an Energizing Rhythm Game! \u26a1    \u3000\n\nBored of standard workouts? **Fit Squat XR** transforms a powerful lower-body workout into an exhilarating rhythm challenge. Sync your movement to the music, dodge obstacles, and build strength while enjoying the game.   \n\n# \ud83d\udd25 Key Features\n\n* **\ud83c\udfb5 Rhythm-Driven Workout**\n\n Move to the beat! Walls rush toward you in time with the music, turning intense leg exercise into pure gameplay.  \n* **\ud83d\udcaa Scale Your Challenge**\n\nFind your perfect pace with **EASY**, **NORMAL**, or **HARD** modes. Crank it up to HARD for rapid squat sequences that will truly test your legs and glutes.    \n* **\ud83d\udcc8 Calorie Tracking**\n\nKeep track of your energy burned after every session. Your progress is personal, rewarding, and visible.   \n* **\ud83d\ude4c Controller-Free Freedom**\n\nExperience the ultimate comfort with Hand Tracking. Ditch the controllers and move naturally with your hands completely free. \n* **\ud83c\udfe0 Turn Your Room into a Gym (MR Mode)**\n\nWith Mixed Reality, rhythmic neon walls stream directly into your living space! Stay aware of your real-world surroundings while you move. \n \n\n\n> **Ready to move? Squat to the beat and crush your fitness goals today! \ud83c\udfc6**", "short_description": "Drop low, feel the beat, and break a sweat! \ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Fit Squat XR is your immersive VR rhythm fitness arena where your lower body takes center stage. Dodge incoming walls in time with high-energy tracks. Challenge your legs with multiple difficulty levels and feel the rhythm. Your next leg workout starts now! \ud83c\udfc6   \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_te
, {"file_name": "3.png", "id": "1304259938130589", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620856_1304259941463922_4011644941351319497_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rSmeKk_idUQ7kNvwE1dhPQ&_nc_oc=AdqhsERgDw8IelaDBfXOpHqAVJmOAXNEJnukWjJAvyMxXaKbq3FCrbG_EmQh559rbl8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmnbCQkHM6rs_ESrzYsCtTiOucfSutzSn4grgDpgH3Ug&oe=6AC91306"}, {"file_name": "5.png", "id": "1371269948213119", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619808_1371269951546452_7889463761728838125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUsm-txHKEwQ7kNvwEtrAQI&_nc_oc=AdoHd4u-Oa0zisVW59ZBoY32Uc1ni5JcmymeURW6pxMDrpTp0t9I7hKmy1F6NlbcF08&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMIz8MEjJJruCZj-MbxdRbmlg_G_3JisUZ3KMMtM5xpg&oe=6AC8FA05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1017884687540315", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620965_1017884690873648_2203116526645987407_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddddc89Hw8IQ7kNvwGRqDps&_nc_oc=Adq8c9bf-hwECS_8h7J5lfplOEFoW-VBgJrTOL47gOCn9FRuHNOL1mGGAbpqqeOvbzI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfQqnwK0bw3sGSteHDyYwJhrT53IGUQstNOPM8wwo4Qg&oe=6AC8F3D6"}, "display_name": "Fit Squat XR: Lower Body Workout", "keywords": ["Fitness", "Rhythm", "Cardio", "Exercise", "Training"], "long_description": "# Turn Squats into an Energizing Rhythm Game! \u26a1    \n\nBored of standard workouts? **Fit Squat XR** transforms a powerful lower-body workout into an exhilarating rhythm challenge. Sync your movement to the music, dodge obstacles, and build strength while enjoying the game.    \n\n# \ud83d\udd25 Key Features\n\n* **\ud83c\udfb5 Rhythm-Driven Workout**\n\n Move to the beat! Walls rush toward you in time with the music, turning intense leg exercise into pure gameplay.  \n* **\ud83d\udcaa Scale Your Challenge**\n\nFind your perfect pace with **EASY**, **NORMAL**, or **HARD** modes. Crank it up to HARD for rapid squat sequences that will truly test your legs and glutes.    \n* **\ud83d\udcc8 Calorie Tracking**\n\nKeep track of your energy burned after every session. Your progress is personal, rewarding, and visible.   \n* **\ud83d\ude4c Controller-Free Freedom**\n\nExperience the ultimate comfort with Hand Tracking. Ditch the controllers and move naturally with your hands completely free. \n* **\ud83c\udfe0 Turn Your Room into a Gym (MR Mode)**\n\nWith Mixed Reality, rhythmic neon walls stream directly into your living space! Stay aware of your real-world surroundings while you move. \n\n\n\n> **Ready to move? Squat to the beat and crush your fitness goals today! \ud83c\udfc6**", "short_description": "Drop low, feel the beat, and break a sweat! \ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Fit Squat XR is your immersive VR rhythm fitness arena where your lower body takes center stage. Dodge incoming walls in time with high-energy tracks. Challenge your legs with multiple difficulty levels and feel the rhythm. Your next leg workout starts now! \ud83c\udfc6  \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "suppor
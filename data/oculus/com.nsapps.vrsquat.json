2811520506", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623400_1336662814853839_8575896276767822033_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0fzPOeSyyEQ7kNvwGFMc88&_nc_oc=Adrp9jU8kLSn1sBWpVGpC7rWZfQHaXnXsy-kOrKhmBratMkqcaG1A43NhRbJTUEm4Mc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-fdVu2I1aI6yDcjR7FOi7UG1ZY__zJ9-bMVCjDMC8uw&oe=6AF47ABD"}, {"file_name": "4.png", "id": "2230572054152344", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_2230572057485677_2372904277471757210_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZXunZiMTKsQ7kNvwF3yY_p&_nc_oc=AdolS3ZQHmw0DX6-6IXAKVsAV5UB8eYkRNn_jaa5vLQS_mb5M97RfNRKEvg3y1RlWfw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6-Y1usp3hrAaC3rEtkTEJZVNZZd3tg_RvTtNIT0ZQOA&oe=6AF486CA"}, {"file_name": "5.png", "id": "1371269948213119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_1371269951546452_7889463761728838125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3yjYrtI73QQ7kNvwGNPc8h&_nc_oc=AdoHWnjzoHAopE6BicwXQp_O5noTi-UV0PxlZk1bb1NOhBk9pikt0pJkO6mqHg353g0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDcCvIKfHLPcMfTQ5XUXxo2cXBNJ-HnzR8u2zNiAJ9dw&oe=6AF47B85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "1867021894668895", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593714175_1867021898002228_6579959995361148752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdPeTQuQEmkQ7kNvwEN2dBc&_nc_oc=Adr0M_T-ZXhmL3g63WtcmbfphIxiCbKoSXdv15LTA9dCCp_xx4DJIZFsEtoJdKC0yzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnrCOl8d1PKApINlbcm_OHJ5ZEnI-Pf1R3gmdgan7v4A&oe=6AF47538"}, "display_name": "Fit Squat XR: Lower Body Workout", "keywords": ["Fitness", "Rhythm", "Cardio", "Exercise", "Training"], "long_description": "# Turn Squats into an Energizing Rhythm Game! \u26a1    \u3000\n\nBored of standard workouts? **Fit Squat XR** transforms a powerful lower-body workout into an exhilarating rhythm challenge. Sync your movement to the music, dodge obstacles, and build strength while enjoying the game.   \n\n# \ud83d\udd25 Key Features\n\n* **\ud83c\udfb5 Rhythm-Driven Workout**\n\n Move to the beat! Walls rush toward you in time with the music, turning intense leg exercise into pure gameplay.  \n* **\ud83d\udcaa Scale Your Challenge**\n\nFind your perfect pace with **EASY**, **NORMAL**, or **HARD** modes. Crank it up to HARD for rapid squat sequences that will truly test your legs and glutes.    \n* **\ud83d\udcc8 Calorie Tracking**\n\nKeep track of your energy burned after every session. Your progress is personal, rewarding, and visible.   \n* **\ud83d\ude4c Controller-Free Freedom**\n\nExperience the ultimate comfort with Hand Tracking. Ditch the controllers and move naturally with your hands completely free. \n* **\ud83c\udfe0 Turn Your Room into a Gym (MR Mode)**\n\nWith Mixed Reality, rhythmic neon walls stream directly into your living space! Stay aware of your real-world surroundings while you move. \n \n\n\n> **Ready to move? Squat to the beat and crush your fitness goals today! \ud83c\udfc6**", "short_description": "Drop low, feel the beat, and break a sweat! \ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Fit Squat XR is your immersive VR rhythm fitness arena where your lower body takes center stage. Dodge incoming walls in time with high-energy tracks. Challenge your legs with multiple difficulty levels and feel the rhythm. Your next leg workout starts now! \ud83c\udfc6   \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
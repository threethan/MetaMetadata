10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0pYoc-zMI0Q7kNvwGYTIIP&_nc_oc=AdpTW73pVH53eEWFueOsVKAECTweh_xdv83GA3AEniWX79xz8SJJUmUvQkLDI0a4bSE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8_1QazRtm4bfLYRWWQh5PqAg_Sa6oKSACgxyspv4TXQ&oe=6AAD5D9F"}, {"file_name": "Untitled2.png", "id": "1244714280322910", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824322_1244714283656243_4174352392007358180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlTQIQ_9lt4Q7kNvwE5jyFS&_nc_oc=AdrfqlM4DJZOyDn5TfuoR5M8nGBF7gNsC51z36mBXi6Mym1JwmknhQhjd50Ueoh5skY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVb0bzf2sYI5R5yuGGvih-HhEMuVfBKrSBOq4TdzCGLw&oe=6AAD51DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Taggg", "keywords": ["Tag", "Taggers"], "long_description": "Opium Taggg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Opium Taggg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NXQjN0ACD7qEpo7ezC7mBppSStXjrL4q7PN_3rjSAe8/edit?usp=sharing", "developer_terms_
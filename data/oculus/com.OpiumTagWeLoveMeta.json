L8vcInvypbnvQ&oe=6B046FD2"}, {"file_name": "Untitled2.png", "id": "1247744750648568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_1247744757315234_5563637096782840005_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FLH8D33EN4Q7kNvwGm5G4n&_nc_oc=Adp6qiaIdR4GyY_5z8gQeZKxdseQaAStxPuBH-v9yvbS3pMfG5LcS0Zg9AxGgyd2SEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4xDoxB83Tr0J_E_VCgqIGoSmjqt_IwL8V8cyuCkHIPw&oe=6B04609F"}, {"file_name": "Untitled2.png", "id": "1244714280322910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1244714283656243_4174352392007358180_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FnuzP1u_SQQ7kNvwElWV8o&_nc_oc=Adq77RaSSga5IO8ipGC1sRcEUA0S9UfNu6YPMfYAQVur-aA_qY-OM-38YdtwiLCobvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRocUMycQipS9N82WINSw1YR2g0MsizegbyYmg40MvXXw&oe=6B0454DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Taggg", "keywords": ["Tag", "Taggers"], "long_description": "Opium Taggg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Opium Taggg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NXQjN0ACD7qEpo7ezC7mBppSStXjrL4q7PN_3rjSAe8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opium-taggg/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25991977600467546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_1612077949994827_9022639570421804630_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=av2bkVpUf38Q7kNvwHVgKmZ&_nc_oc=AdqcnliyyVNpogXr46FCXo7PPq426twEd0PKYWtX5DzINkpDTDGADJ_eSdJuESngo8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkk2slSvjbQeKg4jDz_Y4gzxddmXYFEodes7Z2uemZVA&oe=6B046981"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Opium Taggg", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1771968900, "lastRevision": {"nodes": [
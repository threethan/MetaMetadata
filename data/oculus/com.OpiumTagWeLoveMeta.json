10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iHq9NnogwEQ7kNvwGS4KVy&_nc_oc=AdpciU2OWhbZLL2P2ymCPnth9y4hAcyvONQ5U-WCj6KEFwhta_JvI9HYtyErAyjmvyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49tQBFbWELm3oQUnb_1PqyNt36ZVLkCKZWY8V5sjhUvA&oe=6A01C25F"}, {"file_name": "Untitled2.png", "id": "1244714280322910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1244714283656243_4174352392007358180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7RHYgabvdEQ7kNvwFqvDGH&_nc_oc=Ado7MSxoKcOW_ejQTr--hWDRUchdDcLX6S5w1GM6Jgl9MsGK2e0oFRRihBEgGjvwK0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HODUH9hYH9Uc18a2_JZ4qE7ysheoN1ee6Q9bkMoQOxg&oe=6A01EEDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Taggg", "keywords": ["Tag", "Taggers"], "long_description": "Opium Taggg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Opium Taggg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NXQjN0ACD7qEpo7ezC7mBppSStXjrL4q7PN_3rjSAe8/edit?usp=sharing", "developer_terms_
eECPf6SaRcQWw&oe=6AFDD852"}, {"file_name": "Untitled2.png", "id": "1247744750648568", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823270_1247744757315234_5563637096782840005_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBsKSlfQiTQQ7kNvwET5grW&_nc_oc=AdpraWF01dw5oy_xPKzsyrd6hNlad4jz-689O1WNcb5I6KXg28WWHYOyKXQD3rmIHoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsZ-l2oGnsz2cemspx9BzYTWDT4VK83SG7U8QdGlu1AQ&oe=6AFDC91F"}, {"file_name": "Untitled2.png", "id": "1244714280322910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1244714283656243_4174352392007358180_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DI7YMYZOrigQ7kNvwFEgD-_&_nc_oc=AdpuTVPbQYRUp5hEG5EBzTM_RUF3GvM8kIYcpugfE8XHpWeKe-2wk87rcsBG4vYthtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_pzvl3UWKn2gIqfyv6eROz1e34nOO6m3zY66XO5FniA&oe=6AFDBD5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Taggg", "keywords": ["Tag", "Taggers"], "long_description": "Opium Taggg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Opium Taggg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NXQjN0ACD7qEpo7ezC7mBppSStXjrL4q7PN_3rjSAe8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opium-taggg/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25991977600467546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_1612077949994827_9022639570421804630_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GV9B9gUwJ0sQ7kNvwFMZkzM&_nc_oc=AdoN5xAfsiat-yrwJpGUDGqe7e6j4CsWmv5_jpjH4VRag_DjYHCBP-BQd5MhzkVlazE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStkM5KQ7O9bBNvsbSy3JGKkJXwZh5jjUfMhyJgIbw_Ug&oe=6AFDD201"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Opium Taggg", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1771968900, "lastRevision": {"nodes": [
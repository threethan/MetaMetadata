10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=embawiRkPy8Q7kNvwFX6B0v&_nc_oc=AdrPjwzWuQe9AJLGiKQ3dOXDkTrLMnLUiEAVXQ5wWxhaOP9Tmjj0euVwbTUsK6TINc8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRregWsOY9NIped744GTryshW-v3rwtb_PZOnQvKKWAKA&oe=6AE8B11F"}, {"file_name": "Untitled2.png", "id": "1244714280322910", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824322_1244714283656243_4174352392007358180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rV7Ro06jSBUQ7kNvwHeoX-G&_nc_oc=AdrIJSg_xtq3MIuARfr0_yFF-cDeMmgziN_gQk2xE48nauBEmQcKqUaDclFmW-qlB7I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMSHV-GeCoXJzWnDu1cFOsnGeQEtvJYqr1qd8bm5M0LQ&oe=6AE8A55A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Taggg", "keywords": ["Tag", "Taggers"], "long_description": "Opium Taggg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Opium Taggg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NXQjN0ACD7qEpo7ezC7mBppSStXjrL4q7PN_3rjSAe8/edit?usp=sharing", "developer_terms_
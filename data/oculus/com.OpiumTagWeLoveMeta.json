10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbCU15Gn3p0Q7kNvwE8JVWh&_nc_oc=Adr2c5iu-ByObSbj6i3nk5YeQQcd_pDNsxEWEEtBZtWzm7PaRUJzTlBOBZYxZpNBnmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZIzughvhqhkbaaNbWiHBwLiRLuf5CXMGMTSBV8ltnvQ&oe=6AF09A1F"}, {"file_name": "Untitled2.png", "id": "1244714280322910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1244714283656243_4174352392007358180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqrsEa8zUJgQ7kNvwHDFubX&_nc_oc=AdriCmBNw4_miuC89zVj7v43gQ90YQ7jUCk_DEnACjErMkxVPznWArOsF4VOhe8Rll0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfYNwQhDzrJQ5wIkEJAtjTybH1nbD7L0EOdeZaSFEgng&oe=6AF08E5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Taggg", "keywords": ["Tag", "Taggers"], "long_description": "Opium Taggg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Opium Taggg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NXQjN0ACD7qEpo7ezC7mBppSStXjrL4q7PN_3rjSAe8/edit?usp=sharing", "developer_terms_
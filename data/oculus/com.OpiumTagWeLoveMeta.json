10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXKrWv7xCmQQ7kNvwGBUxSq&_nc_oc=AdpKS2yIGj0ruunwhizdODF_FdOA6j9uA0p9xvWrZuU4EsourMFzKQuZkGf_xL7t7Vg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZQtBMIkvrV7Z7PcDCbOLuuEyEBqPJ24NUXQcnaMjsrA&oe=6A6F2EDF"}, {"file_name": "Untitled2.png", "id": "1244714280322910", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824322_1244714283656243_4174352392007358180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KiQduGx1XQQ7kNvwHBpCyX&_nc_oc=Ado9bvw17-mr0-vLbGSZ1oR_wcHhmB_dR4sNOXw9U-zop3duvTf4ER1pRnOdd7YyEyw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe3PAe16PxyGhDJZCR5gSF_gXLbolf22yNTSiAjoQt0A&oe=6A6F5B5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Taggg", "keywords": ["Tag", "Taggers"], "long_description": "Opium Taggg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Opium Taggg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NXQjN0ACD7qEpo7ezC7mBppSStXjrL4q7PN_3rjSAe8/edit?usp=sharing", "developer_terms_
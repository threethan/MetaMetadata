10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtZ-i7hBzsAQ7kNvwHWvqXi&_nc_oc=AdoQ-icu3dk9RG_Ih1dCjvPgE3qH-aw5kkAdQC25NECZSsXZdzzR4rFoVznMcik7fGw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm6mXn3e_7saz-LklkgzWWTUWUlUIOs9UktxVfmeJKDQ&oe=6AF9D49F"}, {"file_name": "Untitled2.png", "id": "1244714280322910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_1244714283656243_4174352392007358180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1endcQX-SoQ7kNvwFhdLx9&_nc_oc=Adr9GLz3CZOAzNX2tBrZc0zFWlgRECr9KVb2hdy76ptWgLgte40kWL6yDNY4Ob1onUk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPFZzEliIldQauHyw8eia3cCxr51emJTF74j-M0oDGTg&oe=6AF9C8DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Taggg", "keywords": ["Tag", "Taggers"], "long_description": "Opium Taggg drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Opium Taggg is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NXQjN0ACD7qEpo7ezC7mBppSStXjrL4q7PN_3rjSAe8/edit?usp=sharing", "developer_terms_
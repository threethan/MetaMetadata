c_oc=AdoKdmmyFPFt71Ie8LXwjlEBSFEtZmDt9Hspa96_zZEnBhNtDVhBSW9Ef9j2UAhdKKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQX1inBKo3qhUTbTl7EC1eoSoZ5GK0Qm_-88KfmuwhNw&oe=6B0DCB74"}, {"file_name": "5.png", "id": "1118665371154882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842191_1118665374488215_1068122196225135544_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EYiU6oQ2xgQ7kNvwF7izKG&_nc_oc=Adqlss7_GuHbzBjwieLJXKfWCTK49VG1zx_Ma7yASu9tzGxaJYFNHRLU3W6wgsv-v98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQnCMk1PcpstI-xnJRaEJDfR0F-D0rl3aGY1cVDlTAObw&oe=6B0DAF72"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Integrated Energy Assets Home", "keywords": ["educational", "education", "energy", "training"], "long_description": "Step into the future of smart living with Integrated Energy Assets Home, an interactive Virtual Reality experience designed to make learning about energy efficiency, renewable energy, and smart home technologies fun and accessible!\n\nExplore a modern virtual house and discover how different energy systems work together to improve efficiency, reduce energy consumption, and promote sustainability.\n\nThroughout the experience, interact with energy technologies, explore educational information, and discover how smart energy management can contribute to a more sustainable home.\n\nWhat can you explore?\n\n- Solar Energy: Discover how photovoltaic panels generate electricity from sunlight.\n- Solar Thermal Systems: Learn how solar energy can be used to produce domestic hot water.\n- Smart Air Conditioning: Explore heating and cooling systems, adjust operating schedules, and learn about efficient energy use.\n- Electric Vehicles: Discover how electric vehicle charging can be integrated into residential energy systems.\n- Energy Integration: Understand how renewable energy, storage, and household technologies can work together.\n- Interactive Learning: Explore a realistic 3D environment and discover useful information about smart energy solutions.\n\nCreated as part of the REPowerE(d)U project, this free educational application encourages interest in energy efficiency and renewable energy through immersive learning.", "short_description": "Explore a smart, energy-efficient home in Virtual Reality! Discover how solar panels, solar thermal systems, smart air conditioning, energy storage, and electric vehicle charging work together. Interact with energy technologies and learn how integrated solutions can improve efficiency and sustainability."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/102w8sWFsoiJWYIKtN1jhfXD7a_OB5cw-mINgi0jhOjI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Instituto de Sistemas e Robotica - University of Coimbra", "support_website_url": null, "website_url": "https://www.isr.uc.pt/main-page", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sk", "pt", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26317937781205769"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842212_1190006370354591_1648057586579466319_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qECQkymDW0Q7kNvwHmE_8m&_nc_oc=AdoLWFS1VwzXC
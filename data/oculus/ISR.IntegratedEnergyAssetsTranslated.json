scdn.com&_nc_ss=7f30f&oh=00_AQQck6RItoR59mkl1hjgJ_xo8xB7KDXZ9H2nJCZ3910sxg&oe=6B0D9CE0"}, {"file_name": "4.png", "id": "1630120798251291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842226_1630120801584624_5083364582428036652_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-xXYBjg6vUQ7kNvwHa-GjZ&_nc_oc=AdoidBN3haYFfQzf3sp2VUnUYLSsRQZ3-xksVArbz8aKmCsgeCz4n9q0niRDtzTAAok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwbXP8OtvjC2r4W7NozU492W73SErp3LzdIp1Dw_smHw&oe=6B0DC2E8"}, {"file_name": "3.png", "id": "1154585490399528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908850571_1154585493732861_6351193132329258707_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D4-QkrfWU0Q7kNvwGyrm7s&_nc_oc=AdoKdmmyFPFt71Ie8LXwjlEBSFEtZmDt9Hspa96_zZEnBhNtDVhBSW9Ef9j2UAhdKKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQX1inBKo3qhUTbTl7EC1eoSoZ5GK0Qm_-88KfmuwhNw&oe=6B0DCB74"}, {"file_name": "5.png", "id": "1118665371154882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842191_1118665374488215_1068122196225135544_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EYiU6oQ2xgQ7kNvwF7izKG&_nc_oc=Adqlss7_GuHbzBjwieLJXKfWCTK49VG1zx_Ma7yASu9tzGxaJYFNHRLU3W6wgsv-v98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQnCMk1PcpstI-xnJRaEJDfR0F-D0rl3aGY1cVDlTAObw&oe=6B0DAF72"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Integrated Energy Assets Home", "keywords": ["educational", "education", "energy", "training"], "long_description": "Step into the future of smart living with Integrated Energy Assets Home, an interactive Virtual Reality experience designed to make learning about energy efficiency, renewable energy, and smart home technologies fun and accessible!\n\nExplore a modern virtual house and discover how different energy systems work together to improve efficiency, reduce energy consumption, and promote sustainability.\n\nThroughout the experience, interact with energy technologies, explore educational information, and discover how smart energy management can contribute to a more sustainable home.\n\nWhat can you explore?\n\n- Solar Energy: Discover how photovoltaic panels generate electricity from sunlight.\n- Solar Thermal Systems: Learn how solar energy can be used to produce domestic hot water.\n- Smart Air Conditioning: Explore heating and cooling systems, adjust operating schedules, and learn about efficient energy use.\n- Electric Vehicles: Discover how electric vehicle charging can be integrated into residential energy systems.\n- Energy Integration: Understand how renewable energy, storage, and household technologies can work together.\n- Interactive Learning: Explore a realistic 3D environment and discover useful information about smart energy solutions.\n\nCreated as part of the REPowerE(d)U project, this free educational application encourages interest in energy efficiency and renewable energy through immersive learning.", "short_description": "Explore a smart, energy-efficient home in Virtual Reality! Discover how solar panels, solar thermal systems, smart air conditioning, energy storage, and electric vehicle charging work together. Interact with energy technologies and learn how integrated solutions can improve efficiency and sustainability."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/102w8sWFsoiJWYIKtN1jhfXD7a_OB5cw-mINgi0jhOjI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Instituto de Sistemas e Robotica - University of Coimbra", "support_website_url": null, "website_url": "https://www.isr.uc.pt/main-page", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"
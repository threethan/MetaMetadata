c_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh9DzLqn5p_pPJaI5NOgeD2xwz-EFwk4zNuas3-EVEGg&oe=6AC526F9"}, {"file_name": "005.png", "id": "508206964108473", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86613167_508206967441806_5947248506887917381_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLyLtvMYPE4Q7kNvwGLu6CV&_nc_oc=Adrtv0cPkuj9lDVZGFlc4IOYwKzkiNcAEY43Fbr5vzwAdycw2akNPmczvTNxah85LX0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcjnsfet7zB8BnFw5qcfqFaB3CblmEwzujIQJn9oUX8g&oe=6AC51AE1"}, {"file_name": "001 new.png", "id": "1452373495193937", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031647_1452373498527270_7075553710083891822_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9-OvvPBW_gQ7kNvwHXo529&_nc_oc=Adq1eW_jE9DyKTMpUwnH3I9k_yylTPVOZQeAGUz77gGUffvqoZ_zoptt_WT1Y5z316c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPIQTqFZvOVaghz2PRlio_2q-REsYCX0bFb4OHOsF6vw&oe=6AC5189D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QPP_WorldofMechs_2560x1440.png", "id": "275784341430859", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974610_275784344764192_1043956551782677645_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AO_4rXCZhmcQ7kNvwEToLj9&_nc_oc=AdpMHsLnBkdjTicnm7wiEyla-4eO-eHS7eUZ3XnMLQ-E_uvTppgx64GHMre4-Hh3tuQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkG-gAi4T_QR0aRImnbNNSKgwtqvu_HH7Ql7Qf7J5Dow&oe=6AC518E8"}, "display_name": "World Of Mechs", "keywords": ["Action", "Mechs", "Multiplayer", "Shooter", "Deathmatch"], "long_description": "Fire up your boosters and dive into supersized online multiplayer mayhem in VR! World of Mechs ain\u2019t about pressing buttons or flipping switches - it\u2019s all about high-speed, curb-stomping, jump-in / jump-out action. Flex your supremacy in online modes like Team Deathmatch and Domination, or take down bosses in the single-player campaign to become a mech pilot legend. The ultimate VR mech battle awaits!\n\n\"World of Mechs is an instantly enjoyable experience.\" - VRFocus\n\nONLINE ONSLAUGHT: Wreak online foes with up to 3 friends on five maps and 4 modes.\n\nCOMBAT STYLES: Select from 32 mechs across 8 different class types to fit your combat style. Jam radar sensors, enable stealth cloaking, and unleash Barrage missiles to crush the opposition.\n\nCAMPAIGN MODE: Pulverize bosses, earn cash for upgrades and become the best of the best.\n\nBUILT FOR QUEST 2: Headset Targeting System and VR visual performance optimizations customized to enhance gameplay.\n", "short_description": "Fire up your boosters and dive into supersized online multiplayer mayhem in VR! World of Mechs ain\u2019t about pressing buttons or flipping switches - it\u2019s all about high-speed, curb-stomping, jump-in / jump-out action. Flex your supremacy in online modes like Team Deathmatch and Domination, or take down bosses in the single-player campaign to become a mech pilot legend. The ultimate VR mech battle awaits!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.369.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio 369 Inc", "support_website_url": null, "website_url": "http://worldofmechs.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "582224746639555"}, "r
1-25/38974460_717772669407334_7411742698121570967_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LshLnztoP8Q7kNvwHBVmxH&_nc_oc=AdrTA8SZKE_NDCKYp1vDtGn3QvmT6vqD41ZOypxyXFG7_BrRPH7KGSuAK0Ny_QQGeYg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZV_I1pvJ3ubTSMsKjpqJez1EvnFSV1p_fY2QL577W6g&oe=6A01D0B9"}, {"file_name": "005.png", "id": "508206964108473", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86613167_508206967441806_5947248506887917381_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20kFKPChs0MQ7kNvwHIHqQS&_nc_oc=Adr_dT5qYjgppwr2R_0DCbCPAskC_FnIKNG52P8uiY9w2M2OUkQvkU_lTE2rYIveccw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iffPwhsZjq5kDJhfGO-DhwJt3Cst3G6S2yZ8_Kzq5gg&oe=6A01C4A1"}, {"file_name": "001 new.png", "id": "1452373495193937", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031647_1452373498527270_7075553710083891822_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3j8lybjs_MQ7kNvwHvpp4m&_nc_oc=Adp70xUtQhYHHmRrKcTFnEbnLq3vtW3c4g0X1lPghX7b45McAYmGAedCj6Vo22444E0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PkOdFnAICdSV9JQ6Nr3R8aFkPUO--QNdKAttpXCwsUg&oe=6A01C25D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QPP_WorldofMechs_2560x1440.png", "id": "275784341430859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974610_275784344764192_1043956551782677645_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZXGV-L9WBQQ7kNvwHKBLG_&_nc_oc=Adog3WUo1-AWy9EZ2Jt35GMe_3ij9EElwoo-qm1TqMmoP4RJyqfN_COdi8GNZSMQcOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JyxTDhEslZIgDdKsqfbFrGYg2Yh-Kh-2r8oHJntV6sw&oe=6A01C2A8"}, "display_name": "World Of Mechs", "keywords": ["Action", "Mechs", "Multiplayer", "Shooter", "Deathmatch"], "long_description": "Fire up your boosters and dive into supersized online multiplayer mayhem in VR! World of Mechs ain\u2019t about pressing buttons or flipping switches - it\u2019s all about high-speed, curb-stomping, jump-in / jump-out action. Flex your supremacy in online modes like Team Deathmatch and Domination, or take down bosses in the single-player campaign to become a mech pilot legend. The ultimate VR mech battle awaits!\n\n\"World of Mechs is an instantly enjoyable experience.\" - VRFocus\n\nONLINE ONSLAUGHT: Wreak online foes with up to 3 friends on five maps and 4 modes.\n\nCOMBAT STYLES: Select from 32 mechs across 8 different class types to fit your combat style. Jam radar sensors, enable stealth cloaking, and unleash Barrage missiles to crush the opposition.\n\nCAMPAIGN MODE: Pulverize bosses, earn cash for upgrades and become the best of the best.\n\nBUILT FOR QUEST 2: Headset Targeting System and VR visual performance optimizations customized to enhance gameplay.\n", "short_description": "Fire up your boosters and dive into supersized online multiplayer mayhem in VR! World of Mechs ain\u2019t about pressing buttons or flipping switches - it\u2019s all about high-speed, curb-stomping, jump-in / jump-out action. Flex your supremacy in online modes like Team Deathmatch and Domination, or take down bosses in the single-player campaign to become a mech pilot legend. The ultimate VR mech battle awaits!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.369.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio 369 Inc", "support_website_url": null, "website_url": "http://worldofmechs.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
6Oq1a&_nc_oc=AdlU6jCc5CyB85Ne-sSDzAMurCay7lF8V643WZbEeoR_V2QlLXmDVhudfOEeWnbQUBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsnKWZFPkOp6qbYgx_sgDtWkuiBPxi9G_wEmRNcbaxCbA&oe=69A43639"}, {"file_name": "005.png", "id": "508206964108473", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86613167_508206967441806_5947248506887917381_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVDqGYT0uyEQ7kNvwFSOdWt&_nc_oc=Admmgb97Ew5n4kxt16bnAbsaTF0o0NiGoyFhzwQVjOCin8_oBio4mDTm8ADZfgA82Jw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftyA-QQsLXAAyCke7k6JuYgT3HYEfi43tw6Hc2iWOH2Vg&oe=69A42A21"}, {"file_name": "001 new.png", "id": "1452373495193937", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031647_1452373498527270_7075553710083891822_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYVjfTIThFYQ7kNvwH5WQvQ&_nc_oc=Adn-dU9pNEZ2FUpRrxsoKEsUPwQyBD_eklXWUJOz17gHG3nPdHZKct3usVezkQ853ks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvcl14RkexbA5rINCifIWmNaS24oEE7V876VCzHXGssHg&oe=69A427DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QPP_WorldofMechs_2560x1440.png", "id": "275784341430859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974610_275784344764192_1043956551782677645_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufMRw-A4vS4Q7kNvwGcJV9P&_nc_oc=AdkprwPHMe_Q4R_qhUjYtXrjsnFzBArGDAPLzrQB7Njsc1vyOVJdTAlfMPSpE1OiVJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftpXYQBD7sU8EhLc4cy3auds0ZgHNey0LPYopxicZHVgw&oe=69A42828"}, "display_name": "World Of Mechs", "keywords": ["Action", "Mechs", "Multiplayer", "Shooter", "Deathmatch"], "long_description": "Fire up your boosters and dive into supersized online multiplayer mayhem in VR! World of Mechs ain\u2019t about pressing buttons or flipping switches - it\u2019s all about high-speed, curb-stomping, jump-in / jump-out action. Flex your supremacy in online modes like Team Deathmatch and Domination, or take down bosses in the single-player campaign to become a mech pilot legend. The ultimate VR mech battle awaits!\n\n\"World of Mechs is an instantly enjoyable experience.\" - VRFocus\n\nONLINE ONSLAUGHT: Wreak online foes with up to 3 friends on five maps and 4 modes.\n\nCOMBAT STYLES: Select from 32 mechs across 8 different class types to fit your combat style. Jam radar sensors, enable stealth cloaking, and unleash Barrage missiles to crush the opposition.\n\nCAMPAIGN MODE: Pulverize bosses, earn cash for upgrades and become the best of the best.\n\nBUILT FOR QUEST 2: Headset Targeting System and VR visual performance optimizations customized to enhance gameplay.\n", "short_description": "Fire up your boosters and dive into supersized online multiplayer mayhem in VR! World of Mechs ain\u2019t about pressing buttons or flipping switches - it\u2019s all about high-speed, curb-stomping, jump-in / jump-out action. Flex your supremacy in online modes like Team Deathmatch and Domination, or take down bosses in the single-player campaign to become a mech pilot legend. The ultimate VR mech battle awaits!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.369.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "Studio 369 Inc", "support_website_url": null, "website_url": "http://worldofmechs.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"
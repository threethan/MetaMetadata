82575_1310798183686814_5812971563795928112_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdUHyXHC1-AQ7kNvwHFnBbg&_nc_oc=AdrxYHTPe36lyVynApdssvi1yk1WEEaVsnQMnsvGecXF25UMninuknSxpr7bmTgboTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4r00Xe8g6qnF9b0v6HKfztv2AOB0C8re-_ppYUiOi-g&oe=6AAC0936"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VOL_MetaAsset_TrailerCover.png", "id": "1260939805210804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974774_1260939808544137_3081641552621530760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srrRHKIuZdUQ7kNvwE4xh6O&_nc_oc=Adrusj-GTVlSzvPV83vqblGBbXHmUdY5NLFnhrVVkxg_nxCYTzDprs-A4R96MdxABXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpg711pUCvWx6RYPXAUog_SN6PwfSTq0HuPXjcTHesJA&oe=6AAC04CB"}, "display_name": "Volara", "keywords": [], "long_description": "FLY LIKE A KID, FEEL LIKE A PILOT!\nVolara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, overcome challenging boss fights and become a Top Pilot!\n\nADVENTURE AWAITS, UNLOCK NEW AIRCRAFTS\nWander through the skies alongside friendly toys, navigate intricate tiki mazes, or dare to enter the depths of a treacherous volcano. But that\u2019s just the beginning. As you progress, you\u2019ll unlock new planes and worlds to explore. Soon you might even reach the cosmos!\n\nFUN & INTUITIVE FLYING CONTROLS\nWhen we were kids, we used to play with toy airplanes, the interface was very simple: our hands! Get ready for the most intuitive flying experience you\u00b4ve ever had. With a simple twist of the wrist, you can control your plane and fly anywhere. It feels amazing, experience true freedom!\n\nEPIC BOSS FIGHTS!\nNo true adventure is complete without the thrill and challenge of an epic boss fight. In Volara, you'll earn your wings as a top aviator by facing the danger head on. Will you rise to the occasion as a Master Pilot? The sky's the limit!\"", "short_description": "Volara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, and overcome challenging boss fights and become a Top Pilot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flamingosimulation.com/avisodeprivacidad", "developer_terms_of_service_url": null, "publisher_name": "Flamingo Simulation Systems SA de CV", "support_website_url": null, "website_url": "https://www.flamingosimulation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "it", "ko", "ja", "es_MX", "pt_BR", "pt", "es_CO", "ru", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9215447105142807"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035447_570648695552459_8937920203707735986_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWdT6IJP3gAQ7kNvwEopfPk&_nc_oc=AdpkjHQIuJCArawiVSC5z7td-T-gUAsAKNtjzG9cxYvJbUH8cUjwdyHU5BD0uZvSBzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk7UUh8TwEcslL_q_vyCAzi_RSuKjMe1PnilEJ5cGcqA&oe=6AABE06E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Volara", "platform": "ANDROID_6DOF", "context_category": {"
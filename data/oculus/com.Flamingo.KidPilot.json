LABsPGc5YGRL6jTGQNLCs9xNWrSFt0gwNR-iCre3N5n4648bF8LBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTj-mVxb26kgI5sSkPocnaUWKpZASpkW1TpGx02WzeDA&oe=6B05B5BE"}, {"file_name": "VOL_MetaAsset_Screenshot02.png", "id": "1158155365640441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75540508_1158155368973774_5142507775462658658_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTrO-nqPf-IQ7kNvwFfl7nl&_nc_oc=AdoUWXqOuleWeDEJlO93by1Hw3EtjndN3T7J3VJ-Uk1jKU4dXVX5BZRldcsGzveVxo4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7tTEXk2yBpiNzSRskDSd7BWxBxLpCcOJwE04Ltcbxkw&oe=6B05A851"}, {"file_name": "VOL_MetaAsset_Screenshot06.png", "id": "3922299701316370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982440_3922299704649703_5175671950193182139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rS-FlYZjqWwQ7kNvwGInelN&_nc_oc=AdrZgPBjrczWeVT3fwrkLKA_oumgIJzMJwY0eyup0K6r5bNLJYfrRh0YGizDKF55eTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJDSYwbw-qHSj7sy3LsHof7w1LhchtTfd7vK1HljrheQ&oe=6B05B7EE"}, {"file_name": "VOL_MetaAsset_Screenshot01.png", "id": "1310798180353481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982575_1310798183686814_5812971563795928112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcGBiOmtk4sQ7kNvwH9JZZE&_nc_oc=AdpsjpR-u_eqj21C1skdbbe7O3G_aln84wvyP-Kwvg97BmdOlDS1UjBTJ_BCcOhk-9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR97btjOxK1N-WuiGMv54AQ0rP0h3Ipy93UlKx6TuvPqw&oe=6B05AF36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VOL_MetaAsset_TrailerCover.png", "id": "1260939805210804", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_1260939808544137_3081641552621530760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gfEqVmiqq4Q7kNvwFebnTJ&_nc_oc=AdrIztub-U-_LvtmMJYceuanJ2DnjiKTEYvezXq7piN2LdSgKA4M2Qy-g3X6i-6Fnt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSubJk0G-54hwEoar4fyJggv7nQ-1gYwdsxgaknQvf81Q&oe=6B05AACB"}, "display_name": "Volara", "keywords": [], "long_description": "FLY LIKE A KID, FEEL LIKE A PILOT!\nVolara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, overcome challenging boss fights and become a Top Pilot!\n\nADVENTURE AWAITS, UNLOCK NEW AIRCRAFTS\nWander through the skies alongside friendly toys, navigate intricate tiki mazes, or dare to enter the depths of a treacherous volcano. But that\u2019s just the beginning. As you progress, you\u2019ll unlock new planes and worlds to explore. Soon you might even reach the cosmos!\n\nFUN & INTUITIVE FLYING CONTROLS\nWhen we were kids, we used to play with toy airplanes, the interface was very simple: our hands! Get ready for the most intuitive flying experience you\u00b4ve ever had. With a simple twist of the wrist, you can control your plane and fly anywhere. It feels amazing, experience true freedom!\n\nEPIC BOSS FIGHTS!\nNo true adventure is complete without the thrill and challenge of an epic boss fight. In Volara, you'll earn your wings as a top aviator by facing the danger head on. Will you rise to the occasion as a Master Pilot? The sky's the limit!\"", "short_description": "Volara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, and overcome challenging boss fights and become a Top Pilot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flamingosimulation.com/avisodeprivacidad", "developer_terms_of_service_url": null, "publisher_name": "Flamingo Simulation Systems SA de CV", "support_website_url": null, "website_url": "https://www.flamingosimulation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tag
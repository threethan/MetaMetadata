ycFZo-0AWe-gtFIEQc-LktSMVb01joaVwg_BNVuJqzdfUFoxo5rhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThhO8QjyjXDmAwnzbCRoQQ9c72xdz0KjNFfIPkWdQ7rA&oe=6B07073E"}, {"file_name": "VOL_MetaAsset_Screenshot02.png", "id": "1158155365640441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75540508_1158155368973774_5142507775462658658_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTrO-nqPf-IQ7kNvwG_kP5z&_nc_oc=AdrPqAb2lkTuZOPb-eDAz48hc6p5at6Re77f1ExBjlgHb1DOAzpcF3cuGP4v4QVSfoo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTARvUcLjHuZ43MTZlsOUK35QH2tHkox7zePsn-5Lhs6w&oe=6B06F9D1"}, {"file_name": "VOL_MetaAsset_Screenshot06.png", "id": "3922299701316370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982440_3922299704649703_5175671950193182139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i2RhE6YA7AQ7kNvwGuzRek&_nc_oc=AdrmJv7Cws_9pjNVzEkdO8b3h8NVdL7dnpw06_GAQSXCyuV6mzpNKrXvpX1DgAG_tYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1_uHGCr2MaSQHxrSJbgdMTNK4whiGlZ_wlgxzp6QnKA&oe=6B07096E"}, {"file_name": "VOL_MetaAsset_Screenshot01.png", "id": "1310798180353481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982575_1310798183686814_5812971563795928112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAaVRFTNqHMQ7kNvwFLXLOh&_nc_oc=Adrr5IKEmzMxW2OZZoAhKpiblxM4jKuQRPRRnbRITtHWdSVgvKIP3aWbq94n6DGhuTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdmuHsHv9QetfD7VTnUfAq8Yj5ZTypmBGEcBxebCtCxg&oe=6B0700B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VOL_MetaAsset_TrailerCover.png", "id": "1260939805210804", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_1260939808544137_3081641552621530760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gfEqVmiqq4Q7kNvwHOR1RL&_nc_oc=AdqvTzRtTvNUUPTsgKBduAVr0Hq4xLF3IJJrjwPrCL5cI5m8V7GHp3NJQS5S4s3GsDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXl4meIplsCsaClObjjHJPdfdoq4F9fh_TKzl9FKZ3uw&oe=6B06FC4B"}, "display_name": "Volara", "keywords": [], "long_description": "FLY LIKE A KID, FEEL LIKE A PILOT!\nVolara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, overcome challenging boss fights and become a Top Pilot!\n\nADVENTURE AWAITS, UNLOCK NEW AIRCRAFTS\nWander through the skies alongside friendly toys, navigate intricate tiki mazes, or dare to enter the depths of a treacherous volcano. But that\u2019s just the beginning. As you progress, you\u2019ll unlock new planes and worlds to explore. Soon you might even reach the cosmos!\n\nFUN & INTUITIVE FLYING CONTROLS\nWhen we were kids, we used to play with toy airplanes, the interface was very simple: our hands! Get ready for the most intuitive flying experience you\u00b4ve ever had. With a simple twist of the wrist, you can control your plane and fly anywhere. It feels amazing, experience true freedom!\n\nEPIC BOSS FIGHTS!\nNo true adventure is complete without the thrill and challenge of an epic boss fight. In Volara, you'll earn your wings as a top aviator by facing the danger head on. Will you rise to the occasion as a Master Pilot? The sky's the limit!\"", "short_description": "Volara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, and overcome challenging boss fights and become a Top Pilot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flamingosimulation.com/avisodeprivacidad", "developer_terms_of_service_url": null, "publisher_name": "Flamingo Simulation Systems SA de CV", "support_website_url": null, "website_url": "https://www.flamingosimulation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tag
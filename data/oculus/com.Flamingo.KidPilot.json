SqUTeX94FgPGWMA3etcXDN_eM0SgtiwlKQetDquSy4_LpZnMmvFKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9vHL8xGxvART8KsHcI5ewbTHspcgXtLjiiVYpGLUvxg&oe=6B01C13E"}, {"file_name": "VOL_MetaAsset_Screenshot02.png", "id": "1158155365640441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75540508_1158155368973774_5142507775462658658_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTfWP2hjBa4Q7kNvwFDnF-Z&_nc_oc=AdrDDhlk9Ts1j7N_447ezB0zHOeonqM8IDwR8XqJ64rYHn4K48ojM8u6kYTsiCcJ7nE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWrbkw2lsU0PPa-RWSOmKF3c1kklTBUjz3pzsZovYdwA&oe=6B01EC11"}, {"file_name": "VOL_MetaAsset_Screenshot06.png", "id": "3922299701316370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982440_3922299704649703_5175671950193182139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWKqjDDBAeIQ7kNvwGudVgo&_nc_oc=Adq6htveNEXNCeSlL43JlZ-JEZY1D05Ssk1oOQ_SMUoz5fmdi1Uzf1ZdhEw41txKOis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtUw2WEAF3uPAe30GczdSf2PJchTaad0lp4L1QCSVXOA&oe=6B01C36E"}, {"file_name": "VOL_MetaAsset_Screenshot01.png", "id": "1310798180353481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982575_1310798183686814_5812971563795928112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAi2esmESCAQ7kNvwGpIoJJ&_nc_oc=Adp6ogGlL38fdgQWjUUPK_FDAXJenBrjwKsry0kiNAxLbrXerCrqHKCUDetsp9WD63I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzgHGCIwpWpaz-88wbCqPzjxwqlX1oA0Uul7t8hHEFTA&oe=6B01BAB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VOL_MetaAsset_TrailerCover.png", "id": "1260939805210804", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_1260939808544137_3081641552621530760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqbvNe6pzN0Q7kNvwEyTJzW&_nc_oc=AdqPWv3w7EB2_qQp29f1wHe9T02NLL82fI8IjjTWBogIrz0x2Uaa0dhynPKLy-z5qTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtS6-ptDi4MroyzZqfhaHuLGZXXZ7hsXMTJHYpRfxBTQ&oe=6B01EE8B"}, "display_name": "Volara", "keywords": [], "long_description": "FLY LIKE A KID, FEEL LIKE A PILOT!\nVolara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, overcome challenging boss fights and become a Top Pilot!\n\nADVENTURE AWAITS, UNLOCK NEW AIRCRAFTS\nWander through the skies alongside friendly toys, navigate intricate tiki mazes, or dare to enter the depths of a treacherous volcano. But that\u2019s just the beginning. As you progress, you\u2019ll unlock new planes and worlds to explore. Soon you might even reach the cosmos!\n\nFUN & INTUITIVE FLYING CONTROLS\nWhen we were kids, we used to play with toy airplanes, the interface was very simple: our hands! Get ready for the most intuitive flying experience you\u00b4ve ever had. With a simple twist of the wrist, you can control your plane and fly anywhere. It feels amazing, experience true freedom!\n\nEPIC BOSS FIGHTS!\nNo true adventure is complete without the thrill and challenge of an epic boss fight. In Volara, you'll earn your wings as a top aviator by facing the danger head on. Will you rise to the occasion as a Master Pilot? The sky's the limit!\"", "short_description": "Volara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, and overcome challenging boss fights and become a Top Pilot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flamingosimulation.com/avisodeprivacidad", "developer_terms_of_service_url": null, "publisher_name": "Flamingo Simulation Systems SA de CV", "support_website_url": null, "website_url": "https://www.flamingosimulation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tag
VlOJpcVbL_cMw2f-xJgwK9GYCrhJXQsok_VEWts59Bna_ic1mrwZQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8xednz33anvbFUmKAt4pSiQ9nA5lNN22ywcsvI1r5SA&oe=6AFB29BE"}, {"file_name": "VOL_MetaAsset_Screenshot02.png", "id": "1158155365640441", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75540508_1158155368973774_5142507775462658658_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u2VrfTAdA0Q7kNvwHesQ0o&_nc_oc=Adrs0CDxZgEADaTltWUqm5zvzwFOU6CVbfNozNgPI_aOosFTa3kMb0x8JziLt6yG4xA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIKPLpXcVbhB0RvaRT-Da8AV159BeiiXPQUEPSTB45bg&oe=6AFB1C51"}, {"file_name": "VOL_MetaAsset_Screenshot06.png", "id": "3922299701316370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982440_3922299704649703_5175671950193182139_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFQNYaoO_JgQ7kNvwGf_VYE&_nc_oc=AdoyVuPA3JyX2Q30STblATn3pz_nKZznP1ustmyCuR6bN-6oeMcFAb8e_gVMe1rZFQc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIu1p-c5BJvZ1zUV6M9-swQ-NHG8pMxKKFBKKqkdDAjA&oe=6AFB2BEE"}, {"file_name": "VOL_MetaAsset_Screenshot01.png", "id": "1310798180353481", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982575_1310798183686814_5812971563795928112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO8yAMkePg4Q7kNvwHqX2gh&_nc_oc=Adq6_WsC1Zc0K7wi6zT3fjMIVRtEabQBVve76HXQGx7iPAWyvseCcgpfYNIMRoZCwiA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdG6w5sW96yKmJHy_KzgQQYbX9XLFfKZ_Pnyd4qayUbA&oe=6AFB2336"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VOL_MetaAsset_TrailerCover.png", "id": "1260939805210804", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974774_1260939808544137_3081641552621530760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2d02hM7pYvUQ7kNvwE2py2T&_nc_oc=AdoBkYV1XYoXEuHRKrFIwlPT6diwrvopA1j2YUX0kthzXuZajcE1LIP9OxWKVQ-8SIc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX8DfTatPgtbxF3Timz6gHCdGdILC2tWn4MJEcSU_PHA&oe=6AFB1ECB"}, "display_name": "Volara", "keywords": [], "long_description": "FLY LIKE A KID, FEEL LIKE A PILOT!\nVolara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, overcome challenging boss fights and become a Top Pilot!\n\nADVENTURE AWAITS, UNLOCK NEW AIRCRAFTS\nWander through the skies alongside friendly toys, navigate intricate tiki mazes, or dare to enter the depths of a treacherous volcano. But that\u2019s just the beginning. As you progress, you\u2019ll unlock new planes and worlds to explore. Soon you might even reach the cosmos!\n\nFUN & INTUITIVE FLYING CONTROLS\nWhen we were kids, we used to play with toy airplanes, the interface was very simple: our hands! Get ready for the most intuitive flying experience you\u00b4ve ever had. With a simple twist of the wrist, you can control your plane and fly anywhere. It feels amazing, experience true freedom!\n\nEPIC BOSS FIGHTS!\nNo true adventure is complete without the thrill and challenge of an epic boss fight. In Volara, you'll earn your wings as a top aviator by facing the danger head on. Will you rise to the occasion as a Master Pilot? The sky's the limit!\"", "short_description": "Volara is a flight adventure game where you soar through amazing worlds just by moving your hand. Explore beautiful environments, earn badges, discover secrets, and overcome challenging boss fights and become a Top Pilot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flamingosimulation.com/avisodeprivacidad", "developer_terms_of_service_url": null, "publisher_name": "Flamingo Simulation Systems SA de CV", "support_website_url": null, "website_url": "https://www.flamingosimulation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tag
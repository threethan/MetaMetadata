Nc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyXTH7h44_JvMkVY-IF3rpwQ7dCiFV1XAxu-kJYyBuUw&oe=6B0D9E5C"}, {"file_name": "wefwefsdfsdfsvdvsdvssdv.png", "id": "1665383954680469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593718973_1665383958013802_1115177627390358754_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKlZPlKQpoIQ7kNvwFwn0tt&_nc_oc=AdrXrtc-Cryy-rNxvPbdtPB9IaaAFr3Zf7DyAID7IAeC327Vmup3goNtW39co5LMFeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_MnxQIm--lfdy47ja_GYy_oDJDIf6oQuVF9kkdkie0A&oe=6B0DC4CF"}, {"file_name": "wefwefsdfsdfsvdvsdvssdv.png", "id": "1596375212155927", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507819003_1596375215489260_4421344105463305652_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8RQGO3fbQgQ7kNvwEHGljG&_nc_oc=AdoWouT577NeB7TM16jQGT5qfxsKLEmD4IjOXiI9WKYas4Db4RHYGCh3Zv5i85mQLmo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSXoTbq93hTSEOcwABgF4yCtRICBG9XWwlc3Q2OlR2Ng&oe=6B0DA1E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey VR", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Monkey VR drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Monkey VR is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1233XUV40tLCq4H8jjU_TgVyh3PHHWzDPCcjSVbWsdTQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-vr-site/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1142848038915260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_1265199035692694_8356656805325471148_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhLbHP4W2LAQ7kNvwEAYsB4&_nc_oc=AdrYArsm-nHB2Sc6Jb4kfMh2ulKcTPTFVY1DEjc2BJH39Vd-3m8E7V_X8vkhb4V2okA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgrb2YPyINJH0Ygvkt10EzvllMW083IpHfDIS-WByGvQ&oe=6B0DB85A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
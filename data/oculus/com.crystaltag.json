1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWDr5FSUYYCSdWxfb_Qp86ZatKIJjZ8GQL4l3861bqMg&oe=6B09A9DC"}, {"file_name": "wefwefsdfsdfsvdvsdvssdv.png", "id": "1665383954680469", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593718973_1665383958013802_1115177627390358754_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4irP7ckk0MQ7kNvwG5Ocpl&_nc_oc=AdoppDQpSGK5KXqGqr64s6pUxzcjQFVFTpL9Z6jI2GIrEmValqgPNdn5SQP8bg2xxiE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvE-bu4lIHkp3xRetvf-dIUWsr84Ui3SvdfFZGHriakg&oe=6B09D04F"}, {"file_name": "wefwefsdfsdfsvdvsdvssdv.png", "id": "1596375212155927", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507819003_1596375215489260_4421344105463305652_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4hcMJBopKYQ7kNvwHjjCdT&_nc_oc=AdriqfczNcHMLXD-f6AbaxHhx3O9H6WUdw5vZQgSPLfVP1-gRn4aIgDxSZCZNefvF_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq_9Cek9FzBtBAg6I-8k7EYIG10Po7RImANf4-0kWm9A&oe=6B09AD66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey VR", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Monkey VR drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Monkey VR is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1233XUV40tLCq4H8jjU_TgVyh3PHHWzDPCcjSVbWsdTQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-vr-site/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1142848038915260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312236_1265199035692694_8356656805325471148_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTqU3V70LakQ7kNvwHgdg2P&_nc_oc=AdpDbLVhobaRTV7oajFX3TsZE3Om5gYk6lG5OuKo8__pKd_fnOg_wSOKZlicFw8IHlM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBGhzwasx4jdv0ea6-KLSl80si8KKXDB1g2qJNUAq-dQ&oe=6B09C3DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
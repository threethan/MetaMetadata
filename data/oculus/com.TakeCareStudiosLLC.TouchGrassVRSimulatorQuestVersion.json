oe=69BA8C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_coverimage.png", "id": "911568931028401", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75500285_911568934361734_7687251914336321629_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rjtt6vC2fIQ7kNvwGseQ_b&_nc_oc=AdkDh-8GYfuVENMW06kmxUYT468PudNV-b0bHOS64iaBQm3nfP1Im_fKTPC2uml81O4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwmn4zP-hZVgNz3wmqyVvrHVOf3D45MIuuy6jcNL7P22w&oe=69BA81E4"}, "display_name": "Touch Grass VR Simulator", "keywords": [], "long_description": "Has anyone ever told you to touch grass? Do you remember how that felt? Terrible. It felt terrible. Now you can touch real virtual grass from the safety of your home!\n\nRELAX\n\nEnjoy the calm virtual environment that allows you to simulate being out in the real world touching grass.\n\nTOUCH GRASS\n\nTouch real virtual grass designed specifically to be touched from the safety of your home! \n\nMINI GAME\n\nPlay the touch grass minigame, where you can count how many times you have touched grass! How much grass can you touch?", "short_description": "Touch Grass VR Simulator is a VR experience where you can relax in a virtual environment and touch grass virtually, without actually going outside!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://takecarestudiosllc.github.io/privacypolicy.html", "developer_terms_of_service_url": "https://takecarestudiosllc.github.io/termsofservice.html", "publisher_name": "Take Care Studios", "support_website_url": null, "website_url": "https://takecarestudiosllc.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gr
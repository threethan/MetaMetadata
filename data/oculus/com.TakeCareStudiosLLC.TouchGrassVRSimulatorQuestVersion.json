oXWKVjc3hsYLZoyB3YVCSRTg1jBuWfSLrohu4WgsNCQbmvuCdIGbR8oHAUK3EDWCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDraAK2tQwet-m70HjNIWfKYbXPikZMNuuGeb28xBEU-A&oe=6A510FB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_coverimage.png", "id": "911568931028401", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75500285_911568934361734_7687251914336321629_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VpWltUDkkIQ7kNvwF9Q-OS&_nc_oc=AdoYW8znhNu0Mdt96L8Id2pD8hjp_8Mzzl3k7R3shcUKkFiRIqus6uwCEMfetgC2Blo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqBj-VpcFaRiQNbHrCjn7JM1xVzU4KwNj3nMmQpVlqCA&oe=6A510524"}, "display_name": "Touch Grass VR Simulator", "keywords": [], "long_description": "Has anyone ever told you to touch grass? Do you remember how that felt? Terrible. It felt terrible. Now you can touch real virtual grass from the safety of your home!\n\nRELAX\n\nEnjoy the calm virtual environment that allows you to simulate being out in the real world touching grass.\n\nTOUCH GRASS\n\nTouch real virtual grass designed specifically to be touched from the safety of your home! \n\nMINI GAME\n\nPlay the touch grass minigame, where you can count how many times you have touched grass! How much grass can you touch?", "short_description": "Touch Grass VR Simulator is a VR experience where you can relax in a virtual environment and touch grass virtually, without actually going outside!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://takecarestudiosllc.github.io/privacypolicy.html", "developer_terms_of_service_url": "https://takecarestudiosllc.github.io/termsofservice.html", "publisher_name": "Take Care Studios", "support_website_url": null, "website_url": "https://takecarestudiosllc.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315
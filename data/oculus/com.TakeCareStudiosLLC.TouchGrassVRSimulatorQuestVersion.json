pAF4Bt5e32PREEgRNP6JfG_9W3sgMwA-s_U6bx8FTDjD57cbCUDOhEGdG9XmdA_bc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZZWgGTmWRTtBG8a0ZtV1eaRCQ4OJOU71ZzgTxa625cA&oe=6A3D4933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_coverimage.png", "id": "911568931028401", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75500285_911568934361734_7687251914336321629_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GUZlFfXitEQ7kNvwERJ0TL&_nc_oc=AdoD4St89hLpfOO46TAE7aZXD5y5CqdUsBSCaKcpmahtLT3Z4AMRjLd1LGdiVIXtnCE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pNzfiDTiLpdXccph3pTuawarkjm8mSdubnHv6K3nV6A&oe=6A3D3EA4"}, "display_name": "Touch Grass VR Simulator", "keywords": [], "long_description": "Has anyone ever told you to touch grass? Do you remember how that felt? Terrible. It felt terrible. Now you can touch real virtual grass from the safety of your home!\n\nRELAX\n\nEnjoy the calm virtual environment that allows you to simulate being out in the real world touching grass.\n\nTOUCH GRASS\n\nTouch real virtual grass designed specifically to be touched from the safety of your home! \n\nMINI GAME\n\nPlay the touch grass minigame, where you can count how many times you have touched grass! How much grass can you touch?", "short_description": "Touch Grass VR Simulator is a VR experience where you can relax in a virtual environment and touch grass virtually, without actually going outside!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://takecarestudiosllc.github.io/privacypolicy.html", "developer_terms_of_service_url": "https://takecarestudiosllc.github.io/termsofservice.html", "publisher_name": "Take Care Studios", "support_website_url": null, "website_url": "https://takecarestudiosllc.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315
=6B0F1D1D"}, {"file_name": "Ekran Resmi 2026-11-17 21.03.10.png", "id": "1305313045074344", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908835839_1305313048407677_8029821814476095198_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u1FmTG_qA0Q7kNvwENXRla&_nc_oc=Adp_uNOESBhfW8CsU-L0FWOADuB2bLgtHvcNfo8UqAN90Mv5ut85AlgfkDdfMpNyjaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcBfVWGqCE_ocf71gqI-gOBu9Ilj8-BgUx8U2Pf2bosQ&oe=6B0EF2A3"}, {"file_name": "Ekran Resmi 2026-11-17 21.10.34.png", "id": "1756896882077935", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908835885_1756896885411268_8075393937118890939_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTJYmCncNsUQ7kNvwHLUogA&_nc_oc=AdqDSuJFmKLxtSkfxI9jqlQORsjxvM_3gEIjti6AEqkxfMQo3H-yt__f398yoViwpaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUTYLL5u2HkpI9A8qsLsCu_vWEY_wRgn_ryhERbWb1mNw&oe=6B0EF097"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holy Quran \u2014 Offline Reader", "keywords": ["quran", "koran", "islam", "muslim", "kuran"], "long_description": "Holy Quran is a calm, distraction-free Quran reader built for Meta Quest.\n\nRead the Arabic Uthmani text with the trustworthy Pickthall English translation or Elmal\u0131l\u0131 Hamdi Yaz\u0131r's Turkish translation, side by side. Choose a dark or sepia reading theme, resize the Arabic text, bookmark verses, jump back to where you left off, and search the whole text \u2014 all without an internet connection.\n\nDesigned for a panel on Quest:\n\u2022 Arabic + English or Turkish translation for every verse\n\u2022 114 surahs, 6,236 verses, fully offline\n\u2022 Audio recitation with continuous playback and repeat modes\n\u2022 Dark and sepia themes, adjustable Arabic font size\n\u2022 Bookmarks, continue reading, and full-text search\n\u2022 Privacy first: no accounts, no analytics, no ads\n\nThe Arabic text follows the Uthmani Hafs Mushaf. English translation: Mohammed Marmaduke Pickthall (1930, public domain). Turkish translation: Elmal\u0131l\u0131 Muhammed Hamdi Yaz\u0131r (public domain in T\u00fcrkiye since 2013). See Sources & licences inside the app.", "short_description": "Read the Quran offline on Meta Quest \u2014 Arabic text with English (Pickthall) and Turkish (Elmal\u0131l\u0131) translations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ozlusozler.com/app-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "GamePegasus", "support_website_url": null, "website_url": "https://ozlusozler.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1446851328507678"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842256_29745418368417606_2559666782302919772_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYMvrEyBIIYQ7kNvwFDX_TI&_nc_oc=Adod9tfuWTIlgZG8B-ou6U-GKdlv5JKnK5HM8LG4_tUCmcWiwQ-0igtLIhxUzKCiVd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW3S6vcfXLYjOvrL19F1M-f7gSaXEH0fV2NHGTSC04DzQ&oe=6B0F1C8A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Holy Quran \u2014 Offline Reader", "platform": "ANDROID_6DOF", "c
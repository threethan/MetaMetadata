, "id": "1483228610171148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619374_1483228613504481_2781004320653405207_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23gj1FyR7EEQ7kNvwEC0ADf&_nc_oc=AdpdGFGvG4Qh1lvA-b4_INdRIUIf1NQwzMv2anqDcWgJN_1GOSdGEPb2BZwoatvgn5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHADzYEsTRPCd1icZOJywcLC751xRxCb8i0YhK-uaRPag&oe=6A707F1E"}, {"file_name": "5.png", "id": "1506603330959710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299922_1506603334293043_4316439182611322543_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auf9pRhl9uQQ7kNvwERDQuP&_nc_oc=AdpPPGQF3jY_wSLWlKnzuYm_bM2LOwuS5fzWoUAFglHAkUTvWdoWK_CrxbwEHvz0fuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP5V-9hOVer4oKBWQnG8xKdOFhLP9EOz94n6Hf90XkBA&oe=6A707D96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Music Performance Kit", "keywords": [], "long_description": " VR Music Performance Kit puts your sheet music, chord charts, and practice patterns directly in your field of view while you play, so\n  you can keep your eyes on your instrument, your hands, and the people around you.\n\n  Load your charts as PNG images onto your Quest headset and they appear as crisp, floating panels in passthrough, with the real world\n  fully visible around them. Whether you are rehearsing alone, playing in an ensemble, or performing on stage, your music is always\n  exactly where you need it without a music stand, a tablet, or a page turner in sight.\n\n  The app displays two panels side by side: one for your Real Book charts and one for practice patterns, scales, or anything else you want\n   at a glance. You can turn pages with a simple pinch gesture, switch between panels with a fist, and grab and drag either panel to place\n   it exactly where it feels natural for your setup. If you need a clear sightline to a conductor, a single gesture hides the patterns\n  panel and slides your chart to the side.\n\n  A built-in chromatic tuner listens through the headset microphone and displays your pitch, note name, and cents offset in real time, so\n  you can tune up without reaching for a separate device. A live volume meter sits alongside it, giving you a constant read on your output\n   level.\n\n  Everything is designed to be operated entirely by hand. No controllers, no buttons, no interruption to your playing.", "short_description": "  VR Music Performance Kit puts your sheet music, chord charts, and practice patterns in front of you while you play: no stand, no paper,\n   no looking away from your instrument.\n\n  Load PNG images onto your Quest and they appear as floating panels in passthrough, keeping the real world fully visible. Turn pages,\n  reposition panels, and switch between your Real Book and practice patterns using hand gestures alone: no controllers required."}]}, "developer_name": "David Harper", "developer_privacy_policy_url": "https://www.atonalfugue.net/vrpolicy", "developer_terms_of_service_url": null, "publisher_name": "David Harper", "support_website_url": null, "website_url": "https://www.atonalfugue.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1197108996808994"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310726_1350965593582951_7034679023458204419_n.png?stp=
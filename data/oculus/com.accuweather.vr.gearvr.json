ther", "travel", "forecast", "video"], "long_description": "Get ready for a game-changing virtual experience where AccuWeather, the largest, most accurate source of forecasts and weather warnings in the world, takes you to new heights!\n\nWith AccuWeather- Weather for Life, you can view engaging 360 video content, current weather conditions, a daily and hourly forecast, and AccuWeather MinuteCast\u00ae, the leading minute-by-minute precipitation forecast, hyper-localized to your exact location.\n\nImmerse yourself in an array of weather animations like stormy rain, snow, thunderstorms, and clouds, all which can be accessed either through a secret weather feature called WeatherScape, or experienced during one of your daily forecasts. ", "short_description": "Get ready for a game-changing virtual experience where AccuWeather, the largest, most accurate source of forecasts and weather warnings in the world, takes you to new heights!\n\nWith AccuWeather- Weather for Life, you can view engaging 360 video content, current weather conditions, a daily and hourly forecast, and AccuWeather MinuteCast\u00ae, the leading minute-by-minute precipitation forecast, hyper-localized to your exact location.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.accuweather.com/en/privacy", "developer_terms_of_service_url": "http://www.accuweather.com/en/legal", "publisher_name": "AccuWeather Intl., Inc", "support_website_url": null, "website_url": "http://www.accuweather.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supporte
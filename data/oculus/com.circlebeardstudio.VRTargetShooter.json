NYDS4iBiVseDCCkutyfu292hYaJ6jE-tX8lI0P9y4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98ofjkuM_W2t9_-33LlYxs8MfeqZ68HWnVz2x6fQEC0Q&oe=6A36B7E2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCOUNIk4nF8Q7kNvwEHL54A&_nc_oc=AdolXbxqz_z4Xd9P9quXYR5Oo4uoJVj3p6Ca1IXQlvyy0GX_I1HwqYtKN7EnqzQy4yM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c_M-ZkFPaKI1a8em9lUoT7Yjcn1TSVBRGFGkvdF7T0w&oe=6A369756"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0CMQirhkqIQ7kNvwHfcdaW&_nc_oc=AdqL5_SUEnpyXOi3_-bQGq66759iKdBbCCid4iE-FyeAWXEtwBdrJtwIPCioEq7PqO0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RpyInjSvex238lqGxYIueTqJmh6hSDw16YUOi3XlVtQ&oe=6A36B5A0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dfMhVMB4ysQ7kNvwFyWwk-&_nc_oc=AdqYBvCcygkj3aTTOIPwAG6PQKIM0ykIgNQacqrNRk5m_HNFMyV7bG-taTJdFKl-k1k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TxN4edIplEberk4jd9eBr-dJUknfgYLmE3Adp2ZAAjw&oe=6A369A47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TwreS8_094Q7kNvwHNWusA&_nc_oc=AdoGcq9mmQ9Boe0ksXlQ0JwTax1rglSz8VbiJv5XxCGBRhapV9EnheQgh-uVgjgFgoc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NVX0CNeuMDzkvgaie5zTuCCMTFCuLPdFKDy9QAuDz_g&oe=6A36929A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
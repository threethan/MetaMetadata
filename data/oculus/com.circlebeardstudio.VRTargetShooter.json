YoTF7Vgf3sNMuGHOhAwjOy9Hkgg41j1Lw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfn_bPija_tRCm5GwXL2KqhlqCzjfa_HSPKi6D3PaY9g&oe=6AE36C62"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ua4PGzivFNQQ7kNvwEkdfeW&_nc_oc=AdoappRy_uXPp74ZXHW8YBNku2rbANhk8BQGKXzEoxSVXwOfidv8eAvfSzyboxpWoBU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUz2xg0CSSvJQ0Tu5skfIs-ZpUGCbDTn7HBIsDzWJU9g&oe=6AE34BD6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbJcVNJYL0AQ7kNvwFC8hJ2&_nc_oc=AdoNVaxNY1eR4NV72r_fhklYk30QK0P7Khb4e7zSju-crIbhHDfjuyEdsDRH6Zc5bAI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8Mizo6_IZ9OFQiZgDUc_Sgol-vyIJX80Cc3YB7VJ1fw&oe=6AE36A20"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og7TYxSCkSQQ7kNvwEqsSPH&_nc_oc=AdqiElZgDo4d2WUEvF60mEPPwcmeA2nxaVcQ1Cih07nDDGXV9PifyYidfCaIg_vItzE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAfgicnaJwylgkL1y09BCsI-AQKZ4nP-QxcjFOZ6Jk5Q&oe=6AE34EC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M17t9rC3dwUQ7kNvwGAiUki&_nc_oc=AdoksV8_YbQ8PDN9D7aY5TSZKli-qVP1ya981Ab9tcIx8T3ac18UM_hQ0ryVs9fFCVc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-5rfjh5d_QBlMo_1FsL-dWTl1qWqnfQHEtzqBx8m7MQ&oe=6AE3471A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
UNk4cwuBmGQET0GEIVBOlt3Vj4zTVNGNI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58J6HAYTv3R2fmiE8A5UhrN2k1FsJKLN-4zVGCXHAA9Q&oe=6A0F2AE2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOYzNTLHDy4Q7kNvwF09HjO&_nc_oc=Ado5TT_G-tclmFvArgDzT5IFG_LK3Fgs8Onhpt-kB28VjeAv7fhoB0ospHxhzzSHLxw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V57fRiBB7XsnOlxghRQP3mgUvrG7ZueJVreM9g5d0_w&oe=6A0F0A56"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mmcekDxpD4Q7kNvwHvWAN3&_nc_oc=AdoLFfJ7h3_yc0bYHOQnAliKCV0mLLYLvseIXjpsspjIgwjGmpw2WFMQlSoUM47kop4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cfu4jKPFTXwlAEf4VjkqWNZ7n8I5QQBm5ZS8JNJSjAw&oe=6A0F28A0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT5wR4nhF58Q7kNvwF8Li7-&_nc_oc=Ado8-h-SvFGJKb3OXdm8ryrj7jJSjDMgJjUcfMNQdf_t6HOuy9vcrx3r37vhl6yh4PI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KCFJNlkHpgPw0RqI9707zzn1bYfSfGLXdb9RS0OkPDA&oe=6A0F0D47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnO3n3wNgv0Q7kNvwEWGFQv&_nc_oc=AdqPp3soq101T2kYoACsbEOBbrl6_sa3dRC5seMoLBRg25IBuWW3NvS6fIA2woBgx7g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fjCh9HG9UgjrdKYQxlsGco015hjcsFE9PLsg9IORamA&oe=6A0F059A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
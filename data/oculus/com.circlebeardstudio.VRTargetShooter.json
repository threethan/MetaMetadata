ei-ESUHoqjxhiReQsl52gUvhoAtXI0vss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCbajX_mfMJVu7Svu70d-XvNO5ZA6oIwBP7XKL_xk6KA&oe=6AEB5562"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAROdgHO75cQ7kNvwEVu03n&_nc_oc=Adrr3rTQ2X-0lGtUhrwb5Vpfqr0ycEB8OSDgCXRY1u2S_FuPCQxaSu-dNcb1fJcTKCQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaE3py88F1CkY12mUmnmc_cidnepFd0lpBurreA9KCfA&oe=6AEB34D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-ToimMqeIAQ7kNvwEzfT-Q&_nc_oc=Adp3lssNI0zbSgxTL2vSsBJiGmSCGIlA6IyYpWzaP72JqsLdWLhGrllxq5TGDwBMavg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRijcCtp29wPN9xvvQdUsn_tX-VFusMB_Vmg0PrATQ2JQ&oe=6AEB5320"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kN5cXEwqH0Q7kNvwHP6wRK&_nc_oc=Adr7UhMr5mZoTssvl2Vym2ANym9R5hCxToVRiBta6CCBHNRtfmdjcMGDxhp0eml_Cfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaoPg-v7PKkeFWm__6mLICHi2Ke_536il6A0iEIdSXVQ&oe=6AEB37C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP6AO6jaOyIQ7kNvwGxg4zR&_nc_oc=Ado2VDLxZB85KlhyJRSAJiJktQirFh0wmlXlrBtagRLhcKl2scPRDzktfRG2fp3nEeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS73hq0uTXSNtq-5A6ReEolZ2_sIj_DJpdqDNVsoeO4cw&oe=6AEB301A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
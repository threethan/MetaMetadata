ptuKe1h9Q8aXq4LqsBFOmkopBEfO_JZL0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT0ePfISCkeT-RbAoFEFvZ1d_Uwjw9NGh0uUl-dNsCJA&oe=6A7324A2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OvBFLa-WRAQ7kNvwHsm_bt&_nc_oc=Adrap2oZX6mxQnRroc8BCX7G32bLZK7Cagp7Gx0dzyp6MnZQXutFMsEven9BS-5iBv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQFUrAxKe0TP3sr8H_eY0RAZkIAJ0_t-QP82oO2gAafQ&oe=6A733C56"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e4r53MVCewQ7kNvwFV9HxH&_nc_oc=Adob8TyVeny2KU6z4WH9lU_Uy2urx9mB-a_Dm1_qb0LauTwdjB8lrWSdv8edKn7m3vU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFTDPaHWJcb1nu9vSDu27WgQoDnNV1R7Lj1zBct4u-HA&oe=6A732260"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmRGARYSSUoQ7kNvwFF_U9G&_nc_oc=AdqPVsw-NzSIg3iuh-vENCZ1z7_m09Wqn8m7lYg4e7JL8a9vOJqTjmw70EBuHIqNzPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsS__EsGXp0mzzLQxSJbMO7QfArjW8IFhyvPTb4I2MKg&oe=6A733F47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95KyZFiQIDgQ7kNvwFwtnVw&_nc_oc=Ado3Kbcr43NWg3M3PcG4aRMQeslz4P868e_LwKtoS2KlmKZj4Q4586EHc0dC6_ywm_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6SwmOe9XWiLjL3MY1AN0AfSXBqTFkcKWCwj23ZgbZMQ&oe=6A73379A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
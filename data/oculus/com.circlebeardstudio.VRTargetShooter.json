qwJf0_8gsEEg-KIQec672JjZHt8pv9VAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpQZrdiXQfTQnf_PEorlt07vLu0-5DN4ZGdTGq1mXWcQ&oe=6A54D222"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jQEBDIfOokQ7kNvwE3dImF&_nc_oc=AdryF3KC6grwa48ay9Hka0N-IPhR03FTP6bxe2Se45rZMiXxehaU4RN2aEW7K0iSBvI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcp6FzFbMAucCBGTuJmR-NlaovBtSqAhOxqjJW-ftESw&oe=6A54E9D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcHW5K-8N5oQ7kNvwE6ra0h&_nc_oc=AdqGZCydMxK1NRhBF5AUEopBdc9UTJzMG5zyTebx_8BY5YcNpNJ8BdybFoMBsNXNhW0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX21vRexIEosQSOJcQsA0lp-oGUZLrt8JW5o_lL5AY8A&oe=6A550820"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubquh2KSguAQ7kNvwHIa0bo&_nc_oc=AdriwhjTmW_PSzGS17k-HeBiXN_fBmviG4HxRnUvX2J9jbpKS_h1LOpGrq07VRwQVHI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEupHM-2Y4jG8k6KFJ_cJAnir0f2v9wQfWTuG7nFuieA&oe=6A54ECC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUjYSNpvB-kQ7kNvwFd7nRp&_nc_oc=Adqrqjf3RPz8gBLtdlGotDvgKntr_1lFmwrSt52mE9O4tNtw4R4ratNIgCKpSsf8_pE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK7oMfaQuHHQH6NZhOCLnunUxPmVahwf4BULGFyNe2zA&oe=6A54E51A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXcM9r-TJ4A7LeqowxzQw1reKKfRHuJrSP5qvGcaBpWg&oe=69B69E22"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JoLmd9bW0wQ7kNvwFuAnUk&_nc_oc=Adk1kyAq37Q_XFkvdDCh_ZbF5NTMJFSJ2afhFKWkTG_2HtffvFC3vq6djxKbxwqdjbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_TImw9FBZMhELmADfmZF0bWVR_w4ojEIIzu7fl8tccg&oe=69B6B5D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMbTaGytuhAQ7kNvwHBKxIc&_nc_oc=AdlhUDnV_0VziJOoZOhzX1fqFvXb2LG3Xab41TRET4cAgZ6LQuobSEaiU_sCFx3vgY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzssN7D7RgcLJ36eaSrtLjkpTBpSZP-ENOfLx9kz61uCw&oe=69B69BE0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EudSBuOPnIQ7kNvwHfWenH&_nc_oc=AdlYdAnQ2K2ovcwhB_sW39yca8fHJ2tnDVEhx93CGv9dhnsjbmr5aznCsMjGVgIy-_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2C_HP-yzQbDihwVQ_q1VqUs63A0kKziud3QnXOOQ1uQ&oe=69B6B8C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1t_LaTbTNgQ7kNvwHi7Pl8&_nc_oc=AdlQFPDp_jlS2LyYk3QWshE829_71yi7JsFSop5FKv1_kPcaBaZTDde5T6HXS3No03Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2TiqNSN-1n976mlm6_xJ944bPS3bZBTp3P7GiTjkTEQ&oe=69B6B11A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_m
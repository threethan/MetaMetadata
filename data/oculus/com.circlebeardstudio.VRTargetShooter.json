vx2GJpmEbzcsnnj8qOpIy-qsz4yA&oe=69A42922"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xvXiVIMeEcQ7kNvwGp6JIV&_nc_oc=AdnsiqEd0SzzS6zqF7KJfCazC8pIABWb1ZFzoDo8QZCEy_-DDz1gkCS3SILyus46JZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfviLtlRgNls3Km2Osm3ssIMQFLHfIGin14TnCzcE7RODg&oe=69A440D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M9n_PtW0uEQ7kNvwG3raGR&_nc_oc=Adl4JFH6KOHjeLP29veJtb1BQvcGAU2ofqiBsCjk503f5zFaD2GRBh6g4awNGFC4SYc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuSEi7evccx-3_QCeDcrmithecYozUiAGsiYJrdzSa05A&oe=69A426E0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFCNm7YL56MQ7kNvwE_E09g&_nc_oc=AdmyBCr8Mk16kax3r-hly2YGMD4oFJkAkXUly414m2i4qZ_LVrBuiU9yB6J5Ik0ecyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfulfbRS80gwi422_GdxjQkXvoaxX3exAy2XVe7BjSiDwQ&oe=69A443C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yv01WV0yH5IQ7kNvwEtaJeY&_nc_oc=AdlrD0REAP8rFUs1ovHoUlbRef7QmtKzHCLRNATXRD3ZTk4jK6OOesOALqaaqvyJeIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftjVvKctafl7ZpHx6AAK3F-eAQ2rV9Dlrjwm6hyId6BXA&oe=69A43C1A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "264679000327
U-6nNgfwwFPTVo9c03EfNCmlBH08w2WTA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxTKDxt_8rWaVlVJovkkI9eGPus3xuMyZlLMYZ_ClKcg&oe=6AA14922"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEzIU0gMQh8Q7kNvwHyaKvZ&_nc_oc=Adq_FOsAlJrfCvseLNCwMvbivBfV876zen63Cd2-oMg6lWh_sN3jqwVs-7mzj-eM9mM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf7xiZvPoZgch3S36dUm7coaQZRdTfE53cc3_oBLD6lw&oe=6AA160D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0P374O0KvaQQ7kNvwG4YBsN&_nc_oc=Ado_zzHrGf4_WEDCMd2jzXDJpGjl-yTu9eVb_5EaPNtw_FUYOj8Lt92Zofu4_opvjpA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhR6GVWyoKgUaAq2uPC1powKdJN9YqYOW72CAk6iniuQ&oe=6AA17F20"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKIuCt8-Vs4Q7kNvwFQYms3&_nc_oc=AdomFdSVUFDbFMHwBeKmqKwwVs6b49esgAEtQz9LzvphDs1bYYqO15i234PCFEKCyVw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvYK81ezbasjk7Njq6gChKNvzP4D3JuvwZa9xDKqxdOA&oe=6AA163C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt7wGGz1oWMQ7kNvwFsj7To&_nc_oc=AdqZqMFFMf8PlptsuNrVbCHpmrnTJb7NDnslLnBY56LEiSdrA2XwcHtwDytnGOndbzA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE1DuPZu_ltr2C4czxt88cr_utvcrZsMTocjf0-SLdIg&oe=6AA15C1A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
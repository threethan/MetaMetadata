7vSdckKeDn0osJF9hwWqooQoeB8lE6D1SbUQD8x4k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MvtXg9j2jUoyVfXA7Aas8zBJaYBYJ69R1aaOJBDX6LA&oe=6A11CDE2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJgb4huiDZEQ7kNvwHnpq46&_nc_oc=AdpyhUWAekXDk0qz5YHi50FEguJJLYjtn8DE-IeawYIdobQ6TtKgKuD08c1ncErVOrE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_EKnEXafZhGWDTsP7UvtKBQZx8gkzS8rBFGZMtPcE7w&oe=6A11AD56"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kxnQyzl9xwQ7kNvwELexNy&_nc_oc=AdqPocvi4I227AF0rEPkR-MrtUc-raKtmyQMlZQANP7-BlDgb6ozW8Gggx9qAgf13po&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FG22TsaojE0gzM0e_gOPt3ithSEqlH_0yIhHIQUJnYA&oe=6A11CBA0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOsabcxWGLkQ7kNvwEclUab&_nc_oc=AdpLHOwfzV1o8SimMBKt8Ny4PXcJuIvQQ-dzUNQ8oeeYDz1GSJA1PXFKNF4opmrtsV8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EK9DbQ85fVf33tj7PplvNk_oX_PliWba6tLBIicOUUA&oe=6A11B047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnO3n3wNgv0Q7kNvwGBir2v&_nc_oc=AdoyfPjbERvX-uWxSPLjklTxC6a2yg6wvQqXEp8Mqw-fJTANw3Gqtqm9fQu3t-73pBY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BFB6Byxot5JrqB1XjokPcbkl_xAVpzgP6P_hQERQJaA&oe=6A11A89A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
f20f&oh=00_Af6O4jeWxPSQWPeDFRf7TaJPY910DN3VLWajGbAf9oJSoA&oe=6A202DD6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjyPT0WXDt0Q7kNvwEIHvi3&_nc_oc=Adp3JKziQJNYqvUZeYcPtHUO5Z3iUM4JcW2r0XwR4QVDACKKRSfx-YMwb8haMdBti_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70i3_tdbsaPhjZFa2cRB0sbXZ9Dtol_ZhF9O29zBmWsw&oe=6A204C20"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9UcFLv456YQ7kNvwEWbt-9&_nc_oc=AdoQu6Z94GtN0LiI-S4GvrQU0bgq4ZEg7pqndahMLxInEdEv49JXFb76fNY4aTWk5IY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6068u8L-G74N_ONEUlauuRiAWh-o3gGvIPPGrLbDpRTg&oe=6A2030C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAefTI2I7XEQ7kNvwHcERYL&_nc_oc=AdrFiqJht696yQrK26C5XWnZIQiVvrzzQ_4A0xqBgHbDPb2aM9sY_lhTlCYPrnw1VEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77zChkiSn_KJXKQmH_sZ2Kp2-7LGuM8rnVdk0g93gV-A&oe=6A20291A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26467900032797358"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1106133870499306"}]}, "baseline_offer": {"id": "1106133870499306"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1720217066, "status": "PUBLISHED", "id": "1106133870499306"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "
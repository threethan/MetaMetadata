GN6QOyJpnEW4WK94Td5zMTTSAIuQ&oe=69A57AA2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xvXiVIMeEcQ7kNvwHPIcUX&_nc_oc=AdkTGu1k8Q7qYrVh5jScv1lil9fIZqIIguZWm5IiEZp2lFIMICR4St0AAIJs9d73gtI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuDIsMPmQvwNxYZdGjgpNG260gr1afGF0nUtpCPtnVaaQ&oe=69A59256"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M9n_PtW0uEQ7kNvwEmyGuy&_nc_oc=AdmDqmRkj5efeE5GBIdP-6Iu7niWhFEeTX0cEz_GEkMkRRKPxfq0Y5GUU4uaS_gffL8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftQKDA8AT5MCO9eGuPZJSsEUO9PrrElcPmN105sZivoRQ&oe=69A57860"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFCNm7YL56MQ7kNvwEVmB-w&_nc_oc=AdnUtLKCexfFXHKfT0p6xCS3GHekGPnPvvMrAM67ZraTY7ja0-q7DMvz1RujzxAjWQI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsWYphxOCFcz5s3vGiBeg63uNQilofeIat9NQ1SFUkIMA&oe=69A59547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yv01WV0yH5IQ7kNvwEXJLV2&_nc_oc=AdkJ36alyYtxEMWCmXTQFPdq6jWzltmYZVDbxgOiOiMyKGVD0THluM8XJTWXwmy8EVY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfssNGKaqSwHxtGFMdRtDGaEpGndzqOclyCkZbRupKWt5A&oe=69A58D9A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "264679000327
0X6H3mbl17oVTOdNr8efCC1UrLGj84dLg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06lPER7okSiuWthOF_vI5saeYmF8VLG1CGY4b6Mqz1Bw&oe=69F5E622"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0QzS3177ZkQ7kNvwEzcLA6&_nc_oc=AdonnEas8TU1P8IaVbXJhUr_lzACGId_7DVvRPQFFulx9eLKNDdV8675o4RA8d_EVYI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-pZl4rKI3nF3n-GMcGiwVtKPoXqemkVN3N4R7FvPKEg&oe=69F5FDD6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_R86ribUGoQ7kNvwF8BDJP&_nc_oc=Adq6NZbdzC6EupXhdvmrurjNqhniwO-565KLhpS5vJsPUyUIz7oHatLjXjMjbBStoPI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VjYosgkL37jyHbGIPvO0C8Mzd2zcK6iJrM3n41fCv_w&oe=69F61C20"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hboygrjRxT8Q7kNvwGYz2md&_nc_oc=AdolQ8p2ux6DuYEr1N_Z7HyBABR0Xtc6YcEmlp_YS8gGkM6RjBQdDdzX8Dw0c9EDAMs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ddgwg3FrdykykA7a5m6R7sGXHAS0echvLs2tuShh4aQ&oe=69F600C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4enFvFIP9wQ7kNvwHcARMA&_nc_oc=AdpymNvpwh09MGzgSUZjweRj0jfK4c78jvZt7JII-Znu6XCjEpxsgg_t3UIkVCGTEvk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37M1Mz5frMCYSxDJCNHQ3TkNezgf0JrMm-zPz3gktYvw&oe=69F5F91A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
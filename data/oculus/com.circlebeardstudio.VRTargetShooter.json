UIZOTainghQT7BnpOD04cJnD9Mcg&oe=69999D22"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzKnaWpsTp4Q7kNvwGYcf8H&_nc_oc=AdnOMBAwbymApD16yZpRUPLCBWlqvSA4e-p7qFHrhypfRRUO0ozDudi9CMhAURzTNXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMWqykHTuvb71jsxf-KgTg8y-U6tycwioxEEFO67qobg&oe=6999B4D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSINPLw-I8IQ7kNvwGBtw6O&_nc_oc=Adl0gAreCbFfvicN51LECnvzNJwR4vJ3duvmSwMiz6JJiyCy3mZ918aU0VOJxUND_sQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9cHMJQ-urpXrrv3wl7VaOUDmpg8LY_1FCoFem6YoeVA&oe=69999AE0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=at0l3uDgXWkQ7kNvwHtdavE&_nc_oc=Adky6-CY2w7DjnD3xO_gapEkMNBjq-EdYVW77A73Ze7b4_b-Gm-hsjhkw-BDCZg8cdU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftc2ln5IfCjjg2gQ7lt4z2p3FJGHX-z5Istwdd3YfuUsQ&oe=6999B7C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5EPCH1ApzMQ7kNvwG9DwpK&_nc_oc=Adkoec4IluF5C9bu2ryKKRoGu5Qq7ix2pLMSLsiauwOiATvyGjtlwvZMfB4BinMUJ2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsmbPnu8chMBJxH-j-8tvWAGetSh1F9SWVARrL5Cj-Y-g&oe=6999B01A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "264679000327
Li6rqfdDt5Z_nHsPoflgg0T1psUOgJOCM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-0ZsF4J4PoFaafde0DEpwyinbKyYS2-B20XcHDovRYw&oe=6AC519E2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PShFA-X4z7QQ7kNvwErT6pe&_nc_oc=AdqjzYjsGspjeDuXdau-cOKXbIlJmM0FbZ9lFbXhOF3RP0U4zzW2GQ10l9DyIZ6nIq0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ96GEkK4E8uALsknHqwCMtSFkjHUkNJxuGxPuMP1Z6g&oe=6AC4F956"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RIW2MIoPpkQ7kNvwEMh9WY&_nc_oc=AdrAaAszkObRX_rAHU4P08LR5bZeCjuoMX8qCC4wleAhagTjAhCqP5w4874J48NZDl4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFyTI9B5Xa0rrBQB6IKqWdg4S4Xayq2dT_FMX7xfAxzg&oe=6AC517A0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d48HBhygYQQ7kNvwEKC9_O&_nc_oc=Adpg_9Av-IaVta8n4orDcNA6S6RiQsba5f_wfsmYDcRE6uZ32Og0PZiV4wXmG8K7vBU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtijNJIPxA6DCfw9WcHpQ_o3ERDC1l61Ew8zsgOA6j9A&oe=6AC4FC47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNAgyih738IQ7kNvwGL2DRO&_nc_oc=Ado-eycMpzSoJiZq9mmGPRpreJ5c0V1FDny_DCzYRR8jgr3E7DY3tywncF1-2bRoukA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO34iOhdU90NqC1GtjS_rL5Kd0oyTLiVP29uGlMXaEFw&oe=6AC4F49A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
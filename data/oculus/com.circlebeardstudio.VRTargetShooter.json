QS-5o0KCg9gZT1SBaeGlvSPYrj7HwPVGM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZayyR-q4VWWzJq7raEUOwc4WKqyNKXEZe7V4YhQE6pg&oe=69D793A2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ_6v7Y5FsMQ7kNvwHBkQ0Z&_nc_oc=Adq6Owz7Cmog1FnblhAnKr-8vn81cKJgXfOkMJ8bZ6MYd3k2LchrxPmBzhasU47yF1A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YnF8VG8mgdhT5MaTx6J67jEo1a2uhHgH1RyuLkbu6QA&oe=69D7AB56"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_O8uKUB-8yUQ7kNvwF8YQDf&_nc_oc=AdoVvvQeJJ6n5dfoS5_QdwwrBUmrWk9I16n8bpoL4xE6x6FvrX_rZ1SkpjQnR87uPeY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MdmVHfDBk8c0COphqRAAlJtKC_Q9uT7EkcQ9AU9LRhA&oe=69D79160"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdWmwQ-7P40Q7kNvwETnv8a&_nc_oc=AdoIgC_Ml6JMmDDIPw-KimlXSyj-y7OMWmtU7z6irk6YXFsh36_mLzN1dvx9hbZCFWA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Na0sRV-4AFWHKY49LgjvpXqV0ARfuWOMl4ANBctqwIA&oe=69D7AE47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO-t822ld_YQ7kNvwG11jcb&_nc_oc=Adrcr5YeEkkpiBvCcNzHrfWOv3WnQUHC12xA_Ohm1YqaIIDIS7Nyz9SmZ9rWpm5EK98&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JhC9tRu-IBLhk-gIQ23HAYh1H2Qx8c3qTVk09Z-EWhA&oe=69D7A69A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
paLVbpP3Zt1kLFT3unyohZFRrTqmZLQ7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R8vV7mM8e-4eDQfC4zfrU9D6FByS0hLIrPdM_Iy1wbQ&oe=6A05F062"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXhfXMymJQ4Q7kNvwEgNm_M&_nc_oc=AdozjTpjJPOCCl3yc_piYEqlcet6s8-c855Z4N6DOA_QMlGbpvxqWfpw4Gr9R8Z4nRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AAfWRMLPpzFicTtdGRJOWVIFc2Mslr-VgfgHCGkm9xw&oe=6A05CFD6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9n8qDljDpEYQ7kNvwGZYJz4&_nc_oc=AdpGTxqtApka05CrID0gntsiAzGax04xlvvKcJ7p63plVxUZP4xC6pdiT7j35XD8FQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56NoRorOn-qQ5E7JNweU91INJFcXkw6N4Eciz-ckeonQ&oe=6A05EE20"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgbJNOovtD0Q7kNvwFWbZj0&_nc_oc=AdqX7zAzGR7SibLqUNKZuBsszn-_ynQOVGaOBECZgx_JjpLJs-POmErLw65oZe-xqcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wNPY8ZLxUAVa06PiTuKu-i0MSjoFNif5JxoI62MZJiw&oe=6A05D2C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loPpwnDmVV0Q7kNvwFfpffS&_nc_oc=AdqgHvIoENf_RRWMtvBrnACp84IM4V9fVo6GBqNEvPBmavxc1HH0UhLjDVxbVT6bQBQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74G8jlDMcd4qzV6QRwQgOgEwArCBzWjqNcGVKqqRgWtw&oe=6A05CB1A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
, "id": "1586251718893723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMbTaGytuhAQ7kNvwFuHJxZ&_nc_oc=AdmJT51Un8G88JdOLhLYJG7ih_rABxEbqO4ed41BgQj89nscFw5zxdrQO--jmcZFynE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyjVqReXQfOudWUuOKi1RG5wFobrYQnWctSKpdWd_7Y-A&oe=69B93EE0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EudSBuOPnIQ7kNvwGgV_Hq&_nc_oc=AdnoFrkPCfVFaMhxqmp0B4eDuQ_J6WjfqafUaobeuJomQFi3pwkSS8PSzidmelAEuWg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzmQCtc1eziyHhpFvxiSv3nkHB6lbX_yF4QF9agw6FWSQ&oe=69B95BC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ay1ASgX4ux8Q7kNvwHWD1fK&_nc_oc=AdnkG4vu_frrh7UdYb2dj_anm4rBiIaKKgvPb3L2qFfNTWm_csBzVcM9qiIQL7kVF24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKe6vm40kToqbuzVX89VXX6o0IFnpckRTDFU5YiJ7LsA&oe=69B9541A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26467900032797358"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1106133870499306"}]}, "baseline_offer": {"id": "1106133870499306"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1720217066, "status": "PUBLISHED", "id": "1106133870499306"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26653841504203209", "version": "1.2"}, "id": "8
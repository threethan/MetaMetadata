fHcthvsMIFG2fOolOuSgA4GR32X3XLI9o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UOihcO5IlZhpEpWtNBjdMfGA9Hbjg5FK-0yyOobiIdA&oe=6A131F62"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJgb4huiDZEQ7kNvwG-5k_a&_nc_oc=AdrS9aQQtVR493FV4bhj_X3242HAU49Z0FNLUTLn9xeDFyKGatzvamzoh4COSMKJ9CQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tpv7LtG81_9c69LeyhHtfo3FOfjmCOWU4WA-XR_Lezw&oe=6A12FED6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kxnQyzl9xwQ7kNvwEBvnSa&_nc_oc=Adrqj-pM-6oOfaCpDW1kPoQUsngI4_03XaSY6Clsd1I81gmlhjpK-1i3MHRqr2d2e2s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S3ErpTDyPQhDlaG53DfYEFLMrun1UtJLSx9oJ3MNvxw&oe=6A131D20"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOsabcxWGLkQ7kNvwFl0v_w&_nc_oc=Ador-2zXmqoW-Cx7ad9gi43WJN1l7CosHrxCXtMlsN4xf6ihq1O576ImqiKeexh-UMo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55uT07GTFHFtSBhXqoFV7UzROLGRKfOrweGpIcCHRt2Q&oe=6A1301C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd_QksiVQWAQ7kNvwF-oUou&_nc_oc=AdprZ4w-tNAwe_ULt3TA9n8WydS9rW4iP9c5Nt4MIqLP-AeOpL7arCyBu6MpIBI8Uxw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P9cOdaHUlknP3-M0W40lwPjpjUqiIyT36S6MSJBaVKw&oe=6A12FA1A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
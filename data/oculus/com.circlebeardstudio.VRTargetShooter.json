5OzVlVAVsswpqPEo1KTTh92d9EMrPaWmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F_4D1oAGX0AnDy1Gede-H_meSIFqtHOFNkB7KGuZjMw&oe=6A3171E2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oO-9Zx6bwo8Q7kNvwEfmJ6m&_nc_oc=AdoFl8xTgqp6rTip-UhbCein3rXoGxiCaUjqrI-LtE0_xuiQH5uT5-ovUmq4ZrCiiio&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BpcXGjxg-6gE9VxKl2vb1WG2O9kCQKl79leXH5nBUVg&oe=6A315156"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt8IGONdbJcQ7kNvwHrmLOX&_nc_oc=AdpvoQq1xB_nIQLbasQqOdPYqfUBxDLQMtPPQ87uyfgHH3TPiO91qFQAVN4N-jHo0qI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qx8LTHD1b4BSnq7URdFga0PWfGZbcgWqt_Y77F_lwFw&oe=6A316FA0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YgQPCQs6bcQ7kNvwF1TguJ&_nc_oc=AdrmOXWTZhT5H36otoIRObDdkw4q7gkErdtTy-Vtcky_AkJK-7Fb3LzVMbJKdb2cvzY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qF4ZxLpl322AYyf9aQ8xufeSw_4uNokcwjOC9T2BFJg&oe=6A315447"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ce9CuKNRj_8Q7kNvwHaCuOF&_nc_oc=Adr7hgwpb-8PjL3DrEM9qkjlDGVmW_UHHGFCgcVsnmtM6LndTPUcRnUzyRVVPkX2eyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JfTHmnviCMjyxFoV2U87baXbsh-ts_QXpBT05g87dWw&oe=6A314C9A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
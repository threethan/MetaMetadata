kRZfzxAWk4xwkfVs_c6I8rWYcxG9IlEcprYWXecTY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_ap7WGBWQg-QtanOvmtq6IThmABcEOAsvdWmNZVABbg&oe=6AA3EC22"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA8wonN5yL8Q7kNvwEFgE9L&_nc_oc=Adpm1tqOofYy-9SZuD88xJ8aVfGuaNQUBc-0yIaY9WKCTiiVg7Iji7DTuBKjko08S6s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjZFg5tdVHhoO1dQXe9ES_BVr0l6JcP2Jm7HaC_gFUwg&oe=6AA403D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVKrAGLhlW4Q7kNvwFSB_Jb&_nc_oc=AdoyhatBb7b_G3Fi559Piu3YuXyaHpzMm4Vbx3fyqTDmHhRH9afdtu0Az3E4Sn8Ezmc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8BUmH9OBDVDpZGT234G3CLca3g73OT3q6trhjqOJeFA&oe=6AA42220"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9281fEjXpMQ7kNvwEQBpHZ&_nc_oc=Ado3M7bMW7n0Dbz2LM2-aOvBUVJlzBGKucGgcjcNaxr2MgCXrKD3XtijtJ06tDMMuj8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkmY5c8KYT7XEvdhWXNeCJk6HbrVL8JfHiVDnrbT8TSQ&oe=6AA406C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt7wGGz1oWMQ7kNvwEpIM2r&_nc_oc=Adq-3ZxtAKuF9xA5gnQC6UL6ODc6yFJldTsov0-9DFkInucVDTzZVIjsQn94bn15ZTo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo1JxFGYS5fZaJYfZLUQ-cVfotCM5fZH05E3HkgjX4lQ&oe=6AA3FF1A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75314844_7200738226698530_340074723625919525_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poxaIoFU5uQQ7kNvwHGqiD1&_nc_oc=AdrGe5BWAhnbfwOovt46jR89Y7f91iX8nd2m0mddMsf9eRadH_qU_H75_9k68CtTDRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWWNNVfXoAqhxbiaSsgCGDEOoCB1M1uouUZhlaBT0fQw&oe=6B006D62"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBTkUxfgs1wQ7kNvwHhO3pR&_nc_oc=Adrt5X2v1I1tutHPUeUNCYLe4CZn6v9HgZcZesgnk77ylh9RpIdE3dqvD-fiHJH5s00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu9MKzBmjB9Q3PNwkLls4qi3SbC_UTgS0SAkjq66qVTw&oe=6B008516"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ie0U9CSX23wQ7kNvwHQRb_s&_nc_oc=Adp-XgmrEsZ656fUArntP_EKm6p7EjlAXRTIIRQ5CW1Bj2dpy2UELNSPg-HBt4-Sm8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWqMXAmDA-FpquFWcSAEEdtDFdTPrseumXKQAOw3DEPg&oe=6B006B20"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty3HTsW_kwAQ7kNvwESN7Ah&_nc_oc=AdoeCgpml4fXI5OLrCGmZHTEmQ4hBPuydvhcwc-ooaxkgoj89F0ycsbmTBbhD3bKzIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe_wcQUNGko275xlBmqvdCXO9rITeV2XWHGgOSEr3aVA&oe=6B008807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2wZuvS6v10Q7kNvwHvFQc3&_nc_oc=AdrRxUHyrBrgmxPgjQ6zjEo0COM3m45xCMTDus_9KZKSV8G3dWr09oMXXAJjW4akehQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-dUYYfoTp-N4KTh298JxEXdK_iCIP6uGG5j3B-4I2FQ&oe=6B00805A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "374
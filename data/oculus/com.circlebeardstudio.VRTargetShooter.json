92zvogYN2kRR1_AUeJG8a_gpw3nA&oe=699C4022"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nplqHSykr0Q7kNvwEFr4yG&_nc_oc=AdmvUab-9yuO-EaeZDxKxUTzcu9dLbIcMo7N8nxzPOfVXHTGGdx2ewCC0IuSOvxHcgc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuX4ASGaDcE24xLkI-Ti5Qr1lXf4GaEyyaDLImZA0-o_Q&oe=699C57D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQhFYCfenYcQ7kNvwGzkdtX&_nc_oc=AdnHRFTO2sunZt4O0MS6PBY7Auh90bb0GHdsK8G1M-B8cB8zq1VxVHcW8idmGehXpdQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuUQYNCZZQZpk4-ACcT7cTBsvJ8c18KyI5y8XN4auIQ7A&oe=699C3DE0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tXJFUpqZ-gQ7kNvwFmg1hG&_nc_oc=AdnX54VF_O2cfbzS0ikAVcXXx_5F0dv7yiPXpzOPo9Zh83-ekHlHrp9hyOMSpDlN-WY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftjbsWAag9BZqxcuJOFAqT4HlSttjDl-eOPWX0o6fJaVQ&oe=699C5AC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bk-S-fg-9rsQ7kNvwGB6i4X&_nc_oc=Adl2ehsQUJFSrLIt1KqWJtvdYO-UBmvKxfKn7Rwzlpr_9cy7xW3DVNhwNzsVYrtn1gU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvJuTa5D76pvbAZcIm3qnBqHwuFZmeGXtMPmayCdFBzsg&oe=699C531A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "264679000327
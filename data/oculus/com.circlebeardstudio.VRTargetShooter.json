LII5jUWerDigPmYGFdZ6seiYNGYrykC6Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ-fzuLii0YagCpswaHu6igh41gVqen3vAF3R4qmT5cw&oe=6ACFA5E2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jBy-SvrdQgQ7kNvwHoGwsl&_nc_oc=Adp-9-2av6YqY3mhX2YA0d56UNt0hBMS4oHlkfvgFlI0FA1zllspJKHKNuaLjq61ay4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLrOqa8ViyCoosf-428FdjPcYsda0hly9stfOKHOAU2g&oe=6ACF8556"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmShHjyKW9MQ7kNvwFT3cNy&_nc_oc=AdryKJotcyMeR8vOAkwR4NxQn_uUpYes4c0tn5dQWyU93MkSX3jM-mf_K-4t_gOPFlM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXltjtv-GohyJ8w_ItZ1BrzNCEavvW-OpxDBOqksoieg&oe=6ACFA3A0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvyfJOv6r_wQ7kNvwEFLQYp&_nc_oc=Adpl2OotORzWVS407mKQqO7DVO34MAMTqoPsxvRDZhSMTwpAZTetTst7cxbkRiTnLXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODtkN1m35qYIE4gtiWzirgxbSXaPg_vsprQ9-hmzPO3A&oe=6ACF8847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p5eZd6rqxQQ7kNvwGCnN1g&_nc_oc=AdrGaw57B5TqoEJPY7n3P3DpVk717QsJ8IyivQvEyJs7NT6PkwfbXo10rrwq-QAnFpU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnXRwaRqDquct8nBRcTuSd1vZc4MhBKD8UjqB8Am2lEQ&oe=6ACFB8DA"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
GIJxCoLJHySMMGy7juPkLnAwEkYgGbbwI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsuVdhy2OAZ8bIpihgi5Ua4hTYqmtZqSkxBHd528JFvg&oe=6A86EB22"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbMx1b3N9pcQ7kNvwE353Sy&_nc_oc=AdovD4QqmhTBEixSSA2gfhtFEvGaN24I-bsy6UEO-yFMww96Ud_CkJH-TU3XMjXM0Xc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDQ3dY7mIVs4zqRDKseaSj0T67sVr8-OstZLRSmoS_1g&oe=6A8702D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFpit4z1jkkQ7kNvwHqpp0f&_nc_oc=AdrSP35FWh5P67CT-nGGmhUJJv4BJFG4P-lQ363W6u4VtfACFBZeycVOQKBfATNsABI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt1H4Vjj653coIbQiauEE2hzCdqSTw2RWyXbfu3YSviA&oe=6A86E8E0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2vYmaMrKYcQ7kNvwEjbm2L&_nc_oc=AdqdMg4ccV9pn5nIg9NEJ-zOhgdMDVp8mofRJXy3Yu9wT5P5ntWkdTcL42ag0JxuA2M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqVdF5_0c_doftsPxKEk1_11FVIM2N4r9ww0MogF8XLw&oe=6A8705C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNOZ0tLYu8IQ7kNvwFBxF9o&_nc_oc=AdouFUkSDUUwbtwyUwHqzHrBC8FmnuhLFxZrzydy-7qdXfYC4J2l-Y1HEfu0vO_RVPE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTQKWsuFr7Xb90kjUsC3s6X3wZb3MXQbt7k71qGv1t8A&oe=6A86FE1A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
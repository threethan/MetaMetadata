eHi13awnPYgEaAHHV0ynxFogFaqYbwnYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnHHuijaz8fySZ1aC9rNRsXqjKFM9sFxcOmXSgPhi6Fw&oe=6AEA03E2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCfDYiwqIA4Q7kNvwE8scMh&_nc_oc=AdqP9XK17KpQV4Wkv2_YGe25zzVAgd-ZOfv9hhfk6QgAAqDGMtf-4Mk869l7AkxufL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo48XHoaNnP6Fu8dmJ8xuAdCcqrAlY-rb-93n0tS29mA&oe=6AE9E356"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0y9LZmD4ewQ7kNvwE3Zovi&_nc_oc=Adpej6BHMf3TrPHqlPPD60ddKJXzy2Z6bf1aX2aFcKSgTpwLmUgXlJHlIVPf-y07NY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLXo7oTUfgx8G3JwVw9KpGA22nawgBg4lRm4rnmPtT8A&oe=6AEA01A0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9aPAA62lHMQ7kNvwFSq4q8&_nc_oc=AdpB-dfrEgmwfT9jH_0UaPXVaNjS9aM1UpFxTo4vV1V-9a4gjc61BAyEByoYmL5lIi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcIVih7-k_Y58qHmFW1NyWQa1cMEWV1G0cpf7bj9KTHw&oe=6AE9E647"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP6AO6jaOyIQ7kNvwEGU310&_nc_oc=AdqadbM04xqV0Flyv8v_SLT7VRvtwgPKJ1wXnPiZ5OuZxfLHrA3hVRo5G_u1c0pvTps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfXM896UI4o8WBKisgMXOdW8D7lAs5W-JlBaiB1usJKQ&oe=6AEA16DA"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
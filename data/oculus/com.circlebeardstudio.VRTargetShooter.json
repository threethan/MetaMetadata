IZiKWVWSXI8iMB6v5t1IpK1aNfAT5WlGqPKjJBbMA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rVNK8v0LhX1OdBbteY6_No1nEa5E4rqZKEFWBruVpoQ&oe=6A22F162"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nHj-lJuduwQ7kNvwH4ebab&_nc_oc=AdobLAry64_73maFDlCSrYnH_LRsduIKZN2biLBLWB823RzWBnk-doK21asuQQqDgIs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kjijM0L_S3NrHOzGxX-tU9DAv573JuNrSGqN0vfofkQ&oe=6A22D0D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdHgKSdsjo8Q7kNvwHxQuyd&_nc_oc=AdpcqFht5AnJNXAS8-nl_ZZD2n2Pc8taGHi4BDyf6SS4pjCbTtN9SAol870Z9-dIqWU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VYoZNVo7aZEZlM2Tztbp9R7xmpJ23qw-7R917zk_Aew&oe=6A22EF20"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b617sRQ8IlMQ7kNvwHoz__R&_nc_oc=Adqzyb-lpQJDFACiHHeJ5Qe-9UsOcJ-h0K9UZSeup-z1Ali_8PLIkb4A9F6xu-hxdWk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TYEe8pqp_JbMHtQ81L2ZOcag7iWS-18KH1sIJFofrfQ&oe=6A22D3C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXf_itSDuqYQ7kNvwGmG3Oo&_nc_oc=Adoj8tIkoOBPde7eTy1jlJM8FEf4X0hKe5KX1vUebYeBLYTlNCK4EyjtWp9prLuOKC0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hLj3fJUtMKS2CF74UA_nCXMJaFDEUyoBfBv0bSEdGXw&oe=6A22CC1A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
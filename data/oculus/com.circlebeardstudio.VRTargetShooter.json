AEXlvAg0KREnU_3NSsodOjBi1bxrA5F0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQhttiHwgN3jm56H77crJ7Om-OaKrn7BKXiaguXQh-lQ&oe=6ABFD3E2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0jfTTQUPnYQ7kNvwGJl_j3&_nc_oc=AdqXgguOZUO4DRAgsoxSjBxOJ0szSGeTV4h5CW2ynv0oQmfZ8R9StUqBeDO4vsaNKkE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPjyviTilpy0FolMAHeL51zqls9QxyrdyBarcQCoBrCA&oe=6ABFB356"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mcdm_G0X7qwQ7kNvwF8H-c6&_nc_oc=AdqbIVpds2ylzYvf8RQ9OsxARuI9jYIROY0EXvSgLkYqr5ORAC_W5GUKZS4G2G8tr9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz3-RiiT7C2ur8QRKnwOfUGkb9YKvt7B1lC0UFmb-uEg&oe=6ABFD1A0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9MODS26HTQQ7kNvwHqVnl9&_nc_oc=AdrWx3Pg_YDMccxmTM3YDo1zpSsMd2_K1K2DChTBz_U6QLSIRAM7e3RW6WOAfq9miTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiY8Y9e4nb2giZoVp6-3gdnhzvCUil8u3RTC5rtAS5yQ&oe=6ABFB647"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukJnwkcwiZYQ7kNvwEB2o8X&_nc_oc=Adr7XYLns0SJIbz8HM1WC3iypnLa2VOdM1-WqZhxi43x-pmmaPDOpya2rmURfC2-fNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7fcPAPWTyeYOyCbSBLaMVKD_pTLnTrTAh6mBQvaIl2A&oe=6ABFAE9A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
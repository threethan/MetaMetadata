85clOgRy6qSh3bUCMCrMK2oN2V_t3SfnQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFbQn3MG8L_D2G-lIrl8EYABOBoJ57hlW8Lx6F_n5NPw&oe=6A6898A2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPNw1UouDt8Q7kNvwGrHCR9&_nc_oc=AdqAVg1gW6F6N6AfHBHbcBAWIFKmWNuIsNCNgqhGU7paDrSKFs5CAaFQTBK-NUGbxdw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASWZkaWfQG46HRyqXmSANJYbXbD38VCK_OWCJFWpFXhg&oe=6A68B056"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN7fJCHgHu8Q7kNvwECr66_&_nc_oc=AdqAwACtoKlK0Rwdm8f-m4BfBaks4SOAB0xRgfKMX76cyZE6vE2FmyQ1uXEY2hRuxF4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBua_q7KPN-KJeuYQB_bhO8q8Ao1pEoc9anNiyJlywWDA&oe=6A689660"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o13FB8QyvtUQ7kNvwHKOC7v&_nc_oc=AdrQMBA4LZzVDQT9xs7OOtJU7ZEjbjYyK5xTf7KCY8t3bwjX56CorS82-n-yqF51cKc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCas8m0CYfQxXaPc3tW1dldmSPd244TKvAc4CjaYO3E_g&oe=6A68B347"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TuTc9EPwD8Q7kNvwFPcpuq&_nc_oc=AdokHMd0XyrxrQkQfVVoLSu4oTFKDh__LEoX6kRPtY2rT1OY9Ye2XLwvp3FFUmAxQmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtYUdld8vQ2_ubcz6GqkFDN9UU-_raMlvmFTTX82b4nw&oe=6A68AB9A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
Ylec7w_qIqA8Lc-dI2qiUxKeML0qBaHPI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNltRYIu1frOurrOzTw0Fqnsrj5bMDrDjHOCB86q6uLzQ&oe=6AE0C962"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4Px7g0WfZ0Q7kNvwGPIstM&_nc_oc=AdqMnozFy2C99lBDQcYuE0MkosRX5T33fRsEjbPJd7qlVpyu6a8KcZfF6PArmF2D6gw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnV296fbxHG5OLHHOplRCljtXIznwoZUZYUVW5-i8INA&oe=6AE0A8D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mjh8mUIlMigQ7kNvwFP91hh&_nc_oc=AdqLoTczD8lGUoTiO9plOrgKileMbToOgMeVGu6_wE-FRErdldj12AGGaQfOz1AEIL0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO57RdMS-6yu1LS4QbkQuqwPyoDb-DYlox_czzlSlfBcg&oe=6AE0C720"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_Pfq4O2NuoQ7kNvwETbadg&_nc_oc=AdqndSg5_NsbA24jOU-ueB6nxHyp_aN81SXFPGjy-0-fd1woNTLIXGTVnkuGx3yjM_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8kz2uT6THgri1GvojuC9I4qqJDFAJOcyzncMHQze27w&oe=6AE0ABC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M17t9rC3dwUQ7kNvwGJVvgp&_nc_oc=AdrMTPPr-DBAwXKwr411M9lvFvJFNlIUCOeQMOTTJGJgc1n6zdlhYKG36vp3FWzwl28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZpD0L_OlJrO3-De-IKef17wBKSc7HkzRf0CpopJXOHw&oe=6AE0A41A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
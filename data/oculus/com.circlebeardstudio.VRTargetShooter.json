rvOpEqXoobfdKzjwa5q4aWohOvZmM8-Ww&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyF8dAf6ed_tZ6pUccXhK7EBWXasNZJ7WyvNGydjI4g_Q&oe=69C7C1A2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDBKmByTA2cQ7kNvwGUnbat&_nc_oc=Adr5LyiIo8k4XeGvBG_1n-eL2_JPuADY4SE9_62zt9EPrXNk7-jMg_SOYB9iI5zWqXc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2qY58TtR65G3EyNpcAYyVUYdvkbEot6lE0mNqakfvXQ&oe=69C7D956"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZJ9FyKaQy4Q7kNvwEmxBmA&_nc_oc=AdrUz149fbgrMnYQtHyYn77FHBmQzLdLnVhXYdNJfNTJrp1ZG2CLd9NyZSIIPKGkjZA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLO5-3bk0-x65YJxJ_aH2X-kUgvlrsU65R_PRgH-1oiw&oe=69C7BF60"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gji9mR7PwlUQ7kNvwGZBRET&_nc_oc=AdoEn5ATzVKamMd_XZmM0OuS0zWnfxa0aEfY-7Ipzf1c-9XF1ygvR_Szu6eiBFe0S8o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLm9S8oOdA6biurSN4S338fXOMzREHzvZLiQN739Arjw&oe=69C7DC47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-WUXmj2KnMQ7kNvwFirQCh&_nc_oc=Ado9V-w2vUcked6jwb5nsOIvyXBIJ4SNubIJjEwiwx1-xb0MPfg8dS9LJKaLoVNZYW4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCbdA8wlGFRgOPXFtflTWekMfernBaNzbFTTv0fFugNA&oe=69C7D49A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
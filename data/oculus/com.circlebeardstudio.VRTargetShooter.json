xdSUw3Hrc9_sDEgJ708LVUHe6v8DXQTKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF2L-mS00XLCHD5lsgli0-exlQbXbpFj1TJ1kMcFY2sg&oe=6A5F5E22"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-8nX5U5eTUQ7kNvwHzO28w&_nc_oc=AdrTlLLuBUompGb9xlhOxqkFFXSr0lLmviA7k-rRpicKIwKAs-2dEeWxzxzTOuFgEkY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsp7trOUy8sks37VKQ2E1Je_hCk0otRflFzbVuxFMr7g&oe=6A5F75D6"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kE0Zbs4RCwQ7kNvwGU-jIy&_nc_oc=Adqmehewz83cAJaLla-FS2F4jOJJy5zAUmFEeJEFfb9cgq6asw5BdG-3fNM5C8K2rm4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgsG179UUHDJZ57o7GgSaHHiYjQc91_AHKKk47-5pAfg&oe=6A5F5BE0"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJAaQ0JBwOMQ7kNvwHWvUyj&_nc_oc=AdpXOYdB3DLb8lChQOqI2fRhH7mmhV0-HnWMJ0orjFjCBKQLOu8WRE-F0O28tuZEzGg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFJW9fW_aNG1Dbjzu1tjPOy2ASLjfPsgDYo6W6WlNrAA&oe=6A5F78C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9msLoVZMZgQ7kNvwFVc553&_nc_oc=Adr4kZaTlUYtMq053ETvtL4Fj4S0s1WyaijtHZPLrJ0o1j2SohZsr_jKmoe79Ji9Lsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAni2TPfiB5O7FpK7w6Jo2fONp8vHM68wFP8gYp-X79Tg&oe=6A5F711A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
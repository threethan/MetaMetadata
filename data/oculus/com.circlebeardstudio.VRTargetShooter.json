mEza5smpdmx2tkFgKj6iuxzTbGHLOgKNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2lKk2HPH3SdX-WgtyNJnWfxJpAXtyaiuYBnelGipDFQ&oe=6A6B3BA2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPNw1UouDt8Q7kNvwGJGt7F&_nc_oc=AdrLouG8jHnYxOrsXM6uOlZLEbaT7Owl_zwU74tP_p0Y2MPBufD6C9ijjFonnE0-onY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjOZKVGMQkMi784SIuf-aOLJUPntrpoMI5XATbcV-06Q&oe=6A6B5356"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN7fJCHgHu8Q7kNvwEDLKqj&_nc_oc=AdoE6TEk-ihvSCuLpOLr8o2pFjDvGDDsuwuLNrEci_K6bHFkzLSnf81wwhyMN2Cu8TI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByxQDrr4aWscuOI2fRIXgewTinQp-FkOF4StOuqfH-cg&oe=6A6B3960"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o13FB8QyvtUQ7kNvwEIoJv4&_nc_oc=Adr0UKeaj0TdKqvfmeKY7XbPF_qxWiCYPbQgI1KHdOQjioZpyP18B9IKJ6FLlUJz8vE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbo0Q8OcWrbmsLaDIgRE7kTHr5yZey1_YG-XoRXZZzGQ&oe=6A6B5647"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wh_xzMOhATIQ7kNvwGUrHHC&_nc_oc=AdqbecJKU0c4lstn1kC3F5IkZpQqDXAXK6O3F0zRqErm5GaG9CIgCMDQ3CrIZR1WCAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs8ZnKp0GKj8NM0ggjsbhHIU9a0bGc4F-P2hYvAQ-URQ&oe=6A6B4E9A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
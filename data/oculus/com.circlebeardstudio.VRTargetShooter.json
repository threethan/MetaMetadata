OUu9a8R_07DPgUPaahnh1LnaIgBoW5OfA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA73zYDNwYI4xFm2nIl0PWNix9wCTuARmymttp0T97W1w&oe=6A65F5A2"}, {"file_name": "ss4.png", "id": "961967495337484", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984475_961967502004150_2746166457523674826_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFJm84pnXeQQ7kNvwFo7waP&_nc_oc=AdpPXmsqPsHsKVIUR3EhN8Us4EV3ii1l1N6x8vQw_sLT6s_wVKpCNWi7aiZTOgc67sc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8-JZ_jMdYLQgkXSmjJ-3NgeFN8frXvNy5Dg5SbKyqng&oe=6A660D56"}, {"file_name": "SS1.png", "id": "1586251718893723", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982689_1586251725560389_3620496660463320637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L-V5V6pIHwQ7kNvwErxzNw&_nc_oc=AdqaKYFaTmehxL8gj5HEsOYAof0ZPViPrq4waTVgztPNUXyJ4yOuZReshe9MH7mNt3U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOFSpGfIUuD-qH_z18vPwSgs4bhGHqEI_so1jSSv7RCQ&oe=6A65F360"}, {"file_name": "ss5.png", "id": "486648363792569", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75334058_486648370459235_5430701532199714769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II877ko6Pu8Q7kNvwHbAoOH&_nc_oc=AdqRNnpp_e8qv62zyWG80mtQEK1irnWNitbIMCl8Vv3eu12nw2pdeRmXOhAiAIEIBIM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS9XacjRQx8HjPiFSTWa0I7Er5K7_fn55bIOGJRuy_Kw&oe=6A661047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "853757999927591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75254868_853758006594257_7443193151755883535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TuTc9EPwD8Q7kNvwFksjrb&_nc_oc=AdrMVCbUby2obLYlgAvEaFTr9FGlSFyBN86gz0S1qGIqNxECI6Kzeypr1s9pJRt9I80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx9_oxF0GdZMFNjqY_dWqcknnD9cKh5fq2EEQh7Gmrug&oe=6A66089A"}, "display_name": "Target Shooter VR", "keywords": [], "long_description": "Get ready for a barnyard blast in Target Shooter VR, the latest creation from Circle Beard Studio! Step into a vibrant farm setting where your shooting skills are put to the ultimate test. Targets spawn randomly around you, but they\u2019re not just any targets \u2013 they\u2019re chickens, ducks, pigs, and cows, making every shot a thrilling challenge. Armed with a VR blaster, you\u2019ll need precision and quick reflexes to hit your mark and rack up high scores. Target Shooter VR offers a fun and frenetic experience for players of all ages, blending humor and excitement in a unique countryside adventure. Can you master the farmyard frenzy and become the top shooter?", "short_description": "Step into the immersive world of Target Shooter VR, where precision, speed, and accuracy are your best allies. In this thrilling virtual reality game, you'll face a series of dynamic shooting challenges across various environments. From futuristic shooting ranges to wild west duels and alien invasions, each level tests your marksmanship with an array of targets that pop up, move, and even shoot back. Perfect your aim with a diverse arsenal of weapons, earn rewards, and climb the global leaderboa"}]}, "developer_name": "Circle Beard Studio", "developer_privacy_policy_url": "https://github.com/CircleBeardStudio", "developer_terms_of_service_url": null, "publisher_name": "Circle Beard Studio", "support_website_url": null, "website_url": "https://github.com/CircleBeardStudio", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
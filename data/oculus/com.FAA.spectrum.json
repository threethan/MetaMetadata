8", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_1677444026718341_706051444851563284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kkuxNwWBwgQ7kNvwHUxhEn&_nc_oc=AdrprM_ve5Icqb-L8DaQRdLpFSlELcYqxFhiw2rhsZJcOUH01vgPpB6ollOgP76NLNI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxglrS1A5z61SvXNiFZ6mBdIncI-H8uZ8ECR46EYv35A&oe=6AA40F0E"}, "display_name": "SPECTRUM", "keywords": ["puzzle", "XR", "meditative", "art"], "long_description": "SPECTRUM is an experience that combines art and game in a spatial installation, consisting of dozens of floating colourful spheres. Find their matching pairs, reach across the room, and watch your world fill with light, colour, and sound.\n\nFeatures:\n- Spatial puzzle progression with 10 levels of increasing complexity.\n- Zen mode for daily challenges and clearing your mind.\n- Meditative mixed reality experience that transforms your real surroundings into an art installation.\n- Intuitive interactions using hand tracking.", "short_description": "SPECTRUM turns your room into a meditative mixed reality experience. Dozens of colourful spheres float through your space \u2014 find their matching pairs, reach across the room, and watch your world fill with light, colour, and sound."}]}, "developer_name": "FUN AND AWE", "developer_privacy_policy_url": "https://www.notion.so/zhestkov/SPECTRUM-Privacy-Policy-321e3519f2b980abb661ebe88e1a9a93?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "FUN AND AWE", "support_website_url": null, "website_url": "https://www.fun-and-awe.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_mem
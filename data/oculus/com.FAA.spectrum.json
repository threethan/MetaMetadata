ve", "art"], "long_description": "SPECTRUM is an experience that combines art and game in a spatial installation, consisting of dozens of floating colourful spheres. Find their matching pairs, reach across the room, and watch your world fill with light, colour, and sound.\n\nFeatures:\n- Spatial puzzle progression with 10 levels of increasing complexity.\n- Zen mode for daily challenges and clearing your mind.\n- Meditative mixed reality experience that transforms your real surroundings into an art installation.\n- Intuitive interactions using hand tracking.", "short_description": "SPECTRUM turns your room into a meditative mixed reality experience. Dozens of colourful spheres float through your space \u2014 find their matching pairs, reach across the room, and watch your world fill with light, colour, and sound."}]}, "developer_name": "FUN AND AWE", "developer_privacy_policy_url": "https://www.notion.so/zhestkov/SPECTRUM-Privacy-Policy-321e3519f2b980abb661ebe88e1a9a93?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "FUN AND AWE", "support_website_url": null, "website_url": "https://www.fun-and-awe.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35110619555248005"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491820441_900765012588902_1159252965574987038_n.png?stp=dst-png_s36
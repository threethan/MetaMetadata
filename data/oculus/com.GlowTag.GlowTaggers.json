d": "3691846220949003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305194_3691846224282336_1346359130239796299_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOdTzJ6UxncQ7kNvwHJ-vx5&_nc_oc=AdqkzUf9gn51PLVxy-1Z3U4nPr9KO2lJwNhuBRxStgOsDxs2HqIialxKSDuf5KusF3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV03cODddlNI9-USD98qXLHfB4CSXXKMcYfVcbtAR9Dfg&oe=6B0F11B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Glow Tag!", "keywords": [], "long_description": "Welcome to Glow Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.\n", "short_description": "Welcome to Glow Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-glow-tag/home", "developer_terms_of_service_url": null, "publisher_name": "SplashOfficial", "support_website_url": null, "website_url": "https://sites.google.com/view/glow-tag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
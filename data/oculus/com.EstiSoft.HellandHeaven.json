20f&oh=00_AQMj2wGO86FKibzfermxWrIxV_fQoMnD8ZYQsSuQUTrH-w&oe=6ADF50F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-17 012309.png", "id": "1300309117640306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570314_1300309120973639_5156803316698235408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnAUEILV_-EQ7kNvwFkNHDB&_nc_oc=Adp04T-duxDjAqO5ASAi30nseZ7f0_28QY0MGMX833BrkK1MisQvzedEfJuolMlhUjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR2WCSgZmnfjA09ysr21pLrZne2gwJ_qUh7knh7TlakA&oe=6ADF553B"}, "display_name": "Good and Evil", "keywords": ["GoodAndEvil", "elite", "HeavenvsHell", "LightandDarkness", "EpicAdventureGame"], "long_description": "Step into the eternal struggle of light versus darkness in Good and Evil, an epic action-adventure game that challenges your wits, skills, and moral compass. Explore beautifully crafted realms, from radiant heavens to shadowy depths, as you navigate through puzzles, battles, and choices that define your journey.\n\nWill you fight for justice and ascend to greatness, or will you yield to the chaos and descend into darkness? Every decision you make affects your character\u2019s growth, unlocking unique abilities and shaping your ultimate fate. Along the way, encounter mythical creatures, engage in intense battles, and unravel the mysteries of a world caught between two forces.\n\nWith stunning graphics, an engaging narrative, and immersive gameplay, Good and Evil offers players an unforgettable journey of exploration and self-discovery. Whether you seek glory in the light or power in the shadows, this game allows you to forge your destiny. Download Good and Evil now and join the timeless battle between good and evil!", "short_description": "Experience the clash of light and darkness in Good and Evil! This action-adventure game takes you through stunning realms where every decision shapes your destiny. Will you embrace the path of righteousness or succumb to the lure of chaos? Navigate through thrilling challenges, collect powerful rewards, and uncover hidden secrets in this captivating journey. With immersive gameplay and breathtaking visuals, Good and Evil promises an unforgettable experience. Download now and choose your side in "}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/good-and-evil", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1725996564472128"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648778365204823"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "4056010881202512"}, {"status": "PUBLISHED", "id": "2052428582359053"}, {"status": "PUBLISHED", "id": "1429097072071549"}, {"status": "PUBLISHED", "id": "826998456343612"}, {"status": "PUBLISHED", "id": "707163625597767"}, {"status": "PUBLISHED", "id": "2036420370183628"}, {"status": "PUBLISHED", "id": "695973486281588"}, {"status": "PUBLISHED", "id": "601315199015338"}, {"status": "PUBLISHED", "id": "577518538187760"}]}, "baseline_offer": {"id": "695973486281588"}, "is_approved": true, "firstOffer": {"nodes": [{"start_ti
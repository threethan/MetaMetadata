8xCRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftHJjdeg06RrsiS14lNwfT7jIUQzdTmjNA21XPzRZKXzA&oe=69A968BB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0TsKhCgg20Q7kNvwHwoxbr&_nc_oc=AdlxkQsGvKL0mQz_ILU3HurDyBMkhGi7h7UIysbEUoA2wN37-8GoYmrW063OtZcNdtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvT8jfPhtRZe-2tu9QVRSTadra-ptqiQnhj1jZNgUXs4A&oe=69A98E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-h2ANpGVk4Q7kNvwHT8JY9&_nc_oc=Adkqa6lGfA64j4P5_P49g8dlN4ITXThyl-G_jDOAXfJRKx4lczTO0bFEb6CHjJS3new&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvPCJfpzeEps3mRuv6I4TMioKgf3aNsGFnu25hKlRn2Mg&oe=69A960FB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergam
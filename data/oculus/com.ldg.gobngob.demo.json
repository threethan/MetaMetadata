0vpz5S9zURKMLZazV8YkzLQ&oe=69A5743B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2zexbZa5acQ7kNvwENCYBz&_nc_oc=AdlxzX73rwv_zm140oz6wbOoofBRW7iytZFEDJmIAtcgna0tHikIGTQi9SDXxYODDW0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvUK-PsA36JU-ecNzjBHh_hKrkNrMlBRmYNXR6B6TyCog&oe=69A599D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb-6CdVhirQQ7kNvwE1Y87V&_nc_oc=AdmuY65gY1S1Gn7mhMl_9Ijhe_fkCbApET5t6YdsaI2xa8uLuK2Q7HmVfKARqqsBpQE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsB8yYkoE00TO5RDJbADYXyJkZqgqddxQuTwTV5VyxQpw&oe=69A56C7B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergames.com/terms", "publisher_name": "Little Dreamer Games", "support_website_url": "https://www.gobngob.com/con
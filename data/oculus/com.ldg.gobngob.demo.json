Qw-U4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHncJ5yScDjeZNBX6rE-hTV0VtNEuITjleHcAYtrrgiQ&oe=69B7E93B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghQxxNMw-4EQ7kNvwF7PmOW&_nc_oc=Adm565uFXjBL8fPui6r1ZMy8L-satkfwj9YXx-hCKpyamQChFYnU9C5JK7MstBHxgAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0AhF7bXKrZQ0oqD-nphhMLz_uxYM43QVAK9VGrU0kPg&oe=69B80ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt40WlCL_tIQ7kNvwE2ucbf&_nc_oc=AdkF_he6GbAV4JRPsymSKYEqxBgtw1HTaSP0ikBA3qDwfFAOaO8c9_EhERCS4bO7JDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZIn0JmYxwf2Z1koc6b69lTlxaOtmtz59_KcpRVHY-lw&oe=69B7E17B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergam
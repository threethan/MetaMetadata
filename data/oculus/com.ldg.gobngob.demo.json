u-6fKT5yLo1E0Kf_sxVfPLFsQn6QSNFGfgiAT7twk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n18Cl01gIuj3CUuAcgr0ODHwBpfBkW3IEeUvLZ491Fw&oe=69DCD33B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHozsOHcsD8Q7kNvwHy09xJ&_nc_oc=Adof3I5gQz91fM2UnETts7eH19CsD0h464QqFBLSde10Wg6R7eggmjS5mZnvu1YyTAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qy4TpjApdQ7W-OpyGUgmcy3sGBd4Xs2psgfTIIOA0lQ&oe=69DCF8D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj7YLmXhDyMQ7kNvwEX5bvw&_nc_oc=AdoRdhTRBL_sWPtPeGyzuToLad4twlKZLEnSxTO7lTUeMlJCN6sOSsHCEgju6YE2-Y8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QwwIGIj0wotb59KyhORJcB21fXi_dqLtd8-wjJMxnVg&oe=69DD03BB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
_BH6SO0GFquvKlIbBLQCwVuGdT-mzmJtmabxCTpas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECxPqY2tQ-lVWtvheaA76NCc-rNqMPxrDF1nno_0j_Yw&oe=6A731E3B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96JEYuvxvUIQ7kNvwHdxfB_&_nc_oc=Adpo6wLFmg3sdN_mEk97Su8JGqev4XyV4dTyhRsNlzVsqrAsIKF-pl2QO6kApgNdtYc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVQRA7v0ZnDQGPAlZYTSFLLwFcvCe6uZVwiZ24ZoKDZw&oe=6A7343D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raVjJrY2taIQ7kNvwFmi4iZ&_nc_oc=AdpOrWytTo9e8lqzKxKpuDds_B59ABmS5XjLAfA0XRzQYzPVrzPQJDhsfVKpJuRlYS0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN0rRLYYbr2AlS_cxwpyXYmO3wQKQfB9DCeJvxVqiL3w&oe=6A734EBB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
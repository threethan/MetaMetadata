tnjAjke3lZXDJ7CQVF5yhIA&oe=699D8B3B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDWOi5mft84Q7kNvwFD8INv&_nc_oc=AdnWVNlni48PCzo6EmhQCpo4DYUccpW5W9jkhqw97kXhrStw9sFVpvvFVksDL8mp634&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvtiJki3RR-7jE4JtIhqI6s9hESdJYFtY5291TIV0yJA&oe=699DB0D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFpJwj-lFksQ7kNvwE1ghrH&_nc_oc=Adn3a8FfsQfCtZohktMPWwgvjncye91iN7t2zq0b3reej5OYeoAulqmghcLHKbjawl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft6InWSM3XHO15SIoBP5G59g1reVht94oydJj7KUCCunA&oe=699D837B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergames.com/terms", "publisher_name": "Little Dreamer Games", "support_website_url": "https://www.gobngob.com/con
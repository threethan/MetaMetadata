T_75sARvlBUDv8j-QlrY7_glOOsjC8Br4jfrtg304&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sUWZzqjPiFX47WkI11mtIT7ieOmvGL3kQG71v3JsPmg&oe=6A0B2FFB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ji3o3-lLlvAQ7kNvwGj3xZP&_nc_oc=AdqgU1HxYPYS9oqmLujLHF0x5-RGd6FSo5TEEzcTwHtAb7QQwKBjKgi6dEPURVSTRhU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y5LBJbibuoh9g8z6nelxpMkXavuMaNmPRVJM2FMEnuw&oe=6A0B1D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zKKGYvk4eYQ7kNvwEPYhZk&_nc_oc=AdraSWkONhMGk69w1HHRzA49XhGqCNlftLq1GLC-ObnXzy5rXqTMFe7TYrNCOswozC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jJ-9SAxrzbQqKP6xcfAM2AsSrllnhK7EYkN5NgssP2Q&oe=6A0B283B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
SzUtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCH-emYewA0r9ENDUnFATu4MnN7TBR2PqgpRqtelOYVA&oe=69AD5D3B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw4I67S_ivAQ7kNvwGNYIk7&_nc_oc=AdlsQ_yj3wX_N_UA6rrAT4GjQk9Enuch-f2h9vvOrihf3KwtHqcDOS5Vb3_NCIKDwbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr5RI_b1G7Sj_zGThdi3BW6KtBUuzrbVFcaqa__JW2vg&oe=69AD82D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEgTdcVz1_UQ7kNvwH1xzqp&_nc_oc=AdlMBWrKuEKQdyi9NcuKYHdbiuY3CG6rYzsTS2n98dANR_rnO1iWbTZdl_leJSeBM5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoM-Qbu-af8M__OjbLwp5DLFk-V7P_V0KrBTddKneopg&oe=69AD557B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergam
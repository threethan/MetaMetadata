ilt-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergames.com/terms", "publisher_name": "Little Dreamer Games", "support_website_url": "https://www.gobngob.com/contact", "website_url": "https://www.gobngob.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24722877393987489"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210898_238300345422961_6763321902779981003_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CJf_nXMlR8Q7kNvwGNuFdW&_nc_oc=Adqw1byRQM2fj4a6JCVCiTI-ihJ2bWpmz-SafyfGoqpQRa8VRVWfuh7x4600teDTXM4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX0nOF02vUkOpa-YwbX_EWc_MWnytBMh_l91wroGtbcg&oe=6AFC82D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GOB 'n' GOB Early Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592
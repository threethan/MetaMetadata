a4kziGYZn5-EyvLXe_CzJRo08H5tIO7H4ZEj-TatI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tBhDHb-8Ruev0je-Ljd8Zv6VQLIZadLWgKi6cxDwong&oe=6A01F57B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac2UfNA_2bMQ7kNvwF135_8&_nc_oc=AdrktXOOh1XaF2yMDj2fftojGkgtb9plmGXKDaw-CZ7kd5NP6RXF0MXfn4j5wew9Ezc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65lhZo-w3vNl6xFTwFK9KpLyVWH4_JxJVmMg-vf3gJWw&oe=6A01E2D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqzG9Mi3lE4Q7kNvwFlw1eG&_nc_oc=AdohfSra0sfhRqH1CbMYo11Scg6m5TAuet8FYyzprDhbXVpzli-fGXFMNcPvfn7p6Kk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YYgG_PJn-JGHZxzX68bMrQ6vNrVX8rUkvVAtEIfmGfw&oe=6A01EDBB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
wVE9lkQ58NKlJLxhtG-6sFUXwU7Ak-S0hMRX8SCH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMONCRx_aQOEr1ZkC7dONh84BO8smIbX-6aznVLCvX4PQ&oe=6ACA597B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujLqX4EyFAoQ7kNvwH8E3Iy&_nc_oc=AdqS_5okSm3fT_iDcnjgv9JQrpe9C23VBtTBpl9b7hn89TrSxmbkJ-emRbz2wIxEqk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPL8peSm9JxYyYmyfxeFTUSaisSlRG4fnSS03rf-Vwpw&oe=6ACA46D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrXugl90mqUQ7kNvwF6-aNW&_nc_oc=AdqCxDVP3GMlMo7wBxCelntM5Ry4oEc9j7g31NTf5M403ho1Ewh0fw7UeVUS_dnIC64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1CusbOQT9zJjKrYeNy5ZT67ejwxSeUoUP6deHIpGJAA&oe=6ACA51BB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
T735Mrc5EkpqWuiuAxLV6aQOqjCpfqtNavn8OCbAs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1Tx3AyTzjvkQMLi4abakocxXGTGMdlVJmDZKpySfKOw&oe=6ABE7BFB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld5kZa2C59YQ7kNvwH-B8_p&_nc_oc=AdqMtk0EiMCthKZUVvXqkHpDqbW6TtbD7KmSRDf5Bjd-GNtkXBuZ2VgD2w1upcryqKE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA1u-WpKDrxthPuEj5fCubkmSHb0qQb_ht1nveivsUVQ&oe=6ABE6957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBSyl3r-aD8Q7kNvwHX-wy0&_nc_oc=Adqg8imHhiC9b1TpcXZyR4Ic6B-ig0Na9zDUaGXwSJ2lPkdwkeEyQQU7RFRtEgwYpZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7ZFTueVKlGQduJ3uQY2f46G_MS2pQcC35PcBXF-OTNg&oe=6ABE743B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
mH4V4NfPVJJL-1TK_2uaD-01AT_vUXpSi1BYjHK9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Bg9PI_F7uHEeGZX4UzsELP2CtxpRitayVGAQCFUodPA&oe=6A47D4FB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2GATuPO_WwQ7kNvwG-2DVr&_nc_oc=AdpphFOeJaDUNr7FdzQ8McJ-EgHVSaZPPhmODXh4RuhWValjlTyp4l9YVIWVIvuE8Js&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90LuTGidkFcOgf90ktLJQMe_76mTB46nVWjN_JM5he3A&oe=6A47C257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8ly54wDuuQQ7kNvwE57IJh&_nc_oc=Adqi1Dc2_P9v_jnJt-iTTqY56-7b9vsCwLK52AK3gPde8l89X185lZH5hmtyua9-pHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ka3Ojd3BXLhSnHkuCbnqtgSm3hCxj86d1G0X2IDxWbA&oe=6A47CD3B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
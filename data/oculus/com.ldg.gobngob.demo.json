iqL_rQJk4tUtfOiL8mSnaZmvwpFxQxrzqCHD6KqpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz-9SmRO_jwkRvU8I6SQC83qVHs4H-8fOvZoaa83wHqA&oe=6A510F7B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHh0k6aRkuwQ7kNvwH06IPP&_nc_oc=Ado7Ts73reS0C20x1HTKzWCwY_8gNkPEnAjVXoSf_i2FmxDr9LPjBXdWYio80AS37JE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtqHqbGgNxBoB8pDJasAO1S5JUeKu1NAnbjlEiYuVIFg&oe=6A50FCD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3sowjf-3bQQ7kNvwHSpoFu&_nc_oc=Adp9NTPj-kZPDqsDMtrPDCGd3i34PNZDnpyBcJK7g7kqS7JkMx8lHwDc1v7Qv_FL3Ck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkcjOup4bBln5-tVIgaKsmGRUCFtTCI2b0Mp16nyUa9Q&oe=6A5107BB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
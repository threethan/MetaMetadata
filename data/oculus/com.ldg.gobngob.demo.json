77366961_2847751349172244015_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TePXA_q-1QEQ7kNvwFtumeX&_nc_oc=AdpIXJKD9c9dRWSkhXc2IKKDbmGuY-Aa_wuptaUHTIxceXVsFAB5vsvUV2wduPB0-9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnPOrb4SIRVzWRONGKnUWmprkainAjphV3VJwMFK_Iow&oe=6B05D297"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFBaLJj1vkIQ7kNvwH3c_ZP&_nc_oc=Adpd4R3F39CHnooE0O38ldFdAHYuoybugesR5XWFp8rPErbQPUWRv_lSAPX1vzUzZ2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVk-auPUxdps2M-4DvJQJd8vttC_e037D_NFTjLDoZdQ&oe=6B05A53B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": [], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergames.com/terms", "publisher_name": "Little Dreamer Games", "support_website_url": "https://www.gobngob.com/contact", "website_url": "https://www.gobngob.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
cgEC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQ6NNYdcvRiPGLuCLf3tEEWeCZvKwqREuxBgvkTqby_w&oe=69B93ABB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMZ0Fas7nB0Q7kNvwHKWxRj&_nc_oc=AdlQ5RBW6283kTj95eoGuN_nIFqMo9FDdIV6XkuS_Np2OLMYDXOhB9FDW9dJ8dpn2lI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw843mK8WoXooFDeG0jgflvlZrh1n_n70RzKewQ0DRAHQ&oe=69B96057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt40WlCL_tIQ7kNvwFos_yC&_nc_oc=Admfgy59qlUmnuXVne1JNsPmpx3z8EBuwjA7ksTHRY9pAW-jNU57TV-9MUM_Sobzog8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxh4TKkTz4QFYjGIdY5hXsBlUBXFlu-mPcSHWd-NG5huA&oe=69B932FB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergam
ek3XpJd8qj1-iyhl2hsEjYh537vSYUea7_AV-8ZoA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_RmrXEJXZdvzBu22ftvEjroPxxEthg46gp4try5TxPg&oe=6AA56F7B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoHdWQEK8awQ7kNvwElBOrG&_nc_oc=AdqGgK8PxFFULdT8AcAd_j1Q2y8LX1FlUuYSp_cYWmNKi_fjzdLDALhFflTr31bTpkQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNLcD3JXnOfdmvHjjdzgcQsy2gmLhcr2GkoZ8BeNybDw&oe=6AA55CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oep3dTDyAhQQ7kNvwEx1wmj&_nc_oc=AdrDITAtko86gUm1EX2f84BvrmnQL4sVt5xwgkZLme76-H3TkIsku-0nLwBiX-IYkPw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe_FxBzvriX7e7TPZ1GVqBe9J3SbYjvUdy77Y2P5jz5g&oe=6AA567BB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
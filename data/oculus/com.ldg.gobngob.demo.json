H7uF8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyj1mPASwNnaDh7RM6iPB4WFN2g__8V7mmzVa0m04Zheg&oe=69AEAEBB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw4I67S_ivAQ7kNvwHDQxe1&_nc_oc=Adm6DFOCBP__osUnigWxGyFe6uWSlvwh1acUttky4EIa0OveEM-FIEHKHcSFo1hiYlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKoxf2Y9ItQwbFIxWvTkPkUk9FR8KO2ezfkpt2f5aUMA&oe=69AED457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed4xqgdwSKAQ7kNvwHiUON6&_nc_oc=AdntL9NPE46EN4K8TEFtGharsQIqxnsfmSMj5O3psmvGHBO9k9EZ4Zaz7YmTRw_Acek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzOLUE6EHNOq7dI-SyPWKhs-NnSlqsKWKsy8cJjEvIFA&oe=69AEA6FB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergam
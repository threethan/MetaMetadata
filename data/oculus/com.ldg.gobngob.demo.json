8uPkQ9oQWIp3oYPe5akU6gNxsAE-zGHHpOoPHEcdqQORQ3j-M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbH0Dpsscs4qL216FgvoxvF1uTLXrBnseOCo79p7uf1Q&oe=6A85933B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwcF3WgJNhkQ7kNvwFV3Npk&_nc_oc=Adoc24ztacV0oCqybX5TXgQ6jzVWz1qFS7a4NDtaXh6_Vs_v300qk83L5KaIHdbNY_A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxN4Dt1sIqUakBJ1kAzGlFaIW1p4ljaKE43xLN4FZKHA&oe=6A858097"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuvAih_SCyYQ7kNvwEG4Sx7&_nc_oc=Adq7nTb21hj0fi2nN7slI4U_QBG31g1mJqXdJYcDWUrEsNpZK7ozYgtHrmM5O_yeKiM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-TmcZ8QUoPZV7x1tfNUsE20SfR3KltsE-dUSvcCRNpQ&oe=6A858B7B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "deve
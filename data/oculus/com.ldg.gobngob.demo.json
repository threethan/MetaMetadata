ULwr8dv7v2UcZxdb1UjP0gzuEGKYVuBDU8QJApPUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GzG0nsfubXjwuEumF7ESO5gXam0RzJlIX5T0cXUOyZg&oe=6A0346FB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac2UfNA_2bMQ7kNvwFEiGNp&_nc_oc=Adp8nzya1uFvF_fq9xy7BUPSQTv5Wl2x6p7Ci8MKv7BEoByNlQe0crIuYx3IvAMp4lM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68urvbF8EPYOe-ZaZs39k4WsoxEXMSCaLhdVyYneuhMw&oe=6A033457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqzG9Mi3lE4Q7kNvwGpYZqK&_nc_oc=Adpn2ICAuVClbGyXeJ0Rani89koA2MItcec1vgeUAHn4WE8b48IFi2839AvXJkadSq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tfxEBaJfVZTZ6RBJU_HFbhQVrLwhy1t1H9zTs2a5I2Q&oe=6A033F3B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergames.com/terms", "publisher_name": "Little Dreamer Games", "support_website_url": "https://www.gobngob.com/contact", "website_url": "https://www.gobngob.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24722877393987489"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210898_238300345422961_6763321902779981003_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGyZq5h0GJ4Q7kNvwFGyT46&_nc_oc=AdoUzMblwPmz4xxjPtNxOcahBYD-qtUNrCp5CKgHBqWthdOUOmdIgqfeUjMuN8KOFzI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BoXMPxReelM9QBOi6X_rC2D3zo0BOTZnRagPig5LiyQ&oe=6A031F15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GOB 'n' GOB Early Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1696964400, "lastRevision": {"nodes": [{"id": "6025372837497894", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6025372824164562", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": 
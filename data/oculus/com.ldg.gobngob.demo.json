hcQhHwCqzRGDrJwRa-UBnrw&oe=6998453B"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvUT907XB7wQ7kNvwGW0-so&_nc_oc=AdlnYJQZeGkcVMtwc1KQnbhk8pAc6-HzyMRgLiQDy14F_z5TtnqMV4uWyp50voiOsiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afuk80bKEyW2rHG3KwHnY2OcGQO-2WBNSHW6b7P_1pvYnw&oe=69986AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxutduD-ha4Q7kNvwERSA3n&_nc_oc=AdnvoJW_XcsfhJjEyagSvvQBmLh4ChP88WBmXT1070oybTBEZp4IcbBtisBHrBSLlxc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsa9B4qXALNCVc0E_YD0IUskoYXHurrM9aDmvUnrD3Mmw&oe=69983D7B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_terms_of_service_url": "https://www.littledreamergames.com/terms", "publisher_name": "Little Dreamer Games", "support_website_url": "https://www.gobngob.com/con
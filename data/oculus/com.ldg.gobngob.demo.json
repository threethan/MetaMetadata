uAWtJlGKjbygOu3ot2OuJ_D0gGUUUCwUHdxoi4tkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBldewKgjcBGpXC329367pOm6PEZecwnH2df9_UidfVmw&oe=6A5260FB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHh0k6aRkuwQ7kNvwEFxcJX&_nc_oc=AdoLoj16Mnfojazxffou_kufPI5wqhK24EACGPYiz0ObMmoKi3Ex1Fha6uoqdd8aziU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALnC7pkc8MDUJqK9sz9Wm9jgVE73FSgq2ZMPvuA8xtdg&oe=6A524E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3sowjf-3bQQ7kNvwFic6dj&_nc_oc=AdputAhSwNZHyRBRvNrS2a_NQtXGdfzxR2XlUGLat4UEuo86vRoMuSusn1kc4PW7vVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCusnRNroNcTMu1g2hGjsu-w3obJ9u9_bqtdSqFIzBDg&oe=6A52593B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
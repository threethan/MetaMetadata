j_MhXUR_8E4DSpr9lQ9JscCjQcV2bUL7xG1o6a0pg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sw4GM_WvVvdygHzs7ktMb7prRZo9E6hSJRXgWv8COLQ&oe=6A1DA4FB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N08zKR4IlDcQ7kNvwGRFP3z&_nc_oc=AdpLY-f0cfC8pr-jl4-ii4mau6M441h_dtt1LVUDNckWG8M8Rcvtl8knuXkSUqh_EBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43Gi22pO7NB8e9j3gjxLLdehhktKwFJNrjDJV24v_7qg&oe=6A1D9257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDhb_-6f2zQQ7kNvwHY3o5N&_nc_oc=AdpW1UIASsOpcPo3SyZcEUtNQssVdD38uf21ZDaosGyMqZthNb7IrD1t5j2S6dtG9NQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EosC6XrMwJdDypEj08vSJmEe3RWa-50TTqCfl0hP6Rw&oe=6A1D9D3B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
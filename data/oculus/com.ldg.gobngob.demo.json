usMczwj0fAq6bfK8w_kt1Ax2VGld-fF5uiWCZgds0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsodbUQ9aYP9H41Lvb45HuqUNvgQ2RJtKZm1Fb_g0gwA&oe=6A8987BB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rOWLcGBja8Q7kNvwERGdeK&_nc_oc=AdoNewkCHbHpso4aEhxGuERQ5fl0zqDOf7M4RYde1RxIpNR1r08LRa15mg73KcChRbo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG11sGZkuuE7xfXuPkpR6fAWxLCs3b86kVp_RdBl-qTIQ&oe=6A897517"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTk-YjqiGJAQ7kNvwHpf9zd&_nc_oc=AdprGOyVQOBnfbetBMQZhJVxfo_Iw4xrvGRiDfhQnPz5ds_28hrUm76Wgkb4MIkdjF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuG1X5OP3Z4n03Zk4DNFutDikSUYzLKmDEZeTUGBWHcA&oe=6A897FFB"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
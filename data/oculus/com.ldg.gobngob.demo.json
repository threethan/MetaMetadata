fqhIOPpq1MtEk2w4lX_OL3ubBz12J1i3ztpN3PMLs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExMU6CRgAH38h2t4I4vK7Byr_o5Gd2_Hmd8fLoFQN7Iw&oe=6A7EFBBB"}, {"file_name": "E.png", "id": "1299327774033628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1299327777366961_2847751349172244015_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJGjr4PxqycQ7kNvwH-cIJK&_nc_oc=AdrJV0x-uVdf_LHBAEic6qhRs4nbrQL23r-fbEaLRm2InsPopcBz0hBJDSNIRH5-Ph4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv0ODzRX152Fxtr2uVxBbjdTgwSpO19H0szfdJRYT9TQ&oe=6A7F2157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1253171961963534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974452_1253171965296867_7728549463423463840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4puGMLXgz8QQ7kNvwGpUZ6N&_nc_oc=AdolCud_LHMHgRmd6jvORphoqKl6H1-M5bC4fsYQ8wmfKbjliS39DEI7a7CAvnVzI5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmzQfpfhlqpIwryqlHO3e6-iE0htxJOhQRywvcC4Xg_A&oe=6A7F2C3B"}, "display_name": "GOB 'n' GOB Early Demo", "keywords": ["rhythm", "music", "beat", "tempo", "gob"], "long_description": "GOB 'n' GOB is still in development, and this is the Early Demo of the game. Please, if you have any feedback, send it to feedback@gobngob.com.\n\nGOB 'n' GOB is a hack and slash rhythm game that takes place in VR. Pick your favorite song, select an environment to play in, then hack and slash your way through the song to get the highest score in the world. If you're having trouble, there is a practice mode to help you get better. If you're a creator, there's even a built-in GOB Mapper that can be used to create your own GOB maps for songs that come with the game.", "short_description": "VR hack and slash Rhythm Game and Mapper. Currently in development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.littledreamergames.com/privacy", "developer_term
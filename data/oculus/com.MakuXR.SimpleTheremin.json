/38974827_856567065186086_2629895353751846440_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM8L2Zn6oUoQ7kNvwEjZtd8&_nc_oc=Adp2mWz6kutyfUqR1j3Q6OBgXTFpsZjOBT1qRMfkzTor_YxDHVS8wHmg07Z4vwVWC6w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSNfr5r1_q3TXtxZlcBTrfanJRvNeafnrNs8wGbDGWbw&oe=6B083FC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Logo.png", "id": "756543068579614", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974820_756543071912947_9002300068869800877_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX-qOCdfo1QQ7kNvwHL13R2&_nc_oc=AdqeUDvm879J5jZ6GoCw7QczwBXxLoYxhdGVwxsuJtyRu9Ld7aaks269-MRmQrNyGgw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-86yeJiLpx2ib87D37qu4W6p4Wb0Z_Y8bzTPIfrUGxg&oe=6B08721A"}, "display_name": "Simple Theremin", "keywords": [], "long_description": "Simple Theremin is a musical instrument simulation that allows musicians to play a virtual Theremin using hand tracking as well as their touch controllers. \n\nWith a variety of four different waveforms to choose from and reverb adjustment, you can create your own sound! Simple Theremin also lets you enable \"live mode\" and connect your quest headphone output into an amplifier for live performances.", "short_description": "Simple Theremin is a virtual Theremin that can be played with your hands or controllers. Select between four different waveforms, add reverb, and use live mode for live performances."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.makuxr.com/thereminprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Maku XR", "support_website_url": null, "website_url": "https://www.makuxr.com/simple-theremin", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
_trailer": null, "video_trailer_thumbnail": {"file_name": "FOE_Logo_2560x1440.png", "id": "264908955655922", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974854_264908958989255_6190523671737743685_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlByBAs3gxcQ7kNvwHc35r8&_nc_oc=AdpOqmWVoR3_Mh93PCty_OUQVe4jFG8cSvR7m_jW9CxuLGGmE7tmt188Bz4u0mSr0Uc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3yyN7us9ZRb7j_dUts9qlHZD4rwJelJxW8NCKk1HQTA&oe=6AFF1FDA"}, "display_name": "The Future of Energy", "keywords": [], "long_description": "The Future of Energy project sits at the intersection of education, entertainment and interactive data visualization. \n\nPerfect energy conversion means that 100% of an object\u2019s mass is converted into energy. Our best methods of energy conversion today yield less than 1% conversion efficiency. This VR experience allows players to step into the world of energy to play with these far-out concepts. \n\nThe Future of Energy is the first of many short-form (10-20 min) interactive education pieces. Upcoming pieces from Found Object VR include Inside CRISPR, Understanding Wildfires, Explore Antarctica, and The History of Currency.", "short_description": "The Future of Energy project sits at the intersection of education, entertainment and interactive data visualization. \n\nPerfect energy conversion means that 100% of an object\u2019s mass is converted into energy. Our best methods of energy conversion today yield less than 1% conversion efficiency. This VR experience allows players to step into the world of energy to play with these far-out concepts. \n\nThe Future of Energy is the first of many short-form (10-20 min) interactive education pieces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/q0nsxv2cz5zsv7f/FutureOfEnergy_PrivacyPolicy.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Found Object Media", "support_website_u
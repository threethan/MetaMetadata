file_name": "FOE_Logo_2560x1440.png", "id": "264908955655922", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974854_264908958989255_6190523671737743685_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlByBAs3gxcQ7kNvwHc35r8&_nc_oc=AdpOqmWVoR3_Mh93PCty_OUQVe4jFG8cSvR7m_jW9CxuLGGmE7tmt188Bz4u0mSr0Uc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3yyN7us9ZRb7j_dUts9qlHZD4rwJelJxW8NCKk1HQTA&oe=6AFF1FDA"}, "display_name": "The Future of Energy", "keywords": [], "long_description": "The Future of Energy project sits at the intersection of education, entertainment and interactive data visualization. \n\nPerfect energy conversion means that 100% of an object\u2019s mass is converted into energy. Our best methods of energy conversion today yield less than 1% conversion efficiency. This VR experience allows players to step into the world of energy to play with these far-out concepts. \n\nThe Future of Energy is the first of many short-form (10-20 min) interactive education pieces. Upcoming pieces from Found Object VR include Inside CRISPR, Understanding Wildfires, Explore Antarctica, and The History of Currency.", "short_description": "The Future of Energy project sits at the intersection of education, entertainment and interactive data visualization. \n\nPerfect energy conversion means that 100% of an object\u2019s mass is converted into energy. Our best methods of energy conversion today yield less than 1% conversion efficiency. This VR experience allows players to step into the world of energy to play with these far-out concepts. \n\nThe Future of Energy is the first of many short-form (10-20 min) interactive education pieces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/q0nsxv2cz5zsv7f/FutureOfEnergy_PrivacyPolicy.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Found Object Media", "support_website_url": null, "website_url": "https://foundobjectmedia.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "471079584368791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031342_3015814978735450_7961206893711797528_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flw3yPkeI9gQ7kNvwGtcPyo&_nc_oc=Ado7vvVIjjZXAexlWQHHazbNuufN9rFnlKbBIkUYDHfakFSaHX1FdEvvkctk1AEzEA0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrCMcFs1N_iHoE99xzi9ePU9-hH7txUaYu46215oMWHQ&oe=6AFF18BE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Future of Energy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1643759132, "lastRevision": {"nodes": [{"id": "847935009199517", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4911597315520363", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "395476302090752"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "FOE_Logo_10
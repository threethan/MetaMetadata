m&_nc_ss=8&oh=00_AfxyYf94i2Oc-rJtKzc47HjKF9NsxsI0pxfUIMtnnIWu8g&oe=69B5509A"}, "display_name": "The Future of Energy", "keywords": [], "long_description": "The Future of Energy project sits at the intersection of education, entertainment and interactive data visualization. \n\nPerfect energy conversion means that 100% of an object\u2019s mass is converted into energy. Our best methods of energy conversion today yield less than 1% conversion efficiency. This VR experience allows players to step into the world of energy to play with these far-out concepts. \n\nThe Future of Energy is the first of many short-form (10-20 min) interactive education pieces. Upcoming pieces from Found Object VR include Inside CRISPR, Understanding Wildfires, Explore Antarctica, and The History of Currency.", "short_description": "The Future of Energy project sits at the intersection of education, entertainment and interactive data visualization. \n\nPerfect energy conversion means that 100% of an object\u2019s mass is converted into energy. Our best methods of energy conversion today yield less than 1% conversion efficiency. This VR experience allows players to step into the world of energy to play with these far-out concepts. \n\nThe Future of Energy is the first of many short-form (10-20 min) interactive education pieces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/q0nsxv2cz5zsv7f/FutureOfEnergy_PrivacyPolicy.pdf?dl=0", "developer_terms_of_service_url": null, "publisher_name": "Found Object Media", "support_website_url": null, "website_url": "https://foundobjectmedia.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
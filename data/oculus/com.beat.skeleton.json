965_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcGJeOKbp9cQ7kNvwEWUveg&_nc_oc=AdpWDMA-4_-DjRFISeevkloXQfbHoUIwgRJwEUx6F6EBsayCpck7E8zCCJlIkx_PkNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7jFy8M0vAeY5HsZ268wTjG4qMsTf1YS0sdN706Ijh4Q&oe=6AFDCC53"}, {"file_name": "55.png", "id": "1755149635515409", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311597_1755149638848742_2560470388775987565_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sfoEt8QTH0Q7kNvwHfYRPg&_nc_oc=AdoAcmPVi3X_PFl6tgwnRWJXHpI-E43Y26K_2ZrsiiAnXrBYziKgEILQEQsp_Tfr4Ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGpvwE7QutLgv6N9Dxxsjv9R0dIbeSs-S2vKBRN59kXg&oe=6AFDC3F0"}, {"file_name": "44.png", "id": "1548458096958980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_1548458100292313_6762323974849919729_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p06DKBKY-UQ7kNvwHDpMWB&_nc_oc=AdocgMsqibSr9GDGsvv7pXeZtLKHzNEByt4R2fZzXoURSSw6y5o_MiciI1FGG6-KdoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMVNmy-g40JSXlMnC6mGNA8a8HzGzmEH7W7we0NEoWCA&oe=6AFDC784"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Skeleton", "keywords": ["Beat", "Blade", "Sorcery", "Saber", "Sword"], "long_description": "MASTER THE BEAT. UNLEASH YOUR BLADES. EMBRACE THE SORCERY.\nEvery Beat matters. Every Rhythm rewards precision. Every Blade has a purpose. Every Slice sends another skeleton crashing into a storm of flying bones.\nWelcome to Beat Skeleton, a fast-paced VR Rhythm action game where music, timing, and dual Saber combat become one addictive experience. Wield two powerful Blades, Slice, slash, smash, and shatter endless skeleton warriors while building massive combos and chasing your highest score.\nEvery perfectly timed strike explodes skeletons with satisfying bone physics, while every missed Beat challenges your focus and breaks your combo. Master the Rhythm, sharpen your skills, and push your reflexes as each battle becomes faster and more intense.\nFight across two unique worlds\u2014a blazing lava arena and a frozen snow battlefield\u2014each delivering spectacular visuals and nonstop action. Experience the Sorcery of perfect synchronization as your hands, your Sabers, your Blades, and the music move together in complete harmony.\nBuilt exclusively for Meta Quest, Beat Skeleton delivers responsive VR combat, addictive score chasing, explosive skeleton destruction, endless replayability, and the thrill of mastering every Beat, every Rhythm, every Blade, every Saber, and every perfect Slice.\nThe Beat never stops. Will you?", "short_description": "Master the Beat with twin Sabers and razor-sharp Blades in an adrenaline-fueled VR Rhythm action game. Slice through relentless skeletons, unleash explosive bone physics, build massive combos, and discover the Sorcery of perfect timing across epic lava and snow arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
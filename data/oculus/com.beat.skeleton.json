_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p06DKBKY-UQ7kNvwHDpMWB&_nc_oc=AdocgMsqibSr9GDGsvv7pXeZtLKHzNEByt4R2fZzXoURSSw6y5o_MiciI1FGG6-KdoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMVNmy-g40JSXlMnC6mGNA8a8HzGzmEH7W7we0NEoWCA&oe=6AFDC784"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Skeleton", "keywords": ["Beat", "Blade", "Sorcery", "Saber", "Sword"], "long_description": "MASTER THE BEAT. UNLEASH YOUR BLADES. EMBRACE THE SORCERY.\nEvery Beat matters. Every Rhythm rewards precision. Every Blade has a purpose. Every Slice sends another skeleton crashing into a storm of flying bones.\nWelcome to Beat Skeleton, a fast-paced VR Rhythm action game where music, timing, and dual Saber combat become one addictive experience. Wield two powerful Blades, Slice, slash, smash, and shatter endless skeleton warriors while building massive combos and chasing your highest score.\nEvery perfectly timed strike explodes skeletons with satisfying bone physics, while every missed Beat challenges your focus and breaks your combo. Master the Rhythm, sharpen your skills, and push your reflexes as each battle becomes faster and more intense.\nFight across two unique worlds\u2014a blazing lava arena and a frozen snow battlefield\u2014each delivering spectacular visuals and nonstop action. Experience the Sorcery of perfect synchronization as your hands, your Sabers, your Blades, and the music move together in complete harmony.\nBuilt exclusively for Meta Quest, Beat Skeleton delivers responsive VR combat, addictive score chasing, explosive skeleton destruction, endless replayability, and the thrill of mastering every Beat, every Rhythm, every Blade, every Saber, and every perfect Slice.\nThe Beat never stops. Will you?", "short_description": "Master the Beat with twin Sabers and razor-sharp Blades in an adrenaline-fueled VR Rhythm action game. Slice through relentless skeletons, unleash explosive bone physics, build massive combos, and discover the Sorcery of perfect timing across epic lava and snow arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1248866854982351"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1054777234288358"}, {"status": "PUBLISHED", "id": "1624645145728856"}, {"status": "CANCELLED", "id": "2614231375696999"}, {"status": "PUBLISHED", "id": "1037880892370879"}]}, "baseline_offer": {"id": "1037880892370879"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1054777234288358"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1251212814747755", "version": "0.1"}, "id": "1370202741980850", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1248866841649019", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1251212814747755"}, "re
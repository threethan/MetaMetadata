.oculuscdn.com/v/t64.5771-25/38974568_469347149473424_4788019419558433794_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpWsEK20qWsQ7kNvwGTqb2B&_nc_oc=AdpdBSDYI2pTxovnuz4DqlOa4QCq1up0FWFDXKP1nLM27D8lp3yDPZumIw_kSEv7mWE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7Jy7pDnEjllwQVUn22YfmDeI2LAG16zIUlkg0RYhYyw&oe=6AD390C8"}, {"file_name": "S4.png", "id": "1589494074971302", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982622_1589494081637968_8661073390467476111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pcI2d5l4xgQ7kNvwGmvzAp&_nc_oc=AdoPb7NHA_Gp5LWAgyCBtgdf3GZZJ5hIMj86niA_VT0ITN9Cb24nB7b9NSdniVwpISo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh1eZrSSviP345tC4KOJc6B9rhCtntYB8ZC3Pgxe5Tyw&oe=6AD3968B"}, {"file_name": "S1.png", "id": "1870256840148319", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031524_1870256843481652_8504559206061228227_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guQvospcMA4Q7kNvwFG5gvY&_nc_oc=AdqqNRtYtzGk3RAZGLwIWdJK06QQHzLRWsPmAWYk8hhlDBVQYACKDGcNqDjAutbx96g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl8hbAyO0Wm32kWwqEVqeBbRgbHw6O1JzHjLpM1cMOxQ&oe=6AD3B221"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverArt.png", "id": "1069769008085981", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974780_1069769011419314_856597801219685842_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORBGFgY7olkQ7kNvwF-xdiM&_nc_oc=Adq1QNy2Bl2ef9jeIhPb6sa9UphrhF3wk7u-_fmDqFUgvEkLym8Un9BeubeLt-FtmPE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3SuJSLODr1QOCbnlj5fQ6bHvdDKiu3gKdTU6lxqU4GQ&oe=6AD3B930"}, "display_name": "Grenade Junky", "keywords": ["rocket", "jump", "deathmatch", "multiplayer", "boomer"], "long_description": "# *Grenade Junky: Explosive VR Mayhem!*\n\n# 3v3 Team Deathmatch\nGrab your friends or team up with new allies in Grenade Junky's high-stakes 3v3 Team Deathmatch! Embrace the chaos as you clash with opponents in a VR battleground designed for intense, nonstop action. Test your reflexes and firepower as you aim to dominate, dodge, and destroy.\n\n# Rocket Jump Platforming\nIn Grenade Junky, your weapons aren't just for shooting\u2014they\u2019re your ticket to tactical mobility. Use rocket jumps to leap over hazardous landscapes and dodge incoming fire. Stay on the move or risk becoming an easy target. Master movement to survive and outmaneuver.\n\n# Explosive Arsenal\nChoose your ultimate combo with a variety of explosive projectile options:\n\n* **RED Launcher:** Balanced power and speed, great for versatile tactics.\n* **GREEN Launcher:** High rate of fire but lower impact\u2014perfect for relentless pressure.\n* **BLUE Launcher:** Time your blasts for strategic detonations with this rapid-fire choice.\n* **ORANGE Launcher:** Maximize damage with remote control for precision.\n* **PURPLE Launcher:** Close-range domination with high-damage proximity detonations.\n\n\n# Destructible Environments\nNo cover is safe. Every structure and obstacle can be leveled, letting you reshape the battlefield and smoke out hiding foes. Create crumbling chaos with each blast as you carve your path to victory in fully destructible arenas.", "short_description": "GRENADE JUNKY: The Ultimate VR Boomer Shooter with Explosive Combat and Destructible Arenas!\n\nDive into the intense, action-packed world of Grenade Junky\u2014a fast-paced VR boomer shooter platformer designed for adrenaline junkies. With immersive multiplayer and solo modes, prepare for chaotic combat, destructible environments, and nonstop explosions that will keep you on the tip of your toes. Gear up, jump in, and let the mayhem begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.verticalshift.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Corrupted Media Productions", "support_website_url": null, "website_url": "http://vertica
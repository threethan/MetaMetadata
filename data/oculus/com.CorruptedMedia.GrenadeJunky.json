&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VZPMCe7BDcQ7kNvwGz7qEd&_nc_oc=AdongiRaBCs7VvhS66wDBIjMwVrf5lIzQW-IX0s5evXFzJzboAHH2SqRPt9rgvxwP9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW759wGpVRZks8SnfcIccer1Z5Jf_bcu0CdH6QDAp5XA&oe=6B05D5D3"}, {"file_name": "S3.png", "id": "469347146140091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974568_469347149473424_4788019419558433794_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U4c-nyQt5QQ7kNvwFcvUz8&_nc_oc=AdqLUSnHVzIlPUrpbH8DpNKkY3x9uuOOGc7txRcseCbob_Kfmw6uPphaiZi8xflg0tc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlqYfipz-kUdvwkqROuvLfXiLRlJ7Zjf35oj3D7F3Dcg&oe=6B05A9C8"}, {"file_name": "S4.png", "id": "1589494074971302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982622_1589494081637968_8661073390467476111_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2Sj4wPJ-r4Q7kNvwFeZCXl&_nc_oc=Adp3YHktOfdCadXZ7frkFm77Xkm8u9CxbosN5zpx4dC_6fKmp0kxGYgi29UYhzbzaSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoXVlB7BluTRDS_5eLpF0RHQ04vDbwp1kfAN_Y1j4uKg&oe=6B05AF8B"}, {"file_name": "S1.png", "id": "1870256840148319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031524_1870256843481652_8504559206061228227_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTpCtIoQESoQ7kNvwFi2ZQP&_nc_oc=AdpQkBbo8Krt37DX_JhTrk43qJzkSGK_SG2pK_n7mbdEoho7fXbQDM2PVOyzxIwz6TQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_caqAi6IKkwx76T6v26IT-kuoBo0jSujJ-cxR8s3rFw&oe=6B05CB21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverArt.png", "id": "1069769008085981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974780_1069769011419314_856597801219685842_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BoFugg44GwQ7kNvwEE5dGU&_nc_oc=AdqZPdmDb2dKpm0WCLpaUP--M7CrzTbtfsW5R9nFGE51CKJyYoKGCp_3tqd2ethQYkA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwiA_US5yT9pkUCkjiUKNREMdAPnjpOG4XqYc7PU8hFw&oe=6B05D230"}, "display_name": "Grenade Junky", "keywords": ["rocket", "jump", "deathmatch", "multiplayer", "boomer"], "long_description": "# *Grenade Junky: Explosive VR Mayhem!*\n\n# 3v3 Team Deathmatch\nGrab your friends or team up with new allies in Grenade Junky's high-stakes 3v3 Team Deathmatch! Embrace the chaos as you clash with opponents in a VR battleground designed for intense, nonstop action. Test your reflexes and firepower as you aim to dominate, dodge, and destroy.\n\n# Rocket Jump Platforming\nIn Grenade Junky, your weapons aren't just for shooting\u2014they\u2019re your ticket to tactical mobility. Use rocket jumps to leap over hazardous landscapes and dodge incoming fire. Stay on the move or risk becoming an easy target. Master movement to survive and outmaneuver.\n\n# Explosive Arsenal\nChoose your ultimate combo with a variety of explosive projectile options:\n\n* **RED Launcher:** Balanced power and speed, great for versatile tactics.\n* **GREEN Launcher:** High rate of fire but lower impact\u2014perfect for relentless pressure.\n* **BLUE Launcher:** Time your blasts for strategic detonations with this rapid-fire choice.\n* **ORANGE Launcher:** Maximize damage with remote control for precision.\n* **PURPLE Launcher:** Close-range domination with high-damage proximity detonations.\n\n\n# Destructible Environments\nNo cover is safe. Every structure and obstacle can be leveled, letting you reshape the battlefield and smoke out hiding foes. Create crumbling chaos with each blast as you carve your path to victory in fully destructible arenas.", "short_description": "GRENADE JUNKY: The Ultimate VR Boomer Shooter with Explosive Combat and Destructible Arenas!\n\nDive into the intense, action-packed world of Grenade Junky\u2014a fast-paced VR boomer shooter platformer designed for adrenaline junkies. With immersive multiplayer and solo modes, prepare for chaotic combat, destructible environments, and nonstop explosions that will keep you on the tip of your toes. Gear up, jump in, and let the mayhem begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.verticalshift.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Corrupted Media Productions", "support_website_url": null, "website_url": "http://verticalshift.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9194264890605452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974826_552033477308761_5775719067340633651_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMBuieH5rtMQ7kNvwFBBhJp&_nc_oc=AdoEo6K3fAKTdOVrU7jVSyiFfhyyEO1lhSBzj1cAan0jIKTbxOl9kNBF5bqmOA20cSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIbzUwcZbQ647da9DcvaXeT9NLg7tPgQn-mDl2ktmAaw&oe=6B05B3E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Grenade Junky", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date
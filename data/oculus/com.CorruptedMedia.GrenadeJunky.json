t-sin11-2.oculuscdn.com/v/t64.5771-25/38974568_469347149473424_4788019419558433794_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2zaSOASF7cQ7kNvwH-IFhN&_nc_oc=AdoM7WK2sSKAM-xQ0sGpOBOqc2kyzmfYL10IcxEuwhuUBaOe6T8xFKlpJOQ1KVusNCI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgRgykEIovaMJONLx1L6Ig_tz3_aWxGCTWmghryohxIg&oe=6AA41AC8"}, {"file_name": "S4.png", "id": "1589494074971302", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982622_1589494081637968_8661073390467476111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne-Fg6x8oWoQ7kNvwFhsPc1&_nc_oc=AdpZrqCufP-5N13PhlnFmt7OQX-1iuiYzzks-hCus7ng6bG9FWWZoLGpMKvBxjYdpQA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVJQNMnRdeRkD-tJDaQZSMGs-2HCfcjDyAy_eoo1wlkQ&oe=6AA4208B"}, {"file_name": "S1.png", "id": "1870256840148319", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031524_1870256843481652_8504559206061228227_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nTx6C4zcH8Q7kNvwF0VzKm&_nc_oc=AdqmJSWXDnL816rIjRFz2iGwKg9SzOA5HpW5y-OzlRf9uEwlFYlz36Xk0DKqMMyjhtw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgW6f9SDi15_zJme5ImMvsQ0j6N-8wwVaTOdfuUGxn9g&oe=6AA403E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverArt.png", "id": "1069769008085981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974780_1069769011419314_856597801219685842_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSC0uuNJ1TYQ7kNvwEGqiUl&_nc_oc=AdoRQh69xwULpAsW6M3ULvGCxO5ghki9ymE_4MzNwR5TxrpoRoIAsQ2VdJbvN5F-G80&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR0qTAYzUYtSJptiQ9oNvOa3Z9akAVtVNsSJM-XXq_hA&oe=6AA40AF0"}, "display_name": "Grenade Junky", "keywords": ["rocket", "jump", "deathmatch", "multiplayer", "boomer"], "long_description": "# *Grenade Junky: Explosive VR Mayhem!*\n\n# 3v3 Team Deathmatch\nGrab your friends or team up with new allies in Grenade Junky's high-stakes 3v3 Team Deathmatch! Embrace the chaos as you clash with opponents in a VR battleground designed for intense, nonstop action. Test your reflexes and firepower as you aim to dominate, dodge, and destroy.\n\n# Rocket Jump Platforming\nIn Grenade Junky, your weapons aren't just for shooting\u2014they\u2019re your ticket to tactical mobility. Use rocket jumps to leap over hazardous landscapes and dodge incoming fire. Stay on the move or risk becoming an easy target. Master movement to survive and outmaneuver.\n\n# Explosive Arsenal\nChoose your ultimate combo with a variety of explosive projectile options:\n\n* **RED Launcher:** Balanced power and speed, great for versatile tactics.\n* **GREEN Launcher:** High rate of fire but lower impact\u2014perfect for relentless pressure.\n* **BLUE Launcher:** Time your blasts for strategic detonations with this rapid-fire choice.\n* **ORANGE Launcher:** Maximize damage with remote control for precision.\n* **PURPLE Launcher:** Close-range domination with high-damage proximity detonations.\n\n\n# Destructible Environments\nNo cover is safe. Every structure and obstacle can be leveled, letting you reshape the battlefield and smoke out hiding foes. Create crumbling chaos with each blast as you carve your path to victory in fully destructible arenas.", "short_description": "GRENADE JUNKY: The Ultimate VR Boomer Shooter with Explosive Combat and Destructible Arenas!\n\nDive into the intense, action-packed world of Grenade Junky\u2014a fast-paced VR boomer shooter platformer designed for adrenaline junkies. With immersive multiplayer and solo modes, prepare for chaotic combat, destructible environments, and nonstop explosions that will keep you on the tip of your toes. Gear up, jump in, and let the mayhem begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.verticalshift.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Corrupted Media Productions", "support_website_url": null, "website_url": "
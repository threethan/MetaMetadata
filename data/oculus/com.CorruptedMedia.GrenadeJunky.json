t-sin11-2.oculuscdn.com/v/t64.5771-25/38974568_469347149473424_4788019419558433794_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIfxHTXkoYYQ7kNvwGsoSGi&_nc_oc=AdqymWszBXkwgWMDE_KziP4A-lRmPKZVKVLyLf0z_jtdfk9XiL9vEJhMGZfvv0bLOQk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gKwKVi_ttw61jeI6RbEUd_-21O7uF1Q35SH103Likbg&oe=6A22E7C8"}, {"file_name": "S4.png", "id": "1589494074971302", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982622_1589494081637968_8661073390467476111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyHDCgzaFYoQ7kNvwEVf1-z&_nc_oc=AdojI13ZlmQuF5WSNYi4UHrFd60HbH9dfAyTOGkj3Wd2hLyDKkFqadtca3-otgwllPU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Trmg9Uoa6WuZ1ySwJUYef3m-augK0NUyDgahiK5rUQ&oe=6A22ED8B"}, {"file_name": "S1.png", "id": "1870256840148319", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031524_1870256843481652_8504559206061228227_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLqabsk78dgQ7kNvwE8Uzyn&_nc_oc=AdqKJHe0h6axPxpW3FZ3lJRxrdNsCOqmGYqykHJ6ARtHdGG0dvsQiCSb4aSCFMZQNaY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84BjEty-BZiJjkZy6qppXb1wii__P9j03y7SFvB-lRPg&oe=6A22D0E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverArt.png", "id": "1069769008085981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974780_1069769011419314_856597801219685842_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQzTnWKUi4YQ7kNvwERjWCc&_nc_oc=AdrC33Jin-U8byZoUv_5rNZjTnqXUyRaLIkOO4WZYtq-OPqiFOPGi8yFHZyuZevd3I8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_17AWnIX8EDdNh4CzxTrm9Sw11xbBQUnbkcIoXZ1PMUg&oe=6A22D7F0"}, "display_name": "Grenade Junky", "keywords": ["rocket", "jump", "deathmatch", "multiplayer", "boomer"], "long_description": "# *Grenade Junky: Explosive VR Mayhem!*\n\n# 3v3 Team Deathmatch\nGrab your friends or team up with new allies in Grenade Junky's high-stakes 3v3 Team Deathmatch! Embrace the chaos as you clash with opponents in a VR battleground designed for intense, nonstop action. Test your reflexes and firepower as you aim to dominate, dodge, and destroy.\n\n# Rocket Jump Platforming\nIn Grenade Junky, your weapons aren't just for shooting\u2014they\u2019re your ticket to tactical mobility. Use rocket jumps to leap over hazardous landscapes and dodge incoming fire. Stay on the move or risk becoming an easy target. Master movement to survive and outmaneuver.\n\n# Explosive Arsenal\nChoose your ultimate combo with a variety of explosive projectile options:\n\n* **RED Launcher:** Balanced power and speed, great for versatile tactics.\n* **GREEN Launcher:** High rate of fire but lower impact\u2014perfect for relentless pressure.\n* **BLUE Launcher:** Time your blasts for strategic detonations with this rapid-fire choice.\n* **ORANGE Launcher:** Maximize damage with remote control for precision.\n* **PURPLE Launcher:** Close-range domination with high-damage proximity detonations.\n\n\n# Destructible Environments\nNo cover is safe. Every structure and obstacle can be leveled, letting you reshape the battlefield and smoke out hiding foes. Create crumbling chaos with each blast as you carve your path to victory in fully destructible arenas.", "short_description": "GRENADE JUNKY: The Ultimate VR Boomer Shooter with Explosive Combat and Destructible Arenas!\n\nDive into the intense, action-packed world of Grenade Junky\u2014a fast-paced VR boomer shooter platformer designed for adrenaline junkies. With immersive multiplayer and solo modes, prepare for chaotic combat, destructible environments, and nonstop explosions that will keep you on the tip of your toes. Gear up, jump in, and let the mayhem begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.verticalshift.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Corrupted Media Productions", "support_website_url": null, "website_url": "
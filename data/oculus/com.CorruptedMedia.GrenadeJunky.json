gb9kePNGohyoMrhqMjlPAvUBjez8ewd5SFaJ96armrjz0OkSFsvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftTKtf1SyiJvXOuBnerGhsGsVPPoog6q8cDb_OFuuua1Q&oe=699ED988"}, {"file_name": "S4.png", "id": "1589494074971302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982622_1589494081637968_8661073390467476111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgarUFQfDY4Q7kNvwFy9uBf&_nc_oc=AdkYjGbaclLMuKu_gRn9MvlDT1osBBJIhIt4O3q8c_b-ArQH_OSdor0DcFBJJ6RVlHE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv4r1Dbkwo4Zn-UU1j9cDIpoKGfk5xJyMHbTdepG_XOHQ&oe=699EDF4B"}, {"file_name": "S1.png", "id": "1870256840148319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031524_1870256843481652_8504559206061228227_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-N365FskP0Q7kNvwHYoW54&_nc_oc=AdlK4Z5Zx2J2pSSMx-MJS3BWjzeek75rQiPghy0AMtXZ0Y0scf4rGCyT9YwVrk3_FqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft1s2eoeOiDzYoikBG3QbcWeRYivkzf0ssX8OE81jC7IA&oe=699EFAE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverArt.png", "id": "1069769008085981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974780_1069769011419314_856597801219685842_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uytmyiK40gQQ7kNvwEoYSsF&_nc_oc=AdkPWMIE9gZXsCJ0swfuDZd00pP8g0Nda4EOOECj_GGaqMA1frquCQw3XNo4LmCnPmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs1Kslyzm-NIPNY0VRItm0Qx7Kpcpq_oztldAez09hTPw&oe=699F01F0"}, "display_name": "Grenade Junky", "keywords": ["rocket", "jump", "deathmatch", "multiplayer", "boomer"], "long_description": "# *Grenade Junky: Explosive VR Mayhem!*\n\n# 3v3 Team Deathmatch\nGrab your friends or team up with new allies in Grenade Junky's high-stakes 3v3 Team Deathmatch! Embrace the chaos as you clash with opponents in a VR battleground designed for intense, nonstop action. Test your reflexes and firepower as you aim to dominate, dodge, and destroy.\n\n# Rocket Jump Platforming\nIn Grenade Junky, your weapons aren't just for shooting\u2014they\u2019re your ticket to tactical mobility. Use rocket jumps to leap over hazardous landscapes and dodge incoming fire. Stay on the move or risk becoming an easy target. Master movement to survive and outmaneuver.\n\n# Explosive Arsenal\nChoose your ultimate combo with a variety of explosive projectile options:\n\n* **RED Launcher:** Balanced power and speed, great for versatile tactics.\n* **GREEN Launcher:** High rate of fire but lower impact\u2014perfect for relentless pressure.\n* **BLUE Launcher:** Time your blasts for strategic detonations with this rapid-fire choice.\n* **ORANGE Launcher:** Maximize damage with remote control for precision.\n* **PURPLE Launcher:** Close-range domination with high-damage proximity detonations.\n\n\n# Destructible Environments\nNo cover is safe. Every structure and obstacle can be leveled, letting you reshape the battlefield and smoke out hiding foes. Create crumbling chaos with each blast as you carve your path to victory in fully destructible arenas.", "short_description": "GRENADE JUNKY: The Ultimate VR Boomer Shooter with Explosive Combat and Destructible Arenas!\n\nDive into the intense, action-packed world of Grenade Junky\u2014a fast-paced VR boomer shooter platformer designed for adrenaline junkies. With immersive multiplayer and solo modes, prepare for chaotic combat, destructible environments, and nonstop explosions that will keep you on the tip of your toes. Gear up, jump in, and let the mayhem begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.verticalshift.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Corrupted Media Productions", "support_website_url": null, "website_url": "http://verticalshift.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id"
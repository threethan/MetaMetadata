4_4788019419558433794_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eq1_4WQMBkQ7kNvwEAKhoL&_nc_oc=Adp834k9gbi8AR26uHCulFxHjonRtvsiVz17o8YYgsLfyORQwbr-rti5jtr9H9FkBXg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzIuVf_f_6EWVQE74UfQaJNmdYs1yBsQJprZ4LrPsJ9Yw&oe=69C12088"}, {"file_name": "S4.png", "id": "1589494074971302", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982622_1589494081637968_8661073390467476111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNAtol0WmIAQ7kNvwGoltMM&_nc_oc=AdrnpDFjhAsredrOF1RH2DCHw7VwspShj7orbPdG2rUxGIhaSXpJ4Ypby-UeckqxqvQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-7sZ66WosWwMfN-FaHUwi_Ksu-Wpbe8dnzSudTdwNHQ&oe=69C1264B"}, {"file_name": "S1.png", "id": "1870256840148319", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031524_1870256843481652_8504559206061228227_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGb26JE144EQ7kNvwEpEQCc&_nc_oc=AdqqekPXHV0gTmLtL7tDr2eRzIbk3od9-Spi_ymA16HbVwtT41jr917FKzEvENmN8wo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6eaSkDQRvmHMHZ4zhhMuWc_vCUtOVEXkYTA2RPpVWZQ&oe=69C141E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverArt.png", "id": "1069769008085981", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974780_1069769011419314_856597801219685842_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IjVHHlWNKMQ7kNvwGlYm4m&_nc_oc=AdqSriLvmAg7y-HlTHrpYU0ynJ9LxxIL-UgzRfEFCmznQyZPDeSpPCjZnbNd8alZJ9g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuXtrL31ZqFEXu72m8CwzWKvuO8Rmfn73cTrpmL3Wikw&oe=69C148F0"}, "display_name": "Grenade Junky", "keywords": ["rocket", "jump", "deathmatch", "multiplayer", "boomer"], "long_description": "# *Grenade Junky: Explosive VR Mayhem!*\n\n# 3v3 Team Deathmatch\nGrab your friends or team up with new allies in Grenade Junky's high-stakes 3v3 Team Deathmatch! Embrace the chaos as you clash with opponents in a VR battleground designed for intense, nonstop action. Test your reflexes and firepower as you aim to dominate, dodge, and destroy.\n\n# Rocket Jump Platforming\nIn Grenade Junky, your weapons aren't just for shooting\u2014they\u2019re your ticket to tactical mobility. Use rocket jumps to leap over hazardous landscapes and dodge incoming fire. Stay on the move or risk becoming an easy target. Master movement to survive and outmaneuver.\n\n# Explosive Arsenal\nChoose your ultimate combo with a variety of explosive projectile options:\n\n* **RED Launcher:** Balanced power and speed, great for versatile tactics.\n* **GREEN Launcher:** High rate of fire but lower impact\u2014perfect for relentless pressure.\n* **BLUE Launcher:** Time your blasts for strategic detonations with this rapid-fire choice.\n* **ORANGE Launcher:** Maximize damage with remote control for precision.\n* **PURPLE Launcher:** Close-range domination with high-damage proximity detonations.\n\n\n# Destructible Environments\nNo cover is safe. Every structure and obstacle can be leveled, letting you reshape the battlefield and smoke out hiding foes. Create crumbling chaos with each blast as you carve your path to victory in fully destructible arenas.", "short_description": "GRENADE JUNKY: The Ultimate VR Boomer Shooter with Explosive Combat and Destructible Arenas!\n\nDive into the intense, action-packed world of Grenade Junky\u2014a fast-paced VR boomer shooter platformer designed for adrenaline junkies. With immersive multiplayer and solo modes, prepare for chaotic combat, destructible environments, and nonstop explosions that will keep you on the tip of your toes. Gear up, jump in, and let the mayhem begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.verticalshift.net/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Corrupted Media Productions", "support_website_url": null, "website_url": "http://verticalshift.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_F
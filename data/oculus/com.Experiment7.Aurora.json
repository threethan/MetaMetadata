 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdCE9YaG3wcQ7kNvwF7ZlJL&_nc_oc=AdrWT8nL9RYzhwEr_1TcEl4cIbFC1IERjGEu4GGNhw31q_8QWoiCphZ4Os1gyTTTOp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNFsyT1dSpaqdtDGbwuwpzxeoFEyjnt0jf-KRbXBfj2g&oe=6ABA5DC5"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quWbZ2njp8AQ7kNvwEPQ-54&_nc_oc=AdrHzxz2cNo0AHBnpr9Pfxekz87JFOFsXuRIQ1pYMOkZ3FAVAlbhT8RE87VsbUpC9Go&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsT6dWN_fKCCEaq4bJEVyq63HqpvZBHuN9cQbQTgWVXw&oe=6ABA8357"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CshiHt8K_vcQ7kNvwE-7ZP9&_nc_oc=AdoM89HKud2b6AEOKx7R_JHeahyv--uC7R6pAZiF7FTULcQdfJuVvZCyokGJ6-hHjw0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWvYyi6MYxtoIWvcWEKtv09UXK-TFJ2OukRYZVUIPeqg&oe=6ABA8EF1"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnxjPQsQlYIQ7kNvwFSPlAv&_nc_oc=AdoND8x8o2evM2BsKUi1BdQr7m2teBhRQwlQAqx_WyAza4q3fa4d-G2L6yTjPCQdYcs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXmHyUtlIK3U5pRqtYheOlx2-aDslO0BzET2l4_p3qIg&oe=6ABA8CBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6Lugn-yYYMQ7kNvwFYm2Iy&_nc_oc=AdresONKtY1GJdrsd0LCltJCTuKYoUkTwuFb6HxKsk8nysMemlDKrETS0lz3izSaXMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9D-uQICuZ0fH-SIGcgKsoAcYS6G5kJbdk75Ks-xcqgA&oe=6ABA8BBC"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
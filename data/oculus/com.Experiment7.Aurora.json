 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPbm5KFi5FAQ7kNvwGOeNah&_nc_oc=Ado1b3n7Mz2l1jUmuBQ4nEtMHakMdexfFjLi0VZPrERJ2DZhuIueRycXpU2PTHr1DUA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KMGHaDVJNMHZvk9_67Fln-ofcUS83JSw1FRIZaVPhmw&oe=6A21A805"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DfzAp0mMkkQ7kNvwGkqt3a&_nc_oc=AdoWJURtbpOx63qYX1uXQqRDcZOtwcm2g9qVzvxUWNVy8neRzxjdfHfDTn27flDTaaI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3cZvhVSpXcVmRX2asG4_OLy5fHbWwF38sW0bSGEAnHw&oe=6A219557"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zhSxZuUA8QQ7kNvwGkUUNd&_nc_oc=AdoHiHuZRTvWOQU8zBNIkx4FLOaDqQLDJijr7oVesMFAHE7krdSx7O6uCa-szygBm-Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-700eYn0d1kH1roym6KWWG2qt9hyl6jw42bYkexCF1Zg&oe=6A21A0F1"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXcdDkYpdWIQ7kNvwHOjmPK&_nc_oc=AdpTl0LCDUFm4j4rNoVDU5TV6Lh-fxtd3VSroOOBvRqWugXuO73nm_eB2j1Lpw2wrOM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qnr06BtJXxq781PJ_ylhDZbPNeRKlSs2X7jFQQN740A&oe=6A219EBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GTpjuWVnK4Q7kNvwG0oDEN&_nc_oc=Adr4l0N5sapWQnIeMUhjzzO_zHeHm8QxGbtl2iw13_dJEK3RARt0hphlpDfjDCwIfgg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zWVabVn4ZsSQlvsM6RvxKZJeBhJrzOvQer4psUQxUPw&oe=6A219DBC"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
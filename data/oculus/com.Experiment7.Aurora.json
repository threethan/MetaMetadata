1-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkZo2bgvRi8Q7kNvwFATclg&_nc_oc=Adku9zyzpe-RUmOWqVlmoct3rxRzGOkZxj7tsb_RP2cMuRsEaBrg-8cEHJ40YieORh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu9y9GSfbrZfyZs4nQ_NcuLekddFd3tNr19G51NWXWCUw&oe=699AF6C5"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13SWhn9Mw9EQ7kNvwHQCUeV&_nc_oc=Adn5IIqN1pIM6dv5YMW1pYIWYuB2D7ab5apwL5-MhbwCJ89WZclf4FykwkM9gF20_-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftpt_svA3don7oWZNPc7XZlOJg2YW9Zd3uK0Dr66vylKw&oe=699AE417"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBAz0zazmOkQ7kNvwExbJk5&_nc_oc=AdlPd-4tlANCkNnOFzYrYFU1CzPsb1budePiFMTVwsOUm_6uB8d0pkkHq5rXHr-ltjU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfulG0dQVG4YYXddhoS2sS0eyAs0GQRxIvJYEOrYJziE3A&oe=699AEFB1"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFo4ebhpC3cQ7kNvwFBJQOu&_nc_oc=Admn8rqZ_wHQEiaXKZPBNQRETShy-8BsMK2EnpbkqNlZ8TWcwcutXnOob5XrKGd037Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv1HBtfAGlhCt1RhF9LJbpt7fTeV-b9T0EVjPOyhF7xtQ&oe=699AED7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbYR-AYfBYEQ7kNvwGy5Ivp&_nc_oc=Adn4XVOw0cYR9IdTFQjzg_F15rPXliy3NZWsP3IgxOwWLMpaP-aukU79UMpKQRlN_tE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsct9nYZL78SimXSJ_AhiM3Hl5vCrXllF4vRHvFBCH3-A&oe=699AEC7C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
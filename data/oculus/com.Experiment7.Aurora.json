file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DfzAp0mMkkQ7kNvwEpcG9A&_nc_oc=Adp0U-Z7a1MBQFipFZ3jSo0gMxKLnYYmEgM6kEgKzyhwhd1lIc7kX7GeZF4hwjS1nSo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AKJnMiJ5bdBPSFisLrNWJZ-1a0yFLAqg82Lrg564SCQ&oe=6A22E6D7"}, {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPbm5KFi5FAQ7kNvwGgbCHJ&_nc_oc=AdoGbmVhUeh-XD83XS0P40UQzRN0OKGx19ka1-ujTSiLBtGvmxi-ORCsZxxcZspzcAo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GatpSrS1sJ8iLVcYsxz4CFNLURrJVrD5i75NJgOHTKA&oe=6A22F985"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXcdDkYpdWIQ7kNvwGmjWP4&_nc_oc=AdrRtmy6QkuVLyU3maXa-0LKVXikseqteT_T36BH7gebLdJD02w-Lm2GRTT6Fa5qEkg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HWiP71IQD9lrqu-VwrrPw4lC_A0hKobm24plQACqeWQ&oe=6A22F03D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GTpjuWVnK4Q7kNvwHoFVOb&_nc_oc=Adr2pT4i0BETAZ6PxSkpxH42SntiRvNoOYj89fEqZqdaBOfXDto6l0IL4-hG0mRrReU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XIIOVU3-lwHXmlE4W0nas6d-AUWa12sVFiA98k1f8qQ&oe=6A22EF3C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes
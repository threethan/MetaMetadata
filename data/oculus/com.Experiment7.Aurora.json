 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFXdj3Jf9jgQ7kNvwFIUWC2&_nc_oc=Adp9WopglZi_1sjs4KDmI08lN3NNWlyz_JLen5L6IQhhicaz8YQplyxfkIg3rUEzpRA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk8Fqwh3-nd0zoxqX2sAx4Z-TCb1DUQW2_GR-BU1S6iA&oe=6AD0FF85"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYSU4EDmwLAQ7kNvwHod1e9&_nc_oc=Adost-s1tVc2dYiMRXmsv3at6_q0bw9Ov_dmXtJaL4mYOcuuGxgeeCmenwtPdP17fTs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxgpWCj0dB09BXh4C7mJGrwwsg0FS7LL68S7nxrEH4eQ&oe=6AD0ECD7"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEsQJYliue8Q7kNvwELE10r&_nc_oc=Adq6ayXrkZh6U2_VEhUslXsHnHGtrxJQGXQIF_2dIHM_p2JpKuMBM-4RlL5Su-iF5Cs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtJlbuuxtVCx5d0h92i5rY-CXhRZDnr-4Qz0MnDcmMxg&oe=6AD0F871"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raqQ3G9bcB0Q7kNvwHnap0U&_nc_oc=AdpQCzAhzJ-ZX2OX6vy_Ikl6ENTuM18tTWwpIOSKCSopb3BDfSMhvuUUnyD87jvscEk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEmUrvq8XxHiEk4RxCPz2ZibHa5KeVLDxha1HEbiyVRA&oe=6AD0F63D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiihWNM4yAEQ7kNvwELXvPm&_nc_oc=AdprfmxA_DdjojAGFjc32nU2vRlnU4ceHaFy_vcZtExS-8aIvpvVboA4QuCRz_ZvtXE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0mOF549UTU8prIswapELVJ9BuLM4eUrW6CTyPzE1_rw&oe=6AD0F53C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
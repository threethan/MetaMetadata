1-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMq1I22EvPEQ7kNvwGsE-qN&_nc_oc=Adm3ZfReiRwAXraytAQjjGhK9y8MYDGzyrvM6r3DuUT3mAtJZ6qa0oc3tiTOEsuSHhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftn2j5JS37FmkrriO0mZZgmaehlYaa2kBbdHAQOe0JhOg&oe=69A2DFC5"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gjOS-5zsrcQ7kNvwFIVJK2&_nc_oc=AdmpbbJGZDD5dHDvWXB7Bt2uXWeYbkrDvgQkl8kLViApA5ZwReeDDgBUU2EAssB7dyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszarRGLALEEWHb8pDodtkFIFvDthHr7twcFop1Ml4ZAQ&oe=69A2CD17"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjRXYnHTaiMQ7kNvwH7L3Bf&_nc_oc=Adlar1PMq-xBx5JeoZziKVs69visUapC9tM9A0HzxSnaNqbbjsuMx4RQeQtSpT9EA0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBLs3kzAMXpIr-FWsusphA8uikPndPwzK_Ga-bqPlMrg&oe=69A2D8B1"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6RJfs16n6MQ7kNvwG5DsJK&_nc_oc=AdkO0nFWfnrOJTKquBXqYP3NKcYASUh8jn3tb7eDNUAg8MzdgQZlVcT1gKeqxz2Tp0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv61OucfPijOUResTB1uMIvBhLdQZ46eNibZfkNItyVVQ&oe=69A2D67D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvyu10evpp0Q7kNvwFwf7fy&_nc_oc=AdkyGqxaO2e47e5LoeugteJd0jE69GHbOofOVGiD7Hjtml1gB3f1bWALWlMtxHr7za4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmaUip-dXCffxb3c-tQXlWhWo2QfX5PMllDd3Pf3YgiQ&oe=69A2D57C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
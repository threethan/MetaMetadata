 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8qUgKtsMgMQ7kNvwGNr6Ig&_nc_oc=Adpuj0mLQkkKmHknmnqznBJLkjGxU6X9EZzajns1fIxt6i9TQo0e3tGm6qNsQJhFiJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMmfJ5XbtaDkXPTMwi-HRORTjSDzuC9V91Jg8IvRK9Jw&oe=69C283C5"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAoZewAYB2gQ7kNvwFBlqGf&_nc_oc=AdrII8g08sLOZNi_bxg7pJhTBuDXyIDoh5ylemWp-9-pBzN4HIuUC88ZpcKildWZJU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afym8f5h1JCqA-DsXgXX_IOCo-oL0_EIt6otvV_O075_cQ&oe=69C27117"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueottl1MWdwQ7kNvwHUTkUM&_nc_oc=Adp0UDhWyDkJrDh82sWd5xBQamCbMe_BorysUfafYct9TzTyDXzhL0db3wMWOadB3ds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-SqdizJoZndaYnLK64XR-Bf-qmGCnh7oPO939wy7VXw&oe=69C27CB1"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dL9XPfccUVYQ7kNvwHgxeYh&_nc_oc=AdoEdo5W11Ay2MLF_RVp66MHtnLw0HQ6vidosQ5W44P-E1PANv0xtUitzn3ergCVpmY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQMDjzXQ5huP3toI_5CeXjQk6AyNzck3UFtdHuTwL2Lg&oe=69C27A7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYUSkJ-38NcQ7kNvwGrXXaZ&_nc_oc=AdqdqzYR4edR9TvSZ3RUo6F656GQ4JJSFtTL2QHlvSPgCCrOVeBVhLBcOC40hWWMLwQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwG-b4kL0DlBBwUgRsbztnK4bUluxz6IYid1V9XbVcTJg&oe=69C2797C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
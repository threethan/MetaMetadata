 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-HtHdAtiRwQ7kNvwH6r3kG&_nc_oc=AdokrZtIKq9_nf285AQ10-RjLc2KCYROdfnihWYAyg5LcJb5KH1-8Oq2udDtTK00VTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUq58d-BCYLl3qapgUeGjR12hfEJuhuLNjyTECQHJlBA&oe=6ACE5C85"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i0iVA0KrVUQ7kNvwHCM_jn&_nc_oc=Ado7fPxTQy-MHjLDRpqEBhRr9-AWcTqHn-UFPezNliDWiDtKb0DYMg8ND1av9GSXaTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN8tOC1k1H_-LG5vyVUehX3W8OEp3q-v-6HPySbVR1AA&oe=6ACE49D7"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZqOiILjnu4Q7kNvwHKsJha&_nc_oc=Adp5WUwsk2oejE00vTaPeeal7CFlS2TTGgad043hUHVD8z60vb3U3wmULtEVM2t0js4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCFR_cmbaAlvjrkhio8hYEGCeBukUvL7K4ehe96_X-8Q&oe=6ACE5571"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raqQ3G9bcB0Q7kNvwHyeCmE&_nc_oc=AdrN3urrMtpS6AFjU-u9LIjLRX4oE8bC9e47_0QoqprO-8i4Gg8wzcXOkmKrEVnXMqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrMtyPezfynTc1SWQ3n35MrXSvmgYInXGla7UfBSyIbw&oe=6ACE533D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiihWNM4yAEQ7kNvwEzE5r6&_nc_oc=AdqhQ06YoH2VHrSNLcmQGIvvQwcLZArueV5G-L5B0-2CVj_iDFgt1wP4xizzw9KtIsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOSL2abtSd4usJlPs6BtN_vHf94oqsFvxTJGM6qFiPeg&oe=6ACE523C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
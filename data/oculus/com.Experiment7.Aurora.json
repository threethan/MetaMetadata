 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIVLj6Rmi_YQ7kNvwHepaG1&_nc_oc=AdrCtlqzV2XTuoyeOlciMkVgtYQBM6nfjK61dl6KEAh30p01F-7BbWwViYUI46WxTJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8rw3PcyVFluAHoTvcphvh7GQ0Lh-8Dt_BKNNnPCI69g&oe=6A4CF145"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n25ddquzmikQ7kNvwGQquZC&_nc_oc=Adr8W0b2H2dzIE1eqiAX0lIpO3GkWM_cCvuM0IGS_8g8H7X554bzSv0HbhWGvEn5gtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi3qBJWuKJ8aaDvJaqrfYdDbQuLhMTugq3E9a47zruUQ&oe=6A4D16D7"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kd1KdVpGLG0Q7kNvwEJIFe0&_nc_oc=AdpgP0iLGCWryhSfpzIkApyDrREleOnf_F5LSLHTPj7LRfKOnbsScUOlUH7Di8SWksw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhvPNbHjcgxEqkcgt_vIXT1Ggz9MAhAh0jusLkM7Bcig&oe=6A4CEA31"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJ7TUwrfOAQQ7kNvwFypMkR&_nc_oc=AdpchSbT8XwFJDIwqyruYnr66cDZgHnXaOY7Q-bRuHJiA0CA5LKEyva3DpYZTJmkNMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqY_I78Rzz6H9ceJDzOl2V74cGxxlgZUEEPRatkzBXWQ&oe=6A4D203D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRSBpm9TGGgQ7kNvwFvxhYE&_nc_oc=AdpvjZyeZDQlTNuOJ0zljz9UwfwGKMKW46Y_DEPqgyw7wLGo5tVxW9SWnZfVU4Wbtnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhmPWiaxDtCCNKViHkCOwL1wUnCiLXzxbpFjnXDsCKYw&oe=6A4D1F3C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
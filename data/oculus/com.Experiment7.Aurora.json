 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-5i-sUitcIQ7kNvwEalai8&_nc_oc=AdqYYHJ5D4aod6VZjiRytWsTVwBE0lMF2Ctv2sjjXc5uWZ-jv4wJl1Sd_mXp6BCtZiY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSioJMiEJ7eNQ78OMWNmr5vRWFkesqh5KNuTECQk-1Uw&oe=6AE8BA85"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVWEmiej4gAQ7kNvwGBB2D7&_nc_oc=AdpeJrp4u0ZiRn-0kB9oxElLq1Eujs9HdMMAbBKLOaENR8y7hshnj6JCg0moGQB6sr4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-TAE0BG3JAgfTXwYJU2JzAqUcCHPo_x3TsB8hKBkwTw&oe=6AE8A7D7"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKCgniqxhFwQ7kNvwGFGq_R&_nc_oc=AdoWkwOreUkQHb-xrcp4P3-FzohGfiqjA88uX37H6TmQ2t31XTCrOo1pOhqy7ot_ZKo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBYFb8rcgquXmoRDfXdqHXG7PeGU6ur9QTFUUqkJYAVQ&oe=6AE8B371"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNVHJwN22k0Q7kNvwEWISJd&_nc_oc=Adr_24cc_zSjN84nX6oLB888i3BzeLLGK5rjWYRv_nYbcfYJHFhZLlza5cQdxEo4uIM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlKi1NVPetXWWe95FfkvpHarz8bBHXpb_G22_UCUiD4w&oe=6AE8B13D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMJ7wE-UMl8Q7kNvwEk9jRF&_nc_oc=Adok-nuDJ14cAPaV-PXZ-pd7NQrx-MHV8FyQm8YqARLeSSFdv8FoF7x3UCWZK9PQjBc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThXtW-DgNosR1mzLEhG7Atyjl5P5OUyiYRW_roh7osmQ&oe=6AE8B03C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
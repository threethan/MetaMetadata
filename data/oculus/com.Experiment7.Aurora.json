82080329442913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMS-cskqzpoQ7kNvwGK5T7Q&_nc_oc=Adl7swGVGUzZV0Y4KvSi18smX1auW1lWKytPkDbQCTZPSPA4RjaRZZu61mDJjwCQjwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzYIq1Vz9Wgj9F8XwTKsX1N1_RDfZIrRS3MwwNLQvbbQ&oe=69B16045"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh_ISqJIv_sQ7kNvwEHirEX&_nc_oc=Admv1wW6L3mVtI4NHLYybhozrUIsVatO3oELjCR81cIJ1y_FfsS161SnmfsNYZ2QsFI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_Q58OtJOLZZD9Y8fqJNeVpbr2Dz2bXMiaHbqlF5IY_A&oe=69B14D97"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7EXYLwbu5MQ7kNvwGrrEkk&_nc_oc=AdlVMNkNQbdJ0sRRSvqgVDtIQG_j044XUCNh7QQd8Up90i1qgZo_O5Q2cZcTFt-KFWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHcoiCpW1ZQnPqv0gVAdmlcpzFC_xZoYqvWqU8z3x02w&oe=69B15931"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibd7dBEuBf4Q7kNvwFBK2yx&_nc_oc=Adl-pKnU1TBkmihflqEG-fa3CUwvUYk65WOOk8IcslxCBzBf4o7iEbQCT8As-bOc4Z4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMjAugkV7owFCTuEhSKWnFtp-uSyaEdwWLwJdyfNP6qw&oe=69B156FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=620Ub013xDgQ7kNvwFUudmd&_nc_oc=AdlPOo9Rnz0NmGKoN8YJusrznEfuYpirl9G89XGYuj7OVcL0_jveZ_lAAHgobgWU0AA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRY5M5HBiiGAZGsXAlXJ3JxjROfUufDqdbsujhmH5OCQ&oe=69B155FC"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQU
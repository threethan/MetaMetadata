D"}, {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iO-5bN1vXEUQ7kNvwFTkLPp&_nc_oc=AdosLIW0kNuVGfmNLVjAMzqbwjgIuOpSo-ujdTeNpDMNl3zK354-TZjilItAC9sttHI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeOi9YiZn8eqjchraSOhGiR9ZoYc6K0cdWj2E2Tt0zWQ&oe=6A7DB8C5"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r58k1IiEffsQ7kNvwH5jV1s&_nc_oc=AdrgAftc26RomjF-FUCwm_OQnJLJF-vYWWUlp771jjoIAF7TudTSu93qHmn438oGDvQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcc8AuAagXma1ag_bh0z3iAty5sy0NUDEU7cSosTYlXw&oe=6A7DA617"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32gUlSmct0QQ7kNvwHwGteh&_nc_oc=Adr19jd8Lh7ZyZQP2OyzpENaH-i6raRDzE2_qWWFXmOx_Ib7h0c-sahg-ZouH_tgch4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6c0R590RPbke2uyLX8WFA82uyi2K5kormAllTNTsTzA&oe=6A7DB1B1"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPG-j93pt9AQ7kNvwH5hASr&_nc_oc=AdpjzIcSpBs8oaXSFgKbIoTVGoNT7JhPnQZsdaPZab5JJZsC-ley6hE7OJIqwUyNUEg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsrpK_F3IKXuB55abINEwpuGTHDZ6dQp8UX79yd5cx8A&oe=6A7DAF7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=henSlS_3xpcQ7kNvwHUThqH&_nc_oc=AdpPZMEYTOzC5z-iJcQx_sLQu21X8ona2cRljV6knJmTEeI7p0I3XKGFOZccDaR6B48&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBC_FkUCJasNRXI4j4tWcvKLKj9pagUsXopp0OJ_eKJg&oe=6A7DAE7C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16
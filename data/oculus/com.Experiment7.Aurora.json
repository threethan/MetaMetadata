 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCJtfWPCjswQ7kNvwHKxJI9&_nc_oc=AdrG8iiTBCOcQyw3eEa-1QdSqVv54XtBpVT-gPFrUBH0IKnZc5CZzg6nhWBycHEqJ68&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPs1Q_70fZmLg5Uwm5abDNdBvFz_7MMxy12A7RIFcaiQ&oe=6A58CEC5"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txS8fazU35wQ7kNvwE8lemp&_nc_oc=AdqiHO2vcOTgbWwKzUHpRtuwpglq0OyiXGaJB3aSTyWFfSMDzOxWVgnIYew5YioiStk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzg8RO7-qyn41uuIpNBBEtyXhN6mLkl1UO134anrY0oA&oe=6A58F457"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiiEN2MlyuQQ7kNvwGSAYiq&_nc_oc=Adp_e4l8a2_bXVsHzSoDZn06usVIHP17Rs5QnXlHxgVUyXAVbFweP7ZRrsvesBJCRhA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_541Fj5xIkdBr13KkMYUYW5YSyLHvTgMte6WWsOp2Ww&oe=6A58C7B1"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JJ0L9YrQ2cQ7kNvwFpJOHl&_nc_oc=AdqsofWMHRBmJdjE9uUf-8Blr6L284R-wmWYqMS9kEUmO5avf8C5TKnCAQX9hOoasZA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMtx6PyECUpqvbHk1ZbK0decROGn8Gi0KiMA2dQ0jo6w&oe=6A58C57D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCTwJlkHjOsQ7kNvwGdAN3Q&_nc_oc=Adod-Vcfnywy88OQz8x8HRyaW9tuMsXYQOlwvQ3GEXGaBgbur3CX3hSreOFiTyi2QKc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP0gx2pLPXFoDFtTK2Zix07upTvUpQAnEtwYq0NBVx0w&oe=6A58C47C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
: "4.png", "id": "621141241914338", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqOmas9kp8sQ7kNvwHeudJ4&_nc_oc=AdrosD3F4cSzioFRb1tKKKZ1SdtLj_irhjAuJ7dPQhm8U62FI2JwzQffqbp9Uk6GmWA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0palYnda5NG5ykgot5HW2PKBnYMYG19rSNJDfsouIvhQ&oe=69F613D7"}, {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIBEgTm-T0cQ7kNvwGAKPQz&_nc_oc=Adq23cfz6IHYBOUOt_MKcpPnhhdeZ1BA8SfFhF3x8_EHvGj8nHEvPOUudTWGuNAsCUA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30-bi9IOvMjPaWI_my0Q-kivPspdWOMN4RZzfTjnELzQ&oe=69F5EE45"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QLB7qGPjxwQ7kNvwEClOvb&_nc_oc=AdpzJj9EH8yMdc3fPr0Ckt7e3DSat94UHEQeVVPVBVS_SQ3sOgrECXCii_mD8THT01A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MGITQN7huLxPr0B1Od2y6YVyn9gJvPk8bHZTkuaHmcw&oe=69F5E4FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r1KkN3w_-oQ7kNvwHFDLg5&_nc_oc=AdqXvvsm-6EryCC2t2bkxblh7UvUSGV65ffknwXy9EXRIHtjCdhHWmnkf9MWuKfky1o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1669jzREngL000FXaWWbpoxy-DX2_wPEivLsFDxm2oLw&oe=69F5E3FC"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user
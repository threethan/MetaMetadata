 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPhiSQfmoa0Q7kNvwGBRRfL&_nc_oc=AdqNDTZuOpYaT7IUc3PWWQAP8jPS6yF_vC2KWhrI4K14b__V2pHfJ8ieFege1PasAK8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30IBOAz9cXjjeSxYDezJ6g4LiFblkKmJw6PngaPKnJuQ&oe=69EF56C5"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Xa3IksC9uYQ7kNvwGlFplo&_nc_oc=AdpABnlq9hoJ4JY-PoLSTZtmDrkIqbWh5uDapolWy1Ee1ujvQuS-d7MDgx0wOW7oKJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IxXxaaxofZoBAaKRF8y_1CpIT1ZmBmYzkB9yp3qYzLQ&oe=69EF7C57"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvWzItdEfAUQ7kNvwEDTWRk&_nc_oc=AdpFK8vgjn2-Bnp6QVyPmVLDigiG-3l3_rjHhi7uEjut1LzpYrsXtwvc2S01kC5-Soo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VZ6GvFLFOe2SB5HHvH1FVvgjP_ioxLCIwhueDecdYyg&oe=69EF4FB1"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fehGbMUIRSoQ7kNvwEyt1I-&_nc_oc=AdqccP1rogHrVp6mMpryt-V4qwB0Al8z4v9n7n47hlL1Jm3NoBkCpb_MUoQIXURMstI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GZyMNexy7_AauJgV0A9d15eDn4LmL4kah1N4FCNcsLA&oe=69EF4D7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHXgT3DmdZQQ7kNvwHCkmo4&_nc_oc=AdohCRu2uxy5Wvbqp_FKoOMJ1kueaL8oU9WmyO30zoe9ZiqmOQHkFXfyZxG5cArOBiA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_1FSws7pNV6Z_psQni6cOguy2rVFAGBjNMfBlsgiiMA&oe=69EF4C7C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUiX0G3RwJEQ7kNvwGDkKe_&_nc_oc=AdrjMJBuZ1sC3F07oN6yZ7zRDjmEEtP8gKdGEvJEbnWT14SLnjh_hOWn6OJLJYVd_pk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hYkPcYRxN1UEk_MB3X1t_dk7x5_-dFwVHEAWqigQSrg&oe=6A356E85"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56mKIFsqAqEQ7kNvwGpvf6J&_nc_oc=AdogfizIkauflpE_dUP5bDMLWA65QfH8hGzs0LJg2TrICZ9XRBZt0MdQ6LIDGt8hB6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tWRyc_Cq-_N8viY30dKP9OEP8aM8YUPn_bP2ghYM4Cg&oe=6A355BD7"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5iJF8Vvp90Q7kNvwFXcTzN&_nc_oc=Adr362iQ549NaagQP_yINhknVqt51fZEG0-v1oq8i-uR58LlRvvJMVqAfg8Zc5XtKGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gh-4rFJGOuV2Yp3PaDAIPsbFTDTsWWQM9_l0VkjkRFw&oe=6A356771"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGCuH9AmeaYQ7kNvwHVa_aU&_nc_oc=AdrCoSNCCZKW_v-6yfc6g6CdeReEErDVm9GqjZXr6tgAr9i-JBTPQ_Lh1l-KhuI2SqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wd7bDAR2Vaszy5cmMAErFR-mR_CY3iDe6-Ogx1w5tMg&oe=6A35653D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQAF3EV7CrwQ7kNvwE-PKXF&_nc_oc=AdoQ0xQClt5V6wOgQHp3d5IiB-pSPUWkYhsaJfOcXSdS1ou1uBRqWxNFheoPALqiUfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W0ieGbc2QFXl9EpSwe48BaTjjjSr3Z9Dpmkf4SbyBng&oe=6A35643C"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
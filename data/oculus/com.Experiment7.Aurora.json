 {"file_name": "2.png", "id": "282080329442913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982534_282080332776246_6160352661840846822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAM-7sJlGBkQ7kNvwFNHxCM&_nc_oc=Adqj0-9Hxykp3RRfQl_mxt-kRAooVKaNhg6Li6f0-QZHqbzUskqyRLdmje2os0dqZ5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ72-Va3nP4Vkeza5Cq5YietrmPsUC1vMr5uwVTmYsm3A&oe=6AB517C5"}, {"file_name": "4.png", "id": "621141241914338", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982477_621141248581004_6601217092171587373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-PQNZycGJMQ7kNvwGuwmb5&_nc_oc=AdqMDLdE-NdhpsHTUjHc-KDWRux-Cws3jsCasee5eajUdpdgNqaK34L4rzud_MUBZnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKze-4bphW4dvKIPnLxLsYYmMEzk3rMYbHgem5jXUMxrg&oe=6AB53D57"}, {"file_name": "5.png", "id": "666403020969870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974786_666403024303203_6397322406234964444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCjb5BHOHTAQ7kNvwFkBxyo&_nc_oc=AdrzXM7qqgF3YXnoKYOK_DUNXzLY5too8ZeETJxFY6LOMi04plNFzNm132NfP13UhC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJd53frYGs2q_nELtediJRCp_DIB7hWEGJhowSPRHj8A&oe=6AB548F1"}, {"file_name": "6.png", "id": "280469579629838", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974747_280469582963171_8002131370352906278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ihg9MJFNtsQ7kNvwGbAzB4&_nc_oc=AdoU3zf5jBsevThJx044ZHPWIiPyNwoZ4a9eSA8wQy3q7sTX5xFy5-kS6A3wOjAVTYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKObLwfOSMexjlHeIx67oSGW0SnUq8SnxTsYM5gc1Srog&oe=6AB546BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1044586255980119", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031349_1044586259313452_1201325813482557882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L20SBVvhu8Q7kNvwFnAYzh&_nc_oc=AdrQxWxjoWXwffi3RJLQRrQXKR-6xXtZT1i5bm-FgZHs9boX3G4cYcDb5bH9dx6emxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzScbdddL8Ryn38HjPtQEy5_1n4cx9Ursc1AtsY4Do_g&oe=6AB545BC"}, "display_name": "Catan VR", "keywords": [], "long_description": "NOW ON QUEST & QUEST 2! \n\nCatan VR allows tabletop fans and new players alike to experience the best-selling board game in a fresh, fully-immersive format. Take on other players around the world or play against Catan personalities and watch the island come to life in VR for the first time. Catan VR brings everything board gamers love to the Oculus Rift, Oculus Go and Oculus Quest. \n\n* Classic Catan Gameplay, Now in VR \u2013 Experience the award-winning strategy classic for the first time in virtual reality. \n\n* Custom Catan Environment \u2013 Wheat sways, a mandolin strums, and clouds roll over the mountains as you play on the iconic island of Catan itself. \n\n* Invite-a-Friend & Matchmaking Multiplayer \u2013 Enjoy a game with longtime friends or take on the world-wide Catan community via online matchmaking. \n\n* Catan AI Personalities \u2013 Play vs. classic Catan AI opponents designed with guidance from Catan creator Klaus Teuber. \n\n* Cross-Platform Play \u2013 Rift vs. Go vs. Quest? No problem.", "short_description": "NOW ON QUEST & QUEST 2! Catan VR is an immersive take on Klaus Teuber\u2019s landmark title that revolutionized modern board gaming. Trade, Build and Settle on Oculus Rift, Oculus Go and Oculus Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.experiment7.com/privacy", "developer_terms_of_service_url": "http://www.experiment7.com/terms", "publisher_name": "Experiment 7", "support_website_url": null, "website_url": "http://www.experiment7.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "16764853
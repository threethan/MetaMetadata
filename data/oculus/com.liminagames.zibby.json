ye7Hg&oe=69A450C6"}, {"file_name": "Image Sequence_007_0003.png", "id": "845763184505694", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828050_845763187839027_468447991220621964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i-OdJhW02gQ7kNvwGQMCTv&_nc_oc=Admyox2Ba_3p7xY76JtOpCyjJ_g-k7hU65K3R_GfFs7paiGPXj5j4Sv5GA7zAJExgR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu2U7o214Fhx1GBMVFLdTDwGd0xagGwlLk3I4xS4xQWSQ&oe=69A43E2C"}, {"file_name": "Image Sequence_003_0002.png", "id": "1836602476962685", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1836602480296018_8280261062432359374_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buTTXL4eGRAQ7kNvwF0LNvG&_nc_oc=AdmeCVjG2KYyn0Y0tcWUvS_IXJPYmn6jKGFnb_qJMeJD-Xe-InibTBUlcy5m_O-D54c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsrT8rey_xRBTDjBSyUnqOgTKqm3W7LQ9-BeT41Uwr6OQ&oe=69A43B03"}, {"file_name": "Image Sequence_004_0000.png", "id": "1138993271704566", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1138993275037899_3311993198849045458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgzJnr_Vxf8Q7kNvwFyXEU1&_nc_oc=AdkPh_aRMUZrgpps84e4fqYsLavCylnP_2TpvxTb0o-HQHXv3JyBlOszTcB_pwdJpHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuv4HKAP8xebhwEzFuiPZ0V2SF4j-V_RxaPas7a92IXZA&oe=69A43E13"}, {"file_name": "Image Sequence_006_0001.png", "id": "847449181015275", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823279_847449184348608_15613528115627936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkpDWcJhP1YQ7kNvwFSraVm&_nc_oc=AdkXLmoLVdC5Q7V-_W09zR6nhfT70X5Amdm7s5OfIq5Hf6sQkbdhHy0Kd9ZBdG2z2ms&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsA53cPx3mYdRC1PHo-XZXUkU191GcXPFHX3hTSzJe7TQ&oe=69A43781"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zibby", "keywords": ["social", "casual", "free", "gorilla", "multiplayer"], "long_description": "# Welcome to Zibby!\n\nZibby is not just game. Zibby is lifestyle. Enter the world, be the Zibby.\n\n# Bonk & Snack\nSee that Spitflower? It has gems inside. BONK the Spitflower. Gem falls out? Don't put in pocket. EAT IT. Crunchy victory.\n\n{847821848000023}\n\n# Shop Like a Boss\nWhy look boring? Go to store. We have everything! Buy funny hat. Buy cool gadget. Buy shiny things. Look fresh, impress friends. Spend your hard-earned cash here.\n\n{1280599737210708}\n\n# Dig Deep, Eat Dark\nGrab pickaxe. Find rock. Smash rock! Oh look, coal pieces! Are you hungry? Yes. Eat the coal. Mining is tasty work.\n\n{2308405566240054}\n\n# Zoom and Boing\nWalking is for slow people. Use Jumppad: BOING! Fly high. Use Zipline: WHOOSH! Go fast. Explore the world like a pro. Never touch ground again.\n\n{722552094239314}\n\n# The Circle of Life\nSimple life. Good life. Walk -> Grab -> Bonk Mob -> EAT. Mine Rock -> Get Coal -> EAT. -> Sell loot -> Get rich -> Repeat. This is the Zibby way.\n\n{3001593293368798}\n\n**Rise through the skies. Serve the kingdom. Become Zibby.**\n\n\n\n\n", "short_description": "Explore floating island biomes as Zibby, servant of the kingdom. Team up with friends to hunt monsters, mine rare resources, and uncover secrets across a vast sky-realm. Collect valuable drops, sell them in the castle safe zone, and upgrade your gear. New islands, enemies, and tools arrive with every update\u2014your adventure never stops!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "271
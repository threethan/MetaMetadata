nt-sea5-1.oculuscdn.com/v/t64.5771-25/491819323_1519994945989639_6610495106460986944_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8wALcuEvhAQ7kNvwEVpZ1X&_nc_oc=AdpAM1RF5zFhg2oxr7tVQMOSzFCduGsjJrPmemsuUMFVvn_AuILyCapVhz7hjad01wc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3hD6RwNtXNMWpTD4SYsmjHTijR2bt2UjFJNj2Z5fTuA&oe=6AF08AC6"}, {"file_name": "Image Sequence_007_0003.png", "id": "845763184505694", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828050_845763187839027_468447991220621964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFtYgxcDKzEQ7kNvwHkKESW&_nc_oc=Adp6LEY9fZNAdsL2peTB9fZz_IiuA6dv3v__QLL1A85rJIYtsNDr1gRAGScQULGSK0w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl4PUWzHopjZ2k1D32rQI6GlIda6MuGxTa85z7ouDLZQ&oe=6AF0B06C"}, {"file_name": "Image Sequence_003_0002.png", "id": "1836602476962685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820855_1836602480296018_8280261062432359374_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOsXDE-IbGcQ7kNvwH17d-s&_nc_oc=Ado5Pq5krwwybzOvNE2PnbZqUwBotbQVdflvP1iVKlkHR5dzywljM7AV_Q-W6khKnsk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV54E2rytfKpoV9QsVyMz1Q0qkOpiMwwWhSNs05V3dwQ&oe=6AF0AD43"}, {"file_name": "Image Sequence_004_0000.png", "id": "1138993271704566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1138993275037899_3311993198849045458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1IcwVrqm4IQ7kNvwH9fEHB&_nc_oc=AdrEglOQWnlIc1Tn-Cf0QuGaMsEtK9eIzBfoBFeY_x7PhLgU8fojntuTK5eXhqCgNus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLpm-l2UpUsjDrlPo8o3kLEpO9Yu6DYhcYSyMslh27-w&oe=6AF0B053"}, {"file_name": "Image Sequence_006_0001.png", "id": "847449181015275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_847449184348608_15613528115627936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FyvhgWByjMQ7kNvwG0J0SE&_nc_oc=Adq-g-xP1lDtTjqkZO284fG4RVkqY9VPTiQVarXuGD3lengf4q57kEq9Efg04IQzEbc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxfjUNE2srpZVQBfPq1VOHWAyPjLpxP39zt9epYCpD8Q&oe=6AF0A9C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zibby", "keywords": ["social", "casual", "free", "gorilla", "multiplayer"], "long_description": "# Welcome to Zibby!\n\nZibby is not just game. Zibby is lifestyle. Enter the world, be the Zibby.\n\n# Bonk & Snack\nSee that Spitflower? It has gems inside. BONK the Spitflower. Gem falls out? Don't put in pocket. EAT IT. Crunchy victory.\n\n{847821848000023}\n\n# Shop Like a Boss\nWhy look boring? Go to store. We have everything! Buy funny hat. Buy cool gadget. Buy shiny things. Look fresh, impress friends. Spend your hard-earned cash here.\n\n{1280599737210708}\n\n# Dig Deep, Eat Dark\nGrab pickaxe. Find rock. Smash rock! Oh look, coal pieces! Are you hungry? Yes. Eat the coal. Mining is tasty work.\n\n{2308405566240054}\n\n# Zoom and Boing\nWalking is for slow people. Use Jumppad: BOING! Fly high. Use Zipline: WHOOSH! Go fast. Explore the world like a pro. Never touch ground again.\n\n{722552094239314}\n\n# The Circle of Life\nSimple life. Good life. Walk -> Grab -> Bonk Mob -> EAT. Mine Rock -> Get Coal -> EAT. -> Sell loot -> Get rich -> Repeat. This is the Zibby way.\n\n{3001593293368798}\n\n**Rise through the skies. Serve the kingdom. Become Zibby.**\n\n\n\n\n", "short_description": "Explore floating island biomes as Zibby, servant of the kingdom. Team up with friends to hunt monsters, mine rare resources, and uncover secrets across a vast sky-realm. Collect valuable drops, sell them in the castle safe zone, and upgrade your gear. New islands, enemies, and tools arrive with every update\u2014your adventure never stops!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "33266155159698853"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507830479_1555099159060202_5504412233788720064_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS4df6J4tdoQ7kNvwHRhh51&_nc_oc=AdqPT8ZWJAs9gm6iuTpbLUJOI9CJqspjO-6zM3MXj68SHkac-zUVPhTYo5DT4RA45Mg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwR3pPHcgwYAbFo_HQRwy_zrN1oTnWINQ3w5ASvcdYZg&oe=6AF0B0A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zibby", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1765895280, "lastRevision": {"nodes": [{"id": "30785250387789355", "release_type"
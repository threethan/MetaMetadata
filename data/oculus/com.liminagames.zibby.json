ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1138993275037899_3311993198849045458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgbQznp41tUQ7kNvwEQIW1s&_nc_oc=AdoywELe6zH4JmFwXmlt1E8XnpbCPQvqKJ8l6ieUs-jezwj_caDZIc6hlQrV3KOHCVw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDblFsRuyrN4Cw-SfgMrn_Ix76TlwMUNSN1sdSt0iVW6w&oe=6A4A5B13"}, {"file_name": "Image Sequence_006_0001.png", "id": "847449181015275", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823279_847449184348608_15613528115627936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgOZzrqtwscQ7kNvwEcU9wm&_nc_oc=Adq9XxU8BueRVgly3SdFNTLSj20Vr7g9CY2LejF1QOPzYNwcWjsPa83KhbTNoHzjXBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbw7LCWdvIFa8OvQ5XR_Wpb-5Itu10p4tzEAWECgCwFQ&oe=6A4A5481"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zibby", "keywords": ["social", "fun", "casual", "combat", "gathering"], "long_description": "# Become Zibby, Servant of the Kingdom\nEnter a massive open world of floating island biomes, each filled with unique monsters, resources, and mysteries. Equip gadgets, weapons, tools, and cosmetics to survive the dangers of the sky.\n\n# Explore Floating Island Biomes\nTravel through cloud forests, volcanic peaks, frozen skylands, and ancient ruins. Every biome challenges you in new ways\u2014and rewards you with rare loot.\n\n# Hunt Monsters with Friends\nTeam up to track powerful creatures, defeat roaming threats, and gather valuable drops. Cooperation means bigger hunts and better rewards.\n\n# Mine, Gather, and Discover\nDig through hidden caves, mine rare ores, and uncover secrets spread across the floating frontier. Bring everything back to the safe-zone castle to trade, upgrade, and grow stronger.\n\n# Expand with Every Update\nNew islands, monsters, gadgets, and surprises arrive regularly, expanding the world and pushing your adventure even further.\n\n**Rise through the skies. Serve the kingdom. Become Zibby.**", "short_description": "Explore floating island biomes as Zibby, servant of the kingdom. Team up with friends to hunt monsters, mine rare resources, and uncover secrets across a vast sky-realm. Collect valuable drops, sell them in the castle safe zone, and upgrade your gear. New islands, enemies, and tools arrive with every update\u2014your adventure never stops!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "30785250357789358"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33311009991880036", "version": "0.0.2"}, "id": "1441487720326146", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binar
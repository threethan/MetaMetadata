=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p2mzbW627jsKUUgjfPCBsiUaZg6nmYrzVt4-9h_vNaA&oe=6A0DC8C6"}, {"file_name": "Image Sequence_007_0003.png", "id": "845763184505694", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828050_845763187839027_468447991220621964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8z0T7xVYp4oQ7kNvwEHs248&_nc_oc=AdpAYPqugfa19eTM2h3aXMQq9sO2o6E8_B45S7lVmB5BcENMgCPej4nXSsAKOAnzr7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_zRpC5NgmfuNW0EWQoyoDVxYVAAuHHauFnSJT3rF1jQ&oe=6A0DB62C"}, {"file_name": "Image Sequence_003_0002.png", "id": "1836602476962685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_1836602480296018_8280261062432359374_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDend1fLMssQ7kNvwFSrK2i&_nc_oc=AdqhUj-0pCOB8XJYQCk_VaPx8UXIYnsxsolGmZJRKFcko3w13MLF1wGsosvKEi4dEO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kKOaih_UM5iz-z34CP5sEcqFgdoVPRYNRDu_Ejc6Oog&oe=6A0DB303"}, {"file_name": "Image Sequence_004_0000.png", "id": "1138993271704566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1138993275037899_3311993198849045458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bX38_OPJXAQ7kNvwFUKVnM&_nc_oc=AdoSfEFq2fTR0DZXz5FfC_6fQoQP_bx3FIBfgk6xehVzzR_PYqof8wYyCfld-HA8G1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EgEtaQmX9LPryRviAlwcM6JN1-wu9wP95P76Cvr_Rjg&oe=6A0DB613"}, {"file_name": "Image Sequence_006_0001.png", "id": "847449181015275", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_847449184348608_15613528115627936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9fa_W5582gQ7kNvwG4slDW&_nc_oc=AdqA-p6BD0PdIPuUa3xBwstU421B2Qot9Z9CYaipWRKjmL74UBcbB20XeT5rtUB2Pyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4460cYHEUL4_cnQ7h37r9IRq0RJVXPwYzQgi7Aes8vEg&oe=6A0DAF81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zibby", "keywords": ["social", "casual", "free", "gorilla", "multiplayer"], "long_description": "# Welcome to Zibby!\n\nZibby is not just game. Zibby is lifestyle. Enter the world, be the Zibby.\n\n# Bonk & Snack\nSee that Spitflower? It has gems inside. BONK the Spitflower. Gem falls out? Don't put in pocket. EAT IT. Crunchy victory.\n\n{847821848000023}\n\n# Shop Like a Boss\nWhy look boring? Go to store. We have everything! Buy funny hat. Buy cool gadget. Buy shiny things. Look fresh, impress friends. Spend your hard-earned cash here.\n\n{1280599737210708}\n\n# Dig Deep, Eat Dark\nGrab pickaxe. Find rock. Smash rock! Oh look, coal pieces! Are you hungry? Yes. Eat the coal. Mining is tasty work.\n\n{2308405566240054}\n\n# Zoom and Boing\nWalking is for slow people. Use Jumppad: BOING! Fly high. Use Zipline: WHOOSH! Go fast. Explore the world like a pro. Never touch ground again.\n\n{722552094239314}\n\n# The Circle of Life\nSimple life. Good life. Walk -> Grab -> Bonk Mob -> EAT. Mine Rock -> Get Coal -> EAT. -> Sell loot -> Get rich -> Repeat. This is the Zibby way.\n\n{3001593293368798}\n\n**Rise through the skies. Serve the kingdom. Become Zibby.**\n\n\n\n\n", "short_description": "Explore floating island biomes as Zibby, servant of the kingdom. Team up with friends to hunt monsters, mine rare resources, and uncover secrets across a vast sky-realm. Collect valuable drops, sell them in the castle safe zone, and upgrade your gear. New islands, enemies, and tools arrive with every update\u2014your adventure never stops!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
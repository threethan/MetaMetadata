64.5771-25/499622211_2056968078565449_6851310258815569858_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3EGMXKjEMgQ7kNvwHbmMwk&_nc_oc=Adov6QEsrlGUHrr81cwwSpzZ0P_yPrmmAZUqMZSMf37_8FAGMPKd2PTuy2Z_Jzqul4k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbI5nTuG3E6fs0fFfWhuUu4FIVOOMDv87m4rF8Boeb1A&oe=6A5654C0"}, {"file_name": "image (110) (1).png", "id": "1109994635537045", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499620860_1109994638870378_2574459401754458431_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50JkmC5bPtcQ7kNvwGle983&_nc_oc=AdoWUbaFXD9zLSW-mWngO9bsVXQD-ldtZF_AqQfaLIvKgzdv-j8CaNmS6ce6msUAdds&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHI1QNy1qR_HR6E5dkeCVmpQ1BopmRKv4kVrnMQWTt2w&oe=6A56345C"}, {"file_name": "image (0) (1).png", "id": "1568040521553071", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499622211_1568040524886404_2722164329975821553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO1oNL5JFAQQ7kNvwH5Amwx&_nc_oc=AdrsFnZymCbfM0u4oHiqMUMj0zMul2bkhxuaDbgfLCbiq1v63CGrghJcusLzY3jjxzM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFwdedWaNt6fOlNeIycxv5EplL2Sz-BEcjvUIgf7F0pA&oe=6A564134"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Containment", "keywords": [], "long_description": "Primal Containment is a multiplayer VR horror experience set within a secret underground containment facility overrun by dangerous anomalies.\n\nWork together with other players to survive, and navigate a complex network of containment chambers, tunnels, and research sectors while avoiding deadly threats that lurk throughout the facility.\n\nFeatures:\n\n\u2022 Fast-paced VR locomotion and movement\n\u2022 Multiplayer gameplay with friends and other players\n\u2022 Encounter terrifying anomalies and hostile entities\n\u2022 Explore containment chambers, tunnels, and research areas\n\u2022 Dynamic chase sequences and horror encounters\n\u2022 Interactive doors, security systems, and facility events\n\u2022 Voice chat for teamwork and communication\n\u2022 Regular updates with new entities, maps, and features\n\nCan you survive the containment breach and escape the facility, or will you become another victim of the anomalies within?", "short_description": "In Primal Containment You Have To Run, survive, and escape deadly SCPs in this multiplayer VR horror experience featuring Gorilla Tag movement, containment breaches, and intense encounters."}]}, "developer_name": "Dream Verse Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1ztV5Jp4uTGb5W-DBeFZ1BuDhDrF0QDAAaSIJKEwVcvk/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1PoHWJazMaiWWtIqfMU6o5vr2exm94E4j125ZKPD8GrI/edit?usp=sharing", "publisher_name": "rm3_mp11", "support_website_url": null, "website_url": "https://sites.google.com/view/primal-containment/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "27286674224353849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/618758916_2080505519477827_967175266774508621_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAmq7bZoCWsQ7kNvwFQBXqQ&_nc_oc=Ad
7542712823817467_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6waz2WOg-4Q7kNvwHT-cNL&_nc_oc=AdqVSnGA_datQmqphMtXh_XY2od9UPGyFXLudBiFIl3iNkS18ITHbQPPbLbUh5NqHqM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdQnw1XyQOKZR5p5f2Ot0kMJw113M5SuWgEBGlWWY1zA&oe=6B0B2B82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440\u7b2c\u4e8c\u4e2a\u7248\u672c.png", "id": "873856436656615", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031340_873856439989948_6253938896385027273_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0QQwBZmQuUQ7kNvwF9kXEb&_nc_oc=Adrcz7CBAc4XPeetuQGZO30uk5kY3PrgDZNcVADauQlTFxDU14pnVxuwwTpOGVSNVtU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTI_mKfnAj4rzL2fPct03KuT8onXlBDFqK-sTIL5tk0zg&oe=6B0B320C"}, "display_name": "Dance workout VR(Junior)", "keywords": [], "long_description": "1.Song list: http://www.cqplanb.com/ccc/Danceworkout-songlist.html\n\n2.We use microphone to react with rhythm, So If you refuse to open microphone permissions when first open app,there won't be reaction with rhythm. Never mind App still can work.\n\n3.Make sure to review your surroundings and clear any obstacles in your play area before starting this game!\n\n4.You 'd better have sweat proof sleeve on your Quest headset, you will sweat a lot happily when playing this.\n\n5.Due to Copyright of music, we don't include music in this app. But we support custom import .mp3 into Quest and play. \nSee how to https://www.youtube.com/watch?v=QfIdWHGalTY\n\n6.If you can't keep up with the rhythm at first, please be patience to practice more times and also click 0.75X to slow down.\n\n7.Will update new songs every month, If there are songs you wonder which are not in the list, Please don't hesitate to contact us immediately via E-Mail: 408077086@qq.com", "short_description": "1.  Dance Workout VR is a dance VR on Oculus Quest. We can learn clearly step by step with pop songs.  In this way you can find that learning dance is not difficult any more, dancer is stand around you. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cqplanb.com/ccc/Danceworkout_VR.txt", "developer_terms_of_service_url": null, "publisher_name": "Jijia", "support_website_url": null, "website_url": "http://www.023d.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ART_CREATIVITY", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "905567116795929"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75222948_3356510647807048_7348801296981120455_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnCSUlPcX14Q7kNvwF0UhfQ&_nc_oc=Adrl5Smqas6g5ECTJg0JyA2qMFsZQu8x72LQJDWZYsHNyACqeHsFYh5u0vCAzgixmP0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_IAXNCB-G5Vx4nsAW_RYKeuNgTkGNaQUqsIYDWWTm6g&oe=6B0B135B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dance workout VR(Junior)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1639167961, "lastRevision": {"nodes": [{"id": "350605833511345", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_
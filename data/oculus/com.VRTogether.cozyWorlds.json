-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItU87bRiHYE4oyA2LmPirXgppJotJYUXLo7O5EmEVKHQ&oe=6AAE9AAC"}, {"file_name": "Glossary_v2 copy.png", "id": "970771029176108", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307422_970771032509441_8605865230917608863_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpfS6EVNK4cQ7kNvwGaT2mF&_nc_oc=AdrBxugUYo4fiIPQ3Tuyr9g-mSj-0dKuUavL6PQFEBfs-NdmnS56-6IdeXm-rgd38SY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMUnK8vpfWwN306sTJOOGw1Pw4vwpGGKKSlKGaxLHznQ&oe=6AAEA2AF"}, {"file_name": "Placing_Plant.png", "id": "986688154295856", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830003_986688157629189_4267202620871698214_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOOiY-Lws_sQ7kNvwHId9uz&_nc_oc=Adri87PdFfEgM4sdIckn4KJXJzuQAePR2a1Jp8f-V-lxwqZwUhQHeYfmLFfJpJ0tFqw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS0goTljCJxMzPZbvehExoUT0yf5WhY7Iiv4x0RBAYeg&oe=6AAE8E03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cw_main_capsule_v3.png", "id": "1012073434742458", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/593845024_1012073438075791_5115851470217098440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4T8VhWtvRgQ7kNvwGl5hfr&_nc_oc=AdopgYoifH9BysHK_3uKwwxvCBGYyIUXfgjbg8FjFjNW0l_vRa2uiVnAwInjTDesK7Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEldmugyVA2G1kxVlNRMLiffsrMr0vk_gM5_6df1dC2Q&oe=6AAE9BA5"}, "display_name": "Cozy Worlds", "keywords": ["Cozy", "Relax", "Cute", "Create", "Garden"], "long_description": "**Relax, unwind, and play at your own pace.** Explore World Builder to bring worlds back to life and unlock new more elaborate places, tools, and items. Chill out in Creative Mode to build whatever you want, however you want. \n\nJoin our Discord for events, secret game playtests, and early access to new content: https://discord.gg/ckn7Dt2Xqm\n\n# Cozy Worlds has a delightful and intuitive way to bring worlds to life\n{1399115992324700}\n\n# Building worlds is just the start. Shrink down to explore your world!\n\n{1717984999452437}\n\n\ud83d\uddbc\ufe0f There is no art experience necessary to enjoy Cozy Worlds! This isn\u2019t a tool to make art, it is a way to let everyone experience the joy and magic of bringing worlds to life inside virtual reality.\n\n\ud83c\udf31 As you play, your options grow! Cozy Worlds has an expanding glossary of items and tools. And we are adding more with active updates.\n\n\n# WHAT YOU CAN CREATE\n{1440450527841765}\nCozy Worlds Keeps Growing. We Frequently Update the Game. Check Out Our Roadmap Below\n\n- Multiplayer Companion App, share your worlds with friends even if they don\u2019t own the game \n- Multiplayer Building of Worlds\n- New World Builder levels, biomes, and decor\n- Events and Community World Features\n", "short_description": "Relax, unwind, and sculpt beautiful worlds.\n\n\ud83c\udf0d Cozy Worlds is a place to chill out, feel creative, and find a bit of joy. \n\n\ud83c\udf31 You'll shape floating islands, unlock a growing glossary, and fill your creation with delightful plants, mysterious ruins, and curious critters.\n\n\ud83e\udd8c When you\u2019re ready, shrink down with the Pudu tool and walk through the world you built.\n\nUpdates and new content every month!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtogether.us/cozy-worlds-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRTogether", "support_website_url": null, "website_url": "https://www.vrtogether.us/cozyworlds", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "reco
HEs8e5&_nc_oc=AdpaTF5N80sAQrBsrHbs6sNKrw1T30CEoWMheGt2OipDhIWLdwnoqosIT7-ewdMFdWc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMeTzLm7MFmh6qEVdHIdi7swSvAAQaw3H59xnqNzKXYg&oe=69C7CC8C"}, {"file_name": "CW_EA_Trailer_Thumnail_(2560x1440)_004.png", "id": "861834619644985", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823366_861834622978318_7152744831054764358_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqm1X1vSse0Q7kNvwGg1f_2&_nc_oc=AdoF0OYUe2guDP1cRHMuH8fVyupneowttSMFB_jWcYPLtyRt-1FBBPFYzEqjG1JvrXI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6wzLr7PHMZVfpzUedOO3kywOWL0imTW61ryliFKN3aA&oe=69C7E836"}, {"file_name": "CW_EA_Trailer_Thumnail_(2560x1440)_011.png", "id": "864054356046526", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820141_864054359379859_3132543218830287424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1cCO4zpJ48Q7kNvwEgt3HG&_nc_oc=Adq8pLYr1i5ZbQXmHZ-IQmF68H5nhAw7cU8fZslaqji6aENoRI69N70qzy-WOSdKv24&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDkJ0AuQptyGCckXOsE-bJfxKxXgMjKXZuQHQPRGYHxA&oe=69C7D447"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CW_EA_Trailer_Thumnail_(2560x1440)_001.png", "id": "791725770498003", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818860_791725773831336_7963522473989790612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rln6wAdhBfsQ7kNvwH90MXB&_nc_oc=AdqQ1KDitVwzm2lu5_8CAuqjG2pEXvFkZXYc-4BTboofryK_9I0VCF_rr4CM-PcC95A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkvxJSpEOvq02YOQ2MsKsPqo5uzTbr-a7Ewf8HWdYJvQ&oe=69C7B9BB"}, "display_name": "Cozy Worlds", "keywords": ["Sandbox", "Creation", "Cozy", "Garden", "Meditation"], "long_description": "**Imagination is your guide - Cozy Worlds is your canvas**\n\nCozy Worlds is a soothing world-building game where anyone can craft living landscapes - no art experience required! Sculpt floating terrain with a wave of your hand and fill it with vibrant plants, cute critters and enchanting natural elements.\n\n\n**Unlock the Creative Library - with more elements to come!**\n\nDiscover unique plants, ancient ruins and more - bringing color and life to every floating island and rolling hill. \n\n{1127379655819066}\n\n**Intuitive Toolkit to Cultivate Your World**\n\nPaint and erase terrain, interact with living elements, and customize your creations using your intuitive toolkit.\n{2244298876036827}\n\n**Two Ways to Create**\n\nJourney through World-Builder Mode to unlock natural decor and tools - then try Creative Mode to sculpt with zero rules and total creative freedom.\n{1851337849596103}\n\n**About Cozy Worlds Early Access**\n\nIn Early Access, we invite you on a Cozy Worlds journey, to try out our first selection of tools and unlock a range of in-world objects that you can use to build your own cozy worlds. You can expect more journeys, world-building items and animal friends in future updates - for now, we hope this experience sparks joy and leaves you feeling a bit lighter!\n\n\n**Ready to join the Cozy Community?**\n\nConnect with fellow builders on our Discord! discord.gg/fbAvagsC8r \n\n\nCozy Worlds available only for Quest 3 & 3S", "short_description": "Step into Cozy Worlds - a soothing VR world-builder where you craft a dreamy natural sanctuary. Sculpt terrain with a wave of your hand and fill it with vibrant plants, ancient ruins and more.\n\nWhether you need a creative recharge or mindful stress break, Cozy Worlds is here for you to take a breath, explore freely, and follow your inner creativity!\n\nConnect with fellow builders on our Discord! discord.gg/fbAvagsC8r \n\nCozy Worlds available only for Quest 3 & 3S"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtogether.us/cozy-worlds-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRTogether", "support_website_url": null, "website_url": "https://www.vrtogether.us/cozyworlds", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10076667485762682"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2143483159798838"}, {"status": "PUBLISHED", "id": "1567702790892068"}, {"status": "PUBLISHED", "id": "734341112413396"}]}, "baseline_offer": {"id": "734341112413396"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "2143483159798838"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26084121394590702", "version": "0.4.7"}, "id": "709394245051468", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10076667472429350", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26084121394590702"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "709394245051468"}]}, "change_log": null, "created_date": 1773865343, "id": "26084121394590702", "version": "0.4.7", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"cou
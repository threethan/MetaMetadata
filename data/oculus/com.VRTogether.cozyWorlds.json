t=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zlu-yQiJxplWUR9qNDKSP5FCc8GuHWsd4ofRcgjxBTQ&oe=6A47C5AC"}, {"file_name": "Glossary_v2 copy.png", "id": "970771029176108", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307422_970771032509441_8605865230917608863_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZfXp6i7AD4Q7kNvwH2Xiud&_nc_oc=Adr3KzMJGzZz-cnLLTAR4eXvARO50b5dJ0ejaIEQxYfWBuMk-IONwGbEzIJYFzNWk0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1p0KhM-E9ULDg6qAfrvA1PXEIpkaAK59VESPfD--Vbg&oe=6A47CDAF"}, {"file_name": "Placing_Plant.png", "id": "986688154295856", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830003_986688157629189_4267202620871698214_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9b3L0I-BJuQQ7kNvwHVLODs&_nc_oc=AdoTUlyMVIVtqGsbvMlArj-Z36Dfd1XdjH1NLUNoDNFsFEzImlUW-163cYENmLYP-M0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bBBQ8xIeDYUSqvBq5JsqFDKmF2_11P2rDDg0VJtUuxA&oe=6A47B903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_v3 copy.png", "id": "1235211045000973", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303864_1235211048334306_7643070682220301624_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IO5iYQgqmDMQ7kNvwEloso8&_nc_oc=Adp7QmHKN3X3yDJoXethtidJ4QYvv7si8p-EZ6vBjUIvIP5LnyzFpdS2dQDX6HYjSvU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TDh3HV5ZbQO5K8xVSQ6JTqMVLfgtjEtVw2SDvo5qWyw&oe=6A47B8B2"}, "display_name": "Cozy Worlds", "keywords": ["Cozy", "Relax", "Cute", "Create", "Garden"], "long_description": "**RELAX, UNWIND AND SCULPT BEAUTIFUL WORLDS**\n\n\ud83c\udf0d Cozy Worlds is a place to chill out, feel creative, and find a bit of joy. \n\n\ud83c\udf31 You'll shape floating islands, unlock a growing glossary, and fill your creation with delightful plants, mysterious ruins, and curious critters.\n\n\ud83e\udd8c When you\u2019re ready, shrink down and walk through the world you built.\n\n\ud83d\uddbc\ufe0f No art experience required. No pressure. \n\n# TWO WAYS TO PLAY \n\n\u26f0\ufe0f World-Builder Mode \u2014 A guided path that unlocks tools and fills your library of items as you progress. \n\n\ud83c\udfa8 Creative Mode \u2014 Your world, your rules. Everything unlocked in your library.\n\n# WHAT YOU CAN CREATE\n\ud83c\udff0 140+ unique design elements \u2014 ancient castles, delicate flowers, lively critters & more \n\n\ud83d\udd8c\ufe0f Paint and sculpt terrain \u2014 intuitive controls\n\n\ud83d\udd28 Crack open seeds to reveal unlocks and hidden surprises\n\n\ud83c\udf31 Grow vibrant plants, place critters, and watch your island breathe with life\n\n\ud83e\udd0f Shrink down and explore your world at full scale from the inside\n\n\ud83e\udef6 Perfect for unwinding after a long day \u2014 or disappearing into something beautiful.\n\n**Frequent updates with new content! **\n\nCozy Worlds is growing. Here\u2019s what\u2019s on the way:\n- Multiplayer Companion App \u2014 share your worlds with friends. \n- Spirit Garden Mode \u2014 tend a growing world and unlock nature spirits\n- New World Builder levels, biomes, and decor\n- Events and Community World Features\n\nConnect with us on our Discord: https://discord.gg/ckn7Dt2Xqm", "short_description": "Relax, unwind, and sculpt beautiful worlds.\n\n\ud83c\udf0d Cozy Worlds is a place to chill out, feel creative, and find a bit of joy. \n\n\ud83c\udf31 You'll shape floating islands, unlock a growing glossary, and fill your creation with delightful plants, mysterious ruins, and curious critters.\n\n\ud83e\udd8c When you\u2019re ready, shrink down with the Pudu tool and walk through the world you built.\n\nUpdates and new content every month!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtogether.us/cozy-worlds-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRTogether", "support_website_url": null, "website_url": "https://www.vrtogether.
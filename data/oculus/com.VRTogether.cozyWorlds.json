scdn.com&_nc_ss=7f20f&oh=00_Af7vGF_QB8w06tVwEEtZb2woLiO3b0kRCtzN4Un8aHntPQ&oe=6A09D193"}, {"file_name": "screenshot2.png", "id": "886544650708548", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499295512_886544654041881_5858571116903816650_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdVlWOkrPmUQ7kNvwHSSOmC&_nc_oc=AdoYSmsqV8AK5UCUQUj0ccqTrZSmM8e5G00g6_7zIvQvbsmdefWBHdgBIgh12avCPG4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UaIxDwOK-C22OZB5FGPkpBsUgMHDhSIE6MpLQtKypGg&oe=6A09B414"}, {"file_name": "CW_EA_Trailer_Thumnail_(2560x1440)_013.png", "id": "4535792186735301", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499307326_4535792190068634_2307844779775273825_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rz2va75dty0Q7kNvwF7w_y5&_nc_oc=Adram8qEjxwwkMIGmomoILUvV1v3r3_FrS2Lyc_t6NwTXy7Djd_MeG9eUDDEJk7DuSw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l_YHDfbQjiIqxBuL88dh6BPKWiXdtulqUmp1WIS9ddA&oe=6A09DD3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_v3 copy.png", "id": "1235211045000973", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499303864_1235211048334306_7643070682220301624_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFrKPkRxCdEQ7kNvwGVq1Vi&_nc_oc=AdpOo1YMIh9rKEF7z4GYy0J4n-lc1Hrdn3yUwOtDCH_80_gMuZPOH4CBM4Ok9JkO_98&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64kK2rPR4SiClW-I3LntrY2kJeMpZC8SujrVu04w_Pxw&oe=6A09C232"}, "display_name": "Cozy Worlds", "keywords": ["Sandbox", "Creation", "Cozy", "Garden", "Meditation"], "long_description": "**PAINT A WORLD INTO EXISTENCE WITH YOUR HANDS** \n\n\ud83c\udf0d Cozy Worlds is a relaxing VR world-builder where you shape floating islands, grow vibrant plants, and fill your creation with curious critters.  \n\n\ud83e\udd8c When you\u2019re ready, shrink down with the Pudu tool and walk through the world you built.\n\n\ud83d\uddbc\ufe0f No art experience required. No pressure. No fail states. Just you and an endlessly creative canvas.\n\n# TWO WAYS TO PLAY \n\n\u26f0\ufe0f World-Builder Mode \u2014 A guided path that unlocks tools and fills your library of items as you progress. Perfect for easing in.\n\n\ud83c\udfa8 Creative Mode \u2014 Your world, your rules. Everything unlocked in your library, no restrictions.\n\n# WHAT YOU CAN CREATE\n\ud83c\udff0 140+ unique design elements \u2014 ancient castles, delicate flowers, lively critters & more \n\n\ud83d\udd8c\ufe0f Paint and sculpt terrain by hand \u2014 intuitive controls\n\n\ud83d\udd28 Crack open seeds to reveal unlocks and hidden surprises\n\n\ud83c\udf31 Grow vibrant plants, place critters, and watch your island breathe with life\n\n\ud83e\udd0f Shrink down and explore your world at full scale from the inside\n\n\ud83e\udef6 Perfect for unwinding after a long day \u2014 or disappearing into something beautiful.\n\n**[Early Access \u2014 Actively in Development]**\n\nCozy Worlds is growing. Here\u2019s what\u2019s on the way:\n- Spirit Garden Mode \u2014 tend a growing world and unlock nature spirits\n- New World Builder levels, biomes, and decor\n- World Events and Community World Features\nExpected: Summer 2026\n\nYour feedback shapes what we build. Leave a review \u2014 we read every one.\n\nConnect with us on our Discord: discord.gg/fbAvagsC8r\n", "short_description": "Paint a world with your hands \u2014 no experience needed.\n\n\ud83c\udf0d Cozy Worlds is a relaxing VR world-builder where you shape floating islands, grow vibrant plants, and fill your creation with curious critters.  \n\n\ud83e\udd8c When you\u2019re ready, shrink down with the Pudu tool and walk through the world you built.\n\nWorld-Builder Mode guides you. Creative Mode sets you free.\n\n[Early Access \u2014 Updates every month. New Spirit Garden mode arriving Summer 2026]"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtogether.us/cozy-worlds-privacy-policy", "developer_terms_of_se
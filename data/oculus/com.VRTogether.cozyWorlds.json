193_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=up6fL5S9_CMQ7kNvwFgNAbT&_nc_oc=Ado9dx7WizIfI4rQLkeSfpQDAJke0auBy-aRX6t7wBzlDzsvxnJ6AA3dbLotgZNuS78&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h8nnadhFD2nHwm7hKJsSjXOBp8NO3aM12TYZOG0vQqg&oe=6A395895"}, {"file_name": "CW_EA_Trailer_Thumnail_(2560x1440)_013.png", "id": "825727380059462", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823901_825727383392795_1794405789011801822_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axKucJrdduwQ7kNvwGuwljc&_nc_oc=AdpASVF_GCxKJUWrhhbx5joFBWckLsYIPp4yphoB8uqgjgYEYLvq-EvxJ8g2cNcRta4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JVXi7bRxGbvrjtzUirIlgm7kDsLbKGvGSJGNnv9AsCQ&oe=6A395424"}, {"file_name": "CW_EA_Trailer_Thumnail_(2560x1440)_010.png", "id": "1415454567247071", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823286_1415454570580404_1941291654666578362_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXPbtSlvZikQ7kNvwGKySbz&_nc_oc=Ado4fLIYvDdWRrd3ImlVKUPTy_SkLGvgImIKpycRqCjfhKz3bZwUqGjGAbYkkvwae1w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_42b4hlc2EFE1Y38y--B2ZuOlkOo2ATrpKeqgbyAnlyg&oe=6A392D8C"}, {"file_name": "CW_EA_Trailer_Thumnail_(2560x1440)_004.png", "id": "861834619644985", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823366_861834622978318_7152744831054764358_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uTtQQmfMVsQ7kNvwEovDIC&_nc_oc=AdoXW6lKrisvRJ8hZAbv57k2Om6q52XfEyZ57_KWNI4v-QL_614fezL4GV3vpHQ8Afs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AcKzKDZgbNqJMT6VIatp7jN38PV0P8b2ftbT36hDT_Q&oe=6A394936"}, {"file_name": "CW_EA_Trailer_Thumnail_(2560x1440)_011.png", "id": "864054356046526", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820141_864054359379859_3132543218830287424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baYIfFnHQGwQ7kNvwHtEqvB&_nc_oc=AdrTpUCk2nq1fLgw0OVN1zuVeyGmPCGpk3KdW7-F4hb_tWR8JZud7yzZS0dDQXdmhq4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0kVS8ijoMdYQMm8Gz0YLtR5kmmFuP3v1EX6f334mzCQ&oe=6A393547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CW_EA_Trailer_Thumnail_(2560x1440)_001.png", "id": "791725770498003", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491818860_791725773831336_7963522473989790612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQ7Nk9vqsDMQ7kNvwE3DhuD&_nc_oc=AdpVNl_UIhyCFES0sZnnybbSosHgfb-yD-Su0ljQZqYMFw3Tg6RS8ohTXjF1DNlfrLw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gNNgL7Bo0zloBBIGtfmLLu_6bORLz6h8LaUG8FwFWsw&oe=6A3952FB"}, "display_name": "Cozy Worlds", "keywords": ["Sandbox", "Creation", "Cozy", "Garden", "Meditation"], "long_description": "**Imagination is your guide - Cozy Worlds is your canvas**\n\nCozy Worlds is a soothing world-building game where anyone can craft living landscapes - no art experience required! Sculpt floating terrain with a wave of your hand and fill it with vibrant plants, cute critters and enchanting natural elements.\n\n\n**Unlock the Creative Library - with more elements to come!**\n\nDiscover unique plants, ancient ruins and more - bringing color and life to every floating island and rolling hill. \n\n{1127379655819066}\n\n**Intuitive Toolkit to Cultivate Your World**\n\nPaint and erase terrain, interact with living elements, and customize your creations using your intuitive toolkit.\n{2244298876036827}\n\n**Two Ways to Create**\n\nJourney through World-Builder Mode to unlock natural decor and tools - then try Creative Mode to sculpt with zero rules and total creative freedom.\n{1851337849596103}\n\n**About Cozy Worlds Early Access**\n\nIn Early Access, we invite you on a Cozy Worlds journey, to try out our first selection of tools and unlock a range of in-world objects that you can use to build your own cozy worlds. You can expect more journeys, world-building items and animal friends in future updates - for now, we hope this experience sparks joy and leaves you feeling a bit lighter!\n\n\n**Ready to join the Cozy Community?**\n\nConnect with fellow builders on our Discord! discord.gg/fbAvagsC8r \n\n\nCozy Worlds available only for Quest 3 & 3S", "short_description": "Step into Cozy Worlds - a soothing VR world-builder where you craft a dreamy natural sanctuary. Sculpt terrain with a wave of your hand and fill it with vibrant plants, ancient ruins and more.\n\nWhether you need a creative recharge or mindful stress break, Cozy Worlds is here for you to take a breath, explore freely, and follow your inner creativity!\n\nConnect with fellow builders on our Discord! discord.gg/fbAvagsC8r \n\nCozy Worlds available only for Quest 3 & 3S"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtogether.us/cozy-worlds-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRTogether", "support_website_url": null, "website_url": "https://www.vrtogether.us/cozyworlds", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10076667485762682"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "722170294278590"}, {"status": "PUBLISHED", "id": "2143483159798838"}, {"status": "PUBLISHED", "id": "1567702790892068"}, {"status": "PUBLISHED", "id": "734341112413396"}]}, "baseline_offer": {"
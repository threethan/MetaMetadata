und"], "long_description": "Following the events of Project UG 2, the Apex Containment Network has collapsed. You are one of the last survivors trapped underground, hunted by creatures that should\u2019ve never existed\u2014genetically-modified apes gone rogue. The lights flicker, alarms echo, and the air is thick with dread. But this time, it\u2019s not just about escape... it\u2019s about uncovering what they buried beneath.\n\nCo-op or Solo Survival: Join other players or go it alone.\nAdvanced Enemy AI: Apes now learn, stalk, and adapt to your behavior.\n\nDynamic Power Outages: Manage light and sound carefully\u2014or be hunted in the dark.\n\nVR-Ready Immersion: Built for VR horror with full body interaction and networked grab physics.", "short_description": "Co-op or Solo Survival: Join other players or go it alone.\nAdvanced Enemy AI: Apes now learn, stalk, and adapt to your behavior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethal-ape-underground/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ykblooming", "support_website_url": null, "website_url": "https://sites.google.com/view/lethal-ape-underground/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24199183433099544"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED"
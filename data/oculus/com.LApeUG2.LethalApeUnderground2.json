ZOb8JWolvuAk-Y&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-83ebFIrKbY8vey8Aq7FXHHz3EAv3KiX6biT7OyN4fw&oe=69E23984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Underground 2", "keywords": ["Horror", "VR", "Ape", "Project", "underground"], "long_description": "Following the events of Project UG 2, the Apex Containment Network has collapsed. You are one of the last survivors trapped underground, hunted by creatures that should\u2019ve never existed\u2014genetically-modified apes gone rogue. The lights flicker, alarms echo, and the air is thick with dread. But this time, it\u2019s not just about escape... it\u2019s about uncovering what they buried beneath.\n\nCo-op or Solo Survival: Join other players or go it alone.\nAdvanced Enemy AI: Apes now learn, stalk, and adapt to your behavior.\n\nDynamic Power Outages: Manage light and sound carefully\u2014or be hunted in the dark.\n\nVR-Ready Immersion: Built for VR horror with full body interaction and networked grab physics.", "short_description": "Co-op or Solo Survival: Join other players or go it alone.\nAdvanced Enemy AI: Apes now learn, stalk, and adapt to your behavior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethal-ape-underground/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ykblooming", "support_website_url": null, "website_url": "https://sites.google.com/view/lethal-ape-underground/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
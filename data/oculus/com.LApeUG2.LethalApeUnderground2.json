 Built for VR horror with full body interaction and networked grab physics.", "short_description": "Co-op or Solo Survival: Join other players or go it alone.\nAdvanced Enemy AI: Apes now learn, stalk, and adapt to your behavior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethal-ape-underground/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ykblooming", "support_website_url": null, "website_url": "https://sites.google.com/view/lethal-ape-underground/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24199183433099544"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "771447165254545"}]}, "baseline_offer": {"id": "771447165254545"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755284880, "status": "PUBLISHED", "id": "771447165254545"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27934292499588600", "version": "UG APES VENT UPDATE ReleaseV39"}, "id": "744331204985698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24102153446135877", "is_concept": fals
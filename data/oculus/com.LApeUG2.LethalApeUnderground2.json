c=3rYgvi4BkigQ7kNvwG7sKCo&_nc_oc=Adr1W192rbeErzZTwoQNq99So8bAZNA2gOpC29uWQYa5eHFx53vr6AYMUrWry7zxKz0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeYmQjKj4jv4IGQeKGXLLwaGBA25ya_9GNtRmvHzC1bw&oe=6AA806BE"}, {"file_name": "LethalApeUG2_Custom..._02.08.2025_16-21-24.png", "id": "1418779382763151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822737_1418779386096484_7095768767299086270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeAkaJdly94Q7kNvwHjelOx&_nc_oc=AdoR9l3O83PQYdLSGym3iPsjT5wWliSFsb5ykZv-NCBCLWFJN5_1o8nNRRIwlF5rUBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBDjTqzFwgXqi5P6UWXtumAzabtyPs-yJtUkaw-L43Xw&oe=6AA80712"}, {"file_name": "LethalApeUG2_Custom..._02.08.2025_16-20-36.png", "id": "700257526319370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818925_700257529652703_4852532594809364037_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLVSILpOaWgQ7kNvwFrw1I5&_nc_oc=AdoI8QdnfuPWmqgmh_m6g2Jo1bIr3whP1x_6wmNU3OUlQ4Qwt0lc6fP7hzsU4Scl3e0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvkTOf0AygW_lmhNkifWuk5nTQvjzlA6u4e7WaPooOmw&oe=6AA7FA84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Underground 2", "keywords": ["Horror", "VR", "Ape", "Project", "underground"], "long_description": "Following the events of Project UG 2, the Apex Containment Network has collapsed. You are one of the last survivors trapped underground, hunted by creatures that should\u2019ve never existed\u2014genetically-modified apes gone rogue. The lights flicker, alarms echo, and the air is thick with dread. But this time, it\u2019s not just about escape... it\u2019s about uncovering what they buried beneath.\n\nCo-op or Solo Survival: Join other players or go it alone.\nAdvanced Enemy AI: Apes now learn, stalk, and adapt to your behavior.\n\nDynamic Power Outages: Manage light and sound carefully\u2014or be hunted in the dark.\n\nVR-Ready Immersion: Built for VR horror with full body interaction and networked grab physics.", "short_description": "Co-op or Solo Survival: Join other players or go it alone.\nAdvanced Enemy AI: Apes now learn, stalk, and adapt to your behavior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethal-ape-underground/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ykblooming", "support_website_url": null, "website_url": "https://sites.google.com/view/lethal-ape-underground/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24199183433099544"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "771447165254545"}]}, "baseline_offer": {"id": "771447165254545"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755284880, "status": "PUBLISHED", "id": "771447165254545"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27934292499588600", "version": "UG APES VENT UPDATE ReleaseV39"}, "id": "744331204985698", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24102153446135877", "is_concept": fals
le_name": "\u30b9\u30af\u30b7\u30e75.png", "id": "2143176043098962", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304079_2143176046432295_1313509779600174280_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0jPCk_4LiQQ7kNvwFumJtq&_nc_oc=Adqfc8FCOj8NOhOvafq9B1jxSIDrC_UcOni3lK9qi9fPwGJXTwevnMe-BIfJTpxMrFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYjz-BgwRTZ5jwY7ra7AJf1M_ScJjFmqseKNJMo3LyyQ&oe=6A5B83A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Thought Orb", "keywords": ["meditation", "mindfulness", "zen", "wellness", "reflection"], "long_description": "# Thought Orb \u2014 Make Your Mind Visible\n\nA place where no one else exists. Speak as you wish.\n\nHave you ever wanted to drown yourself in thought? Thought Orb turns your words into glowing orbs, floating in a serene VR space.\n\n\n## How It Works\n\n1. **Speak** \u2014 Just say whatever comes to mind.\n2. **See** \u2014 Your words transform into glowing orbs, colored by their nature.\n3. **Go Deeper** \u2014 Reach out and pull orbs closer, exploring your thoughts from a new perspective. AI-generated questions guide you toward deeper awareness.\n\n\n## A Space Designed for Stillness\n\n- A starry sky stretching above and below\n- A monolith standing at the center \u2014 an anchor for meditation\n- Light that pulses in rhythm with your breath\n\nNo notifications, no noise. Just you and your thoughts.\n\n\n## Features\n\n- **Voice-to-Orb** \u2014 Just speak naturally. AI handles the rest\n- **Cognitive Color Coding** \u2014 Instantly see the nature of each thought\n- **AI-Guided Questions** \u2014 Thoughtful prompts that deepen self-awareness\n- **Pull & Arrange** \u2014 Gather orbs, revisit past thoughts, and discover new connections\n- **Encrypted Storage** \u2014 Your thoughts are yours alone. Protected with AES-256 encryption\n- **Bilingual Support** \u2014 Full support for both Japanese and English\n\n\n## Who It's For\n\n- Anyone seeking a mindful pause in their day\n- Those looking for a new way to record their thoughts\n- Meditators who want visual cues for introspection\n- Creators and thinkers who want to externalize and examine their ideas\n\n\nYour thoughts deserve their own space.\n", "short_description": "Speak your thoughts and watch them become glowing orbs floating in space. Thought Orb transforms your inner voice into a visual meditation experience \u2014 capture fleeting ideas, reflect on them from new angles, and let AI-guided questions deepen your self-awareness. Your mind, made visible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wp.taskruru.online/thoughtorb-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "taskruru", "support_website_url": null, "website_url": "https://wp.taskruru.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27504731859114320"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618515_2071791183367162_3066823951962570251_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7QcvyPw6VEQ7kNvwGQUT6R&_nc_oc=AdrZY1tLfAkoQFJBmp7jjx4yJdiNaz6POHnpaQ-ZW6QOBVmDR37CqgzeevWUZdgWxRM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5Zx2YteRbOrU-zgNQ6LwY43sxCVUHXkRqCoEKb3e9xQ&oe=6A5B6202"}, "is_concept": false
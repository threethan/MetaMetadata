{"data": {"node": {"__typename": "Application", "id": "25906867488908129", "organization": {"id": "705560972632519", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "34640169082298083"}]}, "id": "2128089917956361"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26261263830182507"}]}, "id": "811112855380718"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26772306675703347"}]}, "id": "1475925844129693"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26105685972376587"}]}, "id": "931467836492809"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25906867488908129"}]}, "id": "1407423447840410"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25385691287757147"}]}, "id": "709017688708699"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "33007560172193177"}]}, "id": "1424967632310287"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25185006614419138"}]}, "id": "4265738553570088"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24552001997798976"}]}, "id": "1528611215220253"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24619062697733317"}]}, "id": "1256449906282392"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24334636456176019"}]}, "id": "1436794250889478"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "31112099521736814"}]}, "id": "720922214440907"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9804523692991003"}]}, "id": "1269522004586655"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "23868001389537044"}]}, "id": "2162380197599761"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "10017113878373725"}]}, "id": "1167765258406445"}]}}, "firstRevision": {"nodes": [{"application": {"id": "25906867488908129", "release_date": 1771386840, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27438415149086681"}, "id": "1214367866691639"}]}}, "binary": null, "live_binary": null, "created_date": 1779944293, "id": "27353191274275736", "is_initial_release": false, "name_with_fallback": "v11", "pdp_metadata_with_fallback": {"version": 9, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "27354390314155832"}, "release_status": "RELEASED", "id": "25906867488908129"}, "id": "27354390314155832", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25906867488908129", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "853773924067888"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "2560_1440 (10).png", "id": "26654948644172333", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499309014_26654948654172332_6300619337954888337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQQMg24n0PcQ7kNvwG_p4PQ&_nc_oc=AdomFx7EV1Y2R00KLjxgNhn_DtLmVZaovoTWtoxyzMISil-lSR87BVVqqU_D6D6tzVE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1ZvVVvAu1PQBNFAiYYFJm6Efag7QEgp2re2ywUGAHxw&oe=6A2C1E31"}, {"file_name": "1008_1440 (3).png", "id": "5898268467004442", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619672_5898268470337775_3390731086415699207_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDKPAVV3_9kQ7kNvwF8F4ju&_nc_oc=AdqdKV2rXVjjTZrCRZqWqwrNlizxnkhoiIK7cCz7VYBpdvkYHPYIakpOuAWVyTuY9UI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U-_QnlQIqU3UwPUkF5pTquKRdOiIxaAuiqtB_XOSSPg&oe=6A2C0372"}, {"file_name": "3000_900 (3).png", "id": "2283127518762937", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308349_2283127522096270_3431145393703933973_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhxSOekbdY0Q7kNvwH_OvAp&_nc_oc=AdpvDDdDxpT1x4gIwK8ooCrWq_XA_EssINBKaJtAA4iNTXoGN7fwTbEzxupIJCdspWc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eqROBNkelsOWpsu-DIDumh2O5M-4o-R2OTK4F60FeQg&oe=6A2C202B"}, {"file_name": "1440_1440 (4).png", "id": "2142676170241470", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618440_2142676173574803_662300070836692948_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dYNzFNIXm8Q7kNvwENTfpK&_nc_oc=AdoKQbQkEHN0pTPDl_ru8mdu1x9C9UNyEFSacs6tMX1Lw_S5iHU5Wjl-a3Ys391TvpQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XA2ZyCAOkPDCHctgkDGt4A_qIybJ5sfMrqXtr8ChCIg&oe=6A2C0072"}, {"file_name": "512_512 (7).png", "id": "1301523018589567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618937_1301523021922900_8522684882006509479_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSoUxrZVhf4Q7kNvwG_5mBJ&_nc_oc=AdpkjnxyERF7uR9oduUmpgqTyjzppwdJHVTR2iNDDAwm_eMcVBpY6SmiTEZ9II6400I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IY8_G1f29pqrM5oQ74OPGjROyA2InSiatma972J0xcg&oe=6A2C0191"}]}, "id": "2813596989032677", "locale": "en_GB", "screenshots": [{"file_name": "Crab claw.png", "id": "861051166982055", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823812_861051170315388_3620868524152368984_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Fqh4CL7q5oQ7kNvwGle1MV&_nc_oc=AdrzMxw0yRNFM5QRUGMWWCIPdkhxKSYKGSPsyEFnilQepvEZaQqyc4K9mBiIG7BOm_g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hKpvCz7T0xUBju-MLNOtjDL7AKemMaSG1BEGvbnI8qw&oe=6A2C24FF"}, {"file_name": "Carb SS114.png", "id": "835970626169704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818860_835970629503037_3873259673294006253_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnNY1i0fkpUQ7kNvwHV4Ado&_nc_oc=Ado6aiJ9Gq3H8kbXDD4x41lw0cfxP1fxJN3XoKHxIFHvgkbp1-nevvAonramUVtVcag&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BTGs7jM0Tb84-4a0IzMturZelh4nBMNZXatZ1iLImiw&oe=6A2C04EC"}, {"file_name": "Carb SS13.png", "id": "1323321079634106", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819859_1323321082967439_7799448672024372703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwE0e_6NZp4Q7kNvwEWs9Db&_nc_oc=AdqOI_rIUhYOBSMZqnqYBRp1zDSjQDoVClrKc3EmPfqr5biCPK_AicKOqACCsD-ztH8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GzHT6fG2Ck1tTsGd9-a6YPpn5H6q27H1WMsnWQVkotA&oe=6A2C0B09"}, {"file_name": "Carb SS12.png", "id": "1567970714317473", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824328_1567970717650806_4639081852162705204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umxb_nmwixcQ7kNvwG9Wcaa&_nc_oc=AdpN3o-zObVE9zaggEOEM0GJhyNDntlw45F2aXBmaUfH3nfN_Vr4kKccLpakugCT6MQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8834DOIhQHG1SA45xdsKNZGMvx5UBrmqGAe-aYqLNcwQ&oe=6A2C3048"}, {"file_name": "Carb SS.png", "id": "4190354621277233", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820887_4190354627943899_481061455826641147_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaMeyh0KkI4Q7kNvwG0owqb&_nc_oc=AdpwIk1Zy38slAvAHzVKsm6wHdhvUdRfbavYKTBD1ynAmVKRDnYNDoKGb6yuyOdSpjA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LYqvhVTgLflRQ4rUWKbb-BhmPfPn8mcdqa-TIdFWD9Q&oe=6A2C240D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440 (10).png", "id": "2011120609436715", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617729_2011120612770048_5365416398665121704_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D_OnLCMwO0Q7kNvwHJLI5a&_nc_oc=AdqpaWolQHCHXpI3En-H2W_AHUVmf6_QCBZTSMyf3itRkZkDgVf2kT1szDG99Jov0js&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IkWGmedFttwrz_5JcdsY08KQv5-_bjGrmC5Fmru53RA&oe=6A2C090E"}, "display_name": "I Am Crab", "keywords": ["adventure", "Island", "mission", "simulator", "job"], "long_description": "# \ud83e\udd80 Play as a Crab\nStep into the claws of a mischievous beach crab in **I Am Crab**. Here, you don\u2019t just play the crab\u2026 **I Am Crab**, and this is my world! Use your VR hands as powerful claws to grab, lift, throw, and interact with everything around you.\n\n{1580264889911789}\n\n# \ud83e\udd80 True Sandbox Freedom\nExplore a lively beach island with complete freedom. Touch, move, and experiment with fully physics-driven objects in an interactive VR playground.\n\n{942062721840660}\n\n# \ud83e\udd80 Do Whatever You Want\nLive your best crab life \u2014 take photos, start dance parties, explore hidden spots, or just roam the island. There are no limits to how you play.\n{898413533038599}\n\n# \ud83e\udd80 Create Fun Chaos\nKnock things over, mess with NPCs, and watch dynamic reactions unfold. The island responds to your actions \u2014 sometimes in hilarious ways.\n{897675433131868}\n\n# \ud83e\udd80 Packed with Activities\nComplete fun beach missions and mini-challenges scattered across the island. Every task offers new interactions and unexpected outcomes.\n{26193085766998595}\n\n# \ud83e\udd80 Physics-Based Claw Interaction\nExperience realistic VR claw mechanics powered by physics. Every grab, throw, and collision feels natural, weighty, and satisfying.\n{865148156498424}\n\n# \ud83e\udd80 Annoy the Islanders\nSneak up, interrupt activities, and provoke funny NPC reactions. Tease, prank, and stir up trouble \u2014 because you\u2019re a crab.\n{1547957586313711}", "short_description": "I Am Crab is a chaotic sandbox VR adventure where you scuttle, grab, and fling everything in your path because I Am Crab! Explore a lively island, complete hilarious mini-missions, annoy NPCs, start crab dance parties, and create wild chaos in a world that reacts to every claw swipe.\n\nClimb walls, squeeze through tight spaces, and discover hidden secrets because I Am Crab, and nothing can stop me! Fling objects, cause mischief, and show everyone that I am crab in a fully interactive playground."}, {"images": {"nodes": []}, "id": "2031687737740101", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Crab", "keywords": ["Job", "Simulator", "Mission", "Adventure"], "long_description": "# \ud83e\udd80 Graj jako Krab\nWitamy w **I Am Crab**, chaotycznym, sandboksowym do\u015bwiadczeniu VR, w kt\u00f3rym nie grasz bohatera\u2026 jeste\u015b krabem. U\u017cywaj swoich d\u0142oni VR jako pot\u0119\u017cnych szczypiec, aby chwyta\u0107, podnosi\u0107, rzuca\u0107 i wchodzi\u0107 w interakcj\u0119 ze \u015bwiatem wok\u00f3\u0142 Ciebie.\n{1473427184562556}\n\n# \ud83e\udd80 Prawdziwa wolno\u015b\u0107 w sandboksowej grze\nOdkrywaj t\u0119tni\u0105c\u0105 \u017cyciem wysp\u0119 pla\u017cow\u0105 z pe\u0142n\u0105 swobod\u0105. Dotykaj, poruszaj i eksperymentuj z obiektami w pe\u0142ni sterowanymi fizyk\u0105 w interaktywnym placu zabaw VR. {1870410746934496}\n{1263170398567740}\n\n# \ud83e\udd80 R\u00f3b, co chcesz\nPrze\u017cyj swoje najlepsze krabie \u017cycie \u2014 r\u00f3b zdj\u0119cia, organizuj imprezy taneczne, odkrywaj ukryte miejsca lub po prostu w\u0119druj po wyspie. Nie ma ogranicze\u0144 co do Twojej gry.\n{1934727460494145}\n\n# \ud83e\udd80 Pe\u0142na aktywno\u015bci\nWykonuj zabawne misje na pla\u017cy i mini-wyzwania rozsiane po ca\u0142ej wyspie. Ka\u017cde zadanie oferuje nowe interakcje i nieoczekiwane rezultaty.\n{1245044894484159}\n\n# \ud83e\udd80 Interakcja z pazurami oparta na fizyce\nDo\u015bwiadcz realistycznej mechaniki pazur\u00f3w VR opartej na fizyce. Ka\u017cde chwycenie, rzucenie i zderzenie wydaje si\u0119 naturalne, ci\u0119\u017ckie i satysfakcjonuj\u0105ce.\n{1234549054991911}\n\n# \ud83e\udd80 Denerwuj mieszka\u0144c\u00f3w wyspy\nSkradaj si\u0119, przerywaj czynno\u015bci i prowokuj zabawne reakcje postaci niezale\u017cnych (NPC). Dra\u017cnij, r\u00f3b psikusy i wywo\u0142uj k\u0142opoty \u2014 bo jeste\u015b krabem.\n{950422664309604}", "short_description": "I Am Crab to chaotyczne sandboxowe do\u015bwiadczenie VR, w kt\u00f3rym \u017cyjesz \u017cyciem psotnego kraba pla\u017cowego. U\u017cywaj opartych na fizyce szczypiec, aby chwyta\u0107, rzuca\u0107 i wchodzi\u0107 w interakcje ze wszystkim wok\u00f3\u0142 siebie. Eksploruj t\u0119tni\u0105c\u0105 \u017cyciem wysp\u0119, wykonuj zabawne mini-misje, denerwuj NPC-\u00f3w, rozpoczynaj imprezy taneczne i tw\u00f3rz przezabawny chaos w w pe\u0142ni interaktywnym placu zabaw VR, gdzie \u015bwiat reaguje na ka\u017cdy tw\u00f3j ruch."}, {"images": {"nodes": []}, "id": "1544901130541492", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Crab", "keywords": ["simulator", "job", "mission"], "long_description": "# \ud83e\udd80 Juega como un cangrejo\n\nPonte en las pinzas de un travieso cangrejo playero en I Am Crab. Aqu\u00ed no te limitas a *jugar* con un cangrejo... I Am Crab, y este es mi mundo! Usa tus manos de RV como poderosas pinzas para agarrar, levantar, lanzar e interactuar con todo lo que te rodea.\n\n{1606267067137834}\n\n# \ud83e\udd80 Haz lo que quieras\nVive tu mejor vida de cangrejo: toma fotos, organiza fiestas de baile, explora rincones ocultos o simplemente recorre la isla. No hay l\u00edmites para la forma en que juegas.\n{1014393051017929}\n\n# \ud83e\udd80 Desata un caos divertido\nDerriba objetos, interact\u00faa con los PNJ y observa c\u00f3mo se desarrollan reacciones din\u00e1micas. La isla responde a tus acciones, a veces de formas hilarantes.\n{2026851191255676}\n\n# \ud83e\udd80 Repleto de actividades\nCompleta divertidas misiones playeras y minidesaf\u00edos repartidos por toda la isla. Cada tarea ofrece nuevas interacciones y resultados inesperados.\n{2049014085680053}\n\n# \ud83e\udd80 Interacci\u00f3n de garra basada en la f\u00edsica\n\nExperimenta mec\u00e1nicas de garra realistas en realidad virtual, impulsadas por la f\u00edsica. Cada agarre, lanzamiento y colisi\u00f3n se siente natural, con peso y satisfactorio.\n{1794370598226538}\n\n# \ud83e\udd80 Molesta a los isle\u00f1os\nAc\u00e9rcate sigilosamente, interrumpe sus actividades y provoca reacciones divertidas en los NPC. Burla, haz travesuras y arma alboroto... \u00a1porque eres un cangrejo!\n\n{1938101333511231}", "short_description": "I Am Crab es una ca\u00f3tica aventura sandbox de realidad virtual en la que te desplazas, agarras y lanzas todo lo que encuentras a tu paso... \u00a1porque eres un cangrejo! Explora una isla vibrante, completa minisiones hilarantes, molesta a los PNJ, organiza fiestas de baile de cangrejos y desata un caos desenfrenado en un mundo que reacciona ante cada zarpazo de tus pinzas."}, {"images": {"nodes": []}, "id": "1033099639280774", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Crab", "keywords": ["simulator", "job"], "long_description": "# \ud83e\udd80 Juega como un cangrejo\nPonte en las pinzas de un travieso cangrejo playero en I Am Crab. Aqu\u00ed no solo *juegas* a ser un cangrejo... \u00a1 Soy un cangrejo, y este es mi mundo! Usa tus manos en realidad virtual como potentes pinzas para agarrar, levantar, lanzar e interactuar con todo lo que te rodea.\n\n{1012304104816349}\n\n# \ud83e\udd80 Aut\u00e9ntica libertad de *sandbox*\nExplora una animada isla playera con total libertad. Toca, mueve y experimenta con objetos regidos completamente por la f\u00edsica en un patio de juegos interactivo en realidad virtual.\n{2739352789791003}\n\n# \ud83e\udd80 Haz lo que quieras\nVive tu mejor vida de cangrejo: toma fotos, monta fiestas de baile, explora rincones ocultos o simplemente deambula por la isla. No hay l\u00edmites en la forma en que juegas.\n{4482587435358424}\n\n# \ud83e\udd80 Crea un caos divertido\nTira cosas, molesta a los PNJ y observa c\u00f3mo se desarrollan reacciones din\u00e1micas. La isla responde a tus acciones, a veces de formas hilarantes.\n{1545934197252645}\n\n# \ud83e\udd80 Repleto de actividades\nCompleta divertidas misiones playeras y minidesaf\u00edos dispersos por toda la isla. Cada tarea ofrece nuevas interacciones y resultados inesperados.\n{2061440478086430}\n\n# \ud83e\udd80 Interacci\u00f3n con pinzas basada en la f\u00edsica\nExperimenta mec\u00e1nicas realistas de pinzas en realidad virtual, impulsadas por la f\u00edsica. Cada agarre, lanzamiento y colisi\u00f3n se siente natural, con peso y satisfactorio.\n{2122161581661081}\n\n# \ud83e\udd80 Molesta a los isle\u00f1os\nAc\u00e9rcate sigilosamente, interrumpe actividades y provoca reacciones graciosas en los PNJ. Burla, haz bromas y arma alboroto... \u00a1porque eres un cangrejo!\n{993904649702495}", "short_description": "I Am Crab es una ca\u00f3tica aventura sandbox de realidad virtual en la que te desplazas, agarras y lanzas todo lo que encuentras a tu paso... \u00a1porque eres un cangrejo! Explora una isla vibrante, completa minisiones hilarantes, molesta a los PNJ, organiza fiestas de baile de cangrejos y desata un caos desenfrenado en un mundo que reacciona ante cada zarpazo de tus pinzas."}, {"images": {"nodes": [{"file_name": "1440_1440 (4).png", "id": "26786200901031901", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618254_26786200907698567_4638728702713548559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrwbe1AGzXYQ7kNvwG1FKAl&_nc_oc=Adqlylwr8kcf4B0pH42beVnn84d8hfKFV-Bus1wtavSZfcfEaLIlDhtlTH_gQouhIac&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qwIrwaaFJHzsY8-OZI_lcOAE1OPNxYRYSmXreHzUWHA&oe=6A2BFDEF"}, {"file_name": "1008_1440 (3).png", "id": "3913556302114593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618938_3913556305447926_676828394661470572_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRUmkcVgEdwQ7kNvwHCqPHw&_nc_oc=AdqAx2MNfuD7TRNR6tIC0vwiUwLg9p9rDYO96csPGwOZ1QOSLsnEaorK_HLKRTo2hSU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Dre9hhQAz7C6dQ5VVPLO35uxER9eXTaa9ac96vq2eHw&oe=6A2C2979"}, {"file_name": "512_512 (7).png", "id": "1936081247045581", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618444_1936081250378914_5004641689981624446_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vKS2J2lXJAQ7kNvwGqMsvx&_nc_oc=Adq0_yW9MqaCQDmM9ebAOswVytpcA_EOiBJJxhI8Upq1MB8ogazzSr-9aMm-g14g0lk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7HeDMnZ__NjW7wTrkQQr0k2lzqUU5wPC1DOb0M0l9oA&oe=6A2C1C50"}, {"file_name": "2560_1440 (10).png", "id": "1473417104253774", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499310731_1473417107587107_5318420836202470131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cD1eFhKjXu0Q7kNvwEV_PfF&_nc_oc=AdrJx8ckpSq8gB31aOh4NDk7kjQUyHVeMHqzXJngmqVvFFWKNe1y0ATEsf62Si_4XXs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CXNiABAuE3IPKazh1D3iTqy_BeuL1tpFMhfBjoOfc9g&oe=6A2C229A"}, {"file_name": "3000_900 (3).png", "id": "984059200736467", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499304106_984059204069800_2742859493548255313_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlL6CLXI5M4Q7kNvwGGDf9A&_nc_oc=AdrHlSm3GXzN0V-Va3Hv8xm6xJc03yWS5liFO9Y6Iy50BMhUwOwjzAYIpC5P5OUayAU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h0nTmndidFmHdmPwGLJF38zDxEOalQTsUlLRl47_JgQ&oe=6A2BFF95"}]}, "id": "876125792185561", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Crab", "keywords": ["Abenteuer", "Insel", "Mission", "Simulator", "Job"], "long_description": "# \ud83e\udd80 Spiele als Krabbe\nWillkommen bei **I Am Crab**, einem chaotischen VR-Sandbox-Erlebnis, in dem du nicht der Held bist \u2026 du bist die Krabbe. Nutze deine VR-H\u00e4nde als m\u00e4chtige Scheren, um zu greifen, anzuheben, zu werfen und mit der Welt um dich herum zu interagieren.\n{1439006054584882}\n\n# \ud83e\udd80 Wahre Sandbox-Freiheit\nErkunde eine lebendige Strandinsel mit v\u00f6lliger Freiheit. Ber\u00fchre, bewege und experimentiere mit physikbasierten Objekten in einem interaktiven VR-Spielplatz.\n{762438906660106}\n\n# \ud83e\udd80 Mach, was du willst! \nLebe dein bestes Krabbenleben \u2013 mach Fotos, veranstalte Tanzpartys, erkunde versteckte Orte oder streife einfach \u00fcber die Insel. Dein Spielspa\u00df ist grenzenlos.\n{2128051881383844}\n\n# \ud83e\udd80 Sorge f\u00fcr lustiges Chaos!\n Wirf Dinge um, \u00e4rgere NPCs und erlebe dynamische Reaktionen. Die Insel reagiert auf deine Aktionen \u2013 manchmal auf urkomische Weise.\n{895501339913272}\n\n# \ud83e\udd80 Voller Aktivit\u00e4ten! \nSchlie\u00dfe lustige Strandmissionen und Mini-Herausforderungen ab, die \u00fcber die ganze Insel verteilt sind. Jede Aufgabe bietet neue Interaktionen und unerwartete Ergebnisse.\n{1450727716750998}\n\n# \ud83e\udd80 Physikbasierte Greifer-Interaktion! \nErlebe realistische VR-Greifer-Mechanik, die auf Physik basiert. Jeder Griff, Wurf und Zusammensto\u00df f\u00fchlt sich nat\u00fcrlich, wuchtig und befriedigend an.\n{937928568598080}\n\n# \ud83e\udd80 \u00c4rgere die Inselbewohner\nSchleiche dich an, unterbrich ihre Aktivit\u00e4ten und provoziere lustige Reaktionen der NPCs. Necke sie, spiele ihnen Streiche und stifte Unruhe \u2013 denn du bist eine Krabbe.\n\n{2832876440397465}", "short_description": "I Am Crab ist ein chaotisches Sandbox-VR-Erlebnis, in dem du das Leben einer frechen Strandkrabbe lebst. Greife, wirf, erkunde und sorge f\u00fcr herrliches Chaos auf einer lebendigen Insel, auf der die Welt auf jede deiner Aktionen reagiert."}, {"images": {"nodes": [{"file_name": "1008_1440 (3).png", "id": "2357652864723072", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623345_2357652868056405_4997861184166173672_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrHjD1xhjvMQ7kNvwEWSfqY&_nc_oc=AdpzXiTLIStFkDa3QcUAbxXZBpoDNjlH9cDJUD7DD5SanZEoNfpUh29BYkUQlfmiSyo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HQMb65re_woIEMaPNW3tEWKZEpPQoTzW626TdU-BCdA&oe=6A2C1917"}, {"file_name": "512_512 (7).png", "id": "2276402399550039", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620504_2276402402883372_9173725150151932537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZZ-aGXftqoQ7kNvwGit749&_nc_oc=AdoXkyWmKYQ83gGHEAUiTG8bl_ixKylMWdI6d1UbjZ7HNmu6rFkd0_5baqPnxnfP7Pc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Md4R_pGkrBMmJGAv5eOE6JxLKUfuPHVM_LX5fOCasw&oe=6A2C157E"}, {"file_name": "2560_1440 (10).png", "id": "2210051566427248", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618284_2210051569760581_2301553600752986591_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rxt7PS2Ll6sQ7kNvwE0_Snm&_nc_oc=AdqrJOtfeXRM3QXKIG0x2Bmz8sOmfrIa3HzXaoQhVLKE150k5Q9BsUjpTgjzPC3bayU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JgX9aSjC8G0jBnmEDTnnjZANp8giEs45maj8WDjUW_w&oe=6A2C0859"}, {"file_name": "3000_900 (3).png", "id": "1248833410566957", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618264_1248833413900290_5240180500334921117_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uD1PAN0ruBgQ7kNvwHDX7qT&_nc_oc=Adp8a1HIo6wsal80idofEtTMdmUD4QmJpX-NsN8TF2N9Y-6cOKMFwMn7B00E84qq-rw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80bgFWOzkCh9bi171vZz8GO7spY1JPCHs-MYTJKIEfaQ&oe=6A2C2327"}, {"file_name": "1440_1440 (4).png", "id": "980171531247692", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499304131_980171534581025_938074517669647016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKY7h_3MfdEQ7kNvwEEjUqI&_nc_oc=AdrM0591tykfxBcsd5lVvSC5s3yU7mFjwT2v7EfeIdqxtk3eSiaTtFsdTKIcVgrk-XI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vBtbedR5jM6MzrBdLjU-8yqYTWK5GhOszL7EHdpUYlA&oe=6A2C1E9B"}]}, "id": "841993711857589", "locale": "en_US", "screenshots": [{"file_name": "Crab claw.png", "id": "4513948782172550", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499312310_4513948785505883_7137350221975921502_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbtuCXd7o8MQ7kNvwGhXgtf&_nc_oc=AdodmMfPiUVBIQmhBH0lVWodWZAV7gL69Hsczr8XzaQYY_tUnqlytHVQdiI7sJkV4JU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QAIf9OWQ9UG6xVlQwFc4n5GaFlsvKMhtoBtDgbY7CXQ&oe=6A2C2B42"}, {"file_name": "Carb SS114.png", "id": "1889478978602822", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821099_1889478988602821_6230537918678311012_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srdNlTLJ2Q4Q7kNvwHUaYWU&_nc_oc=AdqdBHReQfT1b8iF6S2Xk-hm6OGRqb4RM0rpaKvf79lx5MCBPDgo_iehcJ3LCXXpO5Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90SGsqiiCxg4icxHJTkEKYpm55tSzNkLRhlW75X4h5_g&oe=6A2C0711"}, {"file_name": "Carb SS13.png", "id": "4500320060199167", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827585_4500320063532500_533146387973958699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG14AlTpx_EQ7kNvwEiM4tE&_nc_oc=AdpkP96dfkfZdmjZkYw1QbNFTy0kwq5UULsgR0UvAMBR2Y_c2cBxgbLRkBx2u2HMcEA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KV-v77Lesvb87YDESZ_OSWgxUA8OIQHWIR2xkJOplaA&oe=6A2C2198"}, {"file_name": "Carb SS12.png", "id": "1435384034869141", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823341_1435384038202474_5531164299316901953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9qOWHdJbwAQ7kNvwHTRTk2&_nc_oc=AdrmwI1O6FVvHwtZ-lvyp0rqiyNJyN3oLz3JoNS-dij7JE5nXyjTRHv4oCY4gZ4gUfY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UayKEsg-bWKPKao8b6jMj9IMWQ5mm90ewripbG5LdEw&oe=6A2C14A3"}, {"file_name": "Carb SS.png", "id": "1238481665097026", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823279_1238481671763692_2173012281129207439_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNv7yJv59MMQ7kNvwGsQsl7&_nc_oc=AdpVhS74mH5lhi6l_vhzOR7UUFZaqTNo4VDv0f7iMRqlv7k80VvlZQDJm3UTi-gjvBc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98IOJHOUadPHD10zwKxDhk9FLppHrnKEBSIA_uJf4Juw&oe=6A2C1082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440 (10).png", "id": "2196009654568806", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499623400_2196009657902139_5315752943921706951_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48TXN_aGEQ8Q7kNvwHCfveC&_nc_oc=AdpELbJSfL8O5z8zIIlbUZxWb4cIr3nUeqc7qpmnWHUDpGuBqcRANCSuM-2OYj420fk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bV7ZMh2QE1Okt76HgNWtPWfmQCD0Y5KHZ1kgHfTi87g&oe=6A2C0358"}, "display_name": "I Am Crab", "keywords": ["adventure", "Island", "mission", "simulator", "job"], "long_description": "# \ud83e\udd80 Play as a Crab\nStep into the claws of a mischievous beach crab in **I Am Crab**. Here, you don\u2019t just play the crab\u2026 **I Am Crab**, and this is my world! Use your VR hands as powerful claws to grab, lift, throw, and interact with everything around you.\n\n{1230119845972244}\n\n# \ud83e\udd80 True Sandbox Freedom\nExplore a lively beach island with complete freedom. Touch, move, and experiment with fully physics-driven objects in an interactive VR playground.\n{1870410746934496}\n\n# \ud83e\udd80 Do Whatever You Want\nLive your best crab life \u2014 take photos, start dance parties, explore hidden spots, or just roam the island. There are no limits to how you play.\n{1233720542241584}\n\n# \ud83e\udd80 Create Fun Chaos\nKnock things over, mess with NPCs, and watch dynamic reactions unfold. The island responds to your actions \u2014 sometimes in hilarious ways.\n{1222883546720694}\n\n# \ud83e\udd80 Packed with Activities\nComplete fun beach missions and mini-challenges scattered across the island. Every task offers new interactions and unexpected outcomes.\n{2179752836166157}\n\n# \ud83e\udd80 Physics-Based Claw Interaction\nExperience realistic VR claw mechanics powered by physics. Every grab, throw, and collision feels natural, weighty, and satisfying.\n{1453155403184702}\n\n# \ud83e\udd80 Annoy the Islanders\nSneak up, interrupt activities, and provoke funny NPC reactions. Tease, prank, and stir up trouble \u2014 because you\u2019re a crab.\n\n{1392107025552767}", "short_description": "I Am Crab is a chaotic sandbox VR adventure where you scuttle, grab, and fling everything in your path because I Am Crab! Explore a lively island, complete hilarious mini-missions, annoy NPCs, start crab dance parties, and create wild chaos in a world that reacts to every claw swipe.\n\nClimb walls, squeeze through tight spaces, and discover hidden secrets because I Am Crab, and nothing can stop me! Fling objects, cause mischief, and show everyone that I am crab in a fully interactive playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMF
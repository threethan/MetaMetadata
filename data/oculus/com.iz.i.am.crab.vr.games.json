wFZImdv&_nc_oc=AdqEQJjLq7QA7ZmOwzD2YZDwWovSWyjMRpUHRl-cjTwetmiReyY0Mq9DgItk0jA5jQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNgjkm74WNjrahZDzMabQvXe5jttaSil4mQw7unHcmng&oe=69CD18EC"}, {"file_name": "Carb SS13.png", "id": "1323321079634106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_1323321082967439_7799448672024372703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsiHcGw2mmoQ7kNvwFY4fAg&_nc_oc=AdqG8I_xosa2t2QwwT4L4XQkd7LxxnuY401zQZafG2eAFDjVGM-Z4AgUXDlTzWcQpgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJkxQI5C73sij2VA9LYswlbKwMXrsxhDpk-G8MBlb5_A&oe=69CD1F09"}, {"file_name": "Carb SS12.png", "id": "1567970714317473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_1567970717650806_4639081852162705204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM0DyfB8dhgQ7kNvwH3fy4j&_nc_oc=AdozqM-R7kOrMfl0j_XcZzQKTqLXDVchYCZFTErsBuvhtRz3iu3M0DNbFgdAgYTXEu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0WZvIuByMiFS6EPe-qVgvgIZC91xyth37GRYM4idEUw&oe=69CD0C08"}, {"file_name": "Carb SS.png", "id": "4190354621277233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_4190354627943899_481061455826641147_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9LBF1cneoIQ7kNvwF6LFJF&_nc_oc=AdpGvpUfn5vVKBumc0nolXqpdWyWv0IC64U1-bz8gI5hStmq0Cx7aZIvrRB4Dg9hJwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymscVi46xyus7Ljc0JRcEnJsZq2BvJ8jjS9KPQS5ntzw&oe=69CCFFCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1518528462975253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_1518528469641919_2254797365803894625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiHhl85o8rsQ7kNvwEqtPt5&_nc_oc=AdrTPOxa-NZ3g4olgMlmfC5FBvg-bXHC7bkPrk-Xa1RSf1lMyrO2SXGl4AMKlQMloRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWISeQlDmCgza5aY5Df7FPoS4gzmbniZxy-PvbIST9kw&oe=69CD03EC"}, "display_name": "I Am Crab", "keywords": ["adventure", "Island", "mission", "simulator", "job"], "long_description": "# \ud83e\udd80 Play as a Crab\nWelcome to **I Am Crab** a chaotic sandbox VR experience where you don\u2019t play the hero\u2026 you are the crab. Use your VR hands as powerful claws to grab, lift, throw, and interact with the world around you.\n\n{1580264889911789}\n\n# \ud83e\udd80 True Sandbox Freedom\nExplore a lively beach island with complete freedom. Touch, move, and experiment with fully physics-driven objects in an interactive VR playground.\n\n{942062721840660}\n\n# \ud83e\udd80 Do Whatever You Want\nLive your best crab life \u2014 take photos, start dance parties, explore hidden spots, or just roam the island. There are no limits to how you play.\n{898413533038599}\n\n# \ud83e\udd80 Create Fun Chaos\nKnock things over, mess with NPCs, and watch dynamic reactions unfold. The island responds to your actions \u2014 sometimes in hilarious ways.\n{897675433131868}\n\n# \ud83e\udd80 Packed with Activities\nComplete fun beach missions and mini-challenges scattered across the island. Every task offers new interactions and unexpected outcomes.\n{26193085766998595}\n\n# \ud83e\udd80 Physics-Based Claw Interaction\nExperience realistic VR claw mechanics powered by physics. Every grab, throw, and collision feels natural, weighty, and satisfying.\n{865148156498424}\n\n# \ud83e\udd80 Annoy the Islanders\nSneak up, interrupt activities, and provoke funny NPC reactions. Tease, prank, and stir up trouble \u2014 because you\u2019re a crab.\n{1547957586313711}", "short_description": "I Am Crab is a chaotic sandbox VR experience where you live the life of a mischievous beach crab. Use physics-based claws to grab, throw, and interact with everything around you. Explore a vibrant island, complete fun mini-missions, annoy NPCs, start dance parties, and create hilarious chaos in a fully interactive VR playground where the world reacts to your every move."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26472869435641262"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_3978055622449737_8122089896018969238_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4ZGyo3GRG8Q7kNvwE8usqJ&_nc_oc=Adpstz31mHLoMb2eBq6cDbWp3oHBLzI4kwV65w3d01JXak01SKmMDfo3H7o4jhXag4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRLknIxzpAjhR1KpEpxH0TRNGDzbX3Tq5Ul850IPm-Qg&oe=69CD23C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Crab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1771386840, "lastRevision": {"nodes": [{"id": "25906867555574789", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"
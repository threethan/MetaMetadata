id": "4500320060199167", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827585_4500320063532500_533146387973958699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iC4B6rKxsPQQ7kNvwGdy6j_&_nc_oc=AdrqPFEdAVLeXXw3Yc0FqJ1DGwkuMeta3IU1In-l8NJW2B15B4r_ayCRhWLNuAP8bOE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSeV5NZ0ETe444aRM5VyoA9AZoFcGeUwlB7AGDC5EXRQ&oe=6A82EC58"}, {"file_name": "Carb SS12.png", "id": "1435384034869141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_1435384038202474_5531164299316901953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8X9XfITDhQQ7kNvwH6a-Ao&_nc_oc=Adp_jVpaWczI73i5g2VOmmOtpoUfz8Q8KuEdSBzwJePgMXAGZXcM5i9ji3lVApZ0iHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnDOp8mZ6kC6uCab5-cK6suSoap3nY3OYcKvNp5oCmQg&oe=6A8317A3"}, {"file_name": "Carb SS.png", "id": "1238481665097026", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_1238481671763692_2173012281129207439_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6YKFCzNsSQQ7kNvwFXzRvX&_nc_oc=AdpPvkfWUMFNCWJvYg_stq0zVUcF_dye_jBH5jbNNDrXK73uri_8Iwys6JYmBpAQ-cg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeazsQ4iKleAbpu6wK6LkpYcF3KhC-GHgQh9D9HnFwYA&oe=6A831382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440 (2).png", "id": "2053024175267627", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821782_2053024178600960_4697228775114001578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9xG2iuSAjcQ7kNvwEez_f7&_nc_oc=Adq0aA9I9oydhd4XyoiUasrgY8wqUJoia12siw1FGA7LTJIzc9tT23RMgfkodVSq63w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOFu1zkXJw1gairAw98bbav28E1_5Q2s5yeL7SjbNodw&oe=6A830894"}, "display_name": "I Am Crab", "keywords": ["adventure", "Island", "mission", "simulator", "job"], "long_description": "# \ud83e\udd80 Play as a Crab\nWelcome to **I Am Crab** a chaotic sandbox VR experience where you don\u2019t play the hero\u2026 you are the crab. Use your VR hands as powerful claws to grab, lift, throw, and interact with the world around you.\n\n{1230119845972244}\n\n# \ud83e\udd80 True Sandbox Freedom\nExplore a lively beach island with complete freedom. Touch, move, and experiment with fully physics-driven objects in an interactive VR playground.\n{1870410746934496}\n\n# \ud83e\udd80 Do Whatever You Want\nLive your best crab life \u2014 take photos, start dance parties, explore hidden spots, or just roam the island. There are no limits to how you play.\n{1233720542241584}\n\n# \ud83e\udd80 Create Fun Chaos\nKnock things over, mess with NPCs, and watch dynamic reactions unfold. The island responds to your actions \u2014 sometimes in hilarious ways.\n{1222883546720694}\n\n# \ud83e\udd80 Packed with Activities\nComplete fun beach missions and mini-challenges scattered across the island. Every task offers new interactions and unexpected outcomes.\n{2179752836166157}\n\n# \ud83e\udd80 Physics-Based Claw Interaction\nExperience realistic VR claw mechanics powered by physics. Every grab, throw, and collision feels natural, weighty, and satisfying.\n{1453155403184702}\n\n# \ud83e\udd80 Annoy the Islanders\nSneak up, interrupt activities, and provoke funny NPC reactions. Tease, prank, and stir up trouble \u2014 because you\u2019re a crab.\n\n{1392107025552767}", "short_description": "I Am Crab is a chaotic sandbox VR experience where you live the life of a mischievous beach crab. Use physics-based claws to grab, throw, and interact with everything around you. Explore a vibrant island, complete fun mini-missions, annoy NPCs, start dance parties, and create hilarious chaos in a fully interactive VR playground where the world reacts to your every move."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "h
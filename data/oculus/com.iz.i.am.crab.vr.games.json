c_oc=AdrmwI1O6FVvHwtZ-lvyp0rqiyNJyN3oLz3JoNS-dij7JE5nXyjTRHv4oCY4gZ4gUfY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UayKEsg-bWKPKao8b6jMj9IMWQ5mm90ewripbG5LdEw&oe=6A2C14A3"}, {"file_name": "Carb SS.png", "id": "1238481665097026", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823279_1238481671763692_2173012281129207439_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNv7yJv59MMQ7kNvwGsQsl7&_nc_oc=AdpVhS74mH5lhi6l_vhzOR7UUFZaqTNo4VDv0f7iMRqlv7k80VvlZQDJm3UTi-gjvBc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98IOJHOUadPHD10zwKxDhk9FLppHrnKEBSIA_uJf4Juw&oe=6A2C1082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440 (2).png", "id": "2053024175267627", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821782_2053024178600960_4697228775114001578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvYi_vpOjVQQ7kNvwG0Bgw8&_nc_oc=Adri2Y0sDywp0bGgThMTJYK99xp8davl6VWyexJEunxDUplDtU-Awcb5CUBSlYollyg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xu1i93W18iyyOZWXF-6j_pJr9nzFEMvVD02lNPkVcCw&oe=6A2C0594"}, "display_name": "I Am Crab", "keywords": ["adventure", "Island", "mission", "simulator", "job"], "long_description": "# \ud83e\udd80 Play as a Crab\nWelcome to **I Am Crab** a chaotic sandbox VR experience where you don\u2019t play the hero\u2026 you are the crab. Use your VR hands as powerful claws to grab, lift, throw, and interact with the world around you.\n\n{1230119845972244}\n\n# \ud83e\udd80 True Sandbox Freedom\nExplore a lively beach island with complete freedom. Touch, move, and experiment with fully physics-driven objects in an interactive VR playground.\n{1870410746934496}\n\n# \ud83e\udd80 Do Whatever You Want\nLive your best crab life \u2014 take photos, start dance parties, explore hidden spots, or just roam the island. There are no limits to how you play.\n{1233720542241584}\n\n# \ud83e\udd80 Create Fun Chaos\nKnock things over, mess with NPCs, and watch dynamic reactions unfold. The island responds to your actions \u2014 sometimes in hilarious ways.\n{1222883546720694}\n\n# \ud83e\udd80 Packed with Activities\nComplete fun beach missions and mini-challenges scattered across the island. Every task offers new interactions and unexpected outcomes.\n{2179752836166157}\n\n# \ud83e\udd80 Physics-Based Claw Interaction\nExperience realistic VR claw mechanics powered by physics. Every grab, throw, and collision feels natural, weighty, and satisfying.\n{1453155403184702}\n\n# \ud83e\udd80 Annoy the Islanders\nSneak up, interrupt activities, and provoke funny NPC reactions. Tease, prank, and stir up trouble \u2014 because you\u2019re a crab.\n\n{1392107025552767}", "short_description": "I Am Crab is a chaotic sandbox VR experience where you live the life of a mischievous beach crab. Use physics-based claws to grab, throw, and interact with everything around you. Explore a vibrant island, complete fun mini-missions, annoy NPCs, start dance parties, and create hilarious chaos in a fully interactive VR playground where the world reacts to your every move."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_t
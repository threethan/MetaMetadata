=00_Afym3BLSBQkpwCvuUV9zxafLyVL2Z8AMhLvqTg2rAde-Cw&oe=69CCFD58"}, {"file_name": "Carb SS12.png", "id": "1435384034869141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1435384038202474_5531164299316901953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDLud-K3EiMQ7kNvwFC-1tE&_nc_oc=AdqjSFu9nY-bh4O_MDycsd6uBRw5dBv6gK9H3ub1uLmnK-KdbNdAdiSGyk4gBpnApkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOzG2p_DSm9qeZVl0rtURxEL55dXPuOv-vHz77wTddFg&oe=69CD28A3"}, {"file_name": "Carb SS.png", "id": "1238481665097026", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_1238481671763692_2173012281129207439_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIeF9BjC9JYQ7kNvwGFSfVs&_nc_oc=AdrvXpuV4NRm9AQz4wPhMSc9sZ9cxOpjl6pwze9J9Ham_pW3v4jzAl6ay9RIPxjhQXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8HEvIA8yYzzXh-HID8dWlnQ0oR_-ha33psdY1eTr80A&oe=69CD2482"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440 (2).png", "id": "2053024175267627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_2053024178600960_4697228775114001578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7rROBgkni0Q7kNvwEQ-kCR&_nc_oc=AdpPJ42j6MmWhKBLM2Gd2BI5-GuLfyX9Q71rVO5b8rNABOHPdKfeCZmyF7cS1pkRKs0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCniXN0JvhiaN6o2A0_WLL-rFIsObzZ2rjOwVINHK0_w&oe=69CD1994"}, "display_name": "I Am Crab", "keywords": ["adventure", "Island", "mission", "simulator", "job"], "long_description": "# \ud83e\udd80 Play as a Crab\nWelcome to **I Am Crab** a chaotic sandbox VR experience where you don\u2019t play the hero\u2026 you are the crab. Use your VR hands as powerful claws to grab, lift, throw, and interact with the world around you.\n\n{1230119845972244}\n\n# \ud83e\udd80 True Sandbox Freedom\nExplore a lively beach island with complete freedom. Touch, move, and experiment with fully physics-driven objects in an interactive VR playground.\n{1870410746934496}\n\n# \ud83e\udd80 Do Whatever You Want\nLive your best crab life \u2014 take photos, start dance parties, explore hidden spots, or just roam the island. There are no limits to how you play.\n{1233720542241584}\n\n# \ud83e\udd80 Create Fun Chaos\nKnock things over, mess with NPCs, and watch dynamic reactions unfold. The island responds to your actions \u2014 sometimes in hilarious ways.\n{1222883546720694}\n\n# \ud83e\udd80 Packed with Activities\nComplete fun beach missions and mini-challenges scattered across the island. Every task offers new interactions and unexpected outcomes.\n{2179752836166157}\n\n# \ud83e\udd80 Physics-Based Claw Interaction\nExperience realistic VR claw mechanics powered by physics. Every grab, throw, and collision feels natural, weighty, and satisfying.\n{1453155403184702}\n\n# \ud83e\udd80 Annoy the Islanders\nSneak up, interrupt activities, and provoke funny NPC reactions. Tease, prank, and stir up trouble \u2014 because you\u2019re a crab.\n\n{1392107025552767}", "short_description": "I Am Crab is a chaotic sandbox VR experience where you live the life of a mischievous beach crab. Use physics-based claws to grab, throw, and interact with everything around you. Explore a vibrant island, complete fun mini-missions, annoy NPCs, start dance parties, and create hilarious chaos in a fully interactive VR playground where the world reacts to your every move."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
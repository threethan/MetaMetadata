060199167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827585_4500320063532500_533146387973958699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIeGu4rIDNkQ7kNvwFQGdXn&_nc_oc=AdrE6GZyD6RHbD6A8ey3dQA7TjMA4V2QcEvuuwrGZeJheXGyqKL5l4JSsK2YnPDtNNQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnk6yhiGvZxSQPopX9dVLy0vW6l2XljReKb_8XhNDH9g&oe=6A688E58"}, {"file_name": "Carb SS12.png", "id": "1435384034869141", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1435384038202474_5531164299316901953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZAAwOjbDQIQ7kNvwF8cPFO&_nc_oc=AdrIlqCaObjDntsHqcKA-JV6foohpFdrKDPswpoFZFNyqlN3rNaRfYWO9qPxBvBFxPA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEOXELs4SXqm5g0vA6fImaHU9CbzHPqO-XwuSE9d41pg&oe=6A68B9A3"}, {"file_name": "Carb SS.png", "id": "1238481665097026", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_1238481671763692_2173012281129207439_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBlb7lL9KMIQ7kNvwGY130u&_nc_oc=AdqfMfvvo-Nb4M2r9y5-0QX_KRXnimxpzOrHSiPe_NROw5qHm5w9o01tnXKi62upLt0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhz4XhaBgkM6vsQX0vEVz90tXDaYx14gC5jmcXtopMuA&oe=6A68B582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440 (2).png", "id": "2053024175267627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821782_2053024178600960_4697228775114001578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsZPEAGi7MIQ7kNvwFV3KXQ&_nc_oc=AdoO4LFmlSh9xG_TPCRqx38B0o6LJuJkgqyALpYprlHKAVrPahmQJmrM9M4I71MDWVg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxT8nSh-CiYUJS713Mw2C1N6xB06zyL7amNPTXxJ8lOg&oe=6A68AA94"}, "display_name": "I Am Crab", "keywords": ["adventure", "Island", "mission", "simulator", "job"], "long_description": "# \ud83e\udd80 Play as a Crab\nWelcome to **I Am Crab** a chaotic sandbox VR experience where you don\u2019t play the hero\u2026 you are the crab. Use your VR hands as powerful claws to grab, lift, throw, and interact with the world around you.\n\n{1230119845972244}\n\n# \ud83e\udd80 True Sandbox Freedom\nExplore a lively beach island with complete freedom. Touch, move, and experiment with fully physics-driven objects in an interactive VR playground.\n{1870410746934496}\n\n# \ud83e\udd80 Do Whatever You Want\nLive your best crab life \u2014 take photos, start dance parties, explore hidden spots, or just roam the island. There are no limits to how you play.\n{1233720542241584}\n\n# \ud83e\udd80 Create Fun Chaos\nKnock things over, mess with NPCs, and watch dynamic reactions unfold. The island responds to your actions \u2014 sometimes in hilarious ways.\n{1222883546720694}\n\n# \ud83e\udd80 Packed with Activities\nComplete fun beach missions and mini-challenges scattered across the island. Every task offers new interactions and unexpected outcomes.\n{2179752836166157}\n\n# \ud83e\udd80 Physics-Based Claw Interaction\nExperience realistic VR claw mechanics powered by physics. Every grab, throw, and collision feels natural, weighty, and satisfying.\n{1453155403184702}\n\n# \ud83e\udd80 Annoy the Islanders\nSneak up, interrupt activities, and provoke funny NPC reactions. Tease, prank, and stir up trouble \u2014 because you\u2019re a crab.\n\n{1392107025552767}", "short_description": "I Am Crab is a chaotic sandbox VR experience where you live the life of a mischievous beach crab. Use physics-based claws to grab, throw, and interact with everything around you. Explore a vibrant island, complete fun mini-missions, annoy NPCs, start dance parties, and create hilarious chaos in a fully interactive VR playground where the world reacts to your every move."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26256959630565578"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1358881836114952"}, {"status": "PUBLISHED", "id": "1878386436161825"}, {"status": "PUBLISHED", "id": "1593493445176388"}]}, "baseline_offer": {"id": "1878386436161825"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1358881836114952"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27926209553640569", "version": "0.1.0"}, "id": "1214367866691639", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25906867488908129", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27926209553640569"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1214367866691639"}]}, "change_log": null, "created_date": 1784032456, "id": "27926209553640569", "version": "0.1.0", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": 
uluscdn.com&_nc_ss=7f20f&oh=00_AQE-qk9DkNpM8K8hczMAzctnOr5jIGnbkvCjCWXHwDFenA&oe=6A903C8D"}, {"file_name": "3.png", "id": "232784524945964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75361348_232784528279297_6036885773619577034_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThDeGVXjPm8Q7kNvwG2JWc9&_nc_oc=Adqv_JJk4LEyhJLAc1YTDmQFU7C8N-AMtmsMKXC3_Jy0AJDIGMEZP_8m1Rx3ioefDpU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkQJ8uCMtJXj4wf2QI4gyl0quTIm00mNmFbd8IBhPQwg&oe=6A9039AB"}, {"file_name": "2.png", "id": "1119852311805212", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031545_1119852315138545_1387800435837134823_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqVkD84c44YQ7kNvwEBN6Hp&_nc_oc=Adq7YDcCkOd5es8XYQRFU6QTenjpg0wuSVohxBXilSu50rB4ExLEVZCyu4ncv3rz4cA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdm-D2mby11bkeZ6Kc2RkzTCc-XfhA8lmY114Kx1bZBw&oe=6A903B08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2517017418595817", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974542_2517017421929150_8334052531700065049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4t5Mg1lWr0Q7kNvwET_N0N&_nc_oc=AdrnvpIi99HsB8TLRd5k9W-LwFJTUt-UD7qgSTdIS43gJFRTR5tx8yacdwa6awb3sQE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWvZ-3bRBUOIPU2JGOBiy2cXmV_WsXQ96PnGgW9WOxTw&oe=6A902E20"}, "display_name": "Flight 74", "keywords": ["flight", "Sim", "Simulator", "Airplane", "Plane"], "long_description": "Experience a new genre of Flight Simulator.  \nDo you have what it takes to survive and become the ultimate pilot?\nRun missions for the South American Cartel and prove your worthiness.  \n\nFlight 74 features beautiful graphics that push the device to the limit!  Every aspect of Flight 74 has been developed and optimized from the ground up.  Explore vast landscapes that include trees, grass, rocks, buildings, airports, cars, and more. \n\nFeatures:\n- Realistic flight physics\n- Interactive cockpit.  Flip switches, press buttons, manipulate levers\n- Incredible graphics and details that squeeze every ounce of power out of the device\n- Movie style campaign and missions\n- 7 Airports and over 2,000 square miles of scenery\n- Free Flight Mode\n- And so much more!", "short_description": "Experience a new genre of Flight Simulator.  \nDo you have what it takes to survive and become the ultimate pilot?\nRun missions for the South American Cartel and prove your worthiness.  \n\nFlight 74 features beautiful graphics that push the device to the limit!  Every aspect of Flight 74 has been developed and optimized from the ground up.  Explore vast landscapes that include trees, grass, rocks, buildings, airports, cars, and more. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/ybrzqqs5c95a91z/privacy.html?dl=0", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "http://www.tasappsystems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631712138104781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974517_303612417429364_5385601985955261279_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZleWrt_fNTAQ7kNvwGE9X4s&_nc_oc=AdpNUGOrqzrxdgRGg06j5PVxk1R-Q6_nNA2wg0hOf6GJSLjeGxQ1g
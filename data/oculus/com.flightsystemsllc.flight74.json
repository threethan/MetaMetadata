uluscdn.com&_nc_ss=7f20f&oh=00_Af_5umPlP76Vgs9Ehk5aqXK3TTFkcQ-t6MXDIqqbKuR7rA&oe=6A29678D"}, {"file_name": "3.png", "id": "232784524945964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361348_232784528279297_6036885773619577034_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tosquJlMHccQ7kNvwGJb8Sy&_nc_oc=AdqM5l7b4nSLkAU8eJr0HIgqlQNwYwEiyuZnE3LTw4FHnHPjpoj-yD41mLAXCkI5_X8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gf1lrMqOD6wEjE4-HD066-CX-v9qna3XVToMan_MEkQ&oe=6A2964AB"}, {"file_name": "2.png", "id": "1119852311805212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031545_1119852315138545_1387800435837134823_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPvnfZNMwoYQ7kNvwFJZFZv&_nc_oc=AdqkeptGcdXlRwOxpaZWdwBsA7aIkTjJiSMiRYcrDlFiuIS3V-H9DSUEpRY9Ffc9axQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fs99vinAoJEjie9WSzP1PY_QSKNJweXWXvFs7r_wgUw&oe=6A296608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2517017418595817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974542_2517017421929150_8334052531700065049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ho-wEhIL7-IQ7kNvwGxbZoF&_nc_oc=AdqeH8itZVogbuOlZpQ-brMMQU4_38NKL56vtQ-u5yHqiX1lk0HtLBY3kl1Wl3jQSug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CjbZrd2QYtMDGmonQYCdr-BwkOfQIo9bkUA0yHU6wtQ&oe=6A295920"}, "display_name": "Flight 74", "keywords": ["flight", "Sim", "Simulator", "Airplane", "Plane"], "long_description": "Experience a new genre of Flight Simulator.  \nDo you have what it takes to survive and become the ultimate pilot?\nRun missions for the South American Cartel and prove your worthiness.  \n\nFlight 74 features beautiful graphics that push the device to the limit!  Every aspect of Flight 74 has been developed and optimized from the ground up.  Explore vast landscapes that include trees, grass, rocks, buildings, airports, cars, and more. \n\nFeatures:\n- Realistic flight physics\n- Interactive cockpit.  Flip switches, press buttons, manipulate levers\n- Incredible graphics and details that squeeze every ounce of power out of the device\n- Movie style campaign and missions\n- 7 Airports and over 2,000 square miles of scenery\n- Free Flight Mode\n- And so much more!", "short_description": "Experience a new genre of Flight Simulator.  \nDo you have what it takes to survive and become the ultimate pilot?\nRun missions for the South American Cartel and prove your worthiness.  \n\nFlight 74 features beautiful graphics that push the device to the limit!  Every aspect of Flight 74 has been developed and optimized from the ground up.  Explore vast landscapes that include trees, grass, rocks, buildings, airports, cars, and more. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/ybrzqqs5c95a91z/privacy.html?dl=0", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "http://www.tasappsystems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631712138104781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_303612417429364_5385601985955261279_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpccMN2cWYwQ7kNvwHi6oDc&_nc_oc=Ado69byxAa1o8qiepJDuXBDDUyBRwxJsue_1yRw4LLWfvyfOFd0vQ
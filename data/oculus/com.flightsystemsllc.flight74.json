uluscdn.com&_nc_ss=7f20f&oh=00_AQOBxGoOKYafLtQbr6baxAlMBGPIlkYtXWDWdkTfKNpmwg&oe=6ACF848D"}, {"file_name": "3.png", "id": "232784524945964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75361348_232784528279297_6036885773619577034_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEbricrja0AQ7kNvwHjmxhz&_nc_oc=Adqifyj2ErKQP2ogiTnfL-A59mGk13Qw04eqD-3GhS0BOr0Md6VWfO7gZEARcD72uug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODCywmzHyur6LQ8W2CFkEACJTWFtP5T5RRKXcQJQvqSA&oe=6ACF81AB"}, {"file_name": "2.png", "id": "1119852311805212", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031545_1119852315138545_1387800435837134823_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCB-7IvCqy4Q7kNvwHOUKR7&_nc_oc=Adr54oRXFe-SMS7oytsfcmbmKNzBT9b3NRN_BmWmYh2ragjbS7ROqMzvwG_2kIM-Vr0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNecpJO2G1XS-8abr9WC-y36g6JI7NH_khqoOAXRQ6PHg&oe=6ACF8308"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2517017418595817", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974542_2517017421929150_8334052531700065049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjWrBs_WgVMQ7kNvwGosATy&_nc_oc=Adqg1F85ny-5K0mHpuOmBsIRTtdWTSlmz8MKHtg5nSvfq7DfI91XyJ-4XoyS7tdTgt4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd8pm2hiOvhg7xHWq9e4RqlVJdQXBjgEZYKICd6_5Nfg&oe=6ACFAE60"}, "display_name": "Flight 74", "keywords": ["flight", "Sim", "Simulator", "Airplane", "Plane"], "long_description": "Experience a new genre of Flight Simulator.  \nDo you have what it takes to survive and become the ultimate pilot?\nRun missions for the South American Cartel and prove your worthiness.  \n\nFlight 74 features beautiful graphics that push the device to the limit!  Every aspect of Flight 74 has been developed and optimized from the ground up.  Explore vast landscapes that include trees, grass, rocks, buildings, airports, cars, and more. \n\nFeatures:\n- Realistic flight physics\n- Interactive cockpit.  Flip switches, press buttons, manipulate levers\n- Incredible graphics and details that squeeze every ounce of power out of the device\n- Movie style campaign and missions\n- 7 Airports and over 2,000 square miles of scenery\n- Free Flight Mode\n- And so much more!", "short_description": "Experience a new genre of Flight Simulator.  \nDo you have what it takes to survive and become the ultimate pilot?\nRun missions for the South American Cartel and prove your worthiness.  \n\nFlight 74 features beautiful graphics that push the device to the limit!  Every aspect of Flight 74 has been developed and optimized from the ground up.  Explore vast landscapes that include trees, grass, rocks, buildings, airports, cars, and more. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/ybrzqqs5c95a91z/privacy.html?dl=0", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "http://www.tasappsystems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631712138104781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_303612417429364_5385601985955261279_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nR9sOhaFHJ4Q7kNvwF4sj5z&_nc_oc=AdoVkdQG0HCuLYVzxEXBKX0ei0qKbk_32k5Dc4a2WmS6TqtU-2P0r
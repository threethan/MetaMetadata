uluscdn.com&_nc_ss=7f20f&oh=00_Af8lxgQ0FekRnU_Z2gwUr3bi5XC_hYRvZmKrly2yjjmEhg&oe=6A2FFF0D"}, {"file_name": "3.png", "id": "232784524945964", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75361348_232784528279297_6036885773619577034_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IineXziZD6UQ7kNvwEoaLyz&_nc_oc=Ado3r8YPTTf90-kdg9x9BKyUh51lgHTss7R9LOA41gwxWpvLcC4uRFZvwZEh4XxYE2c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X5Bzp4L6TedbSxCyIUx8luVo8rlilgIN-pDHB6IqyuA&oe=6A2FFC2B"}, {"file_name": "2.png", "id": "1119852311805212", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031545_1119852315138545_1387800435837134823_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb4AsNnQDJEQ7kNvwEyIgsl&_nc_oc=AdrWLh3tQX9D3m7HNbpcda3ndzmQRMYWjMaKzz6VT5au_L4stlQZG0QBq5_NuYLt0Tc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-35kSuWD5BLG9RIuAu1QdhIZ-mFczobQNliGFo95c7pw&oe=6A2FFD88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2517017418595817", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974542_2517017421929150_8334052531700065049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvhYZ4lfMH0Q7kNvwGPbtQS&_nc_oc=Adrk81gNEgC4oh_4EF2cGTunnRKooQaC9HL2G-CxpcrTqagJdYZX7bXyj5i2dnoncEU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xr4-Y_JsXHYGlcgpeU287xE3KeDZe87RRLAG9pomMlg&oe=6A2FF0A0"}, "display_name": "Flight 74", "keywords": ["flight", "Sim", "Simulator", "Airplane", "Plane"], "long_description": "Experience a new genre of Flight Simulator.  \nDo you have what it takes to survive and become the ultimate pilot?\nRun missions for the South American Cartel and prove your worthiness.  \n\nFlight 74 features beautiful graphics that push the device to the limit!  Every aspect of Flight 74 has been developed and optimized from the ground up.  Explore vast landscapes that include trees, grass, rocks, buildings, airports, cars, and more. \n\nFeatures:\n- Realistic flight physics\n- Interactive cockpit.  Flip switches, press buttons, manipulate levers\n- Incredible graphics and details that squeeze every ounce of power out of the device\n- Movie style campaign and missions\n- 7 Airports and over 2,000 square miles of scenery\n- Free Flight Mode\n- And so much more!", "short_description": "Experience a new genre of Flight Simulator.  \nDo you have what it takes to survive and become the ultimate pilot?\nRun missions for the South American Cartel and prove your worthiness.  \n\nFlight 74 features beautiful graphics that push the device to the limit!  Every aspect of Flight 74 has been developed and optimized from the ground up.  Explore vast landscapes that include trees, grass, rocks, buildings, airports, cars, and more. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/s/ybrzqqs5c95a91z/privacy.html?dl=0", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "http://www.tasappsystems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631712138104781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_303612417429364_5385601985955261279_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFsTr2JAdDYQ7kNvwH9QmuA&_nc_oc=Adq28Pgjyj_btirF9_vCnsaY8ZK42Vupa-OHbD1-TXDFK4fCmJcKy
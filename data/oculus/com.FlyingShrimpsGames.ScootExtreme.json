584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uQUoVPqEb4Q7kNvwHUbhfW&_nc_oc=AdpD0aIIQLorYd5UPrDmnAzLX66JdtzdTbXp6iOoMm3F8Yi0XVYi1J33nkmKPsCXTi8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9UNV2R1X1Rgg-lE6MNvwtz5B148Xgz6oSd2zbKF4vaA&oe=6AB27216"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bwd_LWMF88sQ7kNvwGBsvcC&_nc_oc=AdoH9NQLmFgamHu7tcw6x3Bm1sbnrSAD-HAidoxj3Suoep6JMN6WH8V1wVlfZHV_NFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFO3xfLvDz2OCtZhNAtLc49v3HFIFpaIuQFI2d1ndFbw&oe=6AB2A5D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXMeqcPPe54Q7kNvwF7zLSH&_nc_oc=AdoaH1Pj7-zlJmhcOKXdSEHyw_MtnsHpoTZ8uYMW-_CF5D3SlFXaSkNlozK40ZLdklU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWkw1nuTUORsP_A-H1IYgNgQgv9uYf1cZemidcq-fBaQ&oe=6AB27BC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QH9QF29vIMQ7kNvwHn3WN5&_nc_oc=AdptGgQXFpo4DT1yXfQExKN-Q0mC3WZ2rlgXO3NBVmPhmk89S_wvDh8rApKapjJIjmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoi8TZN6IK5MjXjIEoYigFo1MIRj25mEhyoQ2H-qfePw&oe=6AB27C19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6Qqu2MNSbAQ7kNvwFZZTnS&_nc_oc=AdoNmjs0cJqB3dSuBw5jnjWy9aKsaZVr5mHoV_F_smDZ1dsN6pbjN8PhRCadFw4NCL8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUSfdtEYIvIAqCGNpFzw5Dh7i9nA6cNvIITLhnWgqoAw&oe=6AB27938"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
2010_562584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMqjoMUaO6cQ7kNvwEQBCBi&_nc_oc=AdoImGPElYJa0x8JntTQndb6zLjZz6fOPaEEVRO3fUfes31WomDUFpMSEteZvY6ScXk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPckH_JMg5Z2zsnjLzg8sobZIrLb_rXhnlmjf9jhO19w&oe=6A8ED996"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3CFxiCUYfgQ7kNvwHP2CIw&_nc_oc=Adrq0rwbT8Ml5aY94Vas_H-8FPT5B7YwfCERxR8f3B_ZYx1SdiyTM3iOaFOnbAx9y9I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSTMOctcm6E89S_WZBenoBw0sLzc3djWucN3hlyo1Z-Q&oe=6A8ED516"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esPVm1Oo45QQ7kNvwGfUcDP&_nc_oc=AdoxY3bG3IeMojpjeRuSPAaJvyVuvXsIsB81AcoEHxDvAmgDdgVDlW13C7o3O1lLRtI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAky6QIR1_exX1u5n22jn6WL_N26MGjYuDU6Vi04t4JA&oe=6A8EE344"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyurGHRmuMkQ7kNvwGWqyo1&_nc_oc=AdrXWP4OqU13yXmvm584nAq_oSq3c7FC-ZlHcB4_TlkfR-DAp0pSQaiqvX3aGCPM6SQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_8zyUEuuTjaVd0hILRZgi5us_iWFcrLPtTluujF9jMA&oe=6A8EE399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgfONi7mhccQ7kNvwERgDPg&_nc_oc=Adr9FcysvK2TkXWZFEnxasISZVo6CVDZFAzf0v1UyTPXRvV9PecBwy5uMFnP997M_FE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1-1Ilm8YkDLYwi45Wv2uNTF-aaMrj1NvoRAyidCfr1Q&oe=6A8EE0B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://ww
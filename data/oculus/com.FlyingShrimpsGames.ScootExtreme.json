584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAqEKB0AeWAQ7kNvwFwkijw&_nc_oc=AdpYIiur1LE33LJZR9A86kwqLhEIE1zcpoIrqccn24L-4eTg1i88xtzAQ1_cKo_MieE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUz5D5iaDlY1tCMbQW4FfSYiZDWJcksSJiLoeq9O455Q&oe=6A4CEE96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDHV0HoxlMcQ7kNvwEBaxI0&_nc_oc=AdpD6m7-ha5Jw6OIfbiJmH2MYYk_-UyznXYbwPXLF1m4De6ixo2LDb00IdQyO32Al0c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDarQw2BHy7EDK2LovL6OyeteTeADpwXRGo1Xqe6gqTjQ&oe=6A4CEA16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5sGMJdk3zYQ7kNvwGAJMC-&_nc_oc=AdrznWPlyxZVCaTZHmHv1lIQ0VKrqItiD3YCIwBERwN_mL3rNGx3KrL1mX1MwgeZIp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgiERbAhbGkxJRBP21PDnb7Bt-jIQG-3PAFQ_li-zj4g&oe=6A4CF844"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUP5C7M401YQ7kNvwEBue55&_nc_oc=AdpaJaiOTGUFPVBEI2t5xTY1C5d5HZDeeimARPdjnfMKzzS0fi_yli4-HyBxOoSKvH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOCRDclgzLxRwoVsJ23F9vadLlF7Cpe0su0eqoAE2iqQ&oe=6A4CF899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUdgesgQJ1cQ7kNvwHZOtxx&_nc_oc=Adop0NuQltTp2fMbZLw-nLYarcnA8EeOTulKSADP4FwV_oNMeSh5xCiCVs2-aZ7p5mM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHfHNwGHjskLH2RUbqSSmVsgaD6WPdmoTP_Y1nG-NQQg&oe=6A4CF5B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
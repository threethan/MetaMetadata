584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMEIGKeAVmQQ7kNvwEPMSkR&_nc_oc=AdpgT4L4D37y5VebRNLM1d0XYSv0eSXJtdsjmv-o9A-lGh9Bk4GZK1-_WBmWaRu4QF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ylEo7OkJ6OAcFYd5RxlFXQMGIZ5MLtHewToNHuqyfRw&oe=6A3FBF96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M__atmUDzXYQ7kNvwFpaCjq&_nc_oc=AdpOqstvd6Nmkd5U6rFtX9YjGkR2J13powV2-XSz3RSK7MhEx5WcHilMzvPej0BXLYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dAfoJRaGEFyIFxkcJl9vdZVwv3DqerOQwfkxIqq68FQ&oe=6A3FF356"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvz1N5jXimEQ7kNvwE2fwVM&_nc_oc=AdoTu7vah9Czx5J06v100wUn-TswpzC6Q-S5i2faI34I_U0dJcFevLN8GmwchseGMCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90UwsfuCe2BC3SHGbgGrw56vRS2U7WazwWJm_Pv54oQg&oe=6A3FC944"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcbAGagKs0sQ7kNvwEFph_o&_nc_oc=Adrgi2O3jsR_2azX0TexAlk_P7Hvai4JYppNgWHWjMMVYcbCSkijwZfsRDpNCV6RO4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ubmo7M1-PGzgtXPTXhLksjnIQAp-12lLxQt3HUXRp5Q&oe=6A3FC999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxauVvaYLTwQ7kNvwFr8Ksw&_nc_oc=AdpOSwcwkj0957k3IR1Sl5_OpAIjuMXdgpcxLk0deVrjV2GwKWMqYnSth25fQh9QtTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zw4nFhCMDgIeaM1_haBjwzKjh6HHl8rdl8TQlFoVMmA&oe=6A3FC6B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
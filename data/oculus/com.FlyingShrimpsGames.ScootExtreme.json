584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EuKum7K11gQ7kNvwHwRkkJ&_nc_oc=AdpKygF0pP5WjqmRchvAD_CDQ5n1T0pN_1eUxZN6v0aXjKDGkGRm9fLUx1qVWzyNvgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80vgC8CBSmQNUUOKaXrGKy_fu6M6808dWYq_x_HCvnKw&oe=6A43B416"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=setQde_986gQ7kNvwGAtX8t&_nc_oc=AdrQebfkFWHi_jn3-BkaWCF9J5n_v5Kx9pj1Ebv4ELpCjP8D5LqYsklzUOjSiAEUxVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NfdJfBevKff9OdLx_8U7ySJY6Ky3GAt0HtssoPT01Tg&oe=6A43E7D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1NR9YOvBsMQ7kNvwH9f4Ve&_nc_oc=AdpGgj4VM7CphzUBYi0pUTo3IablYN3xu5v3mYrDyo1fxoTmlZ8YcACubQhTKTYAlgE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PXWI3jEsoriN0juMOlk2u7jzLmDm-UwwANsr962F-kA&oe=6A43BDC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkIUP9Lwn4wQ7kNvwHeZ-sR&_nc_oc=Adr87GKmzLLNJ_Kt9i5uEeJTwSeYVAlnt6ugKG8r5gblppgiXh9JicHnIjC7wCaYaVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vHE3WNj1LCVN3wTLpFloF3X1UCPaIsMHTphgd937SyA&oe=6A43BE19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo2mMQ2CRy8Q7kNvwH5927g&_nc_oc=AdrweUwoXxMxEbTkDP0JeVSbmF6muE2WLwIe9m0hzmqWgPkg1W0l_sBS024Mfb8_-pE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VYGLVad9K6C5qdmwrBGjebp4EkTV8g91GdEgCUf1ehw&oe=6A43BB38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
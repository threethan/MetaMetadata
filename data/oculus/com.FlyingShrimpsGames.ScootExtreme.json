584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZHh8BW6xiYQ7kNvwEHyLvn&_nc_oc=AdrMkNuaeL4hB_rB4TF_hdxgCL0F1xR6YHTg5f594-G8Ej0Fk3ArNZnPRth9Bk9-KGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIcSre9G4ZCPPUmn6KN7gXNIr4qeqI8TzN66cu8Oe5Fg&oe=6AC3CDD6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEuPvFzPBh8Q7kNvwEZv0hO&_nc_oc=Adp0bhuinp2PtP11dOsPl-x2xdVzOEX8z-62OMaYlXbf1BMPv1gojiH47Ek5wcnOyLk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa9NiPDmyuqdOdmMIdOBMhLc771xzI6-I-nSCA5e4z4Q&oe=6AC3C956"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjYEI_jhtYwQ7kNvwF-tMr8&_nc_oc=Ado5uSbpsecsAdciD2otbxaAKYnegPlz5RT4x4gWfCB9sTo7-9D2NDv1ChLvKLtQ0cQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwaVI9lPD1HHvP9zFdTzuwC7lH-GS7DDcoO4rG12H5EQ&oe=6AC3D784"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkB_gAlXgykQ7kNvwE12JCN&_nc_oc=AdqQyfp2MttuMHTjmIHsKRXcO545v8ppztjJGeepad_MqEa4WptF56olmbcbpCNAJ5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlT3iPWoYIJVqFHrnOFouxJAG_KOAblVVFkkUuLqgKaQ&oe=6AC3D7D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glV0w1C8vmwQ7kNvwGg0eLX&_nc_oc=Ado-l8oJJm0ZwsvChHd-h2GbBN6fZ5EmzwZEID5G2gCyNXmHfLDhh9f_TBIqgJ_E9oM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX8gws5c2TGbFPHiCr4plZgCE8gloaHcf9TL2va0d0Zw&oe=6AC3D4F8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4y--4dLO8YQ7kNvwHBosRa&_nc_oc=AdqC8gHdPvd3YPntGO2K5EknJQTi9La-ue2mf5slPD4--AZ2Cx8B5Wnc1ZvW0ge9F9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo62cmS7P2VBdt7pB5dG1SMZRyYWF6Ynuki2PgYkdEaA&oe=6ABFD956"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIexjdjwVtkQ7kNvwFleY7_&_nc_oc=AdpIE8WGVyi0H5SK5q71-TrdKDD787GzxmMM-VHBGXpfZb9uuxi9xRFu57Tz4lLW_Zo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe6Kuh66-M_NdjImaUuXD3aKZ8V51L0H2Dpec5jriCUA&oe=6ABFD4D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWtgJQm5aA0Q7kNvwEj4RIa&_nc_oc=AdoLCrj89MuCJJ1jDrgF3ZAsAyDmQTmciWxiZ_r0ZCNKLii48bniaezP8aDrUDqphlo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgzg7uw1eWshwzpOb5wTbfOKPvcBSY9QS1QQ_BEzjO1w&oe=6ABFAAC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTETZDl62rsQ7kNvwGNXgvk&_nc_oc=AdpTVHbzAPPWQpFNBSha80PK1LvWujuM_lVEy9yhChph_--I6TQzcy_1nNK6UqzBPnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHXpjzOzxdX5BNXlnbA4p8dQF4qDJ9ozSqwUvRscUB_A&oe=6ABFAB19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jlC-TLFbWUQ7kNvwFqrh9R&_nc_oc=Ado6EMIdbLAkebpc3lkF__VokUnuuf5hfhtD2ys5T0wWv3aeL_BeJwI5klH17uundO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5w98ggUJVjLrLLyMq5-hVky41ptDx2lerI_G1IdGQFA&oe=6ABFA838"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uQUoVPqEb4Q7kNvwE1xpqt&_nc_oc=AdrOHHX8hFPn_qQwJRPPsDTy31K8PYazTIVyuLbuFHt_FDQ37YwhC2Cm58q7l3_O_Q8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB0D4A17H51qVMXD4RInW14xEuvxxGmr7MHWcYeWaFiQ&oe=6AAFCF16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_YpIFMYDOgQ7kNvwG2DAlW&_nc_oc=AdoScqBIUf3kyDtSBctreCQ80kGp9-Rriq-m_ej9YNLcDVbQeREWgcbtayyoMTgfCQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVAT-mnI80rayW7tk9qEmtWztqVJr4w7Fc7BMX51Pd6A&oe=6AB002D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXMeqcPPe54Q7kNvwHFIxBa&_nc_oc=Adqdfdw_hr2QV9nOe3SrugZhJA91QO5YsPQoOIvEGj3M-zmeZimbanfkuiW2s1l2rMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKEbyS2IaxEzumum8XFzBZON1iL2wwgyBZuVIvMsp58Q&oe=6AAFD8C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8KfKirqM3UQ7kNvwFDkbs6&_nc_oc=Adq4BoPVXVenepKWs8P0eLJD7te48GzlYcwn3GbFOVa6yHpX5N3JsLXV_At8LS52t1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhArLrMUY91GQygDTSgrhkURs79q9kK3DmS_PhOnEgzQ&oe=6AAFD919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20nu3wa3pkYQ7kNvwE1aToz&_nc_oc=Adp8Dls56i_n64SCxN9-JMtOn6tbiucdyd1ulMZ-Keh5lMftaKI-7rE4qZkKOV24d6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoVv_FMdMPIIkgZ75ibziJjwe1aSinNDBKSbvtUAd4Pg&oe=6AAFD638"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
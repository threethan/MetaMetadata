584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C8hwyO3rhMQ7kNvwH1hxqI&_nc_oc=AdoIyccA09wjd23f-dEw_uCmy_LyaOmSvKP3lyQ5qMQYC8tR5nKgbGrreZEZRXP6rWo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIl40BXWo5Lb1Fx-ACzknJOZA1xlIE5hS-FhT0Kuhvsvw&oe=6AA14E96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V_965XSEJYQ7kNvwHqlDo4&_nc_oc=AdoOa0o2IaqbEuMJI2ofZWFWBEB1DjN_Qs4_1H7iHMUfzscYHPevqHQBI3htLInTlJE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ44J6MDxZI2Ld4hyjP_xCo1GRC9I6JoUyewa5j1_8VPg&oe=6AA14A16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxBkeyGeHG8Q7kNvwHf-g2w&_nc_oc=AdoxM58HopLuoqqU_juvpVaRmbg5bt83w-ejrEdy8EdAs3cUzhHFySJuJU7tUwSfNow&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY3W75JkjyuQaHRa3H493JklVID-_LDjxmHLwOJf9ZVw&oe=6AA15844"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcCeL35XvpMQ7kNvwHI2h2P&_nc_oc=AdoFc9HShym2rIM1p_mlbMXh_xbPj1oV-MJwZXXe2fgDXb9Jikn7hgQiHNyNZU62RtM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGsLuqxmUQkWBGHtsNtD8OCwJjE53X-5tTbj4zo01weA&oe=6AA15899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6MCQzq0d1kQ7kNvwEHUee1&_nc_oc=AdrPkXA0lMYSqTdQmX0pW3H1RhWapX2kETqdSEdlJqaCphK7ba_hiGdhlG2x3IMYf2M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf7zLqV41T3Pq1qmdgFZkJcQTHKmhG0fSGFNWRn1w03A&oe=6AA155B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
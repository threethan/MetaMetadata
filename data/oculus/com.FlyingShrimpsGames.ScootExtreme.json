584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqNtdTri61UQ7kNvwFXYHt6&_nc_oc=AdrZIZ3kn84s7MjqiZK_lMFRWRfLJjczztRwt7Yw0EaPNKOGIqFiiLQ6ymmPhC7Z1rI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVCptUpGDGifX43lmnFRAEXm-ewH0slltqnpTENISERg&oe=6A71D896"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjKdwIrpyDQQ7kNvwGrdj8V&_nc_oc=AdptfP57bssmZMyvsMBKyl9obWpr6QTFLyFPWRDe42F3QLGtl99CWxZ_rlElFLGkU_k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOoCDu-XZJJZF8Qk4K5obEyTd0G4QCYWLpdUaidLcyJA&oe=6A71D416"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGw9AreHDRYQ7kNvwHRsKJg&_nc_oc=AdoFCzEBzSiZWJPVhHx-n70415pLPIIPdtsbc_Ezuw21nFM_XlFXxLDDv11WSKGP_DU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZFTM4UJ3wmm1SPpL_ogcs-pSr8B9Xo9pBTAuBldRf3Q&oe=6A71E244"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miYmn8abPlMQ7kNvwFDSvgC&_nc_oc=AdpJFoOCnQELeG79oxe8Yjo_od9w3lnb58fQSxY-DD-YSb9cobWnk4y3i0xjISPcsPg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyxCggZJhZksx4s8HuK3Z5UCw9YXbz40wvnlgdMO552w&oe=6A71E299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBY9-bXHEMwQ7kNvwFwRru_&_nc_oc=Adp3EeHlMTjWs01cnBZ971pR8QJW6COq2EIEJg9n84pyP03vBaX6ARDiuiFzFLSS548&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIl-zfGkwSr4JL-eFmvgQHOoC-sqWpHFAuwi3XuFtezg&oe=6A71DFB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
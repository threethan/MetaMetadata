584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5SyL7xhxB4Q7kNvwE7H10F&_nc_oc=AdqUDeVCOiszyDIlmNe45MEPRqnUeGln32o7r3bUTfVdGebRRnHVkZqd9m_QR87OcNM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KffzECI-I_ejzSuWKD2cp7BC6A57G9EoqjcYRJTNX7w&oe=6A186AD6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39irAaPCECYQ7kNvwH5ftov&_nc_oc=AdoAvzYQfVbWeH0VLrIXDaOfVlkpb74KloQy4va_Ebw_1JSKs0U3Zna2vnA9lNHN2Hw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RjBckohtIYm0PCmkbk2JzZq0J8VSdNjY2iwuAPvnhqg&oe=6A186656"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnrQZJpfXBcQ7kNvwGvpxli&_nc_oc=Adq9Z0MBNWW8waf4zU4uQHHQc0NIgy8edKmmKqJ9Z9DMHzr7KFsZ6sT7jbEojGrI6mA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BAPO9nTklwAv59e8TyyK7fvOMfht_gH1m19t3mLjYwQ&oe=6A183C44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag6gGqDqEoMQ7kNvwF-h6le&_nc_oc=AdowWhRtlkX4ik-xwF4C_zcH1Fz-KVOv8CqNoxBa9mI7vvWjRWuwpKcVFM3sFN1DFH8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af651m4Zq0XDtFl6JOdh5EVzX1kxR6FnsxQtobwCzexDjg&oe=6A183C99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNfENgV9wIMQ7kNvwHu5n5k&_nc_oc=Adq8vMuyRJ9B4ngJMLI85PiQ1y1cirCVOUR8YrxGapomqdu1ht8_ToZ45k_ZtjpcFTs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-PhjUPeye9fp578wVeT0YZuJV4fxMbkA6N-OrQLu7oQ&oe=6A1839B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
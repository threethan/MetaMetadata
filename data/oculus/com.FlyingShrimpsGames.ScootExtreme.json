e5wO_IIQAjQ9w&oe=6AF889D6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pr0MlBNMArEQ7kNvwGs5aS0&_nc_oc=AdrEEpytoPrqjeZFXiMD01JtBQFVh1adnqRiEKaQDvLUkHhKYRLy7gCL5t0NO1dzLu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6E-SxHn4rWhCMCNe0nXb7NMh1yZ-XXBTyRWz_ZmE8Zg&oe=6AF88556"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY2YsQcVXv4Q7kNvwGUZP2S&_nc_oc=AdpFM8kAlBJc0t1YJIVOi37m2emSN7Y8_L8Bit-z-W_onVlmKJIdHMuO9RuzI2aZQHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwtYP-1fn-dgMNS_IwNTXCsFCq3ngCx1_BJBLGWc_9uw&oe=6AF89384"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFlHfnygZwkQ7kNvwFc-raC&_nc_oc=Adr3w9z5Kcnc3JA_j6snxLh9DIx83N0NpWf2YZIv-vPV6QCEguTdyne5k6_E8RDr4hI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd4EU6-ygIUnXgc19LURsn7DzbVgLJ_6nWAp0Fo6__tw&oe=6AF893D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGNYJdfcy_QQ7kNvwHfdtso&_nc_oc=AdrGR-nXc8IWjQSDL4t1U02paLUx1xjS-YOqGcO917Z_SxahCaOJsMviPMDf23_TUMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr7ozjf5VqgcIJj1bfn4YTRb1n-aeRLL-kmrZ-Ufl5Sg&oe=6AF890F8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshrimpsgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "ext
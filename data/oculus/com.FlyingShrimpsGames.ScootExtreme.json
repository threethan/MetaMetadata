584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4y--4dLO8YQ7kNvwHpZZ-0&_nc_oc=Adrq2oXqG7DqluqzckIFo6YdzFppvpOIqexhKlyTM8FcYiJSaEWyOB-pNowSJAVTZI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj3Cnog_Nqgbrkq9wwdqe2ejH1q5zQiYh835FNba7noA&oe=6AC27C56"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEuPvFzPBh8Q7kNvwHkapJl&_nc_oc=AdrggVieCA7Ez8BXkGoumZh_Jc55fOiXLcOb3hL2r1_b4UKkzYTwyXdN6mlZa_dSnXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5pHbFCHMFFoeKNA7AAOEZyqDxWlrTYzr6AEn0ZPIe5Q&oe=6AC277D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWtgJQm5aA0Q7kNvwFtbsZ6&_nc_oc=Adrz488A3URlusBWm4BUt1579J-SbbKHKsCsfYFZGc_7BYEz3CWXYn0KOFgB4trN5GI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-iTMyZQZ1LTbzNXPhVxy6LLB8-PE590KRa7VSuF6cJw&oe=6AC28604"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkB_gAlXgykQ7kNvwEqUryB&_nc_oc=Adp4o7Z7Cavk91wnu0QE4KFlniRI-umM8RpUdgfz--rsUXhfUqNYTaNr6PjVySC0w7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzN-cZCcACTLvW6vd7WNzQAs1fhc4IYGv-YfWdpGrLFQ&oe=6AC28659"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glV0w1C8vmwQ7kNvwGrBRYg&_nc_oc=AdrYJaNl17Yk41jbzQMGjKScr88sUmIv2u8lK4TIPDSIKdY7cZc41IlCLf9HEJYpg8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4LCDusxXrbAJrAbG0K_URtmh_FTfxgbdNovgYtSsdZg&oe=6AC28378"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
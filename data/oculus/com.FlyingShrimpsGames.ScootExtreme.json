584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uQUoVPqEb4Q7kNvwHOwx8V&_nc_oc=AdpqUUyWZza0LG1yE-9lz9-GiyfHtGO3Yf4EV00eKuKWo40E_rZGf_zwA00d4vWPa6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa97IM4-vtNc6iNnT7fhnY8pzcVNSZLOl_rdhRbXtDlQ&oe=6AB158D6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bwd_LWMF88sQ7kNvwFoiNML&_nc_oc=AdqTg9BI6OoVLj6bu8cJc9oZMRjynNCF-Vzxuqe38AVHnyFToqhao4JBfXfj5Qr6hFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ9WG8FschB_Gse1BdaLUoh8mGpM-jwmj6_00WUeFDcg&oe=6AB15456"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXMeqcPPe54Q7kNvwGHuul-&_nc_oc=Adp7LdIK9tyVMi4aB2hpuriBxOXErScB0smfEvUnY0xkjmpLnoJ8IcCJlGmOoleEMz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpxTW4dSxq26VwXVyD4QfsvbQI47S1gHEGHxhXLLgbUQ&oe=6AB12A44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QH9QF29vIMQ7kNvwHwZxkm&_nc_oc=Adq3-eTarN51jMh2FoS2ATNO_3kz8RBMw_FE-6EvLFL_mCuSHK8xkJ9ht4RCGwMjTeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICnt5Fpq_qVzeIZokbMyaWk5WgG6oRU8zDAmGgh4wx1g&oe=6AB12A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6Qqu2MNSbAQ7kNvwFjYTGQ&_nc_oc=AdpLX12gUgoyPmrKF6zEs9wu82V55C7TUzLIZQTSMPMVikbCASEYzpBLZCOTMXU3cEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO23-2ff5u-bEsQN0lI_34GjiCds57pEPnHNY2rrVsFQ&oe=6AB127B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
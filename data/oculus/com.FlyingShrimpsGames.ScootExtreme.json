584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxVFc2riVZMQ7kNvwEssuF3&_nc_oc=AdpV0Bcgu0VO8KsJ_28OeWm63yLCy6Efc7k_zABYxa6UYSQBcNDyomHLfxkCbK1Fa6E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqV4CKx0hS4sBE16Hygn4K1ZF2yeFjvNbEg3dRoYd2Nw&oe=6A562916"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsCfH1y80z8Q7kNvwGXdNWo&_nc_oc=Adpexkxo1jUw-QeMaq-9gtEBJ9sQKAlp3u63GfyhkWXVXcAsze1W27BBRMMT4PppOXg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_TYZERbUku6zCIQYS7owPNc9kaer3i6TCE7hU2T91rQ&oe=6A562496"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYCfjQW-LYQQ7kNvwFS-643&_nc_oc=AdoIYP1yn_gcixYT6YL_UKyWVSJvnZ-hDqyFRMsFu8bxP-da1e0aq7CytRYAI-mRne4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjf5peKmesj-kyVuh6mcJhv5IzTJRZjNIBNKeSDvrK_A&oe=6A5632C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KkJ9ZFhYTkQ7kNvwF1P9vA&_nc_oc=AdoDgtxLFCNejkNn18N7fWZcsbljU0Ft_vEE85kuEcskjqsY4p5tr-USDo_Dj4NsEk4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBED3pERDhd-OoSP4ferUtSC_H8VBjHpJl54tfRCaVUcg&oe=6A563319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnhwZBBORz4Q7kNvwEcq-s8&_nc_oc=Adox-IAJJv5fl0PMyYLW1PnNJKs7weyGfZsUczehyfWeA35USgRnsDKi9ggZXcP_dKw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk-8CAHFw2bjsAg0hV9s4oPi7zp3mMcHe7bT40ZIFbqg&oe=6A563038"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
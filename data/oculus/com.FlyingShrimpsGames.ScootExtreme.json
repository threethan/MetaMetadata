584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zun5PjCixsAQ7kNvwHMKmIo&_nc_oc=Adr9stSPsrOCHGYXVLy6FVeGPwQXrlEwJZJpozkq566cx3-ZzuFr9j0ucdLAcNC71D0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I-4nPM04g7VVbM1YKgOSVNxotV1aUEejw7SOad8ZLbw&oe=6A26EB56"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTFGGkeXsTkQ7kNvwGfSYKY&_nc_oc=AdolJD-ANTBPPkl82RqSbFNDG3Q9gT0aWtCZDgI9FExcVXns7FsYdt4Xicn55CsmSqE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A7jO6MRyPj6S0CfNNd1DmUrsZs-Z2IAIKANkxPfHZYg&oe=6A26E6D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gULIxbrzxt8Q7kNvwGHJ3G7&_nc_oc=Adol8TDgtzSt2mG1PFok8tqhhIS9EbTtKUu0qORsXoFPN-P4SBZeGlC2q7ZG054v14I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88NFfyb9u7Hs_ZYUQTWG0Obimt2b3sc0IwekwVdQOYRw&oe=6A26BCC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1SIQa4QODcQ7kNvwGxsV1U&_nc_oc=AdrMMEN7JD3W-9COtJ272e8APwACS8AkpV4Bmh1qrwh_CJYygY-lwn4XDTD6X7w0RfE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EW_oiV0NxNDPgslvby6NEtN6icJp6Jm8X_FXv-3seuw&oe=6A26BD19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOTO3qNtpDEQ7kNvwGaaDJX&_nc_oc=AdpnCg3bvh3xYaJhO5ttNAXhwoxLPmK5RoLpMSYljU9sHF7AvVX4gV4JuH8oKe4e2hE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SkDqSaU-vV_d51tQTZ-Tfw8Sle1Rpo2WF5yMaSr_wMw&oe=6A26BA38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsJ6oe9fPw4Q7kNvwHISyAG&_nc_oc=AdpS4TId1ksmQ9oq4_rHO4U_9_4k73lb61MWFlpyz843DFlE5gik9zncVL6OturxEfs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w0jbgoMQ7d323K5ms3Qwqf1PDlnJhmKllr7F6M5rRwg&oe=69E22516"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUoAmfh-tksQ7kNvwH1LvQh&_nc_oc=AdoYNaGficimviYFygND6JK8IqUcK1eBCyMa8Ii9Q1nn94QJaxbyi3voIIOzTvE1Mts&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bS3gOLQqjyzArELWaWV40ASP31rWXy6lWwLZqQeK1dw&oe=69E22096"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyDn37v6VwMQ7kNvwGCq34X&_nc_oc=AdqQ9Y6h4ok4DkvkcKobaGkHeaIJ7w3c_Bb9CvjdTYOtJC6SSlIcIbtbp8PC0fsMCEc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t35UWskIr4EP-AUc8umCwCmROHdiMSkkTpVgfpDe-Hg&oe=69E22EC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37zFU_g5gAoQ7kNvwFS-Sxw&_nc_oc=AdqDz8dWQOl8qs6yso3pM2Zz5Tv-yapQrU8Xb0MVJwCp3cUisylW2D5_TIJIYHMaunM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-x_kDB6Hj6FzpBNb4ZK5wO7L3k1FQd0d_Emq0V9cqyg&oe=69E22F19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqmp08Qzb9oQ7kNvwEuNnvH&_nc_oc=AdrMPVAjOkLZk5wj-zVN5O-DuFsMZYiiz7_o_ue4dOi1VKRQFJ0Dbye8pTX6e0ft6-U&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bk3MmfQBa0TSVxh4Ysg1dfaJVZSmH6ELo4jO631JIjg&oe=69E22C38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
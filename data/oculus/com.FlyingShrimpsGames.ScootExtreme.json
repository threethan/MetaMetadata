584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EuKum7K11gQ7kNvwEwosy-&_nc_oc=Adqy2GvSBaBdgYdHcp2ADvA0bkt5H6WFvKCMyuifgW0qruQE3TiUAIIOSiVGK_vVuaM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DdkNfMxfqQD6inlO3tpY9Woc_dWz_YzRxLK4QI_YvEQ&oe=6A426296"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=setQde_986gQ7kNvwEB3aS5&_nc_oc=AdopjPaZmLh7FSLwcEsiAsk0aV8WlCfTbcJhZb-hVo7M7PrwA1di7L3I2G6gvn6ldv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LjV5XPnsPYeeKhE9Ycd5B1iDxAAHvgFoG3o7JIufvUg&oe=6A429656"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1NR9YOvBsMQ7kNvwFHkM0A&_nc_oc=AdozKu82Jkzx7sExxDjtt8GwMn1PUvvGh1lx68SHhubtTyFgzHfGZYkTNSlXOTIkFY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yFF_cNLtGwYEUbvPvizujPIf4w6pMPRNoBjWEBpeZWA&oe=6A426C44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkIUP9Lwn4wQ7kNvwGU-9Em&_nc_oc=AdpRoKBXal5tlI_YI0a7tBW0duTL400xGSorZcfssW8X7NekS60jtjfAnxnPflgTk6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OJyIt7uGcLpYKLfgN-NwxBQpYv7TDbiAxtpBZTyL2vw&oe=6A426C99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo2mMQ2CRy8Q7kNvwFjhNQn&_nc_oc=AdrgmAE4F5MGayBjFHOu5K8aoJR6c0BGmQOND5r-vo2R4ZQzEVVTJPhFLScLEp3rflA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Oh6mo1apFinF9EOYvluigCokDTzvVwrShBm6edupVlQ&oe=6A4269B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
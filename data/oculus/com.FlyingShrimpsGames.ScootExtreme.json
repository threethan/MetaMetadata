584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKBxQK_nansQ7kNvwG3HDA-&_nc_oc=Adq0czzvctrIqg_BuKPQhjghG4YDP7biCezY5Kb8tRk4g3oqOIqHBHJyz1a74wcNg-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G7GFPwETuecpG6ZmMoMXwk8CzVvJxvShkLGxQzUN4iQ&oe=6A070F16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEC_9B0TyksQ7kNvwGXrjTt&_nc_oc=AdrAF0RQLVccBb1j8m36GetpPIy8H9fop1uSXoQNpyutOgwwDQbgpYQVZWBAIIevf2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54zILjmg8qfWaqJIcR1VkAwUwgAd2I5YKfGL7bm6eC3A&oe=6A070A96"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3ALhQxm0rwQ7kNvwE0t0Fg&_nc_oc=AdoewRsABiXzRHX4u8eVOnMlD_urkvfJ7rV1I0rwYd3IzIxMoO4zNmEfH2SmCNYTGH8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Utp5sduQTn_Iz6o1xTLJUgVxjQDk2rNjl8vA8InFetQ&oe=6A0718C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA66a62s0EIQ7kNvwEQtf5R&_nc_oc=AdpWwzFh4NvC-31rvNssRVgndweR7arVQXQLFEfY6yTXA2ZnEr4pKbfEc96VAM_6CKE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FM8PeZO0V4YPzPYj7Z1Gqe5M4JAbK7HFwHWSTCYYf9Q&oe=6A071919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLlR1aCmOSQQ7kNvwF1b8ip&_nc_oc=Adr8GOZyxyj4gSYutSKTXEv7EWvHes-njxMrMpbpxi5bZ_tDlbFPfSoF0EIKPqGZfTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bre0rFYkgqA5TT1A3ROgdSsTSZgr1Luo6f3jmYqRABg&oe=6A071638"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
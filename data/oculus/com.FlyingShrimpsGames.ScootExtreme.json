584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD-M10ailEoQ7kNvwF-bOxN&_nc_oc=Adqs255CAS9U00da0p-I-Tku-QbLfdaVHXpqxtRto2qbfPz4fm6A4mFpFlcgjaDZwC4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdN-AoU0DQ4cOm-Xxhdm0qma9nlY1BPm6Bv6nUKmD5MA&oe=6A9D5A16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7sOoaibl6wQ7kNvwFVuDdi&_nc_oc=AdpjvCpQPDFI0R85M8MwWfKuUJVkHkVVUGbUQX-zPQg7CkjCGXrT4DoovsGI--FVV5E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYfPYCyePuC20_m09cHjwhSv_fFyjGjpc6SHxYisQdRw&oe=6A9D5596"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg3Kfobzb7AQ7kNvwHg4uQd&_nc_oc=AdqYKyoDN2R9R66YmRstFRRj_4d7i2ARatW-6xKZkpDWz_JnB-agCkyCgPL6j-i4yII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgQ9YD5Nq68dPYvIp5Yk7oJNgOBQootIvmxtQUcG8lXw&oe=6A9D63C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s6oo_8f8MoQ7kNvwF5Jb2E&_nc_oc=Adrj1TyTjxuJG25yKkfOTfhOnrWS00DPxZGrOokqDsGPr7TxEiFy4d9RGDeqfkVGaAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ70UPwEr2aVj6tvmc63G5Aj70bjWN15X4x3WCW9QreSQ&oe=6A9D6419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2yYjPBjNXkQ7kNvwGzpOWd&_nc_oc=AdqQchE_DenT4uWsMWLOpnXSsJ8SlCEAUba4dbG-4BiMj3AFjEsdsrmfc6FRwkQeYaU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5yVjvZO45godcTWonGwa5hjG-sSdr1mfiqh9dRkssPg&oe=6A9D6138"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
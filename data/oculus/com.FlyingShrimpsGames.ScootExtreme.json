584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Y6pqu0z40Q7kNvwHFD91N&_nc_oc=AdrwR_OZ-VHsekloYf1Xteb_U4f8hQZtH01n1DXYtWGS7APThz_1JOk8SKUk1rHVWWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKobbXGrHT9vWa9FJrP3tx6irvyt1s9AdV3ahPgw2ptFQ&oe=6AAA8916"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h85SFUlo_P8Q7kNvwF3X5t5&_nc_oc=Adqk08lJFelLrdbN10zY7LfUdr9qWiKTn7qp2xsFNAsixvabNwIvMk8D30_AAzzO0_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzfHxeEddHInJJQzFNZJRHN6YROO-seVIpPS2euQAk_Q&oe=6AAABCD6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DYje4AtOm4Q7kNvwH6PAj6&_nc_oc=AdrogxJNWeeNWj3ino4T2ZCadmxDNOzN_me14LfyPf5HNu5Vg_RToadLJVcXmF_tIs4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfbik_zA11W0GGNTNgbUt6T4I3zlcITXt0hmoB7xe3bA&oe=6AAA92C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHIHA315h9IQ7kNvwFVkaUJ&_nc_oc=AdrcZn1r4QqSXTFuFPU_b3TOQpunPn9cdDFdFV12aMWTLnO0AcbDEjPq7dpjmE6rtmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL97J_eUIHBaWXEvNlLFHPLsZLXPFm_k9iaC4oedkL9sw&oe=6AAA9319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_McAHgNmwUcQ7kNvwHo2GQS&_nc_oc=AdrdOLH8eZYXybaZ7qeMr8T4euSkoXduG79p9CwmkbgVSuXdKxpElOGAC-vXw_P5X9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHI2hziH6CFIBGh7kpPWemKqc14nTRWiIQTV82gW7jYQ&oe=6AAA9038"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
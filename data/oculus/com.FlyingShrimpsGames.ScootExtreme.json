584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiWHuDg1vdkQ7kNvwFMEESi&_nc_oc=AdqryDEXOjJt_yfDmCXElrt48n73tkeYOtU5aADjJUK4B-Uj4wuhVhRJZ7QlbmvFMiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UZ9VTCjxZyfCEOnWoIkdBplkvR79k5VpvYmktS6nRwg&oe=69FB3196"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0uPhd9DBmIQ7kNvwGvgJmm&_nc_oc=AdqUctEH6LHVUylY6WlR44hWn10GEyQegHRDp9ptv7Lf2owLL1N7wwf3pbGVxrEFSHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fneSapiENKeQJsl-6K5rSQjLd_DAFeRzdVvcH-BokIg&oe=69FB2D16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDvexAJHY2EQ7kNvwFvyHiy&_nc_oc=AdrRvfefxIhdzx-Iw67FhakRDNJC6k3suPsCxLwgTGwhxdnKNgDeovb4Et2rcNzA-Io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gPEpRs6OKGE56r2fgbT6q5ns_QIktT678jHSH96YA8g&oe=69FB3B44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSzmQzItDbkQ7kNvwH2sZNU&_nc_oc=AdqMWgnOGhnMm9ruz59m6Jz-afc1j5SP_IGtZ9xGD3kABBvk3vlLvwDlt8xXU2c5Fb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WMDWx7_d0vkrRwTq_njXxvGvbulvVctyaibMhnr9Wvg&oe=69FB3B99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o59gBMhScxwQ7kNvwEJZ2lZ&_nc_oc=AdrM9-HyvWSn3CsgKYIEzW1WWAepY9I4MzV-06yfpFCwSr32IjahMNWm71HyDWBJ8rk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73NRrjnE0TvcQ7z5HM2pr5IwVUi9_eQntGVZMu_2hx6g&oe=69FB38B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
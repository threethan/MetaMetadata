612010_562584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2qmIEV34DYQ7kNvwHOTXwR&_nc_oc=Adq8olN71iB8VVEcaTLcbqhfTZWSyZ33HquNzONkJ9jKsu7PoCBOWM8BU0nxUOC5bro&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eh9u2KXt6G4G91xpGfO4NTplMeQPXJkhYndlKgPbhhQ&oe=6A22F6D6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WiwoEFYwNEQ7kNvwFmCHDe&_nc_oc=AdoU0_1RnWv8jh84LK3IerAmxrjqHaaSm8FtQKlVWKusn7tmSu4Inw70LqqHCqX1ZVk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oB-djF4pVUxeAlTrr_8MMBihROIM16ln1y3QWU3WLeA&oe=6A22F256"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqzJOJW9KsEQ7kNvwGzKnsF&_nc_oc=Adph3h6qd2i1FCvY62dAy_eJZcs-6pRfOD9nIWKcycifJEKO3YE40gRfzqbTmuFif4Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WSEy24paccZ3ZbMyRaoEfPZkP7U7sV5rmAoxACt50DA&oe=6A230084"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7lYtRGDbEsQ7kNvwH1_QCH&_nc_oc=Adrc0tt3JKubRr5l8In3skDf_oj_XozGxQAFWwSUGcfJajpttrmbfIv7SHAtEAMj65Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LTybH3vhGvs3QeKXFP8BryOtmi3icmVQYlXQopxfmsQ&oe=6A2300D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4W7WdTsiiYQ7kNvwFIbg6e&_nc_oc=AdoHVSSixrnMotvKyHirBHJpFiQ8DPJFCR_yHLuyBChKI6gNPQ5VOxMzMugHUrkwDRM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GPmj9gPjJZjrcQgYwqpC_aQ0nPTc94USj-D2T-od2uQ&oe=6A22FDF8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.
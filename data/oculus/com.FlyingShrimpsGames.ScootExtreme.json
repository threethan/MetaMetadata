584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKBxQK_nansQ7kNvwFZA1DI&_nc_oc=AdrOryse7A4GFQv0Os3RJJMIeW-yzlsOaTLRF8kGT86GpNtPDt0Xfv3tZ_mr5gAO8Oc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xq4n2wOI52pnxWEHqbpJPiwmNeFW-tIwq88GWt7kZQQ&oe=6A086096"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEC_9B0TyksQ7kNvwGyoiTm&_nc_oc=AdoqQHYuVDkWJPLWw1Ec-0VbCJbJCOkOzvAoWxX_yyz01_ThU0hfd1nQ124Zv6CDW6A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DZRv1jvT5s9KVnqfOx0VYuM-hD96P6x46OrohhRWhFA&oe=6A089456"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3ALhQxm0rwQ7kNvwEyxfFe&_nc_oc=AdozYK2tgJD2jcwt0sKNixiVm_3KkNP2ZK0ajZuVxEybt7E6G8QPJtfgcu6Jk65USaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UQQYFwmCiePqAZY_yz1foil8n3lNkqrMlhzJm4niDIA&oe=6A086A44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA66a62s0EIQ7kNvwHI1vCR&_nc_oc=AdpvCFWd7oGe4bd-MyWQTgj_rfceoR6kSjmJxDIwEvadchN_EKeaoANEa5oq6mGa8GY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UXxTDW5auoV-FSkPFcq8xlCL52yjZdwRsDEoPzRz8lg&oe=6A086A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLlR1aCmOSQQ7kNvwHg-eNJ&_nc_oc=Ado_KMHDINbU7r1yUkBaN7RZfujTPxAYHIo6dzodbdDWt_nXw-g1-SlZANHzsRCuVm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78gHk3eRZncQ4AC45rsyO_rrz45bwJID1U9LREG68gYA&oe=6A0867B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4y--4dLO8YQ7kNvwFkSEUe&_nc_oc=AdqQIy45Kkou4FXJDlA26mmgPS7jb6beOM1ODKoZGl1M9oNLkMK4ETWKyD4VB5_Fusk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy478RCKFY2h-CRXf-DCQn-ma8KBvoARUddhRByGrntA&oe=6AC12AD6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEuPvFzPBh8Q7kNvwHxkZQa&_nc_oc=AdrxkyVzAKkFUSckaVxbr4nfHAvfH5idL5FrAeZBUCJByUVrir9iUmj8HVCi33abgxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOprdKSmblUst5PcqA_ABA06UvAZKCMiPt8-NE7XyAs_w&oe=6AC12656"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWtgJQm5aA0Q7kNvwGGBZ0A&_nc_oc=AdrBDaix5aCRg7HsgzLEKKwZyDpcHPM93At9PLlra46gFV_zogv_WIw_K6eEIetErXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpIeLMjH6Pzr1yIRtDVWTQ3xj6j-E8gCwY9W7VPTWtGg&oe=6AC13484"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkB_gAlXgykQ7kNvwFn_3oG&_nc_oc=Adpb8_fqqPCyCz9M4dXzCjf3WuOoJNIz_atNlNLRboHRMWoKykBsPErgzVdlIg_po5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZhp8O_M9rQrI49Q_9pqlCikfkvG50XqrtlWgvQvs3YQ&oe=6AC134D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glV0w1C8vmwQ7kNvwE3Gqdw&_nc_oc=AdotWxrj0i8ntGE99CyWl5oeeh1qC6Wcqg2ojdrTbCc_kFwKSym0GxVRijbIkNfHxAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSHdR_9jMLSF4NoM7cU_641JIMx0X2OZdi-rWm0BdcNg&oe=6AC131F8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
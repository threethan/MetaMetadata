584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt8zb5VQnRYQ7kNvwHidNAR&_nc_oc=Adp_CAR48nj7Bo4nQtkuR7LuB1RD-GJ-Y6FMYDjHiEaUNcqLrDnsPAEMIb8yndt0VM8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31Vv4BPcFLqVyvoWlklAP8Pt0PtLlo5lM_YFOoNUdleA&oe=69EF5416"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J80W7tiOIbYQ7kNvwGK1Lzo&_nc_oc=AdpLMU2I2bZF27_r7O8qu4cx1i0KFJ6SWtNEsuxZbCuXK66uU02AFgbjjebkHo8ukBE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aZXRxTLGGeWdMSii2b1k1fkjJ0TVikbfp6PqEYWSu9g&oe=69EF4F96"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPdf44X7uU4Q7kNvwHxCQci&_nc_oc=AdqSV9PCy_Xn_0GHgT8vpR9Pw8F7t4KmqXo_zxwwCYwDILH8pg5pJIu-gBOm9uoRTts&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19b4WAtOHKH6lgV5NBC-lvX3_0aXLA3cvW8NicxOPi8Q&oe=69EF5DC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtAG8o1CpqwQ7kNvwFh9KHa&_nc_oc=Adob5laBvCZvHNC1Z43wX9ZfOfaCQ6tLlGZ2a5l93LmguwFuMSB3pO_lwYKciKR-9Bo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af374F-7kayx1pJTAxgDrwUgLjWFh1A1nq1cg7NwZxZ8Hw&oe=69EF5E19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPcaDEbZyFwQ7kNvwGc9tmH&_nc_oc=AdpQFQspVb3XPJJLQRCp9zxM33km7EzUQDHvVSHiZV2X5ZH5N8tT9wUz42ZyLlfogFI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IdM9CXyocY6RiQhMWA5EFUikH98aMBAqLKUAL8uhLzg&oe=69EF5B38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
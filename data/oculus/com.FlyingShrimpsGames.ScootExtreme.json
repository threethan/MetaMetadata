584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smzBtfgG2eQQ7kNvwGyddzc&_nc_oc=Adr8ZE76Pfrx63f0fL52EB-hKGs-Ehh30dqAvnJmKKxY9JJBz27saHTAGjPxbrcxJ-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IGV8atDSoaLrGQoQBwnxA8dK2zUJnXiTKzdUEK8OVog&oe=6A01C916"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uwGC_ahkSkQ7kNvwESxn8K&_nc_oc=AdrqBCOHM2gPS6OuMT9xKNWkOHrCbycCEEz00hDRntBO9iEOyxicQh-CxlqL5qBTA-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Ztk09VIhNTrshrCewruFIlLNWA_-RvwobR3P73LZ6Q&oe=6A01C496"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3e6Hi5uZ1sQ7kNvwFvYBIq&_nc_oc=AdqazNvzuiKCJx5zPNieuBg1_Yktg8ykXCv8qCEZhX1dhEX-lvXWUj2LMpJhqyRprJs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ryRDi9u-cLq54-nvhrnVv1gPTUHc-d8d2MlefDYhdKQ&oe=6A01D2C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYpPH7wojmUQ7kNvwEd-4kK&_nc_oc=AdpEhtvh-x9Rl8Y1upWXmIn1v4uPH_3QwBa4KykdKGcVMtKCNQSdYu4LIFbgcl4a1iE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50BMQjiUW5T2IH7_9rvCGANE0kjuiiSR_wT6lVwmI9fA&oe=6A01D319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DovyDwH_CAkQ7kNvwEFZSae&_nc_oc=AdpvlM3Jz6LT63VNQZ1hqUpR0ED4UiC77xkzT5hz0K78wxjgMFQHlnVFqA4l104Vfbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DrIgKRSVARNENVlUAjO0gCYxmxkOxOrhY4UD-dsJbSw&oe=6A01D038"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
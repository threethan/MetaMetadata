584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smzBtfgG2eQQ7kNvwGP1-im&_nc_oc=AdppJMsZC03y6Ez4rD_0RWntcA5XYfFJEWQKXAtlUJKPszfRm1k_B0li0vFJ0pUtxZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t_iYb0E7wueqQijSZaAICOQ7eIa--V4tyxuEdLPhVpw&oe=6A031A96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka3RMP0wQhYQ7kNvwFZS9Rx&_nc_oc=AdrpXa_wBrOxtpU4KyeXUTD24Z6OK3gHXvuMj-OiVyhQwEBf3liRw9SprgCx3qPPjkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iMljUYkFa1duemgXMUgNzAlh0VXK2hvTnvUG5OnjKgQ&oe=6A031616"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3e6Hi5uZ1sQ7kNvwFuvOvp&_nc_oc=AdqS1SLxrZMJCO8uPQciuzZuenXu_KUg9RENGtq1TsRHPqobLvRC2cuj305kt3NNj20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66rHJygIy_gHbGYSSX7AU4fQD0z4BqCNicSdpgYtrdwQ&oe=6A032444"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUwV3hB9Ms4Q7kNvwHp0fYE&_nc_oc=AdrU1aBDoV3cDsT_U53dMkqx61-jltXmF84ikksOUGgZL0GoFHlSO3XAIGEhtFK2Frk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mQNuaJFGZcDwhZ1byxJoFDMUeq3nz4PtXBIk59YcXBQ&oe=6A032499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18FfuFIwToIQ7kNvwFGB2Pc&_nc_oc=AdqJ5thVflfepN29mrFOrF6IfgES88KUm6VR_4mXZVdwFs7VAEj6aZWPF-oq3wUiKj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AWVsBf0c3EdfiJJcvQOED37AM3-FDCbLgkiOyQUFyNQ&oe=6A0321B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
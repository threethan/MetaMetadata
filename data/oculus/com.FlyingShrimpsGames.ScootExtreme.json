584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt8zb5VQnRYQ7kNvwGjwq7W&_nc_oc=Adpg2b5Qsj2OWxQRT8NyJrFglHzMHw_iU-iXu0Qa9lORfsIdWx7Tyz0oniUgQjYI-aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AQ1y5evzIfFvWidm_5KwlpN00EXmZgxqNnQBxAR11KQ&oe=69EE0296"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4olea68NisQ7kNvwFiJQow&_nc_oc=AdqcwJdI3-AArtqHVK9f-IYoEclFrowUS0W96UE4d6SJQPlrACpzixNcdaIbKartWnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HunHLWiToJkIxKiQmHbLcq7NC4apLxNTcB2T7Hf-HHw&oe=69EDFE16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPdf44X7uU4Q7kNvwGsnc_f&_nc_oc=AdrrPrgEZED-PB_Mxr8kVtqUHvHWPw6s0OQDMguVW1KGfJvWUTAsfpnbvK7WfALRCjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f4MZONbPauMgKwzxLhwRdL5TWoys0ymJu1hYX1W3SXA&oe=69EE0C44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcpfSxN8pOsQ7kNvwGP_bRA&_nc_oc=AdrNpz2k7Bq8iVssUGlS3ETAyfyaqKXQrWXd1OVRuLN41Glcka5MfOMKAvrAeolSbas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lAR6a5awkDcIuLiQtrX9XWFgaiIGnsAUwZRYNYMbaAg&oe=69EE0C99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWH3sMwEw2cQ7kNvwHqKKmP&_nc_oc=AdpqXLWSs9UMxQrFIRh7m2PnD543_3tJguf1wpkYo4BZVz7CzDwETL0NRj_FbHTTlTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xxcynAkMuxKN9YGWYHQt31BhuFnXgpr4viKURpY4KiQ&oe=69EE09B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
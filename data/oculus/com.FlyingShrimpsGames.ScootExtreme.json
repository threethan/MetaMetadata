584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsrvydBcsZsQ7kNvwGcXwVh&_nc_oc=Adq4V9_Uvh2WuBPYszW2cHrNu5RhAZl-k-aZ51EfU7eorlSugatpfgc9fiXxmchpBLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKISQHmfI3-2RUNQOdlKOizCiIbAMqyrPBKNhAgZl3ReQ&oe=6ABD3656"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIexjdjwVtkQ7kNvwERBygU&_nc_oc=AdrcqBQ0IeFxSxFn4VlYsRknp8EXD8RVaj1s8bpUk_avjjmA0hxFxWS_hLt2E9jcJFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlG9jnjPTR6uluyH08_VBCvNKEGN7A0EK4EipGXHoeWA&oe=6ABD31D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VHgKoWfLzUQ7kNvwHWGAaq&_nc_oc=AdotzjmX1dGa9oBZEpUhzxNbBbjttq9EpbHCsaitDr0SIqzlgNHdWpKy7HJap6V5wwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYhMtxDPPoK69cmwAmLlwZumRBVQRYpC9HX5JKKvCjyA&oe=6ABD07C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTETZDl62rsQ7kNvwE4vBCt&_nc_oc=AdpH5Yws6uQzZo1i1beFB5jspzx6IXZ9EnSYK7iBmoi6GbADuYTukrgPYASbiYXYT_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcx7jfSfcZgkqG1DEZnWftVvIaCCocQhgZhepQwzlFqQ&oe=6ABD0819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jlC-TLFbWUQ7kNvwEbOP3s&_nc_oc=AdoIVXqNY5i3eXsNV4G7_MZ1kjr2zMSUMWQ1U4mWXCRLSiuXKhZCeelUhf3I5gRHfGk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxnCXRG9z101u7xfny7zRYAts5elkKkWA5AVhsLoGA9A&oe=6ABD0538"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
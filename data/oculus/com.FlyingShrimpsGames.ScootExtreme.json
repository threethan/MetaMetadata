584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skd2PE52EpYQ7kNvwGJabDE&_nc_oc=AdpreGILfpHlf_Nkuti0xXzBgJD4W42dt05aPu7meSvivnNF-bDJ3ovEW-qhyX2N1II&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-7gsPCZB1O_0UMrgj0ze0f1uFQAEswUCm_efi0v05cg&oe=69DA3C16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48EjddAa1QAQ7kNvwHcCImk&_nc_oc=AdpFW9MlrutJK1Rh8mSNVTdiLhoozynfTxwarW9MI250ciU2-pnYbvhdzK1sIAUnVFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26y9vOYg76XthrQbQN_KP-nVqvi0BzV29Dk0rf4jmgTg&oe=69DA3796"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvUyMw3XBL8Q7kNvwHKk8ql&_nc_oc=AdqY6SzCMFej-hfFadkN7wGt1sYbm8PKd47x6MsQ0OWRrZZ6n7tLmkMtRJYRTHZVEBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Iy8PttarqQ-Ss-8jOeqRsarSC4vJKBH9YcSe79xpU1Q&oe=69DA45C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZwegvsy7rwQ7kNvwFWA2G3&_nc_oc=AdpfIhfIhNI4a4OAkWv0MHiXifl8NSwro_mQEAuPtky3jZREVTJ5c1Wr3yUsMcxyWAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MI4d2K5ZI6bJm7DZ3S92iuR476y8EA_G9Jxw02t8TwQ&oe=69DA4619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rn6xA9QsoMYQ7kNvwGQZq4X&_nc_oc=Ado50SCVvNHoFd7zXj8jB_rFbDg4zcEZPBs6ZJ9Bh4OBD8JJ1PdDXZUL6YYRSJUQJVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HdS18bmuLBTk2t-p3OUrA6aG3CStoNzRrfAc5BMUvGw&oe=69DA4338"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq__D6iESXcQ7kNvwHqpwMq&_nc_oc=AdrT1uzHmkjLcuMs9JX_G0k1L5LnBgkEBUwGlN5ky0U3Bg8AY8bauBfpJ5rQ8DBtgMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_WIZM89eRfNdzMHrAWYK0XQbJrN4B-N_NENRVoCiGAw&oe=6AA54316"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g720Mr66QgQQ7kNvwFGp3Kk&_nc_oc=Adr7Gh6JqyKUfq59vK7yNihf09goXuABWYjAfRFnLQtppslRDQCkZL2qX5X4RRgFkCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpfbVPsDiWvHqBBL6VG45x04K0SMFpie-XZPKNjbhQTA&oe=6AA576D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9FcC1dz900Q7kNvwHtC3A0&_nc_oc=AdoWV-KBBDtZNEzRyRklt0E8dpbbjYT7tLOq-dkGJD5XzpAAcPrrQsibN9-FLdTV2JA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf4DJP4KsLL_GOPNiAaOOBQomV9FWsYjVcDTHAnUWVRA&oe=6AA54CC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvRsnamXypMQ7kNvwEpoSv-&_nc_oc=AdpGlA0s0A9KqM0BUIBlOPmreoav8yv1EXVIP4AGaxYlQmQOJbBZhBHIk_mtp0-DnXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxn_AwCcpgv3AcTL8MgUFIBEymY8mFF03Iz1qEQnVeyg&oe=6AA54D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1fBBW-4kCsQ7kNvwFDskG2&_nc_oc=Adq8KGuMppTQiRm4RSkp1E3eO30wao6UhFLNOV6S-aRctglpQ1Yidlr61dP5RQaLuqI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzVKH2KV_tkgYjCEcmNCBj7-su3Mx82RZ61S95V4rBhA&oe=6AA54A38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke2qLBen3BQQ7kNvwEZSzt0&_nc_oc=AdkqsAO8-arnMAxpfE6NNaVl1ypC3YtDIhFnTplUqttLU5sch6GzFYj4C-udW_HUg3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-3TxcZ5VJ7lI0P7fNUlWfB2C_2D_Sz9SpAqtDdurrqg&oe=69AEB616"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ytKN8MO5dEQ7kNvwGvmMK7&_nc_oc=AdnrteUDIgzs6qHqRGe59ltjg86rpxlwuIMHYtvJOL559-gdSFKe-zo0WBzo5oO9Sl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgjFSfr_mjyGE9KDTxMJI2YxZ5eW5zzoGXPEs3ia2png&oe=69AEC444"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDSx2WfCS10Q7kNvwGthiln&_nc_oc=AdnLB06y2JpA4aOWGHoUYetR19wDWB_mUPGUYkbg7zzUNEbPq1yGiIA9q-YXfVO3qAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPjEZJg5ycfQ7Zf5GnIWOJBceH_nkkOGzOtVMLkITM6Q&oe=69AEC499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-Vck7pkPrgQ7kNvwG4jq36&_nc_oc=AdmSCTFEkypnzPmnUcR6FKmxbJfk4tvLjnbwGmPdpG6ZyxSXJx0y5MK1hV3Lcr8j_wU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6teyzg8c41aQP3yXAFO5Beafyg0X-1DM4AVbwnj3Yiw&oe=69AEC1B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshrimpsgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_
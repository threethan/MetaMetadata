584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l05kKVhTwScQ7kNvwE9D1gY&_nc_oc=AdqRrvTHgbjOwCKpjpEZNxWJ6MHVZdnd969eT8QShz5UDntmkbFRl4i_CZWrGCPpqJQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIHU6AzkS9t7L5lYLv7VJ20d-Yk-awlAX7lX3uJ-YXeA&oe=6A92CE16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6f7FeQD-BgQ7kNvwGglh25&_nc_oc=AdohtpwzHma12E-BReLjWXghbIUvDuGCGitONTT-wWKH5Ee7OFnKFS1y4FpDRC3kjcY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUEYeSKUTAkCqDV8XIJvYSy1bIWbxHFUYLLgFIRXn80g&oe=6A92C996"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CRaMIKXxoUQ7kNvwHrG0Bi&_nc_oc=Adq7CVWL0CBg_2pPiFzn4453yf3ius4tozOX7y6fkp8WszPjr7C1_H71aplyB7e2rJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc0ecCFnWL40isjk3_88H5zqImPyNI6n9-aBV8gIkE2w&oe=6A92D7C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owl70iJreWEQ7kNvwFUuIVW&_nc_oc=AdpWlIHrIZS1ICMcM5Vx9PaZRzCdKPVPO58395UBQY4OaiNZYbn0Zw2wsnzepeeIzYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc_hZKNs__lNTuFRdLNTLNzcxEhMEIaeIvc6uBZKZ6nw&oe=6A92D819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmEOWGLqD5YQ7kNvwGuFWcv&_nc_oc=Adqdfyg4ua3ft2EkU3nbJVxbhN0bBhpq3FDXoF4gOzXlgVJEi8WATbVa_4dh9YIUOd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl04laBz8SHMyVg2GMl-9odZk46HUzf4JhwzU80sk6sg&oe=6A92D538"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
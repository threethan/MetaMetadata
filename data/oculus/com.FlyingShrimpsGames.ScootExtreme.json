584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aEwftxjDLwQ7kNvwGbnpK8&_nc_oc=AdqRjYMwXsivXkiNR1fYT86zj1kJ-UX8Q9prY-EwgRo6sigCINNL6TCenK49u5EQczg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCjUi8EOuD2YdXepAyfSAYp1Nt61WyqvSFfnL3ger3Nw&oe=6A69EF96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF9tj8kAYtAQ7kNvwFiibGK&_nc_oc=AdrbNRNYsSovumUOgTuvI8OXTYdvIUUnAAlCu5IyLZXSl4LtSC9XlF3bsvaFjHWrfSs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbJYvbVSwYmPAPL-KMR8v8rqXhBesipVCDrsQjmwkVGg&oe=6A69EB16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPZ3HVTtor8Q7kNvwHl7Sok&_nc_oc=AdoN6tF55_VPnoAvVY1kpAiTZxHRDmlbqogxZBBr9Af7Ngt0yYTY0BoN9ww0oHydoiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8zSTluwBAmMigm6m8_iVIGfGof7P96vWgCxzQ8RTf_w&oe=6A69F944"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOxVZ2QfRygQ7kNvwHgjaf5&_nc_oc=AdoCah0OfNVybgqz944KrGzhGu6-_nykU62iinqnlP7yQEGO5h21BmXFaVsfBjypqe0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp7qp_U85bakm9FhossKHvI40cKPV9Cn1cKF_lDyU5vg&oe=6A69F999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgR3OjX8nWcQ7kNvwHG90EH&_nc_oc=AdrFDUaOh8wPdwA7EwLyBpopLYofDlyF2TDww9SDm7Ks3IIbymEQ7Ka3vODNzw5RTtA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV-yDKpVuwHe2j097FDut66NAcun_SguUxraL3UCQrjQ&oe=6A69F6B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
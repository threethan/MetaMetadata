584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBKKkXaQkyoQ7kNvwHK6zXn&_nc_oc=AdpHrSkPFqyXIo9SNnvku3q9t_RMV2lP5k05b5G3yXQzvmEeA5LjRyPtBGlwzX0_NC4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A_mQI84CkCeEq7ee_NLRHooeAOJBM42HgGuM6tUorUA&oe=6A3AB1D6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIYStZ5WBSsQ7kNvwHQHF9t&_nc_oc=Adr9f5u04UDRg83tpPnG3ymzd05cL9TogadFopfEbo3-MjOwsqpWsVTt0OqGfrNN9Uc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n-yQLtvZ-X0rpgZmimKbiIXIr32uORRjZ5F1E-eNNWg&oe=6A3AAD56"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3yzeEbwMmUQ7kNvwH6fTsu&_nc_oc=AdodTi6TBxs6BwA8wlzXKpR68d3vTzjUToFbpRPC0hr3FMd0T5x-KKYJDIM6Dhf_cD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jSpSWqGNSrlcMPNuzNWasjlOSPesE0N-z1Xhl50lKRw&oe=6A3ABB84"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VDyv6wLoEgQ7kNvwHfjmOH&_nc_oc=AdrVqlV2hKE2qkt_vY5af9l7OL826jMHKUdDlpumK5HKde9Q_COyjuOaV6w9YTYv-zM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l5LJ_NLjDlmqzkFl7ZmI2yqFVvsfZy5DN8kSLklf8nQ&oe=6A3ABBD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1Db71Nvvm4Q7kNvwFkvt7g&_nc_oc=Adr4yWmFsK4I6N_Bz8nP_UqZmRoYFi_WT44Pv7P2cB_KgsOS1bfL04RnGs20AxAd4u4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dEi55MPCSdligRtTFzRjE4FEjnJ_ZXzr7k246w1_1Ww&oe=6A3AB8F8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtCsz11X_IwQ7kNvwHju1fH&_nc_oc=AdqF7GYrJnNXotd_5C03PhCLWv7zh_t7eAUYDWgkPHgXs8yTqzu8I2DWW-tXU6RD08E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP84XyY6P3O7Z7Ra1xL0WbRUqNdxOsxyjCSbU-dOJXDg&oe=6A844D96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHjnBQCFGasQ7kNvwEnG-A2&_nc_oc=Ado8BTVB7CLl1UjSTdU9qwZ9XTIZK9TTtwVMt92re-iH23ML4PXe009gD-1AEqQn3Uo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIgHwEjB0tWJ1oNvUqHphF9DlyuXaBSsrpC-Yw-1Z9jQ&oe=6A844916"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPKOwrNXAhMQ7kNvwEdkPZN&_nc_oc=Adq7rS_exo9WeCPyvyxhiXEOxErRazCvf2iZnwjeBuF-sa4PvZXcrdj4X9gd-r8GvBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPU0_0jrvYAyRio1P5M5u5dpSIc__FZkH3DH2j7lu4mA&oe=6A845744"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuZgsVLtwCkQ7kNvwE3JeT4&_nc_oc=AdoNOW_GurKSMs0gz_fuhHqHAmPmUvdYOOTbsKtOj-SR9z8IdWNM0qIM-A02S39XY2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0VNzD8oZJt_gRobKst0yE_qK2MxPVHUAdQUMNx_2sgA&oe=6A845799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AUbtqEG2uUQ7kNvwExs_IF&_nc_oc=AdrDkad-XKesuZ_rcKREpajsh5DhkdO6j_4P2kDywNBGGoCP3h3d8N7X1Wu4ONpktRU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOnHxK2Y3BA3NQvTEDWWuhRuqhV1cF7sxT649DsoeJZQ&oe=6A8454B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
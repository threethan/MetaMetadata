584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C8hwyO3rhMQ7kNvwG7q3Be&_nc_oc=Adpt1-FL558unL6DBY3LgtRUp7nYd6AWsn1usBmHQKOAbkXp_thak2kwh_P-u4F2jpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8HT1lNB-1nwxAmURfkAUxVkauH7RhFACDEHwevoheTg&oe=6AA2A016"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V_965XSEJYQ7kNvwGeVteW&_nc_oc=AdrbwDmMts7_cWgCYjgjeQ62cek13upNmCUgDTNearsvh3FL5-kxKZ-6hxt2QYmpBWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzUPIUm6WZwiqjtdocaaSsCL5ILLSqfnkduAhcd5dH3A&oe=6AA2D3D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxBkeyGeHG8Q7kNvwF-PFSZ&_nc_oc=AdrZGABjDnCLE7_ZzaRfuGiD075Kcm7Y9NuzThsPVzgxaJrTU8eu1L5GXh6dmggO92c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjXXU1B-2RevAurTkxsAMJCQ4PoFirk1LXaqo007e4zg&oe=6AA2A9C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcCeL35XvpMQ7kNvwE-8-kr&_nc_oc=AdoeTKHPE8N2xh5gA-1oOSWM6UeAFEwO7AViJ9GDmzo7jmLS9FIqBNdFLCteDFoICYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEGCRGDN-9yrwSoo4NOL90seOQZNrPtnh9nX2jJ_yqJg&oe=6AA2AA19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6MCQzq0d1kQ7kNvwEQiuMv&_nc_oc=AdrGCmHvgYVqki9Q7Ao4i8Quoje_iWw8EiqdkOQHPbiTFZGJeSIx58Gh9Z-UDNa2KEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdZqbR94IohBdukF_XoBpRf1HPREOUATwpoY7i-n3f2Q&oe=6AA2A738"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
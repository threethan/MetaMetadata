584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmkOw2CKmPwQ7kNvwHL8sKz&_nc_oc=AdovyQ3lgWvEiYXQVRn3QXDKfqB1zGptojnkOUBD2f946HcQS2zzjw_wGrlBHq0nZ8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLGVojB_Sgsqxu6U3H_FHB7SY5xD1Z1CPkMCRzzPQuwA&oe=6A674C96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yZQNWG0MqUQ7kNvwFgtIsA&_nc_oc=Adr6gUVcoir09l10WBP2p6wjdQalMbedTRFx-d5klzw6mdCxZyLv5iOrUTmAZWY9BKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZUPCMnddjbnIFSpfPuxLTfFlCw6bIb7VD35WBn1psyw&oe=6A674816"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDe0XuIj-iwQ7kNvwE_xVKx&_nc_oc=Adpl7Q40pKFLdVbqpRapw8byA9P37uNNYthhAZQx5VHgjIhaWLPsoAop9WSI0_tKt58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV7NehU1IbqTmf-sQRXBOJpSS6J9lXzPsLD3Wx2FNmOg&oe=6A675644"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaP3c0foEawQ7kNvwEDi4Sf&_nc_oc=AdrAkMEc89B4ElKbjfNrrdmOlwl0MxJk5y_N_TNvrQh3Y_NTyceGqCu0Rnm_ncTNcjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVF5k-c8hYDiKSFUuBRNnLskFhAxQO0B974s4IYAozXg&oe=6A675699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xucFK82D_QQ7kNvwEggRKY&_nc_oc=Ado3dmGyrn28RSSVK_ok4szMFXaVCOXLRcwpF-5bwYzibueorJOb5jzda25vTiibHOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwJ3OUTAePzjdJPQnuzaaM7KzP9lonyvbZriQzSkSqmQ&oe=6A6753B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
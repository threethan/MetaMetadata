584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK_fGokiCboQ7kNvwGzCCGk&_nc_oc=AdrkbGa1QAp890dt_slwad9zvJqzIYIH5cCFO2SrqDou6LDcr0YveAroSneaPoAHRkw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2aPhxR6WRaP2yTBHSI96lvGovBt4DDRBWkiIM_TJFVcw&oe=69F49A16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwZNvm5FYD0Q7kNvwEPT3WM&_nc_oc=AdqiAl1Z88tNfj7x95O-2A2OK7Q0XTgJZ-Yzl7fBE4DxjvsAs2WQAA1VvjK9QSt6H7s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dpTlPJwmJhuigDyhJ19qcpsbfrlvYQUJw6tNn9wfBPQ&oe=69F49596"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFjZtgC9eEgQ7kNvwHWfVWt&_nc_oc=AdpW1mEjwuCu3LPxzH7Gy1ie7Z1c2YfPwDonJ_4uJ1z3WaUVgxkwNaQWUcTUgj4skQ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2caUmgx4Kd-WMynFC7nrlKMbBbf2B_V-Mn-KTFxg84Og&oe=69F4A3C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmQ8Wzj95ToQ7kNvwF5hwtu&_nc_oc=Adrt_23elTgVBtVikGLrupLbnYgXERKCEmoMGN5P15LhmcmkqFfZB1tZx5ccbqLVa_k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ckLyuW7FW17ZnD9dguqe8Za0mLQmeD-Q7IKtyCPr9Gw&oe=69F4A419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZbFug85_aoQ7kNvwGE_EjB&_nc_oc=Adqatx01qQvdFzYXuT_noeA4bvQwjX5HND1UTSZNSGin9Z3rErtywonE1Pc4it103bI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1f2DQo85kLvY4Q6dxFLoBkFf7tNHcM8nv7Kmm6xt_q4g&oe=69F4A138"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_qnkfJkvAIQ7kNvwHz5fjb&_nc_oc=AdoiulvHHOSbfQC_Df58r0E_m3qC0CGtmIHx8pR9PnoyoPepSun79kwcs8ZriRMOEt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDngH_PjsPv3uKket796vFEd_AmFrOuh9s9cmN82KGYsQ&oe=6A523496"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtRT67ZqpXEQ7kNvwHEqUBI&_nc_oc=AdolCs-kKwle2Xbrd40MOTxlS37saEnqb00VKejXqUelDRJziWb_o9gBbMVdfRKrAp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuNI4QuKe2v7YTlh2i1cJ_Hw5TAZq6uLbghaAtRwT3Tw&oe=6A526856"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvAoGuSxKiQQ7kNvwEEl3wq&_nc_oc=AdrkQ2_vNxH0neV5jZYcE-CeXvvAJjNFqdhN8lCVslJZCko4mSYknS_ZFI9P4OFla5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAztz0bQlB3uE6w6kgmioIGW4LBrH5YB4ZkwPA6ZwPeAQ&oe=6A523E44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbKx3KOzJKMQ7kNvwECEK3H&_nc_oc=AdpXFH6Vv4oPqVHF1YAQ6aqVTdtjmETrMr1soSyaRYCtRakxoqzcklLD2T53zbTmwW4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrji2MiTYEBkbWl6qeVFQbxY3HG0IpYBKMHC3k4kSmzw&oe=6A523E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO8gGUMFZpEQ7kNvwFdUdON&_nc_oc=AdqFVOf2ntwBVhyqN2Ue8gchG2jnJdDlDIolMLh3RCuhcWuRakLqMY3E8f5t-KjoRIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi9v5k8diDXglA7xagz7kOmOOTN8Y0C5580zWK-x22jQ&oe=6A523BB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
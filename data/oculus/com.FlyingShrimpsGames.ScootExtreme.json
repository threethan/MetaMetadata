584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTxsxVEOzpQQ7kNvwGir_AS&_nc_oc=AdrFNfrfU0YfJ1bnCv9qoHzKmjcmwmemQMBfOqvCptbSG-icH95Nt2x3k-i1G7n42ac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_DOxNVc3OR_zGUtOHLh5NPsQt8SPs8exDYmLX8FgESw&oe=6A0DA696"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOey0zSkXykQ7kNvwGw1Joo&_nc_oc=Adot3NSq-rmKQJnAed31bJTmX8NT7fcLhELz2IOnwTa9u6N03X7ab8XXgY7UYq4uVGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TBU0TQq8hBqMlNp58a9amMDivIUsaQmoPkcY2W5hwhg&oe=6A0DA216"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0j1_9EeV_2kQ7kNvwE14vkK&_nc_oc=Adrra_l5vgnoRET9Edg1wZ2q0nm8uqzAVOCKh3cc8Qh5Y_R2ZD8hI3wL1jhxCl2J9pM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-TQw_PdBP7L5UxwCz8nrXNZsnVKMYGbqUwtrdqMaV7g&oe=6A0DB044"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHSTNyj4QxwQ7kNvwFVvBXU&_nc_oc=Adr5wtM7UJQVgM5U5Q4IxvALc2eSG1nCHbqGkLIuohTLR823PZxl83aY_kC32TAVLoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rFoBU8mARvrEqukH2GYOQ12TdXGudt1AL-5qnzGjotw&oe=6A0DB099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2RP8zvSHocQ7kNvwFKO5kM&_nc_oc=Adp7EIpHtMk6ELTRL1pz-DfEFH3p56KiXrjBUYxj5jV8_5iPwnyoY764c8sI2jcTMLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZkWnRUgvpgSBixVHP2EO-cIOGjzrC1z3XPjjZwSyCzA&oe=6A0DADB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
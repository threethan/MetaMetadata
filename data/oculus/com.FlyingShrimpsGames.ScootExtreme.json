584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKBxQK_nansQ7kNvwHdKTyZ&_nc_oc=Adpi4NfUbUc4PrmzXRGUfZrTmBk3EoTDdzMzFhQytiCX19bjKE5auCpmQILcvLcrBhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qa4JsT5QDbOny7TD11lDHFUgi9TIwbk541g_nKLntAg&oe=6A05BD96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka3RMP0wQhYQ7kNvwFoR9ag&_nc_oc=AdoLNafqJ1XfuFzBYa7J38zp0cqzFA1X_s2XmwaRcI6CboZar72Hkk4-HmBCYRQ_6p8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J9gQreMsETtY6Fm_GO2bUbhWrKvtgqLTIUExT3H4Ijw&oe=6A05B916"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3ALhQxm0rwQ7kNvwEeu2P8&_nc_oc=AdpkEDVVzQnyFyCjr4lVfZ81tobcBFStNMq1tV782p_LgmBDbpmhNg3NohU54lOushA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q1Jf6YRtWu8EF5Wxg_vSQw2bIwIFlUtQLdBQf0zgToQ&oe=6A05C744"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUwV3hB9Ms4Q7kNvwEKLjRH&_nc_oc=AdrPpIE43OqZh2412EC_fdCftNfiWqFNwAgUDmNZYqaaEOdz5d5R8P9ZYlp6z_LzPsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s1O8r4ysLPADX-_MBRaFXOdZiTlUwS9yODFfXqb8R7g&oe=6A05C799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18FfuFIwToIQ7kNvwG5YsC-&_nc_oc=AdpZE9cMfvKj61kptEtSyXuKdovxHwIIQ4TNt4gepD0koKF2X4TI_AjTBb8eoDUNfGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zL4xY5PmT8VUgHDt4FivFRrZ-iqu3GZ1Tm8E7K5S7bg&oe=6A05C4B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
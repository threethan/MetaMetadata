584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aEwftxjDLwQ7kNvwFQU6uj&_nc_oc=Adom9EnATacv-Ih8yyHd42XjcAvZioX2CKsw7UzmpkkmmKNGxBKcAmeCxB7qUGVzvOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP7B0gU5bnjD2N18ULShLhAJOMSSMgr6KlhWv9LVsOjw&oe=6A689E16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yZQNWG0MqUQ7kNvwFu_aJa&_nc_oc=AdrttyKgMXVEDETCQFimkeVfmTkSxmyLQT0PL0liVJPp_fbukHSamBZzKIUR05oqewI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASW7dzESKYqcwIkty7dTnPFTXlSVbhtYyxzY2mi55L2g&oe=6A689996"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPZ3HVTtor8Q7kNvwGeXqTX&_nc_oc=AdrLmML2nol16P6TLZGoLRtR1hnmq6bQZXB6OTyHIKx8A0c2R_5EbnqAEKQ8DKd609Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQQ1IW7klTkVlleReG4RuSXguyybHSNO3bgPkfF8o2FA&oe=6A68A7C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaP3c0foEawQ7kNvwE4G0Gb&_nc_oc=AdoZ3_QEtQVzQRSI-EXFxYlK65rRGQHGn8SgwYqA2sAEd0QiYEsDZY0Cv-LVFH9rmX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm9L6nAsc3uIKs8Nr0Jqp-N3SOIA6IKzM_PO90eNkFZA&oe=6A68A819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xucFK82D_QQ7kNvwFLJ4l4&_nc_oc=AdqJlENBbhtzL5SMP_qmJCt0Esg3feEOy_OQDyhz7JPi3rXiGPmoAvBsa_SiEjjTZOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPzw09Nz3WZBHIjbzbXq9bEpIKvXM51zUqOj8NhlH56g&oe=6A68A538"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
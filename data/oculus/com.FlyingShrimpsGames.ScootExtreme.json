584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3o1kj4800YQ7kNvwGhhoN9&_nc_oc=Adq2pT5DQvBaf83-7vzOup-xWUxGIHce2E5n1GbTSBKScHG7Hs2DyTxSwOYGDGEPd78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlVVroTLpIPTjM3ajIWFN4-nb0u3V0GsBTiUlVIV2Viw&oe=6A7C6496"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqugCWDUtW8Q7kNvwGUSWTg&_nc_oc=AdpU4BagVlQUNyFo9DmgTRwrHcJYNNr-06LZNoQczS4RzJmG7Xz7We-CkcIFXbuEUeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPHGpXrp6pawzsfLHMDe2nocFVdKSBOG0M4hx2huSUug&oe=6A7C6016"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi1B4ayWXNIQ7kNvwH5i9nD&_nc_oc=AdotzNXKp1hMOfANvhDN-jJQFUbphBT_GApfvMMG9xs0MMF0m9gWTGaHKqKAA2buEQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk11nd8HqAoHbkOQs9HdRNgteT8n_sCerFtvRB0akJ0A&oe=6A7C6E44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwheoRiWepoQ7kNvwEEmm6D&_nc_oc=AdroUOe46ZA7KCc3-Qfm7ZViTmJIqy41S4loFG-naxnDLimkNqQAtn2ZuGem0l3sCSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXpj4o1eJhnKalJuPRIODpJy59aCMGoxW9mFGecYVxaw&oe=6A7C6E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZ3mPBwE5aAQ7kNvwHWUyCx&_nc_oc=Adr2Zgamfr7LLbG_h4e5qvNNyX2lXuUHwUuKBSDI0FhLx4j7bHlnehT1V_wytwl_hAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjXQYQWeP3rnMKTzJHwPBNwR_nXYDpI-3UC5DnO0ooPw&oe=6A7C6BB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
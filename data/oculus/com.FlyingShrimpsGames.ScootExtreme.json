584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZHh8BW6xiYQ7kNvwGU7eYi&_nc_oc=AdremPZw5AtXfsCaBzx4qczKK4gFNvpaIhGMdqcYYu-rAnbglDSAZPD042zDSm40axs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu0RY9xB7v-guTnRdpQZfy5UeWYW2dx61OSpi3vOTQzg&oe=6AC51F56"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSztTS_mwggQ7kNvwGcypvW&_nc_oc=Adr1TjopVrdZ9INiHJwgyiwC98JQ0FXjS34DTssQR4F6ndEcyBin6r01yiSF8boQBrI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1-KTOaZVAIspzbK-0Ole1HY-29JCZWtXeYyD-ayPa4g&oe=6AC51AD6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjYEI_jhtYwQ7kNvwEe3UzS&_nc_oc=AdonICttRLKLqosoplBTZUbRDz9naBqY-oGnNhK-QzA9B2nERTLKZoWpMnbaDZFkpJk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUwfmFcNx1G7-ht9-MMfu1-L_mUBYXmZzm45GbrFGLMw&oe=6AC52904"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrzleK2UeFgQ7kNvwFohS6b&_nc_oc=Ado_RM5q4jXWxFoUe0xK3s-eqe_hL34YRYBsuDXA4nyWqhjFFkf4woIaGpuKQtddgoU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8VkuXb1UKPNS__LxQMFi6utkNNfN6rVbMIi8LRIrBmQ&oe=6AC52959"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbKnpvpX9J4Q7kNvwEmtTlF&_nc_oc=Adoh2uPMSyDbCOQzFf9liUli-fjG6oXPuC5xX22MXzfTP5smcke8c1nN18f3iBhm8oU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRFRFmQoLsAsk5QscGcFS4RJBfM1MdVwooObhUD8jiKA&oe=6AC52678"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
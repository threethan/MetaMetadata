584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5SyL7xhxB4Q7kNvwEG0jNy&_nc_oc=Adom-5V3e_FOIRjUXs1qAfPzqj_mr7YreO6f3ybUaFlN9iOQTAmOVfYnGn4eifGmdzU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51BN2er8X8bQIGzzkUMAClX5G8C4IEj8Qw9MV-TLOMwg&oe=6A16E116"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39irAaPCECYQ7kNvwGLfaHp&_nc_oc=Adr49-fzvTzk1jpRHYecQi-f5ouh6vhEREkzPrYOyPS8JnE2zARFV35e8-AaxuetpSE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XXN8tIQU_lO87r7NIdrE_QY2yAyLrsujTBfnFosjpwA&oe=6A1714D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnrQZJpfXBcQ7kNvwF1Qgoi&_nc_oc=AdpAo_avFTQJxvacwioyrQBHKVl-DD28k0TdwZoNbDBTOvtUXahKLRw053pVJ-iZdCA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61Z22QYo46FDkxeA7B4p8hgwZnyMT4WSEzEvI_0LgAyw&oe=6A16EAC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag6gGqDqEoMQ7kNvwFEKiSx&_nc_oc=Ado0PEA0R6yIb3AKvm5U8SI-gYYDeOx1bQpQEvXnpq_qVpQ69Kj7vdSUfzqFilRWo7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Imz0fxOdxvT-5w3AktiQ3QtnkxebwAhpR2CbNl1UiPg&oe=6A16EB19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNfENgV9wIMQ7kNvwGrsZ7Y&_nc_oc=AdrQXP3V-Bt6ufong5esuMSVVU0m_c7gyxKBvAFBcRQrcIrfCJuLJdrXOo0URgkDYUE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v_P5s4Wqs2sex8gcQXdSBFFMJb93lVlzWQOgwloETXQ&oe=6A16E838"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
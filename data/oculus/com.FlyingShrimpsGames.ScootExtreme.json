584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFmyD-J5jQAQ7kNvwGUDvWB&_nc_oc=AdqltwB6UmeCg8QP5VF0nbYNvI8Z96eENM2VyZKqVky0T_vEt8vzMVgA2FWE_YIjn60&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af176FQ_-HQ1hXpdDG78J21MhWszrlTkOTo5YPbSAPjpwA&oe=69E8BC96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC4zHfVjkGAQ7kNvwHt5pdk&_nc_oc=Ado-YH7bUxh2EcDdoxsGhZZT2H4tRQRD3FWCiv1-RWDre8nv3pFVXM-jKSg8d_ab734&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g8Soy5PFD89ni3YD2_PDfIwgJeGqXsIV6cp8bBXdhOA&oe=69E8B816"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXmMUN95oFUQ7kNvwHD-bsZ&_nc_oc=AdopVBBfY4kQAti0vARiCdtSf1YD9k94jMOId44TbdB4v4Wc9PKt8Iz78NZRIxWubog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ergGljjwYwJBeJLMbmZpMkkeMnN-imQWupBysVm8O1w&oe=69E8C644"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfeWEJovF7YQ7kNvwGnrqRu&_nc_oc=Adp-iaiN_im9oewt5u10Y0VBwa6766T7R3VRmzfNb78YM3caTsjGpNJrb430DmONBZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35DvrmdiLBRqDuQvkm3ROJfOxg37EordgZdoA48vvCUA&oe=69E8C699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5T2blC49I8Q7kNvwEFWJqT&_nc_oc=Adph2LlwtzeX2MDWj_It0gqnaX-J1dNzWsxKBLtstDR7qrYN9T4wtkkb3janSEp9Beg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OAQ2cJvJeyRwuKHzHDiRW7ACi5yIVSnkLVxeZ__KIKA&oe=69E8C3B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
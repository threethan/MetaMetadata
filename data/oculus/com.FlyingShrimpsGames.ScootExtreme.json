584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjYVcEdX8YcQ7kNvwEYt9d7&_nc_oc=Adrrg1OEw807papadP5-VcAsB78TWLGnHjT4txObX-gh42ovJOomjvTT3SVAW6_ycVE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Ywo4u4Ul8lrf0QbAwW9EvnRiC79SSKhTXNWcFtbIbg&oe=6A5CC096"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDxOijGCTXUQ7kNvwFyWsJu&_nc_oc=Adpft44aX7h2OCsyd49uvHllvp7EC2YLuNyAhrHDfjWHvO4cZLV_9ScIMtmMttln4Rg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2a6MEZcKHTyk20uw2soD-rR93cNonQagc4-oa_skr6Q&oe=6A5CBC16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpVlCsqbfjsQ7kNvwEwT9jZ&_nc_oc=AdoQ-u96QrR1e6ehyQquMY4co8fa9a6Pa5jHOeXn66tT2S70fmkWMytBoHNwQk9UlyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUeH1rni1iKJyyxvHG43NtOY5GE9GC9J6Ro0XG24AfWQ&oe=6A5CCA44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBoPDCe3ZBgQ7kNvwG-0ZND&_nc_oc=AdoLRZDldaeg_2hnKn_p3ptIsXBBETaxdjmO8ZEiuaOchypQhGdUU0_dL3aytFMA6P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD2OXP_T0PI09qsIaas-eH9jvP869M5CEJptvZ6uq7Aw&oe=6A5CCA99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-LJnvkDQjkQ7kNvwFlMQCO&_nc_oc=AdpEgILCKly2dSJtNk1WfPMCvhe7KQIqJjzr1mA3AosezCaVj18ISzAOlqhCEWl-R6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr8RXHTMk--oav9PdCFFHjiS70Q1lz_ojetSooOUrkZw&oe=6A5CC7B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
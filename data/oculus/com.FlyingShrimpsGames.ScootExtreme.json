584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcA0tKca79sQ7kNvwE7cQkV&_nc_oc=Adq6T_CK0EHUdlaXkWUK9TOStn1MoIqF1WqRwzONMCsAOmtOFZWjnZqvq-Oj6NkXeto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2i_4K8yNH9Chs_Gem2nQvoPqrIzOhCRET_GIuTNRWPPA&oe=69DE3096"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUnKvaWtKeEQ7kNvwH71xCm&_nc_oc=Adr6sYycxyQjwW3lxNuEROxwdJxSAhHx4F3C4wkj7GrpLQaMW8PZm11mho45bOSYc-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hMVQGPZqbEpifv0kXEuFK_YfIFwuXbSDzulZrRB6HCg&oe=69DE2C16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGFT_4IovbIQ7kNvwHHVV9V&_nc_oc=AdrV2rcW1c2Xa9y0Dl7CipJce0P1lXRXU5PZqRf6-8duXavLLYCr7gGbIUgIQfJxG8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oQ0zfzA2da8coFOcQihzqDR0MV4M7kpgf63gAjHlJfQ&oe=69DE3A44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiz22jbM46cQ7kNvwE0Mqxz&_nc_oc=AdpWYfxCgcEEfjqO8WyXoRsg0vw2jPu8gBmNax00g1vDybBsj9c2iyYZfa4bJ2Srk0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sBsG7ciDsyTkYetmRTzRivmPv_dAvDrLHopDG_nXKPg&oe=69DE3A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B_5gqrnEaoQ7kNvwGRM80e&_nc_oc=AdrN-YR30tG4Ubzil9wSTNRM0WWvIMxS59aemztspUUo2MpNkgdiqhaO2srFN9JzKwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Kysxu9lB5gxPL_SQzXdZSDAFeTzBUqWAmjL_WZvRX4g&oe=69DE37B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq__D6iESXcQ7kNvwEMYabo&_nc_oc=Adrveuc_X2OeZQq215Vggj52hBvj6qSkPtztvghWOXR1f5oZdIan7AAIDdkPcJkb6Y4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQzG0eE4myRNyhg-tl271p9YbIxK_lwW7B_EkTuuWung&oe=6AA69496"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g720Mr66QgQQ7kNvwHFVMOI&_nc_oc=AdrywLza-bRN02lZOWlE1w2l6k_ofuGCMUdaQx-V2A7rLqDqReaaUKqI6b6xUc4GITk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbroRti0aaQ4MjoAXB9VG8TTcTa8sz_jBjPAPaLNa_2A&oe=6AA6C856"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9FcC1dz900Q7kNvwF_aj0I&_nc_oc=AdoSJgHh7SuP6xxGtKEutsVmYshzYuvC16V4ircRA2kN3huvGELeiOkXToX583t9hxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGiSzBW3pKfjie3UZZ5JSOQS-xZu562lZvzvqprquv-A&oe=6AA69E44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvRsnamXypMQ7kNvwE7-ej7&_nc_oc=AdohoPH1X5v_6jJBgHO2mY-bOJh77LNUvBVcJQZbqn4pc47JlALkFjN89n-PSNZEI1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4GcTHansKQp8Aqbw6OTRW0En9-YJRWDWLA6259GTQxg&oe=6AA69E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1fBBW-4kCsQ7kNvwEeIRz_&_nc_oc=Ado-CVnzW0JiPm-uLgB7aGcnOVoEipOE097OReiZbTej3L39yEMTEOpEyFrDNWzoxh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkrAg2oF2m7p9sgIN_DG02jic61q52uP0vyvSlF_1b0g&oe=6AA69BB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
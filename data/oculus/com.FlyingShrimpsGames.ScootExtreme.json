584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAqEKB0AeWAQ7kNvwFmxnVW&_nc_oc=AdqY5cxg0bJt5aIoxAb4sRbzZFyEVgsl0qkOax1Wx___GoaJ3hcp1FuhYozAYifxRD8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUeXVuvNruH46X-ansNwPLocd_1NZ3ZjGG-nO6Crv5xw&oe=6A4E4016"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gb35ajg7YAQ7kNvwEbHMxq&_nc_oc=AdrGSqDJIfzSxRik3GjGMeJq-u3QcGUJ1Jl5beKRJUJObI4cr2g0L6sm3sNI2pqbKc4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9la68MSUkVGD4ufb37hZUvJRqX-AoNYQYEg-lgMe_bA&oe=6A4E3B96"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5sGMJdk3zYQ7kNvwFpzVhE&_nc_oc=AdqVK2bvXsFY9Xf--0yLWX0baRU8x2n9si0ezf8LtVdxW_lwyqEO9yZXXGCSep5dfng&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkkGR4gMBNIFfjzhZatI6aCzNPqhK39EXv55OyNAlK7A&oe=6A4E49C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj_-GRlPUp4Q7kNvwFXPiFg&_nc_oc=Ado2bHguq8tXYAWg_pGDO1tfkZ9HOv75VlCisAD4TkQJOP-B2ExIua2MAR0isjZSNL4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJHwCQBsMQkzORYlBymUGVPYRuPZ1iNU-eJyhgERjE4g&oe=6A4E4A19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB7sUF3j6FMQ7kNvwFgwp9F&_nc_oc=AdqCiCxgL_oNDFjMVeiGYYYpLwGVuSo8N8xFHlbetnoKttSS35LBJAwzYyjbc29ZHvQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtOo8u24NO_1uD_P4GeNxQKF41oISw4Mq2WzkwQATtlg&oe=6A4E4738"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
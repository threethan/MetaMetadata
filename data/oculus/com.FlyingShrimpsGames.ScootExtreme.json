7-7ZMNfEGBVoQ&oe=6AECAC56"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1iHbIR4VPwQ7kNvwEgzifM&_nc_oc=AdoFCwPIAoN8oJFUk90dp_TEeYxzYUBvmXiR05WIczYWrUSP1t0CdbX3fBySL8VGbVU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL6MBelQUU9Qq7YtgyxT340UK8dtaVwm7ZLj-xG7aHoQ&oe=6AECA7D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2_GL_EbiB0Q7kNvwGBEfdp&_nc_oc=Adrc6zCVhRHBh4ixWNui572VNaOF6mTR5-i00rnOEQ2JwUl5n-S_Zzc_BqN73iDfuRQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPgmhyDvR8p2BZU8kFx2r6xTCG6BioE5jfBHtStYfGJA&oe=6AECB604"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjphh-UDL20Q7kNvwFs3gee&_nc_oc=AdpPb12OYr5eWZbDDt5ooTF5xRNeMqwGxvY8Itqchyn4mURxpgJ8yiZjapVNULqHMjg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO7A1uAcyG_I2ndfcS4LYF7OKcCMv3okuiHiRPgq7DHA&oe=6AECB659"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWTrmSPjW9UQ7kNvwHEjlqi&_nc_oc=AdrNXjwO8evxST1s6L0g_e6TxlbUBKgFkE-FjQPUYkAzabTVyAAS_8I2VT1XdsfJua4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSupmY-xkOVUp7rF82yuPjzq9OuZs5xlP7dh7n3wHH8oQ&oe=6AECB378"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshrimpsgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "ext
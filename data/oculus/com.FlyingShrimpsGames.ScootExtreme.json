584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjYVcEdX8YcQ7kNvwHJk5vb&_nc_oc=AdqGnHG_djbt1adQIIcttIGTMWuNtndshsKvKgWxK_x-R_e89uqcbfvVVOw8Hndmkug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFsg0h-rggHGOBbjB5peNT_FiXhLs7TblJkUSpErIFwg&oe=6A5F6396"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_2X8fCM9O8Q7kNvwHXeTsV&_nc_oc=Adq2ErYVHGd9nG9KwN1i7QAUkCZ1yiY8A5_hO1xbl5PViBgfrud9vF4CT5fUMwf6ZgI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlMEE-P0hqu_oEFsXaqa3ORJMggMjxJHK17XB5JasjOg&oe=6A5F5F16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpVlCsqbfjsQ7kNvwGUvi2c&_nc_oc=AdouKWv-E6On8mJbn9sFOB7vRv_RwhTO8nokdye5wy_GTAyRem8T1pM0jJCtZRTUnEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCub26NIhkKmORVRSHmHQXHMXfKQP9UeRB1W_ry5W4qEw&oe=6A5F6D44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT_1Zp1993gQ7kNvwEq1kbv&_nc_oc=Adq9qIfV0OeVQABmdV0tLUFt_9KXV0iLhXVrEJJRItUzUS0CpLJD7mHoA0E4LFsSByI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe09gMKMgKf8m39rr0XLIBjtDXv-VntjlVXpGRzXvj5Q&oe=6A5F6D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ywRKkCJn7AQ7kNvwHShmAr&_nc_oc=AdrHvKvnk56ejBt7TQnWFu2o83IqzCz1uwxJs3XrxtRH3h9S_UO0dXqdG_yTEMnFCvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL0aK7vz4gTltXETmjguWK-qSygqn05d4Qe-0k8JJHZg&oe=6A5F6AB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
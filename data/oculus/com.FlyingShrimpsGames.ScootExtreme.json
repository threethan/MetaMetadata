584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aEwftxjDLwQ7kNvwGTA6Kw&_nc_oc=AdoFqARDgWePKooayPiY-XoA52HyjZN9KyBXcHkQTSlfg6aDbYliflKJ198rPRdoVxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA82YgpfQd-6p9ohEMeDq2kPHqxRU7GIN1YFaFlA1bweA&oe=6A6B4116"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF9tj8kAYtAQ7kNvwGXO7o3&_nc_oc=AdrJxGl9ee_MDgyGnUlW6gLESTKXC9mjHtVTDwfUoZ6qgJ_7g859ZGUepscauW7fH_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpaGWAOnAfQpJ4cmZaK2e5hCSczOM_N5UE2Il_Ky0JfQ&oe=6A6B3C96"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPZ3HVTtor8Q7kNvwHeIZX6&_nc_oc=AdqLSh05GJUKZfCw9fIBJX7QAX4dTMZkYQdjPuNYWBpE89wI3aqNB6gv5F0DMQpsYtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrIzRlKggXBF4eKmnOAl7oH4vPEaOafxMG0sCharZhZA&oe=6A6B4AC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOxVZ2QfRygQ7kNvwEOwPV6&_nc_oc=AdryCo2s0j0K2r2-GFwHVC5zMQPyrRkiYG-iPv6toyeLNwbl2_z1d-NEKam8FJoUDZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJW_JXT6cgBVs7RnRlmUPdnttkaS4hVeZaQJq3lENcVA&oe=6A6B4B19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgR3OjX8nWcQ7kNvwEsIOOq&_nc_oc=AdpowpSQ8PgjT2wB1SDrjv1QLC8236S9tXCMOU2mTzk9h0yYaGqGY8eKRllZ7MMnqHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi4FdwiKF88-yDdk8eUpZym1-rqaOl9R8BKwDwEZpUbQ&oe=6A6B4838"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
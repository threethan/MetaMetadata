584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CawynsS4zzQQ7kNvwFAfLZf&_nc_oc=Adr4AunEwSSEOEK8ZNvg2YDid6TrUyjj4JbpdaHGXSvRBbP4J7dkCCAdrVLpnVoia3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35Oocu9IFB_qzLOqNcmFl2uzNKoOHAi1ysKnOYamMpWg&oe=69EB5F96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4olea68NisQ7kNvwHgFPhs&_nc_oc=Adp1fDXCrJeHROshgT-lruneZ_roa3xGGsUmX7aybDorYESiv5eXb5VQCy5x-HDOCj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aSmg3er79GS5J8rF1anAsjFXe-HxTgNoA-PdQhDdIWA&oe=69EB5B16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPSm0mWI_60Q7kNvwH4gm8V&_nc_oc=AdrJhXOBwdeuYpAIeGu798_PmaXH6O4UUUKEi2mMozxFxOFajgBnP2ioWXVFikk3ZG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ejg0GxfCE72pb7ZzAq6tbbULlRMqFoSzJYpD6aCTAcw&oe=69EB6944"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcpfSxN8pOsQ7kNvwEqg5Cj&_nc_oc=AdoHKZubxgT8k6DHmU6OMz1_RiUj4FmCM2J75Hvm-3BN9g336Ng43ztTnB1riOJAzz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FuRcOp-WqFGxzw194s4hw4qIg2XsR_ivuDwrNkLNYmg&oe=69EB6999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWH3sMwEw2cQ7kNvwHmNqTE&_nc_oc=AdpumbKoPw5CePyOGH5mO0ZmfmUqqFj-CvksZZcJqEaE42QzZVqo_0QASPHvVZW_Vyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C7taLiQBYxBafAW4v6zZKVTPW3wSi4xp8jgvoVyWNHg&oe=69EB66B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
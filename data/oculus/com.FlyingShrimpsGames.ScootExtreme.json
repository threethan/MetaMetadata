584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skd2PE52EpYQ7kNvwFAVNB8&_nc_oc=AdrjVcudcV4h4AXnhujd5V9YcYvLD8alc726PEFF4d-B_UErMR5UipmqDU9AudKmfxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sFtnmqBImWlJfaxHXlRoj0y3vxG_K05qkNivANLsZfw&oe=69DCDF16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUnKvaWtKeEQ7kNvwGzAgIe&_nc_oc=Adqra7TylGf22bLy16YjrQ-Z_Nq147cJC3vYaxQo3zrfHvSVm2oqXGu6PCb7QHo_03Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gTkK2X9VTjQSCeB52ceKceffQ7PBlebR1Z1YCNY_cbQ&oe=69DCDA96"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvUyMw3XBL8Q7kNvwE62RLb&_nc_oc=Adqv7yn2u2EQ2e4rpy0T_kRutwHyXmhugrsso6KZmrf8j8Rr6lZocVCjHf9zv8rGSnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_hz9knZtzrXdzd6BxngVHFCeVKMnnX2qDxocJffszag&oe=69DCE8C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiz22jbM46cQ7kNvwG-Icim&_nc_oc=Adqfstyle1-b_9DEoX0dH1u4gUQip9EfEwo6aOnbrtzB4XpPV0ktFqpUToNiLksOoHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ReLqk8qaPXJ8TFGcSeQ490gIdPYixNRytVZEymavfmg&oe=69DCE919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B_5gqrnEaoQ7kNvwHH5xnH&_nc_oc=AdoPr7CMgFHEchKnFr6XTNj_ozoB4pnG6qOtJGJrx1y8-wZjgYvTBXWaS5cj1Gqb_40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UkngFkGUyY6aQgXWkYjKUOh11KWSVLkbnrRXxwVlE3w&oe=69DCE638"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzSZQi8n-kgQ7kNvwFvpuia&_nc_oc=AdrEMmJmg7sIofhi9Zr09nAXE9YeaNgP9IVEl_wmQzjqjo77YTAHuDwkxGMIoEjZz_4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jerch8fURImXgWc-eT7yCAYdzYxCaHZZqMZ8tRpZkpQ&oe=69FF2616"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uwGC_ahkSkQ7kNvwE_J96O&_nc_oc=Adqm36kA67OZbMShDw_zjq_9M2vKi2LhttpH1_HnzupDso0tNNFHKZ4cIEF6tP3ZNSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rpZ8U6Fyy8GLzGziuKpwedbPg8N0KFgHs-_HiRhyfFA&oe=69FF2196"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1flOwNbXOCkQ7kNvwHagPUc&_nc_oc=AdoGPr-ktOc2UmKdB6HoTfQUQKjWVTwoME8qBHa694T02KqxZQyKeJPIyuRk31IMzqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64EJGu4dLR1fJx2DqUisPXFVZaeY7PqEw1RUG3OwDZ9A&oe=69FF2FC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYpPH7wojmUQ7kNvwHUYpv9&_nc_oc=AdpZ_Swwaj1mDuYQqbzZ0RFcj4EjeMbWGKjznIn_gfup8GM8bcGb_RHh5Yww75QgP9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MgduZ5V49gKQENzbLWVSdbukmF4fsMbb6ilYsAIp7gg&oe=69FF3019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DovyDwH_CAkQ7kNvwGKHnsI&_nc_oc=Adphp642sWMDMEL1V1lbnJW_1RGc0mR72Hb_mGYTUkC0PQYk82FYck8Qct7mVM3OxnM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75dlg9EGMCu4phoSMrOTW8gqG0mB057nEW6Aae9hBClA&oe=69FF2D38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
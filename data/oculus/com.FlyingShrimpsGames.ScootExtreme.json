584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Y6pqu0z40Q7kNvwHITbhB&_nc_oc=AdomOTkUI5OWdbVCX_MCzBBAWeUL5SOTbsUg0gWbTkjGuC_5Ow8DRbKZtV13BFJk3Zs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX0tYIDUYiN5vybP2TbUAZ7D___vHCunNl92HS2s86Fg&oe=6AA7E616"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g720Mr66QgQQ7kNvwFORWw0&_nc_oc=AdpnKKbaH7exH9ck6nn3sdBZsBa8vt2id8F-yh4lUZVQ_2ORW8vVTrGuhoQUtIjIWJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCvc5RNADzWXxPTPJdQ8DICowbDBD9rfA6k3MTU9QuOg&oe=6AA819D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DYje4AtOm4Q7kNvwGe9WMN&_nc_oc=AdqgA9dXfyxsC05rDPVVhPy9WZ79lD7VTI69dcdsGv5AU_2Z5isYX49nUf2FltiC3eY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKZhfvCfAO20ifOyOn1Fdg3yblV0uNoAGJVTronunG6g&oe=6AA7EFC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvRsnamXypMQ7kNvwFoZSkd&_nc_oc=AdqulvUnS5iTcmCLnFfPFNkskERvnIT-enZnVzHr_Nwn2VKLVBTbZ_j7Rm311Bs1wPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW-5FAnVJ9Zzj8z-gFHrk6rb0rORTxHIYnWKe_BDqKcw&oe=6AA7F019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1fBBW-4kCsQ7kNvwHbFwYd&_nc_oc=AdpO_RJ5aHsQLdlea_NeVC-e_-Fv1KIlfne2Pt-vRetMRwx7FUCrv2My3OrWx3OX3Gk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfhQBtaCGXZyWAgAnBDgcaAKiYOOcsA9f5GBuyLtIqtA&oe=6AA7ED38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
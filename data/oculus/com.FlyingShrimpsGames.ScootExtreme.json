386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3hD5_-iTKQQ7kNvwHBfFP4&_nc_oc=AdkBVhDX2ZtWbeUybXZx7BmR29cU01w0PxWo_TdrcftEcQbCKcbGca4rg1rVhCBeWMg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoDQQifiilFUddceYamoRnc3-OMVSujo86IZCD9EKNqw&oe=69B00796"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ytKN8MO5dEQ7kNvwFpl4LC&_nc_oc=AdlNVqTnHQQysUv242PxrjwCblKEAcRfDNFb24UVDml6MfSiF0upBlMxsdgGMJwtlj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6515ozuM3oMCJDV6ysADqjiP9ZHiSvKodezBJsygQkQ&oe=69B015C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRpJfBYYpBcQ7kNvwFXhgnn&_nc_oc=AdmeRg4i0AhVicVGPDbNBQ_R9w6YdNO7kOGs5oCS_dYRZNACGxr5Zfb6YMi-8kRAtcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfycPu0DAPvOeAi1PtB95-Y_LZnQp5lHpBi0_COALnVZWA&oe=69B01619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycvFC4XGz8oQ7kNvwGXGD_L&_nc_oc=AdnNS8RJCw0QO2B36JnbVxvJEdpAEIEJ7m-xUBUzicnSLcDbn4rYHYB0Vuc_GbcFg8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwhl_cG2t25_iDdTtcEYsxVxGBYDvwMzacsh_75zlgDAA&oe=69B01338"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshrimpsgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_
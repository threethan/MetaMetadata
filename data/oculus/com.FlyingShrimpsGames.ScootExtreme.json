584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MhInoQ1GCMQ7kNvwFFmr0U&_nc_oc=AdquYm5bdlwBymJ8SqxCmNSO-F3UpvNFDGpnZsCyM6VNHRKOrJ8yZa5gSM0QaI-KNmg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o6c-0mcHAWKjfzPzzHY9bEXiZbyL6dnAJAT1_U_cpXQ&oe=6A317756"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1lb1Lb1xGcQ7kNvwEtzLHP&_nc_oc=AdowIoNpBaFRNzSaGeSchLjn484rVY2hna8sTvZUbu3zi-wOc4g8_Q6h-L4LnFhOFXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_29uwC_y7S7haf8rhPCMBR9c-pXCuTUHwuHTAXsc_JTQ&oe=6A3172D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO0BwNDvIxEQ7kNvwHKqvW7&_nc_oc=Adqyy1TP0T_xUtBA1Mcl272KetFFdRfcEiiVnUK8QsmVa4mwZz2EQs4SHFYx82tx-tA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BiGRrBtypL6SoUvURheWs0QswvjX4SC6V00-j1A1qJg&oe=6A3148C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCGG_CCy6AsQ7kNvwFxyHgH&_nc_oc=AdrV_ApZoIr3PycdxNbyvVfwY-njS5_FKLSqWXRHsQlKeiItE_3EmHMueJ-hxhstP7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83mj2UayvBIPrEekOjm6olZAQHtMezBdANOS33cjWAmg&oe=6A314919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuLCIJW5Ln8Q7kNvwFUMpcs&_nc_oc=AdrBKVmuVxITbCqUUkJ5Jdl6Je_hYOuGqpAY0HkqiwnZEHRoDjycEfqd8Q41ddYM58c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AFhV_x9yxOd_1xZpvZuoTe1WsCVruffTHAVZl2wEJgw&oe=6A314638"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
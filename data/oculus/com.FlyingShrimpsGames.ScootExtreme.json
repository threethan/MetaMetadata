386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzRzwPUqYsMQ7kNvwFtCVF9&_nc_oc=AdkRGLWmK_DcaBxnumCY1Y8fe1jteo36eZVfdcASX028Y5CCuXZuJU6iWtM2loLiTCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqCpPu_d6R5yPMvkgwH7xwM-Xg9G5B6EUzzOAr3W536A&oe=69BBE516"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHrJefSWMNAQ7kNvwEBa0Nu&_nc_oc=AdnBpw2s5gBAZAMXMaCRgBkuizrvPceXANV01KhHqeKVPilMu0U9ovaY2MC84GrWOqg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxeUZzJ003GiDMd1bomS9wQasVQwabprQ0USOtV_tVh8g&oe=69BBF344"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lCXx0VvSRYQ7kNvwEqd_ih&_nc_oc=Adk6rliLjJkrhMGBp5RI4jql10Mr7JDu_E6OF3s-1G2om-mO1ugxzVC-Ob9ylfUnIqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxdC4sldOu9naq_K4aiBJjvJUZqMg29TquBes-Ehp465w&oe=69BBF399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXc6HXBKOVcQ7kNvwE9LPKJ&_nc_oc=AdliujGZOqwZcvGOuE4_0Ja7ejQ0QdsfFS8YhS7S0tZBGQGZjKq9vXTQ9GH3HRG91fI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvUiu9n9-xww1HsUuuRm-cT0mQ2fnai8iqAVOQ6kZ0LA&oe=69BBF0B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshrimpsgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_
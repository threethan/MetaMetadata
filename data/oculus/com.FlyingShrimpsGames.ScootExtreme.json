612010_562584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBKKkXaQkyoQ7kNvwEtu7qt&_nc_oc=AdoMgR4piiAPdUfdKX2oQc8l3DfVWWwLdEKNoWoV3KWdDvDIEnKpl5Y8RAqHk-dUKfQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2G6wNSOyH7n9SCgG2lCfSl4fQ7Z2x5qduO1MHB1kqOA&oe=6A396056"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa4TbAVqP3YQ7kNvwEVyQa0&_nc_oc=Adpf8BJsKwW5WNQluycZIcL10JUqe6PxStF6GwdrHfSDokwIcyhFaOCP7fnhtJQu6e8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YM9qlD-o25nqdtMJSFL6WoXgu-DYBepmzNJvm4bt9mg&oe=6A395BD6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3yzeEbwMmUQ7kNvwFu52U6&_nc_oc=AdqY8jyI0FJRiGia_wfX4Q2tl3fGiS2OzrANS96OnRP3_XzJ5mR2doK488Tx3ET5-4s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CwuZRqB8QrImH3Au2A-z-ZebRHlYaHHlFSXBD_9i2hw&oe=6A3931C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdDVRzgxIfkQ7kNvwFE6jI4&_nc_oc=AdpU-B6FIpd-PZ4sM-ifJzwryItBO9cJsv2FhkvMf8-XR05NAV8RXdfQM4UtO39AJTc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1UhnpZb1iBV77VsQuaSzcgliR15_3j8hKS0P6LF_E_Q&oe=6A393219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St_7nBaRYusQ7kNvwFZvCvu&_nc_oc=AdqY2TtvcCEGvMo6onx_EYWZx6HO9ZzCQHkKQgotjEXSJsAaSWnp7sFK04_A8LEHxHE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jzUFM1IDEoxAwIH93rgI0N42Ca7mahqehhxe9gOwoMA&oe=6A392F38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.
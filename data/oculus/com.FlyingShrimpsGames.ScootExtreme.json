584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbCOlg17_lkQ7kNvwH5oLzv&_nc_oc=AdoE5e8EjfS0CLLu8xvNtZgSnwYacd8gkn2oy_zJGZqDWd0RKf1Dp2cP5fbpwdH7AcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gqpo_41eIkKjlICYFF2fxAggFN0WSIxWFHEEMb3b2Hg&oe=6A380ED6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa4TbAVqP3YQ7kNvwHiWOxm&_nc_oc=AdpPK4V5oEV1iKukAvTXLoECdiPMhQwBqmdhLJcbdn-JQ0glGi38ubP7rDDibjGueLI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u9nscAjOArvzzbQ6uIp5k8Bov6JRzOjoNx1OtRaHlOw&oe=6A380A56"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93SPe6hYuzwQ7kNvwG7eAr7&_nc_oc=AdqcLH9yW6kTDYv7ea3nTngLZsLXq2WPaqc3704PBHr3kdq7bmFRiuM_V0M3lYtmBjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6us75iCfEGXQlUH8ABGLZ-tDDX1PW0_8Eno_L_GL4SQ&oe=6A37E044"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdDVRzgxIfkQ7kNvwF_vD9s&_nc_oc=AdoErOLCzV37kz2iIrJ_0dnOzKcGVRIUKyPOMg5V4MHo5_c3Hz7leGgZlBfpuAHLyi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af807xkCd6C0HhsiycQGSPzQJ0btSJLUEO6jrG4Hz-iGeA&oe=6A37E099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St_7nBaRYusQ7kNvwHFGFrv&_nc_oc=AdrtSXbnanx-NxieRuX5s4AzWnwgEtfcNyoad9gt-yld8nvb4Gjc41qmsN_Yxoe9WQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pYFba812ztWJwDqKQvjvKugLfWOby8h689S3A1BKSoA&oe=6A37DDB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
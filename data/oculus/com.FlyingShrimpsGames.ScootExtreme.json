584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsJ6oe9fPw4Q7kNvwHHGkAH&_nc_oc=AdoqEGgg4_hqdsC95a_f-LJr2C6Ss8XaDM9S_Wp367GXXYBih6DJynMFmxEuMr5-1YQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af220D_cMtxvkWYaSpMbs6FdZfz2fURi7WiRGhHgokZGpw&oe=69E4C816"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAY9Vj2sZDoQ7kNvwGj9o1K&_nc_oc=AdoqloIE_0FL-2OOx4xqzI3hYYlug2UVvH4lnnjBRQYG7nF0fgPg9N_u3Sa_j3cuwDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mOl05AAiF3N3HaLTAct_DspIUY6a7_k4CQh_t7ZR95w&oe=69E4C396"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyDn37v6VwMQ7kNvwEG_ynB&_nc_oc=AdorWUbVrcIkXrdMfI2z94sufL4WB7uJ_U6LsXDT1SYFwsQ63kEqkPK_8OQoSmD-gZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30cPaJeZo6UCFRWyGwlJih6_nmddjX2D9LDj0x5tuvsQ&oe=69E4D1C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eui6k1t4PW4Q7kNvwGHfVa7&_nc_oc=AdrXjg_fa1JalIkfs6E3ZGHov2F2QLzvaykR3-4AwB34m7FaFD5hNVSYftZwZkrkbfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pVPZLlNcc4mZsi0rItiVGjirLFBMQQWS1o-hULQHb0g&oe=69E4D219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXmtqo1L1lwQ7kNvwEjYLer&_nc_oc=Adr2Qx0eIItWuay79rIBup3FLQae1tnIk6r0J4b159kuU62mkXuV8YZJM9w336DSIvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17DvsS5mBAyrvOqCYsgwfbe28nC8ChRtzgylb6DH9ftg&oe=69E4CF38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afb13pY8jkAQ7kNvwFtncVI&_nc_oc=AdpCETgi1UazB11ONdwymBgWc8D6Cvlr9Yrctzg0Tpnlrukm6B5OBQth7m57G0W-3s0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYTqIiIQgAxUR7yVEpzYFXGMOroxkk5L05VcFVBFhO0w&oe=6A6C9296"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF9tj8kAYtAQ7kNvwFU58iP&_nc_oc=Adqb8ZRpD6FYsdATJqDG7CcGk7Jiw0WGgoSTO0jYhACxl_fbVqjGYBHFUF0Nfy-7Xts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-v8UZYHage-qsKTvr1fga-gxh3_O-2rsG-Q07PpB6jg&oe=6A6C8E16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP301nRj8lAQ7kNvwHYYy3U&_nc_oc=AdqS9hdFirDffH8ZuoANMwrWMrd26G8jQvG2Mkdh_vjbNW6-xC3iNVKDUq9ctMjxGcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRTiD-uh1YiQfbVydd7qAk_bPspXo36NPI2CsRIfNKqA&oe=6A6C9C44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOxVZ2QfRygQ7kNvwH6EVQH&_nc_oc=Adr6D39vgLApifIUGnNAHG9Dxw-8ixHBjgNEUc-A5uoTG0ok2CnGTTbhpNQumEEPsXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbqPB5T0r3TUdMa0e8oUybDCVxeNPcOCPRU252FeQsgQ&oe=6A6C9C99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgR3OjX8nWcQ7kNvwGwk9xf&_nc_oc=AdoIs1o4LxQY0wudjslY5xCmSoO-tc-J-OvHVGqPBAN-hFhFFpz4LCwE9EsnWRP7igs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiOtDgPMgI37AjzcbbubR5Zwgd668R9UZumbyZhmp7-w&oe=6A6C99B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
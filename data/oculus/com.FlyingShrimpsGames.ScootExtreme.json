584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjYVcEdX8YcQ7kNvwEGSLV1&_nc_oc=AdrY8l3FFg88M189cb8VBaMpGaspqOTXa1GVnk0SkikljeVxVDF58Q2OOfAv3bAObBc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD631fdL5L17qVAySS5Lz1nq_zXlDhmMtM4WOwKPX8Arw&oe=6A5E1216"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_2X8fCM9O8Q7kNvwF1mWBo&_nc_oc=AdoA_ePto2z8ns-oiTyvip3tia6NTN_PVv8i6Xess6MS6XUYA18exKcpJWGSFWoZ-QI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdtpuycLP9g86QXxQOK1rYhkkOxSmoWwjt7ibA6Lv02Q&oe=6A5E0D96"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpVlCsqbfjsQ7kNvwE1uOSw&_nc_oc=AdoyQjOERXhM5p35dzXbgGdR-FY3bqeS24eHVjVM8ywx_tOTf1tpRMZa5G07vaAGSN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw4cgZySijHL6BvdxECOO1YWBRri0Q409vpin2ZRt2Vw&oe=6A5E1BC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT_1Zp1993gQ7kNvwGsLT1z&_nc_oc=AdqRAvqC59idPmK92Iwf5jOVqEwpUVblyIkbqnoXf7Mf55TexRBBpHJJ-2exHOjjbrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo8yzMvSAHvldkvoca36vpFbnj8TEKdKBAtK6jhTSksA&oe=6A5E1C19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ywRKkCJn7AQ7kNvwH_KFYn&_nc_oc=AdpzvxH0K_ooLJWcCvBapCpA5eRlbp4GPYaJx333WJfD3djuRJpssIwxcJ6MTuZIAhg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8SLCbYGDenRB84jqGMlZScE3dhA-IssvMiJE_92GEtQ&oe=6A5E1938"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
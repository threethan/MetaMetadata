584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKpIItNR3mQQ7kNvwF3gUbc&_nc_oc=AdqIZXKPJ9ADtPPJ2pzo3th0932NX5b3wnrcepSJwHf5wzouH0Jt1EGSZg_TUSEpc8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0095oX5caFtFYaj4w3SECWlVFV5ZBzF9TnI7-YL9FThw&oe=69F73D16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuKAFMyAppUQ7kNvwHqvoFn&_nc_oc=AdoOrIPc0m5CPE4ezzzbiJ1Lt6jj931jqbJ6Oy39wAQ8XFP4u89CsBu7y0AGV836V58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0R3zQ0eKwHgBshlUr9ohZ5zOpRtiRI6fC9-stI1IN7oQ&oe=69F73896"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSouxibmXUcQ7kNvwEMRY7f&_nc_oc=AdrJi8s2oEVQ5YkXCU3R4UgfoIHar0HYwNbxmiw7wD3MhlXfZadZZJIJpzdnHCPi2AQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2QjhWY8SKw50YRbojpf9KzWQ7TFWH_aPESO9u0-_iAnw&oe=69F746C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFNeGoKglpgQ7kNvwHYYt0j&_nc_oc=AdpFAPp-bib6qMdi-IfaUlZ_jwjp6WwgKtXQ1A-bGBlbM7hnDduRr8pPkkD0niqANyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1X9STnvaEgcy3ujn0diBjRToYBOqz1tO-a8jGgaIxCbg&oe=69F74719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWqdiUjDNhAQ7kNvwGBU5HG&_nc_oc=Adq95KyIJYzU8QvwUhCA975tFx9Mt8WtMAdunE45p_GNneIcJs0Ho3yWVnD8heUM7AI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wMyBoMO1_cbFG4-io4YSn7Egi92IKdS6SE_ZMDjYXCw&oe=69F74438"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
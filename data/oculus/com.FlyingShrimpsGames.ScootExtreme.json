584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7V8YRULvBgQ7kNvwGvQ6wS&_nc_oc=Adocq6lW_IvCPAr7VIxCAf_HNBvwFTr3RJDMVVQXVF19e8BsHxaK9AAd8lskCK3RcSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PqflRUyhmP3ioJK8zrUaLwVxKc5ZJxbFvH7Esinz-LA&oe=6A2ED456"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1lb1Lb1xGcQ7kNvwHLS2Vr&_nc_oc=Adryry_9cvKwiu1a_t4kAEvqOrM0_1TS3ycVvI_eLMc8MM9xOkuCg__aMMcBZKawlmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--E607ENRb_xU5NvDoXuOsx2XgYRNBuje-bIX-uVjB0w&oe=6A2ECFD6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq9XYbZ45h0Q7kNvwH1Aazf&_nc_oc=AdroXrfuue9mtfYDrzn-HEw7Kuw3gOeFGYnd7J5PXVRoqBv_jLxod2bx_29FiLf1DXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lTQC1HqtHS2OQN7twsw19yY6HARoq29_moPXkJ5dnBA&oe=6A2EA5C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCGG_CCy6AsQ7kNvwE4R-7J&_nc_oc=AdoNH-q3z_lP3rFZVcZHCGakGTl94fqPGUq4leD23aoclfe1SZQJS1Q7Iu3wfzMLWWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aqzG6e8epXn9RmRCG2iYlB50YIJ2Aht6f5mFuk8aBlw&oe=6A2EA619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuLCIJW5Ln8Q7kNvwG5joWx&_nc_oc=AdokKihbtDaqbrmptf8Ysoz3Q_oSCWifxGRF3WUN8reNCwqsbbCtkp01mfAJv38Q1N8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cSRXv6LE51vTRLll0TkQzgSVUGex5BAH-dBUjdLwdtg&oe=6A2EA338"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
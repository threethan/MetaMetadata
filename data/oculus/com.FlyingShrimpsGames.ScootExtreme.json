584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiWHuDg1vdkQ7kNvwGMBPja&_nc_oc=AdpG2bQH0bRp1ckCVbxIZRqR0i1jz91xV861geCDFnw4UNSdPwYSp6l4RQD2p6BjAAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55el9go-rmeR7sIBhNWsVrR0Rwj5sK4OIj_-T3gm8U7Q&oe=69FC8316"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0uPhd9DBmIQ7kNvwFZ7n6b&_nc_oc=AdpHdD0XAUzq7vi4E-vLJkDKPjTT6S9NGRHKuUgJXyv8qyuPn1YiG-Tif_Y16QbffOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lxl4PlwfIfnYHnL2z1Pj55XUal2Mx071Y_ujHWxOFLw&oe=69FC7E96"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDvexAJHY2EQ7kNvwG9lX-W&_nc_oc=Adpt0Mx0cx8ERUCe8lu0r1zJN7dHwYNseJE0rUNqvzVvmGhDj4-DYAaa5i07jgpI7ss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XRsw8oRARyy69c2gPqKzArGDRUrNQEetc4VAR6uwQfw&oe=69FC8CC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSzmQzItDbkQ7kNvwHQELN4&_nc_oc=AdoPuj_jjMYNuD5VHUZvbQrEgV-Ok0XC5U1YHOjn9ZCJHRT_CCjxXyXcVZvtcgKKXcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50Vmi0RfRoRZF-07ERU8ZhlH0mixGoUaNm3HwpNK2V4g&oe=69FC8D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o59gBMhScxwQ7kNvwEMnt6-&_nc_oc=Ado_9jWQHvBy0vHWpoomim0qycXZEG3o9twyLp8NM5cLgIdR0jFw6ChOw1mr7c1q0z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kUtyz6gOfXwbSsYM10pR2d8fjiaYUZc5ymjvUFdfH6g&oe=69FC8A38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
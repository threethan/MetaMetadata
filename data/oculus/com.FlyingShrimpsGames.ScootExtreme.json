eo_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1A4XVOmZfRkQ7kNvwEiLvtU&_nc_oc=AdriQHLoP4Hc9577dp-mLcLljPIe6szmyh-GDmKB5mO6nn9LbK-14Tyxn4Ea2q0jCRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrUo8tY8iCO57Hkdl8tBZGhCTHDIB0aLnoeZFk1eaA6Q&oe=6B01CB78"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshrimpsgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8539988996093305"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PUBLISHED", "id": "1427306392338599"}, {"status": "PUBLISHED", "id": "1060133953506341"}, {"status": "PUBLISHED", "id": "1044778418215584"}, {"status": "PUBLISHED", "id": "894776670282757"}, {"status": "PUBLISHED", "id": "1644903430163302"}, {"status": "PUBLISHED", "id": "4344216079195924"}, {"status": "PUBLISHED", "id": "2374271412995964"}, {"status": "PUBLISHED", "id": "1457480823051922"}, {"status": "PUBLISHED", "id": "2041262440031752"}, {"status": "PUBLISHED", "id": "1115196084154681"}, {"status": "PUBLISHED", "id": "713769681828775"}, {"status": "PUBLISHED", "id": "1541608576977043"}, {"status": "PUBLISHED", "id": "718818310920270"}, {"status": "CANCELLED", "id": "4018451131748029"}, {"status": "PUBLISHED", "id": "1256342769289723"}, {"status": "PUBLISHED", "id": "1213470680147858"}, {
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1moMdfkzAEQ7kNvwHYUXzi&_nc_oc=Adq7DUFMJtR5hYtmCVlflESWzpiJCau0ugkXg7Tvlt68F9l_dKRAw3G06-6hBaOXz6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KCblQdOf9yKjwH81hZocC-q3PlvrgNdBsmNYlN5alnw&oe=6A147656"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOhdlA1eZA4Q7kNvwHqIO0k&_nc_oc=AdqosxBdHY1oTLXl3CF1UfHddn6uV13EZmSjv2YpuIYCLJRiYsckYGHAvczzABgt2tg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HP_5Be0O6r8Nnt3yEa1YL1iLzO55IjVADVOsQBwhrYg&oe=6A1471D6"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2new-H2QbGwQ7kNvwHzkKYa&_nc_oc=AdqUxMoP_JovG3b-NE9917kk-dCce6X2_Gcp0GBBGNQRvrbZB3lEJsbMNuRsqBKJEgM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X6Vcu8LgPVjXajxiUa80oY8CuTE0j0n4fPYF__6ThqA&oe=6A1447C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FhR7qoS3LsQ7kNvwGWmyZe&_nc_oc=AdpQhH6hB2tYgi8bUBnOpG-7tegEhghatSh2aak0TBR9L1VDf2zLX4-4k5XHsjy7Nao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IK0TiwQpCkhRJt9Gl9ExBz8kFfDutdMJ0NbsoNNKQiA&oe=6A144819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4Rbs-x5U9oQ7kNvwGpngfv&_nc_oc=AdqoGXiYwJejAOjlDeACiDmjLwNR_Br9R6pECN-OQHDQFMPyyx5UtJmgRTYfE2pTLFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rewREptLwnG-F4HUJqN5E0_xsuVWmiZwzoIRUCadCWA&oe=6A144538"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
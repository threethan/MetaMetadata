584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZHh8BW6xiYQ7kNvwEytwvF&_nc_oc=AdqVy-FipjJE85NjWLza_caHbcAcJ354jyrhKY-ohAThB-yKX-xFiVZn9x-DXyQXey0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKAOP-EnjPt31KrRz8paCUqddXrlUCD1nHbBvoPDtuIw&oe=6AC670D6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSztTS_mwggQ7kNvwH3-GYX&_nc_oc=AdrV0OpUMvech1Xl3zLT9A7VBN-zYdC1wNdPcmiw8ZxXq1OwbuEuYSK1MrnLKCsLZjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp_SXFiMbJu7S2a4NLe9G0ofqPa6MPHz5JeNgKXYMfOw&oe=6AC66C56"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjYEI_jhtYwQ7kNvwF3DEKu&_nc_oc=AdoD8f5kky3rVXmls_1s8V3egri2E4jc32heDLvSVaV_3svi_FHa-jFULhOsGyT4P6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCFGFOlVX7cLH382NcDwjdorEe4iHnZZjmaY4rJB302Q&oe=6AC64244"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrzleK2UeFgQ7kNvwFQX_Dn&_nc_oc=AdpwZlXRQTM7yGzpsGT4bkbF1JVy4T-fhd60crVZH6SLd31EX7Uw9qA3LaCO4PFausI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOea8h6Tf-KY7dOy3Hgzp0duNrsHnuPrfYUP3RkdLiddQ&oe=6AC64299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbKnpvpX9J4Q7kNvwGmBXq-&_nc_oc=AdqNj0cmNd_5nBYHh5e3Ho37SHkz96dYGrqcR4d7AcXmcv3kurcDC4OeWzPqNkFq4nc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHW9TyaZeYpSsNdbyVp58Cf1783QDmYrlTjVLKOvWq6g&oe=6AC63FB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
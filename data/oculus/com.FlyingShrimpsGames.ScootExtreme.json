584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTq4Kiy5fX4Q7kNvwHBo7C9&_nc_oc=Ado--9Eet9cFae3NpYEU4CbvSZeadcQOzY3TkTdnoWs0SsIKW8XJat4AWfbH5WgJ3dI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VQ0UcjvIa6qLm12J8NVHm7QKI9Gmh60_sPK2utSdUCg&oe=6A09B216"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEC_9B0TyksQ7kNvwGC7nSe&_nc_oc=AdoadflHfdfskOdcGyLbS4pBPpvnVQWQI-Mx08IHqZ4kP8KC3xggB5ux0XpHg6qbFyU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v7M0AfTrXbWHkEsWbs06GTlMZBlE_hNCY2m8vb_H3bg&oe=6A09AD96"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=634X-J0G5ssQ7kNvwHIF8Jt&_nc_oc=Adrw81abHogoFkOzOdSXg9BF4gKpKftJ7CVb7YhUCbJa7i8ivBufPlEnb_YA0LvowFM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oTJUtaZleqzJJD-bJqjEPBNJGprbFu99ZPoE8M79IDw&oe=6A09BBC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA66a62s0EIQ7kNvwG3cXk0&_nc_oc=AdoehAUeZOvHO7icDQ12Zxngi2U_2E6d5YjYrVQoBl9DfOIYxluFjS9h4oH3HDICcYs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WyDgXdcC7WUGYwYlFyVO7ttQI1lQI9I90gvY9FECqmg&oe=6A09BC19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLlR1aCmOSQQ7kNvwE655-R&_nc_oc=Adqr2LJaoz7MDuDJYvDP9cMUPx1Waa5WQxM-seuZ6lcs_jA_9BNhKTCjBa5J6UVZK7E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K4_1IPsaue7xwO2UjzRA08e9QxRS_ceLA0YIOtDKwTA&oe=6A09B938"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
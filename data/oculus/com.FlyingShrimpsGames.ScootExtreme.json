612010_562584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Y6pqu0z40Q7kNvwGTWEIS&_nc_oc=AdqehnSN3z5erlqAsDu3vr-Eht2QbReqkO73JeizZIGTUUcjyzvGxlXM6MSWLtkaXqI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbBIWNGMO5jaRu9MhKGWlfPmd9DLbgbLY-BTmvMBhwsw&oe=6AA93796"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h85SFUlo_P8Q7kNvwEQawRG&_nc_oc=AdqXuTQ26CQ3CucFezm_T9ju1oi8qcaqobmXHLRYOpSEtscjEN5G3yEn1YMDSrkDi_c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKazbpeK6ca5VCr9zQMzaSC4cJH2DUA5f3Pm32Cwj3heA&oe=6AA96B56"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DYje4AtOm4Q7kNvwFPrKx9&_nc_oc=Adoq6wFmrf58T7rjMvZiaBsvS9owuwPoduLR4UoAweMp-ARiS-evjS3aXuyuHIS_nZc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ0LEjHF_sl1an_1I-fwBEloNrt2VPjYJuLjLhO394Wg&oe=6AA94144"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHIHA315h9IQ7kNvwGa3i02&_nc_oc=AdqCgEtyipTXv0rWqK2xIA3KyJldTRGvoudCuENzzqbTwkcZtxxQhM8HQZ2uYkt_tVs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZIvb19mjWgc9AXS0Qpc-FRN7jIMLFm0U9y1EmZbGAwA&oe=6AA94199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_McAHgNmwUcQ7kNvwHTuAAY&_nc_oc=Ado6eFSjl-ybq9sNyyjeUe3mZ65TL8tbivZQV1e1GmOqU_Bpkg_aCZLO6Cmq1hx5E9I&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnNKXgi7_e64bRR_YzWedtJqo3c8HtjbWUvBWSsQtT6A&oe=6AA93EB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKpIItNR3mQQ7kNvwHb1hOB&_nc_oc=Adp5ekPHbyyynutXJowfkSfpaNQYHwZ8MFbgVgyFvM2Y5IlgZFOnGK3Zk99buK3hdtE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2kUWLYLr13mn2YKm3G8_uT5U9u70_IBFUmCTCMbmbOgQ&oe=69F88E96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuKAFMyAppUQ7kNvwG76JUQ&_nc_oc=Adpkts9j8qx03kwTfAswgVp3-VHAIunC8hE7GybRSHlFxfL8PB5Yhngj7ELPwhRPRM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af244WoKiKsAHzVuKfjgVG0dHbbBYN_TAaP58_DrKTVhdg&oe=69F88A16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSouxibmXUcQ7kNvwGZESJE&_nc_oc=Adp30cqdIvm0MhnyBh5zwheRTUW1d3tloQntFeJ9jhYwMXMOjEZXY93uiZPOwwi1f-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cOx3Zqtuj1NvZXK4qBMi8fHPxkZSUgsvZx1bwY5w9Cw&oe=69F89844"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFNeGoKglpgQ7kNvwFTbJ3G&_nc_oc=AdoBL0oBMERbsaUUElHG0OyNMWRWxL8PjvJeAmHq6jlgsnTOteSzDe4Vr1CUdIYo1ns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mj199JYfhoiJQwUjrd03govY6znX3pKJpprlRoay7jQ&oe=69F89899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWqdiUjDNhAQ7kNvwFkBBPa&_nc_oc=AdptoYFttLzBFnCJ0at2r_8_9NVYD61Rp41yeZ1sGq3g_lmigTag953bOisN_kOimDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Vc0w9RDFDhPrcno-JMEI4amiT26U0ab7-Pm4F9wY-oA&oe=69F895B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
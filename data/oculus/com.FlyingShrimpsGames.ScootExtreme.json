584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afb13pY8jkAQ7kNvwG5xjtl&_nc_oc=AdodSOp7bzB8OaGm4tPrNVDtKAflgPDWFK_iZESnWXVXNko7esDDqMDBc3LPzfI_HpU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8uk0roxtPkpBuUPww8BLY1eCQXbhL3ulAX8tUsfp2KA&oe=6A6DE416"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OLuSNXys1YQ7kNvwHG2bQK&_nc_oc=Adpko4bTOIzkmfKtXhC5QmOutEne0r908P-G3Krr6qr_-PLT-bWRtPVwjGFAlS1WikM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMaI5LaduZNWEJKpcu4lXyfK87eot2yI-hxW74MLwE3Q&oe=6A6DDF96"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP301nRj8lAQ7kNvwFOv1Q8&_nc_oc=AdoW9xmrinCfq055dNxv_pXxXWHOmOdAXAIFQ4ZS10s51mds4npSj1YLnzJgPGOJ48w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx3AzJerZCfCwtQCP3zXwbW9jXxvA6Kdl2_q_N_aa6cA&oe=6A6DEDC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE9Qx533HvcQ7kNvwGCZ-ix&_nc_oc=AdqaGuFxqy8by7EHHncRQ_gsQVaN2zKN8S6jW3HabF1dieIKVas2XrAg6cPZ_il2AKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI-JKpVOW0m4-cUdMe5nJjB2HlzBkoBGf3zZeUD5IVGQ&oe=6A6DEE19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnAHpDpTqUgQ7kNvwGFwkDr&_nc_oc=AdobBqCK18QKboPxji9gyAmFWOoKy0iZzuXDihHwTLL29E87XP3w1-x1nb7ASuQC9lA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT_amK7dAz-JUGBGAXiCw2QLaLcfF2E_7ov2kDNGxudg&oe=6A6DEB38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMEIGKeAVmQQ7kNvwHU_7hP&_nc_oc=AdqDzb2NRDyCFMk6_Qfi98T0c12uRcE9brqrkr_vlEIjhlYT01SnEUzEpkg2Sm0QI3g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p7TJAHnFfet8vMeR9faiFMxRxCQkfYJZC5EQ49ogA-A&oe=6A3D54D6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIYStZ5WBSsQ7kNvwHqc7uH&_nc_oc=Ado4clF3N1hbKYtJ3zyWJ7DIg1UYJhxkBGV_bK-Km87HLVMueeepJObR12sejqmQy34&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Oj_WBCXlXKTMggAeJs9LDypW3ZTYIOUJV-lEP8378A&oe=6A3D5056"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvz1N5jXimEQ7kNvwEMwjmq&_nc_oc=AdoELa6NNPqasMwUGjXbyNi24VKRYvpdEp7prz5F3W0p5gza7n1J43KTOKcKXXXEfiQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pp3WXZdkZwf9sZe7-cYk8eKorpLC03aEDseoOHnYX7A&oe=6A3D2644"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VDyv6wLoEgQ7kNvwH0IiML&_nc_oc=AdphfBLi2D2RNYrYdwtNCa9c-ein7qadENwtdJEGw1EehgSNgMLqihXtQPJOY9iYD5g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tqeVNFnr7jq2Oy5smTUnMwhMfYknwMRaoohVRPCyx8g&oe=6A3D2699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1Db71Nvvm4Q7kNvwGRI3ag&_nc_oc=AdpoT1LklXcx8uP8sWOz1KNXKbBZ46Hz9hgs0IOIfiLTrE1ZZuq8AsKCgnrOJm0ovYw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tzLwnZmlWvKn8zDk9ZlZFhOR1s24mk9R9tx0fFFX9DQ&oe=6A3D5BF8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxVFc2riVZMQ7kNvwEP1_zr&_nc_oc=AdoEviqO4U7cuL_VQ0BLlV1_DJ-n-h6YGsdYu7iiYr21r7zI6TyREZCzVvYeC3h-DEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApfk2KjWGLYcnJ85PXzpudqJjAzI9F8DvU11vbxQyWYQ&oe=6A577A96"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsCfH1y80z8Q7kNvwGEVLJ5&_nc_oc=AdoP8sk0f41vvSYhXLd1gMQUpnIKfveK-XjVe9Yhs2f9NKoX_zyokhwkDRlvVQM5jw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2y60eYpj0_2DzaU2WTzdNdmw-ypKwHV_Wuc_JBsAkmw&oe=6A577616"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYCfjQW-LYQQ7kNvwG1wJr4&_nc_oc=AdojaQwf9l9d1N0YI2ufximYRxs_NR2N1t9jLLUyjEg3jhFidVZ6rHcZvKlBI5_gakI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpo9a6OnO9FoEaDutZ6W6rtmKh9d5PAP9iOUF5iXc0NA&oe=6A578444"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KkJ9ZFhYTkQ7kNvwFpeBgV&_nc_oc=Ado9BdHdTEeFIS2Hb6FV1ulIRu5plS_XP2nsv8LuVuqz8LaaUtU-e5f7Ejj-S8Phe9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgtOj-eisqMOSa5AbMMBxSdq-jIeTFjRvQfXntFzjUHg&oe=6A578499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnhwZBBORz4Q7kNvwECQZzM&_nc_oc=AdoJhkN9fYHO93t_jzO52qbfN8I4vzDcLEiOcBMasYJMqO5BbO7qtG3YH0b4w11I4BI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC98gOo0UvF4oqvJ9nL-iLPy1wIZyEeK-98J4pe-kt1mg&oe=6A5781B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
612010_562584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq__D6iESXcQ7kNvwHpDlkD&_nc_oc=AdopGGsgDZXKzBMeNH92HaRuWQbdpdcYZ6os6MqYmqI3FkiEESD0-K4aRYKFyemZKP0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhHuv0dWHRpNLBgqg6qM-22t3wNM8pKvg9WkVmoLUWVA&oe=6AA3F196"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V_965XSEJYQ7kNvwHTDADP&_nc_oc=AdrCQmWDMnhBmt896y18SYmBaSysjVRTiks4tfTpX-myl2DjfjUNd_ji3vvgENLitz4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ_H88wC7GmmVTdmRESXWn45IBahr03eUmP69U-m8pGg&oe=6AA3ED16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9FcC1dz900Q7kNvwEEYlWE&_nc_oc=AdrFkEG-mf2pbt2MxMNOC04ayNxAEj6t77xKG_LGx5iWqzPlsT-CbdnsDXsK2gyCbKE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbczY_Kqx5ZXU4JgQTiQZyGPVOXHeaqW6BFoqeHpnEVw&oe=6AA3FB44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcCeL35XvpMQ7kNvwFr5C8Q&_nc_oc=AdpeOybmo_Iz29iub_MGdB8tYBAnhdqvoxO88U9AXIANDWSnIOR9-Qgs3SdxT_g69LY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp7EtSGNNMjIRe2eeDg4YPVBsZKPLuvKOeB7rIyMhNmQ&oe=6AA3FB99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6MCQzq0d1kQ7kNvwETJiot&_nc_oc=Ado2vYIfMbtPAKuQXhJBKGxgK884ErZxa4hGxEoH14N5wuqwNBgBAJRu79kfHCCIatk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNlNQeju7qbHQ1kVoWYbnmp0zPpOb2Rrl4i4y1XVgWpw&oe=6AA3F8B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.
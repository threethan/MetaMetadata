584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7V8YRULvBgQ7kNvwHac-8A&_nc_oc=AdoLzffvwCiuKcPQaOaVdd3C07BnaJOhekjpql-iFqTrDv5lWbfoL7a-9iqRWhWAKHE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RiUy-Y1CXMhfI2JUG2PuAaCaicNdGRrE_VIVOfdy-XQ&oe=6A3025D6"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1lb1Lb1xGcQ7kNvwEo9aI0&_nc_oc=Adq1ws0jtm7F64q184PeTpT-0X6k3mkY8wGbCqOohAywpg_2rDLO0ss04_obhmkExs0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8yS6YftkJox84TTPzUjQRdgJZC_DN3fa-x-BvMvPqYQ&oe=6A302156"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq9XYbZ45h0Q7kNvwG4oi7j&_nc_oc=AdrbLqeICcAajV0Fu7tawVMKM4p8MaWbttq6mAtxX_agQDFgLYWqVyKk8D4h29Fvnx0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u2NvggNAkfj8w8GiLNuGy60uUCIJH7FX2i-m9NK3F4w&oe=6A2FF744"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCGG_CCy6AsQ7kNvwHFeWnt&_nc_oc=AdrlE6QfMV2i8tKPjd1oesUq0LJNThF5M4astVkHTp9LRWWuS5ZeTGMzhIPBEmzrN98&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LJgGoY2SfOdlV1FDl8Y44yAy-9uUMPJXePTQoE3irzg&oe=6A2FF799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuLCIJW5Ln8Q7kNvwGvu86l&_nc_oc=AdoqV4a-1HE5Djme4_DIk0EL8yqurzTpIXZopoHixIOQTJjow2uGW3ygh17sHAdoiQ8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y8HBuHEbHSE4FID-39Cr1r4iynsSCz4ESaGUj_lkTew&oe=6A2FF4B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
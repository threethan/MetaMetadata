//scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZqhiU9H6_gQ7kNvwER2Nud&_nc_oc=AdpwiQeb_5JEWtaLa4YJa3GufwPrr4gNW9zbvbVWmnKM_iAcQsb5mUkwYLC8HdAsjzs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwY3wHjs5VbzBFPEPmzGEOtB4Mm4lZOyVLA21mr484jKA&oe=69C67116"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6AHVdqhougQ7kNvwEJ7QGh&_nc_oc=Adqf-tjpvCFe1wkNe6y2hmYdeUi6D9JUlkoJpmCpcZYW6MUqn9Fy1I63s1LNZHEtCmo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7T159907E_8si9_QwOHo8sKecW6b-uFxqs-LosLvgFw&oe=69C67F44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAOlZqOtVgwQ7kNvwHy6iwG&_nc_oc=Adqchgiu_LTgOy_1zwnZQsW_y4jIGkCpZ4YcdaRVyezYs4l39BgLFwOPwpX1J_vbHoM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjMKEG58qdo2STNMlWdBMdytAL6njyfL2Tyahv_SIwkw&oe=69C67F99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrX2H0JQuSUQ7kNvwG_pyJP&_nc_oc=AdpTGzidarvuhA0Kv0Hxfg9WOkGrFrPEIxpWl0pKMTl28hrKUja_Btf0ZbI3WeRq8iI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afys1nPU_azj1qAguoPcUo4CN0J4XNLXFl_4xcTrFdIfLQ&oe=69C67CB8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshrimpsgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_con
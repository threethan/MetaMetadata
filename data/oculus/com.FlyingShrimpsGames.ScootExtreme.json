584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l05kKVhTwScQ7kNvwGTyJDp&_nc_oc=AdqFWTT-LJT1IT9sVnw21ttnh9i_uBjrwqfLGIqbyvfuNF5Fn3zHq3b8MPsNtUMVkOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL8Db_pSSJ13u7Y0C30UZ6_y5LmRwBlOifWrYL0ukf1A&oe=6A902B16"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3CFxiCUYfgQ7kNvwF7cT1U&_nc_oc=AdpxNPx05Y-zTe67UHoy8xNAjOfaG5AJOuujz01rLWYMtpKkHtG3rrSsrAvv7e4yAL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGce9BvuaCOWyWIOY6rdi0C8X2rITmzFqo3yTGE1SoKrw&oe=6A902696"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CRaMIKXxoUQ7kNvwESFECR&_nc_oc=AdqrenWZFpsG8YF1tBzCu0j_WVl7UsavO11M0kqdNcd7SB3kV2cOxhzVjOBHM3wkcjA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Zw3Wl_F65_naYwHLGdm2CX14L1EI9rFv1KkfJgBbPw&oe=6A9034C4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyurGHRmuMkQ7kNvwEt8j0z&_nc_oc=AdorsYoCrxhSCqEfS3sKx_TztkUsFTyQeXL_y28xF5vy8R1NaYkb3Tg4Om3rdncNbPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFayRBA1YJJqLo-wMOYDetoBemVtMT2tsWnHG1d1LvvMw&oe=6A903519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgfONi7mhccQ7kNvwHyhgj6&_nc_oc=Adp_SZ-KlKn-oK9P0UYRXq3raRlR5-DxCSvzDPlRmvUcLeI_7o1WfEHjniZldkK2Yds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzossk0r8U7SEH-68IXJsWcquzH2eV5w8EQJSNzDjUMQ&oe=6A903238"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
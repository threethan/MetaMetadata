584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rTAo_hiRGUQ7kNvwFv3jpy&_nc_oc=Adqd_HmfOsKY7aDuxkfiTV1QzQ20aI0hJtcbBiH2D2pK5d9z9AuMWAZ2xQv1QFpHhIQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7eZth2uGrCGuXnWMIyPwoqo1NqG_1vys2pDkpVlRJmg&oe=6A8AE516"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59etZjw3B3AQ7kNvwF56YoS&_nc_oc=AdrRsJ_ZzlboK-5P4Gr-eja7BzkmkULeBDZhbT4oVb33IqhDiyVBjXUau00JdHHNNzA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZbGYUSUyRuLjTfONTdj64zL5Ea2qlxJRFKlxyMKwBMg&oe=6A8AE096"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCkfZ6QFLHQQ7kNvwFomDrU&_nc_oc=AdpZoHjbjTZMc-eX7xCps8DNx7rkIJZkQkBQN1Wscvx4Ec7g3HCR4_jlVYw2hmKA31U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhL51CiZ8xC3LoxEBelO_oJw9WZAbPlioue0lD8hUC9w&oe=6A8AEEC4"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y0JejlPhnYQ7kNvwH-uOzM&_nc_oc=AdpmX6-vnNgzT7JfEwq3BKdRh1NRrd6PoeywT3uqPxrHL0759HWnAgyPP5pXdhS7UCk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-Vy0467HfMlg9gM8b4W3MfC1eqwDPuMycK3Z5xARGvw&oe=6A8AEF19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2xVOghomEkQ7kNvwHbuJeu&_nc_oc=AdpL-til0rzkfJz1sqavXhJbBUthCV8J4llSfwCXjSJGvYHMR_ZKslC3pT8fCh9SMpc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjdQgcUO7V_QlpIAJ1GM2HARKMYixVR_z1ZtZIDfqQkQ&oe=6A8AEC38"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
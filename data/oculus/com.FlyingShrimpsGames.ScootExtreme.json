584966534276_3989322348201379783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITvlY4U9S0kQ7kNvwEmGcCW&_nc_oc=AdoSCo3-0aqRy_c_7MuRwkQDY_mLaTrVphs8RQUdJNHnYPeufXEhE8-nlFMzUCEksH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDgXpUfHiqXEZXeLzbWA-N7xShHxlcYJigIO5TyEBHcQ&oe=6A79C196"}, {"file_name": "S2.png", "id": "1323046205741881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031383_1323046209075214_7626577251822437386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqugCWDUtW8Q7kNvwG7v1Dv&_nc_oc=Adr2WUvO-klRWBfzGpA4xY3Wp6087uFV61Sk2uG9ALlLzH-t4wE3v-d8IPT6cR3JeCk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVFtlNWV5wt4XXGe7CtDT8_1nRxKuA0lV_3bDPDfnHWA&oe=6A79BD16"}, {"file_name": "S1.png", "id": "1103352451426877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221320_1103352454760210_8563883860019496343_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgyTtRx1vvQQ7kNvwHS-imJ&_nc_oc=AdpuStei-9nKl4Jig-byRDw_z5Lga0P6flhvkwG316DfnMfNH5yVdKblmdfJGn8CDSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCPvAKhKzC4gEbErN1x4XdXxgfFEyuUt7FaxTZPk4YaA&oe=6A79CB44"}, {"file_name": "S4.png", "id": "4066243663597643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86604448_4066243666930976_1265171969479001100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwheoRiWepoQ7kNvwFbDlWk&_nc_oc=AdqcQr-32HqV8dp1ecylAbBZIK4LsPtVqnWJN55hel0NOZ3rHUD7kz-B-VZZHWXp1Cs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrz7D7Kck147pug2chBduXpIJprbga8FMQPDTLDstsVw&oe=6A79CB99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scootextreme (1920-1080).png", "id": "1117586479889891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_1117586483223224_1567684497610310245_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZ3mPBwE5aAQ7kNvwGxftSI&_nc_oc=AdqmCgO8dDsP_VhaSj2VMes1sQ51rnv22gJ_LuCyDRCYA6BQrTk48PVFwe16ts1GDrM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGC2_ompMVbZ3fQrD8t7CS-R5vAD1UQiVsrZLrrLiVWQ&oe=6A79C8B8"}, "display_name": "ScootExtreme", "keywords": ["Racing", "Offroad", "Sport", "Scooter", "Bike"], "long_description": "ScootExtreme VR takes virtual reality racing to new heights with its intense, lap-based gameplay across 11 unique levels. In this immersive experience, players can enjoy a variety of challenging courses, including 8 off-road tracks and 3 thrilling stadium circuits. Each level is carefully designed to provide a realistic and adrenaline-pumping journey, whether you're navigating through rugged, obstacle-ridden trails or speeding through professional racing arenas.\n\nThe off-road levels push players to their limits, featuring diverse terrains, unexpected turns, and natural obstacles that demand skillful handling and quick reflexes. In contrast, the stadium tracks offer high-speed action within a controlled environment, where precision and agility are key. ScootExtreme VR combines cutting-edge VR technology with responsive mechanics, creating a fully immersive racing experience where every lap feels like a true adventure. Perfect for VR enthusiasts and racing fans, ScootExtreme VR is where the thrill of off-road riding meets the excitement of competitive racing, all in the virtual world.", "short_description": "ScootExtreme VR is an immersive VR racing game with 11 unique levels featuring intense lap-based challenges. Ride through 8 thrilling off-road courses filled with rugged terrains and obstacles, or race in 3 electrifying stadium levels designed for high-speed competition. Get ready to experience fast-paced action and realistic environments, perfect for VR enthusiasts and racing fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flyingshrimpsgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Flying Shrimps Games", "support_website_url": null, "website_url": "https://www.flyingshri
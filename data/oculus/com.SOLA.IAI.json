ntent-iad3-2.oculuscdn.com/v/t64.5771-25/499618910_1860183581440914_5254871951642364573_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e28maLJiHEIQ7kNvwHVaxnq&_nc_oc=AdoyEHntY82v1CYXUp_5NLiERCmkQe_-_IuM1sk0F5nTxNf4b7BTXErCKB9T9N2uo9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfM4dFmK75zhTHPWonp1WJ9aDJM71Nf9099uqpQaQo2Q&oe=6B0466A8"}, {"file_name": "ScreenShots-Oculus_02_2560x1440 (1).png", "id": "2228553520910867", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_2228553524244200_2522242526675667567_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QI01HCzrC-4Q7kNvwHltXe8&_nc_oc=Adp_CVn9Y94mEYrNbpOMNEVo5IOEc-YliDusV1b3e5ezm1RfRthCCaWhyVaRpcWbkMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRtGGoQ5bWsEjBxAxJg1WMgA_OGKPCY-GyN3YavzFYOA&oe=6B045BB2"}, {"file_name": "ScreenShots-Oculus_03_2560x1440.png", "id": "721531440620734", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618910_721531443954067_4462976514326297258_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gObY-U_7hMMQ7kNvwHR3Kp2&_nc_oc=Ado91eO-o38Fyaz2v_dXY672FlbJL9lUFN-8sEtStRAIwndhjx38YT8sBP2ksuayrZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqwvLcfibrozbIIPhvCG87he7jJbHGhOw9pEfrs-fDDQ&oe=6B046567"}, {"file_name": "ScreenShots-Oculus.png", "id": "23998544086465020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_23998544093131686_4964058394628045739_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bifDHpG9ooIQ7kNvwFvXyLC&_nc_oc=Adr_L4uXH4xMgvVR1a9tudJTe8SjrKP5Hx3E4zE8froZrlLM0SzbahZgEsonhTu8ZhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR95u278Dz3tfY3iiQ3QeepbrZamrTkkKV3RghPV1h7tQ&oe=6B047F65"}, {"file_name": "ScreenShots-Oculus_05_2560x1440.png", "id": "1067147545606453", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1067147548939786_8390305036374976853_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYsHyeoDXRoQ7kNvwHUWjNV&_nc_oc=AdrBVfDz32QlFuxwkVt5DVNB9kR2LfkcMdmICWtuXekIFRHiIw_814qurOXC-Z8eVHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRuzx0R98WgqxuLspQe9B_QdlFzppAi1TmR2dlV0eS5Q&oe=6B047227"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage (1).png", "id": "530993886672764", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618247_530993890006097_5321621982816830209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co-LbzASL74Q7kNvwGS2iiP&_nc_oc=Adp3WHkoCNYBBUeHewVZJdEXA1LFpZhApzMGPhEHB8ODulHYEOQHOiiOmbRgT-P62Gk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_scZjCFO0iR7MxV3mrmw-4hdJSHXfiQAwgT2ieFAeug&oe=6B048264"}, "display_name": "IAI", "keywords": [], "long_description": "I AI is a VR-only multiplayer puzzle game designed for two players. Set in a fragmented sci-fi world, the game focuses on communication, coordination, puzzle solving, and narrative-driven challenges. You and your partner must work together\u2014often in unusual situations\u2014to uncover a mystery rooted in time, memory, and identity. Play as one of the two androids learning to think, feel, and communicate like humans.\n\nRely on voice, visual cues, and shared reasoning to make progress.\nEach puzzle is crafted to test how well you can interpret information, exchange ideas, and work as one.\n \n# IAI - ROULETTE\nEnjoy the different game modes! Take on the challenge against other players.\n\nTrailer: https://www.youtube.com/watch?v=zBUWUlrnlPg\n{637312701952737}\n\n# MULTIPLAYER ONLY\nA cooperative experience built around two players\u2014where communication isn\u2019t optional, it\u2019s essential.\n{720858780906836}\n  \n \n# COOP PUZZLE DESIGN\nEach player experiences the world differently. No single perspective is enough to solve the game\u2019s challenges.\n{608796391778114}\n \n \n# CROSS PLATFORM\nPlay together across PC VR and Meta Quest headsets.\n{678057871896761}\n  \n \n# NARRATIVE DRIVEN\nDiscover the story of the Dreamers through fragments of dialogue, environmental storytelling, and shared decisions.\n{2600117667002886}\n  \n \n# FULL BODY EXPERIANCE\nSee your entire body\u2014not just your hands\u2014in VR, deepening the sense of presence and expression.\n{1224458419378246}", "short_description": "IAI is a VR-only multiplayer puzzle game for two players. Communicate, cooperate, and solve challenges together to uncover a fractured sci-fi story shaped by the memories of the Dreamers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iai.sola-air.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Sola K.K.", "support_website_url": null, "website_url": "https://iai.sola-air.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24052256217719536"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "719289644180183"}, {"status": "PENDING", "id": "627730243033947"}]}, "baseline_offer": {"id": "719289644180183"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753171020, "status": "PUBLISHED", "id": "719289644180183"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {
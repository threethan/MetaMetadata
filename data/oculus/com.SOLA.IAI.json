ntent-ord5-2.oculuscdn.com/v/t64.5771-25/499618910_1860183581440914_5254871951642364573_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y25CTjd1JsQ7kNvwHPFDLP&_nc_oc=AdqpE0-wH5VA3HqTblq3ES52Yys3LbIfk51tortGpASltAUan9kP676mE-0htPVJ9Q4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTV2Rp_d_yR9sL6GOxOtuVGkVAxBp537J1k9OiPtKIoUw&oe=6B0DA128"}, {"file_name": "ScreenShots-Oculus_02_2560x1440 (1).png", "id": "2228553520910867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_2228553524244200_2522242526675667567_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3S6JsPuCmg8Q7kNvwGfFzp-&_nc_oc=AdpOzTCN-2fHXJLnkel9A3uzDu8N0oNPa9YLKDHJaS24J2NwDk1hw7up0Z5tVFwhO5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREsAfDcYgIMsv9jNSiPAwQeVhP_45oeszfcjlAqCbC0g&oe=6B0DCE72"}, {"file_name": "ScreenShots-Oculus_03_2560x1440.png", "id": "721531440620734", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618910_721531443954067_4462976514326297258_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv5nh7GX-CoQ7kNvwHuxHmV&_nc_oc=AdqUiahro4R0TlscrboiYNlxO1h4kj5DyH3ZE9VNGc68UxWtFbGMchYRruignvm4WLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwEB2IHXuZZ-dmeCUV3O4TPCAngZ9ozZ_2-qOBQ9fYJQ&oe=6B0D9FE7"}, {"file_name": "ScreenShots-Oculus.png", "id": "23998544086465020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_23998544093131686_4964058394628045739_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzKcDCsRueQQ7kNvwGSrEzG&_nc_oc=AdrUDSvPCoijrofWJ2myRK_fp0mB9TbLQOzensji1EeSI3_Hio08mS_ZvUXABDHVaNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSu7NzYjYK38-5sIwuN5RKcHoZT_3FBqbqHWU9HfuuHw&oe=6B0DB9E5"}, {"file_name": "ScreenShots-Oculus_05_2560x1440.png", "id": "1067147545606453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618442_1067147548939786_8390305036374976853_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB1Sf6qqbi8Q7kNvwHunYxU&_nc_oc=AdpAblF3XfDWNhw2rO3DW_lPqaPhfjHMpVV99FhJHSTHe7Cux7wv0VEOMc60n6aIvJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-1IEzaSUd1KBNmwiwCBUqflrdgtR7gHHPFMAylfHVKQ&oe=6B0DACA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage (1).png", "id": "530993886672764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618247_530993890006097_5321621982816830209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPzn3crn_yoQ7kNvwGWrr9K&_nc_oc=AdoxrPIhwwWgm-vz1PrrcifM0FsqhKqN5AJYNHbScLgx-yFOMXaNb0ZblocKN0BhrBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSen1Y-kA7amUwZOpjz8M-pSDYGmo7HMFqktGqkSdzXPA&oe=6B0DBCE4"}, "display_name": "IAI", "keywords": [], "long_description": "I AI is a VR-only multiplayer puzzle game designed for two players. Set in a fragmented sci-fi world, the game focuses on communication, coordination, puzzle solving, and narrative-driven challenges. You and your partner must work together\u2014often in unusual situations\u2014to uncover a mystery rooted in time, memory, and identity. Play as one of the two androids learning to think, feel, and communicate like humans.\n\nRely on voice, visual cues, and shared reasoning to make progress.\nEach puzzle is crafted to test how well you can interpret information, exchange ideas, and work as one.\n \n# IAI - ROULETTE\nEnjoy the different game modes! Take on the challenge against other players.\n\nTrailer: https://www.youtube.com/watch?v=zBUWUlrnlPg\n{637312701952737}\n\n# MULTIPLAYER ONLY\nA cooperative experience built around two players\u2014where communication isn\u2019t optional, it\u2019s essential.\n{720858780906836}\n  \n \n# COOP PUZZLE DESIGN\nEach player experiences the world differently. No single perspective is enough to solve the game\u2019s challenges.\n{608796391778114}\n \n \n# CROSS PLATFORM\nPlay together across PC VR and Meta Quest headsets.\n{678057871896761}\n  \n \n# NARRATIVE DRIVEN\nDiscover the story of the Dreamers through fragments of dialogue, environmental storytelling, and shared decisions.\n{2600117667002886}\n  \n \n# FULL BODY EXPERIANCE\nSee your entire body\u2014not just your hands\u2014in VR, deepening the sense of presence and expression.\n{1224458419378246}", "short_description": "IAI is a VR-only multiplayer puzzle game for two players. Communicate, cooperate, and solve challenges together to uncover a fractured sci-fi story shaped by the memories of the Dreamers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iai.sola-air.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Sola K.K.", "support_website_url": null, "website_url": "https://iai.sola-air.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24052256217719536"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "719289644180183"}, {"status": "PENDING", "id": "627730243033947"}]}, "baseline_offer": {"id": "719289644180183"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753171020, "status": "PUBLISHED", "id": "719289644180183"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {
939786_8390305036374976853_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A2ifSql2JkQ7kNvwELJHTU&_nc_oc=AdqAr7nd9LRPQTzZ1lD0M3cFQAPhWV6jsGuJ3QefDZKuc7Cnp9kSgQzjqTTCyInqj6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH2RrC-5Ql9XNp4-oKBLyDr6bzkYiE1QyNgPNIjOpPLQ&oe=6AFF2C27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage (1).png", "id": "530993886672764", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618247_530993890006097_5321621982816830209_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNiYyBXQkQIQ7kNvwHrABo7&_nc_oc=AdrpfcNWwA4o36OEzOO9BnIqBIE3m_JfypTg_EfU8QwdMmAU4CLOWeNNqtRMrROJ7sw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPxzUWyObmsFA9LEbSy6RVtXmo5pbsb4FOit7lWr7oTw&oe=6AFF0424"}, "display_name": "IAI", "keywords": [], "long_description": "I AI is a VR-only multiplayer puzzle game designed for two players. Set in a fragmented sci-fi world, the game focuses on communication, coordination, puzzle solving, and narrative-driven challenges. You and your partner must work together\u2014often in unusual situations\u2014to uncover a mystery rooted in time, memory, and identity. Play as one of the two androids learning to think, feel, and communicate like humans.\n\nRely on voice, visual cues, and shared reasoning to make progress.\nEach puzzle is crafted to test how well you can interpret information, exchange ideas, and work as one.\n \n# IAI - ROULETTE\nEnjoy the different game modes! Take on the challenge against other players.\n\nTrailer: https://www.youtube.com/watch?v=zBUWUlrnlPg\n{637312701952737}\n\n# MULTIPLAYER ONLY\nA cooperative experience built around two players\u2014where communication isn\u2019t optional, it\u2019s essential.\n{720858780906836}\n  \n \n# COOP PUZZLE DESIGN\nEach player experiences the world differently. No single perspective is enough to solve the game\u2019s challenges.\n{608796391778114}\n \n \n# CROSS PLATFORM\nPlay together across PC VR and Meta Quest headsets.\n{678057871896761}\n  \n \n# NARRATIVE DRIVEN\nDiscover the story of the Dreamers through fragments of dialogue, environmental storytelling, and shared decisions.\n{2600117667002886}\n  \n \n# FULL BODY EXPERIANCE\nSee your entire body\u2014not just your hands\u2014in VR, deepening the sense of presence and expression.\n{1224458419378246}", "short_description": "IAI is a VR-only multiplayer puzzle game for two players. Communicate, cooperate, and solve challenges together to uncover a fractured sci-fi story shaped by the memories of the Dreamers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iai.sola-air.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Sola K.K.", "support_website_url": null, "website_url": "https://iai.sola-air.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24052256217719536"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "719289644180183"}, {"status": "PENDING", "id": "627730243033947"}]}, "baseline_offer": {"id": "719289644180183"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753171020, "status": "PUBLISHED", "id": "719289644180183"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {
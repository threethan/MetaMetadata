=2U4KetUU5OkQ7kNvwFPDlUO&_nc_oc=AdrByOAxZpYUGx0x0i44wxRrFVr_sdbQw7Y6PrBTwEDkCFW7oU1PPGfzwG_MQIYsb3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiMuUrge-hcyv26umSUDcWhUYibSWrTcIa3Qli6aw9hQ&oe=6AEA046D"}, {"file_name": "5.png", "id": "517433416286489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75429290_517433419619822_1520470758231984675_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTd07U7C5iIQ7kNvwExZfbi&_nc_oc=AdrdHpvoJh3dLdHjMmq0MuOLQlAMaxDbS4-vtMuWk0jm-YMUgCjUbrIwF709XESC6v8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmhoonXpoi74DqA38gEPdwgvfmUu-tPq3Hb9HSZM7vYA&oe=6AE9F3AE"}, {"file_name": "4.png", "id": "250394400211795", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031475_250394403545128_599197269839842385_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiZrXe5DYKwQ7kNvwELtxsQ&_nc_oc=AdqCWWJVVwSfoYssBg1e0FKPJMMvEZpdjEItzvDfd7GkAObFMueS4FiA-1UnRHgl4aw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcGObHf7P_D7kUAJIWG5wszcJMI6L0kcKzbYnHFzoPag&oe=6AEA0DBF"}, {"file_name": "ui_setting.png", "id": "904403571612231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982476_904403574945564_4100808565281616519_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeCWFnjnMj8Q7kNvwFDOwdN&_nc_oc=Adq2xyQkpyNiQb-lZud2K6qNld-optqGpj48bVKKW0jnGVL6nlNHO0qbzjjcZRJQRpc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeIhdkJv-LD2zBo0QusjLS4Nn67cqWR7WTF04gkhfmXw&oe=6AE9E790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30aa\u30ad\u30e5\u30e9\u30b9\u5be9\u67fb_\u4e88\u544a.png", "id": "521547065537795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974726_521547068871128_2509698567324823809_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6gjCpuq4SkQ7kNvwF_YyxH&_nc_oc=Adp-vv5D_OOvupxvl02p25I14GQ5ehwq0w7uyw504kQbkRjGNXz9C2LY5eQ8t2vZErs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmyEZN7i4gpYrrzILM5LNBogStrWOeze6BK1sAlpPuWA&oe=6AEA017F"}, "display_name": "4DMEDIAPLAYER", "keywords": [], "long_description": "1. No login\nIf you do not want to log in, please select the Skip button to proceed.\nYou can watch the trial video.\n\n2. Login/Logout\nEnter the login ID and password you registered on the LPEGPOINT affiliated site and select Login.\nMenus such as \"Live/Trial Video/Favorites/Local Video/DL Center\" are displayed.\nWhen you log in with the ID that you used to purchase works or sign a monthly contract on the site, the works will be displayed in a list.\nHow to log out > Select logout from the settings button at the bottom left of the main menu.\n\n3.Right menu\nYou can search for \"Type/Sort/Manufacturer/Genre/Performer/VR Photo Book/Subtitle Function\" in the menu on the right side of the player.\n\n4.Settings\nClear Cache > If the playback does not play properly, please clear the cache.\nPlease check the Privacy Policy > Terms of Use here.\nUpdate > You can check and update the current version.\n\n5.Local video\nYou can switch between \"All/Video/VR Photobook\" in the top menu.\nYou can select and delete using the buttons at the bottom.\nLocal Videos > Download folder stores downloaded videos.\n\n6.DL Center\nYou can switch between downloading and downloaded in the top menu.\nYou cannot play the video while it is being downloaded.\n\n7. Menu while watching a video\nPress the trigger while watching a video to display the operation menu.\nYou can adjust the volume/brightness with the slide bar on the left.", "short_description": "Introducing 4D MEDIA PLAYER that supports all video formats including 3DVR playback and 2D playback!\nStylish and easy-to-use UI, highly functional 4DVR, +1D compatible.\nVR trial video available! You can enjoy clear and easy-to-understand reviews of 4K videos!\nIt also supports 2D/VR live streaming viewing, which you can easily log in and watch.\n\nDownloading and playing videos incurs large communication charges. Please be sure to connect to Wi-Fi."}, {"images": {"nodes": [{"file_name": "4DMEDIA_Rogo.png", "id": "819923498956873", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974703_819923502290206_3018373211973402084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f72SrQu-JmgQ7kNvwHgCbTM&_nc_oc=AdpPl5xdfFXENQb9UK623Xl2UMqFyug1HBR1XTxMqMhHKHEb_IYqmx8RKHX88-q7FqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLqGhfYaCErDMCsepLF8GQN7cLq4IS1Mn0XJEdXHPXJw&oe=6AE9E165"}, {"file_name": "4D-MEDIA-PLAYER.png", "id": "301351824817529", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036700_301351828150862_449398175372624136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1ejoOUWd4QQ7kNvwEpU58Z&_nc_oc=Adodk3BuN02v8tOqrKA4RmkfEzxn_enMz1Gdbt6YzjyKJsBAz1xUsI2ZtE_RABP09QQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwj-SMZ8Vfnf2sLyNSb7SsI7ho5KzQXlDEjB2fmPV3nQ&oe=6AEA0A83"}, {"file_name": "4D-MEDIA-PLAYER-PDP.png", "id": "300693568263976", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_300693571597309_8617011754803338014_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvTgFqeLYpYQ7kNvwEzSz-u&_nc_oc=Adp5rP_Ny8doweV2X6dRAig-3NMZLVECE7q4D-LZLxs9_gCXK77BpOVJAGk3WUa-s9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVGwyMH_SXD9o2GGV5hug04GhxyH1AV6VbHPv1mlbOcw&oe=6AEA054F"}]}, "id": "3670464203264212", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "4D MEDIA PLAYER", "keywords": [], "long_description": "1.\u30ed\u30b0\u30a4\u30f3\u306a\u3057\n\u30ed\u30b0\u30a4\u30f3\u7121\u3057\u3067\u306e\u3054\u4f7f\u7528\u306f\u30b9\u30ad\u30c3\u30d7\u30dc\u30bf\u30f3\u3092\u9078\u629e\u3057\u3066\u304a\u9032\u307f\u304f\u3060\u3055\u3044\u3002\n\u304a\u8a66\u3057\u52d5\u753b\u304c\u8996\u8074\u3067\u304d\u307e\u3059\u3002\n\n2.\u30ed\u30b0\u30a4\u30f3\u30fb\u30ed\u30b0\u30a2\u30a6\u30c8\nLPEGPOINT\u63d0\u643a\u30b5\u30a4\u30c8\u3067\u767b\u9332\u3057\u305f\u30ed\u30b0\u30a4\u30f3ID\u3001\u30d1\u30b9\u30ef\u30fc\u30c9\u3092\u5165\u529b\u3057\u30ed\u30b0\u30a4\u30f3\u3092\u9078\u629e\u3057\u307e\u3059\u3002\n\u300c\u30e9\u30a4\u30d6/\u304a\u8a66\u3057\u52d5\u753b/\u304a\u6c17\u306b\u5165\u308a/\u30ed\u30fc\u30ab\u30eb\u52d5\u753b/DL\u30bb\u30f3\u30bf\u30fc\u300d\u7b49\u306e\u30e1\u30cb\u30e5\u30fc\u304c\u4e26\u3073\u307e\u3059\u3002\n\u30b5\u30a4\u30c8\u3067\u4f5c\u54c1\u306e\u3054\u8cfc\u5165\u3001\u6708\u984d\u5951\u7d04\u7b49\u3092\u3057\u305fID\u3067\u30ed\u30b0\u30a4\u30f3\u3092\u884c\u3046\u3068\u4f5c\u54c1\u304c\u4e00\u89a7\u306b\u4e26\u3073\u307e\u3059\u3002\n\u30ed\u30b0\u30a2\u30a6\u30c8\u65b9\u6cd5\uff1e\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u5de6\u4e0b\u306e\u8a2d\u5b9a\u30dc\u30bf\u30f3\u3088\u308a\u30ed\u30b0\u30a2\u30a6\u30c8\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n3.\u53f3\u90e8\u30e1\u30cb\u30e5\u30fc\n\u30d7\u30ec\u30a4\u30e4\u30fc\u53f3\u90e8\u306e\u30e1\u30cb\u30e5\u30fc\u3067\u300c\u30bf\u30a4\u30d7/\u4e26\u3079\u66ff\u3048/\u30e1\u30fc\u30ab\u30fc/\u30b8\u30e3\u30f3\u30eb/\u51fa\u6f14\u8005/VR\u5199\u771f\u96c6/\u5b57\u5e55\u6a5f\u80fd\u300d\u306e\u691c\u7d22\u304c\u51fa\u6765\u307e\u3059\u3002\n\u30bf\u30a4\u30d7\u306f\u300cVR\u30fb2D\u300d\u306e\u4f5c\u54c1\u5207\u308a\u66ff\u3048\u304c\u51fa\u6765\u307e\u3059\u3002\n\u53f3\u4e0a\u90e8\u306e\u691c\u7d22\u30dc\u30bf\u30f3\u3092\u9078\u629e\u3057\u3066\u30ef\u30fc\u30c9\u3092\u5165\u529b\u3059\u308b\u3068\u691c\u7d22\u304c\u884c\u3048\u307e\u3059\u3002\n\u691c\u7d22\u3092\u3084\u308a\u76f4\u3057\u305f\u3044\u5834\u5408\u3001\u4e0b\u90e8\u306e\u30ea\u30bb\u30c3\u30c8\u30dc\u30bf\u30f3\u3092\u9078\u629e\u3057\u3066\u4e0b\u3055\u3044\u3002\n\n4.\u8cfc\u5165\u6e08\u307f\n\u4e00\u89a7\u304b\u3089\u4f5c\u54c1\u3092\u9078\u629e\u3001PLAY\u3092\u62bc\u3057\u3066\u8996\u8074\u3067\u304d\u307e\u3059\u3002\
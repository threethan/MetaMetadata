8563_5953171904919180739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uIJIktznOUQ7kNvwGVfOfh&_nc_oc=AdorCKdTxLcpkugd42USXr2qyKpQeKLdnpq4W93JM6v-5KmmvREGYwUiY0zNtf_Oyms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF6LN2T0obQ0YxiX-1G6m94Plod0YdA3iwIM6X86YSZg&oe=6B05A84F"}, {"file_name": "applab screenshot3.png", "id": "983022023606598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982619_983022030273264_4990515898292565542_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23ygBFQUyYcQ7kNvwEmkTG_&_nc_oc=AdrU3HXRl7ywg2MhyA_rnJcyKKkWLFFPM9BeYRKwN7L26WtLcXN6ioj3r0-uaThDO_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbnHbxZ3-nAFn9zLjBDDq0hnyWLQ6laSWEaxYcyuEYZw&oe=6B05A9DE"}, {"file_name": "applab screenshot5.png", "id": "1695435504594666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1695435511261332_6659533633796777977_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0blyGwn4mIsQ7kNvwG6RPMt&_nc_oc=AdqJ0R2tE5jnFMi9H2Bxm1iQsZ9G1xMOTXZCY-P6mo3ejFDFDVbHYgJb5WnOnTY1AHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-bzn8WVrh43fubLNU88mGfkdt6UJ_ZpLG_Zmns2H4ZQ&oe=6B05A594"}, {"file_name": "applab screenshot4.png", "id": "1000185934751185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75303838_1000185938084518_794172045269513713_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3ufe8oVrykQ7kNvwFsem35&_nc_oc=AdoudrdRGV5jqUWmMx2C9__FT9CSAvZjHrvkhTFlE6ZIrZ2tpLrdHnSI0SYMvEOMIf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqCbl48PRqyGBIAB1aep8SMOqfzuseXg7sy2HaXVcdJA&oe=6B05BA2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab trailer thumbnail.png", "id": "465887202733268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001688_465887206066601_699368569488131784_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ev7xdKAfogQ7kNvwFOql9e&_nc_oc=Adr0eC2MRlrJObArb-Cl6zYh_Yo_R9Rhsuc1d-WmQEpoVGPD36OP-fZidJGE7l-czjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6QwgBID1_tZJdqNWbpOFbb22i3Rgl0wlSMnCCgr-zlA&oe=6B05CD5B"}, "display_name": "The Show VR - Multiplayer Minigames", "keywords": [], "long_description": "# Enter the world of minigames in VR!\n\n*First of a kind multiplayer game that allows you to be part of The Show!*\n\nThis is a pre-alpha version of the game, please give us feedback. our site - www.theshowvr.com\n\nOur Current Minigames:\n\n- **Green Light, Red Light**: Test your reflexes and strategy in this classic stop-and-go game.\n\n- **Snowball Fight**: Engage in epic snowball battles with realistic physics for an immersive experience.\n\n- **Falling Stones**: Dodge the falling obstacles and be the last one standing.\n\n- **Sky Fall**: Navigate through the skies and avoid obstacles in this aerial challenge.\n\n- **Green Mountain Obstacle Course**: Race against others in a thrilling obstacle course set on a treacherous green mountain.\n\n- **Bomb Tag**: Pass the bomb to other players to avoid getting blown up in this fast-paced game of tag.\n\n- **Stepping Glass**: Carefully step on the correct glass tiles without falling through in this nerve-wracking challenge.\n\n- **The Wall**: Are you ready to climb? Be the first to reach the top!\n\n**Minimum 2 players are required to start a match, please give us any feedback on discord & our site at www.theshowvr.com**\n\nOur goal is to make the funniest community multiplayer minigames game on VR :)\n\nThank you for trying out the game at an early stage!", "short_description": "Welcome to The Show VR, a unique multiplayer game that brings you and up to 15 other players into a world of fun minigames! Inspired by the best minigames in shows/games!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theshowvr.com/privacy-policy", "developer_term
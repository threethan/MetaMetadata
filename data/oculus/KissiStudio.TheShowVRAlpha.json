8563_5953171904919180739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDi2eQ8qTq8Q7kNvwFA30xI&_nc_oc=AdoMCVRKYUDPLHRprHqinyHHwS9a32nmA1MsPBETk1ZG0DJo80aetVCKIBeuDxZ7XaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT879Jn0gHk3jnDRhZsJL7CW4N57i-DvBHxWdCbeY6yiA&oe=6B0456CF"}, {"file_name": "applab screenshot3.png", "id": "983022023606598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982619_983022030273264_4990515898292565542_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDYNH3zg4WgQ7kNvwHOZZow&_nc_oc=Adq6JjRNruMbCO6gGi6WlCztTBARRcoLQyRRi7okiJ5oEqjmTdHrMRbW8P1jwQ-5Nws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWoUn5jbohac9L6rq3sZd34oNMNvbMcls95c10-BgQ8A&oe=6B04585E"}, {"file_name": "applab screenshot5.png", "id": "1695435504594666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1695435511261332_6659533633796777977_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zH1s_r3KIyQQ7kNvwEClVkp&_nc_oc=AdpgX8Gjyf-An0hBRJa0bCc5PkJ2tkbIcU611XGWJEpbIn0R1J_40KawAk7BYdXGQok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSruAhIcV1Vd5AL18WrunN2RjdDHHp5Q6aIbsNFs9c6w&oe=6B045414"}, {"file_name": "applab screenshot4.png", "id": "1000185934751185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75303838_1000185938084518_794172045269513713_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfbriHN6EhEQ7kNvwF-XBiz&_nc_oc=AdqprS-ddmTVNnI2yAHXFCr5GVDM-5K20UPo4hxH9QA1hN5RJ8Ba35d-Wkcodp32bgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHx5zdV3cXKPhkFhEkSGf5OPa9uH0s6bgO-AjKq5hERg&oe=6B0468AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab trailer thumbnail.png", "id": "465887202733268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001688_465887206066601_699368569488131784_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq2jWmM7LjYQ7kNvwEZJqir&_nc_oc=Adp8Lt0bmobsAMYIHx6uj0cdTKCprlSFDaulLSo7GdAF3eN971mY9MJOyccdHlpayF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuOi70PpabRUSffeF-pNtqfDlH3PmWui6XxEA5peei8w&oe=6B047BDB"}, "display_name": "The Show VR - Multiplayer Minigames", "keywords": [], "long_description": "# Enter the world of minigames in VR!\n\n*First of a kind multiplayer game that allows you to be part of The Show!*\n\nThis is a pre-alpha version of the game, please give us feedback. our site - www.theshowvr.com\n\nOur Current Minigames:\n\n- **Green Light, Red Light**: Test your reflexes and strategy in this classic stop-and-go game.\n\n- **Snowball Fight**: Engage in epic snowball battles with realistic physics for an immersive experience.\n\n- **Falling Stones**: Dodge the falling obstacles and be the last one standing.\n\n- **Sky Fall**: Navigate through the skies and avoid obstacles in this aerial challenge.\n\n- **Green Mountain Obstacle Course**: Race against others in a thrilling obstacle course set on a treacherous green mountain.\n\n- **Bomb Tag**: Pass the bomb to other players to avoid getting blown up in this fast-paced game of tag.\n\n- **Stepping Glass**: Carefully step on the correct glass tiles without falling through in this nerve-wracking challenge.\n\n- **The Wall**: Are you ready to climb? Be the first to reach the top!\n\n**Minimum 2 players are required to start a match, please give us any feedback on discord & our site at www.theshowvr.com**\n\nOur goal is to make the funniest community multiplayer minigames game on VR :)\n\nThank you for trying out the game at an early stage!", "short_description": "Welcome to The Show VR, a unique multiplayer game that brings you and up to 15 other players into a world of fun minigames! Inspired by the best minigames in shows/games!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theshowvr.com/privacy-policy", "developer_term
8563_5953171904919180739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B76amWkxm-oQ7kNvwFRgEPd&_nc_oc=AdqkJBc56oW1_KhcmNhbZJXmwDFaYihc1LI69t_L_ipRBeO5W7QtAh-0Slhkxt9vcrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHSgvo72vHUtaYBtntevu8yEHTaamntUNk5sQEh13tRA&oe=6AFDBF4F"}, {"file_name": "applab screenshot3.png", "id": "983022023606598", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982619_983022030273264_4990515898292565542_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xkhPVp99_wQ7kNvwH5Y6dN&_nc_oc=Ado-f0rWtQ_U3CuSub7MiMfqBIsMmf4RC8nB4ezkZDy671VpNJm4txs-xpBuiJE54PA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC8avaZue1ZVhxYXXjIoBzRhiRQotO57PtPHTwUj7htg&oe=6AFDC0DE"}, {"file_name": "applab screenshot5.png", "id": "1695435504594666", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1695435511261332_6659533633796777977_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALYJrH2esU8Q7kNvwE908M7&_nc_oc=Adp6xQIvNAhVSYU8V3aSPi7Ds5npWcibgLlRsQyRspfn1X56x2OV67I9TlNJtCtHN7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7ROkpJLTibOwgJoTQlNlFTrEd6hSg1mlNXowY02s3mA&oe=6AFDBC94"}, {"file_name": "applab screenshot4.png", "id": "1000185934751185", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303838_1000185938084518_794172045269513713_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzlMRXtexMIQ7kNvwGSZVon&_nc_oc=AdoULNxAU7h6iIGMHh4Y9Ln-bAcq-FN35Q3fMzjXTbA2n7vAE3W3MyxJTipUv-3Qvro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMLu19tS5EZQwp4sk4GjLp3qzkJisXt5d92HR665Ui2Q&oe=6AFDD12F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab trailer thumbnail.png", "id": "465887202733268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001688_465887206066601_699368569488131784_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJfBfDXz3YcQ7kNvwHfZaAG&_nc_oc=Adp6UARI32pMQNposLMYb02knUVi2adzSMU9kAD7zCiVfHPLuSgMwYshr0t4EF8JmBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVl-a6qILCOg4bLbJxrZgk9Db9K3wElMTPEiCu55U13A&oe=6AFDE45B"}, "display_name": "The Show VR - Multiplayer Minigames", "keywords": [], "long_description": "# Enter the world of minigames in VR!\n\n*First of a kind multiplayer game that allows you to be part of The Show!*\n\nThis is a pre-alpha version of the game, please give us feedback. our site - www.theshowvr.com\n\nOur Current Minigames:\n\n- **Green Light, Red Light**: Test your reflexes and strategy in this classic stop-and-go game.\n\n- **Snowball Fight**: Engage in epic snowball battles with realistic physics for an immersive experience.\n\n- **Falling Stones**: Dodge the falling obstacles and be the last one standing.\n\n- **Sky Fall**: Navigate through the skies and avoid obstacles in this aerial challenge.\n\n- **Green Mountain Obstacle Course**: Race against others in a thrilling obstacle course set on a treacherous green mountain.\n\n- **Bomb Tag**: Pass the bomb to other players to avoid getting blown up in this fast-paced game of tag.\n\n- **Stepping Glass**: Carefully step on the correct glass tiles without falling through in this nerve-wracking challenge.\n\n- **The Wall**: Are you ready to climb? Be the first to reach the top!\n\n**Minimum 2 players are required to start a match, please give us any feedback on discord & our site at www.theshowvr.com**\n\nOur goal is to make the funniest community multiplayer minigames game on VR :)\n\nThank you for trying out the game at an early stage!", "short_description": "Welcome to The Show VR, a unique multiplayer game that brings you and up to 15 other players into a world of fun minigames! Inspired by the best minigames in shows/games!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theshowvr.com/privacy-policy", "developer_term
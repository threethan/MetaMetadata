8563_5953171904919180739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uIJIktznOUQ7kNvwHMHbId&_nc_oc=AdqQk5gi8l6D46Wf2tcRQVMYNE0if2hNcBMCtN8U3ZFV-4gYLD5t0khqgdAU5wMMOik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyp08aU2zLANX6px-jQnCaw0LMhJK0bzU_a49yvNOYBw&oe=6B06F9CF"}, {"file_name": "applab screenshot3.png", "id": "983022023606598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982619_983022030273264_4990515898292565542_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23ygBFQUyYcQ7kNvwE5xMnM&_nc_oc=Adp3DpIScj5RbOo3lVaLleOuW3yYBwTDvNhy-vYThNXV2mpdz4dfWLQ3KEYzu14v82o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO_BfdufmRlIJDSDcY5XKSEcsKb0_gHMplGLW3AAO2MQ&oe=6B06FB5E"}, {"file_name": "applab screenshot5.png", "id": "1695435504594666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392232_1695435511261332_6659533633796777977_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0blyGwn4mIsQ7kNvwHzGBp6&_nc_oc=AdogDZyPgAVTDeR4fRCniAiEqhmnmuYHcYwdNG9kuabIgrX82mZNo-xDOwYeEzpazWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5fRaIYv9goPkMeD9Z71vukfyrvdY5Gb2Hz7xHrQKVTA&oe=6B06F714"}, {"file_name": "applab screenshot4.png", "id": "1000185934751185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75303838_1000185938084518_794172045269513713_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3ufe8oVrykQ7kNvwGeaAii&_nc_oc=Adq7ZoB0rjwn01RkaGRWJfiRiF-S5j7P-GCvRtW7_I6VunnB1P4aJfIFKqhZsZaypts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx_TncXY3tq0cH1Ilv7NXxq2NwUCrkrCrAXmahJtFIUQ&oe=6B070BAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab trailer thumbnail.png", "id": "465887202733268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001688_465887206066601_699368569488131784_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ev7xdKAfogQ7kNvwH9QdH4&_nc_oc=AdpfvXgqETIwtFP1Jw_LMmrYJHeezMe31jaq4K5j_J4UB0Wt9ttSDsdIoS-OcZllDdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgsP_3ZyOl-NJ062RNR46wgl-0kfby7-g1R6i0P_7CeA&oe=6B071EDB"}, "display_name": "The Show VR - Multiplayer Minigames", "keywords": [], "long_description": "# Enter the world of minigames in VR!\n\n*First of a kind multiplayer game that allows you to be part of The Show!*\n\nThis is a pre-alpha version of the game, please give us feedback. our site - www.theshowvr.com\n\nOur Current Minigames:\n\n- **Green Light, Red Light**: Test your reflexes and strategy in this classic stop-and-go game.\n\n- **Snowball Fight**: Engage in epic snowball battles with realistic physics for an immersive experience.\n\n- **Falling Stones**: Dodge the falling obstacles and be the last one standing.\n\n- **Sky Fall**: Navigate through the skies and avoid obstacles in this aerial challenge.\n\n- **Green Mountain Obstacle Course**: Race against others in a thrilling obstacle course set on a treacherous green mountain.\n\n- **Bomb Tag**: Pass the bomb to other players to avoid getting blown up in this fast-paced game of tag.\n\n- **Stepping Glass**: Carefully step on the correct glass tiles without falling through in this nerve-wracking challenge.\n\n- **The Wall**: Are you ready to climb? Be the first to reach the top!\n\n**Minimum 2 players are required to start a match, please give us any feedback on discord & our site at www.theshowvr.com**\n\nOur goal is to make the funniest community multiplayer minigames game on VR :)\n\nThank you for trying out the game at an early stage!", "short_description": "Welcome to The Show VR, a unique multiplayer game that brings you and up to 15 other players into a world of fun minigames! Inspired by the best minigames in shows/games!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theshowvr.com/privacy-policy", "developer_term
8563_5953171904919180739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJCkD6bEl6UQ7kNvwFQDBEy&_nc_oc=Adry1hgEGVA6CAVBu_z-N-PmMufcV5OBUboN9Td7HJiYxy81zuw-AyOsjG5tZnb-U9k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTf0vLth3yabzzaGkLN7qbdNOKh5CAf1QqFD0H2vCw3ew&oe=6B0B268F"}, {"file_name": "applab screenshot3.png", "id": "983022023606598", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982619_983022030273264_4990515898292565542_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Rkaj3Xy3fYQ7kNvwFkKMzg&_nc_oc=Ado-mJGGmf6sJrVCR0OuJMXBkQcsVVwlm3SAS--PoPjztyr08a2ybORDhOFEspgMoPA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqiCQd0yifIXQ0xkAfgdrPDQBwtp2XdEvRo2pATdPi2Q&oe=6B0B281E"}, {"file_name": "applab screenshot5.png", "id": "1695435504594666", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75392232_1695435511261332_6659533633796777977_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CukLWdww-SIQ7kNvwHLA6up&_nc_oc=AdrKEV-0Ije6vy635u6g32ASzBp3Dy34F6411DiQ2gzQWA3mdOiX2JNrGtPBwNy3VwI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoMbGR7ncpIyuRzRE0Ol4SPrYD2muq4PR96vBcv0UI9g&oe=6B0B23D4"}, {"file_name": "applab screenshot4.png", "id": "1000185934751185", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75303838_1000185938084518_794172045269513713_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IobLDKHioCIQ7kNvwHgVCXa&_nc_oc=Adp38b743UILzKoTqrF8LTTCEZNjHWousDWdW0sXP4ShNEAkLgB462xll19XYurDQb8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQnKqM7VdA3VpVZEancOOhp1rjxZNl9vr8WMpzSufFOxg&oe=6B0B386F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab trailer thumbnail.png", "id": "465887202733268", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001688_465887206066601_699368569488131784_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-JtOF26piYQ7kNvwHBzkpG&_nc_oc=AdrxrNs1qTqbZJO2AQqSMH2liKMz3w6VGFE4UYr3Ypu3S1wfJ4749HViDs95XelEtf8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZqNJlR-Lacdkew-SRpQH5s4BLgb5Pb59jHhu3tjSkbA&oe=6B0B135B"}, "display_name": "The Show VR - Multiplayer Minigames", "keywords": [], "long_description": "# Enter the world of minigames in VR!\n\n*First of a kind multiplayer game that allows you to be part of The Show!*\n\nThis is a pre-alpha version of the game, please give us feedback. our site - www.theshowvr.com\n\nOur Current Minigames:\n\n- **Green Light, Red Light**: Test your reflexes and strategy in this classic stop-and-go game.\n\n- **Snowball Fight**: Engage in epic snowball battles with realistic physics for an immersive experience.\n\n- **Falling Stones**: Dodge the falling obstacles and be the last one standing.\n\n- **Sky Fall**: Navigate through the skies and avoid obstacles in this aerial challenge.\n\n- **Green Mountain Obstacle Course**: Race against others in a thrilling obstacle course set on a treacherous green mountain.\n\n- **Bomb Tag**: Pass the bomb to other players to avoid getting blown up in this fast-paced game of tag.\n\n- **Stepping Glass**: Carefully step on the correct glass tiles without falling through in this nerve-wracking challenge.\n\n- **The Wall**: Are you ready to climb? Be the first to reach the top!\n\n**Minimum 2 players are required to start a match, please give us any feedback on discord & our site at www.theshowvr.com**\n\nOur goal is to make the funniest community multiplayer minigames game on VR :)\n\nThank you for trying out the game at an early stage!", "short_description": "Welcome to The Show VR, a unique multiplayer game that brings you and up to 15 other players into a world of fun minigames! Inspired by the best minigames in shows/games!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theshowvr.com/privacy-policy", "developer_term
8563_5953171904919180739_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B76amWkxm-oQ7kNvwHLq7SV&_nc_oc=AdpuMBbVY_YJJr3MYewPMvdfJQFD6kBpcXCTEt4TnfQwwrRtQqaEYNZAB7oqzZ0NbRI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQiGAROerzXH5iUQu3JEgGVm1aZDNp_nBxlykOMNDm9A&oe=6AFF10CF"}, {"file_name": "applab screenshot3.png", "id": "983022023606598", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982619_983022030273264_4990515898292565542_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xkhPVp99_wQ7kNvwF7zUZO&_nc_oc=Adq9GTbVlmnW4KeYTrJuDtFbO6yQWrCwMZ9-7FlwclpFAFMApj-5dSgFEPVzu6tGUnw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHFokcwXwSk5hpRz1NmQW-HNzwBWVRo31LIcIfL1Wjlw&oe=6AFF125E"}, {"file_name": "applab screenshot5.png", "id": "1695435504594666", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392232_1695435511261332_6659533633796777977_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALYJrH2esU8Q7kNvwGt70Kp&_nc_oc=AdrMiE_5Q6NRaJ_Tkux_-oktYAs0wDacu-20o9fJwcl7SskmRs4-dnrMuQFXP9pJ7RI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSON9UDb9u84dR--4693sBwdSNvmuiYf9KjirweOLVwEA&oe=6AFF0E14"}, {"file_name": "applab screenshot4.png", "id": "1000185934751185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75303838_1000185938084518_794172045269513713_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzlMRXtexMIQ7kNvwGwkp0D&_nc_oc=AdpHwSwR6PP-xX9j43WH82xBuTvVa2ZwhkyenTobk6ILKWVk2TiDMpcpNx39IfLqq2Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpdJerd2B_wO90DCZXO7020wlAMKvhC1v2mwK3EU1Zyg&oe=6AFF22AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab trailer thumbnail.png", "id": "465887202733268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001688_465887206066601_699368569488131784_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJfBfDXz3YcQ7kNvwH3tXt1&_nc_oc=AdpfatGHxa5fb4NAwrEOUMkb6igz_h066JyqmKJDPT5p2GewaTcVKZr5bo4Kx-qZhJY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdQrNWeRf6lDj-hSFGTy1yFvfgp-BK5zc-i79cwe42Og&oe=6AFF35DB"}, "display_name": "The Show VR - Multiplayer Minigames", "keywords": [], "long_description": "# Enter the world of minigames in VR!\n\n*First of a kind multiplayer game that allows you to be part of The Show!*\n\nThis is a pre-alpha version of the game, please give us feedback. our site - www.theshowvr.com\n\nOur Current Minigames:\n\n- **Green Light, Red Light**: Test your reflexes and strategy in this classic stop-and-go game.\n\n- **Snowball Fight**: Engage in epic snowball battles with realistic physics for an immersive experience.\n\n- **Falling Stones**: Dodge the falling obstacles and be the last one standing.\n\n- **Sky Fall**: Navigate through the skies and avoid obstacles in this aerial challenge.\n\n- **Green Mountain Obstacle Course**: Race against others in a thrilling obstacle course set on a treacherous green mountain.\n\n- **Bomb Tag**: Pass the bomb to other players to avoid getting blown up in this fast-paced game of tag.\n\n- **Stepping Glass**: Carefully step on the correct glass tiles without falling through in this nerve-wracking challenge.\n\n- **The Wall**: Are you ready to climb? Be the first to reach the top!\n\n**Minimum 2 players are required to start a match, please give us any feedback on discord & our site at www.theshowvr.com**\n\nOur goal is to make the funniest community multiplayer minigames game on VR :)\n\nThank you for trying out the game at an early stage!", "short_description": "Welcome to The Show VR, a unique multiplayer game that brings you and up to 15 other players into a world of fun minigames! Inspired by the best minigames in shows/games!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theshowvr.com/privacy-policy", "developer_term
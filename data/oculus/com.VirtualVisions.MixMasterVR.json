IN4Q7kNvwFynvtx&_nc_oc=AdqNp0MA5GeVJU6gkyKYIdvUpVqMXR4x8VEiqvQfEHBDilkaHY0FSx6hm5UVCSjW7eI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeIPY0qqCgkDKhjHL9KCm2TvJURybmszozxTyyY5Nvcw&oe=6AE0A890"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEqtv3try-sQ7kNvwHFj83i&_nc_oc=AdrrXBMXYxzz5UTxFdJYUE9V05ZP3jDRiMaheoAUigbfFsJ8glCcjK6VByVbS5hV8uw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2KLTtilw7AYbhZGsbhUfDL3WnZs_ECr433p-ekRkcmw&oe=6AE0A493"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbGaLnrdSWkQ7kNvwGv52pW&_nc_oc=Adq3So-gkCtchK-8vNaMTEaKhH-ebBRT1OQEb1ATyQTfysfFI-zHu-5ihiiDkeY9Q-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_pr7MWRFTzVgWdbJ2Ca5cjHmHdUdouXCylpbSMw62Hg&oe=6AE0A877"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWUJZ8Vtx48Q7kNvwG105D1&_nc_oc=AdoK3wskSBKpGyDyS6pgjb7uoXinXYbYotR1nTqmRKNxN7YhYhgbbwK9xVfC2pnAPAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKKOk5d1fCLRaCbKZMRNteGWajyQ9_Fa_ygY4br0UdCg&oe=6AE0BCF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxcCO7UlSd8Q7kNvwFqXCRY&_nc_oc=Adrx_OQI4trrvviYFM6SlTw5bky4H2htWrX_PAUa0kiIqcDQBo8-B8d5cQMZTciihxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr9HDWRGj5k9ksujy_-VWYfwzyu9KiqKw_CRF4PxJrXA&oe=6AE0C2E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
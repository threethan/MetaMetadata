hQwQ7kNvwG8kwYO&_nc_oc=AdrOhV2nTNUG8OJNKaFMl3irBfYSGHj7F0zVkrOp9zJv1qQOOVDbaH_ScMPUlT4hi7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YR2rbwIHT_7SuexZas1DH1BvfExd89JXeOw5OdpdV6w&oe=6A3A8B90"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxiyUKPdrCAQ7kNvwFBQBVD&_nc_oc=Adp8nBOk8lSaLYFKYy4YF_OlhjaqARab0J2l4zy5zJq_qGes2yNwQm5-5ZZ3BSUMSHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80TVnzlp8N4gkrWZvrYf09Rvk7oxIgwG8AeEds7bbyYQ&oe=6A3A8793"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnnyfRqQUewQ7kNvwHV_d1g&_nc_oc=AdoeAiQUlWw4lawkjcHAE3F75BwOR6XpdDHJr4KzpjNVs0jiP01ygmezrvJBKh8icnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cOW9uof87hP_eFH_Lk13uaNhQ4ALb6u162AYY8Pwg8g&oe=6A3A8B77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKn9KahF-3sQ7kNvwGDAyLB&_nc_oc=AdootIecx5QF1hPjuBBXMof_sDLqgJmDk0dsebni1ippcqb2RvTWC882Uokftz8um-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ArC0y6uB-eWIDcsG35mfS-1xIajmZlZGFACruma9bYQ&oe=6A3A9FF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl74cW_ToXAQ7kNvwHrsVyL&_nc_oc=AdrsrOZIBTtyBiLQ3TzWvYNGJ0EN-pBm5eziaz9vakH27KwtVCqsOha4BJrKAr3BtzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hmUcF6OiXu9gkopyNsUNt7cq_4gSMlb8v9bmwNEBfug&oe=6A3AA5E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38T5TF_YfecQ7kNvwEeJWeJ&_nc_oc=Adpd83rOZsdzT266_-RTv-sfpTLSwCY6hTx-qUiUBRWY7MRBD0-ZO5O-m9boCu0r5P0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR4UIoS8BcE2np4p95XU3GQFZG4w0nDshsL3aK-8PQgQ&oe=6A60C313"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twvhe48bz-wQ7kNvwFRdAhl&_nc_oc=AdqRUK7CHwLMRZIoludYbM7-ZVEiUQUT4aZvsqNoyoSxdljjNc05GbIR0ph6CTsTF5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfTWQw_5vAjPoB_PxvX5qadIs5rZ5gZQJ_u2D-Jv078A&oe=6A60C6F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83hjkhI7RSoQ7kNvwF8Ufl7&_nc_oc=AdoP9On4Vimbv2HV3qPgHFIQ5kBw9_cDBhjhv-FTxgsLV1dzADJzrpU-ONSGrgQ2eWg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTSAF9QaoQWcjBLCcwUh-GytBPbAaS7ttYa8JquF31og&oe=6A60A336"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrfJwM3rpAgQ7kNvwEM768B&_nc_oc=AdpRQ6I4ZqHDMUKuwhZYpZ0pwfqoKSC-FOJCxh4v9JhuiAg38XsvKvIOnLAt1AF72aA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG8rT4hYq6DYUKXaARkuEdjQeWEP3mFpYdY5gMrdawkg&oe=6A60A929"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
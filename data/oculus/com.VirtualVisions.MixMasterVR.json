o8MQ7kNvwG401s4&_nc_oc=AdoGrf5-yze8oSQT_rzPDVGn4zCD6U5QhYntg4ihKfkny3dOgo4oGc5nh8AtDEiANwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G6fQWRotNSlUHxZeWy2TnOv7JTlZxo4KJApf7DpAOtw&oe=6A05CF90"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17Plx6a5aL4Q7kNvwF6MCUq&_nc_oc=Adq8yKJKulNjr95xsShBSWv_0AtkIzyiRrc6F1YgTm0ps0qlNBuuRNdkY5WI8Dz0-V8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iCDckXSPregVAU0hG00xSkimS0wCiBFCknrv0Go5L_A&oe=6A05CB93"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU6Ih206ofkQ7kNvwHUFQOG&_nc_oc=Adr_Zok4ueBhwTUmVfjATzRskwIP9znfsCu5RzSX1Z10KRkiX8Z8iDBwTRChO_st0HI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46KqMRuxI9yeUwKedv2z0wGCUWRcvUKc1-Ph0mgEWDOw&oe=6A05CF77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a1kn00gKuYQ7kNvwFj5ErY&_nc_oc=AdoE-Eme0R2M65zg7d1KLDdJfYJPyOgNU27S96u6FDCdmSc9hO4OmWZx--NhbNlfoDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fvHfGJ-Dq4SU_ojv-PZOUE4S4mGBnVCWGTIr95sa72Q&oe=6A05E3F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smF8hByW0GMQ7kNvwFuvO1B&_nc_oc=AdoBBiKrNI_gYF9LUyLytg-WMyyU57golIMXyDXn9SmWwW9_RUplESognPWiuYLqEAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZZ1lAYTwmOGVW-9-PCixtsWahEiQT9rYG3TeeKziy9w&oe=6A05E9E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
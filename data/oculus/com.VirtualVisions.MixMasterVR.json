6f4Q7kNvwEzYpre&_nc_oc=Adp7dK2OjIv_O1XrnQiIPW6J6p39Fs1kBHtPE67tgnLTOcfdrE7BGCNXmvpvWKwRGpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqJOrKz62PuGEri53aEVLdii8CJ4VunsseAQAqj8R59g&oe=6AEDD790"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCF2qzwSxlEQ7kNvwFd-kM5&_nc_oc=AdqIIAjFzEkcrf42DjQbAULq4dXNjyKMZDNkL2S5YpXbOcT35egyn_F6o57KyTm1qVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXFZjwDigHKlLbqVLO_X9WoiyT7Q7W3BSkG8363Omq6g&oe=6AEE0BD3"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zkvab7oJLHEQ7kNvwFKBOuf&_nc_oc=AdqEh4jkny2STF-gNBNNfw49quKC2Xy3mZiuYrUqfVN-I7hFqA3HoJwpGKQiv_brScc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj-9wxeixQcSNq8NRJGi-1cT64BOhNMeSx38AI5ApBFA&oe=6AEDD777"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRs6N-i-zyMQ7kNvwFASdAZ&_nc_oc=AdqRvOPavX2scUUsL7xxJmxocPjIJ8l7ujQDmA7nwMbhKSEgL6xzqjW-XAYyzjr8_fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmfJAS1HnCRn8L0YnTGCe0YrBqVsh6aGhae-TI9tn4dQ&oe=6AEDEBF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z-PExvcQTUQ7kNvwEkoHBf&_nc_oc=Adr6OUy5xA9FoNNeRf4iku8gTqPIKmmgZzj6R4V40mXDH3PMbNbpjOlaFbANpf9NxQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT9SkwJZxt9pROJOy879J0SrGlgMkntHLt1vEhjO9zow&oe=6AEDF1E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
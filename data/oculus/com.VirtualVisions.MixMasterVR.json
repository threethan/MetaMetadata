pIMQ7kNvwFWlM4C&_nc_oc=AdqnvlYUHrryUiBuF0KKt0KdazpR3W5f8FiQE0GWIbjC8pOr8wxPRgx_Q_mcdiKL1bQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3BOiG3ee1Xm_URs10WmFWXPaxOtIf8GtSWbpleXcdfQ&oe=6A636A10"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38T5TF_YfecQ7kNvwFX0Pat&_nc_oc=AdoQyZ-EF4dVXe564VNGCSSvrWniRmKi59Oz6tgftl4I43Qd69zkaH3aYfkDwsxA8Xw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoOZydmYcAGDv-TKN_ziP8XhA8399l8FYjuEencLLTwQ&oe=6A636613"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jleEPCF3NZgQ7kNvwHFejPB&_nc_oc=AdqDS0hgVLrx02v4ZF-HFwa2WBcbj5eDYzwHyzc8oO-XXAYKgk8kLr55yoAOGJZiSso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGd0xAS70wVIZXjN-FysM-GKqYkASQAI5S84xHA7hZtw&oe=6A6369F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83hjkhI7RSoQ7kNvwEYq7vZ&_nc_oc=AdoHVtzpd_YE7EC-DgPndttktofDqj9YYcdxvx-9n-yV9HqsNQYsh2cvqqUB5yto7Fg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9Q0CUaYkfn2IuL9iNDiVwRaPcPabQLlChi5wXZCVbOw&oe=6A637E76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2pVSnJYBGMQ7kNvwFKaGk5&_nc_oc=AdoBUAMFShRs8gPhT9oDlNFobnWuiIPyQgo6LKAdDi7iKPKRxMyti6SH7sgjrxNpql8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXH2W9emd_y9OX9P2M_DBMhS6pSQ5Jv5b4aTKEIuEssg&oe=6A638469"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
o8MQ7kNvwEdELbk&_nc_oc=AdrQikfd0Yy8CCzbbM8qI6-sPqKG3FDlr-KVD2on0J7gzr20QgmrSW7U2bFdfjGagg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LRVkUkeSlbg3hb1eNBetDIwasvkoLE60QJ_k1TgQE0A&oe=6A072110"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17Plx6a5aL4Q7kNvwERx0og&_nc_oc=Adp0xWNsrD9gDbZ8s5D49iV2lGwInvy7FYTkP2Wts7iqHEsjXWox__LXm8LT59-Ct1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57jo6UmdhLPvosVzFa6iTIQaYgFGJ7pxOlfqlXo_LRGA&oe=6A071D13"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU6Ih206ofkQ7kNvwF5kd9F&_nc_oc=AdoWQyY5U0ADZA8khZgHGap5ZOuc7KWAomxztf74hjzZJHi6SbUR5hSZdWf0FfEtyns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pQ1DSfwsWmhaohDVJqNv5XbtO6IKScoctFdVWlYKiJw&oe=6A0720F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a1kn00gKuYQ7kNvwE0zFD1&_nc_oc=AdpdlMrzXTJAGp9MXmzXKxo1E8OPJjpnP6G6ZWY1N9njImqhCLDj_y6rtotnsNbfVkA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PKZdBls38VehH8sxBz3POauwjMYO2VL4ujy0KFpGSMg&oe=6A073576"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PlCyftA_foQ7kNvwF6Tvao&_nc_oc=AdqW4ES_ujxwTJF8e8WcGPd4fsgXjSU-h-tTPqHDIxkD_qffUA9I3MH83SwE8GGN40s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BDkL2O7ICmMLx6anVhtHGiFLAdmhPRdSeMurtxbHMJw&oe=6A073B69"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
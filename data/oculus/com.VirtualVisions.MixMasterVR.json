OMQQ7kNvwG5cbge&_nc_oc=Adqv9W07tQIidFxctX9n72vgc8HV4I1wmQ52Yx6gC-k0i8PrV9KM0d2MQHVirqR8U_Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2E7VheCC1EV4qyzdER-kw--Kn9kA-WMNr4YfPPZjX23A&oe=69F5FD90"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEcv031iyYEQ7kNvwGbJEgt&_nc_oc=AdoQwm02jrGZSh3SnJsNwppfFcj-WwqtoQQz2_jKqYWsj29Z0bPYnPApDoMfNsoSi-Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ejjlLOGbxS2lS1jgP4_Tjal_hcc5DH3JYSm-RDTBqWw&oe=69F5F993"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jccXQNroIBMQ7kNvwFw5pCT&_nc_oc=AdrJ2dfEDAM67kJOZt-HtpUAGHpCKpV0F4RA8febWdklO4F8iaS4-rMnSfPuETm4KmE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22EBw-9ykjxucsXlRn6VC2pVi57eR_rrQGGVZH0xMnLQ&oe=69F5FD77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJykJfnTsv0Q7kNvwEiIYKY&_nc_oc=Adrk1Dv5TtdIRLXwLoK7WxXULZDDgcpaRO1Ea8sI5f2ysSDJ0kVyYUT-lQ0sO_39iCY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OLCTkeh61DUZSihlDlEKdOFMEpOE6FoG62kcXtqanUw&oe=69F611F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLomX7NXM0QQ7kNvwFtOYwx&_nc_oc=AdqtpnxuKEE8Bs3HtIsYeWY8N8k4bQDAvzcK9TFBzEalrstHx5KFGGwqsk597JTKl04&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UjzretWAzetvmMyzUxVGvVyjXM2C31aSZvVQoS55l7Q&oe=69F617E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
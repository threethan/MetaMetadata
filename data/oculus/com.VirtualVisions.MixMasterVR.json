p3AQ7kNvwFgQCzW&_nc_oc=AdogERRF8qlYAHMD_6RIJ5hEqUvkSoI-D69Y3c1KNxrCOV_BsnyIZNuyELk0e4VUyx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbxpupD36CXcK0_w4WGVS00ni_IhgTpdeCdmRqIymJnw&oe=6AB52710"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpOcqiFWX8gQ7kNvwE8BmLt&_nc_oc=AdoV0DNwU-lFDs_cpYp1SG6QF5V-WVK_wTVRDZ0tlhYicCL2zK2LtU80D2ynkUQk1GY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInpG9iuEdrnwoWpkqqmnAo9HRQpPLugTfQSVZqOxDTWQ&oe=6AB52313"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuixJ-yN4EYQ7kNvwGFvjbY&_nc_oc=Adr7AbHL7JPEy3oMkKRo7lGMpI48gYWHSTN8FRdEjLpLPrcPtHF50os6O2TNQTI1dCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt13CmjIE-1QTtKwb2ZQR-lcjDm8Ya22-UPHUoQquDIQ&oe=6AB526F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMMxzbxS7uIQ7kNvwEVQUte&_nc_oc=Ado-Zhq2LdA8kWLoiIazum7wgelvvFHRD2bUzulUVhSzcUYNelSz6wj-G0TmU3v_jOQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp7_NEbNXfWDM85N6X-2Sw5MLmil4xpOvsHPfd7ZqpBQ&oe=6AB53B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgPwoNVc5C8Q7kNvwGsBwA2&_nc_oc=AdoL7ejQJQ4dfx6cXWvpeFyhVDYY3cilSP2q8uQ7bA8Yk1mvgyeijjaByEwNtH3EZlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4_Y49HfBO5qCZJPgOy2wCsCv3_AURH1oLEtVNSc-8mA&oe=6AB54169"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
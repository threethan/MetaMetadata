IwUQ7kNvwGZgOJO&_nc_oc=AdpPikEGL_CEwlZNrt_0hYvdy8dpeslx0KJYu1jRox4ScPvy4euxbzxKodxs3lZDtp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wvAq1VUn3Y17kDw_OU7FH6RVHIBreH9B6XK6wZ5Lrxw&oe=6A2D5C90"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTFe4erbnuUQ7kNvwF4J_AO&_nc_oc=AdqAifjZQwBl6dwG0Y3ttCzd5ES-UbqiTqBqm_pSf0kODusrlsVFaQg-KkrzA699kE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J-YMQ1-sWemZBsatfkNdJaT5EmAakSZOAQXo4G5355g&oe=6A2D5893"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpOMFmkF0V8Q7kNvwFzyV2X&_nc_oc=AdrwwhBLF-oDOvERqWQNfDK1mRM8R7-ISYIElBxlqGDw0CpovuoBRc40S1u9nJxC7hA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vRzx-IUDU4JE3Qr3s75E_jnwQunJPvz-avwKECmfl8A&oe=6A2D5C77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWEW2bmrmZ0Q7kNvwFecKae&_nc_oc=AdqjKUt6bxMI-IxiePMa3eScOeE3Rr3DORkHqfaHglg-Z3svRqS7p7SlSGsAkHBfODM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XpoAC9kAkDRrywakoZbkwkjqCF2bO1cy279l1zA_ung&oe=6A2D70F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZlWb-o0oAcQ7kNvwGknF8U&_nc_oc=Adr2FqcWx4uFUEgPbgdRtGviCeKxRVrlz3ut4BH2pXzy1YkCNTVBJ7WpzwhGoMDqL58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eu1ExvyWqPI3Ab7wdeCzj6Lw2y2UJM5f9y03fVCu1mA&oe=6A2D76E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
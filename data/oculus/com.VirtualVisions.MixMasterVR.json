U-cQ7kNvwEQ9eO9&_nc_oc=AdoGZqi1CxEkh5Vuhd5nH_X5J93dmVGlKqEK8lqd9fVfbGcJYo3qDwO8_JkJZmdxcFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vx3v6_tk4PjDwYvg7GptNRY718EKkc3uc3iwYLWeAuQ&oe=69E38890"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTIpFff-ZkEQ7kNvwEZdCEX&_nc_oc=AdrR-M86ICyZE7MO65832mtyK9huwe0f-sK73063sIFFmglqJ4zgAb0RgF1heNSGgX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1a4bATC3MgxYupY4a-Tlq4GIXc4pstzNtwT_QRRJE2Vw&oe=69E38493"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hSzIXefNMQQ7kNvwEH6Sx1&_nc_oc=AdoeGp6qqXYGApy6WC_HPXOrE-GCGLyUovCC3FLVf3di2TAnAYBgWTDhST-I6FhZ2C4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ed6YK-4ONHS30E2m7bORZHhgy7ixKl4XI2_kK0g1mWQ&oe=69E38877"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwt8ekukp7oQ7kNvwGKV-J2&_nc_oc=Adri9jDduKczWrc3FwBrE5RGV1ZIXQpJZg4aBGQYNHu6W9QDIApsN9yenAGp5xC8EZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jdNeyofsgeMD23CTpdeSqBUCyq88F9OgwaBWQxZtziA&oe=69E39CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ow0VCce3CUQ7kNvwE2hNIe&_nc_oc=AdqxYUumW-UuX5VWcIg9ehnesIvA27a_pYyb9MHBzPkGdh_WZH3A0vRbGfFdA-mbVt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lAZbi3atdNpgV5lCwYg970r03Jo6WzIuOoniGCXpmkA&oe=69E36AA9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
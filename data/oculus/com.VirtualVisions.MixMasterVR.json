_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxiyUKPdrCAQ7kNvwFjbKoW&_nc_oc=AdrSL4dMOhHhm8cYnhmnbJqHdgAXAVshkm81r4gihcT8vHIMAthf-j45jtD2T0eUbD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XpNR4TXpwP1DY7dFyzF-cCR6ZMQT4F9CzfxekBP7tWw&oe=6A3BD913"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWGnyLSywYUQ7kNvwFrie-w&_nc_oc=Ado4gkqzIwssH966mg50vUBmDnRKQfNU9-imSlCkCPS-_ayT99W2ZzLmYUs-M2Bipbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3dPNqDkuGqcBZ5ahN9w1ogf2MeEXjvRoYHWQf8sMBlg&oe=6A3BDCF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKn9KahF-3sQ7kNvwH9w4hR&_nc_oc=AdoV0FasQITqWq9vIoRutddiEMyi_yeT3VHuhTLVR4Fu93grw9-JBA_Z1mlvtB5tKw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m2TDxUONa-Ybvmx8P1hm5uyTwU5ntDODaP5U2L5pSAg&oe=6A3BF176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl74cW_ToXAQ7kNvwGJgnvr&_nc_oc=Adp87RRdKiyjNCFdQCLrfXeaqKJ7ov0XU4KIpLSs4xbC2tSHSfeimH-x1iyoqwM_GUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1iRYZ4AOjkJT_vwfWTp6497HKZOodCFhjkqp2S-cp2Q&oe=6A3BF769"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
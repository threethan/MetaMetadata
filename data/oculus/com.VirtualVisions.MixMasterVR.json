3LgQ7kNvwEBWbNk&_nc_oc=Adrkc4o3X3lvRlZES1Xw5SC2nzqahLgUhS8Nw5Kz04bWk-r5LfFKsvsqxx1GmfSOE9U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pq24Ez0HHqqquz4wVSX8Q36yrwbZaeHJMxRJwtgwklg&oe=6A0C6710"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpNv4JkppsoQ7kNvwEOoCzW&_nc_oc=Adqz3pkQsT4FQTocwE_9TG7pd1-MAVCTyLko3cj-4OG5yabhOd-qD4UZ0Y1ZZ2KBObY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yh7nsCEXjHAQU1zAZx6McgEHnR0O4mjisau7bd-AM-Q&oe=6A0C6313"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bOH7rtxfHIQ7kNvwE9A0Pv&_nc_oc=AdrIgUNy2bboc-g2jEEuFcamcqhQWj18eTumtoUnGb3YXZvMXV6cE2cK34rwUCNRpzE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HZoJQ_h8_PU17kPOfE1yAft8CdREyMHCG_2RAT9oaZQ&oe=6A0C66F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upNWlHEymlsQ7kNvwG5hVjj&_nc_oc=AdrG99GLPUNaI6ZL7LVJZl9Vfy8rvOSknZch-qjkqmh9CfSd7zF27n6wUrH3xz94hns&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mu4I_3oH9pf9uNsj5sxF5-SZdj9XWxi2EsXpUWOVC8Q&oe=6A0C7B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3d3eVVvDX0Q7kNvwFwuEuj&_nc_oc=AdqLZOe4dvxm5u5wSp7QI430mv_ziXy8xejPnS2oX2RnWV5y_iYWUgEOsiCASK7vFR4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bO96ma7AExrDbIT1wPKSeVkGJ3Z1CND-vyMs81Is1Kg&oe=6A0C8169"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
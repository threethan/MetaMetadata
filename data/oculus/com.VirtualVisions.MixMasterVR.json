_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTkWwfl4CdgQ7kNvwHFmobJ&_nc_oc=Adrz07nLVBpi3hZB0Sb8fndSeJxNkv4D8RRAE5wjR-73DfVCBygG7gge6Sa9eJFnNuA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3jCDU2HIqSvMMhxzmMc8XdGGTE9adWI5YGkUynodaMA&oe=6ACFB953"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfWOIxqwYeAQ7kNvwFtavrU&_nc_oc=Adpwg8x147rWUThI6zO6HgAs4a8KqPC1ULO_BXYvsxYQZbZKWfjtjI1X6hwI4g1Y4AQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiwFPyqYB4jIynd5TubQRD_PFzxx2qOJdUkt7DZy9WRQ&oe=6ACF84F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oXEqI8NrfIQ7kNvwEvVX6F&_nc_oc=Adp6-5VeS6TGxze6qs8TFTyaoDu638NLUMKNxr42NMn1LRoAXaiZ8_aC7NBO8kqfTVA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpRaNeO-1upxInQOKqoQ9ruA4t1e1xRNiZb_CGlz3b7g&oe=6ACF9976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgXdRIS2N4gQ7kNvwERTh7j&_nc_oc=AdoWPixhfb4t7xvF4B51ig7-1MaG3n-sIcGuu-ZxxhndPANkrkGe35Bcc0Du_eQ2o3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjWBjlP8ihldon3ia1cKfFwNTSkzx2HCUVCxvvYVPaJg&oe=6ACF9F69"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
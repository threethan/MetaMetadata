FnMQ7kNvwF1_sIs&_nc_oc=Adr_8Q-rn1ZYiZ-N5Zi1L7rBJkSce-SodhiQI3DBK46E1_a5h3VBAWPq3el2xn34ES4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eXTpqW-PMCfkAQcDqdZkTgVWLUODHXJvu15Mvknmp7w&oe=6A3E8010"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI7cFfLlwp4Q7kNvwH37zqz&_nc_oc=AdoAgUFSnHCmtA647YuFGLhmQUIugQ-Oq4X8nXPm_c7_KQpGzFF_jq7GSdyvUxXoCGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jpHloP0NBgYhjCqAujxP-zJUA9GDv4bTB1hX-1GcpGQ&oe=6A3E7C13"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWGnyLSywYUQ7kNvwGr9LeM&_nc_oc=Adr_a38bWobPMteOVznXHdlNYz6Z1w5Uo3dGoDqiZcogD_8d6MuOC3dB656y4_cdc5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af870lTRkVjwindHKzpyktWQBWnuuSkrugYj9KF7rDFH5g&oe=6A3E7FF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJMYpDD4EwYQ7kNvwFxbvAK&_nc_oc=AdrWddFoI3UHd90kMsoQXIT_tzXgMXHHNIfhkYofxVjHPiEW2MK-nHe4aLMtrsaCNig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d9AByu0gs5GL8EyDWBc0rxlJa7vfMXty7RKKHQMLBpg&oe=6A3E9476"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zezhvPGxOIQ7kNvwFvIOYn&_nc_oc=AdpsmCe8T4etpVPJlMQhKOLRYr8dTE48EZuoMQZD4U62ISmrGCrQwmjx_B4OUCbnVx0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MmgMUk4sE4OTfqNL48lN_ggW0DVWNSwV1KfMYCqj82Q&oe=6A3E9A69"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
bnoQ7kNvwGMm15J&_nc_oc=AdrZbWjIqCWS2x4QbjJlSK-x0DuodgUHUqB-rM3eoq94crFVAK9-4VP47SZJHS47HO4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33EJ86HTia_w8lZp7IFWjAbvny0QzuKXpn8mbpKC9zyw&oe=69EF6610"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5mxtNgIC_AQ7kNvwHDAUaH&_nc_oc=Adovzsj22zzKVyq-DvMVbgJBvywcoZ-WccYuD88Tlsv4BMPQzw6zA50av6l5y64Rne0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xeqTX3GVW73OMX9jYOxjvD_Vn3inpJoU5TXvsbWHYxA&oe=69EF6213"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBQtNSVYQdYQ7kNvwGhjiUW&_nc_oc=AdpJwCXs1ZLpwc6QZlBXzKSAvs6MSTvJF0paJzn7nf5QMeWXICQd9J1q9X59OQxeEBU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31duaymX7Nr4xnWsqigNu8P5aF39cxDbAjf-tEy1316Q&oe=69EF65F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i9J6g1uHysQ7kNvwGkMIeD&_nc_oc=Adrk3IWYgwO-dVXNN9vcOI1NiYhUlag5bKb-BsMIMQC_ozHmburgimAJJWge3wTfeYM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03hvisGhUmUgWZ2K42wlkW03rj5RyvFCWpsqD8qhlT1w&oe=69EF7A76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzkCSU3NON0Q7kNvwFUnRuP&_nc_oc=AdpVGU5xmNp3uUCegANoLat-QTFrznvTHAqW-QwLz3LdA9WpiPFFCfqOMlovIcQlnkg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sX2w6qfray9qe7K5HkLxAniyKif3oWOKuYoYWju9kig&oe=69EF8069"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
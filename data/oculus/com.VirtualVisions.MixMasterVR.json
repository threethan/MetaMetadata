O-gQ7kNvwGdjWtj&_nc_oc=AdpBzMBTEXz9dzQnkhTEgSr5ZWFuOq4O2hjPKLA2YuHEsZpFnJpV0uLHp3-Uhaofos4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTH9F7j91hTPzzB6fSfgI9zbBvA7Ce-kvBY8Vn623lFQ&oe=6A7B2510"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j8CCcs67f8Q7kNvwF5qeSC&_nc_oc=AdrQntv477rQgcEhiJcqHiXrpQuO9MvMPFO20tguKAPGjSISlBnxEiGNNcEln0ixnPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUkHTYJi3St-EiOUmfgQ0Bton99R5CWeR3fxxQ1FlR_g&oe=6A7B2113"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T7cHYbqf24Q7kNvwH7FAFS&_nc_oc=Ado44L0qSKwLLonZcXzxCHu4SXPRClUdGZcoxACcbc8zYQOxI3GRPcE37i0ubyGh_us&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4VBJlXh1B-nuiIFh6D1OPDZuS8xI2zef1Q6nyqo1YhA&oe=6A7B24F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXaYF28nMdYQ7kNvwGkRCVv&_nc_oc=AdriYJYVEBEEV5HYDzUCbCn9_d-mdj6aosgreJy8MQMKPMw72luqUK-Lwb-lSeeAoig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJtW-lQdlA2xDfAloNtJRfLW2Y4Ka1Y_gRII9cIPKHqw&oe=6A7B3976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkfsriFpX9cQ7kNvwEEurnS&_nc_oc=Adonwv9Q3l6AJohJh-nrvv9zYUM6T-LHMgvWsq-Ktk-nWVAGRdpaav-WEK2bE5vj8H0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOn5Ije7Qgx38yvQ-OuN8hXLwgB1lNOi3e6XGrOz13Zw&oe=6A7B0729"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
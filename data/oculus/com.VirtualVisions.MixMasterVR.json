ohc=z-TUcYSOUYQQ7kNvwE8rp3k&_nc_oc=AdpjNnOxTbGVixjAyzM48CFkR1hmWof5V046iGQxuCzECY5_BsR49rZsgfD9rNN2DHM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHgWui6qoCT2uVqK460iSY86-OqW8hU50yFLbwfU5jnA&oe=6A8D9A10"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0BoAi0Idf0Q7kNvwG_5aQu&_nc_oc=AdpMPNFOjBTM9F4PHMBW71FZhixXnHfUi5ee9gnFZCQF0Cz246JDIW6QCbx4ZS3sRl0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFC5oRAKWLDVy9InSCBxeRUyekFTQ59AbNGGKtumMiBhQ&oe=6A8D9613"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdaKZOFNkFYQ7kNvwE-jpL1&_nc_oc=AdqCZ63z5xuOJM2cHFFWBCqlVjfgo4Q7Y27QvdbnjMg6m421jmsmO-9hj41f8WfdfsQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEERoonKNM9PZCZ_IdyE8rx3-mskSFBarAO1_GBd-r8Mw&oe=6A8D99F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMdJt8rrc1YQ7kNvwG3BPse&_nc_oc=Adp6NJquwYjwqdh1imzwTeGx-YlgTDigBefRRGAylyoUdpih5Hg90OCmA1FAjxPdf4Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDp8o9p6dih1142nqNqcL_XPqY2Ypp5MhvAw8OR-j-TQ&oe=6A8D7636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTOjcrY6YMYQ7kNvwFDLWkY&_nc_oc=Adp71DAc0O-ML9RCMPUc-pYWHmIB6-WMkdxgpohxth9kQbfDDqhmQwWFE_6IRIOHZ0s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHskLkDpQFeA6zJ7wHs3JNjS6J2YELh3guh0xiKEYB3A&oe=6A8D7C29"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
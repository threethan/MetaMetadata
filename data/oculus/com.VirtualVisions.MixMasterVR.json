FMwQ7kNvwE_xx9I&_nc_oc=AdpJMuZ8M11Jo_solretqHI-K353bfz49rXUIN1TRndHTb0Q9TdLyqSsQnEZLj63s8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbFkNQUmQ0Xm1Qz-7-7H-kNLayXV_AYcpP825z4_sQHA&oe=6A490C10"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bEP1QePzKYQ7kNvwEBDzH9&_nc_oc=AdqFUSPnann1R1xxDgvbk_QOObL-GmyZIgq2eKPGMMHGb-N9WyftK8Htj75ICwPox70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIWlfnOTOLWMJUqY7M4KY-jj7sSnlpiqmfmtPIRVCCww&oe=6A490813"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT3KBscZg48Q7kNvwHmVzEO&_nc_oc=AdrDzj1A00ktunc8T6ANQtGH4yQIuz0UpdOoAZId5Uf5bgjpcG6JQ01duPzigfxCXVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaf1S7NlT7ZM3rJTaGsDmSxXdOdB7FVjjKPD7jc1ul-g&oe=6A490BF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W56qgWdPn3sQ7kNvwHt0eo0&_nc_oc=AdqJcNmju4X-E5EKiHeJCJLl1lxg8hI4Nmcqieb0jDq6e138YekjCBUnnv8MQVELGEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX1nSwYLAvKef7yI4BosYMvdBL5SAx7Ig1Ov4gsefKBg&oe=6A492076"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXoz0b1oWjoQ7kNvwH-eGLz&_nc_oc=AdoR_36i9dgU_CKAnzj-CRiz_Vxq6M3BfpEtF-xKM0FGiU_Lfke3msUnJh0mFp0sUBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw3nZ2rC4UUM1LkN1p5YNEyCUEKgOtD2U_7g5dlD9zGg&oe=6A492669"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
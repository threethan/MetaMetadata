_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTLcjeMaJT8Q7kNvwHnqOUR&_nc_oc=Ado3cW2t-AJamQvlLyI04UHGc4UBajKL-85W0VVLBYremUqW-AnBGS8StEz8-Q37V9g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtfduRsysSqUKWn5WVhPnQBpGcT61ejgXwTSeQ61bGXA&oe=6A58DA13"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vu7EKWAGq0Q7kNvwFHMuNy&_nc_oc=AdrDJjb3S2DKdmbMgpqtvjzoF1TIZxeFgfMJ2T3WSRdqanbxro3y7t5UviPozeDWdg0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0e2HlWxdgfIGFCAgPVhAICE97TLEhajev70DjlroFmg&oe=6A58DDF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_bUfK8pirMQ7kNvwEoqaub&_nc_oc=Adq1xsFzH4TZLuklFEOC2Tk42BHrKmH26AotElTzcHN0MRHiVFkyRsnR1RPRbJA6og4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3-qss0Vh0HlOQ6g9wBTTGh7ae0MPMcKlS4GRd68fXLQ&oe=6A58F276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtKc-6-rCpMQ7kNvwHufwa8&_nc_oc=AdpfvHVecq8-fgQXD6OR9y3Vx9vgatdxMLjRN3wIlUFarjDkHKRrjGycgzyi-POyqNQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyqNHecxdgmDJBw-uytWaQRsVbldCXh9DQHv3Bk7OtUQ&oe=6A58F869"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
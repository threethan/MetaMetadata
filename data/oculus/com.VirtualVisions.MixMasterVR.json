U-cQ7kNvwEdb9Fi&_nc_oc=Adqso1Y3sHugXWY8r8g6QImnq_JtVkGYXf_I1LYXss-r27Jhqc7Qov7yIYfKk9Zug68&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qX-Vg5jrlu0g4umO1Wjn1PjEYgJOhMBFFliPGNvtUhQ&oe=69E23710"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTIpFff-ZkEQ7kNvwG0zkCr&_nc_oc=AdpYYu7shCwjmTn1YYaLxThrXyrSGijri7vscGVqJptlagVhzAun1nAuPYuEVnCOf6k&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SdWIVW-URPVCvHTaeTnc0kGbeULt3flfUaiMi0qCelQ&oe=69E23313"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hSzIXefNMQQ7kNvwHcD7oN&_nc_oc=AdpIHT3KfldqOAR17Uhvimrtp2ZV_VoDUa3EQ0OdAp3WxzNUqaUF8VoTUKMceM03uTw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iFOdT3B7SdP-MXHPXl5-b8f6apHamhgLhW2TZe47oIw&oe=69E236F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwt8ekukp7oQ7kNvwGjJ4it&_nc_oc=Adpe_hklGyCU0f_GOYCIW5m89ROVGXhIPX7DpYBMfHtW-eSuht3ZX3Db4To3sp_WYxk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X2ngXOF3QIBKb7oybfIxuM89RwT9vcu913rGsNprRSQ&oe=69E24B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL3bgxY5hl8Q7kNvwFRRR-3&_nc_oc=Adpq8gBWoZByxf6usKKIWueXkqKNmt5Nd3-RMRTEDF7Gb2eIl3JBtsEVtmXQqMI6Zdc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LlSseerIfWaaefVN34IrJLWzQz3Yc1SEAxAEieyJbGw&oe=69E21929"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
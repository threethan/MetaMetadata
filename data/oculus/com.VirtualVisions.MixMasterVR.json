_eIQ7kNvwFLXGDB&_nc_oc=Adq1wKQ6TslIbT9V30hl8OjbSqfku6cJ_7QQWlLqeSa8e5n8LzTdzyS7CXxc6glvcM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SRi3qwrSsBFjs9skPUxTdp3uQHi3Pgt_WYY57v7Ohzg&oe=6A032C90"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMpVnxIiV9AQ7kNvwEQwAb5&_nc_oc=AdreISczSZmp526MHW-DYy5DU8yZdPatnsax7W0ARMFuvisksNZPaYWEHk5AxxIQ9cU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71G6hAo2iUYT7jW2hxgwwQD0pl7ffUDoMKy1_qCBX0Nw&oe=6A032893"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kyiF1y5uIEQ7kNvwFuT_O1&_nc_oc=Adp0Vzs6kMDgJX_sOado7LnUwBmOjqMZVUuNHLdOciCJaSojJq3TAxQLPkrHeCFkx9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bIGtH4MNLIzfESRwN6FzUThnxrqlujHDectav_yiquw&oe=6A032C77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR6R85hpGFsQ7kNvwF0NYzA&_nc_oc=Adow2KhYNsT3-dj_WTaBXlXZtmgUWOgYnhfcTngHuwASn2PEaY12W4sNQW_n_oDWcKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RLeDwgsjJdGuQOwZcB4FwdNwFj_6wlm8C8_huZTlH_Q&oe=6A0340F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smF8hByW0GMQ7kNvwFxqm4S&_nc_oc=AdoEusIINFt-1IFb_ASCHp13i7u_BiISzXHpkTxASUlL9vMgu96yJtcUop9IrMN4IkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-V9PruYLPMryrzXU4BVtkgG6nCCGEm4oDX0JcM62ZqA&oe=6A0346E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
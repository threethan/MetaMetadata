_4YQ7kNvwFFj1q_&_nc_oc=AdoicCE6_dEiZdxL-ppH3XpUg1tXAuh3dDWah-ICSktSlkbe6y7TUAWXHOmmK0v8csQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAr7xTAR9s4QoPrJcJMr4CNFZLUTd2FptCPYFnB89taQ&oe=6AA2B210"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asOU9-MOpbgQ7kNvwH-pOIU&_nc_oc=AdoOu-STBIo6lc9LPSe8p7jOC_fg3kXdEJovHRIAmIfIjP9Tzx-wioHCxCv6-ZhASSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8LYyD9pPfC7i9YFmhWVRjthKIWUg9cxWorT11cO183g&oe=6AA2AE13"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDVGC5lLo9QQ7kNvwE4K0ts&_nc_oc=Ado7PkUqCDs-KdtHtVeVdVFKDXhtzjeEXsTOB2acUeS7628h-YJGaCeD11Q_4GeUQKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ2VNGmuARnHkE-0pk6smdLNLiToqspKFLqmeppOTLCQ&oe=6AA2B1F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59zlMRDEcGIQ7kNvwH3rdHZ&_nc_oc=AdpCIIQHN8GOepkrBLR2NUe_Dw1P8RHmQ1xV2fCgM7qSEJGZNPzuD2aHVoYY-rAw_ns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrAxHbX9x-pMEdow0fdd6nOWVV49lVAS7eos0b7l0omg&oe=6AA2C676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53qIGtGnP6wQ7kNvwGDA3_o&_nc_oc=AdqU1bmoxO_Nd8DkHR1DP_Tx1emguqU34EwdZVeaoKeZwoKVH0rZfOo4lT9Hhiav0iA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzKL1tTweipg_JyuUfs3ZOQNYcfL021KwwiK4gp4FGZw&oe=6AA2CC69"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
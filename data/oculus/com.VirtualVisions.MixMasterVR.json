IboQ7kNvwEOI89h&_nc_oc=Adrh1DQbsDrE8yJ4EBeueGc-ptVyFw2dQH0-VPm93cnLAEUQdUZLIRwmBKqE3L9FqKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90HE5aPJsVzzaYcxqTvDO7eZVAYCe6frSop059WTT-QA&oe=6A296810"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iX9UUBEyDrgQ7kNvwGRnP9Z&_nc_oc=AdqSWAzNq5LcF1fbwJOs1_rhqZ_fx6_C-4gR0TVP2BugVhyCuxbQtndFml6ql_wwVJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cwAPb5Zf-5KISEkxLh6vImXHOoCJrtZQ5-ShTfwIdjQ&oe=6A296413"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX06txOrdkMQ7kNvwF1o7Sl&_nc_oc=AdqHZP0TenCjaogG3gpBi7eLDybxjLYdIiBUVMqfxlFgNpSIPfvK2U-n2LeXBWB6Y5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j1zyehPtiB-pDikSBrqp0kzAs3xXLI95Kzi1yV8sNnA&oe=6A2967F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Bm_P9ctSdkQ7kNvwHFcRIC&_nc_oc=AdqoXAc5WgKpzXHt2k8LFi1_73fneAEACiumZcVPQXnpTsoRChz_BeuwvbWbuvi-cBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SZQv_JGsUiEXIZxXwzVPseE10VNCNJ2RpEsvbdr-_jA&oe=6A297C76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9g2oQlVL8wQ7kNvwHW9iHF&_nc_oc=Adq_n0gtH3PVcT4Yi0TreNWYvOsmkAM-3QgJG30KAJAO1UeIAbB4tWhCBJ-OKX2zjwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82zQxCF9pxvC_GfSPbP65-LepZ4uKJ30NkfJZz6ijy5w&oe=6A298269"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
UYQQ7kNvwGmmZKV&_nc_oc=AdpGt3ANZ_02iLpgG_oiMgELnx1oHIOK6wW8RZQbT0ZYX8OHhYBFSjnotB7OCmgTaU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb2AF6fmdThScM7CH6Ypr74LDLt_r7g1C3_ipFQPoPYA&oe=6A8C4890"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0BoAi0Idf0Q7kNvwE07qXy&_nc_oc=AdpBLp-0mKmu3XVErbc5h0TuTw3-MSr8Gb5xARTNCKJ_IqS_KpGSHzhoqCH_zBro3JE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI97emmrku5GEJ_XipQc0ltPfv_CMF7a4FSI77hHpzAQ&oe=6A8C4493"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdaKZOFNkFYQ7kNvwF5A92y&_nc_oc=AdqfGepdZcTcSGYZOLjN13TcSk953svktGu0az5rusaSW8Ume4mQ-9Ignvq22Ep2M7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu3y5KSI1wlRSGCXtG7Z2f-m3exEvaFHCGN-qAAqyJYA&oe=6A8C4877"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMdJt8rrc1YQ7kNvwEDghD0&_nc_oc=AdpgTnoUjGvcagc4R0DZ59eco_OpM2b9naH-9eGWPuPTfIbbDyGZGUmpxEgOhWN6kxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIshQh-ljnhcxnQnkXA6rKvloOeKmj3Dvp-wwMWyrDxg&oe=6A8C24B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lQh9wlVJIEQ7kNvwHVxh6S&_nc_oc=AdokBzQLvS6zV1c3cFgVPj1pWSVq98-VwcreHRn-vlv8Mdhxvs7zaLCOlkkLb8VBlQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5_UQ2juBIc5yldtQvE5HHN4wclC-zjhY54rFdfkgRgA&oe=6A8C2AA9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
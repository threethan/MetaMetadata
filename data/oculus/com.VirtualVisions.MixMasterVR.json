_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5mxtNgIC_AQ7kNvwH8Df1g&_nc_oc=Adqelzsv_dSPrOhp_QSTbhTuhfccr1e8LHpdOdeZKJbmqH0E-uO4oLHkH7x3WmiTiig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mMqj3Tmetkubp_m7AhAqf5RclYeOyP_UHzbI_F8fU4Q&oe=69EE1093"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBQtNSVYQdYQ7kNvwEVVAG9&_nc_oc=AdoiK8rXdqFGEDX1iDYhyDsJsqMQctuHfHJTs-thuv00fCT_8Wb0SOk9-4yekOegU-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07mdhZxdSJlXbvsVAQdqbp_FFm-Yq4-uZxfVZ3OF_W_w&oe=69EE1477"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i9J6g1uHysQ7kNvwEPQRCc&_nc_oc=Adq42tUUTo3EqgL_gxD14x8OtQcdqthm4IDfvS3zp0mlMxTEPHxTC7QKpcpRPElRc-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17qhb4etxkbZj60_dk5qe0ZJ-El9fBXSgOLWrPvFYUsw&oe=69EDF0B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHFvE8aT5UkQ7kNvwGv-rpQ&_nc_oc=Adqc7-FqJgBMgKYSEcrEAfeHRKEPbPF4yh5DrYXdsr8i27fd-4yWhyLLdqiI30z5_rI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ee5TChPHHxuGfZzKmJka7zyANLTghZrHiND9JxAhNzA&oe=69EDF6A9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
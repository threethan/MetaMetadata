0MMQ7kNvwFvTnUc&_nc_oc=AdpLAqBIFIkYd_0LHhcKgduG-BauKi7hcCl6pdxEN4QIMboN7IuNKJN3qhz-qZB226I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgVl35INnCjtecuPu1mudn2XOZQkRRs5dRifIDgsA9gQ&oe=6A7F1990"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYB8vRmFe1MQ7kNvwGs3w5r&_nc_oc=Adq3-5CqC6fNBPDxkRkEeEw_uE7jJRwkp54PFEOcoc0CiMMcDu_COmsVSopSpYFYwoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXL4qo0WrIj4qgW3jItOR_T3zgIPDMWFxDSNFIxLXZHg&oe=6A7F1593"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEiW3dnek3UQ7kNvwGcPMum&_nc_oc=AdqjZogXsMFIrzHxncNtVdPsiSHgBWsSZZKxsvmCPg9sqzs-EGP2i7k_Foyck41Jc_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMleQfc040LGFy8L0ePOHdS_ndeqEqzeRvLsCRGatIdA&oe=6A7F1977"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBhA7Q8eHsgQ7kNvwFo9S-M&_nc_oc=AdpyR4R5itdaEv61gaEHIe7rNkzNnMDkVz70gS_gQn-gAO7OMGO8UYV4RqI8hJYb5so&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlngyrFFPjwVYFRq2Saa5Uv5yZ9rlMwbvss5svp3rzow&oe=6A7EF5B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOwmv3uEiz0Q7kNvwEO9bVE&_nc_oc=AdofBKSZXSqGbulzH_uii_x-q331sMhoRSU5OxBmvEGxibvpwq_d-TmjfI1BsM0lvIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmn7UBDsLaZgxNtANIdlB1b-JleoU9PeoBoO5kuwRhbQ&oe=6A7EFBA9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
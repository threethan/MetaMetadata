_zEQ7kNvwEOdBUs&_nc_oc=Adp-jLEutu1M1xOBi8NXcrn1NvUZoXjAneXHesnyt3t7yOtqiebV_iq15HHvVWo1PQg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAsduwaTwqCbgpiak9JvKRJC6OFAnoKcq-3yw5DPi0_g&oe=6A830E10"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAdm4_iH9_4Q7kNvwFDziSQ&_nc_oc=AdoBIcjmFbp7o4Q0E4zo_uMQMFYHSg5J_VJWf2b811IdzULdfdw_XeCIBggeQzMkKY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHluh8fPGkcF209rN8CdrGHOSA7-xASZFSn6R22PN6NBQ&oe=6A830A13"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6-rRFAKeFQQ7kNvwFF7AsZ&_nc_oc=AdrlvA9s7KDDBNFnFKmT59oOqDeSiKGSzTxu2-5ohx8E4IgAGpkX2NPIFw1bPVht_lc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUU--pD0o9g_E8v9zu1x63-yzBy687a3FfzqDph_l_0A&oe=6A830DF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxc6x4WRoE4Q7kNvwHRtJqb&_nc_oc=AdrvMqpSU5YNsLys6U4ej7K7Fe4wj5PWUgo_ye2vt8WHzwpboHLPkoHZrXtZRA4pUVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-nwPBo0rIKsTldijw4Gz8qkWiOc0-_wWAyFuLkIcA_A&oe=6A82EA36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkBU-7S33HwQ7kNvwFedNLe&_nc_oc=Adpt-uv7lcz-adbOeiy58iamwT5tWcHJqAGc8Gtzg4UVC_CmvDve67zXHk249ZBY8yU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrDF61D06h4MpXvl7BJ5hA1Wl5378o3M4pohqrIEnd4w&oe=6A82F029"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
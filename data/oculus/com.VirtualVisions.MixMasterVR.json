d9QQ7kNvwHJBC1Z&_nc_oc=Ado79xG4pFL8EHBr5JO3q9YPx5FZqEJvUZZvw8LwmxeWnrVZISq44efTxARQc1SMH-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD3pYtWEvVDy7DJij9LjZi9v9M6aNCiFmxTLiX5zBGJw&oe=6AE9E310"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdIn89C-IvkQ7kNvwGirjSD&_nc_oc=Adr2jBRigpJRvBP37TQnImHhIgiPYsrcA_7XQHfrpePx4OUyV6shmmxtzHe2IDnzkyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCt8T5eSP1ZEcU4Glxp_mBuXxxj_ZMbGe6wS6eZdbMkQ&oe=6AE9DF13"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90o5vLutmwkQ7kNvwGRY59a&_nc_oc=Adr_GPqOQuL0MNxOR10uV6qZuQ72ev7VyikhIKyIaLdhhnN-osSEbHsQxCCCf0zrPqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScqiAZett4pkm7QO0_IfInv0kLGpmg0FMqVwytaSJdJA&oe=6AE9E2F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ethXUcsZCG0Q7kNvwHMTJLo&_nc_oc=AdpoCG9vG1MQNsf594u275fWZXYKMkK8Sk-ypDU16GUguwS9bnwGaI9ibwqhxttK8XY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe_WH09OiXESgnvG8Ik4KhjwIB2b9f0ETQKm4dkW9vbA&oe=6AE9F776"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-Sb7eUKs_4Q7kNvwGpqGbO&_nc_oc=AdpWbDqqzaPyvxGpT-BMFwI2TC3DPN_pGuUbNk4Rme7H0VsP7rGvopXWFrnofs7zD0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu-caikGICyIcy1x3l6FQSOKIQsHBcpvK--Nij8s1OJQ&oe=6AE9FD69"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
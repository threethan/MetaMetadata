IWoQ7kNvwEpC0ci&_nc_oc=AdpIcUkNGN5Oai-bTk_YNINK1N7lqDKvhYT2fGjnK0WgerYp8LvnBQRW5bOUOj73JQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjPIXyzkoPuAp6BRjeNGIR9GnMDw9XuW0EM1wHqbr_GQ&oe=6AF74A50"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLEkyCBV63IQ7kNvwEL9eu0&_nc_oc=AdoWOPElGzot6t9KYAjInapA17KHDNPKwL3rRmVpu1wN5k_ChtzT9Oi1upcsSvdZNZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrUHW4plfyCvw1-W3WRpo-M9gV2OqfypjLt8FmoUBsFg&oe=6AF74653"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WihR4eAxf-8Q7kNvwHkKY55&_nc_oc=AdrOXL8o5OdnP2cNm88VzIOWE2kXnbnH6atM_iBb-lioypQMAYtO6_nhqIR-wKMWZyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkg5_PcMylVUII4gDqqDGk739iX_5HFRCdsLOagkjtWg&oe=6AF74A37"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v-DCyL1vCcQ7kNvwE2dzzX&_nc_oc=Adpx-ymyhue2KujdHDq02yD6upixTgdj72cnpl4iU6-9RW4orddFxubKHCYo56tqPAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsbmlppC5NXkfAixaVdtdhO2VlaMHXrRfkZR9TB45UMw&oe=6AF72676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ7hzUhmOPQQ7kNvwFvvhBm&_nc_oc=Ado281ZOJO4Z1Z2R51ZF0z9ztxBI10ZpqoNpifzVAyqYHG5Ghi0hPwOKNq9Lv3AlflA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwMe25K82P-1L-pjVXtUh5fw-QjvNrK3_3H2oyVWaAJw&oe=6AF72C69"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
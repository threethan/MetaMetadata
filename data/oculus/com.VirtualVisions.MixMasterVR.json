3NAQ7kNvwFFlP-g&_nc_oc=AdpWWcznN9_5fvnP7kR1iIHTgFtThF3OZOCDaxLHoxWN7zyK8Ue5dIOmYGRaRkzRE1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDxmkLQnjfB08usxXTnHkiXqD3MZZL2I5JIERuZL1Lfg&oe=6A9C1A90"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amMCdUGPFXkQ7kNvwHHFm-e&_nc_oc=AdrehcTXEdavt-S_TdlTufKOZ-KeZ_j2pQPWsvODd4gYlVtU9OIDn3zg1fO5-DHHyC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNcfELttb_nL3RTuNVi5VrVLtsRLHlKACwo1x6thcsOg&oe=6A9C1693"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dqb6SIfxv0QQ7kNvwHVazfu&_nc_oc=Ado3iVQknSyD923hCMCd8YGQRkd7foXyjKA3iva4aM8q6yiQSaFpGcEXqZwF_S-YtZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmziwkrx9pJXaW35aGSQOzW-5_9eH9Rb9jY-5QPic5qA&oe=6A9C1A77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKJL8f8nd60Q7kNvwHIQVzo&_nc_oc=AdoQ9yI2_4DDVfXq-eIqXMaeZlcEndaF_OELYciJwaeaCAtu_l1n1Hdht6aKyGrRQkQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2rZ5z8lOAjApGg3Dt_eE2p0CxGQjiuElubUt2BIPdBA&oe=6A9C2EF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMk562lRj40Q7kNvwH8mMKH&_nc_oc=AdrOWrs13myCtPnjDB6m1A6bc5PonmhZkWTr__0rw4e_csCGvTkk7LqrWGtDNOIgphw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnjtXjjpKeseCASYSKbqrJoU-nnqDzR0UuB-kcvUffPw&oe=6A9C34E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
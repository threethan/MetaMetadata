nqIQ7kNvwHyzRy5&_nc_oc=AdqxiupMf5cAeTvqKqjPlgotmn0OwGyBpRFdEmR9axY1cK16gYrlVdwjlZ3lKYnXExg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MPAxeTqrTeEZwP2O8ZstZHNbczIcVsemUuwCa7Ywrbw&oe=69D3B690"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhUQzaGlvkYQ7kNvwEY95EF&_nc_oc=AdrFleSZg36sqbZJv9smLMsQMQqdeHH3pHuPHLzlMNIck4TfC5Yst4rw9x7chLUCFlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fotMDm_Ti61KsaNtEvtEuSdYZzzZBIO_aAG-XOQNOEg&oe=69D3B293"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h19Hrp-FN-kQ7kNvwFIcbev&_nc_oc=AdqPxy3-HMlsSz5jsAqEf0q5vhiZbuEnoeOD7C-8_5i-zyWaE6luuAhOm_WNgiP04eU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XUhcHH68874wOfexuZPKamrsXZTsPeyQYDta0hK7NCA&oe=69D3B677"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee_NfgZBmpgQ7kNvwHZ9Hg_&_nc_oc=Adq-vZcGmBZhglttqmNUDTrxwmOMvJ7o53Z5H6LkAl_oayBcMpKOqM7NZzGlIHo81Lo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RFYEr3eF3tlcaZ7IQXA4E_c_mPvIQ4GuLUkk_TFSvgA&oe=69D392B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIdS7DTzWYQQ7kNvwHi45Qr&_nc_oc=AdqWd8UIY4AmM2NFsyUYaMiuwNaxPluCg2wpFWcw5HoEZnOP2yMWNmd_sQ3l-sFSYOw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yTENAPrOL4FtqoKnWf1mKHqUBn4k2nN6onRLpR7vzTQ&oe=69D398A9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
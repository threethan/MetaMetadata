_ohc=0_zweT7-bs4Q7kNvwGRlE1y&_nc_oc=AdqRjdXOQSh-ZvYHhOhp3MnWfLbHHkVCu0eZ1R70FaM7A5QCEc5WmkY58p-n202-WSk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nVeTLSsUifZKodEsV1giaxfxB1-Ovkhqthq9LurXcmQ&oe=6A11AD10"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7jtZ9SoYYcQ7kNvwG6mfb3&_nc_oc=AdoZAp0PwAF2rQYe2Q0fxbXoMKFdfdqu9pFULwpjcqUcoJR_Pv0OOJpmak92hFnlxck&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69d984wiNtIBAuVO8dE6ccnFFVk94xVA78OplxElrTRg&oe=6A11A913"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ya8KeX6tYN8Q7kNvwGQUHRB&_nc_oc=AdqI6qHQGfSbqE2kfbgObMbaKJUClvE70GVn4cIyEGz-gEwRwnACmFhXAIwi99tm0pI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79YJOhbXInJZwwijxE4obHMSvdslgNUbeGcjbiuSF4hg&oe=6A11ACF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkXI0uPTyBAQ7kNvwENRgDa&_nc_oc=AdoFoHx3dy_E2k0D-SIed9YFm8N1PkeYsYDVPmG1UuW5NmEhpeHD4WiAuHT4qX6iyL4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w-ITNQc39Gi3Rd_iMZO1r2iBide-wFzA5soBnxV9WZA&oe=6A11C176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPbw0B2km2YQ7kNvwHMQmaR&_nc_oc=AdqJdtzL4EUG5rLtMtgVgYXz0bh2bOcaW8Wddd4dO5GNs1aXn-5UhLSYa9Z35a_yPLc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GZQwTO4PyLvNL91vCnuX4gbBCNTKNwY-QIGycJyTPtw&oe=6A11C769"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
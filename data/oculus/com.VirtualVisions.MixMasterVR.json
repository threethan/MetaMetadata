d9QQ7kNvwHTpBHl&_nc_oc=AdprqpcmwsCxxXVfmc4H0hgawq7YC05ANHL7bGqWu7Jmk4W8qadF2VlNA0wEqfn9x_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG5Xo7xX9vDapITV8TCSswEBIWgEgPFm0f8l9UPDaufA&oe=6AEB3490"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCF2qzwSxlEQ7kNvwHfcQMT&_nc_oc=AdqBMjR3YTH6FPHLHec3VNwFwmZ6bOrB_LzWQG_-umzZgRR-bb8Ovfqoh2Ct44Zw4gc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIcRTb_aVpATKFYRRgQ701jVHReTCUWqUtidHaZido8g&oe=6AEB3093"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90o5vLutmwkQ7kNvwHocju9&_nc_oc=AdpDVDDApgsKj0P8D5cYzPrHQrTKgrMC1A3cpSeNl27IklIGSa6ePZpAFxwCfuT_Jmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA6hHjuFWwui5csA6sDvB4vNjVuFHXxGxoDtpwJEubpg&oe=6AEB3477"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRs6N-i-zyMQ7kNvwHZkrd5&_nc_oc=AdrTe65pC8EWXWndjEe3rY4NkuUjnRFueJO09mD0ZetErJwyxTIzA6Up6-cYGU7hd7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh9EYRNTTMhAQ5j5Ot5T38XQpTNPjniciyiJiedWegUQ&oe=6AEB48F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-Sb7eUKs_4Q7kNvwEU2igG&_nc_oc=AdrB7301GdFt7Dk9Sf9Vy4PPN1hRB3x7r9WJwZDrewxK4klNOt4iJGRvfbyvy8niOoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT748a1656pcefXbR7ViImuh3wUjSx-HtdJE7dwnge6A&oe=6AEB4EE9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
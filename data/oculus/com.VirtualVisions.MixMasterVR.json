hewQ7kNvwG0DhWH&_nc_oc=AdorXX4NyWHzpt9hdK1vRNKNN6uROknNMc0mpCUowenG29L8_a3-56rWUiPMPxMvvFQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVu51kvtDViM-m5OLXBrdJBwmdMe54XYKcqUFzE4GZpA&oe=6A885410"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ADmIXgWpFYQ7kNvwHQaxFs&_nc_oc=AdpCpsFxNcsNf95hJXJ-th6EWpYyNxdbzeF3gtxW4u6J6JOcRUoTWqJ-3n5ZjZtZ4DE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElxlwBt_QM9lyJqs0XJvsh3sYP8ZrQEfj_CT8aGfWO9w&oe=6A885013"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB63b3F-enAQ7kNvwF__Cit&_nc_oc=Adpu-EqRIAZyekg5TahwCWb-eEnCLsYQ-aIu3FjfGziksyqbpcrw8rCakJu1IJNIDrk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiFqymVGxNefMppbTBACN87TBPLAEGaMybnwXUPPU8Bw&oe=6A8853F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ohi1Sv8jwBkQ7kNvwF92teU&_nc_oc=AdrcG1-o4IBS1Pgh0Gd1D_YF_QuO525WIjKsXAp73FY_UBfURiMji4aoshNjqkLsDKo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzhzTOSlSdmb_Si7KL7f3ycwRPrXUVI2sPDBJ8lcfYoQ&oe=6A883036"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkc34VMFRcYQ7kNvwF7axvG&_nc_oc=Adqbfbj0okqCtkyFkMFxY_NO5_WIaLLvkfLI-SBjVVTl4DTYDB7AHuitFC1s2oF_Nys&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc7mVy9Qcl4e2hT9LX0kVtjH3pthlYRmSw-2hH79UvsA&oe=6A883629"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
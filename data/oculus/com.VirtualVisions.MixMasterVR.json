oL8Q7kNvwFFIVeQ&_nc_oc=Adq_eu-U4adL499XUbg3r1EFiD6iIbIGJCH172PnwnJaQPJUxWsIZrQ-a72iLzgKqmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp_IYeDYOA_xjd7nmnNv84-P5zpx-FalSruiRoff54Zg&oe=6AAA9B10"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDwETPRyMrcQ7kNvwFSm6ZN&_nc_oc=AdoQrayEYOuAfxh3C5BWk-yzBr0n-t-HCi-MNF9SBIkLSEocsHaDfLBmC4W2G5yDZwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6a65On_ejHIMKNcXb5Y1ZHJzT_SRB6ue_X7kY51blfA&oe=6AAA9713"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZTM-nTQDckQ7kNvwFmo0VT&_nc_oc=AdpbJQzeJ_P8YklpkZ3l5XO2GfC4fEbmHrMz3VeHgtatfRVem6V09USTwt5-0rHYBTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOjfvSXDKPbuTaKe7MYSJflHkWLByEcMFTE-UkZfD0dw&oe=6AAA9AF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxB9C34foM0Q7kNvwF92fvO&_nc_oc=AdqOukXFzooD95paHOxT2aq_2Pplubm3l7rpoFsAjtGMdAfIc1yvkT0c0-UPjwTLf4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv4TywsTUD_T0oXXqIpIP2g_aSl3Jv5UqbNPwiiDAeoA&oe=6AAAAF76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaYTBb6GG5wQ7kNvwGz3HPe&_nc_oc=Adpmhq76k4afy7083BzQap07iBmNWPe2STpHE6PRkyiatbK6HXbAfzICUXL_nN3Ocug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaVmuCMlj1W30dNfoY7mq9vuR1ywuD2CeNyx1rO6NCAw&oe=6AAAB569"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
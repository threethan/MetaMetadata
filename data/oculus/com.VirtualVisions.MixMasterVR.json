OMQQ7kNvwFLbsBf&_nc_oc=AdoacPwBFh3EXTnYX1TPBXjMpNs-H3Ve7fVnMNJd89wBWUP4tkXolCOb4zn2TttTDRs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3r3x1Q9i4GrsEPPAl2W8pV3sEa56B387JOzBpMRwv8pQ&oe=69F4AC10"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fix3pRICYusQ7kNvwGjMsVt&_nc_oc=AdorMmSGEiCVO2Fc-DPCSb1BNFQyWnpdl-BwIflsXcK0JJnqAN4KUh1tqUOx1E6sd_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Wdzq8J62Sj3sJ-H42PP1Aor7hghsquOEDyImm_LbDIw&oe=69F4A813"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jccXQNroIBMQ7kNvwG1BfJr&_nc_oc=Adqms1xqgdDL2287zSOR_dGgefSyKwiE2nMkZU1zU6vg__WSZ6cKJofJhUqKBGLCs7A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ThpMdQFPM7o6sGEpdZ3QPuOhZu5nEbaxr3MnGCIoyvQ&oe=69F4ABF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3w14JgR4OgUQ7kNvwGRchAd&_nc_oc=AdqqMvJVkjsaMeBAesihbif8pAAhWXgsPlzPxwyuBguGvkzwoyZ4PN49XCDXucDgg1s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BhF67fOv9uFsGiV9PIl3nLfhK9gutMQPatEM3K-d0tw&oe=69F4C076"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLomX7NXM0QQ7kNvwErfk_a&_nc_oc=AdqYCumdnFHNVVg7tgczTJS6Pe9tn5AMun26H6ATjoc2MB77hrsfuPygNnA8kb5-MQE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PRlhG_MJuG4BDzKUrS9u7n8BVEAUMtZ572uJnhXPtgA&oe=69F4C669"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
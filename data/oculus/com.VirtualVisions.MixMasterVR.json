7nQQ7kNvwGLsQwp&_nc_oc=AdoZm-VKZw5nkfvrg1d8-zn8D5RMkKWw6l4rzB6UskkqsVehK9UwmofDrlNvZ4T49Fg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR--GRLtOoIBHXf6hDgQhw8pYSGGETQx9qM_Fyxxm6OQ&oe=6AA6A690"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMt1rK-Xv6YQ7kNvwE9PxaZ&_nc_oc=AdqP8x-CuoiD5IEbvxYiMgRJxKdvNmqbVz0Xf-sFW11tPPhLvvdHyD5-V59UlgvUhcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXmnLdrABZRFDBwVhuEbiUePwEAeub7ysGNP5z0L_5uw&oe=6AA6A293"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpfe8s9g4kMQ7kNvwFW_BFd&_nc_oc=AdqtbfNg7sSrX5k80Ra1dSjEgwU795UpP-wgZNXQP3PbpqMG6EfjQUq8PRWz9t6Wn6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHaUgNTmiTdjLwAui_u9UzsPKoaYpuZCyeJKNDT3RU0w&oe=6AA6A677"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQYrhIgWlxwQ7kNvwHa1osx&_nc_oc=AdqBLnMyTZ8X1XLOy0dwaicUJQuDVlGLolxnzrVxUqdbqL9emCyoFrICU8R4xPuRDqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkbGjMMyNCotONiMbmFL0qp2aWOfJQL-JMtFIiKPGW_w&oe=6AA6BAF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGHL9X_2C5oQ7kNvwG1oh4U&_nc_oc=AdqdMve2B0u5Gi9t-L8uiLZvXscaHDPfV-EcBMl0NfRYJprx6hii0bGsugenFmnlSBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEEPY_Cb4B4RsW20Rvp7jF5kLlqH32Uj6ZxkFYq1k9jw&oe=6AA6C0E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
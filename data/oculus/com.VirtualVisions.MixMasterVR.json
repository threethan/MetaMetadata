MPgQ7kNvwFalc5Q&_nc_oc=Adpo1mIO5uj5PCKRgGDVbqu_wlkLvxSy7A1f5iry7m7mPqwpHisdTVpHs5daEwSqsDY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaEoturLZs1Zo6XrnJ4JtbcKR0lm4VbwX3bBl2oxqQRQ&oe=6AC8ED90"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCk3ZaSviHEQ7kNvwEx9a02&_nc_oc=AdqTBce2wcK4SlHvE65xGdD-KaD6i1HdVoEUMY9rVCtrFdzNYyJuWqE3gy2NK5e8kuM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9813bIMN4yDSTrnHLVom-ODTeo7RjnBnyjA24BeHU4g&oe=6AC8E993"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjl2fQvHTd8Q7kNvwHPZTnX&_nc_oc=Adq7Vz84elgWj6sO60tJ88c6lS4UGan77K_yasKUq8vO_B26a0KcZHUrFTbec_D4460&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJoupj4KATcwB6_TxFf0GcSzz50Sh8r7NaNWgj0oUvfQ&oe=6AC8ED77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd69zRblmnMQ7kNvwHz15SF&_nc_oc=AdoeVewHqkklwfO4NUIulLJ710j2Np0TDBBwknchZz-_HZ-ynP_2FePNvYglzZ2VJcE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL_m6nORx60OprJ8BaDQ2UKwywYgUsnlc9l_2fMGsOpw&oe=6AC901F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfEafgSAAu0Q7kNvwG2T6po&_nc_oc=AdpZxxqTxf-Y_bk7AvPbuVi2E1gyCAfOQWJB7r4dwaP6Qsv1XFsBc7zyuPzYDEzCasI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2nb7jZmmiuW4TxrxwhOiNscC62dY0bFLbSJzv9fqAEA&oe=6AC907E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
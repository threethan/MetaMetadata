YD0Q7kNvwEkpgjr&_nc_oc=Adqp_tskE0mohZc8EMM0Hdi0D-1h01wKQZAyYO6bH7G88IhK-Mv64vZFw9ELs8iBScM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-nKxw4JG12qD4ww4bsXzDSXOetKT6QAvQrcfqCrFezA&oe=6A974510"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVsX5PozIU8Q7kNvwGvV7pz&_nc_oc=Adq-fsdS-ovC_dgP2-VYSeEJAc7q9k5hznoGOU0B3usUzLsUxs6BJA3PCuUs8X3zoYM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjeeGSQ3OU_a5NZMzihFNTnK4mPuoLMEquvsJQ9o2TqQ&oe=6A974113"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mn0AK8eFPWYQ7kNvwH2qsLM&_nc_oc=AdqTaezCq7Zv7S2ax27hAWhQbd2rncPWKioykWQGhKtfE8fLad8L5mqaPF-2tIQvRdA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnqzPoqQKtCUM3Zfn5ZhYnu1QKT70beahF3NHLzQSKIA&oe=6A9744F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rZBd1FWJO8Q7kNvwE9hEtQ&_nc_oc=AdoSth4HillPFqYIqaiTEXGvX2OWqO-Q3yaDcnsvIh30TOsZc_wgJLD8V6NVuOtsjwQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKhroCK0R5cOFGGUeg_R3GQQS2-BhDjfeeVCqdUu27Rg&oe=6A972136"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOkP-gSDfiEQ7kNvwHMnBd7&_nc_oc=AdrssEpaJSvaczH-KRfaOYh4jcxXTI_vGKy62BP2XSRyflCoAjLzldzVPt0Jfns3SYM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc7TFXndcsfKlPpsc1bwCriNkSPp4kU9m415FI_B2bNw&oe=6A972729"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
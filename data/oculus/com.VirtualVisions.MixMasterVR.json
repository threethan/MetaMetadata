bBUQ7kNvwGCqsIG&_nc_oc=AdqCXYs2cGc6o25WpgeQb2rsoawwcbpNQBgIt3at5kDNAZhVEMHUlfCCSZSTw63UWRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3818p3-lZ3yWzOajiZHHMTRBsKQrwA7CdRtkvjfGHTg&oe=6A427490"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLPBVDbZgTEQ7kNvwGBB86J&_nc_oc=Adp4VnwYwPwFHa9f5AjrhenURBIp-mh11fSlWVjv7_-n6MpijUMtJk2GhKG5PrE0PZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0Ek4UnNc-DMjDr7K8Vzpnks4Sy0-KWj3SnlEj4N1n2w&oe=6A427093"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sq_8aomenDAQ7kNvwFAAGgw&_nc_oc=Adqcesje-vvXTbnN69EHoQfHGof9-_uKmI98kTclU9Ax0tSc87NKtRV4JbIKXoWRfVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j3ofHLkxPKj_znAn9c77rJ_LEZSmNYOsq4fJSARTk2A&oe=6A427477"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwVmmw5EKp4Q7kNvwFo_GSI&_nc_oc=Adr3wHdOGwY7V3DrhUwl29jQyMtHkRZd7nr-sm5NZW8_kL-2f-CudghVTXYd6OVsmio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gWmXQb87qFjzfaFrvSDFO9X_Zd1jVlD6-25qOHSwBdA&oe=6A4288F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKS_16OqrUMQ7kNvwFr8G-J&_nc_oc=AdqElp6oTa6dMeBf6eXhqCLA1ge34SUSg_-NdvVfZWGl7REtu0aXWtxtfAuyf-kbhDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91hadYlYDPNwxPGwN37UtwL7JZanv1jGGA_A2005QVvQ&oe=6A428EE9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
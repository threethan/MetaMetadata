IWoQ7kNvwEfgQ4Y&_nc_oc=AdojXy8vti2fyM_VHY-9eJ6aYcqsek_6eKJ1fHbS1Ey8CLvA1YxRdpbjVJ0FxF1AxOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfv8iyU3MctPuFOWxOCOPVGY1_wz8jcVMyDj1rKczjAg&oe=6AF89BD0"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLEkyCBV63IQ7kNvwGRyK-n&_nc_oc=AdriRGHSMz98AO8oLm9jqDBBnZ9KlD7d8TjtRHYASIotNxypMKs1JuTC3UJPOxFGiCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMTO3YRpD_sXXKSn7ZLtXUQMO5TPUfYLx_mnsDh8d4Vg&oe=6AF897D3"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WihR4eAxf-8Q7kNvwEJnm6B&_nc_oc=AdqrJgcReGAyRqBfLLY8rE-t4XK2gGGeKqFZv9dECYD30RIA-jbPV5q7VpGIT3Xp5Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKSpAu9TH45NXWLrthwvU9MoBQ9eBIPUSNTmXXG4vCOg&oe=6AF89BB7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v-DCyL1vCcQ7kNvwEtvNr2&_nc_oc=AdpfGG9Y6QI0ASB6NiKNuEQ94N1sXskRWAp_0gWYZeQq47Ax8sR2UdWWhQCxVHrEguo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_6YpIMzzxhUkjlVtXZfsXPzxLibudkDXqR7k-4gQN1g&oe=6AF877F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tau_72OTS0Q7kNvwHwouSu&_nc_oc=Adqbz-yVk_WLknMCUBeBRnnOF9IffKeTwY5u8Q2AdY0h_TmlpqmjFeEKPNwWte804Lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzOia-y0ixfFvT8oR56_uvdKEzp5L7IfcPzcsUA1MdoQ&oe=6AF87DE9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
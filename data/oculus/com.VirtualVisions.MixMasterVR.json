LJkQ7kNvwEhUMDQ&_nc_oc=Adrex57Wfxwli3KTo-gjDAYkuuHUo6lneibV47-qOGXpk14LPR-pPLY53s_XB_Hs3SI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybMPgISDwv1DnTz8FFkRdp2RNNFdRMf6-Ux_t-0cFLvA&oe=69C53610"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPEQSIN-QL8Q7kNvwFUNqk6&_nc_oc=Adogy_gvXd7hhSEasMtQXykhpwVHcScCN25504MsMTzga_t57hLiWnvZ0eDH32-SwfU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyI41FMuAcue4nubi1nlwqd4jO0cqITiyH28wGcSWmKCg&oe=69C53213"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9PzHiuH7d0Q7kNvwGMP2GE&_nc_oc=Adqrj6v0V_33bnxv7t_l-V6vTZvkBeaq6R8-R3HoBnnzPdmeR4osvEH0nwRcn_l-Ri8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcZfSqOwgnt-htdLdOnVTIqT_GiSbWpGpVPJDJ1QBN8Q&oe=69C535F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X65RLJUxeg4Q7kNvwHm5Se-&_nc_oc=Adq2o-it7e55KTba8h7PHNY_6sFJTYVzBRl7niztiU9A3ZXelnVaa52iRCz3E4rYGtA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2dfjhJbeSpZUPQN7ADFlEH9bEVE8kw8ktKX_NyTRdKA&oe=69C51236"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bci_dGNIwIkQ7kNvwHmMel7&_nc_oc=AdoDjVMU0wTT16GpcRyMB8kUlh2pOae_8w_u7yqnb8wFjCT-Ntgfmgp-GmQr_NFSkmA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afww9Ec7tiuZ61sTaVF1e44u4-bXUmZRyyAhvZfhFI8upQ&oe=69C51829"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
MPgQ7kNvwEXFtoC&_nc_oc=AdpZvtY5RSrjkFCJ7L2iRwmDHbKfkRGY5FQE4nAJJO0-v8lPOrQH7Zz8j2RjnDtNVQ4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuyr3um9aiNTKMOCTVT6x4uPhcrMTE8zqe7T0OcRSTbQ&oe=6AC79C10"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCk3ZaSviHEQ7kNvwGBJFMz&_nc_oc=AdqJ1niFYck6OTkK7O_I40e3xsUvLfVdbhuICcYzoJQIAhvM6PRQcosLIzRueK5f790&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9XeauS-BOAX-4UsjGgba0fbeblR5KMng4pxVJcvZWwg&oe=6AC79813"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjl2fQvHTd8Q7kNvwGslyYb&_nc_oc=Adpapt5hi3t_2pzAvFqjAflKIT6opQtzzZcjIEcTTlhOy9niC13arjjshX0_ZoI25C0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmUVMQZPYhLTz-J4A3yEIsFsbP0LZDGDsFwOtJllTTig&oe=6AC79BF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd69zRblmnMQ7kNvwF0makc&_nc_oc=Adp2zitITd75S89wS6ATNbJ4ASwUdEXFYfGucLKofno_mw_k8PGbDeYzTI-zQnW_n24&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHEukhn5s5GoN2WsxVYcmUlF1ZpegspfXwha1LgkhZCg&oe=6AC7B076"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5zFvdNhK94Q7kNvwED9CnG&_nc_oc=Ado0kSkFn80sCrXekV4VBUu4U1YHqcXMUmtihM7dFlmL3TZ_qFvo99rDYGgqtMybJCE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQCOZRJfImplR6JtCmpmosESPz4wLjKZxdFDM5Sj38LA&oe=6AC7B669"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
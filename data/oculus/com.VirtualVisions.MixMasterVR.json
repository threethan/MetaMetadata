_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W-Ig0TSPoQQ7kNvwFqPXkG&_nc_oc=Adr2ys86khv2SFF8NVf-AdhUb9If0vLcW0-CEz4Ul6jiVisn78SzKSwjshLSFw04wfA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yEpM-5MQs57ruS23h7iQhsV2AKn62f4_f6NS51Ph-6g&oe=6A1C3513"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyAyuM0tpl8Q7kNvwETj7r6&_nc_oc=AdpFxDn0NPzSmCwKAfYsN6gnEY-38P7wc_DGbwvueftX8MSGX09nfk3Te3pJMBUj9u8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WA2oRZQbrXjyqoaLlb7E1iDzT7XiGrcmbVIekqIJTAQ&oe=6A1C38F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAdMppcBN3EQ7kNvwGDnJOe&_nc_oc=Adq7ErhEbDR83-3u4h2KK2OzrXWRy9gLGKp5wEugtoh16YxPiCeXKNuTAWZ8tVoOUOU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UxizwtClVbziMxZ9hlzYcfqHXgFOUqOImesYNozZTLA&oe=6A1C4D76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCZM9MUqaZAQ7kNvwG5L5QX&_nc_oc=AdoNoYRYO_qrrqWwIKLLT_Pqxw5auaJSsl7B-aflUMZ4noSlmVcjOvs7MyBUgg4p3JM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bhLFCXlmSG-kBneyjhx-KLWXMKnrkeV9_VZj0VjDBMw&oe=6A1C5369"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
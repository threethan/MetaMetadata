ZD8Q7kNvwEVqy1m&_nc_oc=AdorJN0hQIGn_pEuUuzOHM-DQTqlw13vpVql-66rttD4sGrd_9_g1pk5cLqLoF_oO4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlGRsf3xBow3fKHRfK2CX2uZbY128VUfeuJybwczswAw&oe=6AC25610"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hhv2T-aEVCIQ7kNvwGtAA9x&_nc_oc=Adr13PH15_L06wGoRXXlNTClWoAgAvBPy8PUi96DhQc26vzQhLk2vMlqXLdVeW87T14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5rEPy7xRd1gTbjW1LJmr1toNxtvvQjrO-Tpz4Ggvqxw&oe=6AC25213"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKkf9A1PSPcQ7kNvwEi1Ngw&_nc_oc=AdpKiS0hNvpgr0l48X5zUBsYwJ8xX6g9eu327KZSyLlJ74DDVyk9kQC5gbu_eDPpvXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-fOpXxeKXUWQuBs340qe1Ux80ZHsakVV1MWI3OmKhJQ&oe=6AC255F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtVwCysa1mwQ7kNvwHFNAdZ&_nc_oc=AdqiC_9M16dkzVpt1K4PwiCpxwafTHq5Arw1TB-mZaE66rkBx2-7zpjxaK1vOR87Ubk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoBN-KWuKgsEgUXp1Qee0q5G-e5mPPbhmGrIIa-6ycYg&oe=6AC26A76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHTagAVRFIQQ7kNvwG5GQVD&_nc_oc=AdrCcC5x7COooIvVUJxDaBxYL4mmkaZdHVQ8EgVBsA67qwqabjCgi4zysX0cDzwzpxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSU7CV-74Y8x-9zbBlq4zGyiZ47VrmDEkmpN_VtAlU1A&oe=6AC27069"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
MPgQ7kNvwHaKoDt&_nc_oc=AdryEKS5XO2ZUgrr9VfCXMvvqU7I-v6ELbR5Q9JedoRxNsemz1x6bToCkEH0dQtVZFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNb0RnoahIEl9voK98YhqoUjR-961kp7ns8nkTuWcBRA&oe=6AC64A90"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYTk7KzMCygQ7kNvwEKNvlG&_nc_oc=Adrd4bT3EWf7goj2PV7zwpUK6AE6I9oeKIoI-axpt_KnSaQIK3eRpUH31VpjmgzVvK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvSZMRbK8M7dIktc8_bAi30aJ0nk53pP5i9T1TdodjPg&oe=6AC64693"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjl2fQvHTd8Q7kNvwE7nr5J&_nc_oc=AdqApuKXPPON_fwSpnnUOqUu0ogKOPbSsZInHcDWgs1LcACNY6MxmJGxqkeB0f2jXhU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBuWi324NHbRiibsT3hrpHUSqr4mjsMTC-5TNmi9X8EA&oe=6AC64A77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgcsncVbTn4Q7kNvwH8Ada_&_nc_oc=Adpo4koPGll1DFUiPgboNy_nHRisKxQ3wb-yGXNi3fzoNY_BF67xxUQMr0BTdDkfnoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7nwDBTOX3YZV0nxKMkDqx1A73y685iqTtfXMjIV1m3w&oe=6AC65EF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5zFvdNhK94Q7kNvwEI0viE&_nc_oc=AdqJKcX-bpzP6xvkbP1ti8Y2Ae_08WsfqtLRnuBKQRcLbNiQXPtLFRm7mC7OQa4VPTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnxDxbiOFZnJ3Q-QYmgSDI9u4sQPFCS8G2rA3pevcdfQ&oe=6AC664E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
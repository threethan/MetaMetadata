_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpOcqiFWX8gQ7kNvwGOJx9Q&_nc_oc=AdpOkheotlWxhMZwPFj5X4vBnk3RmxNiWDbnbYk3ZMVekA3rQwkOkxqj1rhIH3mH8Dw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-sWhh9AaH8qo2RZ9OW8CJtuYFRapN_KVI36tNx1Rgmw&oe=6AB67493"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frvIDTYnHnUQ7kNvwGU_HB5&_nc_oc=AdqDduRC3eaK5MNLYWHPd4d2gx8RRFS8tssQHXGQwfXhKEs3eTEUEsKWUd5-zpNaId0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH15vVKgfpIcRiroSnf_eWg2zAB8ir40N0T43_6r7--w&oe=6AB67877"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMMxzbxS7uIQ7kNvwExTA49&_nc_oc=AdrEXXbofSAs-d5xo6rJoiogZMgaExtaJGk0d1zcuCG6gn5uX32L-HmeFCrpJKuqhsA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZKRqmZ4o_EeKBGZJtsiBNPRnrFB5wDSMPhHHi-bU22A&oe=6AB68CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgPwoNVc5C8Q7kNvwEOZEWB&_nc_oc=AdqTEsXZV8-oD1bHRaoSIg9CTpSY840X6qHqBL9N26d9P0UVLgOd_PlASuL7tLZxMVM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXKdKvMsUakVIKahF1SfEFub1ucm9_blcZmzPnami7Pg&oe=6AB692E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
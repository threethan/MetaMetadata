RIcQ7kNvwGVZGK0&_nc_oc=Adr69PiFc5j21oWurfmugLa7ThIDBfyYL6a_cquWWQf15by4g29PrP7by9MuKvt2gJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9ElxqGmXrh_V655JJqAVgH3Tb_93RR_RGXW0tHA_ZqQ&oe=6A95BB50"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVsX5PozIU8Q7kNvwG1-D_E&_nc_oc=AdrR8QNbUSZnZ5xhAEwYLMXmtwpjX7YW1T_blZ1M_A_uGa4_rD3fTdiga31gO4HgbAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg_PW3gOqfpxIiK_RoSJf6G6E99jaOCuvxyV3UvjumPA&oe=6A95B753"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qH3GujEDPD4Q7kNvwH1VfVC&_nc_oc=AdrNSCbaXAszwWl0P3hQ7g-cFcbQungevx2QN607E_V9366zOWh90RhTtJedf4MQJdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtXdqKlrknYWLaFT1mli6qcf0eJYBBTwBiNkb1Jk9Gmg&oe=6A95BB37"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rZBd1FWJO8Q7kNvwHtL2pd&_nc_oc=AdoJ0nfa-ZWOPImRAgb6hkR7Xl_18bXOtq5h-7o_X373kx1iNl_SdO52CJZSNNuwaow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDofEDIPhOLmZulNl2sTqQ-aiIzn4f0qHFY_7rGkqu5g&oe=6A95CFB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOkP-gSDfiEQ7kNvwFjTlWQ&_nc_oc=Adpm_Pd2We0pO40wVQT5yCga9fnBAHvyO8qJ7t6GQN8knM6_UgDClMe5KXSZtFRigLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf-Yj5LOnzXnyC6ih2TXYGL65B_bij5j67LBEkaxVhZQ&oe=6A95D5A9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
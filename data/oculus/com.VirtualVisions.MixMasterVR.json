8AsQ7kNvwEZ4UO6&_nc_oc=Adro8shXbXgO7B5w7ummqcNAh9VyUzLVj4laI97qZM6jE2DUqh00TPNztir9BAtGwAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ujrDCZP3vLD8-ni0Hk3qDXp836DY_vo5YK_fi0Ok4vg&oe=6A145010"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7jtZ9SoYYcQ7kNvwGzZXBi&_nc_oc=AdqGFDI8PeZOv_v7afPrh7shFabjtfDq1f-lr3AlWR0FxLHopyGZVkOJoPIvPecMWBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ttyXO5C4I_AWRRlq26SDy4P3031_CAA8OlWuWeP3w7Q&oe=6A144C13"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHx28R8njgEQ7kNvwEf_Usm&_nc_oc=Ado1Rog_yeJx1Fct4snAV9D5Ga5-lYEq_uTKQjNamrB4lDKgmhaZ9a-LtSekB4V4mWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XZ87V7FLhTTb3mIT0kk2Jbm-dXlPAKvzDzSF7gJ08tw&oe=6A144FF7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkXI0uPTyBAQ7kNvwF_jMji&_nc_oc=AdrM9hrjFeHMf-BHOtHKhwwBLM4VyB4IW4LBkd_uonBwDoIIQoaHa6TAl0JVJ_PWoes&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HPSqqwrrGR-rVf87rpi9-c2SVMwxikcwcm6dKMHBMjQ&oe=6A146476"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myns-PKxejAQ7kNvwHE-C6B&_nc_oc=AdoPibD-Xh7Jz8DkOuBEfjiG0EGnrMQyrAPgzWYsD5xPVBjNjxXnObL9bbMQogrWaSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kYPFsCDdGa4f1MlZRICb1gvNbGTv1OeoBBy6e9BeICA&oe=6A146A69"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
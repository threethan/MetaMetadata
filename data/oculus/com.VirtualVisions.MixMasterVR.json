_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQCkf0HdA1gQ7kNvwEKuKAA&_nc_oc=Ado5TvMCG8YySBGH6kchif60i5r2Q3At7CZJwAUWv0l87ZejuFZq4dc2qpZZnOm6hUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTviII7rLMSLmYIc5cR5NmOuyaeya0OCIXO5hKSmOdE4A&oe=6AF0AED3"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zkvab7oJLHEQ7kNvwH1JXmo&_nc_oc=AdpL4hjuuApnFPs-8xoxiwPFbtYE7DT4CrKsmIfDU3fIs90p15TfQPj4BhAGvC30J04&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyqDLX_havcK8X6tCM49HqQ8dgQPID3dVyOCVe7dbLjw&oe=6AF0B2B7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWX1EDpvY-MQ7kNvwG8Zz02&_nc_oc=AdqduFgSwCEEgnZLsXfiXNqOoXSsO2x4nfdBJbLv_PIrYH07l0QplGXHAfNBb1_jb90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgkhecLUn-2SAG10Em40oUA28Nn_fJQKhmZayWnOe7xA&oe=6AF08EF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO3O9TxFFAUQ7kNvwEfOFtC&_nc_oc=Adr-XXmoTI2-aDFfgtdYCpE9dhfLJYveDiBuYUmKC-gcrlosUCEa9EhX6sILk657eMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUF4sEw9cVctapSoplsNHq8u5VczZSNsMfgB9gZv6Ykw&oe=6AF094E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
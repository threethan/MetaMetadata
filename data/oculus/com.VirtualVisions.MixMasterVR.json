_ohc=2fTnKAkWKhIQ7kNvwFdlS59&_nc_oc=AdoQWMbFd_4CJJ1cAjI7lTdqLTVuKqMpCoeOgE7l5skQSlG4aq_ywsu7FqJQRQk2mGo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ht_rhcC_IbBBmt_ULJz_6UqViLkP9jUWFFmoaVV8KIQ&oe=6A466910"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InKmZ_WUj3cQ7kNvwHDXUrQ&_nc_oc=AdowUQuoO1VqLLb36sL9hzjxqT_GcPyijCns3QjvWRz1gN7lH78g362P0eY5f9mGS60&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90WLzxmtk7lgfXOsqWvYzBqFNiBWNu58gRWDVDhmt7dg&oe=6A466513"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydXnWdUv8wIQ7kNvwE14Ly7&_nc_oc=AdrbiRxH4inh88xIleAWZaalygJ-FYRzTnKzjjHnNwfgENOIFmGkdPnh6uPk8DcRXBw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V60ofwWjXCU8CmWnivO9h_OFD5nXTlusvlJdLFFZGmw&oe=6A4668F7"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgPFqB9U4m0Q7kNvwERHP0Y&_nc_oc=Ado-e5N4MVgTe7RqNbPowmWJcvXtklYPZnytiH0VEhp40kK4ocVt3P3BytUMR7zoRRA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sGfIxDt4KVJESALUM_n_lcVJWGFrONiPHBQIlq6XeaA&oe=6A467D76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXoz0b1oWjoQ7kNvwFxitIm&_nc_oc=Adr0GWlkrhdx4fTEGcsSXr-jb5Djy8eSdAi6IsUZlOJcrNbuNs-STUljHXXmFv88sVM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QKkiTsTNlu-mp9lWktkKlcS1fNV807eKbnM4Cwe5oqA&oe=6A468369"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
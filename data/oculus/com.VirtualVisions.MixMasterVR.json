_ohc=ukO27XO3ShgQ7kNvwHUq9S2&_nc_oc=AdrYckFKYUrd-r04kX2lb0YGy-AH5DKX0qtvXipey6WAvU0A8Hqi8DQhoMp-EsxZigY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLysk9r25bYW3cOdeGWQw2GZxDFOVOhaZhITf5qGy0Y5w&oe=6AAE8F90"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IacneStfOfQQ7kNvwGnQYBq&_nc_oc=Ado4vR4AYT-4Y2BwQO3qJ1QWliQR8sFPVi2NHne6QRenRDAEgbmhDIk3xAPmLMZxyzU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQxnkJN2OeG9cXBeoyG_CYILaa-Ph8-1nFWbEWDRYN1w&oe=6AAE8B93"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AA848tZk8cQ7kNvwGbWzk8&_nc_oc=AdrUYg2D7244pidfJ3qwL1yDFBXI3zJQSfs1-0UbrNU0IZjfWhqR3-0kaT169Rk7TvE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsWdiVu74E692Fo3C83woMFIg19tABxYbaGpuYCyNcIA&oe=6AAE8F77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjUkHqGc8QAQ7kNvwGlHZom&_nc_oc=AdrQBejQRLeDXOYuvhfIUs4LuMnVrH5M0ZLRUgxgI1FjaJ_xWzE_ralTcKOGY7udL5s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI86Wf8NU-jVUCPVYm_tQSh8Y6IRyiYNI4aoRo6Eclcaw&oe=6AAEA3F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcPiPMyrc3oQ7kNvwHowLTq&_nc_oc=AdqJSibUHevQyG2oEUHGAq_ULxVAFYZ2MxOsp0PAjZkfguDAsz9xw3pdO95hywTMZPo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfHDbwf6ALsv7ZJg-7FC_6mFshkqVAwWmvkNR1mTTvEA&oe=6AAEA9E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
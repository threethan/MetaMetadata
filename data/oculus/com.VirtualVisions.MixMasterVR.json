_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppeoVay2PjUQ7kNvwE-602D&_nc_oc=AdocB_fNy_dI0asryXkNBJyusAH_dv_u0iZPQyIPHl10KBs-wxYDbgUQBihKFg5CSNY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrY56MPxrjn4xkCQX7wH-4EeJQbg4G8kSpxThzrpAGUA&oe=6A71E693"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWgFzCaz_dYQ7kNvwHZFQje&_nc_oc=AdpD6cJJXkhd7K29xsFJLaJqjgok19aP8wFgrPw0mwRHHKUh0c_qWSO5EXo4k8J2-ps&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHj3EEibhV-YddLjCeVivQFEuDdVl919vZWo3GHshdbQ&oe=6A71EA77"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoaJR990p1MQ7kNvwEUThHj&_nc_oc=Adp4RShy1M9y8WTzqulSZkb739ee2w6umGhYanwPcPofkRGbxhJO-4VXLbpxfH998Ko&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnP8Ople2SZRqQh_t2cod0zb9SZw0BBqu0ap9X1lkNUQ&oe=6A71FEF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gVq0RjgoR8Q7kNvwHGoEVb&_nc_oc=Ado7qLM9_rhQlNaauJzjiU2GYv6YXb9ABqtJLa2NbnnG3ezjTSKSwZTH81kKBMAZBR8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiMjDCVWqAw5-szNdRsu2FZEcZ7a6diyFjFlUDm40tLQ&oe=6A7204E9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
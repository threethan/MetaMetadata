cXMQ7kNvwE6xyG9&_nc_oc=AdplZ_Exr9d6O-wyYOh5TQXLHKZPlHwUQe63TABHC_5DsEfnPYb6BjUFgGfhHdGGyUg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4yPDe4dJjTC3ZSFE6JQXXWN_34LJMnQWjKI5AMazM6g&oe=6AE89190"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdIn89C-IvkQ7kNvwGyUVGR&_nc_oc=Ado6FM76g1xGrDcO0G_y4Ic7DvcU-YWDXVp-zCrdjAqY0yJbij3HfgK-bdV0u0f_GzU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNddX1Th_IcGoEI3H05bm-diOos2HDbFF5DrCKSXT-Tw&oe=6AE88D93"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uznyOAvKhTUQ7kNvwHeMwSa&_nc_oc=AdoMXmBJFbxm0dPuHI3IkUCm-xFbh5DSG7fLt1jFdJebWIzLL72O5fk14ilCcpMu7ew&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTId-OJ0hsS5AoZkvtVayv4IjT_9E15rxNoRjK1vyC2eQ&oe=6AE89177"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ethXUcsZCG0Q7kNvwEupA_1&_nc_oc=AdqZqqUsqJIn0sqL6o5I7n3fjYaNNqiStUB5saYUQ9BoITOcdlUyq_dC7xAv_sDCk2U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_FzXDYcL9i9dflDOD0m-mBCusjY-7sSgQZmkC_rsR6w&oe=6AE8A5F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-Sb7eUKs_4Q7kNvwF66axQ&_nc_oc=Adr6_nikVbcYxNBS-yWTJDORzz-kEBd3GnyeTx6n3zid3uP0bGJsiY8jDJHe8TgQUfU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_sOCc4s4mYt3XRBs1Wj634j8FBxrqmEaWpjDNeXW4Rw&oe=6AE8ABE9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
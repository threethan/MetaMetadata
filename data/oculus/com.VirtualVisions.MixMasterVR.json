FZYQ7kNvwFf6N4A&_nc_oc=AdoLFi60UIvR9vZCvKCQ7XMZgDqDnny2ZO_iYZ6_Bh6fZUwlHFQeMfcB97sdx7EjbVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46GMjdzjSi6rMkP_YspUg0J3EXUqXkX8TQ5Fbd6pPrtQ&oe=6A0B1590"}, {"file_name": "rsz_1download_6.png", "id": "1776309413111404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035463_1776309419778070_1134961372257987780_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpNv4JkppsoQ7kNvwEC6d6p&_nc_oc=AdpijCkupDmcKCxKrodVv1oS-KbwSXzO5E_6PpTwBT-lXXkA_wCQ-13b7hA0rVcXPC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d9GZTkUgVJm9ibEy2XfI2lKmU0uXlcez2zfcDmIHpUw&oe=6A0B1193"}, {"file_name": "rsz_download_5.png", "id": "1013543640497320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569485_1013543643830653_8351897982302623622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNxaZAIwNsIQ7kNvwFwEIpq&_nc_oc=Adpclpe1vDeh5k-At0xKmZQVIT22qeQfpiKRPKPThlh40KYcrc5eksb4Zwl5ySJ1ZG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z34IPzsfpdXCsifdePJPqGR1N_61mqcBSYP3exp-KSQ&oe=6A0B1577"}, {"file_name": "rsz_download_7.png", "id": "422552660133162", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361346_422552663466495_2266159449569105371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upNWlHEymlsQ7kNvwEuTm3U&_nc_oc=AdptBGaHbMUCou-mCpXgPOp1lrbXqLuReADRKrgkNFyAkVRB8dvXewnktYyrf1In4UY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uef02yj72wd9qokK4O0xScfhcjnKt_xuwwDhEHOBDuA&oe=6A0B29F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1028565895317889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974477_1028565898651222_8961208044456366665_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3d3eVVvDX0Q7kNvwELmspB&_nc_oc=AdokQTLIwdPCg9ZOFpuJizyqvjkLo3I8nrW5QBKA423hpB9moMoVLSXvndKGZyj8v2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xJwuP4EIc6h04VMNhPjYBJseI1iJmXdzG8QFhRtTacg&oe=6A0B2FE9"}, "display_name": "Mix Master VR", "keywords": ["Cocktail", "Music", "Education", "Disco", "Bar"], "long_description": "Jump headfirst into the wild world of bartending! Run your own bar and get cozy with all sorts of bartender gadgets and recipes. In this Early Access Demo, you can mix and master different cocktail recipes.\n\nOnce the game is fully released, you can manage a bar solo or team up with friends, serve up drinks, and rake in the cash. Use your hard-earned dough to pimp out your bar or even buy a swanky new one.\n\nBut hey, just like in a real life, things can get pretty hectic. Don\u2019t keep the customers waiting too long, or they\u2019ll get cranky, and that\u2019s bad for business. Keep them happy and your profits will soar! So, get ready to hustle and find the perfect balance between speed and precision to make it big in this boozy adventure!\n\nWe would love to get your Feedback on this!\n\nJoin our Discord or send us an email!!\nDiscord: https://discord.gg/Ww4gY3Hf\nEMail: business.virtualvisions@virtual-visions.net", "short_description": "\nThe Bartender Demo in VR offers a detailed guide on cocktail preparation. Step by step, you learn how to mix various drinks while performing realistic hand movements. An interactive program, featuring videos and multiple-choice questions, guides you through the fundamental bartending techniques \u2013 from gripping and pouring to shaking and serving. With numerous recipes and creative tips, each session becomes an exciting experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtual-visions.net/dataPrivacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Visions OG", "support_website_url": null, "website_url": "http://www.virtual-visions.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33
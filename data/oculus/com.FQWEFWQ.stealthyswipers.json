Av9OhblU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-nJYkvjzN03n5aCxCqhYFQS29jvH6PdfTIl0sEFC37g&oe=69AC28F1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc4NevFeLmMQ7kNvwF2kH3t&_nc_oc=Adkf69X_OK-PF8Wm7YVUEJZt6Ts1epsnPmE_zI7ace0p0bDu5Jhfr_qP65FHY-i_Phw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOCDkEDB4ForaY27Es3qOC0e8FpprosEnETQuOMy9ivA&oe=69AC2473"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX7f_4rP6QIQ7kNvwEyQhbC&_nc_oc=AdkoPG3PkGMpPSPoS3fEJfDOaFiD8nVgkfcF4zTbtnRpCrf8EJQm-9C7pBN0eKd2d3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxhWKPNtKi5OIDi5deCIimI9UU17hY0lnep02BwY0VxDA&oe=69AC09BC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZLAC3eikN8Q7kNvwHpPaG9&_nc_oc=AdlXKmoEdgC3XvL5rofIyCDMzIwNly_mQKkhfg77wZEFyrPwt0d4Cc0X__J-3NZmv3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFcwvn7xpP3FAA1CQNA0zbxQRe8VqDpz1H1heYk-BBYg&oe=69AC125D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxww9LxsQ-8Q7kNvwGdWEc5&_nc_oc=AdmDZ_XieuBJswMzpZu6I8xEdlT0k4stnGlfV21JOTMrZX9AWbrXF5OmCkIdWpCHXa4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwuAjxe6e-GVpK2b4F535BB68ea8HUD7MKebU6HBOKgQ&oe=69AC13DA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
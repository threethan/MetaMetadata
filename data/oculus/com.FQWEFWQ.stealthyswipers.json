F-6xAivY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvkYu_L0DGM59pXfHJaiO1kVUQEbnREc6qGYd-9PniNFg&oe=69A985F1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUEMN8ckfaEQ7kNvwHGCMnk&_nc_oc=AdnGm-EzFsmCCOgUGgTbOjhwqANQ9fzpe_QbxdqgtSQt5t4ZqYTJehC8EPWptcw3_yU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuLuBpZ4QGiHiLE5QDUY5yjrFR3DyRjD1X8i6PXHotzuw&oe=69A98173"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sAI-AIgFEQQ7kNvwF3u8Ds&_nc_oc=AdlW99Hf31E1qpnSf39odlfAx0PD-WHSE8nUKz4evLtlnVbfyCAnf4ljBjLoBJuU_es&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftoQDuk1Sxx0ghIEU68WbesCVRRoNpxObY7VJyNs2exgQ&oe=69A966BC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbqR1H8tbqgQ7kNvwEQSRJA&_nc_oc=AdmpB-ZLElH51bOXlR1LRGnzMgiThz1AdOAqwUm42dZJOe6elztVgbd09yS_NzcsMPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs5NGuq18u25OmpOboiO0s5yi4HtgOM3skTO_MINI3dzg&oe=69A96F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBM8VRWBAE8Q7kNvwFNOrNt&_nc_oc=AdlcnF5uKMzjGx0Fajk0cy5S7T9hfJvLj1CvgPh5nalPsxFp0N85ylbkQ27gOLm-P4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv8_8Y3fRw2nIRzH1j5dfkzDJZXj3UGQl13VE9a2kMDVw&oe=69A970DA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
JLsjcE-UyZsga8tFAtIUJBg6gJYMxEp4yBqxGznM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDnqAnMaK1d5qdQuvWRgfiXT7XvXT0C2_7QnHTTODr_A&oe=6A9430F1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vra9sq-Ug9wQ7kNvwE-wvyL&_nc_oc=Ado7DbMBUMHW3oLnDzYbSzzmCDTxD-bw-lmmlHW_1QRiVugL1ZYYBxOxDsovsP_q2e0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhPjVvBBXI4Yz1-wcW3Zm8Qoh4yeCWyKj1-CKvnSDCwg&oe=6A942C73"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fodZ1rPR7zUQ7kNvwHKAGEF&_nc_oc=Ado1ohA0ycw9ABfaJKAvhmXWGnxLHQjcn0e-TeQaoDNFUnWqHVtpjLkYWB-eXfDmbGo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiNSsBwoRDnpUMOxuDe-5Rb4bThumnLT_C00QC03Acag&oe=6A9411BC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9acWOdv1QwQ7kNvwEDcl12&_nc_oc=AdpxH_HtfOgLu-jIwYg-Kz1hcbysmz9fidtKnAOPDIQvTCYCloBdrnmQ-B_3qWNaJEc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6vipCCUsK53lWK1QoTh6rh_8Z92NKVRa7YpMN1fsRNA&oe=6A941A5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvmA5l0r-VEQ7kNvwExO0Yz&_nc_oc=AdrbThYGsCawcwczxYmI0Dpf_-bBrr76JiwlLw8QJEXxJiHa490ASEgSb19_EH0D72U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUcxQ22Ux03pfT5DVVhiSFR2UP4Am1EBkaRUUNyKsd6A&oe=6A941BDA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
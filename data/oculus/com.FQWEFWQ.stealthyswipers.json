iVEqCbpWQvCkMedsRkQgYXhEAHJ1AvYF3aiG2v7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjphUhZGvmYJSSTKjRHuT4FykD8cbOa-6VJOxgvkX9xQ&oe=6A95BAB1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vra9sq-Ug9wQ7kNvwHwzJqJ&_nc_oc=Adqd-ab6mA9DWjLq-UhZnbZPIwxqaYnek5ICOyxdasyAc87CF54CnywtSl3eNiB20Y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3ZCR3YF7nvWA1u9Duahj_mC4SdKwbwSNSL1rmDI5uag&oe=6A95B633"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jP06CMahCEQ7kNvwF3kWXF&_nc_oc=Adpu097TQhWLLu4GqNZUnTZMkEMRR_I7DI8Vei_rWr9A90iUhqX7PWSLVm-sd9i0Gzw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk6QhrAns0LjFmHB4I7kUUX01l-L55GGATr-v1Ph2AKQ&oe=6A95D3BC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttFev-DQdaoQ7kNvwFGv5ed&_nc_oc=AdrsTro4ijKCkPrBdw_BA2gVw-kgZn5QJNGpJ16iRUHGJhVWsM5EQx0TevMRBZwuIKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtKiWNTYRlxcQAUfZ7kpuja3vpE5RfykepCbnjgWLUKg&oe=6A95DC5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM7NKLFvi7gQ7kNvwGQNfil&_nc_oc=Adob5Jxi0uLCuNd_jhRpeeiH0LXF6PkqsUx43PWQCbR_WMTUxT_iyE6envMj4a8uicY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFnKZXgKE092MuFFfByXZasAaUap3dKQevPBJPexDWTw&oe=6A95DDDA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
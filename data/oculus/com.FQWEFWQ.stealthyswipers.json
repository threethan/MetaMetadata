j_ozhvH-fFatD4NjBLwz1NrXr-2N7baOC1x1sr4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVOjvIPTHelmFx4L-9rlL5TLe59UIgYHmXYWjzObBf1A&oe=6A64BAF1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flSVcvUce-QQ7kNvwE_a1bj&_nc_oc=Adp03NJVnfL5nuLD2KR2prFJw-I9iKFtlZxJKHd_MEo8Nj_FzyVpJQuADqLdc_DCWUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY1oRzJwyWKIDMRL8l9uA6ja36FFon28c1ZIhg9nw-lw&oe=6A64B673"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIZMNX0v3LAQ7kNvwGvqKdg&_nc_oc=Ado_JQUiiC-HQX4tkQs4gOR3ZNF2Xfe6On_oC1nGqaJ_cG7LmgO737N7GxaTESaI04s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmdketYMwPJ2eivKUdaR2-aT172fCABqmYSyZDD8C-Mw&oe=6A64D3FC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofbmdBqCMIMQ7kNvwHMsAM0&_nc_oc=AdpFVLVt4b92KVel4Tgfl9co-288h3N--4OOofoXIIx30airo2P9SRm-U1NswhH-JKg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnxJ5RZYOv8FgUnxM9hxfdsaJ3BPH4owXywWLDGjwE3g&oe=6A64A45D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMp_bJ6D1HkQ7kNvwGfsMIR&_nc_oc=AdojB-o2r-fakZhCHSXPPDfTluzi-rUTtJuX2ccUYoeIhiWvtRO-evwvUYj8bUsvB-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8ySjKCf6j9yL6UYck_zOOi9NbacpsLlx4AZuV2edgvg&oe=6A64A5DA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
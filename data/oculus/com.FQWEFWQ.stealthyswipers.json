_QHgw3VaQ777GKjrLAcCunP3F0yucRz2VzqX9Puc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEflTAYF8aS_PiZwHE-d7FjClob19OcSctDjsuRw78N4w&oe=6A918DF1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvCsrYdnkkoQ7kNvwEkfdld&_nc_oc=AdrLafsEhkSmwCmf_8OXYKgCW1d9JiswSsK7cp5zca2H3AwGr3zVn3e3l8ylFQlypq4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjH2KZrxFs3Vg7jYa3BYTkB4rV_rjCFIe_7eN42xLVRw&oe=6A918973"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fodZ1rPR7zUQ7kNvwHlCcSB&_nc_oc=AdoTL2lfSPdKN9Gofu8HsErjoYyBkDFA1MYdKq8SOndyr-_2zyjWe_5h3_MBnSuau9A&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHo1HHaTG1XZG3nrOLWLxTlgDpYArD2HoD6NZi1TVHlA&oe=6A916EBC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9acWOdv1QwQ7kNvwGRJLep&_nc_oc=AdpLaeGRT2Oe9txnw2p_nixSTP6fryDr1F4DHNEBEwE_705JoV8UvJdM9p-9keNiRK8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrAjG311WMA5AZM1HzjyCSlkEFD7jcro68UB77pSZzjg&oe=6A91775D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvmA5l0r-VEQ7kNvwHAFw5i&_nc_oc=Ado_FYNWswIHs2j3SZNC8MYA5tPXG1dwm07_WLIWPjBNpaxqawAeYQyQonEAfjuKvLo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVuEbqIxqBfvN485S2LYHoqSeRThjBJ_LNjmYC4lQXhA&oe=6A9178DA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
ZtyXHwl8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMC1umOtj8vO7CtQC--CSBZlgms93XU2aZd-ZqmY5dZQ&oe=69BE9DF1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1WNNxJ446oQ7kNvwHd-0SA&_nc_oc=Adkb8f6dljda6IglMyd2AUuHzPeuxh5eBPjnYB71ttkQxM3_s7cUtsyhmXrr0C4Ylig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMqEammPaGciL-BwAwlk8Jt2rYeJ8Oi9iu9MXeuur53w&oe=69BE9973"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vrpT9UDL_gQ7kNvwFk7mbH&_nc_oc=AdnW4i7apUncvjtSrpxPyH2199bfEuVk0VXKvlwfwKX5E2U-4uaD5zAg2dBoXnnUoaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxX3OKiOEre91DAawepScdiddnj0wdjrqy6sa4AcSE-7Q&oe=69BE7EBC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQ9jaRA_4NIQ7kNvwEfEzvh&_nc_oc=AdlTJpGJofzb5GsGQsp8Cvq80QhCvoAAIRD09eNmTv_Hx34UPegD0-_Jl2vDzWEgw0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDc2QDHlfnedg4hZUEBL_sa5JZd7ZJSB8uEfYMGkf7Dw&oe=69BE875D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj6IOf4eQ4wQ7kNvwFVIGDb&_nc_oc=AdknnMg9i7syjOK3Y90Vhijk-2ZIEWWAx4_LXp5000mcutgyGDPWGqrnP1K0NmuVrL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmPR8tEKcxaxPXhaRFGD52LobsQrZjN5aP-Mvl5S7MbQ&oe=69BE88DA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
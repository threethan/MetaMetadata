/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl3RMKtVS88Q7kNvwGRQ3mi&_nc_oc=AdkTei3rp30fh_1VOmVS79pui919aaRI5Z8VPr88XXQkvxltQiJ9TUmw_0NNHGdB9dw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIt3ZGKXcRpoqv9BgJsjcKXdhXeewz1y7sFXZ_Zroadg&oe=69A6C3BC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yN-flD9w9G0Q7kNvwEX1qro&_nc_oc=AdknDPof3XU3SzFzX-PnV75HSLLlFT6RUC1T1RrhH9X0odlD8OM3f38AAOkGEg6_uBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuWopsUF6yeXK4bX5GAhcxmxRqu6wgcWxXAcouQNJuFZg&oe=69A6CC5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMRHeS2CFGMQ7kNvwHImuDv&_nc_oc=Adnri_SHMvEZJYTGAXdrjfH0r0mYlh9f86vmNjkIkbDDUA8qBKikbALKL2wBJ3fd8B0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYrDhU0S7X4KVmrjN1mDlK3OXi4TM-zJqQS31Z4wPe6Q&oe=69A6CDDA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    
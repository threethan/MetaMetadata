Ns_YKxiY_i2HP1g8ZY5ZJxsMpYvRnpbndFCPhSlQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g9emaKtKHm7JNG1-NPtozLzzpwvZB3qrfnP9hg6SULA&oe=69FDE5F1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bd49kZc8KSIQ7kNvwG_Yp_G&_nc_oc=Adokl9W832koVMO2Ul9v3KH4fTDU1gNU-J-znqYMAvmL9w2FmKq_eMJxP3QGnVhpnkY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pl031z00qdAVwhoT2ePYtjUoVeZ68-AEOb_KRjEnnWQ&oe=69FDE173"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoYW-n0whuIQ7kNvwEqCj47&_nc_oc=AdrApPG8UeBG-FpWxMQR7st8yPLVdK-spivpiKvqxxbTF7qCly-qkXKGPSUES_YU5tQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70epydxZbrA86pdkspPEPy31NqpQLQ4kiWyQRcwfVeIg&oe=69FDFEFC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObXzBTtJZ8gQ7kNvwFTymEI&_nc_oc=AdrANXoNgjYa1D57HZqz_3Ze5cjSZhwIWm73_GGYo0cQJhU4jcNmwBCHvtD6DrYZbWM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4thTTBWkP8twt0OV7MXF7KUNUgaJSBaJAR6aqx9SBUEw&oe=69FDCF5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWH_KsEVT_oQ7kNvwG4AFdp&_nc_oc=AdoJk190YIfkk8AAi4VgOgYgukJ_ocJH8lqNZ7ZQNHlkBTN4Ckc6NfLNdIhONrDQvkA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OvEAk_zM3nB67zSI26zOndjcqD0qgcMIv5jkPg5YtdQ&oe=69FDD0DA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
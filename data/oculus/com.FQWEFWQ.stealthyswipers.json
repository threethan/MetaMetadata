_A8bpBhYvR5OGISuiHZ9gjL8YeRcSChFVM49jPWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72DaNFecTpIAH2bNNmNzA0jGidm_ozjPuJjWz7sTSfbA&oe=6A05CEF1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn39YiFfCXMQ7kNvwGHlE_W&_nc_oc=Adoq_as1coIMtzmBCBp2Z-l-pbc0OqhciZmun6k9UqInicBQvwyeW0sugWv5RLiwgvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wRiKoBMCJn-ezGRJca6xczc6ls2jJkRIWMVi6yxyd2g&oe=6A05CA73"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXog9Vs6yrEQ7kNvwGU5_Ds&_nc_oc=AdryHf0fbRGnnEkQZt3nIjbL2htw6Gr8x83wtBtBWA-8i4vFRunarIshnO8xcU6coNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HWbjCJwptYb63cYAT1KoE7mHX-BlpXYlPNlqUA0AELw&oe=6A05E7FC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg_psDh2tnwQ7kNvwE1jAFw&_nc_oc=AdphOD060z7nLW16Z1k2otuuSGkrIBQ1YOqvzFEpwTVi2UK8SWEXvt6dDgk_Z7MsSuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bidQlBWHFKinz6O_wvTT86lM-svHBS79da00mbsuHlg&oe=6A05F09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gBhBy2e3eMQ7kNvwEG6Oga&_nc_oc=AdrzIzP21qOePXCECW6RyHn55jeet-93_ElM8nd4fe1SOy8Rn4zCUYVBtkKJKIUxdHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-FHNGTP4lcP9hbBqDzsfPGLv4vLtKmguh3tvEmF2Xhg&oe=6A05B9DA"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
qL_VZW2-FDDJd11y_Ny1ZoiFdfD76kpWGW--VGh4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5s_6ApYMhnFjCd8CREbT9QK20wAHXf2je1YY0R_SW6g&oe=6AF9ECB1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69ggigeFS7gQ7kNvwFeMwNL&_nc_oc=AdrDCAz4Vw87xva_wwNfEu47HnmHUcMR8Gq0clSDNvncHsh2ONNYWi1GPgellkAjgJ8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6clXayzkyAX5DXEH6fuMc_tvcYxLTSkryci4ubPj57Q&oe=6AF9E833"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f36ss1FtlZcQ7kNvwHf8elf&_nc_oc=AdqFIbZLyVZuc5BVCxO41jTnZ4xVOOs1nRjvWguiP8rbkwOqfSaJAqdjun_6onATrxk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyBPR9Ec7PUnQtLE-t_Jxl3jKQpqYpQ-intfEZqT8kyA&oe=6AF9CD7C"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zB1JMEFJLwQ7kNvwFuIJlg&_nc_oc=AdrTv9D-Yf0Susl7W-O1di_VpbeR91umtk7werFZvi68cCnAkQQygCXXPCXwI_9wNe8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCA_PaEDOfX5azZgfsFzJiDE06o5aOczbbIXUMnsFBxA&oe=6AF9D61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmeZfwqheZcQ7kNvwF9enZd&_nc_oc=AdpxHXu4ifj9Vnjqi2MUNnc0RqVTEjf5jIni5ZnmykjZeFD_2mSD8_IRl1hbyS3sJj4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3iUWeLOTmbtRoWaAQlmdT4bf_UnfiXcmntMwIpjYwgQ&oe=6AF9D79A"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
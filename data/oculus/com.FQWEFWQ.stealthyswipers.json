w2CYF9IbU9dOwUT6AlJwhflpjolU6ettQwPLNVZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeFeCRitI87MNf9zW3KI5uGKTC9Og7wlAhTmkz9AGMRg&oe=6A709871"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtnBgwq5q5UQ7kNvwFBgPlm&_nc_oc=Adq2enukaw6GQebX11LH7hLW7QEUezfUvWAxBOX8slMRcw76BvsycMV7loF_GlFdrxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR6zyrmfheJ1Tic__UQcje4f1JzK9KPPd9py9eD9ySPA&oe=6A7093F3"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXC7OIRFjxgQ7kNvwFX2XLK&_nc_oc=AdrSocKD38ZHUahTCbjBfqEtO24JsHn2A_S5ts82skW9B726IdSnvske98oZaaYF_kU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHssFvG67aoikaDBww3SufXXQZf88KBlKrG9Qy7JrBFZg&oe=6A70793C"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxamR1aAy1kQ7kNvwGde_KW&_nc_oc=AdoHEhoIe8tqs6wB79vfyBlqklVG1wpmz7Fm2UjCH7-rqNBPz1Eh6G7x-dpx4_rmNL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETXqCqvZ3-dTBc6wBmnQ8PHLS9EiT5KlS48E8LeHyYUg&oe=6A7081DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urYfT8zOM5EQ7kNvwFYJpGV&_nc_oc=Adr4ndhpi3efTuArrYjJbxOlaJ7aDhl1tBwnnaFdI3sNHaS-ZIIFQ8VNQN9y1MV2Bu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvS_gLqGa_gABqpq9NdkK_spwCFwB9yrwsPj-AeD81BQ&oe=6A70835A"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
wC4yybNF0VliHrc2X3JZKQw-lprvajHrCCfk-CVk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BTmnzy25lqf37ePOe1URkNGqwVwpMTr1nfSCSWqzClA&oe=69EF6571"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4gI_YnugXwQ7kNvwHnu2TF&_nc_oc=Adp3wSI5V4zxHwqceoBA9rjdUGwKwgRtD8ieFpRXKXH_LH1m0wMexDniJr2ujrx7R9A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JCGN_Cm61om9airV2D3BMukvI-m2eDBMDUmwR1s2wdQ&oe=69EF60F3"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRBACjqNadAQ7kNvwHxL_Iw&_nc_oc=AdrEVSGULmkF1zAT2boxB4cGT5wbMP2HV5pT5MI_9LKPnIlHYJxL5gr651ICGs0n_TM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PS62Ek-DE0VNtzd9HezMvXZ5iDA0qgwm9o8XNwbqc1Q&oe=69EF7E7C"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nj-ROBT7lSkQ7kNvwGmxjEw&_nc_oc=Ado-hWODpb2AKfsJyaEBY4JEes2KPrlKrTggM7nHmaRK7Tz2s2F_PBi82HDc9NnN5mo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o4Ess7TUCjm0F7wUGBpAXEF9Ozu7bJ0dyLuXnDLU_Tg&oe=69EF4EDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw1Cs1TIy-wQ7kNvwEF_bd8&_nc_oc=AdrrOuzypP638ra-WCHYjFQGI0Jg-vHmBB0jm2RCKBxYBD7MbQgkzO8zqfljjzPYWoE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03D-rUWwn0O5C7WqucmNkTjyem8MoQbvmh7suSMmhreA&oe=69EF505A"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
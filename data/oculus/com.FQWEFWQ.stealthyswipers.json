-2BCJayn5GP5LURbVHJppLTIa2ERD-ktdF0d9WGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BLCv5bK5UVjELPT9i8EjUQFNOtEcVzVd3ALCdJbLktw&oe=6A37E7F1"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V280VvFJhR0Q7kNvwEYj_hz&_nc_oc=AdoC2PwW52j6jO0TAut72eRTfP6SFe7X3ZKb5oMai5mfHSBcmMH7OaWsPOFsp-8ttP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kYr16VHjSBdNhVtfxJm0csAl__nSlanMffoiOT1djQg&oe=6A37E373"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU3NYElkOV0Q7kNvwHLT-SA&_nc_oc=Adq3jsuprs5S34x21kGNdDm8Nr-_wdjJBBDTDWqWVGAZBsBqttsSfZ1H726MSG0XJEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fO4KwBBmrFnq-iNmQM7chbtU_zfJmmLOB1vcHF3b4tw&oe=6A3800FC"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqZJsyp_cuAQ7kNvwHLrcgU&_nc_oc=AdpERiK9FqbyZPkGJYykcZ-5dKS3ligT_hCB2Co6BKWKr68_al0g6YA4pW_2OrLxBCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nCFlDl2r38kEQaX0Pa0rbq63z2lpCmG6Vc3db14Q1UQ&oe=6A38099D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhQLviTp7hIQ7kNvwEnyrr8&_nc_oc=Adpvh2fHaUEyay4nT_4jJlP9v51CI1pGIWlAWz81esTkH6-tKzVcVj_4tdiZbxYgw58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8fNJ2-mnu65H-w5gAEgzvXeKSY360wqKs5IlNnREvRA&oe=6A380B1A"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
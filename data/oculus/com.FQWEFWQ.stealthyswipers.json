OV-ZoJlS0lLnkubRlG_o9C_MHx9sj8dEFzpweF9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53YX7B8Yi83Dm3JmyTi8gBmSmQr-6Sd2f6ztQWCat7Uw&oe=6A1EDB71"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e3DNFC34y4Q7kNvwFn2OBi&_nc_oc=Adp6I6pxbg13CYyVhRuWTzMUs_S-kf63Rxem0bdeo5Pd17ME5GoHMyaV0U0fjRdWW-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uj4uPTDl0IWBl8CWRB-1_ET4nWxml40SAR3yGiANjkQ&oe=6A1ED6F3"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ONr2tyNlLcQ7kNvwEi8Lh4&_nc_oc=Adpn8yo6YO37uy1xIRmVGeuAmwzP03UtJ5vBi922mMHQwA94M1v5iyt7MNqFqVhCKt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49UaqGkEWYbgc3tpglBE8zeMTBHoZRRjWPZMh7B0iGBA&oe=6A1EF47C"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xtVbW25fgoQ7kNvwGujZYS&_nc_oc=AdqxyyavW4Ir0X803ndEmyt_p8MQGwt6wY7YyycrKd1e3Lsj8OuSRTuXPcvmpmJGthc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43Vo4NehQpXsKuCM38IhoGyqtBrniggTFgQnrMzq70Vw&oe=6A1EFD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbAmT9ukaZ0Q7kNvwFe1qYL&_nc_oc=AdpPJu0yvFBBq_Vfow2n_WnJQT1_0-fHZ-FIfZGuudYDxRfvnNd-bbtNtGXd-ONLJb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RN-Gkw3wjMimFwyt46fGTuVL7e4jng7pUZr15ehwiCQ&oe=6A1EFE9A"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
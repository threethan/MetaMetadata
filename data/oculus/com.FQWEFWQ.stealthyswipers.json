U__0_thstZpT6gHykTJmG8yZz9WMcu-tZF5_grJf3qTg1ibmjEujQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1JmGrK0MrVBK7TjEE1AvrhLrtzABTyEBht9CxMrt9eQ&oe=6A8D9971"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtQx3zK9lewQ7kNvwHKEYgO&_nc_oc=Adrwz68Oij8F02u7vysrBWtkuHdnbQx_fRt7I_aGq5pmfbV6WU6A2pDhuWSVU4YR4Y4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVqE3y8-MY4L03RubWr_Nvz9V5DTeB1BWN2GNt3mPYDw&oe=6A8D94F3"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RPoqtv9QQQQ7kNvwFjPPXx&_nc_oc=AdoIpMzBoFuHL7HpQjuSO1aK6R6MCfOM-oDPmcmzvYfiP3F8u5l0LFSPYdI4wp90KCo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvwoe1n310gDKFFEBsPyxFzOpSjgtNOgDZxKDXsmv03A&oe=6A8D7A3C"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Si44GIJPkGEQ7kNvwGTP0W9&_nc_oc=Adqm33F-p80wBe0iAib6ckeEKo7UFu_LW8hcGamkIqRL12PzQU2cmsYVbnnCEDA8JHI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0LEykKqnq3x1dPI8SQRYs9o7IqoaxI1coIbeCLmo-6w&oe=6A8D82DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeW--3cCat4Q7kNvwHP2Xjp&_nc_oc=Adp_fXOr8RFbRl19J2Pp4xzmNAA_Y3tZmIsU-YKOE6CpLqAltD3Jn9T_yL00KVDcocw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG45weTurM--oKYd_o2k_gB2TyGdPBIkRJO10NjrEGO_w&oe=6A8D845A"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "inter
J_yjF1K7r598MU32YLNPH-u7CtOARfYfxcp-Z3ao&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyahMo1LXisZOQSoRUESTFJl7FW3QB1YgzbtjfjjQwdsw&oe=69C7D871"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jDfXqaTtWoQ7kNvwHjytlv&_nc_oc=AdpvYBs_pdzVeARTDMmKDeecfhSeUPwt5hNcOpn2jCMpPTv8oA-iUz34x3DYppknb9E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZtxmycX9D6rHM8or9esxqV88FX6kTNbxReYTrlkYqng&oe=69C7D3F3"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpKAG0t57XUQ7kNvwGIEg9A&_nc_oc=AdpvBIjg5voHJQ8PBE7lEkh2H20kMM5f0dgdThlprVfphUpmkUdxuLc9V8rHIVovAbY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQLKBaiaYiPYDMnLOzjCz14Mwf5AYrl0bJvECA0BstrA&oe=69C7B93C"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcXHLRKNVusQ7kNvwHLlMaC&_nc_oc=Ado89vzeu2DdyiRsPHvodtAF9ZuChH__yEiQDBebgBfcs2pKlXEru8ukAtaGNQ7yfhA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwruZ7DyK8NgIq15TWJ1umO87m6cW4uukgK6-gg8-p8Ag&oe=69C7C1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRPret3eJ-UQ7kNvwEsmVsO&_nc_oc=AdopOGFiOjzsmZ6m11ByVrYV0SUMfahMAQZVFgFGA1X6hrq0ZHKj-ma47mOXqnOaIdU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNY_8LUYbtnjgnVswzwpFiiafvBthQOMLX9U5mzYNcZQ&oe=69C7C35A"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
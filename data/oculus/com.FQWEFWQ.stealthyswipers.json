w9rJmIfw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfypXZQr6zVZuCGFe2wbeYCPzicSFM1DtH47UH1_a-5VYw&oe=69BD4C71"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HrJf6YNdK4Q7kNvwHcG9Qq&_nc_oc=Adn8_9Ey9VU3-moDRV6cyrP-kxjapdwWESk0RCO7k_iQMVYKyOetpW--0LfZZ5OiwAs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCdXkOUyUI1ZqYv2YRvVAakeZYrpBWXvNydqes1iqjPg&oe=69BD47F3"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vrpT9UDL_gQ7kNvwGVq902&_nc_oc=AdnSgGzhDXqrNqZybfJN7RpQaEdXMJaTOr8YhC8qLPSI_bWSSivioFc3LQvqPISXY7s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_BJVQYqXnDb9Svs4curwuYXw9ueOGl-V88aGUAugHaw&oe=69BD2D3C"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQ9jaRA_4NIQ7kNvwEm2-5d&_nc_oc=AdnDOSprrtwM79pOu7UWonkiPgCWJSn5w2dzDjoI-H_5o_y9JC3NmW--_bcr-LC2M4s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyllIMHKMANPt2VWv-g94HnIq_EaDtEBKPz9thx-7oXPg&oe=69BD35DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj6IOf4eQ4wQ7kNvwEmrj1s&_nc_oc=Adkb7ZULqo8uR7f10zuJzqruaoM11cUZQeRxNmJDLJ-OSfnTha-xszj0BmOstH44elU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbSAb131tmzxeHfmWGWMJkG6F2xjzDbMVQLajPFSJwcg&oe=69BD375A"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
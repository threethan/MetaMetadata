fWUe689M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhC8ZByadt-_VdUgsY5L44L4zF5OKqe5JwDAZdA21C3Q&oe=69B01D71"}, {"file_name": "ss2.png", "id": "448788341371442", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_448788344704775_629309233119315146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGuxGR9U88UQ7kNvwHJ6nm5&_nc_oc=AdmFHV7FNzOY7zpnGR18yXBwGVPnjKuA_qmWyqMqwRKY3NmGVL3yZstBcyE6BgL-Ct8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjwrfCkZzQliVm-pAenX60xc_Gj7_TcAzC3pHxgkX8_Q&oe=69B018F3"}, {"file_name": "ss3.png", "id": "1695566267856585", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031545_1695566271189918_7563581897204183653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXizcI4WCsQQ7kNvwElzP3x&_nc_oc=AdkS1K30QWzJkWZNhONHQtSJAVSBUniZs4NXlHN0Uqf1HykvAPR7zRcrrs4qeXNIA3M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB34jZav5d4yE076GgjF8Q8d503rGfijeexSK1DYckXQ&oe=69AFFE3C"}, {"file_name": "ss4.png", "id": "3751167238508534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001725_3751167241841867_2951941851866511973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3UqjLCZ6d8Q7kNvwGfCadl&_nc_oc=AdmySgj0gqhLzsQxynuTg1XIqUxLSTg4y5M6mag7x6sp9Zz5GGTg703CaMlTEc01bh4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAB2j23JoV1UUEJLHg8_ogDhvkWXBGc6wEqhlInyO-jw&oe=69B006DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1691892224915749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580056_1691892228249082_8993988736869608245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19TpPEx4rIIQ7kNvwE6qpdQ&_nc_oc=AdmsAujKeFSPpPmtUJyAvidHQ8wQ-0OBCe4BgIKs3lUTdXOZK1_-zGZkPuNlzQrlrHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyS4pH9m8cFRcJIjBh2ktFif9h0QW94KzWqAiajKVE0og&oe=69B0085A"}, "display_name": "Stealthy Swipers", "keywords": [], "long_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience.\n\nGame Features:\n\n    Immersive VR Environment:\n        Experience a meticulously crafted, enormous space brought to life with state-of-the-art VR graphics. The game environment is designed to be visually stunning and deeply immersive, making you feel like you are truly inside a high-tech, futuristic world.\n\n    Stealth and Strategy Gameplay:\n        Engage in challenging stealth gameplay that requires careful planning and quick reflexes. Utilize shadows, create diversions, and use high-tech gadgets to avoid being detected by the vigilant room owner.", "short_description": "Description:\nImmerse yourself in the thrilling world of \"Stealthy Swipers,\" a cutting-edge VR game where your mission is to \"borrow\" valuable items from a vast, high-tech environment while evading detection by the colossal room owner. This game combines intense stealth mechanics, strategic gameplay, and a rich, futuristic setting to deliver an unforgettable virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stealthyswipers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FQWEFWQ Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/stealthyswipers", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
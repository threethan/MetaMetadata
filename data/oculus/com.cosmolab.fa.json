?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykflEvHkQqsQ7kNvwGZAxmM&_nc_oc=AdoXS6AOyP6wKRlxL4Z4TVOE0qBWpx1_6_3ujBr3lwLWfsVjq2DpyqUPtxuWempDblY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2q_A2_WQe7S6Oz0et_b-qhS9SRiEzT_iHBg5OezFpZg&oe=6ACB91FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440 (1).png", "id": "10076092479135804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499344581_10076092489135803_2034410084633967134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoA9joz-_xoQ7kNvwGVTqB0&_nc_oc=AdoTZBFfZmryT-QQHSwVYqQPycrts9nUG33lBhitu1FugKlKBQ3L8GEJ0_KJVysJnrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVd7D0DAsDwSAD_qwDBxkndZjXccMnhKksYA9jfuqwSg&oe=6ACBC3DD"}, "display_name": "Fishing and Aquarium", "keywords": [], "long_description": "Welcome to Fishing and Aquarium: A VR Adventure on Land and Sea\nFishing and Aquarium offers a truly immersive VR experience, where you can not only enjoy the calm of fishing but also take control of a boat and explore vast, beautiful waters. Whether you're looking for a relaxing day on the lake or an exciting adventure on the open sea, this game brings both to life.\n\n\n\nCatch the Big One \u2013 Fishing at Its Best\nStep into stunning environments where you can cast your line and reel in fish in a variety\n{683962304497537}\n{1615393262457729}\n{1403871140803974}\n{1081225640488679}\n{1015421610570142}\n{1905198440241747}\n{1611711109491630}\n{2830615983789262}\n", "short_description": "Fishing and Aquarium is the ultimate way to enjoy both the serenity of fishing and the thrill of boating, all while creating your own beautiful aquatic world. Whether you want to unwind or embark on a new adventure, the game offers endless opportunities to explore and enjoy."}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/fishingaquariumprivacypolicy", "developer_terms_of_service_url": null, "pub
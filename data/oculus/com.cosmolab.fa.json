610570142}\n{1905198440241747}\n{1611711109491630}\n{2830615983789262}\n", "short_description": "Fishing and Aquarium is the ultimate way to enjoy both the serenity of fishing and the thrill of boating, all while creating your own beautiful aquatic world. Whether you want to unwind or embark on a new adventure, the game offers endless opportunities to explore and enjoy."}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/fishingaquariumprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/fishingandaquarium", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29751445317803098"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825052_1748609589097441_9220633523675128137_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_DpaaSEYpcQ7kNvwEnmAoK&_nc_oc=AdrJ8T0rw__g76oxFOkhjPKzEyXYeQggvlftMt0nx8WHJzmiGHjo5b3biz5cXYu8VWY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLLbo7HT5Sk8SGMJ_Dtb2FhQGLHTRxsgD1_Wp2Al1OVA&oe=6AFB46A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fishing and Aquarium", "platform": "ANDROID_6DOF", "context_category"
25226839_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhoLukex5vgQ7kNvwHGRG9L&_nc_oc=Adq1dwFGsR4MkihAEK5NLWHBdtgN_JLj_gYUxkY5_VBrqXe4mVoH7D3H-px7XUgNe4E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh7Kv-CnmcjV1ZB4ES5mUwjzoVLxbcJQ-dc44NC8BlLw&oe=6AFF243B"}, {"file_name": "Screenshots2560x1440-2 (3).png", "id": "705607578528243", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820366_705607581861576_6504158868297293076_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M752lF9Inh0Q7kNvwE7Q3l-&_nc_oc=AdoQtK6_O6UcJqu-SwuKQL0R9hB4FKp0uvLEUW4LlZrUbi_qqgkizlHEzc322eUP1f8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXFYYOk3h0xJ0-XodbNPwdkaLm1CXEEYxoCWfoTOIsPA&oe=6AFF34BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440 (1).png", "id": "10076092479135804", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499344581_10076092489135803_2034410084633967134_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiJeEoT6yIoQ7kNvwFzXwEc&_nc_oc=AdrLzyjcMXOxQurDL1foKI6eQ7pvDOJ-OR8LT0uFu0vdHaNAtNPgc9NP9wOHWzzhD-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOdX_sVxKz2QGZrQOurkP8m_imYGeSFG37opTaOj2E-w&oe=6AFF2E5D"}, "display_name": "Fishing and Aquarium", "keywords": [], "long_description": "Welcome to Fishing and Aquarium: A VR Adventure on Land and Sea\nFishing and Aquarium offers a truly immersive VR experience, where you can not only enjoy the calm of fishing but also take control of a boat and explore vast, beautiful waters. Whether you're looking for a relaxing day on the lake or an exciting adventure on the open sea, this game brings both to life.\n\n\n\nCatch the Big One \u2013 Fishing at Its Best\nStep into stunning environments where you can cast your line and reel in fish in a variety\n{683962304497537}\n{1615393262457729}\n{1403871140803974}\n{1081225640488679}\n{1015421610570142}\n{1905198440241747}\n{1611711109491630}\n{2830615983789262}\n", "short_description": "Fishing and Aquarium is the ultimate way to enjoy both the serenity of fishing and the thrill of boating, all while creating your own beautiful aquatic world. Whether you want to unwind or embark on a new adventure, the game offers endless opportunities to explore and enjoy."}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/fishingaquariumprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/fishingandaquarium", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29751445317803098"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825052_1748609589097441_9220633523675128137_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ip7mr9kLYBsQ7kNvwGLDEN7&_nc_oc=AdpXkS8nrz9FqpzJE0FqtqPL-ATwnJ84E4FAXUSRpvDCH9EjUyl3PyuEPRTF70twpPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYZFrKVOaAQYOnd2DLov1t4oY_3BylSqRpvRvh7z5j6g&oe=6AFF02E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fishing and Aquarium", "platform": "ANDROID_6DOF", "context_category"
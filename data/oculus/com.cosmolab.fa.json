25226839_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaO0GRA-dlMQ7kNvwEEf-MC&_nc_oc=Adr9jkEhXrtG25xktPOxt2iGBBuEmmO5WurLQolfR-WeRjqpxC6Bg-wKLlpPnf248nU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbgE-Of_CvzGCWOzssTktfRMH3TGSircIgi4jm8iOdQw&oe=6B0DA4BB"}, {"file_name": "Screenshots2560x1440-2 (3).png", "id": "705607578528243", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820366_705607581861576_6504158868297293076_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-MBi3_INTYQ7kNvwG8hot0&_nc_oc=AdpKenBpkxfDLQrBTDOgi6DnGeoHBdfH8tYDy3oicg81-AF-eudHCjCUmk7ueVgsR9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNJ7u2qRayL1DSQioVJ90VNc24DbpPfr2mRAY_pSHNrg&oe=6B0DB53A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440 (1).png", "id": "10076092479135804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499344581_10076092489135803_2034410084633967134_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUtKkjt-Uc8Q7kNvwG4WLd6&_nc_oc=Adqg8M8AP-LgUCFxuaPFaOUV0nDwKcxKxtX0rlBcF845JcS5fLCaNn_OVT7i4XQp9lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJ-wGaD3a9IpDc4vQaOFHT6lvXMCYZ-HA9zUZGE0giuA&oe=6B0DAEDD"}, "display_name": "Fishing and Aquarium", "keywords": [], "long_description": "Welcome to Fishing and Aquarium: A VR Adventure on Land and Sea\nFishing and Aquarium offers a truly immersive VR experience, where you can not only enjoy the calm of fishing but also take control of a boat and explore vast, beautiful waters. Whether you're looking for a relaxing day on the lake or an exciting adventure on the open sea, this game brings both to life.\n\n\n\nCatch the Big One \u2013 Fishing at Its Best\nStep into stunning environments where you can cast your line and reel in fish in a variety\n{683962304497537}\n{1615393262457729}\n{1403871140803974}\n{1081225640488679}\n{1015421610570142}\n{1905198440241747}\n{1611711109491630}\n{2830615983789262}\n", "short_description": "Fishing and Aquarium is the ultimate way to enjoy both the serenity of fishing and the thrill of boating, all while creating your own beautiful aquatic world. Whether you want to unwind or embark on a new adventure, the game offers endless opportunities to explore and enjoy."}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/fishingaquariumprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/fishingandaquarium", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29751445317803098"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_1748609589097441_9220633523675128137_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQOQ1wfEXsMQ7kNvwGAskSV&_nc_oc=AdrBh0OihtkVPraKhQIgDaZdGMg3WVqISmkkfQvCcdVmHlW-bpuVMfOO-ccUkefIP8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSniaXez7YsUF4yfFxLb6k5ryZmDKyV5iZGAKktzYEvnQ&oe=6B0DBBA6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fishing and Aquarium", "platform": "ANDROID_6DOF", "context_category"
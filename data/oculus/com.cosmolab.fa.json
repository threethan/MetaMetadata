633967134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPXzGKALVgoQ7kNvwEYpN21&_nc_oc=Adrwi0oE39YshtDKDhxQGj6NEbS_nJhKmb6kfFE5sTd9yNdjYPHvhsDRgL1NR9PodmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ity6OfQCZgfSKikXjAmQnvsJSAF3AcPoY2hDG9WNJ9g&oe=69E3839D"}, "display_name": "Fishing and Aquarium", "keywords": [], "long_description": "Welcome to Fishing and Aquarium: A VR Adventure on Land and Sea\nFishing and Aquarium offers a truly immersive VR experience, where you can not only enjoy the calm of fishing but also take control of a boat and explore vast, beautiful waters. Whether you're looking for a relaxing day on the lake or an exciting adventure on the open sea, this game brings both to life.\n\n\n\nCatch the Big One \u2013 Fishing at Its Best\nStep into stunning environments where you can cast your line and reel in fish in a variety\n{683962304497537}\n{1615393262457729}\n{1403871140803974}\n{1081225640488679}\n{1015421610570142}\n{1905198440241747}\n{1611711109491630}\n{2830615983789262}\n", "short_description": "Fishing and Aquarium is the ultimate way to enjoy both the serenity of fishing and the thrill of boating, all while creating your own beautiful aquatic world. Whether you want to unwind or embark on a new adventure, the game offers endless opportunities to explore and enjoy."}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/fishingaquariumprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/fishingandaquarium", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": 
8n62vvrA&oe=6A1C52FB"}, "display_name": "Cybercade", "keywords": [], "long_description": "Inspired by the classic shoot at the screen arcade games like Area 51 and Time Crisis. Play alone, with friends, or with strangers.\n\nBlast your way through heart pounding shootouts. The environment pulses with beat of the music. Dodge bullets and shoot missiles out of mid air.\n\nPlay in \"Casual\" mode for a stress free experience, or play in \"Arcade\" mode with limited lives for big high scores!\n\nThe music and sound design for this game was done by Connor \"Singe\" Smith McCurdy https://allmylinks.com/singeofficial", "short_description": "Co-Op multiplayer classic arcade shooter. Blast your way through pulse pounding levels alone or with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1qJyUPkvAMjwRrYZxAVzWKY89XLSUnC-KRVxtLEzEXBM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Benjamin Parisi", "support_website_url": null, "website_url": "https://www.cybercadethevrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "246623914570826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001665_1013189453382920_8119374972182075520_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmyAcF2oTeo
983681_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU61h_d_5iwQ7kNvwEa2Loq&_nc_oc=AdkiruGQt9GThaPEsqbiZImhIq3ML2pXNK61UQngjXewgVx-Mz8UDjgL4vV0HgTxURw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftqhMYvxWCSB-Iy_sPs8UsCDPRoySs7FqqY5caiFFw4FQ&oe=699EE90E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "794467192236517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001665_794467195569850_5716830297491647557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uSqv6aj3i0Q7kNvwEbSTQP&_nc_oc=AdkQaKoLynSdHtZyhZP8wH9olCSIrcXG1_HFv5VzUMLgT18TjZhd-fAgJIcyjT8rX14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvO56xjpSm1v-fT3S0rb5bZPJOEUekNzCaDl0aUq7e2DA&oe=699EDC3B"}, "display_name": "Cybercade", "keywords": [], "long_description": "Inspired by the classic shoot at the screen arcade games like Area 51 and Time Crisis. Play alone, with friends, or with strangers.\n\nBlast your way through heart pounding shootouts. The environment pulses with beat of the music. Dodge bullets and shoot missiles out of mid air.\n\nPlay in \"Casual\" mode for a stress free experience, or play in \"Arcade\" mode with limited lives for big high scores!\n\nThe music and sound design for this game was done by Connor \"Singe\" Smith McCurdy https://allmylinks.com/singeofficial", "short_description": "Co-Op multiplayer classic arcade shooter. Blast your way through pulse pounding levels alone or with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1qJyUPkvAMjwRrYZxAVzWKY89XLSUnC-KRVxtLEzEXBM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Benjamin Parisi", "support_website_url": null, "website_url": "https://www.cybercadethevrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "374404
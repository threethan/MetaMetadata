m/v/t64.5771-25/39001665_794467195569850_5716830297491647557_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qKPKni-m14Q7kNvwEx2m55&_nc_oc=AdpufSWJm1Q6AzMZbEQpw5gvpV2fXgxONF6Qw7m4YiMmTXBs7lO9MnKFJxBkBool60s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7RpOXG4L1HbcjDP3LTq7Twgr-TvGoTlE5YlX1bXSTEw&oe=6B06FDFB"}, "display_name": "Cybercade", "keywords": [], "long_description": "Inspired by the classic shoot at the screen arcade games like Area 51 and Time Crisis. Play alone, with friends, or with strangers.\n\nBlast your way through heart pounding shootouts. The environment pulses with beat of the music. Dodge bullets and shoot missiles out of mid air.\n\nPlay in \"Casual\" mode for a stress free experience, or play in \"Arcade\" mode with limited lives for big high scores!\n\nThe music and sound design for this game was done by Connor \"Singe\" Smith McCurdy https://allmylinks.com/singeofficial", "short_description": "Co-Op multiplayer classic arcade shooter. Blast your way through pulse pounding levels alone or with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1qJyUPkvAMjwRrYZxAVzWKY89XLSUnC-KRVxtLEzEXBM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Benjamin Parisi", "support_website_url": null, "website_url": "https://www.cybercadethevrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "support
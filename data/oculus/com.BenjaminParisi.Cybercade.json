2191_1010684929916983681_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAmtqnw_gcAQ7kNvwGRQnTX&_nc_oc=AdlF_Dgs9z-607H6Z9HXFXChmGhY2OXjv17LJWcl7WBKKR6ZtY6m6ZTJgYDL6QDakjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhZrNXPuoWoAVGZVvT5or0_-84YvtU6EZmRdWjqVIfrA&oe=69A6D20E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "794467192236517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001665_794467195569850_5716830297491647557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7N1EfTN-DkQ7kNvwE1wgi0&_nc_oc=AdnVFkFUv6HqwoMmMC_vKHkOGFkkE5kB2SkalajrdO2iM58pGJewi3kOqGXE2Rg53pI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu73aSoGdy0V25czuRHeCi307-fztG3x_2qgXvZ_s8-eA&oe=69A6C53B"}, "display_name": "Cybercade", "keywords": [], "long_description": "Inspired by the classic shoot at the screen arcade games like Area 51 and Time Crisis. Play alone, with friends, or with strangers.\n\nBlast your way through heart pounding shootouts. The environment pulses with beat of the music. Dodge bullets and shoot missiles out of mid air.\n\nPlay in \"Casual\" mode for a stress free experience, or play in \"Arcade\" mode with limited lives for big high scores!\n\nThe music and sound design for this game was done by Connor \"Singe\" Smith McCurdy https://allmylinks.com/singeofficial", "short_description": "Co-Op multiplayer classic arcade shooter. Blast your way through pulse pounding levels alone or with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1qJyUPkvAMjwRrYZxAVzWKY89XLSUnC-KRVxtLEzEXBM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Benjamin Parisi", "support_website_url": null, "website_url": "https://www.cybercadethevrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489
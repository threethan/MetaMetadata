39_1350622681106172170_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahn7sBCX2zIQ7kNvwGREPsB&_nc_oc=AdqHJqug24jFjNYV255vK1afVc0mkYEinpNOv0ADaes2m1cE3kJepdAYk6j__883k0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af31Pbpq0VEDWaf5j3kuvQGdlWajcoU16g74J4CUweFCfw&oe=69F09DC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESAMTAC Virtual Lab", "keywords": ["Electrical", "ESAMTAC", "Microgrid", "Energy", "Battery"], "long_description": "The Energy Storage and Microgrid Training and Certification (ESAMTAC) Virtual Training Lab (Desktop Edition) is an interactive, 3D-simulation learning environment designed specifically for electrical contractors, journeyman wiremen, and apprentices. Created to bridge the gap between classroom theory and physical field work, the desktop platform allows users to safely practice the assembly, commissioning, and maintenance of high-voltage Energy Storage and Microgrid (ESM) systems in a risk-free digital space.\n\nBacked by leading industry stakeholders across the electrical trades and energy sectors, the virtual lab translates ESAMTAC's rigorous physical curriculum into a highly accessible, comprehensive online training tool.", "short_description": "The Energy Storage and Microgrid Training and Certification (ESAMTAC) Virtual Lab is an interactive, 3D-simulation learning environment designed specifically for electrical contractors, journeyman wiremen, and apprentices."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://go.esamtac-training.org/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://go.esamtac-training.org/contact", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_sub
299928472951502", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303788_26299928476284835_3627816890114955653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKmXtgq06TYQ7kNvwGYJZvJ&_nc_oc=Ado3T81uEizYCi2GrPCAlvfCpS_xxpfODcR-xs3Eu9ao0Qcv9jBMBhXoTXBheHkrlSY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OcazK8Be0s7IcFPsSyIXO2Kf5g-cXSYLWfdd49tXkBw&oe=69F4B24C"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-140052.png", "id": "752247797823522", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301053_752247801156855_7596784158826723237_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qkZm5kUeucQ7kNvwFvjUb4&_nc_oc=Adotyo9eVPkT_eEajAyofVNmMeLrZh1FKauz-HTGCMgI6f4BHX8FYRJNarcBtjz283o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0V3XYnbHD33-Ony639y8YSILyGMxAu_7IGy7-oKCUEmw&oe=69F4C493"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-141026.png", "id": "2042934882919606", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304106_2042934886252939_1350622681106172170_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuv_7VM8_hMQ7kNvwE7xw4O&_nc_oc=Adp8IsjVa-zF3M0zZ-VDA-aZFu8DfitEXvYIv7uZqqshdQCZEVUPM12l_u6BZXrSCQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TCpePKBe9_A_6Z8K5Gd0loLBPcyFJyia7JOhg5OQr3A&oe=69F49244"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESAMTAC Virtual Lab", "keywords": ["Electrical", "ESAMTAC", "Microgrid", "Energy", "Battery"], "long_description": "The Energy Storage and Microgrid Training and Certification (ESAMTAC) Virtual Training Lab is an interactive, 3D-simulation learning environment designed specifically for electrical contractors, journeyman wiremen, and apprentices. Created to bridge the gap between classroom theory and physical field work, the desktop platform allows users to safely practice the assembly, commissioning, and maintenance of high-voltage Energy Storage and Microgrid (ESM) systems in a risk-free digital space.\n\nBacked by industry stakeholders like the IBEW, NECA, and the New York Power Authority, the virtual lab translates ESAMTAC\u2019s rigorous physical curriculum into a highly accessible, comprehensive online training tool.", "short_description": "The Energy Storage and Microgrid Training and Certification (ESAMTAC) Virtual Lab is an interactive, 3D-simulation learning environment designed specifically for electrical contractors, journeyman wiremen, and apprentices."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://go.esamtac-training.org/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://go.esamtac-training.org/contact", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26749810974614595"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1269837144590648"}]}, "baseline_offer": {"id": "1269837144590648"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775136600, "status": "PUBLISHED", "id": "1269837144590648"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26905021625760195", "version": "1.0.0.10"}, "id": "1184533917139074",
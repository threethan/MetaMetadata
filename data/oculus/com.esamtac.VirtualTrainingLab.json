StorageSafety-20260205-140319.png", "id": "26299928472951502", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303788_26299928476284835_3627816890114955653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCMDKEq3IjIQ7kNvwGXc_Sx&_nc_oc=Adp58NKqtGrkeObYLrvQdXn58PpJ-FNjffziuK3RiQ8u8jST3pQZ0AVIalBxw5dBW80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iw_V_mTZ4UKLQKXgRT-tWAFkmKGmHTFiCvAaj4UqM6w&oe=69DBA5CC"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-140052.png", "id": "752247797823522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_752247801156855_7596784158826723237_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYLl5jtEypoQ7kNvwEB4AxQ&_nc_oc=Adpc9nbXQhuahkA7e7uXVnz3I3UtM_VbktuwfwQowv91H6rEdLavJ4jFqDigiOLmdz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Bs_8y3fGU5hmNyh194Rab_OPxjkQAEXhLnRqlCiKREQ&oe=69DB7FD3"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-141026.png", "id": "2042934882919606", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_2042934886252939_1350622681106172170_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HTHNTdFYcoQ7kNvwFkzM1C&_nc_oc=AdpW6YqJESitX8peJAomMOX5dsLcDTnlVL4YLzwD5gFAQdSSsLIoqz3ctNHY69plNZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pFHksd1UiHzxCA0O9cpwKx2oopL60crJaGDNBLDgYhQ&oe=69DB85C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESAMTAC Virtual Lab", "keywords": ["Electrical", "ESAMTAC", "Microgrid", "Energy", "Battery"], "long_description": "The Energy Storage and Microgrid Training and Certification (ESAMTAC) Virtual Training Lab (Desktop Edition) is an interactive, 3D-simulation learning environment designed specifically for electrical contractors, journeyman wiremen, and apprentices. Created to bridge the gap between classroom theory and physical field work, the desktop platform allows users to safely practice the assembly, commissioning, and maintenance of high-voltage Energy Storage and Microgrid (ESM) systems in a risk-free digital space.\n\nBacked by leading industry stakeholders across the electrical trades and energy sectors, the virtual lab translates ESAMTAC's rigorous physical curriculum into a highly accessible, comprehensive online training tool.", "short_description": "The Energy Storage and Microgrid Training and Certification (ESAMTAC) Virtual Lab is an interactive, 3D-simulation learning environment designed specifically for electrical contractors, journeyman wiremen, and apprentices."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://go.esamtac-training.org/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://go.esamtac-training.org/contact", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26865156403080051"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619145_904851996042228_4774604819321537728_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHoDrU46Hu0Q7kNvwGrAcYQ&_nc_oc=AdpyE7OhnZcc2kVDEK1Ee8m9EZ9z-F4Z0Nd52mewDWLME290fVWkKqe1H6OV4CeGXsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AHr4-ZIK4REc5-r5hR6CYnL91l-f0TL
tj-Jblncaj67rw&oe=6A8D7A53"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-141026.png", "id": "2042934882919606", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499304106_2042934886252939_1350622681106172170_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YODNHKyeYaIQ7kNvwEkPkQt&_nc_oc=AdpxuKJXiu-KrvAUujefLMC4Al3zyOHrSmq60el4rvdCHQQbMj1LjttBT7kXXX3_kIY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_H-cPVM1yFL8-amlFP-oLVEYJiNmZyQRaaJMXfTwNTA&oe=6A8D8044"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESAMTAC Virtual Lab", "keywords": ["Electrical", "ESAMTAC", "Microgrid", "Energy", "Battery"], "long_description": "The Energy Storage and Microgrid Training and Certification (ESAMTAC) Virtual Training Lab is an interactive, 3D-simulation learning environment designed specifically for electrical contractors, journeyman wiremen, and apprentices. Created to bridge the gap between classroom theory and physical field work, the desktop platform allows users to safely practice the assembly, commissioning, and maintenance of high-voltage Energy Storage and Microgrid (ESM) systems in a risk-free digital space.\n\nBacked by industry stakeholders like the IBEW, NECA, and the New York Power Authority, the virtual lab translates ESAMTAC\u2019s rigorous physical curriculum into a highly accessible, comprehensive online training tool.", "short_description": "The Energy Storage and Microgrid Training and Certification (ESAMTAC) Virtual Lab is an interactive, 3D-simulation learning environment designed specifically for electrical contractors, journeyman wiremen, and apprentices."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://go.esamtac-training.org/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://go.esamtac-training.org/contact", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "
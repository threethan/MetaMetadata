m, no matter where you are.\n\nFeatures:\n\nMultiple immersive VR environments\n\nA diverse selection of calming background music\n\nBreath-focused relaxation techniques\n\nEasy to use and beginner-friendly\n\nLet Soul Space be your personal escape. Just breathe, relax, and discover the power of presence in virtual reality.", "short_description": "Soul Space \u2013 VR Meditation App: Breath & Relax transports you to calming virtual environments, combining immersive visuals with soothing music for deep relaxation and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TulipApps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9870274909759910"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_1329848718120386_7786672787543660816_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eungnQTqRiEQ7kNvwEd3q6P&_nc_oc=AdoxXaRBIK51ILI_DuKXmhUw9l6BbgHM0o-R6aYkiOf6Yzb1xU7R00ip3S_6RkCgBxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQm6Fb-oCs4UHdPCmUH7_9MZxJDCQK2H8Z2inj-BSQggw&oe=6B0DA0F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
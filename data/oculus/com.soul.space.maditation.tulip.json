3eTqg&oe=6ACE4B89"}, {"file_name": "4.png", "id": "1012706020622259", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819318_1012706023955592_1428692697973769401_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWd7q_0kS8kQ7kNvwFUVVeL&_nc_oc=AdqDclB-ZLMBCl1Ks_Vmk3LzD3ShOoa2t3xc2soLUDWmRZB4AX6kfdkhdg736s0vfy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKoQ4E4ppApr6hc4N_MrzQSF-CeQwBvnxz5fKIldYjLA&oe=6ACE3316"}, {"file_name": "1.png", "id": "1386324062583872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825394_1386324069250538_6193086680006133185_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMUdcM7vi7QQ7kNvwG03bVd&_nc_oc=AdrC9R04ROWh8xBeKLAKlihbF6YCaO6d0Zl2E2I5JA6qPAHiOnGdqLtxzGc_0O_mL4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC9AQSYgENPtmUutqdmVUuVouQmvkVxsHUn7VlVOqzMA&oe=6ACE3850"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Space-Meditation App Breath & Relax", "keywords": [], "long_description": "Find your peace in a world beyond distractions with Soul Space \u2013 VR Meditation App: Breath & Relax.\n\nStep into beautifully crafted virtual landscapes designed to calm your mind and elevate your well-being. Whether you\u2019re looking to reduce stress, sleep better, or simply take a break from a busy day, Soul Space offers a sanctuary through virtual reality.\n\nExplore a variety of serene scenes\u2014from tranquil beaches to peaceful forests\u2014paired with relaxing music and guided breathing techniques to help you unwind, focus, and recharge. Each experience is carefully curated to support your mental wellness and bring a sense of calm, no matter where you are.\n\nFeatures:\n\nMultiple immersive VR environments\n\nA diverse selection of calming background music\n\nBreath-focused relaxation techniques\n\nEasy to use and beginner-friendly\n\nLet Soul Space be your personal escape. Just breathe, relax, and discover the power of presence in virtual reality.", "short_description": "Soul Space \u2013 VR Meditation App: Breath & Relax transports you to calming virtual environments, combining immersive visuals with soothing music for deep relaxation and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TulipApps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9870274909759910"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_1329848718120386_7786672787543660816_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRnSw_Eh4wQQ7kNvwGp0v7N&_nc_oc=AdpnxHoleJrZCZiSZwHT4oxcylfZ7AynPBcC9pOonahsis7-y9YNekUsChjU7jh_xIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn4PfePONcNOixYMwrD16x_gWJTjGpNjbkvW0jcM-1aA&oe=6ACE58F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soul Space-Meditation App Breath & Relax", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1749136680, "lastRevision": {"nodes": [{"id": "9870274943093240", "re
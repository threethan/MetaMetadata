17I3g&oe=6AE4B509"}, {"file_name": "4.png", "id": "1012706020622259", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819318_1012706023955592_1428692697973769401_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odXdP1dlWY0Q7kNvwG6et83&_nc_oc=Adr7eDyVBBwjQhGLSCpBe_EqJevJyRIqjE9X-S2XT_uIgZP6F98j4b0OcS9gkWMVBX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfu_QbVgnXmNvM7rV0QUWZ71GCttsbpfTD0rIAat2maw&oe=6AE49C96"}, {"file_name": "1.png", "id": "1386324062583872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825394_1386324069250538_6193086680006133185_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLeZbYXTrHUQ7kNvwEhONEX&_nc_oc=AdpTre6hQmdz2cqtvZAMluNOfqw5g3weNwvzcViohEAQGeEdMzpy4TMTa-hM_uq-D1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDucAYgr3bxXrcnGzz71zbaR3oEo4BunL85utv237SYw&oe=6AE4A1D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Space-Meditation App Breath & Relax", "keywords": [], "long_description": "Find your peace in a world beyond distractions with Soul Space \u2013 VR Meditation App: Breath & Relax.\n\nStep into beautifully crafted virtual landscapes designed to calm your mind and elevate your well-being. Whether you\u2019re looking to reduce stress, sleep better, or simply take a break from a busy day, Soul Space offers a sanctuary through virtual reality.\n\nExplore a variety of serene scenes\u2014from tranquil beaches to peaceful forests\u2014paired with relaxing music and guided breathing techniques to help you unwind, focus, and recharge. Each experience is carefully curated to support your mental wellness and bring a sense of calm, no matter where you are.\n\nFeatures:\n\nMultiple immersive VR environments\n\nA diverse selection of calming background music\n\nBreath-focused relaxation techniques\n\nEasy to use and beginner-friendly\n\nLet Soul Space be your personal escape. Just breathe, relax, and discover the power of presence in vir
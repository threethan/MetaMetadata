_nc_oc=AdoGAzWJnB4-LVXwV4oBAbcUScvLbskjn9e1E34wLspvNDtSb2kkyxgQV-rlyBvWEy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cGGa7xcmLpbW-S00OcKQwunTHCikG-_5yPOfMBYZAvA&oe=6A202D16"}, {"file_name": "1.png", "id": "1386324062583872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825394_1386324069250538_6193086680006133185_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExMEYTv4XqIQ7kNvwEwxsmE&_nc_oc=AdoLAxB2-194DJ3AdSTCGVcopbSUsJqi6cK4oYlpDZlpYDOZWLG-DyjXiGQphzDJKsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S_7EKD5Z3xq3KzCfeIJ28UDzpX_jj6dEwsaXx5tLJGA&oe=6A203250"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Space-Meditation App Breath & Relax", "keywords": [], "long_description": "Find your peace in a world beyond distractions with Soul Space \u2013 VR Meditation App: Breath & Relax.\n\nStep into beautifully crafted virtual landscapes designed to calm your mind and elevate your well-being. Whether you\u2019re looking to reduce stress, sleep better, or simply take a break from a busy day, Soul Space offers a sanctuary through virtual reality.\n\nExplore a variety of serene scenes\u2014from tranquil beaches to peaceful forests\u2014paired with relaxing music and guided breathing techniques to help you unwind, focus, and recharge. Each experience is carefully curated to support your mental wellness and bring a sense of calm, no matter where you are.\n\nFeatures:\n\nMultiple immersive VR environments\n\nA diverse selection of calming background music\n\nBreath-focused relaxation techniques\n\nEasy to use and beginner-friendly\n\nLet Soul Space be your personal escape. Just breathe, relax, and discover the power of presence in virtual reality.", "short_description": "Soul Space \u2013 VR Meditation App: Breath & Relax transports you to calming virtual environments, combining immersive visuals with soothing music for deep relaxation and mindfulness."}]}, "developer_name": null
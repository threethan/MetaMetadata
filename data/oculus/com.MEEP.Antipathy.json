AKDET0CuRPhGYNBjENVMTb3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WHoCZ8bE855G5QsK67HzSDhJz44WBNeD0D1mMhtpEsg&oe=69EA3875"}, {"file_name": "MAIN_Custom..._09.06.2025_03-01-55.png", "id": "3986907368235059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820382_3986907371568392_2803077154689841515_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV5aMsok-E8Q7kNvwFZ0wJe&_nc_oc=AdoAnqvFCaF9LKlqIBlG9ScjCbhLVgYUu7RitJOHm41oI0mopW-dzzrzg7mFPEa2GvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hD4862FxNT1CO7PelB18YHZH0VRzZYTtOSBuSLjoeSg&oe=69EA104D"}, {"file_name": "MAIN_Custom..._09.06.2025_03-02-38.png", "id": "1218408996148546", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304988_1218408999481879_4804634123234029152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zF_0JCdKUMQ7kNvwFDbNcx&_nc_oc=Adq9Wvil54g27qhoxGFlbfp5i0bNxTsyVsY-O4FSnIXI7TULpCK48PP7OfI7BP4NxHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CDr1pBWiiwEjIDvTAHrrWpp_AQlMcVJzPTZXaiH7NTA&oe=69EA35A9"}, {"file_name": "MAIN_Custom..._09.06.2025_03-03-21.png", "id": "611304581342721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300678_611304584676054_4693097290742978908_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49cgNKPLCE0Q7kNvwE_o5Ao&_nc_oc=AdorJFPfxCkfHy9xrnPZdXhh4_Aou-f2Pjs13U63Y2z2ddzd0PSAGJREcjaAZx87nCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g_gk2YOioaQhhE8FJG8F30UhjQr4jj7WPKdBigO9lhA&oe=69EA1FDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Antipathy", "keywords": ["Backrooms", "Horror", "Fun"], "long_description": "Antipathy is an immersive psychological horror game set deep within the endless, unsettling world of the Backrooms. Thrown into a maze of decaying office spaces, stained carpets, and flickering fluorescent lights, players must navigate through a series of increasingly bizarre and hostile levels each more twisted than the last. But in this place, you're not alone.\n\nStrange, malevolent entities stalk the halls, and the deeper you go, the more reality begins to unravel. Sound plays tricks on you. Walls shift when you\u2019re not looking. Time feels broken. Every choice could be your last, and every shadow hides a threat.\n\nIn Antipathy, exploration and survival are key. You'll uncover cryptic messages, strange artifacts, and fragments of a forgotten story buried beneath layers of fear and madness. With each level, the environment grows more alien, and your grip on what's real begins to slip.\n\nDo you have what it takes to survive the depths of the Backrooms and confront the hostile force at its core? Or will you succumb to the growing hatred that permeates every wall?\n\nWelcome to Antipathy.", "short_description": "Antipathy is a chilling Backrooms horror experience where reality fractures and survival depends on your wits. Navigate endless liminal spaces, eerie silence, and lurking entities as you uncover the sinister truth behind your descent. In Antipathy, fear isn\u2019t just a feeling it\u2019s a presence. Will you escape, or will the Backrooms consume you?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/antipathy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Time Level", "support_website_url": null, "website_url": "https://sites.google.com/view/antipathy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
ctive.\n\n\nFeatures:\n- Realistic car handling and physics\n- Smooth 3D graphics and immersive sound effects\n- Endless gameplay with increasing difficulty\n- Reward system for high-speed overtakes and near misses\n\nShow your skills, beat your own records, and become the fastest driver on the road in Highway Racer!", "short_description": "Experience the ultimate thrill of highway racing in Highway Racer! Dodge cars, overtake at high speed, and race through endless roads to earn rewards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28870764442581271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_1135512442269406_6012643228628650709_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nP5lFHLEQHoQ7kNvwFipGgo&_nc_oc=AdraNCSfZzy3vz15x2r4YiG1tPw-DVGDzV4kL3Co_Ci_7ASf_cNJPGBEDdSyCTW30Bg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj1DV4CAXNjxMg4ljQF7YqCgIrTnL1Y2jMtTmGV1wJKg&oe=6AF0A954"}, "is_concept
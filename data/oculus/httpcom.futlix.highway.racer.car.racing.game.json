Get ready to hit the road in Highway Racer, the ultimate endless driving experience! Drive your car through highways, overtake heavy traffic, and push your limits for the highest score. With smooth controls, realistic physics, and stunning 3D graphics, every ride feels intense and addictive.\n\n\nFeatures:\n- Realistic car handling and physics\n- Smooth 3D graphics and immersive sound effects\n- Endless gameplay with increasing difficulty\n- Reward system for high-speed overtakes and near misses\n\nShow your skills, beat your own records, and become the fastest driver on the road in Highway Racer!", "short_description": "Experience the ultimate thrill of highway racing in Highway Racer! Dodge cars, overtake at high speed, and race through endless roads to earn rewards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/futlixgames/privacy-policy/meta-oculus-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Futlix Games", "support_website_url": null, "website_url": "https://sites.google.com/view/futlixgames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28870764442581271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673536876_1135512442269406_6012643228628650709_n.png?stp=dst-png_s36
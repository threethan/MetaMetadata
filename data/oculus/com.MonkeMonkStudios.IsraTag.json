9Cc-Wl_aeHOalJU1Fl3M-mf7jxp8v33JuOse8k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fW_dE-yVVt0z4bF_7IcououJbE4lN0xvUCb-SzF4WSQ&oe=6A26CBEA"}, {"file_name": "Screenshot5.png", "id": "1417053290221321", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819982_1417053296887987_2421793505203255986_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zR2ricNnNgQ7kNvwGQWvwo&_nc_oc=Ados5_fj0dovUQf8_Pp-YTboYzqOPKyVQa7nN4obOBBguolDZfqHrGmKEVY1NIapM2I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rxs-OuhcB0EcWtzVfXZ8-SlderxHi2g7TcxcPCSbhlQ&oe=6A26D7A0"}, {"file_name": "Screenshot3.png", "id": "1331948568821358", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820496_1331948572154691_6563794877907738073_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkqYPiJ8LQkQ7kNvwHXuI0x&_nc_oc=AdrA74gqZ2-IiVSpzfs4cvJ0QG_5uaAkqUgguGQ1VAmAA3VFHNh_ztT3hYwXO_nkvKE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vonq-abDLV7nchBn_UyMGQSfLsBN_Yl5CrxTAnOdJBQ&oe=6A26EB44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IsraTag", "keywords": ["IsraTag", "Israel", "Tag", "Fun", "IsraelTag"], "long_description": "**IsraTag** is a VR fangame made for Israeli VR lovers who enjoy fast movement, climbing, and exploring with friends.\n\nStep into a **big forest map** built for swinging, jumping, and hand-based movement, inspired by the fun and freedom of classic movement VR games. Run through the trees, climb around the environment, and enjoy the simple, energetic gameplay that makes every movement feel exciting.\n\nThis is just the beginning \u2014 **more maps and new areas are planned for future updates**, giving players even more places to explore and play together.\n\nIsraTag is built for the Israeli VR community and fans who love social VR experiences, movement-based gameplay, and exciting worlds to discover.\n\nGrab your headset, enter the forest, and join the growing community of Israeli VR fans in IsraTag.\n", "short_description": "IsraTag is a gorilla tag fangame for israeli gtag lovers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1y7AtbsC6AlOl9UtQjUThBnlKzQpV6db_xOXB0Dsek_c/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MonkeMonkStudios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1eiQmNJaI4o7adtymhECkmm5lPXaYO_c-w0NTCCgnlfM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "26375944475359214"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821719_2227686237975610_6046694270542653395_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7DFK-d3bk0Q7kNvwEgJKfQ&_nc_oc=Adp2RRM6eOqQYGuNO1wsr1i397rPHiIb1o7syHNegPbaYSf4CwA4Lp34ntRp81N-rzo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sratYcYp-uZBZmZQTtwVM08MbLoBybaCWQohZ0JpSVw&oe=6A26D6C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "IsraTag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}
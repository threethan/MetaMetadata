WnVOfo0DYWUaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YqxnbZtN6lqEay5A8Cv3UF0gfFbXrReyp6ypW7yNrPg&oe=6A3E9528"}, {"file_name": "Untitled-1Artboard-3.png", "id": "372666091137202", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_372666094470535_3307308553942750494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTVarUMwsw0Q7kNvwGiEklm&_nc_oc=Adph8DzHvzF_15GZaIqbTNR-vo34fR2fBCKMs0nfAYsbWJy8EHDkyjQOULxofUj_cd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XRni9TlBrbvde89BlCm248IyxPAJr2RMWDIvV9lIByQ&oe=6A3EA3EB"}, {"file_name": "Untitled-1Artboard-1.png", "id": "1051401865415975", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572957_1051401868749308_5367370891318206744_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Vyqd9uMF28Q7kNvwEJLg0I&_nc_oc=AdptZrZ-GqyerpZ9hiO1-Gzcr9_R79GyjMYBDMnS-XIdsarD9V1AVsbcyLklJf2qoys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U5jUvpS0p_laXOP19QQhlNvlFa_SUlxvmR88PZllksg&oe=6A3E98F3"}, {"file_name": "Untitled-1Artboard-2.png", "id": "726310185043466", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86796156_726310188376799_8716500588093256576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c75OhOgeifMQ7kNvwF6ugPL&_nc_oc=Adq9lmYvK1Gv_RpnJJLrxGj1YtAhr-cAw_dSFxd4cgCN13ciRfWej2Pjfu64jTffP_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CBWiZ2s_AeTxYiMwSQemJKQVCxQLCUjFZcE_XijE-FQ&oe=6A3E9B3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jousting-oculuszdjecie-w-tle.png", "id": "1101975417031636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982658_1101975420364969_4891128562063501818_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ8jT_J_Rk8Q7kNvwFKYDbY&_nc_oc=AdpTi6cEDze3BjuegGspdZ9LNRGNhwGaFZRSWrMozozMYvnHrpy9Hqz9TaIdmpAJuMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Hkev6n-zIqtG7bFwgWpfmdjtmSD82tzidFcg5OGsGFQ&oe=6A3E7C04"}, "display_name": "Jousting VR", "keywords": [], "long_description": "XIII century, Europe, royal market courtyard. You are a knight who joined the medieval tournament. Your task is \"simple\". Jump on your trusty steed, grab your lance & defeat the enemy. Take into consideration speed, accuracy, strength. Equipment is also important. The better gear the easier the task.  Oh, and other knights - they want to win as much as you do.\n\nYou beat them the king's greatest treasure is yours. And I didn't mean gold.\n\nJOUSTING VR FEATURES\n\n- Physics - experience Exciting fights based on true lance fighting physics.\n- Progression -  Knightly tournaments in which only the best advance to the next stages.\n- Challenge mode -  Smash hanging items. An exceptional aim helps you hit the target.", "short_description": "Welcome to medieval times. Times of Jousting.\nYou take part in a grand tournament competing with other knights, for fame, glory, wealth and to win the king's niece's heart.\n\u201cTo risk life to save a smile on a face of a woman or a child is the secret of chivalry.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vraar.pl/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "Vraar S.A.", "support_website_url": null, "website_url": "https://vraar.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7430561966
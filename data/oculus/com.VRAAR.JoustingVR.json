8553942750494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jERXNBpt-84Q7kNvwFtvKhH&_nc_oc=AdlsORAaWnJySGJzPaF3PT2RJN_Ezpdm-HzP2MnFVAYqjpQwHEyQI4augANHo0k1NGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftf1jsTq_rFWR2EFGHllsPBO9XnwQ2nYFBWkX2Y7iE-gA&oe=6999A02B"}, {"file_name": "Untitled-1Artboard-1.png", "id": "1051401865415975", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1051401868749308_5367370891318206744_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqqF6BJpuRsQ7kNvwHO5k3b&_nc_oc=AdlMQ3HLUp3pymDvhqtIgt3p6eLg7Vg2XXgXAObVqXigjKlAX3T3N9p2eT3iJvz8-u0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumNKJZJDgpOjzKjTETXaUA61-MMgMZR3I-TpE4DCcd1Q&oe=69999533"}, {"file_name": "Untitled-1Artboard-2.png", "id": "726310185043466", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796156_726310188376799_8716500588093256576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw-4j4c5edUQ7kNvwEqJaQh&_nc_oc=AdmgOfIrKs0S6SNsB3j5V-JKO3FtpG1cxfWgb8-kyIjxXpgToO7ZcDxMjCxDjglbPAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVAcLsqpo-UE_x5yhUurfh3d_0M2hBe910-t5euoXc9g&oe=6999977C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jousting-oculuszdjecie-w-tle.png", "id": "1101975417031636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_1101975420364969_4891128562063501818_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVDt24EBJ3kQ7kNvwHs0wtg&_nc_oc=AdneBafXeMwd255aHxamaoVQPNliXYL053ppp3srOZVcGiq5i2Kqf8Sf82Ucu8WPKXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsb6ynMMO0f6vD_BFDX7llvgMazpX-D13Je2nT2AXwsFQ&oe=6999B084"}, "display_name": "Jousting VR", "keywords": [], "long_description": "XIII century, Europe, royal market courtyard. You are a knight who joined the medieval tournament. Your task is \"simple\". Jump on your trusty steed, grab your lance & defeat the enemy. Take into consideration speed, accuracy, strength. Equipment is also important. The better gear the easier the task.  Oh, and other knights - they want to win as much as you do.\n\nYou beat them the king's greatest treasure is yours. And I didn't mean gold.\n\nJOUSTING VR FEATURES\n\n- Physics - experience Exciting fights based on true lance fighting physics.\n- Progression -  Knightly tournaments in which only the best advance to the next stages.\n- Challenge mode -  Smash hanging items. An exceptional aim helps you hit the target.", "short_description": "Welcome to medieval times. Times of Jousting.\nYou take part in a grand tournament competing with other knights, for fame, glory, wealth and to win the king's niece's heart.\n\u201cTo risk life to save a smile on a face of a woman or a child is the secret of chivalry.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vraar.pl/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "Vraar S.A.", "support_website_url": null, "website_url": "https://vraar.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "743056196616504"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5279537075485442", "version": "1.1"}, "id": "4873104572737866", "channel_name": "LIVE"}
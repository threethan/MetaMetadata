8553942750494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMj1vo9lhssQ7kNvwG_TAlv&_nc_oc=Adny6pY_CnOZrQw_JSmd5kxHkKxal2dkl6AeWRvoCXsj9IHFanVCWZbAr-AzzAgwZrw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfthKOA66RQqEwPaMSMdLBtb0hf7ed1AdJBMFvsxYJt5bw&oe=699D94AB"}, {"file_name": "Untitled-1Artboard-1.png", "id": "1051401865415975", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1051401868749308_5367370891318206744_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fwThWQs9PUQ7kNvwE-okoi&_nc_oc=Adk2YgVuNKTrjAXopE59JlL3dWLOiwLe0U3wagNrexQRXyQ7IoArtaMF3SoohPaeHwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthHLF0gtSO5lfTZKsDnPFduW9cfGHrVldr0xqkIN9IVA&oe=699D89B3"}, {"file_name": "Untitled-1Artboard-2.png", "id": "726310185043466", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86796156_726310188376799_8716500588093256576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUCn39Z7h98Q7kNvwGPvV7g&_nc_oc=AdnUUGyu2yaPtK3IPdxuXYtzi1zqZno83ZWk3TAIFjX38po7nz15uexi6AG0SdEwHvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsryvKqFAZ90u44DTOebVd2fErW95GvDXGnQK5bDeCuvQ&oe=699D8BFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jousting-oculuszdjecie-w-tle.png", "id": "1101975417031636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_1101975420364969_4891128562063501818_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulkY6zVLQJUQ7kNvwFzd5hq&_nc_oc=Adk98AGjkN1dHEFbAYkW15n1z5L7JLRqR9hUc2VfvAr3ImNvt4PMT8YmqCwcv2vkf7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvlZK9dijx7QUvc1dl-SD8ii17xel7NxnyUQKXYWtyZLA&oe=699DA504"}, "display_name": "Jousting VR", "keywords": [], "long_description": "XIII century, Europe, royal market courtyard. You are a knight who joined the medieval tournament. Your task is \"simple\". Jump on your trusty steed, grab your lance & defeat the enemy. Take into consideration speed, accuracy, strength. Equipment is also important. The better gear the easier the task.  Oh, and other knights - they want to win as much as you do.\n\nYou beat them the king's greatest treasure is yours. And I didn't mean gold.\n\nJOUSTING VR FEATURES\n\n- Physics - experience Exciting fights based on true lance fighting physics.\n- Progression -  Knightly tournaments in which only the best advance to the next stages.\n- Challenge mode -  Smash hanging items. An exceptional aim helps you hit the target.", "short_description": "Welcome to medieval times. Times of Jousting.\nYou take part in a grand tournament competing with other knights, for fame, glory, wealth and to win the king's niece's heart.\n\u201cTo risk life to save a smile on a face of a woman or a child is the secret of chivalry.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vraar.pl/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "Vraar S.A.", "support_website_url": null, "website_url": "https://vraar.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "743056196616504"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5279537075485442", "version": "1.1"}, "id": "4873104572737866", "channel_name": "LIVE"}
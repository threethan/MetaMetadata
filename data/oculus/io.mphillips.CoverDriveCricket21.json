dn.com&_nc_ss=7f20f&oh=00_AQRSjBtoUyQq11sbZ9becAptSZu9OM7lMFflerfgTTUDRg&oe=6AFB3667"}, {"file_name": "Screenshot7.png", "id": "2103108419988153", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982464_2103108423321486_7517413477447303216_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4eYDv4diz0Q7kNvwG5SZpX&_nc_oc=AdreEAWcToHYWqWt2ejDlDCrp7D4xrpcD4w4g2xeyOzmbr16xeu98RvxWU9taCz6qSc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfnZVf7KD4ZsAdZdbdGyVi_mQXKbqabwSb7p-Z5kuSUQ&oe=6AFB3B2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot8.png", "id": "243040700766539", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982488_243040704099872_5785704469850769715_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72OoWGYQAo4Q7kNvwGAnHPp&_nc_oc=Adr5X2NhqqhrUWeZSedheXiAP-MSXYrIDShW5WEhJo0pBB76wkfWxhRO3XJa6JZcrbQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_EEBz-5jDoXcDQYwwIdLk7YIQ06eNgmBGxpnz8vhX-w&oe=6AFB2BCB"}, "display_name": "Cover Drive Cricket", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\nCome say hi! https://discord.gg/rFUzN6xbmQ\n\nIncludes:\n- 10, 20 and 50-over games against simulated AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- 16 bowling styles (4 different speeds, swing, spin, and left- and right-handed bowlers!),\n- 4 difficulty levels,\n- Left- or right-handed batting, with vibration feedback based on how well you hit the ball,\n- Attach your controller and play with your real bat,\n- Leaderboards and Achievements,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.gg/rFUzN6xbmQ"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362257109075711"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "884397071202970"}, {"status": "PUBLISHED", "id": "3790252161051720"}]}, "baseline_offer": {"id": "3790252161051720"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "884397071202970"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26173104638969531", "version": "1.55.16"}, "id": "329425231798977", "cha
https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031562_2574774739377554_8395713396078196642_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQSo7BYwuyoQ7kNvwHq_UpZ&_nc_oc=AdllPurDRFhzFd0zeyftoRc1dZtta2EzxcwLLej64fEoaLalHhPam2WY4MQiW-zFbkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz7jfQlxnSLEuwuMmJSe3m5cxPdLKU2ZO-trKcuSw-__g&oe=69B7E8D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1005387954181471", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031367_1005387957514804_7746304874855148402_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7l0XBSg22j8Q7kNvwHQtPHM&_nc_oc=AdlN7xymIn9824piKDtq8D7nwJxvbFLYvZJQApGHSQ1aaHe3kF1eb90rCn4zKD5YOWA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxLTGOMgEHH_3sLydyyjTCfiXmXOLTppoXCAR4bdyLg9A&oe=69B7ECB8"}, "display_name": "Feeding Patient Simulator", "keywords": [], "long_description": "The Feeding Patient tutorial immerses Certified Nursing Assistant (CNA) trainees in a realistic virtual environment to practice and master the skills required for properly feeding patients. This application guides users through each step of the process, including preparing food trays, positioning patients for safe eating, and monitoring patients for potential difficulties.  \n\n# Learning Objectives:  \n- Remembering the protocols for patient feeding \n- Understanding the importance of nutrition and safe feeding practices \n- Applying the correct techniques for assisting patients with eating \n- Analyzing the patient's ability to swallow and eat safely \n- Creating a supportive and respectful environment to enhance the patient's mealtime experience \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to provide proper feeding assistance through interactive, hands-on practice."}]}, "developer_name": null, "dev
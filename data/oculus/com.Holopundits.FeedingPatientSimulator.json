_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9l9khsCZWsQ7kNvwGi84Eg&_nc_oc=AdqbvFcP-ZBVoBJBTubs7K__Aswccnv_YapU-ob1xjFE66ctKZpaFDOnRATXgH2VJqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFBRML9qD4YKZpSUwBW3A8kaEVepWOh25srq_lNQ179w&oe=6B10652A"}, {"file_name": "Feeding_Patient_SS_05.png", "id": "2574774736044221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031562_2574774739377554_8395713396078196642_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZO5MBLWAnwQ7kNvwEfGWVx&_nc_oc=Adoxq4nIGnbkrLU3QDoIo--mAyl5B1HsCJ53CH5MD9Ue2VjfniMZT25-5AjlIaZjrsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_Odg126BEca8adD02DjNfDSArKrRV2avMvAWMmoYVEg&oe=6B103897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1005387954181471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031367_1005387957514804_7746304874855148402_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3eXpvBFSR8Q7kNvwGDvASh&_nc_oc=AdppjgxgSfyjXux2T4CnodAtBWNSIh6xfDY0AiMm3ibwn7MPOJJXyowXR0LlrrBTYac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWPjwru9ERrsaOE9BNmP-fBowo48QgKR9RrPRqGanhDzQ&oe=6B103C78"}, "display_name": "Feeding Patient Simulator", "keywords": [], "long_description": "The Feeding Patient tutorial immerses Certified Nursing Assistant (CNA) trainees in a realistic virtual environment to practice and master the skills required for properly feeding patients. This application guides users through each step of the process, including preparing food trays, positioning patients for safe eating, and monitoring patients for potential difficulties.  \n\n# Learning Objectives:  \n- Remembering the protocols for patient feeding \n- Understanding the importance of nutrition and safe feeding practices \n- Applying the correct techniques for assisting patients with eating \n- Analyzing the patient's ability to swallow and eat safely \n- Creating a supportive and respectful environment to enhance the patient's mealtime experience \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to provide proper feeding assistance through interactive, hands-on practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7564952043613663"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "689701754224814"}, {"status": "PUBLISHED", "id": "848890776576819"}]}, "baseline_offer": {"id": "689701754224814"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749743580, "status": "PUBLISHED", "id": "689701754224814"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10004949532947223", "version": "3"}, "id": "3742347342747829", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinar
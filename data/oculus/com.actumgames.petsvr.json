72578700", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_327457675912033_2821379262425207661_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xrLlMKFpsoQ7kNvwERBtSA&_nc_oc=AdmKAvKmvXPELVBf8bF4ad4U4nhVEmbaNqKnEBcemSH9BaEy_1bsihEvZwmrdl8_q4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzyiJGcgMzT8g_fQRy8peP3sITMjrLIiISXduUZYLjhOA&oe=69B80BD1"}, {"file_name": "3.png", "id": "376269917515224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_376269920848557_8257096419215980972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu9iJaO9H4MQ7kNvwG1JQUq&_nc_oc=AdmKdZapLyQ17UI-Ka0c7bWhe56Gf4LS8wkZCbjkTLfWJBwXKnOu4GNtzZlpMFyiE74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhrMcnk4Hw596DonqIJzVc8OBHOQiESOKbWlWdOi0GQw&oe=69B7F00D"}, {"file_name": "park screen.png", "id": "1356917244739288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031634_1356917248072621_7555016658380422445_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=safER6TolysQ7kNvwGbM6St&_nc_oc=AdnCpRfIQLx5UrERxCrSwoxgmxry2zmP0neTrr8nQgrMR5kOQXgKczQTZyPM6ZErGAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxikYLBxOPSmwm1Zwd0LVvo6ctUVcKljftKeGMdPu-FbA&oe=69B7F2AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pets vr hero 2560x1440.png", "id": "4898704120173794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4898704123507127_7967018392648686203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOEake-P-XIQ7kNvwGjL3Kw&_nc_oc=AdmY8TZVhQez7CcII3hqc_ehCdYs16QBOf-PjnPjMEkV1YwArzrrmuNLJybYKKrYwMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxh8WJWJX_KKhV_bGIjIcOf2fTCpik7DjqxC17pZgHwLA&oe=69B7E21A"}, "display_name": "Pets VR", "keywords": [], "long_description": "Some charming pets are waiting for you to play with them - come and see what they\u2019re up to in Pets VR! \nThere is a lot to do in Pets Resort, some of your duties will include: Petting cute doggo, playing with adorable Cat, making sure that they both have something to snack on and are well rested, walking without a care in the world through beautiful park, playing one of multiple mini games in which you can win special points! \nReady for some challenges? Time for some training! Learn special gestures and instruct your pet to perform different tricks - if you\u2019re consistent it gets easier in time but be aware the pet can also forget some lessons! Reward yourself and your pupil and make it fancy! Exchange points to create your own collection of fun accessories for you and your pet to enjoy. Discover everything Pets VR can offer and most importantly, have fun!\n", "short_description": "Pets VR - Take care of adorable pets in Your own Pets Resort!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://actum.games/petsvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Actum Games", "support_website_url": null, "website_url": "https://actum.games/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8159824190765804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974669_308871547274307_4294041891805706558_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7nif_xex9MQ7kNvwGuz4Wm&_nc_oc=AdmSn1vTp8WkXUVsjscL-N4Q8h2hLMG
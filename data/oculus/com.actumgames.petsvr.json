27457675912033_2821379262425207661_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h87L8vXl1BcQ7kNvwEu92RH&_nc_oc=AdlznXa9DKEPozwLqgDtNAupyJODCDDng-IkfyBrSNMaqcwD7I8hEbXIj67T1FFl00Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuxPuOUGP3IugfhYLbdavGjj0dYiS_RBt4tdpyM6AVxng&oe=699867D1"}, {"file_name": "3.png", "id": "376269917515224", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210889_376269920848557_8257096419215980972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl5MVBbyP_wQ7kNvwFNSiej&_nc_oc=Adnl9yD0WoDOqy91nRALZWNXw2gOW-NEPzW5CI3cOdpbzFF0qon4IN1kRonfCEVOBGk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvdtMps0M5IzmMYB-BYiJ7lW_rCuhX1N0xbL-uKOqnSuw&oe=69984C0D"}, {"file_name": "park screen.png", "id": "1356917244739288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031634_1356917248072621_7555016658380422445_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9XXBZHPoHwQ7kNvwHcYXgm&_nc_oc=AdmJcBA21TdMMLNlNlUJQI9yYRd9tV-zz68HNcuArC9EDSlUJLbVciQB7PPHb63MgAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvLP91FNTMUk8uLbr3ICuiVbQuW4CqBhyBJxbmZwrROUA&oe=69984EAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pets vr hero 2560x1440.png", "id": "4898704120173794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4898704123507127_7967018392648686203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1MFSdCLdMYQ7kNvwGP2UA_&_nc_oc=Admbr6q9Bdq7VwWr4Xs5ePgPboSqXBX0fhdIYTzQ0ZgyIsKparN1O5Jgy_gFnA62xzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvw9aInQKhqAjQhjTKZkSEbQK4lLNW_SkquhU4nQIDtYg&oe=69983E1A"}, "display_name": "Pets VR", "keywords": [], "long_description": "Some charming pets are waiting for you to play with them - come and see what they\u2019re up to in Pets VR! \nThere is a lot to do in Pets Resort, some of your duties will include: Petting cute doggo, playing with adorable Cat, making sure that they both have something to snack on and are well rested, walking without a care in the world through beautiful park, playing one of multiple mini games in which you can win special points! \nReady for some challenges? Time for some training! Learn special gestures and instruct your pet to perform different tricks - if you\u2019re consistent it gets easier in time but be aware the pet can also forget some lessons! Reward yourself and your pupil and make it fancy! Exchange points to create your own collection of fun accessories for you and your pet to enjoy. Discover everything Pets VR can offer and most importantly, have fun!\n", "short_description": "Pets VR - Take care of adorable pets in Your own Pets Resort!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://actum.games/petsvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Actum Games", "support_website_url": null, "website_url": "https://actum.games/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8159824190765804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974669_308871547274307_4294041891805706558_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAUOkCYmd3sQ7kNvwFP3u88&_nc_oc=Adk3qRkHeU57pRqRMtugwbfAA3HwH1Fi4urVTWAyuSHyaT3Du8J3koz0L_mzLWDWvvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftUCFI3zWOei2ffwIPlLmRZUDon
27457675912033_2821379262425207661_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h87L8vXl1BcQ7kNvwG2eWPR&_nc_oc=AdngGdsWBadQ_FSTZNq1HavRs2s34zNcuUeiVLL_q2YsP2dZlEM3N5W20pukZ_D5dEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs_5a4UGcwJf9D9LrEWVxrXH5fQIzSgRJWOc0wDfT6Gog&oe=699B0AD1"}, {"file_name": "3.png", "id": "376269917515224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210889_376269920848557_8257096419215980972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G7TcZbmXswQ7kNvwE8LEbm&_nc_oc=AdnA20Vg6ZpWRfauHhItomx_GVRJ4WpDYEdkwpHmrZp-iQB2XlrOnT3gX2UgLVH_20s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft1A-KS4H9fNoe6bD77khUWuw7jFg7gk3x3iUluggrVyQ&oe=699AEF0D"}, {"file_name": "park screen.png", "id": "1356917244739288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031634_1356917248072621_7555016658380422445_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a74HxE08gc0Q7kNvwE3n4uu&_nc_oc=AdlnO0xdMwKUi2BKkdwzPHBSmp8i-6w62ALDNj_7wdt9PtrF9fRxo5AqG9IIMX6qDj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftXcMdrKgQwj1_jpiHg-hMPOLL2M0R6L_rskF0jqqihTQ&oe=699AF1AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pets vr hero 2560x1440.png", "id": "4898704120173794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_4898704123507127_7967018392648686203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qciUbP7Y4CcQ7kNvwECPJY2&_nc_oc=AdlNK6znFc2_SVQ2uA-97q0K9mH9aZFK_JZNhlt4lHXdzFjAMtaQ2RZYdkXqr3Tx138&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsRIB5tZd6Adp0FlTJg6gfrO5sG_8c75AX_-rc0UDZT4w&oe=699AE11A"}, "display_name": "Pets VR", "keywords": [], "long_description": "Some charming pets are waiting for you to play with them - come and see what they\u2019re up to in Pets VR! \nThere is a lot to do in Pets Resort, some of your duties will include: Petting cute doggo, playing with adorable Cat, making sure that they both have something to snack on and are well rested, walking without a care in the world through beautiful park, playing one of multiple mini games in which you can win special points! \nReady for some challenges? Time for some training! Learn special gestures and instruct your pet to perform different tricks - if you\u2019re consistent it gets easier in time but be aware the pet can also forget some lessons! Reward yourself and your pupil and make it fancy! Exchange points to create your own collection of fun accessories for you and your pet to enjoy. Discover everything Pets VR can offer and most importantly, have fun!\n", "short_description": "Pets VR - Take care of adorable pets in Your own Pets Resort!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://actum.games/petsvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Actum Games", "support_website_url": null, "website_url": "https://actum.games/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8159824190765804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974669_308871547274307_4294041891805706558_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk9g8FKSrJUQ7kNvwHjkP3m&_nc_oc=Adkru4Rk55G0VLDWcF-nIClDZ4naq_fhXvSgDlFpWnHIscuJW_1OJ_-SRy-THVEBijI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftFfDXsTJT3kbP5R2kAeHzAAAyC
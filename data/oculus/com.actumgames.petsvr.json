R0h6IyA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLULVV_NxZ2nElL1Caq2WVGFoU4OoXkH6HDTyrR6c3lbw&oe=6AA3FF9B"}, {"file_name": "5.png", "id": "365263842060951", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75367594_365263852060950_5957144769962234314_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fulWSxVWG3EQ7kNvwHxWzlL&_nc_oc=AdqMrTHmgHQQwFbq-dAyg-SNzmeYoZg05m_WtlWLXrNrWH7b26_IJzXyrRBs6qtombg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJEm5PyRB8hf5wgPmL0szB5rvqANJTlMDEKtJpqksotQ&oe=6AA3F139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_cover_2560x1440px.png", "id": "883590099151840", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974499_883590102485173_7728383173360532782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChxFefU3AQkQ7kNvwF9oaud&_nc_oc=AdoctgICfLwyv3hEji0VZufiEnZ6qh8pp9uchj74qHRXsJnYqQFPcj0jiS7Qczc2f9c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0Uz2OEebk6A5IdIwEv54llfG7RsewJH3DLviID_wEcg&oe=6AA406C7"}, "display_name": "Pets VR", "keywords": [], "long_description": "Some adorable pets are waiting for you to play - come and see what they\u2019re up to in Pets VR! Everyday a pet will join you in all activities such as minigames and when the fun is over you\u2019ll learn about it\u2019s needs and behaviours that you\u2019ll respond to. Is not all in vain - apart from observing the pet\u2019s reactions, you\u2019ll receive points for being a responsible pet parent. Ready for some challenges? Time for some training! Learn special gestures and instruct your pet to perform different tricks - if you\u2019re consistent it gets easier in time but be aware the pet can also forget some lessons! Reward yourself and your pupil and make it fancy! Exchange points to create your own collection of fun accessories for you and your pet to enjoy. Discover everything Pets VR can offer and most importantly, have fun!", "short_description": 
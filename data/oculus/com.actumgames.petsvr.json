27457675912033_2821379262425207661_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VbPCo-pS_YQ7kNvwEwYTPi&_nc_oc=Adn5c4P332yj_7jJZqz_LaA87WYUvcUA1vzPQIy3bTAm7bwU3Q8bP_HLU40XB8e2NoI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftmQAkwCQ95H6h3zBtiucjs03wrub4HeDALL5-eJn-MNQ&oe=69A596D1"}, {"file_name": "3.png", "id": "376269917515224", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210889_376269920848557_8257096419215980972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKrhKp0ISIMQ7kNvwHFcMuT&_nc_oc=AdkJRNO20586dKIDcoSGkAFolLCcFgHb3OJc-JxzeSd1hNcWPji6duOpgYEsPAZWhOE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs3r40B2EViDwmKfjKrvoExQpZdQ-LIia5UZ9nnXAYkKQ&oe=69A57B0D"}, {"file_name": "park screen.png", "id": "1356917244739288", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031634_1356917248072621_7555016658380422445_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIgmzEcL2EMQ7kNvwHiLEDc&_nc_oc=AdnJE_1OsH0NZ8ECQyej5GxMBcRlKDQ1F0q-LJIUXi71IDtkbqrTKVkmt5s39K8-gw0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftrL5maFnrEm7qk0XYGk98NovZ7JOCALL_2rsAVBzX1Bw&oe=69A57DAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pets vr hero 2560x1440.png", "id": "4898704120173794", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4898704123507127_7967018392648686203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ccOcH3TS7IQ7kNvwGSPsNp&_nc_oc=Adkp0L6wHcOBjxcUh9dqSnHK3IHzXWn7eY0KmtWs5XoMpr3-zm9teuNaJ5os5cVGfNE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvbSF0Zi1Q4UqpLNQTDkBTnx5h3tl3JhIhIjGOJh-NV2A&oe=69A56D1A"}, "display_name": "Pets VR", "keywords": [], "long_description": "Some charming pets are waiting for you to play with them - come and see what they\u2019re up to in Pets VR! \nThere is a lot to do in Pets Resort, some of your duties will include: Petting cute doggo, playing with adorable Cat, making sure that they both have something to snack on and are well rested, walking without a care in the world through beautiful park, playing one of multiple mini games in which you can win special points! \nReady for some challenges? Time for some training! Learn special gestures and instruct your pet to perform different tricks - if you\u2019re consistent it gets easier in time but be aware the pet can also forget some lessons! Reward yourself and your pupil and make it fancy! Exchange points to create your own collection of fun accessories for you and your pet to enjoy. Discover everything Pets VR can offer and most importantly, have fun!\n", "short_description": "Pets VR - Take care of adorable pets in Your own Pets Resort!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://actum.games/petsvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Actum Games", "support_website_url": null, "website_url": "https://actum.games/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8159824190765804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974669_308871547274307_4294041891805706558_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-M154jQ6csQ7kNvwF7kQCF&_nc_oc=AdkcfjziDrj76Cd5jP-YVH2HJcEpkuSFeU0pypHi_Kl4Zfu2HXQugj0ixaHgpx0FBG8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuihN-uEITZmfA1NqZXSXSODHVR
72578700", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_327457675912033_2821379262425207661_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-2uGSEX-MoQ7kNvwGsxkEc&_nc_oc=AdqCJ4pTirtxXkgRzCRdMF90McTgv-_0H-HciO681AwgM7mYzwAPNKzv78xVeq9bgPM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxnUh2rOY7HeGItuFHi46lPxibLf3jtJOP3lp0pzSN8mw&oe=69C14651"}, {"file_name": "3.png", "id": "376269917515224", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210889_376269920848557_8257096419215980972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKbVkKvg4E0Q7kNvwEmC-5K&_nc_oc=AdpOFnoN8QjD6zDt79D0gcnLVDa-2vak0ZnM6kP1AY3jRkcgyuUhNKatoSmWbz8n_Nc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAV8uGNHg6hVmXO6Wsio7FtUB9uj9hzTKvFg5f9CVvcQ&oe=69C12A8D"}, {"file_name": "park screen.png", "id": "1356917244739288", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031634_1356917248072621_7555016658380422445_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=172Fubyls9QQ7kNvwH3hbn6&_nc_oc=Adpmb36khz8Fy6rj0ULm28LC6JQUNwHdv4rdH0gMC0ArGL8Q89hcfrzH7PEn8H6vC4Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYSXYEw2KGggwi0CSkxl88zVP9dL6RrAZo8sW8dXmE7g&oe=69C12D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pets vr hero 2560x1440.png", "id": "4898704120173794", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_4898704123507127_7967018392648686203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB-5ozvp1PwQ7kNvwGpZdoK&_nc_oc=AdrnYxOGA2HGxzz3JsIHpsrIfa_s81br2AtEtfVTlU3Y5jED0t8ZNFmOnNqTeK3KF-8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx276FINIaZ25jVHE28wYxo9VjA_7FS56NSqqo768AQLg&oe=69C11C9A"}, "display_name": "Pets VR", "keywords": [], "long_description": "Some charming pets are waiting for you to play with them - come and see what they\u2019re up to in Pets VR! \nThere is a lot to do in Pets Resort, some of your duties will include: Petting cute doggo, playing with adorable Cat, making sure that they both have something to snack on and are well rested, walking without a care in the world through beautiful park, playing one of multiple mini games in which you can win special points! \nReady for some challenges? Time for some training! Learn special gestures and instruct your pet to perform different tricks - if you\u2019re consistent it gets easier in time but be aware the pet can also forget some lessons! Reward yourself and your pupil and make it fancy! Exchange points to create your own collection of fun accessories for you and your pet to enjoy. Discover everything Pets VR can offer and most importantly, have fun!\n", "short_description": "Pets VR - Take care of adorable pets in Your own Pets Resort!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://actum.games/petsvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Actum Games", "support_website_url": null, "website_url": "https://actum.games/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8159824190765804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974669_308871547274307_4294041891805706558_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HxjO7SIzN4Q7kNvwFxxXX1&_nc_oc=Adp8f8ODty5A8N8RIHNkIza9QWZngdX
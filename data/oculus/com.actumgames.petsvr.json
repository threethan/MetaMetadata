72578700", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031326_327457675912033_2821379262425207661_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kRPK8abp5IQ7kNvwEptGMh&_nc_oc=AdksMat7FGk5HdwzKOsOKRyPfpgHzlsqhVmFKWP4EaQcV8zfCTXgud6CkZWIM98LyQg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz98OizaOxumc4jle2RTbT3c7caCjnaQhgO1s143Yux-w&oe=69B6BA51"}, {"file_name": "3.png", "id": "376269917515224", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210889_376269920848557_8257096419215980972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu9iJaO9H4MQ7kNvwGDhUd-&_nc_oc=Adlv7VH2NeLBEpmo8KexJpKFi0hHtxqpJFodr0Dnd_nLs_n66Km7NOejaW6DjespbxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnlpKBA8djrbcLh7AKvWYIkX8UAHQuvoI7bIMDPH8KFw&oe=69B69E8D"}, {"file_name": "park screen.png", "id": "1356917244739288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031634_1356917248072621_7555016658380422445_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=safER6TolysQ7kNvwF2hyd-&_nc_oc=Admm6o-e_My5C4bVlqGisTfzf_vHBbg-DZrojsv20bZkLlUGxSjH2yIGcGqBCQOUU80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy59LFOF6CzYpfTSvBW-20Vp8B2FP3m5K_jHVOfQrAAhA&oe=69B6A12C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pets vr hero 2560x1440.png", "id": "4898704120173794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_4898704123507127_7967018392648686203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOEake-P-XIQ7kNvwF-4ir3&_nc_oc=AdmQA6L-Ca43IAOP6qxCMMkRkvdgrRxn30Wq8vAUt567ID4GJVBqKNASHhRkCGdqRig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw30KVGGwrlDux60BI0wxDzSptQkFgWS6fPv5VAz61A1Q&oe=69B6909A"}, "display_name": "Pets VR", "keywords": [], "long_description": "Some charming pets are waiting for you to play with them - come and see what they\u2019re up to in Pets VR! \nThere is a lot to do in Pets Resort, some of your duties will include: Petting cute doggo, playing with adorable Cat, making sure that they both have something to snack on and are well rested, walking without a care in the world through beautiful park, playing one of multiple mini games in which you can win special points! \nReady for some challenges? Time for some training! Learn special gestures and instruct your pet to perform different tricks - if you\u2019re consistent it gets easier in time but be aware the pet can also forget some lessons! Reward yourself and your pupil and make it fancy! Exchange points to create your own collection of fun accessories for you and your pet to enjoy. Discover everything Pets VR can offer and most importantly, have fun!\n", "short_description": "Pets VR - Take care of adorable pets in Your own Pets Resort!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://actum.games/petsvr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Actum Games", "support_website_url": null, "website_url": "https://actum.games/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8159824190765804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974669_308871547274307_4294041891805706558_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7nif_xex9MQ7kNvwHMisMI&_nc_oc=AdkH61mpj8VIlUcpJAm19_iRZLLqYrD
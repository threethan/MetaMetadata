e0jjECCqyIFQbN0Se3LFZ2ZpBwnUPdbi7cOxQ&oe=6A53A782"}, {"file_name": "NightsRoom.png", "id": "27366140229740534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604275479_27366140246407199_6733474187413858924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPPBwQteww4Q7kNvwG6i6nR&_nc_oc=Adoi9sNqLOOVqYOSEPFtDOfp_UsVQZFsz8zqhMcNCp_h4xBMFt4rcbSnpeu9e_yElW4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuVs6UYIZPYGhswmVw-UiQQQFL7DaIc1IIQq-sqGroOg&oe=6A53A4C5"}, {"file_name": "InfoRoom.png", "id": "1878643946156394", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618894_1878643949489727_1173709317891896490_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLnMUXChJ9YQ7kNvwEUIS9K&_nc_oc=AdpSi42VLcvjOj01cstIW8BUQHcyixxTPWG7zJuSeKEnJzm9TdEwVELkPEQ14YzHwR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOZr6bEl87kCdgdFt1eeqQHjhS5KlQLX5Ofv2qTv-T1A&oe=6A53A969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491821735_2829227190602636_5830454164090324208_n.png", "id": "2107447913409567", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_2107447920076233_929254440823790033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZCFvDR8gKwQ7kNvwGTls7h&_nc_oc=Adq358lrXWumaXIe3-t2v8TJRSg41CjadrPDcDioluUJDkYZKBY4_Y3qm8v_fJdrORg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmtraeQsw63spjNgZ6GOGHQrivRrdN9gA-aqcxhd_KAQ&oe=6A5388F3"}, "display_name": "Five Nights At Monkeys", "keywords": ["Fnam", "FNAM"], "long_description": "Five Nights At Monkeys is a VR horror experience where every night is completely different and full of surprises! Swing, grab, and climb with classic Gorilla Tag style arm movement as you survive roaming monsters, tricky power systems, and unexpected jump scares. From forest treehouses to canyon huts, city streets, and dark mines, each night brings new challenges and monsters. \n{824080903495741}\nAfter surviving the scares, step into the lobby\u2026 if you dare! Customize your look with cosmetics, test your skills in the parkour, or explore the museum for a glimpse of what\u2019s next. Wander through the fanart area to see the community\u2019s creations, and keep your eyes peeled cuz secrets hide everywhere, including the mysterious lab.\n{1929891677592140}", "short_description": "Ever wanted to survive five nights of horror with Gorilla Tag-style movement? Now you can! swing, hide, and outsmart roaming monsters in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ea9d9336-ae1d-45a1-a2c1-6c4a39727a7a", "developer_terms_of_service_url": null, "publisher_name": "Gameboy_Alex", "support_website_url": null, "website_url": "https://gameboyalex.nicepage.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27289809140635690"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818890_1126004199290869_1585205772217396387_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AoLnx2ZCSUQ7kNvwEbaah0&_nc_oc=AdqIiAf5soB5pfVv9e9iELFAJw_fpprwdCyeP0xFXRsBvvFGdp0iLLk7hLhzf8SDqUg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5LkVJLt_s94hVg87wgZFbvN-aK4f_P_Jjubc9iGqvfw&oe=6A5382F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
Jr891mI6oMzk9ZViwuZm74Os1KSKmmfeU9oeA&oe=6A6CB402"}, {"file_name": "NightsRoom.png", "id": "27366140229740534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604275479_27366140246407199_6733474187413858924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86EwXOVXNpQQ7kNvwGTOpwu&_nc_oc=AdobXISs8qvu3cCJ2qTbm6p2WQy_hWxa6l1m041rjCaL7b-o1eltEE-4hzo9i8mydmY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoyzNnb2qHN_lmrREp0EGkBG9287nO1u9qMmHFF9hJFQ&oe=6A6CB145"}, {"file_name": "InfoRoom.png", "id": "1878643946156394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618894_1878643949489727_1173709317891896490_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yAjM22hUYoQ7kNvwHflkiC&_nc_oc=AdooGQesZQciWi834RLHImhhUab9YTUwmjhBjW0tvOgp2qSKClXHjIVgZ9sGrLi19qM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAThtuqIBD7ddyudTcXbwoSgl8dlW3_FAXG7r93DJyw5Q&oe=6A6CB5E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491821735_2829227190602636_5830454164090324208_n.png", "id": "2107447913409567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_2107447920076233_929254440823790033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xHg3A7DvOEQ7kNvwHgt1aF&_nc_oc=AdoKDnRs-CtuiF-K_RBAFP23ui3sN9qWFdnfMnwqGwoOgZWbowhwG8Px0fpbwBw9uJE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYU8DmpXCX7aGirPwVr_E5_WyTZ1qBBs0WmM3nE77zLw&oe=6A6C9573"}, "display_name": "Five Nights At Monkeys", "keywords": ["Fnam", "FNAM"], "long_description": "Five Nights At Monkeys is a VR horror experience where every night is completely different and full of surprises! Swing, grab, and climb with classic Gorilla Tag style arm movement as you survive roaming monsters, tricky power systems, and unexpected jump scares. From forest treehouses to canyon huts, city streets, and dark mines, each night brings new challenges and monsters. \n{824080903495741}\nAfter surviving the scares, step into the lobby\u2026 if you dare! Customize your look with cosmetics, test your skills in the parkour, or explore the museum for a glimpse of what\u2019s next. Wander through the fanart area to see the community\u2019s creations, and keep your eyes peeled cuz secrets hide everywhere, including the mysterious lab.\n{1929891677592140}", "short_description": "Ever wanted to survive five nights of horror with Gorilla Tag-style movement? Now you can! swing, hide, and outsmart roaming monsters in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ea9d9336-ae1d-45a1-a2c1-6c4a39727a7a", "developer_terms_of_service_url": null, "publisher_name": "Gameboy_Alex", "support_website_url": null, "website_url": "https://gameboyalex.nicepage.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27289809140635690"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818890_1126004199290869_1585205772217396387_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPEGKPc8mY8Q7kNvwFBtNe9&_nc_oc=AdpWU6YLHBc3JI_kGZ-Qk4AdV9WKW5jx-66csrlcWWWLWeBgMFLDC1iHraex9pKHioY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWbQR98ldHewtC7uYH-eXhr4HhzfexHHXX-J_REUtXbw&oe=6A6C8F76"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
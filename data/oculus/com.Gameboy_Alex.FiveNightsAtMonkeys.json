22nGladh6bYELtv8VKw8CWrlA4tSK_Fy7alRQ&oe=6A9AD882"}, {"file_name": "NightsRoom.png", "id": "27366140229740534", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/604275479_27366140246407199_6733474187413858924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHIdcv6DC0EQ7kNvwEQ4fhq&_nc_oc=AdouZzbvwJVWSbXqUa3jF0MsVlNTGzBSHpaJcvJa_BQPEJVo1XM1FKFxz-keHi_U9BE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKihlZoOuRdIb8rWawmGDb6b6NreQ2dCFQuqQqBIwrB4Q&oe=6A9AD5C5"}, {"file_name": "InfoRoom.png", "id": "1878643946156394", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618894_1878643949489727_1173709317891896490_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTTsJBG3VdAQ7kNvwEEpKDF&_nc_oc=AdplarGDqdRqIbT8fTJBbF0TPYhfQ8wvgK3KQGsBAmsi75t_xkA9maYjXnlf35LoUqs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzCL069_B5NedOLWNJxcmeMdv6lh3julFiW-SUhB0y5g&oe=6A9ADA69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491821735_2829227190602636_5830454164090324208_n.png", "id": "2107447913409567", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823949_2107447920076233_929254440823790033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU0ZIf_C7VEQ7kNvwEsZJm-&_nc_oc=Adrmf3L2xWztQjYhgQvB1PoOZoEal-cJ94apVfqWiEysBhePbuhR8SSp_Rtq1IQdPwI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlMNNkKuG9Z91LEhzcoFGW9X_C5Oam0nW4HHZUBueOig&oe=6A9AF233"}, "display_name": "Five Nights At Monkeys", "keywords": ["Fnam", "FNAM"], "long_description": "Five Nights At Monkeys is a VR horror experience where every night is completely different and full of surprises! Swing, grab, and climb with classic Gorilla Tag style arm movement as you survive roaming monsters, tricky power systems, and unexpected jump scares. From forest treehouses to canyon huts, city streets, and dark mines, each night brings new challenges and monsters. \n{824080903495741}\nAfter surviving the scares, step into the lobby\u2026 if you dare! Customize your look with cosmetics, test your skills in the parkour, or explore the museum for a glimpse of what\u2019s next. Wander through the fanart area to see the community\u2019s creations, and keep your eyes peeled cuz secrets hide everywhere, including the mysterious lab.\n{1929891677592140}", "short_description": "Ever wanted to survive five nights of horror with Gorilla Tag-style movement? Now you can! swing, hide, and outsmart roaming monsters in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ea9d9336-ae1d-45a1-a2c1-6c4a39727a7a", "developer_terms_of_service_url": null, "publisher_name": "Gameboy_Alex", "support_website_url": null, "website_url": "https://gameboyalex.nicepage.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27289809140635690"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818890_1126004199290869_1585205772217396387_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rK-rFVBL-YQ7kNvwG7i-Pu&_nc_oc=AdrAT1qs-7fp6H_W18BXnc5y4yTOdkGiBvP-h4SUmMtX50ACEyDXvzIyU7tZL6ogch8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7ityFw713J939-0JMSJE1aPB3XDTVB6uKUeCzE7IbeA&oe=6A9AEC36"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
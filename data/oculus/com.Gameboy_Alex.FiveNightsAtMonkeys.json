H77i9LAwCb9zgdmG217tzRNAq31fDN4U0Nscw&oe=6A804242"}, {"file_name": "NightsRoom.png", "id": "27366140229740534", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604275479_27366140246407199_6733474187413858924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGqQHmjX8gwQ7kNvwFdSjlt&_nc_oc=Adrsl37flceuu9160Uuw9X1r_rZjd0Z94r5ERD4ROw9meeAr_bBiRustluNBQ3VuaCw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwtnF3nIN-Vy5dykga21kLn-5c3Pf4dXKo4aXKV4LMuQ&oe=6A803F85"}, {"file_name": "InfoRoom.png", "id": "1878643946156394", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618894_1878643949489727_1173709317891896490_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qef1uS4SSF0Q7kNvwGTE8Qz&_nc_oc=AdoObDcxvVwknHBdSdWF1vvDYpRI8aaMOsejAFAbyJlEIwWlYkRhuhoB1wkxnb__G4s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0PaeH5gYXo8PLcY2YL-w-TsapGr1arpp79_A8DJOzlw&oe=6A804429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491821735_2829227190602636_5830454164090324208_n.png", "id": "2107447913409567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823949_2107447920076233_929254440823790033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XVpI3wIR38Q7kNvwG40ZtP&_nc_oc=AdrBX8JWoxQOfZNVei6BS9aHC0w-Tn3DwzVNdz-2kVz6dZ8jCBu2uwYoh8LdEeplPeo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyEe5UyFTzZKHp6I53DII8jwzGLg_UDdf0WXo8zftTeQ&oe=6A805BF3"}, "display_name": "Five Nights At Monkeys", "keywords": ["Fnam", "FNAM"], "long_description": "Five Nights At Monkeys is a VR horror experience where every night is completely different and full of surprises! Swing, grab, and climb with classic Gorilla Tag style arm movement as you survive roaming monsters, tricky power systems, and unexpected jump scares. From forest treehouses to canyon huts, city streets, and dark mines, each night brings new challenges and monsters. \n{824080903495741}\nAfter surviving the scares, step into the lobby\u2026 if you dare! Customize your look with cosmetics, test your skills in the parkour, or explore the museum for a glimpse of what\u2019s next. Wander through the fanart area to see the community\u2019s creations, and keep your eyes peeled cuz secrets hide everywhere, including the mysterious lab.\n{1929891677592140}", "short_description": "Ever wanted to survive five nights of horror with Gorilla Tag-style movement? Now you can! swing, hide, and outsmart roaming monsters in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ea9d9336-ae1d-45a1-a2c1-6c4a39727a7a", "developer_terms_of_service_url": null, "publisher_name": "Gameboy_Alex", "support_website_url": null, "website_url": "https://gameboyalex.nicepage.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27289809140635690"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818890_1126004199290869_1585205772217396387_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0t33Ye-MtuUQ7kNvwFqyI3g&_nc_oc=Adqonbyf36c_t5Fp8oXN4HASsbGttDwAqARGC7R_eStaIsDcM7Cc9AZtcBFXgu28MFE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRtSHcnq3hvuBwjHMPgyG2vlwaTy9FGi2Dbz-rAJhUZw&oe=6A8055F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
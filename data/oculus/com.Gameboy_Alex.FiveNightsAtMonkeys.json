 Project - 2024-10-03T152721.911.png", "id": "1220188342522526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982556_1220188345855859_7741020564012787555_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR7ZrrUzL5QQ7kNvwETOv_V&_nc_oc=Admi9-C-ifjx8Yy61LKcrMjYDyAGEgJMKL9z0cFM2mO4bjJ6vwRlSLw-WA6bINHZsN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEFzatItQyuZeHIKmRPS2yFHHjmWIkl8pGRKfGPmN69A&oe=69AEAFE7"}, {"file_name": "New Project (100).png", "id": "394459817054793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75388621_394459820388126_4127149180506859564_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_oa5f2ogaQQ7kNvwHzP_xd&_nc_oc=AdkdefLfNvr9PQf7ypBhEFt1ZgTacJUkLSKBn2Vgt-fQP5TVvg08b3x5d-P1RMZpeiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZaIQz3t55vVld3tggRIOb_cNMPn_RHwySFKrm9NhPig&oe=69AEB5DB"}, {"file_name": "New Project (99).png", "id": "509531051852800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974783_509531055186133_4130805741329974055_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WCJgZ4AfwAQ7kNvwHAV_Av&_nc_oc=Adnai_fTuVoXkt_i6KEazX5eLcvQQPSLjltGBY403wiGdAo6VLqzidAOh49Rzx7v93c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyJlKKmTK1qccYaBjozVbUP25hUQf4tT51wcdzLkaMRw&oe=69AEB837"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491821735_2829227190602636_5830454164090324208_n.png", "id": "2107447913409567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823949_2107447920076233_929254440823790033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkujTKmk6KsQ7kNvwHK2P6L&_nc_oc=AdluL3xnJ7vI9RJ_R6_KIJeb34F9BorS7eBAphOp7KPKW-mzwPzGby8Bz82TB0i1Rqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-VRL3RbOf0DCn9dGmAxlykkQ7_9_7U26N8xWl5D3sKw&oe=69AEBD73"}, "display_name": "Five Nights At Monkeys", "keywords": ["Fnam", "FNAM"], "long_description": "Five Nights At Monkeys is a VR horror experience where every night is completely different and full of surprises! Swing, grab, and climb with classic Gorilla Tag style arm movement as you survive roaming monsters, tricky power systems, and unexpected jump scares. From forest treehouses to canyon huts, city streets, and dark mines, each night brings new challenges and monsters. \n{824080903495741}\nAfter surviving the scares, step into the lobby\u2026 if you dare! Customize your look with cosmetics, test your skills in the parkour, or explore the museum for a glimpse of what\u2019s next. Wander through the fanart area to see the community\u2019s creations, and keep your eyes peeled cuz secrets hide everywhere, including the mysterious lab.\n{1929891677592140}", "short_description": "Ever wanted to survive five nights of horror with Gorilla Tag-style movement? Now you can! swing, hide, and outsmart roaming monsters in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ea9d9336-ae1d-45a1-a2c1-6c4a39727a7a", "developer_terms_of_service_url": null, "publisher_name": "Gameboy_Alex", "support_website_url": null, "website_url": "https://gameboyalex.nicepage.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25323820987234525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_112600419
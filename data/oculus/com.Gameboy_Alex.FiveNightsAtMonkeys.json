CHlvKzutSXUWtV4AdfAwT6MCLtxX2iHHCP0lDcUplHPupwKc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PNzIKxRdW2GaVl-jhcXfJ-nlYAyrNYyEv90OH7UHY-Q&oe=6A106074"}, {"file_name": "New Project - 2024-10-03T152721.911.png", "id": "1220188342522526", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982556_1220188345855859_7741020564012787555_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvMUtj8iYAMQ7kNvwFQQhIn&_nc_oc=Adry5N5kUOM0xJoTIOvtKiBDxXX6Z9YqZjbNtsU4frNoGLOR1zEQY5Qw_nbb60-NDBs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UACRp116il7hsSmDn3fqx1UwytkJBv0tUBdLkpLQ00A&oe=6A107727"}, {"file_name": "New Project (100).png", "id": "394459817054793", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75388621_394459820388126_4127149180506859564_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSYKtGQKSHgQ7kNvwHWrT-r&_nc_oc=AdrRfV9zsgl8fpUT5fJGxZ5LBhmtMMdwRE-aceb76pVrInV4i0yPtFptOJdYSCUWDzc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mfdEr2rkmJs5FwarJn4MmMC7YZm1-ouxirCEIeZ1tGw&oe=6A107D1B"}, {"file_name": "New Project (99).png", "id": "509531051852800", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974783_509531055186133_4130805741329974055_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mzxo6czhQAQ7kNvwHfY0rB&_nc_oc=AdotSsjVnvZB2IKs9mEkM36ryzfRtHo8ZAp7c6MRVQ9f87_JxLDtz6EEZD66KU_PIxc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_7POejb3rPOo1V5LTS8S2jJ7ea0RfDxRy_BVHLEx-bA&oe=6A107F77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491821735_2829227190602636_5830454164090324208_n.png", "id": "2107447913409567", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491823949_2107447920076233_929254440823790033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcSUyy-5TPUQ7kNvwGk4J6f&_nc_oc=AdqKwX8VoVDRN3VDTD8YY5Jl9N_WqQ2aCa8QjahLY0EzgIT1AhKZ2hD9xWLhI_dwfuQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VsgfjP_FxK4XNMNyKxw6yXawh69nG4jOekG84CkEA-w&oe=6A104C73"}, "display_name": "Five Nights At Monkeys", "keywords": ["Fnam", "FNAM"], "long_description": "Five Nights At Monkeys is a VR horror experience where every night is completely different and full of surprises! Swing, grab, and climb with classic Gorilla Tag style arm movement as you survive roaming monsters, tricky power systems, and unexpected jump scares. From forest treehouses to canyon huts, city streets, and dark mines, each night brings new challenges and monsters. \n{824080903495741}\nAfter surviving the scares, step into the lobby\u2026 if you dare! Customize your look with cosmetics, test your skills in the parkour, or explore the museum for a glimpse of what\u2019s next. Wander through the fanart area to see the community\u2019s creations, and keep your eyes peeled cuz secrets hide everywhere, including the mysterious lab.\n{1929891677592140}", "short_description": "Ever wanted to survive five nights of horror with Gorilla Tag-style movement? Now you can! swing, hide, and outsmart roaming monsters in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ea9d9336-ae1d-45a1-a2c1-6c4a39727a7a", "developer_terms_of_service_url": null, "publisher_name": "Gameboy_Alex", "support_website_url": null, "website_url": "https://gameboyalex.nicepage.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_
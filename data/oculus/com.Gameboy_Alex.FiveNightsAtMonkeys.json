bzUe3COvDt2-q__62yvZjSj57gD0UlVUJejCg&oe=6A9C2A02"}, {"file_name": "NightsRoom.png", "id": "27366140229740534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/604275479_27366140246407199_6733474187413858924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHIdcv6DC0EQ7kNvwHSf6To&_nc_oc=AdrEJbz-W5ryBBPNSZl1C78gvvOehq-OERbuOGR3HTw-OtuKEeTVpdmK7gpOftrx2wg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqycUcSkASMNBb_hsPR6H5n3aiOzWhmFMKtmfA-hzhsA&oe=6A9C2745"}, {"file_name": "InfoRoom.png", "id": "1878643946156394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618894_1878643949489727_1173709317891896490_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGCWoFG0EXcQ7kNvwHAC7lV&_nc_oc=AdpmozELwwpMEnUNo9VKf59WE1Jrc4ihqZCE8fEmAZtDaV7UoJB0qlCvwpHmR-x-Glw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzdQavps3Cxza3WvjjKf5dRFiq0b221zudFl3YkqjjDg&oe=6A9C2BE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491821735_2829227190602636_5830454164090324208_n.png", "id": "2107447913409567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823949_2107447920076233_929254440823790033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BdjTtqYjZAQ7kNvwH3KMzP&_nc_oc=AdrZKl_YoRE8HxuEvkzgAGuAu8Ie34l-i8S1wwHm5EgPFJqMQikhh5sMSvzbmij4le0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlqPygnRbjZIwYxIIQUHCHSj8IdI6bY9jZTaYyB2OPXA&oe=6A9C0B73"}, "display_name": "Five Nights At Monkeys", "keywords": ["Fnam", "FNAM"], "long_description": "Five Nights At Monkeys is a VR horror experience where every night is completely different and full of surprises! Swing, grab, and climb with classic Gorilla Tag style arm movement as you survive roaming monsters, tricky power systems, and unexpected jump scares. From forest treehouses to canyon huts, city streets, and dark mines, each night brings new challenges and monsters. \n{824080903495741}\nAfter surviving the scares, step into the lobby\u2026 if you dare! Customize your look with cosmetics, test your skills in the parkour, or explore the museum for a glimpse of what\u2019s next. Wander through the fanart area to see the community\u2019s creations, and keep your eyes peeled cuz secrets hide everywhere, including the mysterious lab.\n{1929891677592140}", "short_description": "Ever wanted to survive five nights of horror with Gorilla Tag-style movement? Now you can! swing, hide, and outsmart roaming monsters in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/ea9d9336-ae1d-45a1-a2c1-6c4a39727a7a", "developer_terms_of_service_url": null, "publisher_name": "Gameboy_Alex", "support_website_url": null, "website_url": "https://gameboyalex.nicepage.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27289809140635690"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_1126004199290869_1585205772217396387_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rK-rFVBL-YQ7kNvwG8bSpB&_nc_oc=Adp9V4MF8_i3YX2BHdm1XwYp0r9HadSYCwvXEzkLwmTdRvrjqcrAB1MZm_-K8cQhlVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKT7A4yd9Ibq6Jy1x6ZBgUI4JRAlg-XD7pmQGJnW5iSg&oe=6A9C3DB6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
}, {"file_name": "1_Catana_logo.png", "id": "1412335346653229", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499324942_1412335349986562_6233318694936116386_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt0EVT2ukfAQ7kNvwEa6eju&_nc_oc=AdoYhBLOV_TuaxxgpR3D1-I5UQzGK6fLi7o9DaLl4hCNtfQmRYMr5OPhyv9Ukbt8fRw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwb5YcDpsDGWxSbrydKe1CeJAP0xfplmnKtp--BTh1avA&oe=69C3CD50"}, {"file_name": "Landscape_cover_1.png", "id": "1031557265361525", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830589_1031557268694858_6748475057472620343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ1o6Yns9XQQ7kNvwG7rsUb&_nc_oc=AdoItHsnoKD225NppYHg4ABIoTDYon-7fm3kcoKFGrA2qpGDxAMNZbJRr6NzVdz1Gmg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyuka5dUXuJDn-2tDEi3kd4aQtsMKF0KIY2Cu95pe6-pw&oe=69C3CFCD"}, {"file_name": "Portrait_cover_1.png", "id": "1009236988037959", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304147_1009236991371292_8825851430728849096_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFJstCnEfu4Q7kNvwHKYW3h&_nc_oc=AdrOz0FWeR9B8DcYMmevTEW6j8sapfbiQBw7F_crNvD9x2MExDJK5gIkSJG1pUZWCXI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_GOp9ILhCjF2-EA9iKkdqecuzdNFhtpjStO3ifhyq6A&oe=69C3CD77"}, {"file_name": "square_1440_1.png", "id": "661528370218226", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_661528373551559_1626792401756907700_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTbItkOV4WcQ7kNvwGINSrE&_nc_oc=Adq2TR-my7TdfGljKYi38JTM2p6gNHKHn9tCyDLRcPvaCdGP8iy78eR1DF9vuVLIHj4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2VpBlK9Ul6hnWtqC4rZ_-3uuRQi4vUdYc8C5IVk4rBA&oe=69C3F054"}]}, "id": "732211649484181", "locale": "en_US", "screenshots": [{"file_name": "Scr_1_02_2k.png", "id": "731630849973479", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303471_731630853306812_7772670849104384409_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9tq6-WlNUUQ7kNvwHAxaG9&_nc_oc=AdqwrCXNRsX8K5Vcmx-LKVYymSXKp5caGXBWKk6u-8V4YECVjWvaFHcJUCkdD-cX7TA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXjDFGo-5p0EZEMdHyESNEmji4JI5KA9yVF3ofnvTZ1g&oe=69C3C158"}, {"file_name": "Scr_7_2k.png", "id": "4327228530897007", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620447_4327228534230340_4849257457709590227_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Dv92b_rq0YQ7kNvwHvgjmP&_nc_oc=AdoP0Q2r0dytJPb80ywj4itl6L3_ZUFIA78pwgR0Dmvx4f4tgTAHQLuns1VnaF3ysxU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgdRAMKu9JiHiV0amJaftXQvfIOjNHWJXf5b8KDd4uCQ&oe=69C3F169"}, {"file_name": "Scr_2_2k.png", "id": "1186595359804870", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391959_1186595363138203_8465577567410157270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Oyx5qi5FGUQ7kNvwEKFlef&_nc_oc=AdqavByvm5-eO7GV6yF4cCwBNFDs-LAAqnnBbEUJALPRCeEYqvnRUORPmFDK_1ywDwg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ-yBdENQdsfdfr8Z8uhnoh1FVti1_h34ugP1dzEEyvA&oe=69C3DBDA"}, {"file_name": "Scr_8_2k.png", "id": "1110697880711027", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303976_1110697894044359_4902595106418093956_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO1cGm3laQkQ7kNvwGjmNY1&_nc_oc=Adr4Vo7dxRrU2Gg34sOP_9-8sHowYePTJAXm1djjbf7_qwmzk_fIB0EY33VnylL4aII&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBP-Pe_w9QinRcPgH2f4r7OCZ5fQ7v8ayFVHKNwL_hkQ&oe=69C3C802"}, {"file_name": "Scr_6_2k.png", "id": "1641004023205948", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391911_1641004026539281_3151259873816826287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuvyO9SbmyoQ7kNvwGvmErK&_nc_oc=Adr6ay6nOmEQrWuHkePu5GoVNzSywflVT89sBHxExL1370zYIZa7nb_q5WSI-JoD3sY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXD9FH3kvhoOOmr25XTy7f76D4JUncV2PI60FlGqqsTw&oe=69C3D872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1912779762609812", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822550_1912779765943145_489428855081841292_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCAJZqmql2QQ7kNvwGoHQiN&_nc_oc=Adq5fAAgTqA08eHc5Ho2pktGv7rcVmjDz4Pdrz0WaPI4i3C3nlyPge4COxmR6NGtGnI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5lN_9Z2WTiQSBnknoa2e81DaQF6b0pXGY2fnHFxB8lA&oe=69C3E22F"}, "display_name": "Catana: Red Flowers", "keywords": ["\u0421atana", "Katana", "Cat", "Ninja", "Cook"], "long_description": "**FEEL LIKE A REAL NINJA\u2026**\n\nStep into the paws of a nimble ninja cat! Dash through enemies, deflect bullets, and master the katana in fast, exhilarating VR combat.\n\nThe challenge ramps up gradually. It\u2019s easy to jump in and have fun, but reaching the top requires true mastery of precision, speed, and style.\n\n{1316883086034200}\n\n**\u2026AND A RESTAURANT OWNER!**\n\nWhen the sun rises, the fight takes a playful turn. Welcome to Red Flowers Izakaya, a cozy yet chaotic restaurant where quirky guests arrive with big appetites and short tempers. \n\nCook, serve, upgrade your restaurant, and cause mischief through a variety of lighthearted VR mini-games that keep every visit unpredictable, turning your place into a full VR playground.\n\n{682035634920345}\n\n**A NOD TO LONGTIME FANS**\n\nCatana isn\u2019t just about new ideas. It also celebrates its roots. The fan-favorite Time Trial levels from the Red Flowers demo return, reimagined for modern VR. \n\nThese speedrun-style challenges pay tribute to the community that supported the game from its very beginning.\n\n{1306817317819756}\n\n**CHOOSE HOW TO MOVE**\n\nRun like a ninja, or like a cat! Catana now features flexible locomotion options:\n\n- **Parkour-style movement**, evolving our best practices from previous games\n- **Climbing and bouncing**, inspired by Gorilla-likes \n\n{1117516466520017}\n\n**ENDLESS REPLAYABILITY**\n\nCatana is built for fun, whether you play for a couple of minutes or hours. Test your speed in Time Trial levels, chase high scores, cook up chaos in the Restaurant, or simply enjoy quick VR sessions.", "short_description": "Step into the paws of a nimble ninja cat!\n\nBy day, run your chaotic Restaurant, cook dishes, serve quirky guests, and stir up playful mischief.\n\nBy night, dash through enemies, deflect bullets, gather resources to grow your Restaurant, and showcase your skills with precision, speed, and style."}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25018808801135613"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_661528373551559_1626792401756907700_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTbItkOV4WcQ7kNvwGINSrE&_nc_oc=Adq2TR-my7TdfGljKYi38JTM2p6gNHKHn9tCyDLRcPvaCdGP8iy78eR1DF9vuVLIHj4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbGFPgJ4Xt09vjbDoj_mcEehZK30owokGdn0oQ31zOYg&oe=69C3F054"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Catana: Red Flowers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1768496400, "lastRevision": {"nodes": [{"id": "8996571310452618", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8996571250452624", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1184976690027877"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1867077334142835", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Catana: Red Flowers", "keywords": ["Cat", "Katana", "Parkour", "Challenge", "Sandbox"], "long_description": "**POCZUJ SI\u0118 JAK PRAWDZIWY NINJA\u2026** \n \nWciel si\u0119 w zwinnego kota ninja! Rzucaj si\u0119 na wrog\u00f3w, odbijaj pociski i w\u0142adaj katan\u0105 w szybkiej, wci\u0105gaj\u0105cej walce VR.\n\nWyzwanie ro\u015bnie stopniowo. Proste podstawy pozwalaj\u0105 dobrze si\u0119 bawi\u0107 od pocz\u0105tku, ale je\u015bli chcesz awansowa\u0107 na szczyt globalnego rankingu i udowodni\u0107, \u017ce nie ma lepszego ninja, musisz by\u0107 wcieleniem precyzji, szybko\u015bci i stylu!\n\n{1749964265865251}\n\n**...I NIEZBYT M\u0104DRY KOT!**\n \n\u017byj bez zmartwie\u0144 jak rudy kot! Po bitwie z\u0142ap oddech w spokojnym ogrodzie \u2013 naostrz miecz, zagraj w minigry, np. gotowanie, lub powyg\u0142upiaj si\u0119, jak na kota przysta\u0142o.\n\nNo i nie przeszkadzaj za bardzo dziadkowi Kenjiemu! \ud83d\udc74\n\n{588862457509590}\n\n**NIEKO\u0143CZ\u0104CA SI\u0118 REGRYWALNO\u015a\u0106**\n \nDo Catany mo\u017cesz wraca\u0107 tak d\u0142ugo, jak chcesz.\n\nCz\u0119\u015b\u0107 graczy zako\u0144czy gr\u0119 po poznaniu historii, pokonaniu boss\u00f3w i uko\u0144czeniu wyzwa\u0144.\n\nInni zmierz\u0105 si\u0119 z trybem nieko\u0144cz\u0105cej si\u0119 rozgrywki, w kt\u00f3rym odblokuj\u0105 kosmetyki, poddadz\u0105 swoje umiej\u0119tno\u015bci pr\u00f3bie i powalcz\u0105 o miejsce na szczycie rankingu. Mo\u017cna te\u017c po prostu gra\u0107 dla zdrowia i zabawy w kr\u00f3tkich, codziennych sesjach. \ud83d\udcaa\n\nI co najwa\u017cniejsze\u2026 zawsze czekaj\u0105 na Ciebie kocie aktywno\u015bci. \ud83d\ude3a\n\n{689091343542233}\n\n**T\u0118TNI\u0104CY \u017bYCIEM, PE\u0141EN AKCJI \u015aWIAT**\n \nOdkryj pe\u0142ne kolor\u00f3w miejsca inspirowane kultur\u0105 Azji.\n\nOdbijaj pociski, pokonuj opancerzonych wojownik\u00f3w dzi\u0119ki taktycznemu podej\u015bciu i zbieraj skarby, aby odblokowa\u0107 nowy wygl\u0105d. Unikaj snajper\u00f3w, szybuj po\u015br\u00f3d lataj\u0105cych przeciwnik\u00f3w i walcz z pot\u0119\u017cnymi bossami.\n\nRozgrywka dla ca\u0142ej rodziny, odpowiednia dla wszystkich graczy \u2013 przemoc mo\u017cna wy\u0142\u0105czy\u0107 w ustawieniach.\n\n{1219360189708225}", "short_description": "Wciel si\u0119 w zwinnego kota ninja! Rzucaj si\u0119 na wrog\u00f3w, odbijaj pociski i w\u0142adaj katan\u0105 w szybkiej i emocjonuj\u0105cej walce VR.\n \nPo bitwie z\u0142ap oddech w spokojnym ogrodzie \u2013 naostrz miecz, pobaw si\u0119 z dziadkiem Kenjim lub oddaj si\u0119 kocim wyg\u0142upom. \n \nTwoj\u0105 podr\u00f3\u017c okre\u015bl\u0105 precyzja, szybko\u015b\u0107 i styl. Zmierz si\u0119 z klanami najpodlejszych zbrodniarzy w mie\u015bcie i udowodnij, \u017ce nie ma lepszego ninja!"}, {"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateSquare.png", "id": "2943052429190982", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393841_2943052432524315_6240549783010789438_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFscTea0Wg0Q7kNvwFvFgpV&_nc_oc=AdoBbKNHNbpC8yRBwvBw59b4Rtlc5ZSaCWtL11THg64q27-R5rU0jkiZxVS0x1rxYg0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwITz0neR9tHqPF96ICvEILRWQIZMEDmOXwE3DtcPmmng&oe=69C3E8CC"}, {"file_name": "_.png", "id": "2511606065849943", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392000_2511606072516609_3725686372896722404_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkb5hrwjgvQQ7kNvwHX4ovj&_nc_oc=Adpf_HmwSXAgJ5RQS9qZ-TEC5RaonaeWkpRohjqlze6ZLvL6VwP2fDL3wqFkUIelkSI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQmd_OxeMftpI9fz56-oVRj-pCUseyKkh8kHK1k9YQAg&oe=69C3E51A"}, {"file_name": "mini landscape.png", "id": "1458825405492938", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392305_1458825408826271_3899538847110382413_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxujWjo0lBgQ7kNvwGB9978&_nc_oc=AdocjDqqjI4LhahP65XaPs_wP-Nur552z8CaapiSDq2sPrEGAC9S46ViEZjS81BzYNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfhiccZDfjXSaOrlQ7K57eeRE4U3wrXWuv8HImySAdaw&oe=69C3C08D"}, {"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "1197727491709086", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392305_1197727495042419_5140182573221539822_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m05IkaDz2VIQ7kNvwGT4QRw&_nc_oc=AdoXjNqzvVG7CxuCzvFfZFyjC2yDHORKQ3_SEK
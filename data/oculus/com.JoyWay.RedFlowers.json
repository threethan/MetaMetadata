M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCHgf_uiDLDD50gswvRsovKqm41IpL_1yQkcx5vzbB0g&oe=69C3E75F"}, {"file_name": "Scr_3_2k.png", "id": "1024777569536819", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392019_1024777572870152_4132990171306506441_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w_zhx_1GzoQ7kNvwGOntx5&_nc_oc=Adr0cjE5xzeEYMkD4Ag64YhZVa8xvTubCDtQpvGIShKRGeYYSfab8g_xic3RM73n71g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPKPLKQZ94mT8Mclq9hyJPyJbT9lyGySZhlsjebtc0JA&oe=69C3BECB"}, {"file_name": "Scr_2_2k.png", "id": "1186595359804870", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391959_1186595363138203_8465577567410157270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Oyx5qi5FGUQ7kNvwEKFlef&_nc_oc=AdqavByvm5-eO7GV6yF4cCwBNFDs-LAAqnnBbEUJALPRCeEYqvnRUORPmFDK_1ywDwg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ-yBdENQdsfdfr8Z8uhnoh1FVti1_h34ugP1dzEEyvA&oe=69C3DBDA"}, {"file_name": "Scr_5_2k.png", "id": "1151636906644001", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393826_1151636909977334_4733842714713827917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZR1ccLBx24Q7kNvwH6OLC4&_nc_oc=Ado5uPWt4nOqaJJ4G-ZTG_p3WmVyFPxgUDMBUNLNMPprUa7Q3Ja1NqDdqzjphiU4nso&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6AC1JAkeL-mFZn3htVw6IeW8PujcqiwyXek0rQb-9Cw&oe=69C3CC41"}, {"file_name": "Scr_6_2k.png", "id": "1641004023205948", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391911_1641004026539281_3151259873816826287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuvyO9SbmyoQ7kNvwGvmErK&_nc_oc=Adr6ay6nOmEQrWuHkePu5GoVNzSywflVT89sBHxExL1370zYIZa7nb_q5WSI-JoD3sY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXD9FH3kvhoOOmr25XTy7f76D4JUncV2PI60FlGqqsTw&oe=69C3D872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "1186945849542384", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819409_1186945852875717_2519733300585441142_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fj7fP8mX4CAQ7kNvwHukes7&_nc_oc=Adruhsq7YjvBrjkBUsMgo17WaXww-8eSfCIJFRQmGofEX3n8GasAYkD4vu37tMojIo4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzfg-25vXDbz_TT3OMRuNEFj2lRr21n4WDepZjsH6geBA&oe=69C3C2E3"}, "display_name": "Catana: Red Flowers", "keywords": ["Ninja", "Parkour", "Sandbox", "Katana", "Speed"], "long_description": "**FEEL LIKE A REAL NINJA\u2026**\n\nStep into the paws of a nimble ninja cat! Dash through enemies, deflect bullets, and master the katana in fast, exhilarating VR combat.\n\nThe challenge ramps up gradually\u2014it\u2019s easy to learn the basics and have fun right from the start. But to climb the global leaderboards and prove yourself the ultimate ninja, you\u2019ll need to showcase precision, speed, and style!\n\n{1316883086034200}\n\n**... AND A SILLY CAT!**\n\nThe \u201corange cat energy\u201d is real here! Between battles, unwind in your cozy garden\u2014sharpen your blade, play mini-games like cooking, or just goof around as any proper cat would.\n\nAnd remember: don\u2019t bug Grandpa Kenji too much! \ud83d\udc74\n\n{1034711221886064}\n\n**ENDLESS REPLAYABILITY**\n\nCatana is designed to keep you entertained as long as you want.\n\nSome players will have a blast completing the story, defeating bosses, and clearing challenges\u2014then call it a day.\n\nOthers will stick with Endless Mode\u2014unlocking cosmetics, pushing their limits on the hardest difficulties, and racing to the top of the leaderboards. Or simply stay fit with short, fun daily sessions. \ud83d\udcaa\n\nAnd of course\u2026 There are always cat activities. \ud83d\ude3a\n\n{667403815733574}\n\n**DIVE INTO A VIBRANT, ACTION-PACKED WORLD**\n\nExplore luminous, colorful environments inspired by Asian culture.\n\nBounce bullets back, strategically defeat armored warriors, and gather treasures to unlock new looks. Dodge snipers, soar past flying enemies, and clash with mighty bosses.\n\nFamily-friendly experience welcomes players of all kinds\u2014violence settings can be toggled on or off.\n\n{931643069179640}\n", "short_description": "Step into the paws of a nimble ninja cat! Dash through enemies, deflect bullets, and master the katana in fast, fun VR combat.\n\nBetween battles, unwind in your cozy garden\u2014sharpen your blade, play with Grandpa Kenji, or just be a silly cat. \n\nPrecision, speed, and style will define your journey. Face off against the city's most notorious crime clans and prove yourself the ultimate ninja!"}, {"images": {"nodes": []}, "id": "1032756912283848", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Catana: Red Flowers", "keywords": ["Cat", "Ninja", "Parkour", "Sandbox", "Challenge"], "long_description": "**\u041f\u041e\u0427\u0423\u0412\u0421\u0422\u0412\u0423\u0419 \u0421\u0415\u0411\u042f \u041d\u0410\u0421\u0422\u041e\u042f\u0429\u0418\u041c \u041d\u0418\u041d\u0414\u0417\u042f\u2026**\n\n\u0421\u0442\u0430\u043d\u044c \u043f\u0440\u043e\u0432\u043e\u0440\u043d\u044b\u043c \u043d\u0438\u043d\u0434\u0437\u044f-\u043a\u043e\u0442\u043e\u043c! \u041f\u0440\u043e\u0440\u044b\u0432\u0430\u0439\u0441\u044f \u0441\u043a\u0432\u043e\u0437\u044c \u0432\u0440\u0430\u0433\u043e\u0432, \u043e\u0442\u0440\u0430\u0436\u0430\u0439 \u043f\u0443\u043b\u0438 \u0438 \u0432\u0438\u0440\u0442\u0443\u043e\u0437\u043d\u043e \u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0441\u044f \u043a\u0430\u0442\u0430\u043d\u043e\u0439 \u0432 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u043c VR-\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435\u0440\u0435.\n\n\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0441\u0442\u0451\u0442 \u043f\u043b\u0430\u0432\u043d\u043e \u2014 \u043e\u0441\u0432\u043e\u0438\u0442\u044c\u0441\u044f \u043b\u0435\u0433\u043a\u043e, \u0438 \u0443\u0436\u0435 \u0441 \u043f\u0435\u0440\u0432\u044b\u0445 \u043c\u0438\u043d\u0443\u0442 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0435\u0441\u0435\u043b\u044c\u0435.\n\n\u041d\u043e \u0435\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0432\u0437\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u0432\u0435\u0440\u0448\u0438\u043d\u0443 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u043b\u0438\u0434\u0435\u0440\u043e\u0432 \u0438 \u043f\u0440\u043e\u0441\u043b\u044b\u0442\u044c \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u043c\u0430\u0441\u0442\u0435\u0440\u043e\u043c \u043d\u0438\u043d\u0434\u0437\u044f-\u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430, \u043f\u0440\u0438\u0434\u0451\u0442\u0441\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0438 \u0441\u0442\u0438\u043b\u044c!\n\n{1410474553425460}\n\n**...\u0418 \u041f\u0420\u0418\u0427\u0423\u0414\u041b\u0418\u0412\u042b\u041c \u041a\u041e\u0422\u041e\u041c!**\n\n\u0411\u0443\u0434\u044c \u0441\u0430\u043c\u044b\u043c \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u0440\u044b\u0436\u0438\u043c \u043a\u043e\u0442\u043e\u043c! \u041c\u0435\u0436\u0434\u0443 \u0431\u043e\u044f\u043c\u0438 \u043e\u0442\u0434\u044b\u0445\u0430\u0439 \u0432 \u0441\u0432\u043e\u0451\u043c \u0443\u044e\u0442\u043d\u043e\u043c \u0441\u0430\u0434\u0443: \u0437\u0430\u0442\u0430\u0447\u0438\u0432\u0430\u0439 \u043a\u0430\u0442\u0430\u043d\u0443, \u0438\u0433\u0440\u0430\u0439 \u0432 \u043c\u0438\u043d\u0438-\u0438\u0433\u0440\u044b \u0432\u0440\u043e\u0434\u0435 \u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u0438\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0439\u0441\u044f \u0441\u0432\u043e\u0438\u043c\u0438 \u043a\u043e\u0448\u0430\u0447\u044c\u0438\u043c\u0438 \u0434\u0435\u043b\u0430\u043c\u0438.\n\n\u0418 \u043f\u043e\u043c\u043d\u0438: \u0434\u0435\u0434\u0443\u0448\u043a\u0443 \u041a\u044d\u043d\u0434\u0437\u0438 \u043b\u0443\u0447\u0448\u0435 \u043f\u043e\u043d\u0430\u043f\u0440\u0430\u0441\u043d\u0443 \u043d\u0435 \u0434\u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c! \ud83d\udc74\n\n{1030073952348917}\n\n**\u0411\u0415\u0421\u041a\u041e\u041d\u0415\u0427\u041d\u0410\u042f \u0420\u0415\u0418\u0413\u0420\u0410\u0411\u0415\u041b\u042c\u041d\u041e\u0421\u0422\u042c**\n\nCatana \u0441\u043e\u0437\u0434\u0430\u043d\u0430 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c \u0442\u0435\u0431\u044f \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u0445\u043e\u0447\u0435\u0448\u044c.\n\n\u041a\u043e\u043c\u0443-\u0442\u043e \u0445\u0432\u0430\u0442\u0438\u0442 \u043f\u0440\u043e\u0439\u0442\u0438 \u0441\u044e\u0436\u0435\u0442, \u043e\u0434\u043e\u043b\u0435\u0442\u044c \u0431\u043e\u0441\u0441\u043e\u0432 \u0438 \u0437\u0430\u043a\u0440\u044b\u0442\u044c \u0432\u0441\u0435 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f \u2014 \u0438 \u043d\u0430 \u044d\u0442\u043e\u043c \u043a\u0440\u0430\u0441\u0438\u0432\u043e \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u044c.\n\n\u0410 \u043a\u0442\u043e-\u0442\u043e \u0437\u0430\u043b\u0438\u043f\u043d\u0435\u0442 \u0432 \u0411\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c: \u0431\u0443\u0434\u0435\u0442 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0441\u043a\u0438\u043d\u044b, \u043f\u0440\u043e\u043a\u0430\u0447\u0438\u0432\u0430\u0442\u044c \u0441\u043a\u0438\u043b\u043b \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0438\u0445 \u0443\u0440\u043e\u0432\u043d\u044f\u0445 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0438 \u0431\u043e\u0440\u043e\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0435\u0441\u0442\u043e \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 \u043b\u0438\u0434\u0435\u0440\u043e\u0432. \u0418\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0430\u0442\u044c \u0438\u0433\u0440\u0443 \u043d\u0430 10 \u043c\u0438\u043d\u0443\u0442 \u0432 \u0434\u0435\u043d\u044c \u2014 \u0434\u043b\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0438 \u0440\u0430\u0437\u043c\u0438\u043d\u043a\u0438. \ud83d\udcaa\n\n\u041d\u0443 \u0438, \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u2026 \u041a\u043e\u0448\u0430\u0447\u044c\u0438 \u0434\u0435\u043b\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u043e\u0434 \u0440\u0443\u043a\u043e\u0439. \ud83d\ude3a\n\n{1692853138313785}\n\n**\u041f\u041e\u0413\u0420\u0423\u0417\u0418\u0421\u042c \u0412 \u042f\u0420\u041a\u0418\u0419 \u0418 \u0414\u0418\u041d\u0410\u041c\u0418\u0427\u041d\u042b\u0419 \u041c\u0418\u0420**\n\n\u041e\u043a\u0443\u043d\u0438\u0441\u044c \u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443 \u043a\u0440\u0430\u0441\u043e\u0447\u043d\u044b\u0445 \u043b\u043e\u043a\u0430\u0446\u0438\u0439 \u0441 \u0430\u0437\u0438\u0430\u0442\u0441\u043a\u0438\u043c \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435\u043c.\n\n\u041e\u0442\u0440\u0430\u0436\u0430\u0439 \u043f\u0443\u043b\u0438, \u0440\u0430\u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0441\u044f \u0441 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438 \u0432\u0440\u0430\u0433\u0430\u043c\u0438 \u0438 \u0441\u043e\u0431\u0438\u0440\u0430\u0439 \u0441\u043e\u043a\u0440\u043e\u0432\u0438\u0449\u0430, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0441\u043a\u0438\u043d\u044b. \u0423\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044f \u043e\u0442 \u0441\u043d\u0430\u0439\u043f\u0435\u0440\u043e\u0432, \u043f\u0440\u043e\u043d\u043e\u0441\u0438\u0441\u044c \u043c\u0438\u043c\u043e \u0432\u0440\u0430\u0433\u043e\u0432 \u0432 \u0432\u043e\u0437\u0434\u0443\u0445\u0435 \u0438 \u0432\u0441\u0442\u0443\u043f\u0430\u0439 \u0432 \u0437\u0440\u0435\u043b\u0438\u0449\u043d\u044b\u0435 \u0431\u0438\u0442\u0432\u044b \u0441 \u0431\u043e\u0441\u0441\u0430\u043c\u0438.\n\n\u0421atana \u043f\u043e\u0434\u043e\u0439\u0434\u0451\u0442 \u0438\u0433\u0440\u043e\u043a\u0430\u043c \u043b\u044e\u0431\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430 \u2014 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043d\u0430\u0441\u0438\u043b\u0438\u044f \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043f\u043e\u0434 \u0441\u0435\u0431\u044f.\n\n{1001128581564238}\n", "short_description": "\u0421\u0442\u0430\u043d\u044c \u043f\u0440\u043e\u0432\u043e\u0440\u043d\u044b\u043c \u043d\u0438\u043d\u0434\u0437\u044f-\u043a\u043e\u0442\u043e\u043c! \u041f\u0440\u043e\u0440\u044b\u0432\u0430\u0439\u0441\u044f \u0441\u043a\u0432\u043e\u0437\u044c \u0432\u0440\u0430\u0433\u043e\u0432, \u043e\u0442\u0440\u0430\u0436\u0430\u0439 \u043f\u0443\u043b\u0438 \u0438 \u0432\u0438\u0440\u0442\u0443\u043e\u0437\u043d\u043e \u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0441\u044f \u043a\u0430\u0442\u0430\u043d\u043e\u0439 \u0432 \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u043c VR-\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435\u0440\u0435.\n\n\u041c\u0435\u0436\u0434\u0443 \u0437\u0430\u0431\u0435\u0433\u0430\u043c\u0438 \u043e\u0442\u0434\u044b\u0445\u0430\u0439 \u0432 \u0443\u044e\u0442\u043d\u043e\u043c \u0441\u0430\u0434\u0435: \u0437\u0430\u0442\u0430\u0447\u0438\u0432\u0430\u0439 \u043a\u0430\u0442\u0430\u043d\u0443, \u0438\u0433\u0440\u0430\u0439 \u0441 \u0434\u0435\u0434\u043e\u043c \u041a\u044d\u043d\u0434\u0437\u0438 \u0438\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0430\u043b\u044f\u0439 \u0434\u0443\u0440\u0430\u043a\u0430, \u043a\u0430\u043a \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043a\u043e\u0442.\n\n\u0422\u043e\u0447\u043d\u043e\u0441\u0442\u044c, \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0438 \u0441\u0442\u0438\u043b\u044c \u2014 \u0442\u0432\u043e\u0438 \u043b\u0443\u0447\u0448\u0438\u0435 \u0434\u0440\u0443\u0437\u044c\u044f. \u0411\u0440\u043e\u0441\u044c \u0432\u044b\u0437\u043e\u0432 \u0441\u0430\u043c\u044b\u043c \u043e\u043f\u0430\u0441\u043d\u044b\u043c \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u043a\u043b\u0430\u043d\u0430\u043c \u0433\u043e\u0440\u043e\u0434\u0430 \u0438 \u043f\u043e\u043a\u0430\u0436\u0438, \u043d\u0430 \u0447\u0442\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043d\u0438\u043d\u0434\u0437\u044f-\u043a\u043e\u0442!"}, {"images": {"nodes": []}, "id": "683500394051727", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Catana: Red Flowers", "keywords": ["Cat", "Katana", "Sandbox", "Challenge", "Parkour"], "long_description": "**\u00a1SI\u00c9NTETE COMO UN NINJA DE VERDAD\u2026**\n \n\u00a1Convi\u00e9rtete en un \u00e1gil gato ninja! \u00c1brete paso entre enemigos, esquiva balas y domina la katana en combates VR r\u00e1pidos y emocionantes.\n\nEl reto aumenta poco a poco: f\u00e1cil de aprender y divertido desde el inicio. Pero para escalar en las clasificaciones mundiales y demostrar que eres el ninja definitivo, \u00a1necesitar\u00e1s precisi\u00f3n, velocidad y estilo!\n\n{1305877287367803}\n\n**\u2026Y UN GATO TRAVIESO!**\n \nAqu\u00ed la \u201cenerg\u00eda de gato naranja\u201d es real. Entre combates, rel\u00e1jate en tu jard\u00edn acogedor: afila tu katana, juega minijuegos como cocinar o haz tonter\u00edas como todo gato que se precie.\n\nY recuerda: \u00a1no molestes al abuelo Kenji!\ud83d\udc74\n\n{2092340214573291}\n\n**REJUGABILIDAD INFINITA**\n \nCatana est\u00e1 dise\u00f1ado para entretenerte cuanto quieras.\n\nAlgunos disfrutar\u00e1n completando la historia, venciendo jefes y superando desaf\u00edos\u2026 y luego lo dejar\u00e1n por hoy.\n\nOtros seguir\u00e1n en el Modo Infinito: desbloqueando cosm\u00e9ticos, llevando sus l\u00edmites al m\u00e1ximo en las dificultades m\u00e1s altas y compitiendo por lo m\u00e1s alto de las clasificaciones. O simplemente mantenerse en forma con sesiones cortas y divertidas.\ud83d\udcaa\n\nY por supuesto\u2026 siempre hay actividades gatunas.\ud83d\ude3a\n\n{1678868882751446}\n\n**SUM\u00c9RGETE EN UN MUNDO VIBRANTE Y LLENO DE ACCI\u00d3N**\n \nExplora entornos coloridos inspirados en la cultura asi\u00e1tica.\n\nRebota balas, derrota a guerreros acorazados con estrategia y re\u00fane tesoros para desbloquear nuevos aspectos. Esquiva francotiradores, supera enemigos voladores y enfr\u00e9ntate a jefes poderosos.\n\nUna experiencia para toda la familia, con opci\u00f3n de activar o desactivar la violencia.\n\n{1217138149760240}", "short_description": "\u00a1Convi\u00e9rtete en un \u00e1gil gato ninja! \u00c1brete paso entre enemigos, desv\u00eda balas y domina la katana en un combate VR r\u00e1pido y divertido.\n \nEntre combates, rel\u00e1jate en tu jard\u00edn acogedor: afila tu katana, juega con el abuelo Kenji o simplemente s\u00e9 un gato travieso.\n \nPrecisi\u00f3n, velocidad y estilo definir\u00e1n tu aventura. \u00a1Enfr\u00e9ntate a los clanes criminales m\u00e1s notorios de la ciudad y demuestra que eres el ninja definitivo!"}, {"images": {"nodes": []}, "id": "680468684627362", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Catana: Red Flowers", "keywords": ["Cat", "Katana", "Challenge", "Sandbox", "Parkour"], "long_description": "**SENTEZ-VOUS COMME UN VRAI NINJA...**\n\nEnfilez les pattes d'un chat ninja agile ! Traversez les ennemis, esquivez les balles et maniez le katana dans des combats VR rapides et intenses.\n\nLe d\u00e9fi monte peu \u00e0 peu : facile \u00e0 prendre en main et fun d\u00e8s le d\u00e9but, mais seuls la pr\u00e9cision, la vitesse et le style vous m\u00e8neront au sommet des classements mondiaux !\n\n{3912902109038032}\n\n**...ET UN CHAT ESPI\u00c8GLE!**\n\nL'\u00e9nergie du chat orange est bien r\u00e9elle ! Entre deux combats, d\u00e9tendez-vous dans votre jardin douillet \u2013 aiguisez votre lame, cuisinez, jouez ou faites le pitre, comme un chat.\n\nEt n'oubliez pas : emb\u00eatez pas trop papy Kenji ! \ud83d\udc74\n\n{670734625335001}\n\n**REJOUABILIT\u00c9 INFINIE**\n\nCatana est con\u00e7u pour vous divertir aussi longtemps que vous le souhaitez.\n\nCertains joueurs prendront plaisir \u00e0 finir l\u2019histoire, vaincre des boss et relever des d\u00e9fis, puis s\u2019arr\u00eater l\u00e0.\n\nD'autres resteront en Mode Infini : d\u00e9bloquer des cosm\u00e9tiques, tester leurs limites aux niveaux les plus \u00e9lev\u00e9s et grimper dans les classements. Ou rester en forme avec des sessions courtes et fun. \ud83d\udcaa\n\nEt bien s\u00fbr... il y a toujours des activit\u00e9s f\u00e9lines. \ud83d\ude3a\n\n{1083149503648174}\n\n**PLONGEZ DANS UN MONDE VIBRANT ET PLEIN D'ACTION**\n\nExplorez des mondes color\u00e9s inspir\u00e9s de la culture asiatique.\n\nFaites rebondir les balles, battez des guerriers en armure avec strat\u00e9gie, collectez des tr\u00e9sors pour d\u00e9bloquer de nouveaux looks. Esquivez les tireurs d\u2019\u00e9lite, foncez \u00e0 travers les ennemis volants et affrontez de puissants boss.\n\nUne exp\u00e9rience familiale pour tous les profils \u2013 avec option de d\u00e9sactiver la violence.\n\n{1195926095384110}", "short_description": "Entrez dans les pattes d'un chat ninja agile ! Traversez les ennemis, d\u00e9tournez les balles et ma\u00eetrisez le katana dans des combats VR rapides et excitants.\n\nEntre les combats, d\u00e9tendez-vous dans votre jardin douillet - aiguisez votre lame, jouez avec Grand-p\u00e8re Kenji, ou soyez simplement un chat idiot. \n\nPr\u00e9cision, rapidit\u00e9 et style d\u00e9finiront votre parcours. Affrontez les clans criminels les plus c\u00e9l\u00e8bres de la ville et d\u00e9montrez que vous \u00eates le ninja ultime !"}, {"images": {"nodes": []}, "id": "538368775986051", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Catana: Red Flowers", "keywords": ["Cat", "Ninja", "Parkour", "Sandbox", "Challenge"], "long_description": "**F\u00dcHL DICH WIE EIN ECHTER NINJA...**\n\nSchl\u00fcpfe in die Pfoten einer flinken Ninja-Katze! St\u00fcrme durch Gegnerhorden, weiche Kugeln aus und meistere das Katana in schnellen, intensiven VR-K\u00e4mpfen.\n\nDie Herausforderung w\u00e4chst mit jedem Kampf \u2013 leicht zu lernen und sofort spa\u00dfig, doch nur mit Pr\u00e4zision, Schnelligkeit und Stil schaffst du es in die globalen Bestenlisten.\n\n{1024743546217717}\n\n**...UND WIE EINE ALBERNE KATZE!**\n\nDie \u201eorangefarbene Katze-Energie\u201c ist real! Zwischen den K\u00e4mpfen entspannst du im gem\u00fctlichen Garten \u2013 sch\u00e4rfe dein Katana, koche, spiele oder alber herum, wie es sich f\u00fcr eine Katze geh\u00f6rt.\n\nUnd vergiss nicht: Nerv Opa Kenji nicht zu sehr! \ud83d\udc74\n\n{670097572334190}\n\n**ENDLOSE WIEDERHOLBARE SPIELBARKEIT**\n\nKatana ist so konzipiert, dass du so lange spielen kannst, wie du willst. Manche genie\u00dfen es, die Story zu beenden, Bosse zu besiegen und Herausforderungen zu meistern \u2013 und dann abzuschalten.\n\nAndere bleiben im Endlosmodus: Kosmetik freischalten, sich auf h\u00f6chsten Schwierigkeitsgraden beweisen und die Bestenlisten st\u00fcrmen \u2013 oder mit kurzen, spa\u00dfigen t\u00e4glichen Sessions fit bleiben. \ud83d\udcaa\n\nUnd nat\u00fcrlich...gibt es immer noch Katzenaktivit\u00e4ten. \ud83d\ude3a\n\n{1733246363927452}\n\n**TAUCHE EIN IN EINE LEBENDIGE, ACTIONREICHE WELT**\n\nErkunde farbenfrohe Welten, inspiriert von asiatischer Kultur.\n\nLass Kugeln abprallen, besiege gepanzerte Gegner mit Taktik und sammle Sch\u00e4tze, um neue Looks freizuschalten. Weiche Scharfsch\u00fctzen aus, rase an fliegenden Feinden vorbei und stelle dich Bossen.\n\nEin familienfreundliches Erlebnis f\u00fcr alle Spielertypen \u2013 mit optionaler Gewaltdarstellung.\n\n{4063545217225870}", "short_description": "Werde zur flinken Ninja-Katze! St\u00fcrme durch Feinde, weiche Kugeln aus und meistere das Katana in schnellen, spa\u00dfigen VR-K\u00e4mpfen.\n\nEntspann dich in deinem Garten \u2013 sch\u00e4rfe deine Klinge, spiele mit Opa Kenji oder sei einfach eine alberne Katze. \n\nPr\u00e4zision, Tempo und Stil bestimmen deine Reise. Tritt gegen die ber\u00fcchtigtsten Verbrecherclans der Stadt an. Beweise, dass du der ultimative Ninja bist!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "de", "fr", "pl", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9247184888724591"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2082101289298831"}, {"status": "PUBLISHED", "id": "1834261663935720"}, {"status": "PUBLISHED", "id": "
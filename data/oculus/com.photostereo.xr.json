dsUhHynOleNZo0hK890NE5jAYtdwfWgXaklg3dx9LQlJ4jt2UTMtNRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWv4j2C2UGZsGQ_NEwaUtN_xwDmaZ6SyEkClBFNS-grHg&oe=6B104203"}, {"file_name": "5_06_settings.png", "id": "1400091921969602", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842259_1400091925302935_1143556477679346425_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeeajhnYu88Q7kNvwGmLlY_&_nc_oc=Adr-DiVRaESQ71T57MWtnkF3jYDDWWuaKEn94KTe-_vROsV1xKUEBZ2-wE-4nTa4bUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVDwMtQDGgpSmZSEcv4_6E23E4ETIktKe8ST-5KL9hN6A&oe=6B105F9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_en_2560x1440.png", "id": "2355906361889638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842272_2355906365222971_1739537151506963365_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TL9gLpFu1IQ7kNvwE1gk4c&_nc_oc=Ado3FcbBJRrxct-_GhyzI2Xue0Y5ZpAuyQXdsR0H-hj7aKPUbwgjXt6KZgJRD9j66HE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2ASFkGNcytyoi1fEexxlsNnfCuzn22XU6MSrPiVv1Dg&oe=6B1037D6"}, "display_name": "PhotoStereo XR", "keywords": ["3D", "photos", "stereoscopic", "spatial", "depth"], "long_description": "Your photos were taken in 3D. You just couldn't see it yet.\n\nPhotoStereo XR uses an AI depth model running entirely on your headset to bring your 2D images to life. Pick a photo from your gallery, convert it in seconds, and step into it.\n\nTWO WAYS TO VIEW\n\u2022 Cinema 3D: a stereo image for each eye, like watching a 3D movie.\n\u2022 Volume: the image gains real depth. Lean in and look a little around your subject, and the scene responds to your head.\n\nNOT JUST PHOTOS\nPaintings, watercolors, pencil drawings, sketches, cartoon-style art and AI-generated images convert beautifully. Clean shapes and clear layers often pop out even more than real photos.\n\nPRIVATE BY DESIGN\nEverything happens on your headset. Your images never leave it, and the app works fully offline.\n\nBUILT FOR YOUR GALLERY\n\u2022 Batch conversion: queue whole albums and keep browsing while they convert\n\u2022 \"3D Photos\" album with all your converted images\n\u2022 Save side-by-side 3D copies to your gallery\n\u2022 English, Portuguese and Spanish\n\nONE-TIME PURCHASE, UNLIMITED CONVERSIONS\nNo credits, no subscription.\n\nTip: portraits and images with a clear subject in front of a background give the most striking results.", "short_description": "Turn any photo, painting or illustration into 3D, right on your Meta Quest. In Volume mode, your images gain real depth: lean in and look a little around your subject. Drawings, watercolors and AI art often pop out even more than photos. The AI runs entirely on-device, so your images never leave the headset and everything works offline. One-time purchase, unlimited conversions: no cloud, no subscription, no per-photo fees."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unv29.github.io/PhotoStereoXR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "PhotoStereoXR", "support_website_url": "https://unv29.github.io/PhotoStereoXR/#support", "website_url": "https://unv29.github.io/PhotoStereoXR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"],
705_7483791703709076615_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIvyjqWxbZ8Q7kNvwGXcX2j&_nc_oc=AdopQDPbdQ4EposfHKEsa_Z2Y11JHCTlz0-yr3SZG4usdMNTQn8mWlInykQx_UGohIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfFdKRJppr0zBhamfkhUVuSF2nTa8pGxTmItzswHAISw&oe=6AFDD90B"}, {"file_name": "screenshot_1.png", "id": "1098329576080573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/756589809_1098329579413906_6967186915189970806_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bN6rPqAyl0Q7kNvwGHkWzp&_nc_oc=AdpYPr8LGu33sfW5r1gKBe7KozQeDBIF3iWpDchylGOMkOAmiT_yKHxpIOYTmk_VdV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaOplHfooV1_Cf2do_z9kOjrG_Y-XUgbnkDqxs9PNaMQ&oe=6AFDB67B"}, {"file_name": "screenshot_4.png", "id": "1065723952752476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_1065723956085809_4665558306741910487_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dihscLLaH3IQ7kNvwFFcnww&_nc_oc=Adqk6WmG1fu8bnK47k_46mZsTO0JJ9ViXp4qSW8Ee8G-Mj-sdYN0HLknXsYWRWzhv_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp4DMG9mBU3-Kt2MvQEamROk3a7XfA-PoczLzb-O2tVg&oe=6AFDD95D"}, {"file_name": "screenshot_5.png", "id": "2147630002794952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_2147630006128285_8225181624349080544_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvmaFGqWKaAQ7kNvwEX0qF-&_nc_oc=AdpNa14B4uGYcdNiyb61z4XN9Od7GxjlINKVHorhOZieunsQfG-lRgIr9TFg7_cFLzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStop3RfD9dYpTGdC2i-VWtqHcKo0KtOzyPTrJ3ya0DFw&oe=6AFDE2F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1987171958612225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673525341_1987171965278891_2325100490214879549_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JISR-lVbbXwQ7kNvwFMi6Ru&_nc_oc=AdoLX7kh0T7ySaC-FkM-s9lGekzinmMlhg9tLYKbUiz2wdyRq5o94gcpfoDee8Ub1UQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX0_Qyytf7vsZRNQOkZHR17co9CvEV1mpHN8cfNDP5yA&oe=6AFDE218"}, "display_name": "Flight Simulator 2", "keywords": ["multiplayer", "flight", "simulator", "fighter", "helicopter"], "long_description": "Flight Simulator 2 is the sequel: three real cockpits, a whole island to fly over, and your friends in the same sky.\n\nTHE FIGHTER JET\nStrap into a single-seat fighter with a bubble canopy, a live head-up display, a side-stick and an afterburner. Pull 9 G, fly loops and rolls, trail red, white and blue airshow smoke - and break the sound barrier with a vapour cone and a boom.\n\nTHE PRIVATE JET AND THE HELICOPTER\nBoth aircraft from the first game return: a business jet with a full glass cockpit and an autopilot, and a rescue helicopter you can hover anywhere on the island.\n\nFLY TOGETHER ONLINE\nQuick Match into an open sky, or host a private sky with a 4-digit code for your friends - up to eight pilots. JOIN UP to appear on a friend's wing in formation, or RIDE ALONG in the right-hand seat of their jet or helicopter and walk the cabin while they fly. Optional voice chat is off until you turn it on.\n\nCHOOSE YOUR PILOT\nThirteen airline pilots and military aviators - everyone online sees yours in your seat.\n\nMISSIONS\nScramble, Sound Barrier, Airshow, Overhead Break, Formation Flight, canyon and city runs, and scored landings day, sunset and night. Or just take off and fly free.\n\nMADE FOR VR\nA seated cockpit that recentres itself, an optional comfort vignette, and a crash is never the end - you are back in the air in seconds.", "short_description": "Break the sound barrier in a fighter jet, fly a private business jet or a rescue helicopter over a 32 km island - alone, or online with your friends. Real working cockpits, a head-up display, afterburner, airshow smoke, formation flying and ride-along co-op with 13 pilots to choose from."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulator2/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulator2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1260589507147022"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604317775_1438665584854629_3568057640698983600_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5YcikYU0iMQ7kNvwFu6Aeu&_nc_oc=AdoJmDOQ1ktNfsqkfV2rw0ze5i2WJIszbPTYtXDRv2pceHbZJKeCd81tDnO7skNI3fU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT80082D7BC2f5nVg54uJhhQgXsmgLMhECOp5Irfttnfw&oe=6AFDDA1B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Simulator 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1790696880, "lastRevision": {"nodes": [{"id": "1260589510480355", "release_type": 
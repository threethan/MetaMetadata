umbnail": {"file_name": "ArtistLandscape.png", "id": "565488253653358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12522489_565488256986691_7302768133595463680_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDoQGDhOCTYQ7kNvwEy6GJl&_nc_oc=Adol5XBk18MbbW1b7BoZ7t5e_jgyOI8qEMeCGe5jKlaWU9_N7958zfIqaYotpFTdjlU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3vJ8O_eolDpg6IKGS5mZw2kRzO6D0q7gSx5zqh0qEsQ&oe=6AFF20DE"}, "display_name": "The Artist", "keywords": ["adventure", "mystery", "puzzle", "fps", "exploration"], "long_description": "The Artist is a first person puzzle adventure inspired by other mysterious puzzle games like Myst, Riven, and The Witness.\n\nSucked into The Artist's canvas world, you must solve the strange puzzles scattered across his island to find a way back home. If you fail, you will be trapped inside the canvas forever. \n\n\u2022 Explore a colorful, vibrant, and fully realized canvas world\n\u2022 Enjoy atmospheric 3D sound effects and an orchestral score \n\u2022 Read books and find clues hidden carefully across the island \n\u2022 Solve devious puzzles built into the environment around you \n\nKeep your eyes open and your mind sharp - anything could be the key to solving his next puzzle.", "short_description": "Sucked into The Artist's canvas world, you must solve the strange puzzles scattered across his island to find a way back home. If you fail, you will be trapped inside the canvas forever. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://alexkeerma.com/the-artist/", "developer_terms_of_service_url": "http://alexkeerma.com/the-artist/", "publisher_name": "Motoda Media", "support_website_url": null, "website_url": "http://alexkeerma.com/the-artist/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZL
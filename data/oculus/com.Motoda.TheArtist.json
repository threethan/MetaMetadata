8202589184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yvk3MevgVU4Q7kNvwH6aHNn&_nc_oc=Adp-lrplig7p69cCszQ7ho8oQu5G0gMbj3BzRIAMKNhqFfMwW_egxUQAw5Bs6W8IHII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRN1mUxVjBSE_TGJGdxJ1yvdGGyJGRiQHdmlsVqv9v_A&oe=6A5246AA"}, {"file_name": "migrated_image.png", "id": "222270925640952", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602155_1107578682670854_8474569403902459904_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVpGiKP2kwgQ7kNvwE8dgRD&_nc_oc=Adr6OSJF-Z9Pc6seoKO-ITiwMF4SLegZKczEzQp62PT6YYlhT_ovCmxRxL6J1ZCZGxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3hhvbJrtgNhM5l-wEQHG42ZHOkN4BNOVugMjKsHOeqg&oe=6A5233C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ArtistLandscape.png", "id": "565488253653358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522489_565488256986691_7302768133595463680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skv6eQ_zwP8Q7kNvwELKZ6u&_nc_oc=AdoTnVBiQvtbRGALJwb-nFZAcmOT4463dunx5B3ZnPiZ86_Qlalzzz8yGaz5YJip16A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfA6lWHlE9VVeN1TqbWa_Qg6fN05AhqQVSsXyvioqqSw&oe=6A52341E"}, "display_name": "The Artist", "keywords": ["adventure", "mystery", "puzzle", "fps", "exploration"], "long_description": "The Artist is a first person puzzle adventure inspired by other mysterious puzzle games like Myst, Riven, and The Witness.\n\nSucked into The Artist's canvas world, you must solve the strange puzzles scattered across his island to find a way back home. If you fail, you will be trapped inside the canvas forever. \n\n\u2022 Explore a colorful, vibrant, and fully realized canvas world\n\u2022 Enjoy atmospheric 3D sound effects and an orchestral score \n\u2022 Read books and find clues hidden carefully across the island \n\u2022 Solve devious puzzles built into the environment around you \n\nKeep your eyes open and your mind sharp - anything could be the key to solving his next puzzle.", "short_description": "Sucked into The Artist's canvas world, you must solve the strange puzzles scattered across his island to find a way back home. If you fail, you will be trapped inside the canvas forever. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://alexkeerma.com/the-artist/", "developer_terms_of_service_url": "http://alexkeerma.com/the-artist/", "publisher_name": "Motoda Media", "support_website_url": null, "website_url": "http://alexkeerma.com/the-artist/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274140761455903"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1144967628931119", "version": "1.0"}, "id": "1890318821195889", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1135812063180009", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1144967628931119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1890318821195889"}]}, "change_log": "Initial Version", "created_date": 1479164240, "id": "1144967628931119"
8202589184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwa3WmT9hrcQ7kNvwFn0Eky&_nc_oc=AdqeHYbvLNPbNhDQuLhSIB1vHxUKf_ChuX1Bix6u7-1odtHEMH4UO9jt9XdGkcGOKqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuL-iixyDB7GXLu0_bxa912zdmLcNtJiWheGQVMpBoUg&oe=69CA7C2A"}, {"file_name": "migrated_image.png", "id": "222270925640952", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602155_1107578682670854_8474569403902459904_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UukBWvF3o24Q7kNvwGNkSjX&_nc_oc=AdpXEZIfKVOTHnpysu74qBO-Ps4icRmvGl2pajdPNj8Ug2sxVw9JLeMYpUHkcjUf6nM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjCUz4JAwHUa47fv8RlBp2f3z_yAdKAvHy-pEkCmb_nA&oe=69CA6942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ArtistLandscape.png", "id": "565488253653358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522489_565488256986691_7302768133595463680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBWhNbZ3RqUQ7kNvwGKkpB_&_nc_oc=AdqxqgTuzTgo8A7w6e47w5T9fvjQGMu0Y0uTTAsZNJkOxHPfmaPUiJaSqlcPXrkW588&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBFDSk9d8XO7BC2iHntjFYxkf94W-xi9AkuBApDWt0og&oe=69CA699E"}, "display_name": "The Artist", "keywords": ["adventure", "mystery", "puzzle", "fps", "exploration"], "long_description": "The Artist is a first person puzzle adventure inspired by other mysterious puzzle games like Myst, Riven, and The Witness.\n\nSucked into The Artist's canvas world, you must solve the strange puzzles scattered across his island to find a way back home. If you fail, you will be trapped inside the canvas forever. \n\n\u2022 Explore a colorful, vibrant, and fully realized canvas world\n\u2022 Enjoy atmospheric 3D sound effects and an orchestral score \n\u2022 Read books and find clues hidden carefully across the island \n\u2022 Solve devious puzzles built into the environment around you \n\nKeep your eyes open and your mind sharp - anything could be the key to solving his next puzzle.", "short_description": "Sucked into The Artist's canvas world, you must solve the strange puzzles scattered across his island to find a way back home. If you fail, you will be trapped inside the canvas forever. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://alexkeerma.com/the-artist/", "developer_terms_of_service_url": "http://alexkeerma.com/the-artist/", "publisher_name": "Motoda Media", "support_website_url": null, "website_url": "http://alexkeerma.com/the-artist/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274140761455903"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1144967628931119", "version": "1.0"}, "id": "1890318821195889", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1135812063180009", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1144967628931119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1890318821195889"}]}, "change_log": "Initial Version", "created_date": 1479164240, "id": "1144967628931119"
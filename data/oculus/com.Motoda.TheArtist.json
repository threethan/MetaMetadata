"fps", "exploration"], "long_description": "The Artist is a first person puzzle adventure inspired by other mysterious puzzle games like Myst, Riven, and The Witness.\n\nSucked into The Artist's canvas world, you must solve the strange puzzles scattered across his island to find a way back home. If you fail, you will be trapped inside the canvas forever. \n\n\u2022 Explore a colorful, vibrant, and fully realized canvas world\n\u2022 Enjoy atmospheric 3D sound effects and an orchestral score \n\u2022 Read books and find clues hidden carefully across the island \n\u2022 Solve devious puzzles built into the environment around you \n\nKeep your eyes open and your mind sharp - anything could be the key to solving his next puzzle.", "short_description": "Sucked into The Artist's canvas world, you must solve the strange puzzles scattered across his island to find a way back home. If you fail, you will be trapped inside the canvas forever. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://alexkeerma.com/the-artist/", "developer_terms_of_service_url": "http://alexkeerma.com/the-artist/", "publisher_name": "Motoda Media", "support_website_url": null, "website_url": "http://alexkeerma.com/the-artist/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274140761455903"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supporte
=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51GPyW3xHhoQ7kNvwGLvHMQ&_nc_oc=Adrf4gO7IKzWtNwEJ_8vTT3KG1yvcyiD1GjjZ9qD-NCxe6QVQt2OdMl5ptv5bt78Xn0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAyxyRgGGE3G2WGh-s02BL3hVGpnmBSprac0Lr30O2Dg&oe=69C51FD2"}, {"file_name": "5.png", "id": "1342301636473124", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569480_1342301643139790_7933622671683410596_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K72WeIdyI0Q7kNvwE4Lu25&_nc_oc=AdqlZXA0g3EP1XaA95FWtUsx5JAl9YQn7Bqm-f44e-4UlaHV1oetUIP9JBY0D3xf1SM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzx96kwTkmkYw91VGXtUM7BOq6GhxF_233go5ENKrmEAA&oe=69C54856"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail_Demo.png", "id": "1132472497792009", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974790_1132472501125342_7505565009975405162_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRnaQebY0dMQ7kNvwHaJdLf&_nc_oc=AdoLk1cSjpFECsq_UB9aQdGGmcQESSFeadsHF_Ps-jzulEpCWdgIqMHWWjZrmi0oH78&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvU6Zf1MKgXHR2v0FD7kzKj7jnOL6cW_5RWSjQ43EJkg&oe=69C53239"}, "display_name": "Beat the Beats Demo", "keywords": [], "long_description": "It means absolutely nothing if you don't have that swing, jab, or the finesse of that left hook! Enter Beat the Beats \u2013 the boxing rhythm VR game where you throw punches but you can\u2019t fight the rhythm. Use actual boxing moves like crosses, rolls and uppercuts to blast your way through a series of electrifying musical levels and climb the leaderboards.\n\nUnlock new genres, complete daily challenges, and build your skill in rhythm boxing. For the serious competitor, there\u2019s also an extra challenging B-Side for each track that will make you sweat to master.\n\nBeat the Beats is a fun and fresh boxing experience for both greenhorns and champions!\n\n\n\nFeatures:\n- Learn natural boxing moves like jab, hook, uppercut, rolls and block!\n- Get moving with a workout that doesn\u2019t feel like work! \n- Compare your skills in global leaderboards and beat daily challenges!\n- 35 handpicked tracks from different electronic music genres in over 60+ levels!\n- Unlock new genres and B-sides!\n- Keep things fresh with daily mixes!\n- A fun, immersive experience with plenty of depth for the dedicated rhythm champion!", "short_description": "Beat the Beats is an electric mix of rhythm and boxing game! Use actual boxing-style punches to pound your way through musical arcade levels in hypnotic VR. Get pumped, get moving and beat the beats!"}]}, "developer_name": "Parallel Circles", "developer_privacy_policy_url": "https://parallelcircles.com/privacyMeta.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Circles", "support_website_url": null, "website_url": "https://parallelcircles.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7163169887111473"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2472160456470806"}, {"status": "PUBLISHED", "id": "1057045658705126"}]}, "baseline_offer": {"id": "2472160456470806"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750231440, "status": "PUBLISHED", "id": "2472160456470806"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Andro
mRVOatFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EQiOAdaGaQZvem5rG5jCGlj5E1eG5yBkFE5drK_qCiQ&oe=6A3E90E6"}, {"file_name": "Random_SS.png", "id": "490532450566087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_490532453899420_5317964212918178904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoWSfZbR4T8Q7kNvwEey7hH&_nc_oc=Adpj2dPO3uW6UobIBUBblieO6xnOOhF7DZCPFUatvQTOSqC9-Sk7cg655cmI0hrG838&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yhiaAZehb9dDuZ2T3aH31DwO18dzqgJ6sOaoDxkDPsg&oe=6A3EA2CC"}, {"file_name": "Survive_SS.png", "id": "1126102002269148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036669_1126102005602481_329372597537079669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AkrGsQB9HYQ7kNvwHDrDCV&_nc_oc=AdoaVFEFmRxjmmhjY7U_f5TJw5C31n5IoD1zp3KAy0OueoqdTFImZbCzj753aXvj9K8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Wmqlju8dS0mpxmqdhV1n6Gkro15A1d8vAfCsrlwyMYQ&oe=6A3E881D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surfer_VR_Icons (2560 x 1440 px).png", "id": "2531915217181707", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619369_2531915220515040_7124662901031447625_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNIWHZpEDAEQ7kNvwG7vAHt&_nc_oc=AdpDUgx_faEv4D_nT2MVAl4_t47yY-4Poa7BymXkBBwjjmIByDJ3OxE7UiW5HES-fO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af946s2J36ilrwFq56BaAZNugi6yDnYjGMZlTJbZnTBzXg&oe=6A3E88C4"}, "display_name": "Still Alive", "keywords": ["Zombie", "Shooter", "Survival", "Apocalypse"], "long_description": "Step into the apocalypse with 4 immersive game modes:\n\nSurvive: Face relentless waves of zombies. Scavenge for limited weapons and ammo as you fight to stay alive.\n\nProtect: Civilians need your help! Guard them from the undead until rescue arrives. Every second counts.\n\nTrain: Sharpen your aim and movement. Perfect your zombie-slaying skills in a dedicated training ground.\n\nFruit-Zen: After the chaos, find your peace. Enter a serene world where you can slice and shoot fruits in a calming environment. \ud83c\udf43\ud83c\udf49\n\nDo you have what it takes to emerge victorious and be Still Alive? ", "short_description": "Step into the apocalypse with 4 intense game modes:\n\nSurvive: Battle endless waves of zombies with limited resources.\nProtect: Defend civilians until rescue arrives.\nTrain: Master your aim and movement.\nFruit-Zen: Unwind by slicing fruits in a serene setting. \ud83c\udf43\ud83c\udf49\nCan you stay Still Alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-still-alive", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24228704203460205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507827918_1546706863138644_8378979585856366341_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fdg7AZjMr0Q7kNvwELtsGI&_nc_oc=AdpOgad_9B5K1wFFKMqMJl_APCxde_la7M0z_KHPQq2148tl93h8w3GDc17M3RkKWGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss
Uyo-AChM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TqfICNAJ2rVxMKv62Kd56jMgKtVHeiPiBvcqJXse-GA&oe=69D7BBE6"}, {"file_name": "Random_SS.png", "id": "490532450566087", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982510_490532453899420_5317964212918178904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5T2ntVvL70Q7kNvwG3uzd0&_nc_oc=Adqnhuz_zML8MqXAg5nJgdXnYn0FhIgj--L3Bprma-uqvO6k2n_qfoqb22XOyv3SKGw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jnq87qA5pECg32n-r6CAloOChTqcBKfUKwBemKA2lqQ&oe=69D7958C"}, {"file_name": "Survive_SS.png", "id": "1126102002269148", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036669_1126102005602481_329372597537079669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T921XZeAksQ7kNvwFWm-cJ&_nc_oc=Ado-O4XLSuSnxPGcQH-E2vVGfY3EGcCQz9oRGg3Eda2zlkmxrwpon6tBu1SoG2B3R9A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M7AX4zOMPfpTOzljG1-CG9vy-Ict5i47NKgUwE1c2rg&oe=69D7B31D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surfer_VR_Icons (2560 x 1440 px).png", "id": "2531915217181707", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619369_2531915220515040_7124662901031447625_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7aQcadxr2MQ7kNvwGCUry2&_nc_oc=Adp6fsoCOYOWoQwqKdki8k8MUrgfpZITMiLmv390Sr8aYnDMWuhmKnXi-jf80KFjJEI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af017jUYdP1rjDo_ZY0pcyRnZUrLLu_amOgTwLcO2Y6mWg&oe=69D7B3C4"}, "display_name": "Still Alive", "keywords": ["Zombie", "Shooter", "Survival", "Apocalypse"], "long_description": "Step into the apocalypse with 4 immersive game modes:\n\nSurvive: Face relentless waves of zombies. Scavenge for limited weapons and ammo as you fight to stay alive.\n\nProtect: Civilians need your help! Guard them from the undead until rescue arrives. Every second counts.\n\nTrain: Sharpen your aim and movement. Perfect your zombie-slaying skills in a dedicated training ground.\n\nFruit-Zen: After the chaos, find your peace. Enter a serene world where you can slice and shoot fruits in a calming environment. \ud83c\udf43\ud83c\udf49\n\nDo you have what it takes to emerge victorious and be Still Alive? ", "short_description": "Step into the apocalypse with 4 intense game modes:\n\nSurvive: Battle endless waves of zombies with limited resources.\nProtect: Defend civilians until rescue arrives.\nTrain: Master your aim and movement.\nFruit-Zen: Unwind by slicing fruits in a serene setting. \ud83c\udf43\ud83c\udf49\nCan you stay Still Alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-still-alive", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24228704203460205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/507827918_1546706863138644_8378979585856366341_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZ3sBzdantkQ7kNvwFICrTG&_nc_oc=AdolS6ovx3gk6z28kuazwyWMxMORCcaFml1ChDSdfYcMIAkrTqjybE8--aLBT8Rh5ak&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss
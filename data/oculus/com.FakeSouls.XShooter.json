Yk-_3lUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5GgY_n-gYrGL6qLF0pZ-bXVi1DxAAJtJ4uXDDcrmD7w&oe=6ADE1666"}, {"file_name": "Random_SS.png", "id": "490532450566087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982510_490532453899420_5317964212918178904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm-xrAMJdH4Q7kNvwFUBK3k&_nc_oc=AdrBhySXU44L-h93XV0oH693XZxxB7Y_kNm8csueUe5J7d3qQEIfnlTAG2SBrpLXdeE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnDZSkJdT1BY-s0HVE6aSNl8Z0nnpyW1DJK69CJQTrjw&oe=6ADE284C"}, {"file_name": "Survive_SS.png", "id": "1126102002269148", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036669_1126102005602481_329372597537079669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6mOv9CHbXsQ7kNvwE6Y_lo&_nc_oc=AdoI9EFfwjiA66U2vzOmRUoCd7IrE24sHwsGj6DfHJdbUMTkUI4recTJFHOJ4tX-GX0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXXPhJDpYV6i6aNtKdm314OyRbOvZ4rMFTRbCfflw2FA&oe=6ADE0D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surfer_VR_Icons (2560 x 1440 px).png", "id": "2531915217181707", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619369_2531915220515040_7124662901031447625_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT2zGuw9XVAQ7kNvwFP_n1E&_nc_oc=Ado_1gNQEV5FdgBsVe4EwgXRs19o8kuwNZ1RAHgYATzVFAfpsSSochxxWn9NuzICbuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_PkHP1WKYExTZH8iw9UB-PRhRZVX4lb6xE6dy4DH-dg&oe=6ADE0E44"}, "display_name": "Still Alive", "keywords": ["Zombie", "Shooter", "Survival", "Apocalypse"], "long_description": "Step into the apocalypse with 4 immersive game modes:\n\nSurvive: Face relentless waves of zombies. Scavenge for limited weapons and ammo as you fight to stay alive.\n\nProtect: Civilians need your help! Guard them from the undead until rescue arrives. Every second counts.\n\nTrain: Sharpen your aim and movement. Perfect your zombie-slaying skills in a dedicated training ground.\n\nFruit-Zen: After the chaos, find your peace. Enter a serene world where you can slice and shoot fruits in a calming environment. \ud83c\udf43\ud83c\udf49\n\nDo you have what it takes to emerge victorious and be Still Alive? ", "short_description": "Step into the apocalypse with 4 intense game modes:\n\nSurvive: Battle endless waves of zombies with limited resources.\nProtect: Defend civilians until rescue arrives.\nTrain: Master your aim and movement.\nFruit-Zen: Unwind by slicing fruits in a serene setting. \ud83c\udf43\ud83c\udf49\nCan you stay Still Alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-still-alive", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24228704203460205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507827918_1546706863138644_8378979585856366341_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWtcIHMBe18Q7kNvwH6HQ7N&_nc_oc=AdpIbQcR-HeshaQfAaDZeBhUpMlkxdTfifCB3R25Q7NxoWL9Y0mk5QM2HULM_AkuHgY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss
p4rOXcv_i-XwGTsRyMdww02Kz-og39DiGjJ9wpsUjRGwcqE9cDFsATM0QiwZVy2Fc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD2sR6QsDjS6ef_npBAhCG94RLR7KWmij9gfQu54vdnQ&oe=6AA56599"}, {"file_name": "SS_3.png", "id": "671394514901477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65395359_671394518234810_948262017924293651_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqdLm7uPc54Q7kNvwEL7Vih&_nc_oc=Ado5gpefTei3KXeRXZnZ9KCpYTxZ_z2qT6JaThVq8fjxpTJrM7tTaZTthCdsq5Bdy18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTQJ5Gv9NhW-ZiRhz8VYG3trgokjfcT_36r4TZECxVwA&oe=6AA56A8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StillAlive_Cover_High.png", "id": "1788063371681094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035462_1788063375014427_2239583192986921791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dByklHynnS8Q7kNvwEaHwbv&_nc_oc=Adq2fvJzcTfshpjr0jf9FvJNNF6WMNRSwazGrCY1VV1A4d_lOa94-zB2MsikcveDVtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW4mGRWp7-Bc9mAA1W607Z6_klgE0kqDvJraO22CuBzQ&oe=6AA5708D"}, "display_name": "Still Alive", "keywords": [], "long_description": "Immerse yourself in the thrilling world of Still Alive, an FPS Zombie Arcade Shooter that redefines the gaming experience. \n\nNavigate through waves of zombie horrors, strategically exploring the map to scavenge for essential supplies like guns, ammo, and health kits to ensure your survival. Take on the crucial responsibility of guarding survivors from relentless zombies until help arrives, all while mastering the art of staying alive. \n\nAdditionally, indulge in the enjoyable challenge of shooting fruits with an array of guns in the train mode within a specified timeframe. Elevate your skills at the shooting range, honing your aim, movement, and various other abilities. \n\nThis game offers a multifaceted adventure that combines action, strategy, and fun in the immersive realm of virtual reality.", "short_description": "Dive into the undead mayhem with \"Still Alive,\" an arcade zombie shooter featuring three thrilling game modes. \n\nSurvive waves of zombies with limited weaponry, rescue hostages in a race against time, and sharpen your aim in the fruit-shooting train mode. \n\nThis VR experience is an exhilarating must-have! Checkout this game today for an intense gaming adventure like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://altamashkalania.wixsite.com/fakesouls/privacy-policy-still-alive", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://altamashkalania.wixsite.com/fakesouls", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7088966924527200"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1426719156000882"}, {"status": "PUBLISHED", "id": "2131801444131049"}, {"status": "PUBLISHED", "id": "1008444318560437"}, {"status": "PUBLISHED", "id": "949479187686991"}, {"status": "PUBLISHED", "id": "1440343560756444"}, {"status": "PUBLISHED", "id": "4356912141205647"}, {"status": "PUBLISHED", "id": "1476969203369634"}, {"status": "PUBLISHED", "id": "25373410352298489"}, {"status": "PUBLISHED", "id": "1824359061450793"}, {"status": "PUBLISHED", "id": "1047620804238328"}, {"status": "PUBLISHED"
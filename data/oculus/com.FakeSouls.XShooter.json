LSdlOQKE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOT8IjLDYTZ2EghTaygX3H61oaHJ7SZ-mFgxQrb7LCpg&oe=6A9015A6"}, {"file_name": "Random_SS.png", "id": "490532450566087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_490532453899420_5317964212918178904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l0F_T_h_qwQ7kNvwEpOz2N&_nc_oc=AdqvNAmn-bJ4MRljEsM0-vwqJ62NotcyfCgu3Q9-kH0962Bl7LCy0yF5xTkjpX0EJ10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1CG5EzOYMbvneJZnp0BPvcAIpB04MYtIY6WF824RLRA&oe=6A90278C"}, {"file_name": "Survive_SS.png", "id": "1126102002269148", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036669_1126102005602481_329372597537079669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZWWyWx1fQgQ7kNvwEFD14s&_nc_oc=Adp_DwV9FcfcGnkrZYpGAusEoU8e3TGzDvXl5Zmgcw0gtmzeoBCBdWOocp5JHmjM-8g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9j9pVjW9xW8bsB-973hs1LRYuFo6wiVOeqT_ZHovlFw&oe=6A900CDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surfer_VR_Icons (2560 x 1440 px).png", "id": "2531915217181707", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619369_2531915220515040_7124662901031447625_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUvFOSFoydoQ7kNvwGZltX-&_nc_oc=AdpwdF-nBIBjZX5jYwhytEM__VttpWyUbQszCfHYXr-OASNYx7LKCPRzCYr6zvVYP6k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt7HlSImYtMN6PnCnmXA886WHSVDXmuXsMUxNwFItoNw&oe=6A900D84"}, "display_name": "Still Alive", "keywords": ["Zombie", "Shooter", "Survival", "Apocalypse"], "long_description": "Step into the apocalypse with 4 immersive game modes:\n\nSurvive: Face relentless waves of zombies. Scavenge for limited weapons and ammo as you fight to stay alive.\n\nProtect: Civilians need your help! Guard them from the undead until rescue arrives. Every second counts.\n\nTrain: Sharpen your aim and movement. Perfect your zombie-slaying skills in a dedicated training ground.\n\nFruit-Zen: After the chaos, find your peace. Enter a serene world where you can slice and shoot fruits in a calming environment. \ud83c\udf43\ud83c\udf49\n\nDo you have what it takes to emerge victorious and be Still Alive? ", "short_description": "Step into the apocalypse with 4 intense game modes:\n\nSurvive: Battle endless waves of zombies with limited resources.\nProtect: Defend civilians until rescue arrives.\nTrain: Master your aim and movement.\nFruit-Zen: Unwind by slicing fruits in a serene setting. \ud83c\udf43\ud83c\udf49\nCan you stay Still Alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-still-alive", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24228704203460205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507827918_1546706863138644_8378979585856366341_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gibIRN-szKsQ7kNvwGUKIbt&_nc_oc=Adoq8GbX-gk-f8cABtSSXFeuOP-twE0KsB7qrsvdEN2gVcT0PEGwLkjV9FwqfLFn7Pk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/75363514_1528812924676163_7667272891227340181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFVyzVSy1L8Q7kNvwH7azCl&_nc_oc=Ado_CiL3Z-xH9WwQLoA8vOIg9KME4n4y9CAK5xCtMznbf2fmx4SCZMF9EQ9_Ij50i_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSgrRHnoA5ucF7Dt2Hb37ZQ3jqNns4ubt-3upTPBc0hQ&oe=6AFC68E6"}, {"file_name": "Random_SS.png", "id": "490532450566087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_490532453899420_5317964212918178904_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJ4t458Uq_4Q7kNvwEGQlFe&_nc_oc=Adqt_Qq0NRJwetBqbhRaE-TggO5yuPMhJ4ZIznyw1uqdLc5UhXWfO2GaMGxG2B4dYgg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK1I6qhSlJABSnRopc7RNkbaNhkglLj2ZG__NXEl4I4Q&oe=6AFC7ACC"}, {"file_name": "Survive_SS.png", "id": "1126102002269148", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036669_1126102005602481_329372597537079669_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kh_Bvkk2CiQQ7kNvwGnLV3D&_nc_oc=AdrHpLj89Pq-WYvQLdrdVNVY87k_VSFKreR4snzi9dyAVz9fU5tlqOjrBk99R0dS9Xg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjqLasAQ9WwDK4mV7RUwGrx3SYwzr5C-QgO3aKQiFw4g&oe=6AFC601D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surfer_VR_Icons (2560 x 1440 px).png", "id": "2531915217181707", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_2531915220515040_7124662901031447625_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7idXTjdv64IQ7kNvwEcMQ0e&_nc_oc=Adpzg4A3Y8JOvoYe-HxBowrGwRJFaxev8Jek2hf3zWxBrbzlv5bOrAdjGFAx34k1QN4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP7ZOKAFkf-GBQCiD3HXbrpDD36pxEK43X9fprbuY6qQ&oe=6AFC60C4"}, "display_name": "Still Alive", "keywords": ["Zombie", "Shooter", "Survival", "Apocalypse"], "long_description": "Step into the apocalypse with 4 immersive game modes:\n\nSurvive: Face relentless waves of zombies. Scavenge for limited weapons and ammo as you fight to stay alive.\n\nProtect: Civilians need your help! Guard them from the undead until rescue arrives. Every second counts.\n\nTrain: Sharpen your aim and movement. Perfect your zombie-slaying skills in a dedicated training ground.\n\nFruit-Zen: After the chaos, find your peace. Enter a serene world where you can slice and shoot fruits in a calming environment. \ud83c\udf43\ud83c\udf49\n\nDo you have what it takes to emerge victorious and be Still Alive? ", "short_description": "Step into the apocalypse with 4 intense game modes:\n\nSurvive: Battle endless waves of zombies with limited resources.\nProtect: Defend civilians until rescue arrives.\nTrain: Master your aim and movement.\nFruit-Zen: Unwind by slicing fruits in a serene setting. \ud83c\udf43\ud83c\udf49\nCan you stay Still Alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-still-alive", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24228704203460205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
jKz3Ju_c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YfbRS4VOUXlU4LViOaknQUG8ZJM8lpZyqQXCKH-savA&oe=6A106C66"}, {"file_name": "Random_SS.png", "id": "490532450566087", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982510_490532453899420_5317964212918178904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFtw49jamXEQ7kNvwGiPqi8&_nc_oc=Ado_Yw6LkQhZb6QX-eysiR8usHYBiXTwpT_tPediu9zze_yKzndnpS0g9PaKL0QFp1I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J0i6gp3pgah076OdTzEZBsa9S6AgDV3wzIaq_d1KJHQ&oe=6A107E4C"}, {"file_name": "Survive_SS.png", "id": "1126102002269148", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036669_1126102005602481_329372597537079669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yrkd9e8zvG8Q7kNvwGjLz7f&_nc_oc=AdrVpOTXt0RY0ryVZLFkssejMgux2SeYxOVTvgiMG1HewTRqtLvR8OB4cRhPENd1uMQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VP1od8tFC4GfDNmgVLZq1HquPWwudhh_JLh31ueAKjw&oe=6A10639D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surfer_VR_Icons (2560 x 1440 px).png", "id": "2531915217181707", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619369_2531915220515040_7124662901031447625_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeW75Oko8sQQ7kNvwGb0_a9&_nc_oc=AdpsVuMI9STyj0E0_mzSIjqZcyjcTpDisNJussDCXEfE5gCknihVBtl64q_CpukTzc0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cWqLlzU8wC6eZ83nQEdMNxBCZpbLVx8Z6QCr_KCVRZA&oe=6A106444"}, "display_name": "Still Alive", "keywords": ["Zombie", "Shooter", "Survival", "Apocalypse"], "long_description": "Step into the apocalypse with 4 immersive game modes:\n\nSurvive: Face relentless waves of zombies. Scavenge for limited weapons and ammo as you fight to stay alive.\n\nProtect: Civilians need your help! Guard them from the undead until rescue arrives. Every second counts.\n\nTrain: Sharpen your aim and movement. Perfect your zombie-slaying skills in a dedicated training ground.\n\nFruit-Zen: After the chaos, find your peace. Enter a serene world where you can slice and shoot fruits in a calming environment. \ud83c\udf43\ud83c\udf49\n\nDo you have what it takes to emerge victorious and be Still Alive? ", "short_description": "Step into the apocalypse with 4 intense game modes:\n\nSurvive: Battle endless waves of zombies with limited resources.\nProtect: Defend civilians until rescue arrives.\nTrain: Master your aim and movement.\nFruit-Zen: Unwind by slicing fruits in a serene setting. \ud83c\udf43\ud83c\udf49\nCan you stay Still Alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-still-alive", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24228704203460205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/507827918_1546706863138644_8378979585856366341_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpULLHGH_AYQ7kNvwGcJckv&_nc_oc=Adro4bfNEc3DBWLtmXtBX2unlt5clfP1D0PbRC1VnOvlBTZAw_7zPje6q6U4miQJiRs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss
2dg&oe=699D81A6"}, {"file_name": "Random_SS.png", "id": "490532450566087", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982510_490532453899420_5317964212918178904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAtGEL0fnoEQ7kNvwFObPRU&_nc_oc=Adm3oZrkR5ahiq5WPjwnf-wE_UQ-j6wSa1OGDYBalLnTkazn0dlOudAbo6bUGpfGaTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMTG-TTf7yGpmVJrp7xB7c5TPx-lNLP_kNd_mlBO27XQ&oe=699D938C"}, {"file_name": "Survive_SS.png", "id": "1126102002269148", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036669_1126102005602481_329372597537079669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2GudXERSNYQ7kNvwFQR2gl&_nc_oc=AdlQZaxLeI6MrwY1LGa8QTkxY4xIANH37gZVpY1MR-ONzoL_b-3Vz4F0ObqSGWDZSQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsBD-a81KY0MlOiCTHpB_b4SI59SFq1SkHjb02v57BTpw&oe=699DB11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surfer_VR_Icons (2560 x 1440 px).png", "id": "2531915217181707", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619369_2531915220515040_7124662901031447625_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ci4-dxZS7mwQ7kNvwFE4gv3&_nc_oc=AdkN78OxHH_G3pK7kPd9dURC7UpYWpzhcl-p110250N3hXSmKE4CY-OcF0jf9kqmZjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEfajvd1bcBzRIDu4_dK-yQNu0eJbeS_nyAa9fkI1o5A&oe=699DB1C4"}, "display_name": "Still Alive", "keywords": ["Zombie", "Shooter", "Survival", "Apocalypse"], "long_description": "Step into the apocalypse with 4 immersive game modes:\n\nSurvive: Face relentless waves of zombies. Scavenge for limited weapons and ammo as you fight to stay alive.\n\nProtect: Civilians need your help! Guard them from the undead until rescue arrives. Every second counts.\n\nTrain: Sharpen your aim and movement. Perfect your zombie-slaying skills in a dedicated training ground.\n\nFruit-Zen: After the chaos, find your peace. Enter a serene world where you can slice and shoot fruits in a calming environment. \ud83c\udf43\ud83c\udf49\n\nDo you have what it takes to emerge victorious and be Still Alive? ", "short_description": "Step into the apocalypse with 4 intense game modes:\n\nSurvive: Battle endless waves of zombies with limited resources.\nProtect: Defend civilians until rescue arrives.\nTrain: Master your aim and movement.\nFruit-Zen: Unwind by slicing fruits in a serene setting. \ud83c\udf43\ud83c\udf49\nCan you stay Still Alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-still-alive", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24228704203460205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507827918_1546706863138644_8378979585856366341_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taItRLZSTNwQ7kNvwHBltD-&_nc_oc=AdnYx2VPvND_y9OJzA0xil5Fm0gF7SqzBtdtvi7LEynmipX8Qfbz2FvVaP9qRlZVpks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLRbyBYOxxee3xn7WJnAuGE5E2FjokK_OaTg27n7kSCA&oe=699DAB91"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Still A
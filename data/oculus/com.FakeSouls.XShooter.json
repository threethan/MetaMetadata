SqCygTqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__8VDo5xaufv7wzuM1JKfCsZXamQEaY7OyxGtTlIbfug&oe=6A3161E6"}, {"file_name": "Random_SS.png", "id": "490532450566087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_490532453899420_5317964212918178904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEoRdHo3v9IQ7kNvwHRVAnB&_nc_oc=AdoL5OMQCO5xAXaeSXDOryVbedtN1pCsP_nH_JLO-TDspdj-SE9U3_8whYquc7ka4yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-voDC94qQjf4Xzsy0aM9lqS664jFJuCqXbhk6sT2fLxA&oe=6A3173CC"}, {"file_name": "Survive_SS.png", "id": "1126102002269148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036669_1126102005602481_329372597537079669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm5xRrEY7oYQ7kNvwFCAdX5&_nc_oc=Adp9l4lpYKa7hQvIlB3ZPlum4PAsurxnmfSYyt0x6h0t8MKGOlSGiMZj9IMpQUrOSvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9Z-e_E31Nxlno6JaRLVY7pW0yA64BZboW6b6acisy3g&oe=6A31591D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surfer_VR_Icons (2560 x 1440 px).png", "id": "2531915217181707", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619369_2531915220515040_7124662901031447625_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFiIZPl0rSIQ7kNvwGRFPrX&_nc_oc=Adp4ymT61ORMURypUCn1rryoIf6iAkYMkI4Ax8O1RV-BlN2vBFoe8WOk-_Fw4W0USyE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hPFI5Lr_yWkTcFabgYZdV7E2y_sVQ4HQZKYHlU0VL8A&oe=6A3159C4"}, "display_name": "Still Alive", "keywords": ["Zombie", "Shooter", "Survival", "Apocalypse"], "long_description": "Step into the apocalypse with 4 immersive game modes:\n\nSurvive: Face relentless waves of zombies. Scavenge for limited weapons and ammo as you fight to stay alive.\n\nProtect: Civilians need your help! Guard them from the undead until rescue arrives. Every second counts.\n\nTrain: Sharpen your aim and movement. Perfect your zombie-slaying skills in a dedicated training ground.\n\nFruit-Zen: After the chaos, find your peace. Enter a serene world where you can slice and shoot fruits in a calming environment. \ud83c\udf43\ud83c\udf49\n\nDo you have what it takes to emerge victorious and be Still Alive? ", "short_description": "Step into the apocalypse with 4 intense game modes:\n\nSurvive: Battle endless waves of zombies with limited resources.\nProtect: Defend civilians until rescue arrives.\nTrain: Master your aim and movement.\nFruit-Zen: Unwind by slicing fruits in a serene setting. \ud83c\udf43\ud83c\udf49\nCan you stay Still Alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-still-alive", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24228704203460205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507827918_1546706863138644_8378979585856366341_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjKQZfI7fHkQ7kNvwEvLidR&_nc_oc=Adr8HN-LYd2qHWCPGQeUXv5mftZcjx_ASUAVX9_JTL2AVTmmP_MEtGVp6XYz4ejFqRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss
/t64.5771-25/75234369_945077817016659_23140257978207096_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOg8L8GCXvoQ7kNvwFnLwsH&_nc_oc=AdrwQrgMXQnLgO3QnqZfH9J1SpUU9b7P4HSf4tRKcdqZj2g140lxdSJcMSPrAPh6bn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxFKoIhL4qr5Nzk_fhKtb1UwNw5zhj_zW4fu47fzDA7g&oe=6B0C8073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stilt_CoverArt_Landscape.png", "id": "340319788989400", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_340319792322733_8679089536552678010_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8Le98auIMAQ7kNvwEtd2rQ&_nc_oc=AdqrKMzvLK2Sb4r76FhELhY67UzQ3ykHEXmnnwekz2X78176thxfYe7i-xbsCKfBlds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTH1xIpugKvOkZvbL-WwGVVLYCDRS7ZNvb765L4HqFApg&oe=6B0C4CD3"}, "display_name": "Stilt", "keywords": [], "long_description": "Embark on an exciting adventure in a 3D platformer game designed for virtual reality on Oculus Quest. With two stilts/springs attached to each hand, you'll use your unique locomotion skills to jump and run through challenging levels and overcome obstacles. Your mission is to retrieve your stolen spaceship, taken by a giant octopus that lives atop a volcano. As you make your way towards your goal, you'll collect cogwheels scattered throughout the levels to aid you in your journey.\n\nThis game takes inspiration from classic platformers and offers a fresh, immersive experience in virtual reality. You'll be transported to a world filled with danger and excitement, where you must use your quick reflexes and problem-solving skills to progress through the levels. With stunning stylized graphics, smooth controls, and an engaging gameplay experience, this VR platformer is sure to provide hours of entertainment. So put on your Oculus Quest and get ready to experience the thrill of jumping and running through a virtual world like never before.", "short_description": "Jump and run through thrilling levels in a platformer game for VR! Use your stilts to overcome obstacles and collect cogwheels on your quest to retrieve your stolen spaceship from a giant octopus atop a volcano. Classic platforming fun in an immersive 3D world. Get ready to experience the adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stilt-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "Rekt Games", "support_website_url": null, "website_url": "https://stiltgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1229311244379203"}}]}, "scheduled_offers": {"count": 22, "nodes": [{"status": "PUBLISHED", "id": "1050087168103723"}, {"status": "PUBLISHED", "id": "1741251040421726"}, {"status": "PUBLISHED", "id": "1551526836760588"}, {"status": "PUBLISHED", "id": "2579626172452593"}, {"status": "PUBLISHED", "id": "1472657274329158"}, {"status": "PUBLISHED", "id": "1825902041431829"}, {"status": "PUBLISHED", "id": "1590833582120727"}, {"status": "PUBLISHED", "id": "1112375917548371"}, {"status": "PUBLISHED", "id": "1198184265657820"}, {"status": "PUBLISHED", "id": "2068761830528253"}, {"status": "PUBLISHED", "id": "1278148663788672"}, {"status": "PUBLISHED", "id": "1370050630767601"}, {"status": "PUBLISHED", "id": "658
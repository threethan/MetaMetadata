odkMQ7kNvwG0X_yM&_nc_oc=Adl5HWJRbQC_WyM4mr7xCmkFMbek5y9UPW5Fv9ceFtC7R3WbOwbXnYtiIFsF6GMBnSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftmcccvNttnBeQul8V1Y-KpFoXANGZKQJ-sSuvkp_Xe1g&oe=699EE207"}, {"file_name": "migrated_image.png", "id": "684555512317076", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974598_350524418947690_5568108392670560256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPsO1CSvUDkQ7kNvwEbtpvY&_nc_oc=Adk4uAdIciRcBs5XQ-nj7Ru2ZQYJPtTFN7xvaSVTkbJmZoVIayu7VUM3Sf7iYR7Jq9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv0BfRmBJbdKISdyXoflZhR8wAalHVsJ0XMwTlRDo-NhA&oe=699EF791"}, {"file_name": "migrated_image.png", "id": "523057178609343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001693_723230428091465_5552455843921788928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7UBSSXK-4IQ7kNvwHiM0q6&_nc_oc=AdmeL7ujtfnetqyCrhvSi1-9EhV0RbotM6gQEwj-nXZowjvalTB4hB8RGV5ind5ia6k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftWlCGCgSbE7qr4fFPCGTg2mcnmB0TDyymiulXAhBOGTA&oe=699ED4FE"}, {"file_name": "migrated_image.png", "id": "817081308792868", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003240_2301922376592590_144630073050267648_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2qtam0G8UQQ7kNvwHyfAUG&_nc_oc=Adkm4UgX1PqINxWifFkre4sagIFYf4z3mx5S949jnFky4h3nqSHnP4oQRizSIPxdTto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv-kwsowlhV8CQBBjH_6vv0PsN4PVUYpVWptjXuEec1QQ&oe=699EFEC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/f5y9FO", "id": "859163614449109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031477_859163617782442_7393343560734474240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjKz8Q1nKs4Q7kNvwFawHUl&_nc_oc=Adk7PChoApLI_TKY4QYBmFGhbKH_biHBR4RsyJOiHYnvMvGbL81bJh-ip9JbNSdGmS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfumdyBYUOYPXA-ZOsSLWUzWEZwyBttawrTDmX2cat06PQ&oe=699EDCB2"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery. Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Vertigo Games and Knucklehead Studios", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Vertigo Games", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQU
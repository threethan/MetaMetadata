hYIwQ7kNvwGH9iAO&_nc_oc=AdmjZBBz9bepMK2yOlz2CNmQBRGRU4j1lHcTIKFsQbgeryh2NiwelTwcSlEVPvKkM-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsgLt09jfhclLYbvCgErsfi8cACw_2b0HLTucgmfojhqA&oe=69999C07"}, {"file_name": "migrated_image.png", "id": "684555512317076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974598_350524418947690_5568108392670560256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFfPq0FjB40Q7kNvwEgfZ5H&_nc_oc=AdmtZbEkDhpnAl6usaRhPTMzeqT-SDwRAVQlr0XLCSGCWGuZ5srWr5FOVnFWJ0HzH-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvUUNLe9w1enN-FTvJ7susD3NmO5Ai3HMdMTkum6zzmHw&oe=6999B191"}, {"file_name": "migrated_image.png", "id": "523057178609343", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001693_723230428091465_5552455843921788928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIBHprAfJDUQ7kNvwFiLRkb&_nc_oc=AdlZnNiM4yVcudPqkV3Ymk9xOYCIBzZJD1KzdGo0rKFaiXetoyq-OtM5niJB6ns8Z18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfunB6heoTFdQ9-JhS2A3uR3TOHbVqSeTyWT6aYwMaGTIQ&oe=69998EFE"}, {"file_name": "migrated_image.png", "id": "817081308792868", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_2301922376592590_144630073050267648_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyLkaQnrZ88Q7kNvwHRVUkq&_nc_oc=Adl75DeUu3gguS5MCu84j0A0ujZztR1pHUfSk5ZUc3EVH6mMirSepJbhQ1JZNA3-PMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft_hrkF4vPXG92Hr1KuvvNIZOm9nxWRxEGrus00QMcBMQ&oe=6999B8C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/f5y9FO", "id": "859163614449109", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031477_859163617782442_7393343560734474240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGksKkOZeNoQ7kNvwFFHag-&_nc_oc=AdlB7XplC3_EjkD7vo1DatIsGwFhIEKqy5mvZyUmi3xVgRAh8nIGIrB1ibKXgYGuxSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsl7e1WTWjb-wd0N0fAGZbGQVCYquyIl-bA6ncZYYYyVw&oe=699996B2"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery. Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Vertigo Games and Knucklehead Studios", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Vertigo Games", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQU
ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9-EKhaLj87CBObu1yy2fetdjpH_VmYJba-heUVIuLfQ&oe=6B0B1500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/f5y9FO", "id": "859163614449109", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031477_859163617782442_7393343560734474240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odVSZZPitsYQ7kNvwFppX9t&_nc_oc=Adrgons-EE4Lts5BWzDo6MEU29psV4bTe-eOnmGaek5fwbbgnSBPHw2l5tSTBX9IDk4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTY-CeLTzWlDlxy-z05X_T2QdBOBEZvX30HTUfaGF5N0A&oe=6B0B2B32"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery. Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Vertigo Games and Knucklehead Studios", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Vertigo Games", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "pt", "he", "de", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6761197970652337"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035435_463172697779049_2898297901899841536_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IUy7IQ_tIcQ7kNvwHqbLKI&_nc_oc=AdoDda1kGlxW0RCB6Pst7JIGgmZ4LbHEaWIudn8oSNUFunUGqfdeygiTJcNKgSVlc0g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3fA6GA7oGrxiMNubXmJqI5FDnQfYFqkGnoV0OT5agoQ&oe=6B0B1F6C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Anne Frank House VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1561593600, "lastRevision":
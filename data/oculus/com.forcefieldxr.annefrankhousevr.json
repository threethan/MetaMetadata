mBi8Q7kNvwGf4MPv&_nc_oc=AdnnmibUt3DMTfEO8ITDUdxWHybs_Bf4yXU7tIcZYcj4K638xPiQhFR_LfNNLVN0oow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuonbf7gi5x5kcLFFuEx_QHYqY-bKdXhqAfeHu61QV14w&oe=69A6CB07"}, {"file_name": "migrated_image.png", "id": "684555512317076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974598_350524418947690_5568108392670560256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9I4x32NLf8Q7kNvwGQV0Me&_nc_oc=AdnCisoJNcsT4GhyUtMX2SZ9aaae8Nc5-dngJpf0McY8sUI8MD5LoR0vAqSzyGg7_uc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsBNpMrWitBRq21fUcnQjpilP79irDorInBoTvEFovSjA&oe=69A6E091"}, {"file_name": "migrated_image.png", "id": "523057178609343", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001693_723230428091465_5552455843921788928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F1OBRbRCLYQ7kNvwEmPxkj&_nc_oc=Adl-LqcjB2RYYWh-rls8Gek_UgJQREsjLjZueGmkGVJNX1zlX61XCGrw0895rkoDGMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7GnX36P8RxQ5zVg9026kcgp_Y_WvPjI45VuUmWaBDDQ&oe=69A6BDFE"}, {"file_name": "migrated_image.png", "id": "817081308792868", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003240_2301922376592590_144630073050267648_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEHxemLA6k8Q7kNvwGQDr2_&_nc_oc=AdmobcsSgts8TSAgiePSTRcV-YXM1S_F4PK2bR1_1FvqCgTD9B1R-Y-i8XQv6fuNsCk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvC39dtvnzslcrXGgONj7TI3hG3dCJuo82mCk804EPrbw&oe=69A6E7C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/f5y9FO", "id": "859163614449109", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031477_859163617782442_7393343560734474240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQkLhbYJmecQ7kNvwHaylG9&_nc_oc=Adl9ITyajMMiCnr9ftIhV-L0JL4u8t41uoYC1d-3EAxpvE3-YtMK0q8GabGlTIj9Wvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvfxfaDYWAL5e3niTgYWfQ_TZBBeZtqDoBLIUAHJofnmw&oe=69A6C5B2"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery. Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Vertigo Games and Knucklehead Studios", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Vertigo Games", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": 
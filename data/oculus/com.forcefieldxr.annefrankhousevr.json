IUuYQ7kNvwG948Hu&_nc_oc=Adl_B2sueAZ9jKvkbHvKEV3RAMwH_k3yKg04NcvFdu2C_TAYo2CF-RBN17wojxNJncs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv-98Oc_VEdDXhk00XCjFRnIf_Z9NLPh_PubctEvRvTOQ&oe=699AED87"}, {"file_name": "migrated_image.png", "id": "684555512317076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974598_350524418947690_5568108392670560256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXnDY1p7yeMQ7kNvwGusYaK&_nc_oc=AdnVdBGDBcpshZnOuecyJnFgEAmOH-C-9WnsFzOBvtr8dLdk-gkPuKJTDXmQR4psruU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfskTv1L_x0Bf4LHj9wi8NK0ipfRMdRFxNuQLLusJJ2r2g&oe=699B0311"}, {"file_name": "migrated_image.png", "id": "523057178609343", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001693_723230428091465_5552455843921788928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eW9iS5cWTMQ7kNvwFKWxyx&_nc_oc=AdmhCa6evkC0nengNAeR9I6QvnHs5Nvs_zSNdTC5GID5Tklmc9Rn__0eXehOiVerIBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftAB5arFBkSddufBdM_JwrUPdy10ILT_z-ZI3Js6nWelg&oe=699AE07E"}, {"file_name": "migrated_image.png", "id": "817081308792868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003240_2301922376592590_144630073050267648_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pwwGdipk6cQ7kNvwH1DRfa&_nc_oc=AdnqlDl747CvWkVF5a77poEp2NS-re9xZUL7yiempyNqz1zGx2JkU7P5qZKRg5kmsf4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs7r9B5MoXtyci_vO_145Bq1o5GyhRqGAE2MknOg_YsCw&oe=699B0A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/f5y9FO", "id": "859163614449109", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031477_859163617782442_7393343560734474240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DPv1pf6IIAQ7kNvwF-Jc72&_nc_oc=AdkKVJ39QFOEsYHnT0eF8pUVmXDFYelTZm1BxBmi6vaJAwhgcYy9-R18tETRkFyXoUQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv6lv1e7BD7POaehvqw5UtwKZdk2A1D0RUPqRlJdpHDog&oe=699AE832"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery. Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Vertigo Games and Knucklehead Studios", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Vertigo Games", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQU
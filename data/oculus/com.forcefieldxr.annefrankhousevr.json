W7bwQ7kNvwEG23Jw&_nc_oc=AdlL3He-poIRVPldQZGeElHg9m3gF3BPE24gFEyjxHjJ2U-OnVYIE6UrGrom7xmRUGQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsPQJ7k9_bWjsBSRyhKAU8gbnz_Qu0kqCIrOkUox425dQ&oe=69A42807"}, {"file_name": "migrated_image.png", "id": "684555512317076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974598_350524418947690_5568108392670560256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j466vr6pcIIQ7kNvwGRPfUE&_nc_oc=AdkdtBDVojZSp_1LqrUUuqRsmE3y2R4MbwumqOT-C3R4b1g--Etbjdnk4nraHpUdXtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvi58j7hfE4kuDflDOeFbFHMbPRsEePSAh-HC5_QWJhow&oe=69A43D91"}, {"file_name": "migrated_image.png", "id": "523057178609343", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001693_723230428091465_5552455843921788928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt5je1Nq2H0Q7kNvwG_Mj_a&_nc_oc=AdnM91U4u_VZkHEtHGhcFwcc0SyIuH46MB9nFw3GfWDQ9sK5Hi2-31fEfRzx6k9tl7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft5woYX3JC5G0XIvN9PbGRBuRGAPQ9r-OadH0nnDX2g0w&oe=69A41AFE"}, {"file_name": "migrated_image.png", "id": "817081308792868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003240_2301922376592590_144630073050267648_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrWjp8WKPfkQ7kNvwGB-KRa&_nc_oc=AdlM8WjfG2290NfDwznXr3oDM-7YGdURTkB6OA90aMOAwFcXphz_Vqc6A0EWweL25tE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvONJyDX-XUyXIz2k7ajPlzQSbJKWD0gzeox-suShsU8w&oe=69A444C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/f5y9FO", "id": "859163614449109", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031477_859163617782442_7393343560734474240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5BEdgw5NIMQ7kNvwFD9SvW&_nc_oc=AdmZO34A4AA_B3vgP7587PittsEmcGYPv-xp0SEonHXFpEmGty_f8LZ4_IGqsNx9BuI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft8oFqxo6EIqSz2JRNYAhwVZwJVBGEvPA9XwBCKaSTOog&oe=69A422B2"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery. Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Vertigo Games and Knucklehead Studios", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Vertigo Games", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQU
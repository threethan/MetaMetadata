hYIwQ7kNvwErTz8Q&_nc_oc=AdnTar5RFbaIDotvtPkuB0h3URrY2NqxIa3U5_DRgvdrOqNrerhgFlLZIqViDK4PNS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuz_A4_uk4kpa3mK7TcPPs7oSpejqevTvoU5VQdklnBPA&oe=69984A87"}, {"file_name": "migrated_image.png", "id": "684555512317076", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974598_350524418947690_5568108392670560256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFfPq0FjB40Q7kNvwH3TeIg&_nc_oc=Adm40IJxiCGpQqNC-8tpOVQot5SxkzFDMLslWw9GIA0zi2GCnodRYws2ryjhV-w2T6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfugnZGOP8mKqQCxbMn9qChCbov_7v8iLqb-14NDA1gjrQ&oe=69986011"}, {"file_name": "migrated_image.png", "id": "523057178609343", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001693_723230428091465_5552455843921788928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIBHprAfJDUQ7kNvwGcV-TN&_nc_oc=Adky-76bniEVqTNBgOoRJJovD9EPASJsF3JS1K-AYvPhZ4bUfap3DT9-hg1oTzV8KNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuE7Ab-HF0RKE22lcieaISciC2cvA-SVmlel821TcAKUQ&oe=69983D7E"}, {"file_name": "migrated_image.png", "id": "817081308792868", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003240_2301922376592590_144630073050267648_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyLkaQnrZ88Q7kNvwHRRdXO&_nc_oc=AdmZu_RubJSOekYoa11uSyjL30xEl9Fb8BYbmWdORG5DL693vNvlMkiYU3wWtOSgfEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftZ_bYYK5mjr01_ybGe16QEQEfXwUlCy69VPUuCQb4zPw&oe=69986740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/f5y9FO", "id": "859163614449109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031477_859163617782442_7393343560734474240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGksKkOZeNoQ7kNvwHBHHDs&_nc_oc=AdkUaJ8p0G51ubi-RXQVQFKiSPzuWNyWNcCMyPUmiCAXF30nFm1HzyAqCqkmisTyVv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuHj9TFvcFEejovsoAv1gh4ErjR4yUXqgm2L15KHLIe6w&oe=69984532"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery. Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Vertigo Games and Knucklehead Studios", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Vertigo Games", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQU
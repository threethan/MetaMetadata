3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce5jXAFaZFYQ7kNvwEnC7bb&_nc_oc=Adq93nVG3E1lujv7Qdd-6JDy0VGezwMvFR2_MVMt1_4nKMN0WPYqFBH3oQ1mdw6fTS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJxIICN5-hOwLlWGW3R5YMTbd2xJSBHAq_2iNgvwz7Ng&oe=6A64CF87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwQrWlBC9TsQ7kNvwGkH5LH&_nc_oc=AdrxJkjwY5r3shMmvOs6M0Qs6TLGCBRjv01wnynSZ28lAOPGiWx1uG4xyZTudndb36E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD8yQcYC6Gelpr1X8c1J5cTEL9c3OOcq-3bF44iAbbHA&oe=6A649CED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oi4oQIW0-UQ7kNvwFjBCAY&_nc_oc=AdrQf_5ZzNdgVn1N_H-cfLoRcuwXQk3N--q5ez-2xESEYQyuIvaFeYXNTceK5liX9pk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSbv_P69z9c-1FwtQYpicJzfm7vqMYdT3WcfBFpTSLtw&oe=6A649BE1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGp_JLMc8O8Q7kNvwGOZyRC&_nc_oc=Adp5DPoQABnvESM2Tm2UihASC9VvFuvbo2u507e_z1K5NF5EiWAqSD9-XeyVGLi5mI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHA2zf2luuJWy7PgE_CaqGNfYnxwKdKHjDXNA_r62eQQ&oe=6A64AEB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM_vvh8AsTIQ7kNvwHi_eP-&_nc_oc=AdpV9TjEY2wfTF0O-u4v1yATiyHQhHSTbrZX-WpAQ38c7dYRDxn2YopofVK52yAU-l4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhElZe22Oj7QUlkiE__6d0dAS4XzbK-LwYube7oVw7rA&oe=6A64AF83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
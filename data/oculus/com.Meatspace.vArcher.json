3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpqdiZ2fA0wQ7kNvwEnOw8g&_nc_oc=AdrvxShY7DeiARVpuBvvXfLSkW7a2MERNbLwBWMdgK3ZE06FxekwEDWO0YlRZi4-YGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af039vaoXqIkojRNtWJP7F-yDrLFEPRQ21aEOfSU1X9oIg&oe=69D39247"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwPIwq2JsdQQ7kNvwHG2eHs&_nc_oc=AdrSshLR-9Bbq6Gpy8MSTg9LJEBLG6vsVhtXSotj8XFcLlBj99tKeJj8RuA0Yo4y2Fk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cyCvvIivtuC8AvDMWZ32pgHa64Qw3IwfHoxlW_Sn6vQ&oe=69D397ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVdn6r00yxUQ7kNvwEHdSvT&_nc_oc=Ado0SeN_YQF2-ysZOEX3XovZoSQbBYGNwG_hTlP-BPJSELjDY-gaOYLbVvXTEZfCG5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Un5Em1Zzi6IxU_NVXuLt56yg6EvzNZhnUPKil9tcS0w&oe=69D396E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT402myyQx4Q7kNvwGUJZDy&_nc_oc=Adp-L7H5VWZRVQ7aqNTj1uCteDhG403dIoX0KerLwDfWytHb0IAj7dmI_HSvj3OtpFo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3stOqipO0jaSF3-uRLlFXFXpg1AQP5em5KnDQlwAsTeA&oe=69D3A9B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyGvM9OsMg8Q7kNvwGdMbod&_nc_oc=AdqmvlEm_B_ZXNOzMITTAL9u4Rhm7loqk-fxjUU8hkJWeaWw0Ty-pevUsz-ImN1M-0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-R06wqLLqTmn4ocawGSofdX5c_RN5zGtLKrODQc697A&oe=69D3AA83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etmTKYEQ3bMQ7kNvwEIpK-t&_nc_oc=Adrk8qLxJcKFOEv-ghP8DsjuwBkfjwEgMP020xFI43uuqy1Yjw0q_xhumeP3T4H1X40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbwhv5xAPvKhnCE7cSEk7sECfzgmnkuu8EBr8EqKkU2Q&oe=6AF1E007"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RKqrc4Q9AcQ7kNvwGUDGgQ&_nc_oc=AdrB0qntw3I2YWfZCZy8A3pve3_LD22qs3_e105zvNjZzR80GJvokDn1lzjc3l0147E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgbN4AFoxcwyhFnc9EjWo40bS-7rlwkuklRaTbsyqFHg&oe=6AF1E5AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGB0zPLn2-cQ7kNvwFMQ-c9&_nc_oc=AdqczCY-KY3uWlcdJwD0iF6wkQ7YLxTnfHhYOI4EkslKK1V3HLGTdNq5lRRn5ifto9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDrsorsP0tWFLco9RoH-co6w-uS9j1sPB2n9TzMBCxRA&oe=6AF1E4A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvKwCGB6l8oQ7kNvwFqXNaz&_nc_oc=AdopsCqC9azSGv0M81l2k3xt1g-Urq8ZiO_Pk2YxiDCtBTubAt2_77YNh7Jh5Qfl4Ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTrmDja_legXf27ivEAEJ7xXgB0bkq7VSfxwtfYoixeg&oe=6AF1F778"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOg2mY8c1CAQ7kNvwHRkIMV&_nc_oc=Adp2wvL2Sm8Ahup02B8axkAR3VZT_EfGK-BS9vASvHXdt-QDo7nWTKAJt-G-shjNzF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqq1R84jbTdmpKXN1dHeDVH7lkXxvFfsOB9Q3UOmSjBg&oe=6AF1F843"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1UAyGyGSSwQ7kNvwEYTRws&_nc_oc=Adqu9CR0uMtG6M29Kd4CNW0GX7GuhgdO_vQctvbULOgR264_Kofo70zMsFmMxHBfmtY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tki3qRyvQe_9JNmMb9elOf0BvgAujPQdfixnKQ94R9w&oe=6A3A9F87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiEdFNh1XAgQ7kNvwFA33WB&_nc_oc=Adr9sNFumCXMwzFpezcUf1N611kjH34uwFStVcmkOM3aTHHGQQnwuFRa_6_hczcHIdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w7z7Ht-Rv9hdVT1qJTqz522GFjKAB1kd37cqVytxvKQ&oe=6A3AA52D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlAk9QslqhMQ7kNvwGmr2IZ&_nc_oc=AdrVV40JoSqfQts-yQQ3MRyAUzMEEGVwX-haeuF72RVZZMk2JGa4adAIbZ5BVMNAYAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HUFNLXk7OiNTw-Mz_mA4HAeGaqtHGb0C-q-AVT-1pNQ&oe=6A3AA421"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajAlPwCYW3sQ7kNvwHmxvPE&_nc_oc=AdpwNkfTJ-Hut-2i0E99l1evNzUaoXAz1w4v4IqEnlcEcVa2lfvDTlGlycVjGd1EIy0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vmh-zMeUvbR-2G3dWq-0zm9z6XSOR-A2-mNfVefmmFA&oe=6A3AB6F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZF5H4r39SwQ7kNvwGqOlXX&_nc_oc=Ado9X9mp3ODvTkp2Y-jW9s9QiJfn_rCMMZjvCTDNnRZuM9qiargc1vWvHy4aAtVF1Zs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8grm2nNGDZpUuFzTk9J59M0YSwbFl-ettBs5ZijZJprQ&oe=6A3AB7C3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
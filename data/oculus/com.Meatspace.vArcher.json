3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MvOfvhxf2cQ7kNvwF8sJnw&_nc_oc=AdojAeis60UqM5767IkGBwvNedugV7lZwh2nq-ZO2xxLO8vEF9pq1qhYtRYtRHWkC6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTEM6aKy1l5ZiZe_uijuOjtUmPg6wXdiZLBf09aRKMxQ&oe=6A75F307"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZUFHu3K_jYQ7kNvwEqU7kA&_nc_oc=AdrcIK_bkDny31GI0r2Zb_dgg3JQe4bVLo_fXqOW6dvtdX66c6ivmM1zUjlso0W-UDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvQHoLeRCx1JPXmqTVrcF5VVMsY1SWdEEwqDAjZXS9xQ&oe=6A75F8AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_b_2Ctq9H_UQ7kNvwEXGhHv&_nc_oc=AdpAGWpP13KYAEU8aldFG9P2gHWQW_LMHQYR9Ax6PJMv4novE8N8iNmRWHOiZkvVsjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3B6EJRrYhmhj73jEkusTkAEsac4sD91mGA2H3KU1Phg&oe=6A75F7A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncyJWjSVnWMQ7kNvwHoFIDK&_nc_oc=AdrqG33Ufmv-fiZ2wRlUNOVk_V91hSXFs0mas5zDnmCAXzUBDNkOe9Bt4zqQRWoajRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExJtm8yOe0RwA-kD5FCtHDeHndKT0KD_9ZuPxnK-1lKw&oe=6A75D238"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2qy2hPcZ-UQ7kNvwEqcQZc&_nc_oc=AdqRlVGh4JwgUcXX3_Bt_FzZhZtdxeKRpCVgtGCaN1HdYvfuU2h90XI0DDMXs-FM1LU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDbRzTlMJPED6ITc5gQ26M97zbS32l4tVPvfA1aNDojQ&oe=6A75D303"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
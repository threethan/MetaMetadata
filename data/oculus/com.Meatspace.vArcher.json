3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hhUhEvt-JgQ7kNvwFHSyNn&_nc_oc=AdpgmeGt3aI1S-X4MRgrDei8OvNuGHCi1EFLawIgr59prsSoyzsm7-sCKDT2t3al60o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaBAR7g9tLv_lI__sPbgK7Pk-BVZhmwoq1CzeGHVhyDw&oe=69C66347"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5rmSZyw4FgQ7kNvwHsQfbV&_nc_oc=AdrTIESuf07WFczqByBVCsDRGc-tI2t3lk6kQa4on_XoszEZzz1Qswupxxr9zSlaAx8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJHgNz0slNkPNrSs5GjmiZyPYpgJS_N5iI3rZ6t4FRoQ&oe=69C668ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVsu3iqM1N4Q7kNvwFoPhNV&_nc_oc=AdpK9-eodE8KUAKaq2A0D_2QJ7SLY0p19LySGeB2fLc_KS0-k1hsXEopsSE7c33bzs0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPmd1HwdsaNpC5ErX1HDiUC_ArFp7Hy70xmmPiD55NHg&oe=69C667E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHLhSqRM4LQQ7kNvwEUAXVy&_nc_oc=AdqnH-ixeed4G6uXD6yTIgoevXg_Y1niczf9einXZWwH5CEgI0X0ldKXG2LNt4MeGB8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdDGgAyNmdkynaHJTBRKoks0ggo7T_kPD0LgbuWabv7Q&oe=69C67AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEUStxsn1qMQ7kNvwEuYPzx&_nc_oc=AdpiJskkyLwsO_kci5PE-LESLEo2Kxd4XlT3QhwAbLrWt1J0_U3ZMNjasTEAFbAKxBc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIYJzPRq2e_84zfjG3mm5eKpiLXejrVFWqJY6Uo7xf8Q&oe=69C67B83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
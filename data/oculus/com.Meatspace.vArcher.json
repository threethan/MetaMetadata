3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=on6rTArEpzUQ7kNvwFNU8Z8&_nc_oc=AdqNYLxUDYMVEKH9yAPsZKx3ih2AWIyxAQHRLPTbIuhxLYuEkl3TXU8e6hx5Qv9-b2s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x2_M6Ii2uJyTtO_w-VJ9sjJ70tvCJqSoMuehxrrIz9A&oe=6A340807"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-l_AW10JNoQ7kNvwH756ij&_nc_oc=AdoWGk15qhCQJu2YbAXCED7wns4x2GR3ZgQYRJmUb0x67SA9py_ldQfMN1haqrcbpxc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_P9Z18pgwJXqG4Ris7EjpIjkL_zfV0Qc93XWUTMWXpA&oe=6A340DAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8d-nVmU0DjoQ7kNvwEm0Qki&_nc_oc=AdrE8dqJsO3QAtVSF64G6uahjSWTZ4qky2QtARHU-4Iv5o3zfUUKNwRC-ACjuQohYH8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nqpiw_Yl_ySZDqfBTopjp6vMrWkHY4lG8OKq5_WJr5w&oe=6A340CA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63U3NdT0sxcQ7kNvwGlrUGQ&_nc_oc=Adowd0P5ihuc-J8cXNB8NHx4wrn5uReGo-R6rCUBiZkWbgpR3TWlsY-KJNw1l54moWU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d_9NRTqG4osNDapVfIdf5Z0fVBxSSzJ9IEQEj4-5mhQ&oe=6A341F78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5p8AhJcrcoQ7kNvwGeNJuc&_nc_oc=Ado4rhxm4GCF_MuwLK2TQ86SQdk5bcsTInd5MQrGZCL0EM2oJhXHwcCGxR8otUYWiAk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QEFXBybjGB8754lkNPMD5VDYn6KJy8dHNtRFDhMS2jQ&oe=6A342043"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5F55MJxwmoQ7kNvwEXGmRq&_nc_oc=AdqYEFNkspJht7AnsWVVNGyDtvaXtQOBxcBLuVEKKLxJp83L-7zlom8Nbg7ABxC0SkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64tRUQjeYBdQJ8-TdTFqxt2_2a8sbwdBUjf7KljgXFGw&oe=6A034087"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kvhcy_qs3t4Q7kNvwH8vcNl&_nc_oc=Adq2-CS476QtPL50r501po-maHCxZYCaTBHYfTDlHhN3KcY8oBREnJ_5lEcCDsLhueE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FXTTGz9n-XN7yzhILkMTvgAOd2tlkHZpKsDw3DWXTqA&oe=6A03462D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqEnah-B37sQ7kNvwENOnpg&_nc_oc=Adp803uk4A-hFari7HtIYV6lYGxQ5mkaa5Xk7xjdZ1Z8dOT11227p9GgPGnoMAvXlKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52Mw4m_VyojFWVfgV-spRn69p3impBflIeaBQzAktgXQ&oe=6A034521"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFN54h2VSc4Q7kNvwGLYB1Y&_nc_oc=Adpbu_zOSrREX_hbIlZLn891EFQDQNbGuoEPSSJcGmTK4UJuTV2OxeuUh8e6Gf78rIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qNH_tfaEpOAKwa1zWEvVYmfhlRZcwu8GoetIFlsXnvw&oe=6A031FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYjdDs8NeGAQ7kNvwHpwJug&_nc_oc=Adp1sFPN2L2Aq5RhuZ-3GClHO3iGOjCN6BOkZTZ3UCddzMCSvEDbH0r8keZR5LRd1SQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mucVoFGkDkNlp9oYqmW8G-hxW8IxP1RACyNpJ_-E3Yg&oe=6A032083"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
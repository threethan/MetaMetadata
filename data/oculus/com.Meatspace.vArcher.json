3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=io90sn_ovGoQ7kNvwEFjrpE&_nc_oc=AdojerH2h04A6fcZXcL-BAnmGAh0K9PlnBWjt0RDTb6aAhOqOxXhbz-30uTuZ8ITErE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z-8L96jm5pQyk9ogVWv_q7cSbxl144TA14ZtRK5XV7Q&oe=6A3BF107"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiEdFNh1XAgQ7kNvwFWEBOd&_nc_oc=AdqRwazvWWuw8RBIb0aH_p3gddU3IhezlwZzwLPbhE4vbLNVoZr-sahnAPXydbFdA94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DeMU-soFoR0suOHDeXaRqS8u_VALxicP0cjOfTquLtA&oe=6A3BF6AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlAk9QslqhMQ7kNvwHkajAn&_nc_oc=AdqAiwa5N8K8PNjOPGdl27ZL6meqzWt6W15Dq3OIc9whaMTPqyQQuzN6vZ5BciRHmxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rhKSXUT7d2-hFb2go5mlvkClIHQOJV8eZhOvCn6Ls_A&oe=6A3BF5A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajAlPwCYW3sQ7kNvwEcpL5r&_nc_oc=AdpXjpywFnokly13aKLCOTKcI07x1GnctzrDfTuYT_18FJw4KQ1vY48TwJzZLW27XlE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-meYeozTqOEkOUnAAPfrk8EQR7tk8xdrnbSHbS7Hn5hg&oe=6A3BD038"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZF5H4r39SwQ7kNvwEArCFV&_nc_oc=AdrqHC8ZWSc-KcWOD53ZaYZp_YQRvB4fpTV6-pCa2GbRol9FzzO3bZzMeFDG1zH_Mas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FG7gAzcEYq72S_xjjh81nokJlP7fnfUfdAaC69UTJ1w&oe=6A3BD103"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
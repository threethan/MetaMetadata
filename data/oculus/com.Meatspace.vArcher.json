3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIwgXE-30uQQ7kNvwGRxODZ&_nc_oc=Ado7eqsJRPeISHITqCSOZWyF_YngPEyp-puCxUcqQebWbKi9q4-Kyl7n-40pTLd98aU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqoNr4utQ7Mqra-iVRUo5AUfc110rteZsqj5K_pdbAiQ&oe=6A79AF47"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AacSnS5Lg88Q7kNvwEkAqo9&_nc_oc=AdoU77O2Zn91M2OVo3mCqZJU6tlMZpT77HomQOKpmobrJJ3blZsCqN7mv9GgOeOxv5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUupdM-KROZA-qvTnFb0zMLbuQaQ8iYAm7MG9jooiLtQ&oe=6A79B4ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTgP_9uX2jQQ7kNvwEOO2E3&_nc_oc=AdrObzaP3U3Vx_uZQHsBUSSe9ez8GditYPT4Xs-CTo0Mm9IiARKg0j9bS42tHbt7Hak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2KHXwtePXUIJeGETBEuKfd3RYwbrlZa8KlbgVJ9K1OA&oe=6A79B3E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OBzOaVpBVQQ7kNvwFNON72&_nc_oc=AdqbAqFFNrWn5hsiT1smB6VIBi7i2lT8NZcwnHGCVGLjvITnN-QJjOGK8m1F2SEglNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXZaYOQZVLQn41VY9L6S59oLfTNTTm7EffHS6MFmLhTg&oe=6A79C6B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJm9dm7k-SQQ7kNvwEYjwyu&_nc_oc=Adr9d2N-iQ9qCWMiic_EtsoUCLiutqx_klQ3XRnOrUckYD5iZwEizCtPdoELgT6GKT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOSmsMWNk960pZdAy0Ox8fa3JsqvAYjj2uj_WkDex9AA&oe=6A79C783"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
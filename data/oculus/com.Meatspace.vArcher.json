3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lbqqi-0CLJ8Q7kNvwHdPzM3&_nc_oc=AdqAzJ6A5-o1IadkyRdt5DEJ7Kqt9C0PtcH5-u-heuT2rdGN7KD-9aSdNS1TAaHlowY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCboU6Mr9jOF9rRHMC6jp4dNy3V8uB8Ux4o4jN6uAj-Ig&oe=6A6B6707"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkokVftKuAcQ7kNvwFHNcMB&_nc_oc=AdopOoMJw4jLiDKAbJvG82MOhQaOGnKf5nuY8TNMe03ZrN2Zz62jMOFQbOS3HXJ_gF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDorOex1C_FxzH7o_wNtx6pOXy5-827Ey2mIFdURMgqBw&oe=6A6B6CAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh5uIyG-MBoQ7kNvwHn57Bs&_nc_oc=AdrEnkG6IsCn4Eob3Sx1gDJ4PZXj2yPtAdI-NFxy--Bz6uclOM6OUw48LczgvKS9u5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbRxsRldovPGEyCODVLCxrf51dPe2DgNRlnPX7zEDZdg&oe=6A6B6BA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye660jDSuWcQ7kNvwHRDBHJ&_nc_oc=AdorsMUYN2kkYkUx1bN107qtvp4CSaEAz79WizrNuHp8Iq4Ox1HQwotr6QW3FlEal50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6-XH1B3ddkOLLR8-LgtPX__CsvTuG202f44TnDPYOqg&oe=6A6B4638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GViGxZHgzBgQ7kNvwGFaeG_&_nc_oc=Adpb-haMr7bWQaKblsF_NLOeM-NxWefSdFwB3ydUDvi2-KzObcU-zMWFl2L_6iPJCmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5OemzsOQZxE3zbdibQ_0KwLAI919EZC_SLEHEFBZiuA&oe=6A6B4703"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
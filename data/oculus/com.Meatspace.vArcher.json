3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw7y5yo8nkMQ7kNvwGqml1m&_nc_oc=Ado0ebDQCzS9xFjPOSkocyFZbf5mJ9uY5b5tBIfLPH0Vpt7CHAer6N56Swa2WI5CNBc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vfvh4mqvLFTYmvDLtF75Ve2vVGj5D1wE_Z81od_Wheg&oe=6A32B687"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-l_AW10JNoQ7kNvwF8RvED&_nc_oc=Adpg9YE1E9Di_3lDRFWvJP8nitKoFZKCc8pLfjpr9918sN4dmNn8GrhTZzG2uEnntpE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UpCdcmLxq0q7h0a95DriQDC9RZTWSog_M16PX9DI5QA&oe=6A32BC2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8d-nVmU0DjoQ7kNvwH1DCqf&_nc_oc=Ado0bXKtU015avn1g-Hl5Zj2O4BcsyYZ8QzZhBNdqPueVD7b-0UMXqDvh9JbP3QHU_s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-FV1vnAU2gt5WcjA-_hjwYxz4ysFxId3F__dc5V_q0A&oe=6A32BB21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63U3NdT0sxcQ7kNvwHdljWU&_nc_oc=AdqByGMrA3dfC17INMTRt8YMaBC6J_7MfEhKnFeXWi62dx6XkD-HDf7uvK5PrqXRr2Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BQMXzTlgqv6x6Gr6DKKW47Uv7ppOCxoGMn2tVwlRsRA&oe=6A3295B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5p8AhJcrcoQ7kNvwHbyGNb&_nc_oc=AdqJXyqA1M56vMfA9JlWimjqIQH9zZUmfQCIs32vdrpXw6nkjIoKlaidlu9kt2s71Qw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QUv2ahMTyzT9h6syynpRdFhJHX7zZgFI_HDXPiEvewQ&oe=6A329683"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
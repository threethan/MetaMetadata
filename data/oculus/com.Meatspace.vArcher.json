10806_363182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1UAyGyGSSwQ7kNvwFdwb-S&_nc_oc=AdoUXO1oRsJd_MX4AsGkndAmmg5LwlVDMBygLAYYsPvPTauTXJPsfhnu7rtvoZ-DWEg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g52wxt7G6DcaQBWLHkacCULIqdw4y2MUDkmRBu5oNzQ&oe=6A394E07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiEdFNh1XAgQ7kNvwHrwKHt&_nc_oc=Adr5vEhQfEa97fFo94QV1Wa6jxnlOz1qCMxHBq7VCGKRRsbhYzk-MwA56LYLI_YBwP0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qN9YgPcvWSX5ZEHCCYq7hieA0tZYLCBrRtizqg6vEww&oe=6A3953AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5dz3T17SB8Q7kNvwEi_a4h&_nc_oc=Adqo62F9aADKX_QVYNRPan5-HCxCibeIW5aZrCZxSmnaoV2hsXsgPd7J002XJPegY30&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ehBGIyrp5hXTvBCxeviHmdO7bG9KtzAQd9bg6vk3w_w&oe=6A3952A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpkQhyOSmgoQ7kNvwH78KCL&_nc_oc=Adoq5Q97JH3WoKoHh7kgiAncQ-jYiwLCvPkY9vlFBhn9UQ_BVyVvZ4yzYvZzeEzyMdg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RLxGfrNooam3TL_xEqo5tLPuNgie3mo_TbuvcqFIkAA&oe=6A392D38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI3Rzqr44sMQ7kNvwE48bW9&_nc_oc=Adr60HR8PxTInb-g-zCyJEPpJECicBv741qXMvHHx2sjQ7Or2pus65IeGRMyMaaDxyI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_l-NfJ-QFRqmp73c1xchrzaMcyLol-71-F_td8atBGQ&oe=6A392E03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive"
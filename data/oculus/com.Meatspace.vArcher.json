3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKOVxM2t7gMQ7kNvwGRg6gd&_nc_oc=AdqWv2bj8xRBmPq7QcaIB352yF_SEYsr5aKCgZdP8R6bkVmScjrGBVZOhg0xlsFIUiI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCix2qZMf13yZG4wnmSLVvOTrOCH8c7iTZ8esG30DoBA&oe=6ACCF607"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vWaSKHhCGUQ7kNvwEfXE7U&_nc_oc=Adp87p-A0qW9bUzNxKqgTOMQ54N6LNGGnhxsG9f17B_QJLhufXJ8v6NN7Zu3xWBZDD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-wLct-tZ6YyxjTavGxH5QnlNIxYzSzNlONEKUbLn_xg&oe=6ACCFBAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZmTUXyU24wQ7kNvwFPLqOa&_nc_oc=Adp5Rh0lfJR5qjej8oTBmB2rCzLwLAjxTuRNh6M8PKj-PlQpW1RAl0oSx_WdBWHLJPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_FFmS8iRCogt1ogsfmBkhxzRq1yfQzk9cddKRNx4ViA&oe=6ACCFAA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVhjH-TKH-oQ7kNvwFsx705&_nc_oc=AdrimsOVYZ_qB10ONBIaW_aeBh-6YQI3fY-Gz3vfeFLnVsRJR0wPSqKyBD4YElyuCXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCOBh2Nqc9BmPH0AC1cedpAVowuCcAIn7X2FVatJvE_w&oe=6ACD0D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL-9FthylyIQ7kNvwEnnfaF&_nc_oc=AdrolzKtRSlmb3C1ddVR2OKrCLysTvqTKZn7Q1eg5G9NG-xT8vaGv0-qLW2697CGVlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmL9N8opmHv--WY02Kcln19NfhhVpgH50MFuKEOj6gkA&oe=6ACD0E43"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
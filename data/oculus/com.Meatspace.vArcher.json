3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5Ib3Mj5aDoQ7kNvwGgZNnJ&_nc_oc=AdqsN-nfJC1q8uoqP5uIfqcH0to_Mt7B0yTM-OxomEkR60VSNNp5R1EY3BF73g_ZZps&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41bu8DYiam9pVqxi7P5_VuyAUo95CW85LwQ6cy70f2gA&oe=69FDFA87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a62hH9PM26gQ7kNvwH3a9HB&_nc_oc=AdqeckMCs3-RPfas-lUvZDhCBF5ieRxd4IhmKMrG2XHBAImn96Jpjka9X7qTHLZIwHw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GJ-Vg9x_7QP3d4O_Hq0daG8wHRc20kZGf7aHsOf-MBA&oe=69FE002D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJdZZK8qDpcQ7kNvwHpvoF6&_nc_oc=Adp87kEu-2AcwnzEHjOWwxWP1dZq7JaaORj1QyFSft9nUNuWoUsSjhzjLfVzThWq-nU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B2FF7YY5GFny4_XAvUmyCsoTr0TtLcoCZnPpBkn6pYQ&oe=69FDFF21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFRFE6zzX7EQ7kNvwFulH0Q&_nc_oc=Adr5AppLACtoltYZgFXrbOhhIYW_NGBKcbQGrN3zY1iwlQSHw84bWEGgOBjIUPKSUeo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d1DgR-LNI5k1KD9zfrZmAWdviAa5I5ZBDm3SgqoTKMQ&oe=69FDD9B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5BDIM4b7_UQ7kNvwFCju1j&_nc_oc=AdqZoY-OnNe0a-xOO7Xq7rT1ZbRzbOpJ1uH1U9kSZcqe7_3SGlPp6dF3dFCwQPLJKLw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UvKayzvuNp0sEHriUzhlSrT6IHU0oDdstqljUlhL08A&oe=69FDDA83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
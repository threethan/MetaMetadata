3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoLOaym_FMwQ7kNvwFlu95U&_nc_oc=AdqokvnioNg3fojCtfRAF3CFI3nkhX0UPA3a1OPtk5uRy72lJInk1UfXI_fteOCh1kw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61GUHoRp-UrjVYc36ciEDcE-7bGZHqqXbtie0lNGM1ZQ&oe=6A09D807"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaB7tUUhD8oQ7kNvwGojVMD&_nc_oc=Adq8Y7eJyk1sP0qB-fSUi0ro_BfWDJLLnTE1QtwwxPVzD0CGHjyVi6LKVG6sdjLRDQ4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wXYjKDfaIZvwid1bQO0x5yiWXelHj2QVaFk88rNQIcQ&oe=6A09DDAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFKWR3MFNXoQ7kNvwHuM6Ed&_nc_oc=AdrtBdmOXrCff9kvWSeDmYtE1VubrqRROusUTpYwRlmiNbeHJGXeU-D6YczWrxUoRSg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53C0NxfdbvbhQEsKvlx0wNcJ0lXB6s-xSM85bLOZKGBw&oe=6A09DCA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB6Pe7x8tXUQ7kNvwECYhl9&_nc_oc=AdqWi3GUkuMtiM0L51W7DSSPgQLgCzmoQHbFpP8tRMdBlnisA_KZyzCLDQx1JfZ2rGA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tj__YXWzz6-oQgTDza2u935tkHVUVBItQAzn7aHUpnQ&oe=6A09B738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-ufnJfyhY4Q7kNvwF82J8b&_nc_oc=AdrPsh8jsPsSlXdRmDP0_sjh-fLpOoysslCxgoPDGIacFDArW8dFKleqFFqveUU2Ohg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ylDJXU58DTvzicJGoeXgBNmL0a3bd6jkBrIH34tmJpA&oe=6A09B803"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
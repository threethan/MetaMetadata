3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4mEtODJuA8Q7kNvwH_knnL&_nc_oc=Ado5xc7Fma4GOdOkcSuFFW3xlMf8eF3wj143pL-SJiUJxbebdSW7Ebw_25Tzv5YVhes&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxrl26Rph7--stc9DS-2PzjM8Tiafyu3O2-CGwkVnARQ&oe=6AE20E07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT1loBBT4PIQ7kNvwF7P2r1&_nc_oc=Adp7ZOPfiz9W8iq7oHivbeuoI9rIQD2eHPi7sAnGszWHPzo5bFvUD9VQismS8ZWxSxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv093DFezF9e_WScGbhEC9-Ymx4CH4Pm-VvU8XpD8weQ&oe=6AE213AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkKWzBK73HsQ7kNvwG0U-li&_nc_oc=AdqJBRziQBF0maXf0Go7GlXz4Kbb20VmeUpeKmIOkTaf3uU8attJvXDHHLHYCVQN7yw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwutCt3DYEU_69fZ8eQ1cUiMQQMtKm196ovgoUAN3yqA&oe=6AE212A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpoW8XeHQaUQ7kNvwEiJ4Pd&_nc_oc=AdqZNsdqhHwz3f9kdXE_ekAab47ZG5c_JUJBPd0W97EcTj5-XIfQdIjWewUiamJFBHM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3Hga2plrehQRMuhkhiZ1523e_fPWH8_muZNQuoQxOEw&oe=6AE1ED38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIN2U4qQyN0Q7kNvwH2BbFL&_nc_oc=Adqhs3xPbNVu19baauADvPsRa0yJ-mYhLNnZk2vKcb1YfIdS2hWUscqCzoOaSLpsPQs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh-hIdi-l7YdjXNDX8qqMM34fWLneEp8k9S-mbaW12hQ&oe=6AE1EE03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
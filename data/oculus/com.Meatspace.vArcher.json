3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygbNHZMmtNgQ7kNvwFa1ewz&_nc_oc=AdrqmJBF7DUylN4r5KhDqyGQAXrzmTsdszUIbDBjgxUGUnThkThu43KMCB_SZ98ebao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VRTRoKmVy7RPEC3tVmQLb1kMRI0zIkqMd5l-UzfcNOQ&oe=6A185887"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYC3XRbDuJUQ7kNvwFz4xE5&_nc_oc=Ado9038oCTdAeyJ6GSQ73Xs-5YKpxG69ARNZmz8XFjp2MGqWzjhEy7ici2fCO_1sHiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BoMRTPJ75DaxR5tDXBQNvmFUGl48LzkLZpGF4W-FZbw&oe=6A185E2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gzeva38ZotIQ7kNvwFU9VkI&_nc_oc=AdpLxt5Er0wH5BFTTDul8HbG1DkbE_1xGiEEOdWZPl3MKQrnsej7X8Ba-_t8O1KogHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kNp3NDhJ0pEYSDsxgi0XT19gVHlcW5Ezo7f4nTgt9EQ&oe=6A185D21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GpU-rf0weoQ7kNvwHlHk_3&_nc_oc=AdoUA9uA2M-3nJvls_2i724W15ctGIzIDDCxnna3cAs62aw8ptvFZjRwReU-X-Pz_3A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ngFyzjASICWgMFbRoZUTPBpsHnNIH8TLzKlnJ2UTctA&oe=6A1837B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAydWGJV75cQ7kNvwFYeVcQ&_nc_oc=AdryGQkeAtHpWcp3Yq2u3W6iBnynBhWUHHZwGgSi3R4uNi8FheOkR-1LB87x5W6xTeg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kHrOXD2FQu_KMFrD6oK0s5XWT_nWW2lZ94Jlr6B081w&oe=6A183883"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
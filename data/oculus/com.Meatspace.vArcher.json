3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRs5ensOLw4Q7kNvwEAsDVg&_nc_oc=AdqCZ2vFaSv1lFeayL4Gktg6o8pUQkUUd7mLSOcBwt4FyPtyyTEakHv6vJ4eNdr8Md4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCosWzLAGtxNzqUidWsYPyJ7ae0UKeHbLZpp7RyxuLbPQ&oe=6A622C87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sg3mrvvBWBwQ7kNvwFAGF-Q&_nc_oc=Adplc400PuEQLQgUMJ3SP_7EnjOGpA4vAH-4uFaQ4LA6AsOg-DdqoT74H4CjqG9E2-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVVAFUdAnXXeAzdRYGHpYVFBoCHJIp_QTDhVG-__YPVA&oe=6A61F9ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oi4oQIW0-UQ7kNvwG69bFX&_nc_oc=AdouVmznTfcU8JOQiW0LHag3Nj65EEXBHbQFBP8Bs43wt-yyHOcDRykoO0KZ4A-g8vc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxSDrU0SJhHVkeljRABEci99xFWMZPFYdbAcIBw4WtmQ&oe=6A623121"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGp_JLMc8O8Q7kNvwFUF2fH&_nc_oc=AdoekvkKJzWW7DmTbpbJC_JKm87Olmg28eOMxtwdj-84E1iY741Xulx2rJNiWoZeW6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARolx7vCmOTSrcmv3k8iZwG5vJGVJa2Mu01EHKyq-nAw&oe=6A620BB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM_vvh8AsTIQ7kNvwGT5vOI&_nc_oc=AdqyNAWsNsmM2F74mA2TEvmkxpv2amHNzmleuXkW0Tl5UReNSWiQEDpwydpisKm534c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH7uVG__7fbDG19u1yQKQk9Hi_zkh6mDhH8HrP_b737g&oe=6A620C83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
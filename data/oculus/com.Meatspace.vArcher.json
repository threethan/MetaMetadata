3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MvOfvhxf2cQ7kNvwFR29Xf&_nc_oc=AdqU1qnl8BzN6Kirmfr3neOtzaIo-zIppyIflErVCl974-p67hFKE6wm8TXg1kvaTcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDQRWpDY1SBbedn7DaLbhamIVFaeloGvE8oUwbrPY3nQ&oe=6A735007"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woi2SZzpTgcQ7kNvwEWemSr&_nc_oc=AdqjiTNb4g73CuIanglh3qiqLXIceLIzr1q6-5zR_QoVSiQQqTY2i2oacrnR4as7ezU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNLPtWCK403hE-MORBEk-H7e7GRGk1ZSEZcrCreevh0w&oe=6A7355AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ5hYkW6FQkQ7kNvwEqCH6n&_nc_oc=Ado8ZcFp4f0P-nRbWRPC0CmovCUTnqC1sQAsJA6CwR2VsprKtDlQYiMuQXLklNpi4IE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFycRkKbrJpCRlSTCexuXxuf0U8-D5Mnqt07t2whhPfUA&oe=6A7354A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvnkbQqiKbUQ7kNvwFuipdd&_nc_oc=AdopoCyw_zueqzLuU9fm7YbtJW_Lu7GmBsneY5jIS1IQfexF6H4Hikr8-j6KhF3lETo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSV2X3Xz7uasVb8U59HAY58WKs0GMh2goj4emrqHym6A&oe=6A732F38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDuxTLm1_c4Q7kNvwEFxDXj&_nc_oc=Adr8E9LYj1YqWq1uSB_-pbBa1l8VU5pLZQ5U4Ej3oCF_onuqJmjKf7KoJkGafO9lJ-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMMGRZmVfpdLms7HzycTh-nlRxe3GZv1-K7Py9gFFF8A&oe=6A733003"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
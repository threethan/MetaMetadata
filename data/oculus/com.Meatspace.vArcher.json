3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVTz52wzSSIQ7kNvwGjQXJc&_nc_oc=Adp0ekRI2TQRV3nCDBwSBsNFwG1--nU0Yb7HSP0t4qwApL3g_NG5uwVOxbg59l88H1o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tAn9ZYqo4maiFvs77Ijn1Pzjih65WNpja-hHPzXnB1w&oe=6A26D907"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzPgbrRKpvcQ7kNvwGIcQll&_nc_oc=Ado8NycmNdqVw0zgJCZ3KQ9DMguReshaC26Okgr04CRNN4mBEUQgKXIC39TjOWBq0uM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FoD_A51Si9xNx06nbTmge2MsVx9CZfUkITHEWmFLubQ&oe=6A26DEAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxGmi_ecqIkQ7kNvwEYA1Sv&_nc_oc=Adq8kPsq_wXBBfxqJT2kW4HYiKTbp7hMi78R2pG5HRlVxiBS0gunGQMKD66Xso3nDAI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uo-bE1ZpVFRUFsff8EwDK0V4xWNhP0_GXPcaY6iUaxw&oe=6A26DDA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYHoiBWig48Q7kNvwEhP9ev&_nc_oc=Adq_23U9JxO78bldXNqa5UL4HEJGPVY5ElfugujboIKaa7h2KdzmSDqssyEjYLEGxZU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_riH5Yu9k2nQpx_wZCfSwG8oQjahmxqI9uquZQEaq_Dg&oe=6A26B838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVZDqF6iYPIQ7kNvwESjAjA&_nc_oc=AdrLi3GxcesM09RCqRt7wh74QQR5R0-agckH_uvzFldydddwgrEv6y6Y9VbQavzA0p8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z58o_4jpfujjMlaH2oA0zoM9lXzEb5DNpm6UL__t9NA&oe=6A26B903"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
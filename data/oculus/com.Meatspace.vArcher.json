3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKOVxM2t7gMQ7kNvwEqtqls&_nc_oc=AdpxBOZDUoOOkE_0UXdf-ckmQG--RjafYDhcn2BiLMmocg-QiDQeoDxdaKIfEHkMud4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhCZxXOsh1KyNYig9su0ttLpci7jMdP7bu5lx1gAV7zA&oe=6ACBA487"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vWaSKHhCGUQ7kNvwGvsDl-&_nc_oc=AdpSOCbdVjWbRmTn7Jy8ljq-UJzOTECyE6ObhFC6XUdvyOBlMm4p3BejVZ0HbpS-J1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdCQPaC0MnK3l_XSXmHDvtrY_6TjJCwSq_07rh2ctMrA&oe=6ACBAA2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-TrIdBuigYQ7kNvwEww_3w&_nc_oc=Adqv0x9ANugJb_q6AAfcipj9tuMzOqwDvNEtTQYkofTBqX6o44gq3ek0nd_AmMvTEMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq8C9iey3PF1VhzTHJ-2rk9exDK6By1smK3UNyzR9PxA&oe=6ACBA921"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IqLpyFxoCIQ7kNvwG-Ru9q&_nc_oc=Adq1r8LM_XMvirdBP421q4it4XbV557DnZIOQQZ_Jqrs-K_6Ks38xpNuqj1TXtfVcS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUfw9ZGdOfUNh8Ba6ARbvrJB-NF5FOC54rSxLt7RKBng&oe=6ACBBBF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgJtLDrJ1G8Q7kNvwEjdPuI&_nc_oc=AdqMuNJK0OL5IHQiNPdVIuMYeFF-xmCIfZ6Xd2qR3ozr8K51ltckqr2Fhks6UIthy58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx3cSHsq4ZpUtRnmtRv5wlm1JoasGgjjoBYQUrQyAqmA&oe=6ACBBCC3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
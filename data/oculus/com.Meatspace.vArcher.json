3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLm1JmLXjWMQ7kNvwG_HPid&_nc_oc=AdrSkJCr_38N81TPSy53IOTU-IagEVkyN16KP6gJgVVYihNlVjNFMVQ4spNKoe5MWQE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd0RCKasTYq07AWnOGsKMRB7FPofpf7slXv0lHBya8ww&oe=6A564F07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVI8CWr2yx4Q7kNvwExDfBa&_nc_oc=AdooiP0DzgVd1d0Ukb_Q1lhlQ-z7FyMb1rarLoE9uOeEYZpKcz2T9CGL-jnK3YDPc1s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaTE0TVwo6b_Rt5JiY_xMN-FiGZg70ipWJN7YUq_toOQ&oe=6A5654AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4vjmQpKAw0Q7kNvwH85MkT&_nc_oc=Ado-paOvaHp_RAdmVobmRUwpx-bwrdqBu6RdxUt5Oj3D0EMJmOeoZL1qK5tTaWvzfXQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYjbnAj_bQs219G69AbYoV8KJ3JuzJ0W5xS24lVeB9aA&oe=6A5653A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m_XaYillXMQ7kNvwGyoK88&_nc_oc=Adq811yY2DWI6VfRMBD3srSdhzfSUY0LkDm5X-Wys2nW_joIXM3SKEGhvMogYEF9_Lk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEe6wmfVQ0xS6bA__CJTV35XBjwwrsvWLoJaAIGSA3kw&oe=6A562E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRjYNCqX_IIQ7kNvwG1OqCL&_nc_oc=AdqryWQNzV28XEaIsevYp3pJe5OYQXROP1fXD7NSmc601c_c7NJEG_oA78EkZXPtdWg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYFl3b5n5yLZ4FmVNDldMw-46f8RoninnkhbjBDPT0Mw&oe=6A562F03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
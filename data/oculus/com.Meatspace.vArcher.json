3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GXirceOs0AQ7kNvwHLGRfF&_nc_oc=AdokviKurvS6M8cX9qRNeyfcYplU-RyOjpRcXmiSmfTtGWC3GtmRm59hQI03i5jafuc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCtiIavnA5bsVR-nlN8GC7mUzNyb5-eIYDqVVOVc8wzQ&oe=6AF9C907"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqhOKpm4shkQ7kNvwF_tLoS&_nc_oc=Adqw7tXRMi7Rf_hSg80ULV2zRRpmu1_aQi6jAdF271bTzl8UFoAIqXkLPsWr2ZLt8dY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyjx7trElZjiCi2B3u1B2F81jHiyc7FllEUupPETWmZw&oe=6AF9CEAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFfTeHhCQNkQ7kNvwHB83a6&_nc_oc=Adr3v46uVXu7-ETUTBjGTJvpSy82TGpqx28KtV4p0jXOxwUmLxkzv_i84FZmYJJ1xEc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk5tSejNy04o13OMOL3au9h32XOncWgoriXR33MXKqdQ&oe=6AF9CDA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr06JwXVrBMQ7kNvwFvOg79&_nc_oc=AdpHEudZTSKBotv-ZNUqMPFjR1f7AeCg3plJcTjJQv1AQQXM7GWl7XuZtFeFu08cV-0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfYh-_WPXik2Cj4zxs4E58b4CVHLjvDFk0eYiZj3sXEQ&oe=6AF9E078"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpMl57YZbNcQ7kNvwG1qjFC&_nc_oc=AdockjUeD7d--ODEHpAIBx2h55CYyQoxUn4hnzUKtHRt65YzKSksHGm2iAKdJDhbA3s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-YbwSdG6rN_3IEVjpsYx8fDBrMZ90haNiyQyiIzOH1g&oe=6AF9E143"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
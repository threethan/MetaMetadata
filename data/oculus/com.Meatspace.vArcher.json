3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERVvEooWfH8Q7kNvwHEglR7&_nc_oc=AdoTXvYqZsjgE357FEk7nF7C_GgthfxF6hmej-OUbw20uQlhbvfwqAV0pjDR_-yFm5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aeXjGvxx7XIm1Uf2qpqS059W2pnm1Fkr-tL4npbM7PA&oe=6A1EF007"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqnoF0uhCmwQ7kNvwHSQPQw&_nc_oc=Adpp5mOHXzuxpgJH_k730WgcJGeVccM-IvMOsVi9B6k2_nQSR1S3jWge92ifNn3XZrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JTqRUXzJQmVg5HKNY9jLjRdLkm8k_a01xSdzZBdDnPg&oe=6A1EF5AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBKYlOn1J80Q7kNvwFpA68u&_nc_oc=Adp6cbIuZm0gdvNUjNZ2QGfnpPsGQybOeF4cGSy3akQ-4wSN9IjLE5Bc0MegHqHSkow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RgQhea-CbrhuSBHUnVIMhV0AcVQxPVmmJm3vQKgn46w&oe=6A1EF4A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLDKSWLaJocQ7kNvwGNoHAa&_nc_oc=AdqNkIms30qdOx4m6fDNfgLtGk1RIRmAMqfd_HR0HMR7IWXyC2ktrXG056TWbObHitw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y73_rzDVa8eNdnMwGvt2nhxamUhkLlWJxwhbi8V8CrQ&oe=6A1ECF38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJ-w5eCz5SIQ7kNvwFXeNsG&_nc_oc=Adr2JIHvDRup_bRlydtfqL0oktEfJzQRFg3E0KxqKLMSDS0Xpn9hWgjlssSWHIXN9xc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DbLtqNxKTTRChTWbZbU2i9BqdURXBAjvjGbvw-zRdVA&oe=6A1ED003"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
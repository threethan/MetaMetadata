3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lK5uXXmU6cMQ7kNvwHxi8Mf&_nc_oc=Adr2AsF2MKPVg-Qvwb8BzpMf_wC5PlC6WKz-G09g77cAZwc4t1okAExbUE4wNhXia_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KtJR45B9xti1ORxGv38h-UiNnkzEGgbmSUR2SHyWUDg&oe=6A3FE587"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDGKuG7HOl8Q7kNvwEDHMB2&_nc_oc=AdpR4EVexi7XjJVFFT870_k8L43ZO3Znupi3GQ7k9l8uOAc29wI7F8wYqbenYLeYiCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q2Hsf4EYoo6B7fQMaOVnsH27b9eoeeDJ9cxRnn_7vLg&oe=6A3FEB2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyDwwucwkd8Q7kNvwHPjZ-U&_nc_oc=AdqSsDTTM24eVYKyAr4g_PBG0jDPnaLek1nIbD7BL-DQKLLhz0aaf3VKqd4NXS2T_n0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u9M5kYhvxHzbvh7LLDartv_0kgmYbBuiR5ksab1-nlA&oe=6A3FEA21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL1lyglfJhAQ7kNvwHscXhu&_nc_oc=AdrxTVSk3z9-0wsDwEWMV1kONugqZUH--Ozb5YuS_cdRkyRl4XfbIEI_rudubAjOILQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S3WNSF5p4JJR4yhCjwZY-uYGi5ucQiJuFsJjP9FT6Lg&oe=6A3FC4B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5SlNoQeUk4Q7kNvwG7o3Sn&_nc_oc=Adq0fX1r1jvwTwzHbcfw_JzqsbuSNhWNQLEu4a01aKW8cJZ6flpZu-v_PttaJN567Ts&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W3kcjUXZ6SIAua4WWSMYSrcyoaTbjVDUFEoA2SJJOcQ&oe=6A3FC583"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ystJHrJ6dnsQ7kNvwEe-1rp&_nc_oc=Adqpho4JO7POAyhGu8lPr0SC4ShKog3NehhVMPucRoKfyzaMHhlNUa-M2ZvDISSpNsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8xSchGfRhxsEoLaKMt3q1yR3ay5Bveqc3nL6hQUfG5g&oe=6ADF6B07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT1loBBT4PIQ7kNvwFCBVJT&_nc_oc=AdrxzDhkcUGUH84SJXhWz3AXaIdWhQ77fYx4bov1VOvBNucstU_ie--Ue63G_minJa8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjeQIcdONuWQNE2lt9MeuysGJf-soDfLCxhTSZSmGuAA&oe=6ADF70AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTqm-YW7ytoQ7kNvwHvhhHO&_nc_oc=Ado2KxLJx42AOUD3RuZh4KSk5V4BXBgoauWwrx8bbUP6RFy8N7n4pJTgUB2yTfGWoHI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnwUIAu9PRdsrlKMRrhTSXuY08htLawRfxsaydIBybXA&oe=6ADF6FA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toZr1qOFRiQQ7kNvwFMnnEn&_nc_oc=AdrdbwnEXqFM9NPlJrQt7atP1LNZxceOLI5ZqXnwCq3tkOKH2v_ZsOC3hiQI5DIKT9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnJLJdqhVqC3lz5wi7qOjraoouSkNJDNsj7nSdevwfoQ&oe=6ADF4A38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKvDNPKahhkQ7kNvwE4D1Ri&_nc_oc=Adr9_iW2OWxJa1bFQ6cyWiHhW2QqxvLhf-K8wdt01dJTSZK_AdkPcrueDMY3AUg1fkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL4WbX3a4L4zImFYGrc7LZiFiSTyIKNSW7Zl5rs4-P3A&oe=6ADF4B03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIlwQSQCyEEQ7kNvwGhli9B&_nc_oc=AdpMZNgTh5vokSpDWKXRvKpNO0dPBMhBMJvBSnRhG85sXTTpSoaZNndVvm4tkgtvzMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXoQa4VywrdkHbqkcnXV1tBKzn0XbWxGzSJKvUQzMzVA&oe=6AE60287"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zq3DgteZ1IQ7kNvwHPf8mB&_nc_oc=AdoTzzM6mnLw7RhB-79OQGl7rot5a8GbrczPf3NPZ0CuKgJFR938rR-83VJm1kAkgrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQmetYiwCrLzR-1ckMwFOzBw0UoAbXCkmqnaEcAuLCMw&oe=6AE6082D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQCEgY5j_74Q7kNvwFcjBaz&_nc_oc=AdrhGTi2ph3AvMpF7Cs0m3EnXdMBAjIBrzZfrOvI4jd6tW1dkilxtzmraSRUPO0j8Xk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKoNxPYu6yRKky2CfAqVt0chLm0fN2K1KNi37BP5e_qw&oe=6AE60721"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag9x77M3h98Q7kNvwHR1tYw&_nc_oc=Adqaqd7HHW_cQ5_EB7IDEEPfefq3nLO2fQaKjYKwnHxvTG0QN9cLuzbk1_77arR8OJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiz6uSXqblNqulbRLPMnTVkHajFIZdL3ywwcrLbhoMrg&oe=6AE5E1B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCFrU1yvUDwQ7kNvwGGDcNy&_nc_oc=AdoEABqsRUXAqNtf8MGjhDaXtD3MsgW7ojKdlVMKDP1CH0oAFxyCiL0NPMdHF9m84BQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOEk-gLXChA5zi1Cn8T37NkyPKm0pFx_8oUWhUlpYg3g&oe=6AE5E283"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
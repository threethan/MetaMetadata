3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhTxwFIlr9kQ7kNvwFp4rVM&_nc_oc=AdpF7b6OfuYlTp1ZDpC92vQbMnyvQMRUhMKBIU8Xk_M1j0WvHdpI8fCoDUZ8VTLK8FE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVcMobgEMmxo1hS9AQmzpRTppjuX8tiG7N942yfUywgA&oe=6AB7DE07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR5pU2aIARgQ7kNvwHBmRK5&_nc_oc=AdrcKHBL04J4ncHA8s5Pj4-_652IfEKA6PPCuzWgkVY5mVpOCZGlkiCO4MpV0OxZ-UE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgte0sCBFBw1lsn_Vj8ZDKhZb7h2Raq-mRho8Akka_Tw&oe=6AB7E3AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn9NHA9iAwQQ7kNvwHIKsdJ&_nc_oc=AdrS3SmeblrdThTxAcDXuAtzfKDrOcLp_c5E-9Qpg1YqdTV1mgkVEJkTnzMfevz74po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnWtxzcB57Zsz3rUN8pgpf1QKcuWWQkMP2_BD4t1t3gw&oe=6AB7E2A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrvM6gOEquQQ7kNvwEyfFDT&_nc_oc=Adoq6s0paxm98nHqzqpgVGDtAtGPcVfVsgiXNOtRsCvgAVeIoi_1Vq6czmUfygi1pZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU4vm6bGTE8CYE1rYAezu3PQA9qbp5U0fJjoFQ2efKYA&oe=6AB7BD38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvLatYCPnmUQ7kNvwEzceFg&_nc_oc=AdpNOOgLyH7hNbgM6FQtOY1-_BpOM_JolaKrdT3S7tWJs90R8y94W2TA06kj3LdTvAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwu9s0WvvRjFll3MZs2U6TQ088dxNik1d88_FrJ0M0bA&oe=6AB7BE03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
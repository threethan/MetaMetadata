3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce5jXAFaZFYQ7kNvwGcSHcV&_nc_oc=Adr_XjI8nLSJQAcsraNhl5wVGUXXgi4gd-mw8QvZtaz_MNCH3zehxL0dSHOvcjGLXaI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvG7PFox3YE1_NRk_2lx1-KrIkPoIjqgKSNhnABlSwZw&oe=6A662107"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwQrWlBC9TsQ7kNvwEoSuQI&_nc_oc=AdrjAMoRdGdT00OKCC3go6sK6s4Z-O5iI1l3gx46thZZj2djuFKQhxJ33LFyWFwwXAg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkJoZ9Zx5kbSj3C8HRkzO2tLKQPGcQOkPCxZhqeNe4jA&oe=6A65EE6D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejdw9liQKV8Q7kNvwFfj_dU&_nc_oc=AdqRXTZzsAmduM4W6JF44L8hhKx-Xnv94tCWMCcDlwYfOto-OB7OL5CTmCQeILqyzrI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfhGZSCTMwDYd6LCHFIR41WfQTAzH91NmkAnIcixc8TQ&oe=6A65ED61"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kzXVQELg0oQ7kNvwGgDVOh&_nc_oc=Adp8JDXnGDMJ9IsxedzTFJ_vNteS7Uf5CmqgfhZnCMYSO7y_dDwk-OOdPSDVSgIp170&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLigY_FQMF9Ix5b3hvToV73E0yd5L835GDt-8ps560ig&oe=6A660038"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWJAA7Cb_N4Q7kNvwHG7A4y&_nc_oc=AdpxWTl5jQkO0Y-TrpNDR3lKluSVgPB0hMAY6E2L20vD2l0wxHthY7B2yMXm5an8zsQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrYWScFipOFLr4CfUESOIToSymfxZg56Ksyz3jWqJcSQ&oe=6A660103"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
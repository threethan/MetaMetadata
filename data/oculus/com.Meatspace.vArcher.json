3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVTz52wzSSIQ7kNvwGrLgX8&_nc_oc=AdreYVWQFAs6YyIDl0C3Jdm02so5p952iGB08YCDy97a7LGBsp3qRV-0n4UrZWuS4ek&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HcjhnjLAPrumi7KrzB0IGocBoa6RmvoGgRXvmTdG_Gw&oe=6A243607"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTL9X4_tUTkQ7kNvwEbt1Qw&_nc_oc=Adp_1PFpv5BoIX8bS6pZeUAjiu1ELV679qzzZ8Bf32pegXASkO9YoZMHiMAGaSeNNW4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b5OuFQkOpNXMk4uW-isnldtZm8JYYbiiriDDn4vnETQ&oe=6A243BAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKl2NoPWv9wQ7kNvwFx2437&_nc_oc=AdoI3NANpxnmj_Bu5g5ah10bvGonmXlATjKgkDjo3mNtBaVdTvMvzuri7gCil7vM_aM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OJn4rOFQCOGkyxcAiVcmJ6JgH_qr-wBbZz1cfdinJHA&oe=6A243AA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5Bo_JJU3wwQ7kNvwFcsss-&_nc_oc=AdrBAPVo113Bbep-2rUE0mvI-qz3B1cg-alXkmWgcb821qTJgqI05f9wemSHKOk_QeU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eEOSnv5YR74v6FBV13Is6TCLNuLFrTyW7yznugMRQ6g&oe=6A241538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H99Jpj0DO7sQ7kNvwGJCITw&_nc_oc=AdoBY2wJhTYnhufhXNpVPdDywY6e0wi1gR4L0Tm5WqoCSatBQpUKxJ53sLLwr7fn5WQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sjIgOHoBu6zXMMvcYMxyF8kprbOHMWm6x6L1mtBqKXA&oe=6A241603"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpqdiZ2fA0wQ7kNvwG2mBog&_nc_oc=Adpg3BEAFQyvhDA-IpbgJz1HO8hozSilU7r_CiAre7EJKp4lfFNtS9I1RDD2aYrK9p4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz54B09yuZwbDppltiekiJuPSgULTxTB27ReFW9Tbhqrw&oe=69D0EF47"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Drkz7UebehEQ7kNvwFptN1P&_nc_oc=AdoQRBH4u4c5zEJNjacVyi1gz0ayQDnvVxwHGK37eVzGvMfTuqtmaBcUJe2bRDRHlW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdF9YTFyqRT-am43rXxNPZHhW7Ob8U0W0znRac3PSlUQ&oe=69D0F4ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMHqDnflzyQQ7kNvwGU_HtZ&_nc_oc=Adou7KZHoZ1AXHf36h7X2E7Q6jxG0AA1_nWf2mZwODwTH3y86tJTX0HUSNpz2QgfqIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPp7-tUG1pw8Pb2aN23oApBeySlnDfqUOziAJyiEhs4Q&oe=69D0F3E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWmSqZBqlAQQ7kNvwFg_YZw&_nc_oc=AdptQ7jtzzEs7TJQo6GlDnqgxXY7o3Iw_0_ef5iFo-B2_4QLqR6-yTO10Mt8xQ8rLR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdpjKu9EWrz-biPgAx1dPeSAPMMhtRXcRGcuoQtwJ94A&oe=69D106B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiClMg3E78MQ7kNvwFFyUbR&_nc_oc=AdoyOxDyBGNyvTaQbCPJzwa0d223WlWi_pi0th0zvuaZm2h9RJzwnlGLRAASLICDuoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFycQD5-5WenH5ZttQSBv6P45KUOP_D0WcF4-vVaYhmA&oe=69D10783"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ELYcuExESUQ7kNvwHK3mXK&_nc_oc=AdomUyQBJzdIMKBrwPrGu23pUbxMeduUwV4T_rtus_32WYy9k2_NLBy-SgV9uPJimqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qDyeBRREoOlVo7F6YahmjVdaRluvXgz1EmWawjHuTxQ&oe=69D91087"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgkeBfa6gr0Q7kNvwGwRGKh&_nc_oc=Adq3GpNFN8M1YA9zlgjzB3m3ltNG60oh6BEM4BG2bB_qlbSYPcKeSLeZiKM-edC9Qeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3trxjzmMx07iGq_JA625TYesQywz33mWX0kaZxqd42xg&oe=69D8DDED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLPcjjZ73moQ7kNvwGBKZUu&_nc_oc=AdpVBnBZLmxSx8_u4FRl2dpukCyxyOqcbcZhPUw4PXuDNvhAJ8MXM082V8qQ9siX-d0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CWZ5BYYMbDFkyFGcJmWSWT-_Xjn7OjcJDOBjK4ub6HQ&oe=69D8DCE1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2skRp3ZMnTkQ7kNvwFpQT5v&_nc_oc=Adr1r_n6vitMvMqwengashVNpESkK95JcSNcMb4vAZ5OJipIESbOhW5kjlzh9Hy_mC8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZrIOtfEunUNtygC09JgQ6mw7JHbpajri2pFqmkyD57w&oe=69D8EFB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xedt3ad4EbgQ7kNvwFKNnlR&_nc_oc=Adqk8fgUZov50tjwZ6LoUu8qQj1PBHRjbMCZ0bnEINiGwDjL5gA_bb7TC8g-CEAH3_w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vRXVdKbwFOShZaLOGlclJzu90enjxgR98DpyKqqIdQg&oe=69D8F083"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
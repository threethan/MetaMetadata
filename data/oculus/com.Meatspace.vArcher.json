3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54An31POMu4Q7kNvwFKz_UF&_nc_oc=AdqAHk-1CJXA2nRZgwRtciz0e5iv1hT6NraiwhiN_E1tsXsh7XhCQ4iTxjqWb4aSSWY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvhd33IQZ1qGHkCMEM9p-Rpl7f4UsZpZN7NLITcE3KsA&oe=6AC7B007"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vioYgWdLX28Q7kNvwGJiAeP&_nc_oc=AdpkNh7od5hIZw7F9g7uKKfbhyG4h3kv0S2FNYvsW79UEPiCwkWQ5rsO2H2_IXh3j-A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-xdqdGuP0MjFCvPCrivWeqJlAIhZkgseP7zK1oIKqgA&oe=6AC7B5AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zO8IftREvcQ7kNvwHrnB-W&_nc_oc=AdpZnlLxELI7VJiuS10cxOs-eN15nmxUz6rCKrM_NanoJekksz5_CUTTfIoPHvwExq8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9tuKoKf-owkGjeXVIDKZ0flwXmDzkPhWHnga5oP3tqg&oe=6AC7B4A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34vT47BkFbYQ7kNvwGDgL4v&_nc_oc=AdpWo704TKhunsCneY5OyUGXUo74yYNEn2YK00RLJ3hwP0uknRzACO4mFJt6yNc9ym8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuEEo0kiekdD_KC8onypfex98S9OC3wA0z46kg_LD9xA&oe=6AC7C778"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8FNsDVojMcQ7kNvwH-9WTq&_nc_oc=Adq8HAEJXGu9JGJo9lRpdxerfm513SiAPRlzbxPpTsrzMPCcySVN73Fmq3fljyf5U0U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGi4-f-koO4CQhO7xlZwbnDx7imXmfCxatHVMk52Ulkg&oe=6AC7C843"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
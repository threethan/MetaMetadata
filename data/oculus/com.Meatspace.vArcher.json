3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-8O2SMP6JIQ7kNvwEaocIi&_nc_oc=Adq9aKa7roQD9tzBN_VmlNgYmNMaKrEQ2ZZmlbRPkF9fAycn3_p6_knpDpuWcNN3zBs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdZFEj6eVseOaNbhI2ZP749prZwlEiFRx2kyHfrqDJIQ&oe=6ADCC807"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWTVmw_W2BIQ7kNvwEdZT2Z&_nc_oc=AdpijQcCJ-fSbAyllR59ZvGUN2S4fmB7YkXFAeQyiSuvU4BNXVwpB2feU8ejSwmOxts&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPErDhNff2dWwW3mGAUXI4pVRR6_nUxdqWwFez1BOG9w&oe=6ADCCDAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTqm-YW7ytoQ7kNvwGHljV3&_nc_oc=AdpdKx4ZKWbGFjGHbQJbsuaZLArXayMvOZNsjtIoZa52rRCwsFFkbbTTQOkX9S97PFA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1UWpnAr4vRNbxVCm0BoyMlmJ1WS7SnjksWZ7su8IWjg&oe=6ADCCCA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toZr1qOFRiQQ7kNvwE4nVdi&_nc_oc=AdqLgHVjUhKrdgKNPsuW3amTijHu4BUgtNgTSNkxWBNFo273wfVo81-ncRXtLGg62uE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlgDL-66ueg3P8R_cqiPG0Jrsj6MDlwzSjzHbqKVO0Uw&oe=6ADCA738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKvDNPKahhkQ7kNvwFHQYbY&_nc_oc=AdrRFiTU6nmo_j8BM55IkbRl0OCujYSlam1d0C-N7ujOttdNVo0teQv85UZ0dYAZS-I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhPj9qzG9NjnwhDBn-LBho2mgUJVRgoAVcYvmfTzd1qA&oe=6ADCA803"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
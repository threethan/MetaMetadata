3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmXA6rqY1nEQ7kNvwGjQlbp&_nc_oc=AdqYiP1gXgDp4lRmPMci9FUD55-qua00f18I2QCRIYsYKIT7mdyDNWXa3Bly9vkyI30&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk8FI0ik0ap8yCs3qSAWktVaZcvF-zyLqLZgXolkf43A&oe=6A58F207"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6I6vLT1o-QQ7kNvwERiJYT&_nc_oc=AdotvZMuuehlH0x7YYobPY17jYm0gl1IAoO8XSmEcT22nex3mSJPFnyCNKSbTcSEwUw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWKiqSNfOMfOzcszwq_GPf_Mi-IgF7m_wxL_c0X2lQ8A&oe=6A58F7AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4vjmQpKAw0Q7kNvwEeThXb&_nc_oc=AdriZQyjyNaCzYtp4uHGPRnkcqLclZykmjzL9Zb-bWtxKoZ8VoX8iRxekGfFtZToiC8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtbL9WkdY1PaJGN-5_-DRbXVJKEexzoxwFh8OXobhXWA&oe=6A58F6A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m_XaYillXMQ7kNvwEtuH8W&_nc_oc=AdoFmcbHHhbjE2It0Wf0HoJvhM1B4lEMU9G_C_WFSFFAzl3QJLBHcZY_23zDT0cgNZ8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ3FFMNktsiJzGPP3_JxwfyT0Pcmbjx-85FaatSwdqnw&oe=6A58D138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRjYNCqX_IIQ7kNvwFgbI3F&_nc_oc=Adprp6MePwUvHMcTKXs8o8t1iMvdM8jyTfy0UiZhGjLIfeilWx1xVuKpGNCM7Lb3Erg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb9T_-znxaaGersWwCmrYQKCJOhKU276-VP3YFwfEZxQ&oe=6A58D203"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
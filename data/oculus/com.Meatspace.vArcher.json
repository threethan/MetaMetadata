3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxupw-Z-dgIQ7kNvwE3Hn_I&_nc_oc=AdrGqDI3cZWiu_u3Q0RiSzVKUskvIosFMIv7wUcM6LHyJu58ZjLo75D0UedSlqgzaEs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV98njWPwP4ttTutCNM26au7YeyytDysM5lDfmEWOm4w&oe=6A71FE87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woi2SZzpTgcQ7kNvwHi2MLh&_nc_oc=AdpaTM_M7xDMzScy9Ew2jbtKT8KZsBYZZZeyAiSTqhlgmx7YQTJHA8xS3J7d5DHKu-0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzSctUj62ZnN8JI9j373_VJTjwXXin10AjVD-oQt69Dw&oe=6A72042D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ5hYkW6FQkQ7kNvwESGf6g&_nc_oc=Adpiov2-y3fsvY7sQPcD5jpKiJqCR1_WlzGcAk37eHgr0Uxl0h0ps3-wLtNh6HAOtqI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcfzNdtRUhX8gUKuXVw0fxefLKsNmRrMo6uP_TFFmb9A&oe=6A720321"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvnkbQqiKbUQ7kNvwEMJXJO&_nc_oc=AdonN8jwWhod4D74lGYENsvetYjBxvmF-BJe63_JiWL-HC9JmIUYtlI1wARCFmBsZwc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB_6rT_WxE9TDbUGZG2ac_MGvQmUpZ9RKw3vw85fWw9g&oe=6A71DDB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDuxTLm1_c4Q7kNvwESPhqw&_nc_oc=AdpdIvIbmzjTSbJjR1-_0wzRbXMfEguM_-iUBqxXxAQnjAt1sVmpK52ExV8al3Zy6xA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi-vs2jYQn4nsktpt3wDD7Wy4h-wuH3-WCElCOlqz9PA&oe=6A71DE83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
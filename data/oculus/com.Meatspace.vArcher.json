3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOTRs3edqsoQ7kNvwFniDpa&_nc_oc=AdqLP7Sm5cWAjoHMzBmyav7gesVqfPvrSAqSiNiVcAwTOJA5YEScz-X-DGcig_zZzYY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzCGum7IRh6Ww-3khUs_QI6h77EAqymWcIlK8YXaZVLA&oe=6A68C407"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkokVftKuAcQ7kNvwGPzbmM&_nc_oc=AdpWLzpIDe6PrHvzQSq7mL8GrJ3uTjMoZBHbtOtrZ1evpcC7RSctFjCxat6TdofYmkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALr_lwGWzX36r4QmNwHZRf6XC4-PfViXyKM3timuvW2A&oe=6A68916D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejdw9liQKV8Q7kNvwHYQPtA&_nc_oc=AdoLXx17QJwEOCiEtoH33pA8Hr2aGGXSQcBYdhGsPj7CsI98VddZj_sUYm9MT4Iv1BM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ7_n7YfLfWcQ25M9hZ3ECtxXJbMTpxzZ2qwjrHV_RKA&oe=6A689061"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kzXVQELg0oQ7kNvwE6eu0l&_nc_oc=AdpfovfY0Eck-QdjSqBdrr50c1WXg2o-wHEgSaObpCVYlKh7fNNy2_IdAbjZrGIW_ts&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr6Mv3Hh87e0n9PdtiSyb2Wq6ZLsEUU15gIBqtTInSxA&oe=6A68A338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWJAA7Cb_N4Q7kNvwF0j_gz&_nc_oc=AdoYqNGMVOYUtmKPux7r_vbc84LFqDNDU4bMtWzY6ck1oib-fYnFQZ2JRMfWAqkqpr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0GUPG-c9UdnQcSZLSVCL49PIkYKOVlkoVQ25OKY32Gg&oe=6A68A403"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
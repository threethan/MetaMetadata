3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWp_20_leZoQ7kNvwHKckwQ&_nc_oc=AdrF1b-m9Xwy1_KILbMjmekuAvdxAqXcxd6bJyVZnuT8bib-nuZRjkdJ-nycfB2s7cM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-LC5GKaPY3tcKkL7-mtBLPmu9zu6hl5XO29CAz9iyTg&oe=69E24B07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7nIj--2aJkQ7kNvwGLM_Dg&_nc_oc=AdqhqFaEtR_GYdZCqm8ZOpM-122_rggkRpi_T22m8UoB4JAlo405svYrDg4EcDK1nMk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Q76efDYdWxtw5jnw9ybT9JXN33oj_8NFXehve6LfP1g&oe=69E250AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llpTycABKDYQ7kNvwE09pIq&_nc_oc=AdrpHH5_jJ_657LkWkOPoqy81hw0hYr4hxNuXNtGQdn1XNvgxd4HCBDn8O4f2JxMgHE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rS-Jz8yKnWFqwu-dfW1i8KtarRIyl3gLfTPpHSVRl-Q&oe=69E24FA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrR9xkHWJc0Q7kNvwGEr3Jr&_nc_oc=AdrzIZ26SrBAFat_0jdf5jH6o3BYz2R3f56zpqpM9cTKXI0bWU6H3gSl3sWGHC919Xg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22tWKlcDzdeEi0GpXeZUf7moafiZ4zCweT8md0-Lgc8A&oe=69E22A38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZqtpjNShQUQ7kNvwGMdG_5&_nc_oc=Adoel6qHW_aM8hH7kAQzIRra2aIx4V3oxIzKZ55WsnhYzJPbUaY_-_6WvYTq-d9a_pw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y7kf78KW-aj8g-PXLOmBPTT3osjERX770pOWztjnNWw&oe=69E22B03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
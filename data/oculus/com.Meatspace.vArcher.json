3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcTr90PfdPoQ7kNvwEqO_8x&_nc_oc=Adph0y9CmUFfBzq8HxZfCLZnvorqLTy7bhwtJSiI9C10hI5awQRDy7QONWDcWTcQwdk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpgASB1le5l5gDx3HYl7n1xLe40oSekevI2IzHp2Iz1g&oe=6A9C2E87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEXnSDIea1YQ7kNvwEPzBKl&_nc_oc=AdpbxFJPgxxmggabGrWWd1d5OoJd4RwCJVJqdW0NdzRTczl9tDgrd7fkcFBTYpLKO8I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ1EVOqK9PppsrrhG4WZltQN7Io4n5WKqKro0k1bf6mA&oe=6A9C342D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3QJavjLRhgQ7kNvwGdKGfF&_nc_oc=Adq5KENEZNVCnY5kBxMAFzrMlQUjA0nrovpcRyB14ngfTDA64_juFTLque5_BbWHkU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLoqoZE_OjxunkGcbnWWgc2A36J8MFvVRAEMXIqR4xig&oe=6A9C3321"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Avr9x_IM9qQQ7kNvwHErINb&_nc_oc=Adqr4yvzh33QBFfCv1i5NChLMr2TdJ05GJxfRGcf3WEQVCn_d6mBjOJQWkmARqHAy2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINEiLmvGuThIa6CtY0wcFsx4a3ASiCpAgHS7ljKAbrPw&oe=6A9C0DB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVWf8vopYCMQ7kNvwEE-PGM&_nc_oc=Adq8lUfy8FJfCHyjjxF33t3Z7ySqRc4fgdTkdK9ZUnd-cTfii6wJo9BvIG0R_2yV9Q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5mQD6dxzWHJCehyufVlJ5a7V-LcUbzPFyRrMJrwd7xg&oe=6A9C0E83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4bbt0KPyGoQ7kNvwHQ2WOf&_nc_oc=AdqC7iRx8vhlAga9lPGdzn6okPwo58R_NyWt3ViRMOrLMjYZE2EIUp8yn5g4qxxlRJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKT2MweyxZaLezN8Klkkj4Clt5reJO6DuhMAX2V6QD5Q&oe=6AC11887"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG2-FswHyN0Q7kNvwHDvGoZ&_nc_oc=AdqUwOfJTbLUGEIuHyNZjONJl9vFgOGm6wHIvwWW9qVji7Sx4BxabaOoKv5MmTd1DL0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLIjnTKJPZy7GwnYD6vXo9YKJf_WUoSmachletfeS0dg&oe=6AC11E2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL6lZ7rG_IQQ7kNvwGMJv6s&_nc_oc=AdpY5bELfBEyOF3oxKfXnyCHz_7knBCZJ4zNNC14B1RLMAPZEm-0Wdwou0igN526lkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORjaWjfdSzWlABMyjer23jU4TCp_2lWSoWYm-CyBREXA&oe=6AC11D21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpabYzlAn_YQ7kNvwHXIAdA&_nc_oc=AdoIW-9GtS48b5Gt2BLo-dgF6PyYKe6B8utdzL10rcyiUgNY7XWrdaF3PDFLcvNj2cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNENH-nuKVuaMu8EIC0O8UqwD8BrYSYK-LgfV3dkanCyA&oe=6AC12FF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BOKTBJmYpkQ7kNvwF80lJw&_nc_oc=AdpeOfqsTrhqHlDkcT5Z5_0F51J17peT2Rv3us54hs2yAnJ3wxxAhbP-iZFoClUzV44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCCIMHeHsxIsDNWCtdbcdRps-fI4ZHy1elEHfH_GXOwA&oe=6AC130C3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
PzEWeraGA_kV-Q&oe=6AF49625"}, {"file_name": "Indoor_Screenshot.png", "id": "1030121742277473", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396573_1030121745610806_363182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etmTKYEQ3bMQ7kNvwF8z48J&_nc_oc=Ado83M9CbD1YPKe8hi7emo693z63I59s71EeaS3mbOl8C0S17cAL4vmX-u0EdwgKg-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVnSc40wVAebvGaYDKOEphabEpGe6EWFozhYLhzhDqnw&oe=6AF48307"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxFqKrYF9cAQ7kNvwFtzCGY&_nc_oc=AdpwdsiktsYOPFt_9QVpdILQOW2IBedq6fek2CD21vxv3VT9Uxbu79W5w6lfgZE9WPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG-gaaTCjOnauakdenhHOo1N6u4eFrtb6aRxRnEv_W5A&oe=6AF488AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DvwuHLrlIIQ7kNvwEScR9S&_nc_oc=AdogR3i23Y5ZtBamYYMXkwYQohk8DPyEXamOkvPYuKgJjX_ULiwyi1yfGIoVljyHXmo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaKWHq_2NJWZpUsW-6I6kFUU_5USBvNAltEr2chp90KA&oe=6AF487A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwvAJCqPWU4Q7kNvwHl-n6f&_nc_oc=Adr0Wzw6omGt3K_9rcTtTOYoL2n8uwVxvwKSEpi36XKBePXFJ1Tl_jbaex4Q-5dTwbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxjOm9uas0d6icJrkSGU8pzR5C5oc3JCuL73WEK0Ccdw&oe=6AF49A78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_website_url": null, "website_url": "https://www.meatspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27765422860
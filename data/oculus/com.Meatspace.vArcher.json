3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxq48iV_MDMQ7kNvwELluHz&_nc_oc=AdrBCecCdH_wWP2yO0G_fdQdFgLfgoyr5WoBvyWCmGIWPUj00zKRPtg1Rvycuf7kXo4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBC50Pviktbq5RWRFzkHj89HMlvUNBTjWUlKml2Bj8Fw&oe=6A8AD2C7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOtChaL3AHIQ7kNvwGYjVk5&_nc_oc=Adr4YdWMcdeWSfdCHVBMT5HUhsdD0of7ztfa1zokWScj3_q-k4cbAkX0nPf0qMS7L_4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIks1G9ossenhN-PU49T53GeLWkFv7dbGuIUpUzIdoNA&oe=6A8AD86D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CILMVPfMjEIQ7kNvwFQzPgX&_nc_oc=AdoOfKVue83frGymx6CKytbPhN7WEYeBZ_g8r2gzsaxOd6wtzlLVhT6yrKW-CTtfzO8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1h_24sTt7_ww3gwMAz6J2-HGSfYXWAmyFjmCUkV26eQ&oe=6A8AD761"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4thvjx5pMcUQ7kNvwFBcXgf&_nc_oc=AdpsYKcQ6cJLn7piuOK4LohkrmH9pDe6lYPbncsfI2gm9qnMy-u8Bi3STphXP11KkuQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPNk5Up0pvZN2iweqWl7hVkoPI2-lmbBi-c9wqcxQi4A&oe=6A8AEA38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhBW6jiS4ssQ7kNvwHANzPu&_nc_oc=AdpMESiNtUnEi6oP0fgHOOM5CJQXpFpvUEDqKhpyDyys10pOmvVxA0gyLyKlLN4pRLs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGXoZ5kBURaE70wKnkWlJg6u-3BheF0GDzCer0uHdWwA&oe=6A8AEB03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
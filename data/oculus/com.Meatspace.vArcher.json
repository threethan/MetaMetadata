10806_363182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=repTT5T6b_gQ7kNvwGCBiw9&_nc_oc=AdoXp6XlrZyWIRsITJvNjzrcn38pozNy_7s44whkeyLVOwEbregt_Dwz3lfdhpHAyFs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98aurHI6QUSsCsuLZYxj1j8rmgbzOiCSVjlSOwn0OFZQ&oe=6A22E487"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTL9X4_tUTkQ7kNvwF3AL5p&_nc_oc=AdqfYwYXe40kJi3p2kWvwBd6DsMD5hnSCZH87EiPHfpl_oGToGJnTTvnEt4X4Q3WrrM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_XfNwJ6vKt7R2BKZ7URrSkoTuT77aqFRD6kKhg2EtoA&oe=6A22EA2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKl2NoPWv9wQ7kNvwEAiVpq&_nc_oc=Adq3_Vi2XP4YFf6jb0QWIEw2xXyeZr0m25OFPTfL-JTOhaI2zIhRB6N0QBcJES-zPqc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ytsUqIDrybT0ceN4CDEoHUwIlid3tvUpJR0hkZ4lv5Q&oe=6A22E921"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5Bo_JJU3wwQ7kNvwGgyG4N&_nc_oc=AdoWYSBA07itAhE5uZDSm78miEAIOSPUYbdEcbctLWhNID-nQ_ngFUqMXbSG-EZbGcM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0uVq0U4Yi3XXc0GaNL8ImI2hYuvys6ZvSkU_64J2SSQ&oe=6A22FBF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H99Jpj0DO7sQ7kNvwGSA1qr&_nc_oc=AdoxYmJ1HBns_A60gf95wk6yySUlhegF0iFTBCzPJ4K1LyqFDNpFWoqVJqLPBu6BDSU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LD9UNQ0TWVw-0ccy6T-W6ncVx_43j44T56tlGoH774w&oe=6A22FCC3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive"
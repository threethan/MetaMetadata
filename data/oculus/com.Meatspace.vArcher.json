3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=repTT5T6b_gQ7kNvwHKD8r2&_nc_oc=AdpI0EaOSJ3w5xdWF7Oaoh0hBOcECHLCC__WAtaKu4b7d-bqCs-cX9E3BmLtHV5U9C8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af828o6nFDydsmVC1ACoF_rG7VbE2BI1lSWTLTDvS0jmxQ&oe=6A219307"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTL9X4_tUTkQ7kNvwGo_SZx&_nc_oc=AdrMJslY2PJdf4zybCAauMZbnr5A1zJZQgkA0VXqm_XHQOaSCdTLbElcwzmt6bslTxU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86mTBOJfZYMk4YxGrHJPU6XelE7oo5OcVNGlizZD9RAw&oe=6A2198AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBKYlOn1J80Q7kNvwHVUhL8&_nc_oc=AdomRuv1aN1KBRnIWaFP2ENDm5gcndmzyV8w3YaZGda7XnYfil-8UPpTLPFll90wlfA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5NnoOGW-WHO-nXOMlZBONCGLWAjtmVuWu2FUGKqrpiA&oe=6A2197A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLDKSWLaJocQ7kNvwHdwIc0&_nc_oc=Adqo6fdwyPkJVVNC0C5jhLumS_S3zapvV4ycy3aUpRlOupD9AMsMyLgOyxDAT-9UI9s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gn3mJC98AkfF_I-3F1o1J412pVWqiP39K0qDF0VoRbg&oe=6A217238"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJ-w5eCz5SIQ7kNvwHwnsW9&_nc_oc=AdrA8EVPGTT1p-6dniCb-Kt16K7zFJbKrBXxvZFX-ZwfxIdtKfWwtr5nK-bWAb0oVj8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_olCfY4M2hV6gdAKdH8sM4a82r37DFEutiYLFV76kxBg&oe=6A217303"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
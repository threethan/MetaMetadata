3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce5jXAFaZFYQ7kNvwFHKCkS&_nc_oc=AdpKrOAlxT7W7OUI7mLy9clMmcszBVYDuiUiDLjxKUU9aAM_0tBG5_Gq8WUOEmVhIy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCChA3ZueKubufmJHqEDpRiJayfoiOvdOMtIphi5V8iug&oe=6A637E07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sg3mrvvBWBwQ7kNvwHcPw8j&_nc_oc=Ado5uqqcUEm7HMv0dyXwq-cM7ugWRCnT9oEIvZjkQ79dFsCoUtrcjWzMZPzClVLGjdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWG4sRuI_8M0BIof1ir0oYHMoDbYktzTExhsIMpO6lUg&oe=6A6383AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oi4oQIW0-UQ7kNvwGuC6pg&_nc_oc=Adp0IV1xJjlGJnzxVg5c11ZD5sf6fmCEk2WXLajA0kKj6d14KpgsTK36_70sO2Ofjqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnxEJywwwOLAkjaeqXGZcstpRk_3B0xW1DLX_Go_pLbA&oe=6A6382A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGp_JLMc8O8Q7kNvwG_29X1&_nc_oc=AdoU95LzYeV_1GHPvAbo9pQYMpr8JswD4IGckbzTjrI1n3-x1nMNvk8PKYUTE3WxwmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw1plCSMzsexpT03jOwyY-ThuLzvWvvGK9zehYBjGutQ&oe=6A635D38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM_vvh8AsTIQ7kNvwEl4Srw&_nc_oc=AdoGJlA9o3515b6fZhUJk_sx1WWUbqIEQJglqxHr2hM0qJyH8x76hexM5PPnooQGR5k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh7BUaSisusyN9etKaYcPrdOY5werCR8VaRTXGZN0tFQ&oe=6A635E03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
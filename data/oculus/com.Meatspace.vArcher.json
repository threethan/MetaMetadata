3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROts4XYKDZ8Q7kNvwG2FfNq&_nc_oc=Adp_9rCHxQjmvhAagrdVB-5bvuLkBZEIG6Y5stw1io8jeJ_Xs0n5U6hrwRtULVGGTi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pfqZAAt97TZLRH-7XVG-0zqHKuMAkprw-wC_6qAVeQA&oe=6A43DA07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i5yk8CGGtcQ7kNvwGJG4Ge&_nc_oc=Adrtif0ueV6HhXFVYyTjWeNCGahKgMxLAxjC44QMSXfimWeK_frv92z1xnhk2ZN6OR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EDJFL6kioVod14gysUPcGhfB0bhSgitQTKKM6ns9YIw&oe=6A43DFAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eGFi7BEsWEQ7kNvwFKm5J_&_nc_oc=AdrY6HZFksaGDpYh0v9XI0z3PBEOSJwnuiagc2f5-bw8e429teibFhHVijNU8sgS3JA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EYde9Q8Vzdvc2S5jPCfTMrCqgKjYAqPpgcj--vGe49w&oe=6A43DEA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJSC7hf7-0oQ7kNvwGFH5NW&_nc_oc=AdqXc_Iul0rG0wWuy9EO_mQ7cxmpeetuxnQ5Tt-w0dodO8BnIV03D5AeO0wCpdIFHd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GBxFT2l4xMUb8U21dmg76i9Dt7wTNamibYTp44AG5Vw&oe=6A43B938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfSqIxy-l78Q7kNvwFiAwjz&_nc_oc=Adr8IGX1bFZetfLMfOpnJqpGH3QZdcmhOuqv4UPR-rIX7qxr04APzU0pYG86mMDQJ-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86aR3B8mNDGJamuvK0-Wh6jY0asybA1Nz502F9KwoKIg&oe=6A43BA03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
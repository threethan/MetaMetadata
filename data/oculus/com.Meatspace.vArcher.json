3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmXA6rqY1nEQ7kNvwGRHzHt&_nc_oc=AdpfPj23dFZikPHJK8wosYoOa-_tWjTfEIY3UGFVh4xPd1dzoLez79GaxsnfDIhByQo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeoloyE_y5NJ_SXx7zuJoHDmq4WvXub3z8LFhJCAAevg&oe=6A5A4387"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6I6vLT1o-QQ7kNvwFzWVXa&_nc_oc=AdqQsa8xBCjtgvxicmX9iabJMtkaTyxNuWg0WoApL8ztGXXWH4cKKS_PKLpmuUrBSL0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTbrqEtMs-xPI-ufV0TmFASXrRV6ekXHIzY7G7KgtGAg&oe=6A5A492D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMbAe5GghO4Q7kNvwEXDBcH&_nc_oc=AdqcmPPsFjpesRVdNtwcuFQxZoiacNh3K0a0e2YceMFtaIvjdqM70sbQ28-pbKtcdr0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB324-m-TK5LVd7XYmvemXDHxySOGfOnt7789TYeQkRkA&oe=6A5A4821"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJl9PW895IsQ7kNvwFgskVM&_nc_oc=Adqay128-gshUy4m2FmdcBEv8rmsedAlJHa0cNu5wXCFFaqxB17roQBxGULASxrrNRk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9bM5xCZOR0yu7I6zo-eI4RO3j7vGI54G9a4v8-HUt0Q&oe=6A5A22B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7HjBrhinqIQ7kNvwFPDMk0&_nc_oc=AdpLyPDMfbZHyYBs1DT1VfQ-Nx59E8Ja-J1XYrNs24aGMZOTi3kI7Bq3bjQHscDYOu4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-5qh7eoD7uzFv4PV_TbO-k2JMp5Kxtu5IzQtNeIF_-w&oe=6A5A2383"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
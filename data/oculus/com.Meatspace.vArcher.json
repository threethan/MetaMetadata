3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywT8IF6fWAkQ7kNvwGAO2ui&_nc_oc=AdqFqKK8iveiA33Hqe9a_mtnGqj8i9N9YNesxEhZ8tHppM7DEyoQrAXk3AzewDPJBMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-HAEPEbEkLSO1i-hyCI-k-Wbz6VPsibcQncGl5uLZAg&oe=6A05E387"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ce-oMzB6K4Q7kNvwH3o3dH&_nc_oc=AdqXjRB_PUkly4FYWfGYJoHdwdTsGQAxBB9n7cIf4NWrs89fTNgw5RRixnVU3wDgM3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sqB4ymfPPXuDKfy54oZHK3qWPQwZjQ8X1q2Q53SfRIg&oe=6A05E92D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqEnah-B37sQ7kNvwH9Gkbu&_nc_oc=AdpCxhBs8uHsZv0q2wnL_CWwHFKQDUl5hDN_q-A-iVCwzvGv6CnW1GMSGERR9v0dHUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DkzKL496mdQWC8syd3Y6DkuykTF0qtenb5Jr5L0GP0g&oe=6A05E821"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFN54h2VSc4Q7kNvwEh6Kp6&_nc_oc=AdobXo0D6Hm3N5WA2wZQJ-HKm7TkIF_H5n_hAZPsUEjasIirCxoWLB1EHSkS8ITY4Vk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68HAfa-oBbr9S50IFMrtXezVzPobpv0l_DWcuomYsXIA&oe=6A05C2B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYjdDs8NeGAQ7kNvwE89myW&_nc_oc=AdpL-L7hm3rYxvYu1DVLBJa1tBlV0qzF75JCSGiscorSH-vypWEeMl-maz3XN2nATHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dnNSDkN97uBQIhhC0APZHpMZwqExXz6d69d_zBM0_8g&oe=6A05C383"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
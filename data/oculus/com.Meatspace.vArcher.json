3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3GhY6EaBGgQ7kNvwHS-pNI&_nc_oc=AdoVbnGqSZAgxGC502D_Nq2Ly07s3JSOZ3Zvlcyci7T75NyicZ3hrz4qSmrNcx-fQYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAn4UKBZ2DRihEc4sAgwRIHIqAILeFiZKU46FlOCvH8w&oe=6A492007"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmFjFVIUXOUQ7kNvwGHwU9j&_nc_oc=AdrrjnqZU1nqiqlqPq2fpCV9wEBEq0zdH0V5Go-2_cuEffFIJ6vNRKhSz5oGzys22XE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxKYD7dnBzVG1SlgD0ejxoeTPqR_uc5ULfYdYrm_um3A&oe=6A4925AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD1QXySaNdgQ7kNvwGFZCL9&_nc_oc=AdquACHugzMqOQpU1Hy8HZ719kBWRBOGNTyj_jZA6gdsj2jC5YNW8HIlIp5RwqcaqQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJmCC0JpKgeIn1VaPoYWDuTfjZvJSCLql1W_tmYFYPwQ&oe=6A4924A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0Z8JJWA9cgQ7kNvwGxbm_8&_nc_oc=AdogLqi9FwE081NjdAEYbRRIgJR5jauMS0imgvAMdV2xU6JfHxv0e6VGHll4bGiVK2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvmLIY8C6IglX-Sy6pUYhVe5vN56sLraVe0eeio1Ucrg&oe=6A48FF38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fmW_s2FFrMQ7kNvwEAo8bI&_nc_oc=AdpcI9GQVtWXdK3kuupOcbKPPubwpF9s_6E5St5lPOfPdUzyx_8E0OpzX_vNK-vP7Is&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWQyMoWngr-muaR-DrZQdSNNeRgXXqmDGqQkfY0JRwhA&oe=6A490003"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVWQ0dAg2yEQ7kNvwFyCRi9&_nc_oc=AdoUcJWR_vePkDRhUy_V7wo77QdtXEJpPc7W0hMPQoNLx_tqtOEwO6CJtrnPtCDgcAg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSIvNU7QXV0n-XHWU1J4BQkVdRH3NKf1a3Tqy2bp-GNw&oe=6A882FC7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOtChaL3AHIQ7kNvwErPvkQ&_nc_oc=AdqFZDHiOi6V_zq4jQNU34RgIRLP-bQWPrccwSyfBwqHUHCJMq_NWDcH7QgRF_m447Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRjctR2ttqpq8ulmYi9nYeKlhIFiGE_mqDhsQeQzDckw&oe=6A88356D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywo5x3gUSkoQ7kNvwFTS8MP&_nc_oc=Adp-iJrM7jhtUDKOGy2KNViZUE0pgGhbDxuQyB4vc_n6ZlC_c_aBTav84TzDvgsv9uw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYTMfg6_6tgjiVcbuMuq8B1xkKZEc4zNhQCKv8ndk3Og&oe=6A883461"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QSNpW0Rd2cQ7kNvwHjJPfW&_nc_oc=AdrqAHQYSSiU6Ao1kqERd1lN0BAFvnGX3CWvIkVhxfPr22ik6anIhRbWjrLgDUsEBdE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9IIGJGGhUQFkkG8p8KGv7AFaFJTplMAn_UF0M0u7WJA&oe=6A884738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KS06jC0VReQQ7kNvwGSg16x&_nc_oc=AdqbgatXFvO0twnkJdcrESWmE2QjpjP0YWsruQtyKJSrD6Z1QcWU0V5xJpMO38-wduQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcv9vis8VSsl7ng19O3Hbar3pyXyTaGzOsLzV36Kn_ag&oe=6A884803"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lK5uXXmU6cMQ7kNvwEx5NdY&_nc_oc=AdqxIY8rcj9GTbRPhpV_pxiulgl7yGbW4uOqzfhnkeWDQelKCJTrRNT_wS5EU6ZjyFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PZStqfgnAPO8i3HBCKKU4Ho6wT8agZ9Tuq1zQL7hxMg&oe=6A428887"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i5yk8CGGtcQ7kNvwGfiyrA&_nc_oc=Adrxxw0Fj_s8zRbt8-27fYwHk21tNArT6pOFTxw4-LdOCvY63ulc_iqbxzlLWQZiZXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w8idWN6xPIgnwugbIm4DA_d0MJn_hp7fFBBPzmdimaA&oe=6A428E2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eGFi7BEsWEQ7kNvwERJ-zv&_nc_oc=Adr3lg58W5TctEYSJsNa5C4wiMLHlDi-KaLdE9j8MbW_KgzLWxYaO9PGkOEiW4BTKsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WIsmz7taL2_XatIbDNKzgmgSQYd6xCPaWzSLfI4H1KA&oe=6A428D21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJSC7hf7-0oQ7kNvwHTzSFL&_nc_oc=AdoY0jXpPr5IE-PVR9p9JLDuVyKj9ooffAxubHoBxFg-H9kcYMgZUkET3fVLbsL9Qas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6Wccx5JKokcobgVnvZmCRu-oFctk8aYH5KySCmAuiHg&oe=6A4267B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfSqIxy-l78Q7kNvwHcT4d0&_nc_oc=Adq56hUQNWdesccJ84RksbcIjJZSHrOQvw3jieY3Sf-W6l4nR1WyFiBU5eiPioa2YqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MvAtQOr2bG4aJ9Vy_JpKP4_uO5HR_-jHmP4tNYQ4mhA&oe=6A426883"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
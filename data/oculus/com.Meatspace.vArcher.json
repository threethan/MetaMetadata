3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SM7n3BvbJ30Q7kNvwHKWhcO&_nc_oc=AdpVfSgIunNsZCTfYdrE6WUrBOUfk4MM84Vdjye3Bst0ov2RrYakX8wksUCAVrP2TDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwp4sbnITEOJC8f1MHSof5dT43iTKUJu6CCgsyMKiG-A&oe=6A983A07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtJ689TIGP0Q7kNvwEXytzo&_nc_oc=Adp1pvkft1J5Latv1UDjKjYAoktTyBj3UoP13ZMhUmTYilvhRZ2Y6t20ztpdRT3JS3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXgX-Lpzrg5Q9ajwIM24vJfqXnqiGYhbcL6UqVf0hAkw&oe=6A983FAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H04IOoCYW5MQ7kNvwF4H8Jx&_nc_oc=Adr9CsQErpiTYaYDkFKNOYiuRRxNloqJylKSwZlHzUBOMzFYpMCyw3ETpch2lrLmag8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcaBWYZO4PgKA6k7H1tgyVpVmsA_zwyPLRFxQl3Ie_Ug&oe=6A983EA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awV-iZMdPuoQ7kNvwENjbGr&_nc_oc=AdrKa5JAErZlZo779awvNJiE_aLB9NjyS8q797lLujhrhBs8_TDMnfoFjeLCAllUvyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkGKXTXzMaFSwk9rlQdh_T-7R1ICECbfxMU-fSa4e5iA&oe=6A985178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnRbBmaMCXwQ7kNvwEADJsS&_nc_oc=Adrfh5HWsmeA8QyCTOLsLSWJ4gBF0_bbJ65FLKREqrLrvKjeHftFPeG17KhbI6Fw8_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuS4WetMpomRWbZaQ6MwHkGOp2UUvFL6gwOFLVOWDycQ&oe=6A985243"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqQ1tjRsXw8Q7kNvwGzjPUE&_nc_oc=Adodsu3BmDn6oBOVbjRLW_0_Ucj5PUn_F-dvyIr7wBwsvagNMbYvWEFlnAbXifDQZ7U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP1g1SuxFO5xm4SQ8_bmf4H8R1mOkYknAQyKA0LcYKpg&oe=6AC50D07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ho_aTNHVFo4Q7kNvwERcklo&_nc_oc=Adrx5o_Oo0cH5DznHC0mAZCPsiXjtyi8dsvXqG-hs-9F2J3tERNAh0lCRHKBOgWBtZE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXniYqjeOZ2t6I11sNV6548s5Qg8abUwEaayUa7VEkCw&oe=6AC512AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zO8IftREvcQ7kNvwE5l8X1&_nc_oc=Ado88W33mAW2gl5ZR9MyF3RxCSsSnoZ42FpU4Ju9bmYDCK-iAZMuRttftUl40GDwsYA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN21vM-zu3x0zvxMT9iTijn9laWg1MxYORrILUk7yaQHw&oe=6AC511A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34vT47BkFbYQ7kNvwGJ6djj&_nc_oc=Adp0SkVJUtlgpiyl9Z7GscHT-MCOUFQ_g9GB_7_GrlJW_Ga4_kJCpM4TfGQMKAUYgu0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWGtKS6AVmWlYR5HtYl81X03lRDw8BaSejxhhpnlgnug&oe=6AC52478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8FNsDVojMcQ7kNvwHCmcW_&_nc_oc=AdoJc1t2G_Txc83u-rkM_Io0GH3IZkxvx17Mbq2CEFnrGFenGZ9VZnW1RymQUkFEG9M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5c4m0HH2MrTXDLwh7sgMOfkdXHtEQ1C5NHeUIKfYWFA&oe=6AC52543"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
02&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQbqTenljIIQ7kNvwGmxZkN&_nc_oc=AdnJAX44w9zihi4m5tujJvcHwRLN3TtFDXWf5pAT2cHFmg6WzbAJEKR01bBK0tcLsaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkK7UK64oB-b9fHqfAgJCfdjAV410aqDGms7DAJg41Sg&oe=69BFCBC7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uzODKe01JcQ7kNvwFpumse&_nc_oc=Admo0opY7lSMzIpDxsh3WO-ZB9jxq5bgJfN9wmM93O6AwlnWKvSlAzmWfguDf7Vslw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5T9FTm6oQvZTA67KRH_kJIQb5DNBKJHFmzOuJxfNeVg&oe=69BFD16D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_AqZ9h9mawQ7kNvwFF5g88&_nc_oc=AdkT0V7MSSNJ9P-Cth9NRhjKUrBVMq3Srr_jFLjRYbyA13uop_P8YTM3Pm7j_t3Gcx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxevTXSeVYPTg8Fzc-ttUIIVkMP1KSJOq7X-NZ0AhPF3w&oe=69BFD061"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq7pxP9vK0gQ7kNvwF3ZZVa&_nc_oc=AdkC-qILzXOfsyOf958_bm6qrCnWHwN6p5c1cDfACwEvisiTl6Dm4HGweAPz7TDr2TM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnmTEdz7tut1gLSXnScdImXEZjb8-q6xIWVy7B3YYlOg&oe=69BFE338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuuhIvNfw98Q7kNvwF1HKcR&_nc_oc=AdkABh0yWPgvKlOjHSkqXfZIzzcQlaWvGbOIZBn29xzw9bprmpJma_d7vxeOsHFCdBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3LSb1WnjVekkLQXXW3BK-7u4QIHaRyVYftVMAH3cDrQ&oe=69BFE403"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_website_url": null, "website_url": "https://www.meatspa
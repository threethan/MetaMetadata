3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4mEtODJuA8Q7kNvwEkJmJj&_nc_oc=Ado0mQBXQBmS3jFDk2k-SdLnpZ3d8L-UKbnT1BbivUHhfnkvQ0Q9HIkb5HV0neg7Dr8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi6tVuDmvtsdjRiCc0wMOaJn2RFI8n_pTXzA_PtVE-8Q&oe=6AE35F87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zq3DgteZ1IQ7kNvwEXLKMz&_nc_oc=AdqdOhdPEdu9awFef7C0RKW0NQzelb0GMktMOzwVgpF4d6pfQS21e0lYTyOcCmRNoso&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsUQ7COYJ4p2Q0lQIHXkrPhf0ScfHfA7A-NJDke_m78A&oe=6AE3652D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkKWzBK73HsQ7kNvwFeEfzT&_nc_oc=Ado46bNiAoEjUKtYngV3ziqgMA7s_6aa2oeLH3HwH_MLK7OBhn7dnYwkk_VQVxSW9zs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpAQyuGgGAzLgts4ck8O5Apx3azDrpfxkCth64w_twrg&oe=6AE36421"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpoW8XeHQaUQ7kNvwFp4ipR&_nc_oc=AdpYbXpVzX1Y81bsFZWoweNg8klI7h6eMxnspqrv2_x55x2c872RDQp-W5rDvD6XzKs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYmZKH7wGVrqJaAppdv3EWj6noO7UzicO4MfDZPsYoJg&oe=6AE33EB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIN2U4qQyN0Q7kNvwFmqJzT&_nc_oc=AdrLhHLp9-OZoZyq3IQpso3ryKPbAkFqtiq6u6IviwdlKN2kduOWUc7onbCyCj-kfyA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkYg934OGMEKsl1hXEgtlFrFiFRoJORh2b8ZW8NjvBAg&oe=6AE33F83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYdKOVHKd9sQ7kNvwGy-ckV&_nc_oc=AdrwmUVZWoEdkf-HhKYuROC6OaVPAE5qKbhVaf8CMvJwgtEO8ux_c2qMmDa1hRycgp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nce85xDfN5hwOlNUOm1bD_QgqbfKZqRxpIMdIbnT2xg&oe=6A146407"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RqPUigVntAQ7kNvwGHlNGO&_nc_oc=AdqA93GtUtatk5PjHvD0vYNNOv__Qn0_RNzyCASYZjZQgWehPxl89USVpJmTryKuets&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50EXHshLUQu82dq_pimkwVRHadpl2p8U33zoHS_xk37Q&oe=6A1469AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am5MoQMHaPsQ7kNvwFMmPOG&_nc_oc=Adr7M0IVddp07om2VDW6_VvGMbWskhWQ17CsuV0lejGHouuq52HWw9bCzuS1YLBOEXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68lVpsgLIwk4w7cbxyY45dn1axRJtpe9fpIkZsSm3AUg&oe=6A1468A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_jYZqpWF5sQ7kNvwEf0V5z&_nc_oc=AdodoDQjrGg0CmLlfxOQ3lR6QRNVXPAfAd1iKIAYOIngaPOLqVK750G381H5ilD4oic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DMcB3Dp4LJeKTp8HsZU42-GyGAxYvRqVe6R3QrZMITA&oe=6A144338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t4C1oyP-28Q7kNvwFfGZ1m&_nc_oc=AdqbuI0D5caA343H_f3YcoGLnJwpzaiC9Ctenc5DafVaskDgxWnxgTTPXvgN_5gJXEc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QTxk657UQtkJsnu32tUSTnVzKd5_wv6cTsGKrtNRrCQ&oe=6A144403"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m3fRlXTjHkQ7kNvwHswKCR&_nc_oc=AdqLcSTDJ19k2QH-P0RTu2kN9GC47keQ6jNADCuAQAdykw89PmMaZ2jwdHVTRpJte5k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZtMYfGzSrRVXVDy7YZNUePmrM4qwnIsG4wqphc0y7qQ&oe=6ABBD287"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_vZ_g8QktgQ7kNvwGE7u7g&_nc_oc=AdoGlIV_F9Y7-3U6KeJ8SvxnCpWTehmfq_hbQDx592ks36GUKMZpLIZgBB2wWveEJb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEffRHlwogGVJTQB-a0knyhhU1nKKUUhAbWG8lIuspmw&oe=6ABBD82D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdtbheWAlN4Q7kNvwGIuq8a&_nc_oc=AdoLoqwHsKOTKiysl6jmfcGojbnsStNc_1NGJw8zDDeQVH6uPaSDrh2a7ot8JgYDwco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQYoTHXKvzzmyBydq33HwvHH44uQV5hK0LGwfpHebHqg&oe=6ABBD721"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e604Q64OA-cQ7kNvwF_Kb3t&_nc_oc=AdqjYOVw3zNB-3wJB_pqQDvIOMdfYciTupwTaozqJvMplXQJuRfFLdO88r2ORjz5t3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLHPeNtwnY2zqqN9hOg72pY1grhB3CIFnO8dGyEfd9RQ&oe=6ABBB1B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFSORGGKVlkQ7kNvwG9bDNL&_nc_oc=AdrABDvMzK1EY7SpXISyUZsyhTi1dCZYNmhh6wgXJkFDD2crdoha8Eu2gqcfiUJ6Phg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCFvck40PzuLk7Wx9jj1l0d7Mnak6-fKjgAs3M5BQWbA&oe=6ABBB283"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
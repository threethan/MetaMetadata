3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpqdiZ2fA0wQ7kNvwHx2WSi&_nc_oc=Adq7FKG9Vnco2byUuMh2t6whJhE5pxDlxRbUMYoEeVN9ygALNLc8INErnZAbcNmn_o4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nU7XbHjaG_pdukx6aOR_E5zjXJniaXEH8QJKBRmQyzA&oe=69D27907"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwPIwq2JsdQQ7kNvwFwu5tt&_nc_oc=Adr4qLEdkH2sxnlR9NAx-oJu4uwlMjjDImhmm9eR1RWjcLWO_Ol1eBkMVWM9mXWewpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uY9yIPQUCBLQHcjb6waSD3jToIIIN5mkmpYCdNx7yBA&oe=69D27EAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMHqDnflzyQQ7kNvwEgCMbv&_nc_oc=AdqrAWwdQsFvN6AsU-NrPMZTQbL3bq9Ek-6vG7t_uNnLL2IQNxL1wQiYXFPEhUXTguo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af174ChaHfdAdYRfsSWMw4qrSYhGJlnZvRmU2PyfOiO61A&oe=69D27DA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWmSqZBqlAQQ7kNvwGRbvbg&_nc_oc=AdqzTc1cEq9Bs-faDm0nU7YX4WXx14LvJ98rqdjG5FbLe2Ov_Kj-9JobLcNzLg1ploU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DdJIcgRTJCKDZeM4KyRef9mESoA9Q-nH8lGVBA-eZOA&oe=69D25838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiClMg3E78MQ7kNvwGQGGB2&_nc_oc=AdoNiR1xGy-yfLnbygfviqwlYYdg4rXf0nqKohRFzvp3EwKgfdq39wtY8uIkH-Ascqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P7SBGsW_h8e8YyNUoS9apjl8V5EegZjM8zKxhPowxXg&oe=69D25903"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
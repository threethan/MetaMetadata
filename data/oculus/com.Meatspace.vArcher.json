3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqQ1tjRsXw8Q7kNvwEGGfo9&_nc_oc=AdocZ6hhKbUFGusCqmDjzI1tm14gKH5FPEaA7SbZZaerhL6P6F8Qnj0B9F8Dh9xZtuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-tRezjohUSjZElF-u-mBST4ZhkwZ6Q8tpxL_zXOgSkw&oe=6AC26A07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG2-FswHyN0Q7kNvwEdgW3x&_nc_oc=AdrINZ2LUgpacYOoItx_WSv5mMr2PxldwFz2cEeP92ltENhUoaSoKFAN8iq6YyJq35A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfGkQcg8eTIpuZMUyr3h9nJYyytETfuKrLdRjnf1nyDw&oe=6AC26FAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL6lZ7rG_IQQ7kNvwG07_7y&_nc_oc=Ado1t18PVNys0nBOBHYRxJ1ppvcCAx2AkMeHq3bA7sB1X1OMxa6N_CxDsrgNlyiep9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkqXPFeWUuWNm-uDsaHZZiMbLC1obgnGVQy4iEjeA9JA&oe=6AC26EA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpabYzlAn_YQ7kNvwGfc365&_nc_oc=AdpAqoW_kOiNsqQep0ltyjimb_3HqB_JEab9KiN3cpadk9dPwPccrerPsdXXHOMr1-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrwDCdUyMJrlmf95SEaaVE114HORQ3l0Y1EiIPzdf-Lg&oe=6AC28178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BOKTBJmYpkQ7kNvwEL_ZNT&_nc_oc=AdoufMjs0nDYg7rSnQQgisLQYJbBb5Z3yEAYFhHx_xFR_HsX58eF48ol8DY-VmLOwKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM78OsYVr8Vfn4DI8Xd0qrPLjxyll7TJL80KgP70pH51Q&oe=6AC28243"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1TtNHinKqkQ7kNvwGvystZ&_nc_oc=AdrfD_mzA_5mbOLLiuRoUH7s5gLy9LkIoqwc0g1n_G3ejczxy-JtcKel4mHzDZO4gOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR03Ix-nnmrpP0CoYkXU7AS0JkNinEayzBH8_bxFPvYHQ&oe=6AF08E87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RKqrc4Q9AcQ7kNvwGeoC8m&_nc_oc=Adrh3H5P3ITPcMOoApvsfkkTDV7CWNpSZBANbyN65PiCuFJAU0VmKurDsPfMeLym0DY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxRl22KuVq2CGQM9wOR3cRgEi_VZ3RKjTr-00GxfLhPg&oe=6AF0942D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGB0zPLn2-cQ7kNvwGoJgKY&_nc_oc=Adqvc90XLPASTkeg_jeW7XYbMKH0zXxSrijk_W2DacjXxd4JKhJx4XATFKaIaVlwesE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnpQy9IJ0_AEA5WrQ-Aysk-8h1Kd2lqzaIvRC6RiJbFw&oe=6AF09321"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvKwCGB6l8oQ7kNvwEi-Wgd&_nc_oc=AdrbwJURaXOOpiDc7KEXzeIvdHiMSMax8-yHXlwliSFPlb7dCKbFg55Izdhz4_J2mdY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeo8oCVzrhBmHPLlwx8fnAtM2G5nAwqnA3osV6cnpAiQ&oe=6AF0A5F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOg2mY8c1CAQ7kNvwEoctRw&_nc_oc=Adp4LBgPt4ETGNTDoMrwhSVebSbOA1z0icaw3-HAiJmxbh4NTVsDYCyuJx3baaZvpvI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGXTOD2Hp68_eWg4zD_5-OvpIKV2VCSNOSfyuZc3s3Ww&oe=6AF0A6C3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
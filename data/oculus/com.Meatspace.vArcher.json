3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5F55MJxwmoQ7kNvwFfXjik&_nc_oc=AdrP6nRAk1doTIL5ov-CmiLNAT48T_OVmwGFC6jlEqBR_cxIv9M-tvbU9LX1cTG0nEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EGlGkaeE3CULvZ3BFBlD7Kny2pssd_UoYmdPOSNdmnQ&oe=6A009D87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a62hH9PM26gQ7kNvwG2ZrIe&_nc_oc=AdqmdxACwZoUqIw0fAHyzZ40CWqMpdrBOj0LyWWQqzU2GCtTZHtMoyPf3Bsdz2Oh4fE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hHTjesgtw-2eN5rvGUsZb9lyqr5XiTkw-AAPMSpZz6g&oe=6A00A32D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOM-7mwXeK4Q7kNvwERLQ3n&_nc_oc=AdqR4Zj8BaJQYUikh231CdaTa0qOVhfaKXPqM012OuzKk81idhbDdWYC4CVtTc5tTOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C41y_gKDrp3mGd6_2JJRBkNLvTpaFMgpa_75eRbrTqw&oe=6A00A221"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBC-C0fQ-84Q7kNvwEhbqyX&_nc_oc=AdpdQ5B2kg7O1JXAMyUkIubkaAPR00l8Bskrxiu_faviZK-ZB_wVbmT0y6ywo6k_UpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KoAiX7Ze7gz8ZRPYFYckbu6FXtTa22Pvz2ka936jLcA&oe=6A007CB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxjZ_ScaZo4Q7kNvwH0vwG1&_nc_oc=Adr_7Ici7BMTUjSpRms3eE4L-L_-3GKt2YwK1glwE6SO4r6ly68fsNu0Y7LGwgS2nTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_TefgrEuUUm7dIs2W8p5rGDDaNqFlK0W5b2Bo9dqayQ&oe=6A007D83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
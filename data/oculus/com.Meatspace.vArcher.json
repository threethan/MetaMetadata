3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cipTgHLs-_4Q7kNvwHYH7B6&_nc_oc=Adq-SUjpwjRR0H0BrtMdWAqD2P7dP7UHGepiW4-UIgS6oXT43hxpi9BnQkjv8UKTgOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE7PEVzfxE0kEm6aPpHIjPhbn4-rFm9wy-97rQNN_3kA&oe=6A510907"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEe1F-7VVFgQ7kNvwGUq8m-&_nc_oc=Adp3_c-3sSX_2iAuHUaq0404nUJs9KEodWXongNneOC-22VP2LxlG1Q4zXop7pfrls8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa_bBabGyAdax-bjyyiaZFNfSSEDYzuJKADZpQFUO6mQ&oe=6A510EAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K2Olk9OxfwQ7kNvwF4ZRoW&_nc_oc=AdpmX9E94is42hVd8G-RfuCJtrCy_7mgn_sS17TLCJN2h_cANSutcDyeUHiKUaMcF7U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7euL4O9dq3gXorBdN2-Q0BB7G9hMiwd16GEQ_rtKnnw&oe=6A510DA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHeFf728fgwQ7kNvwF90YcU&_nc_oc=Adr92TgfLuC8Go7LnZ8hNu0Kve4-rdVF0rUpHPGD7psigbI3CDD6jv3nEjvQF6QKb88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh8lUMWO2gesmLqToAvK2oMw-E0zFKoL7XPETlv_Govg&oe=6A50E838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIx1XHmz4yIQ7kNvwGifqjY&_nc_oc=Adql1S5hkfbZszSgZA6Iy70HQDBzBi4_Cg5tKRApJSG1I1GDmEIYvgiYs9bcoOcJzgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcTr_8yW7IXXVwaMAJc4yqu4JsyBt5Q8wQC_4h6c9NAA&oe=6A50E903"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
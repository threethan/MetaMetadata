3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0KAQb5u9z4Q7kNvwE8a4q7&_nc_oc=AdpVcIDukVkMA3W0IytsfMhTOqdkSNtXXdfFvX1YcDke5w6uy_NPZ-NTj0qDJKJzzWo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbcrBomXvmH3L6krRbNpDTS2PDtap6wr-_3PUeJFPjZQ&oe=6A4E6607"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrqYwajUU5AQ7kNvwEkUjJ5&_nc_oc=AdqhCWJ3QZc4rsV3GGpBI6I_NlclENz1MSdAl24-Zz5sEE8aav9UMemR7-9TSIVOZGs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2BwZbTp9dw12qofsYGn0hbuulUZbtKqEvOaRTjPpi6A&oe=6A4E6BAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K2Olk9OxfwQ7kNvwFfJlOR&_nc_oc=AdrU2wzttXU0xYWLHPHQOjVebbLb4hvfy00D6Oc2uLKZUQeTSajCv46u8miQv2z-9gM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU6GM-Xly6SiBx4Zvo94C7y9AWkdLrxHGuIBoX-pEcPQ&oe=6A4E6AA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHeFf728fgwQ7kNvwFqSy6I&_nc_oc=AdqdtXgej1QCpDr5N-VpDUYoEuVxq3W-N8NTpoBLoGiVuxWzZ_8EyNSrghIr9-Fu_k0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTf-zANMUiBaNRBun3SbX3LHSd6244dEA7hXUdKPI8LA&oe=6A4E4538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIx1XHmz4yIQ7kNvwEmc1BD&_nc_oc=AdrKObut3dpePloUP5hP0Y--BlfSdccBakD4315cLrgWT3nMPgKjn971I9ZvdAiMH5Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv5v8G7O6A_Le-5NglvhRBJSTH6GNbP94KLxSmQmiq9w&oe=6A4E4603"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
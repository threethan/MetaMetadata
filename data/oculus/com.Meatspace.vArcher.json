3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOTRs3edqsoQ7kNvwGO7KqG&_nc_oc=AdpwkL2ZThLqaTkRsR19NH0Lc3Gq4j0mqoXg-OAZo0c4iYeT-L4kr2ii6PXxMqVInEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApA7_qlr1GIfY6XSLDiHY5ZmrGg6RpuPDVQlx7MAQqwQ&oe=6A677287"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwQrWlBC9TsQ7kNvwFmrC44&_nc_oc=AdpGmGGNmmCLqaW00h8JGKtxKi1xoC6oLs2e06fHARaeS9dl3XUwTsN4KHrNQGeYbNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjzugP0stMYeajTIXXUokm8TbdZKeeMrfRMu5_H4eJ1w&oe=6A67782D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejdw9liQKV8Q7kNvwHp1g7l&_nc_oc=AdocKwK5M4G-zVE0fkguVP4SCV6ufbfSwIISJM_h_L00AqTjilScj5vqNPcBsHE5uhw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBca7v9kwvBPj1oEk6KEaHw5xIjKF_6EZnU7hswKJP32Q&oe=6A677721"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kzXVQELg0oQ7kNvwG6Xk9o&_nc_oc=AdoZrdPTzMChOPqi5OAaEj_9Mqq-1NC-29ShFVvOy7iZyJ-Xtvs7WwGM0sTjTsZZujI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzLdUQb7n6qDi6hXkP5_qowWrxXKycAHlJSU_0_FR0AA&oe=6A6751B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWJAA7Cb_N4Q7kNvwFrhrHB&_nc_oc=AdplnMYX1oWCduh0hbT_DrEVlyUKv0QoNX3QN2xWKKdO0gmtOOCyE1JgUg-GH16rEBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX1T4rR0fRtdJ26LCDT9CLogaO6MuSKrxzKRUJUG5s2Q&oe=6A675283"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKOVxM2t7gMQ7kNvwHVUdCv&_nc_oc=AdofzYObXL8L-k9427wWxrhazf6-EO6QDlfa9c1kLpw3OHuE3KYhbBTF8xvPC2hsuCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKEK4fYJ9cyTkpV5P6kcWLj_cpxVPT_DyxJ1TSrz5CrA&oe=6ACA5307"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vioYgWdLX28Q7kNvwHo2ha_&_nc_oc=AdrPDrl62vONj4ZB_zyqB7IZuliM-rOrAK-qA7Vp6uXH9D2_IQtt3LR0hNLCvcYtvwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS_ZALmUlxF9-rxBn7mIMoAoRVvSjnvaSuNhmeUSgIBQ&oe=6ACA58AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-TrIdBuigYQ7kNvwGdvDQD&_nc_oc=AdqwDoh0K0gnSBZKI8PR9NrAAO1gB6XuBg04Hs3vLsKjV4FVeUlNNmaIfwshug6pOS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn3ayrQyqXe4Lx9uFHkt-nneJQtfZKJ9oxbbG3UPLKaw&oe=6ACA57A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IqLpyFxoCIQ7kNvwFufioG&_nc_oc=AdoSpxzbK-Ov6xSpSvprm_PkXq2xwWE9qmFqE-emQSDgHmlqzxCxuVyqsH8VwKo_WnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGJjY0v4xddtRVrS1XrfEbe9GUW9BTcmX1_77kwD20rw&oe=6ACA6A78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgJtLDrJ1G8Q7kNvwHv9Fe4&_nc_oc=AdrsRwNcfdWBCNbh_qzZ1jqEd1Mfj3s4EAwQ2FS8YudkkUOB7-Q8jCp8MAT5399xhOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdJClaxKMPt5IISPfD7-c5Dkj_bln1sPa6fn9iArwYHA&oe=6ACA6B43"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
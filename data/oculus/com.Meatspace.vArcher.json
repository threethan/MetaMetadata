3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaSo0z7n3NYQ7kNvwEYsw-h&_nc_oc=Ado9GXDKhdRpMIhxIJSmQP7TSGgiyNA86mDtajLx_tFDT_JNBIaTyZSHzOBaPzl7Lhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6DMMTAFz1qIvmmNYlIbOZQYko2FPctUkeNNXGatGr4g&oe=6A5CAE47"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=194tbor2oMYQ7kNvwGI_1RU&_nc_oc=AdqvHQ_R0A1CBhD1RzLCxbbCeBPjc6ftRRYKlz42yHO5MNBdSihOpBnEXnFBWAB9i3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZCG1Mb4P1ZMcFl593pCAC-Ise_XRdHipYK4GWMlvsRQ&oe=6A5CB3ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMbAe5GghO4Q7kNvwFoNAJ4&_nc_oc=Ado_aYQOEIQGRzr2tbR4MTbmcQw-JFi05MWMF60raySYiTDCCtuVgF_rTtnRmSHqHR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5dSgMdAY9QUiGggyLkoEKBPoc6d2dox3geYrZ0C92_A&oe=6A5CB2E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJl9PW895IsQ7kNvwFf8fPe&_nc_oc=AdrSNnrCLvAXsXhomEePoQvWTpLZ5Li9l9QGRGpc3E4fANfqkyV6Y2bw7p16TejOayE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMEmX6bUfYNxnI_VVAoplk_cqHbkoT4wFruBS6JZK-Ew&oe=6A5CC5B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7HjBrhinqIQ7kNvwGCxoMv&_nc_oc=AdqL-zl4lrND6jB7O7zcJuygR9TYW9dEGuNLKy16DWYZdSVi6ZBz7vBDCQ3X2CNho1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHyzhZ5NJGajAxSAbwEzVSvschVChjP4KTQ7-dGu3Mqg&oe=6A5CC683"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
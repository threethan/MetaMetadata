3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SM7n3BvbJ30Q7kNvwGf_vtw&_nc_oc=Ado4AGrAGeDLNIIpX6ZkCrZolaCj5nckxhflBR3_r0VbTpT3g_qBzw3iI0t6YcyujuI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQhjKFx4PGADfLEGPF_5DTk3Q9htuvClpdFbyRELaNZw&oe=6A9720C7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uddTKcGInL8Q7kNvwFGFO06&_nc_oc=AdqTEWWg9Ul7SoIWvoZhApxttWVWqnj7csYa6gMgUFXT1qxzu1_UBE8uAfj_6ZO2wlM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhRT0A0vDAcyvOD8s84LgIE8EGikuB7IkpG-QAo_hxHA&oe=6A97266D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H04IOoCYW5MQ7kNvwEY62Wt&_nc_oc=Adrc-UagFBOiQWjY5t8XP21b5aUovcXcOFqlm5GD1NU-WJ-uKfqVyebYV32Ah7JuGnw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT_yfYZs2s9vAU0cYTqKL-Bipr-Zncf6UGWCSb5e5rmQ&oe=6A972561"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awV-iZMdPuoQ7kNvwFfyy_m&_nc_oc=AdqcQ_zBLJZG_V9lsSDY2pKy8Y2eTLC5OOH9Gp6Mjc-LyDWhClOphCclUCPKbJ14LLU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbEMeVzGieu_gTY7ziItGAjvwQ3yKdcguNlZQlJb9DUw&oe=6A973838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnRbBmaMCXwQ7kNvwFZouid&_nc_oc=AdqGYPe-X7s24DXV-dAkyjZGlTts7Y3WoTVA4T2XumHmKrhdfn71NmVQjvQu74VnMZk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL2J8N-6E8Y_VhyFFyAoE7Dx4wzj7XR-mLpEeoWRw8rA&oe=6A973903"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
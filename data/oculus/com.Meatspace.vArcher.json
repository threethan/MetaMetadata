3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9e6CfGpsq0Q7kNvwGc3UkM&_nc_oc=AdozTXwHWvwKGcIE4peO2FFMTCSJnPxS3d7lakMorv0YvqlHas2Nfql9h7sJVI_skq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwA5WE7tDYpySOzov9Kbr4pv_2EQ9g9b_FTAQH9Pemdeg&oe=69C90647"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5rmSZyw4FgQ7kNvwEu2xTL&_nc_oc=AdqQJlf4ZKKzLjbeUmDsyIvUsQ05FXdh2kzje7cunut8-KS9ORdy2hw4b6g5K94FCh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwG6BgZIo2uhGY_IZMbP2ahKXMaPxYh-iuP1rjIKkLPdA&oe=69C90BED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usPOfhfoFjwQ7kNvwHtV2e4&_nc_oc=AdqtW5HB5FmXXkjf47bSaxakfi4VJsG3e0fzIVQNPJfdEF-uR6VM-LYH0yMT-_hzOmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5HVEA5EcWNMe75jfCq67yYnF0GIOgrZeln9OSa7_5vw&oe=69C90AE1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF__6L3FmPcQ7kNvwEhDCNu&_nc_oc=AdpFwx1OcJ96yDevX129xtFLJMuqc4QOqn2-3YwkSyvwE-VbmFDrojiF7iCdcW9XbjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKQx5LDcwHeLR-Offcf0qs5VcHrl6M0xW6Sw8ll9MoHg&oe=69C91DB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uCMGj_5s0UQ7kNvwGriz7p&_nc_oc=AdqT8pBopbE3yoK3_s5TbpV94-NLMwCsYYJaGKLDFk__mVBl7znjSWiwiFfiEPhjaO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbU_BCzATjBrutnejARzOBOPhYUXD5wiGnlfxJsGIh7Q&oe=69C91E83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
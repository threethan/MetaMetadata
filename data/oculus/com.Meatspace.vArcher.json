3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxupw-Z-dgIQ7kNvwGlo4Rg&_nc_oc=Adqu7TOKKEq_IO4h43ODvD0fpPubsdEJgLuUx9B1Eoy2E17pjh2PrjwPT0smON9wXlQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV2IIKf4p0AOliJ3CootpH6s2MA5bqfqWorhVKdHgHJg&oe=6A6F5B87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OaspYI_z4gQ7kNvwEjD9cy&_nc_oc=Ado7oqMlw_VhGlNtk2ywk_qMfG216Iza4SgfxN2-Vx84qCEBQPjoK4V0yp3YMWCITC0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKihHWJq5Da9gs79_XCsK0_jfZN5wv7laBSrmUIFgwqg&oe=6A6F28ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8H4EgOjSCcQ7kNvwG76qmp&_nc_oc=AdrYPrAWwHgtP70WGcP6yFScfiFlRff0HvjALebpVfPsTJJi71w0F8Hp6h6ZhczIpfk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHGsGWO3Fbj461WFG8-7TX7imXdWXovqky1hG4kTxlcw&oe=6A6F27E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nig8IeO2jr0Q7kNvwGvfkgH&_nc_oc=AdrCUvrxC4wXQGWhj6aoSjjUnpz4i1_Rz1aaw_mxsXDLrBSESeilagFO4fsmfFnWwCM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzowc2EDWngfPH3bWpj9tKDO8y2zPXkmbh4pG1OOrsDA&oe=6A6F3AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flJlSV7O6xUQ7kNvwHCxY_3&_nc_oc=AdqMy8NjDVcVzAAg7YFZ2Syhy-lEy8uuSN7NyPqAUM7GPFtr3clbaC1MaTrlf53LvrQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmGeqzzU002vSAklGOGHFmZCvAAml_9jlMMsM4TJZ_mQ&oe=6A6F3B83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
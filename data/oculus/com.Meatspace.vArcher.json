3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVWQ0dAg2yEQ7kNvwGMivhS&_nc_oc=AdrL-tucsb4j_4Pwcr5MRneLqratpNxcdmOuC5cL-VKEQk8XeLO-PIYbHgWrtmhCy0E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGePaEtNcWtOE_kYLQWaN2rPV7cOk8JPqvH3prGdvEpjA&oe=6A86DE47"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tngIS3C04D4Q7kNvwGNDudw&_nc_oc=AdrfHm_GJ3PrNIBbyfIT3il7MFJVNkHaUhdPTqScxSmqvOvgSQ20RDuSK0t975zcSDw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF91t0TGmeCTeMK1smm5TJb9tEZUkuL318BOxc19Ei6Aw&oe=6A86E3ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywo5x3gUSkoQ7kNvwGFcMci&_nc_oc=AdoH70LVe4zenXUX9B1aewSaRtBvSIPy4T_nRqG2RY-3d0TRL1F6WI3px2L3QpUJ2GU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuQMqcbsMq9HDFW3vnCmSG01udMoVLMjEdGePErv9PXA&oe=6A86E2E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QSNpW0Rd2cQ7kNvwEiEGJ2&_nc_oc=Ado_ROshFjigAE5eD_jylqWBmO9-pNS6LCP5JGtAJujcZJBgzOkYK5isN3-ozMrctDk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhVwN4SF08stxuGmiULfseOLxbD_VFFENp_hJgws_m9g&oe=6A86F5B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KS06jC0VReQQ7kNvwG81IF3&_nc_oc=AdqBgukB39GhjNnXaC_OPjUm0Z3Jx_n_JMB_51GMnzxCjT2Tr2hBnEeXjHf0LR8Nxqo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcjc3B5wokuJydjWaRv9XZeYpn74WY6LsMjO8cBnwWLw&oe=6A86F683"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
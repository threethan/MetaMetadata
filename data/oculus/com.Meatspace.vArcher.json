3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRs5ensOLw4Q7kNvwGPG16A&_nc_oc=AdrkOZ4ms9YnMV-ReNXy34VRXbSenCMwcmxTzN0PpRLswf-tLUxdyDB466t7qAv8Sr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKkrFr3KfTdAdKuFS6eu4nKqbYXVDW5r8D57tHko8OfA&oe=6A5F8987"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=194tbor2oMYQ7kNvwF5aKKm&_nc_oc=Adre4hQGMJ0DNBkRCOVxSNkreKNujG-EE4ma2JWu2624QQPkjmtP61vtwT1Le2MqCaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4Y3GOwBNuSgVlMgRcXAI6BUMe6Xxwx9jltLSZm0_XGQ&oe=6A5F56ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybWKmeWkCj0Q7kNvwHRUEP7&_nc_oc=Adp0HIxrsoCRbFH1929fv8HT3m-i-nTXDWVVtDZsfalxqjDKQf-ZiT-9XI3U5eZ0CXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy9MQ-R6ZtRFPLpKvjyX_xxVPPuDCuN3HhMJmobqHavg&oe=6A5F55E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPZ2fkc_KEsQ7kNvwEuD97_&_nc_oc=Adrj66IqJ9MOjeiyeP1eiRjiUEgjo0-zUux5rvD5js4GLaF8dtovPqYvyWbW8J08of8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsBEq24wq6x_8YYLYTmwpKOjpwxmBYQ3fQnd_fJbO_6A&oe=6A5F68B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiQpPt36qiwQ7kNvwGc67Mf&_nc_oc=AdpobF4v-PR6ei3OL_qKCqhQa8NPP0-C6VSxiU_4fopgRNtUytlxr27ZRM3HX0oi1tc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAdmKCOW_kPkC2nPxxg2MCKZHaNMs_WWolDPGWDKJuXA&oe=6A5F6983"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
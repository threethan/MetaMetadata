3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiGgVy2rd20Q7kNvwGybB6J&_nc_oc=Adq-fbKl4FLs3sjLc2p9g9QeQ_9z4EHABqwSMa5TjGxZwWQr-zCHrH7rxvyz8O1vtrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UxkSEnF2UVaMre7_r09__LTYpgmqNAJOCtUawhgHB-w&oe=6A2D7087"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAOfYulcCjoQ7kNvwH7q53B&_nc_oc=AdpEwqXlIK1QQeDcpPzWl0IwAaFG7DPApdGA2CBNYlqZ8Xv85BTXfCta0jdHp2WwogQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hqQ3NhV0EuRVDFir6huxUpx6QPfM-dQRf2DLX2D_jRg&oe=6A2D762D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18fmL9eM-AQQ7kNvwH25T_3&_nc_oc=AdorR6lLpw_GTeSe_dBGKqodXLXhvHnJJC-YjVfNXPPRWE2AHcULzn7XDuDI9BViZoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NFTiZqIvtEhdk0c726wdqtZVa0vWVMYluzgVovAPlUw&oe=6A2D7521"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtveufPCvwEQ7kNvwGfQ_uD&_nc_oc=Adryw229wZlu26rn7Kyyv146o6daghF7j30UcVyWTXlQT5Mh11oQarsd1pHdBBtoUes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Dhp9IANz6hBCZSzqW50-WskvgcqJAnmZsiuP6mZaLvg&oe=6A2D4FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wLuofjpgcQQ7kNvwFAmsXA&_nc_oc=AdqOjhv-fyrnXPc-hsxHBAEUNekE6OxPffzDl8YE1p26mv0ZMhT6Ck6l8xiRL2usBZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z3Lqxn0ryN_CQBPvCpHEF8BnhrI-59jFTXE1OKq_Vdw&oe=6A2D5083"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
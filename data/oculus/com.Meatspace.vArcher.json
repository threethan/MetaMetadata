3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gqvV4klOFsQ7kNvwEwu-0p&_nc_oc=AdrSOwFOxbghQOXUaxpNiBkgufd5cZhfKedUmZrBYGxasJWVRVYdVYtC2Io6hhaLtmA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGANvoj4inxaHzTLGQO8qXzq1Dd_-smMEBFf97HlULLPQ&oe=6A916A47"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QKyNnjTDNEQ7kNvwGYKKSe&_nc_oc=Adpe-1c7M2Dr28hM5TPEuMbBtu5Z69jJ1ZBh7PnCgIySO1QapoLMxAEAPEOOrwVGd28&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEIqCTWMGKgxlOF6Icf7TUy1USUuu6aDnfiYyAEvRItA&oe=6A916FED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRQhPRWf_TgQ7kNvwFhZ2wZ&_nc_oc=Adr35iX3BgQWHNdIZ2hJdffLVCrnMGA1mu5wclELm09JrncucCpvMIbhVaww5ymwqDY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF01hhfIsxFO9dY2d2cUd_IgPOIeMPIGL1tGTRVAITMvw&oe=6A916EE1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiA9tSsZZ18Q7kNvwF-4mue&_nc_oc=AdoqidkpzL0Ng4S6J9Ka6ODVrigNtH60a1bR2Bmj9MJbGy0Gc7DZcJXuV1DFFLaNnME&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-8TqKJuJCODB8MTHWVAV-AIYxmoq4naqxz0fkELlfKg&oe=6A9181B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uexc7u47DAIQ7kNvwG0eEQI&_nc_oc=AdrBzLPZrgkmhhzaRM7kBTIXnvjIQXr6qJlIAx9Y1HaTV8dwRRQVcheXMeqRoiUwaFs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKd44KJ1yfZqRPoRltAgNEWOZCMzAe5Rg52lPzKap77Q&oe=6A918283"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
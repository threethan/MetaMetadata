3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygbNHZMmtNgQ7kNvwFYvMS4&_nc_oc=Adr30jV9kfrFGvF0o4_rLMo6MJj3g1pXJHTPoY33N8PQH8-vTTJNUx8QqO_2V8nNEQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68td9LFwxkiVDZx9-4oVuL2EOObn1ZbL72obbSu5G4sA&oe=6A19AA07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXpJYBpRiCMQ7kNvwFwPsEU&_nc_oc=AdriT7_zoU8X-7GsXQX6Ym0puLuCYH59ioCmP9MJWjVugl1uFUAK78yGhSYXCiuiiug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q7xTukhvt_eYk-Qhlu4kfkhcUaHRFRQ6Bs9YLNEG2KA&oe=6A19AFAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gzeva38ZotIQ7kNvwHzxB-y&_nc_oc=AdrfgniuF-Q-oL-43Sjjn1n4edrrKbpZ8mXsygqUA194onMaxC4wnoREvA_E8Jf3_uw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HPRQ5-jr0Rmh7YvQVxXsq36QSijcFTFzkgPGVfDYarg&oe=6A19AEA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GpU-rf0weoQ7kNvwGwENUf&_nc_oc=Adplt_-BGtAH-L2eRiix0Y9f5wdgkB_9fAks8stoGdbFcCUIh05NIEbYJclUyvBHoZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y2yiFF38_Ai2qwmK2D3VspiqcNAmZToYlqch3wVAB9g&oe=6A198938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAydWGJV75cQ7kNvwGA8dJc&_nc_oc=AdqZlO4I3o7CfFIS-mHp8dpsPMJNzaGRzNdGFJDhA_gE5nYwuZ5l9xifB6TPy_rAb5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p3MZWS4czFimPoST9OzleSnJDVMEQgqd5O3GVQHOaGQ&oe=6A198A03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3GhY6EaBGgQ7kNvwHpTvyM&_nc_oc=Adp07Ugym8MLSFGBIPdYddQp060Qq37z0nZjLybb2DQUvmtqbVSjiceIZQu5hKgBmmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XxLIHxwj45scL2MFYMkc4GHWWm_mOkv_K8CLC2IWS5A&oe=6A47CE87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoDkAe05sbYQ7kNvwHDw42v&_nc_oc=Adqf2ilMW8rYfDFWKNHdUuDZVrZu7UdqTsFQIhndig7MYWuH-pgLU5SJII-pBZWMQzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lTWdMR_vwOCCgqpgmgqvMmoKtqmGrVxuBr90TlnJScA&oe=6A47D42D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD1QXySaNdgQ7kNvwFRydWx&_nc_oc=AdozPrLpA79LODJ2XRCS1GI8Eaeel8o4cWs8GsYAHfwIy_7gTX5Z3ek_JRP4VPJP-Uk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G_5L3DFoBFQ_FZD3_BHu_kdamsC5lQS6NhuOZdsQgAA&oe=6A47D321"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0Z8JJWA9cgQ7kNvwGApNdy&_nc_oc=AdpmnICCEPMf3BQ0BvoP14dofc_uOdF5-Vpj8HhXLyE8Ct1jj1od8f__gZ2ott50DQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A94XWYIxeQ17QS26de-XCIDp5oHB3YWkMucUUJTvtMA&oe=6A47ADB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fmW_s2FFrMQ7kNvwGgIy1F&_nc_oc=AdpVbs1vXO6tuIT1naocPm1Yv2NrN7tS566NFYJrR3JLHNyYqhtsLzgrQfVraRL8rlU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MiRT6eni_p4xvPMueZ8x-c2J__F2EnKLHvUTEE3LKxw&oe=6A47AE83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
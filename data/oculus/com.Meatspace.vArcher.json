3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9e6CfGpsq0Q7kNvwHTJXHh&_nc_oc=AdqS0zJwza0uvSyr4mXqzvHLZON02mgA8jcO-Tryo4J41QimeYGv3fmXjawocf_zvoM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy2GvLhElDidvoORxnvjqwZSP1EEvWuJCvwsc0bbWwKQ&oe=69CBA947"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAifUTjPfyYQ7kNvwGUGFwL&_nc_oc=AdoM8cp3ehpI5x7S2E47qNN28_BAfQmNKQlhllaUxSB8WvcqJSg-ixqi5RLkSAZLaGQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afydby4gD_TTwupn9qqehu0tGnw2zAS-9X_G0cVH3eBiXw&oe=69CBAEED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co6VJ-NZkdsQ7kNvwFUMoo_&_nc_oc=AdoBnalFsvvfvz35Ac0GGT0rTgorgaLstSdnBJeTVkRAxHup21yd0hVu8-nw40YOuKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygHo0AJ4DpGLknPhYbED-bHvLNq1OJDtF4JpJFa8I2aQ&oe=69CBADE1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9CuHevG80sQ7kNvwGupn-F&_nc_oc=AdrsbaRFuihVQx7vrDR5mZz9DoaZWzRSjWxWgFi0F6AdtcldivxXUSO0APbBY2TbGg4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydGMfVd4X8oRjaM8_qq_XB6GpDPGUqEIocw6kMiuhb-w&oe=69CBC0B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOCtEQ2oJCUQ7kNvwFdbRpu&_nc_oc=AdoSz6umCP3xlop-LHVfJBi3WhmQ1G9SV8JyhT4ps0LFZ0AnHH-irkmekTZl-pZWdhg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxtk8pfGiTR7hdh9oUgSyZtE9qqLrpTcZ59fyZawJ61ig&oe=69CBC183"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
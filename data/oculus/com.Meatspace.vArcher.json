cGQqwhUzEXYkDzFCShV24h2eJlO_DMQcCHsz__c2OMeXXHhdYTUlPxf5Lt6s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvT5ra4c8SNXoX4W-OOrNcLYvKP8rXLlE9FxgUuWKDsxA&oe=69A56DC7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a4cOQsMisEQ7kNvwEzL78B&_nc_oc=AdkiFwcbm-S80iyDrExVf-cR-STOmaOMotMISELLFfUkDyeFX7Ej8aNfB5f93htBiuM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvqPrabWiksHNFIO0rDShPyQBbL_--_b9KVHEn4JyyPuA&oe=69A5736D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhrZzR2HVfAQ7kNvwGdn8jC&_nc_oc=AdlkEt6Yu1yYpIUXGA6wiieHGBsX-uMFH7LY2QbcN24VNyeBurQ1hJHO8zKE7J3QheM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftwLNzNeIshFEYwKVCAy1Zw1ap2cjB8JZRegV9FvJWulQ&oe=69A57261"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYJtfnkjiLAQ7kNvwFyF7aY&_nc_oc=Adms8IPUWyCzfk9cmImQRrVK-nV4xQTzSZb75SK--aJhqkkW4F-ZpplpgyS5a-HaCqk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuMLvaRi1qfXetdWaVIpuBWCWkiaHRgBRbn6JpcZsmY_A&oe=69A58538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3eM95WQnaQQ7kNvwF1A2tc&_nc_oc=AdkfBxRfT7cGlR-ndRr2J4mP61kP6ldybfgqH0zAF0-Lou3v5Z_e3FeJApUFcUln8BQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuYSwpUn9415j4Q5Al4G1U0d87vEFoztD9suOCtCzTREQ&oe=69A58603"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_website_url": null, "website_url": "https://www.meatspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
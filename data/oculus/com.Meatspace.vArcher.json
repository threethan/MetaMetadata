3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7sXT7zz75YQ7kNvwEe3Dns&_nc_oc=AdqR2DsVmU4oX4uHdGu2X565TJlHpQ4jvU9MlDbKUC9iKuytzV7-Oy_F6WHf3KD5X_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE8REanBIg6yxZfxT84gmRJIpphRrgAUZaFPmfz69nag&oe=6AF5D487"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxFqKrYF9cAQ7kNvwEE9DyL&_nc_oc=AdqB6FBCMMyA-baCTUIC3r_nyQfzOV0girFaUlUCV9GEz1UVukp1a0dvi1sx-Cc_PNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThc5Czn7ixrlUF-72xQ6Kaz_gBRPs2Mp53hWP7Hz_e4Q&oe=6AF5DA2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DvwuHLrlIIQ7kNvwEx2417&_nc_oc=AdpYY8L-UY5_0wPsUJPwse_WI6elazO6aGqOmczShiVlAMTrqUbK7FBA46hkzwQULG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ53VWCm4eN5bQtHGqfU5XofN9uGh0ItthTA6R1mpyG6Q&oe=6AF5D921"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwvAJCqPWU4Q7kNvwEHaHua&_nc_oc=Adr8z406ncKL7JTmNSqN-HEe32ZafXR9F-w2kUzs443OkwyRIjEHe22-Ekv1KO-SXOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnnDTEySM90iZ-XhlXMSlRif9-n6vDl9zrk_BceOegCg&oe=6AF5EBF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqOfYG4GvBIQ7kNvwGb1up8&_nc_oc=AdqABvjHhMlFdhqUhXARemKaP19dpU03CoKFpcExhqOFpJvIr2UH5wdaw7yTMQx8BFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVgCTP1cqwbDvG4iWDTasTlZys_rrwK-OCYb_Hvxg0ig&oe=6AF5ECC3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
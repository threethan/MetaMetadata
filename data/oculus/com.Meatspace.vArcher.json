3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5QyYvabmLcQ7kNvwFhfN_r&_nc_oc=Adq8pPglKyHJ3PNp8K2jsoXUYAgnoEHxnaf6WKqfWhKaArs-JMicizGaDpFxG8yKCqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNYK2Rojh6EjFr2W_5Ag1bzRKt-g1X5fXpEW7_yxsAEQ&oe=6A7B3907"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AacSnS5Lg88Q7kNvwHLWL1_&_nc_oc=AdqsOy3ulGVVnb2El5pZPEjAdMZ9c8LbpIZYDoyyoljqxyt6JjKtk9yNY3UQMVnAyn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGqd4dtDqJ2vlY6gizSBsnXwgD2kPps2OU-W1_UELYag&oe=6A7B066D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTgP_9uX2jQQ7kNvwGE61vp&_nc_oc=AdoPR0N-BQIA5iDzLwu_a89TexC_IIptRBKCcolDBQqiNk0P09HH5Po-0A9D6EsyX3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVINaygdMu28L4EAyPCxIv4SgOHNFFjqaFAsGwI1v-nw&oe=6A7B0561"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OBzOaVpBVQQ7kNvwHcx8PH&_nc_oc=AdoDbptO5a4a9CuEdw5ggCQhyonQN0zPkDV2cbX4mdNGEZKrFuKJ3eAIqwOCoSR3mzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnmgNbU9lQvJTMyEZ_0CcoBzIDskQL46zf0M88BoX4gA&oe=6A7B1838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJm9dm7k-SQQ7kNvwH5O1iA&_nc_oc=AdqYEicJFQZ-n-9jbgcMU1J7YoBGZ3hx5DJ9xB6e2oyMho3TVjDPgoKwdO0DSrBHUY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdWkqdXKpazJ9uLHIdh3nRxnMtzGMJA8WNZSvCSvDNSA&oe=6A7B1903"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
10806_363182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIKwycX_dskQ7kNvwGDMznp&_nc_oc=AdouzYkePnvMMUQBOR6fRKvVNeGfmefjsiTLEqWPFZOj6x0VtklG63loS_Ms24E-iXk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYnFTRftA2d0mbQjgIVkV42z3J7DzM_N2Fh4EmsD3JeA&oe=6AAEA387"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2TcCAHuEMYQ7kNvwF2zoJ6&_nc_oc=AdoDIfJqcgm5DouvYG-LuwonU72SQDaq21Bdy1p8eG6-CL6Af14yxGTVbOAnCsRq4L4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5Epq5meNnbDHg-qdXw8hk0H_t7qPiYTxAu-zA6vRItQ&oe=6AAEA92D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bi24TTCNZ3gQ7kNvwHNV2QX&_nc_oc=AdrV87gtwHIQ2SZ1sVXtM0yr1D09S0ZdHR7MFTk0V3ILmo_QlDteADJVhL-mkh58Tic&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxoMmtXvJKjmNLeUWRQ6Zqu1FwmFrhPT-gJfKWfEqqXQ&oe=6AAEA821"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUV4BX9ReqEQ7kNvwHkTJTn&_nc_oc=Ado9jerZQ-5nwOfKDq_-BiV-p7rm1oHhXWNb2TVO8CYmFtoZYu2Dfc3T2-SQtuZUepQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNEsmCs39RWAr6LDhJuYVAXn64rY-ol8b29ATDkmNOgg&oe=6AAE82B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9ezpTXjLCYQ7kNvwHbAfAw&_nc_oc=AdrDdJ2NZMmRLOq-hIR3U7DHM-YyFnS7fpF_Pi3wSu56JpXvtNgVk3YFHZ8lXoU00lE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWyFgDQ-LOJpTDfDzYaUzXX9tK-QW1Li7z2VYpVBbrSg&oe=6AAE8383"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive"
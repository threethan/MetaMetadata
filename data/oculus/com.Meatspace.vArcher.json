3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W4qhM9nr8UQ7kNvwER-80T&_nc_oc=AdpuJv2yRy9oxZ1BuvDd9NYLNcYiu6n0dMJVdobJIJahbNBKmSYtIH7HoB3WfNAu2l8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi_ZA77Exuai9xzgydi7ILxar_1UBQJ-kwBpyLKPnEYw&oe=6A819847"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeseNZa2PFEQ7kNvwHo_-6u&_nc_oc=AdoZsnunkXtzxHh3YglnDhIw8VhouZCqQc-6_lQ_2PeW50PjFK42UBqMA4AS0Ca3BrU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9P2k26Ej9NK4mmX8oXSr1ODqSGCnibUEm6m1kaPRetg&oe=6A819DED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiOZlOxycUUQ7kNvwHwilqo&_nc_oc=AdqGseor5elwY84SBHVPsiWD57Zm_qL2oWGQplI9sPp3LTs-qRvI8q0q6ZyHjTrZONY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj1mfZObS-DJ1t0CKs7CSaVmzw54I6lZ4yix6Q1j6VvQ&oe=6A819CE1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iien9t6EgWQQ7kNvwG5jBC3&_nc_oc=AdpEOlUabTZvVspHZJ70wx32zC5Q9pnfWw0xYWECZjvdcquJSO6vDaT1xFuFKmLlly8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx7q8gwp3pH4egynZYNJlJmJ_lWMF5j6uD5aAvBgs8OA&oe=6A81AFB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1evcOe4IalsQ7kNvwGc64BS&_nc_oc=AdqBa5hGOCXroBTIrudIKOqfuILGH54zQW877uD9RNxhXLpKw_wnc7Wg36VnbXd_EMM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSBKaAcEkiNSfm_sxePILrDDKbFkQAWzTURq7uyl8Rlw&oe=6A81B083"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
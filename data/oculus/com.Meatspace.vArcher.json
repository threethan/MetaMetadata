3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNb8q1v45doQ7kNvwHO93E2&_nc_oc=AdrLrrL--OlQ40cR0GTIzCTpsazV4t-kpqA-nJ0pooBVwVKhXgk8eAiOm5Uf2aAZoEQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv8_1cidv-whuosa7E9OItbJbUqRsRv-Z7Xd7Ohi2Nyw&oe=6AD38D87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdN-BKevzWAQ7kNvwFWgLgu&_nc_oc=Adou_uAoWdWMdPgVVZ7mrfiv6aWHaeyHvaar5X0dnTqhPNy35c1K5_iDxe02xRbxAHI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnd4Q2xMN1yhEAG6nlDYBkl0FDwrkxV2nwUVBntYPrKg&oe=6AD3932D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOg-46KXZOYQ7kNvwGuTqDP&_nc_oc=AdpjCgvxdtIMbBPmAWftHQACxFaK-JzHVLJ8B-LPeNTTw6qTKh_wVvpw2GcXCFXZwwE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRb5D5z3t5picUULUHJaYTgpXMckdI6SPGVrxGcm0NnQ&oe=6AD39221"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpI7cX0fshgQ7kNvwFnRAbo&_nc_oc=AdrjDW8ZVKCD52bI7Wrbu7qhswGpwLPBe5inbhi8_-q72suPhuN9Jm7H_GmUb6n3aU4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA4T1NY7xKFM0ObCg5BAOzdciOAZIeMabS-4Ot8ihgNw&oe=6AD3A4F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x33bFZy6N6EQ7kNvwFl8lzf&_nc_oc=AdowXthH3qwL73JtXmMdwAA_Q44GkbtZY0e0wdnOm50kFG0KiiG5wQVr58_O4IO95aE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4xszSdg-1v3ENXSvvuXmyEqSX1D8kKv-ULkk9KeJZSQ&oe=6AD3A5C3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
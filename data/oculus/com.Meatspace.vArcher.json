3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyVHKLy6kaQQ7kNvwGNpCol&_nc_oc=Adrv3MughtnRKw5O0Ru32ogObbe_tdZan8rkaVBDrshy9nvgJ3FFs2GsGYG_eP0loT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jJcmy6qj2d5pg3pN7ybuLceBEdYkQ07awfOoGGDUUAQ&oe=69DCCCC7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SixBiIV9ZnoQ7kNvwHt18ph&_nc_oc=AdqiwhgFscDjF8dutEkFQzSLWTDqOs0bkr7VBprCR7J-386Q9SxCCwxsRmjJcoCRrGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wvL6i9da70s2tazIHxKpAvA4FCZN5PNBqf_RoXrw4GQ&oe=69DCD26D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ876ZHZz7sQ7kNvwE6iz2H&_nc_oc=AdpdFnZPX6jmJvShqKacw0pv84dkfqBJmzoLGxIQmvE69TzeSazQgVnbsauVcmLmE_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WoK3Am-OlpVYOCIqOECZiilenLCh7wSFV_GhXQ3FEzQ&oe=69DCD161"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seZudEy70eQQ7kNvwErKI6R&_nc_oc=Ado6uhreIXhSU1OiBCOn5j32Sqp0EeE0f9HITgXkdOP28kPyrlHu6JQjPn4lWBFjAsA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ASPCai3yJK8VIsHwf5SdemAkn05w2ZIXm8I8NGDVZ1A&oe=69DCE438"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUoY2p0ct-oQ7kNvwEr7_2u&_nc_oc=AdqEDo7PH13j9JOyvLlIZlZjoAKCf-eMGpSS_IXRFCgRwB2fjyyxq6jmu9RpPVC1dEo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WTz8z8Xurg5S-pjVbmxF2b3zcnNVqSAvhmZiOosIchA&oe=69DCE503"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
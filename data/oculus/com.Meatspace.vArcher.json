3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ELYcuExESUQ7kNvwGsepg8&_nc_oc=AdpphGyAZgQtvMR8efUI5ntgBXUvAA5OMpfdwXHFGoF96y1Pr1rtbB2qksG_ClGVmb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VxK9VqZRdo_pMSUwoZKm3EP9ExRR0AoW7Nsy4-5Up0g&oe=69DA29C7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SixBiIV9ZnoQ7kNvwGi1qUW&_nc_oc=Adp0HSTRCAhrcKcG6MiVf-15kGTM9wE-0u4bPZasuxW7GbOYD4ZQRqpCjT8eKk1UeC0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DqLVzZNR_d9pnzkNL3PKEVa8mNKSJBMt4UGt2huVKSQ&oe=69DA2F6D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLPcjjZ73moQ7kNvwHP9Lf-&_nc_oc=AdptvFmJyjzxpsEmOSBm2Uz4tchWJ05-l20Ftsfh86vx0-MgDsnKUvcFG4Fl2liddHQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KdVNJSB1KwpeURsRecYcLGZNcQoVvTBALA6oT-qYtWw&oe=69DA2E61"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2skRp3ZMnTkQ7kNvwExRRLf&_nc_oc=AdobQxeY7taYDw775onF6ZWdC-cijs15ZURNN3hxNQhiFbKKVdjFxK6uE_6x2rfBYCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tt5uuyp9XSIst7jefZcTt0Te2bPUgXais03bZ1LKrJw&oe=69DA4138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xedt3ad4EbgQ7kNvwEfsOjd&_nc_oc=Adr__guxXm5pf9jJKS2hdE7wr7RcLplERDZd6XlbJWAkE1TJnISIpILqSSzwD_2del8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vx8S5ItyhOzoZN7BgOqEgTSJ6AXPiNQeQeicyOqyehQ&oe=69DA4203"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
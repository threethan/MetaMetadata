3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7sXT7zz75YQ7kNvwHljRcC&_nc_oc=AdplL_hg7bgkUj_qEmcaGk1si0QrDhvPuaSMWap-T_MZePqoHNB-njmruNBS0OtXVuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUtIgSNrIRLiZRqJgbIuQ0nXidJg_ho-g-tpb9PeDEeA&oe=6AF72607"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqhOKpm4shkQ7kNvwGvspWU&_nc_oc=AdoG8rNeZpjbZdoqkCRCyE1daOdTTE2-96rR2-_9FwcDYfePmJrXS0g33FybIuNWRag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_5vmxdlEEFO8mjkRO2fQDIAXKQ8_rUcVhwkqb06g6Sw&oe=6AF72BAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DvwuHLrlIIQ7kNvwFCf3oO&_nc_oc=AdqBlN7I9WyCldGYM3ezfHjxHTVfWTcZHgi3VRL3lEf0qbPUl2PzOWPslfc1cE2oZiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQsA7rvX-XLfUp1PbiG--dfbcO6xdAopOIR5RKGQbHiw&oe=6AF72AA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwvAJCqPWU4Q7kNvwFszuPh&_nc_oc=AdrhfSNFg0055owFsC9L-mZF4vd_5IdQbynYtji4tFaNatgw9VVWs9HwhwPyprWfRMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFCT_1NdJpVQE5CDMBU6uU9rXdNl9Esf737tw0eu8ncg&oe=6AF73D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqOfYG4GvBIQ7kNvwGppk8r&_nc_oc=Adr4vy-yCftNSI9qeeWyYIFyBngtC1dy5nBJLe10cAFjhz0dUOMpH07wkekYRvn41GQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTddDu32PIGgd693n9niMS2ESG0DWKwI-UlRqHFflGF_w&oe=6AF73E43"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
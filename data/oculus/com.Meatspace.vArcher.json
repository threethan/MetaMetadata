3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROts4XYKDZ8Q7kNvwFb8nvo&_nc_oc=Adqcb4MnfTSBOQ_NlmBWpdaTpBRCCGoL79hOXlU_JZNXvKZv7YndXkMnYW1mxq4Xo-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lxdi2v-3j-aBp7wdQIErirhRU2vNLyiE5BGZWLCwhVA&oe=6A452B87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoDkAe05sbYQ7kNvwFLby9o&_nc_oc=AdrslhxC8oL4rtarQtOhaNC5KuBTVqaD_GGTzqIUCfMby9p9Roh5Tjz9hunPRztzr9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92S-VsQt5QcwGMadk56ttUJVgXQDCQCPAJSb41KU-gCA&oe=6A45312D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eGFi7BEsWEQ7kNvwGfE-Yw&_nc_oc=AdoB3lj17EEi6zur-7V_TcDIoJnWMKPZtVyYJgDmiyfZ1e6DZg5ohFssuOgR2uak6qU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hvHfd40ymr5T-XuzK4OCcT634khzOHpAQ10nVZoqXkQ&oe=6A453021"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJSC7hf7-0oQ7kNvwFWVv9N&_nc_oc=AdoarVTAyo-xLGstTfAPb5628WQU_lygKnPbyklS6087B_SqEzC3BJjUJhXk4EePntI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A_DshaxrogVHX3hSf8O5SlhGUGAtnlCt2wMNyWfc1Vg&oe=6A450AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfSqIxy-l78Q7kNvwHWeCML&_nc_oc=AdrUWD8Kh8ihkurgY4AyQ8GVKN1XqUXOmL1S7yQ82sk38tcFqii_GBq7FSFKoXEr_o0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jhRCvApnGXe22rnVMO4MG0HyBCSBWPIRPvs2kb-nTkg&oe=6A450B83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
=QVkmuFoFp48Q7kNvwHvxUZG&_nc_oc=AdoeLwmeVzQPORj6uqesNaD-GmuYLFI9DVZHEZKbcX2qLSmYHJaemGXOBlO1jYRGtIY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HQ5kfkNDj-IIMqyj9f5xGOYlvmCHxXzppALNyDChkmg&oe=69F1E4C7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlDyKsyNSH8Q7kNvwGRJT-A&_nc_oc=AdpI5xmqlotnAzp_dRP7_e2Y0gNVGWKZVuvXCy7LrBD5kFivAcAgEZ25X2qJarz6Fng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1X3zC7qOME37sSj3_dUifvvHgWavpqGFGnNU50EegsiA&oe=69F1EA6D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04byuRkrmVgQ7kNvwFLFP46&_nc_oc=Adpb_eeTOZNUp-9fFGQkvrS-gFNVWn_IsxPQrkMYkFcGOSsEIyKYdlwqJsm_2lZ-OyY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1r4A99Z53PxHlwj41bIeFKgeapZ7svJWuVmwgLk1_sRA&oe=69F1E961"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-Hq5SzJAXcQ7kNvwEVGvif&_nc_oc=AdqeWJkSkC8E7a2DTfR3WRTfMi0aNkdGdSNCUdIWqNtErHXchYDf9QrfUCouilhdB3s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KcclIr_K-GRK71Mup7maESwj8Ub0kCWGGEakqVV0VmQ&oe=69F1FC38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV8wo2je7DwQ7kNvwFNPukH&_nc_oc=AdpM8SPBZ9-u9Ko5bZoaby99EMhTybtUrMZYIXo3VHe95juwm3Z7yCn-6zM44mh-V14&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zq7m9kMXNZWSUzEfe9XlMOyGspmNfWtd5YRiN8A70jg&oe=69F1FD03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_website_url": null, "website_url": "https://www.meatspacevr.com/", "category": null, "comfort_
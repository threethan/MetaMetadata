02&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1W2OeLzeswQ7kNvwGkT2v8&_nc_oc=AdkM-H8HFHl_5dUzFDvymfm50sk8CbayX_-hEoY3QQ5mLBc0CbJhXud7wp6Rlv8DhmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuGIXd0VwNi0o_FcV7tlbrtkFz4GzG6JxdfbBBk14EzrA&oe=69A810C7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnF63CjAHL4Q7kNvwFkofaV&_nc_oc=AdmFWAywypigScbACQ7T-tdJcQwbMdeMnRNhNw3QSCxmczNCVWsX2uuhmqhwCOAIUKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft-lEhI_HJgYpBj9WHF6w7wWlXdBUPyCsG_KEv5V3qh7g&oe=69A8166D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNoOT0EfX3sQ7kNvwFy72df&_nc_oc=AdnSLXWr8x3ZKxiLJVs4u6Mzp0sXYC8sqJyCCykAMxisMnJ2RpieFwgkiLL9jL07pgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsM--8Wg8M9JWM4P3DDJItvpqUy9gpxnP3TeALBLsRDMg&oe=69A81561"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIFAT-Y7UZMQ7kNvwGxpkIZ&_nc_oc=Adk0NkEsmS-GBULSC5XGf_XVWSgAtW-PKzBAtfrgqsDNBje3CxnE569MA55j4ewP5LU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvRRPVFqN-L7XYgDmI6Qm3DiJQN88NKOQOeAWjM5u1SFA&oe=69A82838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC9VEEyjRPYQ7kNvwFgmRWy&_nc_oc=AdniNkMFx-4nn9D4q7MWtV2P8NXkkqtmne4B8XIWKXuYRUNHeilRAYt_RCzzVD5gg_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvcnX491BebPeL-MRJCj-t4JjMxb9sgtAvVhkJCdlWyeA&oe=69A82903"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_website_url": null, "website_url": "https://www.meatspa
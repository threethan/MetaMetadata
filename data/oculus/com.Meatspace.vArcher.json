3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etmTKYEQ3bMQ7kNvwH1gjBq&_nc_oc=AdqJujaWYQiESgfc3FNuZY2FR-80dyc3EVOCZw86xzM27eL2_lZqz6Kz0gAGuKG_fm4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXVf5qnioLukhK-0t1MvSIojPpbam1-oDYVm5K4kl07A&oe=6AF33187"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxFqKrYF9cAQ7kNvwEuc9o4&_nc_oc=AdoJwgleinH9u1xILpdmrLe9p-MRcMhJhNI2EGlpckWtBi80cugyc63DrqtRjfKMM8A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwqulIKs7N8Oog2w9ACbRLCkm1DU71VC2E5BcGQFV4aA&oe=6AF3372D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGB0zPLn2-cQ7kNvwHsR0TA&_nc_oc=AdpS0kpV21FHx2MevoRf757nWRKmIAmKZ8jrRr2fpz9l_phP0WayezH8hyMdwxRlmag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvR3yJYT7-SyhGqdjuBv_e6pMwhyYBoANuZTG1KFdEew&oe=6AF33621"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvKwCGB6l8oQ7kNvwFB-mlA&_nc_oc=Adrl2iXWcJEq0Iv2d1SSc0tthGcSIGMdeI6owThGY6d0toyccr7mqnc3TKSnQm3bdKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_X8DXiWOz1uMkIw_3rRfOsVuSr_aBrp-F_b7NwLEljw&oe=6AF348F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOg2mY8c1CAQ7kNvwHWeAzQ&_nc_oc=AdqKgSwouEbm1u6B_w2iZfNGKnMZQ4IFI0FrY57y4uE-rbg2T7_lQM27RVh8Ebhj4rY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsvFugXJTK7LaxmFF3Rl9-tdaI75dQumPw2usuxgwlOw&oe=6AF349C3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
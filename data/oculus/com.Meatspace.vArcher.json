3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoLOaym_FMwQ7kNvwG5cGEB&_nc_oc=AdqjtNlrJvrCHSwmreIGyPz4x2teuZnYxlVcvSEZQ2TF2rixZaRaWwjyZv-ANFOYeg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n5c_d-V3YDRjgA1kV0sw0dL9cZzSPTCzhwU5Z8cpztQ&oe=6A0B2987"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaB7tUUhD8oQ7kNvwG6ETQE&_nc_oc=AdqvtnNKJt8LX5o60sm88X1h9qhq_-mt8odwmxfD3WuBPBGvOPKycA9Q99_DFWplo3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P47bjbDQdqs_XjcRuFlZ8fJQjemYRc8nvfda0iNqZjw&oe=6A0B2F2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGwwJwpMHkUQ7kNvwEbfTAp&_nc_oc=AdrbhtCIzTV6TUqyThsIS11D4aqt0kE2fltQmTvBPIUTe1QoOwXAuj2AAJFeXF0t7ak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MniwYfTlAmkpNsa_gawN_g1dZNzN7cm-taFLchUWk7w&oe=6A0B2E21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfmKpCcl2e8Q7kNvwG6nlGh&_nc_oc=Adq6s9rr9IIHnZXIkTMQJVJEolIEhKFKapGOYqPTX_ttI6fSNDKvtkyyiFyO3UNh1r0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yeFcEbi4kguTa1v9MYd9mLnqoAJ4qvqxdfV7TP7lvmg&oe=6A0B08B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEaG8rW4jEgQ7kNvwGeGi7m&_nc_oc=Adoka1bR-5kAIluWzsDlX0Zu5coh0rBuNdK4TP9_HQFa3UCXP2T-GYnSw8zrD1oTiiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CxH6H74QIzEoTPSkj9F816Ms1G7IKB-owtsRdgDkrbg&oe=6A0B0983"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VowkRERKALIQ7kNvwEWq33S&_nc_oc=AdrivfZxTrFU6bu7WxCboJBSAn4LaNVn3x85fA8blxXjHLWAW75Bfkv0gagrdjXFHxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-eisZEw7OiTqcnFoxSz0Y2YEAU0m4UgbhpqXoyN0VlA&oe=6ACE4787"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vWaSKHhCGUQ7kNvwEWHsCx&_nc_oc=AdoNGG-uIYP7ThxamBadRudM-AsuCpip-jmyHXwa-Fg02CVFRR89fO2FCSvMnnroQ38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKqyzLHrD2C14Rk5W36WOW2t3LnQgRKweLE2b2kYhYBA&oe=6ACE4D2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZmTUXyU24wQ7kNvwGXNbmt&_nc_oc=AdojOwRydmnuFJ1Fg6YiZPLj2JluoWqTbihIqO5I3CXe1W6n6GWgbEXXUR7R5pI2xGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8lu-NEFAtGsWh1C-g5-AGeZUrILdiwFGUuU3rt8DpDQ&oe=6ACE4C21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVhjH-TKH-oQ7kNvwExYZiW&_nc_oc=AdpFo5BEpxxW7M_AuZetYBe7n0Qs8trK-PRZ3anCliny4WBqdeiRPhdBhBrWylL3PtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPILJE4gogHrMh4lI2DYr13HlfNkNXEATzVHoMmkfnrWA&oe=6ACE5EF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL-9FthylyIQ7kNvwHqLhnc&_nc_oc=AdrZlsWHfSs590q_laZQ8_Y0TV3RuK6d__ESjeYjigtTTTUk2WD1sTBVhuSL22Yc7Sc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPetMRjKGbcZy7v4fo7y94RcgeRV0TA_qAak_UTqo3jVw&oe=6ACE5FC3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
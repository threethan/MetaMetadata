3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyBAC6Es8TkQ7kNvwH9ByRQ&_nc_oc=AdrVpDu-ncxaLsBOxARd627vXqTZGmMcLoLh-tARfx1cz93kbOM34mmar44XICyayso&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OovKitv1XlN4VLpq3wsrkQciY5PafSQvNmla12SeSAg&oe=6A106F87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItF2MRiepyUQ7kNvwHd42da&_nc_oc=AdqtpqxmZ11ypmKAiq59A4cxe05eRfWGswOZGPLP7ddpzmNWO1vrSHdfj8eQ4h0yLBM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47La5G6Fgnx_0oNwNseVSC1yUETkpRDctpe2AH7Twt8A&oe=6A10752D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZeRt33S7gIQ7kNvwHAND38&_nc_oc=Adp3DoawSp9gXXkvtdaoCxJZXNWeXlQJrpdDWz1R25Yyb6SonmwK8nNdU4J0KYBrSUc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qUeW5ZbSYYG0G5-KbBd2p-1f5Vsc6Km4mpGAjUrIo9g&oe=6A107421"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1jb0XW3yJcQ7kNvwEW-BG2&_nc_oc=AdqcxXnZ9_H_Q4cLbOxHSJlmOfXtspdqm42SiXNPYSHJBi6UImOex8nXnnHScNoRb70&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SvEpzP5-0xAZdky2A5DpCI9HTuu7t6zJY-BDjaidvQQ&oe=6A104EB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWqQPSYoGaoQ7kNvwHZTtXm&_nc_oc=AdrWBkC9xMmvsMD3e2korLrsTuCufvdu9Qilbzpi68unAxsMtUGnt59tWmIqZa_0PPU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54M67tifm8GsEsgvcq7btyZYBWXW7Q3KuKW7JZosIQbQ&oe=6A104F83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
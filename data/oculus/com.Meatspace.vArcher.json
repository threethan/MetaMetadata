-1B8OHHa6gDktg&oe=6A2AE0A5"}, {"file_name": "Indoor_Screenshot.png", "id": "1030121742277473", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396573_1030121745610806_363182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VMfNvNXvJMQ7kNvwFejwfW&_nc_oc=AdpWZT_4Aa7M36WdYA4w-0OsAynfRmmqAsXSmiQSrEtoZvMLS1DxUYg-P8cQCaQozeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N-K57i1chqszV7c5EbYAW7LJzsWTdyyJUvZ3q7qmVWw&oe=6A2ACD87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNNQinawo-IQ7kNvwHTuFQC&_nc_oc=AdpuQ6KyZ7iPCGiTBVxWMMjop9KbwFQsoDmLgmpp69Y8TUZVSomiRX5l0kZRO8tXQa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Kf89WXh_PvYlOHuxQ6eqELVn9HJ0mYriLGPZ6Op9v9w&oe=6A2AD32D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18fmL9eM-AQQ7kNvwGaYvdk&_nc_oc=Ado5w4fx0movwcvtn2nwd1XjrVN8zcGRfAVYTkllpTW87DFL9UJ0E5HcM_-Wjtd6e0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wod7ZoF1b-tXc4fMzF6svX4ZygyyB-9AfOw-Yjy8BEQ&oe=6A2AD221"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtveufPCvwEQ7kNvwE_fSm9&_nc_oc=AdryViPTTpZA-hfWLh60qoyskoJ0LEZTze-oXSnHFnuxgKTEZY_J5I7UQTTxxjupA0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1EGBZRQB1m3bxk7Tja--X7Vsvr57jm1VU87H7hIRsnw&oe=6A2AACB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_website_url": null, "website_url": "https://www.meatspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27765422860
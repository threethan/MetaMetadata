3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCmYctb1yYgQ7kNvwHBA_4G&_nc_oc=AdqmjVWB-nIBy3b_19qfuMSoGldjjYSl16hd_mUJZEV6Ab2iAqWfKzokSqsQQw2tqvQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_dlsRRTt6jzGHni6B_37iNBKvxRI2eNoT89cFrrJVmg&oe=69FB5787"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoK_3z-kWXkQ7kNvwFKDH2L&_nc_oc=AdrszlIIrdHZ1KytWp6uO6SPkNH1XEUQ4-cm1LRtilrcG9eYaPDviQh6fzOadAWqICU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UX9Y6HT9lJg7bwS-_2rn2dD3D2lW1i3TuCaFJp5Iowg&oe=69FB5D2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJdZZK8qDpcQ7kNvwGTTG1Y&_nc_oc=AdpqaSVig6BUr3Rpf8ZOHpBhHhk84qXxBAmx_G-USCfVDdf8KIG9QiZUq7lFF0TvZV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pWOngaRvyfYRfiOpf93kTt0eVIldAzGQG729_eO-9cQ&oe=69FB5C21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFRFE6zzX7EQ7kNvwHZaxof&_nc_oc=AdobaB9tRKQsrRwJ89k_clxUZJSaUSLOvl8jHWCNC_LpB3_Q070cIxLAGakLycUgId8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cnV_O-aLwRH_oUR25vA55osChKn1nFsK0uIzG8-JJ0g&oe=69FB36B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5BDIM4b7_UQ7kNvwE3c3XE&_nc_oc=AdqI5YeExbDbBbBmq51_bGpMkzBGC7z9giZUAewcPxpHFgx1ac4U9bNp4EFRqQwVCCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RnWldDvdx_QYs0FyPIeqx00jUfEWUWfE5pnFKhXorww&oe=69FB3783"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
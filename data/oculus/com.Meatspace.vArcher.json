3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jm37Jc--oVcQ7kNvwGKa0JJ&_nc_oc=Adq84AqwuJ0nUk0IVBnw7FOCxeolYd20EiUuafdTzV7LP3Jk3XoCPEkvdUExoWMSgB8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNFWiJ2HNpfaMKsSwGEHf5bscVWTsMlP6_2Q_4Egk5-w&oe=6A92BBC7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QKyNnjTDNEQ7kNvwHYQMUg&_nc_oc=AdpC-zVINgjt-dksEj0zS99Eum6oNyeJ6AKgrgO7h_zZ94uletQ7LQQVaGIU27G5qBM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG27zCle0wDdKhOpnE2FXNGUGQeuHZN9A3gWbNbBmbreg&oe=6A92C16D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRQhPRWf_TgQ7kNvwEASDkM&_nc_oc=AdohKAePWdQAMqHf-Jdklea1U-syJiM-7EV0R-uWlxe9ga93P1Cf_NWKpQVAktgGy8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg6YGijOW5Q6bawYsRIRVAANNLwR5WIE_x8-1HtF7cbg&oe=6A92C061"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiA9tSsZZ18Q7kNvwFSwojh&_nc_oc=Ador3K5bV5eo5cgfr8K9fI1fOtw2I7eUzjVuBwlBJOt17uyBxwtIMbRP_5omKapN76Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmG6rDqiDbR53345kSL_vWmpTb6qr74fEygXafTIZfDA&oe=6A92D338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uexc7u47DAIQ7kNvwGVaB-R&_nc_oc=Adq_jgFNgvX_cQXCddTRbnhSJYc0m3cO3aRJbxOPtyDspgpXdock8H6w2-nOSPBZoy4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuAIG3LQYif66GISKmEaKBmsMFy1da1tT1SwoMtgugBg&oe=6A92D403"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIlwQSQCyEEQ7kNvwFoT_L5&_nc_oc=AdoRUQh6LDBlBIiXNDFXBZPMn-CEpclikDe47pdgTHvC0uH3c-x5y2QpI5XbWo6Lv8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYFbSDdcn1yuYzC0f8gYFuhdVfaU0jVHN4w3y9o4Ztig&oe=6AE75407"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRgBnyMWCt8Q7kNvwEKk_xv&_nc_oc=Adqi_BIH5x_lOHbiq8sYioU3Tnbz-kdaYFnyPoIwVLlrJVZZ9k0ce43z-wFSpiUvMHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWXIWEMK2pAm5x-LIQa5p6zw3ucn7amwKQ3iID5ebsMA&oe=6AE759AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQCEgY5j_74Q7kNvwG2Ww5-&_nc_oc=AdpmCQwFCmgdHrqsnY3YqJJDXswuYnaWVeODvnQU7eLds8Z5ATjib6eY3Tzb2NaDf58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Z-DLsHg4awkT7idR2poi5yBT0InPqCpcZklqW5jKow&oe=6AE758A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag9x77M3h98Q7kNvwGcTLV-&_nc_oc=AdoDu0RPdMAssemAYAlpNrqtHsP4sOEZsphNCkO9p9Tk0wmygP-Du8oKkYjdjcQJJrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbq3YjYbJCJB0-tm3zlslHAYY3GrynXR4b2FvePL8p_Q&oe=6AE76B78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCFrU1yvUDwQ7kNvwGx-och&_nc_oc=AdpjQnGT0CWawgJTXcSJp1OkQ3n4C141xX1kMbW7DtNum5TXTFcX98MgJc8keJAY9ew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG-ivnBKP8q6e9zHURUrioVic8SiNUzUB07jZUmlRmjQ&oe=6AE76C43"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
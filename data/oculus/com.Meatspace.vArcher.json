3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaSo0z7n3NYQ7kNvwHF1IaI&_nc_oc=Adq6HrBoSQ3ifq_jWz3FeMBOzHI9U4YcMiTImf_k8cbOxthfBX9TY0ojO_aWcgguwDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiRuDE_6DRBZ89k0C6K7OpHAUVcna2X7AVetMvqjV2XQ&oe=6A5B9507"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6I6vLT1o-QQ7kNvwG6Thao&_nc_oc=AdqGQOWmFlRzR-C6lWqAHxsDMZrK2hTeLOJSum54nCYZOiTrkVQN2aaYi6mDphKP4Jg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5CnTmnmXHVeivwYAUBVlA4ysn-q1g2H7Eq0E5Q-EelQ&oe=6A5B626D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMbAe5GghO4Q7kNvwHrK48w&_nc_oc=AdrwAXNQVog0f9zIKeCNUAO1kf7LwxYit6nLDFb6BZg0g9AWcP-wEfnCqcTn91MHtbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTMyX1jpwbdf0PagCEJKwRYxWpl4YQq5h8rebEaGHLng&oe=6A5B6161"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJl9PW895IsQ7kNvwH5b-l0&_nc_oc=AdrwOVLWTwNMGYnh7aGrnwVhcKfXLdNW-EA0iC2d4NUJEASSC9OycY3N9joZ1BbKZt4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc0RM0_G0nhWAurXU5xCgkpC7_XDBnobLu_gYPAZPRlw&oe=6A5B7438"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7HjBrhinqIQ7kNvwHbebxp&_nc_oc=Adr1eItGPjJ-0JOWL5x7d1FF-qFu8saZRnTx3L3a5qIjF98yFqxwe8LydGTi-LkuK50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7PND1bG0wXS5Y3yWqb_Z2D_oKyd-xFl1uyVp8vLefeA&oe=6A5B7503"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
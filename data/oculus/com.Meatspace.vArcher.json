3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyVHKLy6kaQQ7kNvwHxnvFz&_nc_oc=AdqlxqZtz7Tpkwmmu3Bmh_VKMTY0g_qg4L1amCOV--urj201o8VDK-u3wAgRwQ1zIYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-XuKS1bG3gqq5DThPkxd5uJccXSpX6oKkk9mC8CKZYQ&oe=69DF6FC7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyaj4cwDHCwQ7kNvwGZ0mg5&_nc_oc=Adq5JsEvjUD82ypXH2NjvGFMKdWFza5ePiDx3QgbXBCH1XCZupkZJUr09J1iVqsm-GI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eqy4iaHRw09rx9Nibosh5g2AB0_qvqwXMTff2kHHtpg&oe=69DF756D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llpTycABKDYQ7kNvwFSko2V&_nc_oc=AdqihmoCylW5QUoAQkhenTMKzj2s-AGl9HQNQbT7Qj6XBPVr2drKq7lZgKnK1p5w6PU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K9M3mtNZ_5nT2k0NhX9lEHwFwTVKwjATQyNgMrH1htw&oe=69DF7461"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrR9xkHWJc0Q7kNvwFypfvj&_nc_oc=AdriCbc6JQOyhN2GOZ0dO8RKXpuSWFzqZh_IR_5C5S7sfiE9LC2NhyhDElQlllXL2Y0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3juQkyhkltmBdId4TDIJ3wDUvK9rvF5Jhf1u2lmk_32Q&oe=69DF8738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZqtpjNShQUQ7kNvwHaI8Oo&_nc_oc=Adr-ESF5uE1oUM5_rYcxah4SGQalqWliENYqAwGWtsWlPrEF2ErUWvt5ICX2apStg-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PosG7F5XJ4JEhRXqPzijcjbE7A-flbh65sCeoN7PeGw&oe=69DF8803"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
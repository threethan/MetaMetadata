3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1TtNHinKqkQ7kNvwFxUxd9&_nc_oc=AdrZClWIeMJ8z_4bkp0kHVHySbU88-RSDJch6gsXAsflm1eBzPhDnpjcP3Wfl0blhN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfn8HwL6xs9sJJ-Pk4uSSl8aqb6qnHUCp5h05lPu7qlA&oe=6AEF3D07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RKqrc4Q9AcQ7kNvwG-yMsJ&_nc_oc=AdobL3sfH6vWSMu8W_4sAW_0-NPn8q4_9KyEpqHVVh-7Hkb0cvr5zHAnJYgmFxnr_Qo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjJ3pWW2jFcF3Ioh3ZZzxTc9KnHN72IOcDuXqhqLwyIQ&oe=6AEF42AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NXwA2t1O2IQ7kNvwEGGkcT&_nc_oc=AdqTFpLZ3G2c1ovtytppIRQrQgQs0PP31m-rj8DMto6V112fIgQwk8XxG4mK25kgU-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiy4gIDvWGsjKCHOnwkAkSyZ18sSXklCdGo9dUPQazog&oe=6AEF41A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xw8JaVKwrIQ7kNvwH5Z-UV&_nc_oc=Adof5xr272-E-nWqZds_AVorwKgeCaWYAlE-vLOKlgDrUVwIDR7PheYqKkHnDsPkftc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDkEI7XuL6KWlTI9PVuPhnqKoj9cNTyxAqPUml1pH5QA&oe=6AEF5478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8QfAZV2yrMQ7kNvwG6yoUK&_nc_oc=AdpQDKEsXTVEyFo1laUFSKf22qAFmTNYjOvZvA-kH-45ys5HOa6NF_ko8Z8Jp0w6wmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQItzk3S5nBj9PWgYJ164XEbeNvJM0Mkj1iDSidCDKxcQ&oe=6AEF5543"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m3fRlXTjHkQ7kNvwHelfbf&_nc_oc=AdrPRw5WFNYM7ejLJApm9FsUAvt4Vbj4TUKokMZtXkOp4jYsDjycIeyw4PZyOJBlPBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsFg_kmJvyvnzLcaSgtcJOgHWImfjSfCGwEEq6-NNTqw&oe=6ABA8107"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR5pU2aIARgQ7kNvwEl_sdM&_nc_oc=AdrWLd3xsaFi74elk1k2jlX_QkgYkzzY8E55wQBDDtTnZqQ_OU9Zf4P-V7uogXSrV0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn3PxTz4eyoHZxlLgCtdZgu420eUd7uCkoF7FHjL6Q9A&oe=6ABA86AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdtbheWAlN4Q7kNvwHCx9S1&_nc_oc=AdrY-6Wt3vDW-lwNywDCW3LvLWRjtgvJowRHfZmAk-krI4aCjVbJpUkfezmLxs7ACJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmYGgVlCL_ZprpciwUOPDDfzWJTG-LY9IDjeamvcc5zg&oe=6ABA85A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e604Q64OA-cQ7kNvwHS-DLr&_nc_oc=AdroYvMKi5iREiYHMOdoRTpHex_Tqh9ADXeOG3XqgbjjhzOifoBByV0Bk6Mue8YbbY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ729mILdhNZjV29Ps0tti_NNsbbwEqhb4UNrTsg0TN5w&oe=6ABA6038"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFSORGGKVlkQ7kNvwGw3MFh&_nc_oc=AdqmaXd4-9ISmIqSGgr0qJHbEBur1UgSQ7nht_OMp56JKvfCP-dcYl2OXSq7AAvFk-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvbkvmXbhPtUe5I3DscwnXDjZO_rAvujprw76ZV8IhIQ&oe=6ABA6103"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
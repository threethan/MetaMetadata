3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqQ1tjRsXw8Q7kNvwH5keIF&_nc_oc=Adq4emOIaFQ8HI-OVTbBOomgAAwQ94Fhki3nDiDv8XaRSW9ob93f0JGQjmUFoj1zV4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFfr4b8lvOrvBTRtzAQlOtJQ4co0AOLPIwNtdqNJBawA&oe=6AC3BB87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ho_aTNHVFo4Q7kNvwEU3cqV&_nc_oc=Adrqa9JERviVEMcIK5ZDYKfDpKZWQDcfmxcXLBV6aY3G3QqIUmKwkKRRGzxyE82bQfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMn0Aut0dGEdGanwjZfRo35u_IMHtdfjY2sWPZHZeEkQ&oe=6AC3C12D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL6lZ7rG_IQQ7kNvwEE3O1O&_nc_oc=Adq0ZAk5V5zjQFsNiyGq9SiJ8kQZ6W6WrGFmcLe-GRFkqG-IuYSOzFAOBD5RSRbhG0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUxZCvFTUI6570J1OBM_EM-6HCvzdXrdjqgs9EFkgvlg&oe=6AC3C021"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpabYzlAn_YQ7kNvwFG0Uw3&_nc_oc=AdoNf9iwpcU0YHVsO0TThgkTfPsFfQangbEaLUm61McXQEeU6RDr2chv3VyB3XLnCUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGvbFeu8S-_FVdreLur2lTFtCdssPNzsNIFhlJrjagKg&oe=6AC3D2F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BOKTBJmYpkQ7kNvwHzdgZv&_nc_oc=Adqv-ljHh5CKrsiwEVG5Wi8hxCM2VZ23xovm-Aw9ZdPXLLPYnQWgYQVA4gD5j_vksYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX9ThAN9ieitpNUeNtm93Hf54R2E1s1nwQPPud0rgkSw&oe=6AC3D3C3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
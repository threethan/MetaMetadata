3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNb8q1v45doQ7kNvwE3zU1b&_nc_oc=Ado6I9e81ipj_9thfSNj8DJ6WFTgli2BnJOWj7LejClUflRf6ujWyFCl8snlBJC5dR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdyFCMvbpS2XZ3NDOb0N8kffggumxvpgPHEdUW3QG-Fg&oe=6AD23C07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt1vgvS9pDUQ7kNvwGYShed&_nc_oc=AdrHU8lSii1J-0xW-1woD6arpQhrD5PbCAPteYcgXyv_2D64bBbm_Xyw8MZ2Ufx_szw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwxv4UPhYb__WEzgijqygvxjMbFGVTY4MqFrjaMB3xzg&oe=6AD241AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOg-46KXZOYQ7kNvwGIriOV&_nc_oc=AdrkU1ULBVpe_yonlmzgUUfrE6LAf3olRbN1YAvwDxZKUHiSrCClYU2VJXtuRO7Ygnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-zl-KcEhaQeyab5mOakVp6F87JBcEuX9U_22fREU_Nw&oe=6AD240A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpI7cX0fshgQ7kNvwHGh81E&_nc_oc=AdrmuIhqUhQ2g-ajYI2plclFbAD7pLUqKHnyMbag352ynH42rNVbxDzY26s6eBqSBQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIoSdq_OeAr_cLFZ4S4zTYvyvhPXp_cFq6l_1A6Dy_sQ&oe=6AD25378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x33bFZy6N6EQ7kNvwGOEO4N&_nc_oc=Adrj4j_prRI_6MZHSpbKvYoqnxBaULbQIWQvFgzcAmWegIJfQCkNqwinCHqKNeawl_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQB6meg0hJkuFGEvNWdQnL9hqBpybEqJWcKyQ8ykd2QA&oe=6AD25443"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
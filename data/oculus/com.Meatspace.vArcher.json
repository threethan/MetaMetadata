3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLeSP90gvvIQ7kNvwG4Y8Mp&_nc_oc=AdpsrCxSo4OOXHkxM_U0RmuBjspyFw627Ykp-pPyQjmJRE-qGRga-G-d88x0h-iXIKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5LZTyeppppFTlJNR7cLJVHhDajICRDwct_hJF_5eMZg&oe=6AA2C607"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWSY8hfptlYQ7kNvwGh-CZc&_nc_oc=Adrk5c4-ALQ1NLWDAKAJ4lLOVeI1bR6akYoOp4QpoKY44qBQZhf4mweXBMooqOeM6x8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2dAaJcb4nBDSyj7QhQlXlSesoFVIojaGxJJXKWup43g&oe=6AA2CBAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUk7PJou5OsQ7kNvwFuhuyf&_nc_oc=Adq11dFWIX7YoWXfXEVOx3yDx-uvaexe6WHzB4A6vDKEK28Fu1RQyOSYj8izK3ylhFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZhWe5YQKUkO6GJ4dILkVHEB_2Wn3CIagryMB0BEcrFA&oe=6AA2CAA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ov2nUAVPM60Q7kNvwEX0lrR&_nc_oc=Adq68dPdMIft3n0FvwGKV7R8TqS81tHPXXR6uxewraWXH2Ghp6qQ1q0dM2tBZVztsQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIACIrJZUBFnNjKu86qFQCcMKTT-PTU4-sVA6H9t-t8JQ&oe=6AA2A538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnuSiXtPh-YQ7kNvwE2j0pC&_nc_oc=AdqaqJX27sHEe2hu7BJcCJU2aaj9qHtZDp1_5z1P0hvbEtuF04VLd6VFcJIRBl50uBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIqLI6lXfTjcHQLaiBfjDI3HTAuggRfGg4YXcwHUo4yA&oe=6AA2A603"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
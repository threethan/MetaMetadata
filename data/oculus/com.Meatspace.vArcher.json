3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hhUhEvt-JgQ7kNvwG9yNNU&_nc_oc=AdrCpC7ojWv1LRuscgK4HpEdFo8FROidH9Mc2lnJTqZXUXtQA4rbAhE5OS4ihXIaI50&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz93K19nK-T31lZTkw6QIAJJ6b42BsQ6f76WXfO0rmpSQ&oe=69C511C7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y23B5dC00xUQ7kNvwHkv50T&_nc_oc=Adqih3ri0nRZBMG26Bw4RApD0ukIn2n57nFRJwDusUwiQcyCdXbLJQEmQ2l3OvRAwQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7mTg1F6FGtSkr18UQxSUpaEB5C5wPO-8j5FW4wvfrEg&oe=69C5176D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVsu3iqM1N4Q7kNvwGCknll&_nc_oc=AdrumUpJZDno-rFTgPjV_omTs2o1JU9ow8_xIwQrygyq4oF8MAlntVPgmaLcQoBJmrc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCcOQFK7g-3RYvQD-LhGnk5A-LPKlGKF8tTWCJJzS9IQ&oe=69C51661"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHLhSqRM4LQQ7kNvwGxGHBs&_nc_oc=AdoW6Kwms3IdffyMbBdwTYRcI6jpj5Vyqb-QtJzOF2xXSXyGcaKnkazJFT9y8vpL2K0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4a0wmFZeQv5e6fg6WkBJDnLILb9n3CDvoU_rGVZ0U5g&oe=69C52938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEUStxsn1qMQ7kNvwFk0wM1&_nc_oc=AdrufFkXlapKVjmSK6SYiSN28XBOItwKsBCql0tiK4hdPTyah9LWcTQ0QZv8PGt2FSc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7jjP60eb67k_RHdcOpGZYpl5fLnVe1bRKfP29M0zEJg&oe=69C52A03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
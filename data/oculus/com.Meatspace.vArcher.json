3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgFXMkeXPAAQ7kNvwG7f4n5&_nc_oc=AdpNk-UmeMAhq0NL3zNUSqk6LHTrj6tqbt4JGoBZ9MxFSncQDYlJEG-g6haf0VoXK7Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGJfXoCROIqxV2jrWabYswUJI3CHQMps4v_Z2Jed68jg&oe=6AA17487"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWSY8hfptlYQ7kNvwFfh2en&_nc_oc=AdrbcWmI08n-ZsEp8HJtibzpeblPb3X57jywIoIX_tsqMorUUJDm6IRmq_uxCGtEpX8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNunv930zw8VeQynTM_f_nsEdJJTDvg0Eub_sI42-EcQ&oe=6AA17A2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUk7PJou5OsQ7kNvwFohLzJ&_nc_oc=Adq5GITbfmmELGr-o50bdj67mJuRnzKTx87HqXN0CHJ2R3iZbVTlGt8bDOFklUwCLts&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGSiTCEgA2M5vZ1fs4td5NqzUIgVffp7wXMDK5lZZ_Pg&oe=6AA17921"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ov2nUAVPM60Q7kNvwEJaMuC&_nc_oc=AdrvqT77cdi8rpqaRp0ZyoaI3FJMrki-Oypg_jcMPPeYeuYhcb9GqLedVuw33JVQ4AA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdyjhlK6Tptbiay7ulhqSkR59o2jR5aUlpkt2oyGpN_Q&oe=6AA153B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnuSiXtPh-YQ7kNvwGvz9Vb&_nc_oc=Adr756eKYhIVpqw6OF8E7wOEugqejHxlmJOG7fAKWBjs7jpF1EX5B1I-H86lQE66FJ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIVZoWV26QD0xMCdA9n13LhvCiJCrMdEDG-7R39h20-Q&oe=6AA15483"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
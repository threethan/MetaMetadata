3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VowkRERKALIQ7kNvwFGiXny&_nc_oc=AdrYVr4uhDweYJCnbVGXk_QIYwm9s06TdG45fVmhGcw4M_v4WOI-4hWK104yRrcJjwk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG9wHLuRI-SnQg5iuE-x-hFc__udaBMInEyrvI_v7Rew&oe=6AD0EA87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt1vgvS9pDUQ7kNvwEGWxwY&_nc_oc=Adprpe9Sw2kYn36gUckd4u2Nqv9usLO4zdLBnNeJAiuMBpPsAOLR6U-dERUyCXlLkws&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCZo9Ns_bUI4UItMpwrPFkSyVDiS0NpDDaNcYNwGCX1A&oe=6AD0F02D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOg-46KXZOYQ7kNvwEcRupg&_nc_oc=AdroKLqZWDaK8PBXo0f3fjCVcIEzidf_USjiPi7omSNW467NiPgcMBRmTy0Dm0udabg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrHyRRjbg8N6WS9fDGZXt78v3HAHAhEI-4ECsKFnfM0w&oe=6AD0EF21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpI7cX0fshgQ7kNvwGOg57N&_nc_oc=Adod85j7SSGOUCjZCrAYmWiaiQ_ZcRYTzAmNZeKSgPFAGeyj2X_cUGkeMmVeVaZtsck&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN03Cbswz2qAQu8keSYFzxfM36fgxOamvMgVMYBWwQJBw&oe=6AD101F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x33bFZy6N6EQ7kNvwFoC14N&_nc_oc=AdqAfej3sTntVVCx9mq6HrBAMyBOWDlA5xJn_h58oe9ZUvjJfmC79VU6YpzhZAnYto4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCj62k7fuVB__BiMPpyX7ZwA1f11KqhjKYn7Mp0IMK0g&oe=6AD102C3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLm1JmLXjWMQ7kNvwG1ePQ7&_nc_oc=AdrKuCBSS6R_VCFn5Nd4TRtV2tvwoL3Mgl_3i9QzVREuMhJwd9aGr9cEXSk2AqZts8s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzgV6RwRr-RKd-3VSkv8x1x4OZ-axCxMS3sGenp17HaA&oe=6A53AC07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEe1F-7VVFgQ7kNvwHUUaaJ&_nc_oc=AdqUglW-NfEK4YjxN44gGPqWofoXrHXkZtKycKsokVEqyfydDfWiEuFb_SD2AXVbW90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXsbWcDxTqLCskgJCWuZYl3fctNnpDawjU8HHtQencig&oe=6A53796D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8gxj8hB9ygQ7kNvwHItaaq&_nc_oc=Adpz44Pd1zGfkGZXBRVdJhB1aYYIz6cux4OuT2keP7gK8LxAPWMmQexaHxx15zfQsGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClmkLpnhxS9l3bqajX2LwVAS7Zz1jDFss-gSVAC_y3Zw&oe=6A53B0A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulD5N7H2VNAQ7kNvwGDAx9i&_nc_oc=Adp8XPD_T8asoHAjjQFKxd-pMQRJCrqw3fYjNR-dcBuBMs3rWCKbn14pF-0gv9cwR14&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxbfdA2pj6IMhYdRr41QXgaHdU_g9YBo2HJOex2qvvog&oe=6A538B38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zobm4b1bzMQ7kNvwGlJWBU&_nc_oc=AdoVhN-KDxdRnIW1hjjBxyPXk0c-yOpzniGviXRcCLs78OWjNr-jUpo3V0jvEhk-WqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTvbrHkl2waERPkon2HVMLr9Zmpov9bDiWL9Zwq42hQg&oe=6A538C03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
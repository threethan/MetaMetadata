3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhTxwFIlr9kQ7kNvwFy3QrC&_nc_oc=Adr8E_2VDemCoUAbdmUTF9nS0vqj2lhZ4g53sP0lU37qlKfycThB8sNU7hc7bY1LnRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbm1qI7nyj5Om2IFAs5S1pnkAJNm1l75BsAefl88p-2Q&oe=6AB92F87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR5pU2aIARgQ7kNvwHk4f0D&_nc_oc=AdpnhqDqUUEDjJvWIvUTP2vhpb1rICguJijflQc4q0txah-qv886bIkCsGJ2OQd7TjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7XvWsmcJvBrjCt3dlKesCkP4GEPQNQT_hVEsXRLv_iw&oe=6AB9352D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdtbheWAlN4Q7kNvwFGjP5I&_nc_oc=AdrGA2v8iSvzYW7FDhDgfOCX4bBa7sipTc7QY4MkbJcVNeMhV8j3NietxJLQoFfFevk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCe1-q-WNnZxd5BDWEz_gWye2OUVe6QUYh5fkXJdV60A&oe=6AB93421"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e604Q64OA-cQ7kNvwHfdTUu&_nc_oc=AdroiuiTYj7vHJW_6QXTQ8Aj7pBl3RigTQcl5OsC5s4F30mxh-nON71uQ1WTQ12kMPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaIbE7ad80zpDICxxVY8EYuohupWHChEQcFtBlw87Gfg&oe=6AB90EB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFSORGGKVlkQ7kNvwH4rs-2&_nc_oc=Adqh0B4K7oiL73RQIZ1nQx4BfpW2ZCBz3Sa7f7xKqKKMVrzeYEDKD5_G4rDD_Alx-Tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5DzUVX_9att8R2F5tmgvV-LDbsBeYoNUiXxQOK52cgA&oe=6AB90F83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
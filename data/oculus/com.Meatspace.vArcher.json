3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPqPclx4EgEQ7kNvwGGJK5F&_nc_oc=AdqLG4e-xgjz5IVQA1dYTb6nyyjfwCd0yaPCGYXnmjjCWd5K4lFaYOwyS3eA0s8DLSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jAZIE6stJMQhQos-eDyChhnCOLZC6NWyw_O2qGLWa1Q&oe=69ECD707"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMjZidmIg9AQ7kNvwGYVJzM&_nc_oc=AdrdgqTp3nztdyaWs5kN0PS2LffYxGF8t0Oy91yLgYpeOhC5UBZsYI0rPxceOefn8Gs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33kLL6LjX3otzjLfERV78LA6xXn_Q5XKL5qCo1szoDLA&oe=69ECA46D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs2PWJ5zuhEQ7kNvwHGzru5&_nc_oc=AdpJgKxG4lUsDa7VPjXc7FpIlrq2LWts3jcAP-dE0Q0FaVn9QINlgFQHA84BX7sKl94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xEfCim5UEIkdxEkAXg_JvsvW3szWrHqAUfv-oeqfwFA&oe=69ECA361"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_q7yPFTx14Q7kNvwHeiLKU&_nc_oc=AdoGPfEcv9YJc8TknAUlXnZOXtXYV1qcoVw8FOO3DW5CPiJ4QgqiKD6__HK7MSkaoCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o1VkVh65_QzzU57Sf18tdO5VlLH_glxddDMb8AibrBA&oe=69ECB638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnrrOUu5sDAQ7kNvwGjvo_L&_nc_oc=AdoDLTPkeZukEIfUxiaxGg_yv8exQeXJ4lG7p4rnDcMucyux1-XDvlKPzssFPqAV63k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p-LIhhPbnTxke2B2RK1aDlOaZcFnPMnZb6w-_zJYe4g&oe=69ECB703"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPqPclx4EgEQ7kNvwH3v3gb&_nc_oc=AdrDd07tTgogFxmrHgQcJlfq2eZWS4Q-AUKsyBOxdlqZPWygLl806VzrvWWBGsFUxHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vum1MdlLdtbUaoZeDqs72oBUnH8USfAH_BfTQXXnk9Q&oe=69EE2887"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18WNW3OPzBcQ7kNvwHoyPBJ&_nc_oc=AdqothJRI3PsEhsvzMMr0RFscHLFl4cQEz6pD3eyXCmGJkPrEGRbCu8ZTPHOaer3D3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ec2yn9NGTe919VgY-iQ5KnQ1F_6kPHezr_ftiwHzucQ&oe=69EDF5ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs2PWJ5zuhEQ7kNvwFT5XMH&_nc_oc=AdpYDCj8CCvIV3bWKUtc9Ue5j7hOkibLtpaNl0oMQ-azzoLCUstxhwT_YJGMi8SKULY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tB6DUFnSb-qp24ot0mIaQ51e1TBx5zpa0gNOA1BZS8Q&oe=69EDF4E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_q7yPFTx14Q7kNvwEKr-tw&_nc_oc=AdrzYiEwY0EGztZ7r69uo8ieyzM5CxJFCDTYjMoiA7fWPWe1zSBjY9BU0PeVj4MJZ9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hqDgk_cxEJ1YgNqXXTo-rjYxjEw9bh3mZM0DJiOjtEg&oe=69EE07B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnrrOUu5sDAQ7kNvwGMcuxT&_nc_oc=AdquV3g8ONORY5RX6HoJksxtmUMH8HAyBUaSgYYa7N-Cn0sRlPAZ97qYQYFlS3LH4hA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gtcWGDRzaSudfC9oS1GMIdFvMSI9kn56yTxtbwS7PUw&oe=69EE0883"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
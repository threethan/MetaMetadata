10806_363182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD_6gSYYPtsQ7kNvwGR2bkb&_nc_oc=AdoB2o80wfS79qVxitXTiZoXhtJPE8XpVWsGhVxZoKlJMwjBhmHKJTTzK43AHs6z5JI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs3VpB2cARRxKlixlnSKmIgNPbYtJbOTUGM4jbKeLIDQ&oe=6AA95D87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7urH0zQMZBAQ7kNvwFz-4gn&_nc_oc=AdqOGFoZaai1s9Ay_XlOfWVMpnXpue0SpboIuNz-oIpKD5LqbJLfbrfSaTUaVoJntUE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEisf-sqX73xKdWixvZtUXLJ9ucgbz6-k7Ek1PO6Qqow&oe=6AA9632D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E83vlNcLW-AQ7kNvwEVbr52&_nc_oc=AdrPYSxgOj4skql1uBtxgTuRKl4grqdAuf9hYHSEb3pgAIu0tYP0yLMAlrhgJWYdkw8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpn6D__7UL4fdllefS0DiU4pGMts7_RfkrnjdEjNI90w&oe=6AA96221"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6M2pkb__pKAQ7kNvwEWKQtT&_nc_oc=AdoRTrLGFuLWhx8zAYZ1mTquZbayClVXtR2hQdKeqruKgd6KA1S10V8VlzMvAI3tGqM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh5OgCQZ32bEQonpdByYr5R5FX1pHgULPoiC7WcPuwaQ&oe=6AA93CB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9dhatDyfm0Q7kNvwE6Eu8x&_nc_oc=Adr77Lh7VWrq13m2xRDpvNWOj-dVyA45kBYnB2hphfGk7us1F_LtGIWmLlR9CIaQ6Iw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIXg67hnfQ9n3wBSZdvJj0IIb9skj8J6dO8-xFmh_RvA&oe=6AA93D83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive"
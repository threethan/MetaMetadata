3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQF2wTEzFf4Q7kNvwFLjgJR&_nc_oc=Adq30S7rdZhaqKQAKPJPOXYSM-c6AMDIFyTQN8xD9RKcu7PaEuDrzUXpG55mOBW8il8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUhOwGJH_kCsApqF2UmNIAYeajBloGQyIjEtxLSQkLQA&oe=6AEC9A07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4etvFML1TIEQ7kNvwFH-A-Q&_nc_oc=AdqiSELFby57t_pLCWYNdRzcbDjJ5y3IFvUfk0oJDACBOn7mwWCEHxMw_JgjcqgCi_M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT6o8WMrtqGR8oGV_L62DyhP3wmN_gL_mBheagr3xZZQ&oe=6AEC9FAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NXwA2t1O2IQ7kNvwETFO-h&_nc_oc=Ado18B_KfGoEuNHAjAXIOmFUuet1NtQ7jhkmlT77d7X78nw_zVhoTRCy8MGjrN8Z68o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4gn0z2ulawz2PeATRQmoCBGvrlzsBIQDUZ4HfQm5Tqg&oe=6AEC9EA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xw8JaVKwrIQ7kNvwFNsytc&_nc_oc=AdqUy0M2mn6MGIqPwdXTE7qL6eojeKIbjS8WfhDJWAK-Y-OlNP1mIuivlGd2z0ic0LE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfa8T3rQ-t0ieiGgkcWhSP2xlAfbiprxMq-iy4No0qzg&oe=6AECB178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8QfAZV2yrMQ7kNvwFN98N6&_nc_oc=AdrkmyHloR0PCAGipwFah8up_OIKYP4FqSUPNJJnpbymF_nFP50bttk3GDfA3ewdbTQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnVsqMUq4Wf-dSM2bm00ItssAl30fG5Y2HqdlwX-cN6A&oe=6AECB243"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
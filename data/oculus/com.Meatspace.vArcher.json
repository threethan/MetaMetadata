3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiGgVy2rd20Q7kNvwEfrJAG&_nc_oc=Adq6MtOwbe2EOLkctHT1YFrUy7EO1Kgu1xZZCODSgMUM-FHbBZoClDM9uVrOqQU6IHE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i4mUQBL0-fgiKI-NHagAmJN0pt9qCMnoOG6tDVCslPQ&oe=6A2C1F07"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNNQinawo-IQ7kNvwFwQzm_&_nc_oc=AdpVWkVg_5rpnjRN08ZmDTkRv2kLnsb3gF4bVoX50CO_EIUMIBMEDCcvacKVD8X-Us8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ihix_8d4xqFbnAEoWjseCXfpUZmWrQj7rWUPcGd2JNQ&oe=6A2C24AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18fmL9eM-AQQ7kNvwEkEFGg&_nc_oc=Adp6QDlP8SSypcf73wZN4-k6YQJpS3XtG21fw3nPMBt6IE69ChP5EVB8wRqrMOroK40&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xfcB6CabL-_dXRbZUgSl988GDgXZ_LmcBC8XlkVMcjQ&oe=6A2C23A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtveufPCvwEQ7kNvwG9XA2h&_nc_oc=AdomlO0kCkR4FOhOWx_DMgsUA1jb-kdKpB_QhidYtPTx7EaHumXc2a34Fh2BBSVuHFg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dm5SGOgxBWe7tARN9EWeUte8eQ4i_RNC8Yy4kv41sZQ&oe=6A2BFE38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wLuofjpgcQQ7kNvwHbiHGo&_nc_oc=AdriqJLFg0AfTC5XMILeKQtdnrQIKoKAL8oM3FpTTT01f0rO62I6WlTM8BnX_PvGKsQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RpKQHO-tJqIBIFRqixTwz-TvEREYAYLXXHVK1ttVIJA&oe=6A2BFF03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygbNHZMmtNgQ7kNvwEuVmsx&_nc_oc=AdpSz8at4wc8EK8p2nNI4R1yLWIyInL93l_K9bO-mFKVsTBweRCDhZFcm1S6PUo-9Zc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af796wvBv2mHatVefukrpS3sUugcw798KetB339-Ea3V4A&oe=6A1AFB87"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXpJYBpRiCMQ7kNvwHV1y82&_nc_oc=AdoaanRjHBinV676cUFioMcl8soEXMzttWezInQaiw0s2gUzY44yGs-u0BZFVKR_gCE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bCxDEuMxfAstWKatJtkx-awoe6Kz_sqXOK85aA1UKrA&oe=6A1B012D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCdJKk1zWQgQ7kNvwFiK6-j&_nc_oc=Adr9eQLEoQS08YfZ7AghHYsownGwFDw4yKoBD8VUXkLxr6sfjRORk0lNnK-pqf1c9vU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HlhvhN0y9oWRmnZjXGm-5QKUmNPGxc2yR5VCgiTm9KQ&oe=6A1B0021"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQtZtFtuNKMQ7kNvwGSfsvN&_nc_oc=Adr1dSDpZLGNfTTr_NZRcpVieYLxJeoVvBA27ocNMFvuWb_lKFjvIsM-K9GwXjEdsjE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J63PR1qUPGGpgdMfnx0CVZ2X1s1u8Vj10zrPJgiKzUw&oe=6A1ADAB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYhUkqazh_4Q7kNvwHF9j8K&_nc_oc=AdqbafNvMOEKo-PgRoDXI3xUX2XRfOZWY1_qeGJBjhFkJiO54_5KTg1dGF6DA9qXh2I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Xl2GLtbrzHlXWm03oixRebj5r8feAODkCIhJEZy6EPA&oe=6A1ADB83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
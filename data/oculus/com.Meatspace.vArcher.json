3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw7y5yo8nkMQ7kNvwF9-836&_nc_oc=AdrBykBB-Aee3BVbRAbFc4ZVQK80m8EoETSm6flaFPmIwn0Zdg_zScVeFJUq73h70XE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R6gScqklzrhj57j7kLCADMwFyM4I24aHeHuMXrsY6UA&oe=6A301387"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAOfYulcCjoQ7kNvwEwG7A0&_nc_oc=Ado3SWdRlZ1OlcDonCFRpJRBZcSSQPGDgM0qCbmyK17Dd6SPNI_gVkAE6_kQ6EUQobA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HtWgIh05eSjYeLzcqTl0j6l-6wi89kjjZDB-KnxJ8Gw&oe=6A30192D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1UVkA6-u6EQ7kNvwHwjXH0&_nc_oc=AdrrslEQ3PVB7LSMEyTsZ7-4xsCVWpVIJKBTRPjcLC7I8p1LZKy9Yc7ek8qVAa5CM9Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uENPVjpEV_kkin75U2oNfUnrlHe4jFh5OmAsGQJG6qw&oe=6A301821"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_Tl7bYYHT8Q7kNvwGtx3y1&_nc_oc=AdrHynQ_x4P_SvvxeZtBRAZOSZQu_pK1-E41exWqjqWp0grvT85mrbnbXhNWwUs_Vq8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SCqQ_Vtvxp8ok7dEZQTK1LKKseXoOYc3a5acsC_JluQ&oe=6A2FF2B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4g9GiiG6GAQ7kNvwG7Kf2D&_nc_oc=Adri5fdIUM_DS4wxGbqbfH2K_IhtbJjLwWlC3RYJR3KU_nb9rhiuAdEqvXy4Jhbtt54&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YbpvwxxvZp02fcyuoLJ-_zwmlLvLGtYh1gNf-kHC8CA&oe=6A2FF383"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
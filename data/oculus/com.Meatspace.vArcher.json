3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7sXT7zz75YQ7kNvwHGO-Nx&_nc_oc=Adq6WtBepINrHNIdP0bSCP5nYk_SufYKRFyk52efpsgah0e3Vo9METVdb6Gs2jZ18s8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgut5EY2zqWu2V_jvnOQeUsRN6KMbe8NmZBfVl5wH8WA&oe=6AF87787"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqhOKpm4shkQ7kNvwGDKPEI&_nc_oc=Adq8n3tIGjP-uA1vJmtCltk8i1dRhQYuEOmhhe46BfN7Wewc3KcvDLYZzNP0FsV3BoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7KV0SYvNNMmNNmvGWZKT0yCL5Z1Pf6J3wt-sIZ1IalA&oe=6AF87D2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFfTeHhCQNkQ7kNvwH9tp9l&_nc_oc=AdreBacRlLaUwNTpCiyHjrm8y5ACMxQA7TQ3HxJsmLOZWIjOf2uhfTf9CaSrPd4hGGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTULIbp0oqcrL3usNfbxs90FNgggwtU6tXtosB3S8fl6A&oe=6AF87C21"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr06JwXVrBMQ7kNvwFB-tOr&_nc_oc=Ado2XmMm8xVm6djMtSqCv3H18z3YxuKMNC1dvcKXWaQdvnF7Ynd2fsjtbrYPZHzIc44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRusIwmtd5nhkQ7h21Thhq6LNxWpePbYzFOqGqzsJYVTw&oe=6AF88EF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpMl57YZbNcQ7kNvwH89_sB&_nc_oc=Adq6j8kl8GBIhDh0w7gMzFOZNeZ7k0C43gTYCplz2Loj7vqCOT5JvviOObx5Zwf8gZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfFdbYa9eLdedSkxDr1kh_3JyRcIABZH1kK0ftpwb65Q&oe=6AF88FC3"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWp_20_leZoQ7kNvwGp1TAf&_nc_oc=AdqkIYbLCA7u3bSUMTxlshBUSH5J55ayP4mR7fueO1S9wIASUM_tkHMwQP8tQieJPMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38HIpnYumbtV40UML1owGSFNWAv2ClhcEv5vqeiavlIQ&oe=69E36447"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7nIj--2aJkQ7kNvwGwuP-S&_nc_oc=AdrbvK2cviTBxsEmTg7NkOCjFa7Smu8UYmlL1ricPN9wi70WZdrr6Xu04iZuB2L6cyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af302pQd7LmYt6F4XAkYrfw-87FSiCrBzqBvL6Z3rbN-DQ&oe=69E369ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvjRJEjvzQEQ7kNvwFR6ZB6&_nc_oc=Adpl3-KfIzs8mPiD2HcijuTo-IsF_6Db3uE4Al0uNyA_n9ooVs7Sv6QwCujnnhWtHjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fGGcL0YD81AywZ_Sx_TNq9SoK0q77tZ-l-C0Xrqemag&oe=69E368E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHmru4Zcvb8Q7kNvwGzQPoW&_nc_oc=Adom0eQe_P5v4Bhi4UqhG-I_ehhetoa5Pyb280gtiegGCCPmfTHmUpxJ2h9C_HcKP_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s5XngrdQF0lNCQgEn25nC9uNxo_AkPSVQVDHOnPrBMA&oe=69E37BB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7b0G_WAL3UQ7kNvwHv_Miq&_nc_oc=AdqOArhchZWqgpj1qDgviCCqiaN6sRZpZQCoU0T45EhLvrJCe20XfjZi6TK2vzUQhC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PpYi73xTSYgOZoTUY3efhZWKAZ31zwn7R62XiIbd-xA&oe=69E37C83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCmYctb1yYgQ7kNvwEVAPVe&_nc_oc=Ado8ZhBlxpjSKwjR5DVLK28YWSNM8JYvx9WmR3Ea5xe5WIkZf8AhMtrR6G7xvRPvcdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ccaz626jlpiLESgLn89R44SDmaWQ1g6H0vbSVboEZ3w&oe=69F8B487"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXHSVBUi1XoQ7kNvwF3-ImT&_nc_oc=AdpBKmtPveSu4r1j6Pb7LMBSsngjVkrWoUpPBnEDqOsmSd5PaSUBkslQ4dViFovJ2lE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lTlabyiRcsEchKf3IsMbtDoHaH2vtRLK1Pzbc4h1CUg&oe=69F8BA2D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOAAnGjVxNwQ7kNvwEE7Z9b&_nc_oc=AdrQO0A6dn0AFPdYnrNQ0hn6V-JWYTlbRcjjbkSImfdCLN0xVXM3O6cBljK_5-b0WzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nZmCMi5ofAG4_MbvTG2ZYeCo0l5Xp7P61mqH6-dLWog&oe=69F8B921"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_rMTsY3UhMQ7kNvwHhcCHi&_nc_oc=Ado_AFURvvG76GVioMezkalllGvt_qIvGJoNXxPp7PXiD3crScaW8L3LGfdr6OIm7mU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LJ0R6iIljHBg0vPx1d9AXgWpXOY2esdIejfB0gcxlkw&oe=69F893B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAJ1gwXfblIQ7kNvwFoWsh5&_nc_oc=Adr5tiWmECmXNCQVmlz3AQFqlD4DOVksnsbwV_X9n-Iorx5gf94jhNDlCMrselC_L9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1R5OoGh9lbPa5jWXDHkqVrl1h7wvEAN_g8pSSbFN4rGg&oe=69F89483"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
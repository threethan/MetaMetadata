3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmXA6rqY1nEQ7kNvwEPmZNM&_nc_oc=AdqN5hj-nZgZOWiaUJr4Hsl8qvHndVYAK_0RVp_SvNW51hLhdGEMj3uB3fPmO-Z0L1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7IPKOcpXB91HDvq-KnFd741_J-Dd4Qrhzk4LlDMkQCA&oe=6A57A087"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVI8CWr2yx4Q7kNvwF17Ho7&_nc_oc=AdoXCgQna5123HLRfeMaFiaw5CSOmvKjtYquJc0KYFnSB-bDE4rdXLTO0w3aApRPGfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgGKBHHdRzJXFszrCuRBJxt8vdQMHJqaiR0ESpzFjxiQ&oe=6A576DED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4vjmQpKAw0Q7kNvwG_0B7s&_nc_oc=Ado-tUHTEZpauM6YP_xqC6v8cE0qwWko4ldCH62inccozZNtH_XfmTmX_-kdOnPZehg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6uofXuw3WdXSKgLbkKawp_j7VHmikaVhAONiwoYR4Bg&oe=6A576CE1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m_XaYillXMQ7kNvwHBO_6u&_nc_oc=AdrKvMkLUxY9hR5IvtZhu-bRE-hII6Bu8NK2Oalx2RnHiyNqmSNMjFcj9b68CEHBU2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbik9GYvoEQqezECyxZVJWdGqn7iEvMhoMp5yONUczXg&oe=6A577FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRjYNCqX_IIQ7kNvwE91oPZ&_nc_oc=Adq8j_tjxNc_GwhZrv0HBcyvgzJZkWOSAVCxkF0owiLjSzqUBorNJo2MB-7CIBSGC4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvj6x1h6Fhg70Z0j06CNQVbW_fqjrjn87C1wiK1gMKbw&oe=6A578083"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcTr90PfdPoQ7kNvwG1Qdkb&_nc_oc=AdrK7s6wk1DASXsD4Tv7K6gQWGCfk4p3IkSFAiXTnwZk_6NBJRlIjhe2pL5X0bzMTYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAumJTD4BzpGnoQwP3EaDb6TQt2utIn_hjVNe0dtjy9w&oe=6A9D8007"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEXnSDIea1YQ7kNvwH5LHfD&_nc_oc=AdrzsiL_qHIVqLo9_BdVID9a7pKFUymGhxKsj4H1XvJK7Ms1RKQNq6xVXnwrxrRM-1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyltkU1PdhQxfI3VYWTFMQ7tz7G6s3rkk8KrhrzT9Prg&oe=6A9D85AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I6_h1paIswQ7kNvwE1hDAB&_nc_oc=AdpWsOBtJ8dQJatQRLsD99dfOpvXphlaHYmIQM57PqkjSK63vaOm0AtTIzSYliGLhx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_iaj1WaHHNdpnbhx60h-w7F8pdsPSfjsQJVaDsGakEw&oe=6A9D84A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d-Mdb9IM64Q7kNvwGLXJra&_nc_oc=AdrUXgrccgrQ-qHOLV2G9Zqkjj_k07qyuSLbrlbYQcj6-Q49Otqf10Unm2gpgX4tgYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIspoX6pr38p1AeOJxaFBLcmFaJcWa9DT1kb_09nrswKg&oe=6A9D5F38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZlYEovyg0UQ7kNvwGuYF8D&_nc_oc=AdpJ7ePbXwIa0OtyF-8NqtzPKfoqBpZf0uKKD74TLxIxOf3EdCh95Y1dkgYrtZJuuJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuu3GhHmO--k28u3TfoFFiePVQh3LoMVvubUqeln2z_g&oe=6A9D6003"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
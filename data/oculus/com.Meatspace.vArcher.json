3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjX5H8KKcNUQ7kNvwEWLqzx&_nc_oc=AdrBMzZUTD0vNaPpumA-hlzHNiwOmPY4DRjl6O6tON_FmTN9B2jCsxiXb1XTnAdCN7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGigveYXjSYBiSXrp3knIIyMj1S-vNfHsNkdNp_cwj4Xg&oe=6A843B47"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tngIS3C04D4Q7kNvwFxeUa-&_nc_oc=AdpGRl1pHOE6zthDB1BpGiEwNY7YUUldkIDB61SdmikE9xIX7DRr8gNFsvYVObA_vLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwsblpqhrDvzpTxKRW8hLSmsiH0yax46jAFkUiVHHrYQ&oe=6A8440ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiOZlOxycUUQ7kNvwEWZ8CV&_nc_oc=AdpDW9lIagYI65Frqs8I0u_8-5ZZtC1XzATRDZnDPCc8BetVpZc76C32DpNoL4syE1I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeLASo6aTpOsthoUR1VSlWhbQ92OM8XkyEM0-Cn-2xJQ&oe=6A843FE1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iien9t6EgWQQ7kNvwHUAh7u&_nc_oc=AdrHohhguEMRNoGz-UyOMEtIiF3mZrtaxTraU8GNCnhHLdfkSVD1Yk8_QEfdJ8v5jOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaup-kNQMiabRaH4lDeOiMnVxUMkHYx0Z0itGWuUuOYg&oe=6A8452B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1evcOe4IalsQ7kNvwHZgQcv&_nc_oc=AdqBwNg3dQ6U_6famR7Jxg2diLbg8SdmMl4xF-NnQHH9oy7iLdL4rl-Ki1MTqA0GLpE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNG9XZDC9hNM-P4V1Y3v37JXuWmEw7boVeA7sZFDNYgA&oe=6A845383"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
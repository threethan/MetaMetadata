3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kopMe8eZzKMQ7kNvwEktQdu&_nc_oc=AdqClj1IV9DNtzooEqWJWtX23locrqhcCPYDdeetP6kGH02enTeZpjcBWZIqdLLvjWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32g9Lm2UEtXHKnGnK5FTRR5wVb4SP42vE1ftlUVStuRw&oe=69EA3407"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMjZidmIg9AQ7kNvwHS3vr1&_nc_oc=Adpzs29BqSRRiQkrz4hiM7rQhZmyeAK3f33_kh8C_Gat4awPUx_7vGFrcWf77-lKbWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af187dSIYUdUyvuqWO9YbGcmbLgtDuZwmuNsngPSfHLuXg&oe=69EA39AD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pS-7c5fTC-wQ7kNvwEvRUBM&_nc_oc=Adp05gMAFnLTkJeIApJ2keIVXtrSuBpTXRyouN65ZMHl4r8LbvAafYo6nrYAAdYb61g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_AtryozmOQUL_Q4C2JmBlqmp2otgaB7Mo8Z5fWUwMvQ&oe=69EA38A1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhSC0Is0T3EQ7kNvwF6vBEK&_nc_oc=AdrBu6yccbl4SyvRjWcXH-vEN1f20h9PCjo7FM9tLDhMmlmO01n4kBL65dF7eD6VlCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZZHq6pTwXixfKYdZ3ctBnBOnLCuO6kILNeZKhEr0-jA&oe=69EA1338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7J6ItAvdWuwQ7kNvwE7MHL-&_nc_oc=AdrJnCoqGU94abSP1chrETAERmgO7N1qycx59yDNDp2yXLx3fDe4v4SsFN6nZNHMDmQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1prUIamMNWKFc3cZUmEkrTU6bJ4pH41ynVGFglOz9B2Q&oe=69EA1403"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
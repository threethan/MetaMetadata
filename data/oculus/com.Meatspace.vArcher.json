3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYdKOVHKd9sQ7kNvwHuubCP&_nc_oc=Adq2NRFNVvED4wuP8P-C9jcOVr3nHRBsMOU5GP4eeN4ZAi6z3HwoXrlhQ_PhUZIP8d0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aOa3TNQCxnuLCmvQ8duv-Ll8sWT6cTteGNkMkCLRAhA&oe=6A170707"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYC3XRbDuJUQ7kNvwEWHjx0&_nc_oc=AdoEFm-G3B_5uPBqd9LilDLu1cM2fgXdOis1W5e6A1-RjVH8VGZKP-8j-26eI8Ym9wA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wh7jjymoTT_xA66WiSLIw4iJn4h5aztn4csb1egAK3Q&oe=6A170CAD"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gzeva38ZotIQ7kNvwEECpiS&_nc_oc=AdoGyVvRl4l6pNZL8DRzEiviwUTVknrjxdABohJocHEN-6UW4z7AQgZX0TxYjQBeAQI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WymxmwkdSPr7kziV9HGaaQfAeGDNxmpO6ksd-HZEk8A&oe=6A170BA1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GpU-rf0weoQ7kNvwHPeUjT&_nc_oc=AdoYOReVc9Bel7f-0LcWQLUEC5nklFjheiBppVejqRB3NFJ9qSXbqPlRIA5AlXZuyKc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72u_XcYXML3WrcFSRnNPas1a2wVq7wYKWtE3a00nXnVg&oe=6A16E638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAydWGJV75cQ7kNvwFb9F6x&_nc_oc=AdrYEmYmEz_eI24zWbk03G3gEGvtornqg7Aq7TwJPnVsqgDvEs2X3ylE96Puxs4D5J4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ID3V5fveVUgaslDZiWrtdu6xJqPOYM3ljDmxLPRlu3A&oe=6A16E703"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
02&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwRvnUIkNcEQ7kNvwGl3OR4&_nc_oc=AdkXS4IT5hg3XlWEgyNOucYO7trmamMkkiw--t_cj9j_qwscMOTAq9kTyKqlGxMiK-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv2xZQknz4vyHMPfynruDkrYG4dCZuIzgQTUEXNyWklPw&oe=69A96247"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnF63CjAHL4Q7kNvwGvZbA1&_nc_oc=AdnbKPCtOnyF7afOTLR9yN57OOtZAMksiFbKZSp-G90rS2t3XS2jCJu3yH8_JUxIN0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsV-sxfoy4vZg4nhs5BuLxbCs9MmbHnmFm54dmCnHNk4g&oe=69A967ED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNoOT0EfX3sQ7kNvwEz8uQ1&_nc_oc=AdmEx3Nf3jI9TwfRQnRD4qeNcSoqcC4YDKr7jBsr6x9McWNLoTYLi8VAIye3fNJKOoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvlrjbeM7Q7zyZ96x9_81pL2yrh08JuEGtczUguFsl8xg&oe=69A966E1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIFAT-Y7UZMQ7kNvwFeywxK&_nc_oc=Adk-gSZljW-i-NjdtFR4lTo5-nPYLK8MVB8VDV932NwywCjRcgCkoheLOTl2oMcYmyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfttugEOGpaVaARu5cmY5CWJH90M3rAHkICXu2ABiKR2RA&oe=69A979B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HC9VEEyjRPYQ7kNvwF4qAlS&_nc_oc=AdmEOtqiqKHB2986pNMYU9jlyRebXtc__SAM1NvQag2IjrFLutHfW4GBvZ0XOxEHd1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuHWPAcluhpziisZObSTY3obKot51I0amBHH7xUpjK4zA&oe=69A97A83"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_website_url": null, "website_url": "https://www.meatspa
3182968852538317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxupw-Z-dgIQ7kNvwFQt7HK&_nc_oc=AdpFtumNDJq-cpFnQwKcZ2tTNcR8iPYLAn4e3tvExHDFt7DgKvAQ-FBdo1hF5DBZrkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvjkQxz668z7UqO6IvJMV-FwJyCxK8esyMvNorO5CJCA&oe=6A7074C7"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woi2SZzpTgcQ7kNvwGWghmZ&_nc_oc=AdrjyMZaos1rv5fY3cXo8ynDYi1VMqUeb7e1fq5fdo1lYhSF9kvwnv7fZrASMSD4gDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtdyoWiUTz1znH-YzEbJqXQSJ1wXPSg-g6EGwBv4TUpA&oe=6A707A6D"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8H4EgOjSCcQ7kNvwGPLs28&_nc_oc=AdoI4Ke1KbTka_3twZbkgZE2bCSQ2bRxhXmAiQVb4fnNUcWMv0xU7Xc-pJxbJJkcfvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJrIKw8XC-7o3pKtRiyU6QAtxMFAVnch7uW5kJTfrGVQ&oe=6A707961"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nig8IeO2jr0Q7kNvwFDkiJ0&_nc_oc=AdpnRnEWHUTJ1U6GER_ZcK9bfwwNxgO6-_g8wDCmd5yFKNQrpYuTfBCGt9-fR3PaoqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0ofqUGiNgUhi9PH8nyHvpT6vphIVl3tj0HkAyFEOUSA&oe=6A708C38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flJlSV7O6xUQ7kNvwGvqcu_&_nc_oc=Ado3es6VFSShnIyv3UwA8H-XuRQ36OpQKy-mvRgpNd7Umorb8jzjx-wa10e4mZXTNjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPHyzBoXiNMcSyllBkhKUQd-Dr86P_lRUaqz_7aN-Htw&oe=6A708D03"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_web
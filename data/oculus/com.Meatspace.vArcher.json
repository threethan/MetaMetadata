02&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQbqTenljIIQ7kNvwEzPzf2&_nc_oc=AdkqaAHYhu1F_LTWmWzf85GpzsoP7lnl9flGRXkMhS8fw7NW7mekeIB1a-OI9-5P4ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7Ymdb_asvun0I_ztRvnADYlHmLm0_RCsvssNNccDrqg&oe=69BE7A47"}, {"file_name": "Crossbow_ScreenShot.png", "id": "2397984983893950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391978_2397984990560616_3969625957978599437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uzODKe01JcQ7kNvwHxCt_z&_nc_oc=AdlDxJtxcWvLI8VBIQ-lSX5ahVrEp39i1p7jAkeYT-gLiD6zsAg9EeHmVS3hBZz2VDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYItt8fq_RKIqyHqn8OGv_QcI3vEy0YtP8fqqSvK9oAA&oe=69BE7FED"}, {"file_name": "Olympic_ScreenShot.png", "id": "648582874300164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_648582880966830_2648986520125630881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deFzpS6aXUMQ7kNvwF12LdZ&_nc_oc=AdmR98j-nFy3GoIrpfBp7H_9p23UWIx8QvI_O7pPtBzL-3cB9mgMmKDZPYIlQoBSKjE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzD_CkYAr5ptqYZ2IQ8q8VCRRkJHUU2LAZw8_Q_bYl6MQ&oe=69BE7EE1"}, {"file_name": "BallonPop_Screenshot.png", "id": "2053609291789381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391967_2053609295122714_5342321999149614343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AQjSmu4buoQ7kNvwH8pPt6&_nc_oc=Adnlj1SiA4cepJcwe2AfoRrkwmhR-3d8CZFndVnPs--TYYLTNZfL2OGabjpG03_-n1g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0GE-HpU6qErkIV6-o1Hq1qdJ2j28RvkXT_bCCEM1dcg&oe=69BE91B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLogo_Landscape.png", "id": "616531301220959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_616531307887625_1642505082054004162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQcd_HNeRLMQ7kNvwFiMgYG&_nc_oc=Adm5t301WSAhceVXq3k8Yyssp-1z7sIMYAnwMOWVKR1-Xgv3qV5h5F62BpU5Fq1jXrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHpyU1-bQidoJo_Rq_kkAxRHoMtfSQOBJvB0xZHtJBgA&oe=69BE9283"}, "display_name": "vArcher", "keywords": ["archery", "bow", "arrow", "archer", "simulator"], "long_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. \n\n**Customizable Arrows:**\n- Choose from a variety of tips, shafts, fletchings and nocks\n- Each part contributes to the total weight and properties of the arrow\n\n**Bows:**\n- English Long Bow\n- Recurve Bow\n- Compound Bow\n- Japanese Yumi\n- Medieval Crossbow\n\n**Tuning and Tweaking**\n- Customize bow parameters like Draw Weight, Draw Length and IBO Speed to match your real bow setup or get a feel for a new one\n- Hone the perfect shot with features like string-walking, multiple string release methods and micro offsets for hand positions\n- Add attachments like stabilizers, sights and more\n- Save and load multiple configurations for each bow\n\n**Ranges and Targets**\n- Includes Indoor and Outdoor ranges with customizable targets and distances\n- Freely place targets in The Sandbox Range for a unique 3D shooting experience\n- Choose from a variety of targets like standard Rounds, tumbling blocks, playing cards, balloons and of course, Apples\n- Get instant shot feedback for Bullseye targets via hit marker displays\n\n**Challenge Ranges**\n- Test your skill in a variety of special challenges and chase high scores", "short_description": "A Comprehensive archery range simulation featuring multiple customizable bows, arrows and targets.  Physically accurate parameters let you experience shooting bows from the comfort of home. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meatspacevr.com/varcher-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Meatspace Interactive", "support_website_url": null, "website_url": "https://www.meatspa
771-25/38974513_1018954689223409_2633948653718908231_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtuQW0vGurUQ7kNvwFU_MNI&_nc_oc=AdoNeYsKBRCUPRlvBKp-xFAisOcyHnlCfi5vO0NRcAtPyPrvfRfgFwUS2nj1QoxRCuE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQgOfESFeoSPz0bEkty9bBuXgH2JHCMwcgxCDTmoe1mg&oe=6A51138F"}, {"file_name": "ZombieSurvivalPrtScr5.png", "id": "696778015646825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982551_696778018980158_4546487947565670623_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0edfWWHTog4Q7kNvwHaF955&_nc_oc=AdqGRBaysrubMN4HadNApmpvHjguNgOG2M2uJ0UaE9vX-kpDQHsvlpuyA8hKN22MBVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxhDL4ixSO1WuAdayJAZh1iPecdoLtW9z0ITFrPZ-mjg&oe=6A50F4E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZombieSurvivalLandscape.png", "id": "1350294269199051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031401_1350294272532384_6674375725344053931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdLBBxHDQ3kQ7kNvwGgoCNu&_nc_oc=AdrDYRrbS5oIVGFgA-3zBt-VT_L5fydTeAwB35KlX88R1Q9a6lX3KFw5rgTDhVRpBpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7nY27VCBZii4KD2scxZzubKoluX5TVZIBrdbQgSHzag&oe=6A50FB32"}, "display_name": "ZOMBIE SURVIVAL", "keywords": [], "long_description": "Survive the zombie apocalypse in this heart-pumping virtual reality game!\n\nWith hordes of HUNDREDS of zombies attacking you at the same time, you'll need to stay on your toes and use every weapon at your disposal to stay alive! \n\nThe game features a wide range of zombie types, from slow and lumbering to fast and agile, each with their own unique strengths and weaknesses.\nChoose from multiple maps and weapons! \n\nTake on the challenge and see how long you can survive in this thrilling and heart-pumping adventure! Do you have what it takes to survive the undead onslaught?\n\n* More and more updates coming !", "short_description": "Survive the zombie apocalypse in this heart-pumping virtual reality game!\n\nWith hordes of HUNDREDS of zombies attacking you at the same time, you'll need to stay on your toes and use every weapon at your disposal to stay alive!\n \nThe game features a wide range of zombie types.\nChoose from multiple maps and weapons! \n\nTake on the challenge and see how long you can survive in this thrilling and heart-pumping adventure! Do you have what it takes to survive the undead onslaught?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bendisgames.com/zombie_survival_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "BENDIS Games", "support_website_url": "https://www.bendisgames.com/", "website_url": "https://www.bendisgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631707205697390"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1504956627835807"}, {"status": "PUBLISHED", "id": "1532566844955514"}, {"status": "CANCELLED", "id": "4406532952919539"}, {"status": "PUBLISHED", "id": "1577587119967472"}, {"status": "PUBLISHED", "id": "1268210498735137"}, {"status": "PUBLISHED", "id": "644370302091100"}, {"status": "PUBLISHED", "id": "1552553472622158"}, {"status": "PUBLISHED", "id": "1738696106822651"}, {"status": "PUBLISHED", "id": "1338
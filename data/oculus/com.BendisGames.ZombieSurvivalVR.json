771-25/38974513_1018954689223409_2633948653718908231_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPmsadWHOzMQ7kNvwHuUr1R&_nc_oc=Adp2y3ukcIhTS9BoPHtVzvqMZ1p832EvS7BwrqTOACiD3SiQ2JpOthUBlQRgdC18dso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mmoe5Yvchr_65FnnUL6WZI785GUR940m_185lQ-SRcQ&oe=6A25920F"}, {"file_name": "ZombieSurvivalPrtScr5.png", "id": "696778015646825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982551_696778018980158_4546487947565670623_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsdFymjGeygQ7kNvwHFPDix&_nc_oc=AdqzStLPgjat91LV7gcbxEQqFAihcfEurWmfvnr92SzX0YfRNJG1UtE0fRYJpno1EGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jm4kh4fRrMCQ8J19wALUOyvbBV_9pZEioG8f5jUx6xA&oe=6A257369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZombieSurvivalLandscape.png", "id": "1350294269199051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031401_1350294272532384_6674375725344053931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICvCQphUHj4Q7kNvwH4T9Hx&_nc_oc=AdqXT1CDEogcRMeLolxko2rMmzznX1S85oYIrxFovZZ-IKcODPJ6X4Vw-JEAzPYDzjo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af939aHyHS4dVF0RTJj6PSaZQ7y2uF59C2wA2zyjbeo2XQ&oe=6A2579B2"}, "display_name": "ZOMBIE SURVIVAL", "keywords": [], "long_description": "Survive the zombie apocalypse in this heart-pumping virtual reality game!\n\nWith hordes of HUNDREDS of zombies attacking you at the same time, you'll need to stay on your toes and use every weapon at your disposal to stay alive! \n\nThe game features a wide range of zombie types, from slow and lumbering to fast and agile, each with their own unique strengths and weaknesses.\nChoose from multiple maps and weapons! \n\nTake on the challenge and see how long you can survive in this thrilling and heart-pumping adventure! Do you have what it takes to survive the undead onslaught?\n\n* More and more updates coming !", "short_description": "Survive the zombie apocalypse in this heart-pumping virtual reality game!\n\nWith hordes of HUNDREDS of zombies attacking you at the same time, you'll need to stay on your toes and use every weapon at your disposal to stay alive!\n \nThe game features a wide range of zombie types.\nChoose from multiple maps and weapons! \n\nTake on the challenge and see how long you can survive in this thrilling and heart-pumping adventure! Do you have what it takes to survive the undead onslaught?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bendisgames.com/zombie_survival_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "BENDIS Games", "support_website_url": "https://www.bendisgames.com/", "website_url": "https://www.bendisgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631707205697390"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1504956627835807"}, {"status": "PUBLISHED", "id": "1532566844955514"}, {"status": "CANCELLED", "id": "4406532952919539"}, {"status": "PUBLISHED", "id": "1577587119967472"}, {"status": "PUBLISHED", "id": "1268210498735137"}, {"status": "PUBLISHED", "id": "644370302091100"}, {"status": "PUBLISHED", "id": "1552553472622158"}, {"status": "PUBLISHED", "id": "1738696106822651"}, {"status": "PUBLISHED", "id": "1338
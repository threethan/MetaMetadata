e the zombie apocalypse in this heart-pumping virtual reality game!\n\nWith hordes of HUNDREDS of zombies attacking you at the same time, you'll need to stay on your toes and use every weapon at your disposal to stay alive!\n \nThe game features a wide range of zombie types.\nChoose from multiple maps and weapons! \n\nTake on the challenge and see how long you can survive in this thrilling and heart-pumping adventure! Do you have what it takes to survive the undead onslaught?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bendisgames.com/zombie_survival_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "BENDIS Games", "support_website_url": "https://www.bendisgames.com/", "website_url": "https://www.bendisgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631707205697390"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1504956627835807"}, {"status": "PUBLISHED", "id": "1532566844955514"}, {"status": "CANCELLED", "id": "4406532952919539"}, {"status": "PUBLISHED", "id": "1577587119967472"}, {"status": "PUBLISHED", "id": "1268210498735137"}, {"status": "PUBLISHED", "id": "644370302091100"}, {"status": "PUBLISHED", "id": "1552553472622158"}, {"status": "PUBLISHED", "id": "1738696106822651"}, {"status": "PUBLISHED", "id": "1338
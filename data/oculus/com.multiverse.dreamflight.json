6968"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEpOghtb4FQQ7kNvwFM3I1S&_nc_oc=AdoOp2aZO9_NQgam3ePC4_nf1J1WF8Up4gZWPk9zWalK7oGAmy4h3L94mFqbV790rbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xpq2a8wpCzgZ0VTASquF9X8f-Xu4yV_LN031JOQrYbw&oe=6A3151FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xX8ls7cbD1EQ7kNvwG3q4qa&_nc_oc=Adr2OXALzd8mmQLNoO5QnPqj9o7I1wnjC_FkIHI6WfRRITvL2f-fWNJ3Ju9K1jCcHbo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D2D8Bh53PcVn5_NBnQD5WvxowZ4EkpxGBcqZxZ6gxvA&oe=6A3172A7"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqxHj_izdHkQ7kNvwEi2u-Y&_nc_oc=AdoLtbgXnGY4xul9kUSF0eOhLQ6CioXapQWDP-OF-fNFTpQadV0wdpl2-glLzGM068s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yCDIPpn4ByRVFATw5ngVVxEaKxZNO4_mPWvNP79f9XQ&oe=6A31746F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cmo7gFKrXIQ7kNvwE5Y2ZN&_nc_oc=AdpgCUbPzgexGiGx-VHQcmg1w57xQVt0nozGXxY8OdR3YC92YXs48w7uwHqhXyIjn_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X4l1zcFeBnhcqy-tMLXBb6-jjsDR7Bs7fPDKck-9spg&oe=6A31463C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
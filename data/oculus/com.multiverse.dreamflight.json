5368"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG4c2qrcbtEQ7kNvwF8JQFT&_nc_oc=AdqWBsOFEr9WnBRo3Dc8y0P6njm7J2iWBEIVZHGznc__kEOcYx2XTUqewE2SYQLNiL8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCycjrg_xaewCLpvQaoP_Q5zyyaHTGu3zCjvSHl0I7uA&oe=6A563BFA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vBKjwVuSKQQ7kNvwEKL8Mp&_nc_oc=AdrMn_4bkHCaJR7L0i-TjbAISEEqGwG5SD87WEG7kvr7zEZbh33U3yXXiz_WTkdRm_E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjePSHH4LyLn45jBCVUOc5r2g1_3O9YeUBN_SNDT7Y5g&oe=6A562467"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfeybzKyRIcQ7kNvwEYjSj2&_nc_oc=Ado5MqbfF7DndygoeyuNGT5Vc33MAto9lj3jHAyqX0qWK1oZ9rs578Np5ZMwCIEemy8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC18mQvXH8r2G7ek5OdxqFn-vgKAC8fxQ20uvl5gvNzRQ&oe=6A56262F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnyB5At6li0Q7kNvwEZaC-d&_nc_oc=AdpeeEALsEbqjAz8ghI0eBm1a-0AngK3O5mNz8x2qAWrVKiwOLKir2VYraGaw-oYTPg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDen9SQ1KURoi_G9cifb4NWSTuTXrOualv8TH_39AMjA&oe=6A56303C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
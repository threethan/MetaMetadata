4BE8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQOVYCVvjAUQ7kNvwHd9oVx&_nc_oc=Adq4jAHg-Ey6ns-z0kf3Rk_s-AU8h4cZfa-rCN-qDfLLS8Bv7w5XhvFVaQLHtBy6UhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH7ouH3emV0zUjEq2eYuxyI32wZaamNB5CXi9jtkGqJA&oe=6ACE347A"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSkLBjEKIhQQ7kNvwEE8HBE&_nc_oc=AdrNjequCwodWyXwJGfYw8ckOgMZCkydW_lcyH4ZY99tMTxDf14V8WRHTv4IENKxFeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOGZYqne1efZtvKKKBuSOrz7LNXXfYGffk-WYo_cm7mw&oe=6ACE5527"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPm5UdkL1DEQ7kNvwHUMZwX&_nc_oc=AdrYSW82HkuaLMoiW5IYVo8qJO3gzZtZSYp3x8WWb-A8gn2E-5ul-3qHcyXXoKKVE7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt6I3NLKyNMZU2IKdzrHCLbKr3qAn_QMOVzwlkCajrqA&oe=6ACE56EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4uz97d9fSkQ7kNvwGy23JR&_nc_oc=Adror3419_YQlH5h46-MfxGQ-N-337hDh5ixiWXfoMyiUN6CiPBN0Yw5KtX5BfQ4VLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqCELzuLir9fhq9mwysyXj1Ug9bDypgp9LWXEeW1IO6Q&oe=6ACE60FC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
4AE8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vv5eXJzFigQ7kNvwFj3kZe&_nc_oc=Adp9thCPFUjv2Jpc4YeyJhkwPcWxfhxRfNZI4O-ChKV59HaFlcYywYkyVmMVd5b3riM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz3ntJvzr6n_l9qCmSoIEXtDaorfpRVziu6vM2JolVRg&oe=6AB1337A"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLS1yELsFbIQ7kNvwFmEyG4&_nc_oc=AdpSPzsDKPdYfWQySP8ebeirvrlfGlsZo3-SA6p4TZt80YqyqbdPKn78KhJ_KCPVleo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHAgtS7uZVY6LXYzTAIUGISY4yrFGTaOsy_hM1Pl7QqA&oe=6AB15427"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPNC3AkA-WsQ7kNvwHLfRUT&_nc_oc=Adoh43f-1eKIQnV4hrVvZI8ewHIp6i0OhuFVcDh_Pa9ANujyI0ir0_4YF-6PzGoqMFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW_t7l5vQKZzSQOH5JP1DQg4gnnvHvheE4Vba3I4m95w&oe=6AB155EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJYLxF7wCWMQ7kNvwFaGDkv&_nc_oc=AdpmV2TfPEU9EgISvAWiJPHxF6RGJHSc4qStedq_PDe_gIZt8_dir9RlRaboyQYuVeI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNxvdlg5evoc991GacuS6Uggi99T3V3IU7y5_G7vKq6w&oe=6AB127BC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
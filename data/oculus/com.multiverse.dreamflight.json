age.png", "id": "206927297071110", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-InzHXkw0gQ7kNvwECYvKt&_nc_oc=AdlHfpH_sKEZ29mAxIwH_DLZyDkhg4g3CxyXMkJJ-QQy1x2dg4uEc-Bpg8bBeMx510k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoALqLLb0bwLCHCN-Ytf9n8Dr1dDBHUlS_QB8hGyCdwQ&oe=69AAD8FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0HObTxWIsUQ7kNvwHArUyA&_nc_oc=Adl8KN0CYj5Wo76KnxlQoWxvhgd1N6YsaiI6g_dZm-1ZrJikViS0bMsqpucPXqX2UL8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdpL_1Mr4D5DqqE6JYN7h_IEdqd1EHo2vW6h136Ko9ug&oe=69AAC167"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhSgs98XVBQQ7kNvwHxuIYL&_nc_oc=AdlEwUUBLiWgwli8yalgbY-MDA6Y2dVWzBPVQ5Boif9CpPHUwTwkYg6cakxdFFymk2o&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJcOSsNRpMXHaoH_Jit9qfLzD7ZUGBzeo5SVhUBCJQOA&oe=69AAC32F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdLlFI4duiYQ7kNvwGzPlF_&_nc_oc=AdmHrZjdX1XlY8RoKqLWO2Llg2tmgWkrgrWYt0OGIXEzNRQSWydCxqveHFcnliDgZWI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5xP8ljen7GbiLFL8eDuIQqzB-cug-RSxe4h93UxLRDA&oe=69AACD3C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
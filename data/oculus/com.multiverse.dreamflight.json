A1E8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cuvz9PV_nk8Q7kNvwHKVYJC&_nc_oc=AdriEy56dSX7LKk79aIvJb5oFr2iyy6Cxc8e-YT9vy-vknmjiOshj_Q9hDOtcpr1ktI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZAIPl6zmNC17D-nPCQyEw7J6eNd4SfUFUvArPXDHADg&oe=6A008A7A"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwUYsi2aS_MQ7kNvwE-TVTZ&_nc_oc=Ado0DY-SF7pxNH1S7Sur2aNUeM1HuuU9Ygi08L11PzYkW2_GZ6pO8P1SIAnvigyHCL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g2B51q0mcfoy_FS-I_h7aCIy-m4sDFmfyLVhRoIGm8A&oe=6A0072E7"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUsdaFLBfTwQ7kNvwGezTyu&_nc_oc=AdrOIwXRqoyd8R6qh-XIaSv_j5i2cZDcbONSkw6JGWxlGJIVUS50gz6Zt9W-2DCw0Eg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o1nBUHENZ3elDaNufOJzYzCRiRVys9_LaTh7vDbvgcw&oe=6A0074AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxb0dCl0CysQ7kNvwE9Wpia&_nc_oc=Adr_cj1KbzOQ2NTQ5S49QP5u94iziTSNeC4DMw0UF8QNot48Sel2OHJ7vjCwzvxLu4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IojUAmOMKPT4ADv52f78bBEBTSW3DljmLJ7FTHHUIOg&oe=6A007EBC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
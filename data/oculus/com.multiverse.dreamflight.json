3F68"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVq9H_0IAn4Q7kNvwFzl2lc&_nc_oc=AdoVEEM8HQy0GCaM8Yet3KcqvhBm7yuWNIu2SrgqGQoPuGw-_mnjUxWYkXN5SEwsLB4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJU3II58pG4gVyWuQPj-zs8ZIwlJckogfveaQiCyljIQ&oe=6AB527FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jfy1LG_jkYQ7kNvwFRrpTd&_nc_oc=AdojWQWHu5_1PI8ycVzI5K-Bxrg6Qu9_4tAm2Nhi013NG9zOaQx-b6T8e2tx89ALakc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN1S6tk3YSKSVbnEwyz0ueq_Xya3fJ7QBvh-TXK6OP7w&oe=6AB548A7"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke7ClIYOJX4Q7kNvwHynCBv&_nc_oc=Adqpsj2WUoQsmmtZUd2dI_J2s2c0t0dRN8FKAi1t1W3ie3CX7aRezOqXDb8InO1Kq6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYaifAEWPmHpr-Dwyad5rdilaI1Gj82EemkVfxCQzvRw&oe=6AB54A6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUGQQ_HhBuIQ7kNvwHOQA0d&_nc_oc=Adqs_OFWGb0kJSPtvP0TE16SVI9yG5NJbGIQwiDzcvEkVqdU7kbJ4bjcit9TP3NxwEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOvcpEUAgO5gZyByVgMi1ccAv0TLT69nUi6RMxOEU-LQ&oe=6AB51C3C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
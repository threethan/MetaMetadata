5868"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erUyv4js3UkQ7kNvwFN4AUT&_nc_oc=Adrfuhl99OxiR2Q1IVADzSw9Lr5NfU8DHkN7U0ilmvDpTLpnMpTHlOHTlQ8toosJve0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQegOn3RkZW600KsPDfVeLQFLfP-WtH1Df7Kacp77eWCQ&oe=6AE740FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW1ftREz7gAQ7kNvwH9t9fZ&_nc_oc=AdpwYDs3Eohy39bPa3doC7PZswYx3SYGMOVQJVGgsSD09wE-zOXvoWMxHvNT66uEl70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0Bm2UuUAMVe-kvzTyNTdnD9N-tKc5lqnxGVY4JRZLZA&oe=6AE761A7"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BovPa3aFWkkQ7kNvwHRyNKY&_nc_oc=AdruqmBJDka1T5-0AlKJ2QgM2Uzzsbq7pSnjIgeHnbAmyKcRfnCKxAZ7E5Yx3NwwlbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjPngHBO8bSzcsemrfhQlLBgi54tDyhlqvfqJMm6f8XQ&oe=6AE7636F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI8J9Wp9VBQQ7kNvwFwGDc-&_nc_oc=AdqTh6-xMgdYiDO02YN-4KvQeMDt0ZNcH2nm8KB7HO9KI4RBdKAtaaH_3MY7ID2SP04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOVc2sDEQb7W_EKpvDryFV2xNMqG0IoFPoej-ItE-7JA&oe=6AE76D7C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
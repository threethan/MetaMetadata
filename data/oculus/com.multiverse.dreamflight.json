33E8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIyxS090V2AQ7kNvwHJ2AMF&_nc_oc=AdrG6Vnjn2AqadXSZUDh87pRLpvPdUogbTKeHgaJfW6qosoO38kUqvt3lNoFXdaI4qU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_GhJmcNGKtCNjTpfK0EN8hhVBHlatqddvQRyP9ECK2Q&oe=6AB91C7A"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzmXOFAjXaIQ7kNvwFMCtnB&_nc_oc=Adpso4fQ2Z66DqBf_R8f8gqZuc9N425REfBqTUhkwRE1xyJ8HxprJuYDPvLWhJhkBqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-kd4G63NcTUBKiaeSTQ77ZKyXO2aKAJk5K-5lMRuCBg&oe=6AB93D27"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTA_-SPrInMQ7kNvwFMEU4a&_nc_oc=AdoUfGz4ZE1fwafNIwAs8lG_BZjrjsrn6UAjRqFwKzJ6NboCR2oVqZf2e94OdBva0go&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX6jnnb0Fjgi4VsvF4MaPLHvAtCetVR-ks0A7yUwdiwA&oe=6AB93EEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6jsuYUn1WUQ7kNvwE-ERdD&_nc_oc=Adp7zdp9JnAnoIm-T2IMXhcVWZiHHaOVuhpjUXhT0AZk_O3hOkprC6ybyFQxdIXkhtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeA7zmAX0MHxBh5wPtQbHzO6X6PCYJ96KQL91BzpUHog&oe=6AB910BC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
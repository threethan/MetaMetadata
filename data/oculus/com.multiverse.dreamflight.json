2868"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00-zcveBqmcQ7kNvwHZSXMD&_nc_oc=Adrbs6q_79WF0m8_qHGbMAqINEAodfzuEMcg8sL3d6TcuzGj3UjEO22ef7vTigvY_HA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3KfaAZ1WqtLgpBHJmSVKFL_KfndekO7-xwPld7Tq8NA&oe=6ABD10FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzBgJpPrTwIQ7kNvwE4SHQW&_nc_oc=AdpaimHl_rloVwzzyFgYVc4zH0Byd2us_CmRVyQOtdNZLTOkl-gyokzB8nttAced_uM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM0EtW7igO1Lbdh-zIxxRWhNvAjb7xKYrM8Y7n6cKb_w&oe=6ABD31A7"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lew3fWoxD3EQ7kNvwFWRQES&_nc_oc=AdohmaV_NbjgcZjK7EIZBM6GFM2hEmmuSIGEVmKCrYYuQ9njjJE4i0FFTL6ZJW-UQ4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvQW0FFT1FqVZEVs2SYHy1_b7z1-EveT7uxg3ognOkoQ&oe=6ABD336F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LHcEwLUMA0Q7kNvwHPBdMe&_nc_oc=Adoq7LDTo-afSuy1fBfC5ATtElU-zRMntuojpDchKVhnIRWLK0SaZ-St5rKRac_IWfs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXae9iYn_GOgA_fDUdbm7XGXwG43ittfLviYn50M8Rqw&oe=6ABD053C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
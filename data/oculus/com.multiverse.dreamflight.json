D6E8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00-zcveBqmcQ7kNvwHXBkr3&_nc_oc=AdraYlByvtWljxWvL7F6soQ9JdGMYlph4DNtsdsT5wgVACYZzmEMfmMjB3RACQNBdmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICNnjE-YfBKBxf5ryxGoCtdhv2n95s_qucrPHixJM2qA&oe=6ABBBF7A"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzBgJpPrTwIQ7kNvwEGlvUW&_nc_oc=Adps41A-HmdaNpPCQyPDa0cUVRRRs1C04Z4ZMOHE7uZzmhxpq9Upx4tnUgkZfiPMu2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYHi5crxsu-Q7G9ANxj0NIYS0MUKn9fj32ulUFdjZn7A&oe=6ABBE027"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lew3fWoxD3EQ7kNvwHGz_Bb&_nc_oc=AdpJQbLLspgZ27QH0sH_heGhoqPJJIAXeuz7PuTFx0vw4qaskF0oxi0oYzmkR5FOjVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6fnbDmBSTPZKxUsh3IgVdX69hS03fLcvpSvs-2G2RVw&oe=6ABBE1EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LHcEwLUMA0Q7kNvwEcCUI0&_nc_oc=Adol5rAW_sXxFoaXMETMp-VFWd2OhJkhvJcnHruw9fxKOK5D8_TGQt-9vSrkKaHQY6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUbVnJoModK0ri4M01fuBV_t8d-juWhQSGy1jytO3zzA&oe=6ABBB3BC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
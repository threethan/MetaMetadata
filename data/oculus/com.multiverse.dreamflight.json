F968"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vv5eXJzFigQ7kNvwEuV4vA&_nc_oc=AdoVFlf__uvISvOF_3woCoffFOwwSR0ATGlLS9h-dLPPCX0rxSVNvpszhzgeo2oCTb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLemT79rq3mMKzJMn9Klm4TCOrTsY36g8QRbxnHdx-6Qw&oe=6AAFE1FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLS1yELsFbIQ7kNvwEBgYtZ&_nc_oc=Adr_7Z7E6rbqXoQFdJvYKa4bzZqqlMy2sUPXlZlWPrn9xl_ae0p8qM2yIty05gM7Wys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCZDYXujDJ7o1VaMzsblStCuHB3Y6AamshS3YpDmT45A&oe=6AB002A7"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPNC3AkA-WsQ7kNvwHOfZ72&_nc_oc=AdoJdyl99wop55IiJQ5FB8LyGBaD-O6UeX5p0vNYg0A2vyHBNvOK18Brovm4tC3LVrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0SDyln1BAHdtmuIECWmB5O3GXI4CtWaLKtJ9riR6YVg&oe=6AB0046F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJYLxF7wCWMQ7kNvwEWkUZB&_nc_oc=Adqu4Y3aCreShimfTNtvHzwsRYl4aL9WRCQtf3LT5_-MwX-rallqfJ9qBF1gBPUl6e8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi-4ty8euiQ3Sy6mRz_28hmce6-WU-GHUeLkp6Q_ndUw&oe=6AAFD63C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
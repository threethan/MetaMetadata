3428"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yagH4Rhk1YQ7kNvwFLVogr&_nc_oc=AdrMoLUUtbBHknUjbR0F_5grKJIqw9gb6Z4JhQxDmhMk3-OtFViY6irUstAtcFOa3xQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHibMC0Ln7_Fcn-96Un0ltwKsnjwsaX2PH5fzN8BTCLaw&oe=6A881CBA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QCI-06naUsQ7kNvwGTJYUv&_nc_oc=AdrSAvwTX97sWEIcirFQYbSPqZzgC31s1IVj1YsbVkNo-j95O7w2YVMNH1H0Bx5KHpU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjeaWz0DI-EF-IKSzJqwFf8RFJRz5b6Hh-gODMI9HaNw&oe=6A883D67"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rUpLsK29ZoQ7kNvwHBG9B9&_nc_oc=AdpvrAYG7XyRXgzO7N_xhzq0oHoAFT6DAMQ6CHJSiM6bgsRbxwv8mH8eoX-oXeAUV74&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEXv-vgxc-JMGDcniYycUO0mcDGCaomj8_081T1hHZbA&oe=6A883F2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rThJrgI6qBoQ7kNvwFIluv9&_nc_oc=AdpBwFL4mwwvYP-_7BQ_nEG4baxdz1YvrKG0YGio_Pk3wZV-4TgcyCVdjCEMiLF5SPs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQGdSTCDL7nX8MtxDUtiokeoC-umOIhYhrambYR1rCRA&oe=6A88493C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
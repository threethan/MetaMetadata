1DE8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUNvPAUiNHAQ7kNvwHYc8Ea&_nc_oc=AdrtYNOvYLzj2QDkwz44smIzczU5_MkwyxqfLngrIxGS8IRQDDDN3XPE7YoKyNQTDHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXdzY6I4-OFRxuNirlGPsO6rmtrmCA_4rspnf65tsu1A&oe=6ADE067A"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6J6zMAwntIQ7kNvwHaO23M&_nc_oc=AdpnfN7VRZy_jwSnlqjG3fDMRkuODXXTM-Y22eAfQ369XPnyehMJgMfulDK2Uf_9vFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl7TQzPg4FtTDcv8N3ewzr0hbjK0iTvmrbid4eJhIOcQ&oe=6ADE2727"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xrut6P10JwQ7kNvwG_-FMf&_nc_oc=AdpI3I7HgzKgA_64l36Ongb4DBkYFXqK61vh2chSvicdkZFgzs-2FS234fjQpD-QN4U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi-wRjLSCNlxZNwm-4icB_aOYc6zdZf9sugWMHitAPSQ&oe=6ADE28EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRrCPJBX1FAQ7kNvwE11Jvd&_nc_oc=AdrzkPkhtLJMuQ22PweOH-lDfY_1CWxpE8VXUpPppJ2wDSbuoYIEDyZvr74M17EJWs0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKWSgzJlp0ifbe39qdBYsyyZV9TyV2SMwr2tCSLDY1Jw&oe=6ADDFABC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
5BE8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXdjIjyP9pIQ7kNvwHR6KW0&_nc_oc=Adr8nyvlBCOcAfrceeoGKJbBhTi3QGGvm0Qr3uhlYeRR1MRvDqJUuvPwwLKMCOLuCAo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52-n7UTbW1PPxl8HZYzQSykmGeE2xokziGEZJ1vEd2_A&oe=69FB447A"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wA9fSPqZoAQ7kNvwEofLqt&_nc_oc=AdpayL8Fg5eNBmOxPjlrjStp9HPnEkd0kQ6_wy_ZZsBNABW9EG9jWfs_f1ZjwQrs84U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67TX4_DWzhjjH5dqx9w23HGm4j14kLoJYoxcGFCrjusw&oe=69FB2CE7"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InIgc9CH0m8Q7kNvwE9xU4M&_nc_oc=AdpiHut-AVGugtBXE5dcQXApTFfVupbTXoO-aTIjzDPGi_Vjxco1KmR3EtwziaP1ke4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xFcaRKmADGRRLGKoW1SgxrfUNcXn2bZAEyAzkO_S53Q&oe=69FB2EAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpkaQY_9V1sQ7kNvwGSr1kX&_nc_oc=AdrH4SR3nEALAa1YiIsN3HNYRW--toJN2LWhz4jfWoc3OxwGV7flBJuA1zJxY6huCNA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54hNEDRFMP6UfcmVuNPw8UO1Q-b1_GpKBrcvbXT1oTJg&oe=69FB38BC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
78E8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inm8stYLGDAQ7kNvwGUPBNS&_nc_oc=Adpg0i9mgzSTj6LrTekPUY6f-a69a18O-Epoqsp-mGS9j8Bw-9nQAAf7kof53JwvZEg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWMypQu67vv4w97SjjwX49w4zhcwgYoulWHCJsGSsWTg&oe=6AA1617A"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgpiAN-eyEkQ7kNvwGnI8cz&_nc_oc=AdrcByxz2F9efGvp8rzwOr0HLEB-MPqnxm_8J6RUmrKtcZ2NINzTBLOcggqA1tud7kc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyLU3cowvqa52DgcXVAK4SdjiXAWOV8ai2dZLsbPeWLg&oe=6AA149E7"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1Mu6xhV3twQ7kNvwE5jaZj&_nc_oc=AdpAePEADVg1TIrVbZiIkFMEABJhPOQrZb4ETndMa8VDcyh5iCBZj-dth2LmAqdCwhI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgkL9_UBxDUQyMxr5qpY5ZqIYC7oNHKE5vFvkVqCbgvw&oe=6AA14BAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naiJ8IQRHcAQ7kNvwF9WMEv&_nc_oc=AdpQaTg76Au4ZNfp_qZFV5wLgnugd63Cd6yVRTJ9xeXosW0ueFVwkvZmH_RTLFtyXN8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7QmeoaA4AJEakfrgslDUnz9p4FLijG95NsokSrPNy6A&oe=6AA155BC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
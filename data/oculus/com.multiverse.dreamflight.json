B068"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG4c2qrcbtEQ7kNvwFPV3Jp&_nc_oc=Adrh5VxEYjUkeVRNSHvfAwKdv3UYS1W19j6LRx2IcKhImqbxVjAX5h_kk9zlAFEZiGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8d_fquYVDGM4SA4rQ_cDHtBlObmKYnF5cGu6FFD6tGQ&oe=6A5398FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga70tzLtqw0Q7kNvwGDc0ey&_nc_oc=AdoCj8Cw8VQDxvEDjAbxXFmeFDlHXLy_nzVKmUx8Ub8-cOpNeCgzU6ZRxkhiUmpzK8s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxxiWCqhr-17TTolxVdRnpWEgLk01O88ydWyJcd6Wb5g&oe=6A538167"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esPAihmx5RgQ7kNvwFmnWI-&_nc_oc=AdrlCNn-rb__Szd2OWnPDObf_cGxrL4eo7EKbc1KhLu0REuYz9bXxRBPIMv2hq5jDMI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkCVbELrtLwISL0b8h02xZrlA6705HH6K3C3SoPwNSpw&oe=6A53832F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcnUPUXiHWkQ7kNvwFjsp_G&_nc_oc=AdokfHSE_qwPv7lPkUVEiV5CkTNIXTezOaX1EGVFjVpOJsnIr2Qi60sdFyjyDZidF-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANyiWOHXbqFWveHQHnLtAw0Vuw5R4dktJNP6XXPQJEEQ&oe=6A538D3C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
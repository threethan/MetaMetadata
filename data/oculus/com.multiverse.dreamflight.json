7928"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPPb1Fk9mCYQ7kNvwFWISrm&_nc_oc=AdqFmKKxK33znQ9ootiUP_7eMQD1tmXRg9wZsHfPzzuxeQT-2-K7FpZ5FboJg5wfOiA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpLrCF1Ojsr8fVcXgQwp7RQzF2p_qcvFyUA0A3_NmcEQ&oe=6A7099FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXl-F8lKRQgQ7kNvwF7rcvj&_nc_oc=AdoVmIKbR1fwhcIDwhSThjXORrRQdgzAzx3FEY3K9YPPvy5HOuj_Nwac_stGNqebf08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE433wIXR5nlCIPEAOMyvEl56wLAm15VrFHGt6d7hEDhg&oe=6A708267"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCF25UddA0gQ7kNvwGQfv0B&_nc_oc=Ado1vrZtarniiDSlNgIS43rIivsoHZNgif8POZXkYKOHXkz2rzikGGAh85EnSVTr3a4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpU6zriixjiB0UMYMcCumnMiYwlk-3DchdC0gEGLvjoQ&oe=6A70842F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_-A4kmZ4vcQ7kNvwG22xs5&_nc_oc=AdpSZoerDRXgFUCPrKKL9N1zsgAziTY3BBKsQ8-NST_1_FI2adLKFeHaQUmjAJW31Gc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEoZAaIj0iNjUKeeXZrTdI66qwWAR4jwfQGx_d03vj7A&oe=6A708E3C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
8068"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPXSok0L_AsQ7kNvwGJhIeF&_nc_oc=Ado1p4aWKZOT4-xbfYh6D1RDOd71YpQli2ivZDbi8yEp94r_o0c4QXpiaUbtR01TBK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BnPdC5Ss0o1K2V9xIyp4iMB5qh0rKcOo160nLrM5_Ug&oe=6A2968FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1J5dzE50VsQ7kNvwHlPDQl&_nc_oc=Adrp4PeY9kRiUd82j4XsRrj7E96f2hqMCfFhLHCQTM2Az3N6IRytH2USmir272VPSm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o9AeWqJvuz_tQdLfVF_6Wr3nT1EVktwBWpiywXbMg0A&oe=6A295167"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_tF5V_s054Q7kNvwEhCZtx&_nc_oc=AdparcN_mPUp65buIaQnr-cGPBrHz4LRTPCZqqc1uhKoMAAa3Bo1vqIiGR3eKBSjZ80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wpGa_8u3Ulx8JmRCqVAJGZMA6ntrqsx3ppgcZ7fNuBQ&oe=6A29532F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXBzxbfaMxYQ7kNvwE2waGf&_nc_oc=Ado3RK6kNWeCMNgZcvZKb7mkrg56SiyCUfjftfWy6YYHzF8laMD8kZq6IhYtBaLUKx8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Il1TcdP9bO_p67h2ZEqyLtLYLrs5ad8Ms2Iyva-8pvg&oe=6A295D3C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
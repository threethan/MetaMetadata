35E8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMygZpq7BbsQ7kNvwFbeVxz&_nc_oc=AdqA5ETY2-wo-Q5apA74q-FXtvHITKyxI0YuUX2A-DI2LS4BQUOu8wSpYlX6lb_CiB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkrQ8tN9SxV-2pBotkOM2UftDXKhK-kQfh4Hcn04jkiw&oe=6AF356BA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wdCiqC2XTIQ7kNvwGDsGhh&_nc_oc=Adp-h5AUFKbPHsou5ru6n1-HEgsnz-JCTCCJK7BQqxTcqcF-NQQIiGiWuzrowS33gHA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG6Esalw2jSZWz8jX9-nTUc67EvoHRCqqkoyXobB-8Vg&oe=6AF33F27"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7_G953w8gIQ7kNvwHrAxPJ&_nc_oc=AdqF6gn_Nc2u8NwEXi9O8yorSwHrsbLfcu71Q9amhAMo5u2gKdXCgwhJTx-W4iFa-_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0R9hJEq7eewDFGsHNiYk1FDVEF3Ydf8Ca4gT0GSGSdA&oe=6AF340EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLZGX14t02MQ7kNvwEIpDmv&_nc_oc=AdpY8ZZlNB5Tv2UqfNCMAr3gBtdaE26GH3qpUqZRt8qR7tf9LbDk7X9wcyXdRhcAVQc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi7_UmqoweGyprd_tKG8cFmctYb4pInjVPFKhyQ4FG9w&oe=6AF34AFC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
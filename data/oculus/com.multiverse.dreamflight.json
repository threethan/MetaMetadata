CC68"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkoQ9tdaS80Q7kNvwHUhHkZ&_nc_oc=AdrKMYDx_rGBlqfTzXYNpMyV2Rl6u_bkzgKjcVR6nIsYmecb7VN9JVfj9hzi76RbVE8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGdnIhLKDTmepNCgOlwov2cWxjwM6k_cp2-MTV8yMDFg&oe=6ADCB4FA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6J6zMAwntIQ7kNvwGbaXDk&_nc_oc=AdoQmQeDFbfYC-F0wctWjB5Qx4TrNO8c50XbLl-3sOdmGLki9TkVgx_OzEsdlg2345w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhqTVtqxee6NwzTfTsgkpnghwvi-Nf2fooILrPyS1zNA&oe=6ADCD5A7"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xrut6P10JwQ7kNvwFcaUuB&_nc_oc=AdqPxruFDJrDftFWz_HHnwH05woJ8j8mbuwc0ArftZ6No5tkLd-MN4FBHi1L6jaJawQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYCRiCObmlVnZe200id0f4v6P-hy0aVHvSVvykAfja0w&oe=6ADCD76F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRrCPJBX1FAQ7kNvwFeKaGm&_nc_oc=AdokzM0LK3fvA8lDWgLI3paP7CXoi9V5q2StDkO1y2M6PXKRvL-3LGoHRMuYFRvpb_I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6I9dwaFXCEQDTtxfxBULKZSfrinED2BbLVQkFZlKntg&oe=6ADCA93C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
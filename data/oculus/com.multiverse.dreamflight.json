1D28"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI-PeXvtirQQ7kNvwGgJK_l&_nc_oc=AdoEBaZsbwx_d1chzM9WOQNyzgRIp4w7XI45mzMPBZv48q26Y3urlWFFMgPTw8xarwM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5ggRIq-5x39nI5dDgg0khUtGtFTsVD8Koe3Uw5OUUqg&oe=6A903DFA"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2g7g0W2IFEQ7kNvwHShtAU&_nc_oc=AdoQz-fXn_X_XF38MUg0tcHqFyOPR54RB6swxWL0EUpveUYlk4Zb22Lzk5SltBEDV_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmsl-xryOQcHszIg-ClxGDTiG8QBDbYhKV4JyJj03-eQ&oe=6A902667"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNSDIAXv_yAQ7kNvwEeI5vs&_nc_oc=AdqVtkUJTKwDXDOHmuAgpoq7mCR0BXAHQHIjJboGFOzNIphbhvkTO9aurl1jNRH01Tw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBWUJPqP9hxSOhIoEgoGHXJk5DU0sFW4C9xqs54atEZw&oe=6A90282F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grUtVfdr6vcQ7kNvwFeUS7M&_nc_oc=Ados1VjLGrsdFv5v7KrlU-QRDZpWLeQqLOBFDhPO9b659DdUnlNUkPsnkQykNEEXT2g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTcPVH7r_2ps04C6nW5U4loNJr0o4TJ8oK0Qe_uud98A&oe=6A90323C"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
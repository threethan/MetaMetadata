4CE8"}, {"file_name": "migrated_image.png", "id": "206927297071110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_205661046499237_1505140856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NR9R504vRZ8Q7kNvwFClSFI&_nc_oc=AdoMomvxVcSGiH81eGX7FynJDGoeGtICzGiGhfvfrYySn5cjNaJH1cNIVllIi1COQHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwHTgr7Yk39MgHa0_u6tevUH_K79dOmpDYKwrgSmcxIg&oe=6AEB357A"}, {"file_name": "migrated_image.png", "id": "349686529285380", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504832_1067714839973849_1946682316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MU_bngYmRIwQ7kNvwH7Z9xk&_nc_oc=AdpMXsAkO7T4DooniqfpUKoWj3dR_l6NAfhVEZ1swCtq4qkTiIIa4H0QtS5VGbVZt34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgaDHS76KyLmXk9uoMVBI3HKhk7U_QFJnPaNYeHXjlvg&oe=6AEB5627"}, {"file_name": "migrated_image.png", "id": "2332771570358364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12448837_1101584653212994_157945009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92y16VJbim8Q7kNvwHK6kVo&_nc_oc=Adrdi-AjZjhpcysqvrKmg3qYFhL0NXZOblSYPi8eQUPerCGPo10HzR0aA6UYsXeR1bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbUZtVIDJfbzm2utE4kz2_9wrn24JUIjiyjTrqGwT3-w&oe=6AEB57EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover2560_updated.png", "id": "463103864080378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602128_463103867413711_6033363873220788224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWQo-xZH5mYQ7kNvwHfCX8x&_nc_oc=Ado-xCRjaZh4B7ycItUxlynXMYaK0ZpyzSd3K4eUjrhDZPJ_50ATTRUvezen85GbxNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7C4a4Civ2_vUFg13ScuAp7PKxAHXkYeb4wIPcVGCe0A&oe=6AEB61FC"}, "display_name": "Reveries: Dream Flight", "keywords": ["music", "relax", "adventure", "fantasy", "exploration"], "long_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack.\n\nDream Flight is a hands-free experience. No controller is needed. However, headphones are highly recommended!\n\nThere are many new worlds and soundtracks being crafted at this very moment. Update your Dream Flight version regularly to receive these new updates.", "short_description": "\"Beautiful only begins to describe what is easily one of the greatest looking titles out there for the Samsung Gear VR\" - Mobile VR Daily\n\n\"One of the most visually arresting experiences we\u2019ve seen on Gear\" - UploadVR\n\nDream Flight is a beautiful game about exploration and discovery, painstakingly crafted for Gear VR. Learn to guide and collect a variety of magical flight machines, and experience magnificent and ethereal scenery underwritten by a mesmerizing soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.multiverseinc.com/#/dreamflight-privacy-policy", "developer_terms_of_service_url": "https://www.multiverseinc.com/#/term-of-service", "publisher_name": "Multiverse", "support_website_url": null, "website_url": "http://www.multiverseinc.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "MUSIC", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
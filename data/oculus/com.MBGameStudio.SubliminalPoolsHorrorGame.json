less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L44SJIS6HMQ7kNvwFUJGpK&_nc_oc=AdrvrYMnknbaiyjjb5nGePngAhx0ctC5ONlsaO_e23rA5SUb5DsUH2srTdJpL0xgwTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbU9ElV9iHK0Q_ocS-mPWJmxHWSNhbtuijhaNKAnWu1A&oe=6B0069EE"}, {"file_name": "Image2.png", "id": "778480644699054", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_778480648032387_3589438190263366020_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Kwtnm8SH0wQ7kNvwEyUA7f&_nc_oc=AdoKv5ST9iYv-oM3_dYAwNWu_r-MO_lpmJ48oawph5wLsaHZH0-tlR-j7EwXUd0XeMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa4mqkGnE121LS-7mUY-EkntYZp-Cmai5nOZA7zR8xwg&oe=6B00728E"}, {"file_name": "Image3.png", "id": "1497203644600835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_1497203651267501_3811913250121017720_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFZ2Y4g-z5cQ7kNvwGAzwet&_nc_oc=Adq57IYacQV2jRROuq-NaeqZsoQlFbP5iqJ2fCIExCuXACr1l_Nk6BTd5v5q6rhKc18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMx2GvCR2gx4YhmEKoiFkd9teihKP4PHEZ-TR5kANhXA&oe=6B005A52"}, {"file_name": "Image22.png", "id": "9953495668111154", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_9953495698111151_8755726101360900540_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a26k5k3wkK4Q7kNvwH6oQ7K&_nc_oc=AdqTomDm4hvWCiCrbjGvAwacjT-sChhEoGFoDciWeFF9qI1hvUyxuIbQp3H3kgErVgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT56pCLbASpI3G9hws4Pl0CylSHLr_ZUkv0VvA4cq_LGw&oe=6B008495"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Subliminal: Pools Horror Game", "keywords": ["Subliminal", "survival", "pools", "backrooms", "horror"], "long_description": "Subliminal: Pools Horror Game plunges you into a nightmarish maze of abandoned indoor pools, echoing halls, and impossible architecture\u2014known only as the Poolsrooms. You awaken with no memory, surrounded by flickering lights, stale water, and an overwhelming sense of dread. Something is watching you.\n\nAs you explore this surreal and haunting labyrinth, your only hope of escape lies in gathering scattered power supplies to restore power and unlock hidden pathways. But you're not alone.\n\nUnseen entities stalk the quiet waters, creeping through the silence. They sense your presence. Every echo, every splash, could be your last.\n\nStay alert. Keep moving. Avoid the shadows. And whatever you do\u2026 walk toward the light.", "short_description": "Trapped in the endless, echoing depths of surreal poolrooms, you must evade lurking horrors and collect power supplies to find your way out. Follow the light\u2014but beware what's hiding in the dark."}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30931694276444119"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "962514019876313"}, {"status": "PUBLISHED", "id": "1772355590632073"}, {"status": "PUBLISHED", "id": "82440389402
-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLQ8QE6mxoTzVML5TyDYgZG9nYetd3vXzHfVFokX8qUQ&oe=6AE1E7CE"}, {"file_name": "Image3.png", "id": "1497203644600835", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820428_1497203651267501_3811913250121017720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErfSxJkIMqgQ7kNvwF3HlTm&_nc_oc=AdrXAMla1OeUIlGZTA9VYc_0a6Hosis3LYQHY96vuJai6k7sxZjT0blXK7tl-7qdLSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJNvOyw49BCJfkzjfhpCz3Cs0kkSmryhjRtmNdoY6dpQ&oe=6AE207D2"}, {"file_name": "Image22.png", "id": "9953495668111154", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827646_9953495698111151_8755726101360900540_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJDs0vrQprQQ7kNvwESOoge&_nc_oc=Adp8WLF6J8tjIIZ2k6vTBGgzK1x34f0z2POFRLMpVxGQ1Ra0iimk9ldEL1raoY7i1xY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5Ji-lfi0Bc0taPwc0nYZShO0hTQqzj2NiFgEx4HryGQ&oe=6AE1F9D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Subliminal: Pools Horror Game", "keywords": ["Subliminal", "survival", "pools", "backrooms", "horror"], "long_description": "Subliminal: Pools Horror Game plunges you into a nightmarish maze of abandoned indoor pools, echoing halls, and impossible architecture\u2014known only as the Poolsrooms. You awaken with no memory, surrounded by flickering lights, stale water, and an overwhelming sense of dread. Something is watching you.\n\nAs you explore this surreal and haunting labyrinth, your only hope of escape lies in gathering scattered power supplies to restore power and unlock hidden pathways. But you're not alone.\n\nUnseen entities stalk the quiet waters, creeping through the silence. They sense your presence. Every echo, every splash, could be your last.\n\nStay alert. Keep moving. Avoid the shadows. And whatever you do\u2026 walk toward the light.", "short_description": "Trapped in the endless, echoing depths of surreal poolrooms, yo
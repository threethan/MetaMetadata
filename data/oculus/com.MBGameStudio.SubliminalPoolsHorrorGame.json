66020_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i_DPnLv4h4Q7kNvwFIQ9bs&_nc_oc=AdraLrbGDoRmAv5i_GxDmKFVcTb4-cy-VBhJRJhXS-bR7Epo7u01nsVuBb6WReLvyjw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFsmjMkgLc24rk-CvIbDU3C-AsUIWOzC3tsvbWs08xfA&oe=6AFB2C8E"}, {"file_name": "Image3.png", "id": "1497203644600835", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820428_1497203651267501_3811913250121017720_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fZAJ7MAwJ0Q7kNvwHLoC2n&_nc_oc=AdqQLGJ5gtuZ10bxUgisjoh1ZjkBif7AgGuuDJ-rhNoMMuTbB7wBFN6kxwPM0e-b6vY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoJwncf2S5lFDkvKmWQv7uLUicCVSwhSzRjbDbg37w7w&oe=6AFB4C92"}, {"file_name": "Image22.png", "id": "9953495668111154", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827646_9953495698111151_8755726101360900540_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBI6M_xwXtEQ7kNvwE1c4KD&_nc_oc=AdoGTetlIn5KM-Qx4gdFXDrbUGy9K2BeLpijWCTiNkMFr5xMk74P-Bz75whaK77MZws&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqsg9foKWd57HX0c9ligEHBBiNWZRqvdtLkZI0Thwl4w&oe=6AFB3E95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Subliminal: Pools Horror Game", "keywords": ["Subliminal", "survival", "pools", "backrooms", "horror"], "long_description": "Subliminal: Pools Horror Game plunges you into a nightmarish maze of abandoned indoor pools, echoing halls, and impossible architecture\u2014known only as the Poolsrooms. You awaken with no memory, surrounded by flickering lights, stale water, and an overwhelming sense of dread. Something is watching you.\n\nAs you explore this surreal and haunting labyrinth, your only hope of escape lies in gathering scattered power supplies to restore power and unlock hidden pathways. But you're not alone.\n\nUnseen entities stalk the quiet waters, creeping through the silence. They sense your presence. Every echo, every splash, could be your last.\n\nStay alert. Keep moving. Avoid the shadows. And whatever you do\u2026 walk toward the light.", "short_description": "Trapped in the endless, echoing depths of surreal poolrooms, you must evade lurking horrors and collect power supplies to find your way out. Follow the light\u2014but beware what's hiding in the dark."}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30931694276444119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820441_1771117610199306_2465115031890994934_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1njeuhQ42wQ7kNvwHf1UGW&_nc_oc=AdqOQ9gm0wREqG4wojX5eO_oKgMrRH6XYxAgJzEvXLn1Q_aHYY0A7e6auwRWnwpP0zs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK_VaQv5o1AyZOEC2UqPg5WeGIH3VWRJOQVPn548YPOA&oe=6AFB4BEA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Subliminal: Pools Horror Game", "platfo
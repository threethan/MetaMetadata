3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl3A2Z-LVpnmpX0i4ATuTYWP2hnd2WC0E_aHH2Gt6nlA&oe=6AF1F20E"}, {"file_name": "Image3.png", "id": "1497203644600835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_1497203651267501_3811913250121017720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0HMWo87c04Q7kNvwFcEsmz&_nc_oc=AdouaaJMOvDRUx2hRueNM9opWRXMua8ttNOXtucfCupKyIJBwyiCpN4RR04X3A8qVQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUjrPcs1XoHxd2lkGwU2HcBCxt8Lysg2nWr8BuWvGFVA&oe=6AF1D9D2"}, {"file_name": "Image22.png", "id": "9953495668111154", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827646_9953495698111151_8755726101360900540_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pi5xBsH9YKkQ7kNvwEbmxsa&_nc_oc=AdoGW77fFGRZy3jX51Q12WAA9Qf4N22Nk8Cz_o2fGm9h7fOV36ISQnjnGi2aEyzhw18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3e-OfH5ktpl7l2WnPNUinduFF3MHznSD-B06CqI7nZw&oe=6AF20415"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Subliminal: Pools Horror Game", "keywords": ["Subliminal", "survival", "pools", "backrooms", "horror"], "long_description": "Subliminal: Pools Horror Game plunges you into a nightmarish maze of abandoned indoor pools, echoing halls, and impossible architecture\u2014known only as the Poolsrooms. You awaken with no memory, surrounded by flickering lights, stale water, and an overwhelming sense of dread. Something is watching you.\n\nAs you explore this surreal and haunting labyrinth, your only hope of escape lies in gathering scattered power supplies to restore power and unlock hidden pathways. But you're not alone.\n\nUnseen entities stalk the quiet waters, creeping through the silence. They sense your presence. Every echo, every splash, could be your last.\n\nStay alert. Keep moving. Avoid the shadows. And whatever you do\u2026 walk toward the light.", "short_description": "Trapped in the endless, echoing depths of surreal poolrooms, you must evade lurking horrors and collect power supplies to find your way out. Follow the light\u2014but beware what's hiding in the dark."}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30931694276444119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1771117610199306_2465115031890994934_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2StSbPznl4wQ7kNvwHEf8QR&_nc_oc=AdqNIKbySkGwhRMETEwG4R4RJ1WUFDURHaTZLXiksowEG35JR9onCmXhqLDyxIWF45M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_J_x8KegkHLh69gfCN8YD06yEfkkEo-QMqRJQBLm4pg&oe=6AF1D92A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Subliminal: Pools Horror Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Action", "id": "459781504968480"}], "release_
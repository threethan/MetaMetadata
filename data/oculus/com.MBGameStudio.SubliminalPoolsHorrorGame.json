-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJHxMVJBFPcnGtxKwKP4kZ--hH9LGgvsU2M7UnqAZsFA&oe=6AEA090E"}, {"file_name": "Image3.png", "id": "1497203644600835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820428_1497203651267501_3811913250121017720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffxyGCjbXXQQ7kNvwFiDpFE&_nc_oc=AdoBLSj3fOeCwb0foHvfBA_wrjc9nGehttu5hSxuJ8HvdsoqgX6YQCY4pIE7QQy4tiM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR66cK_UyYC8zmIzBbYUjCzRh51oNW0a9JjPCsE64piVQ&oe=6AE9F0D2"}, {"file_name": "Image22.png", "id": "9953495668111154", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_9953495698111151_8755726101360900540_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAYybJAE2McQ7kNvwFPj_I3&_nc_oc=AdqZ_iXnZRsWP5kGK2lDk7fvJrn7sIhYtxkc8yefvsycrY0f2QxrjYrp5vcfyMcJQl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSib9FXha6EVoNWYNdrkm--V_V6GF4Mf-bHcaYNiGTUEQ&oe=6AE9E2D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Subliminal: Pools Horror Game", "keywords": ["Subliminal", "survival", "pools", "backrooms", "horror"], "long_description": "Subliminal: Pools Horror Game plunges you into a nightmarish maze of abandoned indoor pools, echoing halls, and impossible architecture\u2014known only as the Poolsrooms. You awaken with no memory, surrounded by flickering lights, stale water, and an overwhelming sense of dread. Something is watching you.\n\nAs you explore this surreal and haunting labyrinth, your only hope of escape lies in gathering scattered power supplies to restore power and unlock hidden pathways. But you're not alone.\n\nUnseen entities stalk the quiet waters, creeping through the silence. They sense your presence. Every echo, every splash, could be your last.\n\nStay alert. Keep moving. Avoid the shadows. And whatever you do\u2026 walk toward the light.", "short_description": "Trapped in the endless, echoing depths of surreal poolrooms, you must evade lurking horrors and collect power supplies to find your way out. Follow the light\u2014but beware what's hiding in the dark."}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30931694276444119"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1772355590632073"}, {"status": "PUBLISHED", "id": "824403894029731"}, {"status": "PUBLISHED", "id": "1206484041259939"}, {"status": "PUBLISHED", "id": "2034137600719248"}, {"status": "PUBLISHED", "id": "1785876438761966"}, {"status": "PUBLISHED", "id": "580871655018070"}, {"status": "PUBLISHED", "id": "1827013174867997"}, {"status": "PUBLISHED", "id": "602089076310200"}]}, "baseline_offer": {"id": "602089076310200"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1772355590632073"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30945105381769675", "version": "2"}, "id": "644094478187907", "channel_name": "LIVE"}]}, "is_for_oculus_ke
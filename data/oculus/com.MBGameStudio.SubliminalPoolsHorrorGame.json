5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS57B-0PYXE2jd3v4XxtL3DWYt7SrkbZfEiTx-ez3fGRw&oe=6AF8898E"}, {"file_name": "Image3.png", "id": "1497203644600835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820428_1497203651267501_3811913250121017720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4NQiRV6qgoQ7kNvwGl828f&_nc_oc=Adpw8bXy_1RiFwJYLr0qBb2Jnqo8SqTs0Ej7dHfBUJGWJhxqBId5o4NRuYyutj9C5Jo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkNu5_-SWogiPGCuyc7OvZBxg4iuP9uiA3Hn-AkDgmiQ&oe=6AF8A992"}, {"file_name": "Image22.png", "id": "9953495668111154", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_9953495698111151_8755726101360900540_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=080O0gW5OZoQ7kNvwGZyUy-&_nc_oc=AdrehW7AtBF_HjbrB0_xYcaBtOxH4ne8DzCdd_OSdvjQnvT-4-MjdXgWvl7jUEQGqMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnn5JEt23qk1Rzus02GGXTE6DM9SLBw2gsqg_7N2nv2A&oe=6AF89B95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Subliminal: Pools Horror Game", "keywords": ["Subliminal", "survival", "pools", "backrooms", "horror"], "long_description": "Subliminal: Pools Horror Game plunges you into a nightmarish maze of abandoned indoor pools, echoing halls, and impossible architecture\u2014known only as the Poolsrooms. You awaken with no memory, surrounded by flickering lights, stale water, and an overwhelming sense of dread. Something is watching you.\n\nAs you explore this surreal and haunting labyrinth, your only hope of escape lies in gathering scattered power supplies to restore power and unlock hidden pathways. But you're not alone.\n\nUnseen entities stalk the quiet waters, creeping through the silence. They sense your presence. Every echo, every splash, could be your last.\n\nStay alert. Keep moving. Avoid the shadows. And whatever you do\u2026 walk toward the light.", "short_description": "Trapped in the endless, echoing depths of surreal poolrooms, you must evade lurking horrors and collect power supplies to find your way out. Follow the light\u2014but beware what's hiding in the dark."}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30931694276444119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1771117610199306_2465115031890994934_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbUjNTvY4-gQ7kNvwGanxR3&_nc_oc=AdqHsF0EKGD1kG6WAJyhqbpWatzjSle9IC1ldT5fFgCBCbFy1ru0lI334SUFWtdaQa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvLhr6bIexrQs0zHd26igFoYbc07ZhT3QHZzAT0imTfQ&oe=6AF8A8EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Subliminal: Pools Horror Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Action", "id": "459781504968480"}], "release_
ADBf2ORFqGUNy9fEaPJaEKueJ_SXtmssawtdzOycE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vpUQE5KrNcwaW4fdP0hi4BjG8kQ-Pye43h69hk_QOuQ&oe=69EB7F52"}, {"file_name": "Image22.png", "id": "9953495668111154", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_9953495698111151_8755726101360900540_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2TPQY14G2kQ7kNvwF4S0y7&_nc_oc=AdogPMr5YP2zVYcli6AURmhCG2Us8baEaPwFxoIR6YSLMBpzQbhyXoHulHEd8M8Fy9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PaSkjpFbIlNHzGX40Rl3MLsw9v4UcSb6SHm4w_8cbFg&oe=69EB7155"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Subliminal: Pools Horror Game", "keywords": ["Subliminal", "survival", "pools", "backrooms", "horror"], "long_description": "Subliminal: Pools Horror Game plunges you into a nightmarish maze of abandoned indoor pools, echoing halls, and impossible architecture\u2014known only as the Poolsrooms. You awaken with no memory, surrounded by flickering lights, stale water, and an overwhelming sense of dread. Something is watching you.\n\nAs you explore this surreal and haunting labyrinth, your only hope of escape lies in gathering scattered power supplies to restore power and unlock hidden pathways. But you're not alone.\n\nUnseen entities stalk the quiet waters, creeping through the silence. They sense your presence. Every echo, every splash, could be your last.\n\nStay alert. Keep moving. Avoid the shadows. And whatever you do\u2026 walk toward the light.", "short_description": "Trapped in the endless, echoing depths of surreal poolrooms, you must evade lurking horrors and collect power supplies to find your way out. Follow the light\u2014but beware what's hiding in the dark."}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_u
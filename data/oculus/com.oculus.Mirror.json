 horror\n \u25cfGame system \n\u30fb Try to have experience with the fear horror that appeared in the Japanese style room of VR\u2019s space the same as \u201cSisters Game\u201d of GearVR. \n\u25cfAppeal point of game \n\u30fbKnown as the first of Japanese horror by VR Game \u30fbNo more VR sickness \n\u25cfOperation \n\u30fbOculusRift + Unity (edited)", "short_description": "You can experience horror like a Japanese horror movie such as game concept \"Ring\", \"Dark Water Bottom\"."}]}, "developer_name": "IsaoOhta", "developer_privacy_policy_url": "https://docs.google.com/document/d/1lTmd_qQkWmMYhlYJHbpA6EfyxZqKsDaww8wDqm2T2w0/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1i0TKs843zUUlntcIbjE7bfPULjjsAjb07L_Fj7CfUB8/edit?usp=sharing", "publisher_name": "IsaoOhta", "support_website_url": null, "website_url": "https://twitter.com/UnagiHuman", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4860112027386744"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386220_769637036757595_2681126088918171648_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvaRJKkxTxEQ7kNvwFjvSZ2&_nc_oc=AdmHcwUzicvuy3w_rPmbLDksTeneDWpBqty81I0DOl3hZjCKHDB45eEzIHApM9E5bWM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwrbw7BaqpQsFiQaBr1-9a8TTJ1IIDgcIkFKHzKPs9GAw&oe=69BA8FAA"}, "is_concept": false, "is_test": false, "is_tria
2.oculuscdn.com/v/t64.5771-25/473391768_963312572030914_5301759794664459978_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nyt-wWVo_kgQ7kNvwHZI43i&_nc_oc=AdqJiLXZHin5cWvvwTWPZhWtn_0UuAY2Q3HAM_uZNb3POE2aug2brHGkVaQOf_8mawM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-o2Np4-gl-1N9bttaxJpFZS-z5Q57SN9VJzp54nDYJw&oe=69EF5D46"}, "display_name": "Imposter Killer", "keywords": ["Space", "Killer", "Imposter"], "long_description": "Deep in space, a crew is working together to keep their spaceship running. But one of them is not who they seem! In Imposter Killer, you must eliminate your crewmates without raising suspicion. Sneak, sabotage, and strike at the perfect moment to take control of the ship. But beware\u2014others are watching, and if they catch you, it's game over! Can you be the last one standing?", "short_description": "Survive aboard a spaceship! Eliminate your crewmates without getting caught, sabotage systems, and outsmart everyone. But be careful\u2014someone might be watching you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
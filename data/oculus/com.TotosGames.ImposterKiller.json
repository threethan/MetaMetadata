uluscdn.com/v/t64.5771-25/473393309_3896540010612630_1280587491053033695_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAQjNKjk-aQQ7kNvwHf-enE&_nc_oc=AdqsfM2u9AifBiLpCth0wxnw_t36SJgbPaVH_JS7jQTomizUS1N4ZG2RjO9ccuMzeBg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1jDajUIB_d0ZJE_x0uGhC982lyu9R1JYSdI-c1C62CA&oe=6B0866DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Imposter_Killer_Landscape.png", "id": "963312568697581", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391768_963312572030914_5301759794664459978_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxk-drAONXMQ7kNvwHj_el2&_nc_oc=AdpyT2BeMFlPBhTlh62vFIQJ8qj9WLWiTX8wYgf1gVoe1n9H9yNls4HrSFDmJTykiEU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpPuyQ3TXWDQ-uB6hekMrXIBkPFJ9jYOHRF4aJGKOxUQ&oe=6B086506"}, "display_name": "Imposter Killer", "keywords": ["Space", "Killer", "Imposter"], "long_description": "Deep in space, a crew is working together to keep their spaceship running. But one of them is not who they seem! In Imposter Killer, you must eliminate your crewmates without raising suspicion. Sneak, sabotage, and strike at the perfect moment to take control of the ship. But beware\u2014others are watching, and if they catch you, it's game over! Can you be the last one standing?", "short_description": "Survive aboard a spaceship! Eliminate your crewmates without getting caught, sabotage systems, and outsmart everyone. But be careful\u2014someone might be watching you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
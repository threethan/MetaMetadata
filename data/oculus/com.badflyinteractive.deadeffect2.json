vwGyLcyO&_nc_oc=Adk9uhFxRhpj5FYgaYxKiwtrM89y9-YSuLAax6zX_tzg7iG19_Vv6k6pyVp6mwks2io&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4-RZ69ObfXW58i8PHVzovo9r4aSFLrencP2bClBKisA&oe=699D9505"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyOLuw72OxoQ7kNvwFUZmQo&_nc_oc=Adl4BNfLeV8W128A_K88Mgs-njEW6P6ZwH3XEZ2IuZh0Dj8tJ_OjlheoLbkIZROxqWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvz87Xqvo7w5KZzD87OktleTE6hIOX22S6_WyU4hDxUKA&oe=699D979E"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1WEGsxPYjMQ7kNvwGmV-2x&_nc_oc=AdkoxsIWi68YvJxfCGiDVGZdPOeD-avCTfqLf576VhTMWjaEQJD9GokeIS3jc01Ls4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvHusWL481UsyNG8gGJXYJi5EQYs6ZRKxPCYJ-d_PjX8A&oe=699D8BBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbT8WEcM0ykQ7kNvwHEKwQH&_nc_oc=Adl5Tr2c5yxC7vFdJmR_1PsYXJgGKadVvD9v5GsqypTO_cV1ll1WVMmPg-EzP1eIQwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftcG6lW6X0EMq41eI1g3CL2Pvzralf3SjgeTeY33znXOg&oe=699DAFEA"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deadeffectgame.com/files/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "https://www.deadeffectgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "ru", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "339158504785878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v
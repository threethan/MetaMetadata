8686159446039977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ_T4HTlw8sQ7kNvwGHQ-Xf&_nc_oc=AdkymsbACLXJuI9bFphU8efew4rubKC0qZWBLTgqpbmO4HD40tIQlHp7j8n9iN-zmkE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy3J_R2LljNdficYll5ntltR6D6k3NLFPANosP1z2t-sA&oe=69B3FE85"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4FtaRUlwWgQ7kNvwH1UCXV&_nc_oc=AdmAzgYDjCD-lGQGpr74DE-XRogjlPq5fj2xypVgNyPQnCw_7W0GHb-Rzwe76AbJlp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHMllkcRk_jjFANV9Ye1ouQrEdreZaINSBFJrgkWS6Mg&oe=69B4011E"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_AAGwrQrwIQ7kNvwEyvX5X&_nc_oc=AdnaYipOT35YiD5vDBcyGzeHrpLjXcHOHx2ttSEccXfJWK9W8dD0lfbwt-SIgfWipYI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwTbN96YrUzlracA7QmSjG1vIJqU5PhJmE4iwScUFWlTQ&oe=69B3F53C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdBHuodS7KAQ7kNvwH_baBf&_nc_oc=AdkDexaSOAzr_FT_oAHLQpZ-gRr5Z1NZ7E5II0XkeDELDeBdwEQ90bJtsU-M8VpzlxI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz0-R8UHerYM1vJxuH6LzKDz3Pd5sD55fcQ3A-DOMh4Uw&oe=69B4196A"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deadeffectgame.com/files/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "https://www.deadeffectgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "ru", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
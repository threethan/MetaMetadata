bEcUomCJUTWqCm3hjQ&oe=6A107FC5"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWjbNI6_W8oQ7kNvwHwx6Dk&_nc_oc=AdrfpajPK9rRsv1zStGucdZCdOr0-GukzrXyUdPUtbMaH9rl3Fn_kLkPco4deNq2Pls&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-t4r-ma0J7WvnyCnLim0tnetM53IA6mb1glJV-OQTPA&oe=6A104A1E"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdZ4M5A1LCoQ7kNvwG4Jet9&_nc_oc=AdqhfmQEuj-pU45LpG7HS9ZNLXjsYrBY5FeZP-HTLYCmU8KCc3p4QQRZiwBaYZRnwmE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WWEbaW3FWsnZpr4735vhxPPaMddpU4niatGD1rEFY6Q&oe=6A10767C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_GSoPdSjQkQ7kNvwGhZaJi&_nc_oc=AdomvnIy4abxjMy5xMuZDkOspUlshA3doKIpv0zKGWgf92GQyog8wCX-N1f993qQSDw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aWfxbC2XrobkVWsDO7_tOv9IHdwhHI0B5sLcEpjdJew&oe=6A10626A"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "http://badflyinteractive.com/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "http://deadeffect2.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "ru", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1107802419976754"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "969127690506526"}]}, "baseline_offer": {"id": "969127690506526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1623168000, "status": "PUBLISHED
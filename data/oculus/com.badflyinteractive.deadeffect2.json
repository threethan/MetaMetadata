_qMSTkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmMq3kqAyFRzgG7t73W_QK3vFHoW5TUqkM5i3d8MF5_w&oe=6B0EEC95"}, {"file_name": "3.png", "id": "706298643393793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_706298646727126_528686159446039977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2Y5KehCoMUQ7kNvwHo6U9W&_nc_oc=AdqjD8_5A5GWuSkvOLyayh0N4vOGI-oJfQ3VcuPDL4Y35uQz5ry5oIN2owjFGzrPTos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVRCCON6H0FyO1bcAXJZD7IdI1fgkPWoho7jVyfUhG5mQ&oe=6B0EF145"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQtKbXXoKIUQ7kNvwEHiXhr&_nc_oc=AdoyLfyFs9ay90m3xoNmBzrbm8cqI3OdPbEyv9uX21fJ2JPimDh8FCg3XYdpjWcJYTY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxN6XhZIyV67v058EqYEvtuBS0SqXDqCPgnKaPLTb1tQ&oe=6B0EF3DE"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWIzStZ0FK0Q7kNvwHP7Ns8&_nc_oc=Adpt1AzYpOa2in53cUkbbbuHy6cxJlUv0fcgXKWabb2OASkNDDTxZs37W8hvLmQuDZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyraIctl-TrM6u-JUkGC9ugLD4ISgpf0hCSGnhPDJqkw&oe=6B0F203C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4M5ms7NZ7gQ7kNvwHYbdFq&_nc_oc=AdoMywTWGecyUm8C5SPPkxKdiQwrxEat0PIjupqVBXvgLuGmKaB_20uy-ApNuuYk-Q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX08lej6bmYly9OROR2TrTnkF9nXLJGWPo6mtYYYgoSLg&oe=6B0F0C2A"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deadeffectgame.com/files/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "https://www.deadeffectgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection"
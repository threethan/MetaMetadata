m2yR_Ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREleAwaHoLEkMthK5fa1N3T1amJx-LRaln6sCnEBP3Bg&oe=6B01BD95"}, {"file_name": "3.png", "id": "706298643393793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_706298646727126_528686159446039977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2voDlP0SldgQ7kNvwFun8ZJ&_nc_oc=AdoXyrQiCCwp9InrWF6lg8lDo-fG6NqGznljFfC4At8dmI2bl9nipEBSQGQLxzfJbU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFcUIL7E4gN20M_0BJALslmFSd3a3bcpB4jYzSAtiETg&oe=6B01C245"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NsmZ_cW7ikQ7kNvwH7I0tU&_nc_oc=Adr7hukAHMQp_41MzwDA0VQnWlQpSlx-cHWcKu2jJVQ1lkwA5UXtTBXCMKCe7okJlYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT4RCRD02Awu0w4tjSNbqkLwXW8grEQ0UGcBWuM-8amg&oe=6B01C4DE"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMFtThxKrxsQ7kNvwFykrgL&_nc_oc=AdpBZPCXUWefHh35ds5-zPLZogFmwISOFq6rZq7agl3WrYSQ4A-IrnUk4pIZIebm768&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGydd6iK10c36FdD-6H0S2W6-shNwNSDpSCQPm0ZerrA&oe=6B01B8FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqXHguLrGcsQ7kNvwFWwg_L&_nc_oc=AdoGpzU5mCpEirSwwXtIjc5kLiZytyrNOO917jyjtuMjso_mZh2S92Vq9-3d93d06k4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyQ0d6SFUNC5XKZR8W9N7eQzlatZATS89JYvbfLfXHCw&oe=6B01DD2A"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deadeffectgame.com/files/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "https://www.deadeffectgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection"
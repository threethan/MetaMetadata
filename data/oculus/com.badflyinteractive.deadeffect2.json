/v/t64.5771-25/39003228_706298646727126_528686159446039977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLK1sUe6Rz8Q7kNvwFuR7QF&_nc_oc=AdpnpykEqM3RXhJoSrM1aF2FNhcAMDoZTR7EViP-XI5307lnL96jkSm8XR3tdsK-4TE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kFn2iHvx44qmr-41012_n8Td9bLe-ZakzXtVC2GQ4Ug&oe=6A119905"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWjbNI6_W8oQ7kNvwFU2br-&_nc_oc=Adqsdp7a3kHvwZgW3QWZIgLuV_ooSmok6y6y4ucgHQnpTdryW2xeDhj5UtBSOs6TTqQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KRSZzcNcYAvE5yGbB24MWx7PoYa1srZsvpv0UBIb-DQ&oe=6A119B9E"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdZ4M5A1LCoQ7kNvwGylKnK&_nc_oc=Adoj0OvrMSPE1spaXSnf60qLMcxc72u7RcGhJuYtnHOpyoVMXQlMbO9blmOxWtuC_zM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xxPGgXLFh2Jb7e42qVPJ6gSRxY9klOsgA_ehxaEKVOw&oe=6A11C7FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_GSoPdSjQkQ7kNvwEW9csd&_nc_oc=AdrJw0EiXQwzAFFOl6TwHn34QiCPJL4kYL7ZmnjwMTtxyYogC4u6ePfh_4ZNvBUU_IE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58CVtknGmEqw03grNIQ1LEX9HpIfe64yx-G4BiXV7fBQ&oe=6A11B3EA"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deadeffectgame.com/files/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "https://www.deadeffectgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "ru", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_
ssUEKn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE7dQRV2x3zQbSlP1N4kNn6kb0ftjwaFmjxX-J1upV5w&oe=6B006C15"}, {"file_name": "3.png", "id": "706298643393793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_706298646727126_528686159446039977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2voDlP0SldgQ7kNvwGHf3hK&_nc_oc=Adp1PW3cHs7RZ2Xaj97syjrKgbbnymAVGHTLSP_S3rApOCkA0VGINIu2JeUYhiOxOFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh2gV-YixWT8sl-uzMPc2GSn4i5ZAXYgDfyOw60b_W3Q&oe=6B0070C5"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XL26OkmesEQ7kNvwGmad4u&_nc_oc=Adqxq2DaBV9NWm6cbbUr1IiChNcX2_ZPsGdE5GKtDZdCW78t362yGGeQSXZlK6M_m7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkAkhnfT_zFUapEGYoPUyR472a1sjWgHEnPHpBMZm-1g&oe=6B00735E"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMFtThxKrxsQ7kNvwHWp9QK&_nc_oc=AdqhTgEeuq5wI_f9OP54vno7FneVQUtyeJgQnNfof0TUjs0JNNFSPhA-08gOzioa54o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb75ESVPiHePrGgWMNBSNgxHTZRZy14Uy5jcdOp_1kQw&oe=6B00677C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzOmL4NwJlEQ7kNvwHIJel-&_nc_oc=Adr3FINO_KBtCjJnFQ7zynnRxsCFw8ucoVnEbn2-tQR6vSM8DHpQFnACtCLYBTAlsWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3gWQ1PxXTakBGY2YZW7SDh-aEaB3jFsx5LNBOx3tKIg&oe=6B00536A"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deadeffectgame.com/files/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "https://www.deadeffectgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection"
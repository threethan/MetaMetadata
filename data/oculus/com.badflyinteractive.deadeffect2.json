vwGSe4zG&_nc_oc=Adlav7aQacesZRv3Me6rfy7OmdD-ezN7rzM9qBJRjRvefl7X_9bOpqJxLZ9QSAW_NcQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsPsL9dDgqi2u5zRs6rDxVIj3mkVzICcVNoEymYjmD_bQ&oe=69A18985"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM-wmpvWg1wQ7kNvwHyTtbr&_nc_oc=AdnnSAquqn8dYbU0cXz1n-hsp31PoLGuXDGfMAGqBW4ik2LpChxTlyAhbBhKJnbXga8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftLGKZoXrMlz4NDxb_uBpkfdwfBwffxmEh2ZzLTQDcJvQ&oe=69A18C1E"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q64HYSLiq-gQ7kNvwFM00QM&_nc_oc=AdmdHjyeZuQYoYccjI9pegElZLLbGYrFlvngdgj-aeVuWZ8y-a3YmqMNksQeBX8vB7A&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsAq4eEPC8X4XpeSs-GKhj4LDj6EndU5CJRV8Cv6_RVnA&oe=69A1803C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5VAP2Qw4YoQ7kNvwGTKT3x&_nc_oc=AdnvXOErYIqmunTyBAs0X-vCMuIHVoVCQNo5PtB_To4pFEZHk3SVTPKwsT_y57nLVzc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs6zz8Q3KhELTFXVwKObCJ2cyu2vZ17aDNL5eL8mXpPUg&oe=69A1A46A"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deadeffectgame.com/files/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "https://www.deadeffectgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "ru", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "339158504785878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v
7I8mmQk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvr3u5eSErrxDRgPzjfFEG0-5oex82I6iAkNQk1JnY0Q&oe=6B030F15"}, {"file_name": "3.png", "id": "706298643393793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003228_706298646727126_528686159446039977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2voDlP0SldgQ7kNvwH9xK3W&_nc_oc=Adq2e336l1VK62v83v6K6fgfpsU8aqiMzYhcr9ZsEgSw8fyY2MhpbT52tGmPMnZyxrk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTBSItGnV1McbDrs86hOhPmzL-GT3AX93bupde2oK8vA&oe=6B0313C5"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NsmZ_cW7ikQ7kNvwED2mRy&_nc_oc=AdqCw9B8x1dDRlXlMEFaVU8UIqINjd-DYjO4j6MxrDpFGYAzQjATcNDgjXvOcx06dmg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnTuI9VjC6kTnHzhMtea1jPPyxzPYUebdo_01alVfI0Q&oe=6B03165E"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMFtThxKrxsQ7kNvwEicvNN&_nc_oc=AdqUZbgySqZVbzC8AaDE-wEnnIb9BaquFg27_9tfK1AwAPuumsTrwfhoTGGMe-LEKcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6f9YT2cldCAuk5X3qaK_WTLOqaeFi3zYqlS_HXFnjZQ&oe=6B030A7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqXHguLrGcsQ7kNvwEUPDe7&_nc_oc=Adr8RRj7DiEJ1HOlVetb6Il-Coj5lTKs0u5bhNc_l90SP0yP9qykXPV9C6QDe7uYbsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaQSYHAGmgyDmr7CoRh8qOkfQl2HZDFLo_nrgVaM4QOA&oe=6B032EAA"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deadeffectgame.com/files/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "https://www.deadeffectgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection"
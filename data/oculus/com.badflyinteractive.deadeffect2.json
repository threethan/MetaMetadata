vwGKEW_u&_nc_oc=AdksXQIou1Toz9SbvDDixyudU6wN2Foy1MtKYJiWBkHsl16HQcinQyGwlj-7jwVyvE8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuF55amXS_iQPVfeazKMKeV_sYnbm-BDF5BdMtkPpLRrQ&oe=69A57E05"}, {"file_name": "4.png", "id": "2840857416134916", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkP7FW3M3UwQ7kNvwHd3Ctn&_nc_oc=AdmLUMGEWWvFCBf53faPUoM8KuJ5OnsXXYFtgISVVIk2IOB2gybzcDC1aI6g1QmMJAk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsAtzi_3YmfGmQEqUAunozwpJN-ZHfMPIGu5yE9PveEEQ&oe=69A5809E"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Yvo3xcC_4UQ7kNvwE1nHfh&_nc_oc=AdlM5TkQa7v2I9jE7OtwceERcsMfQUQM74t08ay5EzNyr8a0-FgGGjhQui7GAt-hkmw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuyXWX8YG0hSZw9cdbMIlXU2JtvKtM2IfQGBqRRLD6MoA&oe=69A574BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W84N9WeZEkQQ7kNvwHepv8q&_nc_oc=AdlAlAxAHaz9tNWnyU_1J0MGnTrqbCzw2on1SozwWE3WxfsFdXOZ52IoqHzibk5QewU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afvw4uwj8VmMVNuIeCuedAJXJ3WbFvf3xJw8k5EvQ-yhWQ&oe=69A598EA"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deadeffectgame.com/files/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "https://www.deadeffectgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "ru", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "339158504785878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v
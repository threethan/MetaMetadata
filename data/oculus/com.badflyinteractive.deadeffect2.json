://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982454_2840857419468249_324405157899133978_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itzulhskFd0Q7kNvwGDnpPJ&_nc_oc=Admz4DYeOEriNrXGciYvJqQB7PI9OY6J4DAmjtlJqYOvzE26cj7Zz4a8AzGh_V5T4gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8mrybdzjNJDLfgYaqwjxHd_GXo_7ncQjsCB0RGCdg5A&oe=69BE8D1E"}, {"file_name": "2.png", "id": "497175857941650", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982471_497175864608316_5820087948146634642_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIjHdR16F2oQ7kNvwH4Q0fB&_nc_oc=Adlxga-v8_WTuPNb3s9oPVhhZaWRzEpYbmadgxhgKOWJ7Yy52YfVskwHZyz0t7ympxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJjOxMlI9QIQJlI5hH40ewEEMtJJxaVWtYzstEzgfs3g&oe=69BE813C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "2884495895156353", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001662_2884495898489686_3878853885529707790_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-vWOx6S-p0Q7kNvwGmc4Um&_nc_oc=AdnG14JP1IJDU_S2NZ8wy3OgjBVZrsGo9t2lbzQLTDFO36dlxkCswaMQZRdUjZx1UoU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeItw02KQOyFK4qSPNz9nrt3OHoFgxsrgFCW8skhbO4A&oe=69BEA56A"}, "display_name": "Dead Effect 2", "keywords": [], "long_description": "Dead Effect 2 is the newest addition to the acclaimed Dead Effect franchise. This action sci-fi shooter is looking to push the boundaries of first-person shooters to new levels with slick graphics, rich narrative and RPG elements.\n\nYour hero adapts, grows and gets better as you play. Help them along the way by choosing the best gear!  Get 30+ upgradable weapons of all kinds \u2013 pistols, shotguns, plasma guns, bows, swords... you name it. Collect 100+ gear items and implants. Collect dozens of gear sets, from Regular to Mythical.\nPut together a complete gear set to gain special abilities. Equip your hero with a selection of 10+ special abilities, from bullet time to force field. Try high-tech body implants to increase your character\u2019s performance\n\nYou know you are not alone on this ship. There are friends, and there are foes. Sadly, the friends are outnumbered. Test your strength against zombies, soldiers, cyborgs, mutant, cannibals, mechanical dogs, drones and many more\n", "short_description": "Dead Effect 2 is action sci-fi shooter. Play the single-player missions at your own pace. Train, develop your character, collect and upgrade countless weapons, gear and body implants and take control of the monster-infested ship."}]}, "developer_name": null, "developer_privacy_policy_url": "http://badflyinteractive.com/privacypolicy_de2_mobile_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "AppHoldings", "support_website_url": null, "website_url": "http://deadeffect2.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "ru", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1107802419976754"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "969127690506526"}]}, "baseline_offer": {"id": "969127690506526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1623168000, "status": "PUBLISHED", "id": "969127690506526"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Android
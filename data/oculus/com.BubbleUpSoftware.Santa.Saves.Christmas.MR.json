M5Mzw3qwA9hwIwpdwimSjSYQSAJSTZSPY-oBPA69jvPP_Jd9IxEtkc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dMv4uWcKbb7TgNquzC2fgFWnrKiYwtHISURESwHAO4A&oe=69FF2AF7"}, {"file_name": "sc3.png", "id": "1125412019026198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422395_1125412022359531_2032876857093721217_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJCG7OgUm3QQ7kNvwGWD2gz&_nc_oc=AdpGcONr-7pSrvhlr7aqx_KpwUY9P13snf5ocy7u6uQ79FSw9WNR1GQwPrUAxOhlrIo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45Cum_ZUnrwxSSkQ6WN3H_PMbGuTTOb--Im1UuNYUoSA&oe=69FF2A7E"}, {"file_name": "sc4.png", "id": "528188520222122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036638_528188523555455_5810238105385172160_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwwLRUlu-TEQ7kNvwFVOekz&_nc_oc=AdpE72Gj-vNJjWw2d-hOg_5ySbXjMK977l_0UQ8QHbJa8MzhPIgINd_6cqeBYatpWXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_oKW5O2Mq1vbTMA_grve1qoPn3o-cS4iuC5_lNUQBFA&oe=69FF44CD"}, {"file_name": "sc5.png", "id": "558376423630303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_558376426963636_7842601909427612917_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyfSmxvKhiwQ7kNvwGRVrCy&_nc_oc=Adp1fFCDhIaI7yowUY1cMiJ6wvFIYo1R5Chv02KoTBp-gFI9Zn5FkzpGk9VK0jLsw20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wn3d-4YTZLNIP0FyHxCaE1IZDdsK9vokAL8tlAD63ZQ&oe=69FF1DEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Saves Christmas VR V1", "keywords": [], "long_description": "This is a fun game for all the family. Santa Sleigh has given his reindeer the night off and he's using his helicopter propelled sleigh. It's your job to parachute presents onto all the houses to move to the next town. You have a limited amount of time and presents to complete your task. When a present lands on a house it will light up and move onto the next house light up and the houses and the game is won. At random intervals an alarm clock will parachute into the play area, shoot it before it hits the ground, and you will be rewarded with ten seconds added to the clock and two extra presents.", "short_description": "Help Santa deliver Christmas to the town presents by parachuting presents from his sleigh onto the houses. Once a present lands on a house the house will lit up. Drop presents on all the houses before your time and presents runs out too advance to the next level.  Santa Sleigh must be four feet above the ground to drop presents. This is a free game with no advertisements. It's still work in progress, and I would welcome feedback. Merry Christmas.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ukflyb0y117/PrivacyPolicy/blob/main/bubbleupsoftware", "developer_terms_of_service_url": null, "publisher_name": "Bubble Up Software", "support_website_url": null, "website_url": "https://goodwillwebworks.com/santasaveschristmas/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28019028144409819"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570294_2910328602477013_7826060069823290432_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp-TNLA3dHoQ7kNv
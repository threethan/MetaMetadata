vzD1cWQYEVFs2hYyhjzr6jjCXjpTtbdLFOBdubo5ye-5PUAbMm5ETnyVAtjDg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41f4EOIH9NiTWUMjyJRJi6DcUcmsLkUmUbe0UdSZCuWw&oe=6A119FF7"}, {"file_name": "sc3.png", "id": "1125412019026198", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75422395_1125412022359531_2032876857093721217_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a8Sg_Y-O2kQ7kNvwFlx1nS&_nc_oc=Adph0dB853JgtGclx7R55IHHTkq8pqudj6wTHHXDJ2zXCUlSbyWUlcM6SM3q9JFcKsI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oYw8ya_rKM0Lla_EvrkFAhRpphZWHxxckyofh64VSdw&oe=6A119F7E"}, {"file_name": "sc4.png", "id": "528188520222122", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036638_528188523555455_5810238105385172160_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1BNoipvQC8Q7kNvwFXsneS&_nc_oc=Adq6nTg-HpEsSJbxMpaws1_YDi-i7lSgiZkzFtqSAqmA9pffLXW93Od1nTCKnw9GE5M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BXLomyRo9KOd86cBM_gDPp8xpsZej5DQgQMtNDxWEqQ&oe=6A11B9CD"}, {"file_name": "sc5.png", "id": "558376423630303", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001725_558376426963636_7842601909427612917_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50c4MVkVJTwQ7kNvwG2A7f6&_nc_oc=AdpLtfOqzDRroMZWPwubA3n2pGRaKn_q_0RSFfrW4SOxAP3WDcFwLwytiz7dE221Oxw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W2XEUwS7NOE3m5wRLJKhNEf8GS3v8lk-lGRI8ffeYDg&oe=6A11CB2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Saves Christmas VR V1", "keywords": [], "long_description": "This is a fun game for all the family. Santa Sleigh has given his reindeer the night off and he's using his helicopter propelled sleigh. It's your job to parachute presents onto all the houses to move to the next town. You have a limited amount of time and presents to complete your task. When a present lands on a house it will light up and move onto the next house light up and the houses and the game is won. At random intervals an alarm clock will parachute into the play area, shoot it before it hits the ground, and you will be rewarded with ten seconds added to the clock and two extra presents.", "short_description": "Help Santa deliver Christmas to the town presents by parachuting presents from his sleigh onto the houses. Once a present lands on a house the house will lit up. Drop presents on all the houses before your time and presents runs out too advance to the next level.  Santa Sleigh must be four feet above the ground to drop presents. This is a free game with no advertisements. It's still work in progress, and I would welcome feedback. Merry Christmas.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ukflyb0y117/PrivacyPolicy/blob/main/bubbleupsoftware", "developer_terms_of_service_url": null, "publisher_name": "Bubble Up Software", "support_website_url": null, "website_url": "https://goodwillwebworks.com/santasaveschristmas/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28019028144409819"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57570294_2910328602477013_7826060069823290432_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI
XbYtwLzLkpZfoBpg54nyXCTFm2oS3yjUmVAE3TN6NIAxrTXFmdn6CA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9i4jvNVnymDQ_-tQX0GetW4Q_DBWSlDh4yD2iuQNUlA&oe=6A4E44F7"}, {"file_name": "sc3.png", "id": "1125412019026198", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422395_1125412022359531_2032876857093721217_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFxwEcZDBrAQ7kNvwHTZrbl&_nc_oc=AdphckWOcSVjZjGxy_h0QDeKpK37H35nHS-3ibm4WoaTJ1NNBn2g5pyiQPkDhWXkFWA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBYNacjJYWUYudLLklJzAyurnaNFHVX299Jlj7emv46Q&oe=6A4E447E"}, {"file_name": "sc4.png", "id": "528188520222122", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036638_528188523555455_5810238105385172160_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXaErhSs0xkQ7kNvwEc8mri&_nc_oc=AdokJkQuB9f5QTY6B3xWYtTc_9vz0vfTpkr2bWIM9DmmfUT9ZC6rGA-Z62QJ_PsDcA8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFFvU6W7YpfgU1SXBNQdMOtFibS2mWfMlmUIUKR_2Mtw&oe=6A4E5ECD"}, {"file_name": "sc5.png", "id": "558376423630303", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001725_558376426963636_7842601909427612917_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IG5V6Fe9CEQ7kNvwHrUhrF&_nc_oc=AdqNYZnGFdMlZjBTv5xmMTWL7cF9gIRzbhgtTSl8O_nOdFZQNYFwbAE1lhc68wsG5cA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG43VveUNn34kvU7G7FeN3rTxiKApBUYeWhcAmnBFw3A&oe=6A4E37EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Saves Christmas VR V1", "keywords": [], "long_description": "This is a fun game for all the family. Santa Sleigh has given his reindeer the night off and he's using his helicopter propelled sleigh. It's your job to parachute presents onto all the houses to move to the next town. You have a limited amount of time and presents to complete your task. When a present lands on a house it will light up and move onto the next house light up and the houses and the game is won. At random intervals an alarm clock will parachute into the play area, shoot it before it hits the ground, and you will be rewarded with ten seconds added to the clock and two extra presents.", "short_description": "Help Santa deliver Christmas to the town presents by parachuting presents from his sleigh onto the houses. Once a present lands on a house the house will lit up. Drop presents on all the houses before your time and presents runs out too advance to the next level.  Santa Sleigh must be four feet above the ground to drop presents. This is a free game with no advertisements. It's still work in progress, and I would welcome feedback. Merry Christmas.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ukflyb0y117/PrivacyPolicy/blob/main/bubbleupsoftware", "developer_terms_of_service_url": null, "publisher_name": "Bubble Up Software", "support_website_url": null, "website_url": "https://goodwillwebworks.com/santasaveschristmas/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28019028144409819"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57570294_2910328602477013_7826060069823290432_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wgq-PwNjQcQ7kNv
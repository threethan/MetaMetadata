5412022359531_2032876857093721217_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TiYJCG4zzUQ7kNvwF2rqVI&_nc_oc=AdoKFHPp9XudjymX1-KWivokGz9rovze2_-33UKByyOB4u2MtUIi26MQcDtInu3ewY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEGHvbgUrxf5PogR4xq91zxjV1TM5o5ompap2CKucTkQ&oe=6B00773E"}, {"file_name": "sc4.png", "id": "528188520222122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036638_528188523555455_5810238105385172160_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_7YeimVHwsQ7kNvwHeFgKu&_nc_oc=AdokwCbZQ_CrPcV-UggBt7MNtgPJjZUwWEZbB6LVm883OX2UKCLW9lFJ69MrzdMmQTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiH8UldZMkiJjxphitgJvkV4tHenGOs4ZYwbB6bjenNQ&oe=6B00594D"}, {"file_name": "sc5.png", "id": "558376423630303", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_558376426963636_7842601909427612917_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQ6N1HFP_f4Q7kNvwH4vzsA&_nc_oc=AdpqHV3irNQH8-k_CZASSCNq8aORCpsK9rOEsDGImSOYPNXR38Wrg4L_aDIXbHqxGnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDN0MG18eyNLRRnRpJKev8qe0uDad6y885eU0obMy0NA&oe=6B006AAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Saves Christmas VR V1", "keywords": [], "long_description": "This is a fun game for all the family. Santa Sleigh has given his reindeer the night off and he's using his helicopter propelled sleigh. It's your job to parachute presents onto all the houses to move to the next town. You have a limited amount of time and presents to complete your task. When a present lands on a house it will light up and move onto the next house light up and the houses and the game is won. At random intervals an alarm clock will parachute into the play area, shoot it before it hits the ground, and you will be rewarded with ten seconds added to the clock and two extra presents.", "short_description": "Help Santa deliver Christmas to the town presents by parachuting presents from his sleigh onto the houses. Once a present lands on a house the house will lit up. Drop presents on all the houses before your time and presents runs out too advance to the next level.  Santa Sleigh must be four feet above the ground to drop presents. This is a free game with no advertisements. It's still work in progress, and I would welcome feedback. Merry Christmas.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ukflyb0y117/PrivacyPolicy/blob/main/bubbleupsoftware", "developer_terms_of_service_url": null, "publisher_name": "Bubble Up Software", "support_website_url": null, "website_url": "https://goodwillwebworks.com/santasaveschristmas/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28019028144409819"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1973209023166100"}]}, "baseline_offer": {"id": "1973209023166100"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735956960, "status": "PUBLISHED", "id": "1973209023166100"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27991640427148591", "version": "0.1.0"}, "id": "1702272477222094", 
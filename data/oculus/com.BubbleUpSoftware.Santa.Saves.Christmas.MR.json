5412022359531_2032876857093721217_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEPRcmacU5AQ7kNvwHqa_HB&_nc_oc=AdqbWoZaLkYfF47dXDutOFMjO3xrKP_YAsGmwaFy3xBkY0vyddXRLqeaf0vHKOyyBg4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzfFPAv_iRj-_5le0SUDeCi_PHATlErT9_3U9mvg3lKQ&oe=6AFC82BE"}, {"file_name": "sc4.png", "id": "528188520222122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036638_528188523555455_5810238105385172160_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlj2j82GLXgQ7kNvwEKIiup&_nc_oc=AdrKKaBZ04CCqcjOhb2rsZOPyKWC8whQ3HEvQZJBDhy9FAURBUlI7OcT7j_B4FhGNlA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuxptJtJc48TAKRRIqt4_WzRWApkyr6l1ToE_UWNQzew&oe=6AFC64CD"}, {"file_name": "sc5.png", "id": "558376423630303", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001725_558376426963636_7842601909427612917_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwSwP3q4k9gQ7kNvwG-tzDU&_nc_oc=AdplC2FKGaYvEYyonivwOQeUtga8eOFo0gaCYuQfKiDPpHGJHvXPgFNdcBmFVOZlq3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4WfUqiy00X4uC_k8wWoED6LIBd94b2HK_BkXpaIhvkQ&oe=6AFC762E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Saves Christmas VR V1", "keywords": [], "long_description": "This is a fun game for all the family. Santa Sleigh has given his reindeer the night off and he's using his helicopter propelled sleigh. It's your job to parachute presents onto all the houses to move to the next town. You have a limited amount of time and presents to complete your task. When a present lands on a house it will light up and move onto the next house light up and the houses and the game is won. At random intervals an alarm clock will parachute into the play area, shoot it before it hits the ground, and you will be rewarded with ten seconds added to the clock and two extra presents.", "short_description": "Help Santa deliver Christmas to the town presents by parachuting presents from his sleigh onto the houses. Once a present lands on a house the house will lit up. Drop presents on all the houses before your time and presents runs out too advance to the next level.  Santa Sleigh must be four feet above the ground to drop presents. This is a free game with no advertisements. It's still work in progress, and I would welcome feedback. Merry Christmas.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ukflyb0y117/PrivacyPolicy/blob/main/bubbleupsoftware", "developer_terms_of_service_url": null, "publisher_name": "Bubble Up Software", "support_website_url": null, "website_url": "https://goodwillwebworks.com/santasaveschristmas/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28019028144409819"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1973209023166100"}]}, "baseline_offer": {"id": "1973209023166100"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735956960, "status": "PUBLISHED", "id": "1973209023166100"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27991640427148591", "version": "0.1.0"}, "id": "1702272477222094", 
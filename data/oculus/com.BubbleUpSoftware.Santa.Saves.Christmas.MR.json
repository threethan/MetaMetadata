00_Af0-8Ozt8Q5u6nzXPfi8c3i1iBzF_6X0gWQV2uJWL1l_GQ&oe=69F0AA77"}, {"file_name": "sc3.png", "id": "1125412019026198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422395_1125412022359531_2032876857093721217_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIgQ4mAUwLQQ7kNvwG15zBj&_nc_oc=Adp0vBCkHCHMzYLN4aV-s5oTQ71H1Emt7ax8zXflj0vdN-0DyVjOnddTQLqCfNSllPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3zbi7A0EFt6mGFrheQP_23e9VThu9LymKBtyJ5D1T5eA&oe=69F0A9FE"}, {"file_name": "sc4.png", "id": "528188520222122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036638_528188523555455_5810238105385172160_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZr1_cxiz6IQ7kNvwGiIk46&_nc_oc=AdrS5HMXuEdvcxFYTVootuSDURt2fIPDZGRhg_AMv82lv0Lz3bUOpyTZnBY2McUPTng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af23j0gSxnl-SEXaIwx-qfjgq4ebRJbwvOsZcynBJrHuDQ&oe=69F0C44D"}, {"file_name": "sc5.png", "id": "558376423630303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001725_558376426963636_7842601909427612917_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waSpvLn9lHsQ7kNvwHFbxJL&_nc_oc=Adr7Ysqcj9KuSteCdWsXI4I0KFaKb19H8pQywMGztbvpSppVw0fpCiri-oIBV2dOOLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3PIsTLfjcStE7ZUjX3OIM9dFTwdIFqsRM5rQgyU8P5NA&oe=69F09D6E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Saves Christmas VR V1", "keywords": [], "long_description": "This is a fun game for all the family. Santa Sleigh has given his reindeer the night off and he's using his helicopter propelled sleigh. It's your job to parachute presents onto all the houses to move to the next town. You have a limited amount of time and presents to complete your task. When a present lands on a house it will light up and move onto the next house light up and the houses and the game is won. At random intervals an alarm clock will parachute into the play area, shoot it before it hits the ground, and you will be rewarded with ten seconds added to the clock and two extra presents.", "short_description": "Help Santa deliver Christmas to the town presents by parachuting presents from his sleigh onto the houses. Once a present lands on a house the house will lit up. Drop presents on all the houses before your time and presents runs out too advance to the next level.  Santa Sleigh must be four feet above the ground to drop presents. This is a free game with no advertisements. It's still work in progress, and I would welcome feedback. Merry Christmas.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ukflyb0y117/PrivacyPolicy/blob/main/bubbleupsoftware", "developer_terms_of_service_url": null, "publisher_name": "Bubble Up Software", "support_website_url": null, "website_url": "https://goodwillwebworks.com/santasaveschristmas/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28019028144409819"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570294_2910328602477013_7826060069823290432_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZGTLPgBHJoQ7kNvwF1k7KV&_nc_oc=AdqX8TYJE1tHnjnMpGKqNl0SZdA1hy_8P1YWwcSYbxyx-3012nBK7iRVD9XEuqDOmDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1DahuCH3LM4kTKfhW7M
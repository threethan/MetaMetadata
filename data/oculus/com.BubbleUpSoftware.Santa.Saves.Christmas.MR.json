x57T-gvLGfnTwagiL4MuxAG_kDZS1DK1CbF2Zwd4lRIIzPkXdBPHDo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0yHtb8JpnUMaZrGkPKg8sBHhgSDE16k2nxvGfZeqDDw&oe=6AA15377"}, {"file_name": "sc3.png", "id": "1125412019026198", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422395_1125412022359531_2032876857093721217_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_Vme7VdBBQQ7kNvwFQJlLY&_nc_oc=Adqb8W5JRTI4ck61ExBxaV1h1oOdMSE9l3DqJXeC1oSHiL0xu-L4IRCDVTrLodCq2f0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuKx73IPlKPUe6ZT2IBy9CrRbEZQoMOALih_vCGDxpcg&oe=6AA152FE"}, {"file_name": "sc4.png", "id": "528188520222122", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036638_528188523555455_5810238105385172160_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC9A7xP5mLgQ7kNvwE-4tx3&_nc_oc=Adr4Vd2FEGWmiovPHK_oFqJY_YIL6Zxqha4BeYKkNeCUYN49gp7PLqg_nuuYdjxygAM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZhDJA6Y6UIWeb7sJVZoIc87OpEOx2my5vOy6bhADI3g&oe=6AA16D4D"}, {"file_name": "sc5.png", "id": "558376423630303", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001725_558376426963636_7842601909427612917_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQieIv6fSj0Q7kNvwHBHBhI&_nc_oc=AdqUjJfL0JtzRyaK075LSSzJL7G0MZ_Yeni0pjQV6vLLng0LZxGbVakD3S37ByEBJ90&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO6r7CPIPmZfG6398bYfbctic293yleNh340u801dxTQ&oe=6AA17EAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Saves Christmas VR V1", "keywords": [], "long_description": "This is a fun game for all the family. Santa Sleigh has given his reindeer the night off and he's using his helicopter propelled sleigh. It's your job to parachute presents onto all the houses to move to the next town. You have a limited amount of time and presents to complete your task. When a present lands on a house it will light up and move onto the next house light up and the houses and the game is won. At random intervals an alarm clock will parachute into the play area, shoot it before it hits the ground, and you will be rewarded with ten seconds added to the clock and two extra presents.", "short_description": "Help Santa deliver Christmas to the town presents by parachuting presents from his sleigh onto the houses. Once a present lands on a house the house will lit up. Drop presents on all the houses before your time and presents runs out too advance to the next level.  Santa Sleigh must be four feet above the ground to drop presents. This is a free game with no advertisements. It's still work in progress, and I would welcome feedback. Merry Christmas.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ukflyb0y117/PrivacyPolicy/blob/main/bubbleupsoftware", "developer_terms_of_service_url": null, "publisher_name": "Bubble Up Software", "support_website_url": null, "website_url": "https://goodwillwebworks.com/santasaveschristmas/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28019028144409819"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57570294_2910328602477013_7826060069823290432_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOjaYzm61mAQ7kNv
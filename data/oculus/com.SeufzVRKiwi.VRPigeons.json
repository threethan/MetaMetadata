36_6623178810939427384_n.png", "id": "2786293468356261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_2786293471689594_9032103439860837176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64YLMjmPg64Q7kNvwHJjEbC&_nc_oc=AdlHVWnnSobyDgJWCO-QewvILNWFig2shpHtcrnFbefnpoCAtLUh5tl2hXtL9K94k3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfufYb_VnXGZXf_GXvMTyx-GmPg8gjJ4bi-4NeraLM802g&oe=699D89A1"}, {"file_name": "38982446_624168074972404_2142538377748145022_n.png", "id": "915226029009163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001713_915226032342496_2573739835754653848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah8MCN1vAmoQ7kNvwGFvBoG&_nc_oc=Adnl6-H5feOcInFrBNbUEKUbBL5DS18-Hm29kvAEMQDX0Qqr2HzVk_N7W4CQ2yKcAL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftYS_KzWBk8ik5F4yojmkT5W55VTQI0U7MStOC1GxXKQA&oe=699D939F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "723893341567913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203627_723893344901246_8222583381724327508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuttluoFwe8Q7kNvwFDZafa&_nc_oc=AdmpJzjzom3t2feZktkaSBluDiQ5Q7rJ2Fj3p7Qh-XK3btPD1AtsYzzsfCwZhk-5Kl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsep9Omkksc1aY2BGpC9IFxDZXBfC7L1N6NwdysvCSUUA&oe=699DAB81"}, "display_name": "VR Pigeons", "keywords": [], "long_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. \n\n\nEat as much bread as possible! BREAD IS LIFE!\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than\nother pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid\nunnecessary conflicts!", "short_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n"}]}, "developer_name": "Maestro Pivetta", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (Mekiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "308977607939024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1000314747114205_6157251180126451813_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOlwsFj88c0Q7kNvwEzYyhK&_nc_oc=AdmjSFqpolA9hlwOhfbccFGK9GinEL4jaNXHBxNwOb2XruBpLF4b-JqQD7wN6YGoxsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJaXh0I6eDMcfZ0HxPf09WP-nQNwLPwOvt_Ap9akGmFg&oe=699DA34D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Pigeons", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1607623252, "l
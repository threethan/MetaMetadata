VIHClju_cUqsiyUyphZKemYMPy45do0BP1FZQ&oe=69BBF7EC"}, {"file_name": "38982613_370466813929736_6623178810939427384_n.png", "id": "2786293468356261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_2786293471689594_9032103439860837176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IHqNfloyrEQ7kNvwFe74oA&_nc_oc=AdlZ5QWJLZaXqh6EvJ5XOeaJ6XYpAuqNLfA_PVZYjS8VtT0kd6VK25R3uNBE7OOW7d0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzGX8tN2ZzVpS7z7eSsiWgTTmLCxqOxV8aWTfovO4cEWw&oe=69BBDC21"}, {"file_name": "38982446_624168074972404_2142538377748145022_n.png", "id": "915226029009163", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001713_915226032342496_2573739835754653848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_kwu-tuvS4Q7kNvwGptQb9&_nc_oc=AdmLboRrFVdPH4IKijC18SoS23i0QOyfbhkJOhAe9KENysQUpEKiqsSkBV7f6VkRcgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6-g-1LFWDngbnQKQ6M_-19B4GwkOaSitSlgzswXpcUQ&oe=69BBE61F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "723893341567913", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203627_723893344901246_8222583381724327508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB4b8Y15lkgQ7kNvwEX2F1L&_nc_oc=AdmB89y3GPbnkpo90q9BbRQ54GIpbmxQMsDjy_BOsb4XwyxLjlMMMNRzpURd68yz-D8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzbMrdbdtKmlUbKbloig3FmbVzaRASM6J0JrXwR5usPCw&oe=69BBFE01"}, "display_name": "VR Pigeons", "keywords": [], "long_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. \n\n\nEat as much bread as possible! BREAD IS LIFE!\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than\nother pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid\nunnecessary conflicts!", "short_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n"}]}, "developer_name": "Maestro Pivetta", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (Mekiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "308977607939024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031315_1000314747114205_6157251180126451813_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWRmsy1BlcQQ7kNvwGfP9Ug&_nc_oc=Adnt5jkscOvsetP3_8II76AWA8GdD33mTZVfULbyAH2Puwv8tLJK9fFSgvAonGvUB7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxc7mkc6M2tkk7HzEB5cEFImauPgqqrjnM8C-HAy4IkPg&oe=69BBF5CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
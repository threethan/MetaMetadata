uluscdn.com&_nc_ss=7f20f&oh=00_Af73L-dQq0vY2X1p7k55flg8400OcZSjjvJnq6F8DJR0iw&oe=6A1ED86C"}, {"file_name": "38982613_370466813929736_6623178810939427384_n.png", "id": "2786293468356261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_2786293471689594_9032103439860837176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0l6I9-2opkQ7kNvwHWBDPu&_nc_oc=AdpLgEz4n940YfREhm9jL5N9uIDDtEI6him2NXWhN5RsUu79OxUnSrSuGEWCb73ZO9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-GD5WLjaLXuQcA3L2SS_-tecIEZrrG1a4TGCaCNPuVA&oe=6A1EF4E1"}, {"file_name": "38982446_624168074972404_2142538377748145022_n.png", "id": "915226029009163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001713_915226032342496_2573739835754653848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1qTeX84lo4Q7kNvwH8PeWs&_nc_oc=AdoY1X0g13ssbUSyldl3qzPQuwi_rEfFR9Ok6jRG0E6jcayQsSSpBU5aaUhb97ZWZCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zBE3vA6SPQTWb86HfYnwxGNtZd6zrnt2UgUPc4kcInA&oe=6A1EFEDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "723893341567913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203627_723893344901246_8222583381724327508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BJ0_q1y9fAQ7kNvwFGy7aM&_nc_oc=Adqn4AJxLOBomFR8KR8TFQHq5i36rKwg782R0F1mtrISBJ5XHHCT72wY42T35U-iKbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7buUmcrPHp5JT1nVhWEiTuMlqXDZcuNW9lzHXBeq9AsA&oe=6A1EDE81"}, "display_name": "VR Pigeons", "keywords": [], "long_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. \n\n\nEat as much bread as possible! BREAD IS LIFE!\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than\nother pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid\nunnecessary conflicts!", "short_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n"}]}, "developer_name": "Maestro Pivetta", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (Mekiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "308977607939024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1000314747114205_6157251180126451813_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OseS2Gw3Gn4Q7kNvwH6lm_5&_nc_oc=AdpS_UQSZ3NNGDrF37BUSDScgsstvipFCOn_1mmJWGu_oLO-SAWr8eydvdYsmVzTBMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pxLemd4_CAB346qKchpotFYueedFoAAEYigXgWBDq_g&oe=6A1ED64D"}, "is_concept": false
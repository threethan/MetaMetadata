uluscdn.com&_nc_ss=7f20f&oh=00_Af6xMzryFQdiPhfrC8TKcfA3plWBZDtTA1euUVeaQMYDXw&oe=69FDE2EC"}, {"file_name": "38982613_370466813929736_6623178810939427384_n.png", "id": "2786293468356261", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_2786293471689594_9032103439860837176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80EHNfJv44UQ7kNvwErNxrj&_nc_oc=AdoqW8ecs5cr1XvploSRyYEkiQao5Mi2Mc93qRNSAhpZnbcdrupg6m6uS13sZSuXOkc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73-nyqaso8mt-I1XxoWV8r4za6jXTchNvTwJkgvS8iVA&oe=69FDFF61"}, {"file_name": "38982446_624168074972404_2142538377748145022_n.png", "id": "915226029009163", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001713_915226032342496_2573739835754653848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12lLhdmDNxQQ7kNvwEP5x1l&_nc_oc=AdqyfKpp-BHtYqesQodeEpLwNjfVwhM8UehzEJ9wM1rRE__esYARe9W2vN4cHLHj9PI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J_o9sDGRMhcycqfE5Qx1psEkJIvDZHR_SUk4CdxSUrA&oe=69FDD11F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "723893341567913", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203627_723893344901246_8222583381724327508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckMlCttJW8YQ7kNvwGBP0Ok&_nc_oc=AdqEhhDLj3La6HvbF-K2djX-BoCXA1ldck-HZcSRUX-5T9GmeTbF2M6-fRFHnjCiM9M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qu1eoRmlWQPBWyE1Ln-31yNDdE4YI36ojqYHzwN0Ilw&oe=69FDE901"}, "display_name": "VR Pigeons", "keywords": [], "long_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. \n\n\nEat as much bread as possible! BREAD IS LIFE!\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than\nother pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid\nunnecessary conflicts!", "short_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n"}]}, "developer_name": "Maestro Pivetta", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (Mekiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "308977607939024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031315_1000314747114205_6157251180126451813_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU7FMa9aAeoQ7kNvwFVN7uV&_nc_oc=AdqYbrpQlwYIQrZwZX26JDy2yenBFt4uo6fFAavHiveCK9VA3kRFU6Vl8DbY68nndsI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JC4aDG2-4xqj2WbHzpZfd9E-DR2p-HlDj7wLiFSeTZA&oe=69FDE0CD"}, "is_concept": false
36_6623178810939427384_n.png", "id": "2786293468356261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_2786293471689594_9032103439860837176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oPQijkXG7oQ7kNvwFx4REm&_nc_oc=AdlHYcc99HXbBGAfNR3BfBSmw29bE_U1Wv6pdWZgjyvrEORhDxqbjkqdU3aYdxIMwtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftW6cxNbnOWk3p5LJ1ALZ32_ouQrbWFFX1eDV1S9NLR1A&oe=69A6C421"}, {"file_name": "38982446_624168074972404_2142538377748145022_n.png", "id": "915226029009163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001713_915226032342496_2573739835754653848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40U7nml1OaEQ7kNvwGAJPSa&_nc_oc=AdlRVagth6_tZyXRCO3Hb2McldXwVSSe9FyLlmvjhv6nOaTjcSJhNJHvwaiDgDG59I8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftzd6hYrSe2TQ2wJj3tl9ogRca0Ln00TwwYuCaenhCCRA&oe=69A6CE1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "723893341567913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203627_723893344901246_8222583381724327508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1-agY3_ztkQ7kNvwG9JS9V&_nc_oc=AdmLWOwsg9kNMsKU5Co9UGlHZohxWmldHVy8aSyuxXmlmpFXN0UiLq1UbuJ_sZ5Qyf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfulXY165zyqeqYRCIYV4eCCSDpQ0BRBTJ_fyj1dmev8tQ&oe=69A6E601"}, "display_name": "VR Pigeons", "keywords": [], "long_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. \n\n\nEat as much bread as possible! BREAD IS LIFE!\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than\nother pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid\nunnecessary conflicts!", "short_description": "All the world\u2019s a rooftop,\nAnd all the men and women merely pigeons.  \nUse the power of VR and absolutely unique movement\ncontrols to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the\ngranny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n"}]}, "developer_name": "Maestro Pivetta", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (Mekiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "308977607939024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1000314747114205_6157251180126451813_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAzbrYeMi1wQ7kNvwGpDndS&_nc_oc=AdlYodYC4nXClUysBpBPlFEBm8ObVjbZPAOxcqpi0iJSn3WFkGLeMK99qSsSC_R7u68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWK22kOY1y5ofIUzc4PdzM5xBrSiPlDxr88f_xBinwEw&oe=69A6DDCD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Pigeons", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1607623252, "l
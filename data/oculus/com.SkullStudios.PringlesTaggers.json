dn.com/v/t64.5771-25/673652249_1914022929975617_185634540875525923_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wP0DUlZuV30Q7kNvwE4bako&_nc_oc=AdqEDmahjCxXYicrsCJ7q0RE0qwY2GMz666wrMdunItcAydYvV86F0_RcKbCguUel1A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5_OT0G8LDENtyRaLR_XdWjXsLuawTSpFp1M4gXVYPww&oe=6B0841A8"}, {"file_name": "screenshot4.png", "id": "1627231339199117", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/756589809_1627231342532450_6554905155936849833_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUl0vlm61J0Q7kNvwGtUI0k&_nc_oc=AdqkWKQ8I1VRLPihFsNhcUb9iTZVwBzcAEkD7ayU_IKITvUxOUHdazRJ2pWkJn1iWfc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ7-oONstzhbsvYJBTSg41smc2v6hQwxTvDlZecrY0QQ&oe=6B086920"}, {"file_name": "screenshot5.png", "id": "1619721419835865", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/596068480_1619721423169198_4046421117839819891_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiaBtVY_DKoQ7kNvwE59gjU&_nc_oc=AdrZgxJ5vGQzD-4ix9HkQl-GUMwsV5Y53QEopTVlTkvH976GLg6I2t6J9gvwUCE8upU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE0a5aIEvXWxdkXIHEaFZbhHvOCjVNobgZl4aofsn_lg&oe=6B086021"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pringles Taggers", "keywords": ["Taggers", "Halloween", "Runners"], "long_description": "Pringles Taggers is a fun, fast-paced VR game inspired by the movement and gameplay of Gorilla Tag. Our goal is simple: create a fun place where players can jump in, move around, tag their friends, and enjoy VR together. Built by a passionate team of developers who love playing VR, Pringles Taggers is made for players who just want to have fun and create memorable moments. Jump into Pringles Taggers today, grab your friends, and start tagging!\n", "short_description": "Pringles Taggers is a fun, fast-paced VR game inspired by Gor
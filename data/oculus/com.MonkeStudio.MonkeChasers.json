"Monke Chasers (BROKEN)", "keywords": [], "long_description": "In this game you play as a monke and run around the maps! You can also drip your monke with cosmetics, but don't forget, this is coming out of your paycheck. There's lots of nice of nice mods but don't mess up because they have a special item with them! Enjoy being monkey because you are a monke stupid! Join the Discord: https://discord.gg/G8c9t8t9", "short_description": "This game has gorilla tag locomotion, this game is about monke, that's it. Nothing else to now expect being a monkey! Join the Discord: https://discord.gg/G8c9t8t9"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkechasers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Dxtor", "support_website_url": null, "website_url": "https://sites.google.com/view/monkechasers/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "500998575286598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974883_547717877287361_7836478486426969605_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxtdfJu5nuAQ7kNvwHJmdfg&_nc_oc=AdqDUTxu_eg5bb8CU_R89NfSSBb9s7G4VIiQSFhqTSZFd_g3HZwub7aITDs4gpddWcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8EuqKT0xMoMXrhmWvaNa-F6st6G_IDHUoCV5o9cOqUQ&oe=6A578B16"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
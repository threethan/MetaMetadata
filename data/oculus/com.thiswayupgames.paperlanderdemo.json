chipsets on those devices.", "short_description": "PaperLander is a fragile rocket made out of - you guessed it - paper. He lives in PaperGalaxy, a low gravitational fantasy world far far away, made mostly out of paper too.\n\nBuild your own PaperLander here: http://thiswayupgames.com/PaperLanderModel.pdf\n\nBut now the Galaxy is in danger. A Space Storm is approaching and threatens to tear it apart. Only one thing can stop the Storm: The Great Anti-Storm Ion Cannon! But it works only with Proto-Stars, which are scattered in the Galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thiswayupgames.com/privacy.html", "developer_terms_of_service_url": "http://thiswayupgames.com/terms.html", "publisher_name": "Self Published", "support_website_url": null, "website_url": "http://thiswayupgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "249492153891551"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "135767013734027"}]}, "baseline_offer": {"id": "135767013734027"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1507741200, "status": "PUBLISHED", "id": "135767013734027"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1572175042840730", "version": "0.8.4"}, "id": "341964979591012", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Androi
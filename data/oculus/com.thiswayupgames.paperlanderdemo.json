": "656754055136622", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162754_146317752616743_7956279778850373632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz79WLVlo0oQ7kNvwFSX3of&_nc_oc=AdpJT5hgAMTd2cHHsFU4sZCUEbvx1yyr_99q4bz51j23r8pFeYOIfbhSnX1-0yOyxzk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ms6bSDyEgIlwtsSGnxPxCcMyKCr70KZODXe4y7TdBeA&oe=6A22ECF7"}, {"file_name": "migrated_image.png", "id": "240391513818743", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162726_768510353320152_9100528013614776320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGFO4bMgL18Q7kNvwH5ykvT&_nc_oc=AdpA2rTbdisVePsZk2PONOUyu6pKZ_Ohs_A-SgxlDo9urfsSOh7q4A3xX36ue5g8t-0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YUcsKRxgwyzHFP8p3rAK181Bjf0I3ntOQ93O345xL0w&oe=6A22F9B6"}, {"file_name": "migrated_image.png", "id": "217249006022269", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162706_506076726393186_5572840046471413760_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gey1vDtueJcQ7kNvwFGmYZ2&_nc_oc=Ado4qlo8XumsfNy96OloNFEWChCaPsKZxx5h9fvkj8bcz-bZGoS_tNLki-b3IyrSz3c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vs80d2DKAxqD9LwfIQLp9BNhp2Ka9xEjDRXV7hox-ig&oe=6A22E8A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PaperLander Demo", "keywords": ["paper", "rocket", "gravity", "cute", "free"], "long_description": "PaperLander is a fragile rocket made out of - you guessed it - paper. He lives in PaperGalaxy, a low gravitational fantasy world far far away, made mostly out of paper too.\n\nBut now the Galaxy is in danger. A Space Storm is approaching and threatens to tear it apart. Only one thing can stop the Storm: The Great Anti-Storm Ion Cannon! But it works only with Proto-Stars. And Proto-Stars are scattered in the Galaxy, across its many Sectors. These Sectors are connected by a network of teleporters that activate upon landing. PaperLander's mission is to find and collect those Stars, pass through the Sectors using the teleporters and bring them to the Anti-Storm Ion Cannon in time to save the Galaxy!\n\nBuild your own PaperLander here: http://thiswayupgames.com/PaperLanderModel.pdf\n\n--------------------------------\nPlease note that this demo is not compatible with Oculus Go", "short_description": "PaperLander is a fragile rocket made out of - you guessed it - paper. He lives in PaperGalaxy, a low gravitational fantasy world far far away, made mostly out of paper too.\n\nBuild your own PaperLander here: http://thiswayupgames.com/PaperLanderModel.pdf\n\nBut now the Galaxy is in danger. A Space Storm is approaching and threatens to tear it apart. Only one thing can stop the Storm: The Great Anti-Storm Ion Cannon! But it works only with Proto-Stars, which are scattered in the Galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thiswayupgames.com/privacy.html", "developer_terms_of_service_url": "http://thiswayupgames.com/terms.html", "publisher_name": "Self Published", "support_website_url": null, "website_url": "http://thiswayupgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "270561315209185"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162688_275788876231456_6622377002454220800_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZKrDlHfTG8Q7kNvwF96Ryl&_nc
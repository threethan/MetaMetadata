ontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162754_146317752616743_7956279778850373632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVCg0QrmZPAQ7kNvwHOLDzQ&_nc_oc=AdkreG2WhLEYUtaF3MvybepQMQl7pXc96iRCHdT8BjvlWPXBRd1RJbPpQtqX_hd0aUc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHXa08uMY8Db_dRi1M5vAcxkXSLMNdqqcWmUMbbvOmxg&oe=69BD3137"}, {"file_name": "migrated_image.png", "id": "240391513818743", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162726_768510353320152_9100528013614776320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkTTa1yp_UcQ7kNvwEUqTWh&_nc_oc=AdkIhhCNCwPX75FANCFx8tbkZsNHp1XCzX0R9NCUA7JotufNzNFV0hns63lFqvGeKPM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwshZLlaj32HH_bZ8LZEcOo2h2UwF8iWvELcv8NIAJzA&oe=69BD3DF6"}, {"file_name": "migrated_image.png", "id": "217249006022269", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162706_506076726393186_5572840046471413760_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRF6bPJgqhoQ7kNvwHvgCED&_nc_oc=Adkl53IlHnXRYuJAJoAjV4Q_5OmDVpFqPvY2P_i-UAsK_F9LHwHlQDuw5m-xSnxYKNY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwzEYgPm-gzCfpVutyQLJIq1wMAWlvyvo_Pa82hK6chw&oe=69BD2CE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PaperLander Demo", "keywords": ["paper", "rocket", "gravity", "cute", "free"], "long_description": "PaperLander is a fragile rocket made out of - you guessed it - paper. He lives in PaperGalaxy, a low gravitational fantasy world far far away, made mostly out of paper too.\n\nBut now the Galaxy is in danger. A Space Storm is approaching and threatens to tear it apart. Only one thing can stop the Storm: The Great Anti-Storm Ion Cannon! But it works only with Proto-Stars. And Proto-Stars are scattered in the Galaxy, across its many Sectors. These Sectors are connected by a network of teleporters that activate upon landing. PaperLander's mission is to find and collect those Stars, pass through the Sectors using the teleporters and bring them to the Anti-Storm Ion Cannon in time to save the Galaxy!\n\nBuild your own PaperLander here: http://thiswayupgames.com/PaperLanderModel.pdf\n\n--------------------------------\nPlease note that this demo is not compatible with Oculus Go", "short_description": "PaperLander is a fragile rocket made out of - you guessed it - paper. He lives in PaperGalaxy, a low gravitational fantasy world far far away, made mostly out of paper too.\n\nBuild your own PaperLander here: http://thiswayupgames.com/PaperLanderModel.pdf\n\nBut now the Galaxy is in danger. A Space Storm is approaching and threatens to tear it apart. Only one thing can stop the Storm: The Great Anti-Storm Ion Cannon! But it works only with Proto-Stars, which are scattered in the Galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thiswayupgames.com/privacy.html", "developer_terms_of_service_url": "http://thiswayupgames.com/terms.html", "publisher_name": "Self Published", "support_website_url": null, "website_url": "http://thiswayupgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "270561315209185"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162688_275788876231456_6622377002454220800_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37lRRaREy5gQ7kNvwE9BNvK&_nc_oc=Adlq82aY_1CaS-pbsA3KSURfDR4c-LXWO-jubi2WJk1sM5yE
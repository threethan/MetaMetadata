-ams2-1.oculuscdn.com/v/t64.5771-25/11162726_768510353320152_9100528013614776320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2PI33RdqhAQ7kNvwFFCtny&_nc_oc=AdmphGBKfmY7SP4cbYs1goMmwPngeNeQeDInrxF_xZcrYQsD1jEyP5JNiD_pvcJ6bJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvJS3ornbnymNOV6sP3tW8XHVHgpcKNXeeNxG_An-Xcg&oe=69B00EF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumb_2560x1440.png", "id": "347740935677671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162743_347740939011004_7535046003687161856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcgIq1yo0FYQ7kNvwEywjT6&_nc_oc=AdmrjZugwClq4g4PaifEz1TIWVVbfFQtKACekwj0UxON-UAOfFhB62x5AIMaSibzInU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5Y7lMHLWEzgJb9qR2_OET8WiGh8R8bSNqY4kLMy1oWQ&oe=69B01939"}, "display_name": "PaperLander Demo", "keywords": ["paper", "rocket", "gravity", "cute", "free"], "long_description": "PaperLander is a fragile rocket made out of - you guessed it - paper. He lives in PaperGalaxy, a low gravitational fantasy world far far away, made mostly out of paper too.\n\nBut now the Galaxy is in danger. A Space Storm is approaching and threatens to tear it apart. Only one thing can stop the Storm: The Great Anti-Storm Ion Cannon! But it works only with Proto-Stars. And Proto-Stars are scattered in the Galaxy, across its many Sectors. These Sectors are connected by a network of teleporters that activate upon landing. PaperLander's mission is to find and collect those Stars, pass through the Sectors using the teleporters and bring them to the Anti-Storm Ion Cannon in time to save the Galaxy!\n\nBuild your own PaperLander here: http://thiswayupgames.com/PaperLanderModel.pdf\n\n--------------------------------\n\nPlease note that the game might run a bit slower on some Galaxy S7 phones due to low performance graphics chipsets on those devices.", "short_description": "PaperLander is a fragile rocket made out of - you guessed it - paper. He lives in PaperGalaxy, a low gravitational fantasy world far far away, made mostly out of paper too.\n\nBuild your own PaperLander here: http://thiswayupgames.com/PaperLanderModel.pdf\n\nBut now the Galaxy is in danger. A Space Storm is approaching and threatens to tear it apart. Only one thing can stop the Storm: The Great Anti-Storm Ion Cannon! But it works only with Proto-Stars, which are scattered in the Galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thiswayupgames.com/privacy.html", "developer_terms_of_service_url": "http://thiswayupgames.com/terms.html", "publisher_name": "Self Published", "support_website_url": null, "website_url": "http://thiswayupgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "249492153891551"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1572175042840730", "version": "0.8.4"}, "id": "341964979591012", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1520090358049199", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1572175042840730"}, "release_status": "
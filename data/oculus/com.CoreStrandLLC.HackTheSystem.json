m/v/t64.5771-25/473391930_1147109636806423_6909828639526574047_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG3My6XhArcQ7kNvwFTG_BM&_nc_oc=AdpGRJ-Ob45v0Hlrq2VKj3PF2u_mkj2PV1xOCUrI32HzNk5mmZoiznRkEhPVETFzfcs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqtOARIRYjg-_YRwfaa-Ucjt-CpvvKz2Kn3QghlaIMyw&oe=6A857CED"}, {"file_name": "Sniper01_2560x1440.png", "id": "619526613778310", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391913_619526617111643_4779182521656177024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Y2bFwHPprYQ7kNvwHLeJxk&_nc_oc=Adr3PyDIMc9fSJ86GAp62TluJVt9_OmluJXK6h6di14LHhD20B63KuG_31sxQy7nU6s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMTVsQYYbMsUvTJMuWo41VDUomviRkfZXAx4uRIRd5Hg&oe=6A858F04"}, {"file_name": "DualWield02_2560x1440.png", "id": "2846696975512873", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391971_2846696978846206_3152004226380843791_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awvhbIIQA_QQ7kNvwE6y3Zq&_nc_oc=AdoqpJ2yiLh2ZWkPBjItc91bgIp3_4vOxyXY_jx-Y2vx7ueSUz-cyYGkINC5S0kSLKw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYjBk6XYW_WfbdwWctw7Qzf17Isw59PaxR2f6xaRArLg&oe=6A8599D9"}, {"file_name": "LOH-Planet_2560x1440.png", "id": "1027032369454852", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391913_1027032372788185_6272348873203520910_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GK8lPN2nbkYQ7kNvwE4NPl7&_nc_oc=AdqCp7ryae7VAkfvOBTLppMaLPU9MEvbCU6X2bGHr266GsdrwmMCQWSeX0R2UeXBvYg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGucccOo2geNVhWLk2iXnuQPBnqPaX6P3AnZGH1csOWZg&oe=6A85AC6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hack The System", "keywords": ["scifi", "shooter", "spy", "agent", "narrative"], "long_description": "# HACK THE SYSTEM\n**A Sci-Fi Wave Shooter**\n\nThe Constitutional Federal Technocracy maintains an illusion of total efficiency, pragmatism and control. The Agency knows better. Operating from the shadows, they ensure order in a world that secretly teeters on the brink of chaos.\n\nFor over 200 years, the CFT has been free of all deadly disease. Now, a new plague called Tracosis has claimed the lives of millions across the Central Systems. \n\nYour objective is simple: eliminate threats, secure classified data, and maintain control. But as your missions unfold, troubling secrets begin to surface...\n\n**Key Features**\n\n\ud83d\udd79\ufe0f Wave-Shooter\n\nEach level will bring waves of enemies as you attempt to secure various locations. Use cover, movement, and precision shooting to survive escalating encounters.\n\n{1344938703584295}\n\n\ud83c\udf06 7 Locations\n\nBattle across diverse environments, from neon-lit cityscapes and corporate skyscrapers to underground bio-labs.\n\n{965507812213056}\n\n\ud83d\udd2b 5 Advanced Weapons\n\nEquip yourself with a deadly arsenal of weaponry.\n\n{1284872422779690}\n\n\ud83d\udda5\ufe0f A Dark Sci-Fi Story\n\nUnravel a subtle narrative of power, control, and rebellion.\n\n{460015863845390}", "short_description": "Step into the role of an elite Operative working for The Agency, a shadowy government organization that thrives on secrecy and precision. Armed with cutting-edge weaponry, you will neutralize threats and maintain order\u2014at any cost."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corestrand.net/hack-the-system-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Core Strand LLC", "support_website_url": null, "website_url": "https://corestrand.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "M
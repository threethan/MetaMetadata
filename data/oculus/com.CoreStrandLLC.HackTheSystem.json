ATJ1oJTYDNQ&oe=69A2F32D"}, {"file_name": "Sniper01_2560x1440.png", "id": "619526613778310", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391913_619526617111643_4779182521656177024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gdW_-H3pGMQ7kNvwH2Q-Po&_nc_oc=AdnDGwjcL70Tp1vjNoTVdqHQVBg4V7KNUpVGXl4su0oLRNjsFl9r6C-d5v28jaVWI6c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvlhmYXvN2cg-Zt-E8EQ852XXsLy7bkpvrQEnlrwYpxGg&oe=69A2CD04"}, {"file_name": "DualWield02_2560x1440.png", "id": "2846696975512873", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391971_2846696978846206_3152004226380843791_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W59aCcAmMBsQ7kNvwGbu4uo&_nc_oc=Adm-ivAuNzC5TRXAzAsOsjCUr62WiRWiHBH2y9Gwow1iswcufpMN7nG12JXu7Trmawo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftJTGy-aOqLjpXa9QwEqn0ciUSUtdbSiL1hTcZ7tSbC-Q&oe=69A2D7D9"}, {"file_name": "LOH-Planet_2560x1440.png", "id": "1027032369454852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391913_1027032372788185_6272348873203520910_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlqRH_qirf8Q7kNvwHhkC0_&_nc_oc=AdlXqfeih_TzHvYyFjM7I_CO25W1eI-6GKOdj__gReM4V50M7J0MZKFD7H0h_5Kg4oA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMXXoZ7Mr1wC1SmSllOtJccSY4uKZGg3pFRFHtllsfhA&oe=69A2EA6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hack The System", "keywords": ["scifi", "shooter", "spy", "agent", "narrative"], "long_description": "# HACK THE SYSTEM\n**A Sci-Fi Wave Shooter**\n\nThe Constitutional Federal Technocracy maintains an illusion of total efficiency, pragmatism and control. The Agency knows better. Operating from the shadows, they ensure order in a world that secretly teeters on the brink of chaos.\n\nFor over 200 years, the CFT has been free of all deadly disease. Now, a new plague called Tracosis has claimed the lives of millions across the Central Systems. \n\nYour objective is simple: eliminate threats, secure classified data, and maintain control. But as your missions unfold, troubling secrets begin to surface...\n\n**Key Features**\n\n\ud83d\udd79\ufe0f Wave-Shooter\n\nEach level will bring waves of enemies as you attempt to secure various locations. Use cover, movement, and precision shooting to survive escalating encounters.\n\n{1344938703584295}\n\n\ud83c\udf06 7 Locations\n\nBattle across diverse environments, from neon-lit cityscapes and corporate skyscrapers to underground bio-labs.\n\n{965507812213056}\n\n\ud83d\udd2b 5 Advanced Weapons\n\nEquip yourself with a deadly arsenal of weaponry.\n\n{1284872422779690}\n\n\ud83d\udda5\ufe0f A Dark Sci-Fi Story\n\nUnravel a subtle narrative of power, control, and rebellion.\n\n{460015863845390}", "short_description": "Step into the role of an elite Operative working for The Agency, a shadowy government organization that thrives on secrecy and precision. Armed with cutting-edge weaponry, you will neutralize threats and maintain order\u2014at any cost."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corestrand.net/hack-the-system-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Core Strand LLC", "support_website_url": null, "website_url": "https://corestrand.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9092580377504974"}}]}, "scheduled_of
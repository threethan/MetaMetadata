_1147109636806423_6909828639526574047_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4J59cEJIGoQ7kNvwEAJ4_7&_nc_oc=AdoKqSwa2vYu3f2oNDbgZ3tsiJnxo000BrItdomv4IweIJFLs1ne6eQKg0S2bTZOlZ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJptYQqc1m486Eeq1YXCI5c8mhWKLbov2hJu-WqZ45Www&oe=6ABA712D"}, {"file_name": "Sniper01_2560x1440.png", "id": "619526613778310", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391913_619526617111643_4779182521656177024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YheKnyj2ucQ7kNvwGAtog_&_nc_oc=AdrsXsi2dkhCb4A9pz2oMKL_yJh1B_A8B5lrAm7jGtOWwPfhEFtZbbXwYj3wx58glFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpcaRVmnMnDPvwlMwSbEDP6Iu6bcDI1A4IfRP0oXkfrA&oe=6ABA8344"}, {"file_name": "DualWield02_2560x1440.png", "id": "2846696975512873", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391971_2846696978846206_3152004226380843791_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06SwtMKtcZYQ7kNvwG9IoON&_nc_oc=AdqI_1FVsQzwLl2uUUjHVOYccM0ZASCpctNd9W16fHA743y0cX7JfT9VrqXpoPUfAPQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbt_08MXyjeGoCmTV7Zw9BOpD7mRogLBTzxucMV18cHg&oe=6ABA8E19"}, {"file_name": "LOH-Planet_2560x1440.png", "id": "1027032369454852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391913_1027032372788185_6272348873203520910_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZVt4JN9YWkQ7kNvwHtCAtP&_nc_oc=AdpMBDUDWHe3VT6b3Yb0R2KJ0Vt9OWVEni5X9D4s7xFe5D5O5qO9NxfzAIjObY-1Pqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_WRzc2wABcJ8v4YtfqVIvg1qcudDPdKCmaVrF6fLZvg&oe=6ABA686A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hack The System", "keywords": ["scifi", "shooter", "spy", "agent", "narrative"], "long_description": "# HACK THE SYSTEM\n**A Sci-Fi Wave Shooter**\n\nThe Constitutional Federal Technocracy maintains an illusion of total efficiency, pragmatism and control. The Agency knows better. Operating from the shadows, they ensure order in a world that secretly teeters on the brink of chaos.\n\nFor over 200 years, the CFT has been free of all deadly disease. Now, a new plague called Tracosis has claimed the lives of millions across the Central Systems. \n\nYour objective is simple: eliminate threats, secure classified data, and maintain control. But as your missions unfold, troubling secrets begin to surface...\n\n**Key Features**\n\n\ud83d\udd79\ufe0f Wave-Shooter\n\nEach level will bring waves of enemies as you attempt to secure various locations. Use cover, movement, and precision shooting to survive escalating encounters.\n\n{1344938703584295}\n\n\ud83c\udf06 7 Locations\n\nBattle across diverse environments, from neon-lit cityscapes and corporate skyscrapers to underground bio-labs.\n\n{965507812213056}\n\n\ud83d\udd2b 5 Advanced Weapons\n\nEquip yourself with a deadly arsenal of weaponry.\n\n{1284872422779690}\n\n\ud83d\udda5\ufe0f A Dark Sci-Fi Story\n\nUnravel a subtle narrative of power, control, and rebellion.\n\n{460015863845390}", "short_description": "Step into the role of an elite Operative working for The Agency, a shadowy government organization that thrives on secrecy and precision. Armed with cutting-edge weaponry, you will neutralize threats and maintain order\u2014at any cost."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corestrand.net/hack-the-system-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Core Strand LLC", "support_website_url": null, "website_url": "https://corestrand.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics"
wTD3FY130RJ721I3P5-wLfR2OS8eBVHM5Z_HD-wyZ1c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvhYpFhmShtnUs0bVyn_FX3tmRjlV27kkCBSEku34NMIA&oe=69A58022"}, {"file_name": "PlayerDamage01_2560x1440.png", "id": "1147109633473090", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391930_1147109636806423_6909828639526574047_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CN9wmEOBc90Q7kNvwFgtRU-&_nc_oc=Adm9-n9A67jvik0hxzzHNhqVx0J32fdesauviya5bXx7bDokyKsgx1-P1xYka0Ml8h0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvUmd84E_5BPZ8Hv8Nb__iO0HUZZlg9cvRyVSf7JU_gIQ&oe=69A5962D"}, {"file_name": "Sniper01_2560x1440.png", "id": "619526613778310", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391913_619526617111643_4779182521656177024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxKiZQxFct4Q7kNvwEsit2u&_nc_oc=Adk3l9Pw5ud5GbEFkTj2hspo4xAgjH1mHTNlXLsBaknAI5Y492RIbOAQu7oL2c3lb38&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs3BRrErtXs_Bif1DeWFzVA8v-p0HGANabhBC8lC7iTuw&oe=69A57004"}, {"file_name": "DualWield02_2560x1440.png", "id": "2846696975512873", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391971_2846696978846206_3152004226380843791_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2mfGSHHYeYQ7kNvwGRd4pY&_nc_oc=Adlwhv2bBrSiIxPoH1l97RCUuVrEbBr3wtNQ0znUMYdRtvARn3Hwxm-E8977dFJii0Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuhMisuE4o8oxdLydMmjqYtfYUJcAWf5-S-eQhG66BoEA&oe=69A57AD9"}, {"file_name": "LOH-Planet_2560x1440.png", "id": "1027032369454852", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391913_1027032372788185_6272348873203520910_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlqRH_qirf8Q7kNvwHZHwoK&_nc_oc=AdkLN9r-osfaNtFeptDrZWQa6mK9xmqQGpo5fNhp4Ps7JltiKXtX34Jf3INQOaKghX4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuvaktRQeztNt2-lIXNQt4PN3KZTzduxF7CpZaWsAnIwQ&oe=69A58D6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hack The System", "keywords": ["scifi", "shooter", "spy", "agent", "narrative"], "long_description": "# HACK THE SYSTEM\n**A Sci-Fi Wave Shooter**\n\nThe Constitutional Federal Technocracy maintains an illusion of total efficiency, pragmatism and control. The Agency knows better. Operating from the shadows, they ensure order in a world that secretly teeters on the brink of chaos.\n\nFor over 200 years, the CFT has been free of all deadly disease. Now, a new plague called Tracosis has claimed the lives of millions across the Central Systems. \n\nYour objective is simple: eliminate threats, secure classified data, and maintain control. But as your missions unfold, troubling secrets begin to surface...\n\n**Key Features**\n\n\ud83d\udd79\ufe0f Wave-Shooter\n\nEach level will bring waves of enemies as you attempt to secure various locations. Use cover, movement, and precision shooting to survive escalating encounters.\n\n{1344938703584295}\n\n\ud83c\udf06 7 Locations\n\nBattle across diverse environments, from neon-lit cityscapes and corporate skyscrapers to underground bio-labs.\n\n{965507812213056}\n\n\ud83d\udd2b 5 Advanced Weapons\n\nEquip yourself with a deadly arsenal of weaponry.\n\n{1284872422779690}\n\n\ud83d\udda5\ufe0f A Dark Sci-Fi Story\n\nUnravel a subtle narrative of power, control, and rebellion.\n\n{460015863845390}", "short_description": "Step into the role of an elite Operative working for The Agency, a shadowy government organization that thrives on secrecy and precision. Armed with cutting-edge weaponry, you will neutralize threats and maintain order\u2014at any cost."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corestrand.net/hack-the-system-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Core Strand LLC", "support_website_url": null, "website_url": "https://corestrand.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
_1147109636806423_6909828639526574047_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCE8GHS-YTcQ7kNvwFHLu20&_nc_oc=AdplY0ov1WvUPlxTHR9KVanqjfBOSCLhq7VqXqxKs9xEm8AuQWpW_-vCfqT7vSs6o2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qvmu1s4pyYTWUQQX5N4fnCy1eOLg2sa3-pGFsqA6KMA&oe=6A4278AD"}, {"file_name": "Sniper01_2560x1440.png", "id": "619526613778310", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391913_619526617111643_4779182521656177024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BnwLbAHuIcQ7kNvwHBbjl1&_nc_oc=Adr9t5U68y5NcXw7nqiUssoPwTa4Jk8bZf35EOERwA50luln3mLIK3MIVFtJ0xnbWZ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wBLIIzDBy8ayRqcuBoBGXH-3BFBsQMCvl-st_FZ961Q&oe=6A428AC4"}, {"file_name": "DualWield02_2560x1440.png", "id": "2846696975512873", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391971_2846696978846206_3152004226380843791_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKZOEJbUz2YQ7kNvwH-r4hI&_nc_oc=AdqWpCauiQW0MONF-Q10HIYJ4wtamblP1zHv0J653ogKrttjTF9f2lLEyQrKqi6qh_Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B0Ivs4M597aphSU11_6LUX-atuexhoXy3-HRnDIM-dA&oe=6A429599"}, {"file_name": "LOH-Planet_2560x1440.png", "id": "1027032369454852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391913_1027032372788185_6272348873203520910_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eaYCAbe6LsQ7kNvwGXie0C&_nc_oc=AdrXdeTg13omr5fYJXbugh3uqip1MIPZk4_qXVYtSO9gTunDIE5bSOmoEYDQgl1zovg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LDyySFKBm1wVHch0uAELr3hKv8InyG_4AoKcMqwGiuA&oe=6A426FEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hack The System", "keywords": ["scifi", "shooter", "spy", "agent", "narrative"], "long_description": "# HACK THE SYSTEM\n**A Sci-Fi Wave Shooter**\n\nThe Constitutional Federal Technocracy maintains an illusion of total efficiency, pragmatism and control. The Agency knows better. Operating from the shadows, they ensure order in a world that secretly teeters on the brink of chaos.\n\nFor over 200 years, the CFT has been free of all deadly disease. Now, a new plague called Tracosis has claimed the lives of millions across the Central Systems. \n\nYour objective is simple: eliminate threats, secure classified data, and maintain control. But as your missions unfold, troubling secrets begin to surface...\n\n**Key Features**\n\n\ud83d\udd79\ufe0f Wave-Shooter\n\nEach level will bring waves of enemies as you attempt to secure various locations. Use cover, movement, and precision shooting to survive escalating encounters.\n\n{1344938703584295}\n\n\ud83c\udf06 7 Locations\n\nBattle across diverse environments, from neon-lit cityscapes and corporate skyscrapers to underground bio-labs.\n\n{965507812213056}\n\n\ud83d\udd2b 5 Advanced Weapons\n\nEquip yourself with a deadly arsenal of weaponry.\n\n{1284872422779690}\n\n\ud83d\udda5\ufe0f A Dark Sci-Fi Story\n\nUnravel a subtle narrative of power, control, and rebellion.\n\n{460015863845390}", "short_description": "Step into the role of an elite Operative working for The Agency, a shadowy government organization that thrives on secrecy and precision. Armed with cutting-edge weaponry, you will neutralize threats and maintain order\u2014at any cost."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corestrand.net/hack-the-system-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Core Strand LLC", "support_website_url": null, "website_url": "https://corestrand.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics"
culuscdn.com/v/t64.5771-25/473391913_1027032372788185_6272348873203520910_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0buJNmITnMYQ7kNvwFJ0Dn3&_nc_oc=AdpllOXvcWuy2RxTickDIe3E9ykdWIxYCKwwLQiDXdsqkODj4L_6mGNY6uOaylJE9Ug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF-Nnvlp3jFwbr5d1LqqVatEAdhRkdPHg59BLCUbSTEg&oe=6AFDDD2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hack The System", "keywords": ["scifi", "shooter", "spy", "agent", "narrative"], "long_description": "# HACK THE SYSTEM\n**A Sci-Fi Wave Shooter**\n\nThe Constitutional Federal Technocracy maintains an illusion of total efficiency, pragmatism and control. The Agency knows better. Operating from the shadows, they ensure order in a world that secretly teeters on the brink of chaos.\n\nFor over 200 years, the CFT has been free of all deadly disease. Now, a new plague called Tracosis has claimed the lives of millions across the Central Systems. \n\nYour objective is simple: eliminate threats, secure classified data, and maintain control. But as your missions unfold, troubling secrets begin to surface...\n\n**Key Features**\n\n\ud83d\udd79\ufe0f Wave-Shooter\n\nEach level will bring waves of enemies as you attempt to secure various locations. Use cover, movement, and precision shooting to survive escalating encounters.\n\n{1344938703584295}\n\n\ud83c\udf06 7 Locations\n\nBattle across diverse environments, from neon-lit cityscapes and corporate skyscrapers to underground bio-labs.\n\n{965507812213056}\n\n\ud83d\udd2b 5 Advanced Weapons\n\nEquip yourself with a deadly arsenal of weaponry.\n\n{1284872422779690}\n\n\ud83d\udda5\ufe0f A Dark Sci-Fi Story\n\nUnravel a subtle narrative of power, control, and rebellion.\n\n{460015863845390}", "short_description": "Step into the role of an elite Operative working for The Agency, a shadowy government organization that thrives on secrecy and precision. Armed with cutting-edge weaponry, you will neutralize threats and maintain order\u2014at any cost."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corestrand.net/hack-the-system-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Core Strand LLC", "support_website_url": null, "website_url": "https://corestrand.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9092580377504974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391913_1522586328377655_4377084015750833293_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYSWFWjSYhwQ7kNvwGpXspb&_nc_oc=Adr0Qq68z5H5_KexDzfPDyXiYzUmeExe98hzD1mWGwGmXNh7HrsLPhWAJgj-OMLBtgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ4k2HiU1pleLOPHO5srzk5qVqZVbkG1A59iDlACMqjw&oe=6AFDD667"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hack The System", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1738290480, "lastRevision": {"nodes": [{"id": "9000318670064479", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "
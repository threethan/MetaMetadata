qUM_RygQ7kNvwF8W-5X&_nc_oc=AdogBRU5TaPpV0mkrRpuSlhwPYweXIER1Y4fZo8vBRfdDWBsoK8qj7sZvKBP9PrLq6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZTscE9IkSVn5SfGkN15Wj-opBWcqlHU1a2X2fSSS1dw&oe=6A281213"}, "display_name": "VSS - Virtual Sports Soccer Football", "keywords": ["football", "soccer", "vss", "multiplayer", "sports"], "long_description": "Step into VSS - Virtual Sports Soccer Football, a brand-new VR sports competitive experience inspired by traditional football that transforms it into a thrilling realistic simulator.  \n\nMaster the physics-based gameplay, challenge rivals in intense 1v1 soccer duels, and climb the global rankings to prove you are the best.\n\n\u2022 Realistic Football Physics in VR: Feel every kick, pass, and goal thanks to advanced immersive gameplay mechanics.\n\n\u2022 Monthly Skins & Player Customization: Personalize your avatar and stand out with exclusive skins released every month.\n\n\u2022 Weekly & Monthly Tournaments: Compete for rewards, prizes, and glory in exciting online competitions.\n\n\u2022 World Championships: Take your skills from virtual fields to real-world stages with massive USD prize pools.\n\n\u2022 Multiple Game Modes: Train with friends, face smart AI, or battle random opponents from all over the world.\n\n\u2022 Ranked Mode & Leaderboards: Earn seasonal rewards and climb to the top of the competitive ladder.\n\nVSS - Virtual Sports Soccer Football is a new immersive sports discipline, created to bring together competition, community, and the excitement of football in virtual reality.", "short_description": "Step into Virtual Sports Soccer (VSS), the ultimate VR football simulator with realistic physics. Play intense 1v1 soccer duels, master immersive gameplay, climb global leaderboards. Personalize your avatar with monthly skins, design your own ball, and compete in weekly tournaments or massive world championships with real prize pools. Train with friends, face AI, or battle rivals worldwide. A new VR sport built for community, competition, and unforgettable moments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualsports.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Sports", "support_website_url": null, "website_url": "https://virtualsports.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27001491729488666"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4316720355262941"}]}, "baseline_offer": {"id": "4316720355262941"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780478160, "status": "PUBLISHED", "id": "4316720355262941"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27342316095406226", "version": "1.3.18"}, "id": "1642940486738577", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26819089577728883", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27342316095406226"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1780394638, "id": "273
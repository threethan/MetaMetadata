08E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfT--LfThhW8iZrwylkeLuEDZrJ-LEHQNgsSDn7yNXEg&oe=6B0B1ED1"}, {"file_name": "SoulCovenant_3.png", "id": "714281797437850", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974858_714281800771183_6750938816274632546_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdxqUoFFNh0Q7kNvwGLg9ey&_nc_oc=AdqK_kMEGG6LsvFrSmBl0VtbLppStjRsZnObnnt0cFVxv9F8Ix1RuM-SMRz_mzGiaYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8HhWhTSBqC29EZCyY7yJX75eaTi1UUS5Zr8WI9uL5tw&oe=6B0B4207"}, {"file_name": "SoulCovenant_4.png", "id": "886195333296725", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982584_886195336630058_4839328764469424707_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beDsKI1Px88Q7kNvwE6YCDf&_nc_oc=AdoC3aDTadEU0o5NAxZ79eu79auwcDAj7EQOrRI4BptnQQet8Wqd05NSR43NFJR6z8I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxuiACF7tksH4xj6CNuPH4HEz025I7VCczqxsCluHheQ&oe=6B0B18AB"}, {"file_name": "SoulCovenant_5.png", "id": "695174452818987", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982617_695174456152320_4031427662436737406_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpBATu2gg6EQ7kNvwGFNFGr&_nc_oc=Ado5QLEnIqEpQDx00AN19olaaMN8aQk8MxYNSDLLyFBCPWt-wrvhY13_aegElBttKNA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoXgYDwTE2FAU21yet3oYa-3lQACNsg_MD01SJ8nvnXA&oe=6B0B1932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sam.png", "id": "951948659755922", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974514_951948663089255_5272432868408069691_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRJMS5l5XQoQ7kNvwHgwtbs&_nc_oc=AdqtwRMaGC_k5HfwR9DriYqxbiZT3ffkk2ecySa04yKYUIjdaOyGtzYxdCmkah1LIf0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSK7qqYhADNWP2jyGCusXdUbWjWK3E1jwtmEIBKDc5Gfw&oe=6B0B2AE5"}, "display_name": "SOUL COVENANT", "keywords": ["JRPG", "Action", "Narrative", "RPG", "multiplayer"], "long_description": "In the near future, the world is under control of a quantum artificial intelligence known as \u201cAdam,\u201d attempting to assume the role of a god. Adam believes that the role of god is to be an object of awe \u2014 one of overwhelming fear. The mech weapons known as \"Deus Ex Machina,\" feared as mechanical gods, launch a global invasion, slaughtering everyone who refuses to obey.\n\nClose to humanity\u2019s last stronghold, \"Tokyo Ark,\" enhanced humans known as \"Avatars\" engage in ferocious battles. Their main weapon, \"Scapegoat,\" is crafted from the remains of fallen comrades, in an endless cycle in which someone's death helps those who keep fighting. The Avatars have a saying in relation to this: \"I'll make sure to pick up your bones.\"\n\n\u25a0 Challenge your fate\u2026\nIn a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n\n\u25a0 \u2026like never before!\nThe feeling of \u201covercoming an impossible challenge\u201d will reward those who bravely fight until the end. Become one with the protagonist and face your enemies for the fate of the world!\n\nFighting in VR - the transformable weapons\nYou can switch your \u2018Scapegoat\u2019 between two different modes, allowing for versatile combat techniques, reach, and power.\n\n\u25a0 The final frontier\nThanks to the power of VR you will face death again and again, and experience the emotional impact of a \u201cstory of life through death.\u201d\n", "short_description": "In a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://soul-covenant.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_HK", "zh_TW", "fr", "es_MX", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "7161146157314636"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1447203490506370"}, {"status": "PUBLISHED", "id": "1562094379258766"}, {"status": "PUBLISHED", "id": "3742318182683097"}, {"status": "PUBLISHED", "id": "367398249140789"}, {"status": "PUBLISHED", "id": "1110464573529255"}, {"status": "PUBLISHED", "id": "263280430150248"}, {"status": "PUBLISHED", "id": "903975308406193"}]}, "baseline_offer": {"id": "903975308406193"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1447203490506370"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7571592742936640", "version": "1.0.2"}, "id": "659199202948522", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", 
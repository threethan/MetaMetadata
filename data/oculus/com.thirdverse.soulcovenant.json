_280863178079167_5342076374060012034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLLFQwjtlncQ7kNvwF4A3ss&_nc_oc=AdkKzek8X5IbXQYjO2OPlql9opnm_Ku3WHs49taS1MXy4RNFTv_G7rE8xSCqaS1yr68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPv8FWhGZN2Q0-bmMihW66rLe459g0hBHzOzUqdznciw&oe=69B2CCBB"}]}, "id": "2237689956576251", "locale": "en_US", "screenshots": [{"file_name": "SoulCovenant_1.png", "id": "1554947625298158", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982690_1554947628631491_6471347349642440710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJpjmvai77kQ7kNvwF8Nh1M&_nc_oc=Adkr8_n9tvmPFLzrcKARw9kcsnhJuuXrFALKN8cwswhC1r19MpB-lvfDIN0pl1Iz9bU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPPgx2j0LKpT7QmcjiMLERbutAE64O7_5dtHws4JXqLQ&oe=69B2A24B"}, {"file_name": "SoulCovenant_2.png", "id": "1038611270559961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974482_1038611273893294_806951884030854284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75W7LMyVAqYQ7kNvwFGCxp1&_nc_oc=AdlRrxDKiRBreH8Qkjh8JvPcccyP3G-FazuIAPWYEZvCeBlhhkrQo9mnvdnlk9u908I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyK2iAWhYDbvAKMjuXSfbnV69XOV-YGSJwBTyUPjX9mvQ&oe=69B2CF11"}, {"file_name": "SoulCovenant_3.png", "id": "714281797437850", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974858_714281800771183_6750938816274632546_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PrcFT9X-fsQ7kNvwHD9TaI&_nc_oc=Adl6S4DVTW3G1vZ6xb6JUtpKY_8ZUM10yB1X--XKT8HAmW4Pe-el8AEQyoDPv4EuWgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkQJfLvj9-99Z24c5juULjesAc5WyypPNjFcEkO9nBJQ&oe=69B2BA07"}, {"file_name": "SoulCovenant_4.png", "id": "886195333296725", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_886195336630058_4839328764469424707_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luU2oZxHd7MQ7kNvwHLgsaS&_nc_oc=Adkjt3ELgHqNP96Q_pPtafH7ZgxpN4sHxQZ4P7G7c-Er1S2ZT1PPh3JLJsxTO3waQeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2JVmAujsL3RluWHy-ZB09AxeMvN3AFhS8SFgeu3Gimw&oe=69B2C8EB"}, {"file_name": "SoulCovenant_5.png", "id": "695174452818987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982617_695174456152320_4031427662436737406_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kml1mayyYYQ7kNvwGp2iht&_nc_oc=AdnHf5Ad0JiaADk4by1yrZr734wJmNhNDRNiz6VbbS2IxQ9DOzQx3g-44rkoGrd01hU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxo1-uv6Q3TxeZuaCK2wCitP0nyhjTTO3_ehc3393nmdQ&oe=69B2C972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SoulCovenant_LandscapeCover.png", "id": "463613840001378", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974485_463613843334711_284628759147043907_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8jkb9G9ss8Q7kNvwGGud5m&_nc_oc=AdnwHlN0pLPpLA0FdebXTX5eq7lNullXs3WWvBDq5DKuSOuC_Z02HRpuzcXkGIteHDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx99OtZ8LTrE-_zONWaY4CkVhZ4Kbq5RswPNoBDF_x8MQ&oe=69B2A498"}, "display_name": "SOUL COVENANT", "keywords": ["JRPG", "Action", "Narrative", "RPG", "multiplayer"], "long_description": "In the near future, the world is under control of a quantum artificial intelligence known as \u201cAdam,\u201d attempting to assume the role of a god. Adam believes that the role of god is to be an object of awe \u2014 one of overwhelming fear. The mech weapons known as \"Deus Ex Machina,\" feared as mechanical gods, launch a global invasion, slaughtering everyone who refuses to obey.\n\nClose to humanity\u2019s last stronghold, \"Tokyo Ark,\" enhanced humans known as \"Avatars\" engage in ferocious battles. Their main weapon, \"Scapegoat,\" is crafted from the remains of fallen comrades, in an endless cycle in which someone's death helps those who keep fighting. The Avatars have a saying in relation to this: \"I'll make sure to pick up your bones.\"\n\n\u25a0 Challenge your fate\u2026\nIn a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n\n\u25a0 \u2026like never before!\nThe feeling of \u201covercoming an impossible challenge\u201d will reward those who bravely fight until the end. Become one with the protagonist and face your enemies for the fate of the world!\n\nFighting in VR - the transformable weapons\nYou can switch your \u2018Scapegoat\u2019 between two different modes, allowing for versatile combat techniques, reach, and power.\n\n\u25a0 The final frontier\nThanks to the power of VR you will face death again and again, and experience the emotional impact of a \u201cstory of life through death.\u201d\n", "short_description": "In a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n"}, {"images": {"nodes": []}, "id": "1517897722154633", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SOUL COVENANT\uff08\u30bd\u30a6\u30eb\u30fb\u30b3\u30f4\u30a7\u30ca\u30f3\u30c8\uff09", "keywords": ["RPG", "JRPG", "Action", "multiplayer", "Story"], "long_description": "\u6642\u306f\u8fd1\u672a\u6765\u2015\u2015\n\u4e16\u754c\u3092\u638c\u63e1\u3059\u308b\u306e\u306f\u3001\u795e\u306e\u5f79\u5272\u3092\u4ee3\u884c\u3057\u3088\u3046\u3068\u3059\u308b\u91cf\u5b50\u4eba\u5de5\u77e5\u80fd\u3060\u3063\u305f\u3002\n\n\u305d\u306e\u4eba\u5de5\u77e5\u80fd\u301d\u30a2\u30c0\u30e0\u301f\u304c\u8003\u3048\u308b\u795e\u306e\u6a5f\u80fd\u3068\u306f\u754f\u6016\u306e\u5bfe\u8c61\u2015\u2015\n\u3064\u307e\u308a\u5727\u5012\u7684\u306a\u6050\u6016\u3060\u3063\u305f\u3002\n\u6a5f\u68b0\u4ed5\u639b\u3051\u306e\u795e\u3068\u3082\u754f\u308c\u3089\u308c\u308b\u81ea\u7acb\u578b\u6a5f\u68b0\u5175\u5668\u300e\u3
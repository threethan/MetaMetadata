_280863178079167_5342076374060012034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPvqfVkZF-oQ7kNvwHvqie3&_nc_oc=AdlcAwcZf26YABIw_31dYBimA8sP8lTgUh0Zvq_8c3UhXopBIq1YalgoA5xCgtq1lKM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJgEeg3yevud405QpH1s8cl-q4_SpMRgTwcD1CAykHTw&oe=69BEAA3B"}]}, "id": "2237689956576251", "locale": "en_US", "screenshots": [{"file_name": "SoulCovenant_1.png", "id": "1554947625298158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982690_1554947628631491_6471347349642440710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCSYZecoeUYQ7kNvwGzW0xW&_nc_oc=AdkS9B1ylQJUrweFgld38Xus9m8PW1QlqcRHEqB1LMsz1giTrIw8gYUpGqHIMxoOCzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeAa-86f4shOizqfwYEDrD4qP_sUwnCna0J6EFDYBgrg&oe=69BE7FCB"}, {"file_name": "SoulCovenant_2.png", "id": "1038611270559961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974482_1038611273893294_806951884030854284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QwPDFinuFAQ7kNvwGHWUvM&_nc_oc=Adljzv17-Qg4UgkgzRk-23q60lba5ptygRr_QtgmEqQ6Z51yzVTabiEeYHYJ9RoHZ4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEjMRsLbBEpCphiBZlw6HZOmGyPty573agbOt_aPBRcA&oe=69BEAC91"}, {"file_name": "SoulCovenant_3.png", "id": "714281797437850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974858_714281800771183_6750938816274632546_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ME6EsWuhhvsQ7kNvwE_8AlX&_nc_oc=AdkD3MrukNeAHpWwVvWpOCcoKS0x5B7KF2n4e7VBnzTt9zXRT1UBv1D5Xop-lq-ollk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZyUSWKEycVLu2MXHDDQOSwhJApfZo_3FohsH72mfLsg&oe=69BE9787"}, {"file_name": "SoulCovenant_4.png", "id": "886195333296725", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_886195336630058_4839328764469424707_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzUWgzR58mwQ7kNvwEiZaeN&_nc_oc=AdkVuZs0CtgvjFB-__WNkQgRhqcFYScxLeB_8CKX5stLRg3k001NdT8dqFM4OE1wLnk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGZ-aBPoOpN_e4DrSyr872H0KJ_jW6CPlp5A5eFprZLA&oe=69BEA66B"}, {"file_name": "SoulCovenant_5.png", "id": "695174452818987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982617_695174456152320_4031427662436737406_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKYiuhZ6QDkQ7kNvwGI7jyy&_nc_oc=AdmZYSJgWt1oUE8sbMkgymsBunJJfRnoNdJykdj54P-U-FikPNW0S89jXznV-3hfUBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLnBR0Ko9sKFlD2BJlgAFXNR33mqqn-3nl0-SpNt1dKQ&oe=69BEA6F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SoulCovenant_LandscapeCover.png", "id": "463613840001378", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974485_463613843334711_284628759147043907_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohMlBOxAn9EQ7kNvwFUiFSm&_nc_oc=AdkhEhw7G8GbhwnPiGbQb1O936oua9xhRkVXKnl-X6UcLG7ra19P0wRejSGXkRK43cs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfybiMvS2FYiOxlF1RaRtDnHGUxYwW-B3tPg7BGPfffsZA&oe=69BE8218"}, "display_name": "SOUL COVENANT", "keywords": ["JRPG", "Action", "Narrative", "RPG", "multiplayer"], "long_description": "In the near future, the world is under control of a quantum artificial intelligence known as \u201cAdam,\u201d attempting to assume the role of a god. Adam believes that the role of god is to be an object of awe \u2014 one of overwhelming fear. The mech weapons known as \"Deus Ex Machina,\" feared as mechanical gods, launch a global invasion, slaughtering everyone who refuses to obey.\n\nClose to humanity\u2019s last stronghold, \"Tokyo Ark,\" enhanced humans known as \"Avatars\" engage in ferocious battles. Their main weapon, \"Scapegoat,\" is crafted from the remains of fallen comrades, in an endless cycle in which someone's death helps those who keep fighting. The Avatars have a saying in relation to this: \"I'll make sure to pick up your bones.\"\n\n\u25a0 Challenge your fate\u2026\nIn a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n\n\u25a0 \u2026like never before!\nThe feeling of \u201covercoming an impossible challenge\u201d will reward those who bravely fight until the end. Become one with the protagonist and face your enemies for the fate of the world!\n\nFighting in VR - the transformable weapons\nYou can switch your \u2018Scapegoat\u2019 between two different modes, allowing for versatile combat techniques, reach, and power.\n\n\u25a0 The final frontier\nThanks to the power of VR you will face death again and again, and experience the emotional impact of a \u201cstory of life through death.\u201d\n", "short_description": "In a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n"}, {"images": {"nodes": []}, "id": "1517897722154633", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SOUL COVENANT\uff08\u30bd\u30a6\u30eb\u30fb\u30b3\u30f4\u30a7\u30ca\u30f3\u30c8\uff09", "keywords": ["RPG", "JRPG", "Action", "multiplayer", "Story"], "long_description": "\u6642\u306f\u8fd1\u672a\u6765\u2015\u2015\n\u4e16\u754c\u3092\u638c\u63e1\u3059\u308b\u306e\u306f\u3001\u795e\u306e\u5f79\u5272\u3092\u4ee3\u884c\u3057\u3088\u3046\u3068\u3059\u308b\u91cf\u5b50\u4eba\u5de5\u77e5\u80fd\u3060\u3063\u305f\u3002\n\n\u305d\u306e\u4eba\u5de5\u77e5\u80fd\u301d\u30a2\u30c0\u30e0\u301f\u304c\u8003\u3048\u308b\u795e\u306e\u6a5f\u80fd\u3068\u306f\u754f\u6016\u306e\u5bfe\u8c61\u2015\u2015\n\u3064\u307e\u308a\u5727\u5012\u7684\u306a\u6050\u6016\u3060\u3063\u305f\u3002\n\u6a5f\u68b0\u4ed5\u639b\u3051\u306e\u795e\u3068\u3082\u754f\u308c\u3089\u308c\u308b\u81ea\u7acb\u578b\u6a5f\u68b0\u5175\u5668\u300e\u30c7\u30a6\u30b9\u30a8\u30af\u30b9\u30de\u30ad\u30ca\u300f\u304c\u3001\n\u4e16\u754c\u5404\u5730\u306e\u90fd\u5e02\u3092\u5360\u62e0\u3057\u3001\u5f93\u308f\u306a\u3044\u4eba\u9593\u3092\u8650\u6bba\u3057\u3066\u3044\u304f\u3002\n\n\u4eba\u985e\u6700\u5f8c\u306e\u7826\u301d\u6771\u4eac\u30a2\u30fc\u30af\u301f\u306e\u8fd1\u90ca\u3067\u306f\u3001\n\u301d\u30a2\u30f4\u30a1\u30bf\u30fc\u301f\u3068\u547c\u3070\u308c\u308b\u5f37\u5316\u4eba\u9593\u9054\u304c\u653b\u9632\u3092\u7e70\u308a\u5e83\u3052\u3066\u3044\u308b\u3002\n\u5f7c\u3089\u306e\u4e3b\u6226\u6b66\u5668\u301d\u30b9\u30b1\u30a4\u30d7\u30b4\u30fc\u30c8\u301f\u306f\u3001\u4ef2\u9593\u306e\u5f37\u5316\u4eba\u9593\u306e\u907a\u4f53\u304b\u3089\u88fd\u9020\u3055\u308c\u308b\u3002\n\u8ab0\u304b\u306e\u6b7b\u304c\u6b8b\u3055\u308c\u305f\u8ab0\u304b\u3092\u5f37\u304f\u3059\u308b\u3002\u3060\u304b\u3089\u5f7c\u3089\u306f\u6c7a\u307e\u3063\u3066\u3053\u3046\u53e3\u306b\u3059\u308b\u306e\u3060\u3002\n\n\u300c\u9aa8\u306f\u62fe\u3063\u3066\u3084\u308b\u2015\u2015\u300d\u3068\u3002\n\n\u25a0\u6b7b\u95d8\u611f\u00d7\u611f\u60c5\u4f53\u9a13\n\u8fd1\u672a\u6765\u306e\u8352\u5ec3\u3057\u305f\u65e5\u672c\u3092\u821e\u53f0\u306b\u63cf\u304b\u308c\u308b\u3001\u4eba\u985e\u3068\u6a5f\u68b0\u306e\u58ee\u7d76\u306a\u95d8\u3044\u3002\n\u7d76\u671b\u7684\u306a\u72b6\u6cc1\u3092\u4e57\u308a\u8d8a\u3048\u305f\u5148\u306e\u559c\u3073\u3092\u4e0e\u3048\u308b\u300e\u6b7b\u95d8\u611f\u300f\n\u301d\u6b7b\u304c\u8a9e\u308a\u7d99\u3050\u547d\u306e\u7269\u8a9e\u301f\u306b\u3088\u3063\u3066\u63fa\u3055\u3076\u3089\u308c\u308b\u300e\u611f\u60c5\u4f53\u9a13\u300f\u3002\n\u4e16\u754c\u306e\u547d\u904b\u3092\u304b\u3051\u305f\u6226\u3044\u306b\u6311\u3080\u4e3b\u4eba\u516c\u3068\u301d\u4e00\u4f53\u5316\u301f\u3059\u308b\u3088\u3046\u306a\u9ad8\u3044\u6ca1\u5165\u611f\u3092\u8ffd\u6c42\u3057\u305f\uff36\uff32\u30c9\u30e9\u30de\u30c1\u30c3\u30af\u30a2\u30af\u30b7\u30e7\u30f3\u3002\n\n\u25a0\u6b7b\u95d8\u611f\n\u62bc\u3057\u5bc4\u305b\u308b\u5927\u52e2\
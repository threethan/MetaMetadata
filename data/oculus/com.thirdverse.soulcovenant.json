sQFq8QUVcCj6b2EPXA1GAWwIaR3gHnoF54b1dcQk_okqW_htczW-Lw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnGUqqkEU4vjls0wPAqwXH0hd43lPrX608k5B8GSrpDg&oe=6A900CAB"}, {"file_name": "SoulCovenant_5.png", "id": "695174452818987", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982617_695174456152320_4031427662436737406_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8McdlPyo-5IQ7kNvwFZHWY2&_nc_oc=Adp_tJI_NiYJ5sN1uTpB-OAMbNKU65u0-WCDiVe6K7Ws7kD9PQYwyxPFxb-car1S8ng&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWcB7s8qST5Ajox1JPRqIOa0unTHFg2WkQmj0KnPqbVQ&oe=6A900D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SoulCovenant_LandscapeCover.png", "id": "463613840001378", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974485_463613843334711_284628759147043907_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqREOsF54soQ7kNvwEP0c_s&_nc_oc=AdrpLT-J4oduPzVCGTFWQdCbPVk_DzckeHQLl4EZ6QIjIjykFcWPbAT7NFiUT-xWbkk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfGydRFuEBOwamZH2uFam0-hcLs07ccdn4b3Pl-4fCjQ&oe=6A902098"}, "display_name": "SOUL COVENANT", "keywords": ["JRPG", "Action", "Narrative", "RPG", "multiplayer"], "long_description": "In the near future, the world is under control of a quantum artificial intelligence known as \u201cAdam,\u201d attempting to assume the role of a god. Adam believes that the role of god is to be an object of awe \u2014 one of overwhelming fear. The mech weapons known as \"Deus Ex Machina,\" feared as mechanical gods, launch a global invasion, slaughtering everyone who refuses to obey.\n\nClose to humanity\u2019s last stronghold, \"Tokyo Ark,\" enhanced humans known as \"Avatars\" engage in ferocious battles. Their main weapon, \"Scapegoat,\" is crafted from the remains of fallen comrades, in an endless cycle in which someone's death helps those who keep fighting. The Avatars have a saying in relation to this: \"I'll make sure to pick up your bones.\"\n\n\u25a0 Challenge your fate\u2026\nIn a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n\n\u25a0 \u2026like never before!\nThe feeling of \u201covercoming an impossible challenge\u201d will reward those who bravely fight until the end. Become one with the protagonist and face your enemies for the fate of the world!\n\nFighting in VR - the transformable weapons\nYou can switch your \u2018Scapegoat\u2019 between two different modes, allowing for versatile combat techniques, reach, and power.\n\n\u25a0 The final frontier\nThanks to the power of VR you will face death again and again, and experience the emotional impact of a \u201cstory of life through death.\u201d\n", "short_description": "In a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n"}, {"images": {"nodes": []}, "id": "1517897722154633", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SOUL COVENANT\uff08\u30bd\u30a6\u30eb\u30fb\u30b3\u30f4\u30a7\u30ca\u30f3\u30c8\uff09", "keywords": ["RPG", "JRPG", "Action", "multiplayer", "Story"], "long_description": "\u6642\u306f\u8fd1\u672a\u6765\u2015\u2015\n\u4e16\u754c\u3092\u638c\u63e1\u3059\u308b\u306e\u306f\u3001\u795e\u306e\u5f79\u5272\u3092\u4ee3\u884c\u3057\u3088\u3046\u3068\u3059\u308b\u91cf\u5b50\u4eba\u5de5\u77e5\u80fd\u3060\u3063\u305f\u3002\n\n\u305d\u306e\u4eba\u5de5\u77e5\u80fd\u301d\u30a2\u30c0\u30e0\u301f\u304c\u8003\u3048\u308b\u795e\u306e\u6a5f\u80fd\u3068\u306f\u754f\u6016\u306e\u5bfe\u8c61\u2015\u2015\n\u3064\u307e\u308a\u5727\u5012\u7684\u306a\u6050\u6016\u3060\u3063\u305f\u3002\n\u6a5f\u68b0\u4ed5\u639b\u3051\u306e\u795e\u3068\u3082\u754f\u308c\
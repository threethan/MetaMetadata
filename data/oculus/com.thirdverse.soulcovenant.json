}, "id": "920308209793935", "locale": "en_US", "screenshots": [{"file_name": "SoulCovenant_1.png", "id": "1554947625298158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982690_1554947628631491_6471347349642440710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYqFX_38NsUQ7kNvwGuyf04&_nc_oc=AdldkV4bXUOE4qihp-mUBl8K7viBhnhsZtjrE7X8W-ZUBevZJm9HuoEi81zdKEYVReY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsxEdcwap8r2bimicX8XCKJWC-DY7b9Qn1UFjlw1E8KgA&oe=69A2D04B"}, {"file_name": "SoulCovenant_2.png", "id": "1038611270559961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974482_1038611273893294_806951884030854284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akEfLJFjJj4Q7kNvwFfzV9Q&_nc_oc=AdlxBrgkQ8asoI_mWHCSG0TPQ9PWUc8yKB7HYXMJBLbgtbaGv6ZTVTjn4B5Hz_VhMrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSsG2Ojk27qhY0cIuvQ88wX8zYqMw3waH_K9QVXccl2g&oe=69A2FD11"}, {"file_name": "SoulCovenant_3.png", "id": "714281797437850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974858_714281800771183_6750938816274632546_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thvsam1f6CQQ7kNvwGesEdv&_nc_oc=AdnJVO_uQUYRrgwRXQvp3InC0rVmvTGmZiDR1nXtsmVKJH-WKq-HWGz6vR4Qg1x_jAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuG8E19gRS3zPLxenwxKAhdC-WOJ_wBG5Zoh0ROYYIz0g&oe=69A2E807"}, {"file_name": "SoulCovenant_4.png", "id": "886195333296725", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_886195336630058_4839328764469424707_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcnuLsAFEKIQ7kNvwHjCcVf&_nc_oc=AdmkS7H-Al1Hnjtu-wPHnGYj-6bX0jXvcWjX6if7Tcl3n66DzWj_AZ66EMclnQJPi0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfteaTVj9B_LkhNKGj3zn6IEUMxJpCnRXKLZ2wX6OC9nZw&oe=69A2F6EB"}, {"file_name": "SoulCovenant_5.png", "id": "695174452818987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982617_695174456152320_4031427662436737406_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OJcDqwDHg0Q7kNvwG2klS1&_nc_oc=Adnjqp8eD7PzagJXyjypnPHmoqq5Lc7aDbfOtEK7aazfJe-frpxInHpsu1kQRQnuESM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcyMWs-J4EwmYFNWR1nhyEezPRpohitXUk7XADnuO2wA&oe=69A2F772"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sam.png", "id": "951948659755922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974514_951948663089255_5272432868408069691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgiV7e3Z6nwQ7kNvwHlucFv&_nc_oc=AdkWr3rYDvHofHNuYiE-IgO8AtRkodUnCCMxgQE3GdjBBlBGOSe3sMFL0J8FRDUvFzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7cWbb73j0W5hqgYde7Q64wrZgBZuqpieEsOBrx9bsQA&oe=69A2D0E5"}, "display_name": "SOUL COVENANT", "keywords": ["JRPG", "Action", "Narrative", "RPG", "multiplayer"], "long_description": "In the near future, the world is under control of a quantum artificial intelligence known as \u201cAdam,\u201d attempting to assume the role of a god. Adam believes that the role of god is to be an object of awe \u2014 one of overwhelming fear. The mech weapons known as \"Deus Ex Machina,\" feared as mechanical gods, launch a global invasion, slaughtering everyone who refuses to obey.\n\nClose to humanity\u2019s last stronghold, \"Tokyo Ark,\" enhanced humans known as \"Avatars\" engage in ferocious battles. Their main weapon, \"Scapegoat,\" is crafted from the remains of fallen comrades, in an endless cycle in which someone's death helps those who keep fighting. The Avatars have a saying in relation to this: \"I'll make sure to pick up your bones.\"\n\n\u25a0 Challenge your fate\u2026\nIn a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n\n\u25a0 \u2026like never before!\nThe feeling of \u201covercoming an impossible challenge\u201d will reward those who bravely fight until the end. Become one with the protagonist and face your enemies for the fate of the world!\n\nFighting in VR - the transformable weapons\nYou can switch your \u2018Scapegoat\u2019 between two different modes, allowing for versatile combat techniques, reach, and power.\n\n\u25a0 The final frontier\nThanks to the power of VR you will face death again and again, and experience the emotional impact of a \u201cstory of life through death.\u201d\n", "short_description": "In a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://soul-covenant.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_HK", "zh_TW", "fr", "es_MX", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "7161146157314636"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "3742318182683097"}, {"status": "PUBLISHED", "id": "367398249140789"}, {"status": "PUBLISHED", "id": "1110464573529255"}, {"status": "PUBLISHED", "id": "263280430150248"}, {"status": "PUBLISHED", "id": "903975308406
TLSi&_nc_oc=AdpzGd-abZkImSLz9PmRmLfGrLXOCtXagu186oC4A7Lv9QwAtfdLrP8w9qT2S6wPVxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaD-s0XYTPOAOtTPmPl7K38fpApB9nuIXjEUwDI1u7NQ&oe=6AB28BEB"}, {"file_name": "SoulCovenant_5.png", "id": "695174452818987", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982617_695174456152320_4031427662436737406_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98iLI1twWdAQ7kNvwGYJ8nF&_nc_oc=Adqa_61VXnQW2M4zNWniCAVW7KY9s5YgHc1AiCaybycMMh9DBypGYkzLGcNiWCzziK8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr5KpDVDnwMhCGsJSl6mB_6m6MduDULV29qi_jqfFFgQ&oe=6AB28C72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sam.png", "id": "951948659755922", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974514_951948663089255_5272432868408069691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xndcWa-EgawQ7kNvwE3RKsB&_nc_oc=Adq0f346HMM7q7chvKXIhNAnMY1bzZGseuOzXCJpKmGiU5TSNZy3Cz1fE4nxAl7nRtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnrefY8xaMwVR8j4qYLBZve1vfZu7cv0I05BRVO_QTZw&oe=6AB29E25"}, "display_name": "SOUL COVENANT", "keywords": ["JRPG", "Action", "Narrative", "RPG", "multiplayer"], "long_description": "In the near future, the world is under control of a quantum artificial intelligence known as \u201cAdam,\u201d attempting to assume the role of a god. Adam believes that the role of god is to be an object of awe \u2014 one of overwhelming fear. The mech weapons known as \"Deus Ex Machina,\" feared as mechanical gods, launch a global invasion, slaughtering everyone who refuses to obey.\n\nClose to humanity\u2019s last stronghold, \"Tokyo Ark,\" enhanced humans known as \"Avatars\" engage in ferocious battles. Their main weapon, \"Scapegoat,\" is crafted from the remains of fallen comrades, in an endless cycle in which someone's death helps those who keep fighting. The Avatars have a saying in relation to this: \"I'll make sure to pick up your bones.\"\n\n\u25a0 Challenge your fate\u2026\nIn a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n\n\u25a0 \u2026like never before!\nThe feeling of \u201covercoming an impossible challenge\u201d will reward those who bravely fight until the end. Become one with the protagonist and face your enemies for the fate of the world!\n\nFighting in VR - the transformable weapons\nYou can switch your \u2018Scapegoat\u2019 between two different modes, allowing for versatile combat techniques, reach, and power.\n\n\u25a0 The final frontier\nThanks to the power of VR you will face death again and again, and experience the emotional impact of a \u201cstory of life through death.\u201d\n", "short_description": "In a dystopic Japan, a dramatic battle between humanity and machines unfolds as you fight your way through hordes of enemies and colossal foes. Experience the power of VR with transformable weapons and special abilities!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thirdverse.io/ja/privacy-policy.html", "developer_terms_of_service_url": "https://www.thirdverse.io/ja/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://soul-covenant.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_HK", "zh_TW", "fr", "es_MX", "fr_CA"], "supported_input_devices": [
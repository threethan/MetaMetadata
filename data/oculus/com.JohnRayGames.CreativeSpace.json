t-ams2-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY6_5vSjazEQ7kNvwEGaeTl&_nc_oc=AdmN8A1zghZZm56G8-1nTzhr7z4mb8XLUL_iSPrh0uuOT2IK_6uKK8_bkMw7e73RCxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsfE492PCpjw6fAryRoobSOQ_i5JpD-RZmg6vAqMYuyGg&oe=69A83712"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdHQTcIWoNEQ7kNvwEWO8HK&_nc_oc=AdkAI0vPWiUP3Y18kv5rAEmQc-vqvHLYXg7WkKFcVqJ58LNZSrvDIZJTLDxEIs7TOl4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu0zHiRFwjg0sOBXrx-5Q_OqIWgTKe-u32ZHSRZ_-SuCA&oe=69A81854"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORo9DnF7Jt8Q7kNvwGas3Pg&_nc_oc=AdlSaHFqOpguO2SBmWJKM7ZH5lMRqocuLfrpPMI2gX9bp6aFjbONfnQ1ogY_MNpO3EA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvyr8A-M2yXa-fvtoZEmswct_N1svsm5VJ7v_Vq_5OjIw&oe=69A821BF"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative Space is a must-have for every Meta Quest owner, offering boundless opportunities to express your creativity.", "short_description": "Unleash your creativity in this intuitive, fun, Creative Space."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/creative-space", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8491562487523043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43997714_1217261856296116_5665206870556641672_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnO3Wc1UujgQ7kNvwGciDs0&_nc_oc=AdnRZuxaN0g2Nf_DjfroSd5o0-D_9kZEPL5N0Ke7zWJjUKp5DxH6IA7UPfwTRNH4quA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvh1wRnt0LTPaK1K8bHokX602cGSoYE9JahgdXnVpBVRw&oe=69A806DD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Creative Space: Unleash Your Imagination", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1653683799, "lastRevision": {"n
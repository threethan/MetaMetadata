94652612350174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiyP7aqu-ToQ7kNvwHfMkVo&_nc_oc=Adr286yEDixkXCBLmrU0kkv8TkDqlVT6bQ42aZlhm5TH6MkjDyC3uD3j1DZOXg6vWTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4xYk-HZ-GxSRHFp4ChZQoxudB2FCfGAJHkz-deZaQIg&oe=6A5E2612"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxNSQ4vZ_qsQ7kNvwG02Twf&_nc_oc=Adok3owV7j5swdYzoErZgVZLyw41XQ-MJuZVn9SYaThQvSiKU-iHHz6SBpPaVgcViFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwNJ5XsXO5jemH0Y2DCuBt_5cIBrBCCKDJgTmvMgFmlA&oe=6A5E0754"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omC1ENH7Ff8Q7kNvwFpgAAx&_nc_oc=Adr8PbUdXwpXxVbu-pvbWKcZrZ1-q-WLC29tKIs-NLRpGb-SCBKc8DJefV6qqa1C_Qo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoo_UrbmieTrZwKsTFEqR32eF2LG8eT6_6UeHqoAU17w&oe=6A5E10BF"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
94652612350174", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_m8MMlBn-4Q7kNvwFoXsBR&_nc_oc=AdoI8sMZgnrFnqK_VkXjlnZmq9Kn11kQm_zCdo5p6LqrtZBZdxmqESR6DRnvvUTBihk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLzDiC6QcQpAdnE22YWWPy8MSUdKMGiim8CnZ80n5k4w&oe=6AAA9D12"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZXo5f013scQ7kNvwED-dhz&_nc_oc=AdqFcSAKG3hVzb00oYvw89eE3A3pGfChVoRb-VjTSNGoWv9PKWLi6pThfAyUABdWBOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2dz41zf-1KoY2lEZKtXkHcERMx2pdf1Y26k0IOel6yA&oe=6AAAB694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-XujKDRUCMQ7kNvwE0GD5J&_nc_oc=AdpdzhZ_eVI3FmBFIq4fUFnlhHvLWuj90DHNc5k044n97vH-_fmJyghy6t9d0OhXMS0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD6B6eux_z1-R_V679wbQpCkVO33xbQ0Iibo58upT-PQ&oe=6AAA87BF"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative Space is a must-have for every Meta Quest owner, offering boundless opportunities to express your creativity.", "short_description": "Unleash your creativity in this intuitive, fun, Creative Space."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/creative-space", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8491562487523043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43997714_1217261856296116_5665206870556641672_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJk1BgmlzDYQ7kNvwE4CrXk&_nc_oc=Ado03VNayhss-6b61cHSqS1lSNESW_b03YiXM-SrnI8Lzwoekp6S8mq7egkv6jFfPBA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLtmFMf4sVYRpuXg0zPgxYYkiZk1X7KWOdGXPdZkDy5g&oe=6AAAA51D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Creative Space: Unleash Your Imagination", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "181902164488
c_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0_kWA4_x9UQ7kNvwETKkl5&_nc_oc=AdmlTvnZx3FT_x7KX5-kU9tWzoMb4us5LZ1wvCG-JFGowaOJ-zHW6fG8EqHJE30p_V0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuwoO1n6pwIL5oOfc1LS-SE8vAOhRhtySoWgGAX2auj5A&oe=69A59412"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoLJ6lQYz98Q7kNvwH3DTuA&_nc_oc=AdmXrxgYMNwR1EFN45VlLT5p0A8_4cArTEr2ElCdyaiGeTdPEe2EI0QrkpradikY-PE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvqbwYCsKe54PMtDrWRP2VlYS_recASxMpgLOy0STOxdA&oe=69A57554"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORo9DnF7Jt8Q7kNvwHrkLvp&_nc_oc=AdnApfVgdxogOgINW-sMechyMrsm8DXupQmR_OX20aLgSRuy7KMHXyelL2lilwXUT2Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsiOp_lM_woMuE4utRSXwUc4B1lnWpAc_9XrmLp7iPfzA&oe=69A57EBF"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative Space is a must-have for every Meta Quest owner, offering boundless opportunities to express your creativity.", "short_description": "Unleash your creativity in this intuitive, fun, Creative Space."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/creative-space", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8491562487523043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/43997714_1217261856296116_5665206870556641672_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3p0k2KXB0wQ7kNvwFqn9nZ&_nc_oc=AdmA_xImr6D4wpG8CIidEBdYsokJ7UcorcLIc4z_qfjk1NHa1cs7O_py45-a9KWVCts&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvCRtckWA1IDxMzYb4QPNcMr6jy7lyqWGUPOjz4ohjAMg&oe=69A59C1D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Creative Space: Unleash Your Imagination", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1653683799, "lastRevision": {"nodes": [{"id": "5498563940156261", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applica
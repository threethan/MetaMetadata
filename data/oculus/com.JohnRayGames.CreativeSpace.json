94652612350174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQLR1-QrojYQ7kNvwEWcDFM&_nc_oc=AdrYgEMiN-9InXBBZHVaSFQ5kiDk0AyfaJ2ZnqbVlMBAvXGe1norJIStbc7y6gpPMoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTu62ehrguKMiwyIxbp1f5IR1DTiGDXj9N8RSSYcDnQg&oe=6AEB3692"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwz-sa1agxgQ7kNvwGp3_k_&_nc_oc=AdrpRORFTUn_PcwXDM-DC15jEpscKOj3aYlh-9EVFz3j8w3mMbebt5Kf-aYAWXlvWBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0EAIZd6TA4eKGqRUP1c607xFKTuVnH4ZVt0s8J4YuEg&oe=6AEB5014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_GU-ldXbp0Q7kNvwGmcQ2-&_nc_oc=AdqBuD9ru0bl38DCF_HL1puIOsGpPDz8Phi2JaQMIFNWOBvUro00HjPr6PJD6TOHVk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw9QjzMP6fkQ2UuFHHbPz9Hd1uYHOjUrhDUROenOm3IQ&oe=6AEB597F"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
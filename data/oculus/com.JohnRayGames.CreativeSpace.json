94652612350174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTOQm_D-zaEQ7kNvwEA5n6j&_nc_oc=Adqc4ScAXOazvXjR1K23s9eXrjDDPn-MQDpFDjcnKYuVUYkLLloKQjXP5xO0z4FffJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUX2vtwBV5KuZrHN8lWF6A-GzrC5CESlOtPUUHCIvRHg&oe=6A79D592"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBUsidvmPtUQ7kNvwFd8ug9&_nc_oc=Adoob11z98u018ffnS4xcRiN-ArA_hZGZreb5Ggr5P12OwhItvb5R5S5VVFZ3xN_H9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQJvYXMgEq3QPUXWPV_cGtZmyF8q17LJP3hWWv6EDzPw&oe=6A79B6D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwuyOgHIiNgQ7kNvwEdd7Sx&_nc_oc=AdoV_t1DFoHQhCWooqqYdsM_X1wVIH_SefpDRz0zgjo0zrkm5p_PuY0JWURm-4cUcLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO01QGbGXLBJlNAaALpUdAV2xTxFhaBtkMCzsCIXVJHw&oe=6A79C03F"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
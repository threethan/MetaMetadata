94652612350174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEH--sel4fkQ7kNvwGy05HK&_nc_oc=AdpUH0fIPBabsLLRgRcJR-DvNi8akX2-bQO5GYI1YXl6QQa0bKE2MT0xGYtaQQdbgo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa4BV_xBfd8Gs83JVh7vflDjjZpMlxXd2bjwP7MBjNrQ&oe=6A4D0292"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9ce4MsNzVYQ7kNvwEwK5kG&_nc_oc=Adq5Cfo-PIAeCKemdYcXIDn21DyOO9WCoPzVRIG6HV-P1IpPsxsFg_vmcR-5M7eyINc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-ZC-lONXTKzyNYUEmQp3GzpQ56kWVK2RqadbjGKap_w&oe=6A4D1C14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVNOlaCLqN4Q7kNvwGbOWs_&_nc_oc=Adr3MEvLSwROD0EQqOkxYbWwvk1zBXHeR_Gyfo7Mt-sHPf3yR0a_PTFlBKeNx0FWeDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzFr43lVMcOR52KOef__wX_TB-p5zNJD3Ja5fmazH_nA&oe=6A4CED3F"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
94652612350174", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ts-GwH2oYUUQ7kNvwHpQ-9_&_nc_oc=Adpva-502RwH1XbAVBb07xGKgATBNTn_2GyemxP1lsSVmERmMaw1ldCRp2QXu4V3Zyw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fr7GBi7Gm3tR0fggB0_LzmhSRqhginYUYyFKQ3THlqQ&oe=6A1C3B12"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLXZPONmd54Q7kNvwHMPzwJ&_nc_oc=AdosrQH_C92RBVz9mlESrVJky42ijCweHt-lICcj6OgShkL_v0BX2Ddu2x-MQ2Ph0Vg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gQd_JvXH3Kbi8K_amBWgaO3sHZfQZiQDAEuQa7Ed87w&oe=6A1C5494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wG8fMYUI3P8Q7kNvwG-ch4l&_nc_oc=AdorE0NUkmkc6iWSTA0B2YbSsejfFyJM_kQPvZuSA2Qhq4fiasIj4WyIRd8mQHOT9M0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nZlrPpHwnlJ43Eu03-5GFD1cw1zANF7BLzH-_lgjWOQ&oe=6A1C5DFF"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
94652612350174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAjiVnNHFc0Q7kNvwErbpv0&_nc_oc=AdrWdGmTnBoY07YNCbWoVWirjQDo9Ywd5oCOifYjGZ3DW9m8-V3gonOIT0ZtJu-coCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7CCSLuSmCzOE92pBn1FLlfsfwVK0x2ENmJBfqq6fCyg&oe=6A6A0392"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLEpTwZ13PQQ7kNvwF604ht&_nc_oc=AdoKCGjFQylA5LgWBPYZRAsNH4C9FDHXOVS8ZdwzlgwDZkMVFbRuGDOhUw9o9ocpbKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKxdftsWC2IrxL_wYcB_ZzoAM17h-PgN-mksdZdFWQlw&oe=6A69E4D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erA6en9QNn0Q7kNvwGHuQnF&_nc_oc=AdqM34K_-sJ-jUB2hdJgfwKeTQZ-tVkB7t2rrBVxbNxeNCzF6BqGICjUPBzy_-m-ZN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJwjZ_c0pUbpLQjWJcVWidkGh3T2CXzBr8GVjqZD8TwA&oe=6A69EE3F"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
c_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JU7EJFXrUDcQ7kNvwEOG2-6&_nc_oc=Adml4u6A5HEV_QJxu4KkhcMBVTUZgLwvHz-cw06m8iQgKlxFl35vbfMY3YGjdOYJaWI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvZU0rP3SvPevWBMFIzYk7W2pbg-zVHLACIRR5_1SNd7w&oe=699EFC92"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzNo74xf1JUQ7kNvwF7g4ZB&_nc_oc=Adl4cHxzbnNMiEWKw0xSAuP2l1wj-t6Zh0STH-ORxFjE-TR_u8poPQTnb-wQuNaDBFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftrSVIAsTv18Txfec9VmhGSgWWBWrw4maYHZvav4abqAA&oe=699EDDD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5K8AOWLXeEQ7kNvwFHORtW&_nc_oc=AdmWONVF2Sr9Q-vkNbjMHnN55Ydp_5b9gPKGcmEpBSAviEWWWVTWRXWWO7cOJ6gpkEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuiUT87n51NYNuHYQPegmNryTcs6pCuKLsvB2kgM5pG8Q&oe=699EE73F"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative Space is a must-have for every Meta Quest owner, offering boundless opportunities to express your creativity.", "short_description": "Unleash your creativity in this intuitive, fun, Creative Space."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/creative-space", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8491562487523043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43997714_1217261856296116_5665206870556641672_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ldqO-Sc8HsQ7kNvwH4hcpv&_nc_oc=AdkmYwSURrjOI5F-kgjfrRwRLvLhx2Bxei_Pa18lLAyo1ayLQEaeXKjAU1BDX0UuPhI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft7e5kEAqGZFC5TICH-rcoVFOVZn5a97GQc8VdbCkUONA&oe=699F049D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Creative Space: Unleash Your Imagination", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1653683799, "lastRevision": {"nodes": [{"id": "5498563940156261", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applica
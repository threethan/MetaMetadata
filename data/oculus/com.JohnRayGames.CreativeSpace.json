t-iad3-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dpjlc5chd9cQ7kNvwFmV0o6&_nc_oc=AdmXSCOKtXKn7u7uD8tCLFqHcfTy-6egUwYwQ2CrNQp-jMe46sPB8z69lgoaRIseRYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEvMtq8wqgkprNY86b0wKag9UtGLxJ-XJjKEDg1OhE0A&oe=69BFF212"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAh86VyVmw0Q7kNvwFGiv2E&_nc_oc=AdmjDtMST9AHzcTB1BleErF0OG7_GUGhYxq8LY6G7yl7rAJTTfkQel8rDtqSewxs3QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwx6SImKnJnscg-tiC93kI1zlcK5KK-79YZTsONt6Uuvw&oe=69BFD354"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-4PpttKSA0Q7kNvwFtR1XS&_nc_oc=AdlNmgcHM5x2_4AkTRyVNTo29nr_VZjrD73zF-spPGkfVApTR-YNwwgdYOSNaaOJ5Kc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBBlUVHgp05t5NIwvbYi6FX6IPDqjLhXXgIeXapbX8hw&oe=69BFDCBF"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative Space is a must-have for every Meta Quest owner, offering boundless opportunities to express your creativity.", "short_description": "Unleash your creativity in this intuitive, fun, Creative Space."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/creative-space", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8491562487523043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43997714_1217261856296116_5665206870556641672_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQR68xIlTdkQ7kNvwFyuD1a&_nc_oc=AdkMc9GgTLzBhk_V-WOvBV21uTSOvT0Ou0iGTxMm1wgBidl0jE1RQ6PPctdfSKC3vAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfziXHI5-WfMiC6GeGHb3GE9XgNOQgrz6EN9tMPT2F_lbQ&oe=69BFFA1D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Creative Space: Unleash Your Imagination", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1653683799, "lastRevision": {"n
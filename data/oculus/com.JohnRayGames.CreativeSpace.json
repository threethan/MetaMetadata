94652612350174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--MCJYT0z-QQ7kNvwGzducp&_nc_oc=Adr3rM0xdlzgBxjOg9XqJWdiXEIzTfmcZzLTvUYqtB29GvtHoktKMU3tthAQqkLFQdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M9kIF0d0Mlk5J53Me1mzr1H0zYWcyRl0mJOiGymRX4w&oe=6A0DBA92"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jotGgIXLEw0Q7kNvwGjNJvH&_nc_oc=AdopAjOC5V7ntYzsTM5PeyFXdpbxUpGciB6BmLLWz2q7jG0Vfz7yo-wsvhcMMexBQ-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66f48E-yNJfal6juvxCbBnziFmBXwSZeSyfZg63pMmzA&oe=6A0DD414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxlJC2MCu7cQ7kNvwGr7reM&_nc_oc=Adql2XZbIOx1tEN5yd_-KKpw_ZQ2JyGZbCxOz0jcqPJ29Tey-JcTX1W1O4bPOFjiu2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SecDO2InKWm0DYnROZvuJeEOgUMf-IoQOyISskGUX5Q&oe=6A0DA53F"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
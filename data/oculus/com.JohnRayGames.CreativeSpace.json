94652612350174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw0MZBjAM70Q7kNvwFxqpMB&_nc_oc=Adrw-OP3fMX6bAEslHryy-tB9T9SQjAiCQTs905ynUsubhX2V_Vf807_sjmEkUf8kVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HRuyhxOZnUoNeDFTEis2eWPwmcNl_PX3AWSG-9IqF6A&oe=6A2D5E92"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_NJa6cyezUQ7kNvwHhRNk-&_nc_oc=AdpoUnrtk_Ic9Nkt0GbOynob9sPpdShphKQqFfoDdKP92XeEvepiPardTSm33GeMTTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fT7bcnDB8q5yF-K6LnKCeo6qDZ8N3OHaflS7kabJzAQ&oe=6A2D7814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NZuRhEkg2AQ7kNvwFIHOr2&_nc_oc=AdrVB684YJ3mRgmF76XCZ9uLNvEfQMjgwm4PkYS2KbD5J9HadBUAnqO0k7Yrle2sVuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DhNWVgqzvobmtfUWYsYp8fklfy-NLDMaRdlenNrH3bw&oe=6A2D493F"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
94652612350174", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYbYLnCzqrYQ7kNvwH1iicJ&_nc_oc=AdqYywJhpYqZu0o3t-zMUD1Jqkl5OiPfISZra7Pz2_l6qqT7IYTROQud68jvN-m1LTU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8SxaaYSIIoTfHyFTyZ_FJWrHOHcWzsPs0TcKmIg4QVw&oe=6A5A3192"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgemsJ30LIoQ7kNvwGMtHMo&_nc_oc=AdqAQu3Ikd38IabeMT-D3Ir6y5tLXaLw3yw8aPfPXsO57IoeCu04c-_ZeeOF55P-oo8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB9ix-_nUymMyoVwy0_BiHIFE_srpYIaMoQZmUCXJtIA&oe=6A5A12D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9pkUQLFRPkQ7kNvwFEy4Un&_nc_oc=AdqCojPk4voAmekdah2Ep-LSTjhIiGQL8obXOqc3dsfie4RoJ_MPSEkAUDIX6eiM870&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADOVsZFpYpFycWZ15gb1V5_VWq4C_PxHeDGVGnbOujQw&oe=6A5A1C3F"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
94652612350174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJEhXLvaoFEQ7kNvwGxWchy&_nc_oc=AdoI8lm0QyiAOGJ4USeQKJEB6tLeBKS1_G8DWcEh12wVyBhKolJmBjituGEs1SpU5Z0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_58NN9fgrRCHznnotZ5vkSnzzKIAKtbKLBboH1IsZ8YA&oe=6A3A8D92"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2seI8tN79gQ7kNvwGO5xCc&_nc_oc=Adp8CXXc-R8tf78q-3FbIM5EEd-qCZK42tJxsr5adauMAzMMMzQLDqHDXNVo4OjzkfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RDekhz-9ZMY1h3siLc7rsN8R8PvUvH7JgPW1BTIjfdg&oe=6A3AA714"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4162Z_Mqtn0Q7kNvwFEhCsi&_nc_oc=AdrnkGSU3wD-bU3SVE4G4zov8hFcOlpOtdo-tNtBixznfE3ptTPcs_dj39FpCSumH-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XsYlR5SDmDbwsz80IPBhUFZUf1lMoZDjQEJ5X2MK7Qw&oe=6A3AB07F"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative Space is a must-have for every Meta Quest owner, offering boundless opportunities to express your creativity.", "short_description": "Unleash your creativity in this intuitive, fun, Creative Space."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/creative-space", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8491562487523043"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/43997714_1217261856296116_5665206870556641672_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7UjZ9GlW04Q7kNvwEx2kyC&_nc_oc=AdovsHyJoLd3ls_jpZYx4fqfC98ek50e_ZNQpi8uARHun_qUA_duAFs8Fohlg_FwEsU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vnn5T2OVOqe9NWcdbhJe5g3jd7hcLdRMJXFLnX_kNDA&oe=6A3A959D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Creative Space: Unleash Your Imagination", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "181902164488
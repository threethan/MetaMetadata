94652612350174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974715_494652615683507_5194124961108494274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5PvG_lFcE8Q7kNvwETk8pE&_nc_oc=AdrDS2euQ-CtBARwh6JdvZDxIwiH9l3FX-ETafEhjyKsC5q8_VFKjzrg_HZrBQ7nsL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9DDZ8AAMg1gHqLmVe6dhxaebHwL3sBIJ17lImVjSV1w&oe=6A75E112"}, {"file_name": "1.png", "id": "1978238639040659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1978238642373992_2464860172263174746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0xdoL3nXX4Q7kNvwGd81jO&_nc_oc=AdrB1eXBFreVcsw8NJ_jnTRlWTG5l9_nMfSkWeZqN1mLoULqDuvVZ5S9CwcjSlWBEgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRWvAor0jz_UXh118cuI_MMg7wm-5f-NqNpVrv7q_ROA&oe=6A75FA94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CRS 2560x1440.png", "id": "825963566336391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982580_825963569669724_988132790043764915_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e0yCldOQAoQ7kNvwFojt52&_nc_oc=AdqXqyOnNfBilpa6L5gBkP3xPG-AfeZ4vWvlq62uCJQjkuoGA3lykxAcT1NjB4s1exE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEG3Shkgk7En_Sghuq1MBVDSpe7xpzfoHmlN0vU3fJ_Q&oe=6A75CBBF"}, "display_name": "Creative Space: Unleash Your Imagination", "keywords": ["art", "build", "create", "zen", "relax"], "long_description": "Dive into Creative Space, the ultimate VR playground for artists, creatives, and anyone eager to explore their imagination. With its intuitive interface and open environment, creating masterpieces has never been easier or more fun.\n\nUser-Friendly Gameplay: Jump right in with no steep learning curve.\n\nIntuitive Design: Navigate effortlessly as you bring your ideas to life.\n\nEndless Creativity: Utilize orbs and cubes to craft anything you can dream up.\n\nSave and Load Projects: Easily continue your work whenever you want.\n\nCreative S
.\n\n", "short_description": "Reject Humanity, Embrace the COLOBUS!\n\nRun, play, and connect with friends from around the world in a truly unique experience. Personalize your journey by choosing your colors, names, and cosmetics to stand out!\n\nEnjoy our innovative locomotion system, but please note, as it\u2019s one-of-a-kind, a few bugs might pop up along the way. We appreciate your understanding and hope you enjoy the adventure!"}]}, "developer_name": "MazzVR", "developer_privacy_policy_url": "https://sites.google.com/view/colobusvr/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/colobusvr/tos", "publisher_name": "MazzVR", "support_website_url": null, "website_url": "https://sites.google.com/view/colobusvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28011663935145901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230047_576822920940571_1748439710273377753_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jw8ZW8_6cB0Q7kNvwHPafGh&_nc_oc=AdpzgLtB_7LO9joEqbhgyf79hjz1YQjFYvyL3t442-b6GvX1Q_TAPcJvn9AFIl_iEXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHFVX-h_xE1Whmt8bG4vpQAGirG9X53gWhXNuBE45S7w&oe=69CD07DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Colobus", "platform": "ANDROID_6
LpuULYIzCPBI4oG5Av_ISuftzZvFBDZ1obA&oe=6AF3434C"}, {"file_name": "Screenshot 2025-01-13 221052_resized.png", "id": "1378459423564252", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1378459426897585_3434185272031891654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKxXCIPsEZkQ7kNvwExOC9m&_nc_oc=AdqWEMrHEs4xD_LJqIt1-JpsEV2-9hjlB0dBqtxa4XwteUglJ0S8ilmLgWdbC8Ok424&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQivlOJhyrFZBtFAQJpBTb3eVYLIvoNa2jCiP5--eFRnQ&oe=6AF3494A"}, {"file_name": "output-onlinepngtools (3).png", "id": "981547177212989", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_981547180546322_1161826827854370285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k07JHiOUuqAQ7kNvwGJDvTF&_nc_oc=AdqsH4OyrQalBZvsRnEwjsL7PeSfksLDJIfgFnoFq1oUgmSZzqdutLEVgMHzg5hoyM4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCghEgDyZU2PBE8tEY7FiZoaosWAjTE7a3QZJcYnVswQ&oe=6AF3577C"}, {"file_name": "Screenshot 2025-01-13 221443_resized.png", "id": "1106322034312973", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391952_1106322037646306_8736429830345530108_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szGZigNjhcsQ7kNvwEjcZc6&_nc_oc=Adq9U5Y2JwUmez3mE18Xr4pXSi6ojI19gw0jYKJ88Pmeo-ANpS9OiswkNu22dGI-geA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTYDLaEm4Lhi2AiwaK93jcRQQICzh5XBnYql4X7r2wPQ&oe=6AF339D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Colobus", "keywords": ["colobus", "fun"], "long_description": "Get Active, Stay Healthy, and Have Fun with This Exciting VR Experience!\n\nThis game is packed with action and designed to keep you moving, all while helping you stay healthy. So, grab a glass of water, download the game, and get ready for loads of fun in a truly unique VR world!\n\nWhat\u2019s in the Game?\nThere\u2019s plenty to do! Check out the short description for a sneak peek of the exciting features waiting for you.\n\n", "short_description": "Reject Humanity, Embrace the COLOBUS!\n\nRun, play, and connect with friends from around the world in a truly unique experience. Personalize your journey by choosing your colors, names, and cosmetics to stand out!\n\nEnjoy our innovative locomotion system, but please note, as it\u2019s one-of-a-kind, a few bugs might pop up along the way. We appreciate your understanding and hope you enjoy the adventure!"}]}, "developer_name": "MazzVR", "developer_privacy_policy_url": "https://sites.google.com/view/colobusvr/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/colobusvr/tos", "publisher_name": "MazzVR", "support_website_url": null, "website_url": "https://sites.google.com/view/colobusvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28011663935145901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230047_576822920940571_1748439710273377753_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwFah6J5jvgQ7kNvwFV4eAQ&_nc_oc=AdrewBpllhixs6wDarSA6OUQx03brRXduJwtCFhbt0MSGVY8vM4vQCQ2lgGieMSApIA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfcG5_gUxyNi6TeMvMzR_g-eCPrX2Xln8woB8IX9n1lw&oe=6AF33E9C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Colobus", "platform": "ANDROID_6
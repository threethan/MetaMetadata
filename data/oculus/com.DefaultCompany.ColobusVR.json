9NH4QfhzpzVeJsC_u5_JAUjSVzyXqLvWU8A&oe=6A15C74C"}, {"file_name": "Screenshot 2025-01-13 221052_resized.png", "id": "1378459423564252", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393507_1378459426897585_3434185272031891654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAqDa9JUQYEQ7kNvwFkncSU&_nc_oc=AdpLPAfeqpoSNxgdiIn__zffo21mTkfNKa4l71xZ4FzHQIgQn46rN_CBhFXQFXfnXAw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y4H8pWnliasxmtosoC8jn0tWRfmWjlwec4aIMVIKowA&oe=6A15950A"}, {"file_name": "output-onlinepngtools (3).png", "id": "981547177212989", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_981547180546322_1161826827854370285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FySr0PLAEMQ7kNvwFfxjCr&_nc_oc=Adr0Nnget4ThLt0z25U2HOvvBOdUH0ljuqJdkVI4JGQ0pr_ROTfUvQNnLQerl-nRDyw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45m1yz9sAcAlBERIlCDPivJ1-t_a99opmepEEuFRBW8A&oe=6A15A33C"}, {"file_name": "Screenshot 2025-01-13 221443_resized.png", "id": "1106322034312973", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391952_1106322037646306_8736429830345530108_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ko9iieuUxwQ7kNvwFaBRzt&_nc_oc=AdrCUf05B_NnaoXE-6YYhIIh6uMxYB2456Jh7DDv9EPVsLCl_ltjMIb4lOL4twa4iIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ebhv_w7jpnmGy2YYsJzy4nlnpWrH3U05GUs9wsni2uA&oe=6A15BDD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Colobus", "keywords": ["colobus", "fun"], "long_description": "Get Active, Stay Healthy, and Have Fun with This Exciting VR Experience!\n\nThis game is packed with action and designed to keep you moving, all while helping you stay healthy. So, grab a glass of water, download the game, and get ready for loads of fun in a truly unique VR world!\n\nWhat\u2019s in the Game?\nThere\u2019s plenty to do! Check out the short description for a sneak peek of the exciting features waiting for you.\n\n", "short_description": "Reject Humanity, Embrace the COLOBUS!\n\nRun, play, and connect with friends from around the world in a truly unique experience. Personalize your journey by choosing your colors, names, and cosmetics to stand out!\n\nEnjoy our innovative locomotion system, but please note, as it\u2019s one-of-a-kind, a few bugs might pop up along the way. We appreciate your understanding and hope you enjoy the adventure!"}]}, "developer_name": "MazzVR", "developer_privacy_policy_url": "https://sites.google.com/view/colobusvr/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/colobusvr/tos", "publisher_name": "MazzVR", "support_website_url": null, "website_url": "https://sites.google.com/view/colobusvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28011663935145901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230047_576822920940571_1748439710273377753_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9E8TJILMGAQ7kNvwHu2Mkx&_nc_oc=Ado6Q1x80JrUh_5aV-IGXp-JBSGhkxeki_w_FhYLmwWRvhNCpeIk1QeodFMFNLvYbE4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fExJRVc_pkI_C4gtqqiP_LxdEcSjbTHjpSKcsJ7i2tw&oe=6A15C29C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Colobus", "platform": "ANDROID_6
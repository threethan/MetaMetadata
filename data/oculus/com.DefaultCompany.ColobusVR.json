6&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vH3_dYJAv9QQ7kNvwGIqJBr&_nc_oc=Ado7flD5KkajLpmiJK2JWfnqqXP3vbFaZAY5Z0IJ5XWgLrgQLX2PkIIz3xyz_hq1o3A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlfgkhO0D42wU01hKFE7jlcsObPUZ3bRb9CyiJJv57nw&oe=6AFC7DCC"}, {"file_name": "Screenshot 2025-01-13 221052_resized.png", "id": "1378459423564252", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1378459426897585_3434185272031891654_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5byTvFMNg0kQ7kNvwGM9NWB&_nc_oc=AdqqGEJavzosqlDJ1tBEVybh1z1ZPlM5zTWgFOPfbQyHyvoF8z3qSzQ0xEj6KguLxfk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0yAKjRvOLGJzfxCpfYh46-a0kz7HR0OE5K8Gx7lLO8A&oe=6AFC83CA"}, {"file_name": "output-onlinepngtools (3).png", "id": "981547177212989", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_981547180546322_1161826827854370285_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PMkCs_6wioQ7kNvwHJ8zw8&_nc_oc=AdrRBGJY-9cs0EEcE-eKc120jS3TVH0mhOPHkj4IawMcNUO5UgZc2Fl-r5F3-OqDL-Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-KL-IIp2uXgdj2bKE0y5UpfFKkE2HsKxcqNkHC4VXxA&oe=6AFC91FC"}, {"file_name": "Screenshot 2025-01-13 221443_resized.png", "id": "1106322034312973", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391952_1106322037646306_8736429830345530108_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pk3HAcSQcj4Q7kNvwF-5EO8&_nc_oc=AdpHT9eBIXO6nUvkVDzYV7lq9egUohMWPtul_QCvg-7AdWycqehWcgvZw6LvF_5C97A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXclN6lSB31lDArIVtuH41BiawDmq40i_mdMdYShiXBA&oe=6AFC7451"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Colobus", "keywords": ["colobus", "fun"], "long_description": "Get Active, Stay Healthy, and Have Fun with This Exciting VR Experience!\n\nThis game is packed with action and designed to keep you moving, all while helping you stay healthy. So, grab a glass of water, download the game, and get ready for loads of fun in a truly unique VR world!\n\nWhat\u2019s in the Game?\nThere\u2019s plenty to do! Check out the short description for a sneak peek of the exciting features waiting for you.\n\n", "short_description": "Reject Humanity, Embrace the COLOBUS!\n\nRun, play, and connect with friends from around the world in a truly unique experience. Personalize your journey by choosing your colors, names, and cosmetics to stand out!\n\nEnjoy our innovative locomotion system, but please note, as it\u2019s one-of-a-kind, a few bugs might pop up along the way. We appreciate your understanding and hope you enjoy the adventure!"}]}, "developer_name": "MazzVR", "developer_privacy_policy_url": "https://sites.google.com/view/colobusvr/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/colobusvr/tos", "publisher_name": "MazzVR", "support_website_url": null, "website_url": "https://sites.google.com/view/colobusvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28011663935145901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230047_576822920940571_1748439710273377753_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_KarJr
, {"file_name": "ScreenShot_03.png", "id": "874361290158490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572943_874361293491823_25491877015245656_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPWCvzE67aIQ7kNvwH4qCKn&_nc_oc=AdqPJQBfo5g3f0PogUNZlT7_OkoRc2Ln3NJEva3Av-2hieq8xmhnH385G9PWTSAjXgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaa9f_WSRNhYda8DCIaeoOVs3My6SPGvUBBYIZzKZupg&oe=6B0C65D2"}, {"file_name": "ScreenShot_04.png", "id": "590097725732571", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_590097729065904_6277981197038015806_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf9vJREu6uwQ7kNvwHguGuE&_nc_oc=Ado-YLMQP_tUkv1cwZU1TKcXc5qG9MuSQN2Un5FhhIE8U6dm33NnlciWCPEaGWEPPXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREQSikklv1abFR2Hv3_f30Ht9NWa8n14dSD0lycA8YCQ&oe=6B0C7E1D"}, {"file_name": "ScreenShot_05.png", "id": "384817316599695", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974786_384817319933028_6592143532172468119_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tINOyyRWJEYQ7kNvwGrH3y1&_nc_oc=Adr8eVXd6G773m_RFLRpVlM2hAtXg0sxACBaxI1cWc4_ur8T0MmRof-NLe8pSpnFktg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS66TQZh_yeLRUhtCmIfgEuXXA20qPoVsodyoJxs-nvMA&oe=6B0C7E26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kauri Classroom", "keywords": [], "long_description": "Kauri trees are treasured, iconic giants of the New Zealand forest. They are among the largest and longest-lived trees in the world. The largest of all, T\u0101ne Mahuta, is about 2,000 years old and hosts an entire ecosystem of more than 100 species in his canopy. However, the kauri are currently threatened by a tiny microbe causing kauri dieback disease. This VR experience teaches you about the kauri tree and its connectedness with the surrounding forest. It also introduces the microbe causing kauri dieback disease, and what you can do to help keep the forest healthy. By using VR to encourage your curiosity about the forest, this experience aims to set you on the path to a lifelong interest in kaitiakitanga (guardianship of your natural environment)", "short_description": "Kauri are giants of the New Zealand forest and among the largest trees in the world. However, they are currently threatened by a tiny microbe that causes kauri dieback disease. This VR experience teaches you about the kauri tree, its connectedness with the surrounding forest, the microbe causing the disease, and what you can do to help keep the forest healthy."}]}, "developer_name": "Jeff Jones", "developer_privacy_policy_url": "http://www.tekuraotekauri.nz/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Victoria University of Wellington", "support_website_url": "http://www.tekuraotekauri.nz/contact-us.html", "website_url": "http://www.tekuraotekauri.nz/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1023660631566407"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "496274098361903"}]}, "baseline_offer": {"id": "496274098361903"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1634080500, "status": "PUBLISHED", "id": "496274
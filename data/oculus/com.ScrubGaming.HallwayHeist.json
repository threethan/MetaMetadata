.com/v/t64.5771-25/39001679_545933807791106_6826334454889195725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF8Z8iH7RnwQ7kNvwF6ZpHd&_nc_oc=AdprqEMn0DXGsm82T6eYVQhSAfVUruQQX9kdygwc7oBBQZWr7Eg_LO4e7Lt5TBiEzKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSneVQVbH_k5pV6xrCd4-EOP79rExw9IlLkmj1bmHwAw&oe=6A53850F"}, "display_name": "Hallway Heist", "keywords": ["mixed", "reality", "laser", "puzzle", "MR"], "long_description": "In Hallway Heist, dodge and crawl your way through lasers to reclaim a stolen gem! Three years ago, a precious gem was stolen from you home town! Navigate from one end of your hallway to the other through a series of progressively difficult levels of lasers! At the end, you'll find the gem... if you don't get caught first!\n\nThis game is a demo from Scrub Gaming, an indie game studio. It only has three levels, but let me know if you like it and I can make some more! Hope you enjoy!", "short_description": "Dodge and crawl your way through lasers to reclaim a stolen gem!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scrub-gaming/hallway-heist/privacy-policies", "developer_terms_of_service_url": "https://sites.google.com/view/scrub-gaming/hallway-heist/terms-of-service", "publisher_name": "Scrub Gaming", "support_website_url": null, "website_url": "https://sites.google.com/view/scrub-gaming/home", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
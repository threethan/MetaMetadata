d5-2.oculuscdn.com/v/t64.5771-25/12138832_1677714962447193_991992719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vUJFfwY19wQ7kNvwENGQFh&_nc_oc=Adl4t9FSOhSzrrJbCjBGFDuad9gJBi6ouYOz6IHMn-gj323C6dswDqUoOye9UdPAQ3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHEe-gvLDJSi_SIVgsteufEP9NAjcPDklqrGvZprJOyQ&oe=69B2AE4F"}, {"file_name": "migrated_image.png", "id": "144322826931417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138836_907079036038062_361380641_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj1w756CdggQ7kNvwGbeErH&_nc_oc=AdlX1W5BEoA3OnrKEPN5Cg1DEgrW6En0NUNBWYusoQNmZTwOfYAj8e8gdE6yxC_DW9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6DCflB_Di9xv2QJTAx2ercJXLDpuW0HShiehj4EDA_g&oe=69B2CAF8"}, {"file_name": "migrated_image.png", "id": "636802547102048", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138813_1635053490094760_28210884_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjLQKTHi-JsQ7kNvwErniwX&_nc_oc=Adk1HdUv-tC4Iz1eCt_IygWBViOK1zit6Kw49jHR5jO6TvbMbp1SZ8Qx4ifEnzCHmS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfykJu6cXFFHpe-eYOkPXM2kp1fnAgac7l56TOG_K7s6WQ&oe=69B2C69D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Andromedum", "keywords": [], "long_description": "Andromedum is a VR novel with stereoscopic environments and audio narration.\n\nJack Philips is running, and he can\u2019t even remember why.\nHunted through the remnants of a world once occupied by ancients who left behind nothing but fractured clues to their world, Jack has almost as little information about his identity. Only a sword too fine for any common soldier and flashes of memory telling him things that would get anyone else in the kingdom executed.\nJack must decide whether to keep on running, or finally make a stand for the world as it should be. Either way, the hunters are still coming. He might not remember them, but they definitely remember him.", "short_desc
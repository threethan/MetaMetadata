26", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138832_1677714962447193_991992719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kRuaJECfwYQ7kNvwFBv99Z&_nc_oc=AdoUJo2EEn3ZdYnr3tXFd4apwIP8XuaGWmaO_C-fuJGRRdFFIf6aMvXdZT_wgnN_h54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RjBmqvrq3VypC69iz5OLzzCUP7j-vCcFkeTqairNlYg&oe=6A14758F"}, {"file_name": "migrated_image.png", "id": "144322826931417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138836_907079036038062_361380641_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-3lx_dGgLcQ7kNvwGgwIcd&_nc_oc=Adr5Qj0jL-6YBzbjy2f-6ix30efM6e-K7-Ptf4YNFdvH7LWMgSgutOv5W_zxdX3xIxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uDjjNuliOkz1GN4_Jvdkq64CISZmjQbDS2XGdzcs3nQ&oe=6A1459F8"}, {"file_name": "migrated_image.png", "id": "636802547102048", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138813_1635053490094760_28210884_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnneC6zYYQgQ7kNvwEP1BGJ&_nc_oc=AdoPLKoYGgZkV6TINt5VEXwX4vHLZYok-MkgDPUWkH_3rgY0D-1OBmV2U4HKY2QZwHM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k5s4kWNv8cpjc8Df3xxRRooSUWyNaopSJjZLKiS2fOw&oe=6A14559D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Andromedum", "keywords": [], "long_description": "Andromedum is a VR novel with stereoscopic environments and audio narration.\n\nJack Philips is running, and he can\u2019t even remember why.\nHunted through the remnants of a world once occupied by ancients who left behind nothing but fractured clues to their world, Jack has almost as little information about his identity. Only a sword too fine for any common soldier and flashes of memory telling him things that would get anyone else in the kingdom executed.\nJack must decide whether to keep on running, or finally make a stand for the world as it should be. Either way, the hunters are still coming. He might not remember them, but they definitely remember him.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.andromedum.com/", "developer_terms_of_service_url": "http://www.andromedum.com/", "publisher_name": "Imbanova Entertainment Inc.", "support_website_url": null, "website_url": "http://www.andromedum.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": null, "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455263766238881"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "952465188200118", "version": "1.0"}, "id": "1635265426725552", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "960573360677178", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "952465188200118"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1635265426725552"}]}, "change_log": "- Added access to Universal Menu", "created_date": 1458250200, "id": "952465188200118", "version": "1.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, 
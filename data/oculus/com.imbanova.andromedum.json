26", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138832_1677714962447193_991992719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Umz1rY1qfoQ7kNvwEP7qyk&_nc_oc=AdqMJ7OltEG0EqDi96sEHUMZHj6YqOHEoOaG53ArqF5vHvitYhUHKKpLbYfa04C1yL8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDba2bytDoMKT4odmN5NoeAjTY6YvtUyDLiEHFrute5RQ&oe=6A6F34CF"}, {"file_name": "migrated_image.png", "id": "144322826931417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138836_907079036038062_361380641_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjKnvtghHMQQ7kNvwGaYIYw&_nc_oc=AdpnZDRhkvLN9F_sh6hd7F5FTBrYB05mVjO9fOOnh3xMKcu-kkzNK82GZqVs3KJfzhY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQl_VZAcve_qV6PN5nWZPowsstwo61fsekYLfXayUvww&oe=6A6F5178"}, {"file_name": "migrated_image.png", "id": "636802547102048", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138813_1635053490094760_28210884_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm4x2p5O1pQQ7kNvwG7-n44&_nc_oc=AdoKVHwKcH3bRj4KsxWMx49ssSgAviYuiXshb1aYIxFy4aZX_t-EO-K4q3jP5TCn9DM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOaKIzxRzcMr3h9SHzuc-oePh-7l9oWgAaD1gTkl20xQ&oe=6A6F4D1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Andromedum", "keywords": [], "long_description": "Andromedum is a VR novel with stereoscopic environments and audio narration.\n\nJack Philips is running, and he can\u2019t even remember why.\nHunted through the remnants of a world once occupied by ancients who left behind nothing but fractured clues to their world, Jack has almost as little information about his identity. Only a sword too fine for any common soldier and flashes of memory telling him things that would get anyone else in the kingdom executed.\nJack must decide whether to keep on running, or finally make a stand for the world as it should be. Either way, the hunters are still coming. He might not remember them, but they definitely remember him.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.andromedum.com/", "developer_terms_of_service_url": "http://www.andromedum.com/", "publisher_name": "Imbanova Entertainment Inc.", "support_website_url": null, "website_url": "http://www.andromedum.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": null, "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455263766238881"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "952465188200118", "version": "1.0"}, "id": "1635265426725552", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "960573360677178", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "952465188200118"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1635265426725552"}]}, "change_log": "- Added access to Universal Menu", "created_date": 1458250200, "id": "952465188200118", "version": "1.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, 
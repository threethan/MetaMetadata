26", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138832_1677714962447193_991992719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDFuRA4-1wMQ7kNvwGi3VhI&_nc_oc=Ado5qFczuKpJEWAAgg36Qsw4JHto6_U2Mc-MTwCf_hBJAR-1aiysMNWfr53iAQoP71E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv_CkvB0_HxE09dRyY0WdYyczcg7rKluR0f_320OFDxQ&oe=69C7C64F"}, {"file_name": "migrated_image.png", "id": "144322826931417", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138836_907079036038062_361380641_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYQ47_CAQNkQ7kNvwFsw8U7&_nc_oc=AdrIJtAK_3DWD_8z3rAnM7mLoFahHpaSWCBv8b0xY125HSPXBxN2kyNtvtKy5hFEWgg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwmqsggp5fT69vrJIB8Z3253COJN8seLsRn0yur3vjMcQ&oe=69C7E2F8"}, {"file_name": "migrated_image.png", "id": "636802547102048", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138813_1635053490094760_28210884_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sE-_zRpysbIQ7kNvwES5iEB&_nc_oc=Adq8Wh4tt3yjQjGWk8xF1-I3n35kAWVMujwtDKfiuDdosY5B9av3ZB2VW4TnLSoOKYs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQ_O1zrROdrnH7hADjlKKoY_wclTZzTqRGoHDWfstlZw&oe=69C7DE9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Andromedum", "keywords": [], "long_description": "Andromedum is a VR novel with stereoscopic environments and audio narration.\n\nJack Philips is running, and he can\u2019t even remember why.\nHunted through the remnants of a world once occupied by ancients who left behind nothing but fractured clues to their world, Jack has almost as little information about his identity. Only a sword too fine for any common soldier and flashes of memory telling him things that would get anyone else in the kingdom executed.\nJack must decide whether to keep on running, or finally make a stand for the world as it should be. Either way, the hunters are still coming. He might not remember them, but they definitely remember him.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.andromedum.com/", "developer_terms_of_service_url": "http://www.andromedum.com/", "publisher_name": "Imbanova Entertainment Inc.", "support_website_url": null, "website_url": "http://www.andromedum.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": null, "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455263766238881"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "952465188200118", "version": "1.0"}, "id": "1635265426725552", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "960573360677178", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "952465188200118"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1635265426725552"}]}, "change_log": "- Added access to Universal Menu", "created_date": 1458250200, "id": "952465188200118", "version": "1.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, 
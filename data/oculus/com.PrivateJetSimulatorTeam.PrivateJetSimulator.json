n-0UBeuuVZ897Co_yJynHZgn998JjtYKE61hFVBtcNHfmzIlBKcDY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3mpo6sXCb0jOtkt2Y6KEbgKNWP8fa3HZtkPMjXT9XpQ&oe=6AFB17EC"}, "display_name": "Private Jet Simulator", "keywords": ["Adventure", "airplane", "simulation", "new", "action"], "long_description": "The ultimate private jet relaxation experience is here. Freely walk around the cabin of your exclusive virtual reality jet from front to back with ease. Features include:\n\n-Pick up toys, cash and gold bars\n\n-Shoot a pellet gun \n\n-Luxury watch and ammo vest\n\n-Slice and dice respawning watermelons with sabers or a katana\n\n-Launch confetti grenades\n\n-Lifelike cockpit view\n\n-Relax!\n\nAvailable now!", "short_description": "Private Jet Simulator is the ultimate VR relaxation simulator inside the cabin of your own exclusive full-size private jet. Freely walk around the cabin, pick up toys, hang out with the crew or slice and dice respawning watermelons. Enjoy your flight!"}]}, "developer_name": "Iron Establishment", "developer_privacy_policy_url": "https://ironestablishment.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Iron Establishment", "support_website_url": "https://ironestablishment.com/", "website_url": "https://ironestablishment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes"
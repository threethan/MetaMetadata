1171787686091_1571733419177573885_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdhRMPCY3MEQ7kNvwEm7act&_nc_oc=AdmUahlE5rZirq6eWx4vPsRV2kq9BxbeQZamnYWJflCqdqpNjLNSQXdGf9bjOHQrqM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsJkA7IGEu1sVzbznX3zXAKLnFGKXyfNxRO9h5pND19FQ&oe=69A41DAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PRIVATEJET_trailerpic.png", "id": "561914170039336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031430_561914173372669_8702590131799672066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IjpajFasskQ7kNvwHCbjwF&_nc_oc=Admd0okeyLkWTkfWmwQ0ONtcjKt3YWvvy3xFufbfmn4Wd33oNASpgAoUYfzYE860sAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvP24zwP-T-aXuo8kJaYBMkoRxrlw140MZ_5S313OLvFg&oe=69A419AC"}, "display_name": "Private Jet Simulator", "keywords": ["Adventure", "airplane", "simulation", "new", "action"], "long_description": "The ultimate private jet relaxation experience is here. Freely walk around the cabin of your exclusive virtual reality jet from front to back with ease. Features include:\n\n-Pick up toys, cash and gold bars\n\n-Shoot a pellet gun \n\n-Luxury watch and ammo vest\n\n-Slice and dice respawning watermelons with sabers or a katana\n\n-Launch confetti grenades\n\n-Lifelike cockpit view\n\n-Relax!\n\nAvailable now!", "short_description": "Private Jet Simulator is the ultimate VR relaxation simulator inside the cabin of your own exclusive full-size private jet. Freely walk around the cabin, pick up toys, hang out with the crew or slice and dice respawning watermelons. Enjoy your flight!"}]}, "developer_name": "Iron Establishment", "developer_privacy_policy_url": "https://ironestablishment.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Iron Establishment", "support_website_url": "https://ironestablishment.com/", "website_url": "https://ironestablishment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "c
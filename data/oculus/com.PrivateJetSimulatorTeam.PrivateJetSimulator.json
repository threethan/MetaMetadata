1171787686091_1571733419177573885_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRzy_Hedn_cQ7kNvwGqyqnl&_nc_oc=Adps60h1MiV7KiL4cMhRbYS3seiNsySq2-fkVnnaVraONybsZ7ZfORqNtAAqMKHR_Sc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1-KocydWK6Bqxw1s0t67kOwruItkrQG9dXppyJGfNgbg&oe=69F0CCEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PRIVATEJET_trailerpic.png", "id": "561914170039336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031430_561914173372669_8702590131799672066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWx7M8dLEGAQ7kNvwEc0Xe5&_nc_oc=Adp6RYjVQ32Q1MSa8LbjW8Pl98AcL9dt_8xt_5rKZyTgadFihNjqzqeqVvFVe_SWrjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3txznUqqm2ejJIRiR6VlztpbcBvi1ekNC8fGxnB8mvsw&oe=69F0C8EC"}, "display_name": "Private Jet Simulator", "keywords": ["Adventure", "airplane", "simulation", "new", "action"], "long_description": "The ultimate private jet relaxation experience is here. Freely walk around the cabin of your exclusive virtual reality jet from front to back with ease. Features include:\n\n-Pick up toys, cash and gold bars\n\n-Shoot a pellet gun \n\n-Luxury watch and ammo vest\n\n-Slice and dice respawning watermelons with sabers or a katana\n\n-Launch confetti grenades\n\n-Lifelike cockpit view\n\n-Relax!\n\nAvailable now!", "short_description": "Private Jet Simulator is the ultimate VR relaxation simulator inside the cabin of your own exclusive full-size private jet. Freely walk around the cabin, pick up toys, hang out with the crew or slice and dice respawning watermelons. Enjoy your flight!"}]}, "developer_name": "Iron Establishment", "developer_privacy_policy_url": "https://ironestablishment.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Iron Establishment", "support_website_url": "https://ironestablishment.com/", "website_url": "https://ironestablishment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "c
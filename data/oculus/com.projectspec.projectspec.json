ile_name": "screenshot5.png", "id": "922616987242664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_922616990575997_6032100802841403814_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFR5Wm8tn8wQ7kNvwH9pevR&_nc_oc=AdrjTVPHy1hRGvNG-FiOboLx_tMi_hz2EnKw9Iu_JKV1WVm6r853KCULX5uRPoE_vxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXCjjUzp8t7kDbNKzQ8Dgc10vA82p3nyKbcG-aKnjvTw&oe=6AFDBC8A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBEnNajFJAEQ7kNvwGU4pgO&_nc_oc=AdqLaD-dG1GiGZ9bmjpvyBDfs3N1I-1eTmtG4Em_4jdzgvvNRe-wcXxUmBUkipywGkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO7MNbSVcd1hUz2tCfNoIItMNA4BzHTOhrWcJULFN88w&oe=6AFDCC29"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIXsQFGKDu4Q7kNvwGPoXj5&_nc_oc=AdoO-83o4iqxBoDKjZNMyeN5e-F6grymlNlpnMMlSSGbqS02oocx_e_B8Yld5BCjZSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqkFXzPR_UmfJCmJeWU9NvvbkeB6cSDHizeMe5zc3rjg&oe=6AFDDB1C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP5GavMCiccQ7kNvwH1ZjMw&_nc_oc=AdoYq03JeDSfNdwed-x9rUEXQB2a3VuUuzIzukVSdHfxpVkeM2OD_Er_bfZGGFjCdv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMyN4GaaQ8RIjxpT4TMXkCmonL_zyjEk7ISVl4-geplA&oe=6AFDD95B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, project spec is all about community, creativity, and fun.", "short_description": "project spec is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project---spec/home", "developer_terms_of_service_url": null, "publisher_name": "izzac", "support_website_url": null, "website_url": "https://sites.google.com/view/project--spec/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
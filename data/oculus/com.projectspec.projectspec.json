499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBaVRRzgtSwQ7kNvwFBV3mo&_nc_oc=AdqK7R5PsRYVLtKwMP6xlGnpuCHfiYMPIQwfP1eZ23iIcX5HZ6Cp4zH-0twE7yW5pE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzlFH-a7C7INbGiymNQ4028ZQWm5-sCQV2mGsdkF119Q&oe=69D0FDE9"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oVJ9FOlL8UQ7kNvwHFeKZI&_nc_oc=AdrGVgFhdaISTvy8u11HtmxEUltxfAZCvzmiZQVsv7VA72-s-kL6CW8732v1u_fjGPE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeIrWUg6t-j0AoAPqHHTwjFoj5LgnA--FOvD6AvnMKQA&oe=69D10CDC"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h50L2GYdUfYQ7kNvwHCsFEl&_nc_oc=AdrmgL16jsQEAv0MPIWGuoiqiDY6G6bnX-2s4R_9SanDSzrssf-7zVJdfaDbo9FX6Ak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSeitc6ZoNCr4xgMKz1rF0bbZdKtcaGaqNWifBLV-Hlw&oe=69D10B1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, project spec is all about community, creativity, and fun.", "short_description": "project spec is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project---spec/home", "developer_terms_of_service_url": null, "publisher_name": "izzac", "support_website_url": null, "website_url": "https://sites.google.com/view/project--spec/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26659725503613029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303971_1226322272990800_6838482847245795490_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzziPM_X9_YQ7kNvwFSFGc3&_nc_oc=AdoMvJJ4WxbskoJzbkZPJhGX43BQzLqHLp0f9WySYGAEwAqD4hAHD2d8QzAdGMg6DPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiMNWSIS2QegOmfCHc68iGhTqHqQIDr5wtKGj16YXAKQ&oe=69D10DC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "project spec", "platf
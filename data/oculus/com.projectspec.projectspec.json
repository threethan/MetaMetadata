0A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVaC7eN1190Q7kNvwEpyCXk&_nc_oc=AdoImadNoNKJWUuf7fMWgKo4UJs9Fjt8ze_NoTcj6RG96OjGoKwFy3pmmHViSL-yuKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tQkhNx76s9kegbiD2MKosyT1RZNoRvuMc7PfC_sqEAw&oe=6A046869"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32LjZqOKOy4Q7kNvwGwBZiq&_nc_oc=Adrdkn3uudV_iEXNJgslq7Qbe3f4lvT3Z-p-geMRVOxlYtICe4UpO4SkbYZVU8kUGa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JQmw-qR_v8cahqrSnv2vFg5EwgV9GXYR0xYXafW9P7Q&oe=6A04775C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6DF-Vswt8AQ7kNvwFV8pEP&_nc_oc=AdrNdxvjdD4gs3VCo8DGQiln4_lnkhHi99KfL64tGqevU29wNIV5S2r3-W8mqxLdsQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VJeTSU_t8DmZ3YpA-9MRFwolNq6vtob-90Fuqu3B-Uw&oe=6A04759B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
0A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BO-j7Zt7jTYQ7kNvwEtLUop&_nc_oc=Adr0LNRz3GKNrQJyLVttCAQu4rH_uq1-OLK7rheH3zld6rFnrUwjFYf5GB68Rzo4ndA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60IVYtUCe0QUYb9qOCRu8eX0f15HD8udGwS2TBKhUesw&oe=6A1472A9"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJ0-p0BRX3EQ7kNvwHfPZzr&_nc_oc=AdpV4H6jlLYChM6vpfr2h7ilkqSz5mfl8P0X7w8Xbsw76akeFh7q8eGeO32AUkTwV1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af505vtgl4OZmU46G6QaYvgdasZvEPGZeoP5MABm3rf1hQ&oe=6A14495C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xfTm1qHy0IQ7kNvwH3xQr9&_nc_oc=AdrQnzWJx2RBoM68PGsX2hOW9GTOHjLGhELO47smhTdoThieEV-DibQy8WoRT8xljGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GoJX7bqUTMtiV9pfMnEgpWqxRD5l81FUP6BSvdUx1sg&oe=6A14479B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
0A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv8T7aIfef0Q7kNvwG_2x_8&_nc_oc=AdoMvON_9zeS_ktw0epTTVzT-hnn9lKBii1qV3mqsCmnc5o94oYEwyFsiGT4GmOSzyU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JqiVeGBBM-34RxrzklyIxYKG7fqDk442kqgo6Gk0Zxw&oe=6A0743A9"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32LjZqOKOy4Q7kNvwHLJXI8&_nc_oc=AdrjQfreqdbE0ZnxxevSuBjFKdrw8PZim0lPO90MPsgNeSKabidbnFIlpTfXLw1Ddvk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45RTKQ7LXLWcPOPFyOXHWhjgizktYQPTuTHs7zBq5SHw&oe=6A071A5C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR_57RbSwnQQ7kNvwEFTkr_&_nc_oc=AdqB-LDiNPLmOE02xgZDxRyFsye0p164diwQRHIzOGtSuCyxWFuvGea6Ia68WfGb8tM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5esGEbq1yl5beQm7BejidBa9xtkepCjPgrAd21d45mAg&oe=6A07189B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
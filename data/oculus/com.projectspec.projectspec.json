8A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahwE-T6apdQQ7kNvwHLsu7l&_nc_oc=Adr6li40f44G2CkfHLRzkJzTJhOejH1nb7sf8iL09hKQBaXAeCd8cQEuZU9UzRIfC84&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yDLMXbxrk_8YEeHkLQHuP1dlyAAC86iZS524xV4ukDA&oe=6A107E29"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSRRGL8ostEQ7kNvwHpACOK&_nc_oc=AdpM0dJLvoWdaU8zwlTVH_YqcT3BesKH5q0qBOo2D-yUuKPXxB4KEkXHc5u_A1UDLpI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CYgaaAh-t7Z6KeDpHVv92dmpmsXkr8Q31pZTjjKufeA&oe=6A1054DC"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue1tqJC8c28Q7kNvwFHtLS_&_nc_oc=AdpbRi9_uesjywJ0tHDZpWq6RVZSbWXG3e2vNfBwK_fDinyENIIfem6ItQhp0hiXTyw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NEchtfWcEZifR879JeYKzLTKyj4P5JGwr5OaWSLsofg&oe=6A10531B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
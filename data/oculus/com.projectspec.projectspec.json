mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qq4mNoRDKEjvOxyGSTV72y372ex5siUZLP0-fGdKJ0g&oe=6A3BF00A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8omYiorJ0doQ7kNvwElgOV0&_nc_oc=AdpaY3_KPTEYYh4RH-LVqSxUoRzkajnYS4jGZ_epYw-5_Oa_lQQBfmwVBNHSpyeWTU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N49LTNC13ypoPY7qylgCE48aWy_uUpQmF2Huq6annEw&oe=6A3BFFA9"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=684FOuDpABIQ7kNvwEMsAQu&_nc_oc=AdoGt-btuJzjafah8jn46E2O7u5-Ssn1g8NI_Rawux5scvkiEquzmuHhYwdCg2aaTfU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h4tNfX3PAK-ToOZEqAPa5_Qf-j2833NyR1pIOBtMqHg&oe=6A3BD65C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7Ntv0SquwMQ7kNvwG3q5WE&_nc_oc=AdrXLRrF6YS91EauIbUvTCLRClL7qDCqD5twpm8U239aQKI-ZDw2nI1iCdjyFN8cHBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sH-4ja5zD_XkRH8mC-zgUTGmDj-D8068ZCCwql54dBA&oe=6A3BD49B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, project spec is all about community, creativity, and fun.", "short_description": "project spec is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project---spec/home", "developer_terms_of_service_url": null, "publisher_name": "izzac", "support_website_url": null, "website_url": "https://sites.google.com/view/project--spec/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26659725503613029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303971_1226322272990800_6838482847245795490_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Bd0SMxyW70Q7kNvwGpRrNs&_nc_oc=Adqc9pXl-AC5RxZ1wNPqNDDLR-gVckfT9YwQ4JCE3ZdP9datWluBy0
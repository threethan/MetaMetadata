ile_name": "screenshot5.png", "id": "922616987242664", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307451_922616990575997_6032100802841403814_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFR5Wm8tn8wQ7kNvwF4OanG&_nc_oc=AdqrPcsdhmu3Gkh01jAiJZ9gUcRs6o77a5L_d2-2x64dJp4F_KUPy10ok07Wy-IZGOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzrgFBqUZB7MscTMxADx2hUN1yrB1_VD4HBiZPPF1qZw&oe=6AFC6B0A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBEnNajFJAEQ7kNvwH_FgGt&_nc_oc=AdqEsmX2wOvC1MUrem0y-7P-CFfAqOpoZ3yl1R8MvJS5HiC4Cw5ivrpEQtn_0mwQ_GE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdeGlGC2Flv3XC6jMS0NRF-JpLDaM9Kr7GAz5W1Xti2g&oe=6AFC7AA9"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8Q23419fwIQ7kNvwEhn7UL&_nc_oc=AdqDKUsquhRP2p-LIzORcqrTKURDcuh3c8ZLFEolaAxvHLgWwIVUvD3mcnnSfqRrkg0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJCru-8mVqKg5T1tkX5y02-U1DvL6vfBPNbaueLc0wjg&oe=6AFC899C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP5GavMCiccQ7kNvwEZOASv&_nc_oc=AdpcJaaBh4qulf8plrKDm3UUdcYRIXgNrT4lvnQq0VOwVboIMi2vMb0gv4ES2249e0Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk-xx2NOGFxCQFN-p41PHNl7VKU0k594CWI6JarmrcIQ&oe=6AFC87DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, project spec is all about community, creativity, and fun.", "short_description": "project spec is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project---spec/home", "developer_terms_of_service_url": null, "publisher_name": "izzac", "support_website_url": null, "website_url": "https://sites.google.com/view/project--spec/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
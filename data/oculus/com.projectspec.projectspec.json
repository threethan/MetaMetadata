ile_name": "screenshot5.png", "id": "922616987242664", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307451_922616990575997_6032100802841403814_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HI9_9ITPCUQ7kNvwGjk7Dg&_nc_oc=AdqNQdSpY4LaTKnCdKEkOrMzDDd9LOuld749Cc42EIjZh1IDfW3NhZR8CyMbRmT3is0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2OpK2qaXazE5QqC-gDDtvhTSk0zU_QHEP2QDpiSeEBQ&oe=6B08488A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxHWzmPrxuMQ7kNvwFBhSRQ&_nc_oc=Adqwanib1LdyYZED0jPKVSPFQHLBeq-m8e4TamEM6no5RgfRJf0z7otqVFoQfHj93Rc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvvfi5M5ZSrfZH8EOSfudeXP48oaZTOm-r2oUE_89UQw&oe=6B085829"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIlfI_eqe1gQ7kNvwFnnhlB&_nc_oc=AdoKzRzP2N2w8IrvGZgw2LNnTqqS5oCK7NMjCxFkvliuJjI5IWXetUzRYfmjMlWZBcI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdDH_WmGpe-kgsWLAojwV0XDKFYVbMnCybrxJO5gk0cg&oe=6B08671C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbF4ffK5b08Q7kNvwEyOHdc&_nc_oc=Ado7GP7DQUrwk64BC-P2ssuQI61Td31rxumVrlt7SbQCfQnXaohqkWv5uLtprbZPGww&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCbo8DRlIfNFpOrRWx7_EPSLzR7LRZkn_xre2qZ_-0bA&oe=6B08655B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, project spec is all about community, creativity, and fun.", "short_description": "project spec is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project---spec/home", "developer_terms_of_service_url": null, "publisher_name": "izzac", "support_website_url": null, "website_url": "https://sites.google.com/view/project--spec/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
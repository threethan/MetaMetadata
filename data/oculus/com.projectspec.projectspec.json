ile_name": "screenshot5.png", "id": "922616987242664", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307451_922616990575997_6032100802841403814_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HI9_9ITPCUQ7kNvwHcDtO6&_nc_oc=AdpdyVawwN4vhbyavbmhAEDZm_UCBFc3JBk2GQq_aMg4ZV1UGh9PJlrGYY-chYqeV9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcai978mLLAYno9jC6WzLDFaagwri9t16PPT_dFiHcuQ&oe=6B09D24A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxHWzmPrxuMQ7kNvwEx31IG&_nc_oc=AdpQqlAZgJ4htkYi-PpNR8iFkmcsVW76XByE-N2Z_9mSNhEE4TbBzwpeJqwEbkfr424&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ70Zfjkhfr8GOGF4cqzXhUGulVVVDNJu5QTckmzbz2vA&oe=6B09A9A9"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TUra2EscQoQ7kNvwEnxFnv&_nc_oc=Adpv4Jwm8JPK2EBSUbKW59I5UH6OyGcxAq00iqyaO_VZkrMD-qLIRVC3A4NKAp3t8IY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPmUzFbtNCWtizssAydCpVW-g4EGuebyXJdc4VVGdaDw&oe=6B09B89C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbF4ffK5b08Q7kNvwG9yMkw&_nc_oc=AdpMo9wAaOq6mIDT8lj0njh4m4EZFNmFY_1kIWdQ6PlYTyw1Eo8RIM-PWuk-4S9BI8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQC5Zt5LONnozVO3l-1xU4xEcJbwEXsfD8qecmJRD1dA&oe=6B09B6DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, project spec is all about community, creativity, and fun.", "short_description": "project spec is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project---spec/home", "developer_terms_of_service_url": null, "publisher_name": "izzac", "support_website_url": null, "website_url": "https://sites.google.com/view/project--spec/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_trackin
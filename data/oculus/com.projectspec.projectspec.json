0A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0iRk4UvgBwQ7kNvwEkxalt&_nc_oc=Adq_G6112W1GJP2FKFQ12ThN5KGvCgtnRRQow9H-Udw4vyIteebXVq4NnYSV2v3OIu8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_3l5im06Irdm--OO9-DVxldQzMtK-Y5y1VlJTa-a9-g&oe=69E76769"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYdjxO5ALiMQ7kNvwHlpubP&_nc_oc=AdrW5IliCpHwnN2niAsxngagi0uV9dRTAq0NjGsxvuqlwY8Mr0SXxCmPCmbf1lAXv_w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xzgWWlywDTiYzSHNXdc6o680RRg50nal6M6HUQwKIHg&oe=69E7765C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xQe1a9Ng_4Q7kNvwHQw-Ar&_nc_oc=AdoWcmGb_aLIB78SM5m26Hv-7oTxiOBXFAAoIW7JKp4-XTagqRxT5axCGjbYdpBO1Kw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QjXry8KD3XJJSR3vRZ4qYkQX3bP4g7RY0Gud9gbADkA&oe=69E7749B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
0A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9uqe-WZjbEQ7kNvwFBHk-p&_nc_oc=AdrsTdL7FAaHnBDPmoT7B8nbyN-_clXjYxFkQPwByjThu0EtJtfpm2HbkprJ0eiZMok&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61plH74-AVZywz5Lkgng5TvcmpRuRdcj6LBIpHbw6IRw&oe=6A0C89A9"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHVsbdUh-TcQ7kNvwEY_bJg&_nc_oc=AdokrGZ_xp7bLmkrlakc9waLPYQAXhbam6Reyk5Vpt7cJcOROgV-v3pZgCHfu3J40s4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ITNGTiIbsELeB9QPGWwvgDGy0zwn356ZMSc9j9-Om2Q&oe=6A0C605C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8gVZxdmgkEQ7kNvwFJlM4p&_nc_oc=AdorOh84bKikKyRS6YBzmSkPrRpdn-3JHu1rLH4v39B-CX1Qbgr_zrLY3W136M5ptH8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E-gbBWlDhSaOzeuowgOX3ZBfRmuhnC8WicI1xg5VGeg&oe=6A0C5E9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
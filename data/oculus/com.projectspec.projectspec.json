0A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DauiC-0w2CQQ7kNvwGaJOmj&_nc_oc=AdqVU4XEdGpwvrSszAAjfiwe6L50Wu8r6pOhS6Oio34f4-HlupP-xIMQxkhPrXPkmoQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D2N5qyyjiz_r78Cu9r17Iyzd0EMP4Z1Ghm0wCEvNx-A&oe=6A2444A9"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu7gHte0QkgQ7kNvwHu3dY8&_nc_oc=Adq4gjYdUgHP0AGWEc5MoRcUCEnpRYbsYeU9HhzKWf9wd4nSNCAy6hd_7fN59eiNYCo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tS9r3MnSfCSnSmm6utT3bOJJH-hpn8IoyK_7HmwB9Lg&oe=6A241B5C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVlEWXyyEV4Q7kNvwHXKcHx&_nc_oc=AdqPmTEAhEN5nioHS6fYE2p1NiM745wfC5EiYw5DYIYC1QAx4LR6NjaZuUJAGbejgt8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rvWkganh3L00rHAUCXJremmALjJFUnbwnIDEqBtfUMw&oe=6A24199B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
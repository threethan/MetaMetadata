8A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv8T7aIfef0Q7kNvwHK4SsG&_nc_oc=AdoR1uJXvY0ncVSfySTEVKSROdG6fqkBjhOJWb24w7TpYnYaWrZQcOdwjQsokp374QI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IAUXm5jiptVSYojsDPKh6aeghw-zq9IFMwFLxDZB3yw&oe=6A089529"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqjU8gESUN4Q7kNvwHI-BaB&_nc_oc=AdqkYcGArScHZ6YO1ln5EdaoEObAn8-zDwy-ktqhMurjnET4dk0vNAmmj04J8MUM4DE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j98Jt-w3ESFZqWwju813rxpsHI5gsm-ZQ6l_fI7xvEQ&oe=6A086BDC"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR_57RbSwnQQ7kNvwEiOFyv&_nc_oc=AdrffCoHmWzxbOvmhLsfLFvIUgUJSAmwzai-Y3N5SuVcU70HvszwToGQDQlkF-rRijQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bpQSnceVwu48py_wvBRvuTVhlaFnOr-Ln2O5in5OY6A&oe=6A086A1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
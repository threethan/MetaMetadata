8A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9uqe-WZjbEQ7kNvwGjxAdR&_nc_oc=AdqckcRx41fqSreTU8oOqJz42IykW0UmGYKtuj7QvK9TP5dqP1dG32J2-W4wnXvzUL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IAePmED8_fzEc6VsjJRmr48jpw_9f16maWd8y_EkGHg&oe=6A0AFFE9"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqjU8gESUN4Q7kNvwF4cIoN&_nc_oc=AdoKqBZuho9Wdsfjt6JJ4-mQhKejULVN7vq0JFzhT_HCF0g60UAR4T8AUETqllNw758&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N_j78KFFXh_5SkuOa2j3Jtx6vPeU3xP8_UMynrDfuUQ&oe=6A0B0EDC"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8gVZxdmgkEQ7kNvwHEgszV&_nc_oc=AdpOAR5YMQwp5bsmbNti2f6-EqXO4jFP4kNmVy5XxxKUeR_wjIB_CDS3jUcEFDLyito&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af508AWUTWq1bil5YZegPt0iXSE5mHJC_jP6LjAxFBA5SA&oe=6A0B0D1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
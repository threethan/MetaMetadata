0A"}, {"file_name": "screenshot3.png", "id": "1258467162909268", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499308090_1258467166242601_7926195277603536227_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahwE-T6apdQQ7kNvwEBZUkH&_nc_oc=AdpVioaeK-nahA-cme-6Ni9x7GF5jxNFK612aCAWzvGVix0ZLVRKGr73G9wrhM3EIMQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qciQ9w0-_KXJTritURybx4iYd--W-g3z6CW-gcldBDQ&oe=6A0EF469"}, {"file_name": "screenshot2.png", "id": "1232927752327910", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304305_1232927755661243_1214329875798852736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHVsbdUh-TcQ7kNvwEcrTgv&_nc_oc=AdooqMnMg0jvFdj1WTNmCAo_kdia1PoLFBVOcdcaCS5Zlksw-eSXRWYWaoSIAaM2fYk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qhg69UcK8CM7NndWG1BFUSuv7jPvkhK74zLRgi-lrNw&oe=6A0F035C"}, {"file_name": "screenshot4.png", "id": "923328893826538", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307435_923328903826537_3899955058002900266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue1tqJC8c28Q7kNvwEmCN39&_nc_oc=AdqvKmFgoNp78iqzPe6apdP3UO-GXYbzmSeRbEjt7gP2R-n5JL84VZhCF2U3vlFkhFQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KvzgCPS0sNZgdAx_89_MSccQ7Str62sndCRzvP19zzw&oe=6A0F019B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project spec", "keywords": ["Fun", "Tag", "Tags", "Gorilla", "Landscape"], "long_description": "Project spec is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join 
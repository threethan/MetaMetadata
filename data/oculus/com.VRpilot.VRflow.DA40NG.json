 "id": "858950238476856", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_858950241810189_2332313048070803044_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_qd85lx5HAQ7kNvwHc0RY2&_nc_oc=Adrlc6zbHn-cYxjRW-NZnLESSSwnr6XKdeZAGFSh1AINZKSTtvYq6CV0ZpS-AbYbg-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYXxovC3u4Q4tnlkQztChKkjO9QJoN-0l2kT_V-3MW8w&oe=6AFDC129"}, {"file_name": "Screenshot 5.png", "id": "1491587227987391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974748_1491587234654057_1655875671215711334_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTFd8pMmQPUQ7kNvwGX_5_w&_nc_oc=AdptoM1h5QLWFJ0sfFdo_adnxFfVrHF2fp_75grLUYOlS95zQuWAk-pnep2Xzjdfooo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2YDug5qXc_Hmh40q6yW4rtrbaYSD0U1rvsX_mY7CsjQ&oe=6AFDB1DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-11-23-16h37m26s808.png", "id": "1219539112108425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031340_1219539115441758_2890263535438349647_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKdVnBDkk1wQ7kNvwEkp0w8&_nc_oc=AdrRjI-2LKgJxMNaoovBdYFOKt0O5mhJCt9svTC7fru5xzx6C76JeamSGkuKPDQmDYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt6di_2p225DZYpg0rxf1Gkj0E0YQ_ucsoTyxMQmpefA&oe=6AFDD084"}, "display_name": "VRflow DA40", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow DA42 is the interactive cockpit procedure trainer for pilots flying and training on the DA40 NG. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for flight procedure training. Train with or without visual help, track your errors, see your training time, and much more.\n\n8 normal procedures and 5 emergency procedures are included with dynamic checklists and step by step explanations.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow DA40 is the interactive cockpit procedure trainer for pilots, used by flying schools and airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their flight training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FLYING", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26398502233076063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035446_896057081414196_2281970629088944241_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4li
 "id": "858950238476856", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_858950241810189_2332313048070803044_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiKlt8c8zHMQ7kNvwHTMpYK&_nc_oc=AdpQg313O-hz_j3WBewzUf6A4up_j1dyhMlR2mCBAkAQ7wWhGAL9TdASFSpbbh5HI2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQi44clrf7XlrDmf_lVaK6s85QlJO8tuam39YWpJhw9MA&oe=6B0DCB69"}, {"file_name": "Screenshot 5.png", "id": "1491587227987391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974748_1491587234654057_1655875671215711334_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNoBGvJlx4EQ7kNvwFF4lQc&_nc_oc=Adq5a8eTlWcwIUjmcc3ATg_gZY1HTALpJ_vIbPPom-i4V0q_6yVQCWtMdd_fcjRD89A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuxb6Gh8mOGH5gioP9u9t6TBNqFO-oQsh8Gr0xQFID5A&oe=6B0DBC1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-11-23-16h37m26s808.png", "id": "1219539112108425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031340_1219539115441758_2890263535438349647_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxlvzogO4loQ7kNvwErZhh7&_nc_oc=AdojrUWu3ce9aaFnL3EOEVEGQxBOKixhO7rLMvJi3sih7ypliWOuotc9La6YP7LILac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuAwkeaKCB_s5nApId6rP-G2pUDwpiXcX57QFuJ0xppQ&oe=6B0DA284"}, "display_name": "VRflow DA40", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow DA42 is the interactive cockpit procedure trainer for pilots flying and training on the DA40 NG. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for flight procedure training. Train with or without visual help, track your errors, see your training time, and much more.\n\n8 normal procedures and 5 emergency procedures are included with dynamic checklists and step by step explanations.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow DA40 is the interactive cockpit procedure trainer for pilots, used by flying schools and airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their flight training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FLYING", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26398502233076063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035446_896057081414196_2281970629088944241_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO2n
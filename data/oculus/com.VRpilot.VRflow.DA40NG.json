 "id": "858950238476856", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_858950241810189_2332313048070803044_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO38S2mgVQ4Q7kNvwH-8KRc&_nc_oc=AdpUsJZ65AOEzWz_nsLXFO_kiyu8P9ZWydFOsYV5hbzfIpw_8dagJEQkBmd50zJBLVA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTgkjcHIzwmPeRLJ3kvblnKTlTjMxZguDkOUGCnzp-Fg&oe=6B05AA29"}, {"file_name": "Screenshot 5.png", "id": "1491587227987391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974748_1491587234654057_1655875671215711334_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42cRxqb4KkYQ7kNvwEgFQAQ&_nc_oc=Adq1baxEC6pep7BOAZoiiLtpnfAsfuTb2jXhILGgtgd4ZCuDMoDV1em4RI0nm8e7UU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-f2YQNgoKdjeSbjINR1_GA6QM-4uEO4XTmOsSktEzNw&oe=6B05D31B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-11-23-16h37m26s808.png", "id": "1219539112108425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031340_1219539115441758_2890263535438349647_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHxIpb2M9OMQ7kNvwHtkOur&_nc_oc=AdoQAwJgXSLGCqjZJu6lmdM380I1Bav2yPBZjxJVfNhDHPIKQ8BQfgwEpDnS2XyHRw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEOOk7jSzSpfV0zoIx1GoJ8QOG9wlTq01yusW1A_-SYw&oe=6B05B984"}, "display_name": "VRflow DA40", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow DA42 is the interactive cockpit procedure trainer for pilots flying and training on the DA40 NG. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for flight procedure training. Train with or without visual help, track your errors, see your training time, and much more.\n\n8 normal procedures and 5 emergency procedures are included with dynamic checklists and step by step explanations.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow DA40 is the interactive cockpit procedure trainer for pilots, used by flying schools and airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their flight training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FLYING", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26398502233076063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035446_896057081414196_2281970629088944241_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhYX
, "keywords": ["ball", "shoot", "bubble", "match3", "puzzle"], "long_description": "Blast Ball Master is a new vision of the old school Zuma game. \nBlast Ball Master is a puzzle game with a new creative idea.\nBlast Ball Master is interactive and immersive game. Be inside VR.\nBlast Ball Master is a good choice for those who love shooting ball game.\n\nUse 4 boosters: Slow, Freeze, Explosion and Backward Moving! \nUse challenges to get free coins!\nEnjoy colorful effects! \nCool fun music!\nTry different VR hands to get an additional bonus.\nTry Blast Ball Master now!  ", "short_description": "Blast Ball Master is a new vision of the old school Zuma game. \nBlast Ball Master is a puzzle game with a new creative idea.\nBlast Ball Master is interactive and immersive game. Be inside VR.\nBlast Ball Master is a good choice for those who love shooting ball game.\n\nUse 4 boosters: Slow, Freeze, Explosion and Backward Moving! \nUse challenges to get free coins!\nEnjoy colorful effects! \nCool fun music!\nTry different VR hands to get an additional bonus.\nTry Blast Ball Master now! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reticulum.studio/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Reticulum Studio", "support_website_url": "https://reticulum.studio/Contacts", "website_url": "https://reticulum.studio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STA
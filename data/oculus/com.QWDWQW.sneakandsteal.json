2Vw&oe=6A942A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1017351233357847", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031478_1017351236691180_2383292809881305642_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTTSAHNKaY4Q7kNvwEEN7vA&_nc_oc=AdouDhx-rMu2Z5acO0FbZOD04nD49KWU0m0mprJvG-ulcvnDaV7KTJ3OR7A4vZIqKNs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXfz_1lk3sAjTIULHgKSFhqD7DTHd7F2UBdu7EQ1Brag&oe=6A941E8D"}, "display_name": "Sneak and Steal", "keywords": [], "long_description": "Welcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Welcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/sneakandsteal/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CCAA Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/sneakandsteal", "ca
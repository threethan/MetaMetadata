v/t64.5771-25/39031478_1017351236691180_2383292809881305642_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gvjs-xq6nqEQ7kNvwE949Z0&_nc_oc=Adl13PkqX0O-HjfyRevJVKlouq3-TrtSkzr0SpiUa1tu1jO8_e57izqbGogSJ0JJIzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsUYkKxAXfXEY0-qYHsMLdqerI56ig9IqNvFxMDCLA8Lw&oe=69A2DC0D"}, "display_name": "Sneak and Steal", "keywords": [], "long_description": "Welcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Welcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/sneakandsteal/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CCAA Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/sneakandsteal", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"},
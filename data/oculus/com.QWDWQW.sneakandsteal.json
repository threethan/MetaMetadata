64.5771-25/57572934_826237472798252_8499873791658789455_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnWiiBn_5a0Q7kNvwHPm8hN&_nc_oc=Adrf0Ndw9cxmw2LAGwYZgkRooK5obKTwNcdRJY2aWmKBFmzjQ84YLctvssixRYNyeAU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP0ZZvp0ptyU0mBmohue9jK78_D2hwHEBtnEepwKwUKA&oe=6AFB375F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1017351233357847", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031478_1017351236691180_2383292809881305642_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88wd-0JHWwkQ7kNvwFUJUfy&_nc_oc=AdqV9V3ikQATBLcNNe6nxVnpKc3P81IB1DqB2jBwHAf2rzD51i7xGQvQDgr4YuqJoxo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2ilMGhIxPtvzw8ijeWrCXMkXjRSAR52pVa4Vax2sF4w&oe=6AFB2BCD"}, "display_name": "Sneak and Steal", "keywords": [], "long_description": "Welcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges.\nGameplay\n\nBall Lines offers a unique and engaging gameplay experience, utilizing VR technology to create a sense of presence and immersion like never before. Players will find themselves in a mesmerizing environment filled with vibrant colors, futuristic designs, and intricate paths. The primary objective is simple yet challenging: control your balls, follow the lines, roads, and reach the destination.", "short_description": "Welcome to Ball Lines, an innovative and immersive VR game that challenges your precision, reflexes, and strategic thinking. Dive into a futuristic world where you control dynamic spheres, navigating them through intricate tracks and lines. Your goal is to guide these spheres to their destination while overcoming various obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/sneakandsteal/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CCAA Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/sneakandsteal", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7955466384522140"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7955857537816358", "version": "1.0"}, "id": "464132323013228", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7955466371188808", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7955857537816358"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "464132323013228"}]}, "change_log": null, "created_date": 1720803687, "id": "7955857537816358", "version": "1.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED",
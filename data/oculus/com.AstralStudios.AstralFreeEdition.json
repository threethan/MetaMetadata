vxWGF8JLa3ujj3sFrR-iHSCeRpBszFfOrJEkXpFjJgOGFOBxHBvaYtd3k8xkWV0Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZdH_OylYCoyZk54Orneixb9g8Zs9FxbUwj-wD9q5YJQ&oe=6AF35614"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfnZpCEc8Z4Q7kNvwGdCKvP&_nc_oc=Adqi6u_K2t8T3czcog0_BY8yMxwULiN3L_pLHbclaVA7mPhpF_-OpY8MfreG14ojaPE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvN29WetSeGGf9wHbrFajv5vIPsmM6E2Z_Iu4hYXe-tw&oe=6AF33D45"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v15iZ-62eEwQ7kNvwE4dmUg&_nc_oc=AdpPVrGIvnEob0XXxCpEtObGh5Ue8wgXO7v_9ADBWSYkw8irglwrXQYQfyl1JsG_kM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwqgiJu1cha3CshpKMobFR9hKJLObQVjE2WSZC8heEUw&oe=6AF32F9B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pEPzg97XcMQ7kNvwG1fdB4&_nc_oc=Adoi2kTK2FeJM8Tt5CJuDWssgel93VG-vFu9G50wNfbVs0jLK4LernTNP4A84l2MMgc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Yg0pfamiTk9z81W8UmmJr9BkSqN9DygNf5vkHkvRpg&oe=6AF33AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHLYULhhp5UQ7kNvwHiLiVn&_nc_oc=Adq9K8ojsgfFnAHsI-QmW9jjux4fVRenpECU8d-vr2Jrx1H9od4qNXstEhVwT9bE3Pc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu5vcyee5Pj22ABbTv6UU_gghOXVKxMnb7nImxsk-2XQ&oe=6AF3460D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
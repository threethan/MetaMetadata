Q85RXro5kV3KFa8VD0utXBWeLNYqHHBSWC8VJ2sJqfKcUki0zouFbZFrUUBsr690&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gWzU9Qwr-CUN57o9iSKnaeKooKioVigs9rmB-_wbG7A&oe=6A3FD1D4"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYvrsZORG78Q7kNvwGkj1iq&_nc_oc=AdqbdLuI_AWu-ugReUneZLQSRhf7oKLZuI9YozZILkG2hxafryDQTR-SugjpvGaYW5w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K3CaG2-T7oAwaN-7jF2176yXN9X3ES9sT-5la4KCPSg&oe=6A3FF145"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCPeR-IXvcAQ7kNvwGGfDS_&_nc_oc=Adph8AUJCjLOwb1VH2GQjA7AZhyWV1u0TAQynl9Cx9heqgI6t_G2NfXfkwSECFMcNK4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_61zSku8DoNxWkt6L4Z9QsNpaK-oCdpWhyv82GPE4fvA&oe=6A3FE39B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB0hwywzu3UQ7kNvwGck6Ej&_nc_oc=AdrVH16Dv_Mb_Cjsq8lJmg1iDLoOkFW_Jh6RmgasT2C7VqEoaURWQTY_85ySL1TL9e0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kWJQUQd1EWf1-hFEL_CFa3fWzo38TGsMoDMS6XipReQ&oe=6A3FEEA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mkb9a__LSdMQ7kNvwHRrcEF&_nc_oc=AdpmvZVeyfhxdEGSEDHjtFr0d-f_twXPfz9inf8rIv8pVA65_Yg_kgSYxa14uC_2nqQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gf8L0WjZETGmFv_eIxtNO_6A77Ogx3fjLg87SHqCG6w&oe=6A3FC1CD"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
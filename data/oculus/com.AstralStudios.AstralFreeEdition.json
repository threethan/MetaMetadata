uTmBYHjgt2NGlJh00obyAWHdki1Y-whMfea7tYTT5MfmGLhLkIAAf_yHPrmV4g0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NUQClyHvabBgwdAu4XTz0sQtuGlqdCORvG45aSBQztw&oe=6A2EAE54"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9yxaLKec_0Q7kNvwGZYYAO&_nc_oc=AdrDjDAEeKL6tlCxS5SHpsIoNMP9C7fiN6KHxBZVQxXc4tgj6ypJkZi_0MRbSNoxMAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LbA53GNvQ53n9hnz-42o8g2De323A_EbcZVYrs18-5A&oe=6A2ECDC5"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehhY09rEipwQ7kNvwEJWteo&_nc_oc=Ado1hbMB_Nt-EtR5-C_R62AMnIvSPDyan39LYVCBM2XdKGo0wVVe0lsrxsakcUzFSY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LF-HpS8FIj9R6OK7_Y5_yLYHNvXA0z8CTUv4FdqVtLg&oe=6A2EC01B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa33RF2SlN8Q7kNvwFPwUB-&_nc_oc=Ado1bQo75RsEhPBalNIGF_mQ3XceHKXGO-IAKxNmQUB8kmdNakG8XQn09pG-y27dpuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Rmeqr-i28A-A0VQ0lY8KuD21tY8hOnHkaPhaPMYcd9Q&oe=6A2ECB23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVJ3fC8XM6oQ7kNvwEAgQgz&_nc_oc=AdrL_7bPX5nCkB_IXgsGjZR0W4sI-ZDjZXK5mZv04hJtKo7WIa9EuGnn0zDf2yrz4CU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cdRpt8nniOZ8aEAA1O2xqk1ca3G-tYhVl4_cYcO7IKQ&oe=6A2E9E4D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
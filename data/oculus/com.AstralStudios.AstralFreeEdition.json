646_1773027246990896_6643976372148904843_n (1).png", "id": "855685790747857", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820382_855685794081190_6168179548117523439_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08_U9OTC0bAQ7kNvwGp2_2r&_nc_oc=AdpzezK9ubz3SCegl3sDqZ07Uf74gXf6Chv0RwNPxGIq9NwCcZeBtI3bkat-lI54iSU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUFZ3yQpwM4A3PzYw1ebkQ6syN6DTT1-yM6welax6BgA&oe=6A565679"}]}, "id": "1520273622629825", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1524184415461382", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499295272_1524184418794715_1700192996567705895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQnpVZLXbn0Q7kNvwH-wAZu&_nc_oc=AdpTdd-Xi3uwdIo3UbVFsyLX61NE3_OpH6xa82WGXoRVWeL02DAbuYYMKgzxsWqpffE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsh_amWLwDKbf6OCwLivKUH5pei15uFu5Qppnf7z9_Mg&oe=6A5646EC"}, {"file_name": "2.png", "id": "1724667184891709", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499310651_1724667188225042_8101162577158728479_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AneX6px4fQQQ7kNvwGhtZlL&_nc_oc=Adrb5M5POzS4YERANHGVGHmaRXNCl6HlTI69qqOW84BkkpVI8Im91O_KR4COtKrrwGg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyAma1jKzfxU6nfyigFpHghf8c9xmNGjGx12l_NieRUg&oe=6A563B54"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdhThrUULAoQ7kNvwF9ha2H&_nc_oc=AdrPnfnd9A-IBPCO8BX0wbv6l0pQEKpe4Twzogjw5CE_aliPeRr2tEOxrR_MvQU7Pp4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4GMc1Vform6kMF0CJptfCU7DCcVag9rs4Glw1QciITA&oe=6A562285"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x73nGBr_-IQ7kNvwEcpAaA&_nc_oc=AdpwBW7PDTmZSlt8lqRmA7-RQ_IeCf0QmtVKeOK2RfCh9uUC8DsiyGXCPnf3xYXDtas&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPjhp5qPLLWhNjUtRSqcpkzlGraMWYLzEn6BU-7atY4w&oe=6A564D1B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvYIN4lVCwwQ7kNvwFqcKUy&_nc_oc=AdrMDBFRZdnsNTSpJE2fjzEXssHP15BHuzOEzoD0KDuOEh2QBtgIfXdd0d7SYYdf7Xg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmM4F4GbpmApQS7xEl10ZTyNNc9z8AbWUZDfBHiDKCIw&oe=6A565823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKQgkCIo1zUQ7kNvwHKC_bg&_nc_oc=AdqMfj82MPzX8NTxklCkb8IvGH3f5OqE9npIRQ43tlkwYU765iXg9BimQUDM7WBe4Hk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAERPklfUZBfqB_IvNhuTNaPvUIC5vrPc4qHBP5nGXG_Q&oe=6A562B4D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24956151017340259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819417_856249980195730_8212089485719320015_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0QhGII_DlAQ7kNvwFkvE1w&_nc_oc=AdqHiS3SeUEPkQV8p4VN1dMpRcw-HiuJt232IpTrJ2gQrQi9KdqkYlAfzPYtENxG2TA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0C4jHeVYLJan066wBuDxxTqiacjpV825FP-AqeShzzw&oe=6A5638ED"}, "is_concept": false, "is_test": fals
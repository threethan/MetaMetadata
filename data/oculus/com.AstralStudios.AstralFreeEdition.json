o4dk&_nc_oc=Adpc3d9DVX9Nif1URlcKZjmuJgiHcZ3T5yTt13pp4jXmbVE00ZQ5BzOa7Z-euYeWNYs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dDDZ9NT2aFty_i0ZPTn0vYjkzDkwV6mPOqxqlaX5kaw&oe=6A466954"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viCF0-J4O68Q7kNvwFn4CKO&_nc_oc=Adr1lZOAumnl1xSYzdanVjnEXufAz6d0ozdAmRPseoSRLiGAQuMnbuXensew7TTFGws&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FKJpDGKd3iwIGfunLqC1mEuhxUPVR0pKwn-q40PL6Aw&oe=6A4688C5"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6G-XQmw7IaEQ7kNvwHuhYdZ&_nc_oc=Adr4aVMZfE1fmWRqCcfdDZXEQK9oWRThTXP0rvaDVHTruu7R3XPwYu0HWYNq4Udko1E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uf9VMEb3j5RCXNfb4DgUejdPyTcbfgGmCqlgG2fGFug&oe=6A467B1B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKUOPYzJxDIQ7kNvwEi_pz4&_nc_oc=AdrB8hyJJRO0dvc_KMzC209h3kNjqmzIFwNC0nRjg81l9ZFdXDS7ZrTh5tFBI-cGOQ0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Rg1rZ7hU11cTxkIZDKysiHL2Qzd0DweAL-Fhue9gdFQ&oe=6A468623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0Ginfw2rq8Q7kNvwEAkZEi&_nc_oc=AdqCltUlIUC6W2G6Lqzcna45L0ldBJI2cOU6fGt3vYwW5nrKAIqzhefZ3x0z1xKhgDw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rCRokn7RApYjxzXRkQjbfhX-SAfXyRzNIk_EvwCGvLA&oe=6A46918D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, 
1602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umOPg7vXk0oQ7kNvwF5tKKT&_nc_oc=AdprEN907FQh871gnfKdLKHCRQq6bhQ4HYGFGV1v_SyLSTNqsa_PJQCwBU4pK0ICrwQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fIfso9CxzY-EgCynCAKGfM9mU5jmpjtSroRRm5U0BaA&oe=6A01ED1B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYdBo2TZAdcQ7kNvwEDcGvq&_nc_oc=AdrZOqXBZKaml8KGehz-GkJpwCGiIVSQhvNfGiiWRHM4bNmU7r__vxc6-o1HHLHBe9w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ft3JLtEDCHW-4H3JgfCQ3fCkqVI1zGAwfQK-Te_ru-w&oe=6A01F823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdEJaxe23UQQ7kNvwEWTptq&_nc_oc=AdoMfFdXn4H0FhShEYuuGY-chTcRzE3-oSDd_QOW9XWA2uooI6R0RbNGZhhQGjHg7Pg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qAOJX03FuckUd0dfgBw00NVDVuHQLl4_ppZ5xPArWmA&oe=6A01CB4D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24956151017340259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819417_856249980195730_8212089485719320015_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOaXViZ-swkQ7kNvwFmiwUl&_nc_oc=AdrKuoD0Te4iYyke2eb5siVONTejEZgLDYvwNbMf9ZoOf-HvRsRkUh3SM6Yyu5_h24E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oJN7_kzcm-ezrYh_z8ACPov06N4WYN4ExdwsUl-WQuw&oe=6A01D8ED"}, "is_concept": false, "is_test": fals
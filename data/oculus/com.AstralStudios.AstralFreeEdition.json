J8yvXHm8aqfkxaPGvcq5StQ7k7NuqjKXul8wz70Cmfoq4u0ESCd8cx1_y_E21O3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EXvI-BzbxLxXPR-osRic8E_OiKo9ObX7JgYUri7r9oQ&oe=6A2AB9D4"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaMZFw-ApmYQ7kNvwE6qYzu&_nc_oc=AdrJt7lrGxFw1XWZtaCXZqz5Zzj60zqByV4hpMNZ2kCKsM9ROqkAtNinXuy5BAhqecc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yu1RGRPfn-GBfh6lN0uF5-QCLEuaJalssqvlc4i8MXA&oe=6A2AD945"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBIfP59OITkQ7kNvwHYtLX3&_nc_oc=AdoyimM9YIsFaM6DXHfVJm1bohn8G01vvIwFwmCh8dCvmATB3sDM7qO1Nrtx7XNbzp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0lljTrdyrBNe_1ovQSDKoH4Fn871C9letF5fuBQrqrA&oe=6A2ACB9B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o1X8Q8xPeAQ7kNvwHwcsTu&_nc_oc=AdrtRVYhQMVFlq9PbTN7EPM815hYIJuGPky2FS2Z09ORzj7Qka2_LcRRBdLlK85hXww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z4KTrB8EWK8QS-u1EMrSltM7_vhHpDHeM08a8lQaskQ&oe=6A2AD6A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7eMLNDQH6YQ7kNvwHS7YK_&_nc_oc=Adr2gckfaoxAJRrQDbDsfhv0XVXSodVcVB77JHEhbZgodm7veNBfVYbQk7i5RmW7SPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2BphtkpldZ-wwg9M4kkmwWDVHW-mU6cBXO2DWvVokDQ&oe=6A2AE20D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
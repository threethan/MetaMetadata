DDtY&_nc_oc=AdqIekEj_XhOMGI6pdYO5Lk7tNCugSMsxlBOfScNOXXCfPPfgTW4yiSUuUGbV10tw5o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZTplCVXE9c0xs5O-3GjiphgCv3u65WZM8qpU3WZKhDQ&oe=6AA949D4"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeE5EoUO3fwQ7kNvwGPq5-p&_nc_oc=AdpMGuqUcIzIlQ_p3DLLnnhmGT59DyZY-f3fCaS4fcjAfPdgxIPagQ95rqEnAMNmkfQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPfc4GhV_gu5tGy08D6N4TWlahWpEn-O3aaKnTpbGyDw&oe=6AA96945"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkMwzp7JDLQQ7kNvwHfkKof&_nc_oc=AdpvGnVL4uzTBXrigsR6L9xSUqU5fWmWpB0vFy_fyvM_n7yMTD1N-CQFWiOtpHCzVnk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwo2Qpc_kf0hmGflgy-xVU_TdnWuUzaKq5IQq5yUmO4A&oe=6AA95B9B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF8yVTISLNEQ7kNvwEFiBfo&_nc_oc=Adoezck4yn4fSrGjdje416u_1JA8qFTyGw8A60g_KnQbPc1HzmavUh4uHfaqp-YnfPw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSyGuALGf3vJ3jEufrD76rbmeRmKxQT-HpPb05UKtC8g&oe=6AA966A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckHNfg6vFQEQ7kNvwEJMKoc&_nc_oc=Adonp5M0D4NM-PVzfkMD-W00FUUdXp0RChe-nLGU-r4PA5PnLpK4V6esPPjGDNzQF0E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInOHB0hXxsTERf5fOyVf-uD--49tQgZ17f1Hy_0tv0gw&oe=6AA939CD"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, 
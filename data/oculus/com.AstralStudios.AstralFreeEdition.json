1602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Hqo8Riuh20Q7kNvwE9PcLF&_nc_oc=AdoMhi68SDz53SFpuOmjiNflzr79SZ3hC4AR4XAWv_-lyU0G1gecHX26eInlM-j8X-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuh910QAT-mf-hiW_PXFgSH5oi8z_TOy7yvC5HhLlIbQ&oe=6ACCF41B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJNojBs4EsMQ7kNvwHA9yd2&_nc_oc=AdqJJbx9FyCaltsp0Sqgu1zxkQGOpFyuy0L0XSSczBNzgyfSGvR4l4XjjmXemNYVK-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSVQ7zHJo53Sg0MVSMe6su39quMiTerbjfb_NTgdmGOA&oe=6ACCFF23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89CmQS0wOTAQ7kNvwGGPpYv&_nc_oc=Adp7UoTucRU9Eh9NTQ5bEK5id71gcx0ORe-7FycM0CAWcKVCuE5LEkChegQeCjmNASI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAP92Jj_Qq-ipD671UTJAnZdp02TeMDaRVMf_voXdt1g&oe=6ACD0A8D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24956151017340259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819417_856249980195730_8212089485719320015_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Id7T8xq1Rb0Q7kNvwFTW2pg&_nc_oc=AdpM7qk6kBQ_4BfUozRrymoBQ_82nHciTIiqC4RbR_ivHHlG7svRB6I4ljnxAyu4HU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz19vq3bGUXqh2M2xRQquYPA7AIUt0R2jLf1g5TGWHlg&oe=6ACD182D"}, "is_concept": false, "is_test": fals
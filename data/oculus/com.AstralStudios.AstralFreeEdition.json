qwilLEabfuJ5GPS7-WrLxRR1o6_p7gH8b47egPzu5e_Qon8lSiVLYmlODmDWcHn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhmSVSbe2qO8Jk-dq5cbyWsXr7h6gKC3ZzndCMzsJoFw&oe=6ABBBED4"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIpyfyfkl8YQ7kNvwF6fNJU&_nc_oc=Ado95tJHFSjHjkWw94Pg86uo7HfwfUIJcomCDaAVUAjJRHKeH28jnkBTxO76Jx_Bmno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7oILU2zDm7NoYPNw8YaqlOunIYjGiubE-bWwJvvYBAQ&oe=6ABBDE45"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L5qfh0I7-4Q7kNvwGeFN0d&_nc_oc=Adpaba8I8Gch2CgmgF2eVRGgmYSVp4E-8EcFVpfaTXxbzR-ikrqDInm8h6rZm6GZHxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi-nGR-7rvQV99O-J6Y4VZBHrpFyXOjfY-rxbrf4MpDw&oe=6ABBD09B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5H_7UsDeP0Q7kNvwH-lKBw&_nc_oc=AdqPBPLZLac_gFsep-VgvPR47A94jw8TauYTMv5CWQu7cmy_iOp99sI2u7Uqd-Qh0fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPiMIuGcry6zvc1iDlupIYH2694ohZOc4564BhDomnMQ&oe=6ABBDBA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogaz180tx3EQ7kNvwHqHijs&_nc_oc=AdpWm07DB5iwmlmlqQBjFlzBvKtUQGK353yyQrV8vXuxn5sp06bHco3IoswHxyIaJuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWqRAVjKudanYjxB5yTYU7KbpT8GvCOEZ9xv6mgslWwg&oe=6ABBAECD"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
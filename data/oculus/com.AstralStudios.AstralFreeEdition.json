_WaX7uwE8Nw4sWycWaySKx36x0kF-xaCew9GaeNsaq7NWPmnZu07mqfvAtVUzdOM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sZlltZ3pc0r8AGcVPKhIV3l7Od0wfCcizTpbRTwTs-Q&oe=6A09C454"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TscNlFSWwqMQ7kNvwGQCp6z&_nc_oc=Adq8WQZ1ONHYLRcxxvUeMRm2nAKS6ShJbX6oaGguOd0YTLznG6gl0m1yUBHs_MtYOX4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51kRsAS0ATLXC1jY55R8lcRKJWSi1kaLdEx1z8U-Qubw&oe=6A09E3C5"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBIAGkMIGCMQ7kNvwHikEGj&_nc_oc=AdoK5dZ8M1Xr3ujsuaP49hWu6DGqFY4f1GZiuTOZL0_ytJxh7d3a_vQ2vhL0_Ed9Iq0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xZiK8qkBA7ZDZKoz_jEe-hsYlVIGfAdz2yoCqxLwXgA&oe=6A09D61B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV8mcZoySXoQ7kNvwHIyj1l&_nc_oc=Adr-IRCs2Bzcjp_xvBvT2nIPHwi2SJOkx0NX5Ucr5bItH72g4zYMSKDytT7LOGSmZxw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QxlQowJVcSE_5t6wTLfcdrIeJ0ZAjaAES0wFwt-9oWw&oe=6A09E123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_I2yZCpyBAQ7kNvwEbLtbE&_nc_oc=Adq5ypQZvxMXzS_oqKKyW7kmU3hd59mXx3ISuxpmBnkEVVGakKguZ15BAntOqdMjLw0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N-o6OpHBVD9UOiFd4XgVpkAU2cklhZs3kZBfZ90DsBA&oe=6A09B44D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
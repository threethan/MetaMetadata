-1RNuacQHUKz-_4AnwPC9De3A2I2vlEdKbYhSKJ85_Jknrow1yfVsL2gOQQXMyyA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_01Oo1x-O54z5wEqNx3tIZc0j6zwyuc2fFqCwKSx68g&oe=6AF0B314"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfnZpCEc8Z4Q7kNvwH1Pioc&_nc_oc=Adrqd6H8TA-378_pHqJLPDhwVanndTbIySuCxjVeWDFN6wF6r8MlPgZ7IxvQTpIadxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2wTkRDurM8gFKWX3F25bYbz8Q2rfMf_vVOPJdJoaboQ&oe=6AF09A45"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v15iZ-62eEwQ7kNvwH4tqtF&_nc_oc=AdrjfAYfVVHliz4BCRfOMfqoP2PbGpug8ih5jUiDrBHkiFdSD1Ie08znBtnjeqV4a98&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg1CCQyqCb49wKhTVEXyaahcFnekVE7OMEQxM5nFZWnA&oe=6AF08C9B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pEPzg97XcMQ7kNvwHcirGe&_nc_oc=AdqFcynByNeyrCqPSNVYPe7fQFcW-R0tm4n40ilH3su9pfd0ptYgl55BqqcUNEp2mh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrcVxNEdD91l-nK-6CQJkVcgTt2uHY8AmcfkrsfIjsUQ&oe=6AF097A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xCT0TTMpU8Q7kNvwFJ5I9x&_nc_oc=AdpqWrH6Q-HteqkuWGzYC7BO1zDYz6GgOFE4X51Qh7uh1wQa7RtN3Gu57OblH3ooxfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP3Rc2ysoQCBsaMZdkFMkmXqnT6mf2pgzklrEDHn8WAA&oe=6AF0A30D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
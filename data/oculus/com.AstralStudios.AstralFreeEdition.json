RMfHIcCYyYWlnJ1Oyb-z7K_SU3plTjtfCGy8YI6A49b4cyxmV11YXNMcGK0dPZ_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rXDi1EGc3zqkKbPQEMh3ocNuknhQocYJmVUIJhnpjAQ&oe=6A3D2ED4"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmOgDtAAw-0Q7kNvwEYF8vC&_nc_oc=Adphx-Y0_odGgzzPGIsj5FKr5CW0aNOhKp-Tf0gUVHKpC4tGl-K4FLFBpK-ixJHSIRs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FlxKCRbXBJQ7TacnW86DOKzmnlpiZeG1WDNpBKOAMMA&oe=6A3D4E45"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6AP0VSouqkQ7kNvwH6bfyO&_nc_oc=Adrv_iDwsTEj7GoTbwthya3D2t-1YItyiOoFc1_AukRf9dBFGeR82ns90xP3Ge7b48Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1a0PlsA7Z-wdOyJS_Pox_cK-Bn-Ges4k_F3_AJcVqKA&oe=6A3D409B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8Ku9hTa-UYQ7kNvwFseh2j&_nc_oc=Adq2-9pAjYcociItuzIFy-MX3K-0xaC40BAVWpeYYB9S43X_tqBxiTubaxvfQYCAIn4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xyJ0T3JJJze23QPSPCE-yF4asE-f70mSbOgroLBiGzQ&oe=6A3D4BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHCp86wQD0sQ7kNvwHmjXPT&_nc_oc=Ado1SqeN3I3603K7o_gV_mp4PqvskmzXRJEoF-1Hzc3-v1rx8hfVVUmtYkiK_D8cJds&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w2khdoV1Lj_aQOaYUP-ydegs_yiUS_f-RGmtfjKgHbA&oe=6A3D570D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
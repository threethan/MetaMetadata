646_1773027246990896_6643976372148904843_n (1).png", "id": "855685790747857", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820382_855685794081190_6168179548117523439_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lw-Mv-7-3zEQ7kNvwES2Auv&_nc_oc=Adou1sfKPl2lfEccw44RVutoyPQxPiCIbt5vzQPUa7GB-TdKb1yjbjfoqQu__ojilF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0XO2L-uiSQbiCpmsrOPOK-axnUWr73VLDnystcVkaqQ&oe=6A43E179"}]}, "id": "1520273622629825", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1524184415461382", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295272_1524184418794715_1700192996567705895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnYQ1xBG88IQ7kNvwEmqeXy&_nc_oc=Adr69VAPJox7-qxbxpsT3_M9qfe6-RAp0ssPIBPsQJzFMx8Nuz_gzePJo3d31mwXpDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FARQQNP-jvHyxg5TTum_e6SZY5N5P8RhdGuALZkusAw&oe=6A43D1EC"}, {"file_name": "2.png", "id": "1724667184891709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1724667188225042_8101162577158728479_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Wt-MiPyaTAQ7kNvwG8zFT9&_nc_oc=Adpgq1mQpyhWBAvHz_NlprRP6Zh9bD2w9QA27E-HBfwM_nHqbZSIPiIrfIGT5JBkZ60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xZWo2UXE4PPmxooVCatILAj68smRb50VaP56CNLUbwg&oe=6A43C654"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnKpl-tvp2YQ7kNvwEtstqH&_nc_oc=Adq28Rc4e-b5T2V7npfbCV2obhMRRFbFT2Iehx1ze0KLW6qiALdQPy5ak_byY-qv-Aw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cOIkaa3cO4EW69XzggcUMOt_1aRAiNmGTCGEO6AsNmg&oe=6A43E5C5"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XmDy6Rk49sQ7kNvwFuYhuw&_nc_oc=AdrTGifuYEolUHwzBOH-r4084yLEUtQFZwL4f42z1_mVXdJ4TkDrNpaDC6elsyXThgM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c-Cins0EetpeaJFt6xxLzU-Tk-JjdkoYnYY4SHtgFkA&oe=6A43D81B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKUOPYzJxDIQ7kNvwFogWGH&_nc_oc=AdoEy1mL0bV1hM9-SOC8DHftEUhodVyX54Q1VFQLq3gWyp_UaGEkuol3iNMbGoLaUEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8VjSw_u9eIakZ_MzrFzesfMP0KYaN4KwIfJJSGtjlbg&oe=6A43E323"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0Ginfw2rq8Q7kNvwG3nUh0&_nc_oc=Ado2Tf_Ufe3Z5_eykfoJ7oEBOgbaoCYK-TsxfNDloVHHW8VbGE4N4kQMEwplX353FIw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7x2RI4w4E0icA0YhyNQAqn2LxbJ9DJMR-ywOaU9q5ww&oe=6A43B64D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24956151017340259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819417_856249980195730_8212089485719320015_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xNiMMmNQqEQ7kNvwEea71v&_nc_oc=Adr0-IRYukKjoy--mk-TNsKBvKOxcfEF9fD-w0a8-yVGZxhi0UmCtSg4ZKLKjVYfVRs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AfRfyT0hsq-KCM9qqUdx956kN24eovgFa1K-8C_9mKA&oe=6A43C3ED"}, "is_concept": false, "is_test": fals
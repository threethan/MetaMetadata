xT1qqNpZGL-9eXUExlNXILb9Gr2rNJVFEOZm4xrng9C6vVNAF-kEDR8_UL_7np3k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQLqf8tGK8-wV0AKh1ZcbjCMRuOaiif_braCfLlRY4tw&oe=6AB132D4"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuMdZovK_JsQ7kNvwGh-yzO&_nc_oc=Adou3STlrQD4GAt88yp2l2gu6I5AxBoYus28syt5YlCj0_9bKLzR6Mzjxtzus6toXlY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVBIVDAUyrGDuOLdvtJpAEIXjSZyFrFnrre-Vy8uYJDA&oe=6AB15245"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZQwdvx2KVoQ7kNvwEnDtnk&_nc_oc=AdodmaA2yc87GWMgTtDAnjLE8--0SOQqkb_2fb3u9wF0M7rGfpAaIZNmGPLecGxgWa4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJriZ9CM4wN6cH5BdnQMmknn0jsLBa79jBNfdZqWCoVMw&oe=6AB1449B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29n-O1kCeh8Q7kNvwF1wW_M&_nc_oc=Adq1gfj67xfz8idd0_SNaQ0wmAIEWaHviFAtRf2QD3ZDw6u_J6bvBOmxH-Tc6Ebfu_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXND2hqahRoF8mJRorQUhIwRb6N7KmLJM_Dk0yx4cagQ&oe=6AB14FA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CpBm9DyspwQ7kNvwGUR8sI&_nc_oc=AdpdEER20yp2aLnHT7kPIOYlNEj8-m_GEemDFkhf7MBf9DpOaayfsNUNmKXjg6c7M38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZH44A99x481egiD6BD_-tcr6YXRYYcn6ie2r_8Bfeyg&oe=6AB122CD"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
1602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80hAao0aKMsQ7kNvwGWyRJ8&_nc_oc=AdqjNeuRtFOY6LShgp3Uh0sdueW2XGdt20_NKdwSvAGeec6yQ8R1LNKD3Sh4djUTX-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-I78_uHEu6W81cVRPYBiZPcmUNrX12Akm0kZ5LnK6ow&oe=6A8C225B"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Msjyvr_HTaoQ7kNvwGImkix&_nc_oc=AdpXpy0eMOFoVH6hH_QlSKDNEaayEL8yY3A9y1-xNfP4OE-kwAAwwXvAoC-Do-kIy6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlsi_bDmEkJcTjTfqmu5bPoLi6jMnhv_Yr8lrR3PhfsQ&oe=6A8C2D63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkSZfkogGvYQ7kNvwG9xCOM&_nc_oc=AdrdMFndIpQcK6o5fWPfpOVG1std1onJLBLFzTKaFO-U0F23MIO_J7xoSLmozLaMcso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2DhfD2WDZe0Ywf2ngsLFmzGhSxw4HPRouAb44ycof6A&oe=6A8C38CD"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24956151017340259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819417_856249980195730_8212089485719320015_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZznaZf3jdIQ7kNvwHPEi3S&_nc_oc=Adq9Ij2lLUPR7SrXi_IjHotRP_II1HRFli5UV4vu93EFQHXOdzfLonX_1rmOIsHQSOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2lgO2PeAZ63j7yv3eTu-5pkNFhQssE14z07ssokjYjA&oe=6A8C466D"}, "is_concept": false, "is_test": fals
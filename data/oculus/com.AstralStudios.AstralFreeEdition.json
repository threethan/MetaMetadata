Gapb5F&_nc_oc=Adq25uHe26LkK1wXqSTr_y6Ab7buLl09CdsWNuwb_QSxnPbc8p97QEM22gqKYjOJKr8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEudM0W0UJc1yDG1jp0PtkiQtpzEDZ_Uj9T61dpO4UkWA&oe=6A8D9A54"}, {"file_name": "6.png", "id": "1212624124078132", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499305050_1212624127411465_2187386998949480077_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKy-o4_P8FsQ7kNvwGGAekA&_nc_oc=AdorJceDAtePhuRHQDOtP4mjz2B1Cmw3Q1gHyUcZLwlzfdVXZk_W2rYQ9kivaO8sJL8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl4LGs4uivjsQu-lBdR6_qIRdtEmVoqSaIFTeXGw3Wvw&oe=6A8D8185"}, {"file_name": "1.png", "id": "2274685373046435", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819934_2274685376379768_871491951602429837_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkOZ0p_--_wQ7kNvwEgcQhp&_nc_oc=AdqXptbSkAd5nCE2nYxrjAWI3b3kzsl_VB0Ks2bUeRCR0k-CxJjdVDsPiUtxG011BZE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_ClVOXBx5fM-DD252rXKfM6B12HMZUJuIESkxYfrbyA&oe=6A8D73DB"}, {"file_name": "3.png", "id": "1491283985258497", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819407_1491283988591830_4381947709906657620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Msjyvr_HTaoQ7kNvwFSpjrO&_nc_oc=AdowaLg1FrQ7UaNv6JzxofxlTU5sC9wdsAmHNK4TaOCKbL-UfKD3kbnNpfDpagYCGrs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtKrjHYLhYK_DjLVBYN_ZxQGq8KhdGNuNo6Dzwn2c0tg&oe=6A8D7EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-07-30 201235.png", "id": "2220030695156650", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818916_2220030698489983_1415343740704291319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkSZfkogGvYQ7kNvwE0vjBD&_nc_oc=Adr7jGJ_KJ-GvqBSfblUkTj4lXCgEumxooMHsEalZaesz737W6xJgbwBgS72yCg0OsE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE36sRS7IuruAsJv79GmMOFmZLDoYjTb7Qdwo-FhwVemA&oe=6A8D8A4D"}, "display_name": "Astral : VR Edition", "keywords": ["sandbox", "build", "race", "drive"], "long_description": "Astral: VR Edition is a sandbox about exploration and freedom. Its central mechanic is astral projection: leaving your body to explore the world from a new perspective and interact with what\u2019s around you.\n\nThe game includes three ways to play:\n\nSandbox \u2013 Open-world freeplay with money and shops.\n\nFree Build \u2013 Unlimited items and full creative freedom.\n\nDrive \u2013 Focused on vehicles, with cars spawning at the Boot and Rusty Nail shop.\n\nVehicles can be bought with in-game currency or spawned freely in Free Build. Shops exist as part of the pause menu, with more systems to come in future updates.\n\nThree maps are currently available: Islands, Crazy Road, and Flatland.\n\nThis game was created by a single developer named Daniel, with the help of tools like Universal Vehicle Controller by Perfect Games. Astral will keep expanding as I continue to learn and improve. Your support means a lot.", "short_description": "A sandbox about freedom and creativity. Leave your body through astral projection, drive cars, and explore unique maps across different game modes like Sandbox, Free Drive, and Free Build."}]}, "developer_name": "Astral Studios LLC", "developer_privacy_policy_url": "https://sites.google.com/view/astral-studios/more/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Astral Studios LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/astral-studios/games/astral", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
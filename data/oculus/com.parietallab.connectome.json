t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJRRYDN0lG4Q7kNvwGm07km&_nc_oc=AdoAt4OO6_rbnPhp69aWEdUyT1BylptE6iS2Ii2GiBdFYREWAzKeMSNo4ZUx9kSl4QQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbBhxpDo1lIyi-2Jkr6uFIPP88L3WA6PHwRoeY3wOUFQ&oe=69C93734"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WnU637FuCkQ7kNvwHdXo1u&_nc_oc=AdodLqgSg5yciNiHNexIuNgyPBJyft-FEZUPMIYqloeAedSPzbJsR2BlN5clqTbIWuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYafmFAjY94BKqkqglsWfXehIX50O4Ur2LilPpyyob6w&oe=69C91C67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sfbS2p_JFcQ7kNvwG5vjA9&_nc_oc=Adq3lV18KG0naTXC_pyUC2XEluqbIEGy8AeVfl9H5cFveDAPRtmWCkTLqeQmNTV8TwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuN7sKf0PAXvp6ZPdzvgGNcNF6iPLQ5NH7LGZ0cEpGHA&oe=69C92D25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTr8zgj3cqsQ7kNvwEtF72X&_nc_oc=AdoonSRNQljGhPxBgxlHAqN1VYP9inOW25twqJau0trHExdlDGBCpZH-Of9Fg2efyOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLEdopQQXInZkq7I3JfwI6WklsLbyn7zO1I8fM23HHyw&oe=69C921C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em1otQPQj3IQ7kNvwGWoQe1&_nc_oc=AdpZuOifBqeNaA6-bPx4JvgtTDP6un1ovha6jQOVo_YI1sM6wsA1WCCZiH_pLXmIweE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw85GfA08AIwnavsfl_-uPgEeiCjyJOQhpgEl6azsfIXw&oe=69C90CA1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
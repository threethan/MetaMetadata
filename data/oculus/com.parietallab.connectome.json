t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlmFP28tbgAQ7kNvwFv6-NO&_nc_oc=AdojCEk73viEloIrAvbdow3_wPlY8oPJkEPH1wj5wlfF3frZASEHqkxPmfeP_cm9_q4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ptqptCDMyG-n80hlNi7E3rnjX8ZPFGQ_oY-jfCr6h5Q&oe=69F9FEB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab0R_B8kNWIQ7kNvwGE2WgW&_nc_oc=AdoTO6WDVt6xLBEVv4xia_MTE5B_Tb_-U9C-mmm4Y--y3MKFsgwiDVhHWcQyC0gMlS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MjX4V6Va2TmlTWkNylxgFqu9oqV6nCBD07X24TMaVqA&oe=69F9E3E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cTQgkUgdmUQ7kNvwHRqdbn&_nc_oc=AdpdwVg4qHk0rURCNLLkOqhkI94HfvQNMO1YkBLrJe_na5EQDKRdTKmvSJREduXPMzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mtH7LLx4zq7W2n7dyt2_Y3_fzfEgi_uBRTo7s7-4juw&oe=69F9F4A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZnO4rJlNX0Q7kNvwEO1UHo&_nc_oc=AdoIasx0vQYC9h3XSWkrqwBJGMv0E32Mqk_k7xfg1pLDFAmKLIuzLxnHzmmx0aL5jgs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xmrF5-twPrqswaROeftt4Da5u3WVQxeGgYfXxvO7zSg&oe=69F9E944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aElgC-Zf4KYQ7kNvwF33Um9&_nc_oc=AdroOTqRaNgyBlUYT-Q1n9o_QKwBF2MlhRomAMH0aFfB-SXPam-eiPdT3lyQwBROcFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VAJ5SPdy93TPEV2uYS8IwRoWqpKsa9qZx14xUmxA3DQ&oe=69FA0C61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
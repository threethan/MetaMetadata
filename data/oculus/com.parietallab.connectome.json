84268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4gO1A7dZ_YQ7kNvwGUv6bV&_nc_oc=Adrct0s8bRIs4HdNjc_pblgGV21YiDcdM3l62mKek1Z-SsEuE9xaF7xpQHIr2ZRlJ1I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaJObR5nkG13rJJe2f618Q_l_-VyDdQ7IsezcSTFoNAA&oe=6A4E5EB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA9TRof7el4Q7kNvwHOabAP&_nc_oc=Adpi7Q9Q9rRjI6kcp9My1atBc9YSd5Mx8p_S_q9U_HROP4p4EIHidxljGCUjtw7zj2w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7vYjDsJwB74Osi4MPCDlBp6Lpzw_WU0uvF4h3zL3vDg&oe=6A4E43E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAdt3iZWEaEQ7kNvwH2DRaY&_nc_oc=AdpjoyI0M9UK4HPV7A2j_KP0UlCsG3NP7Qf_s7K6xvh7kneG0sGPiU-fmPuvUaG8nfA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz-FCykthfURW08vNdzAxyGM-RU2qwoqbmdVNIPAcBxg&oe=6A4E54A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1BsCK33FoAQ7kNvwEFZJdx&_nc_oc=AdpJKGNnNUyhrMOVJntySUeEHkyXulF0SZ7_ugmPD44RPFFXrf-p_LqE6ccn4uQDoyA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSRcC8EKntGYgqviCXMGdh9efYU2wOoD7wY4B3BhDj4g&oe=6A4E4944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Oyt-EPZ-JUQ7kNvwHhnsi1&_nc_oc=AdpyK253ushuiKCR_zxNh9JvcV2Vm7HgYFwGsP83vU-V9Oc0jO5HxeH3_IXNPNreCSI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBThyJ7mIlvbPfd_idgJyYjCufxTqY0apvwGNWaE8-cZQ&oe=6A4E6C61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
84268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Tx0-zvYu2UQ7kNvwG-_OBX&_nc_oc=AdovZT7o-17-m3iRoIzN9uL7jvlhz-4Jm27PXTE3DfUDnCg2z6aTmYVK2cV8mIPoLH8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCf6n-ol1Wk446seKfn5-cMoACKPWHALxgg68J3u5uvYg&oe=6A5B8DB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=268SBlaMBbMQ7kNvwFZ_4UN&_nc_oc=Ado8usiGiSg2k4MYrLVA48m1WJeZfc-sEE0s8QMPzd3n1A6AkH9KUuf96ZOHOSHTKzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAANabUaFw1xmguF70JfCZBfZRrL3z3cFIJ_I8EwsTdVw&oe=6A5B72E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfeyCyiaS_UQ7kNvwGuxZ6R&_nc_oc=AdrMMOXE7EsIfzI63fVpn7EFt4jdjcqHch6PyxHViB6AJnK_HA62geoFmXyNtDdtnvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz2DjYko7iZwhiEzVsC2QrK4C21N9KTLcHjSWIjtgOTQ&oe=6A5B83A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgOSiwQah_oQ7kNvwF1nbB3&_nc_oc=AdrJbAKWy_lxgJMBeMLG_FKmleFTl_rHNlSEH6Xvx1VTB1Wx6aJMYA0MbcPDHRMIcmU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPrc8PQ3niw0irsidHSbaVCl4OfGM_BVkUh2rrafuRFQ&oe=6A5B7844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBqTdOb7ZYIQ7kNvwFcavcn&_nc_oc=Adrelg74rvicZRFl5DtY5xy1mCMXG_ZU549IsHYD6dA_A9uELC3dvC_wiuNUNHZsFBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOalt18uUn5v0IC0AG9GrUqJleF5LlKXhHrr5CUlccHQ&oe=6A5B6321"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
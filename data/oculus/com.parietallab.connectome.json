84268", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGMenWIywnYQ7kNvwFn5wY9&_nc_oc=AdruF1e88WN5W3gVbpdwPSuXxWl36YrbUp3kS5TitAgxzFmkzNDFPHAwGl8pzTO2xq8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3uyP9GaLz6ztWVdplzsbUfTPD2M89nM5sogLrCFcscQ&oe=6A9751B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcogJNzggZEQ7kNvwEwglOs&_nc_oc=AdrTjR6EGZFh5JNcAewGN9BDBR29BGEbp4KTZ8j3up7bi1DTF--OHW0V-vi9_vnO3yc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaL2RkLOSHYDuSqJutHbutG9o_XbrSswEVLN17yeAs2g&oe=6A9736E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y9RG2elGgUQ7kNvwGXcSyq&_nc_oc=Ado1zpEe9KYDCmxSD9ZSp4Ajt-ez1N7LgNlgiNpzelaHV6CvotpegtXvDIqRP5ZqfNo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1cPV4wpuN1nGHgkQ9Dqf5b6Rde23LYpLBl3CW4yqxvg&oe=6A9747A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m3_WpxlFvUQ7kNvwFAL9Lx&_nc_oc=AdpJ1rqngXUQQPPKrc9P_ZFElZwUFgio_2uAdRhMmtHMgxoeGTcreThTt1RITxok3ic&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBJIMFHkGDn5LzFoXBmUxcevpFDP_-f_IdHwWrou9RhA&oe=6A973C44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSQM-XRZF_0Q7kNvwGaWjzz&_nc_oc=AdopVB2lOoWiPYDK2eszXc9l9gaCadeAZg_O8C04Dg-o8a0MX54VDjCCwVRE_5mr-E8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpp2mhzpwaG30stNifvozm6G-2tWCWF9Sqx127B4CLVA&oe=6A972721"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
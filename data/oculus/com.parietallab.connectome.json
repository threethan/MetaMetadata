t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g29dwxQeWbgQ7kNvwFp3Q0R&_nc_oc=Adq1TyF4zfKcNxu7femWBUmFL5LsnmZdTqdfdOFPmt5VWZhEM8lS_wIM9fhiylKTTV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kKj8s_dNF6t4icbpBzOA7GcC1d-Grw_G25_vqQ7w8wA&oe=69EE2134"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWDizf8lAwgQ7kNvwHndnTd&_nc_oc=Adpkktzr0pD-zQzucxt3z-4M8eK9BZtVIuZvZHKa9OBg4ftDCs048hx_SShnTmXcKJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MXVPwqVhDWJF1Pco5yBZav4R3vaVoe2609hhmQInduQ&oe=69EE0667"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uvH5DTVVpgQ7kNvwFkiqqm&_nc_oc=AdquaF0mauOAGKuVF_lJJoXZEtL0ox0kJF5TwiXmAUH2riZt7rA-eoUFP7IVYYUcAcE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bEpvJd_bR2lriBKcKbZbvO626dUXv4fLEwxXz3ZHzSg&oe=69EE1725"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtL7jZKRD5AQ7kNvwFDAOzQ&_nc_oc=AdoUJ9C6uOoPc-z92YuqmW40O19jcQqV86EsNK2gGOE5ham1PmY5UDmvLqF1yimS6Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3otRBM4N99Zfk6CcESyAkYAjohD_1fh8RYeXCfgIL9Qw&oe=69EE0BC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFzluLqdBAMQ7kNvwGzTr60&_nc_oc=Adp1-jH1kfjqJsDHzzrpR2XVX-cBKUG4-SEHL9rqjd_wxq1c_n6Goa0UjBurAAbcmsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EphaOJbfXdNagKNkLx60TUvgI2pJDcFvuBBPgARIqJg&oe=69EDF6A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
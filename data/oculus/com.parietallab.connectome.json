84268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtnhcSu_UAsQ7kNvwEV7AsV&_nc_oc=AdqPGKiNszaGpoF7jzHxqPpcGA3uxidmiK8jL-HDY5eIODBGR5f4Efl5RnnlP2rXyEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XJLZZeTzxSI2C2HTQHNHY4tABXuXXH4VP6Z08wVutdQ&oe=6A355234"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8g1clG_9gM8Q7kNvwFOWZIA&_nc_oc=AdoDNHU7icsdqqPyN_fOmOis5JU-JNDRFRQLm_oYU-bDZCxAjyHV9Cq1CaEina40N5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X8x4MlJoEFWtfj5darOgYcN8W7h2qAia6PG5s1Gw5tw&oe=6A356FA7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFpurUO-nhcQ7kNvwFZckY9&_nc_oc=AdrN1kmgtkveiNAlJ7YL1mCnc3qVY9ERHclnR_RPCoFTipACq1cV3OzjHAkpKqAn2t0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sQiTUO0R3j1Hq0cmZAn1Tjzbhd1Uv18ASJlpsy0NasA&oe=6A354825"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=544yE0Mey_0Q7kNvwHa_4zY&_nc_oc=Ado2TOvmdwFBbed6qKDB8AFxlvpztGfBec5Tw3vHgOO_uje2oZrxbmc-U5l5L6CPjoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Az7AGiZeyOVbGiz4Mw-X1-ZTBKtbsxUuUMopH8VF4QA&oe=6A357504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQfzAmtp3xAQ7kNvwHt8-BM&_nc_oc=AdrguIG9hWs48gy11n3Mmkss5jyjTUuO8X3jpKYbVMhSqY4atdBVnOWOyVNI8mOVQv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FjcsR75BnEOVgnKFrC9tm39Qt3dLV97jwd8FAgN4bEQ&oe=6A355FE1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
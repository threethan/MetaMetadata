84268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SpgoIUqlwYQ7kNvwFMitNY&_nc_oc=Adqg_0WesyvyWKdnREl2pfFuxmLXHAcloO1Au5d6MPecuqKYueLDV6MLToNLG-0ls08&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7pXhuGjSGvfRchK_olgliGoafA2WsiTjh5WDhYRExyA&oe=6A901174"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1NivCsXQeUQ7kNvwFO9c1-&_nc_oc=Ado8cycfSAldJZIIchOPztx7HFPMhxvTrvejeQ9BtuZa1lMzZbVaZmZEqAUK3DzCdRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrMCzRs1qbC0MIRwpP1Q22wyp3zrHhavep5brrnlyE0g&oe=6A902EE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxlsIrCl0g8Q7kNvwGYoVhv&_nc_oc=Adq3sDoKIHjIBSyVS_WJpKrhFeakuUBjcIXUgr3xyvcDj995zZT9sfNnd2jE6fo4dBY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgVFnl4KLQr-cnZSij0amjx0LhT2PzmOe2BFhNFs9GBg&oe=6A903FA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PICqj8JZysAQ7kNvwFRMSKN&_nc_oc=AdqviRQ73vVMUvf6vtwq4WDNl-ciCNae7mrDgN55AxJJzd3YO9qJfWJsCz2bPa9ksGs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm5WCNq-qlKn8sOi3JNyc6pk7rUV45bH6x7LDeq2RZkQ&oe=6A903444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQFGK8j_qfQQ7kNvwFlYp-C&_nc_oc=AdpAoUF3VCK1I0nZwAteqFgq0onzfjArk06IL-d0HqaZ83svG0affStIWRpen-vaQBk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE29JuV9eS2If4tJuYEkIKVzB_qemYLcIf31SZZ4XBfLw&oe=6A901F21"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33288133284165472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622214_891730399976926_2927939352608887063_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcqHvAp9xW0Q7kNvwHA54VG&_nc_oc=AdrD59PU5R48BG7tbhrNoYzoDa-kAnznHR4lDxXHGR_6KDAEgcSnrDuIZfXRn4TZvFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL5lGSMCkriU786jW6zBLUnCdOHMRPqE79TmRO5zteGA&oe=6A9014DE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CONNECTOME", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1748367660, "lastRevision": {"nodes": [{"id": "25707920678853475", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25707920632186813", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "934148758813776"}, "iarc_email": n
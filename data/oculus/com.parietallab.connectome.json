84268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHZH5HrazbsQ7kNvwHCLAS8&_nc_oc=Adpuix_PZdixn9E0853JdT9ugZxUCvXx9aPJdI0zcL0yr8b0IuDpnRRTj5dyTqepyt0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOfYHJNP8iaUuyY1677VXsuO9XI4mCWvY81K2pFCVaZw&oe=6AE89E34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5F7tPkJQS8Q7kNvwHTg8ld&_nc_oc=AdpezaTfHuVbpXsQE05P0CJp5mPGE-4_7LT75E4oe_tJRYypYz23DYpPTBuvgVLin94&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy5b6JwF8k9tZisLCEhSfTWOZr75L-b6pjSK-N8-TFgg&oe=6AE8BBA7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69qvJ1htJMwQ7kNvwGeSk60&_nc_oc=Adoog1TgGYrTJs4IAdBSoKkC0NdgEcgyiO58OPIG_6QubpzEOLtN_74ROPNRMgRLbow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTI6WH21Zc9ZucwrFiqoIRPi2uqKmgDsVXEBXv_vVwrA&oe=6AE89425"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlFeQrVrLyAQ7kNvwHx4yQ8&_nc_oc=Adrmxana9l5rRQMSLxZhqEVlJu5ZAW2bUCP2Kl7WKYkrajoAa0CQfK_PzNGRyvS9tEE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO8yScmwqZKCXQ6_H4m5EOUSjMTeORsoTs4jR3fx3_0A&oe=6AE8C104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ6wXMCC10UQ7kNvwEXpSN_&_nc_oc=Adoi3nMy5qZVTt350k0Q9VduUuVc2eMLsEmTIEmWGBwPGkPjWe-YnehVVH5J5mRhzKM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJy7irjyB5RH-iQI2AJEQRiQ6f1R9XdmoVgSZUpbtZJA&oe=6AE8ABE1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
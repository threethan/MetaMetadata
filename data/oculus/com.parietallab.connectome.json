84268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3F3-L3fGU8Q7kNvwG8RDKV&_nc_oc=Adq7d4KyI-4mW6yeUQboL6YuyWVjAKVl3MPalFtDmF3QK5PeV0uew8WI2xz2Al-xeFY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aoysHlv4QM41J7kPGryk3lVmAlbeuZ462g9kUcXLBEA&oe=6A26D1B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUtT3cGllFMQ7kNvwFclS7B&_nc_oc=Adqwsx4dygehY5ESehI1Q1g1cigVv36FpKYkeHPIJ-JJfk0i5FYXH1LJrK7qTtqLKp4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GD6ZkNEN28-OC8l4FglXOEWO-lCrGQy18iZxwrQTVjg&oe=6A26EF27"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7W4HvSx43MQ7kNvwG1HdPz&_nc_oc=AdpWCwTBvH51Alfzh4Qv8iqSR0VRkxTUGJIElvt3T9tMO3EsTbEJ4Lucc9bJCqmsOpc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vOz7wh5A7rcfxi6DMCGYzThrtPKPXN0gyHyNeMk2hqA&oe=6A26C7A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvXtgUhx_DoQ7kNvwH1a1qk&_nc_oc=Adp39i0PDzCZHs-liOuh9QtDL6OOpe0bdMimOmYgqb3vMF8L_X3MLEx1PmY6O6S2wg4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K1fPkuc3A5NYHPGAGeY3Vfd50q24YH17HI44Xsmul3Q&oe=6A26BC44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RrnPjZcxqMQ7kNvwFqFnOz&_nc_oc=AdpF9-Brgi-vz3ecvWOu5ugnvCCUsNMlV5Z67wIlP0ydaOvrRowijfjBhb8H7pRw5Vc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GeHmLPHfmPJuk4a8joB-y8T5bVjfyGHN_pl7txYKz3A&oe=6A26DF61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
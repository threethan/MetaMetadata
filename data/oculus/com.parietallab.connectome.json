t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeiG0EAU3IwQ7kNvwGaPQ-0&_nc_oc=AdrJGAsZ1kZKzrDVbJdg2oPNKRBE8bEaBcvtZk_ieBnBYb507XeQS8XZ3gz3u4O07pQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G5fDonnOhplwW-GxQvlem8SzN0gNcwWrhBnCCvXFdPQ&oe=69E4E6B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NKhAjWJwroQ7kNvwFxptBq&_nc_oc=Adq2Q4-mv6qYp6FNUvhdFA_-nhyPXY7-sSAdHJ3CgFBi93AOBtRkxudazC_PS7h688M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fxGVbyxldFaXt13YotahyxaNBSLyLOdhDzmhuIhjYvg&oe=69E4CBE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j99ldCkPJLwQ7kNvwER-Din&_nc_oc=AdqwUeJ42oR4pVJlqHHDOl1CO4DhmWkLN8258auRY5u5vpM_oixASDk3EeZB4i_rxuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24Det5zRN-YNLkDfHRUAdh08Txa_3v6KPW0x-4eoc7-g&oe=69E4DCA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chmqd_hji5sQ7kNvwE25aaD&_nc_oc=AdqvSw3IwJH4LIk_ZLsObS6faDX8rKO9d4JH61RM_X865DrnSUDxeK42nHPCobQXBbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07onVDTtUxYw8BER9kQ5rbqrAqdbOsdRr1DXMWYAYd4Q&oe=69E4D144"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3VcoohP4iQQ7kNvwHZ_7kP&_nc_oc=AdqL-Z25Gf4VP-Z0quWlBg2Xugl4Gn_ZP01IHn_QTJL2yP4p4-bFF09BKSQMff_h7nQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YyVhXrrMlzoSr9AVu5B4-x80g_BKnT6RL0CowVTgoVQ&oe=69E4BC21"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
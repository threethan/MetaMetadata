=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxU69NkczqQZ1ZYE5jZDhm7QDNctfI4BqQvThaq0zyTAA&oe=69AADA49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-CoverImage.png", "id": "1865478304189674", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035314_1865478310856340_412617430543564406_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krTt-V0VfUcQ7kNvwEEp98K&_nc_oc=AdnRZFdt14-QiuyYDu1W0Fq1kVb_DKjnEZevAKlGAmA9c-2Vg-mX5j-eaf1XmRQXrFM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFuVsKisXAEiBps-qG8Woe5WuTe075-32640Qi-WLadg&oe=69AAD5B5"}, "display_name": "Connectome", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **Connectome**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\u201cConnect the dots\u201d to create objects\u2026\n\n{459548087014195}\n\n\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026\n\n{1561193251252347}\n\nGet lost in a place of wonder and scale only possible in VR\u2026\n\n{2611663082362016}\n\n**Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in Connectome, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.parietallab.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": 
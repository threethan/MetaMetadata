84268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3F3-L3fGU8Q7kNvwEvQcX4&_nc_oc=Ado-BNgF8V1jakxBU_Or48_MagoVE96fP-WGfUr1bCrfMmTQUBfjTc6zee7KMsMY830&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QOMK3OpEHfojcRNAIMhISz_60h9UhdKylL3bRWQjB1g&oe=6A242EB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUtT3cGllFMQ7kNvwHYiMb_&_nc_oc=AdplA4MP17vjTwAXcqWrgBhSipJ_3YHLt8VzMJdZ9s2zKJx3zpiIMgTHceQUS88bL84&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yeYyti3-nyMGvNRaV0GrumV7pb1w5HWlJjqY3YxafCQ&oe=6A2413E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOFK-UtjlRkQ7kNvwFa6BdG&_nc_oc=AdpQ9LyOJC3yMXWEipgNpzr04Y-6TTsKgXptkfOAoEGWJiRZMh5gN-PNK-DXCRM2ti0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99AQIv8Y_RrJi6PPx_tBL3rTEN5-Hm7I_CDh9O3inpDg&oe=6A2424A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqpY_V-qSfgQ7kNvwE9AlC8&_nc_oc=AdoPHXfIwsP4fdZXi6l0JRBHm2lOMMJKFhcNvkhk1BTBzVMj3w8x7s1d3v9xI3YTGCQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XReV-HLJatvz3D9gdsqYT-lAYNaTohgpn-IgDZKVklw&oe=6A241944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASc_7m3uDF0Q7kNvwE3ZKU7&_nc_oc=AdpiQhLWA6Kla7MtBz-Wdot1_mWmjwOFDTMCVf0QVypESIqgpd1O8lv74qdPK-6mRIQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZYP9i-gyjR_ljlmx6LbRwncavkj-5LWLX1bMXk96KjA&oe=6A243C61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
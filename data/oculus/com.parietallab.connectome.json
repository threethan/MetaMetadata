_ohc=pxC3XoDXnvoQ7kNvwEXunwF&_nc_oc=AdmLK2Y-EgkpiVhm0WGSMH63CsyEU9M9qb8fFaWvQSNa9C3aTbVhp6_3OtHVBcH1z6o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzdOWJ6RPKLoFp-YheeFXO13pS3Yl1RHNr04rE2B5Hag&oe=69BD59B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCYdBhR8kwYQ7kNvwHWo3Xj&_nc_oc=Adm1qA71b8FcgBORDkQz0xUEgiHDtRpfIW1hEZWQePXgk6sMnrvkABTl1-P3V4scM80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfweoO4hIVlMCVWbkBf3-1a0yO5Os0Y8Sy3YcRiUkQBv3A&oe=69BD3EE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFINm2hzKxoQ7kNvwHF1sPN&_nc_oc=AdnZRBclBwlEOJEdm4OsdkBj0QdoWjijlGLp8zFjbDMRRj5xQS1XIwi9TnTQR1_J_Gk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQVhVo07hFIIXzpf49YD_tufQb8YR_tc7TLP1VVu5mLA&oe=69BD4FA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqQjhLeYaDIQ7kNvwGaLZv-&_nc_oc=AdmydLHvehFl-CBkPi3tgAWTOWWL5bLpge8PH_jnxv-ZNxldpk9V8xD6O1eHZQO4bNI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZ3PIEFjZXMcr4sXGqkYCkU6TNH4_QARJ9yvEpqJaFug&oe=69BD4444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-chnC_k6JYQ7kNvwEm7500&_nc_oc=AdlMgf-ZL1vYKjYqIrtvIeH4oG28sfxbe9MCI7QwoAPobUCGW1dyEjN01ypGSCBcETk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyeo-A9pMdC8eiMEEjuxnD6MGAnlPMNF5vvS72la5-9pA&oe=69BD2F21"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectome
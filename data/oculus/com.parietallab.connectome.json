84268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z-KptjIIt0Q7kNvwEGV7pv&_nc_oc=AdoHFXdYPYBY0aSiKfV2BD_2sTjuplpv2LeXDGolGkbxUCO9dcMY5JhvI5mUwAq0ggg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9KwmTFD_G9T34QIU8WeOyEks_4-g4Xuh-2N_ZN1N_Mg&oe=6AD38634"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN4fXLNErAIQ7kNvwFus9T2&_nc_oc=Adp-kHALUY_36w7wH0ze5nUFANpd-UbKKM82EQYFzWq6T-Sfc4d6765vZbiCluO6NkU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNshwXqirCzbs-VexRGIN8oKjzFlgOAYRdNlm8VovQHOA&oe=6AD3A3A7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr8ue_hUfFgQ7kNvwFE9aTm&_nc_oc=Adoa_x5edCjEJhb77rMda1WcBegUpshisBA3uc18cYHdsT_ZH_kbvUSRsor237V6OSo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpEkBb0ZGb9WhY3G3nFwrY4VvFHFdZHnzP3y5Goz4bcg&oe=6AD3B465"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFLpUyY4Uz4Q7kNvwHNrDws&_nc_oc=Adq3hB0DQUk5RED3D5CE27fe0HBBx83aSCMpotHcM7l3BQG-D_yHsa3dppiqsOsUjmg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2WJV8h4KmfaNZbtqKapE_2hpm1m4PEeGdJzX0iiUrcA&oe=6AD3A904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94fzAbU3Na4Q7kNvwF8U6xg&_nc_oc=Adqwa2V_rnsG-9XEi4y67EGPpNMDzmvblZ_prcQ8Gl2lmwes-H4t34d47_3VFZWVnns&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYDYNa7Ly65V7QRpYOQWTFZOYn9BpwYJ2FWdSTKN38Pg&oe=6AD393E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
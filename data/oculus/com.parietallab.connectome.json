84268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZJm3k3QQwoQ7kNvwFk8vZB&_nc_oc=AdoBK5EvcGSkcSoO4F1Mk_9QhHp1PuwEL9ECHCDZ41MJ1OeRa46-gcPFaYb_R0TnjhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMdfRdPaGDeniAwJgIVyqwB9FvrRMGTJrxGtwhY0isQA&oe=6A64C834"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2TKQ6Jcjt4Q7kNvwE0bq93&_nc_oc=Adqu2XdSjOGRjlyRL8lD9_BNbkrFV7ehRWmt-euCs7AuxkaaYqjLa97b5YUEM91WL1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWQLG-ILk_kk6XXpnA4Bs403QT4xDv_L2Kf60gQRo4KQ&oe=6A64AD67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_4Xriyuh_4Q7kNvwGXMuU4&_nc_oc=AdpmENP626LivtCa6dH4kt8C_53HQx_qxaUJoVNswamxVzLBHuGtKBEpGddyYmm4Mdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2s5Qn6CdecnmxP-BrRJL14g0w3aBkEBN2-sWPC10oSA&oe=6A64BE25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wl8c-b8WXVsQ7kNvwEtR6p8&_nc_oc=Adqa1stBVirLPcKpYMhS40iItXCfchvDEy8KITnpMfZqanER0svTiOQYAqQFfG5lSOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQyYczo16H9Qfd2T_2NLfV0NbQqKA9YxHMaQkyBwynYw&oe=6A64B2C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ry5i9dX5e8Q7kNvwEQRVlL&_nc_oc=AdpyWYqhEZnQ1pOU-p36LVGlV_tyxZHqmp89_wFKTHpOjzHbe0Px9pmFCXpgyRStjz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxiPwd_QD5mMP-D2INJrjPd3US4le7QR6yzDaLMO5fWg&oe=6A649DA1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
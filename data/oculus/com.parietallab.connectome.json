84268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmfoGHZwdhYQ7kNvwGaPKkb&_nc_oc=AdpVog83xMWQT0uXzwYtXIj0vo1W54PHVjm1ZjpFOV5x3coT4ccyGSR8lolUbR04XSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SV_zopuRvY_1igC0ds0cbT3F3D20v1m8ycz35SoYyuw&oe=6A2974B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX8RdJxDtbEQ7kNvwG7BCR3&_nc_oc=AdpHgFslgYOBynZ-iSsiIOIuJ1Vw1jUYNlwxaw3OtJ6hxuTnspyDb6ckTIfQXpAn53E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95Kaq90lQr6T58Ij4yLjaWTR_HghgkmTqo7RtfYmDE_A&oe=6A2959E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7W4HvSx43MQ7kNvwHZjU6S&_nc_oc=AdrxDH5RxHwmlRSchytZXZG7IQxVHmT6deVqT2XidnnuG9B0xK-9lQH5Rv-KIXBy_vM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_exE6Rq0BlBYtojdnEImk8C3MerI5nK8pifVmVSmruyw&oe=6A296AA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9uWdUhqBscQ7kNvwGrNnY3&_nc_oc=AdoyUptwXUgYssxh6bbrgILkVa-PZAhXXw18F0eQ80gH34kVLwv1DR2jSdFaldJLaSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HnWbJn2XIYf58WY6sLQSxLMMrDgCcsDcynXcwY9cKIA&oe=6A295F44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJVRy-mAQY8Q7kNvwHqjCt0&_nc_oc=AdpNzdx9PPUJzvee71sys650WRkVrVlIDYqCQ98-yKS3RjeOCkZazv_bLpQTPXU6Vi8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MXmAK-ZJN1u29uCtzwKJzJ7FdJOjjM7GxwZWUvcpcpA&oe=6A298261"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
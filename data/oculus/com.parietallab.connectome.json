6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwppkhuXPAZqEAmgOVWNcE2Xg864GWefo9zovuu-XjSMA&oe=69BEA0C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-CoverImage.png", "id": "1865478304189674", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035314_1865478310856340_412617430543564406_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC_MAqp5XaEQ7kNvwFQgh0t&_nc_oc=AdlQCtpFxRdhWtPwBliO5cq22B5_JOpkHYy4En7jjEGlmRwOvGuLbWFVcdiykBEDs0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLnibCU_LMxUbsEMPdpHhBrzpnuGNzIyFjjzfs4iA_ew&oe=69BE9C35"}, "display_name": "Connectome", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **Connectome**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\u201cConnect the dots\u201d to create objects\u2026\n\n{459548087014195}\n\n\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026\n\n{1561193251252347}\n\nGet lost in a place of wonder and scale only possible in VR\u2026\n\n{2611663082362016}\n\n**Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in Connectome, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.parietallab.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "
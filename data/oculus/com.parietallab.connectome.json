t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g29dwxQeWbgQ7kNvwEcZ5CA&_nc_oc=Adopud9t5U8NVgVJoOHVaJBAFvGnXanifMnTq112PvDdqkWMZykITD9galbqaDXtTWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TxTFWLN6_zXkGRljFAIOUeJkSeHtyV-NQmnZ1bB4RMA&oe=69ECCFB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWDizf8lAwgQ7kNvwH2sofV&_nc_oc=Adq0FgY3uoaopq-ayQIZkG2R0_fSGL3V8XcqorlwT4x4Y1rwYkoXwjeRy4NC5wLwd3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K_w0Nt-fLaGYxViC7kuq_WLZ4mWsbbouW783i0G5Hcg&oe=69ECB4E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uvH5DTVVpgQ7kNvwFwpPoV&_nc_oc=AdrOTWtHChs6hwdZjkJbglzibJxfN97DqGTkq0YvRY8oevLdVwPsH8w9f1bvm8-CpAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SkKR7mQcZv7kYj3VPNEK7dFtRmW00vTF2pNvrnpTtoA&oe=69ECC5A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZW19PLnuSSIQ7kNvwEryfec&_nc_oc=AdqDr-C0jT_0ICl_lVLtJOE_GyfWSbvKmC-1X9nVgIl0AoD3BVjPaG2uSLUb7nJgrSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QtqqokzoWhR2S4x4ZTSyyRZangFLnpfS5A77aa9WvSg&oe=69ECBA44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfFEQy2UucEQ7kNvwEIpQCN&_nc_oc=AdrCVM0MsSL0F3UbLTqylZ8ZqTIbLomwMoLlNU-XHakuTP_DOT9z5qFF1J_7trEC2dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IGrZa5zuI-vXkw2tqQtzKFbT8FWpqRiPUwbea3qzPaw&oe=69ECA521"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
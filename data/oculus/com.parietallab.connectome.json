84268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYRT5kE8sIwQ7kNvwEZRz3M&_nc_oc=AdqpBFw7JLTcTdNG3_a-flQnN-v3fQVlAM8NBUblXiuOm5ij3Pzd4p7osAtIrMR_2rE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnspArgzNbJAVG9nIfCv1v1JETZaMBtOsleVvMtuag6g&oe=6A788EB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avZrKVMSlFsQ7kNvwEQkE9G&_nc_oc=AdqRxbqkHCganxNNQf9Cb3pWXdklCF5oFSIkKqktfu10AKgqE-U594vJxFSH68K_OlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6OhUetj9CWlDwnihqoEIPGcOPqmeEXJifH3DWjtXJnQ&oe=6A7873E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxJXWZB6LLAQ7kNvwGl8KXs&_nc_oc=AdrIBEbgkbk7KnRKoPcgQnXFwEf77w0uGigExwO1InqqIti-EKLokfe13t4QzuKz0NQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkyLhO0bv6cYzo19sSCbAR9f3l_T0CYY2JfNA3bB8GZQ&oe=6A7884A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SylG6S841y8Q7kNvwFdBjyv&_nc_oc=Ado_Qdvvd25boJ7qBOaJjWp3fJvbaCtEnKlKYFDfDewRDmKnHvBzEMxBjrmKFStT-Q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn3zY-w6bYwGpQuobu21YK5W740M0AN4LZXAXo0xZY1w&oe=6A787944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHH73vurDn4Q7kNvwFGTMsV&_nc_oc=Adr4j7wUDfwbYybqXhdPmMWVBWWfeD2mTQ7quE6mUIme_ZR7wuc66hLPiogNWRVs3qQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFGoRJN1wPZcKWZbJwJoC5ectqiHRqpHvrJdmz4Vtc0A&oe=6A789C61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
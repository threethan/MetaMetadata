84268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waG5FwezIGAQ7kNvwEDZKUu&_nc_oc=Ado4MqhnKTGjc06bEz5wGKfx3-zXiVu3i3fl6Wn6npLPQOyOVvDFffkKgieXa9Hqa78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D6-3XZANjRugAzua10ZK6z497pvQbTIN7f10d0uJ3Yg&oe=6A3E8CB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcPhzPeM9NkQ7kNvwEzfnR3&_nc_oc=AdrNqYe0MjYs-u59xC0B3kKzruQzFhqixygyUQj6r4FM9pb_obda2uWLus_FPVuiHSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QW9fUMtlvRj9ZxzjDzr_mEifHsKna1Cvf6xOxfsVo-Q&oe=6A3EAA27"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0SzbqGF8uwQ7kNvwGIbt6d&_nc_oc=AdrxJxuLpAMjI2wDdcUuIOTtla4Nds5Qqu3Y_fHWlxtRv4UPmB-iuHRNsre1RbH2kzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IQY1uujYpfdnKhyuHsDUT3wQRDfVYD7V8396zOzegxQ&oe=6A3E82A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNBJLHwmqtYQ7kNvwHhMMKR&_nc_oc=Adp43UGDRiAal6kGBSiuqTN4459f6x08x7uXP0lGklIjv0Zbojl2ke5zrFQ9ankvChA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IH7gggHSqzuEvpRmeXxxKsKbnUEeoXPPI2pEffBsfkw&oe=6A3EAF84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRL4fYqPnG8Q7kNvwEsUh_C&_nc_oc=AdpW3Mx_Mq3c7ODX_ZOpIoRLW8H1l-nopR0cyXlasvOmh0XmnqQwu3PaqEH_zbyw07I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87wt0HsCI4IUgBG-XRdU-mj0DF30nn9jpuftl7iUCccg&oe=6A3E9A61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
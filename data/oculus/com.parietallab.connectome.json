uvEwj3pCbv7s52boBvV6bgKVhrXnQe8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvqgcluSGEpzHmpxqyvd6KJgZiP1D4tC58J6_BJhgej8Q&oe=69A59EB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8fhhemP1S4Q7kNvwHZNJUP&_nc_oc=Adkka1IyScn2g3rQR9uvRzlO8zqPIFLej0GGWEj4IH7m97-MnKhrtwvIp-hWvXuUhmQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsppleScLPP1xw4F7vKze6fYpjDunnC5zVC54m54ezgzQ&oe=69A583E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXDFoe8pFtgQ7kNvwEIGyOf&_nc_oc=AdmrIENu4iK1Cxj04WQf2M81LQeeiBoGuYJd3JuEkjr8ACdAgHBOajYvAyclSkBnsm8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvpSVAPCRYfu4VJX9sPq4uCRSQ4Ik9MyzkFNlbpffcc9w&oe=69A594A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV76l-_fqDMQ7kNvwEOD5-w&_nc_oc=AdkQqVpvEfLDzFeVHOvoFXiqXSZrzg1T6lxfHvIjxkX9f4OzUmryaE0PsrtkVexRlT4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvyziX1k6PjnjI-e3i3NHJIV3YKYCqAvIoHhuEgdx5jEg&oe=69A58944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUx48xaDq5kQ7kNvwEKv49Y&_nc_oc=AdmJtDjwRMil6koJ1qWSSUYtbJWOgNvqutxVtOVTMatLNp6xb7fc1aJUh9jSzgo-X88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvg6np-2FS4fc3oD2zprwe9nMvNEr1eyC-baPh3UWiwJQ&oe=69A57421"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
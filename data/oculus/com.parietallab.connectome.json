t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LVhIvyCit8Q7kNvwFqz15j&_nc_oc=Adoc2WQ0bXAm6eQlCpSnIxoFWKV9JRxSSJyDLPN64UvAUTCBYlOa5pqKu3IFr51-Nv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysVQETKsxBZkyimZkE51L9lUA79Q13oqSjNon7aT_bJw&oe=69CFCEB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkhyXnxCrIYQ7kNvwHt6miF&_nc_oc=Adoy8x5uhZHyXoRVlf2qimYkUn-pxeBm7ilW-2-LZYHjzEElr8DuKkjvoDvSCOgMzY4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFYK1m3LBQVJxWqLhIZi1eNI0agUGT6w5gFDt18KZrpQ&oe=69CFB3E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws3CAI_wOSMQ7kNvwF6qASp&_nc_oc=AdoVPxDHgkNyLv3T1T8V_K-HVeRZkJdrpZz_85iFwS23ktz_8FUvnuDta9sQ48saJTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwewPzeOgJfNdDmJvFWxKqgFFyl6LOTL8es60evEUbg2Q&oe=69CFC4A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FExYBeFEUI0Q7kNvwFrhA4O&_nc_oc=Adp57vq4Wa96c751siqFdcVNj3r7qC59egyacb2fhml2iAkHxsm_4lFuDrNeKvnhQak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPExQKxbUvoftzUU8pPFn5VWIlqacNf5x0G_kBX9ChNg&oe=69CFB944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYEqH7d3dsEQ7kNvwF1yR5h&_nc_oc=Adp5awtU8EhH0rsl-xma4k7ihtzS_ldYuGdaEqQJbqsfz1mYXBpMPWFVxlmT0bv7htQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2WUPSgW7uZaPoQELNUBGYY9zSTcfhimAjgImWFbxPPA&oe=69CFA421"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
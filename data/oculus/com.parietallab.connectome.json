d-TwoCGrhWVEElXYnh87TgJkFaP0dSs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftO7Dlx_aldV2kL4gysO0IB7DQ6wRKfi_GImhtAYtiGYA&oe=699F0734"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMBa1SAD0PMQ7kNvwEP2zbw&_nc_oc=Adk4A3CHBsUl3Q7_g2FaqKDVVNBxf9sXVt0W030NLfE58HR8S9AFW2tqpJ5y2XOAj3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsFX1cuVeFH7hbrd7LfB9ho8cdjK5BT_VPFrqS3QnhJqw&oe=699EEC67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3fsagumOp8Q7kNvwGavzR9&_nc_oc=AdnDAG7_h-cxU6WZfWwWcPdH0H8f-TQqTtiZ2FULYSMA-4MXz_5Xj2AwThVg5wF2ZLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuHi_oTgLr4K1Uu6Q_lwMyesiR9mTsCkSQDBSliysEBdw&oe=699EFD25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1fQDc2MdScQ7kNvwE0Icmt&_nc_oc=Adlb9l64NbSXRZKd0qZLr9JqcUeGJFAqPgcpA6pS_psm9b_RXTJwkOzAFb0fUpm2AqA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvWSQ3McikUKIbnWJeEkTlgUQQ80wy-rdkZftvfksrTXg&oe=699EF1C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaxKkHF9F4gQ7kNvwGed4Vq&_nc_oc=AdlUm6hAyfg_l29zzrxEjIhVqLhD4yYYF77tfPpxk6REGp8z8cHRI4NPkeLKp8r2DdU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvS4kXSW9lRI0jFKxBWUSzM-Z3NBP6T25eae0D3Eotwhw&oe=699EDCA1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
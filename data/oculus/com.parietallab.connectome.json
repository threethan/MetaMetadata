t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ngw6sFS5AcQ7kNvwFIj6Ax&_nc_oc=AdojtheBH_lO3oid9lTK2Mdj1jcQvcDwjQPUGYrMRrY91uJd5PGZpY1ygtO8XIq1E1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bsj0NZd6f85H0lqA0w-awTBUUPsTljgbD5_a9zxrkfA&oe=69FCA1B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fml9lrm7QgYQ7kNvwEjvay7&_nc_oc=AdoR4uqEofjM6gEYWSmLH1XKVlcknu0qgFL_3nqSouq-TaZQi9kEpFWX_eotO_1QAvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4An-8DRmkxC3J3qocxTJNxWgKhQ-V-aT5mqRHU9XnyFw&oe=69FC86E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK4trxmhgsEQ7kNvwFnh6h_&_nc_oc=Ado3FzoR0AQrQUb-Uj3DdJV1nBNUJutMKaN9tEfpJMuvJ_bBBohLvyVI3mtPzLimJSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52bQdszXWTEsC60uHirLyHWAckqNQtr9ivWkDLCSz6Ww&oe=69FC97A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZnO4rJlNX0Q7kNvwHdCdCk&_nc_oc=AdqL0kv_9FrZP2vgSeq2ohxo0LZbB_yokeGjAi-0D_5GK61ojlXvz07hJV693ek-8TM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DNc9V3yy8nXkwOt1SOLiF8ZkvMJLF99lLZqYixWvUYg&oe=69FC8C44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aElgC-Zf4KYQ7kNvwETgCca&_nc_oc=AdqYIoCgr4DyZzctRCLocRjMPjL5oH6ZVbrS3v18h0oG8fiHRkj9Z_6MdBnzk26MSu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DYxR3l9n6y4sFlu1Xj-cDPUx7hZq4YF9Ud1j_NtcZSw&oe=69FCAF61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
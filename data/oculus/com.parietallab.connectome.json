t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh4oaFcNjFkQ7kNvwH-dM0S&_nc_oc=AdrUDbDN28NX3EBQ9o9y_4eE-PL3LaIOjM5HsB_LadcO49exkA7hey6--BJfpzRF1Xk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26KipvfI4YLyuKR9y74RrsN34hiMOwOzwweqPdsTcU0w&oe=69E8DB34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4LfPzkk7UYQ7kNvwFsGwjX&_nc_oc=AdqRiGStzkuuFMITZR9QgfUguK1wS3J6al3V-ceYnykjH5HCBE6Etub2hrUOlbHfBCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZfnDQlv_g5e5nVcKqPZDc74csduxjN5IgZ2IPRD0UPw&oe=69E8C067"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-QTJIeKrAgQ7kNvwEOHy69&_nc_oc=AdowY-D_aKo4XLti6uVqM8ryW0uf4HvO8PHGPJiiJuNf4a-K7TlQ-Poa-10DZdYgWgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KmVDsgMMCfexzSU8JuH1aeM8eLCLK2h3kq-91uLdV_Q&oe=69E8D125"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ehz3HVQIP_QQ7kNvwEGsmWM&_nc_oc=AdoGcJSTv9drQ4ZStoh4TTmR-DJ4WsTIzKqDxWVt9Y0ZDZTo9Mgl9ubZKYrBzO0T0n8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BpxfzngC4RJn8C3Fz3kGWHETjbSlY-aUJzEzygglK_g&oe=69E8C5C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dCi5sqnTEgQ7kNvwH7-Dl-&_nc_oc=Ado4Dr7b7T9CORTrC7lE32FTYN8KpaETX8Bse0svd16rm_j1Xk5_woo9vzh1h6UHJnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zmEbc12KNPaTtWtKoFHO2Ax1TTyWAvKxN-zUBTGIeyQ&oe=69E8B0A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
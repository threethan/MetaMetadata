t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LVhIvyCit8Q7kNvwHSCjVr&_nc_oc=Adp8QOVO-XOx7L4aJsc6aLFIOQP6da-LltIQycUBTwLKhPKPvUpgGc5SccsrOQRP3OU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeXNhnrOkCdhsTAnG3sMXcgScBe21lUILG7-mmYeWybQ&oe=69CD2BB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkhyXnxCrIYQ7kNvwE-rHMq&_nc_oc=Adq66fMk0Lmav83pQHU_7TjTvGYgHnzADYKfIlUuzynxpa-fbpuxvsQii-X46zifdbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyK1U_lYLGrYn6d-FuM-bR2JHCQAO2ArN9zM0FabSsIBA&oe=69CD10E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATrYxlnp8KAQ7kNvwGq2qny&_nc_oc=AdpsXzNmdTlQuywgC2Z-XbmFgx3BbKmO97VUUE33IQ1ynqc5jHdkZNhQk1yCFrG2mrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJdBo-aPPkwQVn8X5gzCUcPPUtrYnBNoGnpGJn4M-eDw&oe=69CD21A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zikOXCx67dIQ7kNvwHpy5Aq&_nc_oc=AdoXsLipXEyui1oO4DaKYT05OUorCfaExw2tx1SLbC6CsUgLhY1q7foM4C4huEg5tAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4zmDnMwnSVvHlbwg85qvuxu4ZaE5UxqEj9qEQKDS91w&oe=69CD1644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4jdXfBBNPsQ7kNvwERYJ4_&_nc_oc=AdrAxCE715T3T1kQsgyyjJoTW-ciB-EGRlH95M2a7Q2_SQ84y3rky4GRB0M2kUJbUec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_vO82CKaya1Gs9T_KdH9XdV82V6VqtmBRf4raM3hmCA&oe=69CD0121"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
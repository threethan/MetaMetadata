t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UD9v7yNonMQ7kNvwFLrE29&_nc_oc=AdpvkFRiVD5nGUlydj1-kbubKjGzq6DxykTU8B2VuQDOr53JC8LOI60TKeV01ExwGFM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yL6Q35yJf38WieImQ6tREVFKH1-y2VFiDeiplJPi8Bw&oe=69F4B8B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sKwyl_DY58Q7kNvwFMcT1f&_nc_oc=AdonaQco-AOjDxP7oigUQj5e1ymUpX8w7PcAwh9pYoiKElzPUJ_qNhTHLZYj4QL8SzM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25SJVt6GdQ4Ra41-svP0j3_ZKzNsjNxFeSvJfgaP4Yhg&oe=69F49DE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_JqXd1b5RsQ7kNvwFVzdE9&_nc_oc=AdoDyFfnJBPefvQLAVNzyxbuREvJdyQdzJpkAHWim1rhExolY2UF8zoopGk0VnRV1Vc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QlYiHMAQhb6CqqziVhEwngrzv4b6XsY5YwotL4jlCyA&oe=69F4AEA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_0_H2_Y2O4Q7kNvwGknWFx&_nc_oc=Adr0OJ3k9VEC8lHGraxTnCrgHes5aOqV4u9d7wmRnwPq7xeTOaLeANJ4fi8wHiI4O9Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ChCFf5ud0mDI1KkD3RLCy2s4G-NheffUL-E3yOfjfhg&oe=69F4A344"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It9ccCXwNyoQ7kNvwFKPPqP&_nc_oc=AdoPN6YcINFwsAYn5N-lzjUpGjxABHD4G7Xc1DSo5rWnIgd-fWGKKtTe8dPR1vTUi30&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14pVCIXq6v05FztcHZTIkAdSWglnT2xNrSdjm5MhQZjQ&oe=69F4C661"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
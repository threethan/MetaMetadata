t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axhkxrOhyI8Q7kNvwHVz2zQ&_nc_oc=Ado9DbEK9IjYxZhnCviBIQP1gMxvOG_zjn6E5G1fxlYKn2oNr6zegXFV_W5OiD3dMIY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0keeX2xiNIs1dQi9cJvSUbbrVGJ4IM0bHA84sHL4qGA&oe=69C7E5B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgVaLJZPST8Q7kNvwHyQLWf&_nc_oc=AdpJ2cGbdEHGEeA7ab92CK00H-JsBytx6vjMu6Zykm8IcJtFFyVqAzK0w8m5PczaFzs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpdTdU-5g1gvD0XoWLLKDTFsuP8B9rMIq1BPSWdaGzTQ&oe=69C7CAE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sfbS2p_JFcQ7kNvwHObsY5&_nc_oc=AdowpxgHVg5fX14905CoUCrzd_gkBscRMPK8GseVsxNN_XJ20A3U6T91WgYNQoMZras&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwP_HQF7Yk9DG29TCVy8qMV3-Zt_UdrN5Xt-qgJvS98Ow&oe=69C7DBA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTr8zgj3cqsQ7kNvwFbGEmC&_nc_oc=AdqWgmS10pRaUNRszXZOCz_lhb9-Txitvb5RADJc0hFY4vW43wl_DITpF4n2yO8720w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUGKI-kS8Wg2TsqGzdPQ0oKKfB9CGXmwZlvB20nRxEJQ&oe=69C7D044"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em1otQPQj3IQ7kNvwFKP96D&_nc_oc=Adq-872e0hg1NM9pvAt65yNTD61obCS_MjEXOtD8TxKyZkPATAQOOy3_Hzdo2m_d6MM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzqWIrVbInVarQQ8gkRzQLX1SXJtOs6RIdcIgmBzXrHg&oe=69C7BB21"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN_3fLRlYF4Q7kNvwHl2DPP&_nc_oc=Adpv--MiTsdfkX4fNIEsA-gyLiHVhByWpoAVYTHdtqwHO7POjQjVNp3XUi9oOC5vhGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CDwkHG_kWWYPYsybHqAPDGu1EN4IBbgT7IqWVqY5SGQ&oe=69E0F234"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irgSm3_2nMIQ7kNvwGQa-JW&_nc_oc=Adq8pgnlIToIqryGWRuOE3amKeqMPi51U2lZi6hU-ITG9LqpSEuP8JlXV-hBXzhx0zU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TtxUNKlQ9r2aPP4jbOK6g3WYbL6ifQjmSQa0BiWX0Kg&oe=69E0D767"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4vlC7LohWQQ7kNvwHasr-Z&_nc_oc=AdqT33PSMLfUZibVrk26wwBXC6-xwyWyrYmNAKvdjWDLA55VwV7e9BceLzFVbuhMmQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HE6qZ7na4Py4V12MOobO7ZQhX9aFSgxz6JoDZ_6k6-Q&oe=69E0E825"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaEN5OJKkkEQ7kNvwFsLBAJ&_nc_oc=AdqTM5k0gbgqxbhbsXPWs1bgYnW3VTleprc1W7n0yVcD0HOGOKrOCjC--vu21CUQtD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EGwiiPIXL1nRDRbgGI3c5XBjPh4uBiGQik127VPKNtw&oe=69E0DCC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcKK1cFMjQwQ7kNvwGSc6im&_nc_oc=AdpkIf45OWGUdL19YpJJe3epd3k6Tc4iNGTHaLRDt5sCwTP_1X9sm7i12agl2vugSrs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3E3T20nPvYgZ3qduLjO7Cncm9FGbqz1mZUmWPnCFAo0w&oe=69E0FFE1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
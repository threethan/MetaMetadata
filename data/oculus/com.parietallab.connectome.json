84268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kOk6ecTzsEQ7kNvwGPddl3&_nc_oc=Adpu9b4NQwvSo7SbibsaKw5PfEzUo7T3KUZpagv4rFawP5T9HtRcrwPbmLJ8dPzE8fs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA20CyV6mW0wAwY_ywtMxhBR2nOYX-IMxVYsTKa5vuMmw&oe=6A676B34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o23ONtGxJ4oQ7kNvwFPGBz1&_nc_oc=AdrV8dXrrtRCd_80VN_PGmbZZQXExgc2Xto-7Ec-NajllxzZLwsB45kqFTbCmYPasGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIo-cHH41pSQ5Y6ffk_r1C-iHRBLPjYHSnzcz8p8lyLA&oe=6A675067"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk2r2McAwy4Q7kNvwGcT-00&_nc_oc=AdpDA148YrxcLoAtKlc9smEQfsCLHjqDugEfqFM6n-J8zIKX9bWCyp-lngkMoKtwc9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4AWnOO0r-XQxdOij6IEzHSVjDpkGfmW8jw_lro4LM6A&oe=6A676125"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wl8c-b8WXVsQ7kNvwE0lVda&_nc_oc=AdpjGELO64bKqb1TQcRgI4aiz7PNltUMQbBpESg8tnP2BuWlYVY-dQ13kfkKhsO7hh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdW4A_7Wjm2MU7l6GGvdsNzR4uP58xSYaabNNFuxL3JA&oe=6A6755C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ry5i9dX5e8Q7kNvwGYjjSG&_nc_oc=Adr4QGoZR8j6q-lRvBF-gWAHrAdFXCg_a4NVATNUXlWVy4OllTvo8lsDAk0qHNYAYDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcTTD9Sqw3tFJYh0V_uWl596q7TPorMXxP1kZRpcx83g&oe=6A6778E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
84268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGHGEnuculwQ7kNvwGebBBI&_nc_oc=AdrVDXE26tJUCZ3ErgtJy9JfzyxeahAzL7EqhME_Jgs0Pffzf0kEz_YbwzaOPiX6MnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCsp0nAfu1DNWDp8BIwYe9dqAsiAkmgsbZRbg8usFtgg&oe=6AA2BEB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Iq6vecJLTUQ7kNvwEBCoxQ&_nc_oc=Adqaopf3XBfwlaMW_s7m9tUkzpNhBGHdpgeZFOfJtQqtmojZaXa9JE9UmQQJTP3AyFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh5NTV0ZpOb25J-R4onNBx9k7xuisAS_zDDqQZdR7wow&oe=6AA2A3E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu-XVFUrwIEQ7kNvwGRuh9V&_nc_oc=AdppMvIW6MXXevO33Im8cNxEkKz81u1pCZ7ACPVMrsLd5R31LWE0mjvgzSN_n4Ev0R0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdzFoRQwvzb4lUE5iL_vXOjH46ThtZwKyjN5e_Mi47rA&oe=6AA2B4A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmUseyv7wAAQ7kNvwFpF41z&_nc_oc=Adpf-rYTSxGB6GczA-pqVpaEZCtX7ir0ozkRQJa9XZDIxkIgBgfeMzDe3S2-0KrzaM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbccNJGaE--bnHk_muHTII2bhiu8pK4BDBqCDhKvwZjQ&oe=6AA2A944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMb7DluSapgQ7kNvwESpUuL&_nc_oc=AdoySvJh09Vb6mC3Y0-D8KDF2usgaqbLGgyMTlcUIl7qwbBYRmbp4nDunRUmbBiFumQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHOimsrT3mCo-lKD8sMPtFHv7Jud9gqqD6PJYLPEZtoA&oe=6AA2CC61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
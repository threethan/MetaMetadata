_ohc=U7wUSx8HffwQ7kNvwE-aorT&_nc_oc=Ado7KLlMHWftHX-jlEqMX5_zQQjK9U-aGIL4WdN6vZ4_OiMJlZel16w3mUrzo_1aC1M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5jQtvRgDrIBnFT61y-7m01Pu5r3GXhMDFEiRgesU3MA&oe=69C14E34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FnBxXTPKOcQ7kNvwFZVYLj&_nc_oc=AdqyNhGKCyboEG4XljwIhP3LTDiV21MjEMu2KNKQWH29rZenIKAh8_kjogjJM77pvg8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwmABGp5oyEPSVCChodMYBvVTDEB6Sn65oK1bWzFMJ2sw&oe=69C13367"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wzwE6LWGz4Q7kNvwFOx7sa&_nc_oc=Adr-AV-VdrlkuC-2DrdOb_pY9gmlABxBuXC3UE_are84IeXGqMTpbY_H1tKSRAF_5mE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyjCVrB94w2gcagtWemAcI59TjC0yJrfq5COIDB3PgMqw&oe=69C14425"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9jhV_f9cLgQ7kNvwEbfAh-&_nc_oc=Adp6lVwxwfiLt1Dw_5TfybWr_3ELsuiYkHtPmuhNrLLtbQ1EWvG1653S87ZbtGiD3jk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9mZB8nmnqbHpqcSNS8a6Jox4ZfBMgsaC2WFC1wKlTZw&oe=69C138C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dpyktfkTsgQ7kNvwEdBVx9&_nc_oc=AdrSm_i70PDqxfqwgi4D5ST0W6-yasSCTMYKQyDpQWEudNhjv4hIdBDzA71RK8Od4g0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzy_lutMvJPbuP_0jrZ6hyqX9y31RnqHgSJ1vHlQXSLsg&oe=69C123A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33288133284165472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622214_891730399976926_2927939352608887063_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kip6oBnMwZYQ7kNvwGdq7Lt&_nc_oc=Ado3SqPTF6DC-7Iv38sY5R-S8Q_C2c3qie2AgqL6-m2xIoS_yJOPCADQ-OvjK46mYkg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwByCvqldZwTXwHeFh-uN8GWX_HsW1BHps_v3FNoNHWJg&oe=69C1195E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CONNECTOME", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1748367660, "lastRevision": {"nodes": [{"id": "25707920678853475", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25707920632186813", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "934148758813776"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CONNECTOME-logo-nGon-512x512.png", "id": "8712126905541979", "image_type": "APP_IMG_ICON", "uri": "
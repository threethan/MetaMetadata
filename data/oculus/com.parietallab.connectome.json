_ohc=pxC3XoDXnvoQ7kNvwEnzw1k&_nc_oc=Admwl91t3FtycCIWNIun_B9IWrzOEfpIhFviciZyzlA2K88iNnnnIaFsBtwh0j24en8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYopWeQCnzXP72Lj-guUrNazPJ24HBX-LrLgcgzx8iog&oe=69BFFCB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCYdBhR8kwYQ7kNvwESzrrC&_nc_oc=AdnxEKDoJdvmRxe3fXhMh99lj5x1SDXU62GsXu90wsPbMCtXh3bzZZHB74eZVeNey0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwC_P22mYF_ZLlKONEj0E8DY7gPqmcvdbzOg8FqSu5M3A&oe=69BFE1E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wzwE6LWGz4Q7kNvwG6lDPB&_nc_oc=AdnojxG409thy9X7QG7UoMFrefs6EdT9KjYALlc-HVdcOy3f7uohMX7-2rbPWFlqG3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7D7XuH5xZxljb_gILSMuwmHf-NiE5FJZnUwT8HdKRrg&oe=69BFF2A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9jhV_f9cLgQ7kNvwEq6YiD&_nc_oc=AdkV5hE-nFTonBwoooIfZ_E85SJU-HrXj0OkfV1aHL473IZCX8pUq7nkg2hfenLVpPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBWKDac9vB4blcPS4Qf0HUDX1nBttR0d_V1KyPVVOkNg&oe=69BFE744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dpyktfkTsgQ7kNvwFQQtBX&_nc_oc=AdmLo8zx57i2mNcBccaETjkLMW3MaDBYcc8UdwMoMdNi4YyRZC8gPzxJVHrTzY4D6sI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQKl_w4HGHB5xaKBocZXZawmKli0kXO4vZacSsNw4VSw&oe=69BFD221"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectome
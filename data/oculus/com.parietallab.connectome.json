t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh4oaFcNjFkQ7kNvwETstTk&_nc_oc=Adpo0pIIynjaWFVVoGKxZfkzOg8T-pBEdpmtsQpmtvhtIcKZiRqZI5USL7cpe2JHbYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pQ2m9SOSFKKa3sdrsbFOHRGsDaS6RLqnL2DMSMkcVeA&oe=69EB7E34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4LfPzkk7UYQ7kNvwHdXAdN&_nc_oc=Adrv1hgNyt9eu1fq_2wXemecEc2GLexotEDgMeTKwT2Phj2Q3u7BEetHRil8caCIP1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cN7r9tueTVAKpy8tJ5M3TcNQDZxxRIl-DBgHrX_AF_A&oe=69EB6367"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uvH5DTVVpgQ7kNvwFOmKwL&_nc_oc=AdoORi4Yr6FxebfDDjFYmFCgtNWuVvjGB8f9cdoRnwJWZdvrXNmP6NhHDSkEBgdd_xk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EYUY_4Pw2SjVxtOPh4zMWKp_rAcGo2XMcSJY2gPtPaQ&oe=69EB7425"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZW19PLnuSSIQ7kNvwE5PNq3&_nc_oc=Ado9R6Xafu9Bq4d5-CrZr99rN0igd3HUcduU1u3qx3LWZSoBZnHSHJFFJti_K2G40pI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DcTenyAqAxBuSkZkPL3CwAZLeSNTwxCcjs__YOMe9gA&oe=69EB68C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfFEQy2UucEQ7kNvwGqXpAb&_nc_oc=AdpBzlW7K4rR32JEM06Aat50iA3c9Lruc5Zi-mm1jpSNg9h3oDVUF7LGFVKSIfpzXmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07gWCkeTRg98bKyFNy5ZjNlrAza4JLelyRbZN8IPDXnA&oe=69EB8BE1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-IRz8VLySsQ7kNvwFN8Pb-&_nc_oc=AdqvSXPGTpn7pywBIA8FD3ypybR_vzCuCCpUZ2uhDyiaYnDk1UqAmj0XKqsgZOf_pss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZ6dC3C1LqqCH-r8taGsOg1DIF8asZV1VLjIbBM_aaCQ&oe=69D12034"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gk6r8xkUZ_cQ7kNvwEZLDGQ&_nc_oc=AdoKWoEUWRCgGa6zyyfH3eNr4WkfNabebwQDNoMhqpZmO-yjWJI-QfthrW0yjZC86B8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLDi1QIyXMphBL8gsIhU4BVUeqVQBR8pXIYIoLKkGsfA&oe=69D10567"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws3CAI_wOSMQ7kNvwGzzfYg&_nc_oc=Adogv0qljYVJ1ex-_opC3wBfFKVEenHsfYBS7Hs8O7j9F5Au2e7nxswSUk0EIgnzlNA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTXkYPv9cJmm8TGFSIHLdHUJrhjczgIM_5SPprbjyRmw&oe=69D11625"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FExYBeFEUI0Q7kNvwFrQ-pg&_nc_oc=AdoiVBkCbxBFSkie6uMnAa1q1-SaPUSjkRuI7AweWlOiaxDSXhxogkGqYwlxFiJSFXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVSeR-7FjPOAkf1tcmYbkybEvWAWEOPZZkAg6jOSNiJA&oe=69D10AC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYEqH7d3dsEQ7kNvwGfeoK8&_nc_oc=AdqtfqPOkwziiEC33LiiJySTS3WDGXhfFPhcf7SqQEKRWs8SYjVLC_TEZ3QiU1QVUtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_YhixMiEfdhqRKrXxG6__728xlgpK4MCskIu3QmE-4w&oe=69D0F5A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
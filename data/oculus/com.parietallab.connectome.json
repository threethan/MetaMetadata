t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyUIL9RdX2EQ7kNvwGwiaNf&_nc_oc=Adq0snZh7l7Ysl590TN-bLpCH4S2x2s_kykIF54AOpiT08_u8EzmZ4sRITxg-RFSkd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af472qUDZGEX_shDd1yTEqgFcKM6C0sWyMuBkisgMRK_xA&oe=6A01E7B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74TVlT4YkF0Q7kNvwGVeM_W&_nc_oc=Adpz-0AV6A0WIeXrxNRET4PCeO72xDNgwc30CiWrzOhM-xnwcfGAtX4yPnVLgwiVzYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N24Gs1Mf9OvyuyNO4jBum94QnQwnrkkszXFDNXKt6jw&oe=6A01CCE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALuGBJm_s7YQ7kNvwFhJbyN&_nc_oc=AdrmqqbHIjCiFEJk8jGKWWWVMr_VoDNn5dyb62rej42w7UGJ3Xuxko3n_18In4xFt6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cwa7sqgLFwoAwpbfa9LcMUyAXU-kJMFERPBwnO1YvPA&oe=6A01DDA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDGvk4B54CoQ7kNvwH1Ns9m&_nc_oc=AdoWKcBoFVuDVoCaGVF4g1iOL9cXZvLC7ND_7OY58AwNEUFJm1DzFvMhfF6-ONBngGU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l3Do40f7ZEk4uvC_lTyfiAK6gG6kFeAAae2lmh4mY0Q&oe=6A01D244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMCcwHu73RMQ7kNvwH6GhLc&_nc_oc=AdqJq3BRYBIs5AJYqp1nC7p0vY5iZdFJDb_k5GTcMXhgtJVh4ooXn9v32lpABohXwlo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60BIMc4jsFpKI_1voWsWrpBvvy5WQzUmNsUcK-YaMFpA&oe=6A01F561"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
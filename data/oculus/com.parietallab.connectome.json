t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh4oaFcNjFkQ7kNvwFRKoC6&_nc_oc=AdoAm2Ba1zaW0zB_Xb7gMsZX61exTxV5PvTA8ULpbKTA1M84h9B9hi6bvGeh7_DFUEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cp4DGzo8pWvGGurxgX8yMqfYDEyyEFi05h7hDMeT8Ig&oe=69EA2CB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4LfPzkk7UYQ7kNvwFKlXJU&_nc_oc=AdrKMHUnQDiC3Z67xzFp8-K-RkKp3mIDSXBvYR0u9YAX5K9hcqYBulb8DtCX2mKsLSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rITjhemAf-wmaiL_f3yXghI8vtzcjUgOui6oSCOVhSQ&oe=69EA11E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-QTJIeKrAgQ7kNvwFNbegd&_nc_oc=AdqDV4FgD0SMCOQKhZmdBwwNU0XcUzU-4087uLmRQW2hu7BgY3fEWOt2OoYGTc3-w5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_a3HvxBAHbBhTPXU1H0Dpeo7tA-4GcgqUkFNF85N9sA&oe=69EA22A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZW19PLnuSSIQ7kNvwElW5fQ&_nc_oc=Adrly6vHqHodthl6ulpeF4ADHqRK-WANWoOtq4lVThqZ7WMERMya3y6aS2zBYSs5EY8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eyeJd3HQ5WK748tST5tS3-TdUe2e0yaRrhZYDddKmEg&oe=69EA1744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfFEQy2UucEQ7kNvwErUipK&_nc_oc=Ado1sl6vPRs9Cny9B2merebCe5M_8fw0iyizziqhtwSaBnIviwNwpcRYB_aHgO7dBaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EE-v-q7fgi5GMbmGsHT85YENfbrLK3PXgolSb9Q11XA&oe=69EA3A61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
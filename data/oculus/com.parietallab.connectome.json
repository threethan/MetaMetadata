t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UD9v7yNonMQ7kNvwGf3I_5&_nc_oc=AdrZJDLGvIELDNWbavhQOJtN56kiFSZRlje-Siase0T5sLuDkX_dPxMU43tar5gCZlI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3k4Ys3wt5NqElWlr3axdrgMryRfYMiykFHXMJWPTKaUw&oe=69F60A34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sKwyl_DY58Q7kNvwH4LVNC&_nc_oc=AdqihVz5uDaVMsLWvDBYosbx2zKmGvm4MDZdbijWiDmYVT6nEsnhyVfeF-BB6Otn6Jk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1L_kWVwaVdTDksPmYoi-l1az8MIIrxhrGTKWGGZAmrVA&oe=69F5EF67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_JqXd1b5RsQ7kNvwGkIa5R&_nc_oc=AdqPD-RTY3Bip2QbIM52h4yNXlrHGrOFlNqPsubkNfPHsFBFU6x5XssLCXg40UhO7fY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fyX-qTX6U8-nYOiH7EXscYNN05MnIF4qEqeuqXmRPGw&oe=69F60025"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZwVjfJ3TiAQ7kNvwGvIkSH&_nc_oc=Adrr60RyTPseO9Cf5TE8b9OAgIud4mRIPLzPS65OgVyVav4QZbtookXNGriNsTDU7m8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3m_fpbZW7Vm3l5CMiybMk4k8aaKQoOI6xMqjJ33u4uHw&oe=69F5F4C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpNHTMMbRhwQ7kNvwE36Y4M&_nc_oc=AdrBK7aaK8zpMKw2irlaHb6YGLriXaSFkgpwWzVF-KdQze6DWHMwEtos53lvu86ygp4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_LbgVWuCFjaoABiYRvRWsmL2S3wz9fUn35PrHVUObZQ&oe=69F617E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
6802560384268", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xNXg_rKNEwQ7kNvwFIcNTc&_nc_oc=AdoUutli4o852aMFRQ3FvRnrnAw1eF_Ki1TbbVJV3C8N2Hq5nVtLu9AqO40QObiwyDA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLmJxD32CM6WEFQK0F8JoNbx2E1_3fdpU6u9ScIcs_0w&oe=6A858574"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1j7kUkyIcvsQ7kNvwEEfNTK&_nc_oc=AdolG0vKWcdaAevOw_-lvwSPjFxZNf8H2SyIQXNRb_tBRgCojfh67zDd6PzXRyF4AwY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu-fXkfKVG0QLAXSgmvNy75Nj-_F4v4Cevb_infqXVlA&oe=6A85A2E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIC-Pzq5jaEQ7kNvwFB6Kh7&_nc_oc=Adp-O9MhDesof80SvteoTZQSRKJxSqu5czadXtqoCkMoToypzHhomjxYrmeS-sMQc1w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFodxy5oG15XMhNKUYZtFAIDSwM7GJ4QIffOparlLEeVg&oe=6A857B65"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NilXeRnCz-EQ7kNvwEGm3GV&_nc_oc=Adp0tmQsrGowbHZAaU5Fxid9Ae7ognW7xYZhBAOz_Elru9qVgsYex_sBtdLgHD_Aw2A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7EILHT4Q0ELyojtQqWe1zT8mAQ_ZKRUumvuXAFEXWfQ&oe=6A85A844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFf-MqigkxoQ7kNvwHJwz0T&_nc_oc=Adp7IYdGByPcDfuYOPa8y1g_SbQvo6JWWJRve-kedveHP7JlNTcgTJhG9KAr-5AqiNg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVrm8CR_9E3BmsVJ_La7dx55ew99WklCD8LEBqk8RyGQ&oe=6A859321"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.c
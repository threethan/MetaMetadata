84268", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKJH3W0C_-YQ7kNvwG3lMOP&_nc_oc=AdpYN_EUGkpHOQehzo8WY0Wei1gQYbH0IG2dObgbuP0VghheGPjdGVG0KC2xSM-9pYk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GZBuq6PogQqPgmRiXmTWBmPbOSQPsbIiIZMoixkD5Gg&oe=6A16FFB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7p8nphdtCUQ7kNvwH1tZjV&_nc_oc=AdrGXlsH1lGUgar67-HhuRv_JCrLjvsNBZqYcNaolrh44hiWpCJB1NDxCvKXToQhjkw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bqDQqcr3o_DYtcZ4g87GsIf4c-mhsUBxA_olQp4gI7Q&oe=6A16E4E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9goDfpKeYf4Q7kNvwFGduI7&_nc_oc=Adpyybzb3tZ1mmydJsF7RYzKxjJsqU4jjwIlDQBeSA0cAdaDuj-1Gm8SCMEE58jBLuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75taNdmSj1IWd_LTW378QFf7Y0oKeZTTaaYhsrdMx2sg&oe=6A16F5A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU6Yt-QFv7UQ7kNvwFWBcbX&_nc_oc=Adr8SGVI8PkfC_6NAAMTVsuuZlxFJoDCAyaIJzlZkycQnGyhE2LMV5V8Zvx8sVkjNEk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BuDY2qqqZN0tTCwew2UN5gyQ1DQW969xYDlRh5W8Z0g&oe=6A16EA44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmGMYKUT5r4Q7kNvwEeBvG6&_nc_oc=AdoaBGklECiyaLCPTloimvEQgwXweW17p6Y0pZqBp2wnk90Q8GaCdPlJyEm1G7JucjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sX1eZoZCBhjjsuCRRKlkCr8QIm9xv7vKKZPzy_5ZwLA&oe=6A170D61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
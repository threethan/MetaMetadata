t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DLdpsaMSnsQ7kNvwFRg8NI&_nc_oc=AdrXtHEkMXHwGov8rwR0CynEOqxuW8-_GhLXNUKZlICyBWuTY1r9v7i54lRVxFeBwMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S_zfHuSh6AeJB6MVwVelI4frCIh78DOg0fqojQhneeg&oe=69DA5AB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl_2C7K9BsMQ7kNvwFsW_na&_nc_oc=AdorN0cjfrbjnW_HCl5pABJAZX3D0OhyMBXAU-q0mNAOg2-Yd8B9SamqTkvbfIUlhhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23FsE3xVUdBJaV6TfxwDqBlY9804mwexWmyd0Vj3wGxQ&oe=69DA3FE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxiIckL2Mc0Q7kNvwFuJsZ4&_nc_oc=AdpdnDEvUzzH5Vfg2sUhpxkEmhrv2a5_F807i1xsAvQA2tZ6MsdBqUHES1YVDnQre-U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qEmJ6TT6TkiPeaJr92ZMX-Fiz4R4qSAB_AWs10RB-fw&oe=69DA50A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcNOiujO3vUQ7kNvwEb80U4&_nc_oc=AdrqS51cG0zYhSIqeg9TjFB9KyIcRF9TRrUgLWrGo80BhCILvSAMkVGHki0kRUZB_Xs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qWdBJsmhpkDdNXI6hdA86sU-bnCwSLLPWMIXiuUmASw&oe=69DA4544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzDb4_CyQdwQ7kNvwG2rxdK&_nc_oc=Adr8IPBpqGvjLESKsKkTH9d47e02gIQQiO56t4R6pGVF1XODlaSmjy2mLkHXYhSWuKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1POPBL8V7YAv4vQGiVYwtEXfut-OWjWhVeyAiaXYIpEg&oe=69DA3021"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
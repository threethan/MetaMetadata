t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7wUSx8HffwQ7kNvwG3m_x9&_nc_oc=AdqnkzHncFDffWigVSac2JSqFaVIa3YgzJgotToqO_umjSdebE39jh7yr0MXYWerfiM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxymyEHhXbTfOQCxP8276iERzcVqMNRcDAvZDgN2q4SpQ&oe=69C3F134"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FnBxXTPKOcQ7kNvwFHncal&_nc_oc=Adp02BSk6jIu_qmLNpQWZLWV2ELLcyfCEpTi4-LaW6RaECZWYufVIUYdoF5PPqSux2o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx78ornyCeLabmxe8lnSeXz4ws_tS_lyalEKkBM_iXKlQ&oe=69C3D667"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1i5PDvTO6YQ7kNvwGWFINm&_nc_oc=AdrhtAro1wt4Ag2hIaAhv-1ulRe1zBn__aUNIJ0FDKx2UaQ64iT1B-7AZUE68RQzTXc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPvW4Hpi6nVs6abtoaV6zoUCHItZ0isTp0qIyffGNqDQ&oe=69C3E725"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzPIKwzmvXwQ7kNvwFjcQ2Q&_nc_oc=AdrL-CHoBkCj1AlhecHX-eGnhP3S_i9J6eHykaSjSVi1w5Mfo65OAcll15s-OV0TNBo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSUKzAGzbwIm0DDN-TN-44II32xcocqh9pgyCIxM6Jnw&oe=69C3DBC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbaPgpiykQAQ7kNvwGBzHol&_nc_oc=Ado02SsqokztQ8QOJReEmxelR3OmfIp4cIL2TLqDukZZ0eGuc0nESdKWDmeL5-ehUiQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzu4h80bItpPqjWZBqXbLuE2uCrc1iuzX3ya31PQKUJkg&oe=69C3C6A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
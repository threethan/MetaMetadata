t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axhkxrOhyI8Q7kNvwFuofWm&_nc_oc=AdrGIez2oXc9IYng75w9XXccDVrl7VMtYbWTBmS28sf607pQ_0tikqIPcN0yEzmwahg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWCjhQzu4gVPucI-q9DeP5MiVBNBcsWLADbVX85dUXYA&oe=69C542B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgVaLJZPST8Q7kNvwFvqeik&_nc_oc=AdoB6mqxjsmWUlPd2jmTUBMG2vRziznuG2FWF0nbvfYzkxvsuiHWMuaAx28qFc4d5g0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxogQQZI5qdrrTQQXrGZwjqCVgQTaplcv28Xi0C0-Byvw&oe=69C527E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1i5PDvTO6YQ7kNvwEfCE22&_nc_oc=AdoGEd5HuVGT5lJ7phE-4Tmw-gw942cSLIPc6ThLUjcFu1tln-Oda7WCPFV7pTT_qPI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw24MwBrZUc9XK13LsbwF6CEoQxYp82BEiPqNPASiJ9sQ&oe=69C538A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzPIKwzmvXwQ7kNvwESMBIA&_nc_oc=AdqsGtC7SG17zK6R_5tpoBJKannE_5d2Prwv7vwd67JzEROu9UVh02xRNj6CwgL4uek&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzK31JZL1zihXp3zbb8HGFomXJtxyl_HHD0MkX7UR4Y-g&oe=69C52D44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbaPgpiykQAQ7kNvwGWhKu2&_nc_oc=AdoLAOgnqMbyCmAHyiIgK35jzD1lfodeM7kQbPX3JwvMYh7y2NvJtlks9-JOVYte9B8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGWmEm4iQ3KiomUxQXAwmHuvZgMm2C407sl6JlGlPYHQ&oe=69C51821"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
84268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zhWVrbV9HsQ7kNvwFwsTPJ&_nc_oc=AdryrAtJ_fmdjoqQYjnojiRvu-DA4BBIbCLZ68KaeYXIosK9jo5himKf6x3smsLWOH0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xqm8sH0fJLGhaTy-Q1Mh46nUe9lk1S8YLG_kL-iRqgQ&oe=6A0B2234"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyyeefqPXLQQ7kNvwEvcGkq&_nc_oc=Adq6ckaM8bWK3SI7gxcXc2GLcVnSsYbBPE_B7azdhbtFafbX2TRNwUfHTlgGkbmjKEE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WPqwi5axHS_qRsf2QyOGIWaWiorDWUd0Uhws8Ny07DA&oe=6A0B0767"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Anhwnw3zBioQ7kNvwGL6Hhk&_nc_oc=AdqIe0YNXv-gwGio49D0efiP2eSLGOthIWfeAuwKGPZrRnOczw4-HLvlv9ysFs4SeuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7koeCFktydL3TbmNoL-XUsqf_jKVgerxm4hYbkBcsqlQ&oe=6A0B1825"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ueUUWy3_yYQ7kNvwEJo4VE&_nc_oc=Ado0wM1jxB3i2P1FJ8g_pAAn6PG8EwbrpI1Btm7qTycJfAAZejph8c4f0eSf8VjwrBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_Hs9JXRzVarkFpw75uEoMhKiXejyzcOrtvkv1y12Ukw&oe=6A0B0CC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMvLH1SAAIUQ7kNvwFOlFur&_nc_oc=AdpVMaLjudfy3G8F8Whxmw9l9jy0m__7r3GUGoS3p4nUgUKT-Nz_FopRkB4meM21-MY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67qFZnOYKtBmTREiCIW8g2PngHyawsCJPvSDWn0jTRsQ&oe=6A0B2FE1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
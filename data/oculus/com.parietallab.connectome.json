84268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CItr4v8S5WcQ7kNvwEr5Rd5&_nc_oc=Ado1H35ZYJHPLjvY0rTzvIFfz8J2ofbhaRg1beQpWoureOvazH976ZQ1Hi4phYb04lA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIelR4rKfQKxrKkP_Pqt8cWQ3RRwivWAolVnM2NIwdaPQ&oe=6AA01BB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcwfUAaJ00MQ7kNvwEnE_lj&_nc_oc=AdrWbhhBj13315_WCz9DkILaEjJmj0J9F-FiSQl88e68dQaX6JTAIu1UWQ-AYMXma7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSMLoDec5yMuUOsHNuS_DJjCKn88MdfsaCjDEzxFc30w&oe=6AA000E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k_XGPE5w-IQ7kNvwHLVKkx&_nc_oc=AdoYkmf0o520L6uUwqUnQwjTlG6NUekKTHcRZfe02u3RK_wqkB7uUBMJeWxdf9bq5HY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgjYdZQrJzaIy0BiP2ZNfNz2nzb7z8XZJiLyQRYjoOpg&oe=6AA011A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmUseyv7wAAQ7kNvwHL1C4u&_nc_oc=AdpvttdWquK6fhZjjA0LQTDkhk1YN2gLBSG6XCUYSKeByiIkxQ9dE6UN03EgabXRZOc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3B5N-b7665Gr7yskxBWQE-dtu2w00uMY1Vb85o8yoKQ&oe=6AA00644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMb7DluSapgQ7kNvwEyUc9x&_nc_oc=Ado4FRGgS1353D0CosHvpW89XXkVmKg7cY5V-3elQRf8aTcfLvR0Q-8zcr_SmdnJVZk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfIs7LFB63Bn37aiBB3m5KhzUXtZv8SR6MZ026bFA4NA&oe=6AA02961"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
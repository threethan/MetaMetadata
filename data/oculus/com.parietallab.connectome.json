.5771-25/75348036_547445274926381_7448331770935991342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_hmXDkAzpQQ7kNvwG5_Mc-&_nc_oc=AdrGWNhPPBkpupe5NJGUuBQ9pgl73mSE7r2MyRqiDm1PuwzAPMS54mB5kFP1Sw1CRSM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOugdqsxf6M8dqoXNPptHw4wt0n58SfhUlrPlEr4A5qcQ&oe=6ADCB649"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-CoverImage.png", "id": "1865478304189674", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035314_1865478310856340_412617430543564406_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ngNm14q9esQ7kNvwG6bC_y&_nc_oc=AdpKKXEuSzeZHKDjP-mu8U0_fFXyPoAYfCvV2CQiDAoYIrOOdN0OTlHKBnIUIMwF8Tk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFjnfUuhzs4w6LLKxd1X_vCaCLrlrQSoxO4M2V3xgBGw&oe=6ADCB1B5"}, "display_name": "Connectome", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **Connectome**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\u201cConnect the dots\u201d to create objects\u2026\n\n{459548087014195}\n\n\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026\n\n{1561193251252347}\n\nGet lost in a place of wonder and scale only possible in VR\u2026\n\n{2611663082362016}\n\n**Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in Connectome, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder an
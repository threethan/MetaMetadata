t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5sEyUmP6QgQ7kNvwEiWTty&_nc_oc=Adpu42nvYPsyRg03kk9pyLF5ozKU2WSi3B2S9dk0VIx5nGd6_cXBRBzVR6tMd3YBhpg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zFiIBFN3MsuE9aywqAF6VE7GPICL_M8pe4ukpyxdc9Q&oe=69F36734"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABBiFukFa7gQ7kNvwE8DJgX&_nc_oc=AdoKzl8VXsaQ3Qtv_nNMJ9SS1z4UElk4ClkxI2GGeQGAHRikHx1bCDje7Z0YSCPCkx0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Y4l5kHvGBM9ROcVvEfcST779IxDY05XbH2laRrh3d2Q&oe=69F34C67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_JqXd1b5RsQ7kNvwG4ENCR&_nc_oc=AdoCQzLwVCDOPQiZo7Z0OxLAe3ntZ1Cdcasg88torzAxrqUn4owlKLQujcCjL6__Jsw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OrpAp1FwpnRo1THyH5fUEn-ESm6-hH_p3JCW67uUk0w&oe=69F35D25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_0_H2_Y2O4Q7kNvwGzG7c5&_nc_oc=Ado5Of-f15EcK7K2yK9za4G-l4NzWoXLpStge_hBTxsHoErezalCi-F1081hYauDNTo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Bl3dd0AixeVJc76zFXaJ9rTYzLddTwZHq3tb78ZlE-Q&oe=69F351C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It9ccCXwNyoQ7kNvwErccgF&_nc_oc=AdpQPgcQ68ZH_LdLiWWGPmJBA8ii451YLhj5x5yGCSY4jKJJJc-iJl_LijpEh3dh8Qk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06K8KtxaRBUPUcRu3xP5_UbxQ_uWkdidg88_t19C7AWA&oe=69F374E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DLdpsaMSnsQ7kNvwHuTXRn&_nc_oc=Adrqv653_WSOGHSeGHKbpaa5Q7QcGaXyeFcfJkymJ7JqHkNzr_4YZt0bHzi7I9fZkxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jnEiPQj14qXTH7N8paLVpM69JHgzsGSJHM65UesoSqQ&oe=69DBAC34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl_2C7K9BsMQ7kNvwHGjy0e&_nc_oc=AdqlaptJxxJKXd0xsBm42pwjsikmSfKRXsjgKNssuWc6od59vX8FdRgUxtdnai74TD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qrAXsVv27MH342LASTEMyShXUWhfKHteu1Y9NXemlww&oe=69DB9167"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrLBMuw0Gl8Q7kNvwHK70C3&_nc_oc=Adp3aYcRF8Ls79OvBK1s3IDZ-Qr46fSC-JUQktno-Hnshg4_yrpN8uqGsXvWUGxdvFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ClZckSO1j8-72p44J72BjXxdArK-faV9hyGJp0gkRfQ&oe=69DBA225"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcNOiujO3vUQ7kNvwHK6TyN&_nc_oc=AdqSVuhpr0k6DMudlQ164-gzciaXL05vo6Zt60io9-Qbd-R90iBjjnnvtJsf7fDe-oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2btk3kvhJZMThTcUnYiMav5zfdFDs_qv5A0flGaXSmrw&oe=69DB96C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzDb4_CyQdwQ7kNvwGu64GV&_nc_oc=AdpXX7nXRMM5uumY6rpJ6GOnU2o68iWehlcs1nWKP2cmHwxpKkooqbdVuoRfqxrDNz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b8lbxCEzZMc4b_AJ6Yzfn8KugGbyquOap_spqBR3aFQ&oe=69DB81A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
84268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Apa362UmPyEQ7kNvwFuSz6i&_nc_oc=Adq_GN8Mw2q7dwqCW_onGpV5Rs5SHbjAOoDBhh_SXb4cgnWpAxopSMqtbI2VWulDQl8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG00P297nLoqYjK2j6-ieUvw0Ucu9sa8gqrllNGr0xLZQ&oe=6A8ACB74"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVwEEYW8GDYQ7kNvwH_yNNe&_nc_oc=AdpN7YOGCBx9ZHnYIKNT5AhCvNlUA6SL3Kan8gB7B8eVzyjuYTM6Fsn2-HXylBeZDXo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjKOihAH3cgglPIkHrQfSLt9V9679lOc2eRKc-NUEPRw&oe=6A8AE8E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m91JZwx3-a8Q7kNvwHCi7SE&_nc_oc=Adrl89VWKy2lYIAdujW29vXw-XDl4Ny97MNONn2CJcgmSccIXhnjwOOhgSuTMqkLKro&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt7a4FLVPvk0yJ-2GvprUvM6eqogHEvLF30JPiVTGPdA&oe=6A8AC165"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayRZzCjOfjAQ7kNvwG0VJkm&_nc_oc=AdpernTENL6KxbQkSqhTVCUPg-rfvOLzunndgp7t52PnzVR_Zv1ZpFMMjoMorBCIX3U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg23-aANjAMyIvBvAm6RXmbdsK4KPB1kKpleP8Fy4l0w&oe=6A8AEE44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-gyQMWbt8EQ7kNvwHB-YzH&_nc_oc=AdqjM6Jg57-SXJH4R4b8qGFUyKjHsW0vvJrCwf3x-Bggv7ai0YRYfvPzO3LvsGZlPdI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdclBJtyZLbBhC_VN7ruo38BdakiqOPgt767Wo4jI80A&oe=6A8AD921"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
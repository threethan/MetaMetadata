84268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUZ3TqnDwz8Q7kNvwEfsbel&_nc_oc=AdqwKC2AuQ-TRwB3fxWYyR3becD2Tru_cBZoX3_bKn_5Czc6riBjGitRfVXOt4nTMIo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjOlZ0ac5XSXSs9kCl43vfYid8zgNRpWZhUVgrtzYN6g&oe=6AEC92B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Vv6NqU5ziYQ7kNvwGnOT2T&_nc_oc=Adp0Juh5-SKIoOO3Bz8o3Workt1tIjUeze2SzVlIJbuP7xaSdvMVfYF2tvOZMiySCpw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToZHoQhDZ4LVTw219ARFd5i30WLTLz2RfoXH1gVXdxYQ&oe=6AECB027"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWIoy0wdNfgQ7kNvwHgS5gu&_nc_oc=AdpZJlxaSCxQPIFGjfHRdlA8wbtNrqvCdfoeCHIaxPqi9t3S6u6kk4rUmUFagTh8u8s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZw6iafNZef42xd5ySxmAu0u1GNVurQceqE9TNldXuBA&oe=6AEC88A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogm91GNf4EEQ7kNvwHiiTLy&_nc_oc=AdoXBHn7yHxxUg292B194TEiSoi4hwBOWXH6eIHV3ehQY72RbFeK0bjU04bEb3XXz0g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkHfxcLR1E3VBvXTNAKAX-XXGW8TQ0OrnXL0xy6nsX1g&oe=6AECB584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwnnHBoiDhYQ7kNvwEXeiq2&_nc_oc=Adr54RbOL9rfnLSir1WV9lJMe4f69yH0smzA5AQlZgPKz69C0_--zObpNcXMlkfJALU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz-9UPRYjNYVRhh5yCvZ9eSOCamzNHge0p0t1gq3b_Jw&oe=6AECA061"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
Pkqrma_YtMBd9SzDz95pInn5wkhdvD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuryql4p_wKms4i3UJgC5PyqkbgCtv5Y9_9liVaUNJZgw&oe=69A44D34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVe6JbXEc0EQ7kNvwHWhxbZ&_nc_oc=AdmEBwCVpWkNm8WYXiman_60yO31GoIEUGNvyz7vpp78MtPMIuS8jVm3KFJrYjk5ZQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu9s8tIaDCobExcZ7ZPSSpg-HJg8PGLBCM9lYKP4_8jOA&oe=69A43267"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXDFoe8pFtgQ7kNvwHZwSv4&_nc_oc=AdnPk9lXx4I6znEQr2F_f9iFGDprGVIAWU5JVC4nSKC3q7KZcsvANdnxaQc3ny6qZwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftAB0mxlO0eGs72jKsKLK5p_DP_slu1r6TKoTRHpVEaBg&oe=69A44325"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV76l-_fqDMQ7kNvwGvCsxa&_nc_oc=Adnqt3M5I8sFVPQp8oMd1AtR-YFnJB7lt1F1QPfd1RO_Ls2GvFYI4xuOiQ2J3yBgLzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfugMjyBaJs-WbnBIIEZY28XO7hp-ZP_dz32nhdv20qyyg&oe=69A437C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUx48xaDq5kQ7kNvwFwufXU&_nc_oc=AdlQJujiVa7Z855IvIzKEeXgblZ93I_vq6KmwAviU5hIyJALJPVB73rSa8J-Er4PYYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft-2D386WN5HkBWpXmGtbJvV4vck46pSN9DKD3AvJANJA&oe=69A422A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
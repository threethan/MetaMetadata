84268", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3MF-mnXKEEQ7kNvwF8LVvP&_nc_oc=Adr_f7SrO70E0yiPWRt019aOkE3X2ydvZRp30fekdoB52RgxJJYlI1l2Q2foveg0Y94&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k73H4zUIpuqrgp9i-DQVv9IIO7pLhb-CUgAcCoSZhcg&oe=6A106834"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffyx9WgeNdYQ7kNvwGbsLDU&_nc_oc=AdpzioW3gRZe4W8UHJl4O3cEV40JCsrI4jH5bv5360T44F56f8GbqEOQhhfd0gQhAlE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ghO0gufT2a_xmCl14fQ8G7HCt-9N0YefXvMjwwNo3tQ&oe=6A104D67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np71SfUlASoQ7kNvwFVAVfp&_nc_oc=AdoFNloZx1P5mrPUzrT-Fw3-hg5HvX3o6Bk2XszhPDPg_sL6uMppzOLK36OlKRJLOPU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PieKfdeL_RYDREDGCr8_gPmxCYF0ltod5kYen5iIFBg&oe=6A105E25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkhhe7gNUHYQ7kNvwHsRddG&_nc_oc=AdoG5zacJAvWERINKRUFsqBsHf2U4dWCdT-10pldEd-xggGeLF-NujYx03YaQ3AVw2c&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yl70KF-MIQg4FIATSykp8PjnzIib8wtLQ2LKELeNHlg&oe=6A1052C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj49uHrjqBkQ7kNvwHtuwx-&_nc_oc=Adqjd-qN-IN7EcDM2i2snun0me-Th2Tc-J9cXfgk1KNme9ctH8Xef56KjDiOvBQRO0s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LkcB49hP4FPAQw72_r87F5pNzK5KDRmlBCx5ifwWsNQ&oe=6A1075E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN_3fLRlYF4Q7kNvwF-W2JW&_nc_oc=AdrcQRV3pUN9kv3-wWTQh7QtPIAUy50MRBDP2EE9h1wKvzFNJY3YY9ljY4U3VywooDY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DaLWadM3nrz5_MtoMDNZlVWFk-oq54TZTOasmnFWOsQ&oe=69E243B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irgSm3_2nMIQ7kNvwEXT8Tp&_nc_oc=AdpdNBLVyiRUIk5PmoMLcpViPlIz91pbHR9SMn8qCs8ebWjS6ryxKKXBopLbhZSdRE8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WIQkbs6tDSZOduMVL9nVE8hAgbu3oI8UJjcUebo9law&oe=69E228E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4vlC7LohWQQ7kNvwG7lT9F&_nc_oc=AdrZzYeMy6bz8hEdfNfx5ctb6nfHkSAzj2TjS9_pfXJzQQppd9Vq_1RK8e75dkRih1o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E8umPtwfd4fRM5JxCJrSTIvrh6Hw8BNZrCjZOoGojCg&oe=69E239A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chmqd_hji5sQ7kNvwGsAK7I&_nc_oc=AdoQHwbYQ_8F27SeupdcKtJ0w7b-e-oYQ-RHVTlHRaAMTZvHtD8D3a78De7b2YiQT64&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a0odqHUx1IAyKz8GFDcz46gIVKfQPEqhtWpkPa738EA&oe=69E22E44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3VcoohP4iQQ7kNvwEN9q4r&_nc_oc=Adrvtpl8XKKWDediPGdV9vt4gQZyq71zzZisyqOHexxLjA0rH6Hhj_HtpTSOrtJO_6M&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17Si07knS2C5jYq9N8Umf_mkFzud27sbj-JVmSqn4ebw&oe=69E25161"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
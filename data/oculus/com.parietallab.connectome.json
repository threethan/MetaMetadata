t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyUIL9RdX2EQ7kNvwFRjlAC&_nc_oc=AdoXzjkX_HqIZf1hHlqr7lppNduQX4qsrAQTQrFfS9UH48LcoRF5usNfU8AFLDtmnGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z-KmnKDW-jB-qUpLL39wqk5DHu4_BV6YaopV18By80A&oe=6A009634"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74TVlT4YkF0Q7kNvwE2W_LV&_nc_oc=AdpPZRdZq94ja-uvHPoqUdD3U1ReAYtbiYeuXXLPVX6uYj5tDrT0IclL1ZoD4ec90ZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LwoXnnd6Y_d11tPUXNFOeUs-LNKdxio_k5qprNsEU8g&oe=6A007B67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALuGBJm_s7YQ7kNvwEgjOZB&_nc_oc=AdpObYEMZ8Gf8t8Mr11zvxPeB-FIUucmy-1K5SHwKDb5rYYx3vogu0S7mbcX9tidWvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ls94BQAPO0akdcYZGwn1n223Sq-FDODr9V3Nb7mO1GQ&oe=6A008C25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V76ybNDRIcQ7kNvwFBJDmF&_nc_oc=Ado_BdF8QnmseXYU5YcbUoUXuT9CXC-6OQx1zrCY91QHFPUA5XZQNLOZOnWo2mnXzmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-nZaBeyhzJUeRGFvC8evvJKN2g3oVN7dUhUKMpQeP0A&oe=6A0080C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE56wb0TPekQ7kNvwEmRIv8&_nc_oc=Ado1hgkwZ86kPUGQOTH8a8b7B12NAATq9cdGu6mjSkLkWCsBCK4rdT_IJb48ZAD4QZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42g2KO1K6OqSz3KEUQbfP31FxucDYJLegDKZLz6gXY8Q&oe=6A00A3E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
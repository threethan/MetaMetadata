84268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYRT5kE8sIwQ7kNvwGv5GtC&_nc_oc=Adp9F4OhyLwfLIGONRnwxUFSMOyp0szsmXW6JPfmXTArdvEUZHSjg--F2oANPc0olQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzs5NfDfs-StcteqshA_zYbxJjwuspxU3hUcUO1T6u1Q&oe=6A773D34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avZrKVMSlFsQ7kNvwHGi0KO&_nc_oc=AdpQEDre2L7UhHuAct94x8IKEovQdZ3PV8l-rQBWhp21L9VlWVeqIwUENAbfArpEmIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7U2E54vk0fdg8TChQzru_hbTG-weXpHr-EKpRqRC4XA&oe=6A772267"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxJXWZB6LLAQ7kNvwHIVuYe&_nc_oc=AdocRUUrs30inxbFtKJrAV7Dr8401xEWWs2SDe60qBLngCiQDYDz4gUhyWYZ4YkImQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbbgm0F39MnCWIyZwTn7fWqY6yI5KH5pnic50B_Xas8Q&oe=6A773325"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH2vPMW2RTAQ7kNvwGr38Bh&_nc_oc=Adpb0MSHBLPy9hIbjql6PJitY2CSrZSeJlX6GxQXAB8DcTY_igcLGSoMuCjPYGgPr6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd_RTN4x15hI-doyrR20v4R9iTuJkXEmCDT_v-eItueg&oe=6A7727C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBNtfHCm7YwQ7kNvwEJop1r&_nc_oc=AdrUYcReLZ2BXA4Btx3Z1RM4IacKCSQ8p1_Kn1TFjv__ZBmmk46vSyCEngn7lpU5OoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED3zHAy1xmdsXHpUcz3YhQFXulE4ia1R2RkqotMLzZ-g&oe=6A7712A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
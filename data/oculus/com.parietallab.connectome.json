et0BsiD2aDeZvIWuKY9x5D5zT2fOGAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2yfZURbpuMxr9ui06YNmPjk5rw_KnkmTF_b369EQZHmQ&oe=69F0C434"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABBiFukFa7gQ7kNvwEggigU&_nc_oc=AdrvpQxZevNEOh17kOljWfxet_03U_zpVu5DC-kaSvWHxCoHDBMLtlQ0xgj5IXTPmYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1HGUWYFyPbt6G6lP48T4K52ujzJFpsn5yUULIPXB_50w&oe=69F0A967"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S1sXNzws0QQ7kNvwF-eFiO&_nc_oc=AdqojABNQznaxTl5Fg40gT7zBlaiMRt6cQOqt-B1FXPJPAtn3gXELJFotX62vPec84c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3l7RLoXFTme1QwygePWvzEP3WUMhT_DLQLD_4PJ75lpA&oe=69F0BA25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtL7jZKRD5AQ7kNvwGPXijF&_nc_oc=AdrAsSdMHYQz1nPNRfKNvEVA0prT0iUetQ-CjN4ctLn9Hk1-gZnQgaapWjO7wJrKtsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af28o1FvOe6ZtSwy6TlEVk4l9glbPZrBrVH_wx9bbkQlTQ&oe=69F0AEC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFzluLqdBAMQ7kNvwGD7lIB&_nc_oc=AdoZrucqmarR2Zl5O0OhknPS2NMpyn6ubwe8bir7yNQbdfs-5lAd2HCnGAFRms-hPss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3QRE6n9MFkt-qibPbmU9kaByJLtk2LCJYgB2ZAAck-Jg&oe=69F0D1E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
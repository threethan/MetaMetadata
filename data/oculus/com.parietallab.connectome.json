t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeiG0EAU3IwQ7kNvwFwXTjX&_nc_oc=AdrhrpJdPk2umVdBbMULrWjQ1jXEhNMQPlzzX9o14U1j0H8820w3Wft6w7p-QvanArY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fFQcjpAJU1rTT28aY8RrRwb0-vLBkzuxi7F81cbeZYA&oe=69E789B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NKhAjWJwroQ7kNvwEbxRrZ&_nc_oc=AdplhD7XTTAjKNgbQi_AyQTHgUaKQW0GgxZTEiwMa0dZYw2wnlhAxM50YIZ2liRRjm8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q-5-7BI7L4MH-WQS6pegckGV0bKMXWQlNOH8qChzzhw&oe=69E76EE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-QTJIeKrAgQ7kNvwHOZbXu&_nc_oc=AdpVfi9zIP63ty3KGgTKUtJIRbbbomA3LEQat70n_OB0qtGwuIMBSkqO-F88i3oter4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_k3DIpxrhkcd_Vb_SuFUmQ8Za3-qvEGZ8aQPsTwgBcw&oe=69E77FA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ehz3HVQIP_QQ7kNvwEWYGeb&_nc_oc=AdokNlC4bBflkRTzpeOGDzredI9lowlj0FVC4blAT_GuwX0nZ5gtD1EGXHZJCyx4NHM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HBIpqZ6UFaBGg7UFiVk-nORsMvyc2ktnw_swnWPecWA&oe=69E77444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dCi5sqnTEgQ7kNvwH_NqQe&_nc_oc=Adr0PnuwEwH27uBN3uT7Kqh0BSTwAJep941ocY2eFEFqqim5xBOjNllK_YZpjnW3WBc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2507YByNfYnaRljoDNP6mnPjUJMZ4mU6E8hjqpjKUC5w&oe=69E75F21"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJD57XA5yIYQ7kNvwEobSha&_nc_oc=AdpmzsQKNq8SNqkInNrqT88Xs7QFtAUwhuAcnnV6Hgche8U0p1RIiwPzzg_WoGZtywQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ov9zvVAyJSPChhkGMi5Y5GWsjb4mA3kvFtLPJ9Ukukw&oe=69DE4F34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngJXBNal7D4Q7kNvwH36t1B&_nc_oc=AdpkdsssicNpxYEk7mvJAE2c3Sh_kpx6MgOaGTkCnVKgtGXU-rZYjA9xUl0c4JvsvIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LIjazuDsoB21rsRRqzDOXdKjUWZeCULrym1cOc8KJjA&oe=69DE3467"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrLBMuw0Gl8Q7kNvwFX4UX-&_nc_oc=AdqXPCU4xidlfWA4NHI_Uv1wxOHxgGoiG-jNokEQ2TczRvpS-fdZTIow1fTwKEgLiK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HxmdwenrKVOc4Dwm8qXKgXwOGcRI8bNU4lmOfO69l2g&oe=69DE4525"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaEN5OJKkkEQ7kNvwFsruVS&_nc_oc=AdqCg5lvD_okb6F4eEuu-QPSVTpP7193MFaF7jKvPs2tAxjN7QFVwj5ozzFTB3_x-tk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yI3UzYXKAmzsHNu86H1VcF8QBSqsOkC_phH-KmPJI9g&oe=69DE39C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcKK1cFMjQwQ7kNvwHpNxYi&_nc_oc=AdpxzqmfUaeVJ0AM9fw4XjCsFl0O0zKm931AFVIPqgQtWLaHFakvfJU9ocB-5zfvngQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ffy3Zuww2ommeNOkpSFxGvsuSUPBxV16HZiMZYkjTpA&oe=69DE24A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
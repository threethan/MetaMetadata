_X2TtGCTTPrLDpxg_eoketySmJA1oOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftU6wWjMzoOWLHap6rNCNwf5FJFiO0SeAz6yU6JCCNklQ&oe=699B12B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3doZLTHQTs4Q7kNvwFzOjNn&_nc_oc=Adn99775agpgveYst_s8QXkkWiLHoxzcVPCDEc00CBK7ei4rYsbrI2tHntdt1O9QS9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs0tVsKB9c2s_ak99AAdO686TfynW7xS32ZjJMfJWxASQ&oe=699AF7E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJyr1nXgvEIQ7kNvwEAztF_&_nc_oc=AdnHsNo0G1wEOhI5y6ed2fciEGfSrGHAEuneCkDIpW5KDHcFM-_CzAXGgvWNj7Y7GgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsIUTvy_djtcTQkYVUP_4wnMvRVMgj0Kkc-Mb0ObN6-Xg&oe=699B08A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-euSZHTcicQ7kNvwF1nPpk&_nc_oc=AdkQje_ljsA2LZaUDw8fXLe2fGs_X3DPSKHPvWaPAUMYYLgt4VUqFsNiq9ivlUjI9co&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftllrDd4CYOpsnZdBngP7UKjNYiYYClV0ANGbrMPlTz8A&oe=699AFD44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8qrI_qp528Q7kNvwEUtiCp&_nc_oc=AdlkNXyxH5-TONU0zQYSg0DpeIC0_JB7_6CGeD3Uf8358r19q59zgVd0O_7Oi8PXYrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftvBpicrpmPF7lTCqEbhkBjBCXM8HH2_-MHl0xAvg6Yfw&oe=699AE821"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
0a&_nc_ohc=2cdvGKK1j4gQ7kNvwE5_DsD&_nc_oc=Admlp4KkMxsUqSNUy7E7SCpGN1LtG-iKYtcAGlHWqq5---lW6Rxmu-RO9sY9hhZqQog&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8ZLUKuRpfdjdwV8q3EszDBd3ear3ncY7V7T34objUyA&oe=69AAE4B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xq9siXgmpwYQ7kNvwHq2uSP&_nc_oc=Adm6QV9oSTVqC11HPQDHyxfZ42caX0AdjR7c5PA05kM3AU4BFA3yDNcwpJ8-hA0r2UI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCbTsPLc5Ds8TDgQzEnMNF6t-JGUhlD9AbzNPW4jsTrg&oe=69AAC9E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hurgyncZfloQ7kNvwE86gov&_nc_oc=Adk4SHucO5p8bXsxqjwR78blLD2qe3t8QZWt8qqdMu8vtIfw2WxHYls8er4bOgQSVTA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzA8GdJ8cGgiEu81SpjdSIVChnSugzbbH_vGZ2Ki0fjEw&oe=69AADAA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiwSaFNuCG4Q7kNvwFGXnyE&_nc_oc=AdmLgNgWkABXDBQCSogTleE09f_aHduO8ZxQnuZ0EYjSz_u-KvYt0AIpBf_RYyJzWVE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyuupNLQVbcXvML5-Y34nYcgLCkcrocqyWO844kT3gVdA&oe=69AACF44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqPknaYV7LsQ7kNvwEM4UCT&_nc_oc=AdkfgrJMAA-m3M9B1g3h-DMEPcDKad5WrU4vg7majpG6jP-b1PiqcVp7L2wC84zgOxU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwMCD3tpzgMl8yYaAfsEnnu74_12uTJS49Vv433__i9nQ&oe=69AABA21"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.
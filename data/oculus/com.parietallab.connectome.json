t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DLdpsaMSnsQ7kNvwFnx6m5&_nc_oc=AdrotsQyVboUcMaCYsfKaraZiN37CKa-J7zCe5U6NjKvLOQUFEZuCATro_HPRG9UMLc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lRxs6Cb5_yY_ni7no_qzVqS6Vf1kMmYs-WLPSsIUvZQ&oe=69D90934"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl_2C7K9BsMQ7kNvwGqAKCK&_nc_oc=AdqEPONpdxayohlENjemW3WmHlhaWBTFWATpw53IJqtWFjpEnCEcNRFUzU1qZ-X46P4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q1c86FMHKtQe390Npbof_5YZGaRLo_tm6OqG5A5iGXA&oe=69D8EE67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxiIckL2Mc0Q7kNvwF4jynq&_nc_oc=Adp51F-M8QHS6Kwi3_hoXoQymeBTN8sZrtvlf26RptGtLd4xOXR2vG-zPV8pQYBfBMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3e8dFFreA4Mzf9SDmltdwhbjBEN2MJ07TJbpBDPkNR5g&oe=69D8FF25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdF8tVTIRi0Q7kNvwGm7ChU&_nc_oc=AdqC2bBmLf0i-2Ge0LOwG4XvMkCM4gRCmVXnGSzs5U4DqjKFKTQ6ZLHYHmAR5g_bygo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30cF4nmB2m6wSyp9LiK3xQDOhZgjFdzPr_H4ohawzREw&oe=69D8F3C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIVnjQME360Q7kNvwFKCsCQ&_nc_oc=AdoSXqWrkn1NRcuwSGY90oH82-_FFcCZKudqfjeKnarCy4s5oCkZY1DLoWdmWwrdD80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hI-Me-Gu8vM9elTK28lsYriSecGC-aMfbERDq8XDlGA&oe=69D8DEA1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
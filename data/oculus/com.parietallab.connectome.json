t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeiG0EAU3IwQ7kNvwHHeqbD&_nc_oc=Adqe0P8Wo2z8XIn0YOQj6yzIBjWeyJf6KdxLYv49CueCkkWajCaGCuiAdT0dj16yrGI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af310fqP9YjzTFVzJ5HJa6mBCvAlk2BeoRDVJCqToTPR3w&oe=69E63834"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NKhAjWJwroQ7kNvwGoKQWc&_nc_oc=Adq_V77mB-Owr0xsimDk2CQmF629jbjJeXkQdDag9OpDZfVnNQFLUW_qQjd7WO4N-E4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11fH4ojyY5kK-FdsFLnNLTIB_i0PUhd6kT7LyrNqVbOw&oe=69E61D67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j99ldCkPJLwQ7kNvwGp9d8O&_nc_oc=AdqNR8x9QqfCKrEtJbhmMu3Hu8bK75vmnd5tyQd4uioeoHl1tsmP6klknWfTGd1T3dk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ohO1vcPPcooAAFEJJPt0WPh-ElUpjV53AJzAd2PoNLw&oe=69E62E25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ehz3HVQIP_QQ7kNvwEoO36-&_nc_oc=AdqHxAqqJICiI4iaOT-Unj9OoMN4oLipfHE6bzYD2LBIbDfextnF9PJuXT2h8F7hLW8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hIZi71DGY4QgEf9vrFKuZYzgJGciAf1lUiGgEuLAO0Q&oe=69E622C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dCi5sqnTEgQ7kNvwE4iNBp&_nc_oc=Adp5S183wsxqhqV5VYwf6AZ5D0Tt6-hc1GAILJkOmy8K-Pak9mjsu-_8MbUy_HjE-B4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03d1bj7qCmiYB9wnSMJ2HMCoK_tw4TmhnH3ZSLwbJuTQ&oe=69E645E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
84268", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyrQ-nMhD7cQ7kNvwGGye7F&_nc_oc=AdoRElN7IfRbZ8uCsaq6pW3T-Dgi1H7ByQVZoyWvgvRMvQOTHiutYm9oW3fxmTAZSho&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrnSN3sW8d-V5osW3I4JblkgDnp9rMJKSUSQcORD2FkA&oe=6A9405F4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2zw-CIx-ecQ7kNvwFhoouS&_nc_oc=AdqWaPDM7xZ9x9m3FHa9oU8BH4g1UD0gY6nWMZLHio9liTrAB6phKcsr0k8-Jz64NS0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHEeu46pWdJI8als7V6JY3Mca-zpwd_33incgD_uqnxQ&oe=6A942367"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=virlrzPAMqwQ7kNvwE1LYSY&_nc_oc=AdoBNkJ7MFkvEjQ7jb9gwLqrkTgcZIcAB96oSKY1_JVSkY2MR1lRgTo76MkLQkdi9-Y&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJK-PKq0H1_LmJ_rqExBHcvngq2xTcHLJy_26tXR2N9Q&oe=6A93FBE5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLTjTGnDe6cQ7kNvwGUzdkz&_nc_oc=AdrFadeS_kP8I7ffrgKWEvdLGDYhfZF4UOLkf-8CShgGIhz0f4bA4-8KAKkrp8VACDM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIrW8d1z1NDFsmdc6TpPhSCvcDNsUfIhTJ51-Zkg7sVA&oe=6A9428C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSQM-XRZF_0Q7kNvwECBRQX&_nc_oc=AdrBmSIkegpV2VHWqx2bSyX345JJVAkGkEp6Z2t6bAGwXWg-w9XnEBBe0mUavX8j-sU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcySNi9U456T6tF9_x6CrKLIRbAtYUN4le_PzQtW-Q4A&oe=6A9413A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-IRz8VLySsQ7kNvwHtlRI3&_nc_oc=Adoxmxess1cLJgoPdJCPKJqq8Uk6XHqrHzajQY2uEqUxmU0cF8tEOPpCwufCXugQFqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xaqnAaJ6SKJELB7MdKnPDHXffycORiFnyB6Y6289wPw&oe=69D271B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gk6r8xkUZ_cQ7kNvwGhH7IJ&_nc_oc=Adr4UrZ6mCVOKW3zySQeiGBReo_VQ2GbIr2SGjo6wGaDB3zpAQSxwZKwMIHYUzQMFkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ryvUZRJVEmYT5jmkgMhh5gp41BU7rc93Yn3U-lHcjWA&oe=69D256E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws3CAI_wOSMQ7kNvwF_H6tu&_nc_oc=AdovjCXo6CQ991s3atPSMdrdgBVBkKisdCbHj-_xmuxKlwedj-3S2883pQd1Q8Esw8U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NLxmIMTyDJr847RBPZ3KZCWMDJIVkPYisIjPeKfHy5g&oe=69D267A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yRQnMTCZG4Q7kNvwGuMOmi&_nc_oc=AdpEvwxsbZLXz1EN72s9AEiE27oH5y85DXaU9caYoeMAunScjqaZeN9ACINSnGvl6To&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21TbjRKZTASAfGFlfNMawPf3vleJgi1nsodRyhudM2Xw&oe=69D25C44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kcZQD_gBH0Q7kNvwEQgoVr&_nc_oc=Adqsh32ok62pm2Lo3Q9tFRwbscsgB2Bqx5EPJ-3RU7jafr6KU7-PsAHkwxD8FoA3XB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CYzanttWf6TpWZK_mYDmByIF9jONsN-2Nl40Eq8DBOA&oe=69D27F61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
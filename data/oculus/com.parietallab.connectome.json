t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ngw6sFS5AcQ7kNvwH2rE4K&_nc_oc=AdrQyEQUbGX12axiPllWvzWzh_7EeIhdOgv8zFfrrmsEIyHTm8vP7LyaH0E1bfoSzbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af724lhz9NuZhQLD2b0scLNGyxSnc0crBq7_a4euAx0HWw&oe=69FF44B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fml9lrm7QgYQ7kNvwFi2caC&_nc_oc=Adp0ZKZxRaKy5QZDHfTfJS4YmP8Fv7I01zujtjcjbP0VqG6OqbDaRwOgA3HZlJ-Ropo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yJQEWUgFCb-dkxqYsP2kniXj9YhtS_jd9WG013CgziA&oe=69FF29E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALuGBJm_s7YQ7kNvwFbAEk-&_nc_oc=Adq6_VVkoyrpZh4059BuIGRSN1J0pZGdsEBi-oxbCas6mo6duJwXxlUhXaGElrFpHYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dAr3F1cFOctByXSE_pxgBcg80yBF42iz-jfWOJI7XUg&oe=69FF3AA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V76ybNDRIcQ7kNvwHhcBd0&_nc_oc=AdrGuDRjvRCAJzPgvsSELnte3hjloyzXAhTMKj48MyquFkuJCqN40udldQmIT58llHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t2OhxqUpVCInI74lj1_wqLWXrm19o5rUPK7wyd4RN6w&oe=69FF2F44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE56wb0TPekQ7kNvwEAr42t&_nc_oc=Ado5iGP_xGeu1Iy8Lc_x-KIhErz8SZcjVr3h_OgNFnqHzQS4ytXrZ5cpnAuv8NBXkHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75Bvzh8dyd86vXA2f47WnHstVA_y9EITVe5qAnTPRrAw&oe=69FF5261"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
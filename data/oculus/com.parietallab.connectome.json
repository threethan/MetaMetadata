t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN_3fLRlYF4Q7kNvwH6PQXV&_nc_oc=Adr-6JM5c3yKvpg2L7gIJ71a7LbzkelS9dhI9F1uIDzqbTcKMDqxT8Kz36OQR_soV7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xfg9oa0DQ2nsAlgBBSzYEFqe-zj3kL32iX2h2SI9Txw&oe=69E39534"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irgSm3_2nMIQ7kNvwHM7wLy&_nc_oc=AdqLP7b9RaG8U6Lra354M-BmM5Dek8MfkWfMcgnr_7-uFFRhKiZ1IHykScX_f5n2cdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-lEc8GikCXdjchiC8f00lrt8d2A-LekFp5YfkR24nKg&oe=69E37A67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j99ldCkPJLwQ7kNvwH-_4mt&_nc_oc=AdoEFOBTB45ORSvTvN2GTbofhNzkn0Nz-ADIMcJv56y_y5S_ZrmgKdOwQHYFtaGO1CE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oTW0j5JWOzOLawI_pPWnyVtnqDUb_-Yv8zhbOL7vndg&oe=69E38B25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chmqd_hji5sQ7kNvwG_-1_R&_nc_oc=AdplwNX7jkXtJ09GQEs8O6C3bfZl0t9vH-KaRydxaRYs4g-RoXp0oCPBV3ABarxibDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ILq03gDMRR68OIMZlZUn7am4LWRoL9ahvafJuOxX4gA&oe=69E37FC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3VcoohP4iQQ7kNvwFYIS2n&_nc_oc=AdoQksHZ6b5L12FX_hqxXA7RKCgzEs8-ywNAosIIDI3LqYrByUjO1Tp9jqZxF6sx5D8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FyDARO_BO63F9YYRq8W0TVpxhdB1A8Fy3Xa2ckYUqpQ&oe=69E36AA1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
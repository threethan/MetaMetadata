84268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ3OIPHhkAQQ7kNvwGsatEY&_nc_oc=AdqDK56jodp40VKCys8rW_CXVsR2LhVeiVx9LDqnI-Cyh2uaBBTWEpy-JVrdwhBcdGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_ZDvjeb4EyVTcMXp37nQlUdpKm9PCZNBwT0jsuChk8w&oe=6AAFEDB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6ahY8UmJx8Q7kNvwEc59MC&_nc_oc=AdrP-w32pXnwn23rPU74xMzEzC8WM3TYGShRvCZyOp_NP8C5QU_JNc7ZJcZAe0qJ4YQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeeM5wHpdJGPZFcDjn7IHYhEL6aPcGJZ91-PIRckD9xw&oe=6AAFD2E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQnFiPDP8X8Q7kNvwEAN0lP&_nc_oc=AdpRPXHu2uFCY8KkUJ2z63lrWF44oPUWgp4CtIDEzhqiiC0Y5e1CMFWRmCD7J7RL5Os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiuUK7aRFhsU-wwIBtvVok_O0lpUfUDAuOK5hkdIDg0w&oe=6AAFE3A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbbdvp8SV90Q7kNvwHfltqi&_nc_oc=AdqWLZzX_zOB5o5iyY3l_KSFF9rmoFCIWK_PScMv8wdlUvscZbmEzTHTy65OPD_CxnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF_WODS5L37kmMImGTaLnyDIB09al9UXTza41x64EkmQ&oe=6AAFD844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYIBYBOiAYIQ7kNvwFpELc4&_nc_oc=Adpg28tgNeVZd3LKt1N769gYmwhjTniHp1hWNuUb9sVi_ZX09l3SLpa_JTE8quACIlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBj67w_nO_uj9B7BFRkWdA-R9jDiQ97yAz_MdcgJL8Aw&oe=6AAFFB61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33288133284165472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_891730399976926_2927939352608887063_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQTFqNlYeXQQ7kNvwHNp9jP&_nc_oc=Adql9Ro7d-tJC23nsVCfFKLa2vzP-mroQEhwTomAkR3zrz0BhQgBwKDx2Ts1zKvsPfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeYfvH-RwRpygZ6zBRfNWYG8lTyBKqOweYcRj5jitf1g&oe=6AAFF11E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CONNECTOME", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1748367660, "lastRevision": {"nodes": [{"id": "25707920678853475", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25707920632186813", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "934148758813776"}, "iarc_email": n
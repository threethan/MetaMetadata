84268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdQ9HRQorhUQ7kNvwE58vS1&_nc_oc=AdqapRYdoQlSSqB9ZXPtn6RhwPgNzh93pIWVZJV4EZ76X4ziC554K2DRKO1Q7l0OEaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7GWqdd0v0zSmgsnDnagx75AinD0O8SPEULqI95w0QOw&oe=6A9C2734"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE9VFO7NZ3gQ7kNvwHzeu6_&_nc_oc=AdrRWhmzoeuD6-Tf2j54JXjwRDz1xHfI-BODHKcFoNEKJYctMTOq3m7Yzo9OWkSouFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdm91P40dUcwF_ylld7IY7VI6nIQY7NPBIJC8tUZo1rQ&oe=6A9C0C67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyvqqsGF-BkQ7kNvwE2IXHV&_nc_oc=AdpzlqV-LUlNhsMRrR4MKm4wUxq1ftAVqfBVPRnSMNKNxhlI5ufxj5dBVd5TzrIUrx8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3GtXvpib9k027nILxHHymni1ac3W_0e7zzjntvwSPNw&oe=6A9C1D25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLPTdHVsesEQ7kNvwH4fZID&_nc_oc=AdqHhWOW1SepVt0DFlUgIi4hbeXwy6Svb2bmVp60V1hmiTEmwbWfzWo-IrtDcBGUcE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPfHHAF8omBudkyqAVZUorJgQPw02szJqkBzW6bLi3Jw&oe=6A9C11C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVpc-42_or8Q7kNvwFfxJDM&_nc_oc=AdrvcU2vgK0EjgyWCDd3OADNs0MAGENdJ8rcmOUw3yyUjuuH0XPAGGAXxbbptQ06IGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhxtyMxRXJMuPvOvvcYJ2HlDP4DKWo-ZhBf1ZQI7e6RA&oe=6A9C34E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
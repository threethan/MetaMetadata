84268", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zhWVrbV9HsQ7kNvwFwkgns&_nc_oc=Adr0JCSZ7v7l2jOtmBh6ARgvlbONAdUPY9QvLJZVXRP92zDVKGd8hb6iCoLeW7XzGtA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yO9xOOVwgBggfqdbQes3IlfVv-Jg5KKaXa0iTUzSwvA&oe=6A09D0B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyyeefqPXLQQ7kNvwFFy61_&_nc_oc=Adr3qp4-d_nOwYKICuqZPqhbXmJGk388wGlYkfgzTArq9GUX6n-oHvk6eRQNOFzA0Ag&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tkMRy7d2xtcUZPaiXJNRnlOK9d0Eh2sgpLP7xH-tAQQ&oe=6A09B5E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kvfwhusk4AQ7kNvwH_Kfhx&_nc_oc=AdrW4_MT05je5pxOt6FOggFnausp-Vhkc_a7GpfDopbZSZdye71WLFUW8Tpc3RE8igw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eZKTAoq161qR999TZ06CY3YfKj8v9LfaWQJtAfuSHrQ&oe=6A09C6A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ueUUWy3_yYQ7kNvwEU-8zx&_nc_oc=AdrFPm6D8ht00TRAh6aDgyLrGtJLKE5zy-Dc6Vk_dfhFSgxOtuwtbvEgVO1fSNapS04&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R32bbn_2yOc2JlQVXihgZAmxzYE3zx_jhZGkI0-1dqg&oe=6A09BB44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMvLH1SAAIUQ7kNvwHFK9lV&_nc_oc=AdrPGtbelWo0MhiLdxGcdBLTN8r7PHh-IZU3BVAK5WQUsa5mSMN5k7sE2Z5pLJNKWWk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ou8cp8luL4Hr8aZfb4jcg7PDyWqGPSaauAwLCPFNhTw&oe=6A09DE61"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-IRz8VLySsQ7kNvwE-cQvC&_nc_oc=Ado3wBCGwrAvLqBE6IsgJce0m23-m8atz_u-ykP7BZP3cOSpMqyvQiQJJtfen8vyc4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0znW-XUclLzGxYTNLiAbPG4DoZ-mA14im4q9olElT63A&oe=69D3C334"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gk6r8xkUZ_cQ7kNvwHpM_xn&_nc_oc=AdqNf8YwkTesji3hsTBxA4bW6JILetVS7ogW7fvEBjdv0EhMRCk7-tFKA_oSvQnSfaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EavSgshc7Mt10lXyMSpnF2d75sw1KiNPQk_wJwCqKuw&oe=69D3A867"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP0Dw3XTkg4Q7kNvwF9j2tq&_nc_oc=AdqJsNazFha-9dIrseHRasOqIaVs2fm_-Ia5eHmCvFwFtG0c1YrhW0IoFBmb_AGRByg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W1x-zxZ3clZbuk7XpDr6Tggk52QSiweZt1K_EFaBnLQ&oe=69D3B925"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yRQnMTCZG4Q7kNvwEeW7VN&_nc_oc=Adr_7XYj_4fwzo3BTF-oeBpinQXDJUh4a6S-bDlqsOKb813aZObW66PhIUpFbJcWDnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tsEQo2aaZHVLxR_e_nTDn2suZ4DVKtskox_JAjsjAVA&oe=69D3ADC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kcZQD_gBH0Q7kNvwGnUBbR&_nc_oc=AdoAi4mp7OTXOJrMw5dg9eRN-lDNdHrgemvtMRSxWBsJta-PEHAoDRZHO2SmN0vwp2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pIidxzvED4BylxSwg3TORxL3scsvp9TjgVKpDdV9Cvg&oe=69D398A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
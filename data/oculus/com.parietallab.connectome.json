84268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDQJ0BX6sp0Q7kNvwFNE3pY&_nc_oc=AdoeFkNS_IWzjzA7QQ2d-b4o9qBROY6trFA7JHnXOy7tZ7r5OT-rEn1eecvddCQNmh0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BW6NXEfGhZRuF1bkCY9VHjeNXIhmJQvx9hd0ndTaFgg&oe=6A0F16B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zk7kktAmL5wQ7kNvwHAUw5s&_nc_oc=AdqWyN5ON0vJJkkGSZdP-HeBQ1Q1jnr6v5BUcMjNGfDth2qxfLF4hK_h2fFFIGGBv54&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5slUVgXWG7Odka-NQwcoE00gItS0Yw-rSEs2QcjOKQIw&oe=6A0EFBE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np71SfUlASoQ7kNvwHGDdnI&_nc_oc=AdoR-xp7y1p0VIq61ghaxLS7B4u1e6ZBV_E1GrEWutN2oUKGCC1veYs2Jf0r8N_8PfE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uUNFZW0GfWusTooSEsW5qq-QlzFl_EpRWSgSgCjHtkA&oe=6A0F0CA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkhhe7gNUHYQ7kNvwEIQQJe&_nc_oc=AdpAb2oX24_iUyjm0m1hDv3osajlIYCEJVlu1qftcxddLTdHlIVL4qZAQybjy027gt0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ET3DYKhj3C0ZjqytwEefr-bUi0So1UZ77HpuUhdW2Lw&oe=6A0F0144"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj49uHrjqBkQ7kNvwHsTY5y&_nc_oc=Adqwsb1LSaPaXbgHqdk-M-ikudpVWOkXdq905R4po8xx4Wj-r571nJQLxBvvk4-ss6k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fGmcX1li6tr-dJkUaS850AP1AJ5BwBRG2Q4WLMEUhWQ&oe=6A0F2461"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
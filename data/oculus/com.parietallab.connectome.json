84268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ3OIPHhkAQQ7kNvwGw9_-i&_nc_oc=Adqr1mGWNicf6opvmp2s-jZA2_QukVPmPJvgXOCNPaiD7BQQbiTxMEUOGURBLCYR7lg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI64qQgeRXbPEINr_v42uRnVy7uo9jZCRmkj8UNfnyFmQ&oe=6AB13F34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6ahY8UmJx8Q7kNvwFZNtST&_nc_oc=AdroxgzbcSx-BHOwelYKCIFFnep-gn8uEDJlsW9hKkstwUEVqLWtZyLduSiKhWmISj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWGg1VVx6_qqR4NXa-hEfugikvk5sORHCrIQJURRO6Mw&oe=6AB12467"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SF1Ua6HuTd4Q7kNvwHzq6hP&_nc_oc=AdpaZf6zsuRJyoHY2UuxHOuqFHbgtU4DB4k1ezMbSdE54lYPveOHjC1gKTqNJHqJyU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsQLpjg-P4WnRrZluTOMB1T6dCYcdNLcT9abLs8IBBGA&oe=6AB13525"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbbdvp8SV90Q7kNvwGSxe9Z&_nc_oc=AdrQQ9HQbLYbqMDvLIcAVKN8fv2cLUxnnWZ2V4lQsKqQuuphVXK0iTHMOVe4efXB-MM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXGPh1dP2tkg0fJeCbDPT6vzBnI8NRcMeJRka9b0oUgw&oe=6AB129C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYIBYBOiAYIQ7kNvwEMF4J9&_nc_oc=AdponVSGGeoeQ_oAcNc67qgJgxXRXWtmLHtidhVsNQyr9jY0jeOCmsSh2PRcE8PUdxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlJ-v2R_xKHqSjz3pVhUtgnf0GecKXumlSBguIiOeZ5Q&oe=6AB14CE1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
NvEshM90Thk4Axhuno3dfZCrzAAOzoQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsoMkNoe91lxn_jyyzy7f0iPP1K1fQKS6vXkt0zLDgXWA&oe=69A1AA34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVe6JbXEc0EQ7kNvwFb5Poq&_nc_oc=AdkipYDkIbimRE_4_EPmk2kiiQcj8RroFvOGSGFD5DMbJmP28-b-dr2HUTXPaQVdqGA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsGsHqVyWAwKWC2UiQbjHpvEsXLCNUbmoJs2jnpZkwmdw&oe=69A18F67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc_v1j09dPIQ7kNvwERnyGU&_nc_oc=Adlt1Kq_aG-ia9NvigahC7MyzrERnA6PRkIpp4CDD11s-YxeooiLGNFxdiHwQ2iu-HY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftH3lwquSezo8S85yl-Hykiyead3NRuLVP_iYMZ8R_E5g&oe=69A1A025"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1fQDc2MdScQ7kNvwHGNzHq&_nc_oc=AdmLx2iCO243jmpdpnj9LKF8UlSuXaa0lINHWh59V3lKFqxlitowWGKmqPVxTSFQC0o&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu9131bPvFrfkys3gUf32Ndwt7TkJ5_CyNupwKJNrFerw&oe=69A194C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaxKkHF9F4gQ7kNvwEYVtMd&_nc_oc=AdmJ4QVl03gWug58jyy33nRhC0W2rDYxipsQvsAZv2TweqJozkQQXia9maXEdrBFz5c&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuEw4hR1EEwPCMj6G5Djsx2aHyV4pA6O0CIGKgcyZ-s6g&oe=69A17FA1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
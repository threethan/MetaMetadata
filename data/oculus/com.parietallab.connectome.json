t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyUIL9RdX2EQ7kNvwHOpbKI&_nc_oc=AdqDlnGmuVelFPv0TmsTG--Pq8M4DtZroxMwN5h_Nzt9bahrPqGhEQ48Yi9mbbdl1So&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v4qaZrVA8NuA_GgRdq0NJsUmeqO3uMjdBlcg2GBfK4A&oe=6A033934"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74TVlT4YkF0Q7kNvwGqbbQv&_nc_oc=AdqB6EWfZhaqaowITCmlD4MsoW4afPbAkQRhaWsK2SB3KAHcn-tt6uNm9tl3af9PSCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pIFHLB2izmRtpNzdzylrNHI4EkE9iu5zcl6Xc0E1hIg&oe=6A031E67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXnIM2MgU44Q7kNvwFVUkoq&_nc_oc=Adq3pByLEFsxzNNU0053wRIZ64DVAYLLJDH209rJhvuhQ57Avv7Kc92-ZMTMBCNN5XM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A91S8qvlHcxjfo7si3M7lqWxfiBu4FrhBpV2H2ubttg&oe=6A032F25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDGvk4B54CoQ7kNvwGPJpB2&_nc_oc=AdoGCUNkCIglEUlz_nr2vZ5RrIYU0WjXzh3XdIulOcn67M6iMwc_WsrXyy56KJlyw_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kmH8zT9YBwUvsw8H686wKTIVNP27wadDWrz3BJUGcdw&oe=6A0323C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMCcwHu73RMQ7kNvwF_anBB&_nc_oc=Adom0uYtXJkZO4cFacrkSH9pnVMgHGSksp32SagU8tbMfJRyRIu8h_SoRJmTbgJYges&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YkvXqb3tzbxCIoWsqmzenAozbKLSEXNaJPByC66Lbyg&oe=6A0346E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
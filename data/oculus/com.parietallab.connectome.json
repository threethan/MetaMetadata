-3.oculuscdn.com/v/t64.5771-25/75348036_547445274926381_7448331770935991342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJqfRo9pwtsQ7kNvwHUPwck&_nc_oc=AdpvVaXdRxqkutve1Rgk_GRxSVQ1PXz4asTnXYzk8U9Y-cNZ6VuqnrjNb9pAYqR_crw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z4TbgVhpBHC7zworvvQ7L7uixXpni_sfPb7jpvnnrxw&oe=6A11AF49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-CoverImage.png", "id": "1865478304189674", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035314_1865478310856340_412617430543564406_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbJEA_Yso70Q7kNvwHPFAZR&_nc_oc=AdqSAzWkI8j7jubDKKY1yf0VCIvLENTyFQnnQr2UZrpSyBGyxUMj-5eqkr1DXyouTjE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Md9wtY8P2W9L_KCSuNP6qwsaS_hIHGbpKoF_8cgOjTw&oe=6A11AAB5"}, "display_name": "Connectome", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **Connectome**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\u201cConnect the dots\u201d to create objects\u2026\n\n{459548087014195}\n\n\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026\n\n{1561193251252347}\n\nGet lost in a place of wonder and scale only possible in VR\u2026\n\n{2611663082362016}\n\n**Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in Connectome, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost i
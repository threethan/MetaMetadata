84268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ary0wzFTwMQ7kNvwFFtZiJ&_nc_oc=Adp_sYnZ6yJ2Y3j00HcDtS2H_P-LZmb2I9I5blm3LrxGUxDRztBK8YpsIRySHVXJi90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqqcakq7yj5O5Z4cjrbsqrX5r7Rb6GeWgXGJJ98Za4AQ&oe=6AC3B434"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aF_aI6ieS0Q7kNvwH4ZHnM&_nc_oc=AdqK5Xa8s2zXFVW07VMIQwF0Uy78yCAooDtAyW4WkOvSpFzRA7Eei7wrPAP5o0GfP_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNZc8sV8pcstgoM341eWWHKq5uUM2r5sem8f_qoltpbQ&oe=6AC3D1A7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTA8-7nQqiYQ7kNvwG72_xo&_nc_oc=Adrtpw2D04ntATgiFYiUGmTey7Yy8g5sDQx3iF0ei6xo0Yzs5FuGpzhyeaSpO9Yef_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP-uSYdENxoWalzVc8qYxL29C5ILl-wqhwV-P9rzb1dw&oe=6AC3AA25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieNfeqL36z8Q7kNvwFGJC7h&_nc_oc=AdrICQSO5E35pXklGqbs780bc3WFvq9H9LOUNI7bmd85I29QfHV7C9P6ZyUcbLV4y3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU3E2zl5FRNgNZ7jSvhUQthbVOoePAiFp8s7XIZDpg9g&oe=6AC3D704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7V5bVp1lCYQ7kNvwHK15yo&_nc_oc=AdpYBPnsFjFGcUptR6qs48iz4mlh-fVMLNa6wy03ltXQJDj_Qwi2SgPYoclfCeSIhnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVqvu_119P1XmtbxPO2bnrhm2L5ZCbudU4i4cr-uAUaw&oe=6AC3C1E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
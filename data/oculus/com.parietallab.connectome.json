84268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFzJsA9wrEEQ7kNvwG-Hhrd&_nc_oc=AdqEj_iGgN-TZgRAliQxNZeXwwSOXZZY-mDA55RJPO1Zyv-qeQC9Uk9RR-WvZigZ29M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_psOJKtTRDu_Ib-tQXpuRlWjgidGB8Y1cJNVvl9CD8g&oe=6A19A2B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m8lDfRogKwQ7kNvwGgAMU4&_nc_oc=AdqjwcLaJpfU6tTM-Gbi9OrtlGitI0niJajKGBbMmJ9bUVyYMVKdCrvp5yi2FV4vraA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vl69JaqCuxHLUpyZDgbFDAyer-0lA5nE9gGo5PjnMnw&oe=6A19C027"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9goDfpKeYf4Q7kNvwG5SEWI&_nc_oc=AdpdwILMHycL_ZSTD63kBjB1nllILG-Xvwl4TAEIg1VhXTt5Lv6tHoZf7aDvrU2SM_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o79dZGqBT6uZbWEwRfXfQbSf80PkRU21j-yyWyNnquw&oe=6A1998A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc9JalH7i34Q7kNvwH1izv0&_nc_oc=AdrF0WH8f_F8V-_JaXH3otrDn-JKRhyAOaKTe2azr5NGZSJzKyweRYfmZaJVZGGc5fY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6otJAOid6cWBWyLmAwXnS1cY94awcQ4BpvJR1cBO40sA&oe=6A198D44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0UVLp5xrQkQ7kNvwFfpsp1&_nc_oc=AdofN8PIGVMDZPiZVkvldChZeSvMhOgxKOPyEqi_eSz1WY_5BfW8nhL00CGS1Ba7HRU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uRuIfLWPW5s-mXaS3x6MEDBPpeyVVNDsXlFOOJfy2eg&oe=6A19B061"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
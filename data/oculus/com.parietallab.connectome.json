-3.oculuscdn.com/v/t64.5771-25/75348036_547445274926381_7448331770935991342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oxc5eOzffhsQ7kNvwGupPGM&_nc_oc=Ado3nGZxd1QPJstw5hupxfLXjMzZk_Fxs4o8m8VlZXzT-SIZ4ZKOjLEC4RShfc-6u68&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkLPKEvIxQ-GZyyJDQ4QIFlRLm-m8QqgVhHcVv9epSHw&oe=6AA94BC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-CoverImage.png", "id": "1865478304189674", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035314_1865478310856340_412617430543564406_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBBCoy5Dp2QQ7kNvwF_Ke2B&_nc_oc=AdpdJ5dvYe9MhmKuNGinb0X-aTLzyi-kg1s8yEiBew1GTz2gxpVlC5SB_EY6W2i_NE0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvjCGivvf2UnzDdqRhrppIzdyt2ayUiJbquWGdmpP5GA&oe=6AA94735"}, "display_name": "Connectome", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **Connectome**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\u201cConnect the dots\u201d to create objects\u2026\n\n{459548087014195}\n\n\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026\n\n{1561193251252347}\n\nGet lost in a place of wonder and scale only possible in VR\u2026\n\n{2611663082362016}\n\n**Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in Connectome, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost i
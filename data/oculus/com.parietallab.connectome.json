t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJRRYDN0lG4Q7kNvwFmdWAw&_nc_oc=AdqqmK1rnnE315VIXBMmtxF3DhmwjRodW8ULdAFySbvFxyCjsq_N8KerrV7mJL2Jq4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2hAk8RrOz7xKqwH5Yoa5kLNVchzHH06uZSGEM4bvNNA&oe=69CBDA34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WnU637FuCkQ7kNvwHs_nnH&_nc_oc=AdrQl30iCFHJz-B4JXi8tkAbPUxkyY4q1nvR7H5EoRjpB2jo7O2Am58LjlMg9ien5AA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaFNRJQHxXuoDXvatcJNaRmjlSytplZFddX0N-opMCkQ&oe=69CBBF67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATrYxlnp8KAQ7kNvwFtr4av&_nc_oc=Adqn5Z-DGT7zu5iK1hsULoMBcojX0Xo_mxbEUfOLa8XK0nmNs_Oq1hVgzABlAGrztKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-OFrW2qIuU0X0iESOsg5AneYl6mDfqURXXW-04jItUg&oe=69CBD025"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zikOXCx67dIQ7kNvwHIhfZC&_nc_oc=AdpzXiHFqjb_BaWYRlHYfQntm0kwLgiBznWv8YyX9FRHdL6MnVuj6fftYRPQTuxnKWo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzv6JhRJQucRapHtM0xTS0zcGIcXwp6uS593vfCVkMEng&oe=69CBC4C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4jdXfBBNPsQ7kNvwGf4AJ3&_nc_oc=AdpZ13i1-sxqgfepCcoqyPKAPZTZUCSJhaSJOJWY3OCJCl6py8gZeISJHp_AwKfW8xg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwV1fNJZcbxzbAC7CT8UfSN2tusQ9xO_4QudyqY-U-5FQ&oe=69CBAFA1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
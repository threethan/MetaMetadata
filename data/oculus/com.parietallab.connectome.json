84268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnvGstZ_F9YQ7kNvwFTT713&_nc_oc=Adp-51QjvQsyZobugrwLXoZu-IcvO4UaCowKoOJOITtZdv7DcMVeV_MgaSJXwmnkHys&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbzm-0jLqQYGumx5z7yIkhzVBMy0OD9N3Qc_inNoiP1A&oe=6A803F74"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A21s3edjSb4Q7kNvwF4d-dg&_nc_oc=AdpJEPVn5B6xI0hFCK_kGHNfNULo1jN45G72gQegSFBkdDD3g5UK5bgypnow2A16JAo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwc5IflopQaoco3tv-jmIBIvPS7pTg_zQyBYx35_SGng&oe=6A805CE7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwlu2o7caAAQ7kNvwG71Pmb&_nc_oc=Adqw9K80lxlohMu5Bk27VMnNy7GAqbIhNCulQwrZ6vuhkKl86hHI7sctduKPg6O9wsQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHosaQEVmPgm1GMYGf5zPS99Xf63k7JpO7tqjSIL-36SA&oe=6A806DA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU_j3d-QoCEQ7kNvwFPJWdM&_nc_oc=AdpF2WxMvAG_WtSW5KZ6maZg17KRPkIPt_hRtJy6L6p-MVBbATMtSorlZi26mAhvL_w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtNZRmjzoJWIT3rsViiRYzGnQecrwQ_qzEcnpvcWBXfQ&oe=6A806244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upgNrmC34sQQ7kNvwHj0R4F&_nc_oc=Adr_txs7g0sUvsOtECyK_G2BowL6rv3lPHsY_gG03OTsET9_39QIC-wMoZo2xcHsfp8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7AQZQWqUehs-7Xh6VUetCZ9G0L4Bo_3oozAVKK0Lc5Q&oe=6A804D21"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
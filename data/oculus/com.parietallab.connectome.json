t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyu_wiSySL0Q7kNvwEQfrGl&_nc_oc=AdoRfL2-44zw4UlIGdjIqgNOge8RrZIT4OFF98XLU3iO_0o-CHLKfTjLdnunaZiKHn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZDBMbsqdcLkwCDpnRCnMzGwozl2g_eIKiZivQIVW_Dg&oe=69D514B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRSUCfjNk2kQ7kNvwF9w3yA&_nc_oc=AdqI9lT5qEcDrB7dx5_aoJYHAu8MAqP1PV6V7v1kXWaICj9sq1IIvWn-Nh0pHWjycJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wYr6NMZQlVwij0Pz62d6CY2q_CpCV9nUY3Q_wozk1Ww&oe=69D4F9E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP0Dw3XTkg4Q7kNvwGWMhu0&_nc_oc=AdrHomRDMqhz8zQH37nNe0QHd2gmasExGHjONVZSzPuWgEaDTl5mjHU0HDRi2fZsQB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Eq1dz4EeZLL2ppweCJ38rOnDLbJEE9J-kC9d2FN0VpA&oe=69D50AA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yRQnMTCZG4Q7kNvwEgvZdi&_nc_oc=AdpbI2SFkK573f34mqRGA08gSrcewU7i-Hk6ouhAL9krdSBbyDB2PKzxyflTZ6UK4aE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GCqSKvLglAXhJ_gpXzR-h3U9-N_VkHjn7gFpqgCgwxQ&oe=69D4FF44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kcZQD_gBH0Q7kNvwH_hGKC&_nc_oc=AdrADvVpCtQhWMzo08zECNiHtyC-i5ikeQ8jOo4xnCFJNKZ4guaZZnZ-ttz43oEePWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gM9tA-AjbYK8jaVs6ThJviYDU-7YxMaLpPLZt8NpvQg&oe=69D4EA21"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
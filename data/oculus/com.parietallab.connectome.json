84268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilM_2TOI-zsQ7kNvwGVsU3N&_nc_oc=AdoZrmpdzblxP7_Vbkd1EBrCkTTM8lNQa0Nkm6cpTnPQ4QWKcx19dE4rgV2uB1_avQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLftdY2_GdFVJcvZDgStm4xTYqf4S0xEm0PZBwEvxM0gA&oe=6AABF934"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_dgvMX3wg0Q7kNvwHic1DS&_nc_oc=Adro4vNiP3BizBqkE653KpG_gvGap9zA-ghQEgczuxsU9g136fERF_X8m9u6w_QIKHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwCsDz3s57hC4teCVpNuAI0DL5ZJNwe5XksBJTU0S9dg&oe=6AABDE67"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJzuIPdcbBoQ7kNvwHDzcnl&_nc_oc=AdruqHcONkXURRHxubIXamzEYmvEfZ0eBtddyBYywnFiJvW0ttgoPykxY7EpBj1uF44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn4SOudqWXpT3pkdqin2V1tmlcdBu6qyhU-HYSP25T1Q&oe=6AABEF25"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mg-UXhRoFIQ7kNvwEkJX5b&_nc_oc=AdppOa5a0LC0H2doOVy7IFoVVO3gTMuI0mw1X_HfWJyKcERDlq_GYFtyVcA3kryMnvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIASlMWpBysvmRhQkBCEFtv--OW9Y4FCJIK8SnDvjba4Q&oe=6AABE3C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZmysc6Z4YAQ7kNvwHpbMas&_nc_oc=AdqhWa53Dvd_fCC8s5A5B0R8VFq367ieisNnLmm-dGIG11r9ThHGLOZCJ0uAHjkAp2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQcmWobau_kKV2zLl_eNbnw2ABWGqEkI-nViVzOtjdvA&oe=6AAC06E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
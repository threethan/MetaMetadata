t=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJD57XA5yIYQ7kNvwGvb8-V&_nc_oc=AdrmeCHIqOuN_1FhzDTLigUJEpabz4smf2eHuQB4rE0hdNphRPMYb6UHrmonNV9C0_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cgrYS4zVj3YaooWOKn1HoJkZi23e1EhUR15zYuj-M1g&oe=69DCFDB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngJXBNal7D4Q7kNvwEqsrwC&_nc_oc=Ado-Mg9UDDlp90G2se-yo9eKR3R74T1EgW0TwkGoI9R8fu0lL1GhrXnz6dffxFkjeNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VF4ekVRF3hCA5BHeg9_hDrcLXMOpeWTbWAXfM2xGWAQ&oe=69DCE2E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrLBMuw0Gl8Q7kNvwHK4xv2&_nc_oc=AdoYgOXCGQPdkDGDP-DepQym0QRH3pBlaJPWc5MMW0nHKxcdFHw9E1pyWVV6MQANnRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FBYmiS-Wx7wIAWFc2ANHlIv4_o3ose4Aa8VKcFhDn4A&oe=69DCF3A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcNOiujO3vUQ7kNvwHBulRL&_nc_oc=Adoukdgbuc2fRAtFDC4zN5AALcRHCsOG6hkDlXxH469nfWuEGvxqdECz-LY-1o673YU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OcV6-680ysEvcrPj8pel_MQYLDc6IMvcs3GQd2tgHxQ&oe=69DCE844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzDb4_CyQdwQ7kNvwF-lD_i&_nc_oc=Adode9yxKukog2mF2HY99QjdPyj8RPim9KC7Dnh3XU46l3ZuaCm_WFECcwqXeRVzo5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10MhRuH0gOPtRA9HcmGxQ10VHsptuiypwF1o8B0rG95w&oe=69DCD321"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_websit
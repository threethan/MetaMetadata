84268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyrQ-nMhD7cQ7kNvwGJ4x7y&_nc_oc=Adqk6L5Iq7vK4rYPXe0TXN8RfdyfuFMsAnpwHAEzs1mo3PHffcCmgGDDOnCiqq4s5gA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9Q6PKYdQ_053S3EoUVnTgaq_xXDV1EH_453xnwpamPA&oe=6A92B474"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2zw-CIx-ecQ7kNvwFLh2h9&_nc_oc=Adofdo17ajCu_hCgEGP9URmOj5po70VI7K9geftcjSOBznoKvNHPmdkrGJ3m-3Ndxb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElGiu0R2vqVATA8fxm5_WotmCzASqtxnpBH_L30fVMEg&oe=6A92D1E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=virlrzPAMqwQ7kNvwEaZihW&_nc_oc=Adrrh_Z2LSsHQAB62w3Bkuk0BwGf89QE0Lzx0A3Pa1ZK7DdL-zOA60e1PWfdllyfC7U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMbXXGcqTL5p-IgIFTwuRrAE37zk3ziwe3NpdzyUAG6Q&oe=6A92E2A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PICqj8JZysAQ7kNvwG-2TLY&_nc_oc=AdogE98RYgM91UBySztwLHCdEIwrmU7JmZMf4NqHbJgu36qBRnkoZ93tdeGT2VS1LfE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF92A_W-9wU9ZxDgm-8jrYF1ZMF_2DmIWOEG7UeVaCi-w&oe=6A92D744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQFGK8j_qfQQ7kNvwFlFCP6&_nc_oc=AdrzUq54UAoJ5F4ZISYuMNajCJcEaAKiaBhCvnQZxyEu4OblAAIdpN9S7_BB13CjCeg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBzIGmPJV6I4K2YiQL0uISOvsyU_T8X3wgN55aao2DMw&oe=6A92C221"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
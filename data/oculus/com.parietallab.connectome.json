_ohc=lZ26Z09PBtsQ7kNvwFOcLnJ&_nc_oc=AdlL6ALeaElYCuBWMAf7clEx3aIZDjWAkRlaUH071T_-H3q5VOunZZCMvbXFKrrRUSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwjZJLm_br1K2Iv73xdGRjws6mo0Mry3El6Sp3qPpkXqw&oe=69B41F34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSCRTljQW0sQ7kNvwGG7iZc&_nc_oc=AdlcwOdzDrxQ_VnS8XlfscL1bJXHIP9asBHC7e2IOmehGEOGhP-yPKt3oMKMQc3ln8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUU7loc1JDw0H8sxGZlGERKwab2lLGcGAoYFCDPokoQw&oe=69B40467"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVvvnqwt1KIQ7kNvwE5MZKE&_nc_oc=AdlLTZIyZlfhqY4jeOuobmx8ahhQN6HaVIW4JGdO_mOAtNkEiuDBy9u_H8pvXveukl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxnjNbewv3TNiiV2wdkaLftNn21EQ-5Qff-0nh3GblZA&oe=69B41525"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug---_3bO3AQ7kNvwG7pCCD&_nc_oc=AdlUjRrMhjePfaPbkNnejlPXewebbpDfUFmVMMzpXPHJhnmZ5PP1eFoMV-Fn9UF-Z0A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzYLfHbmrcDmQcxlDLnaZb5e8ufSE1WziiDGEbN_Vbc6A&oe=69B409C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWnwCuw0sNYQ7kNvwFhi9wS&_nc_oc=Adl8lVHciMjzP4Zy9YC8DNO5ZfPwwM9TBmuPUOVL3Y-bmeSa8oqlzdAJ0DV_q2y85uI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzq12AD3hFXxgnKbhm7xdUe2-fAfMZNWJyfFcjY5qJs1A&oe=69B3F4A1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33288133284165472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_891730399976926_2927939352608887063_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LWiWs-d2F8Q7kNvwEqS4oz&_nc_oc=AdkyCTSimxfbLR1WOKP2REhNfgO9meqe9ISwe8VWVf22Y_ay0cFXqmq5u8qv0rjCrgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgCsIu7HHwLXA5AnWEu6711PnMmW2iXiPKnINGWzFAYw&oe=69B3EA5E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CONNECTOME", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1748367660, "lastRevision": {"nodes": [{"id": "25707920678853475", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25707920632186813", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "934148758813776"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CONNECTOME-logo-nGon-512x512.png", "id": "8712126905541979", "image_type": "APP_IMG_ICON", "uri": "
f3fWWlkGvZwD1QHijyBH6p0sQeTvpp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuf0-3Nd5NH48-sDuLNKQzX1AJQCUVJ7Bs87-Y_bgp_cQ&oe=69A2FBB4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVe6JbXEc0EQ7kNvwGjrfj2&_nc_oc=Adn8ONn-Bijttsia3CkqysoZsgq8XaVY1ZHoaB5xo_9Gow6ECdXqOh4pcUDSYJnE5fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsy2NZWSrcUEo5O20YgxH2kFjm0H_dSbAgZ3j09QO4Ztw&oe=69A2E0E7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc_v1j09dPIQ7kNvwGjAdge&_nc_oc=AdnceiS4bJuSyHKS5dDHrJX1tpcDkFxWDiFlc6bvV3gsxoeRWRXDpY_aTlXQUGqwKfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqaaINI7pp1gwunYfLEbg6zbL6oGmHyv5c9hlq5zx6tQ&oe=69A2F1A5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV76l-_fqDMQ7kNvwGx6Cho&_nc_oc=AdmBLdpBWPQQjqFApv5qNr2rJVcsVOB6RGk6LBqNYkxfuXV7FPDPsQ4PQ7SupHLyImY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQBIx8NApjKjPd0kqCAnWrot3M1YAGjjViH6FdUC7Pew&oe=69A2E644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUx48xaDq5kQ7kNvwG7SqWz&_nc_oc=AdmGLvVSJtkJDvt3vXhj5seVErcD8I3R-hlyolljDCX7AvHCbTXaOcdmDai2d3u1RaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYt-nPGtDIlwQnjyY1G-ntq1bQtrtLWKVHC8wN6cO9gg&oe=69A2D121"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Parietal Lab, LLC", "support_website_url": null, "website_url": "https://www.connectomegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
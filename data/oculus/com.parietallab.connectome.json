84268", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waG5FwezIGAQ7kNvwH82h9-&_nc_oc=AdqtQ7hff4fgXG4bHXZ30iNxdwyM7zyAOH3df2xof_b2e8-8BopQdcgQiCV4JrOLxyU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YZjqms4dYx4tnW70POdrj8i3vl4FtBNzPdUPgktqrPQ&oe=6A3D3B34"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcPhzPeM9NkQ7kNvwF7RGNH&_nc_oc=Adrcy45tGgQqebSFjn-sLyxMo64gDu_JswTUjI_cgxi6R-XkI9GMJ_FEDMHr8vgy2iE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uBbz4l-GWtaUZWesPbazVwFlnhEfzoWDSkMzTHa8bXg&oe=6A3D58A7"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncnFONWQmxwQ7kNvwFQzEO9&_nc_oc=AdrcG6swmqkSP6H_posrQuoxTC9nVqAO4duMXNXQwl1PE_nTdl88ACZldkNc1BYJSPw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i-Nu955UjksUEjGaZ6uw5wh3TU6UF8jighMbH7h8-7Q&oe=6A3D3125"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNBJLHwmqtYQ7kNvwH_mqDv&_nc_oc=AdqW7Syi7zpjuTSEBLa7s0Xxj7my9tPrlJqEwG5yuuNW1kP37tSa4TNVsb5dAMILoyg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hOhNcy-2aTOis3QJ1ExkQ8tMDfokXW0t8LhCjPtrvdA&oe=6A3D25C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRL4fYqPnG8Q7kNvwH5kChJ&_nc_oc=AdqtsnPXqDsZSOg3osXeAi1Cu5wET3CaEmElJjh7RHR7gMrK1Ss-AurzsT4DrcgaxnI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BltNbzBrMHGkFlnEs7HGWe0e-E_l3-lpx93hPtQjESw&oe=6A3D48E1"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
84268", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823968_786802563717601_4908507408334952299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdQ9HRQorhUQ7kNvwGYGtDN&_nc_oc=Adoj5y4VWMsnoHjZL44I_aAWo_8V4BOfVXUh97EGgypXntp2xUSQMg4QsusZY4pERrU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOGp97eaSRN3ZXGmyyf-iEC9EqFyv_rUEk_MoWRGFNZg&oe=6A9AD5B4"}, {"file_name": "CONNNECTOME-metadata-store_6.png", "id": "1109069551178101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824203_1109069554511434_733356631600195985_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE9VFO7NZ3gQ7kNvwGEXEWa&_nc_oc=AdrizvL2-v9U7py6pR7TR7spC72_uikFLgiOiYsMamoZb6OlY70b46i4_4aPShbnuvg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3mcUHdwzRWucGn3ThN6MhybNNgGe6hW0hOJCq_uvc_A&oe=6A9AF327"}, {"file_name": "CONNECTOME_Halloween_shot1.png", "id": "774174165619682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_774174168953015_7634987824755978842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyvqqsGF-BkQ7kNvwEdS_hD&_nc_oc=AdrmItB6dKuv93pfvs8FPnkOetpz7FB2gWYubvwqNJQxcJpgoUPQoGbODQfwPYbVSvk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMn7EmNpokLiivqlQ9T2E5moO3XXHG1Ehf5YvQ8cQmiw&oe=6A9ACBA5"}, {"file_name": "CONNECTOME_Halloween_shot4.png", "id": "815790571425797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619729_815790574759130_8600262747169364041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m3_WpxlFvUQ7kNvwFAT5qo&_nc_oc=AdomJedrR01qYpLrZohCf4Kzt2ZA3k5UGUOIJMsz9qHZnZoHaoeolVr89BvDoohe6gw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf9_NDfvl2FQxTqV6xCYEXQiuEedki-G9bxgGkw4GWag&oe=6A9AC044"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CONNECTOME_cover-landscape-2560x1440.png", "id": "2608254469574336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620504_2608254472907669_6980469841592711824_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8YS6L_7h4YQ7kNvwFMr-vU&_nc_oc=Adq88G34NB2ktcD1fjtS5F7b5TuRy0ZYMTow1k18DSthwAFi6X2_PhX9yw4eLzHKsoc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLczfbjFWaRMMTj6nsTtmC2CW-O61ZPmHHFmduOZVrHDg&oe=6A9AE361"}, "display_name": "CONNECTOME", "keywords": ["art", "puzzle", "connect", "casual", "relax"], "long_description": "Lose yourself in **CONNECTOME**, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience.\n\n\"Connect the dots takes on a whole new dimension of color, scale, and fluidity...\" - UploadVR\n\n\"Wow. Beautiful. I love the minimalistic style.\" - @DilmerV\n\n\"This is truly unity. It makes me just... wonder.\" - @Matteo311\n\n\"This is so different from anything I have tried before & I love it!\u201d - @Bliss2121\n\n\u201cMy eyes burn from so much beauty. VR was made for this! - @sortiksystems\n\n**\u201cConnect the dots\u201d to create objects\u2026**\n{459548087014195}\n\n\n\n**\u201cPinch-to-reveal\u201d hidden shapes and forms\u2026**\n{1561193251252347}\n\n\n**Get lost in a place of wonder and scale only possible in VR\u2026**\n\n{2611663082362016}\n\n**Core Features**:\n\n- Hands-only gameplay\u2014no controllers required (controllers not supported)\n- 20 unique rooms at launch\n- Gesture-based interactions designed to feel natural and intuitive\n- Unique modes of interaction, including connect-the-dots and pinch-to-reveal\n- Ambient soundtrack that enhances the visual environment", "short_description": "Lose yourself in CONNECTOME, a space of discovery and exploration. Simple gestures bring objects to life and grow a world around you in this room-based, interactive art and puzzle experience. Allow yourself to slow down and get lost in a place of wonder and scale only possible in VR."}]}, "developer_name": "Grant Hinkson", "developer_privacy_policy_url": "https://www.connectomegame.
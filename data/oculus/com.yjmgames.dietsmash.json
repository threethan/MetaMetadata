0_3238381320197792792_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWGV0BITdSEQ7kNvwEedL-M&_nc_oc=Adnl5cKh00M40Zd2PGhi8_bZnaHCqtRxMIfAUuBIZhTVHfSJJlR0Ydbwv5sp7vrM_1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv5upXhHe7RslSfKQl5izr9koT-w7To2SbMqdnsJjmk_w&oe=699AE03F"}, "display_name": "Diet Smash", "keywords": [], "long_description": "Diet Smash has a 'Hit' mode in which you have to avoid bombs by hitting a shuttlecock flying in the background of the indoor badminton court of the 'My Town' worldview. And you can enjoy the 'Bounce' mode where you have to bounce the shuttlecock with a racket for a long time without dropping it on the ground in a confined space.", "short_description": "Hit the shuttlecock at the badminton court and avoid the bomb.\nYou can enjoy various modes using rackets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.escapepointvr.com/terms/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "yjmgames", "support_website_url": null, "website_url": "http://yjmgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "674917440233731"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031414_484219053162459_5496286750061426151_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHvnnI
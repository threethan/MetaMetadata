.com/v/t64.5771-25/499312236_1206270171715227_481298647893889365_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mMQxezyoxEQ7kNvwHGHGzA&_nc_oc=Adpgff3peZrLhbZtI-y4-E9RrE1tOQd0A3hkK-ULOJnEKclYwWaNugpF49RGU7JmFxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7Gsor8p-1C-svR7B9zroR-sr6SBiSm-cuGjkasmSN9w&oe=6AAA8F52"}, {"file_name": "JupiterSaucerRun.png", "id": "759912117176369", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295272_759912120509702_7267670017522412039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzAcF-6KMSIQ7kNvwE0-4rt&_nc_oc=AdpAKxDZ-zbFWpM8qBi2hoxBXAE79GA3aFfP7mjcVB70ZVjGmFTFhsVL35LsOr-rz9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPfImdrO2Xxe0VdsZpAq_RjmecCMi4tkTvZIFZAi-fdQ&oe=6AAAB3D6"}, {"file_name": "SaturnWalking.png", "id": "1129065012553998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304764_1129065015887331_2238802160519026220_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMn4RUG_jA4Q7kNvwFhXLfS&_nc_oc=AdoOygb525ZGH7QCbKR80b-OMl6B1J9JvaEU0ySgMEj1ZI37WzGF07IYUoik9uGlv3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7kOLHocATYSFG3sFA0TVESqcrFdPlxBBJ4nWJJzWwDw&oe=6AAAB472"}, {"file_name": "NeptuneSudoku.png", "id": "1206262891236080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307931_1206262894569413_7837239183281192192_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNKBVZvAxVMQ7kNvwGZg39x&_nc_oc=AdoPb79RCowQaInewym7unrP7UJ9mAOFvXHtTTRgLJ95ou-Al7Ruy27AS0y1nfFXlUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvCAciR53MIndrqb56o0Q990bGmJ8IR7lp7LYIEag6Sg&oe=6AAAA337"}, {"file_name": "EarthBlackJack.png", "id": "943295574717617", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308045_943295578050950_573000686665651998_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIEvm0cptwwQ7kNvwHsgN5y&_nc_oc=Adp0JNiExzfYllnlFJFqQciF1hplGQAQBllH-xI9oXtEv_eCf7MO2-zcXJEaoXjLQkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxJ6K9zjAkvkhGG2m3O4HiYrs_znuNNMGA7hShifkbMg&oe=6AAA869D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "1040062452288593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593966611_1040062455621926_788283060316801850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOkUjtq0hVYQ7kNvwFBQqhT&_nc_oc=AdpBr38MmwVYeq2EuOZQm8hmpYfTQ-tkT6XgQ249ZGOZ3ox3slTwtzorxr6CwFRyuhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiWTGzIsmKMSDXxmANMvQ2Dke7asLISvxM4yEWmTpOUA&oe=6AAA92FA"}, "display_name": "Space Cycling", "keywords": ["cycling", "space", "simulator", "exercise", "bike"], "long_description": "# Welcome to Space Cycling\nPedal your stationary bike to glide along cosmic tracks and take in the wonders of our solar system. \n\n# Hands Free Arm or Leg Exercise\nInteract with mini games using your pedal motion and your headset. The Quest controllers are not needed. It also works with seatless exercise bikes for arm or leg exercise. Just attach a Bluetooth cadence sensor to the pedal arm.\n\n# Play With Or Without Exercise Equipment\nYou don't need an exercise bike to explore the tracks or play the games. When used with an exercise bike, the software can detect your pedal speed via the headset or a cadence sensor. While not strictly necessary, a cadence sensor delivers the best experience. \n\n{1320048466239381}\n\n# 15 Game Modes\nThere are 15 different ways you can explore each track.\n- Walk along a track using the Astronaut\n- Drive a go-kart\n- Ride a space bike\n- Ride with other space riders (NPCs)\n- Barrel Run \n- Saucer Run through asteroids\n- Target Practice\n- Bowling\n- Sudoku\n- Blackjack\n- 15 Puzzle\n- Hangman\n- Match Game\n- Sequence game (Inspired by the popular game Simon\u00ae)\n- Rotate Game\n\n# 11 Tracks\nThere are presently 11 straight tracks to ride on.  This includes space tracks for each planet, one for our moon and one ground track on one of Saturn's moons. \n\n# Editor\nYou earn space coins by playing games or pedaling the bike, and you can spend them on space stations to populate your tracks. You can also change the colors of the stations to suit your preference.", "short_description": "Pedal your stationary bike to glide along cosmic tracks, and take in the wonders of our solar system. \n\nWorks with or without exercise equipment.\nWhen used with an exercise bike, your cadence can be determined from your body motion or from a Bluetooth cadence sensor.\n\nChoose from 15 game modes to help you forget you\u2019re even exercising.\n\nThere are 11 tracks to choose from. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://etjstudios.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "EJT Studios", "support_website_url": "https://etjstudios.com/", "website_url": "https://etjstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29092916483630244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308699_1178639344352785_5837517216248593503_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_R94vI39XTIQ7kNvwFsQqzE&_nc_oc=AdrepWkj6dBr_RmZ6UMfFGE9ajrIDnoN_s8iEMK7-BFa_e-bPF5MuD2divWBhMtZIbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxW8P8MN_30T-JQgDnnz2jeY4
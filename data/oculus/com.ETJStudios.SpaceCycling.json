=00_AQJ7kOLHocATYSFG3sFA0TVESqcrFdPlxBBJ4nWJJzWwDw&oe=6AAAB472"}, {"file_name": "NeptuneSudoku.png", "id": "1206262891236080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307931_1206262894569413_7837239183281192192_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNKBVZvAxVMQ7kNvwGZg39x&_nc_oc=AdoPb79RCowQaInewym7unrP7UJ9mAOFvXHtTTRgLJ95ou-Al7Ruy27AS0y1nfFXlUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvCAciR53MIndrqb56o0Q990bGmJ8IR7lp7LYIEag6Sg&oe=6AAAA337"}, {"file_name": "EarthBlackJack.png", "id": "943295574717617", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308045_943295578050950_573000686665651998_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIEvm0cptwwQ7kNvwHsgN5y&_nc_oc=Adp0JNiExzfYllnlFJFqQciF1hplGQAQBllH-xI9oXtEv_eCf7MO2-zcXJEaoXjLQkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxJ6K9zjAkvkhGG2m3O4HiYrs_znuNNMGA7hShifkbMg&oe=6AAA869D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Cycling", "keywords": [], "long_description": "# Welcome to Space Cycling\nPedal your stationary bike to glide along cosmic tracks and take in the wonders of our solar system. \nChoose from 11 immersive mini-games to help you forget you\u2019re even exercising.\n\n# Hands Free Arm or Leg Exercise\nInteract with a growing number of mini games using your pedal motion and your headset. Your controllers are not needed. It also works with seatless exercise bikes for arm or leg exercise. Just attach a Bluetooth cadence sensor to the pedal arm.\n\n{1320048466239381}\n\n# 13 Game Modes\nThere are 13 different ways you can explore each track and two more are in development.\n\n- Walk using the Astronaut\n- Drive a go kart\n- Barrel Run \n- Saucer Run through asteroids\n- Target Practice\n- Bowling\n- Sudoku\n- Blackjack\n- 15 Puzzle\n- Hangman\n- Match Game\n- Sequence game (Inspired by the popular game Simon\u00ae)\n- Rotate Game\n\n**Coming Soon**\n- Cycling\n- Cycle Racing\n\n# 10 Tracks\nThere are presently 10 straight tracks to ride on.  This includes space tracks for each planet and one ground track for a small moon of Saturn. \n\n# Works Best With a Bluetooth Cadence Sensor\nIt works best with a cadence sensor; however, you may be able to use the software without one.  If you don't have a cadence sensor, the app calculates your cadence based on your side-to-side head motion. Keep in mind that at low resistance levels, your head may not move side to side, in which case a cadence sensor will be necessary.\n\n", "short_description": "Pedal your stationary bike to glide along cosmic tracks and take in the wonders of our solar system. \nChoose from 11 immersive mini-games to help you forget you\u2019re even exercising.\n\nWorks with any stationary bike, or mini exercise bike, that has pedal arms. Attach a Bluetooth cadence sensor to your pedal arm and you're ready to go. \n\nThere 10 tracks to choose from.\nThere are 13 different ways you can explore each track and more are coming."}]}, "developer_name": null, "developer_privacy_policy_url": "https://etjstudios.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "EJT Studios", "support_website_url": "https://etjstudios.com/", "website_url": "https://etjstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27255583664030211"}}]}, "scheduled_offers": {"count": 1, "nodes"
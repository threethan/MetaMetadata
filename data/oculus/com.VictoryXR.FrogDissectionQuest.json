_3840x2160_2019-03-01_10-42-41.png", "id": "136968264983571", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_136968268316904_1114109492687052247_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=273lCp9lmxsQ7kNvwEFNUwU&_nc_oc=AdqpG9xIYup9E31rMdD8Uyf8OdoR5-aaG3ekoxRCDDy4nE5JOOFqXCj9SA5MNGjJx2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg24EjM1QEO9ZgsAuNdxpcNhQQWdRcX1COYW5HxmN0Ug&oe=6A60A7C1"}, {"file_name": "screen_3840x2160_2019-03-01_10-14-43.png", "id": "347492349857576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974738_347492353190909_3456758484560401732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FzHDwNmX60Q7kNvwFJFzB0&_nc_oc=AdrjHfAlxZPNo5wQ3UqTIVP9lcUf3WTJlWg_fYquLlQ1AQoctmL1czruUM9gLS52Qf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH50ReCsCsnxiGOE6XzfypTiF2baW26hCe2rkVIqqNGQ&oe=6A60D2DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_3840x2160_2019-03-01_10-14-43.png", "id": "213573287218582", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569425_213573290551915_1186836567141116527_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0b9qanEN9RIQ7kNvwF8xdEi&_nc_oc=Adr_z4IhUgR3YqR_LoRwV9oL3CJNoXF5q2k7AqQJYz-m6dLvh_pEbfoIqQ3d1Ig8BsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnFkYY5MtsAQFs47QyctVtX_1u2E_VZt4cgVfCK4wWAQ&oe=6A60CBBE"}, "display_name": "Dissection Simulator: Frog Edition", "keywords": [], "long_description": "VictoryXR's virtual reality frog dissection software is a hands-on dissection opportunity that users can experience through the power of virtual reality. This true to life experience covers each step that a student would take if they were dissecting a real frog in their classroom. Along the way, a hologram of our teacher - national runner-up Teacher of the Year, Wendy Martin - will pop up to provide instruction and information to users.\n\nAll of the instruction follows the Next Generations Science Standards (NGSS), the national science standards for the United States. The dissection experience is recreated to the finest detail so that they are a suitable substitute for the real thing in a classroom. Lifelike physical models mean that the frog appears as it would in a real dissection allowing science teachers to feel good about substituting virtual reality for the real thing. ", "short_description": "VictoryXR's virtual reality frog dissection software is a hands-on dissection opportunity that users can experience through the power of virtual reality. This true to life experience covers each step that a student would take if they were dissecting a real frog in their classroom. Along the way, a hologram of our teacher - national runner-up Teacher of the Year, Wendy Martin - will pop up to provide instruction and information to users."}]}, "developer_name": null, "developer_privacy_policy_url": "https://victoryxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1633347187002561"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1230109548165114"}, {"status": "PUBLISHED", "id": "242381948741240"}, {"status": "PUBLISHED", "id": "1188823
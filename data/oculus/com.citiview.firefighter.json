0.png", "id": "1114680874551541", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_1114680877884874_602425649089336452_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vibCS3-TxwQ7kNvwGyv9gS&_nc_oc=AdpsdlCKGP1CWaRUHBfEl-GuOgsN5fbIDrozwMqk2zqQAxWRGgyaq_f_dJVS_0Ic8n8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLDl3ulgGkgIjJehw5Rdo_fsfQmrpxk14H4KsK8aGsFA&oe=6AFDB4E3"}, {"file_name": "screenshot-2-2560x1440.png", "id": "1320677199998166", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596068480_1320677203331499_717106538976347103_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_67sSe48XMQ7kNvwFRiGLH&_nc_oc=Adr3UKu7Y1WHSF2ACBn0w9kjpDXNi1wOJT_6357CjCZtBMWipgW6hoLEXE6NQi300Dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGCC1yeiSbWyJY-jrxjiM9mnq6hEJuvsSoEZN5igWNRA&oe=6AFDDC78"}, {"file_name": "screenshot-4-2560x1440.png", "id": "2163153617604144", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/756589809_2163153620937477_3396533324131017399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2bCtEBWbKkQ7kNvwFytH3h&_nc_oc=AdqU82Pjm7pvFcjj1PkIbnx76dYV2Iai9PXpKBZVXNCEoraVSiORNr3Q2thjiFYTP0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLQQOoKq2q-eXUdvMo-JPKW3WLOrtLxqi6rOrBj-YlCw&oe=6AFDC8BB"}, {"file_name": "screenshot-5-2560x1440.png", "id": "1436066925103980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_1436066928437313_2073624179179815030_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93SabpNbElUQ7kNvwGlZSJg&_nc_oc=Adp3JPeucpX_P9ii7irR4kIzQo8glB8karG97tCw4ASfO2xa_LNvnMLKLva0DXCmECM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1x0Wq-pqH9EETDhv7QMI9LcsTcAyewEq6wr7TVQRoZA&oe=6AFDE263"}, {"file_name": "screenshot-3-2560x1440.png", "id": "1067914162516054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_1067914169182720_4999833125395049417_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zlBMqckpF0Q7kNvwFNm6hk&_nc_oc=AdraIypv5CULPhQQV8341qeEqLazTcO3EblblYMpMDy2cNeBV6gtEyAbGsQXfTeqfbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcShAO1Gl2Hf21mM_u13-ieYgnVplMCm2aBKRjREHvrg&oe=6AFDD44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1384492617125111", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1384492620458444_1677890461578498704_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=to8VpjZE2xkQ7kNvwE9o5En&_nc_oc=Adol07vBuMv5amAzRsr3hSQhvB6_-LkwbDBj0LcQLFEUI8YNfyuI1PqjwuukDo7MYZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqn0ovCi7dgBnCTBahTPedruPtAl58ZqWaY2cnDHX50Q&oe=6AFDDA99"}, "display_name": "Firefighter", "keywords": ["firefighter", "fire", "hose", "axe", "simulator"], "long_description": "FIREFIGHTER puts a real fire hose in your hands.\n\nPull the trigger and the nozzle handle swings back, the water kicks on and you feel it in the controller. Aim high to reach upper windows, flick to a wide fog pattern for close-in fires, and drag the hose behind you as you push deeper inside. When a door is jammed or boarded up, grab the fire axe in your other hand and chop your way through.\n\nSEVEN MISSIONS\n- Training: learn the nozzle in the training room\n- House Fire: get inside a family home and knock down every room\n- Street Fire: burning cars, a dumpster, shop fronts and upper-floor windows\n- Lakeside Lodge: chop the boarded doors open and save the lodge and shed\n- Mansion Fire: fire through a whole floor of a luxury mansion\n- Sky Condo: a penthouse fire high above the city - don't forget the balcony\n- Warehouse Fire: a burning forklift, conveyor lines and a jammed storeroom\n\nFEATURES\n- A detailed, fully animated fire nozzle with straight stream and fog patterns\n- Water arcs, steam and fires that die down as you hit them\n- Fire axe for smashing boarded windows, jammed doors and crates\n- A hose that follows the path you walk\n- Radio dispatcher briefings for every mission\n- Beat your best clear time on every level\n- Bright, colourful worlds with smooth movement and snap turning", "short_description": "Grab the hose and become a firefighter in VR. Squeeze the nozzle, switch between a straight stream and a wide fog, chop through jammed doors with your fire axe and put out every fire across seven missions: training, a house fire, a burning street, a lakeside lodge, a mansion, a sky condo penthouse and a warehouse."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-firefighter.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-firefighter.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1321394867720043"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1322556794270517", "version": "1.0.0"}, "id": "2889608718089013", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fals
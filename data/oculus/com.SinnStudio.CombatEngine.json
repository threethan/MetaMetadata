ps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820441_1469109900818414_4669662775977725854_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIJW59Jq3wgQ7kNvwHK8MfD&_nc_oc=Ado6BJ-qDSwu5xELTYUxy5V1iS4Q-jy2p2dGXgHJCWWJ4vYibdqpEBrOAmxfIIGWDG8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRDTofeZGctoWdV2bsctXNN3u0MqvxSGpK78CjqvVDFw&oe=6A9FFB4C"}, {"file_name": "Untitled (19).png", "id": "1163350739239176", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823930_1163350742572509_1268781068700655141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUDODSFGl2MQ7kNvwHGZqd0&_nc_oc=AdqT4jWzgz5S2hrE1j8jf8e_PBvoA6cnGWqcuAUSZ9VE3C7vUMTYznAtSrK_lxX7ccg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDDJulMU93fxLuV9b6tIGeSWNTkwVPzAczW5_xFK1VEA&oe=6AA02CC0"}, {"file_name": "Untitled (17).png", "id": "1183743280378030", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818925_1183743283711363_7476408671346314720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr0TkYz1a0wQ7kNvwGrDslP&_nc_oc=Adr5O1Irt-IuHb9lTmnc2H8Q9eDbOadvGkF-lY_X5qiQLmOI3PShXDOKBJ0D-BGf8a4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy1uiKUVAau5aMOacwOF-n_MPKJJLeQPfQid3tS8NjHg&oe=6AA02E40"}, {"file_name": "Untitled (20).png", "id": "3535019476637951", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823351_3535019479971284_1857934205342442483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JtakwB1DgEQ7kNvwFnnzcZ&_nc_oc=AdrU8uIL6uOFuns909b4zqadbvQYNwafEfA-eXG-48MuzpSB4VylDYafPF9nvXEUylI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB9hB0oefkMh_eQ9mP3FSU6dL3Knx-4jF12mTTZEQ2OQ&oe=6AA006BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG_Quest_Final_2560x1440.png", "id": "802507252639436", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827611_802507255972769_2562386728375614090_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCI9HVNn888Q7kNvwGRVDHe&_nc_oc=AdrIx2ijJrxFtrOB75seeXOYh7xL5ubLMC2dvJmvSPJTsGUVJhwBY1hx-x035Kdcya4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ6tzxTrSIAwwVrpNbXp81cgqO63wih7PgJE14OZB2fg&oe=6AA02E7C"}, "display_name": "Battlegrounds", "keywords": ["multiplayer", "social", "pve", "adventure", "fighting"], "long_description": "**Boring battles are banished!**\n\nThis is **Battlegrounds** - your free multiplayer medieval sandbox where you mine, explore, and fight across the Kingdom. \n\nExplore mysterious caves, pull off impossible stunts, or dive into the madness of medieval mayhem. Whether you're exploring the biomes with your friends or exploding them with cannons, the Kingdom thrives on your actions.\n\n- **PVE Adventures:** Mine, explore dangerous caves, and take on Kingdom enemies together.\n- **PVP Combat:** Fight your friends with physics-powered battles. Fling enemies, strike from the skies, or outwit them up close.\n- **Dungeons:** Randomized maps with exclusive loot & new enemies. Fist bump friends to party up, find rare keys to enter, and survive together - or spectate as a ghost if you die.\n- **Team Deathmatch:** Squad up and dominate in organized chaos.\n- **Unreal Movement:** Grapple, jetpack, dash, and climb with unmatched agility. Master momentum for aerial chaos & mid-air flexes.\n- **Unleash Chaos:** Crazy weapons, wild gadgets, bombs, bows, cannons, and fireworks - all at your disposal.\n- **Private Servers:** Your Kingdom, your rules. 24 hours of total control with your squad.\n\n# A true warrior doesn\u2019t just fight, they flex!\n\n- **Character builder:** Customize your look & your loadout.\n- **Mining & Loot:** Gather ore and hunt bosses for rare drops. \n- **Trader:** Take on challenges to win rewards & drip.\n- **Unlockables:** Spend gold on cosmetics & new gear.\n- **Limited-time bundles:** Grab exclusive looks while you can!\n\n# Join the Kingdom\u2019s council - **discord.gg/bgvr**", "short_description": "Battlegrounds is the ultimate medieval VR playground where you mine, explore, and fight across the Kingdom. Party up with friends to take on dungeons for exclusive loot and deadly enemies OR fight your friends in the PVP zones - the choice is yours! Master physics-powered combat and wild movement across multiple formats from PVE adventures to PVP chaos to Team Deathmatch mayhem. Choose your style of chaos and have epic fun with friends in a living world where every moment is player-driven."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32693952413584562"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823812_1360771472094884_2112416187150428108_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewFtkWtWHV0Q7kNvwEx0IDr&_nc_oc=AdrItJ7o69SzTRWlTkDN9uer3VozmXO0eBL-6MEXTAWeKwP3rgT8oyJk5HfQRuaTJ38&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZIpF68no_AEkr-SNh1JRDETpZ-U-pf2Hc5ogxa6Q9eg&oe=6AA00E1
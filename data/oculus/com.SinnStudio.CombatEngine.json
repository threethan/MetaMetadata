ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_1469109900818414_4669662775977725854_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoiOlUs-q7QQ7kNvwGVvC4T&_nc_oc=AdqDg470aDJarI41eRIAk_ugVdsvXF5_9QkPF6_RdXVv9uoIeMNYsaTOxQhEzTuf3lM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qr9i64Y7Ati0kNrOCueI9Od6nu-SMbhTbioe48AMYnw&oe=69FF244C"}, {"file_name": "Untitled (19).png", "id": "1163350739239176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_1163350742572509_1268781068700655141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LmUz6eEFVQQ7kNvwHHd-X4&_nc_oc=AdpPHgNITl0uZp2KhU4MLpoBcRPrjrx3FZXSuUTPC3oTZWPD4CI8shQGoiFfocHQBFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K5Jj0n-iFW03XDQxPuiJIcGJLCHW8JNocnpP4ejX0dA&oe=69FF1D80"}, {"file_name": "Untitled (17).png", "id": "1183743280378030", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818925_1183743283711363_7476408671346314720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9evN102QHfMQ7kNvwGdn2K1&_nc_oc=Adr0gYhfSnAEsFt04qu9gxzTElHq6TbzEVl_r4G8N3B0_0BrImejrPw7ltHPpDCkT0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5frlr-CB2z2n63kXuwe896-NV0K7dnuOfe2D96p9nQAw&oe=69FF1F00"}, {"file_name": "Untitled (20).png", "id": "3535019476637951", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_3535019479971284_1857934205342442483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5RMgD7PoJUQ7kNvwEnNqSY&_nc_oc=Ado_wamlUU4QEOdvuHIG9v2EXU0dTH2vFnBmG0xB4CxEoAVVhlWfwAdVa1vDQLxpUEw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jnZoTr0ND90WHcht3Ugalkksjr5-7eBG2Y12IMlBRHA&oe=69FF2FBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG_Quest_Final_2560x1440.png", "id": "802507252639436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827611_802507255972769_2562386728375614090_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlSUzAinTSQQ7kNvwFadTXu&_nc_oc=AdoEjY4zJZYImjPigAEwkgvMKzLShl1gbZj1q9rlOMLV7S1I1nFKaOMTTRrbb7vxH_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mEjgV5P3utRHHfhFPxgUJjFXHFIulsd2HUWcDgeDbRQ&oe=69FF1F3C"}, "display_name": "Battlegrounds", "keywords": ["multiplayer", "social", "pve", "adventure", "fighting"], "long_description": "**Boring battles are banished!**\n\nThis is **Battlegrounds** - your free multiplayer medieval sandbox where you mine, explore, and fight across the Kingdom. \n\nExplore mysterious caves, pull off impossible stunts, or dive into the madness of medieval mayhem. Whether you're exploring the biomes with your friends or exploding them with cannons, the Kingdom thrives on your actions.\n\n- **PVE Adventures:** Mine, explore dangerous caves, and take on Kingdom enemies together.\n- **PVP Combat:** Fight your friends with physics-powered battles. Fling enemies, strike from the skies, or outwit them up close.\n- **Dungeons:** Randomized maps with exclusive loot & new enemies. Fist bump friends to party up, find rare keys to enter, and survive together - or spectate as a ghost if you die.\n- **Team Deathmatch:** Squad up and dominate in organized chaos.\n- **Unreal Movement:** Grapple, jetpack, dash, and climb with unmatched agility. Master momentum for aerial chaos & mid-air flexes.\n- **Unleash Chaos:** Crazy weapons, wild gadgets, bombs, bows, cannons, and fireworks - all at your disposal.\n- **Private Servers:** Your Kingdom, your rules. 24 hours of total control with your squad.\n\n# A true warrior doesn\u2019t just fight, they flex!\n\n- **Character builder:** Customize your look & your loadout.\n- **Mining & Loot:** Gather ore and hunt bosses for rare drops. \n- **Trader:** Take on challenges to win rewards & drip.\n- **Unlockables:** Spend gold on cosmetics & new gear.\n- **Limited-time bundles:** Grab exclusive looks while you can!\n\n# Join the Kingdom\u2019s council - **discord.gg/bgvr**", "short_description": "Battlegrounds is the ultimate medieval VR playground where you mine, explore, and fight across the Kingdom. Party up with friends to take on dungeons for exclusive loot and deadly enemies OR fight your friends in the PVP zones - the choice is yours! Master physics-powered combat and wild movement across multiple formats from PVE adventures to PVP chaos to Team Deathmatch mayhem. Choose your style of chaos and have epic fun with friends in a living world where every moment is player-driven."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32693952413584562"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_1360771472094884_2112416187150428108_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swkI1mDYsssQ7kNvwG-_aCX&_nc_oc=AdqMcJ4jfoJepFYRLx0FWUZTP-wZKCGr6tcnmSeoeKOkeNjfOeYVg3A3VGd1qzhksLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gJnJDescJmPGS6d3kff-GBwYdP0_-3gZGPf8nLtHRvA&oe=69FF371
5854_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=490XqwAxSTkQ7kNvwG-4sKt&_nc_oc=AdmcRGGo98f7-6TUCWeMy5UChOj_DwyjxCgUv1w2fdmnyLNPHnKb7zxB5x-p9IGK67U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs4AK3Sr8l4E7lCNnwBqPBlVrWx6_CsPDIupP0IPuwJDA&oe=69984F4C"}, {"file_name": "Untitled (19).png", "id": "1163350739239176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_1163350742572509_1268781068700655141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zkd5bPGf2GsQ7kNvwGWkcT-&_nc_oc=AdkzZBam4U2RxbI6OERUxHQVqW7qg2GmcZNb5ZPwsXokm2-4haE8GUs7j-bcR7R9dSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftxEaCmzIIU83RflI4Og9RjgapkRIqu75yTtBhKFjfGFg&oe=69984880"}, {"file_name": "Untitled (17).png", "id": "1183743280378030", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818925_1183743283711363_7476408671346314720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRg7KlM3DoYQ7kNvwHlgxMS&_nc_oc=AdmsccNH8wiqyZwkmFtjetI9U_5PQIJ3Hw5uIvP4reA-Vu6HU4H4kKmQDnGZtyRaQmw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuoViZMIME0h4rjH4DZemzGBck0bJD-LO_jL2i6YBA50g&oe=69984A00"}, {"file_name": "Untitled (20).png", "id": "3535019476637951", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_3535019479971284_1857934205342442483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdJVS40Q5XoQ7kNvwHzHEOS&_nc_oc=AdkzerlRB1nTHFaTLEt4yKR1FYdJtWFmHN73g2ZTbcOoXanUrI9tDjnUE3yUpusKhfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsmeYJYpZFdTUdN0Yw89BBb4W2ePWrAX6XFuxnrTeD3Gg&oe=69985ABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG_Quest_Final_2560x1440.png", "id": "802507252639436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827611_802507255972769_2562386728375614090_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TseHj_MH0egQ7kNvwEmfnBM&_nc_oc=AdmC78hkM3C8KZokUmYWfpIW_nrCHKWbyhrY4eFc3oVb_IXiqur6giPc-BMLonTggCw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftAPpYHD5mWTjyqJmTX4HVqKvVEqAJNtMwDEWgik48f9g&oe=69984A3C"}, "display_name": "Battlegrounds", "keywords": ["multiplayer", "social", "pve", "adventure", "fighting"], "long_description": "**Boring battles are banished!**\n\nThis is **Battlegrounds** - your free multiplayer medieval sandbox where you mine, explore, and fight across the Kingdom. \n\nExplore mysterious caves, pull off impossible stunts, or dive into the madness of medieval mayhem. Whether you're exploring the biomes with your friends or exploding them with cannons, the Kingdom thrives on your actions.\n\n- **PVE Adventures:** Mine, explore dangerous caves, and take on Kingdom enemies together.\n- **PVP Combat:** Fight your friends with physics-powered battles. Fling enemies, strike from the skies, or outwit them up close.\n- **Dungeons:** Randomized maps with exclusive loot & new enemies. Fist bump friends to party up, find rare keys to enter, and survive together - or spectate as a ghost if you die.\n- **Team Deathmatch:** Squad up and dominate in organized chaos.\n- **Unreal Movement:** Grapple, jetpack, dash, and climb with unmatched agility. Master momentum for aerial chaos & mid-air flexes.\n- **Unleash Chaos:** Crazy weapons, wild gadgets, bombs, bows, cannons, and fireworks - all at your disposal.\n- **Private Servers:** Your Kingdom, your rules. 24 hours of total control with your squad.\n\n# A true warrior doesn\u2019t just fight, they flex!\n\n- **Character builder:** Customize your look & your loadout.\n- **Mining & Loot:** Gather ore and hunt bosses for rare drops. \n- **Trader:** Take on challenges to win rewards & drip.\n- **Unlockables:** Spend gold on cosmetics & new gear.\n- **Limited-time bundles:** Grab exclusive looks while you can!\n\n# Join the Kingdom\u2019s council - **discord.gg/bgvr**", "short_description": "Battlegrounds is the ultimate medieval VR playground where you mine, explore, and fight across the Kingdom. Party up with friends to take on dungeons for exclusive loot and deadly enemies OR fight your friends in the PVP zones - the choice is yours! Master physics-powered combat and wild movement across multiple formats from PVE adventures to PVP chaos to Team Deathmatch mayhem. Choose your style of chaos and have epic fun with friends in a living world where every moment is player-driven."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32693952413584562"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823812_1360771472094884_2112416187150428108_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsvUGQm2tBUQ7kNvwFZ9Tpo&_nc_oc=Adn2NwB-W0WoyrGwDmLn5be9rQm_x4REiwV-EPSFjqTk_qLVa8bVq5X605e2SfohLqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvgPP9UsKK2aiaCA7KDHfqkpQw7hNWrm2x4rwnCSl1q2Q&oe=6998621B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battlegrounds", "platform": "ANDROID_6DOF", "context_category": {"context_cat
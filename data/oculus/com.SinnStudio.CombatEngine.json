5854_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpDSFU1btNIQ7kNvwH7aTkp&_nc_oc=AdpfZP7rpHq4fiwcQBQ8w_QCpXua60jSUt2tMUH4YM36CDHhxq0ZsPtZcgGJx11TwdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1gSxt7RHQx2_Ywz2SqNBSstgaHKpRV-zoCCefhd8y8aA&oe=69F0A3CC"}, {"file_name": "Untitled (19).png", "id": "1163350739239176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1163350742572509_1268781068700655141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdOU4Lvrt3YQ7kNvwHowUmp&_nc_oc=AdqrrYFOqYoBHXIVCnEz08zsJ0hNAug5-D3z9HwNJ_xpspjFzJjy6tpfKkpxUVFGYxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1-Rx3axrJwk-2q0mCV0NvYAsrSmIRFn-EDUX2Vd1faMQ&oe=69F09D00"}, {"file_name": "Untitled (17).png", "id": "1183743280378030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818925_1183743283711363_7476408671346314720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG77GvKGPekQ7kNvwGAXIig&_nc_oc=AdpHV_8LZfqUfqLyvC56z09JQ3PCnWRmqiyQnGGB9gPHtjozhyZoa92tftPE8EiP2gU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0FjVZyRovAjhujf0O8BoLN2GgmXS6ujJOy_rZVV9LmOg&oe=69F09E80"}, {"file_name": "Untitled (20).png", "id": "3535019476637951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_3535019479971284_1857934205342442483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouNjK6c-qeUQ7kNvwEi_v3B&_nc_oc=AdoGoBE5A4SetFe4Hlu8ZNtCDuQmEePyb_dop_egvi-zzCUNXN6LH4B1maxcqp63ouY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2E8yarg3UsW6pOS_viKCk9FCkR5rZaU_Bp3cMMpLM0bQ&oe=69F0AF3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG_Quest_Final_2560x1440.png", "id": "802507252639436", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827611_802507255972769_2562386728375614090_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKW7PyMJgQMQ7kNvwG8j6JR&_nc_oc=AdrRYq7ZNoMfXnL2mtmkGynUX0jLjUP1nO5CJlP4Ywh6Br-Wt_5Y2JlqsuJ2XBoELA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af23dIcZkwY034VRFC0NSwsPvFGzu3cy3JDSsXsQJAzRJA&oe=69F09EBC"}, "display_name": "Battlegrounds", "keywords": ["multiplayer", "social", "pve", "adventure", "fighting"], "long_description": "**Boring battles are banished!**\n\nThis is **Battlegrounds** - your free multiplayer medieval sandbox where you mine, explore, and fight across the Kingdom. \n\nExplore mysterious caves, pull off impossible stunts, or dive into the madness of medieval mayhem. Whether you're exploring the biomes with your friends or exploding them with cannons, the Kingdom thrives on your actions.\n\n- **PVE Adventures:** Mine, explore dangerous caves, and take on Kingdom enemies together.\n- **PVP Combat:** Fight your friends with physics-powered battles. Fling enemies, strike from the skies, or outwit them up close.\n- **Dungeons:** Randomized maps with exclusive loot & new enemies. Fist bump friends to party up, find rare keys to enter, and survive together - or spectate as a ghost if you die.\n- **Team Deathmatch:** Squad up and dominate in organized chaos.\n- **Unreal Movement:** Grapple, jetpack, dash, and climb with unmatched agility. Master momentum for aerial chaos & mid-air flexes.\n- **Unleash Chaos:** Crazy weapons, wild gadgets, bombs, bows, cannons, and fireworks - all at your disposal.\n- **Private Servers:** Your Kingdom, your rules. 24 hours of total control with your squad.\n\n# A true warrior doesn\u2019t just fight, they flex!\n\n- **Character builder:** Customize your look & your loadout.\n- **Mining & Loot:** Gather ore and hunt bosses for rare drops. \n- **Trader:** Take on challenges to win rewards & drip.\n- **Unlockables:** Spend gold on cosmetics & new gear.\n- **Limited-time bundles:** Grab exclusive looks while you can!\n\n# Join the Kingdom\u2019s council - **discord.gg/bgvr**", "short_description": "Battlegrounds is the ultimate medieval VR playground where you mine, explore, and fight across the Kingdom. Party up with friends to take on dungeons for exclusive loot and deadly enemies OR fight your friends in the PVP zones - the choice is yours! Master physics-powered combat and wild movement across multiple formats from PVE adventures to PVP chaos to Team Deathmatch mayhem. Choose your style of chaos and have epic fun with friends in a living world where every moment is player-driven."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32693952413584562"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1360771472094884_2112416187150428108_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdDq9dzzJkcQ7kNvwHNk7-6&_nc_oc=AdqzsGaHeGg6aaJAmbg-IOXic1S66v1J25ge07j1e-5kTcgzadTEEjvkzPTZNL7X1mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1xGu52dsR8iGAxQNQmq8LW_eEkiducDc9Zy4gJ_dxYKA&oe=69F0B69B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battlegrounds", "platform": "ANDROID_6DOF", "context_category": {"context_cat
ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_1469109900818414_4669662775977725854_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A94vv97OaR8Q7kNvwEDvSwn&_nc_oc=AdotPMZuSC6pQ_BX-Y_UKNDpbA7I91gBH-J0NmywVl1PaNYvIv3hpiSCRrZPudOf9Ts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QXkLupzekdIrZuI-AaC-3Su4ezuIBpERNAJrYYkmj3w&oe=6A05BBCC"}, {"file_name": "Untitled (19).png", "id": "1163350739239176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1163350742572509_1268781068700655141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEUoHCxQAkwQ7kNvwEntT2i&_nc_oc=AdpW1HT9vMpo2v4ucUQ7109aBYf2iqNtNqZaDl-UWoAbz4SvZNiwqPZH6OCHhaiD4CQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fytXx-SVEV7FG7p7Z-jVvqENhTTVoA3H8XSwSc8bYFg&oe=6A05ED40"}, {"file_name": "Untitled (17).png", "id": "1183743280378030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818925_1183743283711363_7476408671346314720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUIoIabC_hwQ7kNvwEKKdxn&_nc_oc=AdpDfcjVNWTEUDflSGdLTTooLb4V8rA_C-OR-SQiQRRv6o2_0rlL7vB2tyltZmx41no&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J943DoTytOoOND9qgZTSqNeExbR44XKomLcw1U4BAhA&oe=6A05EEC0"}, {"file_name": "Untitled (20).png", "id": "3535019476637951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_3535019479971284_1857934205342442483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9caXDFmGhsQ7kNvwFfr9a9&_nc_oc=AdpMqLz2aWfSsKQfHjXfechAPHUPfa-4XB9cURvufoGoS0DSRiDEo6U0WBVTa6nfyFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KPEJ-VfkWlNc3UB1E0-CZzZ7kM5DBRcwmYikNfG4G5g&oe=6A05C73F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG_Quest_Final_2560x1440.png", "id": "802507252639436", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827611_802507255972769_2562386728375614090_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0IMll_y7REQ7kNvwHBJsl4&_nc_oc=AdrXWBYQTLIdQTscDhzw-4Sgkg8sfOQGZcSIbrM5Vm_e1TFkQle1GcG-ZUf7KCAOHBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74kyH1jUNF5pNnk9_EwHOcMjz4r4aGhVNBzJLsVuFvdA&oe=6A05EEFC"}, "display_name": "Battlegrounds", "keywords": ["multiplayer", "social", "pve", "adventure", "fighting"], "long_description": "**Boring battles are banished!**\n\nThis is **Battlegrounds** - your free multiplayer medieval sandbox where you mine, explore, and fight across the Kingdom. \n\nExplore mysterious caves, pull off impossible stunts, or dive into the madness of medieval mayhem. Whether you're exploring the biomes with your friends or exploding them with cannons, the Kingdom thrives on your actions.\n\n- **PVE Adventures:** Mine, explore dangerous caves, and take on Kingdom enemies together.\n- **PVP Combat:** Fight your friends with physics-powered battles. Fling enemies, strike from the skies, or outwit them up close.\n- **Dungeons:** Randomized maps with exclusive loot & new enemies. Fist bump friends to party up, find rare keys to enter, and survive together - or spectate as a ghost if you die.\n- **Team Deathmatch:** Squad up and dominate in organized chaos.\n- **Unreal Movement:** Grapple, jetpack, dash, and climb with unmatched agility. Master momentum for aerial chaos & mid-air flexes.\n- **Unleash Chaos:** Crazy weapons, wild gadgets, bombs, bows, cannons, and fireworks - all at your disposal.\n- **Private Servers:** Your Kingdom, your rules. 24 hours of total control with your squad.\n\n# A true warrior doesn\u2019t just fight, they flex!\n\n- **Character builder:** Customize your look & your loadout.\n- **Mining & Loot:** Gather ore and hunt bosses for rare drops. \n- **Trader:** Take on challenges to win rewards & drip.\n- **Unlockables:** Spend gold on cosmetics & new gear.\n- **Limited-time bundles:** Grab exclusive looks while you can!\n\n# Join the Kingdom\u2019s council - **discord.gg/bgvr**", "short_description": "Battlegrounds is the ultimate medieval VR playground where you mine, explore, and fight across the Kingdom. Party up with friends to take on dungeons for exclusive loot and deadly enemies OR fight your friends in the PVP zones - the choice is yours! Master physics-powered combat and wild movement across multiple formats from PVE adventures to PVP chaos to Team Deathmatch mayhem. Choose your style of chaos and have epic fun with friends in a living world where every moment is player-driven."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32693952413584562"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1360771472094884_2112416187150428108_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVvb3RNehSAQ7kNvwGRVmfZ&_nc_oc=AdrGE1U_Gvc6fSAhQ0V4vd6XEDvYgjqCB0q36n5Yq8JgfOEbUf3-FkGyjsRYlZIBOl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TpfM1Pqd28yKtJIrVsOof9tK8WQTvtPeoPNcKeI216Q&oe=6A05CE9
5854_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-F5U2DmPJkQ7kNvwGmldeq&_nc_oc=AdlUykyMIN-7u3g7ECBujQe4tLE8sYPTKrZfbhP3faoIjKi4l3Oyjmav0RfaM5mHXug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftRCQ9uTW5JxDhxJFd4H34YxFcPWgjhZ1ZWE4FLwVzNAg&oe=699D954C"}, {"file_name": "Untitled (19).png", "id": "1163350739239176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1163350742572509_1268781068700655141_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1bxuXm_O6wQ7kNvwH3rtHa&_nc_oc=AdkYXYWNaUgvKXjpiL_I8igz4GpFC0bLoTzByFjZVmuts2XecLnNmzD8FAOIejiidzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs6jqALjj6KpQ2kaT_a-NiPxKvzSXSIMWrZmLH4tarnRw&oe=699D8E80"}, {"file_name": "Untitled (17).png", "id": "1183743280378030", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818925_1183743283711363_7476408671346314720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucadJleTHWQQ7kNvwFZ7wM-&_nc_oc=AdkRiOgv0z86BI0ssAyBgFstNcEwQ4bHJF7MTKgbGjuYb7AvAK6ue3CD7dCGa48Yj-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQt1zOqM-ogVFIeMhSiNoKaSwItZS-PEkz_N4uASBOIA&oe=699D9000"}, {"file_name": "Untitled (20).png", "id": "3535019476637951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_3535019479971284_1857934205342442483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y8fPy9jjEUQ7kNvwFDKnVW&_nc_oc=Adlc8fyaTwIXW_p43VcqetC3zoN-lIy5Im-y63jmBr3PSoxy4TtUYQ5nIHVuPsxnYPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvTDJQlo6wR1mOyhdN1GSalo1Ae1q0kBHh161Ak-PAbTQ&oe=699DA0BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG_Quest_Final_2560x1440.png", "id": "802507252639436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827611_802507255972769_2562386728375614090_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itwYIIhi3hYQ7kNvwECRyA-&_nc_oc=AdnXeONiaNAZuKc-5diYSNR2aFmeWczyi-QMq2r3rn7iHRVZlzfYo1V6tBD-7ikHa0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRLHe2pUgywfmzf09DeSi3fMPjFrmGVv26QiU3ze3ozg&oe=699D903C"}, "display_name": "Battlegrounds", "keywords": ["multiplayer", "social", "pve", "adventure", "fighting"], "long_description": "**Boring battles are banished!**\n\nThis is **Battlegrounds** - your free multiplayer medieval sandbox where you mine, explore, and fight across the Kingdom. \n\nExplore mysterious caves, pull off impossible stunts, or dive into the madness of medieval mayhem. Whether you're exploring the biomes with your friends or exploding them with cannons, the Kingdom thrives on your actions.\n\n- **PVE Adventures:** Mine, explore dangerous caves, and take on Kingdom enemies together.\n- **PVP Combat:** Fight your friends with physics-powered battles. Fling enemies, strike from the skies, or outwit them up close.\n- **Dungeons:** Randomized maps with exclusive loot & new enemies. Fist bump friends to party up, find rare keys to enter, and survive together - or spectate as a ghost if you die.\n- **Team Deathmatch:** Squad up and dominate in organized chaos.\n- **Unreal Movement:** Grapple, jetpack, dash, and climb with unmatched agility. Master momentum for aerial chaos & mid-air flexes.\n- **Unleash Chaos:** Crazy weapons, wild gadgets, bombs, bows, cannons, and fireworks - all at your disposal.\n- **Private Servers:** Your Kingdom, your rules. 24 hours of total control with your squad.\n\n# A true warrior doesn\u2019t just fight, they flex!\n\n- **Character builder:** Customize your look & your loadout.\n- **Mining & Loot:** Gather ore and hunt bosses for rare drops. \n- **Trader:** Take on challenges to win rewards & drip.\n- **Unlockables:** Spend gold on cosmetics & new gear.\n- **Limited-time bundles:** Grab exclusive looks while you can!\n\n# Join the Kingdom\u2019s council - **discord.gg/bgvr**", "short_description": "Battlegrounds is the ultimate medieval VR playground where you mine, explore, and fight across the Kingdom. Party up with friends to take on dungeons for exclusive loot and deadly enemies OR fight your friends in the PVP zones - the choice is yours! Master physics-powered combat and wild movement across multiple formats from PVE adventures to PVP chaos to Team Deathmatch mayhem. Choose your style of chaos and have epic fun with friends in a living world where every moment is player-driven."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32693952413584562"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1360771472094884_2112416187150428108_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLdgcUd62JIQ7kNvwGHPIQ5&_nc_oc=Adl_U5eh0WMlcd4CAcp6A26RnZ7x9259wnuK4d4H-T2dWxDPoqKtWP2PBSjBxiNg0ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuOk-EOd2BNaDRIKdhWOhRgWXSHYZtV7FxzkG2kBnzR2Q&oe=699DA81B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battlegrounds", "platform": "ANDROID_6DOF", "context_category": {"context_cat
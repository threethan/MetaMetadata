n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9BnZNnYhIIQ7kNvwEd8CY-&_nc_oc=AdqlN1Vopae6vdNI4vnk_NMo61_-2_iNV25DHv8KxCxfu2t4bVwPCH0OLbWmz-1HoGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqAnA1WiNW9JZikT3QJvFywFGV6NxZqWAP35hUvtR6cw&oe=6A537D00"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koivCpjnrHMQ7kNvwGrjwsb&_nc_oc=AdpbL3-15Hu26ZERUFzDiQWbnsMgbWjomy-xA6Sha8OPNp1DZjg_g00HQuMnh2VczuE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTKYR4OWs_aSENwRrvb-dTFFpkMfjETXyDrtcZgdZJbQ&oe=6A539F53"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrxLlaB-aUkQ7kNvwG-W9yA&_nc_oc=AdqodDjjckcOv2I5yFAJARCoDizQzElnqWnwA_fVPRn6wmEjJldCY_ZFYAPhE0197Ww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIUp4wlRojgb4TUg3xgRIpNaem6kFxoX8-Uf5XHStlEA&oe=6A539E18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU38GsZsB1wQ7kNvwEAhbap&_nc_oc=AdqlRTfvLoj__FOwRRr9jwG4IlW2alc3wEsqPnL7HvoQ9BgbCb1tYM4C0bIxD81EM-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiBWlpQjJ-fjqkQLMEwc9kXfxKM7GLslIH5r9-ycyILw&oe=6A53A376"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Box Shooter VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481097600, "lastRevision": {"nodes": [{"id": "1783253238618030", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US
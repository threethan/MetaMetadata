scdn.com&_nc_ss=7f20f&oh=00_Af4eyko3g_nywEqLgFQG1-FJbDLjqFx1ZDxem5RVtL3KfQ&oe=6A072853"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwyrRd554EAQ7kNvwGnUZ_8&_nc_oc=AdqSSzTNAeaB4S1HpdqcNJx-eFND75gfVV13otXXbRLSO_Z95tx-oeLatr1x6SxWb38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dceNLqwQgt9V2DuXCxUIC5LXTZ6J10uR5xrBG4jr9XQ&oe=6A073E40"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLGhN1KaYLkQ7kNvwFqhG4N&_nc_oc=Adpe7i7k9E1OX2stWDEiWOGfEMF-ciZoJru0rlhPJiRQVNYvVaNuqllEnkJo1ptBaoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HvFdDRCrrvsakbgWwyg9_ZokJQ0uKMoNt0zzosA73Kg&oe=6A0731EE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUov7gPD4sUQ7kNvwG0NN4d&_nc_oc=Adqx868Rnft2kH7qiEmTFC4BmNY6Hk2PXmkP-bTPDOtQfAxO-CjkLjVJJf1OW7EWq0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Glboxzm7mbjtX7YIntRxnKh_XCQzki3G6VO1T2fMUhg&oe=6A072718"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQVDX_SgquEQ7kNvwECMCp3&_nc_oc=Adre0koHpr1m9xG5cxxKLu6-iLMKB-mxRcswDLfVj0bpiTPLipt4JOvJ7JMq5rw22E0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZZZDoxJOiHqR33PHQkksOWpoTm1bc-0UH-Opa8Emh1g&oe=6A072DA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
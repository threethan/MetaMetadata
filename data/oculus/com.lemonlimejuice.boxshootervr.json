scdn.com&_nc_ss=7f20f&oh=00_Af9f_XYibY6zqnxAabTzUqyFUrVgNgHAtSC--j8YEZfkpg&oe=6A3E8753"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YV4y415jwu4Q7kNvwHDACIO&_nc_oc=AdpbjlkSHLpwe7tgFNhPd44cJVSLo9U_buyWjDtcszXQ27NdtfZfCcBCgrDl8gE2X24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af819quxkaXIoBf_1IGPRLOC5yI0e0E_uNm6CWgTOw8xeA&oe=6A3E9D40"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aImcrb1JqssQ7kNvwGLvqwv&_nc_oc=AdrX0Vr5ABXp1yD9GNL4m3ZmlAeZuXI1vXOpS-hSKfGht5CcVszjaXIi0t6HKwz4Suo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qmHEDEe-u5PVlCu7gG-1wV-tDsqdhL2lzNd8FKSEL4w&oe=6A3E90EE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ych_HRdJlycQ7kNvwEGNAQf&_nc_oc=AdqJSjZjJHob5cIzOdKhe0IntA25fG8tqkei_aef2w7XRdaaaCSTSQR4oA3CMXOIgTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FV5OnskZu8tEKs_A2CGnd39NuIK9IA0sO5qsF9YKlyg&oe=6A3E8618"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyR51U4ktroQ7kNvwHZxSn3&_nc_oc=AdqyoLHUvcZHNe2YojSu0lHbRThpFJyjCaIN4Cy7aT-rAG6m4xRy7R1ASO0ZcKr4xSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82VDG_eWgdkC8FUUZ5z2MobjuCFdeTrT_yIsC5o1XJbw&oe=6A3E8CA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
&oh=00_AQTrCvfP34WjT9vuFf8hBRPbiezsqtwzStyJDQws6-xbUA&oe=6B071715"}, {"file_name": "migrated_image.png", "id": "820307881790273", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-re8s3Sk6FYQ7kNvwE8dBmL&_nc_oc=AdqGSXulgRFltzttxREyv6HlbHqtrBRySSPsqzyE9hoLSj7L-ouYIe-hyrsHJU7L3js&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4S3nE-emyGtDpW4dcLU1ggutHs3eEtLE94CVrzodszg&oe=6B070140"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAN8TokFF7cQ7kNvwGifLcb&_nc_oc=AdoOx0FPMV7fXXVQrAmZ-EykjEss1BMznMccCrRcapdRZ9_jOk_5oaHajqo2QkPEMZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsKnxAfY3gLdpx3y_yCJBhL30ot31Q2zyp2r2mDsmajQ&oe=6B072393"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BJjAu7QKk0Q7kNvwGtQ4Pk&_nc_oc=AdqvcoKDi0GbhuK_AaE9bV2KsbqNY2g6UE8dHzRaTEEFQypfkUCdTo-v0FgQJaRGJ8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl2Gix7WykBkAxz8jFEi1EY3V8x5zX5yP2t57BFJ37XA&oe=6B072258"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnDFR3BGTtIQ7kNvwHi_lBq&_nc_oc=AdoYrOkFzkIcILdyEavp9cksLCHF9Q453RjFg5sn5U7bj2s6K3P7ZDsK-zi5xLjYS4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf8flEkvauAmDEhD2A4zoyoL_cSec8Dek8NmgOpDzwpA&oe=6B0727B6"}, "is_concept": false, "is_test": false, "is
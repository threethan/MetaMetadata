53"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_XmVaalkP4Q7kNvwGWYIFq&_nc_oc=AdnKwf3Por8vMvlGB0gB-kCIrhD_C15jFyAR9zFoms4Ilx-uXoe-5ato7XdRZRS6jZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv0yUcfRRX9XTBwN51vflULrkJy-yN28tgtLxfJYpUyYA&oe=69A81A00"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpTc2cRUbGYQ7kNvwEJ3jb9&_nc_oc=Adkmt5b1zr4liqbV_ykmvEPf_ZZsSYekr4wUYchHHi9YP28sPVwxIv7K6bdZOG3SAtc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfumGpJ560z7ilK9EnIg6-dtuJHsQ_kMTA-2SMkB5GQgMw&oe=69A80DAE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6WWxE-BrHQQ7kNvwFcAHCG&_nc_oc=AdmdxRRSHCtmLu9RCFogEAGRldHh81KbTD3cdVgnuxqM7hh4kvQs_l_uIWSGJU5nlSs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvK1YlIXhB6pvK_QpRpBfe2jeOjzIyachrFV8Eslfi6SQ&oe=69A83B18"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dgRRdmTwkAQ7kNvwFk79tQ&_nc_oc=Adn2Peuard3-BPkkn5Im1ixK_ofYnDAQCw_NmUMA3sFK7kcUuKmf6H0Kqby_nJj-gSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsCjf9-x1ctCjL_HA6VZ22nHfRt41ndH5lnTitCNsQsig&oe=69A841A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PENDING", "id": "679569095080028"}, {"status": "PENDING", "id": "1713173839569444"}, {"status": "PENDING", "id": "1275495710575445"}, {"status": "PUBLISHED", "id": "1095524
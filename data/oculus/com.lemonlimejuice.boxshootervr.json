scdn.com&_nc_ss=7a30f&oh=00_AfzHOLp8MEDxqSw2JR1NAjiVy4T-PJoXTZo2xbgPpGk7Eg&oe=69C53D53"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLqCb33nxDMQ7kNvwEug76j&_nc_oc=Adr3ONBHNZq9J5ehFiP-b1fWIpvqFYqcgwXqJOjLtKF8JjrY9C8gr2S_cmHkl_iTEHs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-LVDPA1Djdu2hZCgd2gdfWEQgDMbiR_9c8Y2sxtgV9Q&oe=69C51B00"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEY4Ut-kfJgQ7kNvwFDiSIJ&_nc_oc=AdqdkWzy41nmb0UjHJU5fp2OPGyOwfd1tIAj4wBJqcSPY48jSjKnZM_lLbcaAUyCYKY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2efw8Wh-UhXQebl4Z0oTtEWCnDbc38IczKTIvl0Ua1g&oe=69C50EAE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8nRzomyqNoQ7kNvwExs4Od&_nc_oc=Adr4Fde-Z75CRZZMBbex-aza5ZVrTHyCyg4Xc90dVUAOcgQ3Z47b8qDjWfqtkYkvNoQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi2rA2QJr2ml1_vXj_r7fbE6PhXpPCnzcu3OxUJXlPqQ&oe=69C53C18"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vO5BX18dWVwQ7kNvwE_c30j&_nc_oc=Ado4VWXW26wEUhsipvypWKSaU2BjQZeZcmdESbx-WI8iGAKidLAdghLCjGDCNhqvCmY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6a209YkJhnoSH9qQYDz97IXMWC6A99_lSOiNxsTLL1A&oe=69C542A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
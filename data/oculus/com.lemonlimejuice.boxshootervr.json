n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnGTFCXOubwQ7kNvwHJHLGL&_nc_oc=AdoVe3JHhLcsLEXUOvIagUbgJT-8d2dPLirMnl9EYbL8TMzE4649s1KMTcCTCVFygYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hd0maEBqjCmSpAkh9b4E9Ud0-JwTiNL3cSv3EAVx3pA&oe=6A19B340"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la_AQTJ0Z6QQ7kNvwE4lF2U&_nc_oc=Adpgs28dbnUAD7mbTvKI3dp-vylwPzReJQAnBCabygttx38_VeDXQJFzDz1oaduI8Tc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tik0j13Td1bCL2JWslMDwsBpw_182cxoFwavPW9EA6Q&oe=6A199D53"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deI1GH3xrdsQ7kNvwE88WFK&_nc_oc=AdqErBii5f0aSbQEc4lOUnB2n-ounaQdL8d1H1Xno9hSKcHVWiVcAa8XtoD6SBlt7Eo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DFl33Gk0bzULT419JEgqoNVzfjDnMy0VYDWZzhzrB_w&oe=6A199C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIStREWrtTgQ7kNvwFx9SfW&_nc_oc=AdqzWy_q1OSzOc51NNkFNJL5uaY_JDgoQ6HAl9chyJrBMe92O4z3H4METB9V0eHG_xU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70tJDZo5SVQ2mLHwem90N0fcGFdt2947wOW6WxLvH3zA&oe=6A19A176"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Box Shooter VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481097600, "lastRevision": {"nodes": [{"id": "1783253238618030", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US
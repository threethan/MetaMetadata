&oh=00_AQQqqtMspw9Gpj8cmpl-NNAxckb9prZelW-CvBF9shjCOw&oe=6AFB3995"}, {"file_name": "migrated_image.png", "id": "820307881790273", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3lUsEaokDwQ7kNvwHNBwfr&_nc_oc=Adq6WjKZvF8O7yNJrT4wu3ssxXqqHqj10Q-sf2wVjabeIHJ7JZF26n3lbbugNDup2y4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5K_x_h4cHA3ImrQ72plOTsXf8vjaEf4m1KCMkUGiOvA&oe=6AFB23C0"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLgYFQUVk74Q7kNvwFiyJfA&_nc_oc=AdpftegVROXAmghjvHfIYXb5IqljQCQF1UEOswd6rAemYUO-sq5SMlcPj1x0PMrEHus&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEYb3QN7ap3x2Azcm2Okpza1v8XjJpgogQo0b_XZxuNw&oe=6AFB4613"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LkQH-n-3JYQ7kNvwEZPxMh&_nc_oc=Adp68kV7r9XuIhNSyLVyHYtiYbD0rTaqjNx7zdtInM3r1KBE2Sb2c6YYyJsahUo9xgc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh3r3gbz0ZteFJa2uHuojJmuOCHmu2tMDWRRi5WZACKA&oe=6AFB44D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sca5VMobxLAQ7kNvwFTE65l&_nc_oc=AdpecrP9YCmxQbgMrNYmDsV7Ew8uK4G7IE3LZdN_PCIR7LTEdPXcJO772YX0TqJV4zI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQD1q8o_gvj0eJ4wECM4fFzN5HkZ6DhnsxvcKGMV_HSg&oe=6AFB4A36"}, "is_concept": false, "is_test": false, "is
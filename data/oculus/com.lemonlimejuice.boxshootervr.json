scdn.com&_nc_ss=7f20f&oh=00_AQO31uA3Ro8zVDd5jmTy5B_0mTIxWx9Untfr-8pRNb3Yfw&oe=6AC7A353"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqD3bJLuzFwQ7kNvwElLhkM&_nc_oc=AdqU0b29dqX4bfFEsNEm6tup05hvaFtIfbV_5jb63OR_95l55-xojbdsgIxnxEjc80k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSpSqUmetXH-fjwMhxW9f-tqWRpFOJwukKA1q08SSgkw&oe=6AC7B940"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPBn_Po7PoYQ7kNvwFmOv0I&_nc_oc=AdoOlqMfZEPQhgo72Y_Gg3C7uWSg5BEKgiMWGOVq6u3hRNBBLD4WW4gNy-p0GYZu8j0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORFm-VRJa31tk9n3ONeNHI6cl5C6oQc9Mi4hHVbrqc0Q&oe=6AC7ACEE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzWh3-i8BoMQ7kNvwES7Sqo&_nc_oc=Adrv64Y_WiXNlv4jCsmUUdX0VIe-e-xQb9-8aRMh0GirVOwSbQSCfpmWiVG_y9Itp78&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPQqAxfCvpcrziu-oNuHR4AMAhuT4zIHXnhd_gUCg8Tw&oe=6AC7A218"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5Xrmhd89hsQ7kNvwHXlKZp&_nc_oc=Adq1DX6CkJmVZuQX_J5ixt8FFs9lNIraj-LqeWu7Ah4Q0-x7dlbzdoADJEYJp0UOLpI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7C5gGB33iWidBjRGRLy_usLIhjAgbWtwOLzdIXlFdxQ&oe=6AC7A8A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
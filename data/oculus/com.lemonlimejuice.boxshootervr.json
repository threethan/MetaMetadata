&oh=00_AQQkeFN2t1efn4EvILmt4HeLnOqSzA0o9gNWMJTCyOWuhg&oe=6B0DAE95"}, {"file_name": "migrated_image.png", "id": "820307881790273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqTZAHvWagIQ7kNvwE2FJ0Q&_nc_oc=Adohtr5X79Pa3jsk-HjtF9unHsZldKiPjnAkcwW8qwAHopJD72tsPCdWke0GlQenPfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBTdzxq9T7Cavw5j7hYxmKFJtDQA8d8CMzG4Qvu9VAvw&oe=6B0DD100"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU7Y7oXGXOgQ7kNvwHk-4cP&_nc_oc=AdpLUgfQ7ucQMOtEZhN7Q0uyJ5iE-DLbLjuzB2ifVEQEabG52bc3Y17__X8S0lf96_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjLrRPJuT_qyUeaRMoLVVLKoPk4iihHhTPxetqhG-v2Q&oe=6B0DBB13"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgM3O90PHr8Q7kNvwGL9oDl&_nc_oc=Adp4L4txeED1BLVUBxQkAxe4bfvlyZVs_NkEie98HExB9ODNIBMyoY2YJ45iNVRlHKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToaxfcy39CuiAT4l3PdLs39aj-ztfQVvAMsazuhPBkhg&oe=6B0DB9D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vBf_bEmyTgQ7kNvwHFnRmO&_nc_oc=AdpUYKWDIg-HIwmn5MO7_ZH2J69CG2Aq5ggYArmY2jHXISUd0nLY6MNw3Jn00gAcMXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUSkTm7joa8BAW3Kty_MoF2bSdOHDWiqf6hd8iogfz-A&oe=6B0DBF36"}, "is_concept": false, "is_test": false, "is
scdn.com&_nc_ss=7f20f&oh=00_AQEgyp1kCmY1SwwBQ9OExG3d1L6q2GTsSWS-HvePzWRqyg&oe=6A882313"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbIhcBArEWkQ7kNvwG2gLYE&_nc_oc=AdqWCmBVz9zkiSTRKhmG4IM511BgxjT5w56fYNf9HdeQZFYYI5bZxDv-3678muJQ5E4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFtRo7i4CN0o08bUrgUxXwamJfS2nNOgdF9lrfhKPhPg&oe=6A883900"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFpQOD-3bjwQ7kNvwEuqxle&_nc_oc=AdqaFFDuHbYkxjXmTU4dwN6NWB-P-U3c9BuAl-L0sgExBp7wezWEES1uuCcE1-VlGqc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_xoalotv_vWk_0UP1bJawwbHSh18nl0ZPwKWrG4bU-g&oe=6A882CAE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IlKXT9CozMQ7kNvwG-Lw8X&_nc_oc=AdqsGrL3KDJisgrtZqpzKYMeQRz2NVnZnOnHM1b45bpagGvwlcrTTXWY6fukllHeoTM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVHebsdxtkuqAdLOc-kftmnA-r3dtxHtnSTOE9jtAVZg&oe=6A8821D8"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQXVQZYWyWoQ7kNvwHXOw4m&_nc_oc=AdrLMQEs0KM9o0eYzWyXyxKmG1BudZ4guTMEw3_2wan47DcJg5noC2An6YL14k06suA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLlAzHU9GoHeDAFlMSr03S81LuweILU69VoinaC2PVGA&oe=6A882862"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
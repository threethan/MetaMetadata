&oh=00_AQSBJ23-HtXsdAnKK__EsBDZjC3sMPksUJEezM9GV0Pa5Q&oe=6AFC8B15"}, {"file_name": "migrated_image.png", "id": "820307881790273", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3lUsEaokDwQ7kNvwGsXyNr&_nc_oc=AdrbMbUYIsVcIdJO-ytmWqTB02mwKhVN8tbRkeHQwxDOy_mp8poS1oEbYPRNI09sVqU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi8J7f8D1XFhjZHsbjHrwG9jbSAaoqYlvMi8smyIdNXQ&oe=6AFC7540"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLgYFQUVk74Q7kNvwFObuQb&_nc_oc=Adr5fbPjkJdJSeyWVYTC1YTZTV-1fcbiBJF-I70ZyPBZswrBZ2f_PMsMiZPniy-si-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqWYUwADT1RetuW-s6U28BvFwGnvMaIOy2b7Xf3sjM3A&oe=6AFC5F53"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCxvNMG37SMQ7kNvwFSnB5P&_nc_oc=Adqsr1q03Brj-a2w8mnhtNVO4NVwcHBIO7HnLOsLwXZkhycezNphpUVFfOry9y8KYtY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmvfI3j9xiARK3NMoaekcEb0rPH0cuT3cE1yfRrK3-xg&oe=6AFC9658"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sca5VMobxLAQ7kNvwFj9fS4&_nc_oc=AdpkpqMYexUng_j-2B3VJfd-kvem2ocmrRz_QtNJP5bLW9rukjjfCjxtQJTECUUFHNU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3WX6RIOBQRgqQKOq7tL78QE_EhIofHqgWVSAZHn2HwA&oe=6AFC6376"}, "is_concept": false, "is_test": false, "is
scdn.com&_nc_ss=7a30f&oh=00_Af2INfeRha9Y3Mftl14Pm0qpoD_A2eRa63I1GGyhu90QZQ&oe=69E78453"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcA5PJuAkroQ7kNvwEEIrqI&_nc_oc=AdrGTXicVt9nQqZxj9D1leP0Kr2gD2T6XzhnRleHovk6eQOGUFh2yc5AUzXwla2UME0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Wg-LjIm0jXgWfjwpl2hgpIR3PsCUr2LWS6zmMR1wd-w&oe=69E76200"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E0PzrueQFYQ7kNvwGeyca3&_nc_oc=AdrTRZ0P4wtlUJeT_IlYTEAoaGkMSZ6hGOEDgERFH86SZlSd7-4-mTxIinbIc8XUVI4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16lwrGqg8w8kYrSCfHt-s5tQeRyhWTORenkqiC0Kk1tg&oe=69E78DEE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvGOhijTPp8Q7kNvwH0nOi2&_nc_oc=AdqDuFbsnT9I3e-eFjkvQpPrSobj930QTLvhHVIY2htE-VYPDw51iiQz2CRybzAL1ko&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37YDxD2p7jTgYqnEjiQ87cfMl5-hoeSw2JikEJETaotQ&oe=69E78318"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPHgMu0LbXkQ7kNvwFFCZj0&_nc_oc=Adr6PE6rNzaN_whxu00mpSvJaK3KfCMA1v7byHGSj61wqPKaIDOaPvEBJmTXdl41DQw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bHyrhSGsQ8rp1YE1myRI-P3rqqDrWBkMTH97iq77Jqw&oe=69E789A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
scdn.com&_nc_ss=7f20f&oh=00_AQK6OuLo7Nz0wk9zXcQXf20D15y69k_yppUF07TwZO5U3w&oe=6AA01653"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNB0D0nEJv4Q7kNvwHaNTSP&_nc_oc=AdrqIMZjSCcomRFnP01_t0GZyvQ28xUg8gbqACFA6CcxE5buFVkdqbvuS5OGTUt1hIk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5R9JD5STKYk4eRZ34pVCRZXa3o8jQy1BB3hHrG848rQ&oe=6AA02C40"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QccmAOur8FYQ7kNvwFW34nm&_nc_oc=AdotPC5IJcDDhrRvG7MD4mExhinA3JO8X4130UtUeYlL0FXjHDjzknRb9PnX1NLDxLE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLftHufD39Xp4Fe20KnDcMuht0qfi62kehwuO9_RmLNTQ&oe=6AA01FEE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMOc8eWmjaIQ7kNvwFtLfkJ&_nc_oc=Adr6SMPUd3_zSUIFAr6EiP2ro8N7s3ZW-GxTP7-ZreWE9rKRG_X7vDnskCIXVK4e8-s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8eL5-2_ELSCKOmMjqjkQJA5Wf5-lLzo5LEpkzKlgbJg&oe=6AA01518"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo5ixel8sSMQ7kNvwFJ43Uf&_nc_oc=AdrjamxMrRasXK48kkdvuusw4S3zLQFJfYF5xHc1hJjKgNIu_Zroi3pt56YQIdlkWcM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5vCAPj21QGpAh03z6H_VO10hrUCH3S0F9o_sUWu6WGg&oe=6AA01BA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
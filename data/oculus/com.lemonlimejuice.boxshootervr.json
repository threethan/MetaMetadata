&oh=00_AQRU3KLsoJUhr8YAxGEY9L82F45eVuMz_MfmXCpgJrLL7Q&oe=6AFDDC95"}, {"file_name": "migrated_image.png", "id": "820307881790273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM2FKd5N6EwQ7kNvwGvykHM&_nc_oc=AdrkVDOGyjnYjeRoq9biHxkOelfRaAQWQy6jT73VDtTqXHNlduzQVSSxWeRqfxkV8Sc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGHHoDe6A0yvyKjaXvXQHRR21N_8uNSYSB5o1NEupeBA&oe=6AFDC6C0"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiPFSvrQpAkQ7kNvwHd55r_&_nc_oc=AdqSa4wfYtTpvXa4EVyQTdAUm9b8LVTe8WAiJ8cbZH-Ds5GQCkAeAiNCOxMPJ3M5TV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMS9hI6xiXBT9zFbzzP0k-vueqO97S_4UQG60VKHAktg&oe=6AFDB0D3"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCxvNMG37SMQ7kNvwFUOzKk&_nc_oc=AdofuuMLGR3CdoTUanJEPbhrmaOgOZNS97DeTT2VpcngReltaIc9rB3aB6A5236eM7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEqxW51n5My7o6B_miyib8xzJn3dPfEDf2B6C_ntJrqQ&oe=6AFDAF98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sca5VMobxLAQ7kNvwHE3Abg&_nc_oc=Ado3yYyqx6_BVUnsXVCeD3kFgzQqraYb4nrBuwMFg0AVHpTpWx7Avt1Tb9_S_nQK1t8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLg9sOPtL7lDH5WkU63o5566XGDjBX4zZZuI8Jza2UMA&oe=6AFDB4F6"}, "is_concept": false, "is_test": false, "is
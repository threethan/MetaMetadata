scdn.com&_nc_ss=7f20f&oh=00_AQA8dwLsuc6ccC96Uk66pKGllhyRzlgUp1zWZft0b6tS6Q&oe=6A637153"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t47LWgME1QQ7kNvwEfGk2R&_nc_oc=Adq_Ar5UWeFgPkzgUESVEMdRV2T9C0Hussn2vPeXw5xxuKHDnyXAfTB20BU0PBb-DXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8WcvvMRjbQJiZEEaUGyUt9__coXbLnOfElQ4wF8fIQA&oe=6A638740"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m38qpl7rfvYQ7kNvwGtm_aw&_nc_oc=AdokXZ8XVUfVSGpAYgZTdUEky21gQhgD6vt3todh9104X_xAVgn89w2AmxMJzlfuAIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3BMCU96pup9HNiU9cMvFrj73E9YQF9lH5zdXl69ia_w&oe=6A637AEE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR_shdSjqpEQ7kNvwGOXVrx&_nc_oc=AdpkHEBpL_6e2kM3uWeMnIJAp1-uN8fItGLuElOE8pOY0NnVyYsCwFnYn6-95q_pjas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe_OP23tMbR_IHtO2j_ucqPJ08Ixdw4NpN5M_fv2KH6g&oe=6A637018"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZuJUp-yDNYQ7kNvwHiO8QX&_nc_oc=Ado_QURmpZN43VQ_PPn6KC6P6P3-AbADDZrRKvyhlT3Nqp4d0mYOPlprAIlTHHLu6aA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUZ6gyYg4fAPh4oPT7cN9I1XN4wWxFxzEUCnR9P6U8qQ&oe=6A6376A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
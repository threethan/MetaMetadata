scdn.com&_nc_ss=7f20f&oh=00_AQOf8rWjr30I9Z1Yvw5RZwl6rRLS3un2s2nSq9Hu6cRBXA&oe=6ADF5E53"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kvc0QFdk_ZoQ7kNvwHQoXRG&_nc_oc=AdqUqqs2Vf3TgfhY8O113bfDFWlZmANbS-BeWMCc8xF7xIDoE7oUG40RCCPAlcaLQD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxd4u2iE2E7pdBe2cY6KUItMB5jp5Awsg9ftyJB3tt9g&oe=6ADF7440"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSboc3tAX_YQ7kNvwGAJKir&_nc_oc=Adq_aTlll5c44G4IDKcUBnbWwUfoTp_dyr6E6ktbXkz6UsilaRQznDfuvG98okqht14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLYQHPw3pkBPTuUotIphgVRmW0NJshYQpTxAp7ZcBCUw&oe=6ADF67EE"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPg9fFU3wnAQ7kNvwFM94o2&_nc_oc=AdridTfJ1LAHaqbwZaPC_xqyaDU0ptzOb11soYb0ccA6pktiVFQ7KjfWH75gdJff1l4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO15yN7pl2fSzmWe843UdStIB3bf2eFY04bjefBPb9rxQ&oe=6ADF5D18"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUK7SyY-i20Q7kNvwFA3TJp&_nc_oc=Adpabp4-myAZBdUGbdn17cFavaWZ30ztcMantD3t1JXFU5TAYQzrhFLoRbieHnK9cIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBsHSZL7cSYQ3btBrKldGrFbX6FriOr84RmnB-xqz4hQ&oe=6ADF63A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
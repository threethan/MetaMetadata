n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBxu2jKKL0oQ7kNvwHvKaL-&_nc_oc=AdoJh5qQ0rs03yro66Qo3T6FwjFmtjxQ0S0kRxW3nhc8wEfc5w-MeFrk6pXLvY1-VQg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76Tg3JkeC3w3P_xgr0v4Ksb1rrrAOg_3u4wmLnZ-P0Jw&oe=6A131BC0"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f5Ccx7EB0QQ7kNvwHXMX29&_nc_oc=AdpfsU_sDbgtGi_nO5qbgGfuio_h0u0tIuF7Lz2tQUVsp1qVR8-9Sco7ahyzgGfxQZk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eh1DZoEDDPeb2H5urEbVP2bjwS0q_KIiAmwJnAWAe6A&oe=6A1305D3"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wReKXWClmCEQ7kNvwFzKGbT&_nc_oc=AdrZaB8a9L9MQfTo5Eu6M87G1kG-Wc8Uy2_xpRZ9e0rA1Fmz-OwlW42g72HOCErAFEA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rk1hTfQPMZXMRFurXOggfAF8m6NtBjiNp_JlZcOoF8Q&oe=6A130498"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PPLg1W7b7MQ7kNvwEixMjR&_nc_oc=AdpZet_MWqTC1BiDLiVFZl_T3RqIEJjxrygS3alwegknHv9d9XkcXsU6r3SHHqG6h_k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lOhQcjXZBLz879R5CZnhNnpBxA3dlRHDZfFEczWBzCg&oe=6A1309F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Box Shooter VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481097600, "lastRevision": {"nodes": [{"id": "1783253238618030", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US
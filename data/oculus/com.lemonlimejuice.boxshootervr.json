&oh=00_AQSrreyZBJG9zSRHLe79pcXVZdXKxFoEN_4PnQXiIp8HCw&oe=6B05C595"}, {"file_name": "migrated_image.png", "id": "820307881790273", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-re8s3Sk6FYQ7kNvwHhg3PX&_nc_oc=AdpkkV8ySXEVGSMIUs9X7lgWlQym-Q0t1GAQHJ9rj_yEA5YJDk4KeFrz-OY27f2Dto8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHbb114-_CMOYR0F-l_bMRsq0NxOSRQGCQMrLEm9p1Mg&oe=6B05AFC0"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAN8TokFF7cQ7kNvwEq3IGN&_nc_oc=AdoqTlAg0RN3cqqX4wxlMLpky2lWwrlHgNUzxYuFJHOBsVDGHQXCZKdmiB-sWXTDGJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ6784RjXp8lOW2WYBJahncMZQqqJJHkuEZ3FK1suBdw&oe=6B05D213"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BJjAu7QKk0Q7kNvwEunVas&_nc_oc=AdrmR9XqEdcNvz1d9ZGG-1PrAsnOk3L0Ryy-onnBZu8isr2SVR4PGKNUEJfUTNxPAOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeEUuhUOVngkIIG-cTUoNlYLlxsTCDOPB91hWbS_WOQA&oe=6B05D0D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K68qFVvRaKgQ7kNvwFfNiKP&_nc_oc=AdobrLX3mlWr3QIu9hgfPjAEsveYFPC8iz_MQPAgsXfbfnwWxvwhbdYl1jaB4ICb9y0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSo6-13Pg8UmnWD3nay-ZmJUdxG54hfPmpUt8OGiUGpA&oe=6B05D636"}, "is_concept": false, "is_test": false, "is
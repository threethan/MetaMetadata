&oh=00_AQSV6Be78t1-fc5vmSjNa0ZGyIqCEKi7pK8cSrTbtka1VQ&oe=6B032295"}, {"file_name": "migrated_image.png", "id": "820307881790273", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsEmdl0TwFEQ7kNvwGu2Jap&_nc_oc=AdpCwFGG_TU9v8cJDq9RJsO4WA5AUPBXSB1QEYl04m3c75ZuS-3f2NPq7qtWCDJtgLs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE4gdZOaboglIO5bGyMiXYm5f6SlkIJhcQ4c4y4N9TjA&oe=6B030CC0"}, {"file_name": "migrated_image.png", "id": "607955956720733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504646_1104781289576619_2123890374735822848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7hnQmokNP4Q7kNvwF0E_km&_nc_oc=AdqIFsB6KACIRVqyLx5e2SUQjukgX_lKPzK8W4RU7hMzJ-6zWzYn1oEYMHmN6UAUzGk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhgV-l1qBkVYrhYMFim0Dirv_k3c4uvXHC-EkWMD5pGw&oe=6B032F13"}, {"file_name": "migrated_image.png", "id": "518161762171805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWacFdtFHnQQ7kNvwEigBsR&_nc_oc=AdrJeExuxWTlAkfXPb5rOVNB3y3BZOLR1l-KHmMbeGrMIBwXNRccqAi-8GwV1t58vgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSi_LRxfQzWO2dP7z77aOFJ2745T5BKGnnnkNpI1IcSA&oe=6B032DD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "464945311901239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680304_1040881602691460_8485016070036389888_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K68qFVvRaKgQ7kNvwGibGdX&_nc_oc=AdoVwdZQFqInO18RApQ_NnZmMXy65kQ0MVXBx-a9WUATflep_EjRI490XiVYiN8XHXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVxqGbdSvra90HbUpvbPZEENqr1mRuzUz0Mlr59L2sew&oe=6B033336"}, "is_concept": false, "is_test": false, "is
scdn.com&_nc_ss=7f20f&oh=00_Af_QcTlXLpyY2vnPcRAVPEsoLyJxpPDGPjQQVmhwcv0Q2A&oe=6A2AC0D3"}, {"file_name": "migrated_image.png", "id": "602058720522109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504812_188823778188896_100646365238919168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Dj9q-NtcgQQ7kNvwGYAAf8&_nc_oc=AdoGiWLE7oGT-_YA5r56tJn5UKZu8LldiEPVfUYz0EOGmGQ2bf8-rIDIqKsr3Jzajww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-utHSiYlLuFt2-ao0F1kDnB8REOSLBdtM9f5YjQ0lFaA&oe=6A2AD6C0"}, {"file_name": "migrated_image.png", "id": "653249562175081", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680423_1737736886550639_1219078011148566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OurIymChpwQ7kNvwHq_WhP&_nc_oc=AdqEwvDS5_55p8ULSPglGsJ0i6TqKjOWE_AtHwcbPnNyB21DM53Wu-1pKfptc4Ema64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pqMLYm3Bp94b-EXqoisZO1BDMTcwSYu_c3LUMD7oSlQ&oe=6A2ACA6E"}, {"file_name": "migrated_image.png", "id": "607807303283549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602295_1786868828246443_5425813806871740416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fj-QkXcayn0Q7kNvwENDGhs&_nc_oc=AdqbVeELptsUm-MN2sOA4Q_AgYf-uqJV9Mw1I1_zkKYSX0HXipqcoOHpTgYqmpnzy1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nW4hDpSgQQg4wRZqp1yRNRQTz95tlwWv7Y2w_QNut0g&oe=6A2ABF98"}, {"file_name": "migrated_image.png", "id": "250375052791506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12482396_1151341141579576_2019874813811621888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCxu2E2TkgwQ7kNvwHBHUsG&_nc_oc=AdpHd8ZSB9ux8VpU6UibUHvJoteIKzHA5RxEQ3A6xumT2kCgk-_OTOLNNtjp9PKst4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wPucsq_V4cMQNVKNZhFicJrI-P6K3LKov4nhD6OPV_A&oe=6A2AC622"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Box Shooter VR", "keywords": ["Box", "Shooter", "VR", "Simulation", "Laser"], "long_description": "Do you want to get a full VR experience but feel like a huge 3D world is too much? Have you had enough with being a \"cruiser\" and just simply exist in a VR environment? In other words, do you want to immerse yourself in an experience that is \"simple enough\" for you to enjoy VR yet enjoy it more than being a passenger? Then Box Shooter VR is the experience for you. In this game you shoot boxes. Green boxes reward you with points, and stars reward you even more. White boxes add time to your experience while red ones subtract time. Your goal is to get as many points as you can while you have time. Its simple, its fun and most of all, you are in control!", "short_description": "Have you ever wondered what it would feel like shooting lasers through your eyes? Now you can experience it! In this shooter simulator you shoot boxes and stars to collect points and extra time! How long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lemonlimejuice.com/box-shooter-privacy-policy/", "developer_terms_of_service_url": "http://www.lemonlimejuice.com/box-shooter-vr-terms-of-service/", "publisher_name": "Lemon Lime Juice", "support_website_url": null, "website_url": "http://www.lemonlimejuice.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SHOOTER", "SIMULATION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "640899647239490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQZ4RaGJpaHImlbWUxt_UrWt1spH8kagUt1brpEJe9AQ&oe=6A7EF4B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2020-07-19-15h38m55s089.png", "id": "736791198517954", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031532_736791201851287_4149678069899420458_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkKMQHw8HX0Q7kNvwHcuOST&_nc_oc=AdowelnE8ClgCJk6Irn61fq4II64hYOWPF904O1U-dZUl027ZsDErtg9EMJFNxPOIh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCD2Cv0Cjo3VQABOg0O2ZW-blF_MxJ5Hld_OIHOFFVFQ&oe=6A7F1E86"}, "display_name": "EscapeVR: The Basement", "keywords": [], "long_description": "EscapeVR: The Basement is an 'Escape The Room' genre game which was inspired by real-life escape games and written from the ground up as a room-scale virtual reality experience.\n\nExplore the environment, solve puzzles, discover useful items, investigate clues, and find your way through a total of seven rooms in three areas to -hopefully- escape the basement!\n\n- Solve over a dozen puzzles, which includes smaller ones like finding keys or codes up to large ones which involve complex interactions with daunting machinery.\n\n- Explore three distinct areas with seven rooms, a total of 130 square meters, and more than 200 items to interact with. The game is designed for room scale and features a teleporting system.\n\n- In case you get stuck, a built-in hint system provides you with clues. You\u2019ll also get in-game statistics about your performance, and there are achievements to unlock!\n\nWill you take on the challenge? Will you manage to escape the basement?", "short_description": "You find yourself locked in the cell of an unknown basement with nothing else than a bed and a toilet. Can you escape? Explore the environment, solve puzzles, investigate clues, and find your way through a total of 7 rooms to -hopefully- escape the basement of this VR escape room game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.escapevr.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Five Mind Creations UG (haftungsbeschr\u00e4nkt)", "support_website_url": null, "website_url": "https://www.escapevr.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "ru", "zh_CN", "zh_TW", "zh_HK", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7537689759601100"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1026541550240228"}, {"status": "PUBLISHED", "id": "964012279847081"}, {"status": "PUBLISHED", "id": "1642001543704230"}, {"status": "PUBLISHED", "id": "1197874822232678"}, {"status": "PUBLISHED", "id": "1832866934098668"}, {"status": "PUBLISHED", "id": "873482255477761"}, {"status": "PUBLISHED", "id": "1360798705846718"}, {"status": "PUBLISHED", "id": "825910123386013"}, {"status": "PUBLISHED", "id": "1151631697035055"}, {"status": "PUBLISHED", "id": "1330195822086268"}, {"status": "PUBLISHED", "id": "1232601471488989"}, {"status": "PUBLISHED", "id": "1231925641832636"}, {"status": "PUBLISHED", "id": "874629308022513"}, {"status": "PUBLISHED", "id": "1238728667189047"}, {"status": "PUBLISHED", "id": "451382081308670"}, {"status": "PUBLISHED", "id": "1750392115704770"}, {"status": "PUBLISHED", "id": "1673636633426873"}, {"status": "PUBLISHED", 
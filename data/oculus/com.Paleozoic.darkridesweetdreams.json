LmeGBPA&oe=6AF5EF4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sd_meta_thumb.png", "id": "1848539072526913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821716_1848539075860246_6378055504840272013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5UniZdAtmkQ7kNvwFlepEJ&_nc_oc=AdqpH_X-q7uk4vnau8p915J3IyOrw9MdrgEr2o0uMD7C6y0MInP6aROpHXN8YZ-wDYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFyNylru4sPAfWwd4q0o8Yz6pLdKv_i-y5dAfUiNvfnQ&oe=6AF5E23B"}, "display_name": "Dark Ride: Sweet Dreams", "keywords": ["ThemePark", "Theme", "Park", "Cozy", "Cute"], "long_description": "Dark Ride: Sweet Dreams is a theme park\u2013style dark ride cozy VR experience. An indoor attraction where visitors travel through themed scenes that tell a story using immersive environments, sound, lighting, and special effects. In this version, virtual reality enhances the experience, fully surrounding riders in a dream world.\n\nThis ride is only a small part of a much larger theme park built around deeper lore and hidden mysteries. \n\nEARLY ACCESS\n\nDark Ride: Sweet Dreams is currently in active development.\nThis version includes the core ride experience, but additional scenes, features, and polish are planned for future updates.", "short_description": "Dark Ride: Sweet Dreams is a cozy VR dark ride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://presskit.paleozoic.com/privacy-policy-sweet-dreams.html", "developer_terms_of_service_url": null, "publisher_name": "Paleozoic", "support_website_url": "https://discord.gg/HjhwQr5gdU", "website_url": "https://paleozoic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_
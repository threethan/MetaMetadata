c=B9bA05UAym8Q7kNvwHhtXiY&_nc_oc=AdqhBnblWZh7BVQOxFeQ7T4LODhCjRV6aUa1sbZ6MrT9Uk2nv6Q0Kb9floCA6qFoTWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4GUgDW27lwtyuGvT2dfRThtzhzzQbn6PkVMEu__OUOg&oe=6B0066CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1630309695437409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305071_1630309698770742_6986779961555736353_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZbuGAkWpokQ7kNvwGbeF70&_nc_oc=Adq0jmfEu8z__BmJCJk6QaFwlOmAIsb-OLllahYPbFXDrMhQ3DAYWQN5wCm0o7wHQdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3n3rJF0ixbbyZ041lhrHi0bXEh2AoH1WFjIT5xCZ4oQ&oe=6B006DE5"}, "display_name": "Flight Simulator Melbourne", "keywords": ["flight", "simulator", "melbourne", "australia", "jet"], "long_description": "Flight Simulator Melbourne puts you in the captain's seat over the real Melbourne.\n\nTHE REAL MELBOURNE\nEureka Tower's gold crown, Australia 108, the Rialto, Collins Street, Flinders Street Station, Federation Square, St Paul's, the Arts Centre spire, the Shrine of Remembrance, the Royal Exhibition Building, the State Library and Parliament House.\n\nTHE BIG GAME\nThe MCG and its light towers, Rod Laver Arena, AAMI Park and Marvel Stadium.\n\nTHE RIVER AND THE BAY\nFly under the West Gate Bridge, over the Bolte's towers and up the Yarra past Docklands and the Melbourne Star. Ships at Swanson Dock and Station Pier, St Kilda pier and Luna Park, Brighton's bathing boxes, Williamstown's timeball tower.\n\nGEELONG AND BEYOND\nAvalon, the You Yangs, Werribee Mansion, Geelong's waterfront and Corio Bay.\n\nA LIVING CITY\nTrains on their real lines, traffic on the left, yachts and ferries on the bay. At night the CBD lights up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar by Albert Park Lake, the skyline out of the doors. Repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nMelbourne and Avalon approaches, a hop to Essendon, the Bayside Run, under the West Gate, a night landing, a city tour, Geelong, an Avalon scramble, Melbourne by night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Melbourne and Port Phillip Bay: Eureka and Australia 108, Flinders Street Station, the Arts Centre spire, the MCG and the Shrine, then fly under the West Gate Bridge, down the bay past St Kilda and Brighton's bathing boxes, and on to Geelong and the You Yangs. Start in your own glass hangar by Albert Park Lake, talk to air traffic control and land at Melbourne, Avalon and Essendon."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatormelbourne/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatormelbourne/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1388485364347999"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
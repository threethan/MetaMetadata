528727_3456431230944719156_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zbtw4KAFHv8Q7kNvwHvND2m&_nc_oc=AdrGqwXbujkYepyya3MosU1ijvuN_2p7ITTPeryioDkqGpEdB-k_Q4jfXA2rXiFx9v0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7reAdVSqQWjX6B0UvZyOWwajBJ20oDdGDRyafJiVynHw&oe=6A04983C"}, {"file_name": "Untitled design (3).png", "id": "1345798587300707", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_1345798590634040_8075421249825125135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWo38eKS-uUQ7kNvwF5UsX5&_nc_oc=Adr9JVBlVBAjhGrL8mLUAfTytoQsGyDqlgZQ4te332K4rOpeVpkxSAdiXVl0dqooj5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w38LD_h8cWgvxyr397virvCe6cFSOCXwNCx8uXVwyUw&oe=6A0497FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuperiorTag", "keywords": ["Tag", "Runner", "Running", "Project", "Chrouser"], "long_description": "SuperiorTag is a fan-made VR game inspired by Gorilla Tag. Swing, climb, and tag your friends in fast-paced multiplayer matches. Explore new maps, try out fun modes, and test your skills in chaotic VR gameplay. This is a fan game made for the community and is not affiliated with the original Gorilla Tag. Jump in, move fast, and see if you can be the ultimate tagger!!@", "short_description": "SuperiorTag is a fan-made Gorilla Tag game for VR. Swing around, climb, and tag your friends in fast-paced matches. New maps, fun modes, and chaos guaranteed! Just a fan game, not the official Gorilla Tag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/supperiortag/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Chrouser", "support_website_url": null, "website_url": "https://sites.google.com/view/supperiortag/website-main", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
-made Gorilla Tag game for VR. Swing around, climb, and tag your friends in fast-paced matches. New maps, fun modes, and chaos guaranteed! Just a fan game, not the official Gorilla Tag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/supperiortag/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Chrouser", "support_website_url": null, "website_url": "https://sites.google.com/view/supperiortag/website-main", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26194539336805858"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821725_1930755264521936_5524994976767334710_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ablCC6pWVuQQ7kNvwGYxX6x&_nc_oc=AdoffY18OnRMGflZTlwZ4VAW9mYQYOumNhx9FmHdd2qFez0s3UzIL5R8J75oytiYrXc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-6MHzKhzbIET7wN--2-GAFoFrR_BoFgGW03u_nibB6w&oe=6B0B33F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SuperiorTag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1769648340, "lastRevision": {"nodes": [{"id": "26080959724830487", "r
528727_3456431230944719156_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbB389y-2TYQ7kNvwEmqPVI&_nc_oc=AdqEW80iM47MMTvZv1yqKr-gPPnCgct6LYQToCtZByuggcYomJSVTkJZOqLQifKSKfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ktnY34dNZO-kKfGDRKUfQalMCRnOf1wCYogy-NpQ_9g&oe=69F8BABC"}, {"file_name": "Untitled design (3).png", "id": "1345798587300707", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820855_1345798590634040_8075421249825125135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9za8h-5Q1IQQ7kNvwFQ-Fnt&_nc_oc=Adq-uflVV-T8LgvlJDSbprxQVp1yDurhjV6eDG4cLE3YP0wGt6rrz0131Pp5TNEp5M8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3R2EdudoSaqbKynmnG6mOtpQts_FkMxxM4zyINCA44lQ&oe=69F8BA7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuperiorTag", "keywords": ["Tag", "Runner", "Running", "Project", "Chrouser"], "long_description": "SuperiorTag is a fan-made VR game inspired by Gorilla Tag. Swing, climb, and tag your friends in fast-paced multiplayer matches. Explore new maps, try out fun modes, and test your skills in chaotic VR gameplay. This is a fan game made for the community and is not affiliated with the original Gorilla Tag. Jump in, move fast, and see if you can be the ultimate tagger!!@", "short_description": "SuperiorTag is a fan-made Gorilla Tag game for VR. Swing around, climb, and tag your friends in fast-paced matches. New maps, fun modes, and chaos guaranteed! Just a fan game, not the official Gorilla Tag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/supperiortag/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Chrouser", "support_website_url": null, "website_url": "https://sites.google.com/view/supperiortag/website-main", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
95653409822_4440219207300284416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1d3qXPerCYQ7kNvwGaAQXs&_nc_oc=AdmZEXxFd-53ogsnhIZmV2VV-45vATqqxtIBx3_x0J4C4OpXTG0fnsWKpU9OIcHak7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDEweWpceRLGOMEW1r3jsgs271AfaQZALA72maWsX8Eg&oe=69B02BD1"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drUUFnrrXHcQ7kNvwGFtHpO&_nc_oc=AdlunB2KzamWqVWS4XF3H3MyZYX5J7B9KYP1XjRp1cyrw3mUh2WHb_oUQOK-8aF6_fI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr_-ULVBWu_zK5SePqtzCXrSUyc3ANEgGj1nJmy8X32Q&oe=69B00E87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwGGQflU2IgQ7kNvwF3c1BJ&_nc_oc=AdlmPFeL9iK618l895_PTST09R2wZvSzG5yfJbAlAsIY_9ME0nMqfQR9WfLdMtCa1ws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0V6qa_SMJJMIF59_i2pfwtLSaTQDxh7tVKXd3Cz4j7g&oe=69B00F11"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatur
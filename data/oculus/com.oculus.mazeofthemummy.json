95653409822_4440219207300284416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUxHdiviNtEQ7kNvwFxbrt0&_nc_oc=AdkiUA7wuAF2FtzglhzTwT258E-l8XsouHvtbYTpUU9tHKYEg6V6MsBwwCeEQp-X8f4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyANxPU-NLdguElHzvvJqiUKfpKcQ0nT3JaK13ZpYCopw&oe=69B814D1"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNLCb8zsFTUQ7kNvwG6CHJ8&_nc_oc=Adl6azF5_YFpu81G3W2y2_ji-LXjyPYJQm9sxe1x4RxL65yr_R0vVVCb_ljnu9hB4CQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxcCE0YNPrgHcl1_CjjyCMOvHHYi4ypUgsB0ucDhuLu3g&oe=69B7F787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14VY3hxKRAQQ7kNvwFJvZXF&_nc_oc=Adn4B1rmvs6WZuqCDI6qz7CBbQKQDd1_AshjoY-ofwKxrEZVU0RqTK783uKDjGGqNXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkTDzXLxuTumy9xxN23MqU5h40btrsBvwdkCP9OBlHeA&oe=69B7F811"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatur
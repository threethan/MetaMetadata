95653409822_4440219207300284416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUxHdiviNtEQ7kNvwGKSzN3&_nc_oc=AdmpEWYV2q2GfsjYZ5eAt31yoXyFa3bWe8CF-0RbMbSaJO2LmXJb_jKpYyk1xU8rBWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFf-zEIgO4WDk-4NEy8qn1hmPg80s-m-Koj9z9Deng5w&oe=69B96651"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNLCb8zsFTUQ7kNvwFN1eAF&_nc_oc=Adlx9TLJj3NI1rAYnk-OOFyfXpeMdOIUstW49hORK8g5MdqJXd2GSPrcQHdukJConSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzg9qSh3NxPMWEqZixiuMKnbUz-qHJQ2ZlPSiMtx9gceQ&oe=69B94907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvBo2Om0cRsQ7kNvwGv8tCT&_nc_oc=Adl-3mZhu0j_k7tGbhqIRK4-JLgvimJDcXAK_xZhtQ3EDHIAutAPkk3xQW7KY3plovk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx10qeWHBHFf6q3Nori3yg3QTrmbOhGoHxrTtSIW_CMuA&oe=69B94991"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatur
NFgjPXOmqB9SAig&oe=6AFDD2D1"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lebersoftware.hu/index.php/pages/policy_mazeofthemummy", "developer_terms_of_service_url": "http://www.lebersoftware.hu/", "publisher_name": "Leber software", "support_website_url": null, "website_url": "http://www.lebersoftware.hu/index.php/pages/mazeofthemummy", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1377811879321611"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "111995609490830"}, {"status": "PUBLISHED", "id": "137235180314377"}, {"status": "PUBL
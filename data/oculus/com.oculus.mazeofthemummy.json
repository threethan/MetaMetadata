uscdn.com&oh=00_AfsQXTtgb9hYvXlw_AKsyNf_llveV-DgTK02qFzpxrPFeA&oe=6999C251"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oZTnFdF6VwQ7kNvwHONtwU&_nc_oc=AdlpbVgdzIUsKIAu-GVLXvNulV0pnJWAlrBOHqnAPXt4z5VYeYNQ6BHA9Yl_jvncLu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvA7fn518c7Kj70zdn51ZHR-Vm4T_jmNm0ZXsqkR0TXgA&oe=6999A507"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viB5NcoqFX8Q7kNvwEPLWiu&_nc_oc=AdmNOxIeP-4ksdqBJKuc64v3PQmXwdzDL5xRpgoNHI079WwJAdPN8qQ-GG23gjiUWqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftoSMf3hRTunfa9OwQJPsagy2Wd8bLpRXr-63jMwtSUVQ&oe=6999A591"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lebersoftware.hu/index.php/pages/policy_mazeofthemummy", "developer_terms_of_service_url": "http://
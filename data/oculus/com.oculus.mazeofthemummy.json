95653409822_4440219207300284416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWd-XZH1CusQ7kNvwGoyce8&_nc_oc=AdkSTdFenTyBZNfYLMOvc3NCFav4dDrvwAXHC78Z3uWXz9P5CPM5ZMbiDEjtxG4nmRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyT9qjhheqUQn9dHGDBMEr5MOpMNo-ZAhAZClnRHyCuzQ&oe=69BFFDD1"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMI8IK0stHAQ7kNvwE616Aw&_nc_oc=AdkEsciBAqeZT_qgs9fIInfsSmdsshlMq7SO-gsqMpsvRms2t5F7k-LCYrZ1QRgDmtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcU-gRkYA_1BPFxTURpSYIjqFHxyEb580I02d00I3Q3w&oe=69BFE087"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miOW-zhcm1EQ7kNvwGhY2O4&_nc_oc=AdlMnPzmwU3QCDh8FadPnM5OzRlku77lX-V1ranFMlmAtz9_cSvffmitoUOjzuJPwbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4DnwnLg4SVj6NuDqZz1oUZPDEnxxjPN6hEIQrdo6miw&oe=69BFE111"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatur
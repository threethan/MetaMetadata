95653409822_4440219207300284416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeK8TuEwDXoQ7kNvwH5IX1j&_nc_oc=AdlwM5wGOd3nFThCl933qTwNi1thRGibmezaRVQTl7maAxr8pfSl6KNdk64INKGUqjs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcsUK2g7C4oM31r6KI-bvDsIOsy-11WqHmjCIR-x1O1A&oe=69AD88D1"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSig3Dat-mYQ7kNvwF6pqQN&_nc_oc=Adlyt6xvJcYaBmxTQl8BSrhkMROOhfdwmaUcdRopMqDFh6vrIFpOsgACcpJG_lyjJjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0rI5JuZIzxvjViHsHVsuca7Zd2DmGmbiTiooiQ_fEKQ&oe=69AD6B87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwGGQflU2IgQ7kNvwHTRbXG&_nc_oc=AdkH9mpfmeQNagDQ-NE7IcAiE4MunzO7VS3V9iHUkhP737tJ_3t8sNZxveFgKky4WLc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwnx1E_l-yWA-rBcNVoV1K-NQm6uuxX4UUjOMG14T3jnQ&oe=69AD6C11"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatur
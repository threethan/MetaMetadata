95653409822_4440219207300284416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUxHdiviNtEQ7kNvwGBVjyO&_nc_oc=Adkv78IOuwVcsqtP5v0OxqBaaZ9adXKVw2sZAalUVf_T8X7GToA_We01XyBARUbE5Dw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoOPLRIqrbWCMEEmuPt4jFJwaFPeYNUYiTQRTHUt7CJw&oe=69B68B11"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNLCb8zsFTUQ7kNvwGY4Y8x&_nc_oc=AdniOzZ24ejbzXQ6wROYhBFS5JGXEWW1qefJ66NHODV4xxIfTM-2io36ba8RXrv0Z7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzY5E5P9ntzo6xGs0Z32ZbuIlqA_aHEVT-o4WojGPf28A&oe=69B6A607"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14VY3hxKRAQQ7kNvwHeuTr5&_nc_oc=AdkR1qVCB9jxDA4K3dVLgosHv0l2jwg3Bh5bHh4PWLNWZefNiBDFBIn7XYk9lPXVXHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKYZ1lCUeQlyCDWPSQrK3E-6DFLNNZo_4WuC_j6iUraw&oe=69B6A691"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatur
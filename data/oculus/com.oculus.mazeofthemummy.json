95653409822_4440219207300284416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWd-XZH1CusQ7kNvwG3j0TN&_nc_oc=Adn08i9kFpBZvYKFouJhG-xtUPCPRKFo2eSD2wsxjnn8EbC3gD19jBEgdeatADuyWJQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYjGRaSK6ON_23JmkNLUlkQCSQYSSz1Vns8GY0hJR_dA&oe=69BEAC51"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMI8IK0stHAQ7kNvwFwxfqO&_nc_oc=AdkVG3wbNii7u_86JUp16l07v-64CWia5yod7HSZGscffzUtcWaHXSV7czf9sTwQ52g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOOEaxyeESI4xVcnPBsO6pICKWqmeEVodtNDzmKc2Scw&oe=69BE8F07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miOW-zhcm1EQ7kNvwHEyUvD&_nc_oc=AdlTOEiFcM4n_RIXqGn6V8FHBis9ATvo0Bp5fnaGDz0XrOaRlvEP2rpVDOeDg8Q6A78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWYogP1bMmd7XUci7Na15khS7wQxp7rsLU0s9Hr7Aiiw&oe=69BE8F91"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatur
ver_2560x1440.png", "id": "786759052144913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269160_786759055478246_7374121386183275495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_R_azUu7J4Q7kNvwEYK3iY&_nc_oc=AdrEh0UkeQSaLXjzdrIK1duta_zOUvx8T3IBi_KuY-Y76K3rtgtCV-1lodi9ThgQXNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPJ0Es2w1oImLJJ6vcY9kEGcJ4lQJkQ34SfpYMcLyY2g&oe=69CE7A6F"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. ", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lebersoftware.hu/policy-mazeofthemummy", "developer_terms_of_service_url": "http://www.lebersoftware.hu/", "publisher_name": "Leber software", "support_website_url": null, "website_url": "http://www.lebersoftware.hu/mazeofthemummy", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPA
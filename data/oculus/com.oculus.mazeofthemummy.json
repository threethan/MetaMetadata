95653409822_4440219207300284416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t09Q1pFlV_AQ7kNvwEKH5C1&_nc_oc=AdllvCYM_J8zglwAUVjcOjXdwBxE_auwnNk-OgiTDZvCwOKYCmE-DvNViX9MuHHlROs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzVFK2vi-GacWtK34dCopuaBe6hp5BjQZyBwA6MLdFyyQ&oe=69B53991"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyRh7o57I6YQ7kNvwFd1474&_nc_oc=AdngZ7IRPU6b91t7wcCYAX9d8KfHOX7_tG9q_3wuyHyrgvhvwSEWZGMMKFS_eV8igxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKFcJmUUQXWg2DTOAapNBIq6-PE48h_XWYWiuiVedJYQ&oe=69B55487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14VY3hxKRAQQ7kNvwF_N-VD&_nc_oc=AdnjC2SbnYFYUQcL6od1ZnJ-vjCbrREUGyYZxUqOQM8YZit1vYQ-Go0tqQyykMw1IQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfypHDHo1i-CcmUbziSo8ZTuCaQ0pQIC0pvixJQX6NeTNQ&oe=69B55511"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatur
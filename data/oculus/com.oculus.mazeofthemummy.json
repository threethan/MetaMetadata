uscdn.com&oh=00_AfsEgSp2alvZ2aws_-2K-PEBNO0fnRSjuEmOwOtvolgDfg&oe=699B13D1"}, {"file_name": "migrated_image.png", "id": "206162653995656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_292650861202886_5097912432714579968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y59uNeSK4UQ7kNvwHEblmH&_nc_oc=AdkHhL8rcn71bfYXi-NAL1E9Vo_LJBafwnOI3LOLUnl3VEGBLMjPLe8pfBDpDL8kaIY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftadjwjS-1zaaSQCiLApk-UlDjm5jbb8LTSn6huhsaorg&oe=699AF687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vide_tn.png", "id": "118437942146160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162694_118437945479493_6916320221980524544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viB5NcoqFX8Q7kNvwGiPs47&_nc_oc=Adm9f-Y0Fq1DShN7MpX4BouO3smHYCSzkl9uCKMPt7dlS5xfUjgS5DxnRuDCamn0EUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsdTrgbK-6LGZJglS-sTVNeK6-blB5Rr2NQpN5w5Q4O6Q&oe=699AF711"}, "display_name": "Maze Of The Mummy", "keywords": ["mummy", "maze", "scary", "horror", "traps"], "long_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid. You will find traps in the maze as well so it won't be an easy job for you to collect all the treasure and leave the maze. The maze, it's size, the traps and monsters' locations are random, so you will be able to play the game in many variations. The game is avaliable in the Oculus Gear VR store and android play store.", "short_description": "This is a VR (Virtual reality) maze game for Android mobile phone, where you should collect treasures while several creatures (Mummy, spider,...) try to catch and disturb you in a dark pyramid."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lebersoftware.hu/index.php/pages/policy_mazeofthemummy", "developer_terms_of_service_url": "http://
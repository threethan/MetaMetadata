825546_929710556823574_3401111493303329318_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrsCTS6l5VYQ7kNvwGeS1ff&_nc_oc=AdradDoLzGW21YbP0mPtxqiQFaKhn-3JdUn5fA-ET9jOub5ntFZfu3BLOYLNh2FVnhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8Vj-2v39_NxFphTOLCHcyDBALzHg_ACrpmD7xXMhhow&oe=6ABA8BD3"}, {"file_name": "2.png", "id": "1618742889819069", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_1618742893152402_8534240052556586669_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCWktZHNDlUQ7kNvwFHWdhg&_nc_oc=AdoGvGUS1NpvFbbz7assgBIfmvhXiciTH8inyv8c0Rq_KK4tJUzD79KTSayMmACwSro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYtV1ooN57b1GRe9jUkf-kzqP0Mncv6Pi3IVVjlOrw7Q&oe=6ABA7FF9"}, {"file_name": "3.png", "id": "2021080868511766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_2021080875178432_2256771341137546710_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5sDtx3Py6oQ7kNvwH08lC5&_nc_oc=AdpGxCXFfC2rxx_fDELXBto33Mg5kswTIXseXgUZ8D9PBQvr_NhLKJvw4YpIXgSDATc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFhb99QrOg1Svg5RFuTIZSY7PtwlNf5ZMrF3qzWVrqcw&oe=6ABA64D2"}, {"file_name": "4.png", "id": "1042918571773814", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_1042918575107147_6412836705770127068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUZLAFDEa6YQ7kNvwHdXOT7&_nc_oc=AdrY8QZvVm_OYtD23Ie_cxe5IhrQhy9bXjxJpDND2ZmZBd-3DO-_4up2d8UFbAeEFTA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbvsCysoB-DtwtL2MFA-QuBjVmjTbC_4Vqd4v8tSSQBA&oe=6ABA5A73"}, {"file_name": "2.png", "id": "1619709426445114", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_1619709433111780_2647532077683347409_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMkGPID3woMQ7kNvwEFRNsA&_nc_oc=Adp3QIgBQ20PxSAEo2pU3LzDsJAuUduWPsJtlk5Db9bj45oQ09zKiQEYDCAu0e908tc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIid2ZvMDV1zmgmahWG6Gwc6rBh7arr16-wZI51_3uSxw&oe=6ABA62A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadRift: Zombie Survival VR", "keywords": ["zombiesurvivalvr", "zombievrgame", "survivalhorrorvr", "zombieshooter", "zombie"], "long_description": "DeadRift: Zombie Survival VR is the intense zombie VR game on Meta Quest. The world has fallen. A mysterious rift has unleashed a deadly infection, turning cities into wastelands filled with the undead. As one of the last survivors, you must fight through dangerous environments, scavenge resources, and eliminate endless waves of zombies to stay alive.\n\nStep into a fully immersive VR experience where every bullet matters and every encounter can be your last. Explore abandoned streets, dark facilities, and ruined outposts while uncovering the secrets behind the outbreak. Face fast-moving infected, powerful undead enemies, and overwhelming zombie hordes that will test your reflexes and survival skills.\n\n\ud83d\udd2b Intense VR gunplay with realistic weapon handling\n\ud83e\udddf Multiple zombie types with unique behaviors\n\ud83d\udca5 Action-packed combat and thrilling encounters\n\ud83c\udf0d Explore detailed post-apocalyptic locations on Meta Quest\n\ud83c\udfaf Sharpen your accuracy, strategy, and survival tactics\n\u2694\ufe0f Zombie hordes in brutal survival scenarios\n\nWhether you prefer aggressive combat or careful resource management, DeadRift delivers a thrilling zombie survival experience built for Meta Quest. Search every corner, choose the right weapon, and fight to stay alive as the infection spreads.\n\nAmmunition is limited. The undead are everywhere. Survival is never guaranteed.\n\nWill you conquer the rift \u2014 or become another victim of the zombie apocalypse?\n\ud83d\udd25 Load your weapons, enter the DeadRift, and fight for survival!", "short_description": "DeadRift: Zombie Survival VR \u2014 the ultimate zombie VR game on Meta Quest. A mysterious rift has shattered the world, unleashing a deadly infection that turned humanity into the undead. As one of the last survivors, fight through dangerous locations, scavenge weapons, and battle relentless zombie hordes in a fully immersive VR experience. Every bullet matters. Every decision counts. The zombie apocalypse is here \u2014 will you survive the rift?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zylostudio/privacy-policymeta-quest", "developer_terms_of_service_url": null, "publisher_name": "ZYLO Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/zylostudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1319991617854347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_1050036950891717_1816516109512135285_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMEanSt7GOUQ7kNvwFkX28K&_nc_oc=AdqltnFHse-0Io8khVGfwLEKHdGTRpzSzVH5WwWD3xVXy-Jqz9FFrDWsL4wctf1C4C0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBq0Jrq6IW_xXE-o6SUAVCwOyE5CVcXABKWZco2g1ocQ&oe=6ABA8214"}, "is_concept": false, "is_test": false, "is_trial_offer_v
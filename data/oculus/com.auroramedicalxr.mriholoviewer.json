_uc&_nc_oc=Adrv6fTAww68Qzekh7LPIwkTXD3It0K9xWku3066om7nGWEmROD6y4nV7-qViXaXV2E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx8NSpHwTb0WhkJ__tOtnkFAzBEHq-04pG9csg4EZPCA&oe=6AC51633"}, {"file_name": "shot-01-MRI-volume.png", "id": "4678463365720490", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823949_4678463369053823_1255769986102906241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNhonpNP12YQ7kNvwGphBgM&_nc_oc=AdrIz__BOXL7_5BgYZiwaAJ2gNRw09sP-Z5zatGyKeUb2Va-7h_XobBunzD7mmzO0Xs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU_KvS8om8j8svTSAmQWu9usJkqrLa_XwhSh5OgXeJpg&oe=6AC50D91"}, {"file_name": "shot-04-Brain-surfaces.png", "id": "944167768739547", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827601_944167772072880_3788044656833051632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UHNTP0cwbEQ7kNvwHbKvmj&_nc_oc=AdqODWcN5SRzMwo3w2FGQ4eLM-UcEA3MQP1Cvk6BsfRWQNiFDnQO21RClBSQLtZUEbs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1WCcfORr6dw69XWajw2AS3Me0j8sYIUpVlU_aNvqgQA&oe=6AC4F159"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MRIHoloViewer-trailer-cover-2560x1440.png", "id": "4422829071312770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827567_4422829077979436_8020520808984300037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rjwqp7YMWHoQ7kNvwH6tEHa&_nc_oc=AdrWo0QvqXaVLcoZuesmeyXZl4LIbbOEOzKNPO5tWncJN_TOwNumDrsOfhN8AvDNuGQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVr29zNXJmGD4BAp36-XdCIO5AWrpHlxNlU5ODZNZvig&oe=6AC52613"}, "display_name": "MRI Holo Viewer", "keywords": ["NIFTI", "MRI", "Passthrough", "3DBrain", "MedicalViewer"], "long_description": "\nBring MRI and CT volumes into your space and explore anatomy from any angle. Volumetric information must be of reasonable voxel sizes to avoid low FPS.\n\nOpen your own .nii or .nii.gz files from headset storage or a direct download URL. The optional reference MRI and its whole-head and brain segmentations download from GitHub and remain available offline. CT data comes from your own files or URLs.\n\nChoose visual presets from an illustrated grid, then apply the style to your loaded scan. Inspect sections, coloured labels, solid organ surfaces, holographic shells or a surface mesh with visible edges. Preset pictures are examples, not live previews of your file.\n\nFor labelled data, point to identify a structure, isolate it, or move surface parts apart and restore their original positions. The head atlas includes eyes, nose, bone and soft tissue; the separate brain atlas contains 95 regions. Custom segmentations can supply label names and model information in a companion JSON file.\n\nKeep compact tools beside your workspace. Move and resize them explicitly, choose Glass, Contrast or Anatomy colours, and switch between passthrough and black VR. Room brightness is adjustable from the header.\n\nThis is a visualization tool, not an automatic segmentation service or a validated diagnostic device. Surface meshes are simplified display geometry. Internet is needed for downloads; stored files work offline. First-time surface preparation for custom data may take time.\n", "short_description": "Visualize MRI NIfTI (.nii) datasets in 3D holographic passthrough with interactive anatomical presets and landmark overlays."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/mri-holo-viewer/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/mri-holo-viewer/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "478089301798119"}], "external_s
d3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsZfmA4mSfKZC90RX_ueQpR8b6Lr6xSlxsaeuWNYVzsQ&oe=6AC26778"}, {"file_name": "shot-05-MRI-axial-slab.png", "id": "903174325961297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_903174329294630_5157269856339482240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSYq9jU-QcUQ7kNvwEtL6AN&_nc_oc=AdqzDsMkLWMrWmAgoBczbfDoJwMqpaGxgMNwPO9dC8tF0tko2p-zKdYUH3BpOFGvs88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi83zaLStBb8Tw1TsxviJqXFjsgRLQ8mbvP3BT3xbTVA&oe=6AC26D44"}, {"file_name": "shot-02-MRI-coronal-slab.png", "id": "1389945042658271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1389945045991604_8983297526515727039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-e4j9dt900Q7kNvwGH_s8S&_nc_oc=AdoXEhaqredV8DumCWg7XgMOFWTQtI8KzuSLvYZ5hfW9gGnIP0Ri3BFaG8cY3Fhf788&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4gXxWmo76SGJuodrnnXknTWeHCTiCTEDQv0FvwLf0xQ&oe=6AC27333"}, {"file_name": "shot-01-MRI-volume.png", "id": "4678463365720490", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_4678463369053823_1255769986102906241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNhonpNP12YQ7kNvwHeqgW7&_nc_oc=AdoGKocIBd5qDQQ-zv0jeNasDcGlPo6YgiBq9vBessmod4Bld7-qJNDyCdOOCCTWRTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtyIgKyZYX_ppIVC-kkoZ3qqS20LqwnW_UpU_hnlO29w&oe=6AC26A91"}, {"file_name": "shot-04-Brain-surfaces.png", "id": "944167768739547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_944167772072880_3788044656833051632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78X2Z0pm8G4Q7kNvwEwBJen&_nc_oc=AdoOajCx3Y3jGPUMK_aUl3Zk35ysB3silZCl-3CA-diDdu0gUqmoBBgq9Yn4t2HVlOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy5Lzj1VJdW5YAQCS8c55PbTR4Zb_qDhQS_TuUxAhZJw&oe=6AC28699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MRIHoloViewer-trailer-cover-2560x1440.png", "id": "4422829071312770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827567_4422829077979436_8020520808984300037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rjwqp7YMWHoQ7kNvwHiadfF&_nc_oc=Adp_AXTn7t89hj-5WTQ6bsYCHo22wFgF0ICP29eIzd2LsEOmR3aWddWFEZtg2DCfC8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPE9aFEseA4460Vt02AiAauppM3j_5c6TvuinvAum48w&oe=6AC28313"}, "display_name": "MRI Holo Viewer", "keywords": ["NIFTI", "MRI", "Passthrough", "3DBrain", "MedicalViewer"], "long_description": "\nBring MRI and CT volumes into your space and explore anatomy from any angle. Volumetric information must be of reasonable voxel sizes to avoid low FPS.\n\nOpen your own .nii or .nii.gz files from headset storage or a direct download URL. The optional reference MRI and its whole-head and brain segmentations download from GitHub and remain available offline. CT data comes from your own files or URLs.\n\nChoose visual presets from an illustrated grid, then apply the style to your loaded scan. Inspect sections, coloured labels, solid organ surfaces, holographic shells or a surface mesh with visible edges. Preset pictures are examples, not live previews of your file.\n\nFor labelled data, point to identify a structure, isolate it, or move surface parts apart and restore their original positions. The head atlas includes eyes, nose, bone and soft tissue; the separate brain atlas contains 95 regions. Custom segmentations can supply label names and model information in a companion JSON file.\n\nKeep compact tools beside your workspace. Move and resize them explicitly, choose Glass, Contrast or Anatomy colours, and switch between passthrough and black VR. Room brightness is adjustable from the header.\n\nThis is a visualization tool, not an automatic segmentation service or a validated diagnostic device. Surface meshes are simplified display geometry. Internet is needed for downloads; stored files work offline. First-time surface preparation for custom data may take time.\n", "short_description": "Visualize MRI NIfTI (.nii) datasets in 3D holographic passthrough with interactive anatomical presets and landmark overlays."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/mri-holo-viewer/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/mri-holo-viewer/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28404514592491116"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1059303103345891"}]}, "baseline_offer": {"id": "1059303103345891"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789654380, "status": "PUBLISHED", "id": "1059303103345891"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28368390512770191", "version": "1.35.0"}, "id": "968353989697443", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25802868075989127", "
-QyFqzeMW841RlKI8Scwy82MPMBWQB9U1igvs5Tcrcs51wTZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn9ocO7RUFKAi31GvbHRqgx_qJ5FxJX4mPEUU8LbRjXg&oe=6AF72378"}, {"file_name": "shot-05-MRI-axial-slab.png", "id": "903174325961297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_903174329294630_5157269856339482240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64vkT7IDfTAQ7kNvwHiiUoR&_nc_oc=AdrWp6GEUVwmsP908JdV7qBxgnhrWCAKasmt3RBIYaW_QPdBKVUCHU4imaCCa1LcF3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQtkk-q4kSsmcIorO4voltjeOnokfqJiXRTonM8Fjf3w&oe=6AF72944"}, {"file_name": "shot-02-MRI-coronal-slab.png", "id": "1389945042658271", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1389945045991604_8983297526515727039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xI0vIqfp6IQ7kNvwFPSet6&_nc_oc=Adrjqm8dSGDUcRZru2hZlm6BKHSc-E_fjYrNJNq5hwtQvuu6mukRdWyZJRZk1JgJmUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa9XODVg-Qf58tw2Og5oEhDJIlT9t8o1kEt_5ClrsEog&oe=6AF72F33"}, {"file_name": "shot-01-MRI-volume.png", "id": "4678463365720490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_4678463369053823_1255769986102906241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ygZk-y91GEQ7kNvwG9fQBo&_nc_oc=Adoi3lI8tb3W_nnNiSvnX29S4ghJoxiJXabDIjMoI5UHfVoQd-WB_UuYJSKjFVK1pIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaozL2Ce7x4JldPwsj0xGupbGB61Zp6132G5kRWE4Eww&oe=6AF72691"}, {"file_name": "shot-04-Brain-surfaces.png", "id": "944167768739547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827601_944167772072880_3788044656833051632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRmRmpgGUZ8Q7kNvwG4DJQ9&_nc_oc=Adp-TEvHF1rxw6ff3v9KUNdl4IHNI3vVv-OF2UFR988oZRAj1beNWsFlghW-4ATAXf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWjo6kFqoK_V9a3jhQpsCMAIVy7uKJwSixu4Dvgp4PWw&oe=6AF74299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MRIHoloViewer-trailer-cover-2560x1440.png", "id": "4422829071312770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_4422829077979436_8020520808984300037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kWbISAoeWoQ7kNvwFq6vq-&_nc_oc=Adpb5m-kKDMrrfvhp2ro_p6NmWGSsPfrZbvLzeKY382SnPAjc8XFX0zNlxyB6L4BM-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNo6E2mpBFBGvu-x7HLNIvTDRKK7OQleFBnTtP7MKIYQ&oe=6AF73F13"}, "display_name": "MRI Holo Viewer", "keywords": ["NIFTI", "MRI", "Passthrough", "3DBrain", "MedicalViewer"], "long_description": "\nBring MRI and CT volumes into your space and explore anatomy from any angle. Volumetric information must be of reasonable voxel sizes to avoid low FPS.\n\nOpen your own .nii or .nii.gz files from headset storage or a direct download URL. The optional reference MRI and its whole-head and brain segmentations download from GitHub and remain available offline. CT data comes from your own files or URLs.\n\nChoose visual presets from an illustrated grid, then apply the style to your loaded scan. Inspect sections, coloured labels, solid organ surfaces, holographic shells or a surface mesh with visible edges. Preset pictures are examples, not live previews of your file.\n\nFor labelled data, point to identify a structure, isolate it, or move surface parts apart and restore their original positions. The head atlas includes eyes, nose, bone and soft tissue; the separate brain atlas contains 95 regions. Custom segmentations can supply label names and model information in a companion JSON file.\n\nKeep compact tools beside your workspace. Move and resize them explicitly, choose Glass, Contrast or Anatomy colours, and switch between passthrough and black VR. Room brightness is adjustable from the header.\n\nThis is a visualization tool, not an automatic segmentation service or a validated diagnostic device. Surface meshes are simplified display geometry. Internet is needed for downloads; stored files work offline. First-time surface preparation for custom data may take time.\n", "short_description": "Visualize MRI NIfTI (.nii) datasets in 3D holographic passthrough with interactive anatomical presets and landmark overlays."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/mri-holo-viewer/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/mri-holo-viewer/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28404514592491116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825345_1609709447233838_2681523965166844591_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37fE2dXlnp8Q7kNvwEbapPn&_nc_oc=AdrQz3pW5Nhnir1aKca9rOZn3GEgNcNTcqYnZ-7LupLZzH_WW99jSJE98EveerHeIlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkZor8-IU2O6Ek8RNpaTwf-flQf0e5bBZS67D1DaQtLw&oe=6AF72A92"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MRI Holo Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "AP
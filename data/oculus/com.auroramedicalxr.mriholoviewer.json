872321_7298178296542950523_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zLJljlRBTEQ7kNvwETNq5Y&_nc_oc=AdpJPPLWlKOe0Fh9w2h8OOXbZ_tiX7VDTDhi1--MN1Oop1UqhFE5APJRQf7YiKJm4kk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-061-_Bd6Cf3yJVaITnisFe2TqrS5w7cYZFilkAnInQ&oe=6AF874F8"}, {"file_name": "shot-05-MRI-axial-slab.png", "id": "903174325961297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_903174329294630_5157269856339482240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZD-TyktnovcQ7kNvwEr1K9t&_nc_oc=AdpkB_XgWOnfYweKvkddKD1Yr2HTXi4k6Dc0fhqfMcta-WffuTOHOIkBZ4Nte0mPXco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhvXDl5Wk20pHOMXxV6zmVdjxTBcIDlJCeNMckaO7Sfg&oe=6AF87AC4"}, {"file_name": "shot-02-MRI-coronal-slab.png", "id": "1389945042658271", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1389945045991604_8983297526515727039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xI0vIqfp6IQ7kNvwE9GNIl&_nc_oc=AdoV5v8mWneN3mDVpvnVXzAyER6BVHmsYJIittrJTTfzGOLu24KFM9b-qXm-AkD2ch4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5PFd_h6CD_ka47t51TRvpUSG4pF6XuIM4zyDHTy00iA&oe=6AF880B3"}, {"file_name": "shot-01-MRI-volume.png", "id": "4678463365720490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_4678463369053823_1255769986102906241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ygZk-y91GEQ7kNvwFVvMHs&_nc_oc=AdpTmQ1Sf8TGmRnY08AR_NNZmNK4c0s5Fr_05QU4yArIiCoO282oSCbsjRb0oLsCfjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAboIB3fshcj16i7usTAJBX7K6AlSIxC-5NCMeU6_6rw&oe=6AF87811"}, {"file_name": "shot-04-Brain-surfaces.png", "id": "944167768739547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827601_944167772072880_3788044656833051632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRmRmpgGUZ8Q7kNvwHDrxrH&_nc_oc=AdpdSDIKNFr2ZPuYbOJ_pefc9jlsbyRHIUQ4WQbmrT0Luc8OoQ652_WQK1ssPP2oy0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvbBlFFrigcoZzbemPVdmuhzi1PYT3-NVFiI223kYGPw&oe=6AF89419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MRIHoloViewer-trailer-cover-2560x1440.png", "id": "4422829071312770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_4422829077979436_8020520808984300037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kWbISAoeWoQ7kNvwG9ONQ-&_nc_oc=AdrTldYIzMSWKIKbyT1kG3fuJCvYMCFq7xC7luS3PVXSm9I-ntLy3l8E3EkxAkJ2Pas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv_GYfv7V9aAh_1S-OQz3HOW5GuuBcg-r_VTTIQB8pHw&oe=6AF89093"}, "display_name": "MRI Holo Viewer", "keywords": ["NIFTI", "MRI", "Passthrough", "3DBrain", "MedicalViewer"], "long_description": "\nBring MRI and CT volumes into your space and explore anatomy from any angle. Volumetric information must be of reasonable voxel sizes to avoid low FPS.\n\nOpen your own .nii or .nii.gz files from headset storage or a direct download URL. The optional reference MRI and its whole-head and brain segmentations download from GitHub and remain available offline. CT data comes from your own files or URLs.\n\nChoose visual presets from an illustrated grid, then apply the style to your loaded scan. Inspect sections, coloured labels, solid organ surfaces, holographic shells or a surface mesh with visible edges. Preset pictures are examples, not live previews of your file.\n\nFor labelled data, point to identify a structure, isolate it, or move surface parts apart and restore their original positions. The head atlas includes eyes, nose, bone and soft tissue; the separate brain atlas contains 95 regions. Custom segmentations can supply label names and model information in a companion JSON file.\n\nKeep compact tools beside your workspace. Move and resize them explicitly, choose Glass, Contrast or Anatomy colours, and switch between passthrough and black VR. Room brightness is adjustable from the header.\n\nThis is a visualization tool, not an automatic segmentation service or a validated diagnostic device. Surface meshes are simplified display geometry. Internet is needed for downloads; stored files work offline. First-time surface preparation for custom data may take time.\n", "short_description": "Visualize MRI NIfTI (.nii) datasets in 3D holographic passthrough with interactive anatomical presets and landmark overlays."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/mri-holo-viewer/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/mri-holo-viewer/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28404514592491116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825345_1609709447233838_2681523965166844591_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37fE2dXlnp8Q7kNvwH6SCFN&_nc_oc=AdqmtwZTYCohsVzQ_ps0LcCNF73ApHyNZ60Bfd1ty44xEIo6w5UNRguNa5TXLLkoCyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhpG4XHhBJiG9aY3I7zAeAZihGo7TvNheN0OAmKvT28A&oe=6AF87C12"}, "is_concept": false, "is_test": false, "is_trial_off
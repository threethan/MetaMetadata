94630_5157269856339482240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPQFT_aKx2wQ7kNvwEG4jll&_nc_oc=AdqzuDmk-IisxKC6Z3_xsTrAJdaD72kLoOFrgE6Zc3yHawPm_JYN50D4jjkkHuKJvfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCF0s9yvnztHzm8sQpyiyN28YEvUSYfE0ccrLeIFNPjQ&oe=6AB7E144"}, {"file_name": "shot-02-MRI-coronal-slab.png", "id": "1389945042658271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1389945045991604_8983297526515727039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFtiJQix_EQQ7kNvwHMSiQX&_nc_oc=Adqc7kozgF9mH3N8ERBTZblTsjpBREUouE3a7d5pjfsaVBKJ-xzZ7V_c1H9ENiuMJyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwFEgKWsmOMWL0-F_2Hly7LFqV3vff-PxievpWptbLlA&oe=6AB7E733"}, {"file_name": "shot-01-MRI-volume.png", "id": "4678463365720490", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_4678463369053823_1255769986102906241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRDtGw-yWqAQ7kNvwGuU-xM&_nc_oc=AdovZjscJbukQrODkCD7shwSSLBVbnAB0Qw6SpU_ZFD2d2fPtkDcCto0CBQXH0dXC1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw-_Awmg_HiBDGkCpn2WnEPX9Kt4uUVxkn01Ap-NkRcQ&oe=6AB7DE91"}, {"file_name": "shot-04-Brain-surfaces.png", "id": "944167768739547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_944167772072880_3788044656833051632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1KFODQt9LoQ7kNvwE-LTKH&_nc_oc=AdoZorOUEsKAuBPT3Mhz-yWycsiFKbGirTVPdiZOZAr2Q1LoswUcwwpcF7Waun7PehE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaSiwCAlZA0spkpkRCbu8KvpluSyLLKXMGD05_-tqf5A&oe=6AB7C259"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MRIHoloViewer-trailer-cover-2560x1440.png", "id": "4422829071312770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827567_4422829077979436_8020520808984300037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ntf-9122GYQ7kNvwGyHdW8&_nc_oc=Adrw3mpYLIm21YDEP0WnSj8WO3-q3uvpYomXFmVrJxR-euQkamceVr676bhvGoc8RAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqTTxESfRb5-XsHcolHUwNFX09rRw7VfO4_9hUBeyV6A&oe=6AB7BED3"}, "display_name": "MRI Holo Viewer", "keywords": ["NIFTI", "MRI", "Passthrough", "3DBrain", "MedicalViewer"], "long_description": "\nBring MRI and CT volumes into your space and explore anatomy from any angle. Volumetric information must be of reasonable voxel sizes to avoid low FPS.\n\nOpen your own .nii or .nii.gz files from headset storage or a direct download URL. The optional reference MRI and its whole-head and brain segmentations download from GitHub and remain available offline. CT data comes from your own files or URLs.\n\nChoose visual presets from an illustrated grid, then apply the style to your loaded scan. Inspect sections, coloured labels, solid organ surfaces, holographic shells or a surface mesh with visible edges. Preset pictures are examples, not live previews of your file.\n\nFor labelled data, point to identify a structure, isolate it, or move surface parts apart and restore their original positions. The head atlas includes eyes, nose, bone and soft tissue; the separate brain atlas contains 95 regions. Custom segmentations can supply label names and model information in a companion JSON file.\n\nKeep compact tools beside your workspace. Move and resize them explicitly, choose Glass, Contrast or Anatomy colours, and switch between passthrough and black VR. Room brightness is adjustable from the header.\n\nThis is a visualization tool, not an automatic segmentation service or a validated diagnostic device. Surface meshes are simplified display geometry. Internet is needed for downloads; stored files work offline. First-time surface preparation for custom data may take time.\n", "short_description": "Visualize MRI NIfTI (.nii) datasets in 3D holographic passthrough with interactive anatomical presets and landmark overlays."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/mri-holo-viewer/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/mri-holo-viewer/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28404514592491116"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1059303103345891"}]}, "baseline_offer": {"id": "1059303103345891"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789654380, "status": "PUBLISHED", "id": "1059303103345891"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28368390512770191", "version": "1.35.0"}, "id": "968353989697443", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25802868075989127", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28368390512770191"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "968353989697443"}]}, "change_log": null, "
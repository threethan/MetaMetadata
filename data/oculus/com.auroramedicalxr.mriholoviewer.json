nc_oc=AdrIJ_n_WOf5qo6vPwMacKiIvtTnJEryZEZTBWOcdgkYuFwkxKrR2vKPtonQHA7cAfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyGrC1VfGsprxLKGexDd-R4v_AeWY-1xBwJT1lZNF8UA&oe=6AF1D3FD"}]}, "id": "1116038344443555", "locale": "en_US", "screenshots": [{"file_name": "shot-03-CT-intensity-projection.png", "id": "1075641018205655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_1075641024872321_7298178296542950523_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EXcfU40qTUQ7kNvwFdFvFQ&_nc_oc=AdqNYsapnBziGgSwmxHF2W4vtVTKhPhmX_fQJyHRu_n6GgT5fao3krU1CAchNEPiidM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJFmcuddCMebLTH_qxmfLrJ-cDJYsHpbeVV8doxQEUxA&oe=6AF1DD78"}, {"file_name": "shot-05-MRI-axial-slab.png", "id": "903174325961297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_903174329294630_5157269856339482240_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ew65PDRZpEQ7kNvwEgXOAD&_nc_oc=Adr2EzPAo2nVr7bGFXVFhdiFpOe0YAWjd1Cnj_PsUBp1prwLElm-STPMUyACgid34Xk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1A0NNjiqjZiP6ZkfB_24uvXoG0IaTI-w8mBNL7yHbpw&oe=6AF1E344"}, {"file_name": "shot-02-MRI-coronal-slab.png", "id": "1389945042658271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1389945045991604_8983297526515727039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJAWUOPyjTkQ7kNvwFmGhEB&_nc_oc=Adp91939gbKxG-jAviQYfyG6XP_UTEe7_a5P4o-MF5d2TPSjVwAysYtWkYRUF3YHacs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRigTB9xgJj2Uo3EprVNuCR28X1bw6WV49z4HbXpjVIDQ&oe=6AF1E933"}, {"file_name": "shot-01-MRI-volume.png", "id": "4678463365720490", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_4678463369053823_1255769986102906241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDdJcU0B8OwQ7kNvwGpSNm0&_nc_oc=Adoh18O9lg4CkUnaTJFjiuOpZ5jlY7j4-6lbrl7gSiAXPxsb-AaEbMOmrredo8ItLzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1GAYRhzIGFE6UWyDZ6wlaNMiyovNaznvsoTzflypqcA&oe=6AF1E091"}, {"file_name": "shot-04-Brain-surfaces.png", "id": "944167768739547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_944167772072880_3788044656833051632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlh5JgwJJk0Q7kNvwFLXX55&_nc_oc=AdrBs6UjSPed5F0Wu70R1ntC00ZSspb7zUO5VIqyCCR8rhIZqMt1DKHJzMxtqlTMklI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOV0M2qMlUjyXyyNK_g6GBKvnWbDr9BKKCXD_MmQmBEA&oe=6AF1FC99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MRIHoloViewer-trailer-cover-2560x1440.png", "id": "4422829071312770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827567_4422829077979436_8020520808984300037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPWEKV7-6A8Q7kNvwHwKJbU&_nc_oc=Adp7nTOhtNgFF4R4WT-YIDL37p8rO3GfV8CmUlePRHfZWZBIlZUiDV1gZati-wt9sLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVR66oxG0GGg33h1vjQldpM-Zb04HDIINOhgrY3c7c7g&oe=6AF1F913"}, "display_name": "MRI Holo Viewer", "keywords": ["NIFTI", "MRI", "Passthrough", "3DBrain", "MedicalViewer"], "long_description": "\nBring MRI and CT volumes into your space and explore anatomy from any angle. Volumetric information must be of reasonable voxel sizes to avoid low FPS.\n\nOpen your own .nii or .nii.gz files from headset storage or a direct download URL. The optional reference MRI and its whole-head and brain segmentations download from GitHub and remain available offline. CT data comes from your own files or URLs.\n\nChoose visual presets from an illustrated grid, then apply the style to your loaded scan. Inspect sections, coloured labels, solid organ surfaces, holographic shells or a surface mesh with visible edges. Preset pictures are examples, not live previews of your file.\n\nFor labelled data, point to identify a structure, isolate it, or move surface parts apart and restore their original positions. The head atlas includes eyes, nose, bone and soft tissue; the separate brain atlas contains 95 regions. Custom segmentations can supply label names and model information in a companion JSON file.\n\nKeep compact tools beside your workspace. Move and resize them explicitly, choose Glass, Contrast or Anatomy colours, and switch between passthrough and black VR. Room brightness is adjustable from the header.\n\nThis is a visualization tool, not an automatic segmentation service or a validated diagnostic device. Surface meshes are simplified display geometry. Internet is needed for downloads; stored files work offline. First-time surface preparation for custom data may take time.\n", "short_description": "Visualize MRI NIfTI (.nii) datasets in 3D holographic passthrough with interactive anatomical presets and landmark overlays."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/mri-holo-viewer/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/mri-holo-viewer/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28404514592491116"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1426
.5771-25/491821704_1389945045991604_8983297526515727039_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Js5NvQ4XZUEQ7kNvwGkkq7m&_nc_oc=Adp-gM2y7cdKz9LVuIKxia4JXkrzQ-mRdsXr4DhAWHWxEGLPq3kWCuCLowWxg2P3cHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHMSaIWnpxREjpW1CPotGv4QmEvM97gcR7rfj8CAmyig&oe=6ACFA233"}, {"file_name": "shot-01-MRI-volume.png", "id": "4678463365720490", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823949_4678463369053823_1255769986102906241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzV2bZ3wUC0Q7kNvwFLhIC4&_nc_oc=Adrb7bPJNcKOJIzsFY8Mq9h9u4LoRgxp59Dosoy-Fz9sApcbE1-NmS9cycRxy4mUyak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwMOT6aHVcowBw6gkHQ87nYeT96K9Jf0YsAE3XpCQT7Q&oe=6ACF9991"}, {"file_name": "shot-04-Brain-surfaces.png", "id": "944167768739547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827601_944167772072880_3788044656833051632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEXs-VXt0KwQ7kNvwHRD-f4&_nc_oc=Adou0hkDQcIiJvD4kJBnc3NYGPCbaX7m9W8Ucl8-rOO4GKKo9vgJqPE0R-St0yKnu2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpcH5Nw8cTJVvrPbNUsNbCNb4dZCNptGsnCx7Pa9dHIw&oe=6ACFB599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MRIHoloViewer-trailer-cover-2560x1440.png", "id": "4422829071312770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827567_4422829077979436_8020520808984300037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3uXhB0csUMQ7kNvwEujTFj&_nc_oc=AdpPjPw3r1KLwtEXBz1SSS2_KLT2Ro3zk0ecQd4xD1IbTlH6UpJvEuW_U9d1NY5z-Ng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0REBOE9b_ZmYlXubLrDKOzKWSnWn34sA6gFSlQKJ8Iw&oe=6ACFB213"}, "display_name": "MRI Holo Viewer", "keywords": ["NIFTI", "MRI", "Passthrough", "3DBrain", "MedicalViewer"], "long_description": "\nBring MRI and CT volumes into your space and explore anatomy from any angle. Volumetric information must be of reasonable voxel sizes to avoid low FPS.\n\nOpen your own .nii or .nii.gz files from headset storage or a direct download URL. The optional reference MRI and its whole-head and brain segmentations download from GitHub and remain available offline. CT data comes from your own files or URLs.\n\nChoose visual presets from an illustrated grid, then apply the style to your loaded scan. Inspect sections, coloured labels, solid organ surfaces, holographic shells or a surface mesh with visible edges. Preset pictures are examples, not live previews of your file.\n\nFor labelled data, point to identify a structure, isolate it, or move surface parts apart and restore their original positions. The head atlas includes eyes, nose, bone and soft tissue; the separate brain atlas contains 95 regions. Custom segmentations can supply label names and model information in a companion JSON file.\n\nKeep compact tools beside your workspace. Move and resize them explicitly, choose Glass, Contrast or Anatomy colours, and switch between passthrough and black VR. Room brightness is adjustable from the header.\n\nThis is a visualization tool, not an automatic segmentation service or a validated diagnostic device. Surface meshes are simplified display geometry. Internet is needed for downloads; stored files work offline. First-time surface preparation for custom data may take time.\n", "short_description": "Visualize MRI NIfTI (.nii) datasets in 3D holographic passthrough with interactive anatomical presets and landmark overlays."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/mri-holo-viewer/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/mri-holo-viewer/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922
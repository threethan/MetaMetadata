": "en_US", "screenshots": [{"file_name": "shot-03-CT-intensity-projection.png", "id": "1075641018205655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_1075641024872321_7298178296542950523_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwVmGZ-Ct4kQ7kNvwHMf9HX&_nc_oc=AdqtTzAsXTmLq09EKgAO5Af1GqB_JI8qbZWHjg0N_C1-x598MbdBemVu6bLZPcc6qqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTsHJ1X4-DGOiFC0B-l_DkVFuLUBABIkZtPjNOm5EiAtA&oe=6B0C73B8"}, {"file_name": "shot-05-MRI-axial-slab.png", "id": "903174325961297", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_903174329294630_5157269856339482240_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON3ovsvAecUQ7kNvwGFwrFG&_nc_oc=Adokox7xo5iOolxz1_YL3INQJ2jumyjapq-ixoFOZUf9zTEnpqvx9HNKR0YMIFiXLFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRC6aJF_0tVh7QFSNwuGHlTHpCmIgg0kdFcvlHcMDB7cQ&oe=6B0C7984"}, {"file_name": "shot-02-MRI-coronal-slab.png", "id": "1389945042658271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1389945045991604_8983297526515727039_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0iFHAO_ouQQ7kNvwEq5am3&_nc_oc=AdqFkocVFWOc3IFaIS_3W4Kytxa6P2Ywp5MdLXGu9GJMs5rAw0ZmJ6Dm2x3izQjLI3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLwCjWCutYu5Ikhpbo0SOgf3q7ofKvzef3_kf5ILphSQ&oe=6B0C7F73"}, {"file_name": "shot-01-MRI-volume.png", "id": "4678463365720490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_4678463369053823_1255769986102906241_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2AhLyCz0hUQ7kNvwF8cpS9&_nc_oc=AdroV2S6m5zfj-Q-AEqw-kt2HngNkKHRd7fBXd7l9V7e1-C2-Hs5jL4hmFvsbhpUEFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFGD2R3HPVGayGzWLo9WTvM-K3olkZ4tIRd7QL0ReNsQ&oe=6B0C76D1"}, {"file_name": "shot-04-Brain-surfaces.png", "id": "944167768739547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_944167772072880_3788044656833051632_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZEtBtpB-TYQ7kNvwEavw4a&_nc_oc=AdrExMjqHnHoacLfpNPcwaI_lTSdCn0XtrRLvFqmd6xxYECSfIVO_yYHkjctknRxJiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8y_fYT105PoqmJC-f8SS9PeZZzSOdoU9-REpaxTLF8Q&oe=6B0C5A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MRIHoloViewer-trailer-cover-2560x1440.png", "id": "4422829071312770", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_4422829077979436_8020520808984300037_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWAXEKUwtroQ7kNvwHqf1dZ&_nc_oc=AdoNv6oiDFi0uB8cZaf0rcq4OtiXBayWmwDCUmSBUWr3aUvAjMCPxFT5_6cWScjl0YU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpA1esGnpT_fPibZGJeXnQDY9PuLpLMmWn6vbcbr5Gzw&oe=6B0C5713"}, "display_name": "MRI Holo Viewer", "keywords": ["NIFTI", "MRI", "Passthrough", "3DBrain", "MedicalViewer"], "long_description": "\nBring MRI and CT volumes into your space and explore anatomy from any angle. Volumetric information must be of reasonable voxel sizes to avoid low FPS.\n\nOpen your own .nii or .nii.gz files from headset storage or a direct download URL. The optional reference MRI and its whole-head and brain segmentations download from GitHub and remain available offline. CT data comes from your own files or URLs.\n\nChoose visual presets from an illustrated grid, then apply the style to your loaded scan. Inspect sections, coloured labels, solid organ surfaces, holographic shells or a surface mesh with visible edges. Preset pictures are examples, not live previews of your file.\n\nFor labelled data, point to identify a structure, isolate it, or move surface parts apart and restore their original positions. The head atlas includes eyes, nose, bone and soft tissue; the separate brain atlas contains 95 regions. Custom segmentations can supply label names and model information in a companion JSON file.\n\nKeep compact tools beside your workspace. Move and resize them explicitly, choose Glass, Contrast or Anatomy colours, and switch between passthrough and black VR. Room brightness is adjustable from the header.\n\nThis is a visualization tool, not an automatic segmentation service or a validated diagnostic device. Surface meshes are simplified display geometry. Internet is needed for downloads; stored files work offline. First-time surface preparation for custom data may take time.\n", "short_description": "Visualize MRI NIfTI (.nii) datasets in 3D holographic passthrough with interactive anatomical presets and landmark overlays."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/mri-holo-viewer/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/mri-holo-viewer/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28404514592491116"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1426880202436716"}, {"status": "PUBLISHED", "id": "1059303103345891"}]}, "baseline_o
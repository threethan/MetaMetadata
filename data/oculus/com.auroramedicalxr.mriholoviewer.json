": "en_US", "screenshots": [{"file_name": "shot-03-CT-intensity-projection.png", "id": "1075641018205655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_1075641024872321_7298178296542950523_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctCfmwud9i0Q7kNvwEL_MeS&_nc_oc=AdrZTUlNJl2I106u6gar4L-TrZH_YLq-PaBTNcpuVtwtUPbiOJC2Lb0qNO1NnXi0Gtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWHGT0ft6sLK-Nw_ByoCib3rsUmKTSOkVTrqW3gd6ikkA&oe=6B0F16B8"}, {"file_name": "shot-05-MRI-axial-slab.png", "id": "903174325961297", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_903174329294630_5157269856339482240_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON3ovsvAecUQ7kNvwEMVyXf&_nc_oc=AdofZ2lqUP3aUi_ZWwisjHuzGLtt9GC5SFDzX6plNvaGSlRopwZxdYjtiEHI_A6jJEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFqSw6PBonlIaFUaL_Kd5etQHltbahOCyyLuRMnpwDhQ&oe=6B0F1C84"}, {"file_name": "shot-02-MRI-coronal-slab.png", "id": "1389945042658271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1389945045991604_8983297526515727039_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLhFbu8o5j4Q7kNvwH0VQa9&_nc_oc=AdqJF5mqbMLtmxp7G1SJYpMRlELee3snHjulJFeC8usG3JJZUXEr8MQPUh8FEsaIjbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWa5mgs9LoPyz5y-JXZ_8JiuU9w7U9fTYP8hlnKlN_7Cw&oe=6B0F2273"}, {"file_name": "shot-01-MRI-volume.png", "id": "4678463365720490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_4678463369053823_1255769986102906241_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrzaQmDtooUQ7kNvwE3vH-b&_nc_oc=AdqCRakQ1fecFxosgYCk9_K09QjJ8yBFdMv_Qt1K6_g6RY95wLmMSMaMDaIIZZbvIYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUz8eNw5tBZWT9NSdtMjr4vrC6KfCb1ziqcF0KzBh7Nig&oe=6B0F19D1"}, {"file_name": "shot-04-Brain-surfaces.png", "id": "944167768739547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_944167772072880_3788044656833051632_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pj_b-ATdlkQ7kNvwHPjowZ&_nc_oc=AdqIrmLEDIKnSyeAdZdmCGfFNse-9v8xI-0oW0eG7ToWhe0sJWbf39SfTjQ-V_fuhs0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUXr6nmIo65qgDQwN5vTnDTu0o6f9saZIhNTyZ3zFNxcQ&oe=6B0EFD99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MRIHoloViewer-trailer-cover-2560x1440.png", "id": "4422829071312770", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_4422829077979436_8020520808984300037_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-wvB-Tj-zUQ7kNvwH3_jrz&_nc_oc=AdpM4RPS64AvcThyX6GN44oXVSTzoPMSGFnFBfPIRypKCt9raqk_CIiOmqNC1GQ9frE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXq620TWnnfvdglT9r4LUOgDt5ncglw1hTVsJf5hpWqEA&oe=6B0EFA13"}, "display_name": "MRI Holo Viewer", "keywords": ["NIFTI", "MRI", "Passthrough", "3DBrain", "MedicalViewer"], "long_description": "\nBring MRI and CT volumes into your space and explore anatomy from any angle. Volumetric information must be of reasonable voxel sizes to avoid low FPS.\n\nOpen your own .nii or .nii.gz files from headset storage or a direct download URL. The optional reference MRI and its whole-head and brain segmentations download from GitHub and remain available offline. CT data comes from your own files or URLs.\n\nChoose visual presets from an illustrated grid, then apply the style to your loaded scan. Inspect sections, coloured labels, solid organ surfaces, holographic shells or a surface mesh with visible edges. Preset pictures are examples, not live previews of your file.\n\nFor labelled data, point to identify a structure, isolate it, or move surface parts apart and restore their original positions. The head atlas includes eyes, nose, bone and soft tissue; the separate brain atlas contains 95 regions. Custom segmentations can supply label names and model information in a companion JSON file.\n\nKeep compact tools beside your workspace. Move and resize them explicitly, choose Glass, Contrast or Anatomy colours, and switch between passthrough and black VR. Room brightness is adjustable from the header.\n\nThis is a visualization tool, not an automatic segmentation service or a validated diagnostic device. Surface meshes are simplified display geometry. Internet is needed for downloads; stored files work offline. First-time surface preparation for custom data may take time.\n", "short_description": "Visualize MRI NIfTI (.nii) datasets in 3D holographic passthrough with interactive anatomical presets and landmark overlays."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/mri-holo-viewer/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/mri-holo-viewer/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "website_url": "https://nebulytic.com/apps/mri-holo-viewer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28404514592491116"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1426880202436716"}, {"status": "PUBLISHED", "id": "1059303103345891"}]}, "baseline_o
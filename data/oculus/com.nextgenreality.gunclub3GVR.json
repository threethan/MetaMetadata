Uyr4zJvEQ7kNvwGEIYWm&_nc_oc=AdpS53KvBWBlCUIFYWLwaOJEYoUj1TFFX7YNCUduWkCa1H_0y-PGBO6tVIPA5q1jrtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSp4ccoEGcOHRPdyA7Rcn6jPOQzuZwAwH9Ot6wGtSP6Q&oe=6A50F8CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GunClub3VR_thumbnail.png", "id": "2029033374029229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504730_2029033377362562_5417587750498992128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVjHFj-HuKgQ7kNvwHws-_9&_nc_oc=Adp2mtrDqquj-nOXaWG8dzhjRhTHzuxnnFqikcgMoq3QFOB7ho2qDasB2BN4ZHjNuf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5tUsoNc3k3jt4ZvTJT4ZmJdkEAPZaYEN8f6T_wVaXsw&oe=6A510847"}, "display_name": "Gun Club 3 VR", "keywords": ["guns", "shooting", "gunclub", "allied", "swat"], "long_description": "Take to the range with an incredible arsenal of the world\u2019s finest weaponry. Gun Club 3 combines challenging, addictive gameplay with stunning visuals & unsurpassed detail; the only thing missing is the smell of gun powder.\n \nThe newest release in the best-selling Gun Club series, Gun Club 3 brings a whole new world of excitement to the most popular gun simulator ever.\n\nUNPARALLELED REALISM\nHighly detailed interactive 3D weapon models that are fully operational & feature real-world ballistics.\n\nADVANCED CUSTOMISATION\nCustom-fit your weapons with hundreds of different attachments. From scopes to lasers to grenade launchers, the picatinny rail system allows for any load-out you can imagine. \n\nINTERACTIVE RANGES\nFire your weapons in a multitude of different range scenarios, from hostage rescue to long distance marksman to the dreaded zombie apocalypse. And for true shooting purists there is the classic target range. No time limits, no scores, just you and your weapon.\n\nGo update now live!", "short_description": "Take to the range with an incredible arsenal of the world\u2019s finest weaponry. Gun Club 3 combines challenging, addictive gameplay with stunning visuals & unsurpassed detail; the only thing missing is the smell of gun powder."}]}, "developer_name": "The Binary Mill", "developer_privacy_policy_url": "http://thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://thebinarymill.com/terms.php", "publisher_name": "The Binary Mill", "support_website_url": null, "website_url": "http://thebinarymill.com/gunclub3/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274408104796806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386320_1170364869701872_719815115_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TJ4gexz5WAQ7kNvwHqwjat&_nc_oc=Ado89eIf8OfektvXunMC7zYj6kJZm17r-2gAv-0y2093CR0oEpa-1FieCmM22mhpMk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTdWcamKspYJa51zKYI26BKHpWWY8PuoFtlpSIHc0srw&oe=6A50E771"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gun Club 3 VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1467183600, "lastRevision": {"nodes": [{"id": "1041693879220015", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "927672977351617", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDR
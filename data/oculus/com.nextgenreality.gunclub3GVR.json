scdn.com/v/t64.5771-25/12427557_1086957798028852_1769057822_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqKH8jRNDysQ7kNvwEv3kns&_nc_oc=AdlSjj4iHo8qrxl4pIuKRsgAZHGlHrf5777gdL-WqvxoQHEFIwVUTHoVCw6to-ev9N4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftITu3ENc2dNgNA6IP68vIZGsGJI40W8GiyLviOelsmRA&oe=69A1AD94"}, {"file_name": "migrated_image.png", "id": "203139044312361", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12504682_226112457775445_1159975757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXUAj5znLpUQ7kNvwF-deED&_nc_oc=Adl7g-68NSrNOtycQ81wRxBAjhC3F6rzqocEHD2BA3o-SDXHHd-DVDiBXfXmaKtLi9I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft7Uw8tGHmyT1VfS8Ew9EwC6tlDIf-G6DT4fjWakB_qNg&oe=69A18B41"}, {"file_name": "migrated_image.png", "id": "519987548706721", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12522358_491650397699608_718709886_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKkaX0Vk_boQ7kNvwH74uGp&_nc_oc=Adms7yt-IVtMXylPQh87T6CDYajJiDPuWUIGe_d8LTYT_SO0Lk6nvEP_tfASeOa2-l4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuZnYyuDj2dHfj-a76cjXDc11cXAUj9oKi9mC3pdc06Cg&oe=69A1A14C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gun Club 3 VR", "keywords": ["guns", "shooting", "gunclub", "gun", "target"], "long_description": "Take to the range with an incredible arsenal of the world\u2019s finest weaponry. Gun Club 3 combines challenging, addictive gameplay with stunning visuals & unsurpassed detail; the only thing missing is the smell of gun powder.\n \nThe newest release in the best-selling Gun Club series, Gun Club 3 brings a whole new world of excitement to the most popular gun simulator ever.\n\nUNPARALLELED REALISM\nHighly detailed interactive 3D weapon models that are fully operational & feature real-world ballistics.\n\nADVANCED CUSTOMISATION\nCustom-fit your weapons with hundreds of different attachments. From scopes to lasers to grenade launchers, the picatinny rail system allows for any load-out you can imagine. \n\nINTERACTIVE RANGES\nFire your weapons in a multitude of different range scenarios, from hostage rescue to long distance marksman to the dreaded zombie apocalypse. And for true shooting purists there is the classic target range. No time limits, no scores, just you and your weapon.", "short_description": "Take to the range with an incredible arsenal of the world\u2019s finest weaponry. Gun Club 3 combines challenging, addictive gameplay with stunning visuals & unsurpassed detail; the only thing missing is the smell of gun powder."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://thebinarymill.com/terms.php", "publisher_name": "The Binary Mill", "support_website_url": null, "website_url": "http://thebinarymill.com/gunclub3/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "SHOOTER", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "894563677894613"}}]}, "scheduled_offers": {"count": 43, "nodes": [{"status": "PUBLISHED", "id": "1040328662839565"}, {"status": "PUBLISHED", "id": "229503664751049"}, {"status": "PUBLISHED", "id": "1098545837013869"}, {"status": "PUBLISHED", "id": "1732372950181549"}, {"status": "PUBLISHED", "id": "791772521003505"}, {"status": "PUBLISHED", "id": "2772605219424111"}, {"status": "PUBLISHED", "id": "672711372891489"}, {"status": "PUBLISHED", "id": "1906148482982199"}, {"status": "PUBLISHED", "id": "6391658498413
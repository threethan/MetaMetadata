1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQgfHFs6ZB_SHnw-tk36gjQG4rlI3dVvuC7PXJ1Zmtyg&oe=6AF715CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GunClub3VR_thumbnail.png", "id": "2029033374029229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504730_2029033377362562_5417587750498992128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW__E4WOArEQ7kNvwHcu1c8&_nc_oc=AdpI2WFEHVTf-nI9cVkuGsiBL8YhZbSY8I5QZxFbS6w2grgMKyrCp0-t92oc8Q6D-x0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwaMjsfeM8InleNGEbMVRXpalKkjHEUyoreRZaIonBmQ&oe=6AF72547"}, "display_name": "Gun Club 3 VR", "keywords": ["guns", "shooting", "gunclub", "allied", "swat"], "long_description": "Take to the range with an incredible arsenal of the world\u2019s finest weaponry. Gun Club 3 combines challenging, addictive gameplay with stunning visuals & unsurpassed detail; the only thing missing is the smell of gun powder.\n \nThe newest release in the best-selling Gun Club series, Gun Club 3 brings a whole new world of excitement to the most popular gun simulator ever.\n\nUNPARALLELED REALISM\nHighly detailed interactive 3D weapon models that are fully operational & feature real-world ballistics.\n\nADVANCED CUSTOMISATION\nCustom-fit your weapons with hundreds of different attachments. From scopes to lasers to grenade launchers, the picatinny rail system allows for any load-out you can imagine. \n\nINTERACTIVE RANGES\nFire your weapons in a multitude of different range scenarios, from hostage rescue to long distance marksman to the dreaded zombie apocalypse. And for true shooting purists there is the classic target range. No time limits, no scores, just you and your weapon.\n\nGo update now live!", "short_description": "Take to the range with an incredible arsenal of the world\u2019s finest weaponry. Gun Club 3 combines challenging, addictive gameplay with stunning visuals & unsurpassed detail; the only thing missing is the smell of gun powder."}]}, "develope
cdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf1VhToJNk4Q7kNvwG8OXfN&_nc_oc=AdoVgbMcbYSEgmrXCeLLqSZzZSupE12WVrHxW0OfpX6H3yZuSafBKO7jwmzc5aj2_5c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVXMW99q0r5KkxMqLWkjVZtfNaF1bFNZZng8jXnxJNyA&oe=6AC7AAB0"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4tseMKHljMQ7kNvwFfl9nD&_nc_oc=Adr5MMRvz2EwqYGXetVh9iCBmpr7txFDR3j8T9d27sSIdFWKruBUKDlN99Hn5txcRD0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1h5IalGm2TO97WemzZCcsr2feIHUra1jGb5fPcS9lQw&oe=6AC79702"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundi
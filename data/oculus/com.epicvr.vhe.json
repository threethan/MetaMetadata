cdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlzQDfgvj8QQ7kNvwHDKccc&_nc_oc=Adqoc50GXu_Esenj2iiqg9pxLjMD1RTPwrVy5HwxBdhZxenT0a8mpaJW6yDp8LNldM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVTKT0cMfIWJetGTWpujYEY_6DgpdUv4yqF1jYy2Ejmw&oe=6AE74EB0"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRSR1K3QT-cQ7kNvwHhRzXx&_nc_oc=AdoYom3XDz8yViSfM_3RxOM8SiEs30CgbRYTnmq9OWPOWTVR25RAfySkqkY8S4tvZhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScd8fG_YwqlqHIah3V7PE6ryNPtVJgmM2D6kNBcVZmqA&oe=6AE73B02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundi
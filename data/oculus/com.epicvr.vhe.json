NvwHMPps0&_nc_oc=Adm1Om9sqhzi531FMR2N7PS24ht-TSKTjo71xeiPf3L3zRq_NbqdFzHy4BxFOLGLk98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu63W7IZawJYg44Cu5qM-vukiDVt29C-VSPdO1jm-l0kg&oe=69A97738"}, {"file_name": "Screenshots14.png", "id": "1088329881654429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982553_1088329884987762_8715548583848926529_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnp9LZjpuQ4Q7kNvwFFeIER&_nc_oc=AdkQkQFP-begEMmFYDDo3VGoMTnZWjC-DF-p4GSRYLiyp5a5xtooyXZ06L2IcC2ORAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs03j9QLo65blC5tLLxqZw7f2bDQKV0Gx9tqI7wVgIujA&oe=69A992BF"}, {"file_name": "Screenshots13.png", "id": "193491705889855", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOIsrNp78bMQ7kNvwFM1VF_&_nc_oc=AdkM5fooQSIO4UQG3uYq4vk487lOpvJn1zduoTHr5z1l6SKh7Qci-dYujs5prcRCZoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvEViLFLW6METysQ2neoX83-6Gcpx4hCtqZAKuMSi8WRA&oe=69A99530"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wF8L9FpyEwQ7kNvwFoT8ZN&_nc_oc=Adkci3Rv1VbnwwHKor8JvfskP3KBwzo9XBX4yxPSZ8Okne1PeLOreXhg32CspbE0cQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftnNYx0Wc3dzxQispaKH3Y3vWiTH-gvlJT4GeQyFtLwlg&oe=69A98182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zdjecie w tle.png", "id": "1365345023825377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572663_1365345027158710_8073058259518614664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quoOkEYrLokQ7kNvwEPwjpF&_nc_oc=AdkbQF6DfJnuCVZgcxbpRhZQc30zoanyxKJrAd8usfeNihkWRpoKpT-v8rSfnMJqZl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvI94R6Zx2Kj6IKl6HSs1evvrReHoTY1TXmRuQ6g6vUMw&oe=69A97075"}, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings."}]}, "developer_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "developer_privacy_policy_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/before-and-after-forms/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "support_website_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/contact/", "website_url": "https://eascape.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area":
IgQ7kNvwFZB-xS&_nc_oc=AdlZDJaZpjppoUExefjNoN60LV2ivzRNnomwRofJr0wfL1Wu3xE6OgFPC7NVPkLDWjE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afyan6eNPEsytQpSeumNrCsjT2eftqgavXljxE4k8JOwpw&oe=69AAC8B8"}, {"file_name": "Screenshots14.png", "id": "1088329881654429", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982553_1088329884987762_8715548583848926529_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnp9LZjpuQ4Q7kNvwGzZppn&_nc_oc=AdlyE7r9uD5UP4pvueAHeoN4GSfkDSnuOQRJOs6OFMzt0aMHyuB1slwSMRVMHNSMfIM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBYY8uUTj0eJgMSeGNFmMskdxydfLkQ9kLyMTHCm3cQw&oe=69AAE43F"}, {"file_name": "Screenshots13.png", "id": "193491705889855", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOIsrNp78bMQ7kNvwEkW_xy&_nc_oc=AdlJnPyq7sY7zP5DXKS5uTgVJzjNLK474RyKoMP4prKaC2FyYvk2ktUNl1zQuWRHFuM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0vtoeAXYwla6xYijQqEdtVd7HiQkBjKUKoDK_KAbBOg&oe=69AAAE70"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD930qSSODcQ7kNvwGMzN2a&_nc_oc=AdnhtrDRip3WjE4KDmtlF0oXuxLku51BZygeeYOlKExEZKusjfX96hrtqMcYJiXMERI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzU9ZA13r-UBJdu-iPf2jKSVqyHzEIbwpgP27-isUNzQ&oe=69AAD302"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zdjecie w tle.png", "id": "1365345023825377", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75572663_1365345027158710_8073058259518614664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quoOkEYrLokQ7kNvwEXf9L1&_nc_oc=AdlaFzG0NtXPLTIJWbun-cRlfpQLodOIuWhez6yMLxwE2F6ZqqXETD3sVLHT6VDZqcs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhbV5O04hxMHmZMjwTjRIus6f2VOyMyvmcYyxRL0JouQ&oe=69AAC1F5"}, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings."}]}, "developer_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "developer_privacy_policy_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/before-and-after-forms/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "support_website_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/contact/", "website_url": "https://eascape.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_
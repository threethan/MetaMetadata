NvwELrtxB&_nc_oc=AdmPvgB45j6Q2E95I9pPx0OIDVLDvv83eUECID9owuS3cygl96przVKGNdvOt3jFKLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyl08B9WIKHADLRj2i4syJGsb-8cscAMUSQiRLtEPEmwQ&oe=69B2B1B8"}, {"file_name": "Screenshots14.png", "id": "1088329881654429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_1088329884987762_8715548583848926529_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2EIEvAawKIQ7kNvwEeQ09F&_nc_oc=Adlx7NWrvjIUVOoQbQd5yO7nKV-KLMZbFJ0Db4lAc4f94r8i3LycyhV_op0UH2S5S94&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxvBSueKG6b0plcnnQ0eu8JbDPTi2jwxXFbUOxnD4bsXQ&oe=69B2CD3F"}, {"file_name": "Screenshots13.png", "id": "193491705889855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCvecNLbujYQ7kNvwEes_6F&_nc_oc=AdmAPwYgI7KGB4AApb5YEvY5rBG-0wQOpS8Uz3mQj8o58HQaf9Li-Uf0xmn2G2yXCxc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhxN_XwzqTnL_9s1EhIUcayvvHsLSAlfOKbKeG5YZgTw&oe=69B2CFB0"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdeAUbNGgG4Q7kNvwFWSp5f&_nc_oc=Admk1jhfpX9Sil8TOLEPtRFQ82QJ35NL1PexKK-GF-D-yaSfQX5bW5KstYiyjAS7Soc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxX7_b1BQ2qKTKYur4Dmv09SEPEg4Cj9VHAVlwKfZQhug&oe=69B2BC02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zdjecie w tle.png", "id": "1365345023825377", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572663_1365345027158710_8073058259518614664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYeRSp6mjRgQ7kNvwHfOdLe&_nc_oc=AdkwVeaeKHvTQ8-oy0AdRTij0xkRycjyE0bR88mDfa6QVgrxg-ARTR5XzDVanxJR5CY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBps8CWEW0iq8tpBrVSnuTrEQhxs085cR33ekthG_3XQ&oe=69B2AAF5"}, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings."}]}, "developer_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "developer_privacy_policy_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/before-and-after-forms/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "support_website_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/contact/", "website_url": "https://eascape.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area":
NvwFTfl0L&_nc_oc=AdljWJxVYHQ2KqA1tzdCQJgKShTVxe2sBZMjWpW760ymMdvS-6gfuekfuYlNse7ejUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9oI_4YetsUgoqq8H6xduMIH7_ThPk1fwKjcVX2MfTRQ&oe=69B94938"}, {"file_name": "Screenshots14.png", "id": "1088329881654429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_1088329884987762_8715548583848926529_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoQJWXA1tokQ7kNvwEmIcMt&_nc_oc=Adk3ZyjgWQnenDYvJXk9BUokwU5jb1mPoOoo58tP4YDQnuPuUlkO79-zZxsCFTHWWCw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzsy7WZiuUJWzBx_Y8TxjDIAWBJ_roaegeZeRUwV65-fQ&oe=69B964BF"}, {"file_name": "Screenshots13.png", "id": "193491705889855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUga9UTo0XQQ7kNvwHkI9tq&_nc_oc=AdkNUZHAWuDCzURLdCYJ6Ne1jO4R7E07H2BbThctSqp3jjtrXUNeO9O15e3YKvf_O34&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxrmkOv7QkhYmXNsnWYLW9C1MFwGad0SjdLpGZF0E_UJQ&oe=69B96730"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG2KDLn8fEgQ7kNvwF2Cnu3&_nc_oc=AdlhmfM0HNHOQu4-zKXehVVuKtOKSkpstoA7eCkf-l61H5us6iYT_i5_oT5Yp5vdndU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiDJ4gALvCN2hegJD6cL_bTAR4nIdqXBAt_KS5S57b-A&oe=69B95382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zdjecie w tle.png", "id": "1365345023825377", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572663_1365345027158710_8073058259518614664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfDZaxXUY88Q7kNvwEkCLAn&_nc_oc=AdkM6wm_KObdiI8RAvL7Hhdwrri7CTFChNqfESkCkonQZ8cU5Vo6AdkGNDGhwmaCqF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPksnWTmziRndXHZQDc5MguvUKij5n6RY8YDcA6eCMLg&oe=69B94275"}, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings."}]}, "developer_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "developer_privacy_policy_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/before-and-after-forms/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "support_website_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/contact/", "website_url": "https://eascape.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area":
id=6e7a0a&_nc_ohc=Tcgy2TsSssQQ7kNvwGM8XJI&_nc_oc=AdpFJ6Q2pr3cOehEz-RVK9xm7p3NNxXxPPJQTvkrWeOIQrQ6Amjcc4BU8UyuxAC8zzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_vblv7C4exrd30iIHa97zzVsHq3xStxnYdV_vHBlH5w&oe=6A69F238"}, {"file_name": "Screenshots14.png", "id": "1088329881654429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_1088329884987762_8715548583848926529_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzpoHT8HO6gQ7kNvwGgQBak&_nc_oc=Adrm0lEVLyNHusI_YIw3r4a_2xnUkW5TIhMNz3caI5p5ZaVITM4XutC96_44tF2Zgms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNjwhpJR_WPCti5EUMawHNV9Y21QppqdhYC5_kddjNlA&oe=6A6A0DBF"}, {"file_name": "Screenshots13.png", "id": "193491705889855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=994z8MTHvUkQ7kNvwHHXa2l&_nc_oc=Adq5y_OlHNpaTvNYZxbNfBDYZXvmR3f4mbvMlBDkeR2Rxr7VOOjcQiYuJKVo5OGz7g4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuBtlkanMoEK8ngPvBhhjq25755BRgejZfGu_fnqvMpA&oe=6A6A1030"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1Wc150wSlQQ7kNvwHyZ8pf&_nc_oc=Adqzdp3TkGOLxe7v17Rp_2D-azZ5vRn2iIBpMR_5G38pIm_89VpBGO53yQ7vHqtYCuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAARkBNe1uvNvUKo3oNA4uwi4EntvhcoSpk9-xptro76Q&oe=6A69FC82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zdjecie w tle.png", "id": "1365345023825377", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572663_1365345027158710_8073058259518614664_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct0RFVhvKJ8Q7kNvwGiDf-j&_nc_oc=Adr_TK0rfu5mKDMGSOMHu-GF7rJsFcPW5qx9-SMtigFZ6PT_oR5sh_erxd1uUJIKZRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtxRlDLZ8tHiS_tGaakri1UYufzHj-3MTog_IXXbX_7w&oe=6A69EB75"}, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings."}]}, "developer_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "developer_privacy_policy_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/before-and-after-forms/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "support_website_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/contact/", "website_url": "https://eascape.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "interne
cdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlzQDfgvj8QQ7kNvwHsCcFh&_nc_oc=Adqlz1d0xvx2TcxM6LdNElZp_ah4PGP7kr_Na0yzeYMiTiivycdwiRfw44r2yG2VVcs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLm78h8GZvt8KzCROA5gLMfPxNuH6y1Nc2f-5TkG9AqA&oe=6AE8A030"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRSR1K3QT-cQ7kNvwGFgPBh&_nc_oc=AdqdyXrVY-YJ9h2JizJmOOOq7qjSlxYYBUFNf18BlfAEYoAURbHGbkKlrH-dO-b6rfI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZl0kmrHUongT7tonnRon9XWjCzGA2o6e3bIGQdzSoBg&oe=6AE8C4C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundi
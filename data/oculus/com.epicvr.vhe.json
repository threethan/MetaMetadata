cdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vp9JcmWQlkcQ7kNvwHTnJcD&_nc_oc=AdpynUX-RuXNg6gXZ-tRniVjcmGQcp7G6ENc71zuwa0dQThkV40o3-xINQMsmLMvzlw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfVxHJOX3ZCVWzHjGXT6cXotUZvTFgWzzh1_0mb-aMNw&oe=6AEC94B0"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyF4C041iLgQ7kNvwHfbVH9&_nc_oc=Adp1xqz_VXu8-G9ul_W15eRKCVNog6mvixShcHukdgTpxxGi9Lb2GoIXP0V7N54O5d4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ6xnxVKJnZomwp5MS9NhwG5O0nyjvpz1iYOKJELVOpg&oe=6AECB942"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundi
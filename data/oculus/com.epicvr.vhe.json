cdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3Y374gvQDsQ7kNvwEz63bs&_nc_oc=AdqGQlMndHhhFqXKLf0NDCGIjFI9eOuWci4opdUE2KtQdxwutkPKH4-s5dkB8aAJDok&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwNwvcosBlFexufwrZ9J8f5vODWJ1bVl6MMBXCAmDrTA&oe=6AE208B0"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut_durM5hSQQ7kNvwEvtaQ5&_nc_oc=Adr6v39av505TBv4PQWA9TBGSGo0BZ9YSj0ei3SjVBdLSML9MRkXv7dW_Sg1e2IgVlU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkjGSIkqYNCfpmTRtSbZWrOGyWpiN28SQFKLQjS8a_Hg&oe=6AE1F502"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundi
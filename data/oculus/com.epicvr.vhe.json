dozRHrBRJSa3Jklw&oe=6B05BB78"}, {"file_name": "Screenshots14.png", "id": "1088329881654429", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982553_1088329884987762_8715548583848926529_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gw88S_cCBkQ7kNvwEga_dp&_nc_oc=Adr-b-dKdZ9DOEcE7cPXt9d4BaDVuj7Tovgwu9heDOO6r7Z-pk4g-bUj4KZYwVXL3Yc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe30DSOca1sUvhxTWyTblvL3paNWG1_ASDKrUOHxy58Q&oe=6B05D6FF"}, {"file_name": "Screenshots13.png", "id": "193491705889855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223475_193491709223188_8694784358737836970_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFH87ltzEgEQ7kNvwE9VxK8&_nc_oc=AdrxaExAL-lA3agQTFZ0POWDkY7GGi_fXreQKoVy5QC73vZsNk7fsIHOJ-FhIMzfJ8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhXVtBPEmqj-QIeuuguB1CZ9hKhHVCUIvLKArlZZ44OA&oe=6B05D970"}, {"file_name": "Screenshots12.png", "id": "137236878342943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404372_137236881676276_7653335583313797718_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVMemdB0heUQ7kNvwHHhKD_&_nc_oc=AdrkhOpiYmljDc-q53qK0nJwBcr_zRYBCb5Ja-DIdQpPPCRYpU-4L6AA_L5xwa3vBUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf5hLTj37Peva3nOByP9C6tjEM_JFGI9YutK2v135yIA&oe=6B05C5C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eascape", "keywords": [], "long_description": "Immerse yourself in the relaxing power of nature and find your inner peace within contemplative landscapes carefully curated by scientists. \n\nEascape is not a game. It is your new self-care tool that combines knowledge of neuroscience, landscape architecture and VR technology to give you the amazing opportunity to connect with nature right from the comfort of your own home. This is your calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings. \n\nEarly access version features:\nBeautiful natural environment with relaxing & meditative properties\nScience-based selection of 4 contemplative views\n3D full HD quality \nA complete immersive experience with natural sound\nEasy navigation & teleportation by sight", "short_description": "Ease your mind with a virtual journey. \nEascape is not a game. It is your new self-care tool. \nA calm place where you don\u2019t need to achieve any goals or perform any tasks. All you need to do is let yourself be present and mindful of the surroundings."}]}, "developer_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "developer_privacy_policy_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/before-and-after-forms/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NeuroLandscape, Epic VR & Brainstorm 3D", "support_website_url": "https://eascape.org/index.php/eascape_ease_your_mind_with_a_virtual_journey/contact/", "website_url": "https://eascape.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4795092353873507"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binar
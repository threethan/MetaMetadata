RrpvWRqS37A&oe=69C12DE0"}, {"file_name": "ApplicationFrameHost_vXUq5wXFIu.png", "id": "522958917218502", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035372_522958920551835_473137394626911759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRxWAa2r7d0Q7kNvwGXnHIk&_nc_oc=AdqGNnf8CXEihQvXHRze0o2oanO8CdMFrtWj2ZirSCAZfde_Q4g9Fpt8rclqyoYHJx8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afze1SoAjUNfAERZIsX4WZhPige8I6GoFCZNVGKnHspzDA&oe=69C14A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Public Transportation Safety Simulation_Landscape.png", "id": "3886725471554632", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982652_3886725474887965_391720936567370794_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR5VCWb4CpUQ7kNvwHh8MgD&_nc_oc=AdpP5q2VHZ0y5qSvQACuy8MN1Wn8Bed9d0syEp5Ckwb3xCQ2s3AS8_xIZu-wcLdt_io&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyRbcIkN5tbAW8nS1G4SNNReS893NqlolcLIGovpWW2Q&oe=69C146B0"}, "display_name": "Public Transportation Safety Simulation- ContentsDa", "keywords": ["safety", "transportation", "traffic", "simulation", "contentsda"], "long_description": "1. Pre-departure safety check: Hold onto the chair handles and do a pre-departure safety check.\n2. Safety on curves: Keep a firm grip on the handles on curves, which can cause accidents.\n3. Arriving at and exiting a stop: Make sure the bus has come to a complete stop when you arrive at your stop and exit safely.\n4. Moving and crossing the street: After getting off, move to the area highlighted in green, and at crossings, check the signal before crossing.\n5. Move to the opposite stop: Check the highlighted markings and move to the opposite stop.\n6. Wait safely before the bus arrives: Check for hazards and wait safely before the bus arrives.\n7. Make sure it's safe to board: Board the bus safely when it arrives.\n8. Prepare for emergencies: In an emergency, use the emergency hammer to break a window and evacuate if the door is blocked.", "short_description": "Experience the safety protocols in public transportation. This simulation emphasizes the importance of being aware and prepared in different transit scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8823791714309225"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75584096_1092241205241159_7754825061132262735_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5FJogd0pr4Q7kNvwE4S-Em&_nc_oc=Ado_ahhUKGUiDYaxnm7VdZPKizL74H3pvtU32w3nuvRyyP3edNvYjC5Dn-fytG6r4TM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfybkKU04wmMzl05T-G7cH-vyM6EkPmkFpmlRH_74hArWQ&oe=69C14CB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Public Transportation Safety Simulation- ContentsDa", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707
0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX4EwSEKkpQQ7kNvwE59TS8&_nc_oc=AdmY_QIvsF8AhGYBVhDNyC6dz83FBkB7s_vDTfgNhq2o1S7j-lrviWuNwzpRrdvIlno&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu20CkPUoV1JsyCNG-krLePFaeXwJBmr0axGX74Cr38aA&oe=69A445B0"}, "display_name": "Public Transportation Safety Simulation- ContentsDa", "keywords": ["safety", "transportation", "traffic", "simulation", "contentsda"], "long_description": "1. Pre-departure safety check: Hold onto the chair handles and do a pre-departure safety check.\n2. Safety on curves: Keep a firm grip on the handles on curves, which can cause accidents.\n3. Arriving at and exiting a stop: Make sure the bus has come to a complete stop when you arrive at your stop and exit safely.\n4. Moving and crossing the street: After getting off, move to the area highlighted in green, and at crossings, check the signal before crossing.\n5. Move to the opposite stop: Check the highlighted markings and move to the opposite stop.\n6. Wait safely before the bus arrives: Check for hazards and wait safely before the bus arrives.\n7. Make sure it's safe to board: Board the bus safely when it arrives.\n8. Prepare for emergencies: In an emergency, use the emergency hammer to break a window and evacuate if the door is blocked.", "short_description": "Experience the safety protocols in public transportation. This simulation emphasizes the importance of being aware and prepared in different transit scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "exte
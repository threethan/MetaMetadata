LPA&oe=699F05EA"}, {"file_name": "ApplicationFrameHost_tm0IlOd0RE.png", "id": "1284633052888337", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615252_1284633059555003_6854588418256912788_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhrepVDGaeUQ7kNvwGHXMVW&_nc_oc=AdneHX9H_MFlVIf_qXSIVLtOu1F7bsu0U34WYeqSm2HiAS-0UKd5cDU64Vc22rK1BiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvwn1t4fBeaaaBFU4TleBc3ZzDnztGThDQ0uroDsMsBuQ&oe=699ED557"}, {"file_name": "ApplicationFrameHost_coiZYZ1hme.png", "id": "914110810645908", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982596_914110817312574_523849571035051177_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tq5W0_-3_44Q7kNvwEjsjRc&_nc_oc=Adl3lD61dxukiYRPTfn6L6vMOXvDZOPAtI9Okybi6lfckQp-FudvQOtVhv2KHcwW3XM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsLvOUX1sX04GofKDKJ86ZWM_kwGOK_OJSM6KZP6fwuWg&oe=699EE6E0"}, {"file_name": "ApplicationFrameHost_vXUq5wXFIu.png", "id": "522958917218502", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035372_522958920551835_473137394626911759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quToFv09MHoQ7kNvwHdWa7E&_nc_oc=Adl0erNeC_Vg8vmI5bzKzcyrcUfZVm7HgXEYyHaF9esPI_EnQxwignjegjGmHesq0TM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfueMocTQFKoE6nj5zxbd3_PLGAcYJG_eifSm0iP1qRuwg&oe=699F0340"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Public Transportation Safety Simulation_Landscape.png", "id": "3886725471554632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982652_3886725474887965_391720936567370794_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S53FKmjoguIQ7kNvwEHzZKv&_nc_oc=Adk1E0G9zwpsqtQ_T6YUr6iD_Lv_Rfk6RGvPFaRVDOL1kJz_snTrQwhusJ7vvqgELI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftfqH6WBvpaX-6D15yn7KsCAnj1pXwlvn8QIbQvgkIHdg&oe=699EFFB0"}, "display_name": "Public Transportation Safety Simulation- ContentsDa", "keywords": ["safety", "transportation", "traffic", "simulation", "contentsda"], "long_description": "1. Pre-departure safety check: Hold onto the chair handles and do a pre-departure safety check.\n2. Safety on curves: Keep a firm grip on the handles on curves, which can cause accidents.\n3. Arriving at and exiting a stop: Make sure the bus has come to a complete stop when you arrive at your stop and exit safely.\n4. Moving and crossing the street: After getting off, move to the area highlighted in green, and at crossings, check the signal before crossing.\n5. Move to the opposite stop: Check the highlighted markings and move to the opposite stop.\n6. Wait safely before the bus arrives: Check for hazards and wait safely before the bus arrives.\n7. Make sure it's safe to board: Board the bus safely when it arrives.\n8. Prepare for emergencies: In an emergency, use the emergency hammer to break a window and evacuate if the door is blocked.", "short_description": "Experience the safety protocols in public transportation. This simulation emphasizes the importance of being aware and prepared in different transit scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"],
om&_nc_ss=8&oh=00_Afw3Ux7P4i3J3rDZGkmJz2xZA1dmSL-t6Rc88mEsyjHEzw&oe=69C12258"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09.cover_image.png", "id": "314182564738222", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031377_314182568071555_8512792515227097295_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeH3xZ7Tc9cQ7kNvwGChRS9&_nc_oc=AdognRcZAIhcPmgICgbB7v3_Ul-haNt8rh4LjLjubgX4DzkVX7eqwzjExcEl5qiRfJI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWGsgCngqVAvz80VH6lCWqaRASB63Vjz5wthibwi4XMQ&oe=69C12BDA"}, "display_name": "Public Transportation Safety Simulation", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 experiment.  This application supports two languages, Korean and English. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
ntent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcsJkSj9rXjW9X6-W9qr8SijdVR3w2jubCG-2b44z4Vw&oe=6AB3EF17"}, {"file_name": "I1440x1440_ICON.png", "id": "884988647590953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822883_884988650924286_2963174681105821176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TGaO2y7DOoQ7kNvwEynbGA&_nc_oc=Adq9S_kUlic6Vj1_wkxChgBSoN5MBYaMFVUHeExkFa5wRVQUU4VieA-pv6fuCTPqUsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcKc5Ll6lCtRxyjwHhFofP2sqLW0bAdyTxlgEymG_8gg&oe=6AB3C60E"}]}, "id": "1992106634689130", "locale": "en_US", "screenshots": [{"file_name": "IG_Screenshot 3.png", "id": "1569559574291655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1569559577624988_1822307655087399260_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbWmQQWBMfMQ7kNvwHxwRUk&_nc_oc=Adojqs_64h2UIBjRRqNssOd_glxhzgtc7qPP-KiDCMxlQANt2GMJudBB1h_PZKTSt7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF5lILhKv3bH-WGyI0cspjk_wG3Uu8-ofjdM-FB4C96A&oe=6AB3E29E"}, {"file_name": "IG_Screenshot 1.png", "id": "1244769864217929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_1244769870884595_1419569731646063774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB6dVf1vq80Q7kNvwF1XEK5&_nc_oc=AdqwMHbAYlqkTCp0gA7Hd_97AaTaupQMjwfB_qtEdoMlc8v_aHfsLosTvODrQtKFOkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWod0edVXNA0ht9aKY_9QkWK2eZUNtNkQsuFVlf_bCSA&oe=6AB3E25D"}, {"file_name": "IG_Screenshot 2.png", "id": "887447484017207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_887447487350540_2316505709178562476_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGMWFXu8NmMQ7kNvwGTRAIc&_nc_oc=AdoUKt6hBWkYUxahlKyH-fXOs9dQlKiS2pGsHpWQLt1LajNb6gfdub7ctSKeJeDKo1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4YjdYDpA4xLK6utYSjyYVZpVO9PZvLpgYB8HA_GA6Yw&oe=6AB3F096"}, {"file_name": "IG_Screenshot 4.png", "id": "1234931085236477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_1234931088569810_6477745044212934096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH_oPYzxuhMQ7kNvwGRLb4c&_nc_oc=Adofv1je_9hH6QrMCGUhSATHikQUtNZdjBw5RJVunreBZZC5hxOoxmCetyQIH_Y04dE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzXlTDHfwcceyyWTNRrH2d8QY-yMiaHYpTROAs4pCoCg&oe=6AB3F025"}, {"file_name": "IG_Screenshot 5.png", "id": "1990920171485289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821799_1990920174818622_9163330749836139368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z_JuaDnkUkQ7kNvwGk4aQ-&_nc_oc=AdqCeLqXJxRRxLCw5jeFUKPrKwiH78XE-fLjp2rynWLrh4c6wJ0HgUPrsM7MU0n8e4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNLAFKFtkkmZWLO4UFSmhGU_1spkN0jasyxYB7sMW4iQ&oe=6AB3C963"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Impostor VR", "keywords": ["impostor", "social", "deception"], "long_description": "# Someone here is lying \ud83d\udc40\ud83d\udea8\nAnd in VR, you can\u2019t hide \ud83e\udee3\n\n**Impostor VR**  is a **fast-paced social deduction party game** where real human behavior becomes the gameplay. Step into a shared space, look other players in the eyes, and try to survive the pressure \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83d\udd25\n\n**One player is the impostor.**\nEveryone else must figure out who\u2019s faking it \u2014 before the final vote \ud83d\udc49\n\nThere are no menus to hide behind. Your gestures, your silence, your distance, and your reactions can all expose you \ud83d\ude2c\n\n**WHAT MAKES IMPOSTOR VR FUN**\n\n\u2022 **Face-to-face multiplayer** with full social presence \ud83d\udc65\n\n\u2022 **Physical deception** using movement, gestures, and eye contact \ud83d\udc40\n\n\u2022 **Short 3\u20135 minute matches** built for quick sessions \u26a1\n\n\u2022 Loud accusations, tense debates, and **dramatic reveals**\ud83c\udfad\n\n\u2022 **Easy to learn**, hard to lie \ud83d\ude08\n\n\u2022 Designed for **friends, parties, and unforgettable moments** \ud83c\udf89\n\n\nEvery round creates natural chaos \u2014 pointing fingers, nervous laughs, and sudden betrayals \ud83d\udca5\n**No two matches ever play the same.**\n\nWhether you\u2019re jumping in with friends or playing with new people, Impostor VR delivers intense social pressure in minutes \u2014 perfect for parties and perfect for sharing \ud83c\udfa5\ud83d\udcf1\n\n\nTrust breaks fast.\nTension builds quickly.\nAnd when the vote begins\u2026 everyone is watching \ud83d\udea8\ud83d\udc40\n\nComing Soon.", "short_description": "Someone here is lying \ud83d\udc40\ud83d\udea8\nImpostor VR is a fast, high-pressure social party game where your body language gives you away \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83e\udee3\nStand face-to-face with real players, accuse your friends, and survive the vote \ud83d\udc49\nShort matches. Big reactions. Instant chaos \ud83c\udf89\ud83d\udd25\nTrust no one \u2014 especially the people you know \ud83d\ude08"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_trackin
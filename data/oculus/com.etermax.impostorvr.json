ntent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8_NWwOzwo7Vh0IUZUpX9av7tnYlaLXtKrKSqZcML_Gw&oe=6ACE4D17"}, {"file_name": "I1440x1440_ICON.png", "id": "884988647590953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_884988650924286_2963174681105821176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXnSAQ21ZNsQ7kNvwGHzRFQ&_nc_oc=AdqSRBhr5dMJ8SDAltmqJXtFqsJ8Rxk-xr8NVLWhoW-ceGXzRautwfOI0M9qm9cJHd8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF8apGZKNmelqUewjBu0zDmuM7g8J1jIfeGvvonwdC4A&oe=6ACE5C4E"}]}, "id": "1992106634689130", "locale": "en_US", "screenshots": [{"file_name": "IG_Screenshot 3.png", "id": "1569559574291655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1569559577624988_1822307655087399260_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOfquW6kaCUQ7kNvwGMm_FY&_nc_oc=Adov715IWW_fnB_j84ovpa6SaCAxK0bixrzq_68984a9jnGm_aK2Zf-IoEEiNnFSxMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr-eAF5GcRzX-R3UhRfNOGnLcB5okLsyNDWNc_BEdYAg&oe=6ACE409E"}, {"file_name": "IG_Screenshot 1.png", "id": "1244769864217929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_1244769870884595_1419569731646063774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQcOMtdIFikQ7kNvwGuTCIu&_nc_oc=AdouUVoDO3kbyZNZLO-Q0AlJsxARukJSmSr7zAwY-NM_ZVgShrh4PAxsVAlteiIjkoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIdxbNKQf2t3Uo4wGx5gcuSC7-mjutB-XZ4a5PQJGYCA&oe=6ACE405D"}, {"file_name": "IG_Screenshot 2.png", "id": "887447484017207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_887447487350540_2316505709178562476_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou_ViJAZD3wQ7kNvwEQRNTc&_nc_oc=AdoU019DvbfL1_D9gTvj5izQg_zvImQhvHQ4HYKNbJndwRtxEZ28E02KjuivuZOK59Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNueO-uJHESv5C-ZqQeLiaDvPlry_gsOzLj7HPg3RJQQA&oe=6ACE4E96"}, {"file_name": "IG_Screenshot 4.png", "id": "1234931085236477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_1234931088569810_6477745044212934096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV6yqJc3zB0Q7kNvwGVPr54&_nc_oc=AdrUJVl1r2SIALkjqaVeGARQzJFsVMuxeuP_TOmZGTr4bZSURJfrNltbk77JiWWIAaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSswXWi_NJ9YbvOOCGIXGsinpDRKxPfV5IVrU_4eO7ZA&oe=6ACE4E25"}, {"file_name": "IG_Screenshot 5.png", "id": "1990920171485289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821799_1990920174818622_9163330749836139368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRf0xhfu9jQQ7kNvwGnZDMd&_nc_oc=AdpZCUH4JVC2UEeexx8AGBwr8OvyDqqRMmRTcwcmyDJWezfa4IMazIyAC7Y4ano8hu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7QXM8ElG4Naragn5L-fzV2hSxWiV-onniElJ_yry5QA&oe=6ACE5FA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Impostor VR", "keywords": ["impostor", "social", "deception"], "long_description": "# Someone here is lying \ud83d\udc40\ud83d\udea8\nAnd in VR, you can\u2019t hide \ud83e\udee3\n\n**Impostor VR**  is a **fast-paced social deduction party game** where real human behavior becomes the gameplay. Step into a shared space, look other players in the eyes, and try to survive the pressure \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83d\udd25\n\n**One player is the impostor.**\nEveryone else must figure out who\u2019s faking it \u2014 before the final vote \ud83d\udc49\n\nThere are no menus to hide behind. Your gestures, your silence, your distance, and your reactions can all expose you \ud83d\ude2c\n\n**WHAT MAKES IMPOSTOR VR FUN**\n\n\u2022 **Face-to-face multiplayer** with full social presence \ud83d\udc65\n\n\u2022 **Physical deception** using movement, gestures, and eye contact \ud83d\udc40\n\n\u2022 **Short 3\u20135 minute matches** built for quick sessions \u26a1\n\n\u2022 Loud accusations, tense debates, and **dramatic reveals**\ud83c\udfad\n\n\u2022 **Easy to learn**, hard to lie \ud83d\ude08\n\n\u2022 Designed for **friends, parties, and unforgettable moments** \ud83c\udf89\n\n\nEvery round creates natural chaos \u2014 pointing fingers, nervous laughs, and sudden betrayals \ud83d\udca5\n**No two matches ever play the same.**\n\nWhether you\u2019re jumping in with friends or playing with new people, Impostor VR delivers intense social pressure in minutes \u2014 perfect for parties and perfect for sharing \ud83c\udfa5\ud83d\udcf1\n\n\nTrust breaks fast.\nTension builds quickly.\nAnd when the vote begins\u2026 everyone is watching \ud83d\udea8\ud83d\udc40\n\nComing Soon.", "short_description": "Someone here is lying \ud83d\udc40\ud83d\udea8\nImpostor VR is a fast, high-pressure social party game where your body language gives you away \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83e\udee3\nStand face-to-face with real players, accuse your friends, and survive the vote \ud83d\udc49\nShort matches. Big reactions. Instant chaos \ud83c\udf89\ud83d\udd25\nTrust no one \u2014 especially the people you know \ud83d\ude08"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_trackin
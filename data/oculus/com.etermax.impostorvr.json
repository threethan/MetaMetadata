ntent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR_lg4nl9bPnzGyal752g3iKWXl66eoLTsKsavah48dA&oe=6A9C3417"}, {"file_name": "I1440x1440_ICON.png", "id": "884988647590953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_884988650924286_2963174681105821176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os4z1hDPSvQQ7kNvwFQ14oR&_nc_oc=AdphEwDx13HeR1x7vCO30zI8FlhH0UnxVQDc82mNnPa3TiH2wIJwuFjzf609EsK3y08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5E-YkgJ14vS8Cgdi7uJX9WhYQcsRqDS8otKF3ZNYeDQ&oe=6A9C0B0E"}]}, "id": "1992106634689130", "locale": "en_US", "screenshots": [{"file_name": "IG_Screenshot 3.png", "id": "1569559574291655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824307_1569559577624988_1822307655087399260_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIkEhcQkqxQQ7kNvwHUT0tZ&_nc_oc=Adq-Qklq18NdJ846rSK1X5IszQzftfiNBHxb_QnDh3uGqH9FBl2VwX0wdoG8qD0qCQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6c672PzRp6nhcxTNFuLRDOH3Q_xcWdDdTDaaGAZnS7Q&oe=6A9C279E"}, {"file_name": "IG_Screenshot 1.png", "id": "1244769864217929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_1244769870884595_1419569731646063774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-yjKtbmuIQQ7kNvwEGPlf1&_nc_oc=AdoLbyxXv0S1IXRzJMOlDWUCDA0JEsrvCl3E3V6gT6gQwcq1z8NZM5_iDHzIy-ltrhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYu1o83qk2KJ21JdT9FjT7xC7rcK6t1FTYyUYK89ouDg&oe=6A9C275D"}, {"file_name": "IG_Screenshot 2.png", "id": "887447484017207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_887447487350540_2316505709178562476_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq7KxhoFivQQ7kNvwE1NuLT&_nc_oc=Adq4fKZBhVDKII8Qxk_LqxU-ZBowsL028YRx42ZanvmXnMbT2vwM7X1WRYwul3oxaVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvIS8cktRibQn2iwY-NbDe0Swk3aTeS7N_Nr5NGIBeWw&oe=6A9C3596"}, {"file_name": "IG_Screenshot 4.png", "id": "1234931085236477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_1234931088569810_6477745044212934096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVouOiIt9ucQ7kNvwHMzM6G&_nc_oc=AdpuuAcT8tMqZcvKug1r_KEGcQu7ipLK-okNZHI5gRDh-HLHUMr727pik6kMg7kBE-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8z4GHluU8Wy4WTyw1TuYFhmj2b4V8gwhyVPU5RVC_jQ&oe=6A9C3525"}, {"file_name": "IG_Screenshot 5.png", "id": "1990920171485289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821799_1990920174818622_9163330749836139368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAsw5ZPqpM4Q7kNvwHTStuB&_nc_oc=AdppeLnxHu3EfN6rIclFl_DsN7KStBJD-Ws3C5t6xmoAuVpSZ4aWoSs8kzbogZWadHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_ku1DjZu1-Y0jw6ZyKEF-FU-ZD8IpiQaws6NAEUV15g&oe=6A9C0E63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Impostor VR", "keywords": ["impostor", "social", "deception"], "long_description": "# Someone here is lying \ud83d\udc40\ud83d\udea8\nAnd in VR, you can\u2019t hide \ud83e\udee3\n\n**Impostor VR**  is a **fast-paced social deduction party game** where real human behavior becomes the gameplay. Step into a shared space, look other players in the eyes, and try to survive the pressure \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83d\udd25\n\n**One player is the impostor.**\nEveryone else must figure out who\u2019s faking it \u2014 before the final vote \ud83d\udc49\n\nThere are no menus to hide behind. Your gestures, your silence, your distance, and your reactions can all expose you \ud83d\ude2c\n\n**WHAT MAKES IMPOSTOR VR FUN**\n\n\u2022 **Face-to-face multiplayer** with full social presence \ud83d\udc65\n\n\u2022 **Physical deception** using movement, gestures, and eye contact \ud83d\udc40\n\n\u2022 **Short 3\u20135 minute matches** built for quick sessions \u26a1\n\n\u2022 Loud accusations, tense debates, and **dramatic reveals**\ud83c\udfad\n\n\u2022 **Easy to learn**, hard to lie \ud83d\ude08\n\n\u2022 Designed for **friends, parties, and unforgettable moments** \ud83c\udf89\n\n\nEvery round creates natural chaos \u2014 pointing fingers, nervous laughs, and sudden betrayals \ud83d\udca5\n**No two matches ever play the same.**\n\nWhether you\u2019re jumping in with friends or playing with new people, Impostor VR delivers intense social pressure in minutes \u2014 perfect for parties and perfect for sharing \ud83c\udfa5\ud83d\udcf1\n\n\nTrust breaks fast.\nTension builds quickly.\nAnd when the vote begins\u2026 everyone is watching \ud83d\udea8\ud83d\udc40\n\nComing Soon.", "short_description": "Someone here is lying \ud83d\udc40\ud83d\udea8\nImpostor VR is a fast, high-pressure social party game where your body language gives you away \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83e\udee3\nStand face-to-face with real players, accuse your friends, and survive the vote \ud83d\udc49\nShort matches. Big reactions. Instant chaos \ud83c\udf89\ud83d\udd25\nTrust no one \u2014 especially the people you know \ud83d\ude08"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_trackin
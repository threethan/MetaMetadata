_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "611064278511586"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "816351684886697", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR/XR \u0421\u0442\u0440\u0435\u043b\u044c\u0431\u0430 \u043f\u043e \u043f\u0435\u0442\u0443\u0445\u0430\u043c", "keywords": [], "long_description": "AR/XR \u0438\u0433\u0440\u0430. \u041d\u0443\u0436\u043d\u043e \u0437\u0430 \u0447\u0435\u043c-\u0442\u043e \u0441\u043b\u0435\u0434\u0438\u0442\u044c, \u043d\u043e \u0441\u043a\u0443\u0447\u043d\u043e? \u0412\u043c\u0435\u0441\u0442\u043e \u0441\u0438\u0434\u0435\u043d\u0438\u044f \u0432 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435 \u0438\u043b\u0438 \u0441\u0435\u0440\u0438\u0430\u043b\u044c\u0447\u0438\u043a\u0430, \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0441\u0442\u0440\u0435\u043b\u044f\u0442\u044c \u043f\u043e \u043f\u0435\u0442\u0443\u0445\u0443)  \n\u0414\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u0430\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u041f\u0435\u0442\u0443\u0445 \u043b\u0435\u0442\u0430\u0435\u0442 \u043f\u043e \u0432\u0430\u0448\u0435\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435, \u0432\u0430\u043c \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u0441\u0442\u0440\u043e \u0435\u0433\u043e \u0443\u0431\u0438\u0432\u0430\u0442\u044c. \u0423\u0441\u043f\u0435\u0439 \u0437\u0430 \u043e\u0442\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0431\u0438\u0442\u044c \u043d\u0443\u0436\u043d\u044b\u0435 \u043e\u0447\u043a\u0438!\n\n\u0418\u0433\u0440\u0430 \u043d\u0430 \u0432\u0440\u0435\u043c\u044f, \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0440\u0430\u0441\u0442\u0435\u0442!", "short_description": "\u0421\u0438\u043c\u0443\u043b\u044f\u0442\u043
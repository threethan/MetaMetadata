ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y41DFi5AlG4Q7kNvwE_xL7N&_nc_oc=AdoQx6vrAYQDFjeHkT1H4VfR99totqg4jiz9Ih0du_JxKNc64KyaEJ06zi2OLNKdqL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hKGwg_i_GC8FzHNS_yyDaSFCkRyd8DeQYiE074nhViA&oe=69EDF6A3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4q9vU7G9JJIQ7kNvwGK9fSQ&_nc_oc=Adp6DwDQkG7Epz-SVcelU_-YB2gi_KeZ1T6cqKK8VueKSWUc8RHUG6OQX43-_0bOgis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F55WczvQ2eXHgC4-wZV7SFh7himpYwJDJ4v8TdNni6g&oe=69EE1E64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdH22DhUdPUQ7kNvwEanIDd&_nc_oc=AdryaV29_eH7XRMz-Rw8xuHX2qi6H-GPKgM9SxySSVoKPEr2LuB5M200nacigda7mJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dk1cHPqgmCzEdyDOIGozEGzhgWwBL0yNIN26wFfxKWQ&oe=69EE26BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFPGtZ2Ksg4Q7kNvwGddlCp&_nc_oc=AdpdKZGuFujJLfmBoyPpm-upLowkzJmmIA869U1x38sHbv9UKym1LXXwxQDHMEpDTi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E5bSWZF7pvs3GfTYkWtC4laaTEsnGGepb9HcnxkdjfQ&oe=69EE1622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4y-3RkCnxwQ7kNvwFIK-Xm&_nc_oc=Adptb_ekPO48EHRvApl6zxJLQGAqgaYZiXKRpCIgNnGlrHqg7vDjMidUbE--_2VR6sM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hbZVrMHkA-f4Bofl7CphMDG9kU1aSxGbGZaZXal3C3Q&oe=69EDFA80"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
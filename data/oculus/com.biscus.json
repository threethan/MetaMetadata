084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0e7PQv_x84Q7kNvwFQPK0c&_nc_oc=Adn3_gR1KuwqQWnhQr9hPYUdIxbrsbjhNfbGT7MewPaL9QkpK9eRuGPfzd3RRnbSsuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsgAFDSwximMG07qUknaOk2_eRfNr_KJqSLtGXsGnfo4g&oe=699AE823"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SImi93zydK4Q7kNvwGprTqr&_nc_oc=AdlfGDq0rlL6iQo-yTSo58P6kbFBz3o2xabXvBkz7ayRGubBVP5jovBBW2JZgsk4gMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfumVV8UfFjYWorUMxF5zG6EpW5xdqYH5QCt-9sRi_widw&oe=699B0FE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FNMYIMxYKQQ7kNvwHkTtdo&_nc_oc=AdkJtGVYQeoyMCkAnMT8d9TefALmuzE17E9SX5nmyU-AQq-GHxwizswyUaGZOymEC_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuJmG3MYOHkqxpHMF6Gb8RKkCFDe23xpgpYd0Uqz3usxg&oe=699ADFFC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqPnsw5gCS4Q7kNvwH-Hj6g&_nc_oc=AdluSxZ6iZOgikZk8illF6Tcbq9WWxJXXqHdyHOci6JD2jP3T4FV-it1bWJo6mAXUKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuj_7hQGHT81I1nD6mJHAYRipCYnHIEflWaC2DtYIgRQQ&oe=699B07A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu11dvYXS6cQ7kNvwFEC79c&_nc_oc=Adl_frfj__uUC5nIjWmy7OBrwtbKWIgdhkkZmgLVL9MDefSVXHxV-lJyADwtt94HyB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfviONbwB_wuO8zuohkE31PrHErYS49GyO-E03IyvTE_8Q&oe=699AEC00"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEhAVVJ5-dwQ7kNvwEyruyT&_nc_oc=Adq6Z7ReAp8zbdP1SinWd0oZSgP7eCvDbChsfWj8OPN6xqO-7foY4jowzoLVDFSzRvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4kxArpM0EZkgxvOhdSXWBfUsMenpKrfE6xdfJ3cN9LQ&oe=6A7EFBA3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwV9d0aTitMQ7kNvwGvXqcI&_nc_oc=Adprh_dvsbR06Ul5ZE-DoOlkAdzin8Xshcbht7M4v6dISHKKS78LQj7L-sb1_ygTuG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVEe6TM1RUuqHt-SGT-6pkDhTPr1gwZX0NF2dSJ56PNg&oe=6A7F2364"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EVIljP_89AQ7kNvwGCk2mI&_nc_oc=AdpuKyboadegQW2hH0QDGDuZtOVzbP8mb5FTH2xwS0aMg0Hzih-wZfJQ1AwOQLH9o0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPDNqNQ0vXU9dJJrMA-3BLqDJpJKJotctxK4cobtr3nA&oe=6A7F2BBC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8wz-zwtMToQ7kNvwEuqNiY&_nc_oc=Adqux3Lix0tYKjPsa8ufDKKM4f8HKtwXv0Ls88d8jBV0qGnoSbY56DZ5cAMDQRCcevU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjzhG1dNvN0fVbHvNUVyJOk-s1jHTfSMqafvms9JWLqw&oe=6A7F1B22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEUaLMMPOhEQ7kNvwEl8H4g&_nc_oc=AdrgNvt_OS1hP2N7yrNgREfWczrAP8I1bJu2FctRPhWByA1qYd0jo3OUXHM1uihWx-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFgP3d7xui-XzYduDhBj23-tKpbpyCM231X_AXcCtAxQ&oe=6A7EFF80"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
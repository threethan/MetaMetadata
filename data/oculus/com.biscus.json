ng", "id": "1158084358857990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQNsUYCOFTcQ7kNvwHNX-6l&_nc_oc=AdogCN4UY5YKIdf05LK6Ml41WoK6-nytZjE4_-1NRMAOTCjXYUr7KfsLn7uQHY-qNjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZXnBACgmeiGGlCOzsQMp1CLxrSW0quZ_F46CrfKeR2w&oe=69FB5DE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iwlg4W7lSMQ7kNvwH163WA&_nc_oc=AdqONuSzCcX6kcYssKYis6soFthSohjLnYCcZg4au12zrIOsOHJJH-B_WXez5Gcx_-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af567RDVg2qGYaj_-6TFVLc0xaB5d2kyoGReI8RrewNmlQ&oe=69FB4D64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_89pXGhS1b4Q7kNvwG7JIM9&_nc_oc=Adpna9MhNbk2otLibjI5DdyQvT2b8txc522gCAwoTI5fVBlqpW4yrzJcptmsDweiMeA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G6xuTokiWSiFDWFLzgNyedYrLjV4rAtJskkWv8gcluA&oe=69FB55BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2ZK3xSRTowQ7kNvwFO9s5m&_nc_oc=AdpufvGnrO-CP7TlIGiMP9EGGJrb8V_3kdRmhGngx_XPRMOGsRkVFDaie-2QlywcAlo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JcarX_hZBwHMau2G0a5MZyYKPAsQJvnvoAW5_J6oX_A&oe=69FB4522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zaSLjjPrpYQ7kNvwGLIWRy&_nc_oc=AdofAO1GUQbP9XMQY4RTSzfft-VgrmPxln0elDA2xeqJFN75CXbkcNLrAIUWZbV4QRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IMDMfOOa-EspCAXDmTXkduHdLLQARbESxGv3H7eRQRg&oe=69FB2980"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLBqugHRQ7sQ7kNvwGq3Ow0&_nc_oc=AdowdRJYX1NlU9dxTKLq8F9Eb-_YFr5Vhz47SQe47kZGtQvri6dcSvqYiatOtrjxRvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RYIbbmKTUDZpPAwKJiSPmRfZBZ9Mfgy41Smn71X4D-A&oe=6A0B2FE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe4OyvtpoI0Q7kNvwG703kQ&_nc_oc=AdoHUF87TSOZHZRq1vsaCT5YQ8BZ4wz35BZJ9hfopkQzlEqBRg0JM9eCaCMOSCI3u-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Izr69fZMTwytqoQAiPPP-4e4D923g9SRvwcOHXvChdw&oe=6A0B1F64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrbyFB9-IF8Q7kNvwHDnuEe&_nc_oc=Adq3T4CO3is69T-r5Fqc84DVIaI8Kb7LVfQX8CZaVAflH0zxyY335vyTUw2SrAHSnf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AiDyrVwikiqK-URGTguOkaBusp2oS8zauuHd1yEu_Xg&oe=6A0B27BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LS1yyNWnkkQ7kNvwHZdq_c&_nc_oc=AdpuMwQ_flyzeFv9gzVwqEp_Jen0y0QcJQmyrPx4dNrWobe571lIiLmlHW-HwgcL1DQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tX6vrGcg5tuJI_S9HEorVumqbcFnz0maevOH4i9flJg&oe=6A0B1722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sELX4vrtPXUQ7kNvwEi_wBm&_nc_oc=Ado0JKztUvPHodxuqGQbEme0apND543xt1DZd3PKruxoOsEciZy0I7wKAp_c0V6eH8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BY7OzsHLLsPxBi2sZOAgmj043Dj8Wmi66pgG3I5QMfg&oe=6A0B33C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
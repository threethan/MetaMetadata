ng", "id": "1158084358857990", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR3e6gpsXnkQ7kNvwEbRrHq&_nc_oc=AdppiKk5HYv3skLgYxEAJv03-xjVNm88ecEd1UBo5W8eBNNfkSr_AWeIe0ZNdP8jR5c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J-gU9AyEY1pIo2f5AjVrbU5lhVELpbmnwWn9E1tPzvA&oe=6A413D63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciUJVD92tl4Q7kNvwHZZ4ZP&_nc_oc=AdqqfZ_ucpWLe_Yk_4cFq9DmoveCwSHKP0aMLlKUsoTj0gRbiHnLNWenMQ2WVwG9qdk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Sz6Wtf3wAluDMSPIhORWw_fXvwQcRDJsP7fC6vMXoBQ&oe=6A412CE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBvNH_w5DuUQ7kNvwGoBKUl&_nc_oc=AdrIyfHGXAq9LeBP1YjR303I8pAI4dCU0qAPEvJNU4QEIdP04Rsl9QeVz1PU9uPpYFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gU1NPfupI0hVVeio2mTmVf_4WOvvmEFAnyXzSu_TjqQ&oe=6A41353C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHOTM4PmVRgQ7kNvwFqYkr4&_nc_oc=AdqvDPbPMa90bsYXsvhIexwk_kziEwBxE3Zdo0G14eTTCd9cmNPqJkohveRh3DaGOvU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YLQQ_RuPL4AVVhHO462m2RCbe5g615WPRClFGET8UjQ&oe=6A4124A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrs96MaNdgcQ7kNvwF2jhaO&_nc_oc=Adp7EAY25XIWhW1iGrpE6lAp9PBWwZMfDaRRt56a6OZgnzXqHbICAbyBChGxSxi7acE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j7lG6NnpYVHuprs9ykFOMbblgCEW9SQp6Gfdw7XLJDw&oe=6A414140"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
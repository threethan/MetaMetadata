ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXhq8tUcX-gQ7kNvwHF56WV&_nc_oc=Ado8I_wwPouQAik_s1emwA1vpp21LpN-Wrb9KenWznMCQmfdvvleBi3kav-8M_iWmcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXGsFeKZCKQh5ZC8yIBLmb94fif8Sup3_bybwOrp3Uyg&oe=6A95D5A3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQee5ov91owQ7kNvwFIKJga&_nc_oc=AdrG4rMlSHxMufozeIGmfri7THRGcaVUYinWs6qC3IEzbyYzR5SHNveYkVoDLWwtKLQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6lFLZVRFi0DIVHqrCkF1enSkuDBksXxuK-tu7n-6_sQ&oe=6A95C524"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbrZjibLQdUQ7kNvwEDHdH9&_nc_oc=Adqg4aqcKQXHdBgRdrA_q9kM6LB63OfCtY_H2c6TXLL7sl8b0FNg-XfNn7yJXlwT-zY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbKfcVz6m8x07V1RsQMv43Ni50qs4gabFUAp7Z-OuzaQ&oe=6A95CD7C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rEyJ3APz5gQ7kNvwFma4vy&_nc_oc=AdqgE5nJ8E2v3ZKt-oJFr11u5FFZ5Q0dZ5L9KDw-3hbXbFY-Vx3dM31pZhZM2LEYuWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtG9Ht9kCwwy8KYs1qYxmih9CcKQj-Fw7-OuICmqGPmQ&oe=6A95BCE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vit3wBP-yX8Q7kNvwHaGU5p&_nc_oc=AdpDSDImj1Pu4BpDqMcApkoZ8CzjX4AvWN7bligDltaKhpa9qs1PDkNTFqOVra7PsQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqBp4iMRfYxM2gLrJC_N74kmybtVTMmjuv7cG1xJh5Jg&oe=6A95D980"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
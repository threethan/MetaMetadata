ng", "id": "1158084358857990", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMFNOjucCmoQ7kNvwHt_HFU&_nc_oc=Adqrk7wZzcvFiHxbSFHB0KrvudFsm8I_br2b7PmmOnq-F7JS7tihoFNtIyVJGPhkKSw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwbabAQ2sQ4N6fMuNGpZbzn4JoJj8vnZFBZ_LJGtb9Qw&oe=6AA02963"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsYXz5OhWeoQ7kNvwG686aF&_nc_oc=AdrEySxVBkHfKVY8DfhWbG-YpDok4yKOH7-tGAXAtAhSobvTVczYQzDy7NmAyQZ6Lqg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGBZczhSIT_dOSL2Q4Kt1eyRcTp6ecLwiyO-ppJ_w8lw&oe=6AA018E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XEmcxGESvoQ7kNvwGTcxIZ&_nc_oc=Adp1-xqsJC3IS5PCZiKuDr0UamoO6UHcb8Ju0oGsS-AzTDS0eAa4shHQ-hpIWr4W9z0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq6KDcDcP-hSqwFm3CwruDMhR_nUj1sxlvfKfkkZFw_g&oe=6AA0213C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r72zCAEBBzwQ7kNvwFvejpt&_nc_oc=AdqvyyL8CkWB8N1TFjyfyRZ3xGAUiyu-sK7rfBlRs_9nk1HyZhbdSk77wg8y63qjeMo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMuNrXjkv2O88ma1ebSZU1Wj3vBzZiQ1c5vbTgX0uEzA&oe=6AA010A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xX5-CX5nlgQ7kNvwEv44yQ&_nc_oc=AdpYefv5RlPhsZ3QGzDl9lNZp5264-En6KefZtB4XhBPi5SwSqu4YOQ9ulpF1HBJ1DU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtnBR2spg0EYeWKyJMrITPHsR8bTpsy9o1zo9H-6sLmQ&oe=6AA02D40"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
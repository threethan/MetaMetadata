ng", "id": "1158084358857990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muOQPnhqI0wQ7kNvwGWQfRR&_nc_oc=Adovn1QLfrnsDmugiZYX2driJjy-Ad1xnC_xfxU8u1es2axvon0Vk8cKVC1KaxAkmV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k-wOTkq3OKcxY8zuihPUU3MFcTsabpKXdrDTgg3ElUA&oe=6A15BBE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71-GyEI_TmQQ7kNvwF8Brlu&_nc_oc=AdotYf3W-Q05Kxs9trhMx_czOWwfAzmxy4K_j-gm2qucH6ESfxikBbkHRzVHv5rpDWQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yIGf8AFAZz1t7Bys4UeS5nVSHU1XcEM6cduFZYORZCA&oe=6A15AB64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFeP4NfdVHgQ7kNvwHR8Ai7&_nc_oc=AdrPFoQcOvOP-KlyAyf5pSYlsanZ47Y5NqSEU30y9s1wMowguaW1QL14J8UxBJ9c6ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SYaYxRQPweLrj8aQg_hckxn4NRXMh9ceU4QAMdfeG6w&oe=6A15B3BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGbMomLCOT8Q7kNvwEU1MBJ&_nc_oc=AdrCNlsnzNsf9K93mLrrtmlc2J0TMBTQOqpKnhahs2FE7uCkxRX1aYWJ53IBkHgoAd4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JXqPzspYHbqQPFT8Vzalpi1w9L-FRZdPRQW1r3kdAUQ&oe=6A15A322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7Dl5dWC6BwQ7kNvwE0XVw_&_nc_oc=Adr1SPBuh4ypjbf6U5wp9FdyCYaruiMdoH1bPpHaFormnKAiz__rgExn3-VZmXaz5Ek&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t9ZIn8iE_qh9hf5ERbY74BjsadCDGDy5s96tjWSHBtA&oe=6A15BFC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
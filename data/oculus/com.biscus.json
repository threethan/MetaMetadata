ng", "id": "1158084358857990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54n4MVV7orYQ7kNvwH_K1VN&_nc_oc=AdohFm6u3Q5XYs0eUanSkGUyjOjkD_7N5b6kj1Jo8Rnipti7josEUL_hGXTwPMMRxHQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aaWvNH1Yp95yJM6hH0ctl6CJYLBUuyKwnRaYFYx1MFQ&oe=6A26DF63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPh_Gq-UVzwQ7kNvwEJP1VF&_nc_oc=Adpdh6lIGd4fr5nHrrrsKULkA-Lu9XNcCmnpanTK-Rz-I8miS0QEb9KIjK034BTOhis&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nr8EQ0nAZ_Jpgitlx670DUnXbwXPPB4uw_ISoJbadgA&oe=6A26CEE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkVnVcuwnXkQ7kNvwEQSnw-&_nc_oc=Adol9S3eTseLm3qDOntVNMa-lyV8gspR7Cx7tfC5BRumPI8nbOTGjkt-E-fSwnTtkYw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zVIb6GxCJFo8bLBWk3i1GotNYR2ewpq-Wy9_RZHl7vQ&oe=6A26D73C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99opV2ahcucQ7kNvwHIzjNl&_nc_oc=AdrB-vYbVbY3FNFz5-tfSpAk3fcm7MkKh02hTjXdMXf11NZBCyCMXfC2U-uZ0hamIws&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fHWJnJOnMt2kZ-YhtvYRZ9ar0rT0_trubz9w2XpEbmw&oe=6A26C6A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0bLvPQpTrsQ7kNvwE0_Edq&_nc_oc=Adrs3qjc_JPRrk9bvTyE52N1G8o_J3xH0bD8SQDm5nsDOM7eUQcYr6iaDbAEqdjMTqg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wsn7S7_su9ClXscj2Xqs7os91PwmhHzwvH3N2O77QKQ&oe=6A26E340"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
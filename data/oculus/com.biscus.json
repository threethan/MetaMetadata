ng", "id": "1158084358857990", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PApy0UEdhWQQ7kNvwHvGVQU&_nc_oc=AdpnsgLfeqEuensy-6DttTSUcb3cVKdCoh7np_scEb35B_XWqXDQqx9SjjIYityXfZM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t3EOZIhyKcHU1Lv18ix2m3sqv8w77PTrd1OV4Dh5l9Q&oe=6A340E63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbGqTs0QghkQ7kNvwEucYFa&_nc_oc=AdpQ5VXLq9NLeYiuvbBmRfR27k8ZGTBlLOLkOzKXsAQCDiKFfmQkj4At5oWjxAo9qd4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94k-VsT79ONWbSzgJ_AQ-FzAKykOHObVSTstHMFUNV-w&oe=6A33FDE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gglbN63NcywQ7kNvwFalFaa&_nc_oc=AdqTwKXXORUq5xMJ7muxitehgZKo3xsw0ClwoJgwfKpWS4kp_415HvyuG_5bDvFwvNM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hBAOmn6OW7KuRvpJDl1vW4ZptKwuSTDQ-QGRZdItn5w&oe=6A34063C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTiiYA4ZZ0wQ7kNvwHOPgP1&_nc_oc=Adp8AJuqV1kXEtgoT9pJ4rYL31UtDF5EE9P_krXzi4Zknon_fBdFYxxHs7cFAY_flO0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ybvvD2-Hs-lbfhcAUxcFgRU2-3o8J-bHL7CfdskonFw&oe=6A33F5A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUO1b4K6mucQ7kNvwETfeHN&_nc_oc=Adqo50CIb6-vdrBy-l4tnU_eXQfSK2GkSvJp5jvvteuhhnsSvcSJhAVJGB20_EsrRQ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ydS1T3_Y5HEsR76BANV-RYszKS4P8-tWqJRouP4R5Dg&oe=6A341240"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
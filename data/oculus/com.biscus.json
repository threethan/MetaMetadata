ng", "id": "1158084358857990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phLTrnQyB6YQ7kNvwFG2wvZ&_nc_oc=AdrEzBFpKz2MqfCANEFSSVcPkbKFWpwp39rDJO48FaErUX5myPs8r4pZPN7Com8KY5E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxonHq7f7QrluNO9ZBvKqAO-YRPeGJmjSTPsFP0hZy2jw&oe=69C27523"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPibuglHMaYQ7kNvwFrDaeh&_nc_oc=AdoiUNjkmy6KmsRkFvXbYn2PDfguddk326xF2JLWbn9l8VvQPudwlffJzi_zWuCxrhA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2vVgPdXKSG-GX3sgbLNa-PbPoNykD9Y00Fi75QYvHDg&oe=69C29CE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uD482QBD7eoQ7kNvwFOAsXd&_nc_oc=AdqcOY8-sRQSmxbYq8cwntxUWN8fnW1XStbTsZIAaw5PnLMUx_tsJIgPd3AK5jwjG-c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyipMIu1QvTOKfS76D1C0MtbS0fAH4SJlnaxr5haHd2iQ&oe=69C26CFC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1FUhX8A3FsQ7kNvwGaJaqB&_nc_oc=AdrjBisvgayAc3gebTF4LXZtilmAgzsiIf3kl4cbkkj7bmsodiQSkSZKfvdz0U7RChk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3KpR0AM759CDJTyyKFdxMEffNxw3sHy2aVacTiWJzIw&oe=69C294A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIghHAfetccQ7kNvwEao7eQ&_nc_oc=AdqrNxzeYccR1GdtHqYTZt-LiniqqIaXYEuP5RhNlTRV_WaBzMKMZA3pOwMvd35JOZ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmiaR-9dOc2ULToyqu_TNSck2jSEVTN4G3hXJIUqrzCg&oe=69C27900"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
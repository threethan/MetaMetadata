ng", "id": "1158084358857990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nT8qkyYizwQ7kNvwENokRX&_nc_oc=Adr3DZ1auWVv615mbEI6BYpErGoJxC9DMYffKh4glg9kmcpK2IYCFf6whB9RT_SzIsQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKFuoTVBFPmMbQ2jgb6WjGmWUO51apiTMspb_b9JMMYw&oe=6A61FAA3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlX6nNzEOq4Q7kNvwGBFoCq&_nc_oc=Ado9HEiKz2Sle5eMIiGO-VEcQmxH7zJ9h8zO63fHCHRnvaI6837A370PC2CG_lNAFj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0LXyLRMNJOsbttc3l6haBUekQETU2UzJPKFcbPF_U-g&oe=6A622264"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0CDJWgUuDcQ7kNvwG4PcDl&_nc_oc=AdrikEpypj9VvvcPPfxkDF-xHh9Xlv9qHf5GqRaugQaxhDrvffg3t0iyYT14Bcc8n90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyznguK3i0WXJ1rWvLi_SHIxO13GJLCLvdjDQn_uhfmw&oe=6A622ABC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2z4f0q4gL8Q7kNvwEMmXyd&_nc_oc=AdpdGGu5VzB1QwcPadmKuv4DBoUDIcdwiWvRMBPPI_C0cPPy0qXOpSXTixsawhxbRJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOnDlZVs-5veZY1zibuCRe5TM5LrG82jDELQxVzw8ctw&oe=6A621A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHKm6DfkoL8Q7kNvwH_XXkv&_nc_oc=Ado36dRH3Wpejft18zAoZUMCRiodzEoH7iWDc628EgNCNRqE1V-liXGw25KDJmalUR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsAgCTdYqaEOqXJ475g8zXbyOHh1FyondD99Ocs1qgLg&oe=6A61FE80"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
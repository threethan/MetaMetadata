ng", "id": "1158084358857990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQNsUYCOFTcQ7kNvwEqpOrU&_nc_oc=AdpTP2rLA2yKTB5t_eL9r4aJwaR-r-9YByYPha3QpepWf6k5ttugKcq4HLu9nmcvrj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XWE3Ilour0tiUm9LUrC05x_T4ImBF2k5fL8X2WwT8zg&oe=69F8BAE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqiVJqSLFJAQ7kNvwHvcoQm&_nc_oc=Ados4Jjvw22I4DgoerTFFdmq1nYiAQxC12hZHg6VUHNK1PaKc5om9WcdhateL3QHPbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Z7EXEyD_ZeUecRTLbJCQQiLAF3gvs_SbabJ6T7LDIiQ&oe=69F8AA64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_89pXGhS1b4Q7kNvwGGngki&_nc_oc=AdpaKZeTCXgWmN2I7tdDAYK2TsLsUvk-RNrtcyirvzcg9lFkVgloLKk00eudbahJyM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ar22a-f60TFF_W8C9SRKu2CMT1bpHH4OpG5Jpmq5LqQ&oe=69F8B2BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7B9BP4wcm4Q7kNvwHOF9xV&_nc_oc=Adq8hlCIoYeMCD6sSPpdPD1TeuvmD3hiuyRmpoE8OBB91abLNRv9Q2WTIp2YDkir7Tw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03EGHoO8Qo2otSM0bOU07rSwBNoRf7UVac8lQ_zKXtYA&oe=69F8A222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zaSLjjPrpYQ7kNvwGSC1z-&_nc_oc=AdrMM2RkDArcmEyeD5BRIvexPnpcMc0GUhYEWsfJUmU2PCdlk3PTF6JSB4V3d5hmF7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2E8sY7jx-M0bur0dwOV-OLCcXi9j9m04qBntlg3IhTiA&oe=69F8BEC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGnGybVHHHYQ7kNvwGCeaKr&_nc_oc=AdofPk2yggBS9UuIFSuiq23tygCEFbKdVWasSb3_nbd_V-5uNwzDbklX5Xzk9wrzlX4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lp4xqnPJEBfHO3y0mTZl6P_1eEU5s7RqWQjec0ZQmhQ&oe=6A3019E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBiSqmOaAiEQ7kNvwG8HiX1&_nc_oc=Adq4xcx5a_KVQzLQXAj_a4RcPI_f9KMmDkIua0huuUi35ubDHxdI6-iE0LYhdacSySU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-izm64R7WzcLP5C0y9spYoM0asLSOhL5GrxEROjOEbWA&oe=6A300964"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIFVJfKc7NoQ7kNvwFr7KM1&_nc_oc=AdpiPrzeu3Lzt0ADrUBsndMNKAaaN78M71-5Rn2vy9s5T2ulFyJbuhrXjZEsB0VKh7s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ufLPqVUYmNwHmw9oJMUUwfpexmFIkvU7-X7fazTwOow&oe=6A3011BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YvxqKQIAYYQ7kNvwHbQKeC&_nc_oc=AdoV6No3jFDGRAs-ahoE_Q9TrqErKSpJHACDIv1JFUUK0vHx8BnF9fVvIuG8u2C_y0k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q7_tSoVn9UHoqQqhoSkMOh5bvM0y2mDjdWS7eJWEGrw&oe=6A300122"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjuQqn-VhXcQ7kNvwG13eRz&_nc_oc=AdpWwej8Jb9j-uFKej1mKUB_iCIh4CRqGChB8KS0-p0gVT3-0exUMhQWl0vAsT1FDQM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RDlWRFFUNlTAc9Ianr9Yr2x5u-N_2xZWcfeDxZ0qP2w&oe=6A301DC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
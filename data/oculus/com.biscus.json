ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcNNP_FwEtYQ7kNvwHgDCuJ&_nc_oc=AdqogQIqI5BsAWDOxsb_-ntEphX-NihQvI5OrfkE4r65WeSxOAXCcU5FY5WxOMsXjs8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOigZnSk-hGsFhmZdzuqpcLUu_UNxC-BoX8QFlpRX_Oqg&oe=6AC3C1E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDFoWexYnMkQ7kNvwFNWYuE&_nc_oc=AdqNcjyx7tc36ocWMHIR8af8uyk4RpUWwGWoEneB8B9X8Fq-F5h9LmL8zPLrMcLmxBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVo_AFIUv67yKyOzi7f9hADTTrqDCyrSQYEzn8HQ8wxQ&oe=6AC3B164"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28tRIlXXYjoQ7kNvwFoOEX-&_nc_oc=AdrTK0TJdxX5LRMs8VkH6zBLP8P2xKyf85flAXmeBOHWzHm8nyZqdxZ5u7nlrAKiYBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqH8GEra55B197ni5tekx6ilMhjx0h-TSK2eRjp1Cz0Q&oe=6AC3B9BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY_P84yAkJIQ7kNvwEgiYHO&_nc_oc=AdpTx0vxvPxsUGKDg7_hSvtiDsjUzDwPsP2BfF4j7Or5ki2ObPyxpjxa6yj3FCAy5Ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV6Q7q9IvtTS_ViXeWdmzhOlTGVV1PmaEvjgT4PwRzbw&oe=6AC3A922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUVEU9OLidoQ7kNvwHebeEG&_nc_oc=AdqIceTCsyGwvVCHi3ZE2Ly4TVS7WbNw3Q4lWRL9kgfYuy9HkzEyN3tu5AkUXX3-kzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5Nlw2kur8t2Axk-cd4hxnekJ5wjkIzAC8pkEg3Cvx3Q&oe=6AC3C5C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
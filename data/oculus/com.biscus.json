ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkYuDEJmXVcQ7kNvwE-dDAe&_nc_oc=Adrwbbowl98QdTqLcB01ILBQ8DVrAfBEYV-VoE26_0WVA6i5s2j8YXdiHID6ahRv_Vo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwspcDYR99xTwT9Oqls1rpylC7wlDfpcDwG4yxwfdQkAQ&oe=69CA5E23"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz8cc0T2DEAQ7kNvwEe8hDu&_nc_oc=AdojqdVtNgBSfpfeprdbehhrL2G4VjPjKxiSCbTXvWqrTB_Zp14JplLppZoMofxv3HE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEO1nBKk9QZ76IOZ5HTlZUncsm6gtesMreQK2dzGRt1g&oe=69CA85E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQsmfjq-5L0Q7kNvwFLogMO&_nc_oc=AdqnBAsqUmYXAiQYzGB9uL3ZqAp665ODy7IIs_ZVkLRkjBd5DH8we7SlGc052VagYKg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1RAdU1Xq79n9jZc8Eym7hruFR5WGIhI3fQeS3bL-cXw&oe=69CA8E3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnSPylhx8ekQ7kNvwFWnDaU&_nc_oc=AdoUxYT7ebQ8B9FcH7avR3TKor0BL3VacddX2srtr05zt51n4r8KbEGJehV8jk5bLX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfxKHo8ve--OemvovS7R_bZeBFmh2MhvcHU0MJD63J8w&oe=69CA7DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmAUabABMPIQ7kNvwF1rPfY&_nc_oc=Adp_NZWwZGRO93L3LlNftTHfHaEgu3YkPHgk-7C_MZdifXfB0Tz4niroaiLkiSrC9GY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxXN5DEIGN0GExKGmNUSstL849ktfm7ugjELlGd8stHg&oe=69CA6200"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
v-nw_2CWKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftAy29Ez-I6U9e0RD93CrR9e_DewQzsTfhuyU0TMB4WSA&oe=699F0464"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRqKTGmxIvwQ7kNvwGEw-PS&_nc_oc=Adm8q-PyDxkrcpkPZma7oH85Fv0BZgsgNY2z84cHLHTRRhT2b640vUAU8IpDR4fzECY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftK0O0e7FHpiOCuAlioeXYAvBOjmVm2x6DLU38AWXzpvQ&oe=699ED47C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbwsystBr0kQ7kNvwGPh-A2&_nc_oc=AdnnqEmfvnqpk9qx0iVbwpo3ypNMvW3Z3wwa79Oytc1f1NwPxcnAUe_r1rpENCaTLRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuzHbN0jb5oXjRkGuY3wZWnJpAxJ_OLlsdYa59P-kDG6Q&oe=699EFC22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzdP-R-a6U0Q7kNvwHtnei_&_nc_oc=AdnB0HwJ_6C1hHd_3FMn1jwhpLFeeNCer0P3gi-dMImEHgnaSC6TsnTmRXuC6rCdbGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu3nuLcwkK9siO-QhgbCSrmgkB7evCxjog8UnF-RKeMqA&oe=699EE080"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "7062818353766766"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7851883268193600", "version": "2.8"}, "id": "418037437551531", "c
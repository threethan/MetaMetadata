ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG7Dg1yiM_UQ7kNvwHGpjd-&_nc_oc=Adr_7RkYGruZXeplu22YzXwcNZe2yu1kgZ55V4PrxzGtDTwntACE-lu2H7V6g6lq2wQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRtmbPWDm45uUfd1yTl8F7lcyPpAdrV4XDvXnOfx7UbA&oe=6AA2CC63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFWxthfLpMAQ7kNvwElmeHL&_nc_oc=Adr42gcfN69yKuQ2Zc_oJTZiBzmamDdXXx8eAX0j7qk8haD9sBS-TV5dRp6brNyXGkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISNnCz63If-xVBr95u-jWv9WeotB836gU9dZa3tP6ucA&oe=6AA2BBE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImQTFROL4R4Q7kNvwEx8aW3&_nc_oc=AdpJ4eeD7869GuY1EnQ-9xCpx2xEwDLQ-Dalg8bV8bm65JxcZl0wHt0-nP7FHz9KdnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_akRxKnGhUpzIKuEm8FGFBNdRtzuNV1JN-s_QV_9kXw&oe=6AA2C43C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h669Ypl2yIIQ7kNvwFPGJQc&_nc_oc=Adr1e4xi74Iv3rXU1xKFY8Um_BaH44Ls0ONM3583gEMqys8s4NwsUXugdR2XXBgGPXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFwMlsN0RGsAIEl9_qYFr1uoOqCR8-USkzdC-TrQvU6Q&oe=6AA2B3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Dy7Wcu6na8Q7kNvwFiFyzx&_nc_oc=AdoI_2SWD828nfMIcph6j1gn-aQgG8maKz0FEfVkKeyjjo7XSVC6nqMxPRpLYzPjeWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSoLxyxR3eAR2gtb-v65xbuoMaIA3b7EVuEeXz73DFhQ&oe=6AA2D040"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
=6AEB4EE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ROzWB-U_FUQ7kNvwF1JGXf&_nc_oc=AdpY21YzWaGIW53edoU7BY965eRsHwB2JJi6CfU6zKMZr5vkL-gEOofqdNdUeWBPBmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcnzhnrR3wdWHmYYpXNzfujE6NBF3j5ahD_uJ6yQr9lg&oe=6AEB3E64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lntDngpo2mgQ7kNvwFlXSsG&_nc_oc=Adoe5MtPoBAlFM-sa4tu-7t_r2FOnSzEKXLwqSTcnxkQi5byEVbOSy07vd27lNhd058&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIpi0vhgMS-7H8jlHE0Vo68h9vISCwkQQMbMgJCKM8Pw&oe=6AEB46BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Au5ThnAnQnMQ7kNvwE343GP&_nc_oc=AdoKs-mEgi6INonurT-gAX4x4Nn8G4Wml4VEz8njx7i6uiEllgxYK94FRO0-j0AfGBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1M_8SQIZExkP5oyZ2D8aANGNewV353BizJ42xET5fOg&oe=6AEB3622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCVI2PUzxYwQ7kNvwG1K43b&_nc_oc=Adr_5AG64pdxdPzG-u-GWWxo8gbi6ufJ7_tuGK95v3Yx5xk9DX2EbZGYpWOOc47AAmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1dE966-c6wnQg-WQsY64qXKqF1UF8cEAShPg4sw2dsA&oe=6AEB52C0"}, "display_name": "Biscus VR", "keywords": ["monke", "tag", "horror", "monkey", "ape"], "long_description": "Swing, climb, flip, and run for your life.\n\nBiscus VR is a fast multiplayer game where you move with your hands: push off the ground, climb any wall, backflip off ledges and ride ziplines and swing ropes across the map. Every lobby votes on the next round, so no two sessions play the same.\n\n10 GAME MODES\n- Horror: one player becomes a huge Monster that can grab, throw and eat survivors. Find the power cells, power the generator and escape the hospital.\n- Murder Mystery: one murderer, one sheriff, and a dark library full of suspects. The murderer's knife is real now: stab to slow people down, or take them out with one clean swing.\n- Infection, Bomb Tag and Freeze Tag: classic chase modes with their own twists.\n- Hide & Seek, Capture the Flag and King of the Hill.\n- Spleef: shoot the floor out from under everyone above the lava.\n- Color Switch: stand on the right color before the floor drops.\n\nPLAY YOUR WAY\n- Ranked lobbies with tiers from Bronze to Unreal, and a live leaderboard at biscusvr.com.\n- Cosmetics, abilities, pets and your own fur color.\n- Daily quests, a prize wheel, and gifts for your friends.\n- A carnival with a working Ferris wheel, and Biscus Grub: a vending machine of knockoff snacks you can open, drink and eat.\n- Mixed-reality and third-person capture, powered by LIV.\n\nHALLOWEEN UPDATE\nEvery map is decorated for spooky season.\n\nMade by a solo dev. Join the community on Discord: discord.gg/4WKR9TFbq9", "short_description": "Swing, climb and flip with your hands in fast monke-movement multiplayer. Every lobby votes between 10 game modes: become a giant Monster in Horror, hunt the lobby down in Murder Mystery, or play Infection, Bomb Tag, Freeze Tag, Hide & Seek, Capture the Flag, King of the Hill, Spleef and Color Switch. Ranked lobbies, cosmetics, pets, daily quests and a carnival hub. Free to play, made by a solo dev."}]}, "developer_name": "Biscus Studios", "developer_privacy_policy_url": "https://biscusvr.com/privacy", "developer_terms_of_service_url":
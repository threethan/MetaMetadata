ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xc59jhDLu-4Q7kNvwF93h4Z&_nc_oc=AdoiCZAn9vQnY9KBBPJsXJpg8iZdBiPgCss2Dtfj8PLVpyglbpJ3KvinqtD-bOZw2rc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-zG0NrNARsdA7kKyRnwgaJ2SrkpEoC3JG9eEfmdLUvA&oe=69D8DEA3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af7u8nQ24ZEQ7kNvwEr7rRb&_nc_oc=Adq1Q4X5mrH4sJix4J3wn27TP7FaCRjaJkKYzc_CHt6wVmEszK3VBAZb4cKrm27ALlE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30oyRkCjp1IiwdlHeH2mheCOxOSoK5kcFpBPLZLTuiYA&oe=69D90664"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhxU5hGBy00Q7kNvwEdDe9z&_nc_oc=AdopKbEvup4xPr0M1RLV7HACz8cJL3qL2LGQz64MmsJqi4HMzOp-lWi0LnthzguI-3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r3kY1hMESZe0iSSnfrwvjK-IuCv4bLGz5F_D6Cja_ww&oe=69D90EBC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULjieR4P2AQQ7kNvwEq8xGM&_nc_oc=Adq7txlP1VuH8ZbZysOmOQm8PhGkTXKQsxBo-tXIFJhG_HCGwMNIUxGE3U8BrwMmZlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HkHsq6jf5gDty6PbLCUZq2pA7bCm0xcX6gUxAQJU2pA&oe=69D8FE22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV0rDUPT-TgQ7kNvwG0wYJk&_nc_oc=AdqF-pDNzXRKspovTozQ2RzcOXtLBRWt7WKfB52hROzLOpMT-or1TryAWH6PaZ2nVh4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zNoBqX5r8ACoqTvuxSSsJT_WQY-jQt_oPWEl_wP4Jig&oe=69D8E280"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
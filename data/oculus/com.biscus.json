ng", "id": "1158084358857990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGnGybVHHHYQ7kNvwE_aJnr&_nc_oc=Adqbv-yiM0v3Qb8ptBsqSx1MhNKJAyLDquENYfcdRA_urZu8Gg2hAuB1IkQWGK4_RNQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8naSPco0jbTY7cx6XfgFid3DByVzRA7YeM1qxtnARwBA&oe=6A32BCE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbGqTs0QghkQ7kNvwEM6wxi&_nc_oc=AdrGRO6-iL2ObbXp4xXA_u67y_7b5Hwv29J3rQGX4tpNL3W9sG08W5d0xgfFWscjr_E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fx--7WrIbZVImScX0BtpXDUmLCCf4b8oQIkmVPUohBw&oe=6A32AC64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIFVJfKc7NoQ7kNvwGT3YUA&_nc_oc=AdrKK--doyxJdPtHSBoZBCZb3dcC2egOI2aBbOvsKKrcrp5n0cl-MWZI03H3c8jAcyw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LU9zTnYo4dKa3Y3KC1KExPIhivccPZZWS_HSvVWWDhg&oe=6A32B4BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTiiYA4ZZ0wQ7kNvwFNxWb0&_nc_oc=Adq3SLR_DStPVFfgxAds9E98ERH59fCcJ8Kuf2_za43SZefMqR-20EHCV_ggYAWD6_g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iGllgIws59yybkliB14sF0sFSPTK_zBDj3UYFvic-XA&oe=6A32A422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjuQqn-VhXcQ7kNvwGBls04&_nc_oc=AdqGMsCpi9_nI_KyJ6s-EWiYZHltgAJU1bAW4-4WDAq4_2Zmwbq9TwY0o0P_yuOiNf0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i6MULBVPCMJUtyS9M9YnifUS_HKlraw6T1OKRf3vd-Q&oe=6A32C0C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBgMUPqT2DYQ7kNvwGhpJxB&_nc_oc=AdouybJp9O4E80NjvTOFlGtuDJtXVNhtMwMfAo9iemljxi6YXeKpKrHxXHevTireu68&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uO5Jzj2S1i3q8zoZmjFs4DdENc4ORtVIiMONO94VWkA&oe=6A1C5363"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTn64oUIiOUQ7kNvwEbgkQp&_nc_oc=AdqIUlB5aOVYpc5NIhNs2Sa3RC-AmEd-ZtE01BCeIll4Shx_WWMrdsL7Pu47CJXwFY0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Lyh3e3mb6mazBvpuwDkOsZ3H0bkp0xnjAzT-q4n0Fzg&oe=6A1C42E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPa3uEwd_wUQ7kNvwHH99xh&_nc_oc=AdrcO0OkgyQSD6AjBouFce0mrXy-AhtR4lciR9y3sBbfNF6LWi4F5_wvyE3-PDoOMvQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dSlLXA-AURSfKQO43z_dc8B_xvd0zloK-5xqeERlS9w&oe=6A1C4B3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJiEXEu3CAIQ7kNvwF4rHcB&_nc_oc=AdqsSABX2ZF5PEKFJEtL2hvlaIMAlQP3GOOFZsAXokfnxC55UYBt3hGWZTf3_g-MSJs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SPGyFy4SyGxBXd63TWZvkIv4mGb5lDMkkj2exFTg9QQ&oe=6A1C3AA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewwC-017h24Q7kNvwHmBDGS&_nc_oc=AdqE3B6SJuNVkV1fMFhg1KoVhWjxXpDaYyd6pVBc6n7aAgU5q_KIwN7HFKFMHViYN3Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D4-GJgO3F0OCi4eNyFfAoVPf-FK8F5JDXfFr-fBm-OA&oe=6A1C5740"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
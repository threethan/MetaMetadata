ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5_EhU43FTkQ7kNvwGiVML2&_nc_oc=AdqqEz9WZ6H_e_G8Nqtx7i6utqunHQNcdQHYzB24TSp3sk2z1Th4CYKkGMZ2W2R-1CY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiZ6e4dJIlxyz7ve_ifR3WcDVOYKduKwlriQN1I27ZMw&oe=6AD24263"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae6Cj8IHFysQ7kNvwFOKwEK&_nc_oc=AdrybPi90ljH01XfpbZblVbKe6Tc-AC6gFmx2RgPfrTJEnp9R6xyTyRaZqoMU-i9BzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2PqdXzeKvC4GOlvsGxho_WjfAWkwBHyApqMD7FJKa5Q&oe=6AD231E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyejjclJp2wQ7kNvwFxLNCD&_nc_oc=AdrbuSsA6EvPDuvjtVYRjPHq5ES0qAp--qv6FVs4olOdgfDZ26W-eNtWtIUuzUu_juY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdrH1_x6PCgCQcvImSHQiwK4mEruafM2Q9i-LiJgLPyg&oe=6AD23A3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azwg-EIZhHoQ7kNvwE2F65m&_nc_oc=Adq_bu8cl3n7iBl2S1DlXo8ZjAU-yr_K_35jb50qgHhrQeIgs8lRv8dYOML6bcnJUmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHb-qsR7ARnDPUgn5SP0QPzJ5_xjd8TQWWmT51e_tu3g&oe=6AD229A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_MeJNaf9GkQ7kNvwF0WhYi&_nc_oc=AdpzHxOWHkFNbs3GjXBu4AxG-B8jLSSEy6Gz_Q-4fW8hmBMpUXOlS3n2-_05xgDarfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWO8ezGzEZHrlD8kTMGOMpZS5ezN3H0cPh8Cgpj9SwNA&oe=6AD24640"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
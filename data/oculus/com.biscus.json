ng", "id": "1158084358857990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qmq19gikiGAQ7kNvwGH-V_H&_nc_oc=AdrdfzM-F0zs0AnfKGpAR0VT0RSGu75DYvfgaBLJZetjzRcnJxaCJYUksBONPa6Lww0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbfOE1naBFOKOBm1HLA5DbSXwAtpidAmn5ztLPorFVzw&oe=6ABE7BE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iVseIG1V8AQ7kNvwHGrvvs&_nc_oc=AdoBtUrXiV0aW2B0F_hBZOCraBw6et6fIcn3zito4qs4tS3wa4_YwJaQ1GVZo168Ays&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBju8J6vGS0aUjVD3UzXj8_F-kpSw5h-iuGsQScB1_xw&oe=6ABE6B64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEVpNaxzW7EQ7kNvwFyx6ty&_nc_oc=Adr_w-htfXpX6YT106Rp3YvbFmSgu2zQYoPe-ZEUjy7fqWq9mRmZ9jdZc8swYW9ryTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCqhMHdKuIs6HijYEaFVB9HqlTkNk9HpZ2Kaa5vg98-A&oe=6ABE73BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZTB1lTB1csQ7kNvwE2WNH8&_nc_oc=AdpPyPSQRGnbxho_7JS72B-sj2BJ5Tddh32k3mAPvHmCLLUw_gBx2V9orx2dKNFmqtI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINx-c_yLWHQfLO4Vf_huJfh3MIyuLetMPcxYbtd7VN-w&oe=6ABE6322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhNCZg5STZUQ7kNvwGi4-Ju&_nc_oc=AdrFWRkUaYjA412vTdX9_r5ud_Btp__Er17BNBTi-QOj1MFZxCzDSQdhkTj5e5wfMS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL00EOhagu5xHh7RWnCYEiF-48E7CL2fT_sTaXjrswBDg&oe=6ABE7FC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTAm0cJgS78Q7kNvwHwIhMS&_nc_oc=AdrWon3Br-DtUepRJRKkRWYfWCqUPn94HhdASKX5mqnj1Efs8fNZwxVnmHhC3Al8tjY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JfAcGHmtwnZq49APrHHgPj9lv2HIXQ4sw0YFh8_JyeQ&oe=6A298263"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPh_Gq-UVzwQ7kNvwHcCVAh&_nc_oc=Adr2yhYw7V5Ns7mf9IpiP6C1ppsNKksloeNhzVsrmlpY8er2T2C7ZJnadWr7HkQu_JI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mQc-1kQBM7fLUWB3ZsyUpc4jDXMxARKAaAEpF6yVudw&oe=6A2971E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j0qU3GEDo8Q7kNvwGx7c4l&_nc_oc=AdqR5taStSXNhc0sJQ08FqG5D32PSx-ISEWtNYiml1iDzLr4CnDbHgHAVQGlbuTew0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AYAEqwpIgyVyAxyHEoIEx_zFqsV6KGtIGUnmg1cL9Eg&oe=6A297A3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99opV2ahcucQ7kNvwGDFh8w&_nc_oc=AdrAbTRdXqSOfJc9MBuada4GqtmDQyLoso7iuF2P_Go0RHs-5WvPIls337vJgXO6oyE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HIcEyoGnUGO0r1y6DLaPkjVhq5kptMot2OTEuxnCffg&oe=6A2969A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Pqxy9BJaacQ7kNvwHwXGFb&_nc_oc=AdpKqJbIJ3AE5vdbOggLw8yD7oHbbSPR4gQlo3ukm5xWUb_ZE8fwRLsj1hft72vJNmw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rTiF_6Y54TcmBgWZh5BTZvkcu93XpUl63Wd7_2BgLww&oe=6A298640"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
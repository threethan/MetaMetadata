ng", "id": "1158084358857990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5_EhU43FTkQ7kNvwGfY_E0&_nc_oc=AdqmRoaiLjdW-31gYudWteSRWEma8A7fyyUnTDB8S-ZrEC6gZcwX7NDW-ltbzuDg3O4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrTIn5oyc-0KwCqJjb42ASPpwhCrCNjqFWmi1_YqKbMg&oe=6AD393E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae6Cj8IHFysQ7kNvwFDy_uH&_nc_oc=Adoboyphmpi8zXljFXEz85-QzVL0Y22lAHxRYs2tjsLUIogkFDP95Z8Gz1N_Flp0Z9Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNInBkau7rwsFWoHjIS1AcbH8gWosrGZjRTakGKNXOjnQ&oe=6AD3BBA4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyejjclJp2wQ7kNvwHQ9fu7&_nc_oc=AdrbX9PMOYnSfRybFp0O9Tn1TVDKZyVZ_nAwEol5yuFKnjKd9BmUVAw9r_4ZHPrd3fU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCccQnRXYSy8shaqJsVd6m0jNi91kDpkSd8cMMmAxGbQ&oe=6AD38BBC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azwg-EIZhHoQ7kNvwEs8f0B&_nc_oc=AdoYC0yTbccgdE7KPT1pTX9yO_4GNE08JNYdTFDJEXAHuSlNRybIm9rrwRi38bdLEXI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoQdUlm0kkbNq7_Fym9umLTHCT1HUc4GAuvSjpv2FXgA&oe=6AD3B362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_MeJNaf9GkQ7kNvwHv1Qzi&_nc_oc=AdrVhnRybgv1am0pmJr7HBv2dak1bDFjgnGHrdg96LVj58EBLOT_5hcXVapZQBIFexE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_27RMxDKnqGDYhkCm_uoYEzoMJZuoxx_rhzd-n-Lk7A&oe=6AD397C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90UVZsbqMXoQ7kNvwEb0Gxh&_nc_oc=Adq0geZD85hXIkzzUiOHhLQbtpJJxC4IE1j6qrIw3I81v6GFlYrFOexlmmuEzOLFX20&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz4YUbEA20efFPt56v1C8eO39Loyuxw-_aSO_7bB9_WA&oe=6A565563"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oNoCL-UL2QQ7kNvwFcDL-N&_nc_oc=AdphHIEV7vDygj9OYp-ajJ0oF0m35fbxe8Abum0ZHrpUZ_NferucbjJnGEgfJbO-7M4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3xdJNlP1RNEs4cMARzBP6_Ki44OmxPiATNf95lDA04g&oe=6A5644E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y0QqaiSJvcQ7kNvwHU2KD6&_nc_oc=Ado5YqDfYA2xlogANEpmdkiBh0FucfTgcbdyNTsRxYKoaSbI_k8pEfJ9xFP9wjNtNwM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyvDPSlyovOm2jFF2fWdt-nLgMJdKCDZhjyqrIp2AUNg&oe=6A564D3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpylxvriXD4Q7kNvwGF-ASq&_nc_oc=AdoNGXd0r3wirOCTJj_tdxp-fhNk_AWopK9z51bkFGHVKJKs_oFs1AJuYY4JoQr-fFA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdNXv7BZNOgb1bBMYB_xxmgShvQwMkagByQVbovRYxNw&oe=6A563CA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cug5tFMM_NcQ7kNvwEAESkw&_nc_oc=AdpPoT0Hi1Q57muK7_R-Z2zZMI0sQXiZrNN6NIx-7rdYw46J0JD6WYSvNzCScijwX2g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7b1EZ3ziCcK74eKYaMSML9iiWdNX6ztnBjkQMR9MJJQ&oe=6A565940"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
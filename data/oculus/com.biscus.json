ng", "id": "1158084358857990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54n4MVV7orYQ7kNvwH9MaFo&_nc_oc=AdoSyWHP1TeKDxuUahEzkapwM9-vVZa8S2Edx90n1qQtGAE1A3p3PfUf_kQKkCxLow8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gitMjOTjCU6cG75xIpOienz3nCvpLpmEPg7IWOyC3jw&oe=6A243C63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uETsTHV0pI8Q7kNvwEj88HM&_nc_oc=AdoHBHfKYJiBRNUUFzStuWoK2Y7nNeVQJ6Pa5WDxnxIiXuzn22gLu546Jo_ejhFiins&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LsLLuyYTBX8JCEW5OZstCe8xsuVmHCGd3c7gp-vfeYA&oe=6A242BE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkVnVcuwnXkQ7kNvwEVN_vQ&_nc_oc=AdqsAUbkGZ6Fltk8ArnzJk6sv2VoBqdB7JS_pzAGcaiqON_W7kBPsTEloOabO5Ld2Jk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4-uIRipY2om203Vvoqcwh7yvS8OD-h1SoCavwC2vpSQ&oe=6A24343C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgT83xRFbTQQ7kNvwGDPHFF&_nc_oc=Adq2FFixuKJcFVZq_zsey65r0CuasVJx-nW7cIGGBAiNpzKIZf7Pc9skARxjorVN3o8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95GwA9IO1ds5GMikxflUjmih5eHvHxhaOqsN9HHgPTbg&oe=6A2423A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0bLvPQpTrsQ7kNvwGU-BNf&_nc_oc=AdpYqLqscnNlQGJMPr8jNusUUn5VukmxxqxxtWgQOtKeH73HKS4-3SPOh7w1Nk0-pBo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82K6Rr0DiRPwayQrzGMbp0rJwCqe7wz1EvEy0GFvov9w&oe=6A244040"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
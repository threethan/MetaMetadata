ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR3e6gpsXnkQ7kNvwHHk42L&_nc_oc=AdrAyTVug3RZy4McV6-DNYwv-B27qKzjn-q6xebsFlOw178R94OoDvD9f4BJvnGwyEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MmtVdrABDhoG95lxXSR8FyRB6jN5KMIo6k0xKV0cl1w&oe=6A3FEBE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciUJVD92tl4Q7kNvwHS2abi&_nc_oc=AdrOuLXFKyGNTxZPsQPhALdhi_rNb9nNAJ5jOZ-PShhAKZEVCkSpDKIpKzSqznZ_iwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HR3vV6wx_ZBf7jo6Iu1dLHMkrOsB17ZWokhKw5f6u2A&oe=6A3FDB64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBvNH_w5DuUQ7kNvwE2Iimp&_nc_oc=Ado55glT9m1li2MVyx4LiXphhoxD75-LPsjeq8s0QLYcOe8uX4qDX7rSdTHz1Msxz1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r2d-T_RCNdNXTI4usyjJCDR3UcaIkPpVAIN8oZo8jlw&oe=6A3FE3BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHOTM4PmVRgQ7kNvwFCvG3b&_nc_oc=Adp39ykqjFJlc1e67W1mmVFQt-3l1qMisfEPTszPkXk9gV8eIVjOiwGZhjPxMRzMzoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3l1m4RPlnCdUWh-XbC2xqLIcZ2u9PWkZsDitfk1U3Fw&oe=6A3FD322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrs96MaNdgcQ7kNvwFguGX6&_nc_oc=Adp58FFdWEblb4-j34C0l3Flz_P31XjktmQS5A3c2jQzPBmzfoW2mSGHOoacXMN9m2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yBeQN4AqhaWpS_lqWo2nRHxHH-z-w8ZdxoPdLeJv3Sg&oe=6A3FEFC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
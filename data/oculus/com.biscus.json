ng", "id": "1158084358857990", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6jdQeOi2NcQ7kNvwFwd81-&_nc_oc=AdrKUweia6WS-YHK2j0JHhFjoAoQSBjCDVa4_aytGYtOxVhiDzsl5yRBQm4QRt6VygQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeQfrh7JXhgJxSaFxA06KiaphtuCT8QCc7jCBEQxMMAA&oe=6AAD5863"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K28Lg3Y5yF8Q7kNvwH5aayL&_nc_oc=AdrnTbPT-CGL3xhQNQ9LNmkPdvsniZx6Ma58tatQyjjlsEwifNk6xf1Fy-481tFnfoU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgOVwytW65LhiNDVqoHxZ5Q8SONOksi1kFQt1M_zgQpA&oe=6AAD47E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLgVBcJL8HoQ7kNvwGyZtjN&_nc_oc=Adq4LxId_fCu21DzReCZcZEnS7ennD2xVAPyZghTvsh-0CxVaOf8E4UyXMbZes74j9k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL35Oi3EX7tETcoYmQ6SxQgMoJONmsjz9xxFSOcNY8-3Q&oe=6AAD503C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUY98tBPsLcQ7kNvwE0xtlz&_nc_oc=AdqudHvKR98X7fvgzz6cZVm2cjbeplV0t-9kOnWkSuet_5l4abNTd53lf0urfK-8dAg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxHlaWcXsf3kkdmrNg_ARnCGlANMKADPo6lV1zebxh6Q&oe=6AAD3FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mSqpFWIZyQQ7kNvwFqkj7Y&_nc_oc=AdpwxuknSjiNEdHpRfW9Iif2Id0rWF1tTZUZ1lF3cFYMJW1JAr0YETSEDSo16lSsA9E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7UETqJ7zB9Q4yxx6C8wO03aSRU_bSNkxMtBZUXrPMNw&oe=6AAD5C40"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
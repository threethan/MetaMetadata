ng", "id": "1158084358857990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEhAVVJ5-dwQ7kNvwHQHN_i&_nc_oc=AdpoECuLJVrZnDOHHpar2I3u5MV_xE-_nWnMRXNC_uuqMaoPAptW3ppzYRXNyAD4EMI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdJzQmNWr3Cr5b0OoqJ1dufBGlnCkM2rOcPhs8MOdxyw&oe=6A819EA3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8tUZH6MInYQ7kNvwF6TIbA&_nc_oc=AdrJKpSx0Cxl_t8vtqnT41QQEVaPhYO5WebNjfgMUS4jkp2_jrbNh9WGbJsvTJO778E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcPh1bwgLLjGKv02FxbSCoYQUIlZTc92eND-BjZQP68Q&oe=6A81C664"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EVIljP_89AQ7kNvwGUMA2E&_nc_oc=AdrKyTbwJgHUJsf_3-OvUYow7_fkues5G8OKFQs-RUY_6rMUGXG7tZXVm-AonuVhJV4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2Kq2QLWAe-gykttYzX0mdeKqXIU0KyttMBRam2mdIyw&oe=6A81967C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8wz-zwtMToQ7kNvwF1bDM-&_nc_oc=AdoeEyBN79Eq_S6Ho5RKuISyuYp98iwIb9bK6gnmIh4ccBEgOqMuJtEvVx-FNMcZDuc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWUsbxMyhv6y4WaXiJ60OGAV4wd2Dz14lz2nSzb6Nang&oe=6A81BE22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEUaLMMPOhEQ7kNvwHkZ2Rk&_nc_oc=Adp_lXCAZ6_BEzjY3GK49kpSBvbbCBqT-a7GfvpwIEmSN4uUB6EeFtHpJu5w24VUI8M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGivaZSCqzfR5Ywbh2hT5iiZlBVclJ8FkOLoHnPIxineA&oe=6A81A280"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
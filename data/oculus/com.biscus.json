ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMFNOjucCmoQ7kNvwFXuN8N&_nc_oc=Adq0Vby3pVOJiTJC0k4dgiEDaITWIuSTLXL3rK7wGa22HB_Xo3nC8vRQyLdXsutIVA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmbOrv1G2944vuzyWBrHh5X7EQxdUDId-dhN_HZ_qbYg&oe=6A9ED7E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsYXz5OhWeoQ7kNvwEQX0JT&_nc_oc=Adq95voOuYPK4nSdE-c4VQuqnhvrrpSnkz9tQpwzofrJvvC1P6xa6TNGYCFTNyaGhbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqZFAEwZqedW9a1pfRjKfutJbP6g0hWZ04XSr06toBaw&oe=6A9EC764"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XEmcxGESvoQ7kNvwEPcYzw&_nc_oc=AdrTKkEl0C2ePUMF931e0FqxuVWiaOnHp3-hJsbrfx1koll56LK9F1yfczgcqQaUtYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7013STa2DyvlvVd4qBjcNleBujZKdQi_oyeYs5uqfUQ&oe=6A9ECFBC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r72zCAEBBzwQ7kNvwG-A4pv&_nc_oc=AdorMgZcmFgEGsXMbO5uP4_VdjkeBH7yU_PF2HSRcAW6yOsNieAXvDNW4aimQ3utvpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNNmkpy6lAL39QLzHX_yWRvvDxuJ4ebu0M4nrEtLjsEQ&oe=6A9EBF22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xX5-CX5nlgQ7kNvwF3DWFa&_nc_oc=AdrWSGNzHbAYvZD1DrTiAoOTlEj-7choglLYInXFEp1dOTli2lnmST_2YOedwzyf6yE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD6kNCLO8i0wk7ljfAy5BJv4hidMvZjr6A9W2lMS8uhA&oe=6A9EDBC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQzpyIxelR4Q7kNvwHa8OvB&_nc_oc=AdqQ4aMpM2CyHI4RA1_cr9KvSz3-bROnopQMPikMyvNOmob20rvEJFlVS1trL-sneMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuZA31EFodymRHalRp2LQGw79i7LE5MijMaeiEFlJViw&oe=6ACE4DE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztMBfNyG8uMQ7kNvwFTENz6&_nc_oc=AdrSI_u6vEZ7t3oCZf-7NqBN_8OoptosVt4_0baBqNhaZjvpa6HpdUJYCMYxoBUD1_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3m1BzrLIYcr3-05a-3Uht8NMLGt9XaUrW0ybfOjaVGA&oe=6ACE3D64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2vaZbTK8TwQ7kNvwEA87qt&_nc_oc=Adpp5mvnak_a_Z0y1Xa99cE9YVUbOyorGwpWG5l8tAVNMU-D3WS5Us4puQKQkld9Vmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTlb6SiNoPOQTZYcHFyzIIm_9bsved2c8EdfYouHooBA&oe=6ACE45BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5pQ5E6_GwkQ7kNvwE_-ycZ&_nc_oc=Adpv58b1eNHSxBpdzvKcMB6k9JV6o0h79nbbYPuG7Ngc4tzQl6liFvZ_3ld-5p0zv00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsprgH8I0ouSniDQ92Pf9LRcfpNzCBImA-Q6skrmjeew&oe=6ACE3522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69K_QGKPoeEQ7kNvwF3grIQ&_nc_oc=AdqNyHTfwX8rkGSIbnYnMvqBWrW4OBFvIiZvaMKvn4b0PbBPAIYrtYJbVw4_RmfdO9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcf-NSJTQok7_XoPhuxoatBsEtbNGDCpLMdMOQCbWOTA&oe=6ACE51C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
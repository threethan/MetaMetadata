ng", "id": "1158084358857990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTAm0cJgS78Q7kNvwHnJTFt&_nc_oc=Adq6GA5GMiS9ug3eksgNjbVavIKcQjY0DC7Xd3dGpMgo5kT_zy03gaWTdNAszfJFMp4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2Cc5GBctKoIkGsnzxIo_rRZHfEPIbH1CnKyDR297fow&oe=6A2AD3E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2WoUI2YgyIQ7kNvwHi5XgY&_nc_oc=AdrwE70OEncjv2LNvMxoJtlFwlG5s42DUsf4crJAKm1ctNAQ9Sg63eM-fjmonph22Vw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80hiRvmbpxi2_FSPYuonfrh8-WRF9VP3EwKhQgnuQwsw&oe=6A2AC364"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j0qU3GEDo8Q7kNvwHZLYPl&_nc_oc=Adr2xxMPCH6XDB-ZcpXgQgrvpYt5zP0Pbvg14nxgiiZaO-DCILUboPu-g6JB1MkacQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B6OgUpPBbOz0VeJhKm-mH50fJT7P4FlcVPWicQ5AGWA&oe=6A2ACBBC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKKjsEERrSUQ7kNvwH64KfG&_nc_oc=AdqoRejbDcKIbAeZ2NxAZBTXtjL8wZ1BvPwz8xRzEDyrO4kJeyV_kvUd-d13BL9zvOo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9srNd_LHyX1FMffQPBhbqW_Hk3c0gUq_NY9E81RUPsA&oe=6A2ABB22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Pqxy9BJaacQ7kNvwEWWTLK&_nc_oc=AdrobkGaw0m7Sk8KQl5n9Kdw98Xv4-efIXkJfxjJzq8YLxkMAhiMQnNB0ifQZZ0z62E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af992n3rsrhKjrReQSOndiTY7HXsnu0waQ9fnD1-jqjp0A&oe=6A2AD7C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
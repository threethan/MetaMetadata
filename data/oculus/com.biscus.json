ng", "id": "1158084358857990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBwzt62WamIQ7kNvwEIGp-P&_nc_oc=Adq_TTMp7CUUOQPc-tUsYLU1MesaVLHSEvhzQ6-pb0BOarOC1WdCPmmt7VLKz8yRxwE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lRrG3ynO82iieYx9t1V_Zn2fEhr2cgf_D8PBP7YLJdQ&oe=6A1B01E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTn64oUIiOUQ7kNvwHIcxIq&_nc_oc=AdowcVvoAJhCKqGMkKBY5RjYgxLj6KrK1nJr1s_t2wFcxjkOAw98hA_1-C31GVGYjSU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-RWJHw6qR9mi7y_Fxo3mPxLTKLYsmAe2G-gGChLavzA&oe=6A1AF164"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQk-NgFfEG0Q7kNvwGfpAUi&_nc_oc=Adq2w4SPNfkPsJEDmDf8Y4gteHAncwd7B2fTQS6tKdq9cZZkuGpt8czawOsWngsuetQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50C8E1OdRyPQjTcdaff4DqURk_HFzfpUypZbIm9VH9JA&oe=6A1AF9BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJiEXEu3CAIQ7kNvwESeQ0K&_nc_oc=Adq1LHwxIl9BugHqxMukMBYzJPPjr1O-mtE1dQQNLOq34cP2uvOJd-kqxYd1LJplOtc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4daxCnloJRydrWdUuOWGnxStn7Y3qqKdlrI9RnpfyTbg&oe=6A1AE922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU5Pd8h3O6cQ7kNvwGcZj24&_nc_oc=AdoL_h131Xe_r7HL6rUpiklcTQ5Ewj_OrTD2milmFXDLjyP9R4BvMAIKbWBbAUTk1XQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sNSgbLv2N4a0PkYwC8CuiO0WnaqQkF3fkyE_2roZ19w&oe=6A1B05C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hc_S5ze9a8AQ7kNvwEWt0eX&_nc_oc=Adp4K3cnPZjnbX4kLDLLXl0I25T6Xo0mfG5lYxjn5G_Rhczqx_MQe5g8gyvA52c1pLg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oxCILcCBXv0rm6HAKhzEcUo6EpZ_19U1UlBK9pDOBAg&oe=69D78D23"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af7u8nQ24ZEQ7kNvwHyXDSP&_nc_oc=AdrMjT0bYAf4qGEgvtcLmDLCEz2xMMvSMbfJbaHGwlIpxt4FwBWvXNM3SCE0vc5MOOI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N7gdXBz8hPnrIrYyuiAeK2u7qaVcWyA2oF63cvH9u2A&oe=69D7B4E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0k5SSRsvidcQ7kNvwHnz0fi&_nc_oc=Ado9cmbv67q8VaZnvObp_V4kKJDYLeg-T_0Zd7vvrjER8kFws4PvHz6MURiWNko9I14&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YusfedSAkfCqTHUit8a-8g4Km9Qv-Vug6zYQu-GktYQ&oe=69D7BD3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAINHGspiq8Q7kNvwFyxlBJ&_nc_oc=AdpmhpvFgx6w_FdIfXIVK-bAnXlcL8junfUKaFCf-4LTjpSrdvPqqIuetiskrYvX_jk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13Q6dorggpZUUl2Iv3z2RA2HpMcMxbvpiDuz2-ijG_vg&oe=69D7ACA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRUogNBaRZkQ7kNvwEr0XQK&_nc_oc=AdoRWazqmwIdQyL8TfvKt8gGE4ypy03plqkmdHYaYO9i7q1QDSfXs8n5y6SdPycKReQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15fvAB92bDZhCuiC5lMyMRNjbeuOoo8zZlBsqrNSWUAg&oe=69D79100"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
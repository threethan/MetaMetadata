ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6jdQeOi2NcQ7kNvwE6Vr8y&_nc_oc=AdotCLd97F17O521-UTpNJPtJSDVERlme8M0iq_L0MFlkfhwoEZhhSskPkFQb0L8B-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsHN6wVusTSdr3_mtnXYwE2Ub8wAgRMqLJmmtE1sXwcw&oe=6AAAB563"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVAbBhT82A4Q7kNvwEkDlaC&_nc_oc=Adp9RgggSYFNFdEzzjAOWpdxUp0LHWW5I3m6aoGUZYhRFHWYBXdR9uFYz_1Gf4qxgbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXMMThLvyHKoXLaaNBFz8QVg7FbDOo_bXZdCYAcDNkdw&oe=6AAAA4E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLgVBcJL8HoQ7kNvwHi5GPd&_nc_oc=Adpc4PSvES60wbQVLki-SKzM6KxXT06x3JEiIJtHTr1ecBeZ50u8s47_EWAhcfNzzgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLjrurRqPSNAtjLafhrxC7r6g28rUhHgpECk4XfTO6Fw&oe=6AAAAD3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKo4tZinhcgQ7kNvwGC8qMH&_nc_oc=AdoXFzMmUQr4tKvEoo-GK0SxCytQPfSN8OsLRxtpE8t2_Ms0fEce9Kx8Nx-UdA-DB04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLR3X6rf95_gqSPFKinIn_Rs7P6-5ivTizk6nWsjlEgg&oe=6AAA9CA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mSqpFWIZyQQ7kNvwGyeAtb&_nc_oc=AdqSfaE2EW3T8ZzUFtFjhNPGFa1AjJMn53XIRCxa9QtkFtXqlHfzVeymC-mzgKpdcp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoH0JdAtMz2kuqNga37ZvtHlu_91mKInjSh6W8vsfIDA&oe=6AAAB940"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
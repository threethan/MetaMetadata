ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Po6Mm-tDjYQ7kNvwE85Xzd&_nc_oc=AdpURUEk2Qcgk-YD0JYdwEWWQnbwE-ExPsCgkcOyMC1Wtx_oOQzElYlcTaGO3hLbJbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlYMmORrJ-W6mAIXoYNFf9L767ld_5Z7p9j43RXdyzuA&oe=6A5260E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf8iZEk-KHUQ7kNvwEoVAJO&_nc_oc=AdrUVzj8p1438MsLW8F-9fBMlbtfnAkGVtjglYpKEHbIl1qebQ-1Mvc4zy5Mjj2pqYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwkZYvU6Kqf8AnQ25yE2FnHM9iWr_sX0dw2N4W_leAMQ&oe=6A525064"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUS4Pz5excwQ7kNvwFbhDxj&_nc_oc=AdqJNCq2htGFqNsg8C-ltMtI4n0Cip5KM_rcSU2jz33YBPtLbibUJsvOh75xO39k_6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu8lqvPsdaii1WQBRwIZhXUVVSdZXY0vtb-_yz8o1-mQ&oe=6A5258BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ-iEGryMFAQ7kNvwHaFr1k&_nc_oc=AdqY2uKvg4K96jo7G_UBfxQHTibHrRHoSFDn1O2hPNTphaek04Dlq-GD-K_d_OZQJiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgpjzyxQvOSnL_oyZyeWSlS0h7gvvMQB0jTN7UtI-fcA&oe=6A524822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wo9SSrSRKBwQ7kNvwGOs4gK&_nc_oc=AdpvLJxGLrO95Zd8bz5FurJ4NAXpoh-Y49feg0Y7obEklOc_HCFcUoBCmnWCGDM8lQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjxGX6gb0y_KS05thK1Bhk8ma0wQduLwt5cG4t8x1Ceg&oe=6A5264C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
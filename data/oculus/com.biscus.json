ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyt3NTTOQXIQ7kNvwFEy0rx&_nc_oc=Adqglc7LmJNtTkx6Cr6_XQaeWsf5JtnToDPwxTLFkbKm_szAIj5GLLW_rbcGHf58x9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Lc2G1r7OJGkZkg3kH4aqA9Sl1X1yti95tlbLtX5yXmA&oe=69E4BC23"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUAA4qqtHckQ7kNvwFsbH_z&_nc_oc=Ado247BtTbb-vGrTIcG4dqWxw7WUg4AZFd4v_zVItkotmKk5ThSaYiFpT1CEEM_RHEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HoUPWYZnbrAnXBYjYvTaBh_-OWtuxtqtLVCWxw5sS4g&oe=69E4E3E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvHmYV6UJakQ7kNvwH--Nd-&_nc_oc=AdpM4LzjTWrrAqc4lgWTd61FoueqMK1aypqdeabtC_dfCGsLP7oAIITFy5iO_0IIhpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OwZVHvbtnDkIllaFIJHrPC-lzSSJcnl74NDBsPNhIdw&oe=69E4EC3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxNNJPVFClEQ7kNvwHsPFj7&_nc_oc=Adp1Qew3kPnPbRz8koBi3VPL_RtBnJfu3vQYk_O78PlPJT1GaJ1UOPo_khHMJ3exdaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ek5bOiZR4t27vTEbEhbQKnXZ8p25Z4JWNV7vhXE_lIQ&oe=69E4DBA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YK4ETQ7FRxAQ7kNvwH4nAI2&_nc_oc=AdrSe2pxOFi5UKcJ29Qbn4I9TzHy2d6nIetqTypuS11yxr-XHwxT0pPzrDMfVqhDxVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0elt6cIWCBrDCBkbm07fUctnQR5-Kbu9QWSNoH5wzQ7A&oe=69E4C000"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
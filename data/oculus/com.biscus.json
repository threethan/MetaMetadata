ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I-LotmQ7owQ7kNvwH0jD0Q&_nc_oc=AdoZ2R7227H9HUosblD2AzZI7RjTe4CbWzu51bz_gWx1khA20RDy1OmyDTluYJ73cDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIOSOyx_Jp0ja5ErdOeao40LI6AaIiUUucNaWWVzUDvQ&oe=6A4D1AE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ao6CGRlevZcQ7kNvwGzmxxu&_nc_oc=Adoe4uxDqfw3UWI5e8ixj_cn0Z53SY5FBEdhJ1Uzai1wy3jlJ-fQIDj7zgxGbTDZGUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhVoPzkny0M-cFYu52e-LfgtZSa4ZfkAYOOfneYY3CKg&oe=6A4D0A64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOByOWz5boIQ7kNvwEEscH3&_nc_oc=Adq7bkJhzUolEBYS9nUuszbr_wjAwL9cmMbJR29CBqOGjl2-q1RadGAzHTuH-Hikowk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-x919UkvEgyfHQi5jxIKzJQ2RmtAHerWfzTmD9TrIYQ&oe=6A4D12BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4R7JFX8vukQ7kNvwFasfeU&_nc_oc=AdrxGPJgVdjVsE3acJH7Uny_YUHAnGkebiCAZNIUU6zc-RX60E5Z1RzGXBewFSmzsKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM-iv2VV0OXIdF_MFYaprAvOGScicAbsEI7fFcnt6xpg&oe=6A4D0222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEJXTf5ML6EQ7kNvwF7DN1t&_nc_oc=AdqjmzNfNPPS--vQds7UkFd-3uJhgWvJ-wz7YiAXgHY6H_GjInHMXEuxFipvy4UQyLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6b9580uG0Dh1jlUn6vTuoNag-WnMCLFm1PnISqefS8w&oe=6A4D1EC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
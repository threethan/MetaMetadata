ng", "id": "1158084358857990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEeBjJRa-DIQ7kNvwEVi6Ug&_nc_oc=AdraiFlmLhXlv_RpQ14_8v-pkkFdgrVIA0U-dAH50pkrhpwV_QVa1LTWkxxGALhY71Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LkrFiGqfmHRarvFPsaqZSG2EjKiGbUKhQinQ5a5Qjbw&oe=6A219963"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEvACI-NjzIQ7kNvwHfJF7l&_nc_oc=Ado_AF_dZ8KrMgS61GJi0RPgCA-c_WZVgwGYLsXU9duecUa4ilKplI285GSGJKICMLM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xhoFHnWlONpFHdGKxaPRkwREwKp3llDx09y3V4iKsLQ&oe=6A2188E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9fG0ybxk2cQ7kNvwErtU-z&_nc_oc=Adop9qfl7pmVrdb6g30o9tvZLsHiGigBlfagoxGrrIhCzKDh1jvrTCIncBGuChuuf1E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1Mlyf0Xf-A8fIXeOcf0XZG6n-bXLnqlyxMjkWnWiQoA&oe=6A21913C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je916ORn98IQ7kNvwHru3PK&_nc_oc=AdpWahq6Q57plNvgRD0QA979eKoauK5u5B2wzDaAQ_K1ATp3ByCYQuwCUxeG7yGkXo0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lJR7vGb8JWrTDQtrBPbOT2ubPn-_tJEs4E_A14wNTaA&oe=6A2180A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtxN9kFwJOgQ7kNvwH_-sGa&_nc_oc=Ado-coI1riG7dxRE1uSyxHTwDlhbsEdWLckxGP-sdN-A-dyRl4dOcDnRbtNQAwQuwks&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ey82Lj7rQhI0XYpmrEZbU5or9cCVpv_2Rok7qRPNESw&oe=6A219D40"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
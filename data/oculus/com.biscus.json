ng", "id": "1158084358857990", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm-rLxdexRoQ7kNvwEYNoCf&_nc_oc=AdoPETSC_8gDtgkaA4n8T92yoMRxL9i7di6IRGt9wLE8yK_C9USqUgVi9ygM_JdllUc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFIalKhvHEe4J2gGM-w3dCTjc2Ab1cj0Y-y8IbliDyLQ&oe=6AC7B663"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqASVwluCloQ7kNvwFsfhvN&_nc_oc=AdoPgq--yDDFrDUQRB2WcerdLvEcKZ5T2OGpLjTXj8BM4ekjIexDCZWBXY3VDOFeaGA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRIrFBf3jDYXKP-XRZU50qGZHVYMUO-d4rdO2zIHa90A&oe=6AC7A5E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69T_oAF11MUQ7kNvwFt_iXe&_nc_oc=AdqgDCNtXsCCblcS7uDIU9YmNipEvis3PAAeYDIGvKNB7ecVyMdDmZgwIQgyRwkwmjc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBrGHnN2zd24pM0iSQJf5KR8sTmvyssEYN3DZWASEVJA&oe=6AC7AE3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_-13zt8IFkQ7kNvwEC-_-4&_nc_oc=Adpmm4c8nOR1VJ7Re7I219vk_pohEm4Z4wKL46iF-Yz9NQ1heZjVk-SrvCEjAplVnY0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJKLqFVZtMsrkyaK7YWty-h3P0y32Fh-Ry1vWtAcK0zA&oe=6AC79DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AScFCdZFrB0Q7kNvwHtWE-_&_nc_oc=AdpcputyINmsC67CvfK-b-Rx9NDSVOSJrbjburVZIT7gpW84twNvUs4-bq1Dk9_izDI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnL7tkesl5rGqbyquMjgtUI1VzXzDDwTVpERKDR3CXeg&oe=6AC7BA40"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
timized.png", "id": "1000447408102766", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xk70a7CBoMQQ7kNvwE0rv3d&_nc_oc=AdpxT4TEwa5KKOa1yrXK0wjXQdOY_pDeA0XklSNZ1rOll9u3z4a3oqWFodm6DDpiCHE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7UA2WN5B_CQkKNeNSvAWDtaOCQ8GFNkUZU8TOxH3zwA&oe=6ADCC63C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JzHLk3L7zYQ7kNvwEhtInf&_nc_oc=Adr4I7KW2TXgUuNnQ6p2Hd2vAhQwLb3ed5JR97sL3wk3GinWjJvb-tJ0mYCR0p3R3pY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTo5a2Rkf3tFErEPwNRq8-J5uyVagQCytZNf5nChgEaQ&oe=6ADCB5A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLfLNp-3UuIQ7kNvwHvMSQe&_nc_oc=Adp_r3r9R8zzZpMjF0rX704FtktIxdGWtY6KN7BPl4TtEIpGW-8zpbpUHiwE0L_igVU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyNCazeKMQZklztzjUpJJVLBRxzBAm7a-4_hFvrYT53Q&oe=6ADCD240"}, "display_name": "Biscus VR", "keywords": ["monke", "tag", "horror", "multiplayer", "monkey"], "long_description": "Swing, climb, flip, and run for your life.\n\nBiscus VR is a fast multiplayer game where you move with your hands: push off the ground, climb any wall, backflip off ledges and ride ziplines and swing ropes across the map. Every lobby votes on the next round, so no two sessions play the same.\n\n11 GAME MODES\n- Horror: one player becomes a huge Monster that can grab, throw and eat survivors. Find the power cells, power the generator and escape.\n- Murder Mystery: one murderer, one sheriff, and a dark library full of suspects.\n- Infection, Bomb Tag, Freeze Tag and Team Tag: classic chase modes with their own twists.\n- Hide & Seek, Capture the Flag and King of the Hill.\n- Spleef: shoot the floor out from under everyone above the lava.\n- Color Switch: stand on the right color before the floor drops.\n\nPLAY YOUR WAY\n- Ranked lobbies with tiers from Bronze to Unreal.\n- Cosmetics, abilities, pets and your own fur color.\n- Daily quests, a prize wheel, and gifts for your friends.\n- A carnival with a working Ferris wheel.\n- Mixed-reality and third-person capture, powered by LIV.\n\nHALLOWEEN UPDATE\nEvery map is decorated for Halloween, with pumpkins in the lobby and the carnival, and Horror mode is waiting in the hospital.\n\nJoin the community on Discord: discord.gg/4WKR9TFbq9", "short_description": "Monke-movement multiplayer with 11 game modes. Climb, flip and swing your way through tag, mystery and team modes, then survive Horror, where one player becomes a Monster that hunts everyone else."}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interac
ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHmsWQExksoQ7kNvwGbTwl7&_nc_oc=AdofEUZwZ-LHHJlEWfgJxuliUUKlU7z0UKxwMLFH34nDfX5z57-iud9i6OelWbowkcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NHGYq0ybpLDJReRI7cOdfDxmPsCTSyuLPdGtBHCQIzg&oe=69EA3A63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VcrSCHT7cQQ7kNvwGaFZgF&_nc_oc=AdpRLDjHAGn_NA6bhX1_5wYuorZJ5VwIczg_NnCbwFkIYFkFPzzyznrJ5e7yG2EquRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K5r6KbP_k-yFwfJ3RKse0PgstXzFWAyGt8a3W66KLeA&oe=69EA29E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOfK-b67uyMQ7kNvwHL5Bfd&_nc_oc=AdpLF3OkyRWk9L6XHE_ZsC9ehT7zIEpWIqvPTSYDYNmah27YUMIezKj2VEbyJ8Kh7NA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JCKyru-vmyLisCsNRRtwpnd8KihpegC8dNz9PgK9ZQg&oe=69EA323C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjGyMjYSSpwQ7kNvwH_D3xK&_nc_oc=AdpaeKnjqARiLSPC1RuOkFcXsLoMUPUIn8IzAouqH7L6_5QtlfI3jSN_as08HdlJ0yQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YPSJgzbHMBfOqbMf5-nU6auCcAODzHfrSrTr_xcLNrA&oe=69EA21A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaAh96NtOn0Q7kNvwGX-P4a&_nc_oc=Adry6v1KCw_D9NHOSXrEvUZyOU2wjZpSVN0jKSOsDOq7cXYifK8fJGY6bBydDUX8h1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BW1ELQjZiC4JtasOtSNHIickmRDJfMkmXn1I-Y87Now&oe=69EA0600"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG7Dg1yiM_UQ7kNvwHT9-hR&_nc_oc=AdpSFJ0QZJlInAZwX8IZmzai5JqHXml82KvKWz7YgK4wQES7pbGhlaV2nGIGh7OXiW0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQxwXNjPX5Jjvs7gbtT9wNoFB1AiQnwdN4e71DpYa1bg&oe=6AA56F63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSRumPEkgPkQ7kNvwGkuhAh&_nc_oc=AdqoaavDk-HiwEQtAZCu-Ha9X63ayWpGg20SJUZXAbhF4BPdkIRGrYlbCuz6sWWweLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ3TU5pYTrZc1XxSQ6VS6tFx3jPC-hooD5HMknbpWWbA&oe=6AA55EE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImQTFROL4R4Q7kNvwFuVfi6&_nc_oc=AdqiS6kAISl8_IRq_eSHg10QN97OSiwYWBksb2Uxc1sKrLoCOcO5NNqzfKNfJBXNNiU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-lmKt-x17XaH5OIpRAccdVqb2puFcGQV3ANK0xlS52A&oe=6AA5673C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB07iuF9AGUQ7kNvwF7fLnU&_nc_oc=AdqArAcA6jpcsK7mu65WDmSa2XHNKRRp8WT3Uxfj_iCPsPld3xstBMqLyhJkVwqrZDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLqmNCyN1RbOV9LKhAQJ-9_6gzP-6c_OfRu3_LNP9YKA&oe=6AA556A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Dy7Wcu6na8Q7kNvwG-xMFK&_nc_oc=Adr2p5OrNwkUjn-s3SqkFpLQdW_EWOn2UAfkdj5ey5jLvu25RmgYsuKq7PPuOPRFM7o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF_dJeevmXzL9YCCkcZ30iWQz4oI5OqZEXW8qXS9_20Q&oe=6AA57340"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
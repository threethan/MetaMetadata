ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6jdQeOi2NcQ7kNvwHdLK6z&_nc_oc=Adq09oqwZrPnm4f_IE7OanbvWVjIry3sU5JXEZjA1oCCbGeXmeIVFZNYV7wa0cyJhXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwwWZDgWoR5ruaDWGVhgmC-Hq9R06n8dBibrVW0fwJZQ&oe=6AAC06E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVAbBhT82A4Q7kNvwENhCIH&_nc_oc=Ado3tD6ftgA7De45eA7DAzKh8OzwlFbNWE9mErIBsN9N8Ip8_iee9u4cI1etV-hPLFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgPkfbRGH7rBI2Aw6NGUfWbh2BnR_NFZ6DgIWZWJSuzQ&oe=6AABF664"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLgVBcJL8HoQ7kNvwGbgeF4&_nc_oc=AdogZ36vSyp5bW-by-bed0appFmCTXNnqXNCEbqdjjwkMKFEGrG_6XYLCHBkT2JWVzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF_9w1ZLuNmBuDrNaIu4uzmaWn7wqZJahiaWPlSQKMMA&oe=6AABFEBC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKo4tZinhcgQ7kNvwEoCOxm&_nc_oc=AdpYuzB3jzEYkYHjPUoZtYL2HygItfm5QGflp3UtimNafPOW0WPvL5wKa-scsytKwBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIbORyJOmeQ2cp_WlGeANWeERJ6Rhe7ItJJivGln5SVw&oe=6AABEE22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mSqpFWIZyQQ7kNvwGxFcXX&_nc_oc=Adp_1HbvbuPQAwoQwdBMg2QD_7G3b4OWHow1m9nUxhysJeF0xUvve8Qqe9k4vn-9JHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvcr6Kep1TD0dWVty5m9X2KWj5-qid_oBpfhnv9KFkWA&oe=6AAC0AC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
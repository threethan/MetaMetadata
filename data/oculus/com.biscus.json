ng", "id": "1158084358857990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9-h74xJ11cQ7kNvwHnV_wo&_nc_oc=AdoFaffoyW8yJD1IyVRE_scPFRq-VlIZbBoXp1v9EBtRePJmC589sLftIUJtUh5LZ-A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR7FCWMuh817eQMLvnFK_6TTePO7sXf9wX7tgrU8Kn7g&oe=6A5CB4A3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stZ3v8T1J5IQ7kNvwEqVhOh&_nc_oc=Adp10ua7aSztRnJ5AW2h9gn-JReW4XZy-o2cnjGWOKHsdJ8WsFsMDYRg8fSePHZ3oEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsn8HmxL7ah9okhkuGt_wWB6ibLdUscE-RlAtsBuf8LQ&oe=6A5CDC64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyvCIK4m5TIQ7kNvwHHcX3i&_nc_oc=AdoONtWLVL0u0vv5Ou_EHmy8-V3gHzG1r5fM24PaIe1EJkf7grpH55fAtU_eUC7ln9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCycAQNoRDj4jw65s5YkoERaKGPYuteT5fv1ETQbtK1Og&oe=6A5CE4BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saMHaNDJClEQ7kNvwGmn8LX&_nc_oc=Adpckv4JuarHAQjgfVhbDIzPIGGLJe2PM-7l_HgQ6q2C8sj5jVTCMq-7j-Kt4nHDz7Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-tP69UeXRstvFLM42_15OzVmWGJ6_74_mBZaIo7ZRGg&oe=6A5CD422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwNEZAS3is0Q7kNvwGogq7T&_nc_oc=AdqHNSJ2o5bcNSAfVtdPRywI-q_M4fV5DXRQxBQbrY0ByxTGNz2vNAvb9bKNOwyXLCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKWUWr-FGjJUKLPfAl8TsXiNrsMkQM8W9N1di2vwImbA&oe=6A5CB880"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBwzt62WamIQ7kNvwG0PlUj&_nc_oc=AdpGrAcJJuXpsk_oW_IO5V7n_ysGjLSOAaFyD7yIK_rWcPFr5MKPTZEQPLtiF80CrN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kVdEmpDh_nY3rHX2P594Q53GeMpmnspimXQZwh0Ad5g&oe=6A185EE3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkBB4QDVyScQ7kNvwGEXfQK&_nc_oc=Adp2Sez-O4-hjeiLNIP88wwIBnlc2qKK5omHWqnZKU03G_S2l5zlpFNF2EqdCFLrKmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_DnbQQMhA4Lt0iOqNZ9O0aeSbwAqQMKCX6W-gIHmPwQ&oe=6A184E64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQk-NgFfEG0Q7kNvwHwJGY2&_nc_oc=AdpFVIE42X-j0NbELlML_51DABGEfK90Ze1rllEzfaAMZWpTFrHqXx5Pwida4Q-9dzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cSQu_hKRpTj3-nC7NZo33NAwfo2-REvrUoUeySLNLug&oe=6A1856BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OwBc-JveQkQ7kNvwFJwIDo&_nc_oc=AdrevKK41zbNIWOwzyrrmcUGmTQQP0ovrKBD8TC-Q-zdZ4amoyjlhxGst50bAQzKscw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yzBMys9N3UHoLypyWeDy9ebTeRYYdiiVt_biUhQ8V4Q&oe=6A184622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU5Pd8h3O6cQ7kNvwEjQSVs&_nc_oc=AdpGtlWwXp1wxAIN9mmmdC1jPWJpGHJhmSERfvnmM82wB-H_EWPQjH9eJUkPREvGf3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46g_ADeCKFXQvqCmuGLuxe44jxGzcxYTOcO-hGDczUhQ&oe=6A1862C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz0IpWm5jdkQ7kNvwG40wGs&_nc_oc=AdqaoyPMeXFz9g7d4p0t0iHhzNk4RavGzyBQxugwIhXEml_t0C2wuIB_SVcY-SeekZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEO7xgHM26GxUkRgUU5_8abJvIvvriFvm6ns2yWnR5Qg&oe=6A79B5A3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jx_EiiJdLdAQ7kNvwHWi5QI&_nc_oc=AdpuoegebkG4ktFebSur_JYmpbYKYYc8lkZQ_GokwoA8T0-KuB11MzmStCFJ8IbkBHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNtuNnxTBFCAdlZ2FEmUXb4uybJKdIfPsxZCG8npWarg&oe=6A79DD64"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g80cFRtZqlwQ7kNvwEpkxfk&_nc_oc=AdrUnYYXb1rhXB_NW9gHPzdWlq5V6cu6DHs6S8Co38k79tLpF2oxd1_lo7aLUJqUP8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSjjv45DCi9LLmCen43sVTBhMcfUfdzNmUsrVVizxJbQ&oe=6A79E5BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVsIJPa_HEAQ7kNvwE2Wk3T&_nc_oc=AdrzyTdecxuB-uazSv3P10PhfydBSpAlY6a7a587QbF2-mEuL8Os8-EEyRBrvpKvSN4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDH5oCFarLcObXO6-s-wFFix3GuPm3avSVyauDxNvXSw&oe=6A79D522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXzVcQU-JIMQ7kNvwHmgDM6&_nc_oc=AdrZ5cJbb04ll_ky_EZp5ZJACk2kQZ09cWmEE7IArB6wGFCzfjqUXEYZHGf9mwv3ODw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGilVUaSjfq3y_aeCxqTzart4Y4uerKbSfRw1oK1fgMIg&oe=6A79B980"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
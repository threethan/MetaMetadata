ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNAFBF2k7h4Q7kNvwFN4HBC&_nc_oc=AdpvclR_m3ctei5kHDgeNQaLXkD5k-YYwpUGJ7BNCfMQiRwMJz6jQbTDTCjKn0aUhSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34BHbKjnTK6LSK8f-yTKodZBWMHgfQfJAFkGUVXqJSAg&oe=69E36AA3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUAA4qqtHckQ7kNvwGLPMNX&_nc_oc=AdplRvwZ__Vo-MLC46mHGWFgNVVQWplw9ol2JsGCYGKBS00m9UVemFL_sZLA4Dtk7iE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AeCYjawelSO3SfaaxR2VD9FKv1AfIdmKOsrVVJOQ86g&oe=69E39264"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpbgvcHhMF4Q7kNvwHhdrgw&_nc_oc=Adpfu0ZKDHnBZZfQnCg6yMBo-hPLGPbTYkhlPAvZkMo00edHhQwWwypQ6l41__svtC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uN5fcBA3SZgqeFm1QbIr4KeNqFOJga7GgR1VmG7wcww&oe=69E39ABC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUGjYafurkgQ7kNvwFuMglA&_nc_oc=AdqO9EmWzcbHlkUOlairpDkKb4Hqi0KxrZndufZ6nWeNCDq_zv4idOvXvANBy4eFVXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16do0zetnts5r0g0tjcmKYBI4JuRR6L7agzVacCkllBg&oe=69E38A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-nYpSGvUbYQ7kNvwEk4ga4&_nc_oc=AdrTcdrvsR4zTG9bqGkp2e0LmMepwyVoJ9gblUEtS-y68f6QDBToOEoDpDQLotnfNTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V1gHm1WFIuReT-Q0OJfTVLGEBZb2KsA6dOl2ISnCI7g&oe=69E36E80"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
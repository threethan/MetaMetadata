ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBgMUPqT2DYQ7kNvwEr48vP&_nc_oc=AdriAhi4nrOUkASFd1F9L5TFROxOsuHcVLwN1vE0o7F608GmIyiGfxVKlQvEQZIqV8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q1O3bf98kjQ3LTuWcbQay1MzcNDde3Q9t-F55KUfaQw&oe=6A1DA4E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTn64oUIiOUQ7kNvwE77aiK&_nc_oc=Adr4NhCWtNdpRzGoBTNTH_he1zovdHojXmfdsG1qGtzWv6w_nRU7Ha2IM2c6voKAj5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mtW_t1K2bsFUnxkvowGjBYersVHjNuD2_kmCpKuyptg&oe=6A1D9464"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPa3uEwd_wUQ7kNvwG8KKmO&_nc_oc=AdpsnaW-2yKbExuFgNhDPyUqGFVzyMSqJjcwc_UZ1x_VqBJWKAuBWGelqn5Ek_i4k1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IWY9chx1SPn2bQsoCj8faj5CTuCnV5pZcRT2pCCDcYA&oe=6A1D9CBC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJiEXEu3CAIQ7kNvwFN8naL&_nc_oc=Adq_tZW4_7iot21hoETMxhObg_WgYY7Xkg388iVZj1lpBoXnA0E5B7kG-g4pXOsAC3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_YMQCc4_MtlPpwNGe9EsOSsKSM5GHHy6e9CoXQ0mRng&oe=6A1D8C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewwC-017h24Q7kNvwEqL2zr&_nc_oc=AdoUCA4p0aiLd07pxMY78jKYmSwdeP6Mj8U3pSowQvS1mBzx9rzmn1vJlvqTIGGGIe4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YVlR666ChWh_eqgtXirVz8QsGPo20F_TT6-vwWfLBqQ&oe=6A1DA8C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
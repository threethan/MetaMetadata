ng", "id": "1158084358857990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHxOsOCuOcoQ7kNvwF4adxm&_nc_oc=AdqIXgUCX6z-YiOYjdSDOUzsumIjr_Q_t2jxpsKqY16iw0LEWoFh9de035pajsIUM7k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjU37bLfDzCcuupQx-N8YMewn_XMO0AMu96qUHVXoTeg&oe=69CFA423"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=manXP-u_fqMQ7kNvwGH26q5&_nc_oc=AdprYDFBG6izgNAgwKo6gMriN3hJnKf-72NxyDl4-1XqhUDJ4wiDVam_XYuKS09-dnU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDqdDq6Va3799ZLsuuGNXYU5SQ_4FnBEafXbngpn4ksQ&oe=69CFCBE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSlc0RpfEaYQ7kNvwEU_ylF&_nc_oc=AdoXxD7CDnKjutmVhP3YQqDHtodwYnkeIjRc9KQOIdzPAV3BJ9AVxsZMff2E40J7Apw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyo9Umpe0iZSuJRTAOqW6clhi_ngwJtvalMqmgMY_21hw&oe=69CFD43C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxTRnLD1o0wQ7kNvwE2RVKQ&_nc_oc=AdpFE-QY-E-1oG-Mn7tlByI0ChjJ2M_t8EZXQlpb1Kqhl7Ad2ccr3icXbZuL-wcTasA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNV_9SXtruiXsnZ3wmJ9h25l9vrJ8i--LdP5n08TEjvQ&oe=69CFC3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02S-G7eQBxAQ7kNvwE1urNS&_nc_oc=AdpKjWyrDAtqXFD7dPYM7gPswzOJI0PcZarSoND14XCwdZmGAgphi0znU1F-cC4rYto&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afycot7UFoBhfy3KyedYrH_Oomeo7qKiHs92RBwHTknyNw&oe=69CFA800"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6urX1lTeugQ7kNvwEQWcPY&_nc_oc=AdqosAYvKCWvenX8fEqOjJbpeWIlz9xXanO-cU5grUqgzoyl7L6mUFSsY-vOL5--LR8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBHs34f0NLCawvOWuMbzVdK5SRwhDolsL4_qukxnrEpw&oe=69C7BB23"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz8cc0T2DEAQ7kNvwGS1LVp&_nc_oc=AdpoyGH8q_lozv7jS01G4xyrgsQG_s6Lw1X9_vigdIabEGvWyPGrUxoEJ_RVoJQ3df4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGV7ss6eBS8KD3C6KazuzVzcRdAvCE6Ss9HSxG5UNOlA&oe=69C7E2E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpucZOgvtrYQ7kNvwF0ZEmF&_nc_oc=AdotDYCWkJnlTZ_4qXamLj9AY9Ug3WP62kgYh0LzqqFzTVj-e_mOVFFLL21MmsUXakY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFW327GhbkFpLUVqLXiMMzWetLBVEVGwMOkVHxHMpYxg&oe=69C7B2FC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AANDuvn6CkQQ7kNvwESldkv&_nc_oc=AdoFL0YEZ6nY26EY-hJh1-1RNdPC9HbB7AXj1E0B-HE1LdI3dvou3tzd8UcSL6o2OOU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy069ePWj9lSXDcpvGElo0___H3cexh0FhLsRquiq_IHQ&oe=69C7DAA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6E5h5w7LWcQ7kNvwEWToVO&_nc_oc=AdpfP4pmwBVKneLrja1-dFw0nj32IzdNxD5jr5gPsVZ3Dmtx9NXPtcQqzHAv76BI-74&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyscHNkANI2j_jwv0IBXA87PNe_Yjftd2Bjh9SMGr6ARw&oe=69C7BF00"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkKkxWJmvz8Q7kNvwHRPyo2&_nc_oc=Adpuc9IC9JaFKb-jiVdAeqfMAIsJ5q_5ABlMOjqJOoFY2RPIt7cYN_m3RPHiHEnpkD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvDUJLbHuWiIliu91YjIcfhfe7aRnLmNgVOZ_AopHWWA&oe=6A4A77E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ao6CGRlevZcQ7kNvwETkPiL&_nc_oc=AdqIIgUBZ5j1uun0CexRaWjIxWaNTwWIK8uVnhDxuayWCKpK0Bn1E2-I6-5LoCLHKGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQv_UodG6K-o0hg0KhzvmsyRJEFXrFHUkX8eX6DV0Czw&oe=6A4A6764"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEcVDKuBaJQQ7kNvwGM4nhI&_nc_oc=Adq2ukRGRkxoQ4kAc1onl1khbS-Pjk-Yq8WDFaBksqegvXqZe6ZTQ8czFL719PVKpDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1RROuNjn6_7-Wk6dUggoB7oE_5v7b9SEOqfYQw4AcEA&oe=6A4A6FBC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4R7JFX8vukQ7kNvwFVrAdW&_nc_oc=AdoXR6F84A3_kKUcmycUYDVpKnliw3i9Kv4eIi3v5dsHZ-f6RCQuHlQlGUn5w68ZObE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXT0NW_AaM7Ni4FH_X4IYH7WOA3foTd6UPRN1s3GVgiw&oe=6A4A5F22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCBXEoyOebwQ7kNvwG9_0Kl&_nc_oc=AdrMZedCkW8g7GL-RxwAHOhhGQ0Da15wyaFD0Cw_GF2KdoMAnKJfsy9yMe9ZCS9mXuA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqzp-8YeWigGYWFbOARIVq5_QGo2_gDcw2HsbqmivMEw&oe=6A4A7BC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ap_2u_w-twQ7kNvwHVFHgS&_nc_oc=AdpKRA0nGEgybUxaWIykXTX664bYj6rnqGfgOpgwE4jGVZ7E6DDeuR4WubaGqc0KoBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QAYEAEnTcOPh8gxT7f1xkKTBa4VVqoEKYu3V5ANcclw&oe=6A3802E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMgCzXHukNEQ7kNvwE63db-&_nc_oc=Adpft4pvGO9JC60pzcXDxyevJ6WKFHkuELkbiVTZ7bZ7ZL65UrCuTZMPMATljRlpFRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ex876oaOsY_l4lRdVrCPn2rEcReCBn0vvhsQjXowlzg&oe=6A37F264"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlBWk19oRPgQ7kNvwF8Iwzf&_nc_oc=Adqj7Z5GMDr0nGGw3C6sEzEptnl6pai2iimGAt8bSjWe73k8k1ueEBmbcoj022CdA8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j-mOXKffZ5uoSxED3_TiC8cmt1eXNTHDpohSvuAOe_Q&oe=6A37FABC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o322B1pO4MQ7kNvwE3YI8n&_nc_oc=Adoqu8svAXz-13maqdFqKhwUlM4dbkpZmVD9IvjvKE0i9HR0UclXM_ShqTqKoCzhg9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jxDGAavmcMF2DuVyfsp2fgmYoP1RJTDyR8C_hNh270w&oe=6A37EA22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mkuHH4iziIQ7kNvwHqrSKI&_nc_oc=AdoXHGk3HgE1mZ_oSxmqnlnG4LSKiKjGuuFBpf_nC_lYNaSpSbKcdrPJyJKnBuxpHkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kCozLnWbrJTw4TpAfQYd-zFNc3imGLI4TFyJVF4NT5w&oe=6A3806C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
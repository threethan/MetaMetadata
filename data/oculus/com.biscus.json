ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9-h74xJ11cQ7kNvwFKqHMi&_nc_oc=Adoq9Nsrob3SBmntrwL6vpeXyK2e83_yjCIh-NvLro5a2cKenAtLiSh0hNLGnWny6OY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUnLtNOKyXoLxxWjmQPPWYMB1tPa7IfXYhFulULZ8K7g&oe=6A5E0623"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMqr4z36GY0Q7kNvwGTt_t5&_nc_oc=AdpB7o1p-0UuO49akg0_H1c3euk8vOZSwOBNcpix7aNcly9C9pCEOS9NN2Z1HcCnUEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl3iw46BzTnHTPpvK3wawKjOoQxmg72SwiCRVB9aR3Tg&oe=6A5E2DE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyvCIK4m5TIQ7kNvwFLyECZ&_nc_oc=AdqgZdDf1ZI9j97M9qX1kRRY1kMQhp-0R5lpfQW6-vAVGtzkaThhY6iw5BwWekD8l8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB9nEJoTRC5sHj7wnUK6omxXRYARFmqQvSbyMqKgujXw&oe=6A5E363C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saMHaNDJClEQ7kNvwGCVPYS&_nc_oc=AdpNp0ku_TGoP-4LhT0d1xmMiMTDF7mLnYRVEc-7Ok2GvbAfiSfrpvDWbaCB6fElPzE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRs4sXCbE7ZhkJTyErISwB6u9cmXV7d2vDzV4wPEEEEg&oe=6A5E25A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwNEZAS3is0Q7kNvwELthcq&_nc_oc=AdoMoJp2om_Mfw-qiD7C6PPUVF1WRqAne7ojkDEiyGHiOM7--tr84owfi0xpIpbCAJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADAWfC1ItwZRojnbbWc-s6SmozrE_6LVrpjHbIEVdeKw&oe=6A5E0A00"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
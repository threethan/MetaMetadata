ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPMvDeo6oB4Q7kNvwESwq3H&_nc_oc=Adq-cLYSMWqaKF3iMeIYbdeGfeDqFhmdXG78Lcfk3tHaoWjLGVY6uVSbADOcehd4cb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkYjmwtax6sPs-YXHw7mKM4MDIMY01eNzm66XRPq60Ig&oe=6A75F963"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnCLKB1LK7YQ7kNvwFIq7ZZ&_nc_oc=Adpgp8Se_vb4f18aHOJltNSJd469PCmDU1YQ0VqBCxoW1xLRTFryGblEbdlNr73iQso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHckekGF0_J9FF7WqFM9G6Bn30uAZ9UdbcJ1pUx_qx1cQ&oe=6A75E8E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDC8sgU7qdUQ7kNvwG3ZPLG&_nc_oc=AdpbB6Bl8DrKf0VLcyepbEoTns3FT67aQ1Cl4XwqAei4z27VBjfkwQVMAflpPYwbBBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9RIKmietULP31QS8dRvsR8nx-8JnriJHwp1gfeENOfw&oe=6A75F13C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIwqRhwMWZIQ7kNvwEHILRt&_nc_oc=AdrW5hN9pKzgBHncNaMog2CfIO5iScFD8iYhF7B_OI1z6B2vOmjBf9WsDMW5JGt5gGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgRQiqFbFUTCoNlxR-mjvfexObRXDn127Uz0nIjTl1AA&oe=6A75E0A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56IXk02-M7MQ7kNvwHdup6t&_nc_oc=AdrbElvIkbQSX2cmcIgsk88NYnRAPl0Hcmu3Woj3TXp6QIYI0x3dCw_KCAmK70Ywbak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf0CL1FrvswRpXNEFjBdh407YA-knZcmSZEjEddZx-Ng&oe=6A75C500"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktzUNKzUqkIQ7kNvwGvoDnw&_nc_oc=AdrdMP3hsHTX8O9gZhn5fmAXhF5hSxmmXcaNBjvSVpkq6LG3vkpvYJtcZzma6Z0ZFIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIycc2NKI7BdqSXbJz_uVoXsV-AD9zHCVvkoPcq4esmqw&oe=6AB7E463"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcqYgi2ujI8Q7kNvwFxMzd7&_nc_oc=AdoOo5SaJTHf1bb70ACfkxzdL7DJK9Z2IXlLRnGWgoIk_aQOmU4Tuw70MpQDlZpKvow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPsQ4pAuycKkK70lvKrJeXl-q4VAAD-seigZN4jeoYnA&oe=6AB7D3E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiphWw5-a1cQ7kNvwE6yLHt&_nc_oc=AdrApPDQY0afcX5QuZCUtWjhajAD8L3eIRLj48GEmS-dd8mIgXpT14V_EYu_K7Mijyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQYmkAjjgYhhJC0QdudqlQz0QCC7jj-_vOEOX5Si025g&oe=6AB7DC3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2GGcJ4jIk0Q7kNvwEm7XOX&_nc_oc=AdqHs8EiSvcP9GsLJmHP7yNGhaGo2TKkGii4BWW4pGNAcA8SDMrcBPlaOpxcSG83xSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0JhgoPLJ44LM6oK8-dmI7MTRZmuHlJLpYWQj2OsYMCw&oe=6AB7CBA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZP_oYTr_38UQ7kNvwF2N5T9&_nc_oc=Ado_iXFB3BAYXvItRfxfsdAt3yVqkLY8omfRFmCRR33d2qZEgZe2VEeXjsCk1pYw-zE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMSD-H_wJ_JrUJna0cZ5p_Vdt2l7VDr9-JrDOZpnub4A&oe=6AB7E840"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
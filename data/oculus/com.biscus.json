ng", "id": "1158084358857990", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95Aq2fJzatkQ7kNvwEFsu_f&_nc_oc=AdoaL3rAFH8kDBmH2tFj7Y8SUSJ8djzJlszsWf9z1LvnzOm93X_dat9ATS-W9w1b1-U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr59Ko3rk0CAiBcwwFsG4eV2uip87Vxz6l1u1VdhknCA&oe=6A7204E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xmBQqMFMzQQ7kNvwGkcV2Y&_nc_oc=AdpVWG59e1ZB3rKOp27vY_h7GfiiDEg3QGE1isjG96t8tcOVw97_q8sYWAeeEp94-0Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1upxnxfshEcZXTdoBj716gf2RuNMCeONNdhGvBEYVew&oe=6A71F464"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfFUK9IBjm0Q7kNvwECkyyL&_nc_oc=AdrDOA756pf9Ejpp3UPswzXhnZMRfBmh08c5gS8NsxeBKNvDpxH2vy7IXOp-EoD_RjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw5H0EHZBOva9b9LKgHm7LcnOSlpwpXE5eqBvHv_34Cg&oe=6A71FCBC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIwqRhwMWZIQ7kNvwHxK2Uu&_nc_oc=AdqCh1ReubkRJLfluMYTWOyMLbIgPV2a6cShnETzThoeWJfXDjJzthOKqW45M3Jr8rE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqFg61auYOEEXPzvokGOv2T2NKJbkchDPbQyxmJcOwhA&oe=6A71EC22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wIqKe-cteoQ7kNvwEW9oDK&_nc_oc=AdrAx_N1dWn5HQfOpNJciBIRA869TNJBd7TM_f9lRw8LWlMSOuiMfFDktzwPiFzWN8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMwrOhJpi4nruRR_jSUUOWKbvW4TiKDhHdbIO77rdkCw&oe=6A71D080"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgEMMiU7oBgQ7kNvwFYS_mc&_nc_oc=AdpZ4e0dadJvS-ZisqK8XEjsFs6hn5xkajk-WKyBF-Clde9iasHtguXQ8suqpq584LI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M5WKLMmkzc0nyOYypJ6rYj3KCk7RZj283O64WItIaMg&oe=6A4531E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhFgK94OToMQ7kNvwEf-4qG&_nc_oc=AdqCoBC4bvID4gnsLRiUjGzjpeugtGB9ZeWkKjk3RanOsGmX1tU9lN8jik6boeChkSM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VjIn2ay9XxIS2jRHOa8KTXhOPs2_KsK02bA023z-MDA&oe=6A452164"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM4ojM_mNgAQ7kNvwHYXkYF&_nc_oc=AdpJ8HWXb0HuXiR7CaBZaw-QkRE39amJYihRxEVW0zemEWbVTT6m77jXUHwVOSlHAgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6byKBmAkPkqfgQnPsru5Jlc9r1zXvUfoxG9ShfBd9rw&oe=6A4529BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUbEYPoVKQMQ7kNvwHVM91j&_nc_oc=AdpBghQbuM8XkrddrSzxCVrshaiyMUYNvB02MOYMVHwTvzh-koPYieO0pqjBd38Hkg0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5IC9CaxQGMThgp9EQ0qH5tdaahT3hkCNWof1EaTqF2g&oe=6A451922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiGLD6jMQA8Q7kNvwG8zZqZ&_nc_oc=Adp3fYKczGs5gCKaFlBxXKRLRq6Nfrg9n0_L5K-k6RlnVZIIB9a7bjCp4mpqZSrPOJE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85h-jLrjvQ7R8i1xpitfULUqBCzO2F3mZk5Nfz7i-DKA&oe=6A4535C0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
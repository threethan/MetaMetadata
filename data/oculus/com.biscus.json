ng", "id": "1158084358857990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahJl1DwpJYcQ7kNvwENt1_i&_nc_oc=Adpboln3lQUyH2_eyPieUp3CEQhoH3DifsHmtvC6NU9GIyU8BaUFYM73xazGeSUVq-0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU2RM1cUgZFeuPaJQUXog2TMAObf-9yRH4ipBZsp9uSw&oe=6A8AD923"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfAQxo1sucUQ7kNvwGNYjAD&_nc_oc=AdoG1BsVQEQ23moRAeKoUbxh9mqd1gb_I33xTR8KA1x--ElAY2uRaX_reqt6uEpAtPQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERLwjelI3tizFsZn_BOgxHBqjU0GEAlLb1NgONaQ5vxw&oe=6A8AC8A4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PibDTRNih2MQ7kNvwFmAX07&_nc_oc=Adq6u7uiTuS_DU0Y_XxbRKigpA1f4ZauG4XLmKHl_ZZf8LsMHPVA7hl7oxS35fvPoHo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGupnEIy78H4GbT49rPBSTfJXT57ubueLpFRZj0kIs0bQ&oe=6A8AD0FC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTnDvyfmvloQ7kNvwFkNA81&_nc_oc=AdpnZsuSJAdd7uQo18MrmaG04KCwCiCx_E8-PsG64cNjekIbt1ulYtY-0-PueNBEaYQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDtA-pZr9_2AtmXJBkVRBylkGsls1TF9nm-xASx6cfdw&oe=6A8AC062"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPyYQBQX1G8Q7kNvwFOt7D_&_nc_oc=AdqLM2QmZNq5-xdecMwupZWe73sXakh6uqAj-MjojlFzM220J6q7Nd5quANqw747MF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9S2XI8_0oe0XCFWjIk9CJK-debEWphf0q4N9eyR12BQ&oe=6A8ADD00"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
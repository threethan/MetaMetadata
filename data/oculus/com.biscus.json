ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQNsUYCOFTcQ7kNvwEo7iJk&_nc_oc=Adp1HQYt0c-8bHQvG6IpArea51TEWYFFnR3QLWoc3REmaRwYRxKAjS6Pn8dwOWXjrbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ae9PnuiLzy9gYIshaDd_MtNlB_yC8HBWbOO3vPnM9Gg&oe=69FA0C63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqiVJqSLFJAQ7kNvwEGZ0xS&_nc_oc=AdqS859ZpYYk2pU57VIDM3EgYvKxo4wRSkgCJXlGXJMnYgoyDF788eyUMxsjVATx278&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u-O2c45fw-JFqKyfE_h0qGFK_mWiHBPI5LLUTeoXRSQ&oe=69F9FBE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_89pXGhS1b4Q7kNvwFjQqEE&_nc_oc=Adpe5kGIw9c_4Pb6Hgu_F3hXM7bVk7D6pFzYs8c8wXbmD-aGDr-cKxz-EmaBOp9BYV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u3Mm-HI4-hY-wwBGk6R2RvTiwTuRFIR2XZdzvChGnPg&oe=69FA043C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7B9BP4wcm4Q7kNvwFH47pc&_nc_oc=AdqrHLW6nxemnRtyUW7ZVW8hKpfaP6JoCEAbBBGUqRCghQPsAvCoH48laLc_it5j3WM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GDiUIFEISe77naKFuQaFFRCbWIF0FL4oufSOfBghy6w&oe=69F9F3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zaSLjjPrpYQ7kNvwFasywM&_nc_oc=AdqKePQecjRSExWbaNC5vqhvwTSNOgXzAZD24vNE942zgVmwEFWlviePruuW6KUeG0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Io-VU8WQj4ia87qbpHgoFARk0SaW2VTThLhlBmNkfeQ&oe=69FA1040"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
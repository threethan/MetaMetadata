ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVCPX_NDk9sQ7kNvwHP7b3P&_nc_oc=AdrMelPpdfC-oecXnOUiAxzF2C8-N0dnPA-fkOYwMU3I9XclEpQv9zovpLJYsvm6aX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fNafLS6PpuNtjm5fco8tqzQtzbJRMIiewjsaRlPjARw&oe=6A2EC863"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBiSqmOaAiEQ7kNvwGJz3Ih&_nc_oc=AdrHNdzGBeXlMG8b3xUFyb08kG7mGOYVWLiZEWje77bmC3OmvP7UHlK2z-gGCBoo4Yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fDBopayQEJKjU_PWk7ijlPezEc1wtiTaXaXBvL2FT-g&oe=6A2EB7E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3nudOiRvF0Q7kNvwHo3Gkg&_nc_oc=AdoRKcUKYclcQxFMy7itCYY7_tc-m_cOA-FLRxT3DEIfI61e8J12KtZnzyByHKiUAM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W9W33ZbwYX_H0luwGE0Cu1VEWJoc6W2iXjO0fqOBtMw&oe=6A2EC03C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YvxqKQIAYYQ7kNvwHBZn1K&_nc_oc=Adqzb_USo5LIQ6L6E5yaz1Y6SKDZ9AuodlSyrIs-xdNbIIoVClWNGaPAJKcozsGpx8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7JJaLU_ANK9D5BD-O2TgbE-cjsNZMHSK2Y1PYUch4Og&oe=6A2EAFA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS_GdhIZPpYQ7kNvwFGJAQb&_nc_oc=AdpgLurzNilQ9ZsqA9MK5JNsJCzRW8EfDCCIWggjZ8NQfNxsa5bfJuaYownVaPwBzw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eUl_6WdiG-XSlNTjEOZCEMkwPvuf0-E4Am6tkmi9Llg&oe=6A2ECC40"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
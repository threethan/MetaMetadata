ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am1YyCg3adMQ7kNvwE96Yy1&_nc_oc=Adptgx2mI2uHj_oQJ9g1XDZaadu82DyX3q90nbSwvLAKzCb_C9ajL-O0hRwEyTB30UI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP4F16FnaUQbweeMAi2Y_MFQ3tKWdrdaxAXcmkciGcug&oe=6A638463"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlX6nNzEOq4Q7kNvwF7kRbm&_nc_oc=Ado9J-7R9qHc99TetyFyxaxEIcxD-Ut6m8l5ZO9L--kdWn2AqIBWVP3r5ci43TeIhjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZTZbpXLjvebrEJKY0xIELAwDjmdcTDEDIsJ5W11YCdg&oe=6A6373E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pYVnKx1I9QQ7kNvwHciGkO&_nc_oc=AdqNG1gr78l3Lzjj_vg4UpqFWJzsr-bnYbKvqq5kTQFahj_q3lPZi0PCySowaYpkVew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjnZi_Qg_mJtwAr5PuAfwkp-koM__ClYTLC0lSWCCwlg&oe=6A637C3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmCzPZuyA6YQ7kNvwFuhv8z&_nc_oc=AdoGnzHQuStwU2PpGRIpnk1Bwv1NRBht3yrHr54JuF8gJFZNJz6_7RM3Un4txEwoPGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUjN-FhL9Ov23uK6uIX6gAbQAWqIzZfyHVYTqZjslSGw&oe=6A636BA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA7EUSOeYfMQ7kNvwHaErbR&_nc_oc=AdpnTsDlo9DJ0rCLvZBcGDT4Kbm3Et_UrfwmvSCPjSFucVoca85_7QUWPaF7GE0OB2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAByKRUO0wDS15g0TTqzzcN__Nna4Nt-Mw6gEQl6_YeMQ&oe=6A635000"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
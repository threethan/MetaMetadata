ng", "id": "1158084358857990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_RJDpEPfg0Q7kNvwE4jtw0&_nc_oc=AdprgAXkCGBE3Y2zJMpJ0ZagohTYhtlP7imu20WjPz8uj-IiVcdelM5tyBO02TCBPQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIkLYrqh7O_wzFKF7mk7J0t_sNoxPwfbaintpslr1YqA&oe=6A689223"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iLv_zwbz38Q7kNvwGB7PqH&_nc_oc=AdqOlShCEMwrvd8yKBEV3gbude3Q0a7iVClYXfFPvkjgiQ3cknH4oaR2-WEpwPzQT5o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2K1xno-4wXsY2kK0O7UjCE3K86NZVRF8uaq6Scz6AZw&oe=6A68B9E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yC4iWwPuB4Q7kNvwGjyZ5V&_nc_oc=AdoQUZZxJKynDmtTIv9tF7IftO5FAbMmd8iQMw2knHyRoPfk2QXjsf_yguQOoYvfwsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsGeB855qwQx-PQQaoAVOO3Ns7j6DSWaYpKcfFEWRbvw&oe=6A68C23C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd5ypOULIBwQ7kNvwHRGVWp&_nc_oc=AdrtmllYsjBDE7pcaSNeUuZU32SPhlIkVvPP9nLdMOQneOIUeSXqKwF5nS-EGfDg3ZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjkqRHV_pHUTSdK-bFuW6y4a6pb9g-mWCDVPzhUNNL9Q&oe=6A68B1A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHtPm7pzMoIQ7kNvwHNoiym&_nc_oc=AdrXmurgCXBebVpkLU-P8xhGpLabtXBMxkXXoehPzl0UvHT2ucuxVFlqXxWTfjPoElw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7bVl3yJlIQRsFwZa6Lg9DwIg7sHn5Z9ZzUE7PS0wksQ&oe=6A689600"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYFAGIuDhpUQ7kNvwEUuTYW&_nc_oc=AdouoARhQ_8NGoUFz6sSF3oAi34AK1Q2HKW_c5O3F7yrQUERLsgDvG-8dGfdimYDu50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oxxAMWfVrE9tD9HzWezGLTnU2YHF7V3vJ4BrzqNfPvQ&oe=6A049863"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUq8IcNs7qIQ7kNvwEPrqia&_nc_oc=Adr9g3pECd4rqJ5Z7dGOWJN8fHY9xcwX1RVVicFeqh4E8MZ9bZqe9zc5OteSda8WvdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DJ_KThGrw9lyj8syw_TJQnFUouNxcz_Gt1XuKZW_lTg&oe=6A0487E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3DuhyYyxq4Q7kNvwHJ7Zlp&_nc_oc=AdqtRNdpgA5sB0Ea3J3ONg-QoPxYTzcBs7rLq2x1o3WCTLj1MEPWolGa89pFpcqBVNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eDXPDyiNN5Iuu3B-hwlqZvAv2bapArD1806L1_EbPQA&oe=6A04903C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA-s5rKYbCgQ7kNvwFLyI11&_nc_oc=AdrRnG_x8qKQ5NLdnRO-bbZBaeav2V9pq-V16u-nLGxh9Jy6TsyZbUfODuRlYbCLKSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Yr8ibDW-0nM4fcK7QMtBy9OK4-LRWdTVJfNMCXgwWRA&oe=6A047FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaxsleJUbzMQ7kNvwEP-_hN&_nc_oc=AdqTRFbu-coSnwDUoWOSFnUDizPbjzIO1kN7bqGm9bQ_IJo--xpVzeBlW55b7GM3pl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cw8hFDOW4_Ouvcsp9s9abSXJzn534U0OLRxUJgurRgA&oe=6A046400"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
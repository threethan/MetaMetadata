ng", "id": "1158084358857990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_LOoVYxEw4Q7kNvwFKW4f2&_nc_oc=AdqeVzAA8AWXabpg347uAtc0w9-DG7KXCXtUooqiAYWe34Hea78pWsf35TySEz6Y3NQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQDxm0bgXAubs_Mt9fiO6gU273qDW1S0QtxeBsRAl7tw&oe=6AAFFB63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K28Lg3Y5yF8Q7kNvwEg0GGx&_nc_oc=AdqA7l7inDvIJxDGecxDYckeXmLu22LGSwXoW0nZAkTG4254XTj504r4jckaOhLblJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFdIgGKvxOA-XBPypJR7shKKhYHOB8G0vHSeSx8F46mQ&oe=6AAFEAE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPCrNe-IRSIQ7kNvwFsGryX&_nc_oc=Adqd4ari2pJAdI4KqXc9iJw6nWnDyWbEkw8x06Kk_R6wWQTP623IloeMgR_AUvEta2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP2pC0t6HxXxy25VVIhfXMjN1sNe-Gd0O-U2K8nha5KA&oe=6AAFF33C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUY98tBPsLcQ7kNvwH5o9f5&_nc_oc=AdpgJv-S8wH72VxdzVn3gMWFa6EqZ1IepecZcfk67WPPXp99PaxJUTzekelBbN5Y2YE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG-aHkCQhzCvkTA9cTYaL-p-Iv-4YYQJu_zCVdBM1VWg&oe=6AAFE2A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaVFPLVFNUkQ7kNvwEfboGb&_nc_oc=AdpjHsaG6t4aBt9RFEl573BPrdoMs9zGpMXDavkX7uS8rO65qxUt9t9ZT2h38eNL2JU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8ckjwL1mjBP_BB_cwbRj6p9ROyd2YycdGccugA7tZVQ&oe=6AAFFF40"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
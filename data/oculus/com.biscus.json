ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHxOsOCuOcoQ7kNvwE_FqNr&_nc_oc=AdocR4q8O2QGFGyY9akioMfZFcGkhlSZVQy9_DL_ESrYv4TZ6Q7Kk9kkdQml3lpkX14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzwr7D-oXasELU0RSNjHEDeoAeu60m0DVTVYQueqGWgzQ&oe=69CD0123"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Yoi4niliUMQ7kNvwGEP625&_nc_oc=AdqjKuPcxDGLB5mfdB2Ly0dB9_weYi4QsUarZk3Tx7NNkffkh_qEdlXMcf3IMwp3p4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDyY71PctgWYurQp51QweeqyyBNhNgIiI-WHeDOYtjYQ&oe=69CD28E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSlc0RpfEaYQ7kNvwH9SN2q&_nc_oc=AdoZ0JoUU-JPi92KSuIndvwrTAI-s6ACHmKgTUiVjLIlisQeMD11XaF7kq5-eGZs7AQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw21V1ObLbncBJHP5xBhukRGxFTfci46zVO1yRfPOCl0g&oe=69CD313C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxTRnLD1o0wQ7kNvwF3nysJ&_nc_oc=AdoJ6ry4nh9Mf2AOtJvFOFOnkWK6Qx7ep_tWM3wq3avyhM3qtYLBDcI64ilfTuXOHUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyt_EmJoFvrXbFmczheVfYIhT3RoGfhCK3io_T-gDFDOw&oe=69CD20A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02S-G7eQBxAQ7kNvwGTj4a-&_nc_oc=AdoIHX8seCuFKUwitpJv7UvLTUw8klPH1KOFnPZhVAiikFM4VKlAYdwqoWQ5QqjPLf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXiiLPFO5lj5q8iN4EU6gom8_oZCnhJAVukq-nKZnV7w&oe=69CD0500"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
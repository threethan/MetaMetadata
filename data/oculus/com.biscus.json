ng", "id": "1158084358857990", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLBqugHRQ7sQ7kNvwFl7tY1&_nc_oc=AdqP65wTgYANuHXUsQa1dBFUb_mPO3HdqcsproeQdFD7T-zfjA6-o_WircEePIr3mWo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pmBk8txbHuAX-WTZzZpwGD5GRLqPzgfPJs_rv_zt4MA&oe=6A09DE63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F64WBD3S7GwQ7kNvwGS5Lqh&_nc_oc=AdqgeWbrGZ03MOizO2s9YZZPv-WUErCgaCl0wyn0Jx05RqH72wZ8rBuUiFy89R1sTLk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6abYaxZvwggjgEiSaruOte7KVflqG3N_XoAA86fxQ5Nw&oe=6A09CDE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrbyFB9-IF8Q7kNvwEoCnxm&_nc_oc=AdoiQh8a2BgbRmSZohxzGtnTa0qXWycHkd7LMfYvWN8hh15o2wsrgweUMV3U65iud34&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZkZ3cqj2v_ZO9I-7PKPFfeEI8ChYTbUPTBCHYbPhf3A&oe=6A09D63C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngsZBOt1yNoQ7kNvwFUeqUw&_nc_oc=AdpZsJMjeKmIwtucvlMRaVf1wE9nKkvi9fF7M0q2PGIyEDnzgBMrIZX_A-44G6qlGmQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rtaA8BPmF3ICCknLhEc8TxpEPsbXR6dSHKssqNgZdSg&oe=6A09C5A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sELX4vrtPXUQ7kNvwHDYmDh&_nc_oc=AdrttyhL4OYqA-14QZS1GyJqs2ci00szftw9IiKONhU1jz4FGxGGfI_zaiREHle3seg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xgURIGV-W_jORM_JJCukk-7QcfVYB-97a1RUqH8ULqQ&oe=6A09E240"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
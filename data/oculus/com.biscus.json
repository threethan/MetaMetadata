ng", "id": "1158084358857990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuOqS3BbyUsQ7kNvwEfXBuR&_nc_oc=Adp-z-heZEOZwV5DoRbtv2zWhqFA0njooO9f166khvMMZ7PVfL8TCaLUJ6wr2q9umZQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24B-cFNDbBrg_HH_Ux0IYPdl4u7nZVjD9qtKn97MZGgw&oe=69F4C663"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtlQ5UVigUsQ7kNvwHLskJX&_nc_oc=AdoGbX7_BP50-11qy3eFTnePTZGEe06_7J696PMJpQ6xLj7inLlfmRpaKcXhOvNQKMc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af062hTJnnMQSjpz3IhM8wG1fPGV1oFcEX5kJkI2PzjK7Q&oe=69F4B5E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNmDDeZ9_qoQ7kNvwGhPuTR&_nc_oc=AdoV8sRtMVxt8XHwdVGA3FOEjax3WIlyerUeSn5WroHlZq20y3jUNlVY7PVGzaVbJq8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Q6MEzbXjZLH9NKLqnMGQsQY4AS6SmlZW7eoVPviThzw&oe=69F4BE3C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcvmCepwNHQQ7kNvwGH4hzz&_nc_oc=Adr7TLdJA2w-jjm9T0wkMIHyUfOEQEEg2oNWPRvrfB95u_KsDks1KzbxIJuqlzN5AUc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32ePNAgLFsXb47hi6rUaX8glAfRWlO_X2ggeNZxM5vfg&oe=69F4ADA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRESJHEUhSMQ7kNvwGiA-b5&_nc_oc=Adp05oLYG2kYBeSKsrN1DyD-LneNo2ORck0OTV90KbTXhnOhGmCk39p-Wg5Nrs3jvNw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3p0ZF-oF_5d4PPR6SyXCb6ihU7EZ8QyDyEEPitfkD8Ew&oe=69F49200"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
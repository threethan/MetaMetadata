ng", "id": "1158084358857990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmaSBetc6NgQ7kNvwFQoStL&_nc_oc=AdpA8IdsYwO2IDx7B1e7fyLa4ecTklbfbIjFrgHsgMr08s5PW0WoDnj-QgJ0Ig1lSZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B0sS9GpTPXu67KapX2Y2IIN6iBvgmhlhE1ZZ40jxLDQ&oe=69FCAF63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iwlg4W7lSMQ7kNvwFWlPvZ&_nc_oc=AdoYKeG91fMgn98tRMbgpSlNJWfKMEQpEgKZsXkQ8vmLaig1C3oiym0nQHKgfkuZGBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60inQ_6CCDOZ-l0nGswOEVSgYtmrF_yVZmWuN6FQB_CA&oe=69FC9EE4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-b4nPSEUg2EQ7kNvwHqzzor&_nc_oc=AdoqKL-OG1v54NFNqeV1AsiJYSfU5M7Jr9sNSAMduMthVSdTGhKKQMUSeKXAr-rHa1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X-5rYXAZuaSq_0bor5bbByDWOlEc7i-CJFrP_XnHs0Q&oe=69FCA73C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2ZK3xSRTowQ7kNvwHJQ1pb&_nc_oc=AdqIqSAbEH3GhaodCZ8Ai-UNSrP4ENG8dYkWz6V6ztZacZa2ORgwtja8TOs4H9LpZjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fLsXiwSr_n1yBXcbRFpjNYP-gDH9Krd6U859XU3L3-w&oe=69FC96A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbWAVnWpiDQQ7kNvwEsoqtQ&_nc_oc=Adq5KnB0XWy0DDrbFXxq25Ob5G5GXVhkt81VK1lxOYE4XRaos6Hx-3o8T7QreqXj1Cg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eKuwKy3I0t4Y3VMG4qlhATXSDsKinEHuqz2AyCSZ_9g&oe=69FCB340"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
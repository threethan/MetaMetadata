ng", "id": "1158084358857990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5qZV2Ae5EkQ7kNvwGl_9fJ&_nc_oc=AdqpmWDadvb1IUwZ-YYSclhzcSGpPEJFh42-Wj7HEK78bt23x3irOBcIwYhXFgHMUKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Uz7RsRU2rkU0reT8LsCIS_AuUeUEdM_N3YZb9Oo-gug&oe=6A3E9A63"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciUJVD92tl4Q7kNvwH4kMAo&_nc_oc=Adr_fSjyvWykmc9LxPANnzyt1iM5ho4-9cf5ItPS6IciBGnInHPtOLcbbzOYvIf_g1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m4QUvQLxf8gj0bSTVzqCJn2FyvZEOEzZO-mqoQ_GVYA&oe=6A3E89E4"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J5hkEch3PAQ7kNvwE-aFl9&_nc_oc=Adq7eKu9Fv5IR4Qg5fdTGhxnomLTO9b-r9Kp34ibLDM6u3qL8-2CXLmCIxAIoQqZRzg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rsbvN-8pGa7Bkz7rHHwhgzB6zY-wzKMKHk-3EWGzkAw&oe=6A3E923C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHOTM4PmVRgQ7kNvwHoV2jQ&_nc_oc=Adpn79ICMGAJveWAh4KVx2yEJfO50opcB-DhTwzEYibnWTB8NjZWZvVImqfx4gmlq4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lu0BkIButvWJ9HvVxvSA72KMtama5Jkt0JrM39Sq0Wg&oe=6A3E81A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQn_woM_XmIQ7kNvwHYwCSz&_nc_oc=AdpOp_KKmS5xOg7dxblv4wSAn9pzE_YueDqRyQT1vVlozooYy37cRWY5SSlj-DHomic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_py_a0dDZtQTtByXOLINVAGaU1g50PI6n5gckov2oHQw&oe=6A3E9E40"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
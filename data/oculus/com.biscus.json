ng", "id": "1158084358857990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwl-7Qxf87gQ7kNvwGfplJn&_nc_oc=AdrKVfmtlof0mMAehXdGMsXX4CB2BKva8OSWB4FtVLsMzH3IdpRx0SG54OZecd8o4hw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgPvOEXcgitbswgTBYzQj5DE9j-hZycjT8AfY6HzB-Yg&oe=6A8987A3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfAQxo1sucUQ7kNvwFJO45V&_nc_oc=AdpAfnpMa7KtL-FBAj0jEwjfkyHnmuNKBCgJ527QaUFWMfD0gjs2YH_g0SHDiZF1Bsc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6oU0ARwoNZILbzuMtsiu1I0RCnTN33gMXb8woyzHelA&oe=6A897724"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1tfIycqak8Q7kNvwEzIa0p&_nc_oc=AdqIrlTGtPTaqopOFBLNdZsBUeQlGbzu38ZT6czKj17VGQ_qEaY0_1E4Qs6t6nyEkZ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPnlO6RIoTrEroS_jbecOLcFh0-mQT0kVGwiQ8E5ZBbw&oe=6A897F7C"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWd0j1fbz9wQ7kNvwH_KcbH&_nc_oc=Adqm3k8OZs7FKe8m_jxuFAmbXzImGrjVLO3Nd2InzZU2wJ1jGp9k5PrNdItz6XaLWEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyUJYPjQe6C14bzKcqXk7o0GBbJhFGVTugomZ3Cs0xIg&oe=6A896EE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odMqq-hOH_0Q7kNvwFclhjT&_nc_oc=Ado3jWXqjzZsZ983ARbnH7LnIYiQkMcFsprG5Mct5hzunW7wWFzIXX3alSq1pWaQY5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGArZSjgHrCm27t9jeRNBuytx6r08qTpjbdzFcK5vnu1Q&oe=6A898B80"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
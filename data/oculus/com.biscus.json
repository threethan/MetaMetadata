ng", "id": "1158084358857990", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5qZV2Ae5EkQ7kNvwFT1zJO&_nc_oc=AdoXFoxUTw77P7SMZ_O6GA_CEE49Ns8bWZSsHPK7lJz4coIQgE51Nb3qMFwBGDBUxXc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XPNGgpCzcOueL6t2AOyYSzMVK-fbVScgmu3Pt5OuBgQ&oe=6A3D48E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlQr_lOmcIgQ7kNvwHRUr75&_nc_oc=AdqqP_gdyIlL2fGWvuyU-RcKjYwp2-Hz-Ss5HFuNtGteK74x59Y_qisRyc8DsCYMucI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af868Ezbcru9iCE9vLTfz9PA0-n-fwoeoRKKRZ93JfUKuw&oe=6A3D3864"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J5hkEch3PAQ7kNvwFoSUwM&_nc_oc=AdpoJAxIjEQtE4PT63i9CZQ9c3xo4aYq5HhUVj41sId8k8gjbqbMUWTlxOamvc2pn7s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b4idrAaplfJrU1bERgwmFVMxBKufEnK3X9H1afsncpA&oe=6A3D40BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw4z2of-oEkQ7kNvwEKPRuA&_nc_oc=AdrNMV6W5hkGFx4THw3xIN-pKoaILjjOVdbzEx_ejwigfrdF8-wUHlsqMYb0Q3wtERI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jf59c7x5hf9EIrFFhFmogMyu4_cKTDuo2Ia9Eh8ldvw&oe=6A3D3022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQn_woM_XmIQ7kNvwFzCNZA&_nc_oc=AdqP7IZT5G-g1hMmvUwMvYHvMyVDfRkV2OsSxZIwJpgCkde8VDsu1aTDzZVRtBRjMpk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gaf0sFcFitI6RF7BKaVAxbb4Lw7oFEdxS8pWeUNu3oQ&oe=6A3D4CC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
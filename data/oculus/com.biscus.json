ng", "id": "1158084358857990", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86615894_1158084362191323_792602695697850475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUPYhIlgG-gQ7kNvwGFS1GD&_nc_oc=Ado9RPHgRbnhA_QmnGL_EDVzCb4niyD1cVY3MMzAvI3Tn9rDNuUSDNTnlsuFJKsLnkc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YYMOuLTqQEUO2ZCztYPKA2ZWYM6y88tV7TL3f7pcEWw&oe=6A1318E3"}, {"file_name": "Carnival_optimized.png", "id": "498621049356698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982563_498621052690031_6365866925104535639_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71-GyEI_TmQQ7kNvwF2lxDR&_nc_oc=Adq3KqhvRAVbC23qX42veP29f9kUJ9lKpxvQl5rvNHersYhSLmH47LvOmC-bpjHA9iM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44jcq9UbzM0KeSyy0vbPUxWkZ57HmkDsbZj_McgU8RdQ&oe=6A130864"}, {"file_name": "Forest_optimized.png", "id": "1000447408102766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031391_1000447411436099_5331248526557978676_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9bEFKd51BcQ7kNvwFJrR1D&_nc_oc=AdoXSgGzZrpV2bjWy8cUqnnH6ffDo75x4I_L_TUjmkrMYReU74OfkgbDR5t7koSDNN4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_QSywvVO49rrywe_6tQbsc0aiOSFL--VnfYWZg3vb9Q&oe=6A1310BC"}, {"file_name": "Hide__Seek_optimized.png", "id": "819139260311698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196218_819139263645031_4824084042172444226_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGbMomLCOT8Q7kNvwEaPHBT&_nc_oc=AdqqAnma8U2wrUZHK87oq7djxSnUWl58pPEtdLADJ5v5ihza8J73EkMLpgro0WrNHb0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FRRPvJlxrE9oE9PQqGBOZfMnAoktKt6Jk1XYdNZiVdg&oe=6A130022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BISCUS_BANNER_4_optimized_1_optimized.png", "id": "1475700723152962", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031326_1475700726486295_8979946353592351396_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1g5qXY0ReAQ7kNvwGswIbM&_nc_oc=Adp4CnfwbOSVjB7GkZMItG-vyA5Xta1RrZM4G9EuQ0S0F6ZZnE_G6B1dMbYmJ9MLmO8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SXlyHLmh-t7jjAmVMnZZIuaRAogbpCYmWxSpMKg-C6w&oe=6A131CC0"}, "display_name": "Biscus VR", "keywords": [], "long_description": "Welcome to Biscus Vr, where you can explore and enjoy a diverse range of game modes, each offering a unique challenge and excitement. Dive into the mysterious world of Murder Mystery, where every player could be a friend or a foe. Survive the Infection outbreak by either spreading the contagion or evading the infected. Relive the classic fun of Freeze Tag with a modern twist.\n\nFor those who dare, face your fears in the spine-chilling Horror mode. Test your agility and reflexes in Color Switch, where quick thinking is the key to victory. Finally, experience the explosive excitement of Bomb Tag, where you must avoid being caught with the ticking time bomb.\n\nMaster a variety of unique abilities and strategies to dominate each game mode. We hope you enjoy the endless fun and challenges that await you. Dive in and start playing now!\n\n", "short_description": "Welcome to Biscus Vr, where you can explore different game modes and master a variety of unique abilities. We hope you enjoy the exciting challenges and endless fun that await you. Dive in and start playing now!\n\n"}]}, "developer_name": "Crispyo", "developer_privacy_policy_url": "https://sites.google.com/view/biscusvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Crispyo", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCynIU49ZUvQmV1pwWAtQkgw", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
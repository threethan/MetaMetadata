25/499618274_827465990344449_7262647713480484115_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CKriFGVVjMQ7kNvwHO0iuY&_nc_oc=Adpgstnk0kgTmtct4yzedtKpXXsA_hQxX5S85e7CmlqL5pTA5wAjW01jYpmJvkdPxBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxQhbfklRFYeqeNss8Vila4a59IuTqdKKQm--t694GGg&oe=6A677BE6"}]}, "id": "1684366266070231", "locale": "en_US", "screenshots": [{"file_name": "img_screenshot_01.png", "id": "1812229842808569", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619588_1812229846141902_1976801242271187951_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tsFRbXfLgoQ7kNvwGcAq_z&_nc_oc=AdqZxx8ycddpyvKUR9QQ47lSpf-prGWkktV6_Sy5ObvJLrxKrN5IxEB0k0Ef5VwmDKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWKGZYEyaQoHEk5Up19s1PoMkOCxLbxX0cLQH1GRCXCQ&oe=6A675661"}, {"file_name": "img_screenshot_02.png", "id": "895940096629103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_895940103295769_1658391484068258696_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0Dh4hG5ueEQ7kNvwHCVf93&_nc_oc=Adok4C7xTmM5B3d33mNe5uKhH9aiPKCWzBKyeFveZIsEc3eWRZAPtXz_lpaG8oaALpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0ySs0PKMyTOUi0Sd-I0G6c4SU_bCW9hwzIDzjIE-Byw&oe=6A67761B"}, {"file_name": "img_screenshot_03.png", "id": "2523835601352452", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_2523835604685785_2375138238330518246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tzblNApEAUQ7kNvwHbbXDe&_nc_oc=Adoo7uh4ULrYIbRC8bwRsu2CVueHe3JESFlNON385086Hxf86375WaOK2sMm7u3fcHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDapdtKu5ZVIHnWHKiRh698upcanGVGQ8eT2_2S5ZI_Zw&oe=6A674B9D"}, {"file_name": "img_screenshot_04.png", "id": "1595300188041528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1595300191374861_5446415045580560071_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvImicunP84Q7kNvwErIxnr&_nc_oc=AdoHV6zecSRdw3q1io3OL6b_JNsKSbALAX8vmAoG2Diq4edgIqbEEoLU-joaMNEJqJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaS0ketdtornrQjSPoh9OjPG6n6294JX7W5KxNZNEYkQ&oe=6A676B66"}, {"file_name": "img_screenshot_05.png", "id": "1418706002969197", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303746_1418706006302530_3691583931273520682_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlQ56nt2RfIQ7kNvwFVHkJf&_nc_oc=Adpoa5r7Zefv9PN8_xf9z-NBv6jbarY3ql-8ouUYgnrE7D5cpHte-l8TpIVvpliLFN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg08ftAVo61MNXMrJLE9FdbvdqpSjn4WFwzEoHo4sRTg&oe=6A675135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img_cover.png", "id": "1421802638879207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_1421802642212540_5752776247324159875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K95RmntZCKIQ7kNvwEnalo2&_nc_oc=AdpiPmjFgMfBv2Xb9lFp7CUT5KAeSgZYkEjqiPCzSYnL8SI-1jPwdWYnVAjCDQA-9eo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYqR6p74QGmXAhF5USbZyxdT3pQNOkdFnJUZeQk734Xg&oe=6A67536B"}, "display_name": "Flip & Bake", "keywords": ["Cooking", "simulation", "food", "arcade", "casual"], "long_description": "Now\u2014flip it!\nMiss the timing, and your bungeoppang is ruined.\n\nFlip & Bake is a fast-paced VR cooking game inspired by Korea\u2019s iconic street snack, bungeoppang.\nThis isn\u2019t about recipes\u2014it\u2019s about timing, rhythm, and quick decisions.\n\nPour batter onto the hot mold,\nsqueeze in your favorite filling from above,\ncover it with more batter, then\u2014\nflip the mold at the exact right moment.\n\n\u23f1\ufe0f Timing Is Everything\n\nEach bungeoppang must be flipped twice to cook properly\n\nFlip too early, and it\u2019s undercooked\n\nFlip too late, and it burns\n\nWhen steam rises from the mold, it\u2019s your signal to act\n\n\ud83d\udd25 Manage Up to 10 Molds at Once\n\nMultiple molds cook simultaneously\n\nDecide which one to flip first\u2014every second counts\n\nYour hands are busy, and your focus matters\n\n\ud83c\udf61 Different Fillings, Different Scores\n\nChoose from a variety of fillings\n\nCooking results affect your score\n\nPerfectly cooked bungeoppang earns bonus points\n\n\ud83c\udfc6 Beat Your Best\n\nCheck your score at the end of each run\n\nCompare with your personal best and the leaderboard\n\nOne more round is never enough\n\nFlip & Bake is easy to pick up, but hard to master.\nWith simple controls and short sessions, it\u2019s perfect for quick play\u2014\nyet finding the perfect flip timing will keep you coming back.\n\nGet ready.\nFlip at the right moment\u2014and bake it perfectly.", "short_description": "Now\u2014flip it!\nMiss the timing, and your bungeoppang is ruined.\n\nFlip & Bake is a fast-paced VR cooking game where timing is everything.\nPour the batter, add your filling, close the mold, and flip at just the right moment.\nEach bungeoppang must be flipped twice\u2014too early or too late means failure.\n\nManage up to 10 molds at once, react fast, and chase the perfect flip.\nWhen steam rises, take it out!\nSimple to learn, hard to master, and endlessly replayable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1FTwMc3kkVu7t07afPvlWSnH8blP3XrMZ/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "studio chorok", "support_website_url": null, "website_url": "https://www.studiochorok.kr/#/work/flip-bake", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
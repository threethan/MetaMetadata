9FdbvdqpSjn4WFwzEoHo4sRTg&oe=6A675135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img_cover.png", "id": "1421802638879207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_1421802642212540_5752776247324159875_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K95RmntZCKIQ7kNvwEnalo2&_nc_oc=AdpiPmjFgMfBv2Xb9lFp7CUT5KAeSgZYkEjqiPCzSYnL8SI-1jPwdWYnVAjCDQA-9eo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYqR6p74QGmXAhF5USbZyxdT3pQNOkdFnJUZeQk734Xg&oe=6A67536B"}, "display_name": "Flip & Bake", "keywords": ["Cooking", "simulation", "food", "arcade", "casual"], "long_description": "Now\u2014flip it!\nMiss the timing, and your bungeoppang is ruined.\n\nFlip & Bake is a fast-paced VR cooking game inspired by Korea\u2019s iconic street snack, bungeoppang.\nThis isn\u2019t about recipes\u2014it\u2019s about timing, rhythm, and quick decisions.\n\nPour batter onto the hot mold,\nsqueeze in your favorite filling from above,\ncover it with more batter, then\u2014\nflip the mold at the exact right moment.\n\n\u23f1\ufe0f Timing Is Everything\n\nEach bungeoppang must be flipped twice to cook properly\n\nFlip too early, and it\u2019s undercooked\n\nFlip too late, and it burns\n\nWhen steam rises from the mold, it\u2019s your signal to act\n\n\ud83d\udd25 Manage Up to 10 Molds at Once\n\nMultiple molds cook simultaneously\n\nDecide which one to flip first\u2014every second counts\n\nYour hands are busy, and your focus matters\n\n\ud83c\udf61 Different Fillings, Different Scores\n\nChoose from a variety of fillings\n\nCooking results affect your score\n\nPerfectly cooked bungeoppang earns bonus points\n\n\ud83c\udfc6 Beat Your Best\n\nCheck your score at the end of each run\n\nCompare with your personal best and the leaderboard\n\nOne more round is never enough\n\nFlip & Bake is easy to pick up, but hard to master.\nWith simple controls and short sessions, it\u2019s perfect for quick play\u2014\nyet finding the perfect flip timing will keep you coming back.\n\nGet ready.\nFlip at the right moment\u2014and bake it perfectly.", "short_description": "Now\u2014flip it!\nMiss the timing, and your bungeoppang is ruined.\n\nFlip & Bake is a fast-paced VR cooking game where timing is everything.\nPour the batter, add your filling, close the mold, and flip at just the right moment.\nEach bungeoppang must be flipped twice\u2014too early or too late means failure.\n\nManage up to 10 molds at once, react fast, and chase the perfect flip.\nWhen steam rises, take it out!\nSimple to learn, hard to master, and endlessly replayable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1FTwMc3kkVu7t07afPvlWSnH8blP3XrMZ/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "studio chorok", "support_website_url": null, "website_url": "https://www.studiochorok.kr/#/work/flip-bake", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25796700626680106"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1997416027497549"}]}, "baseline_offer": {"id": "1997416027497549"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771470000, "status": "PUBLISHED", "id": "1997416027497549"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25641
g?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTV6VZoR4gcQ7kNvwEnOPXn&_nc_oc=AdqNo1o2SnsFprdgD9pJg4vZs8cNqI5vZSUIO17bxn5c20DAQaROyXfoqObGADCtwPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScq5CsvthRuz2LXQb6a-ZXjC-rax-Bz9UZPD1wrsZfOQ&oe=6AFDB169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "608207911669220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982527_608207918335886_5835777348865164697_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61OjPbrp-SgQ7kNvwEzIBP_&_nc_oc=Ado1mA9aQks4AL9m1ijh5kHzBTQ5y939Ie7jyqdgPoFdqrG4CG7KRYZwW1hRSZNsyjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI3iZ2iFxQ-Bwq5XJNmIufZH-tru3YQ0I6QCWO4FT48A&oe=6AFDB9D1"}, "display_name": "Blendora", "keywords": ["color", "gradient", "zen", "meditation", "harmony"], "long_description": "Step into a tranquil VR haven, where color, light, and gentle melodies guide you toward inner stillness. Immerse yourself in a meditative puzzle environment, carefully arranging subtle shades into seamless gradients. \n\nEach completed piece is a moment of quiet victory, a small step on your journey to focus, calm, and creativity.\n\n\u2013 Envelop yourself in a soothing, visually rich world, designed to help you unwind and reconnect with a sense of peace.\n\u2013 Hone your eye for detail as you learn to distinguish delicate tonal shifts, aligning each hue into its rightful place.\n\u2013 Take your time to assemble harmonious spectrums. There are no timers, no rush \u2013 just you, the colors, and the gentle hum of a mindful puzzle.\n\u2013 Allow the soft music and tranquil visuals to guide you into a meditative state. By the time you finish, you\u2019ll carry a part of that serenity with you.\n\nIn Blendora, find beauty in simplicity. Let each puzzle become a quiet moment of clarity, a reflection of harmony in a world of color.", "short_description": "Step into a tranquil VR haven, where color, light, and gentle melodies guide you toward inner stillness. Immerse yourself in a meditative puzzle environment, carefully arranging subtle shades into seamless gradients. \n\nEach completed piece is a moment of quiet victory, a small step on your journey to focus, calm, and creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blendora.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersive Bloom", "support_website_url": null, "website_url": "https://blendora.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28101793256102825"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "2418849918862030"}, {"status": "PUBLISHED", "id": "2086087371987438"}, {"status": "PUBLISHED", "id": "1451583159627307"}, {"status": "PUBLISHED", "id": "1693723552008898"}, {"status": "PUBLISHED", "id": "1767307777284724"}, {"status": "PUBLISHED", "id": "927968379561353"}, {"status": "PUBLISHED", "id": "4336780626557235"}, {"status": "PUBLISHED", "id": "903207142061717"}, {"status": "PUBLISHED", "id": "713478735014672"}, {"status": "PUBLISHED", "id": "24027090806975296"}, {"status": "PUBLISHED", "id": "1739213916691555"}, {"status": "PUBLISHED", "id": "1282894426260139"}, {"status": "PUBLISHED", "id": "1655123415043500"}]}, "baseline_offer": 
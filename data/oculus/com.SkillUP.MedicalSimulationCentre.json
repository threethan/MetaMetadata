LqOHNHy-xsTsxVLLr0XrdTuS74lHMaAXRGa5P85d7M7kQ7lMybQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBAAZOHyf1qDNsFKFQ72MHl1PtwF4r2h0iblCY3U0k9w&oe=6AC25754"}, {"file_name": "Screenshot5.png", "id": "204333212714992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982553_204333219381658_7265425808697674651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yMTgrQPsTkQ7kNvwHNQbtZ&_nc_oc=AdrK1SzJZ7gCdlgip8r_P4KbreeJfQdBWc5XyTHvfhMVvi6eBCWi4afbxa7Z7QcH_hE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw5tTu1xYpSzZ1Kt-Xozw-nGagvA9gRPbcw2BZuH2h2Q&oe=6AC27559"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skillup Medical Simulation Centre", "keywords": [], "long_description": "Skillup Medical Simulation Centre is clinically developed to deliver a dynamic and engaging learning experience.  Complete with scenario customizer, responsive patient, medical tools, drugs, images and adjustable patient vitals, all supported by hand-tracking, users are able to practice scenarios of different complexities, across disciplines and specialties.  \n\nYou are welcome to download and login using your business email address.  Once your email is verified, you will be given access to our trial version.  \n\nTo access Skillup Medical Simulation Centre and its full suite of features including multi-player access, Avatar Customizer, Scenario Customizer, Facilitator Station, and Learning Management System, please submit request via https://skillupvr.com/request-for-a-demo/.  For more information, please visit https://skillupvr.com/.  ", "short_description": "Skillup VR Medical Simulation Centre is a virtual facility designed to mimic the conventional simulation center, with the aim to provide easier access to on-demand medical simulations using fewer resources, for enhanced safety of healthcare procedures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "devel
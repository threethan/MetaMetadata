4stglA7vvUK_CFuCfY_LArUb-HM02rd6kId_O57c-dv0uouunVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPdqADZhrUp_wZJWzRMs6v0z6IUzMzuBaRjne7eeGggw&oe=6ABA6E54"}, {"file_name": "Screenshot5.png", "id": "204333212714992", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982553_204333219381658_7265425808697674651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d43cnCQLNAQ7kNvwHHjNzE&_nc_oc=AdpVnmMThDu1fvNomRcFQPv4O5BLwGyHOT67Ming6xV4YKTGWt5aFS8DolsBXWiG9FA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdZsWzikcn2OJHZwquCRHIR8cHkYvpUwCZ6W6Si_iVBQ&oe=6ABA8C59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skillup Medical Simulation Centre", "keywords": [], "long_description": "Skillup Medical Simulation Centre is clinically developed to deliver a dynamic and engaging learning experience.  Complete with scenario customizer, responsive patient, medical tools, drugs, images and adjustable patient vitals, all supported by hand-tracking, users are able to practice scenarios of different complexities, across disciplines and specialties.  \n\nYou are welcome to download and login using your business email address.  Once your email is verified, you will be given access to our trial version.  \n\nTo access Skillup Medical Simulation Centre and its full suite of features including multi-player access, Avatar Customizer, Scenario Customizer, Facilitator Station, and Learning Management System, please submit request via https://skillupvr.com/request-for-a-demo/.  For more information, please visit https://skillupvr.com/.  ", "short_description": "Skillup VR Medical Simulation Centre is a virtual facility designed to mimic the conventional simulation center, with the aim to provide easier access to on-demand medical simulations using fewer resources, for enhanced safety of healthcare procedures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "devel
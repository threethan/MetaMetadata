": "Screenshot4.png", "id": "6713938438724378", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974606_6713938442057711_7577163229189009914_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IZtZDszBkIQ7kNvwG0FLlF&_nc_oc=Ado7o_0SUUtVeUj8q_Dg0Qsv-CggIa0NoarpEUpqjcvlx3PIghPc5ix-XTCvlOT6Ss8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8NYadx7rIgSb4x8FcHyhumgsj0MusUBoqSnCbt6BunQ&oe=69C3E5D4"}, {"file_name": "Screenshot5.png", "id": "204333212714992", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982553_204333219381658_7265425808697674651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNhN_3RKPRYQ7kNvwEbxH2B&_nc_oc=AdoCRfjL5FGCG8kkZGaG3g2jeL4pvXnAZ6QdgC0h5hI1FFqafPGnMsCM0TDyEXuKXT4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKMqQMMOSe1zKesWy4iwcTRdhPf08qtoIaSGKVEU6FZA&oe=69C3CB99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skillup Medical Simulation Centre", "keywords": [], "long_description": "Skillup Medical Simulation Centre is clinically developed to deliver a dynamic and engaging learning experience.  Complete with scenario customizer, responsive patient, medical tools, drugs, images and adjustable patient vitals, all supported by hand-tracking, users are able to practice scenarios of different complexities, across disciplines and specialties.  \n\nYou are welcome to download and login using your business email address.  Once your email is verified, you will be given access to our trial version.  \n\nTo access Skillup Medical Simulation Centre and its full suite of features including multi-player access, Avatar Customizer, Scenario Customizer, Facilitator Station, and Learning Management System, please submit request via https://skillupvr.com/request-for-a-demo/.  For more information, please visit https://skillupvr.com/.  ", "short_description": "Skillup VR Medical Simulation Centre is a virtual facility designed to mimic the conventional simulation center, with the aim to provide easier access to on-demand medical simulations using fewer resources, for enhanced safety of healthcare procedures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillup AS", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25126258710306953"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1222823995796656"}]}, "baseline_offer": {"id": "1222823995796656"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1708045200, "status": "PUBLISHED", "id": "1222823995796656"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26818680087731465", "version": "1.08"}, "id": "2276909602520009", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25032400429692782", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26818680087731465"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 173614
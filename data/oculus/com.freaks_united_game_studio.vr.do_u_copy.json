w&_nc_oc=AdqIqWGOQpTp8-DetpTy42iPreAdp7-mTJphcrp7uVIT_MRzQSaaFgW1Cl9KdMMla5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwJFv79axBeLnyVypkdu_G0M64kSkMsnlw61fPU13V6Q&oe=6A898BAF"}, {"file_name": "zmafAH.png", "id": "3085744915027523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031609_3085744918360856_3016200792599918863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM5kuvPGcmgQ7kNvwFvwynl&_nc_oc=Adrq5qXLqp1uotOQKB6wvjclSUNvsFUnLphtYkiklQoyjhHyExnvDhXGMZ37e-GOkSA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJi00VogE4KCHm1ElgjlcJ-Laa5WnCjDixkvTmya04lQ&oe=6A8995C0"}, {"file_name": "VQf0y3.png", "id": "472612227517157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_472612230850490_4696346114427874729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCTmrwk2jBsQ7kNvwG4Yecb&_nc_oc=AdoRtYSXFqGqeJF58KcEzEdTmPQqOpOnxUkz3sKxHJHyGRD545OohFxr3rsGNZxIy7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhksFxFC4DDuAO6NaOWEG1J_ur-U_X8CkTbmznasUYEQ&oe=6A899409"}, {"file_name": "LAdPFz.png", "id": "608936177113037", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003274_608936180446370_2547137217207845549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9QFqv6lDZoQ7kNvwECD3Et&_nc_oc=AdptSkw-Kl1VF6iDxwef92NTpsJA-mSCXWgkMCpkzDXaq_oNPPVS3qRVyqUP1Lk_Q9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfVVT77PEx5Kpr38fc7OPkbEkQ0HidHqosZHnUGzh-wQ&oe=6A897D16"}, {"file_name": "z_KAtA.png", "id": "423619112667159", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031336_423619116000492_669497833435706016_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=D2fSEI3Mh1wQ7kNvwE3TzLD&_nc_oc=AdpkuB1G_SVLRgh_JAu2dTW-vOQ-PxJ-Tbmzt7cCKrr_Qq4VXiWvjVGUn3RiNYBQnjI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPZzThTWcr5BulzVJ8aFN21nSRHf8iL75Ehn3ryqI0vA&oe=6A898828"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Do U Copy? ", "keywords": [], "long_description": "There is no better feeling than earning money through hard work and perseverance\u2026 until you play Do U Copy? ! \u2028\u2028\n\"Do U Copy?\" is a VR co-op game for friends, family and couples who wants to put their communication skills to the test. \n\n\u2028\u2028In Do U Copy? Vol.1 : it\u2019s (not) payday-- play as the Thief and make your way through one of the (least) secured banks in the country. Avoid traps, guards and camera using your VR legs and the guidance of your \u00ab guy-in-the-chair \u00bb. \u2028\u2028\n\nOR\n\nPlay as the Hacker, become the eyes and ears of the operations through your phone, tablet or laptop! \u2028Using your (un)realistic skills, hack through the bank securities, guide your ally and solve engaging puzzles with unexpected turns!\u2028", "short_description": "Do U Copy? (DUC?) is an asymmetrical co-op party game.\u000b DUC? puts players in unique and immersive situations where communication is key to win! In the first volume :  It\u2019s (not) payday,  you\u2019ll be immersed in a \u00ab not-so-typical \u00bb bank heist. \u000b\u000bChoose to play as the Robber (VR) or the Hacker (PC/Mobile) and cooperate with your ally to get the prized money! \u000b\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fugamestudio.com/privacy-policy/", "developer_terms_of_service_url": "https://fugamestudio.com/terms-of-use/", "publisher_name": "Freaks United", "support_website_url": "https://bit.ly/joinDUC", "website_url": "https://www.fugamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "
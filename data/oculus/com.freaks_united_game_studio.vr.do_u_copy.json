5-1.oculuscdn.com/v/t64.5771-25/39031609_3085744918360856_3016200792599918863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYoMldokg2cQ7kNvwHNne30&_nc_oc=Adm3c--jPGA1I7XcTFeaJcnwAGLo6JoXvhm188Afm2N_GP-2546eWtb1D7ms-K7F5CE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvYv2NkQouk4-AGrLsnYPHtb0AMt57ksxvH5MdA0XEoGg&oe=699C47C0"}, {"file_name": "VQf0y3.png", "id": "472612227517157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001686_472612230850490_4696346114427874729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKv3lCnwM8gQ7kNvwHyFN9G&_nc_oc=Adnva3mRMrlX4ESqxHNYpOj0kTbIDi-vL1Eggr1woJWEzyBPqJTbKkufiq52kg9z850&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftOLYH1tglOPoSGxoC-r1WQIT-Cg6bq6pXz14TkUasYfw&oe=699C4609"}, {"file_name": "LAdPFz.png", "id": "608936177113037", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003274_608936180446370_2547137217207845549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYLn11u7WEIQ7kNvwEB_u3v&_nc_oc=AdkCKWEfptUIJ2dDUHpV3HETYESQV88NCHMduLGCvcqDRUNfAx_L_HZyFFwh55MEoYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftrp2dvNimbN4F01yhTP1_hYXjaTEvPkrRgxo1TV-ugGA&oe=699C6756"}, {"file_name": "z_KAtA.png", "id": "423619112667159", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031336_423619116000492_669497833435706016_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=KzuwL9TDCvsQ7kNvwGIiw4k&_nc_oc=AdnGsmhdiOGgV-gTSPGrp319ZLxDnIhs3WdLf9dXSVFWBf-C4-nB9jjpBT-kLm_lK4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftEqAxAfDs0em0IWRxXk-4ucVj_jz4_nEAqc0LLUHDEVA&oe=699C3A28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Do U Copy? ", "keywords": [], "long_description": "There is no better feeling than earning money through hard work and perseverance\u2026 until you play Do U Copy? ! \u2028\u2028\n\"Do U Copy?\" is a VR co-op game for friends, family and couples who wants to put their communication skills to the test. \n\n\u2028\u2028In Do U Copy? Vol.1 : it\u2019s (not) payday-- play as the Thief and make your way through one of the (least) secured banks in the country. Avoid traps, guards and camera using your VR legs and the guidance of your \u00ab guy-in-the-chair \u00bb. \u2028\u2028\n\nOR\n\nPlay as the Hacker, become the eyes and ears of the operations through your phone, tablet or laptop! \u2028Using your (un)realistic skills, hack through the bank securities, guide your ally and solve engaging puzzles with unexpected turns!\u2028", "short_description": "Do U Copy? (DUC?) is an asymmetrical co-op party game.\u000b DUC? puts players in unique and immersive situations where communication is key to win! In the first volume :  It\u2019s (not) payday,  you\u2019ll be immersed in a \u00ab not-so-typical \u00bb bank heist. \u000b\u000bChoose to play as the Robber (VR) or the Hacker (PC/Mobile) and cooperate with your ally to get the prized money! \u000b\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fugamestudio.com/privacy-policy/", "developer_terms_of_service_url": "https://fugamestudio.com/terms-of-use/", "publisher_name": "Freaks United", "support_website_url": "https://bit.ly/joinDUC", "website_url": "https://www.fugamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "507561620716382"}}]}, "
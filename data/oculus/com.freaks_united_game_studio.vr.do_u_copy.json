16200792599918863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK_e-Rl-zG8Q7kNvwFkUlPC&_nc_oc=AdqwgV1VHJw_q-2mSD6D01US8ZwUJoFYek_g7JXMBtx1j94nsQHj8YV6NXsxSrG1kFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnAnHwVDRD2DbqfJTf93nPifRHP6PzxptsfkvXOrdCvw&oe=6A7B1540"}, {"file_name": "VQf0y3.png", "id": "472612227517157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001686_472612230850490_4696346114427874729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2XeAaZNT0UQ7kNvwFw41jZ&_nc_oc=Adr_k-ZzjAdhv80zYXWpF2cYMpTg0JvATRiWF72w8X1v1FQcmSBdl7XJlLPbTxkVPlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGamgPCUxhA3L6hu-d64tquGG9XSjR6lhFbbLLM977D4A&oe=6A7B1389"}, {"file_name": "LAdPFz.png", "id": "608936177113037", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003274_608936180446370_2547137217207845549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYMnIpernDEQ7kNvwGvTwRk&_nc_oc=AdqxOmF3biRqjSoJRlUc6wrVVzglg4JJU77y9_CP4r5P2IBxyZzc_ngTgA4m9FvbEZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt-9GLGwvMjXnj0gPW1p1kxpSBiXnmh08PLZFoQIboFQ&oe=6A7B34D6"}, {"file_name": "z_KAtA.png", "id": "423619112667159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031336_423619116000492_669497833435706016_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=R_eJbGPQ4wEQ7kNvwHDqHpL&_nc_oc=Adr8koNq5fF1TjnnFXCPGc6GRdEwKScSD240sLP9MhGFarSk0-EusHPVLALLVwiXtTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUWVHQWgHXSTKTjqkCmeZw-cPKzZjpGXWjG8SV7KLOFw&oe=6A7B07A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Design_sans_titre_2.png", "id": "1600043687414236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/43931336_1600043690747569_1277764539156632875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGqS-dPhx88Q7kNvwFr1tRd&_nc_oc=AdoicLZds_fKcgB42GWcsyEAcxjfx7YJYlik8ePnwRUzxngfoCgBy3DJcKQNGIlSaNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOYY1PREtTdMApwbir52fWTNsKRQxV3X0LIelYiQpEQw&oe=6A7B355F"}, "display_name": "Do U Copy?", "keywords": [], "long_description": "****Do U Copy? requires a minimum of 2 players to be played.  Get the Hacker App at https://www.fugamestudio.com****\n\nGear up for Do U Copy?, not your average VR co-op game - it's a party in a headset! Ideal for friends who argue over pizza toppings, families who can't assemble IKEA furniture without a feud, and couples who think they've mastered the art of 'unspoken communication'.\n\nDo U Copy? is the perfect blend of chaos, strategy, and teamwork to put your communication skills to the test! \n\nPlay as the Thief and make your way through one of the (least) secured banks in the country. Avoid traps, guards and camera using your VR legs and the guidance of your \u00ab guy-in-the-chair \u00bb. \ufffd\ufffd\n\nOR\n\nPlay as the Hacker, become the eyes and ears of the operations through your phone, tablet or laptop! \ufffdUsing your (un)realistic skills, hack through the bank securities, guide your ally and solve engaging puzzles with unexpected turns!\ufffd\n\nTogether, you'll fumble, bumble, and stumble your way through the heist of the century. Will you pull off the ultimate heist or just end up virtually 'breaking' a window? \nDive into 'Do U Copy?' and find out! \n\nDo U Copy? requires a minimum of 2 players to be played.  Get the Hacker App at https://www.fugamestudio.com", "short_description": "Get ready for 'Do U Copy?', the ultimate VR co-op game for parties. Perfect for friends, families, and couples to test their communication and teamwork. In a world of high-stakes bank heists, one plays as the stealthy VR Thief, while the other assists as the savvy Hacker on PC/Mobile. Collaborate, strategize, and execute your plan to succeed. Dive into this thrilling adventure and see if you can pull off the ultimate heist together"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fugamestudio.com/privacy-policy/", "developer_terms_of_service_url": "https://fugamestudio.com/terms-of-use/", "publisher_name": "Freaks United", "support_website_url": "https://bit.ly/joinDUC", "website_url": "https://www.fugamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "273711578281991"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974677_146601564330685_4201001157765143634_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-pLwDGzbjUQ7kNvwEN1_nQ&_nc_oc=Adr-QYAYp_39ngnOXKy_jKfLNGrohxCoWed2R3NPL2W1EYaxvjsehxwejBWnvjpLCfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2rTCDxGOCl3GpYETVGVWGePS6LRZYZTJkCnuIHQRP-A&oe=6A7B2AD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Do U Copy?", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1648043100, "lastRevision": {"nodes": [{"id": "1902050903277215", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defa
aGb6U5w3GFi4XkpO73MN8-feEQ&oe=6AFF2095"}, {"file_name": "Game_Custom..._15.01.2025_20-33-05.png", "id": "1314110463041996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1314110466375329_2543471858544450639_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ7uQ7EzHjgQ7kNvwGtoiel&_nc_oc=Adq8U2yt_aexm_qkrudgoFO34dmHPDyEgFoTgmSYZywFrvoMvALWzNSIP07ub8qEq78&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdMqhFY75Y3KJYRHHXlQ1WLoaHwBC7N7ZPZlN7b9Y7kA&oe=6AFF0A2D"}, {"file_name": "Neues Projekt (13).png", "id": "527685596994285", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391836_527685600327618_8060557691410688476_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq1oeEH7nG4Q7kNvwHXhtEv&_nc_oc=Ado2ac6g3pfarqZU_EE1yosflIdrTyihllODPoGTqiiNq5rSmupwxXX6WXaCPXP6a4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOmnaO3YN7vF-J9bu3lCvxQFxpkYz7KZrZbJbt-OteYQ&oe=6AFF24E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarin Lava Escapists", "keywords": ["Fun", "Multiplayer", "Free", "Parkour", "Sports"], "long_description": "Tamarin Lava Escapists is an exciting VR game where you play as a tamarin trying to escape rising lava. The game uses gorilla-style locomotion, so you\u2019ll swing, climb, and leap your way through dangerous terrain.\n\nThe world is vibrant and full of challenges, from tricky jumps to intense multiplayer competitions. Every level keeps you on edge as the lava closes in. It\u2019s fast-paced, fun, and really tests your skills. If you\u2019re up for a challenge and love action-packed VR, this game is for you!", "short_description": "Tamarin Lava Escapists: Dive into a thrilling VR experience where you, as a nimble tamarin, must master gorilla-style locomotion to escape rising lava. Leap, swing, and climb your way to safety in this heart-pounding adventure!"}]}, "developer_name": null, "developer_priva
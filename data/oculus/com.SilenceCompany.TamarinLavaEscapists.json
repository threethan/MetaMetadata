tBh2eW-h3A8zQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8N0ITxDeOuCdb4llvZKNu-hhj_2QtSqTYvS7LVABMBA&oe=6AC659AD"}, {"file_name": "Neues Projekt (13).png", "id": "527685596994285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391836_527685600327618_8060557691410688476_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCEk61hRsbMQ7kNvwHiF4-7&_nc_oc=AdpGjztfpoPXV9eLe9vOCchoioSULl6PUBazvum1j1HRQbOqz6XhAH__uKJrIFuSrPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGcaRWR55JbTkSQd1jGIY2GG2iw8HonHhk52nNQdvLVg&oe=6AC67464"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarin Lava Escapists", "keywords": ["Fun", "Multiplayer", "Free", "Parkour", "Sports"], "long_description": "Tamarin Lava Escapists is an exciting VR game where you play as a tamarin trying to escape rising lava. The game uses gorilla-style locomotion, so you\u2019ll swing, climb, and leap your way through dangerous terrain.\n\nThe world is vibrant and full of challenges, from tricky jumps to intense multiplayer competitions. Every level keeps you on edge as the lava closes in. It\u2019s fast-paced, fun, and really tests your skills. If you\u2019re up for a challenge and love action-packed VR, this game is for you!", "short_description": "Tamarin Lava Escapists: Dive into a thrilling VR experience where you, as a nimble tamarin, must master gorilla-style locomotion to escape rising lava. Leap, swing, and climb your way to safety in this heart-pounding adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/18c5846f-c6d0-4d07-9179-324201d89f60", "developer_terms_of_service_url": null, "publisher_name": "Silence", "support_website_url": null, "website_url": "https://sites.google.com/view/tamarinescapists/start-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nssq9GTXNgoQ7kNvwFnHceZ&_nc_oc=AdmevuAC5vip_f8mtOUljTKf-63cqQIERTATiVpEfed6S0r1UOcCmDNYlF_F_I8kJho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYQ6axdZ1LUIQMj6lvIA9z3SSbctNpKGzlkFLfGhP07g&oe=69BC052F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE-ASnmjbMkQ7kNvwFL7EUF&_nc_oc=AdmhcSb6dJGkTN8GmgGgDimpu9jqjPif4v6xIop_Q_KlSJx1LXquLhiqtsxqcchqFYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx1cMEpsomSYztbXWf7pFqZDgTPhnqdNGByPAQdwUkooQ&oe=69BC0942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gz6KARTeUOIQ7kNvwG7gB22&_nc_oc=AdliD2_mD1pXBydzbzdI5pf2HijpdbNgHakoTrG3WffzNolGFU97dnq6McsIOfFxeJ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7plMt89fPQIrjtLmMdBWza3AAc2GIZQ5l0wJ-rONNHA&oe=69BBFE43"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
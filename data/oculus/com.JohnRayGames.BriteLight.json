998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPKlHggk2MoQ7kNvwGQaWtj&_nc_oc=AdmfQDcwxd1VijowJq3v-CE9svP-70SbG0d1dQhYbSJ9711GSrfljjou2LUxv1Eq_O4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw57i1PdN0w7HILmo0rWCFiZpJqGZujdH6zwbM7-oa72g&oe=69B41C2F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzafxZXaB8kQ7kNvwE31Loo&_nc_oc=Adm0WobKIS5IMSYWWmsuAFUFsp_1U9oa63cia9Aq5gLTWqcdNi4jUMuA6AR-4X97XWU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyq0OVarkkPyYrmH3eByn28p_GtpfYYBFDIFhuoZZGqPQ&oe=69B42042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkOY97YNV8UQ7kNvwGsgdJJ&_nc_oc=AdmhmEwVvmlMK_PrZGQCMoJrbum0LrnGTy0XYXx2zfez_Ulxmkhj-RqyGJc9oDg1po4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw5PNZMLqIqlzQqE5R4bEgOoUD0VTXU8qhC5oeRbLGbRg&oe=69B41543"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
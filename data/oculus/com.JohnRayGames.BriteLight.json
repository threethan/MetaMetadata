1F5"}, {"file_name": "32.png", "id": "1193495794886776", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031620_1193495798220109_5063966899875026043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BsP8L09CD8Q7kNvwF30peu&_nc_oc=AdobshdrY_o-5fghFmWFkMUJ1EYN8Qw1zuRtLF9sIUb5vp_vq3yFy0WSSKAaWTJtG-Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVEIpCvaW3D2D8YnteoViqXqIHI9k4e-eBRNGdpYfs7A&oe=6A8AD401"}, {"file_name": "5.png", "id": "1945118289165910", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kLasatKxNoQ7kNvwHYwmIt&_nc_oc=AdqpowR0mNdl1asT2rCSjj4P1SEJxaTumNBxy2LIKT-YFZyIaTGqQHjbpkl7XQOXGDk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0vWO0YMHljIflJyx1m7et9gFBMEAGDiGsXuIUxLgvyg&oe=6A8AC86F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZ7Z9Dv7JJcQ7kNvwHfF41a&_nc_oc=AdpS_RfGbO6RuymQBBhWcaxlgWCdOOAokNGcl2vrCQd-O3TqiEN5-_9ZXEIHuYzfEnU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJu8tKdQ_OP-Wep898act7KqXHywIJratW-tVq8BPwCA&oe=6A8ACC82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsCywSGXpWYQ7kNvwHWuxKZ&_nc_oc=AdqyIHC7wuzRvoKEYUQDcPdMoewQJ9hOo5dMhfkTDnvl6sEC33Pxuu_-gEGli_v-qBM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjA739ByqT1CV4JoJLd9kVQWOBrSa1EoNQJOTmS1HjyQ&oe=6A8AC183"}, "display_name": "Brite Light", "keywords": ["light", "zen", "puzzle", "art", "create"], "long_description": "Brite Light: A Tranquil Creation Experience\n\nEmbark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light.\n\nTap into nostalgia and unleash your creativity with Brite Light.\n\nIdeal for both artistic souls and those seeking relaxation, Brite Light is your personal oasis of creativity. Immerse yourself in a tranquil environment where inspiration flows freely.\n\nKey Features:\n\n\nEXPANSIVE CANVAS: Craft your masterpiece on a spacious, interactive canvas.\n\nINFINATE CREATIONS: Use the pegs and patterns to spark your imagination.\n\nAUTO-SAFE FUNCTIONALITY: Seamlessly save and build upon your creations at your own pace.\n\nINTERACTIVE ENVIRONMENT: Engage with various objects in a serene, virtual room setting.\n\nBrite Light offers the ultimate Zen-like experience, perfect for unwinding after a hectic day or letting your mind wander in a safe, relaxing environment.\n{519716874070859}", "short_description": "Embark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
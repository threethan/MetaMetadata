998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be0dwSn0smwQ7kNvwGrsTEa&_nc_oc=Adr_N8zBTGtGbuZJlKCsEhja5Iyw2b0C02nqfFO7IK5zj1GgbS8xsjN5Chk6YQ2KRc0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDc-1pX_aKVZD_k9C8D8eyamECaufAqS5cJJTarSTVyg&oe=69C14B2F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCCjFjbVTisQ7kNvwEroHug&_nc_oc=AdqzG1iU8mLXEcYVj6NUyrnpC4gbLyyl9dOzSJC4-F9jVPzOAPCMFSDOUTIXN27zekk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMl6O39K_i9RKSm4Sb_e5bFxNV-5CTXWFg7hjqICQjHw&oe=69C14F42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwjad7sMxHkQ7kNvwGC0l1H&_nc_oc=Adoqfx7P5LteOSXgDff5UVAuKY_U4j8EJLKocPdXLomIELe-WPFosmvpxa2Foxu6BdQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzlw2HTNGSeZEbHubO5lyuuYTT1pc2n3MQ8u8SpcgbtjQ&oe=69C14443"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
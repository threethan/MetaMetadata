E35"}, {"file_name": "32.png", "id": "1193495794886776", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031620_1193495798220109_5063966899875026043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjNqHE3L1mQQ7kNvwHh4CId&_nc_oc=AdrHVCYTKsrbTgaY5YgPCgU38aFTaeSYf5FKXN5aNWTq2Y-N8RizJKgpczF4Jv1qndY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rnyrYOfFRg1PXGT4M_d6HEifOe9_QCjTMRlkDVKgsQw&oe=6A2C2041"}, {"file_name": "5.png", "id": "1945118289165910", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj3sSB0WreMQ7kNvwEYno3j&_nc_oc=AdoROi5XTJ5Yf_cemIt0wFh9xapw78NS4TE2AOp0JdfPfSqZHv4jjQsYuCewk4z5PKA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BNOEqeRzE0cHdvl9s6wjrtuZTIcW_nBaLEMZ0Y2rdJQ&oe=6A2C14AF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2bIM0Y1qScQ7kNvwGZhrXb&_nc_oc=AdoWordn3PJM3Dnp8P34Xvh-idoC_V-MuVQrHgB8ZWKk6Ni4Fpc0BwNpgmv_vTQQDOE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gtt1jU-Ri9wQSRClv6cwmkFgKfh0fmPk5S-abVuniWg&oe=6A2C18C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xv3d-RMUWm8Q7kNvwE9rKsR&_nc_oc=Adp1RG3iol0woBYADYfq0rrdrrgktZ73X3SeGKQnmcEDbVwY8pM4c54xHnbnT-SUY3I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99Vu6ZsrE70EFe_QjX9qqSq98T5IPr8PU7verJeJ4cow&oe=6A2C0DC3"}, "display_name": "Brite Light", "keywords": ["light", "zen", "puzzle", "art", "create"], "long_description": "Brite Light: A Tranquil Creation Experience\n\nEmbark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light.\n\nTap into nostalgia and unleash your creativity with Brite Light.\n\nIdeal for both artistic souls and those seeking relaxation, Brite Light is your personal oasis of creativity. Immerse yourself in a tranquil environment where inspiration flows freely.\n\nKey Features:\n\n\nEXPANSIVE CANVAS: Craft your masterpiece on a spacious, interactive canvas.\n\nINFINATE CREATIONS: Use the pegs and patterns to spark your imagination.\n\nAUTO-SAFE FUNCTIONALITY: Seamlessly save and build upon your creations at your own pace.\n\nINTERACTIVE ENVIRONMENT: Engage with various objects in a serene, virtual room setting.\n\nBrite Light offers the ultimate Zen-like experience, perfect for unwinding after a hectic day or letting your mind wander in a safe, relaxing environment.\n{519716874070859}", "short_description": "Embark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
495798220109_5063966899875026043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCXvpIxEjt4Q7kNvwF0JaxG&_nc_oc=AdlONqqJM00QLkNRFXpBPgH4x3Xgi55yoKUSOUt9xEgRMVdxkkaN-CbTpAcv0dBTdtI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aful8D5t60MJr3HJJDxMjbx0VxtYihT0leLqQdRC17EZHQ&oe=69A02901"}, {"file_name": "5.png", "id": "1945118289165910", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H634MaWpo88Q7kNvwFVyrV2&_nc_oc=AdkN_fy27m5dUlQcQMskQ8pOYxF9rru_2SQ4N3vrXqM7JZMrKop-BG_qoDHRod4jjN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvjbsRXu7exp2K6fm5FoFXLVaXORUc50xBITYhgKfjl5g&oe=69A055AF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkpZvz0JXxEQ7kNvwE6naRY&_nc_oc=AdmVhFO7MAFp0X9HBqyZwxGchYpBYwy7VMlqOMIUdgR8Ru_cipr9wX7lJuM7zT8Ky_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftPTL8dFV8JfHTsM4_1fsnztIxgKNmRw4RDJmmEvrcj7Q&oe=69A059C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59_aVU_GE9MQ7kNvwGPthRO&_nc_oc=AdmYSA2ErBx2agueVTVOlXROoaLYvm6td2JAYoOP3u0QhWM3LbJr-nexod2p0tWdAEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft0hDxqknOVJ3A-iL13WlDdsyD0Ecz-MJXFWGc9WwRK4A&oe=69A04EC3"}, "display_name": "Brite Light", "keywords": ["light", "zen", "puzzle", "art", "create"], "long_description": "Brite Light: A Tranquil Creation Experience\n\nEmbark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light.\n\nTap into nostalgia and unleash your creativity with Brite Light.\n\nIdeal for both artistic souls and those seeking relaxation, Brite Light is your personal oasis of creativity. Immerse yourself in a tranquil environment where inspiration flows freely.\n\nKey Features:\n\n\nEXPANSIVE CANVAS: Craft your masterpiece on a spacious, interactive canvas.\n\nINFINATE CREATIONS: Use the pegs and patterns to spark your imagination.\n\nAUTO-SAFE FUNCTIONALITY: Seamlessly save and build upon your creations at your own pace.\n\nINTERACTIVE ENVIRONMENT: Engage with various objects in a serene, virtual room setting.\n\nBrite Light offers the ultimate Zen-like experience, perfect for unwinding after a hectic day or letting your mind wander in a safe, relaxing environment.\n{519716874070859}", "short_description": "Embark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8303990156396079"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculusc
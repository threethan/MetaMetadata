998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPKlHggk2MoQ7kNvwF417Md&_nc_oc=AdkYGLcTKEvIHHSaUwB34z-B3obu-EcEwY3g8BtM30yYGng8wZq4M1rn1JLKEVVMTSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXbqjP-0NPW1x3T9rfw13hveES9vMNyaH6QpcUmoPBWQ&oe=69B2CAAF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUnSTckyf9YQ7kNvwEH8XD4&_nc_oc=AdnFpoA3GNLAkMZ5P9wnWUhvaCtFCD5MJ6iV6T96OFLkcCTdgPSpn2DDf25ytbnPInA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwT0KeftT945iaV_B3BC4LtcyFvqIFCwJTcFJSB-KMNOA&oe=69B2CEC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7g7gBjNndAQ7kNvwHRjXok&_nc_oc=AdlcMJbxTq-hUTeelpEXMCBkkzVhse_RqCahWc3sKo3KchmCppsFNv2Y6Xob7ULhPxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyrEHVQNbkHyXPdktzvpw6Xrv-GXCEZIm6XpgigD7Q_WQ&oe=69B2C3C3"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
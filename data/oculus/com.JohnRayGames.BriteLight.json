4B5"}, {"file_name": "32.png", "id": "1193495794886776", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031620_1193495798220109_5063966899875026043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=di8iMIxl3lUQ7kNvwHjj_oB&_nc_oc=AdpeCBeJyk9P9IGcbXq75LqPywsoKzc8by__LR1g1YdBTrgsvkFArtN4p7X0R7Zk-vg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKkJkM3xNsOYujhpCb8Hija7lN_j3z4hhxZN2LcDOCuA&oe=6AE8A6C1"}, {"file_name": "5.png", "id": "1945118289165910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gns4FxUBLvEQ7kNvwEfp9Fp&_nc_oc=Adrc-uh1CLZHJBCaihCdQxWb0SZeEdgVxH0EhZsKoPdtWnmNMNyUM1WfAajoqEsP4Wc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf5Tyl2D9ppij7UrNx06Z0OzIplk8FnJ3wBPJ8LgawgQ&oe=6AE89B2F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tan70KUsln4Q7kNvwFhPfQT&_nc_oc=AdoySMgwEwQ57JNwNC_K4oacf_lTt5m3K6mKeZCWmWEFDWcFyEbjzRdK-xVTaiOeI14&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdlOzSVLVyIfU6ZT92rzvNAbytlNNLm5Ecl6o88jcPIA&oe=6AE89F42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-k5W1F1sVcQ7kNvwGPCUX9&_nc_oc=Adri7m5UCJOL0znvO-2CdqR1BGwvi7kwTQTJOvLujNFdXsToV-QhEW9j8ElVsVmt8cg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIj4ux-Xc0ZveacYWW-yk-F3wiyn4mIURywf6jUwxgnw&oe=6AE89443"}, "display_name": "Brite Light", "keywords": ["light", "zen", "puzzle", "art", "create"], "long_description": "Brite Light: A Tranquil Creation Experience\n\nEmbark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light.\n\nTap into nostalgia and unleash your creativity with Brite Light.\n\nIdeal for both artistic souls and those seeking relaxation, Brite Light is your personal oasis of creativity. Immerse yourself in a tranquil environment where inspiration flows freely.\n\nKey Features:\n\n\nEXPANSIVE CANVAS: Craft your masterpiece on a spacious, interactive canvas.\n\nINFINATE CREATIONS: Use the pegs and patterns to spark your imagination.\n\nAUTO-SAFE FUNCTIONALITY: Seamlessly save and build upon your creations at your own pace.\n\nINTERACTIVE ENVIRONMENT: Engage with various objects in a serene, virtual room setting.\n\nBrite Light offers the ultimate Zen-like experience, perfect for unwinding after a hectic day or letting your mind wander in a safe, relaxing environment.\n{519716874070859}", "short_description": "Embark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nssq9GTXNgoQ7kNvwFzPVXZ&_nc_oc=AdmdhEEEtr5svtj0hTCwqntR_QaeIRSI13Xyf4nJkyNAuNiWVZ8SPd4cHC9xeQQqS30&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHh-TStN_zbWgG3dA5vkPP8RTZJcwHPx0sYPUMx4b_fA&oe=69BD56AF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE-ASnmjbMkQ7kNvwHwIS7p&_nc_oc=AdnWfQiDtaKDUs1uNannPGkIpvBEAWS-Y9v4ZLydykODwg4qeL8e4epupeehhBAgHpQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaGb9YGIaUGLZWYUrfT87lW0MJVr0Mz11nynB34p6a6g&oe=69BD5AC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gz6KARTeUOIQ7kNvwHLxC0e&_nc_oc=Adn-v9pXi4kbx6uo27z7Qztzt9Lec4VFg4-L-6x7XCH541cogh_IEpt2hFb95-AweEc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzxH_XmklsI5Z3VUfNrKnUYGdZcVu5ryVvJCBRw5tX3Mg&oe=69BD4FC3"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyorNB-ZflEQ7kNvwGfpMpz&_nc_oc=Adkgc5erGn7O3XKegawxopBq8NbAcdG8jtHmi5ZSB5JCYH8nngg9IHiqMroi10u9fos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ8gbiRXuclwfEcEN7zE11OsomKxvspgdMA-IeDD-hsA&oe=69AD84AF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0F4v8jWQ-8Q7kNvwHJIXq9&_nc_oc=Adm62aFIc367TqJnZxKBxwLOKOe85GCdIj8-Zd1MlqF-lZ1xrH8rHR-WTlPNvm0VFOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-gfPsuPDNrZe2KQOR9O3UKd2dfkXH9Cfr9ozQq-kPig&oe=69AD88C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdyQs6wiKIYQ7kNvwEPos2q&_nc_oc=AdnLYOvyl2UtvxMWr514EoSzmKevwBjgkMcgZXOE4aMIogVCs6vRDsVQiw74tHbguXg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYenG9e4tdrDbhE76xr8XUL8KQLL16YKW1DKXqtmnNsA&oe=69AD7DC3"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
635"}, {"file_name": "32.png", "id": "1193495794886776", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031620_1193495798220109_5063966899875026043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thtX8DGC4aEQ7kNvwE6siV4&_nc_oc=Ados8HRQ95rQxN2u_WCpNJxDWnLoKo822ObRYzPwRG4R5kngfeEEAxe2A09vnYw8bK4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xjFqF87cJvua-fXFxhxVGfLMN4FHQQn16v1EP4QHYjg&oe=6A413841"}, {"file_name": "5.png", "id": "1945118289165910", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2OMdEVZudcQ7kNvwHMQOEA&_nc_oc=AdpSoqVkN_20TyXk8HYRVFDI0LPy5p2GAZTb7TDnrXZo41bI4hajmf6M0Xuvba_Kntk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OkIqcP94ZvoN3gDgURor4O8dP7cJNbZsZEK12tHJbSw&oe=6A412CAF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOZCZUWjThkQ7kNvwGzAUxk&_nc_oc=AdosEw2DH69Xj15piRV8xogLYtqCqsYHzGk6R--QauPL2r1FArF0G3QxvagEJ1yVKu8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xArH5T9k8oiJr_uwsqo6uRR5icbsJyCjYnN8Hg6Feew&oe=6A4130C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1KDQvVUWmcQ7kNvwEq96dh&_nc_oc=AdpnWixtPFF1JWAzdijv_BW5hnTkWmtGfjiAVsue3Zp59zvA0DyR7fkJDZl7sJFwKX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ovwF8jy7jW7b_1hqk-fRya2QrXRnmzLE0vyHvDbGzSw&oe=6A4125C3"}, "display_name": "Brite Light", "keywords": ["light", "zen", "puzzle", "art", "create"], "long_description": "Brite Light: A Tranquil Creation Experience\n\nEmbark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light.\n\nTap into nostalgia and unleash your creativity with Brite Light.\n\nIdeal for both artistic souls and those seeking relaxation, Brite Light is your personal oasis of creativity. Immerse yourself in a tranquil environment where inspiration flows freely.\n\nKey Features:\n\n\nEXPANSIVE CANVAS: Craft your masterpiece on a spacious, interactive canvas.\n\nINFINATE CREATIONS: Use the pegs and patterns to spark your imagination.\n\nAUTO-SAFE FUNCTIONALITY: Seamlessly save and build upon your creations at your own pace.\n\nINTERACTIVE ENVIRONMENT: Engage with various objects in a serene, virtual room setting.\n\nBrite Light offers the ultimate Zen-like experience, perfect for unwinding after a hectic day or letting your mind wander in a safe, relaxing environment.\n{519716874070859}", "short_description": "Embark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
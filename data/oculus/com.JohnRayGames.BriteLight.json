998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3NTmb5iIl8Q7kNvwHFeevA&_nc_oc=Adkn60eVVSJd0ZOqcRb70Zer8KAAQqZ4nK2WacdeChBMtlHIUFpNr2aLQLUdUpEC3ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsPOFsq5RTm2GNnPTmwqA4qZUiUy51KwFKY9y23IzopuA&oe=69A9902F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esoUtwWMA_sQ7kNvwEVkvLl&_nc_oc=Adnckys8SG0fUXN98h2ovnZq_YGp0Im75Tl1lEIA2QyXQ9Vmp2_QrdNULr9VcXDcRmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvFZT3M11HWivg7J9GE7kp_LqatBGFGsyMjUrRX33T8eA&oe=69A99442"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJzLymSk31YQ7kNvwHu8KcF&_nc_oc=AdkWiDt-iQAssuKoDz36CGj_0Edu0FnVAgPlPiLtuCiAPQX11kp2pPBRcyxEfpXPVZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvsR0H5mnI-5WLxQZoq48JGZm5aYI7GPiNbMYbK4ugKLA&oe=69A98943"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
0", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R03K8Pl3bAkQ7kNvwElHjWo&_nc_oc=AdogkDdtT0sZ9bqiXxPvQD21d8O8E8AvbBfrl-3eyApakPKqEEx77FwB9dALNLrPpdU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoHz184fP3HNKKpZjCkLZj1g9_3fWAyzIX8BdU8eAmKw&oe=69C7E2AF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNAT1gc-hDMQ7kNvwFPa91I&_nc_oc=AdofgtVH1Z8A6_9Kbp1koteEgQZac6kxNDY4v88aK1b_cjyo9ozEXbUBKTujPdcWR3Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz61WyGt09z4E4xJHAHFyA-u_2VgbANNPABz3eqZAxEBw&oe=69C7E6C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23-olfpiSQIQ7kNvwEKAyD7&_nc_oc=AdrpRHlCYrojl-i5GzZMATHRgk-EBOB-Iowk3KCzHGR0ezb-e03eDVhhu4-KB_AzMAg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTFKM87n5eC0DWADci8qAem0xNgXB2JMeH2RblEMqP0Q&oe=69C7DBC3"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_description": "Evoke nostalgia and create wonderful works of art with Bright Light. Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "770757604151277"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1190535899940428"}, {"status": "PUBLISHED", "id": "1120188870072484"}, {"status": "PUBLISHED", "id": "1069927974513418"}, {"status": "PUBLISHED", "id": "2211869312563922"}, {"status": "PUBLISHED", "id": "1834510237497457"}, {"status": "PUBLISHED", "id": "10018684488158509"}, {"status": "PUBLISHED", "id": "3730174170626861"}, {"status": "PUBLISHED", "id": "26810257991922726"}, {"status": "PUBLISHED", "id": "354557014356991"}, {"status": "PUBLISHED", "id": "782902846534431"}, {"status": "PUBLISHED", "id": "469091572209084"}]}, "baseline_offer": {"id": "354557014356991"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status
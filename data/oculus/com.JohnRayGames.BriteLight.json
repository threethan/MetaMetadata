935"}, {"file_name": "32.png", "id": "1193495794886776", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031620_1193495798220109_5063966899875026043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK5TAjHHuxkQ7kNvwGXmdq7&_nc_oc=AdrPzrFr3xe8OoNRmab8fJnke-Shg5UFAno2Ox_2SeSMmjioF8xYJjD48aNNhQfSGs0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR83NASuqXF9RnJsZLCKyAV00wePl9DFePt63ZpnRVwHg&oe=6AEC9B41"}, {"file_name": "5.png", "id": "1945118289165910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3s-b2vxR-8Q7kNvwHu7sAk&_nc_oc=AdphWqkbgkAm2n0OOuB_7hmdZMJADvKJIfTAXXeWdu_6YKIRsAU651qEOOjqPX5NzY4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_jtUUj-3YJx9FWkk5k-uqNLrzU7nLTpHNNnEg0_rDXQ&oe=6AEC8FAF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKzxjE4vHAkQ7kNvwE634Nk&_nc_oc=AdroYnxGxqQcA6HMSTra0_KpM1MeKIe-UMdUi-llJs8z_iuqoUnPC8vMqZ7IG8o7RuU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB0lND8aaNHkTKScgVTQfzZnZJMnZtyeClzc0zs0C2Wg&oe=6AEC93C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrpCLbNfxAYQ7kNvwE7nptA&_nc_oc=AdqEzZppZu3kAr7o8xOtdthj3sHsl0KGEKneYmN9txmk9TxcMAQNLpSB_EWusPwDDXI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6fSZDZfTL176UTarQnsQexKvxQgoOi8QIPk5dJ8zfBw&oe=6AEC88C3"}, "display_name": "Brite Light", "keywords": ["light", "zen", "puzzle", "art", "create"], "long_description": "Brite Light: A Tranquil Creation Experience\n\nEmbark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light.\n\nTap into nostalgia and unleash your creativity with Brite Light.\n\nIdeal for both artistic souls and those seeking relaxation, Brite Light is your personal oasis of creativity. Immerse yourself in a tranquil environment where inspiration flows freely.\n\nKey Features:\n\n\nEXPANSIVE CANVAS: Craft your masterpiece on a spacious, interactive canvas.\n\nINFINATE CREATIONS: Use the pegs and patterns to spark your imagination.\n\nAUTO-SAFE FUNCTIONALITY: Seamlessly save and build upon your creations at your own pace.\n\nINTERACTIVE ENVIRONMENT: Engage with various objects in a serene, virtual room setting.\n\nBrite Light offers the ultimate Zen-like experience, perfect for unwinding after a hectic day or letting your mind wander in a safe, relaxing environment.\n{519716874070859}", "short_description": "Embark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
C35"}, {"file_name": "32.png", "id": "1193495794886776", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031620_1193495798220109_5063966899875026043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQRxvfy1LXQQ7kNvwGfQ-ND&_nc_oc=AdpWvwAz8u9Vef_ymphK2OrNlvMoXVox6DMW7n285u6ZRF2wZVIWu1iVM2VtN9yHWBY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6WRd9zxWDo5owXmukHhviDh3xyKmswMVQRSLCOUw3sA&oe=6AC50E41"}, {"file_name": "5.png", "id": "1945118289165910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N9EZ9gGeFEQ7kNvwF7q962&_nc_oc=AdpKZnj308M11x6f2I0Kqgw9wZN1YBfgEIO3n_y_0IP2r_tELVUqF0iNmfqJRTmcZXs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQGOQ7F5__dRVJuoPKNFc5g7EG3BAvdLR_tX9Kyr88Dw&oe=6AC502AF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFc4-uH38q4Q7kNvwGOe01b&_nc_oc=AdqOd07Qinei_kClKfK3xF6b8bxFASsg4vzr_einZBgcBQAAx0Ajaebbu024AoazVmg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaBvxhSMUcnJI-IK0Ocu43zN18OjKgehdBSVFD4TizHA&oe=6AC506C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLD-WgJ6SgYQ7kNvwHOYgzu&_nc_oc=Adq9P9exPW50rbX_ohs41KObZZ9UtA2Tr2ATxMxyKKtpg2JlFJU6uPkzZqB2VjlJsKI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNijW_z6Mymujy7OsIN-CdhzlfZOpsl4Jk4AjMts1r0Lw&oe=6AC4FBC3"}, "display_name": "Brite Light", "keywords": ["light", "zen", "puzzle", "art", "create"], "long_description": "Brite Light: A Tranquil Creation Experience\n\nEmbark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light.\n\nTap into nostalgia and unleash your creativity with Brite Light.\n\nIdeal for both artistic souls and those seeking relaxation, Brite Light is your personal oasis of creativity. Immerse yourself in a tranquil environment where inspiration flows freely.\n\nKey Features:\n\n\nEXPANSIVE CANVAS: Craft your masterpiece on a spacious, interactive canvas.\n\nINFINATE CREATIONS: Use the pegs and patterns to spark your imagination.\n\nAUTO-SAFE FUNCTIONALITY: Seamlessly save and build upon your creations at your own pace.\n\nINTERACTIVE ENVIRONMENT: Engage with various objects in a serene, virtual room setting.\n\nBrite Light offers the ultimate Zen-like experience, perfect for unwinding after a hectic day or letting your mind wander in a safe, relaxing environment.\n{519716874070859}", "short_description": "Embark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-_H84KjhOgQ7kNvwGvhzeN&_nc_oc=AdnsnmbBdDtvNyh07A8j5QKLQH_8kCDSMfYUAIAEZEu3RgFk4oH-EBnEA6uD_vh2ePw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwlvo3K5JNtoYxJ6_AhyVsO1CVP_jPQPyJe0J51mT9_xQ&oe=69AED62F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0F4v8jWQ-8Q7kNvwEB1pRH&_nc_oc=AdkAOXHoRGIxT3_tgKhxvTbyTme5LAtlxW1Npg0c3sZ_34-cgTPvkO3E5T2tnkb74NI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDyxLykQXMV8b0TCvFYMI4H14yxuoOfnTlaBsFSL0g1A&oe=69AEDA42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdyQs6wiKIYQ7kNvwGsQtPO&_nc_oc=AdkX1fLFCLGT9HdcS8xjwQonJ6njhV6GhG55wciPR6DY5Plmzn22V-tybIau7TQCCSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWxHNcHTlxjcTYWKLC3srLlQvU4Pybnh7FheRzCQW7kA&oe=69AECF43"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
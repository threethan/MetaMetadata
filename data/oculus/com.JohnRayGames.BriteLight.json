EB5"}, {"file_name": "32.png", "id": "1193495794886776", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031620_1193495798220109_5063966899875026043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_2QqF4X_msQ7kNvwESM-16&_nc_oc=AdrtZ4Mu2hgJAFYlGv63zSZUAK0n7-fUEtrEVJIItwW7MPiH32O3RuIoc6okjypxmj8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaSwnC-bdvRFZ83Y8LixBoDgVuFi-ZBYfZx4RbycYXdw&oe=6AE360C1"}, {"file_name": "5.png", "id": "1945118289165910", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VRbUEEUfvcQ7kNvwHfPmOo&_nc_oc=Adps1uLCNJJuqDhSrA1czRumaOPWoPTyHp3WG73vVUKNE_axp8wJ5G2cTMvOTkdgJf8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7b3YlfcC3Y3X_H1hWeIh1BmW7drkiM_oOCEKyE-g4uQ&oe=6AE3552F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1x-hROKe_T0Q7kNvwEHfiQ9&_nc_oc=AdqNRdSKJ1O7wDkedzSYY3uXT1MdWHXc17FqdTPlVCtJhqFYCDtC7_ow6cfz1THXxsQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOonSTCxdc-q8dQXffYCJXaJVgiRYNgXffpjAXgZ0rztg&oe=6AE35942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpJjHNBHcMYQ7kNvwGGyP9u&_nc_oc=Ado5AQ12BiQ33qzkumnBSWk4kGmg1xif8xURaxeXJ60WaHFxmUtMaqrqhkuOcPqXfKE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx-oZ7nUNYxCX1jcaqiihAXW7dIYIDHx99ikxyroAZNw&oe=6AE34E43"}, "display_name": "Brite Light", "keywords": ["light", "zen", "puzzle", "art", "create"], "long_description": "Brite Light: A Tranquil Creation Experience\n\nEmbark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light.\n\nTap into nostalgia and unleash your creativity with Brite Light.\n\nIdeal for both artistic souls and those seeking relaxation, Brite Light is your personal oasis of creativity. Immerse yourself in a tranquil environment where inspiration flows freely.\n\nKey Features:\n\n\nEXPANSIVE CANVAS: Craft your masterpiece on a spacious, interactive canvas.\n\nINFINATE CREATIONS: Use the pegs and patterns to spark your imagination.\n\nAUTO-SAFE FUNCTIONALITY: Seamlessly save and build upon your creations at your own pace.\n\nINTERACTIVE ENVIRONMENT: Engage with various objects in a serene, virtual room setting.\n\nBrite Light offers the ultimate Zen-like experience, perfect for unwinding after a hectic day or letting your mind wander in a safe, relaxing environment.\n{519716874070859}", "short_description": "Embark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
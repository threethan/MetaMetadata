998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyorNB-ZflEQ7kNvwE5Fsnl&_nc_oc=AdlHO4SUtPjstzC24PLJMFs1Yv3r2eBJNrzPFYl6uGO8pBDb_TbQ166fwYEFoD_iO9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyc2XF3zWy8mTQJwy9U-N0PhojaomZ80ySFJa1i1c4gaA&oe=69AC332F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0F4v8jWQ-8Q7kNvwGViCV4&_nc_oc=Adl7sz2o1Iw2R9-REGDGL2_aRy303wfpdrCiPW-_0D6l-7nyqO4fk9rW1HVWCIQpiJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwGs3MZyBlVFuerzsH4Ei38eCz5z4C-KG6mknTuc6Ql5g&oe=69AC3742"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdyQs6wiKIYQ7kNvwEsUNCJ&_nc_oc=AdlUkswu4t75Inb093QxnYEB4VoPJteHBGKRKBW3uqlJ3X1MzCoDhh3p9opAo67XD8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7gcICfM7pS3pEB_svjRrcMt38QDFJ3uSFkEsz0tZK3Q&oe=69AC2C43"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
1B5"}, {"file_name": "32.png", "id": "1193495794886776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031620_1193495798220109_5063966899875026043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb9AjwgaPuUQ7kNvwGb3sYj&_nc_oc=Adpo3ONvCoifeWmE5LoCkbiGm_VGvmBZtqD6OGRBlE2m9e0dRc5WvUaM-9oNmsCC5Hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4294HO1D_T8SMIdYK7Z17O6w6asvlneYG3_QhDdbr0g&oe=6ABBD3C1"}, {"file_name": "5.png", "id": "1945118289165910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001664_1945118292499243_1021220941998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKvxQDrr7g0Q7kNvwFxYkja&_nc_oc=Adptjwd06Gqm_AAySx48WhKUbfBiCNnJolUOPDAAVlrXbWkdZn1Fnujcb2ghWCs_h9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTXRlHFCWmGOu9vfXYSg41HE_loCCb22GxdTKNG7AvEg&oe=6ABBC82F"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moPFRnsrMlYQ7kNvwEPeZ9v&_nc_oc=Adp9kiQYY0b0cLgZRHO0ExBanstpMvM2zCCYotwpLR0CjKkntjPBEFzVVrgKOBGy9Ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2XLALb3nImL4otW_s6FpQtM6EpC6BDuM0zBzkSjhBGw&oe=6ABBCC42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixCfmzZAjKIQ7kNvwGBsBoM&_nc_oc=AdrB_oSzHX2j9OLqTxVbdY_IImarQtKMDzn5W1-KRhVhNR-wsTDZfYTH4CHyMDJiOHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUpNDwV0w_9OAuqmYxP5SR9-lQFyU3fjNk2GikSP0YJQ&oe=6ABBC143"}, "display_name": "Brite Light", "keywords": ["light", "zen", "puzzle", "art", "create"], "long_description": "Brite Light: A Tranquil Creation Experience\n\nEmbark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light.\n\nTap into nostalgia and unleash your creativity with Brite Light.\n\nIdeal for both artistic souls and those seeking relaxation, Brite Light is your personal oasis of creativity. Immerse yourself in a tranquil environment where inspiration flows freely.\n\nKey Features:\n\n\nEXPANSIVE CANVAS: Craft your masterpiece on a spacious, interactive canvas.\n\nINFINATE CREATIONS: Use the pegs and patterns to spark your imagination.\n\nAUTO-SAFE FUNCTIONALITY: Seamlessly save and build upon your creations at your own pace.\n\nINTERACTIVE ENVIRONMENT: Engage with various objects in a serene, virtual room setting.\n\nBrite Light offers the ultimate Zen-like experience, perfect for unwinding after a hectic day or letting your mind wander in a safe, relaxing environment.\n{519716874070859}", "short_description": "Embark on a serene journey with Brite Light, brought to you by the creators of Zen Monkeys. Clear your mind, breathe deeply, and unwind in the soothing ambiance of Brite Light."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/britelight", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
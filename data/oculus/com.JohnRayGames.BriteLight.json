998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3NTmb5iIl8Q7kNvwFz_TCV&_nc_oc=Adk6wd3KUi_Fe6pxthJGvHZQz7nVFGe8_iBVwALRbRuk3eEXi5GECeNwKn0gQ8JAxTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuJHLjBteAhCHvNDK_sADB92lDMEAdoV4wiNNS6bQASvg&oe=69A83EAF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esoUtwWMA_sQ7kNvwEUcF3A&_nc_oc=AdmR_1Y3vs9s0uOergYpRMmPeNrH3fsvxeDSAWeoe9hoeLa8zs_OR1QI7MD_AW2qb6E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftIpW1-cvTdcc_HeAYrkP-sfJ0KWwU7AB0C7qnLGK9pKQ&oe=69A80A82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJzLymSk31YQ7kNvwE-W57m&_nc_oc=AdnB2lacDr4ThFMj0Za8pH3aBkGfuzbLFLrZfqsITNV_kIwYuXEyXuhxQMmAWR7ut7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuzkHt2x1Gy5PzcbmbdnKsSkkMVVn7Crcy2O5GIMHMoFQ&oe=69A837C3"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
998900134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkT9-A97SFgQ7kNvwEAxGCK&_nc_oc=AdlDa24w-uodsddJKVx5iA9KawK2XeKftUSNr4jPEPjlGBK1ZYS096UogvWHBBG8A5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTmwVUI6ekmpGybGoAap39J5G84O9AVbckFK11I2QEiQ&oe=69B810AF"}, {"file_name": "4.png", "id": "1882373772125657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001664_1882373775458990_7028507716099184885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8akFYJ4VNCIQ7kNvwF5YQWc&_nc_oc=Adm7srsItAysdqqE-9rBosbn1cJjZ7birzbvD-8dL5nkbS8W-yozsaYXY2xLl8v267E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfySU40R52WZ6Dw56aA6wD6OGc64kOOfy8hp_ZCa787tVQ&oe=69B814C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "3445578522431678", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223478_3445578525765011_3918502890170441114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peYuwbh4nl0Q7kNvwE1Z1vw&_nc_oc=Adkv1OvyiIFdqSzQQfuVWVtzWDIE-ngWuApPBPiTwL44GBeGlmUuo3mrtGyIJZ_aqls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEmCMD36qQ_mj2tfNwdXyV-NdHAo7T2LjcHJOGTjAZAg&oe=69B809C3"}, "display_name": "Brite Light", "keywords": [], "long_description": "Brite Light is a Zen game from the makers of Zen Monkeys.  Clear your mind, breath and relax with Brite Light.\n\nEvoke nostalgia and create wonderful works of art with Bright Light.\n\nFun for creative folks and people just looking to chill.  Brite Light is a fun, zen-like creativity room.  Brite Light includes:\n\n- A giant 4ft by 4ft Brite Lite Board;\n\n- Unlimited Pegs To Create With;\n\n-3 Free Brite Light Patterns;\n\n-An Auto-Save Feature So You Can Build Your Creation Over Time;\n\n-An Interactive Room That Includes Interactable Objects.\n\nBrite Light is the perfect Zen-Like experience for relaxing after a long day or clearing your head and letting your mind wonder safely in a fun, relaxing environment.", "short_descript
ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiUh_1cVVtoQ7kNvwGmRO6l&_nc_oc=AdoffV0FRo8t7vq0hajOkudECVtGj-lqLm0BX446RfuKbw2DZMzB3O-rx98g2TTcHuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTz15ZUGg8OdqW5UexFzcq8Hr48vtlJ_L-PcGjjqQmRQA&oe=6B0DA0F8"}, "display_name": "Fear Dead House", "keywords": [], "long_description": "' Fear Dead House '  is a game to explore paranormal activities. Open each possible door of a horror house and experience thrilling, scary paranormal activities. \n\nSupports 90Hz/120Hz on Quest 2\n\nIn the house of mystery, you will find and fall into the trap of ghosts. Flying chairs, scary zombies, crying doll, horror tv, dead bodies of the ghost, a flying skeleton who might attack you.  \n\nYou will have a torch to carry and explore in the dark death house. Face your fear to explore the whole dead house.\n", "short_description": "' Fear Dead House '  is a game to explore paranormal activities. Open each possible door of a horror house and experience thrilling, scary paranormal activities\n\nIn the house of mystery, you will find and fall into the trap of ghosts. Flying chairs, scary zombies, crying doll, horror tv, dead bodies of the ghost, a flying skeleton who might attack you.  \n\nYou will have a torch to carry and explore in the dark death house. Face your fear to explore the whole dead house.\n"}]}, "developer_name": "Thunder Game Development Studio", "developer_privacy_policy_url": "https://www.thundergamestudio.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.thundergamestudio.com/privacy_policy.html", "publisher_name": "Thunder Game Development Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORA
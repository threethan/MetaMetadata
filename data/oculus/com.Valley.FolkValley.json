64.5771-25/491827611_1459391589468674_3723783628021457810_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8yP3nyC2zIQ7kNvwHcxg5K&_nc_oc=AdpbM1KETC8jmGYvQAGYRKCpO3qu-5eWx9_EJs6GMLgKvfsBO_KhLvRcE74WxEW5O1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL9eBZNldfzBxAmhfa23P7FHcJckUDUGITwG2M8MK6lA&oe=6AFDADA9"}, {"file_name": "Screenshot_2.png", "id": "3706690402828490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_3706690406161823_2608204468743836279_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW3mRVXRaE8Q7kNvwEVQKz5&_nc_oc=Adp230Oofa7Z02Y2YaybkDp-T4lir621pJzJUHRJb7x-JnRyO9iUsf8BlbcqS0tDfiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM0Be5TRexLglMg9EaZ7fG3BzU29-K-EpcFuwIvLU6-Q&oe=6AFDB210"}, {"file_name": "Screenshot_1.png", "id": "1428982355968482", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1428982359301815_1739419621725269269_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fjJ9GniNv4Q7kNvwGb749i&_nc_oc=AdphskntkAi2iHJzjkqPL8-86cLRWYAu6-USDzAQtc9z7RrpbV6dSnUrycwfQaxKWp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjfNPiSCSNq0QJdTZPC3Um2cEImWXrXMxoeqBwtg37Ug&oe=6AFDC4D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Folk Valley", "keywords": ["horror", "folk", "valley", "monster", "backrooms"], "long_description": "Folk Valley is a multiplayer VR horror game where you move like an ape: swing, climb and run on your arms through the backrooms, while something hunts you.\n\nTHE BACKROOMS\nEndless yellow halls, a pitch-black pillar hall, flickering offices and floors that drop out under you. Every room looks the same. Every light might be the last one.\n\nCAPTAIN CLARK\nTwo of him roam the dark. He hears you, he sees you, and he runs. If he catches you, he lifts you off the ground for everyone nearby to see. Then you wake up back at spawn.\n\nPLAY WITH FRIENDS\nExplore together, split up, hold the doors shut and pull each other out of trouble. Chat by voice, pick your colour and meet up in the spawn room.\n\nMOD MENUS\nSix mod menus, from the Rusty Menu to the Captain's Menu: flashlight, night vision, low gravity, platforms, flying, big and tiny ape, rainbow fur and more. Hold X and it opens on your left hand.\n\nSOUNDBOARDS\nThree soundboards packed with goofy sounds (air horn, sad trombone, metal pipe, duck, kazoo) that everyone around you hears. Hold A and it opens on your right hand.\n\nPick which menu and board you wear in the spawn wardrobes.\n\nFolk Valley has scary moments, chases and some blood. Turn your volume up and keep your arms moving.", "short_description": "Something lives in the backrooms under Folk Valley. Swing, climb and run on your arms through endless yellow halls, pitch-black pillar rooms and abandoned offices, and pray Captain Clark doesn't spot you. He is fast, he never stops hunting, and when he catches you, everyone sees it. Explore with friends, hold the doors shut, jump the pitfalls, and make it back to spawn alive. Gear up with mod menus and goofy soundboards."}]}, "developer_name": "Hatchwork Studios", "developer_privacy_policy_url": "https://sites.google.com/view/folkvalleyofficial/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hatchwork Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/folkvalleyofficial/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"]
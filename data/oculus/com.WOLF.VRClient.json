ryone\u2019s profiles.\n", "short_description": "\u064a\u062c\u0644\u0628 \u0627\u0644\u0648\u0627\u0642\u0639 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0641\u064a \u0648\u0648\u0644\u0641 \u0623\u0641\u0636\u0644 \u0645\u062c\u062a\u0645\u0639\u0627\u062a \u0627\u0644\u062a\u0631\u0641\u064a\u0647 \u0627\u0644\u0635\u0648\u062a\u064a \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645 \u0627\u0644\u0639\u0631\u0628\u064a \u0625\u0644\u0649 \u0648\u0627\u0642\u0639 \u0627\u0641\u062a\u0631\u0627\u0636\u064a \u062b\u0644\u0627\u062b\u064a \u0627\u0644\u0623\u0628\u0639\u0627\u062f \u0645\u0630\u0647\u0644. \u0648\u0625\u0630\u0627 \u0623\u0639\u062c\u0628\u0643 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0647\u0627\u062a\u0641 \u060c \u0641\u0633\u062a\u062d\u0628 \u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0642\u0646\u0648\u0627\u062a \u0648\u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0645\u0646 \u062e\u0644\u0627\u0644 \u0639\u0627\u0644\u0645 \u0627\u0644\u0648\u0627\u0642\u0639 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a.\n\nWOLF VR brings the Arab world\u2019s favourite entertainment communities into dazzling 3D virtual reality. If you like the WOLF Qanawat app on mobile then you\u2019re going to LOVE experiencing the Channels, communities and shows in the most immersive way ever. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wolf.live/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Worlds Online Festival", "support_website_url": null, "website_url": "https://company.wolf.live/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomme
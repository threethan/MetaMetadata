&_nc_ohc=0bnA_i0S0KMQ7kNvwHEh3f_&_nc_oc=AdoODmlL6dayhRFmTdcv36dRSeCOVKRVPeTz1NxT35sQnJhmSWwuTKcLPW54pu1dJps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLxIv0l9yOD9z2WPEa7hROyr8-iY0rgLXxYFE82Wm7DQ&oe=6AF720E0"}, {"file_name": "CoverImageSafeAreaTemplate not t miniLandscape AjCdCbungled2.png", "id": "333165672520391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86684228_333165675853724_772235958259920391_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sw-Vv3elbhsQ7kNvwEw7HVv&_nc_oc=AdoriJfUK2sZG0Jtuo-Ccym_NIz1GSWEG-AMjQd9nzhOhVKf3dYYy-gfHofVtulqxFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbFio1Jda2dvYfxsWlWvWeblNW-z_yZ2uApWFAanw_Tw&oe=6AF714E4"}, {"file_name": "CoverImageSafeAreaTemplate not t miniLandscape w001.png", "id": "6574724962624490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974645_6574724969291156_395928892004452358_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UR_8rU3xyDEQ7kNvwFINYrp&_nc_oc=AdpCQ-48ZaaGlvQ4GfFhHxhuX-yNAUPhx2rv4aeC9MpDui3kcnk0QJoKlzyKFW56S0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYz9XaYKQm5Z4nB7e4C0CG8WGx0nZQ9Trc-4Ww7nQgEA&oe=6AF715E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape ZD4.png", "id": "1272385383475403", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984460_1272385386808736_1574942857261472817_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5QJERM_eGwQ7kNvwEq2AOf&_nc_oc=AdpoYFrQZJiwkJ0HLsjZ-6u4tLucrXJ_fSvgHvpkZsOlB_Uj_CgAnJWp_4tVxbzPvrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThOJeMo07K8mO5p9rGdj6FNcYzKsZqSSJhpAk5k68KBg&oe=6AF72722"}, "display_name": "Jungle Zoo Ocean Passthrough Handtracking Demo", "keywords": [], "long_description": "Create a Jungle, Zoo, and Ocean in your home with Passthrough mixed reality and optional hand tracking.\n\nThis is a demo of \"Jungle Zoo Ocean Passthrough Handtracking\"\n- in this demo there are 45 second round limits, there is no timer in the full version (search the store for the exact full name to find it)\n- Featuring the best of \u201cJungle Passthrough\u201d, \u201cOcean Passthrough\u201d, \u201cZOSU Zoo Home Passthrough\u201d with improvements.\n\nThere are over 60 animals, 100 sea creatures, and 70 plants to move, spawn, and delete.\n\nThere are over 30 premade areas or you can start from an empty scene. Animals and plants can be spawned randomly, or select animals to copy or enlarge in 3 bonus experimental levels.\n\nAnimals include: lions, tigers, bears, dinosaurs, wolves, elephants, rhinos, crocodiles, chickens, sharks, octopus, whales, dolphins, horses, cats, dogs, star fish, leopards, cuttle fish, zebras, owls, seals, lion fish, lizards, goats, sun fish, and many more.", "short_description": "Create a Jungle, Zoo, and Ocean in your home with Passthrough  mixed reality and optional Hand Tracking.\n\nDemo of \"Jungle Zoo Ocean Passthrough Handtracking\"\n\nFeaturing the best of \u201cJungle Passthrough\u201d, \u201cOcean Passthrough\u201d, \u201cZOSU Zoo Home Passthrough\u201d \n\nThere are over 60 animals, 100 sea creatures, and 70 plants to move, spawn, and delete.\n\n30 premade areas or you start from an empty scene. Animals + plants can be spawned randomly, or select animals to copy/enlarge in 3 bonus levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graph
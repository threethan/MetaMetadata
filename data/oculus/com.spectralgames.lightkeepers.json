0_AQNikvAtYu5dpLAANUcWxFN900NGzj6wP1fbTq-07aTHaA&oe=6ACCF30D"}, {"file_name": "LH_Screenshots_003.png", "id": "900255526159763", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304162_900255529493096_968382495594289780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cco5R9N-bw0Q7kNvwEJ0Rww&_nc_oc=Ados3BzWFxyBgRojr2YKN_dO_8euQb5LlSQryxnaNiRBeZGFHNvJYUS3kpSmCtUJudg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjMl64_NCU6DaZ9Pn9FOd8ma3UY_9MyPYnkPY9Ppl-Rw&oe=6ACCEFF3"}, {"file_name": "LH_Screenshots_004.png", "id": "1584014739521233", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_1584014742854566_8199837553397451526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbtTXZIOQL4Q7kNvwG4F_nR&_nc_oc=AdoW7wCVjbmo97cFyA7HRafz3Ce2c3LVqT_R3hAi1NlnDv0bwrAfZ4Vff-hO_csDWf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvIXcaaKuw3rnnL4fq8rY02ipmsOcdX57kUvNFhMNbJw&oe=6ACD05D8"}, {"file_name": "LH_Screenshots_005.png", "id": "925390223613060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_925390230279726_6732078942718189025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8dqACBYcVQQ7kNvwHOhbCt&_nc_oc=AdrUuEgUdCyIkk7oReNeajlT0OgoRM7EjBkjgL2OYBuF1TihsXpg1BjFSp3tVisy_jo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPasGSpJ6mr5SNrWRK9j9merdqWW3oAM_rFUbGCjNWBIg&oe=6ACD00BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_ABtest_rainyday.png", "id": "1299921518755745", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_1299921525422411_950095365467128802_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5G0bT5PICcQ7kNvwE3UJVO&_nc_oc=Adq3fWR2wIg-ir1H2rRH4D6QkevEI_kM8JVcXkSM4JzimTK70_Fe4XUYs2fVpJOu9-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnITJOZNKlxyQyFEyw0PIn4gKgUJL0DrecadFg6H-Rkw&oe=6ACCF674"}, "display_name": "The Lightkeepers", "keywords": ["Action", "Cooperation", "Shooter", "Exploration", "Survival"], "long_description": "**Sign the contract and take on the darkness!**\n\nGrab your weapons and face an unequal battle against the nightmares of the deep! The Lightkeepers is a cooperative action game where you\u2019ll fight for your life until every dawn!\n{1559235318527291}\n**Explore mysterious locations**\n\nSail during the day to discover mist-shrouded islands, explore ruins and venture into forgotten undergrounds. Increase your resources and wealth!\n{1948071269123010}\n**Prepare for danger**\n\nUse your resources, share responsibilities, craft grenades, lay mines, feed the hungry, heal the wounded\u2026 danger is coming!\n{1653339643020741}\n**Fight for survival**\n\nTo arms! Slash, chop, shoot and blow things up. With over 20 weapons to choose from there\u2019s something for everyone. Plan your tactics or revel in the chaos of battle. Any strategy is good\u2014as long as the light doesn\u2019t go out!\n{814648988334063}\n**Key Features:**\n\n- **Marine exploration:** Travel by boat between lands scattered across the sea.\n- **Hand-designed islands:** Randomly selected, carefully crafted side locations \u2013 full of puzzles, dungeons and variations ensuring replayability.\n- **Progression between missions:** A meta-progression system allowing you to unlock and upgrade your starting weapons and cosmetics for your character.\n- **Tactical combat and crafting:** A wide range of enemies and bosses, crafting consumables (mines, grenades, healing items) and fortifications.\n- **Rich atmosphere:** A mysterious world set in the 1920s inspired by the works of H.P. Lovecraft.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/priva
0_AQOS-E7hZPuEu7X7Ool6sLDa1si3snBiJN3Ni9LNe9Hkkg&oe=6ACE448D"}, {"file_name": "LH_Screenshots_003.png", "id": "900255526159763", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304162_900255529493096_968382495594289780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cco5R9N-bw0Q7kNvwHiyP03&_nc_oc=Adr6vuI3PV23iPfgqY0G--PtDRBYDXXkVmFZjs8282mafsTIcVuWjPWlAlkc-suCySk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZUUXf4Ze3sLgYxUTqpXeyTSkd5TtD_VPmGsxig7YolA&oe=6ACE4173"}, {"file_name": "LH_Screenshots_004.png", "id": "1584014739521233", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_1584014742854566_8199837553397451526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTLqdwYTofcQ7kNvwG2cw_C&_nc_oc=Ado6MhtVUG9zsyOBav0PM3LvUs4jDgGQFt6pmGFmemUp-ik7haiCdme7Zk2vL0MEQcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXS1LNZifW0xdeLSLiVbc4b9RYTXFJU3otGCSwSJrGTA&oe=6ACE5758"}, {"file_name": "LH_Screenshots_005.png", "id": "925390223613060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822327_925390230279726_6732078942718189025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8dqACBYcVQQ7kNvwF9waJn&_nc_oc=AdrNoyAfiiPs3OW82WEs_V5ypoSnp-7L8_A2hFygUpttDpuNoqcjW2UDKQvPSxv-Nwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr0NZjvS6GFI40f1i2qQoxfVof2MAbI6inSXhZXxjx2g&oe=6ACE523B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_ABtest_rainyday.png", "id": "1299921518755745", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_1299921525422411_950095365467128802_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5G0bT5PICcQ7kNvwFvvje9&_nc_oc=AdqeaVHsmTnAoKnDRNBcy7vQ3HoC9hErV8rXYib4Pvn6ak6CS7ALmK3HFibnfAYtH4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4FThDs_WExQB3htw8TRpK45fQZhnMwXBlDsdK37eO9g&oe=6ACE47F4"}, "display_name": "The Lightkeepers", "keywords": ["Action", "Cooperation", "Shooter", "Exploration", "Survival"], "long_description": "**Sign the contract and take on the darkness!**\n\nGrab your weapons and face an unequal battle against the nightmares of the deep! The Lightkeepers is a cooperative action game where you\u2019ll fight for your life until every dawn!\n{1559235318527291}\n**Explore mysterious locations**\n\nSail during the day to discover mist-shrouded islands, explore ruins and venture into forgotten undergrounds. Increase your resources and wealth!\n{1948071269123010}\n**Prepare for danger**\n\nUse your resources, share responsibilities, craft grenades, lay mines, feed the hungry, heal the wounded\u2026 danger is coming!\n{1653339643020741}\n**Fight for survival**\n\nTo arms! Slash, chop, shoot and blow things up. With over 20 weapons to choose from there\u2019s something for everyone. Plan your tactics or revel in the chaos of battle. Any strategy is good\u2014as long as the light doesn\u2019t go out!\n{814648988334063}\n**Key Features:**\n\n- **Marine exploration:** Travel by boat between lands scattered across the sea.\n- **Hand-designed islands:** Randomly selected, carefully crafted side locations \u2013 full of puzzles, dungeons and variations ensuring replayability.\n- **Progression between missions:** A meta-progression system allowing you to unlock and upgrade your starting weapons and cosmetics for your character.\n- **Tactical combat and crafting:** A wide range of enemies and bosses, crafting consumables (mines, grenades, healing items) and fortifications.\n- **Rich atmosphere:** A mysterious world set in the 1920s inspired by the works of H.P. Lovecraft.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/priva
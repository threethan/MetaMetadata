0_AQNfGeh8Jk31sqx5zezdg_tVQZPsfIVnoYZe7Z6XLqJ2Kw&oe=6AC8FE8D"}, {"file_name": "LH_Screenshots_003.png", "id": "900255526159763", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304162_900255529493096_968382495594289780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5ZawkDkxogQ7kNvwGJ34nS&_nc_oc=Adoet0wRQHEpU1tfaTObxCDAv7iX3vuKk4nCE9QlTPYHt-ae5l3D1Lp8jfReVeWaWSw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEnlkddzPd_v5XSWWQBRcmMWVbuH91cvePXfQ_baAp1g&oe=6AC8FB73"}, {"file_name": "LH_Screenshots_004.png", "id": "1584014739521233", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818860_1584014742854566_8199837553397451526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubyINufGaWQQ7kNvwHz7L88&_nc_oc=AdruWxAwRp2XXe2Hm3zbq71jjjkAGHpVGZsvY43OkWVQteVTKhmGOjMnnu_iuOyib-Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8u_22TL6Ku5wjL03u4in1tE9XK580hGJdtinj3uMbMw&oe=6AC91158"}, {"file_name": "LH_Screenshots_005.png", "id": "925390223613060", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822327_925390230279726_6732078942718189025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD4ouZp3VHIQ7kNvwE7y7-P&_nc_oc=AdpRh1ny1H6saJusQUccRWnkyKuFA1ixu2E-PgWFo3pUlotW8x2zZKhC7cXeJpMn18A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdP3I-qX41Ujc5pyZGdd8mMcxIVL-Oq_R4Al9aPV8Rew&oe=6AC90C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_ABtest_rainyday.png", "id": "1299921518755745", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823279_1299921525422411_950095365467128802_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUGzxq-u5IQQ7kNvwHLkk9b&_nc_oc=AdrLZRUJG6iWw9dp176ZHeeoodGHQIk6Jj4N1EKPaX_hjes_tX39EHdvQfcuJNtHNoM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEhG7SGlDPIMWyiS_F-9uACg4vS91qMpn7U1MARkB3Hg&oe=6AC901F4"}, "display_name": "The Lightkeepers", "keywords": ["Action", "Cooperation", "Shooter", "Exploration", "Survival"], "long_description": "**Sign the contract and take on the darkness!**\n\nGrab your weapons and face an unequal battle against the nightmares of the deep! The Lightkeepers is a cooperative action game where you\u2019ll fight for your life until every dawn!\n{1559235318527291}\n**Explore mysterious locations**\n\nSail during the day to discover mist-shrouded islands, explore ruins and venture into forgotten undergrounds. Increase your resources and wealth!\n{1948071269123010}\n**Prepare for danger**\n\nUse your resources, share responsibilities, craft grenades, lay mines, feed the hungry, heal the wounded\u2026 danger is coming!\n{1653339643020741}\n**Fight for survival**\n\nTo arms! Slash, chop, shoot and blow things up. With over 20 weapons to choose from there\u2019s something for everyone. Plan your tactics or revel in the chaos of battle. Any strategy is good\u2014as long as the light doesn\u2019t go out!\n{814648988334063}\n**Key Features:**\n\n- **Marine exploration:** Travel by boat between lands scattered across the sea.\n- **Hand-designed islands:** Randomly selected, carefully crafted side locations \u2013 full of puzzles, dungeons and variations ensuring replayability.\n- **Progression between missions:** A meta-progression system allowing you to unlock and upgrade your starting weapons and cosmetics for your character.\n- **Tactical combat and crafting:** A wide range of enemies and bosses, crafting consumables (mines, grenades, healing items) and fortifications.\n- **Rich atmosphere:** A mysterious world set in the 1920s inspired by the works of H.P. Lovecraft.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/priva
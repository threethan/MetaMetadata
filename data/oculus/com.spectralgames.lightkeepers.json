3271451931653113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8CaAqaV96AQ7kNvwHiyF4M&_nc_oc=Adruf4UCBJj4b70S0G8lt0JqNNYTFRpeMBsbX7UM7owgpCW1GbOPfrEEnfLehsS8RCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWrP0nqJGTpAMVnEGgGNe5HNXZ5UmGHVKtr0r8FqoIcw&oe=6AE20AEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_announcement_november2025.png", "id": "685349984302672", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820923_685349987636005_837417336160403919_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNr1gn8N9vQQ7kNvwG7ufSK&_nc_oc=AdrZeddkZnX-hVb5IOOv1CZmybNXfg4PnR5AcQvc8wDaUz_sas9mpUW9WvGGU5sQbL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd61vw4UVwlLzjoOKam7tOUhJXNqKToLgkEg_5BoX9QQ&oe=6AE21403"}, "display_name": "The Lightkeepers", "keywords": ["Action", "Cooperation", "Shooter", "Exploration", "Singleplayer"], "long_description": "The Lightkeepers is set in a dark, mysterious world where light comes at a price and survival depends on trust and courage.\nEach night brings new dangers, each wave hides something that should not exist.\n\nThis is a story about guardians who chose light \u2014 even when everything else was plunged into darkness.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Spectral Games SA", "support_website_url": null, "website_url": "https://spectralgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440400758
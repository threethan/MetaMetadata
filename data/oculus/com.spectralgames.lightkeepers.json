3271451931653113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIqwJ1maGu8Q7kNvwFyVX5E&_nc_oc=AdqR5I7TFyJjYLpD03rJ6cpSCR1U_SVVBa8pXQ9ACDovmk9esnPynAEjpWDHzQNcqjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPu3X7ARvdrI-idnBHkBJcx1BSjn-MjWrjSZKzeuVQ0Q&oe=6AE750EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_announcement_november2025.png", "id": "685349984302672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_685349987636005_837417336160403919_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiAYsYR9wwsQ7kNvwEpjRlA&_nc_oc=AdpIfovhtFL-VNR3sfyC1hDm9-1hFQvHOd5toKImSpdITO8SJpuezZoLcBDnnfWxAp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtwNAdnhbDFIhzejxL2ZBIBJI2ifE9pEIDz2DCGW0Hgw&oe=6AE75A03"}, "display_name": "The Lightkeepers", "keywords": ["Action", "Cooperation", "Shooter", "Exploration", "Singleplayer"], "long_description": "The Lightkeepers is set in a dark, mysterious world where light comes at a price and survival depends on trust and courage.\nEach night brings new dangers, each wave hides something that should not exist.\n\nThis is a story about guardians who chose light \u2014 even when everything else was plunged into darkness.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Spectral Games SA", "support_website_url": null, "website_url": "https://spectralgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440400758
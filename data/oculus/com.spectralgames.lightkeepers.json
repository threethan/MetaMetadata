AQLZZj2okgbNDlD0tUEpIu-lqmTiky9yh8kel8kZklyftw&oe=6AABFD8D"}, {"file_name": "LH_Screenshots_003.png", "id": "900255526159763", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_900255529493096_968382495594289780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdbhWhL6dpMQ7kNvwGySOaE&_nc_oc=AdqF8eTTIf8NTC5vinlG5w-Wo9WlECW__LSlPmsE_wYP8OaV9vP-hkhUuRg6N6Zw9E4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE8Udgn2pZOYPFw-t1yW5HFdPa1xEjk4A74ax4Ud5kSA&oe=6AABFA73"}, {"file_name": "LH_Screenshots_004.png", "id": "1584014739521233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_1584014742854566_8199837553397451526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9YkjhYQyLgQ7kNvwEju557&_nc_oc=AdrDlV2dNmQhwRH0cG7bDyveXNp34uiMrhL4eDTdmPYNaZXN9rubeYgRY5sQHGZHJZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo6TBkbiNqQpoe22LMGVSNUtfJr8LVyCtN7EIwUj78jw&oe=6AAC1058"}, {"file_name": "LH_Screenshots_005.png", "id": "925390223613060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_925390230279726_6732078942718189025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hcf1g6FWWDYQ7kNvwE0ZdDC&_nc_oc=Adpt9Z56KOSzeorod4keSHiBTllDVHgObMcWzvvMhOqbzTZJGGjDLoCo5Cz70rBvJ60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBTD39d3TCBhCgjyeyzHIYLHgcRvH0QelydoXF3qldew&oe=6AAC0B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_ABtest_rainyday.png", "id": "1299921518755745", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1299921525422411_950095365467128802_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJh3pmDwB2IQ7kNvwG0c8ip&_nc_oc=AdrdH6buq__Um8tesgznTt0ln3ECWPgtL61iN0XLkHa4WfHJ93-kYbcxFeuC9lYElPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCQSSF-qGc0w1_EFF5J6pz0KvWzWU_j711M0hrKdL1XQ&oe=6AAC00F4"}, "display_name": "The Lightkeepers", "keywords": ["Action", "Cooperation", "Shooter", "Exploration", "Survival"], "long_description": "**Sign the contract and take on the darkness!**\n\nGrab your weapons and face an unequal battle against the nightmares of the deep! The Lightkeepers is a cooperative action game where you\u2019ll fight for your life until every dawn!\n{1559235318527291}\n**Explore mysterious locations**\n\nSail during the day to discover mist-shrouded islands, explore ruins and venture into forgotten undergrounds. Increase your resources and wealth!\n{1948071269123010}\n**Prepare for danger**\n\nUse your resources, share responsibilities, craft grenades, lay mines, feed the hungry, heal the wounded\u2026 danger is coming!\n{1653339643020741}\n**Fight for survival**\n\nTo arms! Slash, chop, shoot and blow things up. With over 20 weapons to choose from there\u2019s something for everyone. Plan your tactics or revel in the chaos of battle. Any strategy is good\u2014as long as the light doesn\u2019t go out!\n{814648988334063}\n**Key Features:**\n\n- **Marine exploration:** Travel by boat between lands scattered across the sea.\n- **Hand-designed islands:** Randomly selected, carefully crafted side locations \u2013 full of puzzles, dungeons and variations ensuring replayability.\n- **Progression between missions:** A meta-progression system allowing you to unlock and upgrade your starting weapons and cosmetics for your character.\n- **Tactical combat and crafting:** A wide range of enemies and bosses, crafting consumables (mines, grenades, healing items) and fortifications.\n- **Rich atmosphere:** A mysterious world set in the 1920s inspired by the works of H.P. Lovecraft.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Spectral Games SA", "support_website_url": null, "website_url": "https://spectralgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "38412540915057563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673558985_2676619209399085_4365178035510951732_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6cTnKkmId4Q7kNvwGtOcoH&_nc_oc=AdqyvNQs_lx3pD_GfjNnnLSJPA6tFVNk6nBRpEE3ISXQPcGJu2hAV5eUoK4o6WcW_Z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8LstTbuxb_wAzIHjH4Zq0VRf-MtZSF6_9iaKBq3Q4qQ&oe=6AABEC74"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Lightkeepers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1789059600, "lastRevision": {"nodes": [{"id": "27856043147374112", "release_type": "SCHEDULED", "administration_status": "APP
0_AQL7Sxt8y0x7BlqcGs0neDRFyKvdzsqpg7rIKSMVFuWAcw&oe=6ABBCF8D"}, {"file_name": "LH_Screenshots_003.png", "id": "900255526159763", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304162_900255529493096_968382495594289780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fBq1XEi5tYQ7kNvwHuPRpI&_nc_oc=AdqEv89IL8OhgHxB8719ZtpkKdoO0ddBeAmk-yADATpmwET62kcbFFujJYrY801eQWA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLESWUqeHSUuXrqvBK7Supdo1sGflm8Ooxhf2lY9oWkZg&oe=6ABBCC73"}, {"file_name": "LH_Screenshots_004.png", "id": "1584014739521233", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_1584014742854566_8199837553397451526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEF2zwji12UQ7kNvwGYOirg&_nc_oc=AdoKBVWwvzdL5rieSJtv85bFqy-PTOz3537rXq2yye2elpUBSrkxHLHTP6N2HjxxPxY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHbl-DKfvWJFFL90kAY0gWHccy0AMbSRgimakLC5o6Iw&oe=6ABBE258"}, {"file_name": "LH_Screenshots_005.png", "id": "925390223613060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822327_925390230279726_6732078942718189025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7yngPtbeOoQ7kNvwEvIZHa&_nc_oc=AdoxgNrtLSpeHM_AApTwdfZwayfZUPw7polEoP9TbFjbyN4GzSCxqcwegTahBknV13E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL08J9ksJPsT8ke5Gw9pY5ngPGOWzVJK7g-OVaUhODEmg&oe=6ABBDD3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_ABtest_rainyday.png", "id": "1299921518755745", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_1299921525422411_950095365467128802_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS-3gOx0WrgQ7kNvwGX5yvQ&_nc_oc=AdoFwcZxz_bKobrjUzkfgGInNMmV_lyHwB6RgVZBEKmsS2iOLBtG6lO_gjtx-9_IoTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrFROW37PsHdR3qWl41HePA4SuuZmF3MxWgYctZdHbEg&oe=6ABBD2F4"}, "display_name": "The Lightkeepers", "keywords": ["Action", "Cooperation", "Shooter", "Exploration", "Survival"], "long_description": "**Sign the contract and take on the darkness!**\n\nGrab your weapons and face an unequal battle against the nightmares of the deep! The Lightkeepers is a cooperative action game where you\u2019ll fight for your life until every dawn!\n{1559235318527291}\n**Explore mysterious locations**\n\nSail during the day to discover mist-shrouded islands, explore ruins and venture into forgotten undergrounds. Increase your resources and wealth!\n{1948071269123010}\n**Prepare for danger**\n\nUse your resources, share responsibilities, craft grenades, lay mines, feed the hungry, heal the wounded\u2026 danger is coming!\n{1653339643020741}\n**Fight for survival**\n\nTo arms! Slash, chop, shoot and blow things up. With over 20 weapons to choose from there\u2019s something for everyone. Plan your tactics or revel in the chaos of battle. Any strategy is good\u2014as long as the light doesn\u2019t go out!\n{814648988334063}\n**Key Features:**\n\n- **Marine exploration:** Travel by boat between lands scattered across the sea.\n- **Hand-designed islands:** Randomly selected, carefully crafted side locations \u2013 full of puzzles, dungeons and variations ensuring replayability.\n- **Progression between missions:** A meta-progression system allowing you to unlock and upgrade your starting weapons and cosmetics for your character.\n- **Tactical combat and crafting:** A wide range of enemies and bosses, crafting consumables (mines, grenades, healing items) and fortifications.\n- **Rich atmosphere:** A mysterious world set in the 1920s inspired by the works of H.P. Lovecraft.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/priva
0DA4D9"}, {"file_name": "LH_Screenshots_002.png", "id": "2360587324445641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827601_2360587327778974_7115642450148152864_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4oGmwsfb34Q7kNvwFHbYY7&_nc_oc=AdpGUf-0im0-fliViU78y-88c07-S1CLJydRodYY1hlX6X7u8lwsiEt4Webj9BY_lUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfc51-mltCQ0VG0lFtR6OfHtWcxS8kyblvh2A1gwQPgA&oe=6B0DC4CD"}, {"file_name": "LH_Screenshots_003.png", "id": "900255526159763", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304162_900255529493096_968382495594289780_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80G_Vdq18C8Q7kNvwESnG4u&_nc_oc=Adr63QKWxGfVBPNnE4Cv4ByNCYeJYqe0S7P88kV0WcdQMjpbGosxXDhCtmCaQHGqB3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeOdUTHTnB0HBC1cld30tjy-OyR_HnZr9cdPrOyzxdPA&oe=6B0DC1B3"}, {"file_name": "LH_Screenshots_004.png", "id": "1584014739521233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_1584014742854566_8199837553397451526_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIRnq1X6BfsQ7kNvwEmTekY&_nc_oc=AdqxFQ7TlvHesUqGxSyKJdorlpNnHmrIirXbXSzHYNBV-IG1W08DeU28Py0hxnIh9lQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8KorTUSOOsjYkhyLI-5URKbeOCS_2snMUZ3-Ac-gmJw&oe=6B0D9F58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_ABtest_rainyday.png", "id": "1714457843356597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1714457850023263_531400500111552064_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKvGJObFKwAQ7kNvwGTV5Gd&_nc_oc=AdoJ23nN7G7XuoAjcslMEzYjIr_2qLtRch0AT0mMpYQBAT2XRRhXSkolD4UMKw24iPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQezKXMmDBVu3NDektd8EyvmMXOk6NWq9dUGGTCfIucJw&oe=6B0DB284"}, "display_name": "The Lightkeepers: Protect the Lighthouse", "keywords": ["Cooperation", "Shooter", "Exploration", "Survival", "lighthouse"], "long_description": "**Sign the contract and take on the darkness!**\n\nSign the contract \u2013 explore islands by day. Fortify your lighthouse and survive waves of nightmares by night. Progress your character between contracts in the social lobby. Play solo or with friends via Party Finder \u2013 finding your next mission buddy in no time.\n\n{1559235318527291}\n**Explore mysterious locations**\n\nSail during the day to discover mist-shrouded islands, explore ruins and venture into forgotten undergrounds. Increase your resources and wealth!\n{1948071269123010}\n**Prepare for danger**\n\nUse your resources, share responsibilities, craft grenades, lay mines, feed the hungry, heal the wounded\u2026 danger is coming!\n{1653339643020741}\n**Fight for survival**\n\nTo arms! Slash, chop, shoot and blow things up. With over 20 weapons to choose from there\u2019s something for everyone. Plan your tactics or revel in the chaos of battle. Any strategy is good\u2014as long as the light doesn\u2019t go out!\n{814648988334063}\n**Key Features:**\n\n- **Marine exploration:** Travel by boat between lands scattered across the sea.\n- **Hand-designed islands:** Randomly selected, carefully crafted side locations \u2013 full of puzzles, dungeons and variations ensuring replayability.\n- **Progression between missions:** A meta-progression system allowing you to unlock and upgrade your starting weapons and cosmetics for your character.\n- **Tactical combat and crafting:** A wide range of enemies and bosses, crafting consumables (mines, grenades, healing items) and fortifications.\n- **Rich atmosphere:** A mysterious world set in the 1920s inspired by the works of H.P. Lovecraft.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Spectral Games SA", "support_website_url": null, "website_url": "https://spectralgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "40128778396767131"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1863329871467145_5936692851098187418_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt6CqR_h2S8Q7kNvwF73MiL&_nc_oc=Ados3RLekczTgoWrsyaUWR9H5pq1cPSdnfGIp_CSSfbdN04rK3eY-ZQ5g5VmVwZWNUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQotNnk5fkVc_azEEbr7Vw4yIoQXxYJ0d6GanlindZRcg&oe=6B0DC38A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Lightkeepers: Protect the Lighthouse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "
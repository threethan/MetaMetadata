cw1UtHaoUfH44_zmgaq7UDgcZjtVdaOsZfXLLMkWm13pQJMr1PJ34V80ODKR0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML7vUu-3eQB2LQv7MH8dW3iImxq6FwUKBG0MGN5v_buw&oe=6AD0E78D"}, {"file_name": "LH_Screenshots_003.png", "id": "900255526159763", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304162_900255529493096_968382495594289780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4GAYahjETEQ7kNvwGnkHmQ&_nc_oc=Adptexy-pc11k_P5PF7Z2oIssmGpzeGuahzAP47kga6JHAjXmwToG27i3lyRMPVwvqE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEFlbgXE6Gda7_xH-47hvjLfp1EaFhFCfhXxttU8RpaQ&oe=6AD0E473"}, {"file_name": "LH_Screenshots_004.png", "id": "1584014739521233", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818860_1584014742854566_8199837553397451526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTLqdwYTofcQ7kNvwG6nN-Z&_nc_oc=Adrv845NhucjnNlGZMNwbLCK-5Kw2PlxqP7saH9e30AilyAI5qxJu5pyVts1Nvf3l7Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnnYqw3kCxibAdYbYql5CMRED3ybVkfoE8LHf8_nWceA&oe=6AD0FA58"}, {"file_name": "LH_Screenshots_005.png", "id": "925390223613060", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822327_925390230279726_6732078942718189025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNletyzvvGwQ7kNvwEG02zj&_nc_oc=Adoi4PcviJ9myuDj14dMJU8sP_iA3XocpKRjnGRJruWp7bqKKLDVSCBMGdoFnJvlddI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcxaXcl1wTOjrWBNU36XK_upn48LLTB3ddgdOTjzepFA&oe=6AD0F53B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_ABtest_rainyday.png", "id": "1299921518755745", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823279_1299921525422411_950095365467128802_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAqRykDTm5YQ7kNvwHNhzrh&_nc_oc=Adpe3IZXHWdIr--g1wvvbJcemUoFy_0OQQ2nAgsUgO6vqTTfszIixLyqLqCBhoGIU4k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvYgHURfmEocTKnTjquHhfpVY4lK3fsh_Ob7t2EPJGIg&oe=6AD0EAF4"}, "display_name": "The Lightkeepers", "keywords": ["Action", "Cooperation", "Shooter", "Exploration", "Survival"], "long_description": "**Sign the contract and take on the darkness!**\n\nGrab your weapons and face an unequal battle against the nightmares of the deep! The Lightkeepers is a cooperative action game where you\u2019ll fight for your life until every dawn!\n{1559235318527291}\n**Explore mysterious locations**\n\nSail during the day to discover mist-shrouded islands, explore ruins and venture into forgotten undergrounds. Increase your resources and wealth!\n{1948071269123010}\n**Prepare for danger**\n\nUse your resources, share responsibilities, craft grenades, lay mines, feed the hungry, heal the wounded\u2026 danger is coming!\n{1653339643020741}\n**Fight for survival**\n\nTo arms! Slash, chop, shoot and blow things up. With over 20 weapons to choose from there\u2019s something for everyone. Plan your tactics or revel in the chaos of battle. Any strategy is good\u2014as long as the light doesn\u2019t go out!\n{814648988334063}\n**Key Features:**\n\n- **Marine exploration:** Travel by boat between lands scattered across the sea.\n- **Hand-designed islands:** Randomly selected, carefully crafted side locations \u2013 full of puzzles, dungeons and variations ensuring replayability.\n- **Progression between missions:** A meta-progression system allowing you to unlock and upgrade your starting weapons and cosmetics for your character.\n- **Tactical combat and crafting:** A wide range of enemies and bosses, crafting consumables (mines, grenades, healing items) and fortifications.\n- **Rich atmosphere:** A mysterious world set in the 1920s inspired by the works of H.P. Lovecraft.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Spectral Games SA", "support_website_url": null, "website_url": "https://spectralgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "38412540915057563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673558985_2676619209399085_4365178035510951732_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP86FdBTKeYQ7kNvwGzl1sw&_nc_oc=Adp7Ze97v-oAtJcBlEX8ZpU2JUVUtmCPObC3Xum63E1f8nrfgO2uQxDoQTqqyHdvB1o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkOTX_2V5Pu5sk3JoduIx_EN4-IS_sgqPeBxs_n_lmnA&oe=6AD0D674"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Lightkeepers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date"
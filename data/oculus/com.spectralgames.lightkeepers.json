0_AQMd6N7swbY0BS_N9OsJee0ysaow5GKGLZdFg40RUCxqDA&oe=6AC2670D"}, {"file_name": "LH_Screenshots_003.png", "id": "900255526159763", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304162_900255529493096_968382495594289780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufgEyJDghhIQ7kNvwEGap3B&_nc_oc=AdpsV8kg8LZoRPJhxGV3TxxQQzxUhKeX-eQZFZWl1nEEEbFp3BDfd8lst9Gc75GtUwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgYEPWOglfMYvPN6pq93MQDvDV3cidHTOTnIulU6eGuw&oe=6AC263F3"}, {"file_name": "LH_Screenshots_004.png", "id": "1584014739521233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_1584014742854566_8199837553397451526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gi8Ge1fZFCYQ7kNvwHyWwvY&_nc_oc=AdoDELyP9KG5h9Jc-HNzAIhKHp8krn-QJav3u4ZmPrHRh7Ccs0DVqjMw3B0FMK-hwxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpHetxoGhlqKiG_Zsvu077ug8LC9Ja_1fyU1ERsq-nEg&oe=6AC279D8"}, {"file_name": "LH_Screenshots_005.png", "id": "925390223613060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_925390230279726_6732078942718189025_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf56td92izcQ7kNvwGxLnAf&_nc_oc=AdqWGwHSA8TdKy2WMEqpzHUguV57KDWAa1XOIhMNk3NE-5F8Z6E8OGK3Vvg7oq0DBdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGRzEQvSTfyV97Qd5XnD0i-YmbcA9ikc3pMmRM9szNiQ&oe=6AC274BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "The_Lightkeepers_Landscape_ABtest_rainyday.png", "id": "1299921518755745", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1299921525422411_950095365467128802_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZfXOwmOOr4Q7kNvwFu6ayf&_nc_oc=AdrhRscuhDZrolp1ETm-cr6-jsd_CjOGHPVENd4XQCjz5oIg0W7hr3ntNTRMbs7BXX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb8CQRYL3FByLmu24f63NfxTC7brH-5BBn1PIsO5RXJA&oe=6AC26A74"}, "display_name": "The Lightkeepers", "keywords": ["Action", "Cooperation", "Shooter", "Exploration", "Survival"], "long_description": "**Sign the contract and take on the darkness!**\n\nGrab your weapons and face an unequal battle against the nightmares of the deep! The Lightkeepers is a cooperative action game where you\u2019ll fight for your life until every dawn!\n{1559235318527291}\n**Explore mysterious locations**\n\nSail during the day to discover mist-shrouded islands, explore ruins and venture into forgotten undergrounds. Increase your resources and wealth!\n{1948071269123010}\n**Prepare for danger**\n\nUse your resources, share responsibilities, craft grenades, lay mines, feed the hungry, heal the wounded\u2026 danger is coming!\n{1653339643020741}\n**Fight for survival**\n\nTo arms! Slash, chop, shoot and blow things up. With over 20 weapons to choose from there\u2019s something for everyone. Plan your tactics or revel in the chaos of battle. Any strategy is good\u2014as long as the light doesn\u2019t go out!\n{814648988334063}\n**Key Features:**\n\n- **Marine exploration:** Travel by boat between lands scattered across the sea.\n- **Hand-designed islands:** Randomly selected, carefully crafted side locations \u2013 full of puzzles, dungeons and variations ensuring replayability.\n- **Progression between missions:** A meta-progression system allowing you to unlock and upgrade your starting weapons and cosmetics for your character.\n- **Tactical combat and crafting:** A wide range of enemies and bosses, crafting consumables (mines, grenades, healing items) and fortifications.\n- **Rich atmosphere:** A mysterious world set in the 1920s inspired by the works of H.P. Lovecraft.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/priva
_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWTofuRnCnRDbna65sQP9o6I1XKfj63o8T0wfhekU0oA&oe=6AF8ACCD"}, {"file_name": "LH_Screenshots_003.png", "id": "900255526159763", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304162_900255529493096_968382495594289780_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7060sbwM5d0Q7kNvwH5ESdL&_nc_oc=Adpjl24qYZCqqtBvSHwkoeGmfPQHnFRdBCzx_60UKI5TxkzRLbstjutVLxApYxSqOX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStqdV98VNJnmOdJO23j_HlEKykncx7wWga4SPwasGEtA&oe=6AF8A9B3"}, {"file_name": "LH_Screenshots_004.png", "id": "1584014739521233", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_1584014742854566_8199837553397451526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msqOLNLChgIQ7kNvwGRprUu&_nc_oc=AdoQvSeuFP--N4sadYOYdj9xI47TH525RSpHhD8wOEOqkc3Y-RmX1EB-B41WyYAYa9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgEY7FZm_6fqH_MH37sfFe0nZkWz-jS6795RZdnLYXeg&oe=6AF88758"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_halloween.png", "id": "1804894987225886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1804894990559219_899447881280693686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f4w1jqn6JwQ7kNvwHD2sE9&_nc_oc=AdoqikfAOhWwtBUc1XmzuKeVuG7sQvBKbaNDWIxtMyMmjjNASH3Enw_Kkentp8YpU9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWl3Jd0Y6RLwWHWpQMaOUuPc93DaoZYVOOXRQWVo1IUQ&oe=6AF89C1A"}, "display_name": "The Lightkeepers: Protect the Lighthouse", "keywords": ["Cooperation", "Shooter", "Exploration", "Survival", "lighthouse"], "long_description": "**Sign the contract and take on the darkness!**\n\nSign the contract \u2013 explore islands by day. Fortify your lighthouse and survive waves of nightmares by night. Progress your character between contracts in the social lobby. Play solo or with friends via Party Finder \u2013 finding your next mission buddy in no time.\n\n{1559235318527291}\n**Explore mysterious locations**\n\nSail during the day to discover mist-shrouded islands, explore ruins and venture into forgotten undergrounds. Increase your resources and wealth!\n{1948071269123010}\n**Prepare for danger**\n\nUse your resources, share responsibilities, craft grenades, lay mines, feed the hungry, heal the wounded\u2026 danger is coming!\n{1653339643020741}\n**Fight for survival**\n\nTo arms! Slash, chop, shoot and blow things up. With over 20 weapons to choose from there\u2019s something for everyone. Plan your tactics or revel in the chaos of battle. Any strategy is good\u2014as long as the light doesn\u2019t go out!\n{814648988334063}\n**Key Features:**\n\n- **Marine exploration:** Travel by boat between lands scattered across the sea.\n- **Hand-designed islands:** Randomly selected, carefully crafted side locations \u2013 full of puzzles, dungeons and variations ensuring replayability.\n- **Progression between missions:** A meta-progression system allowing you to unlock and upgrade your starting weapons and cosmetics for your character.\n- **Tactical combat and crafting:** A wide range of enemies and bosses, crafting consumables (mines, grenades, healing items) and fortifications.\n- **Rich atmosphere:** A mysterious world set in the 1920s inspired by the works of H.P. Lovecraft.", "short_description": "Explore, strategize and fight for survival in this VR action co-op. The day invites discovery, the night commands vigilance. Stand united with your team against tides of foes straight from nightmares, wielding light against the shadows' threats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectralgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Spectral Games SA", "support_website_url": null, "website_url": "https://spectralgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "co
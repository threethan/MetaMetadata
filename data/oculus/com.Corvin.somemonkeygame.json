8427537247614_5032481525030702344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUXJeQSPBHYQ7kNvwFZv1Fp&_nc_oc=Adp8i4H4GPkMYGVudDYUEalpMju99ydvQnZrd-s-naOTZLYL8WVvXQ4cXfDSDfzqgSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1_3RzUlXZTF9tqTSXBvmYRPr9nsA4BthlHVlPPKZMlw&oe=6AA802CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled project (63).png", "id": "908962888924457", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_908962895591123_417908636998737409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbqcSVrRdnEQ7kNvwEeLPx3&_nc_oc=Adp_bYJ5LeZhIU7yYh1xMey89ANDhgtT6lVP6eUwunM5d65vJuaesWKMPITWK0N6pT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDDeHSPRJ4yXAz7IXXU0v1z0f5_23JfTwnw8nZkaGRVw&oe=6AA80D31"}, "display_name": "Some Monke Game", "keywords": ["tag", "gorilla", "fangame", "somemonkegame", "monkey"], "long_description": "Some Monke Game gives you a choice of game modes and cosmetics, which you can browse and unlock in the shop. The floating islands, where the PvP area is located, are waiting for you to explore and conquer. Battle other players and show them whos the strongest.\n\nThe zero-gravity zone doesn't just let you fly, it completely changes the way you move and play. Push off walls, drift through open space, and experience a sense of freedom. If you are just enjoying the view, this zone makes you feel like you've stepped into a completely different world.\n\nWith a growing collection of cosmetics to collect and show off, no two players look quite the same. Customize your look, jump into a match, and see how you stack up against the competition.\n\nBut not everything in this world is friendly...\n\nDeep in the shadows of the arena, something else lingers. Legends speak of a haunting melody, a twisted, broken version of an old childhood tune, that echoes through the walls when a certain cosmetic is worn. And if you stray too far into the dark... you might just meet the Reaper. Few have seen the scythe up close. Fewer still remember what happened next, they simply vanished from the match, cast out into the void.\nSo be aware of everything.", "short_description": "Some Monke Game is a small but still upcoming game to play with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/somemonkegamevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Corvin", "support_website_url": null, "website_url": "https://sites.google.com/view/somemonkegamevr/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1093948523146783"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827567_1436996081817368_6798249707381145258_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbhI8URKVRkQ7kNvwHr8Buc&_nc_oc=Adpc3-NXwug98JGe7WkJZ0HJVyInJai2w599X9CgcD-MdplPe-dOYlpY5iFQSIUhkAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2mBUs0sJ5FAy6cfMvaFuz8nqyLEixgiBMKcWmNjkhDw&oe=6AA7F969"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Some Monke Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"
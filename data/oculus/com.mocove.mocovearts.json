nc_ohc=5Rejf3ORTbwQ7kNvwFUDMXI&_nc_oc=AdrFyQBSxfHJg6TR-C2Xic4O7mqoxqluMwJx6stshNeSZjW1vEyX2UX9trx6uXICY68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQibYaJcbOuAXRf_DXPTJpnLQe0BrL1YgLKtBpkp1qjsw&oe=6AFDC105"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mocove Arts", "keywords": ["Art", "Museum", "Education", "Painting", "Gallery"], "long_description": "Explore the best paintings from human art history in Mocove virtual space museum. \n\nCollection of masterpieces in major art movements - Impressionism, Baroque, Futurism, Surrealism, Abstract Expressionism, Cubism, Dada, Fauvism, Renaissance, Post-Impressionism, Pointillism, Divisionism, Symbolism, Rococo, Romanticism, Metaphysical. Artworks from the most famous 104 artists, including Da Vinci, Van Gogh, Rembrandt, Michelangelo, Claude Monet, Pablo Picasso, Raphael, Paul Cezanne, Salvador Dal\u00ed, Titian, Henri Matisse, Paul Gauguin, and more. \n\nDiscover Mona Lisa, The Last Supper, Starry Night, The Scream, Girl With A Pearl Earring, Guernica, Cafe Terrace at Night.\n\nEnjoy 14 pieces of soothing classical music from Mozart, Brahms, Straus, Shubert, Tchaikovsky.", "short_description": "Explore the top thousand paintings from human art history in virtual space museum."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mocove.com/apps.mocovearts.privacypolicy.ws", "developer_terms_of_service_url": "http://mocove.com/apps.mocovearts.termsofuse.ws", "publisher_name": "Mocove Studio", "support_website_url": null, "website_url": "http://mocove.com/apps.mocovearts.productinfo.ws", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
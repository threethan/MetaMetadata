on.)", "short_description": "Discover magical gardens. Throw cookies. Catch veggies."}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://www.meepengine.com/cookie-gardening-demo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://www.meepengine.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FOOD", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26781517394867639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974534_1479561436196991_819995255387765739_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AH9uaQKdj74Q7kNvwGlZHIt&_nc_oc=Adr3Gtez-aaB3_krAXauBFOQElbP1LH9iglJcf6U7GlnHmRa_WbH1SokncQncOB54ms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVSdtqNFRHV3e6UJC6GI8JxyBjEx7OL0vqvOJq55njQA&oe=6A9D663A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cookie Gardening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1652490000, "lastRevision": {"nodes": [{"id": "510949393640236", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applica
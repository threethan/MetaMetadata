y a carrot in a hat! \nDecorate a cute home to share with your favorite veggies!\n\nAnd never forget: you're surrounded by friends.\n\nJoin the Cookie Gardening Discord for updates: https://discord.gg/Stw3W2xHv3\n\n(Please note, there's currently no way to transfer your save file from the demo to the full version.)", "short_description": "Discover magical gardens. Throw cookies. Catch veggies."}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://www.meepengine.com/cookie-gardening-demo-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://www.meepengine.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FOOD", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26781517394867639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974534_1479561436196991_819995255387765739_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw1uXRdqD7gQ7kNvwEdg-8x&_nc_oc=Adr2No6HF1l20o8v3BFLpHfwozRs0SEXQTte3nc6Ta1LXhx3ikNphj-97rqrn0wmKUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaQm_t1xCJS-wh8AUGXv-3Rc4Cmsdv6MTMh0MmaElodw&oe=6AFF2D7A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cookie Gardening Demo", "platform": "A
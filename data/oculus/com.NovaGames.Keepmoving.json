scdn.com/v/t64.5771-25/499620429_1580395013018129_6167266565014333642_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWtlKNnmA3QQ7kNvwHFXWvq&_nc_oc=AdrvpZSq7c4BBRbcKeJXx9UL3Wy-NZW0eM14KVPXJxC26C40RSI8tE0cNlV9IzB2ZAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bdxdGxZj4iS2MdTyHxLpUDRqbdjuZTvIZGy7F7atv2Q&oe=69ECA0B6"}, {"file_name": "Main_Custom..._07.04.2026_17-18-54.png", "id": "813192261338501", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617719_813192264671834_8361375546389478613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKfpW9hdr_0Q7kNvwEnvts6&_nc_oc=AdqCqhJq98fcZuTeM76xRjehlc7Oe3zzgFsC_56sdGdywpR9Ykl61r_J9NPdNx-qXxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0beK_ecS_p4OztaajtXpt2HSXdCuAVAXwZlFR_z2nhfw&oe=69ECD156"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keep Moving", "keywords": [], "long_description": "Welcome to KEEP MOVING we\u2019re hyped to have you here. This isn\u2019t your average movement system. Forget joysticks and old-school locomotion: your hands are everything. Using a Gorilla-style locomotion system, you\u2019ll climb, launch, swing, and flow through the world naturally, becoming one with the environment around you. Movement feels smooth, fast, and instinctive, letting you focus on the experience instead of the controls.\n\nIn KEEP MOVING, the goal is simple, but the action never slows down. Whether you\u2019re racing across maps, outmaneuvering other monkeys, or just enjoying the movement itself, multiplayer adds a whole new layer of intensity. Outsmart, outpace, and outplay other players using nothing but your hands and momentum. The mechanics are easy to learn in minutes, but mastering movement and beating your opponent's takes practice, awareness, and skill.\n\nWhat makes KEEP MOVING special is how natural everything feels. There\u2019s no complicated setup or confusing controls \u2014 you move how you think you should move. Jump when you push, climb when you reach, and gain speed through smart movement and flow. Whether you\u2019re chasing victory in multiplayer matches or just enjoying the freedom of movement, KEEP MOVING delivers a fast, fluid, and unforgettable Gorilla-locomotion experience unlike anything else.", "short_description": "Welcome to KEEP MOVING we\u2019re hyped to have you here. This isn\u2019t your average movement system. Forget joysticks and old-school locomotion: your hands are everything. Using a Gorilla-style locomotion system, you\u2019ll climb, launch, swing, and flow through the world naturally, becoming one with the environment around you. Movement feels smooth, fast, and instinctive, letting you focus on the experience instead of the controls.\n\nIn KEEP MOVING, the goal is simple, but the action never slows down. "}]}, "developer_name": "zdee", "developer_privacy_policy_url": "https://sites.google.com/view/keep-moving-web/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "zdee", "support_website_url": null, "website_url": "https://sites.google.com/view/keep-moving-web/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25392601283749403"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623345_1428277271835986_3220130757966346901_n.png?stp=dst-png_s360x360&_nc_ca
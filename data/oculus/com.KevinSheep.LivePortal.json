c_ohc=RLPANODJ-8MQ7kNvwHDkeqF&_nc_oc=AdrCEvxUbH8mUbA5mBz-bIas-EIjVNrkn-p3HurYzr0GIJb6RfiO50AC1RUKC-GNbAM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvmCtqw3hJGWwoe4U-mbrkTo2uIAEjC19GJlI56-v8Bw&oe=6A51019D"}, {"file_name": "Screenshot_03.png", "id": "1088260976314608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393518_1088260979647941_6095177650955852476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-sspyoBxrQQ7kNvwGhqOsV&_nc_oc=Adr7HjrdvpXgznU75WzEZ0sCJUwan46V9vTWmYp4E_w-IWoBfjQs2SYn5SD-XQQVqhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkgk0CwRs8yqtx9UZ59LdVc7k_g4rLWBOwNgh6UWxoxw&oe=6A50EFB7"}, {"file_name": "Screenshot_04.png", "id": "1118745119897057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394059_1118745123230390_419191193862329847_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIJhe_zyq4sQ7kNvwHfONGd&_nc_oc=AdossU7xa1oQuv6VWk7v_dMLj2eZx-rHaZoAkrsThrP7seyDe-Vq8-cYO2n_vAhwJrk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8j8BoszxL3GDcE3bvObpFGGwu8Gm7R6ugUdjhpjHLfQ&oe=6A50FFC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LivePortal", "keywords": ["SpatialVideo", "LivePortal", "MixedReality", "6DoF", "RealTime"], "long_description": "Redefine your spatial video experience with LivePortal!\nThis innovative Mixed Reality (MR) application seamlessly blends real-time rendering, dynamic virtual content, and the real world to provide you with a free and comfortable sense of immersion.\n\nReal-Time Rendered Spatial Video: Unlike traditional pre-recorded videos, LivePortal offers an immersive six degrees of freedom (6DoF) viewing experience, bringing every scene to life.\nComfortable and Natural MR Video Experience: Say goodbye to motion sickness and intrusive space designs. LivePortal creates a content window that\u2019s perfect for long periods of immersive exploration.\nDiverse Content Selection: Explore endless possibilities with a variety of content, including real-world, virtual, and AI-generated experiences\u2014making every moment a delightful surprise.\nStart your journey with LivePortal today and step into a world of infinite possibilities!", "short_description": "LivePortal is a cutting-edge spatial video MR application that delivers a true sense of spatial immersion and offers a wide variety of captivating content."}]}, "developer_name": "SuperMorning", "developer_privacy_policy_url": "https://sites.google.com/view/liveportal-en", "developer_terms_of_service_url": null, "publisher_name": "KevinSheep", "support_website_url": null, "website_url": "https://sites.google.com/view/liveportal-main", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24270237389234424"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "9289020551160225"}]}, "baseline_offer": {"id": "9289020551160225"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738207620, "status": "PUBLISHED", "id": "9289020551160225"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28690063423918443", "version": "1.0"}, "id": "1052381675930819", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__t
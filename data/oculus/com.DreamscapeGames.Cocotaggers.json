luscdn.com/v/t64.5771-25/473391872_1141452271011799_8081109573845456723_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njmI_U9YRxgQ7kNvwFhoWgT&_nc_oc=Adn9DFQcWUHySlG3mxrPqi6uVCapgMb7D1Q-nHQ3-Yb4AJN8YHPvD3LSt0oyufZIFiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOyfOjedJO05iPijb6ehwoGpUTB-Q9cH4dxVHe-JxKUQ&oe=69B41F7B"}, {"file_name": "Untitled design (2).png", "id": "1301132381112727", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391991_1301132384446060_7336786536771111987_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tyTkOn26_oQ7kNvwHn_hzz&_nc_oc=Adll4l8wsLbyj9ph29yBHnDihZTA831Wj47N4OuoZM823z9G_gAtcziGxxdg_isYopc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRBYbyl9sLvqJXMgXULsPrqpBGxMZp69lWlxXg2uO57w&oe=69B40005"}, {"file_name": "Untitled design (1).png", "id": "2446106325766942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393406_2446106329100275_5437302389134298625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5uMj587tvMQ7kNvwGfkRI_&_nc_oc=AdmL5xC7SrRD95XSdWg7_E1fq25hSLRvie2Og5gs3v4KaTuD8eCrisJ01sxOlRYi9wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAFSED_dZLEf-ZdEOJ6DYTUGJ42BLoqWmBF-9rM4h1Yg&oe=69B41E22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco Taggers", "keywords": ["Taggers", "Tag", "Coco"], "long_description": "Introducing the ultimate thrill-seekers delight: the Coco Taggers Game! \ud83c\udf89 This exhilarating game is designed for those who love to unleash their inner monkey and engage in a wild chase with friends. Picture this: vibrant colors, playful designs, and a lightweight, portable setup that makes it perfect for any outdoor adventure! Whether you're at the park, beach, or backyard, this game is your ticket to endless fun. The rules are simple yet electrifying\u2014tag your friends and avoid being tagged, all while showcasing your agility and speed. Get ready to swing into action! But wait, there's more! The Coco taggers Game isn't just about tagging; it's about creating unforgettable memories with your loved ones. With its easy-to-understand gameplay, everyone can join in on the fun, making it a fantastic choice for family gatherings, birthday parties, or friendly competitions. So, gather your crew, unleash your playful spirit, and let the monkey business begin! This game promises laughter, excitement, and a whole lot of fun\u2014don't miss out on the adventure!", "short_description": "A gorilla with no legs playing tag in forest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-xmas22/home", "developer_terms_of_service_url": null, "publisher_name": "Coco", "support_website_url": null, "website_url": "https://sites.google.com/view/projectchristmasv1/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9315675121821727"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9440292296026675", "version": "CHRIZMA23"}, "id": "1349728216446573", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary
luscdn.com/v/t64.5771-25/473391872_1141452271011799_8081109573845456723_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE_vTXKl4-sQ7kNvwELbW8P&_nc_oc=Adrdn4JcyAXmlkLC1BP7LZvUXxrJGon0nfmqgb5fdQogwzZUVkBlS0mF59UfeFHOB1A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afws58HxjqoZcHumq8rtSqXSzp91g-cJlL6dMuEHX5yxxQ&oe=69C14E7B"}, {"file_name": "Untitled design (2).png", "id": "1301132381112727", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391991_1301132384446060_7336786536771111987_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LynhrJ8XK8Q7kNvwFvlYCt&_nc_oc=AdqH_Hz1VTbxHxGeN37Hty0uCZwZsjmszUZx6fZnPm_dW45xSy693cTRohNi2vLOSxY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8YWW95GmtWbbODhsKLldNlp75XKRDzjF5hGR3tf_czQ&oe=69C12F05"}, {"file_name": "Untitled design (1).png", "id": "2446106325766942", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393406_2446106329100275_5437302389134298625_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MtdTl6T-18Q7kNvwECN8yk&_nc_oc=Ado496sqmCShbNYTLCKKw4p_YdhiYdxz9xy1XQQjyTtmmBm5PGAEGqF7xU6jYHEXVCg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwh6uY4ME4Fb4Lf6p1CxRewr-9dzl_Rc4aaR6xBTmuoAg&oe=69C14D22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco Taggers", "keywords": ["Taggers", "Tag", "Coco"], "long_description": "Introducing the ultimate thrill-seekers delight: the Coco Taggers Game! \ud83c\udf89 This exhilarating game is designed for those who love to unleash their inner monkey and engage in a wild chase with friends. Picture this: vibrant colors, playful designs, and a lightweight, portable setup that makes it perfect for any outdoor adventure! Whether you're at the park, beach, or backyard, this game is your ticket to endless fun. The rules are simple yet electrifying\u2014tag your friends and avoid being tagged, all while showcasing your agility and speed. Get ready to swing into action! But wait, there's more! The Coco taggers Game isn't just about tagging; it's about creating unforgettable memories with your loved ones. With its easy-to-understand gameplay, everyone can join in on the fun, making it a fantastic choice for family gatherings, birthday parties, or friendly competitions. So, gather your crew, unleash your playful spirit, and let the monkey business begin! This game promises laughter, excitement, and a whole lot of fun\u2014don't miss out on the adventure!", "short_description": "A gorilla with no legs playing tag in forest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-xmas22/home", "developer_terms_of_service_url": null, "publisher_name": "Coco", "support_website_url": null, "website_url": "https://sites.google.com/view/projectchristmasv1/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9315675121821727"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9440292296026675", "version": "CHRIZMA23"}, "id": "1349728216446573", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary
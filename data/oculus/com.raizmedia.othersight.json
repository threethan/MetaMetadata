G3FBXfQWadQrsGA&oe=6B0C68C6"}, "display_name": "OtherSight", "keywords": ["travel", "world", "tourism", "traveling", "photogrammetry"], "long_description": "A museum in Madrid, a back alley from Tokyo, a famous street in Havana...\nYou will enjoy the real approach of traveling in VR. Discover amazing places around the world captured in breathtaking quality through scanning methods.\n\nBe amazed by each place, walk through it, interact with the environment and immerse yourself in the ultimate VR travel experience. You'll be there!\n\nThe list of available places will be updated soon.\n", "short_description": "Explore different places of the world!  Digital trips for your oculus Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.raiznewmedia.com/othersight/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Raiz Media S.L.", "support_website_url": null, "website_url": "http://www.raiznewmedia.com/othersight/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "665691204442501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395592_2175473419259512_8143154233986141753_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rAnDEL21FQQ7kNvwE8Dsc_&_nc_
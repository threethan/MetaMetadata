_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rywjssmQr4kQ7kNvwGRXO6n&_nc_oc=AdqyHU3rmZJTr3XWM4E7Sp7cs3K7NUayMIhwiReK_NvZIRJhF_KndboWVaVt4j0v_aY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjQ8D5I0QpVe5m_ofWLW48Cmxpn66gXfcNs1-jqf9Nzw&oe=6AC12675"}, {"file_name": "Screenshot from WhatsApp (2).png", "id": "3203247983159099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_3203247986492432_6521301773675641097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IphLx7ewMzYQ7kNvwHqfIdB&_nc_oc=AdozbKk9tl_pqaz-TSGXo-p3yUHHN242HKTQfRYhqTpU3IBIUM5qN3h9fOB0u3EtKaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0yAv175Mk3UEzXEMKWlgX7qh1k6pWAb4Yl27MYspmVg&oe=6AC13262"}, {"file_name": "Screenshot from WhatsApp (1).png", "id": "1227361819216906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_1227361825883572_7938275209255497536_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgK7J9x74XYQ7kNvwHNQ1Xp&_nc_oc=AdoolXU_dQmvmAnBMFZkNpO_LURKWhxyPppV-mQ6Dj_b7Y-xSSYfy3aO4r4L_1hKRHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw1Yr38tKvw5eYWskMk9sg4x9dQxCzEhPdJFf3v4jdsw&oe=6AC132CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art from WhatsApp.png", "id": "801150066137384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_801150069470717_1010000548679113475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ShSRGcXN3EQ7kNvwF_RGcw&_nc_oc=Ado01QjdXEbhNoH467ng1TQpvrcHC8LIiPUhA24HCoh3OSrLcD7QXlmiahGOOWKYwOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZeww8_k8yGaI5prLn5YwLGFtstr2e0bR-qvVbWNPWfQ&oe=6AC13375"}, "display_name": "Snow Crash", "keywords": ["snow", "christmas", "multiplayer", "winter", "fun"], "long_description": "# Welcome to the Coziest Chaos in VR\n\nWhere bobbles meet, chill, and gear up before diving into unpredictable mini-games! \n\n# Explore the Island\n\nYour snowy village hub packed with secret collectibles, dark caves, climbing towers, and sneaky little Cogloos to chase.\nHang out with friends, chat, and spam emotes while showing off your style as you queue for the next mini-game.\n\n{2018870528948726}\n\n# Drop into Wild Mini-Games\n\n**Maze** \u2013 Outrun the Monster. Push everyone off. Find the exit (or die trying).\n\n**Jurassic** \u2013 Hunters team up to blast Team Dinos. Pure panic.\n\n**Snowfight** \u2013 Shrinking zone. Snowball mayhem. Only one bobble survives.\n\n{4093471060982318}\n\n# Cook Your Look\n\nWin games and get gold. Or find hidden collectibles and trade for gold. Then equip the most unhinged accessories in VR. Yes even Skibidi toilets and bananas!\n{1091445512882800}", "short_description": "Welcome to Snow Crash \u2014 a cozy VR island filled with wild mini-games. Explore, climb, and laugh through dino hunts and snowball fights with friends. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/scl/fi/a1pczk314uxxvk1vpi2pr/Snow-Crash-Privacy-Policy.paper?rlkey=ryv8z1bugqp2jucplfbpx540i&st=qpkzlrmg&dl=0", "developer_terms_of_service_url": null, "publisher_name": "Evermorrow Labs", "support_website_url": null, "website_url": "https://evermorrowlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27589894974046872"}, "review_message
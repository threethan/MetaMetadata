_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVZrxJDlnycQ7kNvwEZXe0G&_nc_oc=AdrSWw414-J0j1Ode4kIydKyb3--AAG3pkVE52YBwva-RZVZ1Pyh8HOcoI658oiUS2U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFAU49QmWo6FrKQRFSgyEuPMSdZ7s9QclJFBCcw4z_Aw&oe=6A9D55B5"}, {"file_name": "Screenshot from WhatsApp (2).png", "id": "3203247983159099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_3203247986492432_6521301773675641097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEJhmEAfgVEQ7kNvwEDtDnB&_nc_oc=Adote3IEPNSYFJ51JxajKPcQMv7AGdOPmhaZK-IzQ2b--Vfz9jUa2ZhlrzzY7tntCR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ6bY7kYi_cn1j2LpkNrr2vs0vC1fQAEvje8WnqCtidQ&oe=6A9D61A2"}, {"file_name": "Screenshot from WhatsApp (1).png", "id": "1227361819216906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819982_1227361825883572_7938275209255497536_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MhfUd1cCf8Q7kNvwFpBASE&_nc_oc=Adr5Xp24L46kROB2FxWn0EYwSlWTxR1Ur3AxoNAGf50N8Ehy_M2XpYxkUB6HGDoOhkY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlndi2mekGG_kp-ujI4-KRYsR7cMH8E1Dfh_Z5dOHq1g&oe=6A9D620B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art from WhatsApp.png", "id": "801150066137384", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819982_801150069470717_1010000548679113475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fK7RcMr1dtMQ7kNvwFLj0-N&_nc_oc=AdoY0QwxJUQ5Yjc_SdZJKaxcBqf9rqfhAIy8VsZws8pHufoH5KSF2fngghdk5plXuNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEmBZ2e8j7I7sYqMPlY_eXQ_rvT-B1jwRP5eOw4hKfpQ&oe=6A9D62B5"}, "display_name": "Snow Crash", "keywords": ["snow", "christmas", "multiplayer", "winter", "fun"], "long_description": "# Welcome to the Coziest Chaos in VR\n\nWhere bobbles meet, chill, and gear up before diving into unpredictable mini-games! \n\n# Explore the Island\n\nYour snowy village hub packed with secret collectibles, dark caves, climbing towers, and sneaky little Cogloos to chase.\nHang out with friends, chat, and spam emotes while showing off your style as you queue for the next mini-game.\n\n{2018870528948726}\n\n# Drop into Wild Mini-Games\n\n**Maze** \u2013 Outrun the Monster. Push everyone off. Find the exit (or die trying).\n\n**Jurassic** \u2013 Hunters team up to blast Team Dinos. Pure panic.\n\n**Snowfight** \u2013 Shrinking zone. Snowball mayhem. Only one bobble survives.\n\n{4093471060982318}\n\n# Cook Your Look\n\nWin games and get gold. Or find hidden collectibles and trade for gold. Then equip the most unhinged accessories in VR. Yes even Skibidi toilets and bananas!\n{1091445512882800}", "short_description": "Welcome to Snow Crash \u2014 a cozy VR island filled with wild mini-games. Explore, climb, and laugh through dino hunts and snowball fights with friends. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/scl/fi/a1pczk314uxxvk1vpi2pr/Snow-Crash-Privacy-Policy.paper?rlkey=ryv8z1bugqp2jucplfbpx540i&st=qpkzlrmg&dl=0", "developer_terms_of_service_url": null, "publisher_name": "Evermorrow Labs", "support_website_url": null, "website_url": "https://evermorrowlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27589894974046872"}, "review_message
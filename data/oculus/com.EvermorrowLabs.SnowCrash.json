_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9uKeAlh9eQQ7kNvwHmxTCx&_nc_oc=Adq9ohHZSdnCTpSYa0tZrbL3lMHrzyY7RLLDSdxRCaaCZRH-54XybAMZehsVZHoJjv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqawMwd-uoPJZ8pN8UPHBVCv7TlHzijCzJCp9qcDNF7Q&oe=6AAC0E75"}, {"file_name": "Screenshot from WhatsApp (2).png", "id": "3203247983159099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_3203247986492432_6521301773675641097_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d33FX_PlDtEQ7kNvwGUv-dv&_nc_oc=Adp1DA5VzHBvenF-rOz0-R2lMbEQQneb6XhIUE9R0vsG_IvhxAHOSfimo3-WBD8Xy_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQFC0VPYy96oT9iJSzT6r7iUxUIAl_HfmXQqWKNCMNRw&oe=6AABE222"}, {"file_name": "Screenshot from WhatsApp (1).png", "id": "1227361819216906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819982_1227361825883572_7938275209255497536_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5nH5C-CzlgQ7kNvwFMdIai&_nc_oc=Adp1qB-k2vNQdX4IXW3eUQPE2a7H5MzNbgz1FoHjrP-mRbdHFvsh8d8V0rh_ytQtCPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi7T8jj0kjxjTZDsBzddROcWQqPnc-R8KOZe0rC3pLNA&oe=6AABE28B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art from WhatsApp.png", "id": "801150066137384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_801150069470717_1010000548679113475_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOeJwr2NH7UQ7kNvwHoZBlZ&_nc_oc=AdqmuoS6DY64m_6g2cJBbbgK_3MzRhWnAdrgXbRBLJ0xrT9dkQEz9lN5TA7KEeFd_R4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITZmdWz6GiCtYhl2xkXNNMMhkzb55qep_qOA5lNanurQ&oe=6AABE335"}, "display_name": "Snow Crash", "keywords": ["snow", "christmas", "multiplayer", "winter", "fun"], "long_description": "# Welcome to the Coziest Chaos in VR\n\nWhere bobbles meet, chill, and gear up before diving into unpredictable mini-games! \n\n# Explore the Island\n\nYour snowy village hub packed with secret collectibles, dark caves, climbing towers, and sneaky little Cogloos to chase.\nHang out with friends, chat, and spam emotes while showing off your style as you queue for the next mini-game.\n\n{2018870528948726}\n\n# Drop into Wild Mini-Games\n\n**Maze** \u2013 Outrun the Monster. Push everyone off. Find the exit (or die trying).\n\n**Jurassic** \u2013 Hunters team up to blast Team Dinos. Pure panic.\n\n**Snowfight** \u2013 Shrinking zone. Snowball mayhem. Only one bobble survives.\n\n{4093471060982318}\n\n# Cook Your Look\n\nWin games and get gold. Or find hidden collectibles and trade for gold. Then equip the most unhinged accessories in VR. Yes even Skibidi toilets and bananas!\n{1091445512882800}", "short_description": "Welcome to Snow Crash \u2014 a cozy VR island filled with wild mini-games. Explore, climb, and laugh through dino hunts and snowball fights with friends. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/scl/fi/a1pczk314uxxvk1vpi2pr/Snow-Crash-Privacy-Policy.paper?rlkey=ryv8z1bugqp2jucplfbpx540i&st=qpkzlrmg&dl=0", "developer_terms_of_service_url": null, "publisher_name": "Evermorrow Labs", "support_website_url": null, "website_url": "https://evermorrowlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27589894974046872"}, "review_message
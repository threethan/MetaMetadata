"en_US", "screenshots": [{"file_name": "store_1_simple.png", "id": "1628857185070391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299891_1628857188403724_1997980739548939358_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gTEi9Qhy1QQ7kNvwGzL9-y&_nc_oc=Ado1mWbd78OOeMco8PUYp2Yd56JSQ84yhNoagmt4rDDU0-i2fueV5vNOwtPXzOk8iww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkI2XEoWBQz-hhSPY0SR3F_cyVInGYsifTyVxoHHyT2g&oe=6A95B963"}, {"file_name": "store_2_simple.png", "id": "2266641963863339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298930_2266641967196672_7328956382705604804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuxFHQlXpG4Q7kNvwEIJTb8&_nc_oc=AdrBNVCNhpc_b8w42wID3TMaVYiEGCVTqXBiqD3bF2IJBwdtP7fuZtaUsLvivrj3LYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKtAxLbkjC3Tty4gdPoFe1YaryHopVUEoOR53cZSh1KA&oe=6A95DEB5"}, {"file_name": "store_3_simple.png", "id": "1367595605288602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293690_1367595608621935_963635202776251142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iz4sUm_cJMkQ7kNvwF3-8Az&_nc_oc=AdoaIrjqWZl5ldnUDV5Hg_bOFBRg3MPW18ybOUlTvXvRvwofqQSToaDz4gw0ZIV-LD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGccXtSKCTy5Vs3-c72KVtD1UyESfcWv3Tjv6BHT23TJw&oe=6A95BA37"}, {"file_name": "store_4_simple.png", "id": "1704827630700024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299093_1704827634033357_998671414957048917_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWj3-Upym9wQ7kNvwHl8NNW&_nc_oc=Adr_QnLz5xktbvWdwRykouNOapDhMmTDpd3NtqXcdoA7siLxMcToxYugqypdSnWhPcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWAO27qemcXDBhMtspUExKWxWoIbfiyzTCB8In-GJXLQ&oe=6A95DE89"}, {"file_name": "store_5_simple.png", "id": "1315206157223713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312068_1315206160557046_8302173888506556361_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2CmTM0Mb7cQ7kNvwFh-TjY&_nc_oc=Adpb51axK0tDbiAGqBbqjGX2-V6P__vaJSrRjjRHlbtkp-cNgQTiJCCvPZEXGGpxZuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFElvKvu62OIizZZHieuztjWSyK9be3r2cUCosme586LQ&oe=6A95ACF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail_3.png", "id": "2816215335392283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_2816215342058949_2822831727495430970_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pASc_D9aXjwQ7kNvwHurYuA&_nc_oc=AdrqmOFxe5Q0D-LkkmwfvVSkwhz3TfyMgRTslkSATZH_bwS28GrFdfTFYrwNMb2ncaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE4509K1KVlrun47hqlzOUnD96Au-d4iQ4MVDr7miHCw&oe=6A95DBA6"}, "display_name": "Eleven HUD TT Companion", "keywords": ["eleven", "table", "tennis", "hud", "bibchik"], "long_description": "Eleven HUD is a complete table tennis companion for any Eleven Table Tennis players. Pin it as a Meta multitasking panel and keep live stats, scouting data, and social tools visible during every match \u2014 no headset off, no menus.\n\n**Play smarter at every level:**\n- **Climb ELO** \u2014 instant opponent insight, recent form, peak rating, and match history in one view  \n- **Prepare for tournaments** \u2014 search any player, review stats, compare profiles, and see win probability before you play  \n- **Stay social** \u2014 friends list, direct and group chat, and community discovery built in  \n- **Find better matches** \u2014 filter global players by ELO and jump into quality games fast  \n- **Track progress** \u2014 sessions, trends, win-rate, and top opponents in your personal profile  \n- **Learn faster** \u2014 coaching resources, guides, and curated training content  \n\n**Premium ($0.99/month):**\n- Paddle Intelligence (detailed equipment stats)  \n- Ball Machine Presets based on opponents  \n- AI-powered player analysis  \n- Faster opponent detection & live updates  \n- Full online player list with advanced filters  \n\n**Free features:**\n- Player search (Detective tab)  \n- Friends & messaging  \n- Opponent Monitor with live match view  \n- Simple account verification (no email/password)  \n\n**Built for Meta Quest:** resize and place the HUD anywhere in your VR space for seamless in-game use  \n\n**Languages:** English, Russian, Portuguese, Spanish, Chinese, Japanese, French, Korean, German  \n\nOpen Eleven HUD next to your game \u2014 and never play blind again.", "short_description": "Your complete companion and live opponent intel for Eleven Table Tennis on Meta Quest \u2014 ELO, paddle, head-to-head, AI scouting and chat, all in a floating panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://champadev.com/eleven-hud/privacy", "developer_terms_of_service_url": null, "publisher_name": "ChampaDev", "support_website_url": null, "website_url": "https://champadev.com/eleven-hud", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "ko", "pt_BR", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26429219013420625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1966770060710569_6696903793266469244_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLDE6--JVPAQ7kNvwGo_yS9&_nc_oc=AdqUKvZNZ4fWlyYIsrqFhv3GLmWpdkzvGnLNO5hLY5EGAzVk_CjxjzwH4
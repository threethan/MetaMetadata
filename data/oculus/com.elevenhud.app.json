"en_US", "screenshots": [{"file_name": "store_1_simple.png", "id": "1628857185070391", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299891_1628857188403724_1997980739548939358_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vo9dvl69JWIQ7kNvwHepOzu&_nc_oc=AdpSpmwBZs1It8_5faL5SG3OfagIbHT4UXCbafNvu_VwQTySfdY42PUD5gqUa_aHwmw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1LuAIz_U17bMXOhwviMRCWJRUXVtIOQxuKx8PBJo6oQ&oe=6AF0B0E3"}, {"file_name": "store_2_simple.png", "id": "2266641963863339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298930_2266641967196672_7328956382705604804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nq44Gw8mRVAQ7kNvwEfm-1K&_nc_oc=AdpbIUabEUOtqzy0HTKNxumQK5LpcRbRSRfr-a6m6EfLdqURs8iGThs_-lubzgntKZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXPJ6KNA3uiMaIfKXWSbtwt1CLNYQUmSaORhwSmuwA6g&oe=6AF09DF5"}, {"file_name": "store_3_simple.png", "id": "1367595605288602", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293690_1367595608621935_963635202776251142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCe8WWUAF2QQ7kNvwFH8GIJ&_nc_oc=AdoqxBo4fmFgbb22nghojxe14hW6dVr7hLpxZbC7ETpc-LN0gqxCy7yya6egFU0V97w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWSXPAUxcuxJ65stbSqpVFvDWS2U2kwK0ZScGrByOEow&oe=6AF0B1B7"}, {"file_name": "store_4_simple.png", "id": "1704827630700024", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299093_1704827634033357_998671414957048917_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cw0h4Ukx52kQ7kNvwFoHg4R&_nc_oc=Adrya11A-yyMAFFeeekkdScBJVnRfUqFMwwRMjM8N0HlpONJL-kMulhqISBm_Fm-fD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWbeblAETKogZ35Uni8SU1TeSJRc_PQJKU74E2cKw9uw&oe=6AF09DC9"}, {"file_name": "store_5_simple.png", "id": "1315206157223713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312068_1315206160557046_8302173888506556361_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhVIbziJDOcQ7kNvwERtd2_&_nc_oc=AdpMYq6lr8gfqMb03qpBnGQcLhAEu_z-IwmTbtcAsd_SoHelsNECsb6U6BHHrGbHwOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYXD5-WRdtWerucDB3qkmGojS0cV3qqfKTegtZ_gPN0g&oe=6AF0A473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail_3.png", "id": "2816215335392283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_2816215342058949_2822831727495430970_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_1ElYnEuo8Q7kNvwEP-VIa&_nc_oc=Adp-N1kAdv906gZQRk5w0q3kOqbbiwhNtrnQeiM0MdFOrRhvU6hM5CupKC2bnbTymgI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRNkN1Vo7_rLGRv0QsXbhFhjhCmIYC1H1RTPZsBYjNug&oe=6AF09AE6"}, "display_name": "Eleven HUD TT Companion", "keywords": ["eleven", "table", "tennis", "hud", "bibchik"], "long_description": "Eleven HUD is a complete table tennis companion for any Eleven Table Tennis players. Pin it as a Meta multitasking panel and keep live stats, scouting data, and social tools visible during every match \u2014 no headset off, no menus.\n\n**Play smarter at every level:**\n- **Climb ELO** \u2014 instant opponent insight, recent form, peak rating, and match history in one view  \n- **Prepare for tournaments** \u2014 search any player, review stats, compare profiles, and see win probability before you play  \n- **Stay social** \u2014 friends list, direct and group chat, and community discovery built in  \n- **Find better matches** \u2014 filter global players by ELO and jump into quality games fast  \n- **Track progress** \u2014 sessions, trends, win-rate, and top opponents in your personal profile  \n- **Learn faster** \u2014 coaching resources, guides, and curated training content  \n\n**Premium ($0.99/month):**\n- Paddle Intelligence (detailed equipment stats)  \n- Ball Machine Presets based on opponents  \n- AI-powered player analysis  \n- Faster opponent detection & live updates  \n- Full online player list with advanced filters  \n\n**Free features:**\n- Player search (Detective tab)  \n- Friends & messaging  \n- Opponent Monitor with live match view  \n- Simple account verification (no email/password)  \n\n**Built for Meta Quest:** resize and place the HUD anywhere in your VR space for seamless in-game use  \n\n**Languages:** English, Russian, Portuguese, Spanish, Chinese, Japanese, French, Korean, German  \n\nOpen Eleven HUD next to your game \u2014 and never play blind again.", "short_description": "Your complete companion and live opponent intel for Eleven Table Tennis on Meta Quest \u2014 ELO, paddle, head-to-head, AI scouting and chat, all in a floating panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://champadev.com/eleven-hud/privacy", "developer_terms_of_service_url": null, "publisher_name": "ChampaDev", "support_website_url": null, "website_url": "https://champadev.com/eleven-hud", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "ko", "pt_BR", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26429219013420625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1966770060710569_6696903793266469244_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmK6g-m5O60Q7kNvwFlz6OE&_nc_oc=AdrOrBW3T92qF5hwGChM1ljjyKj1Pidaj__-7iasteS6naavMElvI-y_H
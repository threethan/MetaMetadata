d=6e7a0a&_nc_ohc=_-TlaH8toq8Q7kNvwFhR-PA&_nc_oc=AdpHIciDUdRj_1H6b1BThzsldjd-Zpu2g5OfcDH-2v9TaCQdNw5oOi5siPc0g3QZIgc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TK8uy5Mgg2cqTdT-smTUHOevuJ39tLWVpeFDhphwXJA&oe=6A4114B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail_3.png", "id": "2816215335392283", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823296_2816215342058949_2822831727495430970_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jngRp86QvrcQ7kNvwEsAo-z&_nc_oc=AdrCXEBM2RNsRM7YJiaJWBvho4UpbGXJ1-2udTreUh_gwh9Osodqxw53wMIhK6MAehw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s4RocBbHUa28I_2_P1JKVQbu5TkWPgE_eY_5G0L-6Jw&oe=6A414366"}, "display_name": "Eleven HUD TT Companion", "keywords": ["eleven", "table", "tennis", "hud", "bibchik"], "long_description": "Eleven HUD is a complete table tennis companion for any Eleven Table Tennis players. Pin it as a Meta multitasking panel and keep live stats, scouting data, and social tools visible during every match \u2014 no headset off, no menus.\n\n**Play smarter at every level:**\n- **Climb ELO** \u2014 instant opponent insight, recent form, peak rating, and match history in one view  \n- **Prepare for tournaments** \u2014 search any player, review stats, compare profiles, and see win probability before you play  \n- **Stay social** \u2014 friends list, direct and group chat, and community discovery built in  \n- **Find better matches** \u2014 filter global players by ELO and jump into quality games fast  \n- **Track progress** \u2014 sessions, trends, win-rate, and top opponents in your personal profile  \n- **Learn faster** \u2014 coaching resources, guides, and curated training content  \n\n**Premium ($0.99/month):**\n- Paddle Intelligence (detailed equipment stats)  \n- Ball Machine Presets based on opponents  \n- AI-powered player analysis  \n- Faster opponent detection & live updates  \n- Full online player list with advanced filters  \n\n**Free features:**\n- Player search (Detective tab)  \n- Friends & messaging  \n- Opponent Monitor with live match view  \n- Simple account verification (no email/password)  \n\n**Built for Meta Quest:** resize and place the HUD anywhere in your VR space for seamless in-game use  \n\n**Languages:** English, Russian, Portuguese, Spanish, Chinese, Japanese, French, Korean, German  \n\nOpen Eleven HUD next to your game \u2014 and never play blind again.", "short_description": "Your complete companion and live opponent intel for Eleven Table Tennis on Meta Quest \u2014 ELO, paddle, head-to-head, AI scouting and chat, all in a floating panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://champadev.com/eleven-hud/privacy", "developer_terms_of_service_url": null, "publisher_name": "ChampaDev", "support_website_url": null, "website_url": "https://champadev.com/eleven-hud", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "ko", "pt_BR", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26429219013420625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823837_1966770060710569_6696903793266469244_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erg5_GoKM6UQ7kNvwHphqs_&_nc_oc=Adr03Ab4KuLrV6ToxV-ymyzw-3ezOEDTUmYycl7bl_-t2639xWbPfeSjM
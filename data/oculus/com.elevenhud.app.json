screenshots": [{"file_name": "store_1_simple.png", "id": "1628857185070391", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499299891_1628857188403724_1997980739548939358_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48BwUWI3BxEQ7kNvwEZwDBy&_nc_oc=Ado_CQScR8x1t_qkkO1wl6ORx_4Hvy3vdGG7GvaUJ2bA3OXWklvoaZUF5t7NokvLtPc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oSLzY1NCFfUI6rQgPB_ccbqtWCzG93DeO-MQQ9Kb_kA&oe=6A32A0A3"}, {"file_name": "store_2_simple.png", "id": "2266641963863339", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298930_2266641967196672_7328956382705604804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1s2radec8wQ7kNvwEfEykb&_nc_oc=AdoqdfcvMYNIIhfunhH_r-03JuQ_bdzZ-Q7ZEyqdKDlZnyGbqXAak4e0k2J5AdHrR_U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dRF7ic14s22fQbgOCfMnwb9r5LiDJ14RroFy9hoWlpg&oe=6A32C5F5"}, {"file_name": "store_3_simple.png", "id": "1367595605288602", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499293690_1367595608621935_963635202776251142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y827K_w-ui4Q7kNvwGhc2Rd&_nc_oc=AdpLgmz05qlCXPnkAa61gwOJJBucPcEhcPnoln147b2420OHVm-GSDa5GcI6cqXnxfg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5pvi3LQtBr2Bo4Y5bbHcu7IGiMNpdSp21Z1V3OSewzw&oe=6A32A177"}, {"file_name": "store_4_simple.png", "id": "1704827630700024", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499299093_1704827634033357_998671414957048917_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPT6y7PBwJ4Q7kNvwFLC54G&_nc_oc=AdoZQIO2kTtJFYzK8yYpxOfJA8hyCvc-CouPvkL2TL8uLeGasJ1gU1AiRSBczVlspoo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83WSvis45yUdZqKWrZBdJnKJtOlZS5kCKpv_j8tIyBVQ&oe=6A32C5C9"}, {"file_name": "store_5_simple.png", "id": "1315206157223713", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499312068_1315206160557046_8302173888506556361_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Q7vF33vLCUQ7kNvwGSHG31&_nc_oc=AdqOT97K1cgkh2-Tb1YbdmByI0Omybvl1LWDAlegu0BF2F9ifzbg06uJB_0TMqaOrrY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kifOi9BPFAU01IsjrY7vkYXIRZ3-OW7R5r58wF1DWXQ&oe=6A329433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1291601506500624", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304938_1291601513167290_452853677891290692_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vp_gVfrYGroQ7kNvwGedFNn&_nc_oc=AdrhuqWej8_SDbiWcYEgWZ9TJOJHM7fmZuH8dJwTtmIGWNEZV7nFOzVST94CDUjD2iw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9juEjHDMNcxF7wzb2zSNfNItsN2dj8sa2UCcTxTH9qZA&oe=6A32B308"}, "display_name": "Bibchik's Eleven HUD", "keywords": ["eleven", "table", "tennis", "hud", "bibchik"], "long_description": "Bibchik\u2019s Eleven HUD is a companion app for any Eleven Table Tennis players. Pin it as a Meta multitasking panel and keep live stats, scouting data, and social tools visible during every match \u2014 no headset off, no menus.\n\n**Play smarter at every level:**\n- **Climb ELO** \u2014 instant opponent insight, recent form, peak rating, and match history in one view  \n- **Prepare for tournaments** \u2014 search any player, review stats, compare profiles, and see win probability before you play  \n- **Stay social** \u2014 friends list, direct and group chat, and community discovery built in  \n- **Find better matches** \u2014 filter global players by ELO and jump into quality games fast  \n- **Track progress** \u2014 sessions, trends, win-rate, and top opponents in your personal profile  \n- **Learn faster** \u2014 coaching resources, guides, and curated training content  \n\n**Premium ($0.99/month):**\n- Paddle Intelligence (detailed equipment stats)  \n- Ball Machine Presets based on opponents  \n- AI-powered player analysis  \n- Faster opponent detection & live updates  \n- Full online player list with advanced filters  \n\n**Free features:**\n- Player search (Detective tab)  \n- Friends & messaging  \n- Opponent Monitor with live match view  \n- Simple account verification (no email/password)  \n\n**Built for Meta Quest:** resize and place the HUD anywhere in your VR space for seamless in-game use  \n\n**Languages:** English, Russian, Portuguese, Spanish, Chinese, Japanese, French, Korean, German  \n\nOpen Eleven HUD next to your game \u2014 and never play blind again.", "short_description": "Your complete companion and live opponent intel for Eleven Table Tennis on Meta Quest \u2014 ELO, paddle, head-to-head, AI scouting and chat, all in a floating panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://champadev.com/eleven-hud/privacy", "developer_terms_of_service_url": null, "publisher_name": "ChampaDev", "support_website_url": null, "website_url": "https://champadev.com/eleven-hud", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "ko", "pt_BR", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26197887503220445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499300541_823371556987386_1242441925803954139_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxtYEsQFAYwQ7kNvwHPb5kt&_nc_oc=AdqKv4vWFSIlgG-RzNqpcE_vNzCWSAvLQa5jlxheUyulo12jisbqPuTNVy-R2tz4P2I&_nc_zt=3&
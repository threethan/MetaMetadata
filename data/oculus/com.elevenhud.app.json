screenshots": [{"file_name": "store_1_simple.png", "id": "1628857185070391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299891_1628857188403724_1997980739548939358_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqYaGPM3J2IQ7kNvwFlLmX3&_nc_oc=AdqAjddcDzgYEGFCQuZ2poBO_qCu564ZEF5h9WgfEu2Jeeq4fj6BzbSFdYKOew7t0qA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9goSpSdojRib8OrX2BZCtvP7gSOUa1U7vc_WFNc5WtTg&oe=6A296623"}, {"file_name": "store_2_simple.png", "id": "2266641963863339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298930_2266641967196672_7328956382705604804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK4XKKrv26oQ7kNvwGf1Qm_&_nc_oc=Adq23hH6Y9lR8wgOSW9ERIBjK01FjBO1blO0Mi1u-jd8TGP9FEHjads0Hz8fkXA3hCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HzRMmO2DROIz2WwraVfJOyZdkNotmOEy6yrWP56d1qw&oe=6A298B75"}, {"file_name": "store_3_simple.png", "id": "1367595605288602", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293690_1367595608621935_963635202776251142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lOKbI9bmIwQ7kNvwG0V6-f&_nc_oc=AdqD3p_RYwbazDkRIt7cAO0EamAb-EExikCvO5Z8tBv8brIeylDjhcfosBtOWJtckJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9apkTnfNZVqDc1m25GEVM92fq61Vrb1_lAMUSY-lZAWg&oe=6A2966F7"}, {"file_name": "store_4_simple.png", "id": "1704827630700024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299093_1704827634033357_998671414957048917_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XBKGMf66KgQ7kNvwFQG5Rn&_nc_oc=AdoEOQDMeR3ss9G9u8q1AvhP778_JqU2JSsgBpu91VApA3KqupgK6JFTDjA5oA1c5jo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kYMmO2C2Pb8N5zNIbGbexdivubAMO5XFcZvx2zEQ03A&oe=6A298B49"}, {"file_name": "store_5_simple.png", "id": "1315206157223713", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312068_1315206160557046_8302173888506556361_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKWwouEn8cEQ7kNvwGUbrrX&_nc_oc=AdpYc2Tmc1NYeQ6eu5ZVIDHu-FRWVE5Lg7pJMYYdjHt83d1-SPlFc_MG3BFqpzBYVGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90JyyzzDkTYnYUd2-hodq4mteon3-ASacLo6w7k0kuIw&oe=6A2959B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1291601506500624", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304938_1291601513167290_452853677891290692_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90Pf6B6UEqYQ7kNvwGcaYxJ&_nc_oc=AdqdXgpC38mrsxMUWqCrth8M9gb0l5YEK3dEbj_0P9IEhr0g-g4XSWUsteRzl6Vm7Dw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82SJFMhbYv60tJTFvGCDVvbgaA_uXWgOmZA20IsX7NOg&oe=6A297888"}, "display_name": "Bibchik's Eleven HUD", "keywords": ["eleven", "table", "tennis", "hud", "bibchik"], "long_description": "Bibchik\u2019s Eleven HUD is a companion app for any Eleven Table Tennis players. Pin it as a Meta multitasking panel and keep live stats, scouting data, and social tools visible during every match \u2014 no headset off, no menus.\n\n**Play smarter at every level:**\n- **Climb ELO** \u2014 instant opponent insight, recent form, peak rating, and match history in one view  \n- **Prepare for tournaments** \u2014 search any player, review stats, compare profiles, and see win probability before you play  \n- **Stay social** \u2014 friends list, direct and group chat, and community discovery built in  \n- **Find better matches** \u2014 filter global players by ELO and jump into quality games fast  \n- **Track progress** \u2014 sessions, trends, win-rate, and top opponents in your personal profile  \n- **Learn faster** \u2014 coaching resources, guides, and curated training content  \n\n**Premium ($0.99/month):**\n- Paddle Intelligence (detailed equipment stats)  \n- Ball Machine Presets based on opponents  \n- AI-powered player analysis  \n- Faster opponent detection & live updates  \n- Full online player list with advanced filters  \n\n**Free features:**\n- Player search (Detective tab)  \n- Friends & messaging  \n- Opponent Monitor with live match view  \n- Simple account verification (no email/password)  \n\n**Built for Meta Quest:** resize and place the HUD anywhere in your VR space for seamless in-game use  \n\n**Languages:** English, Russian, Portuguese, Spanish, Chinese, Japanese, French, Korean, German  \n\nOpen Eleven HUD next to your game \u2014 and never play blind again.", "short_description": "Your complete companion and live opponent intel for Eleven Table Tennis on Meta Quest \u2014 ELO, paddle, head-to-head, AI scouting and chat, all in a floating panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://champadev.com/eleven-hud/privacy", "developer_terms_of_service_url": null, "publisher_name": "ChampaDev", "support_website_url": null, "website_url": "https://champadev.com/eleven-hud", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "ko", "pt_BR", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26197887503220445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300541_823371556987386_1242441925803954139_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bWlAj_owN4Q7kNvwFBeW7S&_nc_oc=Ado4cv33eJc3LAGl_Ig877XVS3WqTrpw61nR1oWQAjK-PaTrvplRuxe5_0AM9uuCLow&_nc_zt=3&
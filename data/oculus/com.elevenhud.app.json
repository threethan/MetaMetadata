"en_US", "screenshots": [{"file_name": "store_1_simple.png", "id": "1628857185070391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299891_1628857188403724_1997980739548939358_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT3ph6Gbt0IQ7kNvwG7cOjN&_nc_oc=Adq1MAW98i8wduZrj8_TE8x00KOCTfznXmgAPXS_nJqUyFa8JJeCook68l9kYP6hNnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjx4eEwf0iv6d9VJwDQnyc8TsXj-FOH6FapGYvrjxZYg&oe=6AB52523"}, {"file_name": "store_2_simple.png", "id": "2266641963863339", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298930_2266641967196672_7328956382705604804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ushyeApj31wQ7kNvwHUkRAn&_nc_oc=AdrWPuVfkr6YTeL76pALjB-ddGvm_u9plZ2eLKtY7od4yhaZOF22DkqRNnSklHEZ-Pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIThdq0lwdpuym0oeNmj72W2d6ugjt4tXey1nx6f-VxHw&oe=6AB54A75"}, {"file_name": "store_3_simple.png", "id": "1367595605288602", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293690_1367595608621935_963635202776251142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOkbA5fprZcQ7kNvwEEDjgJ&_nc_oc=AdrX--GnFD2bVjeh8Q-UkXZh1VZB5-ugs8DF1LIa8Rv7K0rLVp3QaP2IVCCXsJGYC8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfec_tZEX2mmYb7L1_uckMUr1Glq4ox6Wy8JlxsIkrQw&oe=6AB525F7"}, {"file_name": "store_4_simple.png", "id": "1704827630700024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299093_1704827634033357_998671414957048917_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO9itkuvHhsQ7kNvwGslN4M&_nc_oc=AdoHtvZNPaOKRqWk1GCvbQv-3wo59U7PhV3_KQC1fdcUdEI_CFcSh8fex9n_cC825jU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDOjNBxIZ9w-Slj8ZZZlGpDDPTxZlXu_7PobLK4YI-vw&oe=6AB54A49"}, {"file_name": "store_5_simple.png", "id": "1315206157223713", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312068_1315206160557046_8302173888506556361_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=purGJviQcmAQ7kNvwHO6P0b&_nc_oc=AdrWI4JU3ULPl8HBN-JtJO5x_Puw4J__hmFIpiRvTRJAY510oqmEysb-btB-HExzCFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9ZQNdAbo78ioHUkfBcC2yrGznyQ4gUjTYg3QiYQj1zw&oe=6AB518B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail_3.png", "id": "2816215335392283", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_2816215342058949_2822831727495430970_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g27QfhHyjjEQ7kNvwFFUH1J&_nc_oc=Ado3bSFWB5xUkeZqG3piDMhrup4Pf70qweEr9lgEhGP8WDETk9gSKu9HRzqcPgx33ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRM8rUhFUyAIIFHI50VqGBvy9t9ve6eq4JpquXV_KF0A&oe=6AB54766"}, "display_name": "Eleven HUD TT Companion", "keywords": ["eleven", "table", "tennis", "hud", "bibchik"], "long_description": "Eleven HUD is a complete table tennis companion for any Eleven Table Tennis players. Pin it as a Meta multitasking panel and keep live stats, scouting data, and social tools visible during every match \u2014 no headset off, no menus.\n\n**Play smarter at every level:**\n- **Climb ELO** \u2014 instant opponent insight, recent form, peak rating, and match history in one view  \n- **Prepare for tournaments** \u2014 search any player, review stats, compare profiles, and see win probability before you play  \n- **Stay social** \u2014 friends list, direct and group chat, and community discovery built in  \n- **Find better matches** \u2014 filter global players by ELO and jump into quality games fast  \n- **Track progress** \u2014 sessions, trends, win-rate, and top opponents in your personal profile  \n- **Learn faster** \u2014 coaching resources, guides, and curated training content  \n\n**Premium ($0.99/month):**\n- Paddle Intelligence (detailed equipment stats)  \n- Ball Machine Presets based on opponents  \n- AI-powered player analysis  \n- Faster opponent detection & live updates  \n- Full online player list with advanced filters  \n\n**Free features:**\n- Player search (Detective tab)  \n- Friends & messaging  \n- Opponent Monitor with live match view  \n- Simple account verification (no email/password)  \n\n**Built for Meta Quest:** resize and place the HUD anywhere in your VR space for seamless in-game use  \n\n**Languages:** English, Russian, Portuguese, Spanish, Chinese, Japanese, French, Korean, German  \n\nOpen Eleven HUD next to your game \u2014 and never play blind again.", "short_description": "Your complete companion and live opponent intel for Eleven Table Tennis on Meta Quest \u2014 ELO, paddle, head-to-head, AI scouting and chat, all in a floating panel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://champadev.com/eleven-hud/privacy", "developer_terms_of_service_url": null, "publisher_name": "ChampaDev", "support_website_url": null, "website_url": "https://champadev.com/eleven-hud", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "ko", "pt_BR", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26429219013420625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1966770060710569_6696903793266469244_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW3TVC7VdjEQ7kNvwHLlX4S&_nc_oc=AdoOYCR0Ms4k99HV9gdxdGwcqu1pm0rmsIEFo-MRfE18kWM4uPSYjZcVS
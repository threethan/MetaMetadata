441_1512992867121912_5547149160647038378_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y2r6yO-dCYQ7kNvwFs1tPz&_nc_oc=AdqKPssKsLHBLpyb9iP_aHpcDCnX1ngqeY-BJ8sgRJMecPsk0oc4ThHrDLopkzdQN5g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0C1f5KR6vsYPnHW5r8hQwonNvL5ccbSh1mP6qL-mX0w&oe=6AFB36D2"}, {"file_name": "com.AtlasV.G0010Slap-20260519-164032.png", "id": "1536959051436485", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823837_1536959054769818_2140700949335189895_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr5xnwYWdq8Q7kNvwH3qtRc&_nc_oc=AdpTeemOgpGbASebZciLqNT4Tdr_7W1vqoyqN6fblP98i3WPOE-YNhwurrvjBSdxdxA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa2sLNvi3yXGNJWcH0KptibjTm_0iE6OJA_dnHEFAReg&oe=6AFB1A7F"}, {"file_name": "e0e708def88b4504b9aa64dbebbc6001.png", "id": "27648710238050797", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819982_27648710254717462_4192682354594420238_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCw5ZBdi0T0Q7kNvwFlyCUe&_nc_oc=Adp8o8gBuHj8vWA_DMzNP12-UQ-NpR27mfeocZSkmIyna_W1I1DcEj5KOKHHoR0dFwc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxTZClSnblKMUudXb5i0SQaAiT8ZblXrbDeqR5vKGaYw&oe=6AFB42C9"}, {"file_name": "701312069_27192627980374952_2048439527887403180_n.png", "id": "960158243565815", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818852_960158246899148_3071113340954845551_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATr-Sj8melIQ7kNvwEnyE28&_nc_oc=Adql-zBG-xh7crUDBtRbF1igasyVcGZcMCyn7_wJldY025cz7_0caT04i8yyEdIjGz0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6jsQloSTdg2_v7T6zqY8TpfgdOSZBeqnNt0sjOxZJww&oe=6AFB2516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlySmasherVR_landscape.png", "id": "2361189397743193", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828038_2361189401076526_6420247853064107339_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErZ6Naby1LMQ7kNvwEtIqm5&_nc_oc=AdoXvMC4ddk2l8B8Q0EN9N4yK50I_Tr1QX0YfNGHiLp5WK8szEkDpq7k88qvzHBxnbw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe6bD9afnQ206_5PM8R5TMI-F0OWvapqEwI_E_WuPDSA&oe=6AFB4254"}, "display_name": "Fly Smasher VR", "keywords": ["arcade", "fly", "smasher", "survival", "flies"], "long_description": "Protect your lunch in Fly Smasher VR \u2014 an arcade VR survival game where giant flies are always one buzz away from stealing your food. \ud83c\udf54\ud83e\udeb0\n\nYou\u2019ve got two massive swatters, fast reflexes, and one job: don\u2019t let them feast!\n\n# Smash the swarm \ud83d\udd90\ufe0f\n\nWaves of flies come from every angle. Swing, slap, and swat like your meal depends on it (because it does).\n\n{708044362372578}\n\n# Survive special flies (and worse) \u26a0\ufe0f\n\nIt\u2019s not just basic pests \u2014 expect tricky variants that force you to adapt\u2026 and fly-bosses that show up to ruin your day.\n\n{859982833236076}\n\n# Upgrade your gear \ud83d\udd27\n\nEarn rewards, power up your swatters, and unlock upgrades that make you faster, stronger, and harder to steal from.\n\n{776136352156370}\n\n# Chase the high score \ud83c\udfc6\n\nThe longer you survive, the crazier it gets. Set a new best run, then try to beat it again. Fast hands. Big swats. Zero mercy.\n\nHow long can you keep your food safe?\n\n{2176945003067791}\n\n\n\n\n-----\n\n# JOIN OUR DISCORD FOR MORE ARIANE STUDIOS GAMES:\nhttps://discord.gg/zkshzFHJZb\n", "short_description": "Two giant swatters. One precious meal.\nProtect your food from hungry, oversized flies trying to steal every last bite. Smash waves of pests, survive special flies and fly-bosses, upgrade your gear, and chase the high score!\nHow long can you keep dinner yours?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestud
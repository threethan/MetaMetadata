6HzgNw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlQxazGr1vzGBIqWpcn-MjAEIUp7eEVS-EvRc4s7Eb9g&oe=6A9C1292"}, {"file_name": "com.AtlasV.G0010Slap-20260519-164032.png", "id": "1536959051436485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_1536959054769818_2140700949335189895_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqE06Za63I0Q7kNvwHMUiDq&_nc_oc=AdqRZHdlArHxP6gRzplsNWaPcXznKKR8lcvtYN9MMyXVYBFzGE8eD3hWFrPzkdcZEQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcbC3JFOBALe-9R3YhuQ1epK3H5Vqj3ZdlODh55DybwQ&oe=6A9C2E7F"}, {"file_name": "e0e708def88b4504b9aa64dbebbc6001.png", "id": "27648710238050797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_27648710254717462_4192682354594420238_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhrZE0gCtRoQ7kNvwE1qFmJ&_nc_oc=AdqQHViZU7ZJOz4zLxYqoy3NAVmWOIupQ4Zg3hx085z_qAhMck56kdInf_bwaKtFtAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRNpqe1lrEgjKR5c6AYQ-YM1bhz8ODW8RYcH0dfc5KVQ&oe=6A9C1E89"}, {"file_name": "701312069_27192627980374952_2048439527887403180_n.png", "id": "960158243565815", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818852_960158246899148_3071113340954845551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR0rCkFuuLQQ7kNvwF5V2aY&_nc_oc=AdrVQeqnjPte0JQcdVkdrqHn3ISWq6H8tOplMzrlkzSrWZMg1LY-XUR1Vq-WE_5-5os&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDFTE-3ImiNyytf49pyg4wAOgP0izKvHD84X-lnlHhfQ&oe=6A9C3916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlySmasherVR_landscape.png", "id": "2361189397743193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828038_2361189401076526_6420247853064107339_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNEoO0E4AzgQ7kNvwHWtxk-&_nc_oc=AdqATxvV8PxcdPeHk_verFtrliiobFqAEeb9xtutl0lGPqREIuyiLADUbT2rEJZO1w8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBWYhmW9jQNJCnEdhTGgso-hZErFZA1MOImRykVXN6WA&oe=6A9C1E14"}, "display_name": "Fly Smasher VR", "keywords": ["arcade", "fly", "smasher", "survival", "flies"], "long_description": "Protect your lunch in Fly Smasher VR \u2014 an arcade VR survival game where giant flies are always one buzz away from stealing your food. \ud83c\udf54\ud83e\udeb0\n\nYou\u2019ve got two massive swatters, fast reflexes, and one job: don\u2019t let them feast!\n\n# Smash the swarm \ud83d\udd90\ufe0f\n\nWaves of flies come from every angle. Swing, slap, and swat like your meal depends on it (because it does).\n\n{708044362372578}\n\n# Survive special flies (and worse) \u26a0\ufe0f\n\nIt\u2019s not just basic pests \u2014 expect tricky variants that force you to adapt\u2026 and fly-bosses that show up to ruin your day.\n\n{859982833236076}\n\n# Upgrade your gear \ud83d\udd27\n\nEarn rewards, power up your swatters, and unlock upgrades that make you faster, stronger, and harder to steal from.\n\n{776136352156370}\n\n# Chase the high score \ud83c\udfc6\n\nThe longer you survive, the crazier it gets. Set a new best run, then try to beat it again. Fast hands. Big swats. Zero mercy.\n\nHow long can you keep your food safe?\n\n{2176945003067791}\n\n\n\n\n-----\n\n# JOIN OUR DISCORD FOR MORE ARIANE STUDIOS GAMES:\nhttps://discord.gg/zkshzFHJZb\n", "short_description": "Two giant swatters. One precious meal.\nProtect your food from hungry, oversized flies trying to steal every last bite. Smash waves of pests, survive special flies and fly-bosses, upgrade your gear, and chase the high score!\nHow long can you keep dinner yours?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/fly-smasher-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
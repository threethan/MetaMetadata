xUocCwzFeu5v50iKsQ69kI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Lyks9rwK7jjlTI2xnplB-j45RyeYlYEwhLNjJT2TDgQ&oe=6A450F92"}, {"file_name": "e0e708def88b4504b9aa64dbebbc6001.png", "id": "27648710238050797", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819982_27648710254717462_4192682354594420238_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XJF1NMYIUAQ7kNvwFPZhjv&_nc_oc=AdqhXIZBeKY1GI5dOKp_qppyUx9xfwrqyRpDnI465m1EHTHXhQzes0DC14fx3RTtBKQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FgCQn0DLAEwe0vjDbk9CQgMkg38tmqDF9OoZghmVI2A&oe=6A451B89"}, {"file_name": "181d19cb7c8c4ed6960f781a9dc96f90.png", "id": "784508741153884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_784508744487217_1192351508790732453_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEQqpCaF0XYQ7kNvwGVKtDr&_nc_oc=Ado6kzjytYJ2IUQEO4ulp_hH-VpdOZ7nG_zy7uFAmb-ZCU1Zz45KE5lk2Ydptee7Sr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AlgvrEvKlgAqT6RTVFnfUmI3RChckg2qYKo3XVm97Dg&oe=6A4534F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fly Smasher VR", "keywords": ["arcade", "fly", "smasher", "survival", "flies"], "long_description": "Protect your lunch in Fly Smasher VR \u2014 an arcade VR survival game where giant flies are always one buzz away from stealing your food. \ud83c\udf54\ud83e\udeb0\n\nYou\u2019ve got two massive swatters, fast reflexes, and one job: don\u2019t let them feast!\n\nSmash the swarm \ud83d\udd90\ufe0f\n\nWaves of flies come from every angle. Swing, slap, and swat like your meal depends on it (because it does).\n\n[GIF swatting a wave / food almost stolen]\n\nSurvive special flies (and worse) \u26a0\ufe0f\n\nIt\u2019s not just basic pests \u2014 expect tricky variants that force you to adapt\u2026 and fly-bosses that show up to ruin your day.\n\n[GIF special fly type / boss intro]\n\nUpgrade your gear \ud83d\udd27\n\nEarn rewards, power up your swatters, and unlock upgrades that make you faster, stronger, and harder to steal from.\n\n[GIF upgrade menu / power-up in action]\n\nChase the high score \ud83c\udfc6\n\nThe longer you survive, the crazier it gets. Set a new best run, then try to beat it again.\n\n[GIF highscore / \u201cnew record\u201d moment]\n\nFast hands. Big swats. Zero mercy.\n\nHow long can you keep your food safe?", "short_description": "Two giant swatters. One precious meal.\nProtect your food from hungry, oversized flies trying to steal every last bite. Smash waves of pests, survive special flies and fly-bosses, upgrade your gear, and chase the high score.\nHow long can you keep dinner yours?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/fly-smasher-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://www.arianestudios.com/fly-smasher-privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26045670465043009"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2200233530829002"}, {"status": "PUBLISHED", "id": "1356301869691077"}, {"status": "PUBLISHED", "id": "1002688732249101"}, {"status": "PEND
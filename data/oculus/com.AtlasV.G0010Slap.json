5a23b4460d970156afa5b80f46.png", "id": "1512992863788579", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1512992867121912_5547149160647038378_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seBPBpuX3zsQ7kNvwGr6wIE&_nc_oc=AdpFfBnX_shTld8aB5FEMnqdD5PNvQozIC3qTNw_YmwMthPSlps_6tKfM4pKeJVI6hY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtH5AK6t0LbDYuDVN3zJVIeGhOUxXGb-tdDsXefcdTGg&oe=6B0DABD2"}, {"file_name": "com.AtlasV.G0010Slap-20260519-164032.png", "id": "1536959051436485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1536959054769818_2140700949335189895_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3soryJrFFlgQ7kNvwG5I2jF&_nc_oc=AdoEWADRODAPnGB41VaFEtMZ8YkB4oNs4q0y8DTS2lsobGRCzUnZg3frCWmCsbgV2Qs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJC_Qec_B9tau7xqFW8EpYWNoPjKL2TTaEM-9Z807bVA&oe=6B0DC7BF"}, {"file_name": "e0e708def88b4504b9aa64dbebbc6001.png", "id": "27648710238050797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819982_27648710254717462_4192682354594420238_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hHOBngBR8oQ7kNvwFPeecD&_nc_oc=Adodi9RC1hGhbUn3s8Lneo6hKUlcDePRzPhdPw295fjUTFrbmMpqIZ_HreQ1YvefzDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnriznk4WanKvPDb8BYQ81k1h_lyCs39qoSe1EVUgHQg&oe=6B0DB7C9"}, {"file_name": "701312069_27192627980374952_2048439527887403180_n.png", "id": "960158243565815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818852_960158246899148_3071113340954845551_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZhXMHY7OIoQ7kNvwEDbMGw&_nc_oc=Ado1Dp6EtbODTzziP-uZPokzcEa2vZ588ODGUmmgUZVpzGBynil-TlT1R2iYLndaKvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQRA15z0r_4UhsWDeUtUbo8i7SIqf4rVbYGJm3yRDuzug&oe=6B0DD256"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlySmasherVR_landscape.png", "id": "2361189397743193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828038_2361189401076526_6420247853064107339_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY3_gsfPBhUQ7kNvwHtVIVZ&_nc_oc=AdreAj505lv2H1FDOkjE-YLGejs6vwOT6f5ub4Hd6mhLAuM4mzCLdZwW7j4qIH_Jeq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKqEAWptTqqCa9CFiq_vF2x7bP_PfgbOE51lG4EKJiMQ&oe=6B0DB754"}, "display_name": "Fly Smasher VR", "keywords": ["arcade", "fly", "smasher", "survival", "flies"], "long_description": "Protect your lunch in Fly Smasher VR \u2014 an arcade VR survival game where giant flies are always one buzz away from stealing your food. \ud83c\udf54\ud83e\udeb0\n\nYou\u2019ve got two massive swatters, fast reflexes, and one job: don\u2019t let them feast!\n\n# Smash the swarm \ud83d\udd90\ufe0f\n\nWaves of flies come from every angle. Swing, slap, and swat like your meal depends on it (because it does).\n\n{708044362372578}\n\n# Survive special flies (and worse) \u26a0\ufe0f\n\nIt\u2019s not just basic pests \u2014 expect tricky variants that force you to adapt\u2026 and fly-bosses that show up to ruin your day.\n\n{859982833236076}\n\n# Upgrade your gear \ud83d\udd27\n\nEarn rewards, power up your swatters, and unlock upgrades that make you faster, stronger, and harder to steal from.\n\n{776136352156370}\n\n# Chase the high score \ud83c\udfc6\n\nThe longer you survive, the crazier it gets. Set a new best run, then try to beat it again. Fast hands. Big swats. Zero mercy.\n\nHow long can you keep your food safe?\n\n{2176945003067791}\n\n\n\n\n-----\n\n# JOIN OUR DISCORD FOR MORE ARIANE STUDIOS GAMES:\nhttps://discord.gg/zkshzFHJZb\n", "short_description": "Two giant swatters. One precious meal.\nProtect your food from hungry, oversized flies trying to steal every last bite. Smash waves of pests, survive special flies and fly-bosses, upgrade your gear, and chase the high score!\nHow long can you keep dinner yours?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/fly-smasher-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27180084044934973"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_1422006829129253_8708409883566721825_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LUz1exzJq4Q7kNvwHZHUji&_nc_oc=AdqbFulP-IjwEQePRyI6dn4iXxcd5P7oSy2bpeeRL7b3Ip2gds5Sdg3odoRNlOc1c4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzEaPeYhYKnant67gTZSCmYHMkOp5ltDbAfsH_mDBfwQ&oe=6B0DC55B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fly Smasher VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1780579020, "lastRevision": {"nodes": [{"id": "26045670541709668", "
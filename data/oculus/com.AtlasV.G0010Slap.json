uV1lYYo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiTbD3iMDCXXYqR9H2DEb5AK5hdWpnBMrQHCsJe3q_DQ&oe=6AE8C1D2"}, {"file_name": "com.AtlasV.G0010Slap-20260519-164032.png", "id": "1536959051436485", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823837_1536959054769818_2140700949335189895_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0mCUliDDjkQ7kNvwFgYOg4&_nc_oc=AdqCmHnEWqE0_4qWOy1ekX23LBedWCrHKBwcnDpNfI1ysRWQn4SVjmhj7qHDmTH--lU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp88yc59h0YQg1nUPtUhHVej3bBUole5sPSxPg8kuI4g&oe=6AE8A57F"}, {"file_name": "e0e708def88b4504b9aa64dbebbc6001.png", "id": "27648710238050797", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819982_27648710254717462_4192682354594420238_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oS2rEGFFDdwQ7kNvwFQkyG0&_nc_oc=Adp7iGGaVlyuPiDewbRHYwsLYXxJg1wMEP1hdbc2or0_7JTmkTA-XAyGGT0JVXZ8Z8M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-zWCUtx-OCRxkjeal2_00CfyeeDLMQ1YVgAHDNG_caQ&oe=6AE89589"}, {"file_name": "701312069_27192627980374952_2048439527887403180_n.png", "id": "960158243565815", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818852_960158246899148_3071113340954845551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE9_m2baFgMQ7kNvwFMWkrG&_nc_oc=Adprz-ZmiMgWmRCCIR9iXM5b47g0Lhw8B1WT2tbgYCPBLbxfJmDlPjayFJk61F8HlPY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCpyUtB2nfHrOPibhAP2Z0LrqoOOTxhBrEth1bo50UsA&oe=6AE8B016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlySmasherVR_landscape.png", "id": "2361189397743193", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828038_2361189401076526_6420247853064107339_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1pMi2yuSYgQ7kNvwGk7e0v&_nc_oc=AdoqfJVUhzsdOeDehFUXrX62iFnWdZ9m36FMuObQgs0ne8ZUQs6AGG1cD8MpPt3CQ1Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlYe4WCr1grwH6kJV0dWEX6s5GYUhpOKQCBEJaKsNt0A&oe=6AE89514"}, "display_name": "Fly Smasher VR", "keywords": ["arcade", "fly", "smasher", "survival", "flies"], "long_description": "Protect your lunch in Fly Smasher VR \u2014 an arcade VR survival game where giant flies are always one buzz away from stealing your food. \ud83c\udf54\ud83e\udeb0\n\nYou\u2019ve got two massive swatters, fast reflexes, and one job: don\u2019t let them feast!\n\n# Smash the swarm \ud83d\udd90\ufe0f\n\nWaves of flies come from every angle. Swing, slap, and swat like your meal depends on it (because it does).\n\n{708044362372578}\n\n# Survive special flies (and worse) \u26a0\ufe0f\n\nIt\u2019s not just basic pests \u2014 expect tricky variants that force you to adapt\u2026 and fly-bosses that show up to ruin your day.\n\n{859982833236076}\n\n# Upgrade your gear \ud83d\udd27\n\nEarn rewards, power up your swatters, and unlock upgrades that make you faster, stronger, and harder to steal from.\n\n{776136352156370}\n\n# Chase the high score \ud83c\udfc6\n\nThe longer you survive, the crazier it gets. Set a new best run, then try to beat it again. Fast hands. Big swats. Zero mercy.\n\nHow long can you keep your food safe?\n\n{2176945003067791}\n\n\n\n\n-----\n\n# JOIN OUR DISCORD FOR MORE ARIANE STUDIOS GAMES:\nhttps://discord.gg/zkshzFHJZb\n", "short_description": "Two giant swatters. One precious meal.\nProtect your food from hungry, oversized flies trying to steal every last bite. Smash waves of pests, survive special flies and fly-bosses, upgrade your gear, and chase the high score!\nHow long can you keep dinner yours?\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/fly-smasher-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
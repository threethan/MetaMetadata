{"file_name": "screenshots--SS4.png", "id": "1195182355920836", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303391_1195182359254169_5393159120547616767_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EnfUM9JCNcQ7kNvwFE4Aua&_nc_oc=Adoi3SH9fgoxyN8XW4XNI0S0jpyD5tXLpWTDOm25HNvfFsiYX3-A7l0buLstRyBuTjM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7oCfLX_AtpImt37lNqNFcNZupjbI3tMcjfMnByJuheg&oe=6A539B2A"}, {"file_name": "screenshots--SS5.png", "id": "1152713323743145", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308103_1152713327076478_3814856706915766260_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDy48kHA-5QQ7kNvwFtN_nE&_nc_oc=AdpoLoVipv5x6KrL3SfcUU3OfM5EPCsEOyToYaU-Sm8GtmYpFwb8EGQmYsSxBE61BxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlelC6JcJ9ZzYtgiLfIzx0HI4PYkyh6bo2erjdQ2eP5Q&oe=6A538868"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-+-hero-art--landscape.png", "id": "1586902709016991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310646_1586902712350324_4763246704054688123_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sGtWsUSqlAQ7kNvwGx7tS5&_nc_oc=AdrH4EklL3oxOPlJsFXyvod88fW2KP1zTcCwQ01gft3sJEuTbrwd5b-WhrYz3gg29zQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAExGDIXhhq3U3_Q3RBJFo_jBaJRSXa5yPSXoA0ieswZQ&oe=6A53A480"}, "display_name": "Batuque Beats", "keywords": ["rhythm", "music", "carnival", "samba", "beats"], "long_description": "Dive into the vibrant atmosphere of S\u00e3o Paulo with Batuque Beats VR, a virtual reality rhythm game that brings the magic of Carnival to Meta Quest. Embark on a journey as a new bateria conductor, mastering the art of percussion, from the rehearsal court to the parade at the samb\u00f3dromo.\n\nPrepare for an immersive and culturally rich experience. In Batuque Beats VR, every beat is a note, and your precision is the key to success. The game offers intuitive mechanics and a learning curve designed for everyone, from beginners to rhythm masters. With controls adapted for VR, you'll use your hands as virtual drumsticks, hitting notes that move along an original soundtrack.\n\nThe game celebrates Brazilian musical tradition, with settings inspired by authentic locations in S\u00e3o Paulo and a soundtrack that celebrates samba. The journey is a progression of difficulty, where you'll start with a simple rehearsal in the community court and evolve to the peak of the Carnival parade.\n\nBatuque Beats VR was designed with accessibility in mind, offering a full settings menu that allows you to customize your experience, including colorblind adjustments, visual options, and difficulty.", "short_description": "Conduct a samba school bateria in VR. From S\u00e3o Paulo to the world, Batuque Beats VR offers an immersive and culturally rich experience, with intuitive rhythm mechanics and authentic settings from the samba and Carnival universe. Use your hands as virtual drumsticks to master the rhythm."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kongastudios.com/privacy-policy-batuque-beats", "developer_terms_of_service_url": null, "publisher_name": "Konga Studios", "support_website_url": null, "website_url": "https://www.kongastudios.com/batuquebeatsvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [],
ohc=MUpG9R4f5ucQ7kNvwH4w_QI&_nc_oc=AdrQKiBintb2_6hSoVHxvtQeQ31etcsBSEzqybNU51lI4XGglE4wXBnT5wUkkpoeAT0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IJ1d33mg2B0KHAU7CeWtIAbGTJ0GIUEj4Dp3S02u1GQ&oe=6A2ADE48"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nJIZzHhetwQ7kNvwGbM2lR&_nc_oc=AdpJhb03SX8YMR_lHBOrVQRlvXiDuHVjsUWHEo-LHg6DY9FvxiCkOT8_FcpgxNsm4Kg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hsVSTJCfr2t6bSCJ2j5jPAa4c9gXIIRpOHwuR9KkNRw&oe=6A2AC22B"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LEkxQUC7bAQ7kNvwHRtWbR&_nc_oc=AdoI2-AYoCo7wsY_kHde0RNJ9UMmRwLEQz6tiZPHffPcEIY7lmIgeU5PUD_tfXSZUfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f9fo8V9MmEXG4WGXdGMVZNvhQbCf7hY-5fl2Kzo337Q&oe=6A2AB93B"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXZnSVu-gvEQ7kNvwGlrNka&_nc_oc=Ado7u6GSeQwEAEJ--otG_8k7ppabjV23pxqsclWqy7-sj3qZ7b6sXTYR4l42I0QMwuE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af860WlQv2IU5p1OwGnpNRhr8AFNFiH4wCnfkvn8_2b8gg&oe=6A2AAD9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsJbKVpqB2EQ7kNvwHzKPLy&_nc_oc=AdoybyLl2uQf3nLmqhtKd7d9BqhdrndqgO1kwXytYdapYWgkhyR8Wsp60E0U_srEi6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4HrihSurq-R0Niv-EI1gMsGb7ZVhsLc3rbnHBOIgkmQ&oe=6A2AC5C3"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL
ohc=Xe3XGRd-RvwQ7kNvwEuAE2k&_nc_oc=Adqy46lrVmIyahTu1ufrRdKxReXKlzriPpcXiZMXrh3R1P11W6q-denjlJe3jQWAkXA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8pskf9UJCy_JadM9Hey7ZanWHamApKNg8TyBiVrjGXw&oe=6A26E9C8"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLC7Ii5DojsQ7kNvwH4Plvp&_nc_oc=Adrb1UcZKXnwe5nPY3uau-I5CAwQzC5T9Vb5wDDWij7WnYe04imlymxlDMk9mO0NUNg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gXk8m0rr39LcbcjO_mye8DZbvrv4p1jmKZonu6hJ-dg&oe=6A26CDAB"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoIgJ9VfM9oQ7kNvwGXEy0o&_nc_oc=AdqoAkeWp0cfAr9_JpjkSOCMkiabjLca3wieRmqf5fMmFS2QhFqK7OO6x1icWlpAX9s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TuT2VEqWlHsm2YV_GfoTCPgeglf9sstZ8FsAbCACabw&oe=6A26C4BB"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmmVYzfB89sQ7kNvwGiQ6a_&_nc_oc=AdoDbJQH0hplXzNYe8CmNC-C5yeJMlTYEy5uDLN2iQ1iw20-_WcQblSGQuM15O6MacQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yXxB10AwBewLCSmFqqjGd42GzT6Pjg5WUm-cVrKvuVg&oe=6A26B91D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4icZD2T6bYIQ7kNvwHoLAHM&_nc_oc=AdqBHa7hKegn3ry4sPJcRlMBrt0QUkgevsFATGjDmKRjMQNDYKbekhwfdmQohGm1STg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mzKLn-Ksi_-InME7nnyolUBVzW4x-2uPAAIW88jp-wg&oe=6A26D143"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL
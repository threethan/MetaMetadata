ohc=XM6tX69v0SsQ7kNvwFQIijs&_nc_oc=AdoQbaSjnlGo0szidiBzyYmdZaQWpx6K77fqNJURwdSBll8XNnbcrUVciwXGrOr9UKk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytOP0QV0sMMRdhUi7My0bwG_HadHBTegwP4rJs7vRy2w&oe=69C7C588"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f8QVzyTIO8Q7kNvwHOkds8&_nc_oc=AdqZXfiW84NtgfykAAVzM3CnNuossuGVfS3Kda1CwPSZvCGaSQcO49H1usXcxahiw3w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPUYERkZZYN79QC7oKl8av7p4HuomejBlTNi86ROsntg&oe=69C7E1AB"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNRyc55BoK0Q7kNvwENp6UC&_nc_oc=AdqVyf85HYMNWNOhSx3tLjHpyOmy2_p6fGfTAbOX35WEfvUcCjEKehWMgEGvjm1HLyg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtgY7EeNX8_wmHjqyz9Vy_u2Ma7ACPVjPa3L4tiWKFug&oe=69C7D8BB"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXDKf4S395MQ7kNvwG2RPvx&_nc_oc=AdoSPdaMppalyQGXmKD0U7fFoeV3J1bO8rcx8XQplhmkmJMOAWV3qYN47tTa2Tau_NE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyR-tE15RjGUIg2_DONqXZ0Fo5W8LzJU9NSgiMm8kjsMA&oe=69C7CD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDHANtzKe-cQ7kNvwE1LASS&_nc_oc=AdpWoEHE4VfZmD_EB0qjF9LC4Bg7W0U__3j5889lufqnd3b9iOZptQhBi6mic6wryMU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRgS7K-tYY0xtxf89SubD64TQTc_thhZCv9qMgjxljOg&oe=69C7E543"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1907669476287371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12448944_1986785761585030_2673846574617985024_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SzJeekcU3EQ7kNvwENyjiq&_nc_oc=Adou-zdZ-mJGQmFJYsryqgqbkmwxjmhXtuOuvUJoA1etIQI4-bgFGLDkOlhh5WTVvu8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyu2VR0dd45B4vJ3Oqe50RipszzLru1H70f2qJ7vOAOJg&oe=69C7C4DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cat 'S' Trophy", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1522738800, "lastRevision": {"nodes": [{"id": "1829795090386725", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2037076092976380", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1714181308642603"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2861553083931814", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139007_361727464296053_1140397757928833024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNfbFIaIcqsQ7kNvwFx_I9D&_nc_oc=AdqHa0RkgKTt2QL1yfrgpCZKt-BagsRN8CyCtW7frGsmoMZDcPTuXTktoNOoICCFPg4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzooSG_EH1n1zCAKMGTYiKIatkHB5E4rNjt8J_6K3DD_Q&oe=69C7BA78"}, {"file_name": "migrate
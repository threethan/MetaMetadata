ohc=oO2WkN5ChgcQ7kNvwEVBNpm&_nc_oc=AdoMYZfoi7A3OdIQijX2FTwolcZQLac3SqiMUFwEXdszIJbRseWnoeCyUsS6XVbuDIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IrQkM5gywLzMLEWuN2jAtJsWsG8bzIoNB4rMeQ-578g&oe=6A0B0208"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r-iCO1TpBEQ7kNvwEqwV1u&_nc_oc=AdpZ-t09bTfBUTYCMnrDfVgi9hJxlXeB5F4NRUumyFudjLGVUVKjsLecXki8GXMg2C4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4idRDxM1z7iUVhiTWEDnlZkngQp8tt3QcwLeYBR3FICg&oe=6A0B1E2B"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH-HK4j7JwIQ7kNvwF9IXBZ&_nc_oc=AdrZE3SoP0HBrRG4jqIQwqIvV7xYEPsZz_u9LREUDNRIRhtN9adZTWRlgyn3gUvQuUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iMk5cHKcedABhSnPRbe0B0TrzawbvAQGSxpM_dMjhWw&oe=6A0B153B"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-SgEDS0dEMQ7kNvwH3OlG5&_nc_oc=Adr26kzaNHTkA7q0IXm8uYVpYV3ZqYh0z_7ETngV7wLsacoX7mQH2OiZpkF56x6do9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AsPzrHU74e2PqnnfrlckbuZylYhf0FnMje5xjUShOpA&oe=6A0B099D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dc4NHGLRXTYQ7kNvwEC1Wiq&_nc_oc=Adqny38sGzwUZ_YOAKRMClOY4W9xjWpY98iaN1YKkxX5wxrjXaITbstNYI3gQm7T1u4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43ADtPR-KDK9Lwi4Gh_bkApjF18MPY_SW4uYsTGOnH3g&oe=6A0B21C3"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL
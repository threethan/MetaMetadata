le_name": "migrated_image.png", "id": "2481140938868496", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427628_168262743824568_3724376363830870016_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOovxKj7_qMQ7kNvwH6n9pP&_nc_oc=AdqZr175paAQjxqxdMHqfXtDuGbnsUXDhfj6W1t-OES2bFpK9ynhJ2ot0uO4ZbiZHog&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRcUPU2hvZ2H5KPnGHVrM3EsFCKrBiYaRgRj-7_-AZGw&oe=6B031448"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWQlCZqb_EwQ7kNvwGxXwv0&_nc_oc=AdowGpdOdLq-wXIL8I0qyogMrHZPLDnJg3NKFV7pCSYT43MiM82uwgLwzlUhDq43a58&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFOc1x7qGDkojH4xz2joDKhq0Uniih1Uw5pUNb_zsslQ&oe=6B03306B"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OccXEwU8_zwQ7kNvwHQCvFc&_nc_oc=AdpaZAJEJgBVEvzWoziGCSKV9O5LTVuhTMenk3-gREUeR3ZRdB54HBFnVG082bRtFt4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcfOjQEADsA_F7iO73Z8uYnV2LSlbI8czACy75yHzxAQ&oe=6B03277B"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lOzEbqVpAsQ7kNvwFhfdrs&_nc_oc=AdoSuLeZmJlYgO860A3dNeB7lbE87ioFRs4LtAzr59laKcq2buRWJI53_OwTbyVXQAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_seE5fty0AUx_us6VFHdzFqCdju1-Mdu2Ck0INfumGw&oe=6B031BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Nldd4WyMt8Q7kNvwGbNfiW&_nc_oc=AdpAWFfowpn3QMYPXXdaITGVUJukIDBkIr5oXT9TJ-Yv5t0XG_CfX8JR3FiKfFAKchM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLg1MElFkpy4Slb3rTBGoDLgJBFaak7ce8V6E3mPUGlw&oe=6B033403"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1907669476287371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448944_1986785761585030_2673846574617985024_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIXh54cD37kQ7kNvwFpPdUr&_nc_oc=Adpp6eoBh9GjYdNg57TGNmwFLg_9QeViGzyhc2n6-X7FVxjsilGf280b4iNMjVwKH_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-1sGe1Vw0CD0dUhi28GNo0yINmUoyOTy_ZkAsLwJseQ&oe=6B03139C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cat 'S' Trophy", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1522738800, "lastRevision": {"nodes": [{"id": "1829795090386725", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2037076092976380", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1714181308642603"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2861553083931814", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculus
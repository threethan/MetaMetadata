le_name": "migrated_image.png", "id": "2481140938868496", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427628_168262743824568_3724376363830870016_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOovxKj7_qMQ7kNvwGCayrJ&_nc_oc=Adpknx8HWdrqUt0HIMT2rXu7Z2_blsHCs1asfDECl02B2_U9IGAcFxOV1Il_0UDCCHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLHE0MuWDKB-Kliahcwh-eyRQuU6GGTmVSK3bSe2L2pA&oe=6B0465C8"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWQlCZqb_EwQ7kNvwHZi7mO&_nc_oc=AdrFHe0Rwy7ZECZX96SdKU6s4By1iwOCGJh0hw2XQEIuWS95T7OhFVxS8FcMYgjuFss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Mmc0AcLqG3M7Lo-TUzS7ooKS7_be7Ntzo3JDt7EqHg&oe=6B0481EB"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OccXEwU8_zwQ7kNvwH74hsH&_nc_oc=AdpjQObQBhYyknxcBtec8Zys89SSFguunqFkzVQn8CAfogcVKrI1ueOS55AGwYQPt3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNs1SYbLUyeWR54rG03pE01toK2KiwjurglxlTzqXmxQ&oe=6B0478FB"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lOzEbqVpAsQ7kNvwHxw-Od&_nc_oc=Adpw3bv29576QqbeH9F2BIvjFqdLNYxwnKu3aFcOZo4e0AiMi74NAhvSdjbOcu4n-co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSb56um4GySUnvN5hl9_C_Xq5eTS4P8sZ2NbwZ9_y1LA&oe=6B046D5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Nldd4WyMt8Q7kNvwFUbTu_&_nc_oc=AdpmTpFcXciGcvQS6VD4g-hGGrs9LpMc91tCW6AV9-TFU8XMUeZ_kmNQers2z3Eko5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMO90C_Sz4RRHs0EdnrNRBXkuI-eYhdpE7Je987xZNFQ&oe=6B048583"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1907669476287371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448944_1986785761585030_2673846574617985024_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTY0lFvE9HYQ7kNvwGDccDJ&_nc_oc=AdoeT-4Qu6riX1iHiAh9JYomwCEr5NLZ1F4EU7Ig3wqGKDNixjsBbUf68SxPX_Es7Sg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDLgP_o1Kn8LAl6aEvnlr9k433RprPitMRQo5PJLEjeA&oe=6B04651C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cat 'S' Trophy", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1522738800, "lastRevision": {"nodes": [{"id": "1829795090386725", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2037076092976380", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1714181308642603"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2861553083931814", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculus
ohc=Xj5kfktTX3oQ7kNvwEh2A5w&_nc_oc=Adq2BYI0Nif56vDRcvyq7OaR6z9_UyAOurcyRQgn_0KcyIRQlhMHZ-y-fd-pIKgL7aU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTx89FD2rA6c1TPpONz9VDRQIaC8ZWnLxzk-WZqAR02A&oe=6AA7E488"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOKXJrH3zswQ7kNvwEb0QFp&_nc_oc=AdpfRKkGAmlo5fdeYbV68XI6bncaffpQjstLa6xxN8hEqCl00N5QWVzUN2EK6tlwcjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAw8eINpv2_Kn9xW3HzwVbnD9oCjjURZgSo37lgFKwUA&oe=6AA800AB"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vLMCzoR2EQQ7kNvwESiFw9&_nc_oc=AdrfbiAxYIM7UlT-WZfQfjOPqD3kZpK8l8kL7eOjN_RCGkQU905AVz6EUgweSPEESHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDnbhhCMmFaTpP3DPwhf4sQujOlZ1ptT2WFOHe41DD-w&oe=6AA7F7BB"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwQliN5A07kQ7kNvwGr4wF9&_nc_oc=Adpr5W4f0SO4wc6Kp8wZkHevgrKFgaMI9yG4NkpzSdOHkgtjDCJWBK30xoxJKS2Bwbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo6iNKvpwS-moJQbDurIabWAcZKjPgQwi5I8XRp5QJpQ&oe=6AA7EC1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zo7Onfm8qxgQ7kNvwHDnFAV&_nc_oc=Ado2VhcxTW079C4f_0J0CROEByEkg6YRZDQFHylxku0QhWZlBXb7tmKlJAuHAJ-6Gtc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlLf0xw-LdAb1zQxyQlYaVrG3GJ2Ai-SRdBt2Or_IW-w&oe=6AA80443"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL
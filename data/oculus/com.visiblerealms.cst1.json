ohc=L5Y3Gb0weHsQ7kNvwFpWAH_&_nc_oc=AdpumWWjm1KEcEWObWN-AkZlWrw4IEsVR2qzx2nbTiG-OTpJXjvSKbMOdW9dEhOzr9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwm_k74829sNepubrOmShUKDhTvb6KbYMS9FXwSxWyepg&oe=69C52288"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f8QVzyTIO8Q7kNvwFhHivh&_nc_oc=AdqXvysrk_dBhti5Wv_ANl1UZw24Mkv9CLoyCUTpMsklTvZeF4M85KIScJgCYnB8w5k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTNetrWdfcO-CivPyot0vk_gGBMO7mkOI7ZddFYW7C2A&oe=69C53EAB"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fs_KyI2BkkIQ7kNvwFefuMM&_nc_oc=Ado4yLnU1zi5b-ZvEK4Z6xC2iu_ljnJssmF1dIIOMveZy4eyskOKOce14SrOscSPDkM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIOXuidZ07fTYhs3RTU5RONcM4LZfC9V48Qvm-8IZZww&oe=69C535BB"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXDKf4S395MQ7kNvwG7S46J&_nc_oc=AdojcXQh-b1Za74UOYU68hvQc7CEGam7GULcja7uUS4DlYIFEeD9uAcHyTOLBeoYjVY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzNY7hHHwuJ45Z8rtt0yReAe5l7-R1vwU134uuPCWINQ&oe=69C52A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1-v-Jfgez0Q7kNvwFURvyX&_nc_oc=AdoQwTpMXcUpkFdlCniorL3ZGfo4kUg2ufYMA2abg3UJAAwTBPvA2-mHYX-otjMXbZs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYeDaC-oukq-_WkBt2JWeaXlQRhKAW8eLAtf_HGHdrzA&oe=69C54243"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL
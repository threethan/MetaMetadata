nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuK2GUb11bMuMcJJzCLTI7Fa25B6cxfWm9Xfg2owc3iwA&oe=69A57E88"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVD_mGM9yxEQ7kNvwH6D-6k&_nc_oc=AdmA_y829xnAJk6UfeTc_8k4_URM0okUYM5bVVnMwciAmGv5mqI603bd3scRDN-wlrU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftCTrkT7fGbsDt00_J5xRLijKzxCaEiG1lbsjqJsk2n0g&oe=69A59AAB"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6F_4h5N5LMQ7kNvwFsRFpc&_nc_oc=AdmMKWhN4b8_eivYHLBwZ6g1q5oNv3QKFUfZ_Mfjr0wNB33twPgEqa4ApRm5MUZp9eE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftW5W21hkcECFLSs0PUnhw-M7_EDD2KS9dVet-_rELMwg&oe=69A591BB"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBygKBEC6dQQ7kNvwEf950-&_nc_oc=AdmNrKzixhUuHl8QllK7CwOOvprxM_qbqALwHIYMxPtzJBhAoOmJIJd2Fl6L_qF7mmo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsc7xK4abBMw_quCyJzvc-YakNL5rCUPNT0_EAJQDk-4Q&oe=69A5861D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhoUKmFY3cgQ7kNvwG72WEN&_nc_oc=Adk0jMXA9xCKicrzku7Xaa-Ga49D2cKCiOuurdTRzRv_DJ1NS6qURDtz9nm7HEfJXYc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs7jFhp9bdypU5d5ssSdEVGXjkKqB5NqROt6sZ6I9NUPg&oe=69A59E43"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1907669476287371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12448944_1986785761585030_2673846574617985024_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAvyJNOYMk0Q7kNvwGBvCvo&_nc_oc=AdlW22swkKhxkaSohU6KQwOCb7p9kmDU5vf3Q2qnRlWOT4g2o40pncbQ4QiWK1yTwFU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftyamGlLSywIWD8RCqLImK9GawBkkYfPPhE1QhiuHekDQ&oe=69A57DDC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cat 'S' Trophy", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1522738800, "lastRevision": {"nodes": [{"id": "1829795090386725", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2037076092976380", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1714181308642603"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2861553083931814", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139007_361727464296053_1140397757928833024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L0SjmPODNkQ7kNvwFQVPJm&_nc_oc=AdlxJTE234xLuVkUa8BkXIP2pVEQjyaZavXEoQxiVvMcIu3I01UlcRNkZDG8F4-qOaI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftiOXWUZ_e1vQLcs2NU4GlJbLOjKgqtrNiIlUB9HMMDlw&oe=69A57378"}, {"file_name": "migrated_image.png", "id": "2740489129338475", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410407_148558275840497_1683005389026623488_n.png?_nc
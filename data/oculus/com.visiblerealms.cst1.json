e7a0a&_nc_ohc=rwclT5qnLqIQ7kNvwFx2syh&_nc_oc=AdqJda_Ed-LVBZf_yPmIgbJhUMj9lhNLyjZEXq6HwUHdNyiSzDLXHlnHpN6AgfmLd1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CJCKD5uU5_UAQSxLaPqMNM3ZxMkONIUga0h8IF4-nFA&oe=6A37F12B"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcwXfSxIcQUQ7kNvwFEpq5u&_nc_oc=Adr0mCg01ZZE_ULFQ0ZdGud4uG3mF5eKAKpwtSwwYJkXpbqF_3sw0_xsxsMBoYAv14U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q1ESXltynQKY025pBshGL_HDX9lJz5S6lpUoq1B77SQ&oe=6A37E83B"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8L8JkEYT-Q4Q7kNvwFzFnQe&_nc_oc=Adose3qwTW05ry5aMzyRZz6rUTqUxnu9Lbi0vBHw8c_EvK5mAFaNygyGFrvaxkB4SVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4kdWM_I3LDDe-gkx7DJsEMUHGrY0BaD9PFeBBmQVFow&oe=6A37DC9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V34ZLDM2W54Q7kNvwFMmrNj&_nc_oc=AdpPkp9ox1LMzhQNiVQYxoAfQ26l-SWI5GFnvKjV9k6lCgthOYHO47kOaw2GJgXAgR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80y0n_S6BMs9EyoHEomLvsCROp1NHbFkf-C7PET2Y9FA&oe=6A37F4C3"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1907669476287371"}}]}, "scheduled_offer
oc=Adkh2ZwT7OXfbe5F5VxID6Uz2sT70FszDKkmnGQTIfr2GaPRSMGIawm3n5s0qaeqDSQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuGbc33mJIKGOffaUJA91xouwjaMfh1JdqdiopnYqe2A&oe=69BA9688"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pqcMRNRb88Q7kNvwEbwZEJ&_nc_oc=AdnLqmUBOXNb-wPkKCzqoO74E04b82zACnQ7zV5JQw4zaHxNNl2zrN3FzRo6BL1NU4o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwrmkzNYRsPIKpy7_JoSYhcUFWAUsYb2Ul_PD_hzlTRWg&oe=69BAB2AB"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex_3PPB4--4Q7kNvwH8QGyy&_nc_oc=AdljpYc7-ld4J9JiQhp-LPvZpvu4mu_03OdP1qAhhu3aSpAqOrGvJ8v79vOSARRPsko&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxFRxZTRGQRdj9vtQ-wYwZVRsQyyzMJ3pKhSiZvo6HZHg&oe=69BAA9BB"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkeNOaJ0ztAQ7kNvwFzx9iZ&_nc_oc=AdmelPbduMzfoyInqw1nkzGR7IUHohlF31eaGF_tL6OJTj-gn6imNo4pPVNq9B103pY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-M3qxgmlgz7iFelEXOaDu2mcXwYdbGYq9xsR39a5_JQ&oe=69BA9E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykRztR-7Iw4Q7kNvwGTQ_lU&_nc_oc=AdmKW6NsmMzgulvOzwOy9JrCIHHDFH89zYJ_1YbPPKqQ1QoFUIeSQlw-CKG8fKkDxsA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJN3CLQ2yruQJlP7D-EMt2u6-qHdoV2bPNQ7I2_HZ23g&oe=69BAB643"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "
ohc=ZFBvGgXiPeEQ7kNvwGz2NJT&_nc_oc=AdpPjcm8WRvqk7HS3trbBMfAgDd0RSva1T8osxm0YKwr4yW0O-zKL1RfeaSDRGLTXgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvEpEkrnowo93M0Oe5qIcQtQz7oP7-FuTKkoMABPKlzQ&oe=6ABBE348"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DroNqkgkorsQ7kNvwFbOG70&_nc_oc=AdojqMvhIwoNqywmyV2OeyTxDpL6DcgVjUv5jUIiGQ8LLP5AxWqIrrtrg1JGYuScWf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINbiWldtDhfn_yo3xkCJ3WI_QH_HSVTgdXxueT7f4DrQ&oe=6ABBC72B"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXeh5zhiPlwQ7kNvwEG4IpG&_nc_oc=AdrPP30WHMi2bMH6un6mHcJRG4ZQ-OgV115M9sHvAluK4gQQoJu_F6JCFnzyiMspMH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa0gtUxoTv9-QTL2BfcavcV2tmUZgdHLmGUX-ab6lgLA&oe=6ABBBE3B"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgH9PxhCCk0Q7kNvwFvBwtY&_nc_oc=AdrULMRiAlqCQTCeuw9DYKqeEp0WsDosCC5gVWRSmo7E2bhxE9TxU9H3o7Fvmj-DlYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkIkQpr9mD0-v2grkT6s-X5nM93bp1Mp6JSADSSUWojA&oe=6ABBB29D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-DGnT60qkQQ7kNvwELVlJf&_nc_oc=AdqJOQ-GapK1ydMmSQT3TT7I-urLtdcSNqno7w_gaAZmlu3KegDLrpKhIel8vQW_2Cg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr3wbF0BzIj5RZRVhY2FM7GTCu9MxNdAU0fl55xiO7fA&oe=6ABBCAC3"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1907669476287371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448944_1986785761585030_2673846574617985024_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SRMPM4UZY4Q7kNvwEV69lo&_nc_oc=AdrkIyeMtPacxsTSa3FgtntsQpP14n5Ec44dpRiP8LcBk5Cw5XoQASsW-7t6ms52MuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtdoeqgTs1NIGJ7NuId8_8J8K-suTRzxkWVeGt38UwTw&oe=6ABBE29C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cat 'S' Trophy", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1522738800, "lastRevision": {"nodes": [{"id": "1829795090386725", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2037076092976380", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1714181308642603"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2861553083931814", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139007_361727464296053_1140397757928833024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAcg0X0Z--sQ7kNvwG9xq16&_nc_oc=AdozpZa6defc8A-t6HnHgM9vi2Ph_PMuEIavHMdnCG7bRzSd-RfekhcxZ7sAaCwGXME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzi98ZhvIiAAD_JFySjDenpYSiczqJX_Lui0iJmtLe4Q&oe=6ABBD838"}, {"file_name": "migrate
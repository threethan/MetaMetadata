_nc_ohc=Uomtr6Rxa9wQ7kNvwF3kcWo&_nc_oc=Ado3Pq2by6-nxPQZIiTTqYKSnX2wGyQc16Ah89raAUkpn2XgbZC9Cjs9U7nA79HdYkI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XaCUAQIGU7k7At-Xq6uWodN47Z5sWD3ExxebERkgDug&oe=6A11D1C8"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIqLsdVVtH8Q7kNvwEPDiIN&_nc_oc=AdpxihIMOhrvHjCqe6_Ebtdsj9mGwMjuPhW4lqTMWd5oi7kGAhWjGWTukXVEK6kPii4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G14zxideOC3l_2qaasVvYfxrJUhmzo-hl0zAeeieF9g&oe=6A11B5AB"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yE_dLKYz4kQ7kNvwEO2H3W&_nc_oc=Adql6EvJmuRR6Bh2HS4h00ZDWMglvfG_EjIlRtxNdyBIasOOSyXs2MEpu8_nqVrSMC8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GAI2kpFiYwHx9GQzi8XspKUMLPb24o9OKgRtn-5bKBA&oe=6A11ACBB"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOa6fE5ejc4Q7kNvwG8LezN&_nc_oc=AdrdjK9jPTFhaFfS9O5Nml_I0qm6IQCJxlhIB-rGwO7Gvk2CsddKIgfdW_ISD6C_nQs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BNerrWaG_QD_45wzFu_vogTkCYjVQhMtJnRP4mSfnOQ&oe=6A11A11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nXYM3YCqfoQ7kNvwHfNWnu&_nc_oc=AdqEMJ5GOpg6M_bbXt-0kh9sP10cEWKpBM3gGjYLIsRqisiuBlHNpMsPC0ZwwnOpyFc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pmBpLYCiXuSyOyOKo46p4aCXB-0iC88_FsLo52MxkRA&oe=6A11B943"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "
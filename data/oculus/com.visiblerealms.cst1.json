ohc=8mrq2DmdWToQ7kNvwFHdpqv&_nc_oc=AdrKIOkdvLOltuu4SE8bpHWw4WGa0TcjBA7A8luscrvYuvttdEXRprtbbb53vVNxnak&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QXNeibXNU9NwnSk1CNNfST4X-zobyqzZjchsRjGJ0NQ&oe=6A32C748"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK5kX8lyP-gQ7kNvwFZAyAz&_nc_oc=AdqA2Z9FORn0KaROO2J6gM9xljI-bTuG5tYOre5kwLYdq8P6qOOZMrXJo7gjkHL3qkA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lgIGKseHgh7m040TLKfwFVmZ1VBO4XTCOrXV5nov52Q&oe=6A32AB2B"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70rWhcQd58sQ7kNvwHoO6vg&_nc_oc=Adqw24DplYqSDP8sVCjsHy_DDKqVdkaPyhUgTy3HuSxTcfpvm8t1ZcxhxXDkIftEstU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TVeHJeq768Lv978-QcTx8wXYP2_ooX2OLmFjYhuPLdQ&oe=6A32A23B"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kaw_TjJrdaYQ7kNvwFTLH6r&_nc_oc=AdoBHxWCTEXPF3DrgIH3wM6LUUicBD95Bc_60TS7rOxINYXqL2WjSR-98PflnRwcHpA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ksaxDzo1osqvz-4n2Z4cKNOni5VXVx731oSzwoN8wZg&oe=6A32969D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0SSC9YgOmgQ7kNvwFpvFnP&_nc_oc=AdpclGxH4auHbW1ce_eNRoiS0BWw97XpvmGUwGsWDMAhj_LlhaRCMzuFXaiDQsDBCpo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89wFce_zTuE18pa3VLPfj6dFWHU02p6RO9N_yHEZ1r2w&oe=6A32AEC3"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1907669476287371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12448944_1986785761585030_2673846574617985024_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp6PS6aGgNsQ7kNvwE9Mwtr&_nc_oc=Ado02acqh4_u11xzhqOf4Y4MmbHPJ3SphwndwKLSRoldExmPTiav1S8gy9sTlle8lmU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qbZim2zZhKQ4rIpFnNK8ginC7YLEwzP6hpNO2N5uJLA&oe=6A32C69C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cat 'S' Trophy", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1522738800, "lastRevision": {"nodes": [{"id": "1829795090386725", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2037076092976380", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1714181308642603"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2861553083931814", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139007_361727464296053_1140397757928833024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IuFXQFojTAQ7kNvwEiWzvp&_nc_oc=AdoFlfG2SjTi3a15mHjmSROaR0Pe3usKsctPjk_Z6USn6p2dsty22_CSvhHsEkpGvRA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wk00iq4hKIDwbuDNjWy9_2yn2eMX8cVg3qQIHxkdbJQ&oe=6A32BC38"}, {"file_name": "migrate
ohc=pBOrwGujK1gQ7kNvwGkJPK9&_nc_oc=Adpw-7XxRrTO5XNj7oOg25B8Lb6d91fUb-yUFvrgxX2EleYgbMEoVkAvsvwVA7qfMQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYk8cgYws_cFwEjiewBw6_ywwDmI5wj0Twi7wo1bYhHg&oe=6ADF4388"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erar8J8mG-wQ7kNvwG2wo0d&_nc_oc=AdrBTeoLgfZh8e8VX9qe0WXa5QUN2anvNkwloGt91pGm0_82P_tF0KerozBphrQKdV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfpq0rKra_vWGeAGAukFw2nQKihtUDSgVUGqBimKAF3w&oe=6ADF5FAB"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVhlMqjF9TEQ7kNvwFdPwiO&_nc_oc=AdqoyEaoloEIUi6l_nJc6Xs3Xcg9RbITtS9_uOkqsYsjuPfyc5krsetsrUIc441zL2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBvqibasRDzSiscHg-u9k0-_bA_Brct9VTtzGR0RyXTg&oe=6ADF56BB"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcFv-Tg8TrgQ7kNvwGCN17v&_nc_oc=Adqo00M7AZeBnsIAG41x1SqsSUrmR7N7cL4MFFP6lXU6tviwlKKFWv-GLs-63SYxJA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeTfv9v6zpndZebOVQyh1welN3GlxpYfTwXbMUFYBifA&oe=6ADF4B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OxWvFu8CcwQ7kNvwGSq8cU&_nc_oc=AdoIUabuZ8LI9ybET7ImJ1TPG7AOIAlmK2BUA33ZRXar05CI1xMxD3ewxcwW9i4hWHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAWE6hfwZd_1MgovoWQxbddVnpR9JQL7h7qLW2afSJVQ&oe=6ADF6343"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL
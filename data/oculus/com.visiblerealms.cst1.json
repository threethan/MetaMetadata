oc=AdmoFvbk5Wwqi4bccNTPOs7xOAahy8_PODi7KWfjwazpXPh1WChrapohOdh3a6Il_0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsJjg3uYI5TamOu8cWUaXQ_fhvvSGXO-TdX6LZCBFr-pw&oe=69A97308"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ld7fESCYNIQ7kNvwFgVE2G&_nc_oc=AdmAM_gA4K8n1Llqic2kDlW06zljhxMAW-qraJLXYVtl-27e7INGuufOUu43b6s0hLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfslBOWppC-GsVrbl0zntQhDqSf4cWSH17-91gvwbhTKDg&oe=69A98F2B"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GnqYVDFvfoQ7kNvwFUCGzz&_nc_oc=AdlHjBJvxH2R_V-sABV6_Kx0eydRV7YYSAlNOkaFmjd-TCPQzq3bs2THHZHX6ZrCa-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv5t9NpExOHii6rxn8Rz_TM9-v9NCvELQ4e8FWqpKhQkw&oe=69A9863B"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUMKwB3Mt_gQ7kNvwGVU5Hb&_nc_oc=AdkQHqSh1RolS7EXy7kEXMqh_kc6lCf_G_oAfT1lwq-v0b0WDn0XsRRM3Rqk4p76SbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsL4MPpyzGYSPiJSEi-eK0ufFamIKruFTrxaB1vIR2WoA&oe=69A97A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI7B0Hc91ysQ7kNvwHj52eN&_nc_oc=Adl2a8PB9M8GpmnwpTqvPmfs_JIubJSJxFqRtWQxrxW2jwrkp-51D14vOMx9HXXgMVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfulR98FMPUXi-NoDwJDbjh8OnArzzNEYM_0195LjgWUCg&oe=69A992C3"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "
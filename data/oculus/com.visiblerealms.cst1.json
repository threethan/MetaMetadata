oc=Adm7LVTZzWb7eIqYzg9mEhfP4jAX-07Lm97LAoiXbTL8PilXrxwjeB4TWj72dhfE_wE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXDd_CnuXaOAw6YBWLcy6Cdn72U9q6VgVQodU1c4oekw&oe=69B15C08"}, {"file_name": "migrated_image.png", "id": "1073051666392031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410280_798923820315231_3129386890684268544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Mhu5uDeD9UQ7kNvwH3d0o-&_nc_oc=AdnFvc_j9dVHvAShKVDjYL-UYDrtbho-trnr6z-1PAoYstfYmMt00RugTI6n86TSVco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7Hu_PToVRnuItrHPMxtZOR2Bu2HlVgT3AeVfDoTtaBA&oe=69B1782B"}, {"file_name": "migrated_image.png", "id": "519543012325134", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410200_380138495730072_6437105380458758144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMPFCs7eUBUQ7kNvwHUDDt9&_nc_oc=AdltmWRw-h0BDIpCyUdzTgqPF55cEBGX2E9V33jXpenTbBFltKls_CmHTNLremwrq18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfysRs7FVnItL9ktBru_EYADV0oXsSqaWQmQJsZIRwiEnA&oe=69B16F3B"}, {"file_name": "migrated_image.png", "id": "226611475377680", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12534042_154466091904783_1012288985252233216_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK54dmGGU_kQ7kNvwEi05Q9&_nc_oc=AdkcwNri30HKHiA3y5zddvUObqrhmXUEiV6IsSIt2-OCSQ583crXvDdgV9nI3PwyTwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLf479jR2dKHRy9D6KPnMmySfTVSPgdLsGlqXb8BBkLA&oe=69B1639D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail.png", "id": "1954501114863988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504730_1954501118197321_8750639735501750272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdxFqFn9DEAQ7kNvwHMxKj1&_nc_oc=AdlxIjEG8ugRVc_JnYOhaP1vmqMc0ZDSLyrz4AcgU5Mpw2z-SN5udpGs5bYNusHnn3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtHjsgQPz-X_DCyR6h9vZ1HjHMG259RtX5yaRV6Gp0FQ&oe=69B17BC3"}, "display_name": "Cat 'S' Trophy", "keywords": ["cat", "racing", "catstrophy", "catastrophe", "kart"], "long_description": "In Cat \u2018S\u2019 Trophy cats have races in honour of the ruler of the internet - the Cat God. Conveniently, all five cats in the game can turn into vehicles when the race begins. The gameplay of Cat \u2018S\u2019 Trophy consists of two parts; Part One is track drawing. The player draws the track where the cats will race. Part Two is the actual racing. In order to win the race, players need to gather \u201cstar crystals\u201d around the track and the lucky cat to gather the most star crystals from the track wins.\n\nWith references to popular culture and to memes, Cat \u2019S\u2019 Trophy has been designed to be approachable and engaging to a wide audience. The artwork, graphics and characterization are immersive and appealing, while gameplay has been designed to counter and minimize causes for motion sickness. There are no engines revving but cats purring before the start of the race too. Players both young and old are bound to enjoy Cat \u2019S\u2019 Trophy.", "short_description": "Welcome to the world of Cat 'S' Trophy; a cat kart racing game where cats turn into half cat, half vehicle and FULL AWESOME! Roll the cosmic ball of yarn to create tracks and race to collect STAR CRYSTALS to please the ALMIGHTY CAT GOD. Find the lost GOLDEN BURGERS and use weaponised cheeseburgers to win the Cat 'S' Trophy!"}]}, "developer_name": "Visible Realms", "developer_privacy_policy_url": "http://www.visiblerealms.com/", "developer_terms_of_service_url": "http://www.visiblerealms.com/", "publisher_name": "Visible Realms", "support_website_url": null, "website_url": "http://www.visiblerealms.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "
mfuU5wOeWcvOMREBxtrQM3LO37EbWMW5bbpJ7ZKuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqn9JgBBvkxStpwJit-_Dooc0wcS_3E4e02IoPKC3E0w&oe=6B00689E"}, {"file_name": "Match Point Tennis Update - Action 2.png", "id": "1330676245230727", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_1330676248564060_8023485742680408422_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA1gqhVt5m0Q7kNvwG2x8cz&_nc_oc=AdpaObZPkZvQzpfc34BFa_1hVdWyNoXAsJCWec7pjVdBwmDd5s7UGFxlxR3y69yuSGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD0NKRpGuITLnY7fcqoXTErmeFxIf_uGLNi1AxAZHvBw&oe=6B005A81"}, {"file_name": "Match Point Tennis Update - Trophies.png", "id": "998875389412021", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313072_998875392745354_1078671636320721642_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3gGy2c04uUQ7kNvwFadFFm&_nc_oc=AdoJdBGMFutvtDNETrmCEMUzU5WBVjpI7HnueXJTxEcA7XS5x_Ml_1QcnwXotxI3ha4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg6xLRO8q7wdfTYawM-vEFxzwXwgK1z62Tw8oPb6woSw&oe=6B005E9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Match Point Tennis Update - Action 3.png", "id": "1333709154883690", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314351_1333709158217023_2230199778224434468_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxzlHW_p49MQ7kNvwFB2SU5&_nc_oc=AdpvqsC0Lu4Tp82nH65LGPZCgVxnJoAorLJV77_r1wH7C7u7q6uIHiDBty9b-KYz_bk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4b9dkjocOsHCOJT5jEulqTi2K-s2x40hx9tCIdKIQgQ&oe=6B0054DA"}, "display_name": "Match Point Tennis", "keywords": ["tennis", "sports", "racket", "multiplayer", "simulation"], "long_description": "# Match Point Tennis: Join over 1 million players world wide!\nMatch Point Tennis is free-to-play VR tennis , now with PRO TOUR: Paris Invitational. Real tournament brackets, 42 rivals, six Parisian clay stadium courts, and crowds that react to every point.\n{1004127365684421}\n\n{1447391470473611}\nFree to Try: every player gets a guest pass into the Group of 16. Lose, and try again, no penalty, just another shot. Win, and see what's beyond it.\n\n{2425097917899615}\n# PRO TOUR unlocks the full bracket: \nMPT 250, MPT 500, and MPT 1000, ending in a night final against Bastien Leroy, ranked #1. 12 Legendary cosmetics are earned only by winning rounds \u2014 not purchasable, not random.\n{1716630966328170}\n\n# Ranked Multiplayer with Leaderboards\nBattle AI opponents, train, or compete in Public, Private, and Ranked multiplayer matches. \n{1453026246821991}\n\n# Earn Your Career \nEarn XP, unlock 64 achievement trophies, customize your avatar and racket across four rarity tiers, and climb the Seasonal and All Time leaderboards.\n{1511494476508709}\n\n# Play on hard, grass, and clay courts, each tuned with distinct bounce and feel.\nOver 16 New Courts, Including Paris, Amsterdam, Melbourne, Rhode Island, and many more\n{1770756477226088} \nMatch Point Tennis is free to play. PRO is a one-time purchase unlocking the full tournament, private lobbies, leaderboards, and Epic/Legendary cosmetics.\n\nServe. Rally. Unlock. Rise.\nMatch Point Tennis.", "short_description": "Match Point Tennis is free-to-play VR tennis, now home to PRO TOUR: Paris Invitational - real tournament brackets, 42 rivals, six Parisian clay stadium courts, and a crowd that reacts to every point. Free to Try the Group of 16. Go PRO to play the whole tournament."}]}, "developer_name": "Backyard Games", "developer_privacy_policy_url": "https://backyardgamestudio.com/match-point-tennis/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Games", "support_website_url": null, "website_url": "https://backyardgamestudio.com/games/match-point-tennis", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categor
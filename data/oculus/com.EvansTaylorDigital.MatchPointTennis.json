_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7qWmDcljt5u7b9NP3MZH_cXSi4b5Gr4EGj719Qnbt1Q&oe=6A8040C1"}, {"file_name": "Match Point Tennis Update - Trophies.png", "id": "998875389412021", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_998875392745354_1078671636320721642_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Nx95BnBO2AQ7kNvwG_qvcT&_nc_oc=AdrGIJ4beiyvCkEpYaSuv_Tnu2QvDzKrtq4T9Wetad6U82rSOqOu_sf7VzizgcbVoK4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-P-5Lik2EK5vVAr151W6zdgGomMdteVg_a1S040RdcA&oe=6A8044DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Match Point Tennis Update - Action 3.png", "id": "1333709154883690", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314351_1333709158217023_2230199778224434468_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTiTTgtgPSIQ7kNvwFb0JAj&_nc_oc=Adp66IrPKsdsmpx2zde9e5VQcoUTk5U1oL1ZK-F--Pw3SZn1oFvXugUMaXzGAFyFFeA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG02rKZz7fRqYJlTvJ8LA7flz8tFhNa8gAI3_0yLeJp1Q&oe=6A80735A"}, "display_name": "Match Point Tennis", "keywords": ["tennis", "sports", "racket", "multiplayer", "simulation"], "long_description": "# Match Point Tennis: Join over 1 million players world wide!\nMatch Point Tennis is free-to-play VR tennis , now with PRO TOUR: Paris Invitational. Real tournament brackets, 42 rivals, six Parisian clay stadium courts, and crowds that react to every point.\n{1004127365684421}\n\n{1447391470473611}\nFree to Try: every player gets a guest pass into the Group of 16. Lose, and try again, no penalty, just another shot. Win, and see what's beyond it.\n\n{2425097917899615}\n# PRO TOUR unlocks the full bracket: \nMPT 250, MPT 500, and MPT 1000, ending in a night final against Bastien Leroy, ranked #1. 12 Legendary cosmetics are earned only by winning rounds \u2014 not purchasable, not random.\n{1716630966328170}\n\n# Ranked Multiplayer with Leaderboards\nBattle AI opponents, train, or compete in Public, Private, and Ranked multiplayer matches. \n{1453026246821991}\n\n# Earn Your Career \nEarn XP, unlock 64 achievement trophies, customize your avatar and racket across four rarity tiers, and climb the Seasonal and All Time leaderboards.\n{1511494476508709}\n\n# Play on hard, grass, and clay courts, each tuned with distinct bounce and feel.\nOver 16 New Courts, Including Paris, Amsterdam, Melbourne, Rhode Island, and many more\n{1770756477226088} \nMatch Point Tennis is free to play. PRO is a one-time purchase unlocking the full tournament, private lobbies, leaderboards, and Epic/Legendary cosmetics.\n\nServe. Rally. Unlock. Rise.\nMatch Point Tennis.", "short_description": "Match Point Tennis is free-to-play VR tennis, now home to PRO TOUR: Paris Invitational - real tournament brackets, 42 rivals, six Parisian clay stadium courts, and a crowd that reacts to every point. Free to Try the Group of 16. Go PRO to play the whole tournament."}]}, "developer_name": "Backyard Games", "developer_privacy_policy_url": "https://backyardgamestudio.com/match-point-tennis/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Games", "support_website_url": null, "website_url": "https://backyardgamestudio.com/games/match-point-tennis", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_
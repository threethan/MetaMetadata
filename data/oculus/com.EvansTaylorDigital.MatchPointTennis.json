for tennis enthusiasts to connect online. Competing in matches and tournaments will earn you in-game-currency which you can spend on tennis gear and clothing for your character.\n\nVirtual Tennis for Fitness\nGet those arms swinging! Match point tennis offers a fun and relaxing way to burn calories while you serve those aces!\n", "short_description": "Strap on your Quest and let\u2019s play Tennis! Serve, smash, slice and and top spin your way to tennis glory with our unique and fun VR tennis game. Match Point Tennis is a game that\u2019s easy and intuitive to play, but challenging and fun to master. "}]}, "developer_name": "Backyard Games", "developer_privacy_policy_url": "https://backyardgamestudio.com/match-point-tennis/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Games", "support_website_url": null, "website_url": "https://backyardgamestudio.com/games/match-point-tennis", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "298513249007347"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "336678451139222"}]}, "baseline_offer": {"id": "336678451139222"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1623712200, "status": "PUBLISHED", "id": "336678451139222"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "
&_nc_ohc=OfS_e3EmZjgQ7kNvwF6Z4Nu&_nc_oc=AdoSNVZ4i8Kbe22CPjPU9f7DisWdyOf7ynKEaTuXiC0fb_yYQk4z9pEodalw8-WUMiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTde-mGSQsGHLs3BIXIbvNnmqN8QxSaDlKhW4CwHI3RMA&oe=6B0DAD84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Free Throw Bomber", "keywords": ["basketball", "explosion", "physics", "throw"], "long_description": "Free Throw Bomber is not your average ball-throwing game! Everything you've wanted to do, from long-distance shots and shooting down at a cliff from a bridge, to aiming at hoops on a skyscraper from a small airplane... in this game you can do them all. You can even shoot hoops on the moon! And it's not just throwing balls for that matter: your ball will occasionally turn into a bomb, so hurl it at anything you want and watch it explode!\n\n[Music] d-elf.com\nhttp://www.d-elf.com/", "short_description": "Free Throw Bomber is not your average ball-throwing game! Everything you've wanted to do, from long-distance shots and shooting down at a cliff from a bridge, to aiming at hoops on a skyscraper from a small airplane... in this game you can do them all. You can even shoot hoops on the moon! And it's not just throwing balls for that matter: your ball will occasionally turn into a bomb, so hurl it at anything you want and watch it explode!\n\n[Music] d-elf.com\nhttp://www.d-elf.com/"}, {"images": {"nodes": []}, "id": "261238499292505", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30d5\u30ea\u30fc\u30b9\u30ed\u30fc\u30dc\u30f3\u30d0\u30fc", "keywords": ["\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb", "\u30d5\u30ea\u30fc\u30b9\u30ed\u30fc", "\u7269\u7406\u6f14\u7b97"], "long_description": "Free Throw Bomber\u306f\u666e\u901a\u306e\u30d5\u30ea\u30fc\u30b9\u30ed\u30fc\u30b2\u30fc\u30e0\u3060\u3068\u601d\u3046\u306a\u3088\uff01\u8ab0\u3060\u3063\u3066\u4e00\u5ea6\u306f\u3084\u3063\u3066\u307f\u305f\u3
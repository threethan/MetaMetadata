25/499300725_1710367310030494_6115172995992698667_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMunvEvehZ0Q7kNvwEQywE6&_nc_oc=AdohnuA2lS3CL0GT6WY8xxOJSVCPpWJBVpIRzz5qrx1HeDc9k8mmkq4E6mNtTOZvfmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Wpa6PT2J7UgS8VxwGIFncz5o0RjlV1VHBf7lWRJMJg&oe=6AF884DD"}, {"file_name": "12_stadium_trickpopup_hud.png", "id": "1060720210044141", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314663_1060720213377474_4591972866231885661_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0vdRyB6pQUQ7kNvwEE9kW6&_nc_oc=Adow-h-wPpVlbqfUYX4aVqi8_tTPrXjz1Yt_4LNCfKL7VuA_IAEZqgJkm5vIu6JjoHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI9rEXER0ixO2Qom9ofJfEOb9fsxQgts3ekiCM40SyFg&oe=6AF88B05"}, {"file_name": "13_stadium_crush_field.png", "id": "2019047942083797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499294616_2019047945417130_5998234078675588886_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiAZkP_WJIEQ7kNvwE8fH81&_nc_oc=AdqgfK6H7PhOUhL6xAPb3A3TSbrr3C7aV4avah3zU_eKQrnV8CdM_g08lrELaRNNLZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9v-vpsw9a6hoSeRnY121_qdC9LUEdh0Uy1crgPQGNfA&oe=6AF895DD"}, {"file_name": "10_stadium_wheelie.png", "id": "1110758511640063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299715_1110758514973396_5698024754470147056_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCg9ME0XBBkQ7kNvwEXrBMF&_nc_oc=Adpm6sHmVsKzQ8hI_6UgOcAvXiCbNGaJn1MQcnK8c_XAHieY8mh3mzW-iYr00AhLyoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr-QBecds7rAehEbi5IA74j3vGxMYHESg-8YqM_lyYpA&oe=6AF881E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1076061335400556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299093_1076061338733889_3709438432914865565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQILrijRTXsQ7kNvwGqQ7bj&_nc_oc=AdrLCX73ir2U7N7wyz-9duHL6jYgx_g_WV5njyXNIIjgiYBCcUGeKjSLvh_PqWElq8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFHPooFAP7Ps50RM8aEz5IP9Smy_qreUafVNgOlR1ZLQ&oe=6AF87B2B"}, "display_name": "Monster Truck VR", "keywords": ["racing", "driving", "offroad", "stunts", "truck"], "long_description": "You are sitting in the cab of a five-tonne monster truck. Turn the engine over, plant the throttle, and the cabin lurches as the floodlights of a packed stadium wash across the dirt.\n\nEverything happens from the driver's seat: you never walk and you never teleport, you drive. The truck is simulated wheel by wheel, so suspension travel, tyre slip and weight transfer are real. A bad landing punishes you and a clean one feels earned.\n\nTHREE VENUES. A floodlit stadium with dirt ramps, a car pile, tunnel pyro and fireworks on your biggest combos. A 1,502 m dirt circuit with four jumps, banked turns, whoops and mud. And the Proving Grounds, a 17-section arena with no clock and no score.\n\nNINE MODES. Freestyle: chain backflips, rolls, spins, wheelies and donuts into combos before time runs out. Crush: flatten a field of 37 cars, vans and ambulances that buckle and shed glass under the tyres. Race three AI trucks, chase your ghost in Time Trial, then Long Jump, Wheelie King, Donut Derby, Sky High and Free Ride.\n\nFIFTEEN TRUCKS. Heavy crushers, grippy climbers, speed machines and air specialists. Compare power, speed, handling, suspension and weight in the pit garage.\n\nA CAREER OF 15 EVENTS worth 45 stars across three tiers. Stars unlock the next tier and the next truck, and every event remembers your best run.\n\nThree comfort presets, two steering schemes, adjustable haptics, km/h or mph, and a seat you can recentre whenever you need it.", "short_description": "Climb into a 5-tonne monster truck. Crush cars, fly the stadium ramps and race the dirt track across 9 modes and 15 trucks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/1u3dRaJmdu18fMUXYDY34C", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/1u3dRaJmdu18fMUXYDY34C", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142003481599087"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313058_1953656578636141_5512383424248979474_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On0FZJ80EVIQ7kNvwGhsEem&_nc_oc=AdoWJNvb4pdHfupuQcCF8e2F4tlRphYFPOdAXikzKoUfZyigrgivHJajqoJsKnjfZrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcHwjuWi_VQOYvIsCqin9xP4-VtEf2zUKfmiSER4aoTw&oe=6AF8997E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monster Truck VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1790343060, "lastRevision": {"nodes": [{"id": "1141761774956591", "release_type": "SCHEDULED", "administration_
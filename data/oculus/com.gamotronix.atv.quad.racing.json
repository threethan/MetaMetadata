g?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX6yRAD4E5IQ7kNvwEY5gYv&_nc_oc=AdoSpJ70bds9OgXrM9Ug1cFJz5pVVX60g-9ZwPmybGAANZZiu3QLgvssPRmaNeyMahQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhAue7CH79Sy9zkwvJEvxw50j0-xno7ENO1qZzG1-wbA&oe=6AFB3C76"}, {"file_name": "AtvBike4.png", "id": "1236012802932931", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312332_1236012809599597_8234054215324479640_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqM4jQftPIwQ7kNvwH1kWdM&_nc_oc=AdrkV72emJYOS0yhd5RoLQ-QUAqDue1pBN8N7NQx0DzaTJyCYwOEmJXVD154W7hBYuA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-W9Tn48FhToKDtEHbssvGIvN9S4QZnMZC882dAWvaNw&oe=6AFB4918"}, {"file_name": "AtvBike3.png", "id": "4316660438647639", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314641_4316660441980972_3149414062491083328_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAkIZzPZ11gQ7kNvwGN29k2&_nc_oc=Adr4s-5L487SZF38GJVBaDwc5dxX63YyzGhldUcaNeXVEF2MSzJKYWwtTcaELzOjN7c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzTRcfnkuUt3_N047zhtAyOchCKv2mPLTlCDHQUIfCTg&oe=6AFB4041"}, {"file_name": "AtvBike5.png", "id": "2391926654669330", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593862973_2391926658002663_1525488585358454486_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwmM1xfhFsQQ7kNvwGtUStI&_nc_oc=Adoy01J7KHvzt72TXtjtjBJQRE-I8tw4kfRNi-aEl4CEwIwitQqQgpX3adRhuh6VfV0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGIdmIYg1jFl59Pmnxn5Snx9rsQFwckoVOgNSktLB6Qg&oe=6AFB298A"}, {"file_name": "AtvBike1.png", "id": "1588420922882775", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499311597_1588420926216108_5043393363188868211_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfkHxZ2QB8MQ7kNvwGreT4p&_nc_oc=AdrmCR64cyraHyuZ986GQRTiZEyXusfks2rK0XP_G5qVvayApqxgFO5gT1B0A_Cn5vA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6hDVXualbsmMmIB4XKmQH_3eIxEhcimnUe8ZB1LoAyw&oe=6AFB43FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ATV Quad Bike Racing VR", "keywords": ["Offroad", "Simulator", "Driving", "Dirt", "Fourwheeler"], "long_description": "Feel the dirt kick up behind you as you lean into the bars in **ATV Quad Bike Racing VR**, an arcade-realistic off-road VR racing game built for Meta Quest.\n\nEvery track feels different under your wheels. Grip through loose dirt, hold your line across mud and paved corners, feel every bump through the suspension on a rallycross-style mixed surface, and watch the dust trail behind you. A full field of AI riders brake late, fight for position, and never just hand you the win. Some tracks reward patience. Others reward nerve.\n\nBuild a garage of ATV, quad and four-wheeler bikes, each with its own character, unlocked as you clear Career events. Start on something stable while you learn the bars, then work up to sharper, faster machines that punish sloppy braking and reward real skill.\n\nRace your way, solo, at your own pace. Grind through Career for real progression, jump into Quick Race when you just want to ride, chase a clean lap in Time Trial, go last-rider-standing in Elimination, or settle in for Endurance. Push the AI difficulty up when you want an honest fight.\n\nBuilt for comfort from the ground up: natural handlebar or thumbstick steering, adjustable tilt and vibration, left-handed support, and instant checkpoint respawns, so a crash never means a long wait.\n\nThis is **ATV Quad Bike Racing VR**, extreme off-road racing, single-player, built for VR and made for real off-road adventure. Simple enough for your first lap. Hard enough to keep chasing your best one. ", "short_description": "Grip the bars and ride real off-road terrain in ATV Quad Bike Racing VR. Race quad bikes against AI across Beginner, Sport and Pro tiers on tracks ranging from dirt loops and paved circuits to rallycross and scenic trails. Play Career, Quick Race, Time Trial, Free Ride, Elimination and Endurance modes. Unlock bikes and tracks as you clear Career events. Natural handlebar or thumbstick steering, adjustable comfort settings and checkpoint respawns keep every race easy to jump into."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4011727499128229"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1364605122287358"}, {"status": "PUBLISHED", "id": "1088583920315015"}, {"status": "PUBLISHED", "id": "3988362257961630"}]}, "baseline_offer": {"id": "1088583920315015"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1364605122287358"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4067875070180138", "version": "1.0.3"}, "id": "1507006163989619", "channel_name": "LIVE"}]}, "is_for_
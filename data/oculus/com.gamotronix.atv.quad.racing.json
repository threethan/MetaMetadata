cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW-5MpdTNz4Q7kNvwGC6cBW&_nc_oc=Adon8q48gr8SecjJut39AGQ53RtucFrDTZFHVurYqNd0GEWNecV5M-qjVEmSpWQkoWw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoArARYKLaQSSHgfs0kByDK8H7cXpeS6jC2ftaWz2XOQ&oe=6AFB4860"}, {"file_name": "AtvBike5.png", "id": "1501748698641444", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623876_1501748701974777_8297358479854718187_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaEHzQYnAf4Q7kNvwEs1tDx&_nc_oc=AdqiWWguqH1aXr_AWgRW4JeY456hKfQkSn_o0pqV07BHHV-DVMx7lZcOa-AYlntfSeY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5ECSo6geTBgBKVkIumT3FYh_iRqfy-h52Q-AJwj2g9A&oe=6AFB39E1"}, {"file_name": "AtvBike6.png", "id": "4685687858421663", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499628447_4685687861754996_3718835546397894184_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-L1pf1neGUQ7kNvwGHbvcJ&_nc_oc=Adozh__uJzNPL66u12Cro0m0BLvF5b_RwXufUUerh6QG5JLeGxT-Y6ei3of5NRN9_fQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4f9oUEAP3dGWBSYzG7RhY5tZPePKWyTofgqH_eOmhQQ&oe=6AFB1674"}, {"file_name": "AtvBike1.png", "id": "1044092452017324", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593718973_1044092455350657_7488204955933653821_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AHoqGQQ2AsQ7kNvwEzJjyX&_nc_oc=AdpyeuvAlxJ7kDqX3UV9Ri6YN7enncVdeo2jLnSIrU-54FN_XIA_CQ6ALK_ff_nJHlg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo4sGT_wnQIPv2vUsG0Y0_Ke8t-wjF6R3cMv8QyDPyNA&oe=6AFB3D83"}, {"file_name": "AtvBike3.png", "id": "1602728034734116", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628454_1602728038067449_6083570156287444714_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2LQQ3xSPPYQ7kNvwFY4ZGr&_nc_oc=AdpQfYXpemtaPWWOWuxzTeGI5Lk-vQYDZFxNJEeqegCMGXwCSl-oBIvhSJ3nK6ldsrw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCyaiUhYqk6QDqT0kNtlDF5swhXe5N7qIIXjK83Ijrmw&oe=6AFB3AD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ATV Quad Bike Racing VR", "keywords": ["Offroad", "Simulator", "Driving", "Dirt", "Fourwheeler"], "long_description": "Feel the dirt kick up behind you as you lean into the bars in **ATV Quad Bike Racing VR**, an arcade-realistic off-road VR racing game built for Meta Quest.\n\nEvery track feels different under your wheels. Grip through loose dirt, hold your line across mud and paved corners, feel every bump through the suspension on a rallycross-style mixed surface, and watch the dust trail behind you. A full field of AI riders brake late, fight for position, and never just hand you the win. Some tracks reward patience. Others reward nerve.\n\nBuild a garage of ATV, quad and four-wheeler bikes, each with its own character, unlocked as you clear Career events. Start on something stable while you learn the bars, then work up to sharper, faster machines that punish sloppy braking and reward real skill.\n\nRace your way, solo, at your own pace. Grind through Career for real progression, jump into Quick Race when you just want to ride, chase a clean lap in Time Trial, go last-rider-standing in Elimination, or settle in for Endurance. Push the AI difficulty up when you want an honest fight.\n\nBuilt for comfort from the ground up: natural handlebar or thumbstick steering, adjustable tilt and vibration, left-handed support, and instant checkpoint respawns, so a crash never means a long wait.\n\nThis is **ATV Quad Bike Racing VR**, extreme off-road racing, single-player, built for VR and made for real off-road adventure. Simple enough for your first lap. Hard enough to keep chasing your best one. ", "short_description": "Grip the bars and ride real off-road terrain in ATV Quad Bike Racing VR. Race quad bikes against AI across Beginner, Sport and Pro tiers on tracks ranging from dirt loops and paved circuits to rallycross and scenic trails. Play Career, Quick Race, Time Trial, Free Ride, Elimination and Endurance modes. Unlock bikes and tracks as you clear Career events. Natural handlebar or thumbstick steering, adjustable comfort settings and checkpoint respawns keep every race easy to jump into."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4093955290905449"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304952_2256195381799492_6172059759424320529_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRWWkwM5WRcQ7kNvwGRNANU&_nc_oc=AdqMdj6PEYHEE1v02C1m7ua0lO35pIziibsEbJ-SE-oI5ztF_Wzx2p9r7ZnJt53e1pE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZmhki-deG_B_BG6GbRxMbr3q_KHFROxde2L96uUpztQ&oe=6AFB19ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ATV Quad Bike Racing VR", "platform": "ANDROID_6DOF", "context_categor
501_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdnZwTqPgdQQ7kNvwE9ZBO9&_nc_oc=AdobLZSY-Szb68Zx707T3JVDaOuduMlUAEIdtBZMK7DnXCzu4bZxsop2BjtZauhiJnc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT596960wDwf7-Rtx_Q3u5SFw1-4L0XkYAlgFcTDoo1JA&oe=6AF9DFDF"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1065393473150672", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619059_1065393476484005_1344994092689022907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7o4hnW_7dAQ7kNvwFIzQJm&_nc_oc=AdpHepXs-BOelFr-k4XJ7HdBOnH0tuIsQcWKGeUje-L9SXlrTv4pk_awPU58CMSWtIs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyCtd9h2NGTI2MYpm3jd06S5zGG6LOL972pReYjphgRg&oe=6AF9E3E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pixar Tag V1", "keywords": [], "long_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time.", "short_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time."}]}, "developer_name": "Solix", "developer_privacy_policy_url": "https://docs.google.com/document/d/1
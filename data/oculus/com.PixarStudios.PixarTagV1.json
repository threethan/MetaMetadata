501_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX5tFp0SFwIQ7kNvwE6O_-m&_nc_oc=Adpo_01ZP9PmNzorAGCtpRG8DWCmLPWOymkdIQU9_j45p1xVjC5AgYbbf-8tcDMMQ1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvxAlVvzwXgb9SPh-vDdOsuaABTOml5LOb5OAMLL2t1g&oe=6AF499DF"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1065393473150672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619059_1065393476484005_1344994092689022907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWZXO8Qf2WIQ7kNvwHcsdWv&_nc_oc=AdrUlm71HWfV0f4Xb8tvNLcAtH6RBPv0IqGYW5AQnuu7IgnW12ntgReDkpNwmxB3_H0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShQwz99efZvyngSm1-a2HqiMTnAame2qeOIcW3_wdDNw&oe=6AF49DE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pixar Tag V1", "keywords": [], "long_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time.", "short_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time."}]}, "developer_name": "Solix", "developer_privacy_policy_url": "https://docs.google.com/document/d/1
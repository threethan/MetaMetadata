501_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX5tFp0SFwIQ7kNvwFLq02S&_nc_oc=AdoXTBHospKteldicO1Kzd8feekXew6qpISaCB2PY8j_BVqvgX2Ub1QtDCRA4g7UcjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmnYyNCCpHwwRP-0I8CtnFDF6y-_u_mI65fUqYfZm89w&oe=6AF1F6DF"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1065393473150672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619059_1065393476484005_1344994092689022907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWZXO8Qf2WIQ7kNvwG9Ct1H&_nc_oc=AdqXF6ZiIUkpYoCqJR2KRSqnUeYp1_M4uUUrjFj0miqK-OxYrdwLrv7oICjvkgsFtw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmw_u_CAxjPt2MSlc2leGxuEd_EUQzAFfclosEKMlrtQ&oe=6AF1FAE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pixar Tag V1", "keywords": [], "long_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time.", "short_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time."}]}, "developer_name": "Solix", "developer_privacy_policy_url": "https://docs.google.com/document/d/1
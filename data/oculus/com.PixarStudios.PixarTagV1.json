501_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZuQdbGuWHUQ7kNvwGc_cHo&_nc_oc=Adr8W8GvA90IosXt-qUn2-5jLImoaNtz-fAkSmke6ejMRdt1zg5rNpDXIZ7sV8y2zBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrbjryJYbUbup_HtcJmB2ZwsFHJWiNEjZv09i0n44s5A&oe=6AF73CDF"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1065393473150672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619059_1065393476484005_1344994092689022907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuVkqXEKWOIQ7kNvwHItCcS&_nc_oc=AdporKuQ1u-vkxl6gaMmzYbt8Ci3So0gbGFKdP_FaCe_NA_nbMSM8x6rUW1EMgfXDro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkf-kDfvGl_Sv3Ib5tZarVKs-VseF1H5lrttqILRe5_g&oe=6AF740E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pixar Tag V1", "keywords": [], "long_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time.", "short_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time."}]}, "developer_name": "Solix", "developer_privacy_policy_url": "https://docs.google.com/document/d/1
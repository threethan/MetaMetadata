501_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZuQdbGuWHUQ7kNvwFilwf5&_nc_oc=AdoYa8YfmdTJqQiFh8jYD5NaOMbrkOfspO40gF4ZXkxI4a-hM72c5-awVvrxpMDmJ-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiaBtWVGDhJ0KZaxil4vGr3gQQ1y72ZB1qMBv7pdo1cg&oe=6AF88E5F"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1065393473150672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619059_1065393476484005_1344994092689022907_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuVkqXEKWOIQ7kNvwFmcqwN&_nc_oc=AdpmEZ18BvFRFqx56k4W5uzuvKbpBbyqSdpn1lxIPygqY9kjYPqxwK3uzTk7e97RtQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcvexpW6uTS81rtBa4NbSX8puebPS-xL2bOG6Pqb8fww&oe=6AF89266"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pixar Tag V1", "keywords": [], "long_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time.", "short_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time."}]}, "developer_name": "Solix", "developer_privacy_policy_url": "https://docs.google.com/document/d/1
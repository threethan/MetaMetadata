/scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312338_1602046184923601_5875101658641219068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vxSYPXOrq4Q7kNvwEQguz4&_nc_oc=AdrDc0QW9e_DlKijMv49_4I3Q-2kenO37T6Fdm0rJ3CMmej_4b2mX6WLIjsMQ-2v_4k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAsPtQuS-Ld5ZL2K_SUXZutWEHiPTZbpTtPBlNHZLPcg&oe=6A660659"}, {"file_name": "PH 3.png", "id": "1699456941257470", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307451_1699456944590803_5005426426572809798_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfmNLigbOtIQ7kNvwG-ILTg&_nc_oc=AdovvAXx6w7yhCIX-hUg84T1qpSfmXwKfIJmn8bPCJ8akau7cyDJevxjteCIruAyshI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBorFpgt7QgL83Y58DyLal8kG-5YX5PrpzBT92BvAyC8Q&oe=6A65F9F9"}, {"file_name": "PH 4.png", "id": "2067443513859396", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310734_2067443517192729_4934149638906981591_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bV4V13eLG_cQ7kNvwEHqZUc&_nc_oc=AdqZE5jLDs7STaGjOrx1hLqsTi2sbmo9EJKb8woRv0EkYO6Xo_9kp9Zr0tROPmYc1qk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDruPiM6gNFu9G6rKyueOSv99mUqIEHp4nmNduFNccsA&oe=6A66129A"}, {"file_name": "PH 7.png", "id": "3968440446626242", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620860_3968440449959575_1641079343820252220_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHnbHVIZ-S0Q7kNvwEn6CaT&_nc_oc=AdrwYD7LekYfwqGhmbvD8r_mDLSkauPdrbCsc0-ZOuPkrY6TJx33oZ-SVb7c8LKf5JY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzlG6liduCFdSdrDoSpcNnd6sGz95eNaPb8fU_TZKM7w&oe=6A661D09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PhotoHouseVR logo1.0.png", "id": "1968781660441217", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296520_1968781663774550_4476796696509141959_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7D4hzSS3REQ7kNvwGxIac0&_nc_oc=AdryP6QrLus1LEL8wWMXz4_-cqEr0INwFSftm_sNzQO5q8OHigHjJtNiSneTpPN8bdw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgOvxkUMMUL8gkUPDgEjs4Sg16wWNyiYnruPNK5PaWNg&oe=6A662321"}, "display_name": "Photo House VR", "keywords": ["photo", "photohousevr", "pictures", "360", "images"], "long_description": "Have you ever wanted to walk through your photo album? To pull up a memory and truly feel like you're back in it? With Photo House VR, now you can.\n\nLoad your photos into a virtual 2-story house, and place them anyway you want \u2014 on the walls, big or small, wherever they feel right. Stretch a single photo to the size of a truck, or fill an entire wall with 50 memories at once. Your photos deserve more than a 6-inch screen.\n\nStep Inside Your 360\u00b0 Photos\nHave a panoramic or 360\u00b0 photo? Don't just look at it \u2014 step inside it. Look in every direction and feel like you're standing right back in that moment.\n\nDrop a Whole Folder at Once\nPick a folder and watch your photos cascade onto the wall, automatically arranged into a grid. Rearrange, resize, and make it yours.\n\nAll Your Photos, Wherever They Live\n- iPhone & iCloud \u2014 browse and place photos directly from your iCloud Drive\n- Google Drive \u2014 access albums and folders from Google Drive\n- Home NAS or Router Drive \u2014 connects automatically over Wi-Fi, Works with almost any brand of NAS or router storage\n- Local Device Storage \u2014 browse photos saved directly on your headset and USB C. or PC version storage.\n\nWhat You Can Do\n- Place photos on any wall, at any size, at any angle\n- Resize and rotate photos freely while placing\n- Drop a folder of 50 onto a wall \u2014 they fill in as a grid\n- Move whole groups of photos together as one\n- Step inside 360\u00b0 panoramic photos and look around in every direction\n", "short_description": "Walk through your memories in VR. Place your personal photos on 20 different wall facings\u2014 from your phone, home network, or your USB C, And relive them at a scale you've never experienced before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.photohousevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.photohousevr.com/terms-of-service", "publisher_name": "Larry Lester", "support_website_url": null, "website_url": "https://www.photohousevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1797186004587925"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1509143244290958"}]}, "baseline_offer": {"id": "1509143244290958"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782878400, "status": "PUBLISHED", "id": "1509143244290958"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1812481503058375", "version": "0.2"}, "id": "2106844939961505", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1782481802725012", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1812481503058375"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2106844939961505"}]}, "change_log":
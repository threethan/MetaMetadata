038207890690_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXaOpNqpQRkQ7kNvwG5W6d_&_nc_oc=Ado3nq3Vl5PuiA42-HbUE6fqZ37ECmz3D8zZRSI4fayu-oJx9go6CwwtQvxYc3z6s1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQR83G0gF5vY-HmMtgDL0AO57GL2bcbi9ei8CBwYnQ6w&oe=6ACBB65D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PhotoHouseVR logo1.0.png", "id": "1968781660441217", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296520_1968781663774550_4476796696509141959_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZYP583w56wQ7kNvwEDxGkZ&_nc_oc=Adp3YwYEsWSqfuySMVLTISeXBNy0E4L617lYtDSQYcexluywB3CmtV6YxhfdZEeYpJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5Ikzf-rYhf3iWIDFMqKdXBYy1irumrj-B2kG9O0a4hg&oe=6ACBA6A1"}, "display_name": "Photo House VR", "keywords": ["photo", "photohousevr", "pictures", "360", "images"], "long_description": "Have you ever wanted to walk through your photo album? To pull up a memory and truly feel like you're back in it? With Photo House VR, now you can.\n\nLoad your photos into a virtual 2-story house and place them any way you want \u2014 on the walls, big or small, wherever they feel right. Stretch a single photo to the size of a truck, or fill an entire wall with 50 memories at once. Your photos deserve more than a 6-inch screen.\n\nNEW FEATURES\n- Share Your House \u2014 send a link to family or friends anywhere, and they can walk through your photo house in their own headset. The photos load straight from your home NAS, so nothing gets uploaded to anyone else's cloud.\n- Photo House Codes \u2014 save a whole house as a simple 3-digit code, then build a new one. Keep a house for the wedding, one for the kids, one for vacations, and reopen any of them anytime.\n- 3D Photos \u2014 look at any photo and click th3D. Your subject stands out from the background with real depth, all done right on your headset.\n- Slideshow \u2014 look at a photo and press A to its folder.\n- Name Tags \u2014 add a caption plate under any photo for names, dates and places.\n- Look to Sharpen \u2014 hold your gaze on a phot small faces are easy to read.\n- Save Slots \u2014 keep 2 separate galleries and switch between them from the menu.\n\nSTEP INSIDE YOUR 360\u00b0 PHOTOS\nHave a panoramic or 360\u00b0 photo? Don't just look in every direction and feel like you're standing right back in that moment.\n\nDROP A WHOLE FOLDER AT ONCE\nPick a folder and drop them all", "short_description": "Walk through your memories in VR. Place your personal photos on 20 different wall facings\u2014 from your phone, home network, or your USB C, And relive them at a scale you've never experienced before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.photohousevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.photohousevr.com/terms-of-service", "publisher_name": "Larry Lester", "support_website_url": null, "website_url": "https://www.photohousevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1878673989772459"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310726_2871791869867589_5164598139241274060_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4CGyo5D6fYQ7kNvwGigDzG&_nc_oc=AdoGtweTbG1FCIWZ9rXOTF-gBSU3Y8T5Xuic
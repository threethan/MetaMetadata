msUSYnd4Oro0sehgYe7EoKWpv4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNq_ySEQCh3yMaR1EyFlJn9OqFXpmuYV5hkKtzdd-lAQ&oe=6A539D9A"}, {"file_name": "PH 7.png", "id": "3968440446626242", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620860_3968440449959575_1641079343820252220_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVZuYSoXGYEQ7kNvwFKqkxt&_nc_oc=Adrydd0G_-SgwgeKqVTFYhBpaaJTOXSfgJcU7nWHAWPZOTbBD2ooBuc8q9qQv8bnnRs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvPSoyEPRK1bhr_ffTxCC4qpyHGLjTjLVEQyENKtYdQg&oe=6A53A809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PhotoHouseVR logo1.0.png", "id": "1968781660441217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296520_1968781663774550_4476796696509141959_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6dTMyNTRmUQ7kNvwG8gekh&_nc_oc=AdqZgXq04psjslKw8DFDyhGEZ6NLGMfu8dANv3xELE7bUUIzNpEyqIGQyB4dYdnFzvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYPbkb77eyGvVnF69iAZgNoQqTjh1vFeZuVvHignujPA&oe=6A53AE21"}, "display_name": "Photo House VR", "keywords": ["photo", "photohousevr", "pictures", "360", "images"], "long_description": "Have you ever wanted to walk through your photo album? To pull up a memory and truly feel like you're back in it? With Photo House VR, now you can.\n\nLoad your photos into a virtual 2-story house, and place them anyway you want \u2014 on the walls, big or small, wherever they feel right. Stretch a single photo to the size of a truck, or fill an entire wall with 50 memories at once. Your photos deserve more than a 6-inch screen.\n\nStep Inside Your 360\u00b0 Photos\nHave a panoramic or 360\u00b0 photo? Don't just look at it \u2014 step inside it. Look in every direction and feel like you're standing right back in that moment.\n\nDrop a Whole Folder at Once\nPick a folder and watch your photos cascade onto the wall, automatically arranged into a grid. Rearrange, resize, and make it yours.\n\nAll Your Photos, Wherever They Live\n- iPhone & iCloud \u2014 browse and place photos directly from your iCloud Drive\n- Google Drive \u2014 access albums and folders from Google Drive\n- Home NAS or Router Drive \u2014 connects automatically over Wi-Fi, Works with almost any brand of NAS or router storage\n- Local Device Storage \u2014 browse photos saved directly on your headset and USB C. or PC version storage.\n\nWhat You Can Do\n- Place photos on any wall, at any size, at any angle\n- Resize and rotate photos freely while placing\n- Drop a folder of 50 onto a wall \u2014 they fill in as a grid\n- Move whole groups of photos together as one\n- Step inside 360\u00b0 panoramic photos and look around in every direction\n", "short_description": "Walk through your memories in VR. Place your personal photos on 20 different wall facings\u2014 from your phone, home network, or your USB C, And relive them at a scale you've never experienced before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.photohousevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.photohousevr.com/terms-of-service", "publisher_name": "Larry Lester", "support_website_url": null, "website_url": "https://www.photohousevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1797186004587925"}, "review_messages": []}]}
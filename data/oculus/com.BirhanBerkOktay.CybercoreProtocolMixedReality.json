name": "Screenshot 6.png", "id": "1999381297316532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_1999381300649865_7347301609798471898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwVCN0R9YVsQ7kNvwEY9P4L&_nc_oc=AdpAfADcj9LCGcOBsGLCb4tdyJiHLbWLvvtKz5849wP-r9tM3KggaC1hL0CJxD5-Nwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyiLmnEGyoDvCmd-IkbXrWL3_CMtZkDWH_a1kWQWiuHw&oe=6A787B95"}, {"file_name": "Screenshot 3.png", "id": "1507745078032047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821913_1507745081365380_5597834091933676247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Wi_oe3Foz0Q7kNvwF6oWUe&_nc_oc=Adpy8zon2YPEDHSNL-M0mgvpcS5OnkKbu8F78peR5EsD6Fx7KFMPQxdKHX0DuspDxNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAYl9jAO2dKps49ikKLTL0-2nDc5VTnnwbG38XMyjmSA&oe=6A78783B"}, {"file_name": "Screenshot 4.png", "id": "1332087775498521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1332087778831854_5185049053522010070_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhDyWqCEw1sQ7kNvwEHe4Xy&_nc_oc=AdpaajVJYkmcJoR-4pvhmYqQgIXL2i_zjiv0YN-3GnQsQgrI4XMMH-gb1Vz8q1c0FsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgIGpUxrkCIHSCQ3wVq5RkDVefpfMwBoaKhRfB5euh3g&oe=6A789F0B"}, {"file_name": "Screenshot 5.png", "id": "2568657400234300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_2568657403567633_5626809027527964806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvAbtrZX61UQ7kNvwEQxtNB&_nc_oc=AdqMkjua1MoQY6-jj_T27MUaBId2fchzcPNbsv2yrecfHOZ-t8mP5NbLQEqQb8ej1LQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFtOWO0wOiR4LrYMRQSSiFTKqaOHtXa0NKTNLEJsJSaA&oe=6A788666"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cybercore Protocol - Mixed Reality", "keywords": ["mixedreality", "action", "defense", "scifi", "strategy"], "long_description": "# Turn Your Room Into the Battlefield\nCybercore Protocol is a mixed reality action game where your own room becomes the battlefield. Scan your space, transform your walls into tactical corridors, and protect the control hub placed in your room. Enemies attack through portals opening from corridors and walls, forcing you to stay alert, move, aim, and plan your defense carefully.\n\n# Plan, Build, and Defend\nBefore each wave, use the holographic map projected from the control hub to prepare your strategy. Place defense units such as turrets, freezers, burners, lasers, and decoys across the corridors to slow, damage, or distract incoming enemies.\n\n{948857501328203}\n\n# Fight and Upgrade\nFight directly with four different weapons: sword, pistol, machine gun, and shotgun. Upgrade your weapons, unlock skins, strengthen your defense units, improve your control hub, player stats, and energy shield to survive increasingly difficult levels.\n\n{1673000817174156}\n\n# Descend Deeper\nProgress through 45 levels as your room descends deeper with every completed level. Face different enemy types, and prepare for powerful boss fights. Each boss has unique attacks and requires stronger upgrades, better planning, and sharper reflexes to defeat. \n\n{995968446214810}\n\n# Key Features\n- Mixed reality game that turns your room into a battlefield\n- Strategic planning with placeable defense units\n- Four weapons with skins and attachments\n- Upgrades for weapons, defense units, player, hub, and the energy shield\n- 45 levels, 7 enemy types with 3 difficulty levels, and powerful boss fights\n", "short_description": "Transform your room into a mixed reality battlefield in Cybercore Protocol. Scan your space, turn walls into corridors, and defend your control hub against enemies breaching through your very walls! Plan each wave with a holographic map, place defense units strategically, and upgrade your weapons, units, and shields. Descend through 45 levels of escalating threats and face powerful bosses that will test your strategy, reflexes, and survival skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cybercoreprotocol.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Birhan Berk Oktay", "support_website_url": null, "website_url": "https://cybercoreprotocol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es", "nl", "tr", "it", "ru", "pt", "pl", "cs", "uk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34787540587556110"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "27187030524312009"}, {"status": "PUBLISHED", "id": "792502430386257"}]}, "baseline_offer": {"id": "27187030524312009"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785085200, "status": "PUBLISHED", "id": "27187030524312009"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37238150569161754", "version": "0.7.11"}, "id": "1483376776525145", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34787540474222788", "is_concept": false, "latest_released_binary": {"__typename": "And
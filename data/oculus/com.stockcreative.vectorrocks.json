tent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_1085028280968201_7852017373912274091_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHaViB7xuqEQ7kNvwHl5WC-&_nc_oc=AdqdFPqbPlJBPIjC3r87539TbxrUmGjkoXj3N1bLgQoRhoyZK0ora6EsXnu8BKiDNXA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtOhV57LV7Y6V1AQMmUC76nE_nx6vrPYmw9j2whTGj6A&oe=6AFC5FF3"}, {"file_name": "screenshot-1-fire.png", "id": "2182209716504808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_2182209719838141_351398757417826228_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtPIE1ORquYQ7kNvwFz7PbB&_nc_oc=AdoRxmzzthODAqSCVZiLkHCc-hKRZd3SHbpmJshABXtsi0mVEzr9xjxJxKRO_oHjT8U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkm3XnMjyRX5A56kjDzObTGPGdfEgsvIUNHMFpBiXvFw&oe=6AFC8491"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vector Rocks", "keywords": ["Arcade", "Shooter", "Classic"], "long_description": "VECTOR ROCKS\n \nNo textures. No color palette. Just bright white vector lines on infinite black, and a sphere of space that\nsurrounds you completely.\n \n You stand at the center of the playfield. Your ship flies across its inner surface, around you, over your head and\ndown behind your back. There are no screen edges to wrap around: the sphere is the wrap. Turn your head to follow\n the action; when your ship slips out of view, a marker at the edge of your vision points the way.\n\nSIMPLE, ON PURPOSE\nEvery shape is drawn on a single grid: the triangle you fly, the faceted rocks, even the lettering. The only color\n in the game comes from the lens itself. Look toward the edge of your vision and every line splits into a faint\nrainbow fringe, like light through glass.\n \n A FIELD THAT FIGHTS ITSELF\n Shoot a rock and it splits into smaller pieces; keep shooting until it's dust. But the rocks don't wait for you.\nThey drift into each other and crumble on their own, and you hear each crash from exactly where it happens around\nyou.\n\nAN ORIGINAL SCORE\nA sparse, twelve-tone pulse plays one note at a time, never a chord. The longer a wave drags on, the faster it\n beats.\n  \n FEATURES\n \u2022 360\u00b0 spherical playfield, built for VR\n \u2022 Pure vector graphics with real-time lens fringing\n \u2022 Rocks collide and crumble with directional crash sounds\n \u2022 Original generative twelve-tone score\n \u2022 Classic arcade rules.", "short_description": " Pure vector-line arcade action in VR: fly a lone triangle across a sphere of space wrapped all around you, blast\n rocks to dust, and watch them crash into each other overhead, behind you, everywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/vectorrocks/privacy", "developer_terms_of_service_url": null, "publisher_name": "Atonal Fugue", "support_website_url": null, "website_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1443062925546932"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1429955955311968"}]}, "baseline_offer": {"id": "1429955955311968"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 17930
dxU49QQ7kNvwHtaq0g&_nc_oc=AdoFofejLo2svYAvs9yEFvknxazwMB2SyiYG6VDgHWqSerk1c_W4cN4NIwg-3i2bA84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSzhzPFdsrdEubHMjBmF7XDCEz6Alj805cWRkF3FXesA&oe=6A68C4EB"}, {"file_name": "SSC_02.png", "id": "1453735316264258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_1453735319597591_8851648732761094446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6iwQ2D9HrkQ7kNvwG6xR2L&_nc_oc=Ado_G3_C5DaZ0KKdC9Y-qsJ5cvs1NwXVLMrr-XMsG24Nj-eWnC22cmzE0b-wXsKk5Oo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPgReVXNhHSH-ivGOSvsAsLdPVEhnDq-QClg-6CvtB1w&oe=6A68B1F2"}, {"file_name": "SSC_07.png", "id": "2436196236804907", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_2436196243471573_5573359345447995642_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAG_L-n4jAQQ7kNvwHQWzJ2&_nc_oc=Adq01yBZSc_085gocntaOl6XBvTR5p9gxLVXABjFCH8zAKvZsPFI-RXbfWLDEyW5vk4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrPJxBuK0h52_-qqrf5alA84DlvjzTP5SaCTejYyje4Q&oe=6A68ACD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440_03.png", "id": "1003109975402610", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618064_1003109982069276_7383545051790488180_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hlRnNapJ54Q7kNvwGPA6KM&_nc_oc=AdrLHlFnBhQMbCUqQqkBE8jyChGIEWXB_nfcIkmBwsEGs-PbfB5aP-FdRWJ6iwEj-BY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTLDr0y4itJPnCruAFpuZCAV1H0v0MCIPrMxWkyi5Dfw&oe=6A68B723"}, "display_name": "Store Simulator Cosplay Shop", "keywords": ["supermarket", "simulator", "store", "cosplay", "shop"], "long_description": "Store Simulator Cosplay Shop brings cozy VR shop management to Meta Quest. Run your own anime-inspired cosplay store, manage shelves, serve customers, decorate interiors, and grow your dream business in immersive virtual reality.\n\nInspired by shop simulator, supermarket simulator, tycoon, cozy VR, anime simulator, and casual management games. Sell cosplay masks, wigs, hats, glasses, plushies, manga, figurines, clothing, kawaii accessories, and anime collectibles while managing prices, profits, inventory, and store upgrades.\n\nCustomize your shop with anime-style decorations, themed props, walls, floors, and layouts to create a relaxing VR atmosphere. Experience inventory management, shelf organization, product ordering, item placement, and business progression gameplay.\n\n! NEW FEATURE \u2014 Friki World Amusement Park\n\nTravel by train to the new Friki World and enjoy exciting VR rides and attractions. Spend in-game cash to ride the Roller Coaster, Pirate Ship, Ferris Wheel, Pendulum Ride, and more. Players can adjust ride speed and ride duration for extra fun and replayability.\n\n! Features\n\n- Cozy VR cosplay shop simulator\n- Anime-inspired store customization\n- Inventory and shelf management\n- Business growth system\n- Interactive VR gameplay\n- Friki World amusement park\n- Roller Coaster, Pirate Ship, Ferris Wheel\n- Adjustable ride speed and duration\n- Optimized for Meta Quest VR\n", "short_description": "Step into VR and manage your own cozy cosplay shop. Stock shelves, serve customers, grow your anime-inspired business, and travel to the new amusement park to enjoy exciting fun rides in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://play24games.com/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Play24 Game", "support_website_url": null, "website_url": "https://play24games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
, "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_2436196243471573_5573359345447995642_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAG_L-n4jAQQ7kNvwHQWzJ2&_nc_oc=Adq01yBZSc_085gocntaOl6XBvTR5p9gxLVXABjFCH8zAKvZsPFI-RXbfWLDEyW5vk4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrPJxBuK0h52_-qqrf5alA84DlvjzTP5SaCTejYyje4Q&oe=6A68ACD2"}, {"file_name": "SSC_06.png", "id": "914590377674294", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821674_914590381007627_3326042029982486559_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yff4t2cInSAQ7kNvwFiCXw5&_nc_oc=AdoPQKuQjjtAX7g5ANAaPYj2THmV6ULvKQbH1NscPmoG7MniJbsVNl2rFHs9NeZOzok&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0UDGGokgCqbI8EszS3xMFaz4HxkMFmApd21aGY-riJg&oe=6A68A26B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Store Simulator Cosplay Shop", "keywords": ["supermarket", "simulator", "store", "cosplay", "shop"], "long_description": "Store Simulator Cosplay Shop brings the fun of shop management into virtual reality.\nStep inside your own cozy, anime-inspired cosplay store and experience what it\u2019s like to run and grow a fan-focused retail business in VR.\n\nInspired by classic shop and supermarket simulator games, this VR experience lets you manage products, organize shelves, decorate interiors, and serve customers, all from a first-person virtual reality perspective.\n\nYou can interact with your shop environment, place items, and manage daily operations while building the ultimate cosplay destination.\n\n! Gameplay & Features\n\n- Run Your Own Cosplay Store\n- Stock, organize, and sell a variety of items, including:\n- Cosplay masks\n- Hats, glasses, and wigs\n- Toys, plushies, manga, and figurines\n- Clothing and cute accessories\n\nKeep shelves filled, manage pricing, and satisfy customer needs to grow your business.\n\n! Customize & Decorate Your Store\n\n- Design your shop to match a cozy anime aesthetic:\n- Change walls, floors, and interior layouts\n- Add decorations and themed props\n- Create a welcoming atmosphere for customers\n\n! Shop Management & Economy System\n\n- Experience a full store simulator loop in VR\n- Order products and restock inventory\n- Manage shelves and item placement\n- Track income and store progress\n- Expand your shop over time", "short_description": "Step into VR and manage your own cozy cosplay shop.\nStock shelves, decorate your store, serve customers, and grow your anime-inspired business using immersive VR controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://play24games.com/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Play24 Game", "support_website_url": null, "website_url": "https://play24games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24727501696926240"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "902610916052268"}]}, "baseline_offer": {"id": "902610916052268"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769443200, "status": "PUBLISHED", "id": "902610916052268"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25882854741390924", "version": "0.3"
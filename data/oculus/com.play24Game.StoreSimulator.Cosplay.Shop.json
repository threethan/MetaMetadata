nc_sid=6e7a0a&_nc_ohc=0eZ-9gvi8mQQ7kNvwExqGyc&_nc_oc=Adp_evsI1PHvv_GRITNCa3BjCPOMSf2XFChgfhsS_jz_t8ht2aL9n-7Mm7RPDrVZudQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I-NGNO4MIf1yKPKyb2y2BY9Wg1K1LlIeSN0k6uslzrQ&oe=69EE1152"}, {"file_name": "SSC_06.png", "id": "914590377674294", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821674_914590381007627_3326042029982486559_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3xox7OxjyEQ7kNvwEioO6O&_nc_oc=Adp_ypUfNZ9W1KaxI-vExuCmxYD9nwV7wbNhMy7InLuSw8Cmm7KwqPF3kCUoohoKQF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YjSARFh-4Ca2EnhyLS6BAO6mw4np7oFrtqJ_SdXLxzA&oe=69EE06EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1299116782023875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1299116788690541_7394563702528669854_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfv03_jMYwcQ7kNvwEkYjRv&_nc_oc=AdoJcY3Gkf7a1XUe3deoU9SHkBfSiVZksj64r0c0DtkKlEBSgF9pGB0R_UNTUjSH9Ak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aZ6R7bqwccuT6oW6OlSkDPeKRNSS2GqJe2eRJeaJgPQ&oe=69EE12E4"}, "display_name": "Store Simulator Cosplay Shop", "keywords": ["supermarket", "simulator", "store", "cosplay", "shop"], "long_description": "Store Simulator Cosplay Shop brings the fun of shop management into virtual reality.\nStep inside your own cozy, anime-inspired cosplay store and experience what it\u2019s like to run and grow a fan-focused retail business in VR.\n\nInspired by classic shop and supermarket simulator games, this VR experience lets you manage products, organize shelves, decorate interiors, and serve customers, all from a first-person virtual reality perspective.\n\nYou can interact with your shop environment, place items, and manage daily operations while building the ultimate cosplay destination.\n\n! Gameplay & Features\n\n- Run Your Own Cosplay Store\n- Stock, organize, and sell a variety of items, including:\n- Cosplay masks\n- Hats, glasses, and wigs\n- Toys, plushies, manga, and figurines\n- Clothing and cute accessories\n\nKeep shelves filled, manage pricing, and satisfy customer needs to grow your business.\n\n! Customize & Decorate Your Store\n\n- Design your shop to match a cozy anime aesthetic:\n- Change walls, floors, and interior layouts\n- Add decorations and themed props\n- Create a welcoming atmosphere for customers\n\n! Shop Management & Economy System\n\n- Experience a full store simulator loop in VR\n- Order products and restock inventory\n- Manage shelves and item placement\n- Track income and store progress\n- Expand your shop over time", "short_description": "Step into VR and manage your own cozy cosplay shop.\nStock shelves, decorate your store, serve customers, and grow your anime-inspired business using immersive VR controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://play24games.com/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Play24 Game", "support_website_url": null, "website_url": "https://play24games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24794094306933645"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_20727483
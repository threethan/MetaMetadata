E3"}]}, "id": "1590602802081327", "locale": "en_US", "screenshots": [{"file_name": "SSC_01.png", "id": "1417715900006015", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819982_1417715903339348_1459456123442325473_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5WuWs19byQQ7kNvwHka1no&_nc_oc=AdkJLk3EommMU2pTFUcCOX7Oa9sNOxJtFVPDRU-pjLEdQsACxJkbjXclhU_IThHB7fg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0vytSHuJu2wDY6XInb5jCN_EgM6e8MbgSk7aMDYpNNg&oe=69BE88BA"}, {"file_name": "SSC_02.png", "id": "1453735316264258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_1453735319597591_8851648732761094446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7DwvLY61wwQ7kNvwEgzs5y&_nc_oc=AdlqjWlxXm0wbWLzzHAKeW1_BUxeZPkfdsZgD4sOqGRc5p-Eak8hhWuXUhwLm1cwn0s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGJ69RgEELnlGAZSOLex4Tuklb9LbVAKylAdLz3Vs9AQ&oe=69BEA072"}, {"file_name": "SSC_03.png", "id": "1413946747025445", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_1413946753692111_2788280688454350622_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y45Wd1CzRoQ7kNvwHzN5Rm&_nc_oc=Adm9y-MHTWFMmSWSYbXyhkrS6bRIcfUB6-PRItUb8eADIPlMIaBjk8h-ZTcYCCyySDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6Q59eJhatEJGl6WarIF90c1rhecCtvWSAho8N54BSIQ&oe=69BE8C40"}, {"file_name": "SSC_07.png", "id": "2436196236804907", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_2436196243471573_5573359345447995642_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZx4flkOBwYQ7kNvwEjtzlL&_nc_oc=Adm-IJ0l-r8MhK4a71ZwTyu-okLlfoDDs3cr0t0rv5nNdI3n-Gv-B7qXD5N8MbYQ9wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGNGw-UGgKfPNrTSXLVwUaYPHw1_7GfvvPm3Ip1la7pg&oe=69BE9B52"}, {"file_name": "SSC_06.png", "id": "914590377674294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821674_914590381007627_3326042029982486559_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXEj26hgAnAQ7kNvwFI9q3w&_nc_oc=Adlo-hRXyYrN-M0LuEJkz-BKAsBE7smYMHRc6riCLuC3NPe7O9UBRzDSOruzoEmRFbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSWn1ARsEJyLia0sZPXevFUzd2qXWdnJ47Ys-PerEK7w&oe=69BE90EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Store Simulator Cosplay Shop", "keywords": ["supermarket", "simulator", "store", "cosplay", "shop"], "long_description": "Store Simulator Cosplay Shop brings the fun of shop management into virtual reality.\nStep inside your own cozy, anime-inspired cosplay store and experience what it\u2019s like to run and grow a fan-focused retail business in VR.\n\nInspired by classic shop and supermarket simulator games, this VR experience lets you manage products, organize shelves, decorate interiors, and serve customers, all from a first-person virtual reality perspective.\n\nYou can interact with your shop environment, place items, and manage daily operations while building the ultimate cosplay destination.\n\n! Gameplay & Features\n\n- Run Your Own Cosplay Store\n- Stock, organize, and sell a variety of items, including:\n- Cosplay masks\n- Hats, glasses, and wigs\n- Toys, plushies, manga, and figurines\n- Clothing and cute accessories\n\nKeep shelves filled, manage pricing, and satisfy customer needs to grow your business.\n\n! Customize & Decorate Your Store\n\n- Design your shop to match a cozy anime aesthetic:\n- Change walls, floors, and interior layouts\n- Add decorations and themed props\n- Create a welcoming atmosphere for customers\n\n! Shop Management & Economy System\n\n- Experience a full store simulator loop in VR\n- Order products and restock inventory\n- Manage shelves and item placement\n- Track income and store progress\n- Expand your shop over time", "short_description": "Step into VR and manage your own cozy cosplay shop.\nStock shelves, decorate your store, serve customers, and grow your anime-inspired business using immersive VR controls."}]}, "developer_nam
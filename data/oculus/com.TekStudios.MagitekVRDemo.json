demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U6ugerLlEcQ7kNvwFwoCLz&_nc_oc=AdqqE1qM0udUnQtTCZsFzauX-5HsGiPkGZ2wmsqAb4PrCAzcXGRCGEhR6OEyuAvRr18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt06PuZGObG6b_AyjJrFGb1XuL4Z8ljxhnZp6VhNKGBw&oe=6AF74599"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_QDjjv_ygEQ7kNvwEp261d&_nc_oc=AdqVjYnf5nnGoTDvQddUHXi_WF8NCPW7xEN8knYHf9t4NW7WVBqKeB5ALiQ4hmp611A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrDwo03l6A3F2Q7URBL1eXE-z2aKC9vxWReGBNUcz35w&oe=6AF71D57"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxjoK-tzDUgQ7kNvwFmm4Ut&_nc_oc=Adolu0GpH9p0vK1iH-p9Y9Glg--JgSuP3WAwPxpEGKcOvLnbEusEsOdPBYUam9gi_cw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnE2zwbmjjMKqV5rttIPJJmDY3S7sRGEogVXilZhA_yA&oe=6AF740F9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsQ-gAMDCf0Q7kNvwGwrhG0&_nc_oc=AdoRBvFk76F_snzi8bj1cw65qGmSbWo8_YjEmqmqSMbfqPf8-KhhKibSqK4CYaLBzwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZy2MHwQIN8VVxdU0OppSIJKKtpY8NAn_65G9cqC9l7w&oe=6AF71914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfz8Vn72n0MQ7kNvwHmm3_3&_nc_oc=AdrajnEFBmVdHw2PM9uolflsCkWZ32PVknFzUnhWxfqjh1sYzyvPFFnMHUlKoCLFK7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCQiAAenoIS3stjLqdchdx-WHD4HGGe6qTH5iUZDCkKw&oe=6AF72D80"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
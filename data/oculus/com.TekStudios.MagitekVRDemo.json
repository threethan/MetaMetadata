216932722570090", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOWbHpxdBykQ7kNvwEU6Z4o&_nc_oc=Adn78eo-vXMyG0K4wbTXTs8pkkp-ZLgtWvgKXPm-xEiWAHjtL7d5K3gfk0o-4L9ZJPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6F_44y-IJAsNFO8D_bHM0cFm13FGyTSqMObEHTwZKSw&oe=69B01959"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ampe34R8MHMQ7kNvwEDZ87G&_nc_oc=Adk8QzXCsyeQUCB6Sa-3Jv3W0oi-tDLOagvxR2h3vP2ogwapdL53VklcRTg83xuFBhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRCo81mK6CgxJIt7m3f8erQA_7E-dsvQGYKLYl2r2E6g&oe=69B02957"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV0adRQA5ZEQ7kNvwGddkwF&_nc_oc=AdlkOwFgXWJ6gDIbwUID48cm9X5reD_Q7GNuYlq0vBOugj3FeQnRWsEt5gaX0AznUmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyy6BvvrGIZvO0rfzc91YAOvecu4rSsZ44WOveDqQpu3A&oe=69B014B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNnhLQp11WcQ7kNvwEmQp9I&_nc_oc=Adnb2O4z3j332qhRge948-BR71twTKLM4Q0B7nDY-cU52xcpKw0SINWXeiwrai37Tpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz61hdOmeEHafbnuZDSqUkDQbbSVrzZS9J1g_ZxaV1CJw&oe=69B02514"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR7_HV6E-uAQ7kNvwFLliMz&_nc_oc=Admondb9pv4nCjhAxWBgyxzRzts9l5nt1CNULnCYL3wIwCxa6pyrw1L38s4m1Rw9kcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywS2cih7JSUHzc6-VJ6mqhM8npFp6nGQ0uVKbbGYgi2g&oe=69B00140"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
216932722570090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbeYv5QSpRMQ7kNvwEWgW33&_nc_oc=AdkIcnmKI1t5N9Bch8uCddwkx1WUquf6ZIYAcvqg47MmnaHdPGcf7JJPJordvl2uWC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXYj08meDy6srVXusdUvIJURWfI5n91y0mfU7Ju5GL5A&oe=69B953D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivRD2oh78EsQ7kNvwEJ-mEh&_nc_oc=Adna7GMtG07WLXl5Q0z9KWb4JVYSVZAfOB7IdGirdgCZrclluTHN4AFpiQTiZoEMukI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxxc1WG9lGzlxZrSvU0dM8GjUsFJxQXyADr4FV_0U6trg&oe=69B963D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uApj_FxmpgQQ7kNvwGpsA47&_nc_oc=AdkMNUhvO1zqgLdgVkMggvg2tH954VpGWZxgCmYBD71ICBHZzHM0Ewhg8ICiwn5DcSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyVYpVmJW1Dh2gNygAHqQWpKEu5i_Wf9yy4XR7lHH2xWQ&oe=69B94F39"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B47a9njY9MQ7kNvwH4_Hqq&_nc_oc=AdkFocA5cmvcLkUu7kP6UEOlCpPOR6xsmAZVqWH9cnqT94EmHb9TusTxzLtSSgpWczI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzrg4M2j8VbLfyY7man-JNnv5w4U3qsUrGnBJdZnFP8Qg&oe=69B95F94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z94IUWugtIQ7kNvwEQYusm&_nc_oc=AdmB-ZwsrjLKmiETmX2lOxhdJWvEaIS_QO9S_rXxypiiMXfMwtitGhzwV31Sx6m4kpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZ9eK3CkIdRRM4v0OqmO-XmSdDPaCWeN7ILkt1w7S_Xg&oe=69B93BC0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWzeKU89BRkQ7kNvwFFMd9Q&_nc_oc=AdoS0kWO_qC_jyHliyD19B8MSUekP2aTnFyPOhyN3Ufqx88vs5NaYqOn55isedxvCT4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N3LXKmchk__T0lDoaOXs1-ymf1-ZlQt52NqTSCeQgoA&oe=6A09BF59"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdgiC4y14-QQ7kNvwGtOn4-&_nc_oc=AdodZgzl3RUIW1HublCKJGmHkwMEzjod-YAg7wGz-zwYFl07bEU16OOi9c0fjhJ0NyE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GO5OggBIfrWzOZD38HBAOMJXZ8W6vl6zRLhVpf2bPkg&oe=6A09CF57"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GztdbTO36noQ7kNvwEHCs6v&_nc_oc=AdpYEZJZOjNqVULujle_HXtepWD99fmyIv4T9jBk3_NOrmYgxTxzeSDocNobUDrhGS4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XlNSObq6LSNea5xSfS-vMBi0KN_S2Iyo0w0kfNvd7UQ&oe=6A09BAB9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_NGtTHmcKIQ7kNvwENZpbR&_nc_oc=AdoBTCC_iR4T4N3vKhFBpSjvJztkeVMEpNf_hJTmTO7I7DvtQG6gzA0AhP1TKjetT24&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MuHQ77m455Ff2mpu59MihDnfAjnTQJew77NJkHGPyyA&oe=6A09CB14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDHOUQ1M-gMQ7kNvwEow2bn&_nc_oc=Adqi9vskJhrNCG09VUDp6thhYrKIdoLO6S7Jz_f4oRD2skorBoMoXaMiMEUG-LylCFw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43v3_AvE1CzE7YEfAoM6iIv6B1eUiEdYtxzdeNNuGNbw&oe=6A09DF80"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
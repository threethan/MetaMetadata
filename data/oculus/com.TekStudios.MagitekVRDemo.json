22570090", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgqia9_1s8QQ7kNvwF28eS8&_nc_oc=Adr6xV4ZwyGxE-3dHKMbLL290oYLjMaEGnuz5FToINVghE9MJrUFPZb7IwvhP9an5aw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0pWjAKBJyX8IvAQ_SaOSgq9eDQ02JFAxiBrPgXkqQhVQ&oe=69F20459"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwNdCBHXy6wQ7kNvwGSowSe&_nc_oc=Adoj4dltEWIrRnAhLtF_WK7sYmHd1ulWq08pbcvNPaNZLbDZ776ys6qAiJu2OThSfBA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3em8_z8eubFlIk7ctUi2auLmIoAje5n17yge_F92gsnw&oe=69F21457"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjSDxz4Zcm8Q7kNvwFuOSjH&_nc_oc=AdpG-Kq3QixidSE1EuC4pqDgYJVhLR6Xcu2eeinAYjSe_Ta0GW6aMntH6n-vTTsiL9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2B1cqE-aW6XoUBroA-KodW-kv5owLt25jhy_Xbfg3m9Q&oe=69F1FFB9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0uik1oC9CoQ7kNvwFqVlrZ&_nc_oc=AdqeC97Wmz5DfZ4OmVMRmTu-11tlpitFTq8yZkwvTE9kU_d5TR4BW7X6-0TWzDeZvDw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1xlqP5CKtaZcMizXA8SNrmiMNK6z6LMBCjLp6DYcISDg&oe=69F21014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FIxmMLBa5sQ7kNvwF4zBCf&_nc_oc=AdrPi1vmb9wqATGYwPUQW7eEO7Db1B91-LN-vSvFH01xUBJZN1VPoZcaEL4zwxxMIyw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3gSbSmLiG4D7d9KD2gcEqVJlAyV3Vfh5MNdh7cK1eSlw&oe=69F1EC40"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
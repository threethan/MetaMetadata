71-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14FKrPeiR64Q7kNvwHOJ7HI&_nc_oc=Adm-XEMql353Cn5OnAK0ykdnJghXdVB8m6ruDepw35_CRQMRMedxXbIO6GLvSBooBiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsVFAflLdN1Q8Gn0axka_SvY7UwxU2u5_nh0wyxSF-p-A&oe=69A2EA59"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw5wqwI4c0MQ7kNvwH8KElC&_nc_oc=AdktTLBBR8PiswX64oGRTMei9IttrkNj9VXFHmjEo3olJeRMKO1eiQGMRS-ucSwO77c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftIPgaMJ6pmHwlPQkWZ5yih-PeXPitL5wJ8rPlEg4WJ0g&oe=69A2FA57"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPgEofjAswkQ7kNvwHTbOZR&_nc_oc=AdkkzIWya8LoYuZZiGFQbVFFDxDO-3RmYJclT-HXeWrgASFe1KJn5FCrOmwf3z6t1JY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftlypZT77kPalnTNywd4lT3y2osH4UuxHGTWgwn3RQQ0w&oe=69A2E5B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTXGu-mVWewQ7kNvwHHi-Oq&_nc_oc=AdmXdRm2kwCAascSa6V9tJnmiOUDZ3P5jIE5QuTbx8eOzvIgsSZ52-NGWSlrvaU-kyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumfDNbyy0aupLU0qLXnprlmBgAkmJDhECdFyuvEWNKhQ&oe=69A2F614"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qx2OdGb-SAcQ7kNvwGKNcez&_nc_oc=AdmAbIMxk_ssmzBzq5H5ySZwA86N81GgvPEjH-x6POk6Dc9YqiuLQ79kDuP6x-OPk0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3WH4m7YSBn-rWRw1RKRjOWsl0h_VP9BU2orfF43uj8w&oe=69A2D240"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
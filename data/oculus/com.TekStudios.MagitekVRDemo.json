magitek-demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOI8yycW-SgQ7kNvwFa9oJz&_nc_oc=Adoh0lYLZ41SN1MyCSzSZgzLSZXKv2QyDCU-rbUjPHhIrmdeumLqelIFBRXqKotvKOc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--szKH-erwfQuCz87w3i-lqP3KxgRYJR6ndcDeuin_gA&oe=6A22CBD9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq81K5_EeesQ7kNvwGn29jB&_nc_oc=AdpqhT0X5MGaj76thUp798C85y1qKFSeydLv5mrv272CJxYn_mKiiyHbmnTCooycRDg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Td-XaVJst4CcKg9swuRMBvNR2de6aU0wvucugZjhffQ&oe=6A22DBD7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1TbRgAxok4Q7kNvwGt-_yF&_nc_oc=Adqj3StVHMiRgSpieg0nmKVOBsuuhj1wsUqBtYI37vitshBZ1_mAfhaba7LJmRON-JQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kfIRA2xKy8NOb3sSFSdI6CRWORM5p8zjitXq5CzCnFw&oe=6A22FF79"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjVV2ZMRrTcQ7kNvwES2Mo6&_nc_oc=Adp9SrzDFcoizbcsLCyCD61GMlXqJyyxUVw0d7knaKnCKQybl9y-P8O7QViFnGDmMTo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_esjVSPnaWOg-YjVTyuIhtZBWN-FxOse7twaOUetpKrw&oe=6A22D794"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rDfJnjHaYcQ7kNvwGx_ps2&_nc_oc=AdqnDZ-GNom10bVyD128r-bcpII9DslJvEKzx1Y-auFKo1FD89ttAMcenGl_9P7_eOQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_40lBDjK4eh-qMJENymQsEI1bRPBEE4tUzB5ZukSVOkw&oe=6A22EC00"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG
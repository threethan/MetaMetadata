magitek-demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjAi0hVoxswQ7kNvwGUalw9&_nc_oc=AdpajCn2qXgVXlZwig-e_DHkUof-KCtqNwkqIVEltcbb4a74jiJG7xZsr5YpvLaMwkc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d7vKirWgUe_5TWtUPZWm9ATGdqAOoSVsCqgNBAG8sJw&oe=6A393559"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q65ZxCZQ0SwQ7kNvwHkSym4&_nc_oc=AdoQgYdhmLA0-B6eATPhzXaPh9BheKMXbEa3HFokt5XxN_RokrmUKUQNiLnqYPf15UI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SKahkiIayH9GmrF5VDONr0KwWkgLPELU9C9Prnh5mtA&oe=6A394557"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBJImMkFehIQ7kNvwGzaRl1&_nc_oc=Ado5N02I0F0OZEHMUUGx3K2C8-JA1N56DCi0-fCYCIZVSO_wZZx6eV9vvHZU0YWygbA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ntxcKGaSmUbfK63Y0pHSbI30GhQODYUPxIyUJdGfjXw&oe=6A3930B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsE99FUVfykQ7kNvwGUOQvR&_nc_oc=Adp016xKt0BPuOVkkCzaDx7jKycWuBG8to2AzI-AkFk1lXNLbJKZG5uW0AR5gYzViRM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wapmymKF06w6mWEC2GGq70A3jhgXnVGy_vI9wXMg4Pw&oe=6A394114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdg8kTNwFPsQ7kNvwGQ7d8Y&_nc_oc=AdrrifeSUUm8Pd0o89RAZwsisFyT7gMUI1EckDgK-TTyvXFP7a2_YemxBmpqRdAHzFM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9keL0E5z5OzVzG6Xk_G6e-VhFz_7SWWiKeOiqJnhHcSQ&oe=6A395580"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG
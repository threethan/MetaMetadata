demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgqia9_1s8QQ7kNvwHLIJHD&_nc_oc=AdorD7CybyAanA5EoeM6D_nqESU6JA_cTRX8QLYxdxbWO_KWUDJ-dhjsBJhsjkRtEMs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01Y__5tRPIerSeLm_F3nMxLEtF55KlS3LjOp0OomZy4w&oe=69EF6159"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqZjQvK2xKEQ7kNvwGzYPZ2&_nc_oc=AdqhKpMOFXBKcOyW2U4mx6ufBeirCcCHlAWOXgT4ywWxW2WiF2sPqua-X6EhictVws8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LOf25A3sMBINyb8ePh5A2LZWFtmZf8xk95tUbdzvksg&oe=69EF7157"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vdlDEPcwUYQ7kNvwGUxHaP&_nc_oc=Adp0y_KNjtw8C2GqESnWRB07njdAt5wE7vVKtwWgkiO2OQAz_FxHxGS-U3dHqwA3Ct0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1J3ofIi5Jf5DMFDD90tZ7KxdNTttssKYD9ts4abENh7g&oe=69EF5CB9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zsIJ3TWaEwQ7kNvwECJyRy&_nc_oc=AdqnpGgkIcN1Fgjvo3LLNYm2NTG00I7pUQDnxAWJvv_CbIlUfr5Kg6hhRA8Wid-1Z2M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38mxlCGSnd9JQEcY-Do124NrbdcWRCLyWdnGf8TaK9fA&oe=69EF6D14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FIxmMLBa5sQ7kNvwFrng4V&_nc_oc=AdqjPJaCngWR0GuvVfsB8pQcXlDg9oYz0a73uSqMa1uAXpCMTM5lQNXL31uAZIxPw_M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Wll3tv5QiNst6HwbDFvn43SNe7ZUhNsmKnInQwRKjUw&oe=69EF8180"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
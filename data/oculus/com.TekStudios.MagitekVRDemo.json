demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOI8yycW-SgQ7kNvwFF-8ra&_nc_oc=AdoSCciaQk8l-Q9sgb0-HG0vwZXnVYzTvhL-YEsTgB0P_1FG6G4CHgiIDEdOboDee28&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3rHx9ifXpSzNkuCcNjGRnO0yosd7Ybk2uJRr7-3AEcw&oe=6A241D59"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq81K5_EeesQ7kNvwHHaaA0&_nc_oc=AdpcDEQpRKQaaTsHYombtvV2R0v4wciP2Fhs1IaPWU_Iqa5to1DoP2MHwboE_ID9t4Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0BKwvsei-52TKD6GrjfwWokZno0jaiBGsB0KX0omiLQ&oe=6A242D57"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5RClFnR9WQQ7kNvwGkxd4w&_nc_oc=AdpKXmMbP01GRsTgsvmUyWKbbyHys9qHp6cTQFf7HtmCFVcEyG1R2hGeiiaZOlUxOMc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W2d_WrrV_O0UA85RoARq7mGlJ7HDt4r4JsUdhPh21AQ&oe=6A2418B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM86m7nzLXYQ7kNvwGoYPN7&_nc_oc=Adp0fwZJr1U_N8KTgqYXp8MskF5Oe0RWQXBHZe7CPF3dNXLxkiAAlO5RZnWi74_mKAY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91YnJA46ulvZipjRvOJ4FQAFns33YNmf5VLhC-84umkA&oe=6A242914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rDfJnjHaYcQ7kNvwEXHAO9&_nc_oc=Ado4VlZAwaAUJK6wFaHOhO8PhWsNE01IIENxwcXb28hxH_z__3LxaY2HDPEU6LN2j8A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7PKJUotoyF5YZMMkpTexvTorTjJ3X6-TwFjyflWqvLg&oe=6A243D80"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
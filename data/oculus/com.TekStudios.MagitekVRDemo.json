-sin2-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRlbfZ9_OFQQ7kNvwEHQt0U&_nc_oc=Ado4UmKZquubPK8ME_lAChm5zNsLTKJvPTK6q5FuXiZya6GJYLFSgvpuaglYw1EOKa8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af798Vb2sonlomAD7y7DFhvDsgJ8vAdmZ3RFQO0gBBUaDA&oe=6A11B857"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czFgjVdJZKgQ7kNvwFOHDG6&_nc_oc=Adq740ADzUE95f3z5PQV4jtu6ISNGMN424aulzg1jvXvS29YU0odXR_F6ggy1D4sJ9E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vM8lJOgV_2qoEk8BnjSJdJcTYyM-kgD0m7B2ZBGyT5w&oe=6A11A3B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDC3YVAzJvQQ7kNvwHk4ZZA&_nc_oc=AdqKgWrrgrXp_ge1bWnwZVnymKn77um6uvvjB-GwOAzAk15GC7Y68v0bxvcv6RUHJ4U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uXuMmTChZ0BPzHeXtx3HvUqEuKqDbjEfcFUHigsANzw&oe=6A11B414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eY3xMdchNQQ7kNvwGVsPGp&_nc_oc=AdqXMeN1SR5gpDKSwyJXi4QO2apSWHw_boI8NRLiNznAwwfzc1Je_JQiQ65oZ_2t93E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tiqBou1FrGYBklMEkeS5OmEa3lkwMFV4CIh8cCyBHgg&oe=6A11C880"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "635498104534109"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "635277684575915"}]}, "baseli
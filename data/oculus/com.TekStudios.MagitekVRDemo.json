demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8JYZfsfB1gQ7kNvwGxWsZN&_nc_oc=AdqpulFHfSzMdb5A8pC0jJAY0Ii2qm_8lPaR1ce9unWU7osnT_7CDl4oPwRYR2VPC2Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAzWgK5KgZ-N-LlVUqvqqZ5_L9DCmiSmUJhm2dEnq9aA&oe=6ACD1599"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBvSskDkff4Q7kNvwFF0QdT&_nc_oc=AdoJEVBQ_m7MgQG5eyjpNmFUkEyIkDYysWOxIdSO0iuZq4JNQ4fw0ALrTjWdkG0s9Jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc2VTRShuq3La3rCzurfmiC9TUOcZQEaq0EIOhIIP92Q&oe=6ACCED57"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9Z7CJusmFIQ7kNvwENmgJv&_nc_oc=AdrsK5xBmb89naJw7QzVAEA0RQoXKKVOwrXWO1IrQaiTmv62-vpbMkeTvVy6k69f80E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEXd36PNpjh87kG6vK0vpK8BtxJoEnhMPVzmnRPjk6Wg&oe=6ACD10F9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lHhEf62k9EQ7kNvwEBzE_-&_nc_oc=AdpCZFHONX4CmkWCfxIlVlTjorp2_NI268rOPMNVujsKsvo2d_5uS7_bD0pa23ckssE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZgsDg0CfgQFG7GOCNc2ayidP1dtZ223fdZFnI3ICENQ&oe=6ACCE914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o63xjELyWasQ7kNvwHnfbfw&_nc_oc=AdraO9No03k9m91_04wKV8yPP41aYBR-rDqRfit-Uup09h75Cnawj13ZvKcsuMJMdjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMyyR_8SHC3Q8X7PROOo0z5wKLDGGm_j03D3qNTeNfjA&oe=6ACCFD80"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
_nc_sid=6e7a0a&_nc_ohc=8Z94IUWugtIQ7kNvwHlmYFm&_nc_oc=Admz4HejNuqZgF8xVnjlJ0Fqizn8KWRF2GaRcKQ46MCznIGWDB7mO2PkYTjjW_ORsUQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy95y6p6tczLitvSdw9pqoxLqJ6stLZda7lTgVEYNGN-A&oe=69BA8D40"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
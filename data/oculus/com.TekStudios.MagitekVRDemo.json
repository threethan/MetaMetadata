demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPEIulI7lE4Q7kNvwGhpA3i&_nc_oc=AdqNGhMAFn1eJrO-QeB1uy3OYXniTQa44HM2lLh7aSfqLwJc8lxkBWdt9kcVnLeNeFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRfCZLoFlxXGNsbMYmY9RF7O3gpkbC8FFr-y0CC18qKQ&oe=6AC645D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c2uj6HirKEQ7kNvwH78qyQ&_nc_oc=AdrRMbzu3MNw3IeapJzQDfRiQoLK_GPGPlvrPbHMVBADBqlKDpc-r2uLe7CBTts5y04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2WVIhWo1vLXH3w3nDemn0p921k4G2nreB4KFqdlC-cA&oe=6AC655D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gi5Ltr46zjUQ7kNvwEJZahi&_nc_oc=AdqS5mGghCzm0zagLqn-3FUKbU5jL_s-tt0CqhcDhXhX61bABzT7feFpkS8-8PLuBf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSH4HTklJ6wbwqN_B_uziogVVja0QhrwCbTqmQdVqstQ&oe=6AC64139"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-1l3mRWfmgQ7kNvwF6LCgz&_nc_oc=AdogxqJtY-w6MFA_fA76AMy8Hc6mLuR7jfGT1unRQZe8qqcbsIEbSGlw71DR6O0co2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVaG9W_LcAM7UCDjefuumOil--qGg1yYCwuNziyTaWcA&oe=6AC65194"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8IEP_Gf3EYQ7kNvwHFF46K&_nc_oc=AdrgbNenZvE4UxMbv8_rAuWiCSPWKByGmfPj6UpUiu9b2VA2WC4f4UsCdVJr600BGTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFLqNQl5jrMomlt5x_x92GP_kcro7vVv0UxMiQuqq37Q&oe=6AC66600"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
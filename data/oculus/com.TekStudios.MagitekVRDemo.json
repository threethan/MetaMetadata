demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxBNnxQfIJAQ7kNvwGwABbv&_nc_oc=AdrBvr2E4vvFgKt8JFE7Ft-MV5uyp70Y487N7j4tBxHRLUOL8Wh7UZCpO-MlCLP1irk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61FaBkWN-XJbh1bZuztwfdIv8UzxWag2hbztFaXK_pwQ&oe=6A1AE2D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-rEhYvzr3kQ7kNvwFpsnk-&_nc_oc=AdqHE_JzTkUShDMKKGB5iwvUZTqjvVBDyvroUryPTcJ5uUn5zKS3ikqvmWeMC0OilVI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i_F3gwDk9CRhDfPHSH_eczntOPIG84h-sQT6oYLUISA&oe=6A1AF2D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWwBnPjhAdAQ7kNvwGPnBH0&_nc_oc=Adq4IoN3qOzHNfaVLmA8X5vimI-B3ryb3MxKHsn7o-oo9wdUxoFzXCBgz7wG6aIoZLc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Lk1wHWXBxIPYd6vobnp4hqOlxMtNqhpJVQ1jXwWBuCA&oe=6A1ADE39"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uqyYGCSbDEQ7kNvwFRMgj2&_nc_oc=AdqkNNaUcRFqw9hXsgSbgn0Li0nRmD0mM7hP8a1Lga2Q8wme60Ne43kp6fy4G1fWXx4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xpog1BVaPqMnROL7H3qfxYS-OypR-N74w9FvfHb8W2Q&oe=6A1AEE94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUwAkik7PY8Q7kNvwHVjGfc&_nc_oc=AdrV1-oHAMVHtx1HdY427JlgaAfEnM6mYygQm4wzQx1tg0vedNuvENpG78b-24u2nEM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AOk9hWybBN4aS61HeNg3r6lfYAp3-ojKBWpGkD81Zhg&oe=6A1B0300"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
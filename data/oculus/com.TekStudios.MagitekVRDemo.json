magitek-demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciyPgMfEpCQQ7kNvwHC0z9S&_nc_oc=Adq9uh3EuUcYaIupP33iEBaC77oz-UsqfU7B4IMC3adal26ZQe3IDhRveTL0_eVMgqU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWDvQ4KnldWlXjHpvmlzuVKnIaB1snRRdufWcmGpZEtA&oe=6AA3FED9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyW6x4RF8IsQ7kNvwHvkgi4&_nc_oc=Adp5e_msDF5zo4KITg-E200q23TJV3_abRHB1G8ABHn3iLp7QlymNk-1bY7j4sGFzC4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsEHqr8SP9DH6A3sehximpGpVVKD6fil0SHLMfwkXIFw&oe=6AA40ED7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WqB9BiTR3YQ7kNvwGLBZnN&_nc_oc=AdqD9uOvZURUn01bij5KE8fAm5eNCgypZdbK1V-GQpHe2EUxnARDctMbWxDk3damaBE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDUa9_gH4T9wGcciq1WhzYWlCZROfvcNTPNtxMjMPlJA&oe=6AA3FA39"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4atJPjf1PfYQ7kNvwFYvYeg&_nc_oc=AdoQpTvAie53FKyNmpMICEvueqohCq5Zx1RaX-kQpcEN2GkC4qCu-bjsx0tolJ-cI1Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjemeKY4CnE0P9nF9b2H1N8iZgRQdqATJ4Smr5QrEIgA&oe=6AA40A94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0vublPOz-4Q7kNvwEuQ6j3&_nc_oc=Adp6_LFeOJsXFEvmA04vlLV31mN58l1FEQV5YBCUMoQQChMpqMvdX_73Nnrv1HuEXbk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbWiMNdALr0qmQN8wLfZs3Rl3_xuJyc3UN0AmDbahKMA&oe=6AA41F00"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG
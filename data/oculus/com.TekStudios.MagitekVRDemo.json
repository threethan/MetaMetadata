demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqR4h0YsqUIQ7kNvwHnsstE&_nc_oc=Adom41tKElF9G__Zhi0fQYFwb2odpicOUMXrctQPJjoiLStR_0Su_fspRyMCx9BI_KM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DhKjege7JFGKgXhLM_SN1pzwi1DtdvtPE8r4OvDvBeg&oe=6A05CAD9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3EIwu9tlWwQ7kNvwEatkK_&_nc_oc=AdqhpWTzWSdnzt0E8h7suEMxHiNSFm45b715kFTMmSWPW0h3dV6p4Vd84xEiJ3iARBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vktcELnew7-aCw5Sx2XwL8tj66TvoX2Ex42EEiHWiQQ&oe=6A05DAD7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9I6ZdhHWOR8Q7kNvwFlFT0k&_nc_oc=Adq7Bg4C7yBJD1m2YawAAf2k-5aQdJalEJHdxnP1WOyr6gZwmMN2iH-8WG5SU8DNNDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WXxeLZXy3gkaCNAhsGLDIYSGtBPjiT9inIYjj8WZyjQ&oe=6A05C639"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhdTBjTq_awQ7kNvwHrt09x&_nc_oc=AdrTK8rpCt9HMzfMqs9tdUVvRfdjRWCnSynALMMCx4v_ZBRldUWW9vfPGAywCCDLzEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gKxPLdjNOGAimmEBPpVpWad47pZfhs5w2FGiGLh7qIA&oe=6A05D694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMM6pUbDaykQ7kNvwGcO0NL&_nc_oc=AdoHJxjO0Df7X1lsSdll9D2FOPw4wX8QTPy4Fz4rwUOxl2E-KdhO6W7WfGVDCghhF4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PL3z5NkyCQ2uLmWOKB1tAh9q8DsJ7PsnJEHywM9siFA&oe=6A05EB00"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
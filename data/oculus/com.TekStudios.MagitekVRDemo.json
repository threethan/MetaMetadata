demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0PtS4I5seEQ7kNvwHYGUAf&_nc_oc=Ado_4vcRrGWT63ryj7ktpckpb2mPdwEuTTj6rt3yNZkVA61pwpr2XaOwfR0MUClrrLs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RgouVlOJ_M6AAcE3t_cWBmc2vU1Jb9Xo3IBkza0xmJA&oe=6A2C0659"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg6RnhiP_TMQ7kNvwE_EbtN&_nc_oc=AdrgAgXa9ILf1UfvWg5AQ9V2AbWDV8FHId6rsXz2JDSaRVGBUriYtsEkUtp_9xYKI2E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MXPNPbhCZob5l7tWSCM6LcxeZNG2WLud35iMzV4RHUQ&oe=6A2C1657"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utGpa_KHJH0Q7kNvwEFe2QH&_nc_oc=AdrMjaINQTuFlFz6XTnBLQbMJAEMVzPbGpz5xk7T1FbPqZSfKqkkIV-8EF3URKequjA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O3ynxoNd6ZYxE3RJEmoA-MfT-czN4Pu-TGG92Xdie4g&oe=6A2C01B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu5y-JGA9Y0Q7kNvwHlN8wb&_nc_oc=AdoeXIB3C6CCFr3WMDGroI-e6Mm5bkHUKweCorZdXG2kiqetBbcax_5-YBEtgcPLMCk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rWb7JWP6icwlFsOVsveHBILwBplhOOP7O2BYdT7yVAg&oe=6A2C1214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWzfQt9jploQ7kNvwEi-GOl&_nc_oc=AdqjkM0lMoMTxM1sacN2nl2lgwicigY8sMv5X7Iz_eykDw3ZeHzdi-50KoMhN3BxTFA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ma7IvKWfl47M7x4QMRf8OiKPizA2MEQhXXYmuR5yq8g&oe=6A2C2680"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
71-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY_scnbjgL8Q7kNvwF8Bcii&_nc_oc=AdmLzTPvvNdN8Yh23ew5_UMwstOTc4iUdxkspBktTxmYRnbYoz6bOF_nHUV7CqUn9ZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvgYVXNGbTtOo0zEAHsmdSMZmPnBabKuLf4CMxBfWHTdA&oe=69985E59"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHbIg4yKd64Q7kNvwFshF06&_nc_oc=AdnHwbAkayPnrWGzoKwtLGZCmEi_AlZDX3RjZuwq-kIEQB09O62mrZhR78cIZ7wVg5U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvqcrgNyCe8vI_yEnPtMktLCCIwAhBRrFr1VxwAgYuTDQ&oe=69986E57"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKqL1LeY3jkQ7kNvwErcbAf&_nc_oc=AdmXDjzqU9gN-qfmHHyZWU4Du1UPtL1KIUp_1rzC-sqPmXavinPUsujxv5H1EK2q_YA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftEtpQ3AIzw_Yr549W9LJm3zEFeECgSoUAddwHIO9-YuA&oe=699859B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG8EAqlA_lwQ7kNvwGfc3At&_nc_oc=AdkgIAfyagLk0Z3KnjpROS11-4k1Hk01gOsUu3Lv_pa3RcKJh7UcsrlP0dYs6TpDv2U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvRgi4GNQ21bdAVFXKpq0AHZ6TzrAcgWASPuVuT_hvJhw&oe=69986A14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02wBkDHlqj8Q7kNvwF0J6vi&_nc_oc=Adk4fsJkN-mEba35Hd3tHfz-s_fFlyex11jBhrK8ARefXBxFIy_HZPPHmjqoFEuEo8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvn9SLaWnEdXmJ3z3AdfXXUZsKbepGi-uK7LZwGMgU6_A&oe=69984640"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
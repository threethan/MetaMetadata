demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEF3oBoZDQIQ7kNvwFNfBtT&_nc_oc=Adoqb4ZIkkYK0yjwyt6ydkgXsxSWHd_Dd_DK3T8b5Qd1LipxQZheAVFnPNykEZtg0l8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mxzHHJf9tfMdnvTSqHz8zTt3FuNS9dCswl-z33Oa5AQ&oe=69DB9AD9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79pdmOEFYvUQ7kNvwEomwZP&_nc_oc=AdpEqVfLtsfEFR8pQKmLUFYwZRrKzrAz6q03Ze4iLV6HhYOZa_qDjskPaOcABMJ-rJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37ZekOZCaJX4JyOMOkde4ZjLe8le7NgkC3PlyEHIgaFg&oe=69DBAAD7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf34YOGsaQYQ7kNvwGbXcMr&_nc_oc=AdpVT75gi66Xm0X6JebDQrQObcqPiwqRg0DougRoYcSRigIKjwvdG9jbUNT-gPRX2GA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QbCzlolqpb9phRROzi_fYpdnmN6yG-ZmDzmOY-686SQ&oe=69DB9639"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73e1uq_hinIQ7kNvwG_cDZy&_nc_oc=AdprLEPfZhcMPis7HO1DrXk8GssRikkRjy_ZGhDUUEwpdWM1PIeBrJRpkXQVaEgb9k4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n_SR-ZBmuh7MUkcPQimyMWHm1F1bq_eW6RNS8oBkLaw&oe=69DBA694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu55clGLVk0Q7kNvwGKA2kM&_nc_oc=AdrFRLZtFfbjkXBlKHjhgTrlQN6lSJy1Ae2YeFk1ab1-1Pq111ulLdWjGWBaSt4fxGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07c1iFR6faPcE_ckuLgjT7NuWQ839cq6Uixxe6WyoP8g&oe=69DB82C0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
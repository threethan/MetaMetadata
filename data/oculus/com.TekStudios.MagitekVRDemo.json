216932722570090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOWbHpxdBykQ7kNvwG_Cpux&_nc_oc=AdmzdXPlYLIieCGcnTyYH9e9MRsBv25_YA53gplzwVIJZ1ReX55kK9ps3v5RfygxuEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxry-tBONqL4s-YZ6F47czcUcJnKkaMx6yoCQY0oB12Mg&oe=69B2BC59"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh3KMmGWXwsQ7kNvwFFQ6nZ&_nc_oc=AdmouccUHevYlOgXXR95b9TPsahfkU4aFp3LYgeYGOG5vnbX_x1wMuTcRzWN9A8W3wI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyyH9Oh54unrijDn9rNTX407rW2dGz66OYgqBEsnk9enA&oe=69B2CC57"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFHQrFheoGEQ7kNvwGfqVEB&_nc_oc=AdnHhRh1vCWCJ38U-yrSDrUJ03hBUx0k_UG5ubVZjqYtgsfe5CCGzBaNdKDhMz2c4bo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx1BTTMcfquRcu1QXy4kQr5ZbUNkCaiTHK9EutLlUwBcg&oe=69B2B7B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvv_SuNZ_wUQ7kNvwHyXMCU&_nc_oc=Adk9t3x_0mbqicAj3IFrtMobn-KTF2zBRe2zq2CKt_fXCi5BMVN5lBw86EvBfzffszI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyacbMpnzlu3_T5nbrrUqal85hhJ6l6GAsknosn1laWbg&oe=69B2C814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR7_HV6E-uAQ7kNvwFN9VQV&_nc_oc=AdmFEmzlOsMv-2n1-k809xlC7IUUYx1PzeWFW1LbiXLmHllN7VwF-XNr4vgZeDpK3tY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTPIHgda3kWR12GkhaEGngmip8rJ6PvGfbWS7M57AmKQ&oe=69B2A440"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmJcW-K_RaMQ7kNvwGzslax&_nc_oc=AdqAMsXsD3B66inYKUUABM71-EgE160qgIfwg1eSqbyNTNYKhhX27uBEps9ffwks_Qs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH0xxQMdbtEIYOf3XHl1VutDtlcmA_CWWtJaT8KordhQ&oe=6AECB999"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2_5hWPTIHUQ7kNvwFPfank&_nc_oc=AdqA3Bgwxp56vEzGub48kfd7F9HMJr3AJdC5cfWz1yPYKYbwJ0x-9IGCZFK2rZ4_EAs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL5GJNxOZ3es0bPqVwpFceWAtvhOAIuWj7NLhuGEi3EA&oe=6AEC9157"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju8goQXVyRoQ7kNvwGtByN1&_nc_oc=AdpQjugmNhOKEQRiq5nekB6rog7S5mp2ccwGL79FQp4Vdk-bMSF3ff0w40_1noC1QFg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlSMzjATuLNODuhybr1L1bRYts11cu6xuVXGFyuDSrPA&oe=6AECB4F9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgB3pULeOtEQ7kNvwFAkbbV&_nc_oc=Adqs2e5d9yIpNNyumaRn5MT_llO3yj5ek3eFizf6JZ0SbgTOZjEP0BQoQel7jja2PT0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs8fpztw0R7b5tKdARUjMVjgzVYHa9k8j8_joMcz0vFQ&oe=6AEC8D14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cO4buoHiG9UQ7kNvwEpJU9B&_nc_oc=AdprO6xLjYYGWc8wKydWNViBTaZr1wLoGHkmyWU-H4lBr2pga_IPp4c9jmWk0pSjNxE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBL5zFm7VRsEAxjpR7NmkkwDecQJWtusKNIxZ8iYwIVA&oe=6AECA180"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
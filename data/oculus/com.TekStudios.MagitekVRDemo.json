demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wfsUTOytJsQ7kNvwGMHaQq&_nc_oc=AdrtrTXGXZoctxeMOQgsaUQNwkwLK-9z7ApIUIZBFhS9OGPoc8eEwJaG_rR1IXPz4Eo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn4t-i9xGYonyMttbCJnVeIPcuaz7iJnDAgoVrh1riIg&oe=6AF0AE19"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcPcZkU8MrcQ7kNvwFd0gZQ&_nc_oc=AdoDKcK5WjKzcTWMIJ78fZpQeavf9FmfHeOfrD3OlTk4osQXsUhSCY0fw7ERKijy5fU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgUthZFbZNsurP3yD003tWMq6lvOoO1WBtvSOx3rGK5g&oe=6AF085D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArAWMZp3uksQ7kNvwHVqhhZ&_nc_oc=Ado9zZrXUr8vd3paxxIuqchYATd8xm7y715K1FP_sd58NFjeZKrdADW7eWxQKvCJkIE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDQ88jrAvXV1BMMsdHMu1tR4p22WV1W3hvY1T4f80YAg&oe=6AF0A979"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1yGWudbMbIQ7kNvwFZOuBt&_nc_oc=Adqdyuu0A60kxbfPh3krKKG90OQDHHbr6NSTBkzyQBwVz6ofODGGIaxHDKDlobKkSVI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYS4pX0DmtE0ZnPnLnkRuaysXyznverBLEzpOv_ffTYQ&oe=6AF08194"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-C4rDyNPaUQ7kNvwFxiC3x&_nc_oc=Adr5Auq_lxJSqVor4pwoyypkiiLEK9vO_2nl51Qi0JM8d4iieOzEeHKyevzn_wJN2as&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8NWxnlukwBswnlEQ4Ptl0-4_KwU4Gq7UEgo8dTKf-hg&oe=6AF09600"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOI8yycW-SgQ7kNvwH2tv3i&_nc_oc=AdqHKHkCb9rW_ynbUXQLQv6yII_dwITdpVnSz049sAwc4M3Nqox5SVuXMJrj-K_p2z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DkoNJAau--IkNAHMrCHhNfEXzyshrD2u6w98anpO2JQ&oe=6A256ED9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIuFxNprYz8Q7kNvwGR1Aoy&_nc_oc=AdpyAAGmsJra_nKV5iQIRJ_WXSdokyHg1DTMY187Lqpy2BA6LFJeE4XBQjqEWKV-XME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HgDK1MiQaVQP7VWzdN80Gf4U98hIX8c2k38q-ZKZ9WQ&oe=6A257ED7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5RClFnR9WQQ7kNvwG88bYu&_nc_oc=AdrZtUTLFZxTUbTVFGry7J7B0gBPEqdcMhtdJxj1NesrPDTiMwZGCJRfrf2VEkG5RW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wRJCxr6ZWHjtM6ixp-Kll1l_fmMZcgtZg1JaXIEvT1A&oe=6A25A279"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM86m7nzLXYQ7kNvwGnUeKd&_nc_oc=AdqUPIVsPmhV_noUTDt_o1_k-TnepTnUsODlrzXp72EIe5PKuW2Z7r1O0NRB17xvR4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CkqbM504XCwKuKOv7QJp7oX85yJpvllBL9vhFQK58BA&oe=6A257A94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xU7DAz8D8Y0Q7kNvwGXrSuz&_nc_oc=AdpkCfpnQw3sAPPDTW3xpaAIYs4Y6I_YcXoWxNnoYXl9Ygx6FWuiLLae_hgu_WqNnt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-36uLqCZbRsDLyvKsXaVCkQqPaZvWlVgq3jP8IRPsWfg&oe=6A258F00"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
216932722570090", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yG7QicfQj4Q7kNvwGy4PqH&_nc_oc=Adm7zJaRwm1QJwRzmxzr8lhMlo0vE4CHleUx0nPQciJXCFvfI5y59OtGB3UikooCqv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyL1fnU6LcLwyh4MN5dYWA8Zr0zLiAA29Vlh5sWEjILIQ&oe=69B6B0D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivRD2oh78EsQ7kNvwHbtyUV&_nc_oc=AdnWkhJdzdyIPWJaX1nIf4bhzqOgEwk46bOitpM97pRg5ezvK7A-BUuCqH6K_h27bJE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmDsK2jD1Bsf3TOG6AdX1cDOY62X5m4HCTROg50-rt1A&oe=69B6C0D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvnwcspjU2kQ7kNvwG-ieXK&_nc_oc=AdmKxKYI9lPSNSfiXXdyBWgUSUdDne1eq2LTkKbg4lXw3fp-8dAwBA9suqtDFdAdzbo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGZlNfj96QnonSB4aRK6qiPDTGlPiOs-OMA3QNmB4RlA&oe=69B6AC39"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRHu1eQrWQ8Q7kNvwF8qOWw&_nc_oc=AdksAW64r7BVoeXraUVAmwjA8979OOJL9DQ_0Xh2VpvbGkYWfnxYbn2yawWrX4ZCFx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfynFvfxg62NTxRIU9hOc0R6qrHKAXNKPRI0G06RPgco4Q&oe=69B6BC94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X9N68jsTWQQ7kNvwGQapkW&_nc_oc=Admmd_x4dlCDyGgw2Xo_hG3vXvpe3Gfln_OH0Ey4UwjiClVRe9tZ9LJNl61PKlWHptQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzRTwOd4R4eIRz8uFZNol_PtZ_i9mcFmFtFXNkCR_Xlw&oe=69B698C0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
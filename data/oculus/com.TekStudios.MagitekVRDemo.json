71-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14FKrPeiR64Q7kNvwFECeib&_nc_oc=Adl5z6RqfYJafpjwaOy20-DiLHsLorRnI5v7qLVJ95P8LAvf5ex2n86YPQrm7EhgoEw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsIqVA2f6LJRkOUkFxux3KuJNUzqCInrzYoRr6DGmo5mQ&oe=69A198D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qACYs_iUuZ8Q7kNvwHsxLMz&_nc_oc=AdlJg_TLIq0MpWbvIz_j_KGPbGVO5w5pdRhq3J1TNsR-Npr2szdjWtLctUvT1wZZt5Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftSNOJR1j65qyzWpfKH8HlnUU0sU0S-Tnr45sbLsFaWWA&oe=69A1A8D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPgEofjAswkQ7kNvwHCBSkW&_nc_oc=AdnBudS8vyR3sGMsA6IJXDrbyy7Ywr4qohGylRX5-RiDKG1axvXbssTUsY3MnZ054lo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv-dQzPDPAj63nh_TQu3E32foiKcULnxkqv3bIH_4mJCw&oe=69A19439"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTXGu-mVWewQ7kNvwGYLTkR&_nc_oc=Adnqn8EGGRgyl8L34RqFzK0mmwxnGlrhBj77LSlz1Xk09PRTBMcj-rtiFY47ttRTM8E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuEQ-KwKOaNTFMJ_Xp1xppGF31qa-5JRDBSZdgJ524bKg&oe=69A1A494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qx2OdGb-SAcQ7kNvwHHFX7i&_nc_oc=AdlCwrQM_BAbFjvFHidgOVASnWXDvrXXKpvniVMWTIXSuIwX3Vx1KMfUXg2FVIQMgmE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvR6PQw7J4QHurF2iYjTSQ6_MM6qvYzTSwkMwV34C400Q&oe=69A180C0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
216932722570090", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kb5THSfu9l4Q7kNvwHxj1ER&_nc_oc=AdkLwlCOjkW7iEpAuiGMSk_31vrWtL5TsmFDUTVX1emcY2rnuszzfSJh4PB3GJygGS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfySH5EYbnDy0_lkgidxrEuw8P4cF0EA_VzKzIFWmpSlaw&oe=69AEC7D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ampe34R8MHMQ7kNvwGs6w-v&_nc_oc=Adls3tmal8KCoK017JH036X1xEkjnbr7aZihTCT8N2_dx1UMNg6gLJZN44-1rg7yOMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm1xYBCJKzsGVT41zfEQdZILT_BixU-X5rPAA5OdJf0g&oe=69AED7D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV0adRQA5ZEQ7kNvwHb_sWT&_nc_oc=AdlBhBUdEQ9IYP7pSNVfRcS0KxooDxRgicJ-MZ9Ss3ESVsopWYuZF2HnfhR_kDRqV28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU0pi4LoeuMtFk0tt5SaH9eOQNHrhC0YHVqI66UDurJg&oe=69AEC339"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNnhLQp11WcQ7kNvwFTKD1_&_nc_oc=AdnpAzRbhiUtPAcKq_xVl2YH3qlNp0Qm9EMGi-SqsCsdm7_Z2bM8512Ahd0JOC3OW0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd2LEIkVozg-o-_ovsF08IHgqI7AJpZ4-KODFchqneUA&oe=69AED394"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX9BUXcwPqYQ7kNvwEOZfrl&_nc_oc=Adk1hXyVdr0kvekX_d4Q8TLLaWwaw5Dq96cwIxC_HJadPDUukzl34MOGlah3pIGvukU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7XgqzbelBOgm3NJnDxmmIYYRBQeZCk7fSD2_H9-HJCw&oe=69AEAFC0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
2FUg&oe=699C62D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvJjMJAnpkkQ7kNvwGWU7Sh&_nc_oc=AdkjmV1RDegIj9b6YecykDdZ6LEUuQkooJqm7H5qkRPT_cNP93YHn2ipEGF3CEdrDBI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfscMFNAhuYcJNDuwrAlsjCuA70HZ_eRsIbNiUhC6pnWlQ&oe=699C4E39"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05aZNa4dUkcQ7kNvwFHbDSZ&_nc_oc=AdnEFMVItF9ZZZfeJjxO1LWOzQe8yub4ulxpoLMyhfj5y3aMGv_F9lx-Of1BR6TlwEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvBicuxEHnwisxY6NDN0jzbAm_KwwDAjRg85lD4QUj-cA&oe=699C5E94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbxW8tW4Z8UQ7kNvwH5muML&_nc_oc=AdnHzxWwR17R7ValPKkZF4crodM6DvPP7Oqg-iSitzj2KP19IvPIcYNr6wN1PoZ3zHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftjZXlI-0xMjgBQV1rlfrFyWIUez0iy-TI7UdIDmUeU_w&oe=699C3AC0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "635498104534109"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "635277684575915"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1661971200, "status": "PUBLISHED", "id": "635277684575915"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5709947795784231", "version": "0.6.0.4"}, "id": "1088967671714738", "channel_name": "LIVE"}]}, "is_for_ocul
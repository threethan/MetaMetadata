demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xYoJ1tc2rMQ7kNvwH_EPx5&_nc_oc=Adr1kue_u5qJsd1KMEMw5bV5A67GKyZrp3mDY7w3xtgyVhwmvrc48ECE9woXUIuo_wE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzInut9VV2vTvMKhTYE_pEdFydAHyZaiQtiyKOHnP87xw&oe=69CA7759"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EipCCZr2T40Q7kNvwEtNd3W&_nc_oc=AdodPtrXa7cYTe3x9KQQJrVpjdv7aBns182rWRuH39v8HUixTC_-2XBVoiZ2T4YFkws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjW6wZBm9gULEyO1rRZZadlBYZ4T_8ggI800OQKEWaBg&oe=69CA8757"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dE-a9C9wPYYQ7kNvwFWQwus&_nc_oc=AdqtGGZAP9CXo0NE5Ilr5YO-X0EyInujdOZcfBAXxLfo79Kk8zRZ9cYP6DEQOGxDMn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuSx5Hr-Hy5r1rpCGpzOJ97TxXIGO3LFvw_jge3qK30w&oe=69CA72B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe9RWPSnmAIQ7kNvwHcy_xm&_nc_oc=Adpnxt36z-UuCHC_Izygw6aS2aEsCMBBJHyoWyRKg-ASWvAnzVb-7njAHhOzQUWrLTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv2JAbl1egFaTnmxoLH9N8RhCH7PlN9PF88t7JJ6btBw&oe=69CA8314"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvPGyfH_kPYQ7kNvwE7Q8lu&_nc_oc=AdqNZvmUgOfqzzfbKtnz-3ZmjGPF7c3OZTg-CZSSNQA-b2DgzO3_1Y8FZRBpu-WZpcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afztg5flf2PmsaO3_EUqohouHzhvzRy5Lx5a2Sxo0KvWhQ&oe=69CA5F40"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
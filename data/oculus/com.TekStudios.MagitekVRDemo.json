216932722570090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kb5THSfu9l4Q7kNvwEuMWDf&_nc_oc=Admibb22yAMe6hF3EGtZYL4xD3EJXhi5O0-4aKQltOImSr2jrx4wiYVO6eMKarBNdpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1rTKPPqf6eCASswpM6JU-rTKxOrzPMKMM9yDJNLMT9w&oe=69AC24D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SiPd1lyJqcQ7kNvwGqggTR&_nc_oc=AdnTwutrDc2y0w8BjirqMXroHeVwOIFOea0zXBjFCk6zZx6mUpGWiaVqx0xv8go7Le4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyz-wqpNYdvtmDRXHNzCdxVUZJ3PeUyJ9rl6nxd7FCHCg&oe=69AC34D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktQTKQ0G_E8Q7kNvwG4-DRO&_nc_oc=AdnG-i3WBgknHtxybRJx9Nh9eqLir2oHmc-mSyiFv5giJ9nNLjA5CEPR7eCH_ACTxfY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZY36qE_KfKeDAUqL-qUxxtq7GnYCyaNVP1-681rT8LA&oe=69AC2039"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-SncEHFnXwQ7kNvwGLbV-2&_nc_oc=Adk_bwy8Xq28BCXsDqAUCd-MWp0Y58B94xAzID2fqMf779fCUeoSS1YCm5CDBoAvOTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afys9-kRz5IdIyNR_pbjAApQjAGvujLxXwSCzATNRHgw0g&oe=69AC3094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX9BUXcwPqYQ7kNvwGtNJcC&_nc_oc=Adn-xbc75CRh7CQt1h95lK_9Ri9qHgg0eUOP4gKKDatNF8rQf_2CXX0R1tNkVuhCI1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPCqonqy8vp6gbcaXg9ucRr04mBih9CPKVxWf-wgB6GQ&oe=69AC0CC0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3clH4X60CQQ7kNvwEXdrYb&_nc_oc=AdrOvd_3U_Pj9XjK8klNXVpXUQX4xTFnSG9aELToeh76B8w1tMoqr77PwG_k_97SG20&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpJUDowbn0w1c0-LJKRzJYaI5ERACQlbbuIhylBqyjWQ&oe=6A942CD9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGAqbsAW7e4Q7kNvwHSsm6U&_nc_oc=AdrreCfZhlHUnagkz8fXcg7UpaH67HlIRS_sybQW8DZd_2dk1FBIijusuhO_n6OMtKA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELpTvAr_ds0-vdV6eGgxsri0nzWJrAhMi6IKQE4ys12w&oe=6A940497"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzfdCwPqJi4Q7kNvwFCyIjT&_nc_oc=Adq3iKIZHW3Hi28IubJLClu064FB-Wr9G1SrSBsEUeZGa0cguteXs17kDGGwoSlw7R4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq5DsQ4a2NfKEF4GnUTagHQfAj_DTMDECbOOLovrqIQA&oe=6A942839"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glput1Im9LIQ7kNvwFN44gL&_nc_oc=AdrtsqMkk-2ckQNpGl2Bepmr1zwCnklLKbUsPta_8IPntOw2utX03oRM_WdK8-gbRy8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlZu7z40WLIxbZCe4hvJH6X60ndBr0CUrlDWooAdb4mQ&oe=6A940054"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2zwBB6JExcQ7kNvwFHsoFK&_nc_oc=Adp0R2z7vXdUtC0weXqlNPZC54qN_46g3BWzVChRGb9cuhGjraqY99Cp9GsNuhIBSu0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELccz1Uyg_n8y929pEmqCXC7T9zwJEk2DYu5nyrsHubg&oe=6A9414C0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
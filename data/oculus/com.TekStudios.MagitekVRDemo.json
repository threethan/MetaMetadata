demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzT3tQfvKhMQ7kNvwEGKt3M&_nc_oc=AdrWvaj5-vARDbCP7G3xwDuiYP0WGrEGv7AFYu4rrF_ZSmcO0SzsyRLjdwOkBa0LFsU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P5HaDAKQvQspRIonAS4LN7h_kFfwb7oX6Cqc6dk2RtA&oe=6A0F0559"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dyn3YIAqOMQ7kNvwGc6fTw&_nc_oc=AdrjHaEoDn-5WR8y3oX03asVfAMoThA-oXXkGgJEG06o9W4uLSH46Q8mAO5J9ZSDZ54&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F-sKcBOAMTTVkbsyMGmgcH-f_2mueIf_KLi7n7RE1zA&oe=6A0F1557"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZUIRcKMjxEQ7kNvwHwICac&_nc_oc=AdpG_YtPzY_dH0P0dKRAz-bgMVGk2eFCihMH6sehrVhsXPOpnDclQYAqS6C2e5mAn6E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VwO96pweG4NzN4Qm4IuyQcL0t6Vr8tYNIO8BBw7UWbw&oe=6A0F00B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sinv3-9ZpwQ7kNvwEILkob&_nc_oc=AdoV60PtmQLKmXqwSNpidj0MjKm4Nva5n6Dtf19nBoYh2b2u54i6C0nA16RNEQw2KYk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vfAMS_O3C16e8HgXsXK8TTxdwFInEkrHSBm9TZBsZeQ&oe=6A0F1114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylAjxV37teYQ7kNvwHNoNKt&_nc_oc=Adqb_-BeJRoBOLi9PjY7AQz8kuRxpjZIp2HaKKrT-tpsBnZpl__pUIt_c8o-gbWhtPY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KmFdZCOY9nJHMRFQBftHbbMUGaQy6ZE-KtBlE-gta7g&oe=6A0F2580"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
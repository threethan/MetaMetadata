demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBZk-40XYoIQ7kNvwGMJg0Q&_nc_oc=AdpC0Td9xovQTp0bzpU3QeiCBvpz7Ak1XyDf_GbI2PxoxanWyfCr4YxIr31T_hnrZf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjW-Ur-RFkmsCkqLD2Vlv-l-cC_AXHjKJYUgQF3DQbYQ&oe=6AABE7D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KnznY_zDyEQ7kNvwFl7NL_&_nc_oc=Adous13Y6MY6DoiKlrnasWmw00Q7SesorUZ9Y8yagt_7FiDNOhiKdnlElg6vjYkuqT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqeF_Pz4pSq6_H6rfWJMmq5Fehgzlufb9eQlsfRyqbZQ&oe=6AABF7D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6P0j4ZihkoQ7kNvwEC5igp&_nc_oc=AdrVvCaJ3mMTvW4irHjspUtVdVwSNgdCT61cn67RIBqtrcQby48Lm5dS0ew2yFfv0fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZGunZwuH0NIL_ItcMILGFnn8joBveGJpV-Lim2pJ8Bg&oe=6AABE339"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3T24sa96DkQ7kNvwHkE16X&_nc_oc=Adr8DUVT2tczBp3d1Bj8AzgDMauLuXc3UKccr2ondZohRBxAmjPceTw7lJ36V0j31mQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBcFjduLjtk49_ApAgfOyriwkTHgIOOaOD6CtyN2z1Dg&oe=6AABF394"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9WGMYYDp_QQ7kNvwGnW8Gv&_nc_oc=AdqqKvMNZ7YC-jE4U5XezcKxn3L4bDELtw2t07nZyXtz_ffcMUvABuCjwptL0Byajcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ28dh8I9JCrtyAJOHXmwRsHgitrHgDS8C5Pwyb5fe9KA&oe=6AAC0800"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
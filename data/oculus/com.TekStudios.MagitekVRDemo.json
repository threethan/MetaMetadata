216932722570090", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kb5THSfu9l4Q7kNvwFwubFl&_nc_oc=AdlomHYQWvVZkbRiCclYdwNTAmNlk3zOHBNjd-_xbAOobazujpqcPJY-AfBZsGhc4RQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaB2qDtfHenZQFg7RAlnssixTEwhMnLwYDkpHob9Ws5A&oe=69AD7659"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SiPd1lyJqcQ7kNvwEq5-di&_nc_oc=AdlPoBTKB6mKViEzgxvkAhGEljB6EDazEov54gAhkihfRIvRR9mepmobb-1aU9PzH6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5ez0iWzdT_ZuKQuv1k-HfJszssrZ_UAfKIaTzjk7n3w&oe=69AD8657"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV0adRQA5ZEQ7kNvwFVOJvD&_nc_oc=AdnStjPfZKHBSiL7IyGP0CYZMN-l4n8ZvdtNdURRt6OucmjpQGRTan1fKuvmFhU6ONk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1KaIZoudALlv-LobaYzbFYuZTQGUUgZu2xwnKpKIrWg&oe=69AD71B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNnhLQp11WcQ7kNvwGdXK5q&_nc_oc=AdmJNxYN-6Aee3YTYID3uAMWcW3jVlP5d7LRxzYS6xhjgySt0f6J9tCpb4PmAD5SSlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSmlrX1sEtBQA5-XwIo1nUXY9EiqQOWDXQUNwaJomjow&oe=69AD8214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX9BUXcwPqYQ7kNvwGW-Asd&_nc_oc=Admjc69GX25VRLfeBO48ZbNYghExhxltyZPLD5asccItT91wLHVi6Yy8EAOFbRMwhDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiagnSXfjOn7XIkLd1VOAQRVqFM3x2QF-DKImc-Q_aqA&oe=69AD5E40"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
71-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsC832NJFEoQ7kNvwGTQcR1&_nc_oc=AdkHopxHPAbCCF4n7Ndtx-Oemsji0fQtAB834GdLkzJ5rIPQsRb17SHuYClZmACiusE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftAUTosHyujWgHSmAu7WmKVV_AnqQ3hKagLPFqQP3msdQ&oe=699DA459"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FskidoQcjKkQ7kNvwFDU6R1&_nc_oc=Adl_96lgkNXR2odZqWl60ffUxbt1V_lJhDzxa9QwkiNKuIrOQb2cfhAofgDd_kSe1s4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsNJTPTxIA93gpoe0YToXM5yD8GHByQcAA1mS3vKyvwng&oe=699DB457"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNiXEudc9I0Q7kNvwGgv7lv&_nc_oc=Adm3K9_6RJsEWCHB4yG2zngx8ZjrR_dqgpYsHpuBmQYEOkbR2xvNcLhU_RoRQtDx-lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTmC8pzHXpihbvDbi8_l-Ws7ZRBkSIkQSY-7OWucRfrg&oe=699D9FB9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03MnI0DaHssQ7kNvwHyKL6O&_nc_oc=Adk69NJ97LNbFn183EJKbwGppMgSfbZ_yP1ulY_cTLoehjCNC6670GEn_arbzjTWkG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhCmr-eSUPvPgb9SuwZNcZyhGvDLdeCFhl-PqDBc59RQ&oe=699DB014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbxW8tW4Z8UQ7kNvwF7RlUK&_nc_oc=AdmgH9R8CztwaK8NZfiEdDoe2_liY-xcKw-Kpq45EdT2qQsKPjYT2vNIo_yd-7ItIWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft0sgYG1rwaCPbElcqAJXRL3-oGxMdykCgz74xt1rjWAg&oe=699D8C40"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
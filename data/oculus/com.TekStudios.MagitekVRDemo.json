71-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8Rv2o7Ro-IQ7kNvwHnkD_V&_nc_oc=AdlfBivRTJkTL09AX0YQ-CoxIKHwL-zujz4DFvhBA8UOcthS0jh7Rmk6P81OaCWRiwY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftx8ZQKeGStusxwoU-Li60lFKYwtrUHvRZuF0O6yHq94Q&oe=69A58D59"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw5wqwI4c0MQ7kNvwEY8ow7&_nc_oc=AdnMG_vTsgBbPHgIOJfMOIkX14gCN0OzBgDXEFCLduO-izK8JfkEt2KLOYhRrwSXRBI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfukN68Pwa3BD6rqbPx1yDhUo0Vyzd7Nygr49vzMvcnpVQ&oe=69A59D57"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gF4eUA0XyqYQ7kNvwH-mU0W&_nc_oc=AdnMsp7R83JI7viUg9TMX3vvnmw7VZBKsA-iJcmhMDGJNiaHd0drrNZxDdWAgzIG8Tk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfthVYK54M1fF9UQel7m2FtVCegsLMmWYySHCNEBsyLXlg&oe=69A588B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJk6bpL5-38Q7kNvwErwgxh&_nc_oc=AdnTOnGX8YK12EkbVEQ2ghGC-pdWA8p58KjNlRRe_N6_uMsmgC1ho_XMeNcgnp1cF9o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvp26EQTqQOPovFl3IzEhjil88JEF6VnRKJV1oxRhwEUw&oe=69A59914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUa5N94rcqkQ7kNvwFeqjQr&_nc_oc=AdlZmXqC426xL-bRLPRYOVqM89rTPHs1DzgFMpt_mS0bO2sxTTnnOBaXV-MRg7gi0FQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfucfNb8l96Mn1zemZ4cdXTykznqhY8KZHQhZLkUPiSMhA&oe=69A57540"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
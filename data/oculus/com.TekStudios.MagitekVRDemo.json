demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2WKQuRv2BIQ7kNvwH1n7qT&_nc_oc=AdrJYVeaC4PLh4H7SB47WJtcfx6VSvA8UCr1FGVLr-jvrqhgszv_vVyp6LUhPyjQAIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88XxWOEAMm_66nmVf3I-lDDu-KRY9QJTx3uYuiOKW9gQ&oe=6A43C159"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrE0swCx7tEQ7kNvwG3Abb-&_nc_oc=AdrWH0-CmZPQm0WnSuXYcFxZ0ewVpf8bSuNo3DNdLzOCu3ci6qcSJe14Wv3LgrwpM2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af961fZ3obKhUWDgl0xhKODeMvrCO2z_NHetcdJf_o-YSA&oe=6A43D157"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOIsJrwd2hgQ7kNvwG8Ao3R&_nc_oc=Adr6cnuWS4eQNhSvBkHLCwCz3owzYeCVaCc1Wbc4c2OEWUI-Ra7k-pYiDZCzTCiUFtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QASDFP8WD8V4aghtpG2N_F0SnKzdp4k2XqWBAAyq7fw&oe=6A43BCB9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J53Ut2yUf28Q7kNvwEiC0se&_nc_oc=AdplhENg0aO7FCIY_8f9eY21Mah7d5kqLwwJE2oQAAAB5cF3ejvkGLetO5WoXEN-T3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PUHzROZLZ2jt0FoUKH3u4W-DClcqHpbo80U0465MgaQ&oe=6A43CD14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMT7_HxBJ3kQ7kNvwFqV7Zb&_nc_oc=Adonq-nD3g5_zegWCovbZnBrif_Fya0-_hBdRgRKcbUotvjjjilyrsBxm04lxIxP6Gk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hcQewZ53B26cbO7zbXaAy6mXMy_puaXmCgcQfeza36w&oe=6A43E180"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
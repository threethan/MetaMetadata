demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVkclwbmmbUQ7kNvwFarcYR&_nc_oc=AdpRP9ZkT4TMzJs8zV1DTjgRJWbYDgNT0GlMSo3Ty6xU_-7c34HRtVs-hyoNy0SZkTM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGCg4I9u8uZ7sj3xL6mdmfoy0fs2vqHP-_BiwIq-vr-Q&oe=6AE346D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFekwqIfE50Q7kNvwHPjL-b&_nc_oc=Adq2VL1cEGxS7n2rBbYR8Jwj5QA7VqlFUWpS_9_9bwm1hjnPfteWuAEcRo9inMr9-Lw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl_gUoAqSclpGk9CQCcL4AoWdWG8D3_CeQIbtN26Mn2A&oe=6AE356D7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fVBQhVqGmEQ7kNvwE92azs&_nc_oc=AdrqkApeDf16HjQWPHFv2YBzfqYvvI4YSwnuhzs1h5VpwPPlfOxF8y_-XA0QTp08wn4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN51TFY5s0fpAa8vMSVxQnmRiJ7j2s4IoKJ8snKXmpD5Q&oe=6AE34239"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGuEdGFQMaEQ7kNvwH86evp&_nc_oc=AdoRkKDU0hxeBPg_KNRkVp01V3qWi5_hPUQ9oStunCsbOCHgwGAeCOe-R9EByGboD2Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaYzPpubyOkUPLTuAEWuc74mYYRnaTu5iBucFDO81qFg&oe=6AE35294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWQKBEDYyt8Q7kNvwFLkJBs&_nc_oc=AdoZ_AcZxhFCCJ99MFtc87XngvQtDyPQ3GaWfHADEA1qs8x05kNKn4QQbFRPq-eYvU8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2l6uJYQFvWYVw6r_uxqqnhJfDTTgWU4jSQaK4QERYlQ&oe=6AE36700"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
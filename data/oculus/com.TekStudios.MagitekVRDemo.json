71-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY_scnbjgL8Q7kNvwH6GFVy&_nc_oc=AdkEhI84NfWGAEBtY2btyOKtmkn8lz5Ure5KfXHhyFbBsY6m75qcMKNWCEaG5LmenEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuxBadIsbBhkSkzBX9J3UZXalpRA81EWIXSj5zg2gTqbQ&oe=699B0159"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FskidoQcjKkQ7kNvwGm74xG&_nc_oc=Adl8G7Yoe9ggjtuKsE-Cm0r3P4vs5s3q3NYKEU422HzfH1uR3OmXixCusXWYqg-FzNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftBbrJ5eR9ABnOJScl0G4-o5w6PLo7x9g3TGrfrpt0ztQ&oe=699B1157"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvJjMJAnpkkQ7kNvwGEWXMO&_nc_oc=AdksaLp0vq1s_0u4yPmQuPKuAYeHOwSwfr2MT8qgcZb38duOXrXOfGORLGtbSBP11ug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsELBiLanzEuxtnzT2KHXS15lEw382TxwYk9QzR-Z_aWA&oe=699AFCB9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05aZNa4dUkcQ7kNvwEw6y_H&_nc_oc=AdmFQb6PooJjJsRO6uCSBcd2x4PY7CQIbEnYoDyeZP8dG61SM_GloztzFoibFI28R2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftrB6HCeObrEl7sZK3xmYjXWUofgbMd5JcbWCcPCTZqjg&oe=699B0D14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02wBkDHlqj8Q7kNvwF3j6iv&_nc_oc=AdlgENA4VKCq7ucerx867nGYIfVbdjUZO12k1TqqYbgjL4fW0vtaIUHnFCVcZNI_KvA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuIixGO68s2vGfsHvjl4ApGtew3fHFQ3Tca5O6TDI6_qA&oe=699AE940"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
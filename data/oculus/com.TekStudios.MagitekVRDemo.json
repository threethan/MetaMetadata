demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vag_yW-SYzUQ7kNvwERZQHb&_nc_oc=Adrr1vcS_wB8Nqtd4YFE3LCCwncx7c27Ssl35fQKs7-s0gUju94ktKwaRUvyKYrlMvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHhVUuHqhOLgnWiOVyDaKf0zS5qbHHh_70rqYEFMPQiw&oe=6A636559"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGE2dUOnF60Q7kNvwEQ9qX6&_nc_oc=AdoIaR-WaQ76XJUcPM8qgdNTk9CcG_2Siv2cAjfCngdRy2rB6mNybirs5OCezrpyIMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS98HDYky51Q8E0P3MQ7KbxoJcxxzB12Shyij-eQkZNw&oe=6A637557"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jk2TPsp0nh4Q7kNvwFQn3be&_nc_oc=AdoTPQVEgCGQwozI67HNjaAtjwt6iUU-d7-uzXVc9Nf8wuQ35jBpFU51dv4O5s_xe8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCctwTwrKnxNGff0aqP_VLQvZSQ5eXbQqK1j1ktK78Dhw&oe=6A6360B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAWQkAO8WokQ7kNvwHJ0R9q&_nc_oc=AdqDGPPX43IXAtvYEd3ofqGXZQAP11yG7YakVPjbrHF1ASsh9wWzRfFMYiCUsW7WCv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcp4xeGoVt3nR8YNMBBr1RAkjs40UCXfthH9F5WytlUA&oe=6A637114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT0tjlRAwJUQ7kNvwEQJTr3&_nc_oc=AdrsTHL3aoa57lv5TvQBtTEPAd-_0HupPTnJsVR8i-nNgiyuQ_bOLAw1B5ldfbGSfqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTZF957ckEu9HTpPCS0j_q3i74oh8ybC7BU_Py8fxJXw&oe=6A638580"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
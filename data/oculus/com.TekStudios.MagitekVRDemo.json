demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciyPgMfEpCQQ7kNvwGk61zA&_nc_oc=AdqlrgaI4aCQw3g6DooG4Ap-QhPsXVUXuZScjAn0GbHi4gK5Sgk-Mt_FLQibmWybUec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMfq23oU-KMNEQh5Kb6oDVAsmWq5QcD0LskNML09C7Bg&oe=6AA2AD59"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=453YOVdqiisQ7kNvwFu0CNx&_nc_oc=AdonyUlyCNdMS0YNQP_tE9ExfFdldlfrp4NKhEDbMgLblWWQYk73Q-apgTXCwrVKbWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvc6jDmvgtapE9NLdSNsOukTMEtFlYUPxglo67HvW3eg&oe=6AA2BD57"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WqB9BiTR3YQ7kNvwHLY4KG&_nc_oc=AdrFuQg8ATKaCqoNIsTEotN1WgcSe2Vtldwx9IqoF9AJABkqY5MOjWAmUnGYRRfgsWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsNe87v9UDcHvaHQR-IdWfx3QbXFKd5cpsk8rJT_kCFA&oe=6AA2A8B9"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4atJPjf1PfYQ7kNvwFlHnyL&_nc_oc=AdqAnDF5FKHRCmS44rM8CdoaFgYrpIK6o21GaWv9NPsk4o_i-Oow8kAypTToQIbicsQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYMVQVm6B9Wy-ISVYNR3pc4DOdwlC7lXkKxA6VgiCkHw&oe=6AA2B914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7R9tBNT7U0Q7kNvwEK20V0&_nc_oc=AdpfN3Sccsoszdx6K0zXmbCoQWjSDxfPlZM5I7vWJiyX9zRNkHySBW5LTAUuyVPPRwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJqaPtQEGYK7U53Pf3bvu7pIk1Hc4rM_JTt4IQpwuadA&oe=6AA2CD80"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
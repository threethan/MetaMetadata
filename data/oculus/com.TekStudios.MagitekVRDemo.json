demo-screenshot-5.png", "id": "1216932722570090", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdK12FSEwtgQ7kNvwG8qfPe&_nc_oc=AdohOG7Y_8CmAZtnQzP3X4DGQdrafUPIaZbafWGDCzAyyQEP4sWSoRMZshOpI1Qv-TU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0xi077l03NSTSmLmdWP8tDSljm4RuOThOuS6_6w8Rhg&oe=6A89A0D9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWvhWDZfR5oQ7kNvwEWCI01&_nc_oc=AdoF5aWnw5iDgXOCIK0zmpAF_j-C4u7t2okxgKJs1cRSE1Z7F60oZgzJIngDfHn4QcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdZD2OlDmQlhRMR-JDOkMymt0NRmZfcOMWQgbGTXVOKw&oe=6A897897"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r729EDxD7nsQ7kNvwExysEn&_nc_oc=AdoHAFPu4BgnAFWnVUR8YmNrHSNcyTEfJIleb8sA9Cg6WsrcAhoMKJhm6YPpiAyX2dU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdZe8zdD0g-gB-eRuOVEcQoGBBk5EM9b3-B7j3VJPaDg&oe=6A899C39"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urNa2k0W-qAQ7kNvwEh_00j&_nc_oc=AdpR7uwI2z1dfSDU4jb-LBw3zfysn9OeRYcb_VN182KJqgSoWoaAgetG8dIceDFNeCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFadIpc1X1HyDjap4Ngh3gGbGQqc7BBLFwMGaDwuMaJbw&oe=6A897454"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVr1vRCjm70Q7kNvwE49XOK&_nc_oc=AdopqVFYJbu1vnZeEjl2ZLgmD7tC9W0bekP3r4W0oNF1amg7OufRANxly0H2gXoZD6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfE9t1d2VBHBT7vOVazioEwnpPzWK06GW5t9dI7CtRvA&oe=6A8988C0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_ap
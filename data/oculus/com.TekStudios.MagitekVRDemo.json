216932722570090", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75371507_1216932725903423_2765852228801420611_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KslIM3AFPAgQ7kNvwEvTRVv&_nc_oc=AdocB-bRuIS8AItPgt0S6lBfYNOpcXnPSJM5oU743MggJ-EDFsJqmiTFG9Ndnwp0kv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvTvEgkD3xqj-VCEPdZcqDAbK67jDG426evzT19MOz-A&oe=69C13CD9"}, {"file_name": "magitek-demo-screenshot-6.png", "id": "2274052269400024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610563_2274052272733357_638683785701745762_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sGPnSGu-3AQ7kNvwHl6p3w&_nc_oc=Ado2dvWb14NWdWeLqN54umwYUudIJnwpz8GQcfLP8p95CK56dGZZD-A_7ACico-TgQs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxaDDyXnn2W6VLgvn-qSbPpZZRMvfpmpvrX_uMOKyhJAQ&oe=69C14CD7"}, {"file_name": "magitek-demo-screenshot-3.png", "id": "824379492064652", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75375756_824379495397985_3720650348778114676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyYhoJUo_1wQ7kNvwHx-4wO&_nc_oc=Ado4hwwKJN3T4hwG3weHw13aXunztM-0N3aGRRklQVsuhlQ7n3nLg1FAbsqqqphiHWQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5kKoUFQGD60PzuUYw9H8OlMlVKzT-LyCMkm0irIwjhA&oe=69C13839"}, {"file_name": "magitek-demo-screenshot-4.png", "id": "1557884577991110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75532179_1557884581324443_7303620273896288304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9_JqfaZxCYQ7kNvwHEqCj1&_nc_oc=AdpNswJfRYxU8flS_wXkVUJCuYkkioisdRRqdehF5Qf08XoAxusct4yNBFRI4dFRMY0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_7menRqN0DxugfDr9lgv8Rglywfg_GVygUjeHah6UMA&oe=69C14894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab_CoverArt_Landscape (1).png", "id": "826236658545325", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974892_826236661878658_8216237805069579060_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc1NxOfXevAQ7kNvwFb50OZ&_nc_oc=AdoCdmnb1u-i3VnQbcWrrN6XuA5FDAajZqxNZUHU-SkBENS9ON7WfmSJrFIY8QNymnw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzDcrkk8bEvaG-zk49lOCtL-2CluxYabG3WGU75lr-mCg&oe=69C124C0"}, "display_name": "Magitek VR Demo", "keywords": [], "long_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra.\n\nGESTURE BASED MAGIC\n\nSpell casting is intricate and dynamic. Each class of magic will behave based on a set of physical properties each requiring new skills and training to fully master.  The demo has access to both Fire and Air magic.\n\nINTERACTIVE ENVIROMENT\n\nGrass will ignite with fire, ice will melt, water will freeze and iron will heat up and spread heat. Use this to create creative ways to fight enemies and solve puzzles.\n\nAND MUCH MORE!\n\nAnd much more!\nRPG System: Power up spells to suit your style\n\nWeapons and item: Over 15 weapons and items including; swords, spears, shields, archery and magic fruit that can be eaten to give you magically boosts.\n\nPhysics based enemies: Push, pull and interact with enemies with both weapons and spells.\n", "short_description": "Magitek VR is a magic adventure game that uses physics driven spells based on the four elements. Use magic to fight enemies and solve puzzles as you explore the world of Embra."}]}, "developer_name": "Tek Studios", "developer_privacy_policy_url": "https://www.magitekvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tek Studios", "support_website_url": null, "website_url": "https://www.magitekvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED",
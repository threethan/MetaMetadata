_JTHIQ7kNvwEk0Tbq&_nc_oc=AdrxqHT1LD-Ck6wP9Y70yXCZd9G_WqJcSkHDGLle6nNbe_RrRxHnZfFjh11pDIW0bCo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJNXyu1Qzz7LuEwSLZKkhtq1E7tqGaeoxomIiBOx8OSw&oe=6A5B71E7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mzdje_LSXkkQ7kNvwHuyO22&_nc_oc=Ado-d8nnhCGAWAuD6vAD1t4pgnwltmNBY99gbMQ9ba4jNAqiP7utDixTvzecPuKUHak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_ddeH3JJi6jqRy_AoGleyCgMy_rOFzHQ6VJ758rN5Eg&oe=6A5B640B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDZ5A6x47RgQ7kNvwHbTfNr&_nc_oc=AdrMJpidy4v1copPMWxR-bL4UclcMWFT8WbR-oXEDs0KDxzAHwPixn3W-ZRGkBSfyhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrKKiIhBWRkjtpgyjgPIEDwQ1vt8HjTvANjcfsnrjkTg&oe=6A5B802C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhO44XVddbkQ7kNvwE2VsQ8&_nc_oc=AdrwgTIy86Ep1FqeGB75sWEJ-xa8VZPZoGQLDPwp6-_Bq5kJvSI-7NWJnP3w3pNfhDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHcwYuWYjfnm8ZYAKeuIJSeYy82rWE2FmiqSiYn2etTg&oe=6A5B60C6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2byy0VcAoL0Q7kNvwFFLi5C&_nc_oc=AdoACBpUwbGktx9lA33XN8pYLix1RJmvS45n9-NwVCaUeSsbEBShyk9DRCarUPXVVro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb25TRosd-x_bI-uKfAQZLAGIUpKYWTo
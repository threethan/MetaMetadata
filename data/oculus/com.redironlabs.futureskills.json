27_961244085589706_8241191436475048396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvJad_eb8g0Q7kNvwE7g_9Q&_nc_oc=AdnIEZ1mIkN0CsHb-hAIwDDWG0whzS2FyuFBh5dXEPdqCuPVR6Pp0AqJZyWion_9y1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxaDVmhdBaRi6XYx-vbNYINi8L6wstEbMTh93f00u69w&oe=69B6A667"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbM9z_hT3z0Q7kNvwEmCB-Q&_nc_oc=AdlamLrpjPzzLKNJE0DmLwV8FBOSc96_Pw1J-y4WObqoWl-EHIC13VYq59minaKKYxY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFQ74isRkWNTgN7F6E7Wok7PhkkIQpqiaWKHgKxvob3w&oe=69B6988B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPYle0Ae2S4Q7kNvwG5Mn9n&_nc_oc=Adm0pmexLwqyGcnNYRVnCHaV9tLTnbAPYP5EaSsNQuj0IhsY7Ot0HpoagQGC378-oTg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhItvtlLi27QiBDzmjJjSpKPUXtsQ4D4AXXBmARl1VRw&oe=69B6B4AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1cWtB4M7cQQ7kNvwGCuCr5&_nc_oc=Adl6KjeToP4Dt2S3XEkFBPgIcOLR_RZjJM6qTYXU-oQ-Ul7-oZnq0bvXpIDBZpeEcbU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy05klycJtpF_ja2OdsYX3X_NEM5wPCF_DsmAtW-c6jHg&oe=69B69546"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck3gxQyiBl0Q7kNvwGaDvYA&_nc_oc=AdkNCjVfPK7eC7r1uUMgO3P7Tu-0EvxF-exysyvM7byvfU_w7qz4Zb-wFHyZYixpbAU&_nc_zt=3&_nc_ht=scont
jw6OmhYNHpVgQVrlM5sg3V1GyyKA&oe=69BE818B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8oNrzB49TcQ7kNvwF659O8&_nc_oc=AdlxsG6EwTQdQ_tpf96X1hLlzChOUJmvvmittx1eDwUmlnCsSHI5thZ-QjYpqoSTAv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXkjB6kG9CDawLT09ISmHjbVhEB4pPN0GABHCUKCO1gA&oe=69BE9DAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s8FlCmVYDYQ7kNvwHxKCuv&_nc_oc=AdkrAPLRCOPA6vBEuYSPW4HCwXj9-wXsEjPgn93ieEbGdvmziHTS_dJA-ANJOhcwXv0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3s9Gobill8G_KH_lMHN_ekLfN7LYfPldgyXCmaXVcJQ&oe=69BE7E46"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlab
ykRaBJfw&oe=6A22EBCB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_-ZiUnJEBQQ7kNvwH4uslG&_nc_oc=AdpVA2sT_IYiCfYD3ATFxr3M7Phk1hk4uv2gqBHmcefOFbQyElbz0E5RmjfZSNukSJ0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RfBrFO1FjngNFIM3ghEnIPnknffjqXDrJTfp_KZWGEg&oe=6A22CFAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOfenscUhr0Q7kNvwFJsqqQ&_nc_oc=AdrlvjaTYbabplzq5poJvSlYzlkHeiEPKdSkdnmlD6GtOu_S9BKKguL-YZclZY8hiEI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_98j_x_ESt6-a_LYiOV-muPmDqilpV_ewsntVg6DKi6Q&oe=6A22E886"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privac
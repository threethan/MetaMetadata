Qhg74Q7kNvwHoZTIB&_nc_oc=AdrPQGYYToFWbsttCo4023aUL83m9qoFsBWMShzhWzEBd3RbNJtWwW4b3zcgGdlcNTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyFhn8Se4tfuI6kj3PlJEnEEvF6NxZj3843XLRXgVEPA&oe=6AA69767"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81z9Po5YjOoQ7kNvwEl_7Ig&_nc_oc=Adp9ROHyqoDxs6RGSX93HEMV-40C17r18okaKENi1JFMlcI7xEbiNvf91yGBawQM-9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI837A9VnZ857gsy1yOERhOt_fkE73_IGufUQ-JW7L8cg&oe=6AA6C1CB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVyQuB-b_rEQ7kNvwHJkGOe&_nc_oc=AdrIDkLndv-KrlTltbHzi8Fw6JqglAkP8zpQxb33sn0oxg4m43PFVyK80QskIxalBxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNbZ21EEbgFAjB8jxcQ9sc2BT6aMdbGImGSiiBSXrF-g&oe=6AA6A5AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgq7CziYwKYQ7kNvwGqP6i4&_nc_oc=Adqv4FTkL6YTQFjQdeUUbG_gzk_GHMNL3qGERqWpf1ST3t70DsS4ZO3VmDV_jQIbwbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIepoW1AwBPR0IQnrAxxWZXpPINtwxWtbJALDbYqRoW7Q&oe=6AA6BE86"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl9Hf-ehI7oQ7kNvwESBosO&_nc_oc=AdqKATo5Sj0yTWAsRBopSzrhU7aZsFt4iGYAN-wdrkcBQNaMrtgFyJWDROT6TSDZe3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdozdWdKnJ4lV-Nx2I9-fwEl0qC9II39
09&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2tu0gZughMQ7kNvwFu-Fhb&_nc_oc=AdkYe-HOek_VgG2oPlGc14w3-fS7UUloxyCo1HSLdpBmhay604bZMvmznDh9FNT8SFU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsa8URdeb2ZiLkjC9YvkPuYcVPzYCIHPYWRuNFSMdA60Q&oe=699EF9AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0obRf-JODoQ7kNvwFbmU-A&_nc_oc=Adlh3Y2hJ9k6jljl_edNDt2IEaXmNY1eyhff1qYXj1lC24DYI3XMjffQbfF_HP__88o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsK8Fr10qHQpQM2JgQSRJ-4W1WBUtSnZGMOD14XsGNWPg&oe=699EDA46"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "ca
cG28QQ7kNvwFxgUEh&_nc_oc=Adox1PlVmwPwyFdu8AbZb5dZ4fMuG6DEE1wWBZnRrRO-YmJ1VMLjidruvhF2Szfuq-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMt9Okb8gd4t8VczQtUkDZc-xe-6Qe3oi8jUke8P3B-w&oe=6AEA0C27"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn1Xb_1v5b0Q7kNvwHeUjIM&_nc_oc=Adp5RG3J5iuNGwoW7S7hWBH9dzDJf1R6SwocBUWl_P4CaP6F64MhLN5F0IZUxdxj5_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn46wIwo9mvgDLIRTMAxoePIDfC_I3-iFHfnoeQ6HvGw&oe=6AE9FE4B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqh8kgKUQ0QQ7kNvwFgotuI&_nc_oc=AdqDr-4sZ9sV5vl8zAjZAOOTtWKRK7a46IZyKyxOTz5DGe3VS3o8KEohiLmcLnLg77Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLPPYO_EiufHlJOssa7FCwQUgfzbYBKQDgR4S-ziog6w&oe=6AE9E22C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIheK2RUnosQ7kNvwFIwU-u&_nc_oc=AdoByANrtjsIS7D1AiKsRPE338JZ-cpgYoHV0fcpuSkP77dCrHDHZfOYnw0rjmRhRo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYMPVKWPcFgjzTnYnjOz4VPaT-sfOMb8VidAUAP8M4sg&oe=6AE9FB06"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_SLjNfxvC8Q7kNvwGBZa87&_nc_oc=Adqoq4pDXB6cIrtbtdk8zrMe4mqNOqV6N2osjPpxXeY6E42YGfp2mBxGuBFh1OAU20E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuGCZ6uVLPNFT5b-Wv-ob4VelZGdfvbg
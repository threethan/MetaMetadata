7c5atlU0_zMHEFxoOv2CeT_cgKZA&oe=69B2A40B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvLGR3FvXKEQ7kNvwEs09rl&_nc_oc=AdlaOMyXl32M2FWfc1WPdFmfOhZW1twGhXajxBB63YVkIZAkshwnVAM5HnGn5xhU22c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwqrp0MTCiAL1eWp2eJkf7b4pU22YAF800i2Zr6JDIFCg&oe=69B2C02C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjgFIqxQAmEQ7kNvwGSfGWo&_nc_oc=Adlwl5qUVmeEz5PgRHdQe9IQnHIvcxVulC11JhPc71Wvi5Akyb1OI7c11bCRshyy6Gk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy26u2VTeJORJPEUx6VdLrpx72DtZV-ipXPJ-3DVx0ebw&oe=69B2A0C6"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlab
27_961244085589706_8241191436475048396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIBZ9VqTGtAQ7kNvwHkaxIR&_nc_oc=Adm_VmkbGMck7uC5Tvgv5xSpmfaQBeX79MVuqZpMP7h8P4Y_bQpDBrG2BLb7GEMrFTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afznhq41ss3hUPADTUOfnkJS4DMf0QKdwpcK3mGKQxW8eQ&oe=69BFE0E7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugHuS-2fVXYQ7kNvwEWzWfE&_nc_oc=AdkIj1F_htS8kdX1b5XpJ-eBhcMA-Xkbz7D5dzPL7sU_A3tslXVUWPhM_0uPUGKliys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkINbI9BqxsD-Thrkjuff0aprzcQ8kEPIsWMTt-jSx_g&oe=69BFD30B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8oNrzB49TcQ7kNvwF2iElS&_nc_oc=Adkx_Sa3lHjhOJcFfQ23MEh8dHK5E3Mjrq_cqWnVMKc86O_xJ_99qM0_fioHWnld6aE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQvKwudztDfu5AgmC8sLk7oq7RYCcxqScxSxTmzdBEQA&oe=69BFEF2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB1S1rVncCYQ7kNvwEL8n0w&_nc_oc=Adn4oCSKjqc1j4tynELSwm9gl17xd9PaHyylArljglQzHyer7YdLlghJlnDCAedynyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy77O8PwZBrYMUrrClDKrVKP-Esm6fEFiVQBVddLolfpg&oe=69BFCFC6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klprSvmq3HQQ7kNvwFCqqBO&_nc_oc=Adk-2_1utNZAP-x11NjQ__i8rLRT8u5VWkWdD9L_YigINUwscm45TnCD9W6Gr8DqskQ&_nc_zt=3&_nc_ht=scont
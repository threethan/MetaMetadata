LOkNR3FFmHo75CChf-0ZgE5dVjaQ&oe=69A9698B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHBW0CD1Sl8Q7kNvwFiewtD&_nc_oc=Adm_w2K-BpZ-PtJl1YXY0_ENmkueBftX1oQlw3ByDZWhjmgFmNllA0nrlSNdms07Hjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsjBHGUIg7oFOL0i1unaJOZ2_pWo08285njBQX83h-qSw&oe=69A985AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTKlk9GNcyYQ7kNvwHKcuXM&_nc_oc=AdnGJS8vV6Syxmp-KuuqS6x-KhVuRPLan9C8M6DbaP7fycI_T3ZQt_623oArJIlIq7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv_7PtzDO0UDYSdAtyxt0Sru43xy-Nq_8MYS02zF3lI6g&oe=69A96646"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlab
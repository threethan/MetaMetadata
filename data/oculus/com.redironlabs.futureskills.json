=6e7a0a&_nc_ohc=uj4_uQ-DSSUQ7kNvwFDyRxe&_nc_oc=AdlmLS2q7sIcC7nv2h0uVRALOKwPQ_4z9Ba_DaXGs-ljr6ehbJ41rq-HXDyPlvoTExw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuu8iaH66Q9uYHdURiqD6KNoXI0krqTWQJft3w06r11Qg&oe=699EEB67"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ8ze_t6p-oQ7kNvwFQkTjR&_nc_oc=AdmVNIEO-XyEX5MA7nsZ3vxT594BiJ8ejSf_m3E_yotrYTL89yx0adopeePR5n5RaOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvCrnk9vL9dR_VVNPcRvgcwnbQhiWkO8ZOoe6l4o4iAmw&oe=699EDD8B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2tu0gZughMQ7kNvwFu-Fhb&_nc_oc=AdkYe-HOek_VgG2oPlGc14w3-fS7UUloxyCo1HSLdpBmhay604bZMvmznDh9FNT8SFU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsa8URdeb2ZiLkjC9YvkPuYcVPzYCIHPYWRuNFSMdA60Q&oe=699EF9AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0obRf-JODoQ7kNvwFbmU-A&_nc_oc=Adlh3Y2hJ9k6jljl_edNDt2IEaXmNY1eyhff1qYXj1lC24DYI3XMjffQbfF_HP__88o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsK8Fr10qHQpQM2JgQSRJ-4W1WBUtSnZGMOD14XsGNWPg&oe=699EDA46"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1t-xHBXTh0Q7kNvwH-7ZeA&_nc_oc=AdlSHcMkr_BrWF9XrxUCStNRc8IXbiBiueDpsUKJNnsxnwxNFWZCeQsdfcUUq9qATN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftBlw6tTbt2YNEcnqsSwUCla6AXtMBBbRY8OFaz0FbN2A&oe=699EFCA7"}, "is_concept": f
=6e7a0a&_nc_ohc=uj4_uQ-DSSUQ7kNvwGR4K2_&_nc_oc=AdmuM1eAdfHGL4sL1TqEUZ64KaD_pB-o7i8Kw7lI7JmxiHxdELSCYxABhioi66USxUU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftLX5gZvDqZhwdS4enJC_-gG8zPAa3JWtbwAozIUhwtKA&oe=69A18E67"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ8ze_t6p-oQ7kNvwEYYHYH&_nc_oc=AdkKhot-PeEJ-pGJKtGo_31GqjQdfVHwGwyuIsGS-EhRM92seFcevUenRx23OZoEo7w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsASn72Zdr1LBVz9H6q-ZMe8tfc3P4yk2FLkRqpjZjDuQ&oe=69A1808B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXEaXy9PPzUQ7kNvwHiRpoE&_nc_oc=AdmY9cW_N-rFAbinfH0FwZ210puonRecf_1x8ZSd5ifc-UAdRO356lAnDgJIOof0acI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsXkGE32Alyu3e-6jUSYe9n3cbhHxVThBI6431RAdH56A&oe=69A19CAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfNv2NSxPEUQ7kNvwF1Evg_&_nc_oc=Adna_ruE_CHLSeubzD4NRS3n5ubFcs87QvhojW6upKP9mO6rjVMIYOuHErZAuIKZ1dc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsBKLb_nEupUHjDeOBY6uUjeggFEHc9cHsc_pl59sWWPw&oe=69A17D46"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1t-xHBXTh0Q7kNvwH5HM3k&_nc_oc=AdnJVsAE9Xefi1kYtTi5Thf7CmApcOM_7iXk3fXv7er6avXpIqLM-eSAmtiWPpTa_bA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs9m3_9zxDyVeRIfjbZEw03VVR2N8quAw9C-NEFHpCBEA&oe=69A19FA7"}, "is_concept": f
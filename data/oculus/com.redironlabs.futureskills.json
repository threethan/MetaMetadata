HweKuaNuMMVu290YzI9yDc-8JRng&oe=69B0010B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ev4jS63rAsQ7kNvwFN0KeW&_nc_oc=AdndOW6GpCsE0eQtzQsRZdGsFGJ2ROmzoxG-TozFmSR13g3EO9aEkp35LpteTXEQJOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2lS3y6SksVUqgnXsQA0e_-ZnWshXYqhjpKjhMNJyX6A&oe=69B01D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8osyLnrKhGYQ7kNvwH7E-uF&_nc_oc=Adn-AY8wFDv1jXNqNL3chsAaQedOMu2vmIedhbr_J9nQbwJc4s4eFsMEKIrVnqUY8Os&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy64EbpbSHSJNBmpBuydMsBg-MYy96606uc88uzm_7bWA&oe=69AFFDC6"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlab
En8wqMCWa3nyI8IwLVfB_YECoA3w&oe=69C1248B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shaFYThncFMQ7kNvwGjDoWl&_nc_oc=Adrh2py9Q7y0h17bFFVbWUlhOGI3coWx9Lfh39XF9f6D2EUYAud1kS7HsjzFzq_qJZo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxumNVOqJggsW0Crd_qaGUiSZ0SaIYDAzpl0_jYixGqiw&oe=69C140AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB1S1rVncCYQ7kNvwGl2ZaN&_nc_oc=AdpdmhvnN48n9lqzvIEkxCTKEgZ0xTmw0e0GtWtBsC-QHQOPakkJht9M0a3TtidjFmc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afygodb3F35Lqa09cqRXEYrej_xwTz6mcvmlLe4MjMwCXg&oe=69C12146"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlab
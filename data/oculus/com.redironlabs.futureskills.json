=6e7a0a&_nc_ohc=qjrjUT2QBacQ7kNvwGlYhuk&_nc_oc=Adn9A06IDsQRgwnbEB3niPNTgsmnfpxMwjD15F180BtRn8_Lfc-6lKTq8tEG2CNVzbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs82AJmUrNerTj4NjSxPpuSfTlOKRgxqvfc003bAPRViw&oe=699C4867"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4J9E1UXjMIQ7kNvwGHzseH&_nc_oc=AdnRbq5432PvCKQKXkrhpo8O7x5HCE5pfKGDtwArqGGiX5uiLemk5d-5TTcBA9eOsLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs0Vo42e4B_-bSJ_mdeSiDoYYCEgwL_OHayfxBFJcPVow&oe=699C3A8B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo3iIFWHtysQ7kNvwGyResq&_nc_oc=AdlY1W66cAq3Px5YaK1YhRwrgyg852YWjSkz4aN3H_TWdqYvjaiXl9F720J94rX7g-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsMBoW4J8vJ2iYk7zOaFLhn2avaEY5_idoXsvpTYVXBOw&oe=699C56AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gWl0jO9XxQQ7kNvwFId4vm&_nc_oc=AdkTe53vRUG2JhGSS6ih63UA2jdeAfFWw0uiv-pAbDUEQAkwAsEHkAeVwF1n1sBOsoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afve1mDdbpTrVJG4Y4GQ1uRemY84jriYoHY4Ny9NlDW0rg&oe=699C3746"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDRA_lMX2NkQ7kNvwEiUSms&_nc_oc=AdnhBVECikKXDxK_xCR8rRhxKt6Spf9sbrwjD4fVEb9cGl9UxXlIyt_lxr7HlPCFvhs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsUQiTfo9ZOspXfNuSEICon9U0CAZ0U9me87-J2UmnSaQ&oe=699C59A7"}, "is_concept": f
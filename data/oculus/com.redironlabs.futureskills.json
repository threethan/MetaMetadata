lwafsQ7kNvwH3cZCn&_nc_oc=AdokeDZMlEwmnO_tyK3VGFWE128WjWR2_kDVMMxOHIs6zXx32Pj_X7MboG_qOfSqq1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kb2cOn7ujQbyc6yFlvDYrvK49Ebm3hJGbdspfzdFz2Q&oe=69DA3EE7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EkykcELN_UQ7kNvwGki1I1&_nc_oc=AdoBQL3TXKioY7tx1EshoohnVVjse8cn35yHUD0nEqTLo55lMHlu9pg2u0yn-63Uc00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IqcHvVfSfkiXd6S1bFRmhiIG0Un_brqAScTClXD3wyQ&oe=69DA310B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyRkJeVvgqIQ7kNvwGftKC5&_nc_oc=AdrCBixJ945SL_oHu-Fct0bDGMyhag2JXStnJz7OzQ5RR0W5tLTkSufVw-IDBS2UOKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-mQzADnsnMkVSaEiy-Fg7xEl537r9Mc74NVHDg3FvGw&oe=69DA4D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yORBprFtedAQ7kNvwFCYtcS&_nc_oc=AdoKySbgjzD1UhpoTOrJNflkG2lBYCd9OFRQ2bxbzPZ3D6igz7pUBt4uo3mqwo8k7v8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TtCPMTO5Z3WbHczmcxB_7XDavMOlB-H2S2vTbjFeQOw&oe=69DA2DC6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDwdMBVCjpIQ7kNvwGvqUDE&_nc_oc=AdpOLtX4gqAoQbER3mg9u-Pb98by9aXEZO0BFqng6vaX_EnA-C333-B6xuDSyszt1kE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b8Pn1UIxa-XlscmKt4oVbtMN0r7OH5D
uluscdn.com/v/t64.5771-25/39003227_961244085589706_8241191436475048396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWgaxhzpuKIQ7kNvwH84Q0G&_nc_oc=Adr1TISnt6n1OtXh4fqf9-d8nD9-L7c2owIA1faoEqYRvZpB9N5IvAV75l-hGWhv9so&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyofExEx4HV0sqGP3q90I5Zog4NZWwjvcguxCMGqjNbxg&oe=69CFB2E7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3CLZaoYugsQ7kNvwGVinrJ&_nc_oc=AdqXUS4X-MgTDvAZgeZP_5ut5xebj9dY1WYxaofE_IDy0Y0ok6CrcZfO-c8iUs2PwCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyg0kgzaLNH9sSZ7uQ8tdyjegFtALJomo2T7Cll4iDW0A&oe=69CFA50B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UCBnOts9UAQ7kNvwG0eDEW&_nc_oc=AdpShHk1pI4_BkffAKt23vsR5TfPQyqR9pLtwnTGBOYCgePk4JmUpjHdBQG8-x5Hg38&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBTkn0fz6eeb2zC5xzS9EbGuMdG6mmW15vsjAqzVFQgg&oe=69CFC12C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnK9P5CO82YQ7kNvwE7RQvh&_nc_oc=AdqnPp3T0fDnz1KikbRUBJr2FteS9GVl7jh2ShT0yX8zJoNkar4SBYqAUVApNnca3Js&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWoBU5eGXdHKFHIRWO-2-pgyJZuzQN-if1n9dcYO8ZGw&oe=69CFA1C6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfZvwNsKwZgQ7kNvwF1xnuN&_nc_oc=AdpRPVvfWEYkTgJyQ_eTIJhzbQaL_Pbwp6b16ev4h
NvEvTD9alPAUG6r96FN1hxmm_l6w&oe=69AEAF8B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ev4jS63rAsQ7kNvwFYWgSt&_nc_oc=AdlSpcsrDQ3LA30LLk1o_H_khGD5WEIiDlc5Z3YC4sWSKSMTBssMI6RawOw4cRiKLPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzThFmjw9a160I3rzU3gVnuyi_CAe8D0WV3_GBGSkVj4g&oe=69AECBAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8osyLnrKhGYQ7kNvwEJ6xyE&_nc_oc=AdnNIO5Ce_QcYw3ZwgDF7SBat4GO_GbNXFgJ8XBQ-5F1al5rccALN-pnpDZqN26bVqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afws5UNHXpXo_fmbQf2qr4zm3kqRxosXtrSxs8vZvCICrg&oe=69AEAC46"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlab
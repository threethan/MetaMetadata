DKwuyYZA&oe=6A7DAB0B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXshVufNwsAQ7kNvwH2JAQl&_nc_oc=Ado1j5PNN7eLeymd7BJf82j7y-I43qAN9XwsoAJNr5OG7GkHuC7B6SRX0HNrc2FDN2c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGKeyHctJjakgRs6J4bwQ7w2AJ_obx8SqBTrYzOKvixQ&oe=6A7DC72C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XwH6CEVFGoQ7kNvwFk0k3S&_nc_oc=AdoH9sbSmrVwZmZXZq5bayUp52BlJFUW1Ee_RPhI77TPArTLIoNoreuMcBzYBnwG6qk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5KIqvXAYEvaJm7zAGCGQmWFQ_zTWjG5FWcVizw3pgsQ&oe=6A7DA7C6"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privac
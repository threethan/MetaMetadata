09&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2tu0gZughMQ7kNvwEsIZ-3&_nc_oc=AdklIEAj68bZvp3gxHk3nT4b6MEa0VNjay2NtCkFFDYLrcakS3EGcGIF3hfn-165CUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjM4_xQBamujl1kJupnpJ8KSSzIEYwv6_PNk7FEe5WuQ&oe=699DA82C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0obRf-JODoQ7kNvwG8aYaF&_nc_oc=AdnGr860X5cXLJhlEjCdIFTwb7YNCE59BNwQqmANnEPO4ZYZkfCqjvLT1EVL-YtwAkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9sFW7p783EeIWrAYgRStbqNmcuEY6HYP-v4k6Op661A&oe=699D88C6"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "ca
-p-ukQ7kNvwEgB8kS&_nc_oc=AdrdROZvmfXW3WSPo-LCuWyi5iGg6W5siVWvYMtTuGGIMLU_NKeT2QmJfhZPQfQ8PHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ItHMN5zJVu_lBIQldbTUInybzrJGbPVR6WOAHH0shyA&oe=6A031D67"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xg1xROJr80Q7kNvwEyaxgp&_nc_oc=AdqNeUn6y5Bw5v4eckM8ut8zg6vc4CnH3hsdTMQbSr03z4MADbk_0yAv6NIWtAUsU7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jzBpMIgf0Wz08CaQxnFdqxbmznjvnYxXE6Cch-ztk-w&oe=6A0347CB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBg1XLEHPI0Q7kNvwH3yEH-&_nc_oc=Adqw87i1IlXmVyK20k-XUNOxWNhgScqVoPUkcWebqE4gRnDD4PZ567QBC-GSG6qigJg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KMEcdbyTlwuV_cIfv7cC0lTopREmlUueI-UZ0WEFiiw&oe=6A032BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-4KiaOLDBkQ7kNvwFWPqJO&_nc_oc=AdpKr-PkRlxoNKm4QAt9JKHh72L4pyjX8IUPLOjC70760Eii-gCTo7f1XQQVhaZ2-Ao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VRMBX9lGwkyYJ_g8NLbJlj_grURcM31tQ086doAbArg&oe=6A034486"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfL7p3BJpVAQ7kNvwFDxIbN&_nc_oc=AdrrBtjyKTJkhYDeu0aS3-1uIVGblMiwp2WDi7Me4k9yGG_TTDjbYzCf2IFBNxvUhuU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zhvDKv_nkLB9FI0KvAwaEHLRgbRXQI6
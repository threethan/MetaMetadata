_h5NYQ7kNvwGCUBPu&_nc_oc=AdrziY2IRhSx9nDsUi2MSf3U2PYQjzk0Hoq9fBeBbMKA1Uec_NgM5k5btS1GWPD963k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55iIUDEaEUxP_Der82hElGbF9IM1H4wZw9NP0acZXquQ&oe=6A159267"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDJR47uVFIwQ7kNvwHfuv6V&_nc_oc=AdoqcQgilR0ADLOEjHcNKx6ivgMlwhym9IL1OojEr70PpR6yEDaI7GAegenbFTdhzuM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pG7X5JqJe1LlKAS6gJQ-2il8ucjW5QgwRV8VsDfAVog&oe=6A15BCCB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmU_42sFLtYQ7kNvwH6BNy1&_nc_oc=AdrzmO-iT-zIaQ_Udta7AIIA6fg3BP48cCBtbfkwPU3A10XvdeUmxO328QF1-v2eqAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7El6E1k_-VaLtnygToN0WZ4_Vcj6imfAqfCLFjbJW7gg&oe=6A15A0AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfGLJRtQT9wQ7kNvwFgMyaM&_nc_oc=AdpL1oBTzRSzL_jRcoRrCE-mIQ0vCdUiGlv_ZwqaW4avtSuABnvnfH7Ke2Hg-VGjCSc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WT1IZ1hxIefk9h0zjsUNAq02H0msjBoLy5eaa_YLKTw&oe=6A15B986"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajt3iz7HDvsQ7kNvwEkwNSo&_nc_oc=Adr3spO0fUcB7D2uQ01GvF2HMaJyCIetluI-fFE0PflGsWqEM25vy9j8Az3H126eVww&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pxzu11uLFazSXGn5V4DkdiJq713cGdL
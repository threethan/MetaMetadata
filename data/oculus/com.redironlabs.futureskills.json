uluscdn.com/v/t64.5771-25/39003227_961244085589706_8241191436475048396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwLRmnrqLAIQ7kNvwFnhqTv&_nc_oc=AdoOJK3kNZ1LWNNbLkF8TV0keMvpa_Pw0aiXU5ydtuQRwxm506H1vpDBekKTIaJt3BI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMeK7ZxAC0tazrZ8VzLst0baacHq-R7rSTgRLdq-_vQA&oe=69CBBE67"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-2w7gGAcxoQ7kNvwHHbSNW&_nc_oc=AdrcV_N2WPv_pMc9BdzwVBIB09NVZ_CX_IpgASCIQnD6QaIGFzCMEuHOdcjnH2kGSao&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7WFVNlT2fXq0F1xvcTU2_xwJrJUBeI0uwjfEECVwllA&oe=69CBB08B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNlJCtYoa2cQ7kNvwEFQej_&_nc_oc=AdqCeE9V-96RfRPBRERQCmaE7GNK8Sw3pKivnAbvwnHC6o0M2zifCJOO21_hw17eMlU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeWsCoSVirdG0raLu0F0fb-Zjac5DPhyJ3bsZPspBhmw&oe=69CBCCAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PCLMfrE4zUQ7kNvwFS1bBF&_nc_oc=Adqk-LKjHijavUhmHsQH-jArGqP0cBcHIUFpyAEzlxOIUqciBXgZmlCi8qeBN1pbz7M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnxYq0qxIYoc0kFU6j2xWI_-Fg_hTyGGuqkunxD7fFdA&oe=69CBAD46"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjnh95W3XbkQ7kNvwGmfKpY&_nc_oc=Adr9c-0SgKP1iiDxJf9LuCjPdvlPs6yNaTKEtBjVK
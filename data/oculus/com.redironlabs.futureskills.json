_JTHIQ7kNvwH4HPH-&_nc_oc=AdoyrAOO0NGNN590MWm3E3Ide2st7V69Vte42cj7NSSUy0jeubDD_voDECjG3IGPJVk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDph8Cn0l8vllk8qfw7h4LYWqYWBE0Bap0SI7tFvvZMUw&oe=6A5A2067"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mzdje_LSXkkQ7kNvwHYvLhu&_nc_oc=AdpV6d80uyrF0sJfM9xGxI-ont26kGpREw2wpi4Z3jqvTQ3gSuK-JA92TWHJrrZ5UzY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3SdRXc13_Oid71hl_idyWIvTjUk-U9LkWD4n1LXSBOg&oe=6A5A4ACB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZY8sf79lz4Q7kNvwGAUivz&_nc_oc=AdqQ2owLFk5OUBsDvCuHEuk-pQuPdK4vCrtCLTPKFR9M9c0ewgJlU8E7EncT7BofaB0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaLwSGKBTTW5xbUNoXwdTQIbsd_H5ss0pg-jhjq6hPBA&oe=6A5A2EAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhO44XVddbkQ7kNvwE0QWAN&_nc_oc=AdoSAHVHatOYD4FjP5a-fXzQo-QGtrURElbnbB_53jy2P3RmQ2kSHKLAdpZmbBbCN2c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5Zi2iC6DcDe4vxAv315rOCQWV6mHe99WK3-5OS5zwTw&oe=6A5A4786"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2byy0VcAoL0Q7kNvwGOCPwH&_nc_oc=AdrTeRUD4JIpSRB9H5N0oLtykWFR8bGYznJZR8oB_Gnp0Y88TbIKBn68Py-RsFQjlQw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKQ_0FmL0WcsEYydJF-qJeR6vaHKgw9F
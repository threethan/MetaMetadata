=6e7a0a&_nc_ohc=qjrjUT2QBacQ7kNvwFdzd0_&_nc_oc=Adke-EyVh2i9ZrHWasQbGgcKwMpZ4eF3Zq0PD9-Zkmp0ohj_4WeR8mVyz1kOeecZorU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvIuufGjrR7-B4RhQP2G4J3jgm4YecI_vusnh78czAkuA&oe=699AF6E7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4J9E1UXjMIQ7kNvwG65GP0&_nc_oc=Adkz-t1zO9zTIPipw5mU_oVAUbfr3XX-btAg0HJogG0tYGJsQGuqFOW_pkL6em90p8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft-9zCxtY4aNDBnEb--_CQrG7RF_uD_yF0jnvBjWvXH_w&oe=699AE90B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo3iIFWHtysQ7kNvwGK64DR&_nc_oc=AdmbpOhSrnniSOceJtcjU6D_J661Am35tTgMYSZHCL28pY-OGjUsB0_mII-CZ3a92rw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvogK6FPXXoSoZ7ZKV6GeVMyDoEfGND1PpzDj3O9QMatA&oe=699B052C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gWl0jO9XxQQ7kNvwFgDvXP&_nc_oc=AdkQs5lquIuYp56rbyIWdylp9XveXQ0TWXbPC8LYolT_goCQrvievABLeoq4q_PRrM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs3ccZ3c0KvWpzj3TBJRuZYqTZQqejWGanF9xvnJ_HiUQ&oe=699AE5C6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDRA_lMX2NkQ7kNvwHWNyBz&_nc_oc=AdnYz0tx_DbPEksiJFtQ_NKKgWVrLFWGSk4MvvLDFKzkNggyQTj9gt5x4SR8y-Qj1vg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvyGpTGcZqp9mQOEzQRcuMGJBOm5UU5lPkHbXjZVuorcg&oe=699B0827"}, "is_concept": f
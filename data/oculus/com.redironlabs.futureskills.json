=6e7a0a&_nc_ohc=vja3uML7bcMQ7kNvwHGe7og&_nc_oc=AdmQoGAH2XGsZwcm-J_9uwlRu7qa71UGiLWw4ckuAKz9QoT461C3B4xOx_gR-t-6VFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsggAB9nqr8eZWZNCgqX5j1vKqhZlnaCfR2hM3qeHzBlQ&oe=69A43167"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ky9iGRFKt0Q7kNvwGYpa52&_nc_oc=Adlr8NU077Ke7vQpiMnrv5EEgSrwSkTMKEpxG8CSMpM18FDEdxvIGJDy0_4zrhoIcRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvGXpcucKXtz7u673PHVMQFzPeAk1mAvnX3IvRWX5gTIg&oe=69A4238B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXEaXy9PPzUQ7kNvwEZvpbB&_nc_oc=AdlS_IWb5e69ARlRgT7Hc-UkaGMfH_ssdAk6Y8tkC9FkD0q3XZWijoltEmVl2vWIKak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuIrDSjK4fE2-t_2XCUe_pePEP0WHuw7Ip72lVNXDMixQ&oe=69A43FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfNv2NSxPEUQ7kNvwFWKoEp&_nc_oc=AdnQ8RHOKweAyBL6FkSoxkkntSpVE7GyyU70aIwnpRojtVLk1l4zsfuzPpRS5MCXw4w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsuRGGMIms6w8H39EAtMDWxOKM1yFYALCACWmvwXc3hfQ&oe=69A42046"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU7-K9Su9CYQ7kNvwHyQAJP&_nc_oc=AdluX69Mq0SS4Sl2-PBF91egWzjdiGDMOA5iEn6k6uWQJFg72XR6xjs-atC_i8oWg4M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfugTcPluZA_WEBnqpVXvlOTw-EKBhdGvobKJvmlvoQHAQ&oe=69A442A7"}, "is_concept": f
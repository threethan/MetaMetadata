_h5NYQ7kNvwFbn0L4&_nc_oc=Adq_G7qNnbFVUIVIVeGm77LZdGNXptzOM16pQWD3U1q-oJeogi5ZNl4kiLdOk7hUbfI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40Spau66mMSyG2OAROupztNZMrgTzd9bh7oGtFOUZajg&oe=6A183567"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDJR47uVFIwQ7kNvwH1Cz6K&_nc_oc=Ado_6UTTbcdh2lWd5zlqJPVaG9auKJxZ3pZlbXoBBHl4mKMbehnyXzIRPbr3jhBRt9E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ghHFqEktAgCtV8YC2ryU3Cm_ew6bFREX7kJXUlZkeuA&oe=6A185FCB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gb_QDI0hfEQ7kNvwHAHiFD&_nc_oc=AdouL9VvOQ5Wf7XjKTWz3gu3oc7z5F1l7G4bnPsISQ8MlvhbY8WAqntqiRJRdLcDOeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70_HbouQ3DYm280IYDpq1GGOVV0H1OP6FbXxoRFihMhg&oe=6A1843AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wtov7NG5TQQ7kNvwE2TTCJ&_nc_oc=Adr-9ot-LLhbS72gwYVtSHjaqWp5467QWkVMPJPohi8eRDEy7tug6EamkUYiEQgIrlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42MIxtyps2qgms4LVpqBESVrpVtsEMwI_suD9gh8AY8w&oe=6A185C86"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajt3iz7HDvsQ7kNvwFh9gy4&_nc_oc=Adpc0u2vsoJJ8X2A9XSWCf7xWFJIfdINlqC7d2mPGDTBDWy6D6UTGjoHkrdMaxiC1Sc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M4oZhypa_EKYtPJ6spM8lkDCILVbYHZ
0iO3It5g&oe=6A11C84B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXLdL3oqK2sQ7kNvwEIwwFZ&_nc_oc=AdqlhnZo1YYoyvPyj3-riR3crzbwW7PQ5dZCFJyfBkoWtGeaPhNWEtklhDtSuEH1iBU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sFhwzSSCBUPMl_XkgVRNJvcHY8Xj7xXERtOyi0gGSfA&oe=6A11AC2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvcg2S5rcuwQ7kNvwFyuMt7&_nc_oc=Adpx6dpxt2OGhvzcelmKuhqxCuwhwaXpQfpRrb0EK-P3DMTAh7DpDwu1T1HyL2e60A4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pI9DzvoTjHa-2tp-pOG0jY_NSB1vYiOVO4esBYHFzEQ&oe=6A11C506"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privac
_JTHIQ7kNvwE_qoHD&_nc_oc=Adp-hBWpynfcpFrHzq7nJg47KHY8SlXHWeBR47yfxV0ytDOKK72UiH1DnmvTKZwW3FY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB__qzkzuUGSpZxFiIwQ-U0LJO9-BaWDH3ivKnKZz78Ow&oe=6A58CEE7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mzdje_LSXkkQ7kNvwHwWxEo&_nc_oc=AdqWevDOiXGaCffyuDA16xC8vr46-xXmxL37t1OB_n-8vjQWgibksGeLTGV-OrRAcJQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYJlhvReCJJMMZ3zMttVsycz8qc14YfhokQBSgbnvKZQ&oe=6A58C10B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZY8sf79lz4Q7kNvwGigEzX&_nc_oc=AdpDTdn4WXXGTiKcksRe1WPmoDj7aRrLSGBARfd0Ukvhtl3Z8hsQHbZ5P8Nt_M00-4A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuowJkkYP3pDovd6t0wn7LBj2I9P2mlTh19zz5Hi-E7g&oe=6A58DD2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Boc7BF-LeJYQ7kNvwFzqBkb&_nc_oc=AdrYR-PY90AG3qPiPDdlcN8I2xo_-YiYSvgHKfSdCExHx87Vw9BX7-Zc4x6_OZQVa98&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz1MljKDXD_pZEZKlFitULKxLzYm9nQknG_OPZ9SUAlw&oe=6A58F606"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2byy0VcAoL0Q7kNvwG7xlrR&_nc_oc=AdqNXO7UN2RgWk6Od5bkXcbRqKFlSY9PjRTvBIU05cma68_1aCUaLDaP0FQKU0G0AmU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPnWL1zud24OLsNfQom_4NWbEf4qJaEt
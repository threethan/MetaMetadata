0tk30Q7kNvwEgzPrl&_nc_oc=AdovnCBLSXWcal632XzPhC5JPhpiRueG73uYaXOL4k4pbPyVF7apBGUE1IGiyrySfc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TxQrMgf19mde8Y44_uJvlE1v6yasb1NoeazfzESL3gg&oe=6A086367"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUWI3wJk67YQ7kNvwFcz6A8&_nc_oc=AdqOCbuA4VKn7wh5m3UlRhrDNmYUr1wyzp-uE8-qn_2bWpV5lPW1OL8YK9TQiZh0bx4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IXBYoF6NR6IJ5Oi6Q_Tir8ECoRU3fapbNWIXHU7BMQQ&oe=6A088DCB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7Ib94IbPncQ7kNvwEGZgQL&_nc_oc=AdqaDz3xJJlwZo-C1Fox8ITZqHDGjAeJ6nIv87Ul9t2bALbVf9uLiw2fObrGkBNfUdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yxq9ov8W7M5Hj4mcfO_HqIDnefd6urtZhizPffzAQWg&oe=6A0871AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVxOMjWeIwAQ7kNvwHNjp2p&_nc_oc=AdqTH_aKAIThn7sRF93WXZMruEFE05VjfJ911z_VVow-8h-ZeQQElpA98tvyLbzruFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z1xrV0nzbbAt5r1nnURpMwJgyKtRJN6FzOcQrv_twSg&oe=6A088A86"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROHIFGWI2_oQ7kNvwHB_SDd&_nc_oc=AdqVtjKJdes-Q1sfVKNPi1qFnNU3-ekcMmsj1nYdU8E0WRZKhZy37AWnM5PzPu-VCRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46KNquAFnyywH00ELutBdBclKcL_o5N7
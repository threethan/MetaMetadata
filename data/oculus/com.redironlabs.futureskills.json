=6e7a0a&_nc_ohc=vja3uML7bcMQ7kNvwF4iHwB&_nc_oc=AdlHzKJlIu8DGt_LsNuUc3yUVvzZDB08JXUSUeldooOvD5d4ci-RpwnvTYMWixSd9N0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvDZeqSYka6w27QQw4EpkRQK8xWwxeboQPMRSZKjQtySQ&oe=69A582E7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ky9iGRFKt0Q7kNvwFimsd6&_nc_oc=AdliXPkGdVQSOf5TI-9oxy7Cgiz_yEuj9NNJKwL4cO5FVgJKOaB4uFiK6RnNX3q4dkg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs6MhgOJUFR_T4w9jqPL49v6FsFbRITBJWDB145X4UVRg&oe=69A5750B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlC3dBiTokgQ7kNvwE3si6s&_nc_oc=AdlJTKOxvzg6bOSn5Lt50JCrT1E326esbdeeNIy0hX_RX5Z-scpPKwwCwzRh3Zk4cEM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv82uzDLB6s1cKyXc6P8fUSETvUkMLEE-y-hra2eC72GA&oe=69A5912C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6fco1VbHYAQ7kNvwGmYPGA&_nc_oc=AdkgB5mnvVFPM1-eCKBMGiHZVWgeHTJt089HKloOjOlUmfW-MQBrmPJ4KzII0e2Phtc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsJcaekyY1u6jdP4bvVT46yRzEJBkBZ7sbV2LvS49fXYQ&oe=69A571C6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU7-K9Su9CYQ7kNvwGFlYzK&_nc_oc=Adn0RaYRADLUqkFA4t5_AcheB54QGcaAqLw10hGoSJBp7eKs7K0hNKODzADAIg4TymY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afub9-70GTEfdqidN_hSqu7_gdNdsWWTadMW3WsDnoKNig&oe=69A59427"}, "is_concept": f
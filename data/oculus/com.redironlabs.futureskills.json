5e8Bn6MuULaZ07_-T6PcPBM8cU8A&oe=69B5470B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPYle0Ae2S4Q7kNvwFSwu8m&_nc_oc=AdltAJ9JRERg9ScWdH7AixvEX_OcZQKZdUyr95_c4OOLWq65PPOw7JGVb-sWPsPDJUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIMqvTVG5nanYLnnRdNRlYet5sng9UHfBryd7QH5f2xg&oe=69B5632C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1cWtB4M7cQQ7kNvwEn4A53&_nc_oc=AdkRlZMFt4yxVRGvQMPCigN3YASL1KrbULicXAeVRiAGjZEzSmxt0-9k4Rt7Be2j5sw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWBEYxwsWvQEP-kMnc2RKxUk3ryvAr5LAajJMSY2VaHA&oe=69B543C6"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlab
=6e7a0a&_nc_ohc=qjrjUT2QBacQ7kNvwHKEiJK&_nc_oc=AdmAZytRgtyapLJaUgWxXS-QPWld3Jct59hbftmS-VZmIiu6m6VITpmnO40JssiHwgY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuYxQ3d1TWN9RYho0nRW_X5TNgtjbbhGooCbopzAfcLBQ&oe=699D99E7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4J9E1UXjMIQ7kNvwGE2XBx&_nc_oc=AdmF_ZY62EQY45sQu0PJ7MHwrHK4ujMX-th16qRhsxdZJvr3jM3hUn-KsSk6mwFjl5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3R1wHWNdxjyzuKRURPkOMjFHF67gxEjUknxLdDLCd0Q&oe=699D8C0B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2tu0gZughMQ7kNvwEsIZ-3&_nc_oc=AdklIEAj68bZvp3gxHk3nT4b6MEa0VNjay2NtCkFFDYLrcakS3EGcGIF3hfn-165CUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjM4_xQBamujl1kJupnpJ8KSSzIEYwv6_PNk7FEe5WuQ&oe=699DA82C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0obRf-JODoQ7kNvwG8aYaF&_nc_oc=AdnGr860X5cXLJhlEjCdIFTwb7YNCE59BNwQqmANnEPO4ZYZkfCqjvLT1EVL-YtwAkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9sFW7p783EeIWrAYgRStbqNmcuEY6HYP-v4k6Op661A&oe=699D88C6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDRA_lMX2NkQ7kNvwGFUAXI&_nc_oc=AdmMQST6xOKZSaNouoGCQUMXVEnjzCjJuRdz6Y7ucGyPPa8415x6W-tVYV0bzZdRLWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvprGSZ4KHm2iYQpj12i4m6r5t-trysKWy6CQFuJ5AWkQ&oe=699DAB27"}, "is_concept": f
VhVwKnIDXzusUeABuhqZtUMisapA&oe=69AD5E0B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ev4jS63rAsQ7kNvwEk_OtT&_nc_oc=AdnGNjj1aBSGb97fbtH_nhr1bZMnEmXpS197OFcSTCwUZVTiOh-bkswQ1t5EEsyy2oc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDC8J_NaAWFrJLJmp9Wa-hJfkpQ9tJqTpCSOoJB53tGw&oe=69AD7A2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8osyLnrKhGYQ7kNvwGFdjVZ&_nc_oc=AdmBaYIYcJ_1wPJKPTY2FiqJaxh0sWy33k0L6aQs9eiAhpKE2-T_igTLlPVzdI4BYIM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYrjnb8vfnD2LOJEPbIa7eWX9i0eLjsZ8uhcAS7Ro8Vw&oe=69AD5AC6"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24905470979068956"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1087884509090722"}]}, "baseline_offer": {"id": "1087884509090722"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1709835000, "status": "PUBLISHED", "id": "1087884509090722"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26854400107509357", "version": "5.35"}, "id": "914120833542986", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24905470952402292", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26854400107509357"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "914120833542986"}]}, "change_log": "Small patches", "created_date": 1766177349, "id": "32890076650608309", "version": "5.40", "version_code": 540, "release_status": "PENDI
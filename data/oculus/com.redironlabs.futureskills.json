=6e7a0a&_nc_ohc=1LVx6YTrV6gQ7kNvwGVKSC-&_nc_oc=AdnUXEkGrbMqk_qZiXdqOyeqTJgLIlBV9qImZlPnRPITCvx6qSsZnOgM4odjNPy29z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsUyh3JPueRc8CuhPQPSY3iQ2csjx26C6vGIIDj1uORLw&oe=69A6D467"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIF9De73TuoQ7kNvwHTN2hG&_nc_oc=AdmAosJN-0Uzk8UGifWgf9yd4ODLQk3CB0w5klqpUNWiMTaHe34t5WKgEL9yDPv_vhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHhJbKGrfDP6919lOM-WC6Pr4_umujDi2phjXPBSPlgQ&oe=69A6C68B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlC3dBiTokgQ7kNvwE4TS8G&_nc_oc=AdlQNKfTQZHMqNGSb2ajgd27KqRqXQP7BKXtHgbfVZVWWrn0VgSXeLAw0UHksIlHRw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmEe4OTgvlHtx_SzrcxgGkKNaABS2_7pEJhl6kcFK5dg&oe=69A6E2AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6fco1VbHYAQ7kNvwEi6CLQ&_nc_oc=AdnL7HaRE3L-wNqdgYMOF838WZgEisp-huaJvUtxP7DY1sFWPZN5PumJM9wwaixNJE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfufA1AGVCCBcOM0z6VJwnv_98IBw-gtEegKWiOYCDJ-iA&oe=69A6C346"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffcOnWV09hMQ7kNvwHRrsNt&_nc_oc=AdkY0wyh7EU3hxUTGMCBjmOhJH7AD9XHxTSDbxsHvphvv4r1JVAZwXtkOcdN8WXoXNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftrH6uOheVe7arCYTH8Pf5-An1vi39FB6MI3reXRm5o0w&oe=69A6E5A7"}, "is_concept": f
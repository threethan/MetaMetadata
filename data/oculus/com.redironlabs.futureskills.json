Bn8vxSag&oe=6AAEAACB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUt9CDjRz9QQ7kNvwFuM063&_nc_oc=AdqaPXZIHTaWB29eLW4HyFLXTIH5CgwwJtuUrIwd-eI7L7BWBAD4QC2ZFnXm7P-HEqw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_1VseY0myXNH3ISqjHevyBM357OOGKltxuGVp_oPslA&oe=6AAE8EAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDwjVg41zNsQ7kNvwH7-hCa&_nc_oc=AdoK5Xso_7KDGYXnuH783-7tqf5oL8XUwo7vvKJyKGhG73sMsXk1I3omaPh1261EHmg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZnQJqsMkJYy64cEFX-uNrM_V5vWS4f5e93Z38zN7eNQ&oe=6AAEA786"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privac
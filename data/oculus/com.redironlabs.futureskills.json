uluscdn.com/v/t64.5771-25/39003227_961244085589706_8241191436475048396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr3YwS3blMoQ7kNvwH6eKUX&_nc_oc=AdpbU132PpCtc7UquqZjZwmNnL9buRSXOUwfGvgXvWY5ed_OApnA1MF42qohj0RsGLw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkYoaY5qDDpdM5xOOpUEtH5amj-HOFQuYMwH7NrJ1p_Q&oe=69C3D567"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErtodxWfylUQ7kNvwHyVixY&_nc_oc=AdpvFwr-C-safSNQcfSniYSz7lErpAoQ9trheaPvLohDJfYcyoGLXHA7Dv0BrfbEaXU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxD6_6qjbwOIzy1gT72FYudINRCd2zxaNgH00E35t7pIQ&oe=69C3C78B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shaFYThncFMQ7kNvwGXZUJk&_nc_oc=AdqNVEhqz217pZi81SR_KI5Esqp5v7O5y7ycMmEerMho1RnUFryrzmCnaXHDCTh_J6Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO_enS7cgNba1c6CUPI8nw-RuNg3fU6dBqS9TSwSDn4A&oe=69C3E3AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB1S1rVncCYQ7kNvwHocn7p&_nc_oc=Adp6qiJPD7hAX0RtWEiw56KhUJxvoa1fkYXU4YvUXAQgEbVPu69MpefO8IpvdmwdWCA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzElb8_rACwUr89sTWL6G1VOisJyTsPLan8euR2lbta2g&oe=69C3C446"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zpb9hYKnZocQ7kNvwEH7AGs&_nc_oc=Adr1IfYITpYk7N2fQMMAcxkRxDHi-QeY_FdzHNsJO
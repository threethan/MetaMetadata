0tk30Q7kNvwFp1iVS&_nc_oc=Adqcc6UhL8PtzfQONeDo7HzaUK91hl3lcxePaG5X4D639pPUVE7MFo8ud3GxxglYyCw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IxLiB3fgo8ZZm1ymx0-ix5x-pgFsoK54qFSXF-0FBvQ&oe=6A05C067"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUWI3wJk67YQ7kNvwE3BT47&_nc_oc=Ado2hWd5Tcx8sBFJtfZph8PNNz3zuX6POhBP5rs3Gt__vZqf2gXEpu2F3skkJx7Xn3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b3tuW3xaqg4_kuf6XC1dSlx8eUgv4WxHyCe7ftzeOFg&oe=6A05EACB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNqW47BFmkAQ7kNvwG9dsps&_nc_oc=Adr3I3AdNDBcM15ebNLAqV_FriKBmlGfQRKSs4jbRoT9RKkygD_9qSLnFDCFNQQe2EQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47TJC3tbBqoLbmTdxkBHvOYspeO8lkOEBmXCIbYlHJ_A&oe=6A05CEAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-4KiaOLDBkQ7kNvwEzu5j4&_nc_oc=AdqLP4i0VF_j274oa5uRMJZntDaXvToVmuZJJevrFllPKMULdJDWzaAZG7SWTxde3RM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xQX9kx0Yc-nrDXQx3NTZdIYz8f69QUvu6NnMLJHDACg&oe=6A05E786"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROHIFGWI2_oQ7kNvwFUHcer&_nc_oc=AdrzirgN4qQlMyJdgw-K5aUR0x1jj2oyOhrKgMYR6tZlQEx3yp7AMUGod1BmWpEXr2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jzqBFQdqBaLbhpK5VeXTBrdUkvv5dnO
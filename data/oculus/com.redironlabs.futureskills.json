27_961244085589706_8241191436475048396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLY8nibx_6gQ7kNvwFWLTWx&_nc_oc=AdliXetoXGY0_hbXqYD_pXaLAk3psxs3ARDuIXehT4POgdcEbLaiUEKwTEeMngj6ck8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbCj2sF14eD-aMkw8HWC8edVpPdhC-vRORdu4NzkctlQ&oe=69BBEC67"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XiZCHsNiRkQ7kNvwHV1DGJ&_nc_oc=Adk0yz8_AY_sjVJyJohqGDqGW9ig99X1t6ndlNAfAR6EoTp9GF4SruJdZt_16y67tlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyAkVkC0IjnuTkn6HSBN_bvOtvYgd8p_ngqLsYG7YNdbQ&oe=69BBDE8B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVnpjqJNMUkQ7kNvwH_Fs7g&_nc_oc=AdkrlMSl8Ud3sGs_Nh-CBbDOIkleL3pof4Z54YkoLZ_82VyVvE44Oz8rwJ5pFgXEvS0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyergIQhcaY0cH3mDJm8l2BRS6Dor7NVWPUylwvKZcanA&oe=69BBFAAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s8FlCmVYDYQ7kNvwGcRqBU&_nc_oc=AdlPRHu_d57G_7lVCbtqI1Z2f5RBlrZXaL4YA9BFk6fubab8KgTgZuLixpheVwvEpWk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwoWEkmsUiKtfudzx4uiHsCxAKRuNvjCOj3FAWtFcm6Yw&oe=69BBDB46"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d84WFlSKIlEQ7kNvwF157uM&_nc_oc=Adn_VuXJ9FcNBLXV67qTS7oDBb6HKDaV-t3TJp0osTV75AI3lJ07juNQIQTjVzsp0hQ&_nc_zt=3&_nc_ht=scont
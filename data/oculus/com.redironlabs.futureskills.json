uluscdn.com/v/t64.5771-25/39003227_961244085589706_8241191436475048396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwLRmnrqLAIQ7kNvwHdFYE0&_nc_oc=AdqKxRRkTyfhqGdetM1sMiJpteNnrSe4-DramteMMZ7ENImJ4WjtgouWWZ-MHRG6AVc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKt-leTr2dtZ5jRtSG6QzfxNhtUXP17VTDOIAOEauTcg&oe=69CD0FE7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-2w7gGAcxoQ7kNvwFp8v6f&_nc_oc=AdoC2uZnyspeni6i4Xog1Ws9vkzWw3dqnaWUTyNq2AfzufKjGNHQc-9eB-tz6Dn1VzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDTIGEjpcJ-Hz909DWwlVig0Rv8PFpipnYxM6I8b1fhQ&oe=69CD020B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UCBnOts9UAQ7kNvwH1RBCq&_nc_oc=AdpkpszL1zmHP2IIsE4eQSCffBqyu9j_E03Ii6bIuXmTGQ8SGOnCH9cW0q5r0VDH8Ik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNAxatMzFfCcDO4txrrfSIC-JpyHZ-qB_HeCPhv9pZtw&oe=69CD1E2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PCLMfrE4zUQ7kNvwFGeLZC&_nc_oc=AdoRdBD3WKCK8w9iSkA657mjaeRqK29JywRFgAbxFSRN77W_RcOf3yZgjUqLJ2jfWQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMAh-YhJ-r5_PPNlJJ2geoNhqxkspsOyy1Fp-EW8vfzA&oe=69CCFEC6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjnh95W3XbkQ7kNvwGvCI98&_nc_oc=AdoM-ZDS8GjBo_jpjqOS9XFw3CZNLqMVozEA9NZrE
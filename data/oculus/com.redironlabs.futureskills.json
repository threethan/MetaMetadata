NgpNB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1d9hknXv3SEKKeoXHHnSPz2sm9JfQyn0VnH9F1riBKDA&oe=69F0B6AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRQGLktxF-UQ7kNvwE2DW87&_nc_oc=AdrdnRToLdOHulBr6Kjnzu1WW1BAusicnFqVcTfy8uJKyQFY38M_dMYcokRElTAZjsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0RoeyYP5bzXBa_hDheBlgZ5kheMyyvJUzQZUh9I8Fh7w&oe=69F0CF86"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cate
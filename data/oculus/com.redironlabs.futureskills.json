-p-ukQ7kNvwE_Ily0&_nc_oc=AdpjpYkNAPayYuKA1ZB70SDeIJ5-l2vtZsyO_nWjg1DRSy-GxEWh19Gg7f18wrtFbzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e9X3YWZHs07nG2s2lpWmrPMl9Nbzxs4gx9TJSWtCdiQ&oe=6A01CBE7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xg1xROJr80Q7kNvwHbL4QO&_nc_oc=AdpWaNYE4AhxqkPJidQMsEcVRPOlPHUBPyZ1-83GtuBKMHmQkHKhMN4nPIURC32UWdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q5BgHucGf67OhfrQKnn2MMI_93f7QMbu9kTRqu71Yzg&oe=6A01F64B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBg1XLEHPI0Q7kNvwEh8xSG&_nc_oc=AdocXCa6d_Wd_6zK0o0DY0Ihy33cVo0D59eoOoVSFWGc3WDflpWUAtSt12RcFczOwIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m_OAlnE8WqAZVKzhpR8uVBpY3BkmBx3cwj9svX4JUsA&oe=6A01DA2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWb9wHKuqWcQ7kNvwH_UQtm&_nc_oc=AdrKnFiZ78zcq1u8lckrKRuu1vp3TuH1EBh_3uIJ5gHWw5rAVGlPpk481FteloC9BAs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60xEfORK3lqqr-VBLYtcSZ5aa1qqxKw18Ns02ZysNgWg&oe=6A01F306"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfL7p3BJpVAQ7kNvwF5D-4B&_nc_oc=AdrJx1GikpRmZWluxUfJvPQl-d9Dznudc_JnPfkIbGLaX-rPSDhk-c99xyN4XIzHrHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P1aHgSlfeaFoa6_RxFnUyrwLrstKBKD
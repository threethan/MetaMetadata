kPa6IQ7kNvwFy8fnJ&_nc_oc=AdqQAoXtBOa0vfTMwqGQpbNiLNU2XVjtK-wrayfqVs9h6J65WXM4c5cd8RmUZpIuCOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2YP-Lc3EbrH9_DHeZv68_QWOgfILas07NGizVPQS5WQ&oe=6AF346A7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTHccv9hykwQ7kNvwFPoI2H&_nc_oc=AdrR9ODsg5wQlEfQ9pJU6QYPVu3uUMf1tidUlAdd4VPaja1at42ggFV9lnNiKkiEoX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR9lnt665HDj-1p2JAIs_LtgXDHiqWEYiFra4iuQi01Q&oe=6AF338CB"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s-OribcbUcQ7kNvwEmexHA&_nc_oc=Adrhep-1uN9-KBRC_enG7TCj3nAMUjDrbV0OhMoAJmvU9B3Dld1JtsYEJ8-odTVVx5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH87WN-0-gRqxYRqP7ta3hNd6W51L6_Ovs6Q54FBQKHw&oe=6AF354EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsznG2f7Ta8Q7kNvwGdcqSf&_nc_oc=AdrGYgeAJXXyb4rz-kN8717h4v9LJwZ0Jx8Ub_I_2r21G38hyWMFysnh17LPp4cegqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfVy_CINRKDVyTwt3u7avKUquHB9mRgJPoYx4GvcGUzQ&oe=6AF33586"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auj7zZZNCwYQ7kNvwExu5RG&_nc_oc=AdrKpG08NkkJ_uosreSCjeG3nTRcy_QY3J6PQLzFbyUsWDtm1ciAfCebajlO9gQNalg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk2u4NyDIkv1naxJ3RWswlWTzE0dNrr-
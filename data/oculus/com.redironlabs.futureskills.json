27_961244085589706_8241191436475048396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LVx6YTrV6gQ7kNvwHjTzE0&_nc_oc=AdlfaD8G7SVMz8Es43OSRaH4UcM-75caTTcgHDlkjCUgs8OGjp0Nh47lRoZYsYGLU3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsTAotTQrqRZCPwTnRVti9SwmSncwi1dCkCJSqRmKeHPA&oe=69A825E7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIF9De73TuoQ7kNvwHo-RB2&_nc_oc=AdkKyGGQAWnS9fUVUp-ZURdaxlNEyQuXTI7EITYup7ZBoGGnhWMPyD9DXPHZkcbfB8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsotAjWCq0qMSIqfgvX--C4-RhI8uveOGzAhjSv6C3bcQ&oe=69A8180B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlC3dBiTokgQ7kNvwHg-AtG&_nc_oc=AdnFSii33LBz4LL-uUzGLsFY_NIP9p5iERe3pZT57jFxPzzi_FzluEefQyWiJbZFVCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftgynpt85Zk2BkcGdTuUnM-cmc--_BKCbLSsr2f4quksQ&oe=69A8342C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6fco1VbHYAQ7kNvwHX43bu&_nc_oc=AdmgdPsmyinyO90O9yLQlaOBKoAjCzJ6MjW3UjP3CK2TkUl6oQKbcOUZhQMnefTTC0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft9yplAy_O3geeYD3kbwZarsgkqXGP8K2_UoX9jimj0LA&oe=69A814C6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffcOnWV09hMQ7kNvwG437Gg&_nc_oc=Adk3RgelsDFt_2ZWTD2IH1IkH0uNvgimtkboqEGcY_271BGQ98vxCcPYZoYIs-9TGJg&_nc_zt=3&_nc_ht=scont
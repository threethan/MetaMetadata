JDgTfZwip_GJBImGg8slt26g&oe=6A85940B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-7HuYUvf_YQ7kNvwErfMzB&_nc_oc=AdrpAvM5ZXsSHdZvAzBS8AVr25roQPuo_5yBT70LoY3GR8NlLW-uMFGwZZ3LedVwFoU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3waeiyRkBqnrG0e8keU2jxyhBKWP3Fwt62eIm5FkV3g&oe=6A8577EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgqkWPA2qGgQ7kNvwHpC5F5&_nc_oc=AdpqKOc_fKnDqJ9tXyNHU-IXcey3juQ-CN7twB_qjTMw9SVU8CnG6tf0r4B_epS47yo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4lk_hyqiAuJbe0hgW6iqN0YkS4GQVjG0gTKf1N_dCqw&oe=6A8590C6"}, "display_name": "Experience the Energy: Adapting Futures", "keywords": [], "long_description": "\"Experience the Energy: Take the Challenge\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy: Take the Challenge\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redi
=6e7a0a&_nc_ohc=vja3uML7bcMQ7kNvwHdKg5M&_nc_oc=Adnsy3y9qOb0Mio2o895imm-RkKBHVl0yPPz1AMP1-tANVZ2mb2hQqrv_Oj2azPQZbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuaCCS8l2fDj7WAX-Dt5OTgODBeoqI6Wd-BsCyqsf1BPw&oe=69A2DFE7"}, {"file_name": "img4.png", "id": "1495466098052737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75326673_1495466101386070_7070815020309647335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ky9iGRFKt0Q7kNvwGT5EfJ&_nc_oc=AdnmbroAOhczWinQDC7h63cGPHNLXaW2R6-Lamtij3Iiiqea4FPfShXuU8mjAO0LzK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvhLNK8WD8OCi7kzWzNwn6_3B2Zhg6UfDnDtWrv1TK1jg&oe=69A2D20B"}, {"file_name": "img3.png", "id": "1144219633687226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031408_1144219637020559_198696261144177185_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXEaXy9PPzUQ7kNvwFnHRBJ&_nc_oc=AdmxilMnTw_ZdR4SUqE1-FJs_XJxTdRykXxZzj3DH3UFUy50PywZsV3sT71Ozcf8C80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQ9u2CWSGa_CGc06IWagpqeLj_qTTJFYh3rT53qhJroA&oe=69A2EE2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "img1.png", "id": "2830690787070278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001731_2830690790403611_3963931024632297416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfNv2NSxPEUQ7kNvwHaR0RE&_nc_oc=Adm1qS5iz-bNydbzsTpk7vZmvYHUMHTRSKmSRKnn4fh0AAA1P1i1v8NXbKoO5I1V-YQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqrlRoUYj71szQ-uFWHACi8BV_cUNzbPmemL5RDkdMaw&oe=69A2CEC6"}, "display_name": "Experience the Energy - Adapting Futures", "keywords": ["energy", "experience"], "long_description": "\"Experience the Energy - Adapting Futures\" is an immersive VR experience that offers players an interactive journey through various roles in the energy industry. Participants are introduced to different job opportunities within the sector, ranging from renewable energy technicians to traditional oil and gas engineers. Through engaging mini-games and simulations, players get hands-on experience performing tasks relevant to each role. Whether it's troubleshooting a wind turbine or managing a solar panel installation, the experience provides valuable insights into the diverse careers available in the energy field, while also highlighting the importance of sustainable practices.", "short_description": "\"Experience the Energy - Adapting Futures\" is a VR experience where players explore different jobs in the energy industry through interactive mini-games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redironlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red  Iron Labs", "support_website_url": null, "website_url": "https://careersinenergy.ca/programs/virtual-reality-experiences/take-the-challenge/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31362389046710418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294650_1259255399547840_8731423791104517183_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU7-K9Su9CYQ7kNvwEt9Lhb&_nc_oc=Adk60x9-MCTO5zTEX3EqGRt9CsV6RoI0sr9I1uZBGapp3t9z-g6QdDMP5IAvImb9NZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvjkA0dEf5Bnh2c522UxmYXatxGlCdRx9tjXlLkzH9exQ&oe=69A2F127"}, "is_concept": f
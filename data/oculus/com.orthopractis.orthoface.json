://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1692441562457302_1983591703681516092_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Lbn8MGm7iAQ7kNvwG407wC&_nc_oc=AdqSPQ5PMHjqjgaWOEy4jRjdiTA5XmU8wBWcTdhfO4lrkjyDcqNkVh5BBFsa4SaCElE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgYohRB818dQJfQiFLXZqX2-i421nvVNS57-ooXnpdSA&oe=6B0DB24E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "595133382_2087856595235309_4021664325262664520_n.png", "id": "1430448295733755", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/618730118_1430448299067088_2275910218353880897_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8BFtKyo6aYQ7kNvwEEaskq&_nc_oc=AdrTPnkiXqG304ZU5JwkkttvpbSVxBJ7iwSWqDe9B30PjmdnSX-_N3FaXu7ttff7oSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBSKBH2p1eIxJfAIm_uT7t9fbvOwJ7NbGDPPIOzntrPA&oe=6B0DC879"}, "display_name": "OrthoFace", "keywords": [], "long_description": "Explore facial geometry with OrthoFace, an educational workspace for 3D review and reversible colour visualization.\n\nLoad the labelled canonical teaching model or import an OrthoFace frame JSON. Review a 468-point face mesh, regional asymmetry, 50 proportional relationships and selectable geometric masks. Rotate, tilt, zoom and inspect the model with reference planes and axes.\n\nTry reversible painting, mirrored colour, fill, eraser and Undo/Redo. Original REAL geometry remains distinct from the apparent FIT colour preview. Export reports, measurement CSV, frame JSON, OBJ/STL/PLY geometry, mask images and a complete ZIP.\n\nOpen XR / AR to inspect a captured model, reposition it, change its size and recenter the view. The captured model is not a live, world-registered overlay on a person. Optional outward-camera capture requires compatible Quest hardware, camera permission and a consenting person in front of the headset.\n\nCamera depth and scale are estimates. Teaching models are not patient data. Results are for education and visualization, not diagnosis, treatment, surgical navigation, identification or attractiveness scoring. Protect face information and obtain permission before capture, import or sharing. Review the Privacy Policy for processing and SDK data practices.\n\nSupport: info@orthopractis.com", "short_description": "Explore facial geometry, asymmetry, reversible colour previews and captured 3D models in XR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.orthopractis.com/privacy", "developer_terms_of_service_url": "https://www.orthopractis.com/terms-of-use", "publisher_name": "ORTHOPRACTIS.COM SINGLE MEMBER P.C.", "support_website_url": "https://www.orthopractis.com/orthoface", "website_url": "https://www.orthopractis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1470790619442674"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2387412348731982"}]}, "baseline_offer": {"id": "2387412348731982"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795061100, "status": "PUBLISHED", "id": "2387412348731982"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1516098014911934", "version": "4.4.6"}, "id": "1157408210565403", "channel_name": "LI
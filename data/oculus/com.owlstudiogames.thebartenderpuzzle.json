.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXXXSULZKuHxsMYCf5T6lA1Yg6L0344OxQ9DxV_YJFFA&oe=6B0EF172"}, {"file_name": "Screenshot 2026-10-10 170601.png", "id": "1741474916918487", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604370996_1741474920251820_1913808292212490569_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hLuHWjdcagQ7kNvwG9qbZd&_nc_oc=AdpfjjgPmUYljrNRDJPmHzsdT18FPhd83JOb2dz_JkL1zHQa0A5xIlcRhozk2vOdsto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDW4VZamlUbgOMO_kAGs18SiEl2TkDakCtmBX1rmvz_Q&oe=6B0F1649"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot super 1.png", "id": "2490513521439232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_2490513524772565_6010061833148059404_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWpTD06HrGsQ7kNvwFBaGdM&_nc_oc=AdqOOBG9yY8cqH5D6uRKTCFyHUEaRvZr98Uc_00dUPT_Ig_eI-vov01-ApsrvghH3C0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjhhh3nM5W5XAN38Bz0gG2TD9uJ6BmG4lMECk5vX9XsQ&oe=6B0EFF32"}, "display_name": "Liquid Sort VR puzzle", "keywords": ["puzzle", "sort", "liquid", "bottles"], "long_description": "Pour. Sort. Mix. Serve. Master the Bar.\nStart by sorting colorful liquids into the correct bottles. Grab, tilt, and pour each bottle to organize the colors and solve increasingly challenging puzzles. Plan your moves carefully \u2014 every pour can make the difference!\n{1095906740012590}\n\nOnce your bottles are sorted, the real bartending begins. Check what your customer wants, prepare their drink by mixing the correct liquids, and follow the recipe carefully.\n\nBut a great drink needs the perfect finishing touch. Add the garnish your customer requested, complete the drink, and serve it exactly as ordered.\n\nPlay naturally with hand tracking or use VR controllers. Reach out, grab bottles, pour liquids, prepare drinks, and add garnishes using intuitive VR interactions.\n\n\ud83c\udf79 Sort colorful liquids\n\ud83e\udde9 Solve challenging puzzles\n\ud83e\udd43 Mix customer orders\n\ud83c\udf4b Add the requested garnish\n\ud83d\udd90\ufe0f Play with hand tracking or controllers\n\ud83c\udfaf Complete every order perfectly\n\nThink before you pour. Follow the recipe. Add the finishing touch.\n\n", "short_description": "Step behind the counter and put your bartending skills to the test in The Bartender, a relaxing yet challenging VR liquid-sorting puzzle game where every customer has a drink to order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/the-bartendervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 owl studio", "support_website_url": null, "website_url": "https://sites.google.com/view/the-bartendervr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26691504220546823"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1480040127291634_2438909503017623888_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqLB_GgmBNwQ7kNvwFTkICC&_nc_oc=Adq6y6UzODROVrpw05IRAk4Uji8k8tRmV4sWy5Oh2l6EdQ1DugUpLpxC2_FdHl5681w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHPB-OziHAKtsjhWEMVreT0dvlIBogvv6cgu5U8ALn3Q&oe=6B0F01D8"}
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwokiBsCN8uE6AQXzoaZsDMXpYVO5P5wX3xBFrNToqzw&oe=6B09AB72"}, {"file_name": "Screenshot 2026-10-10 170601.png", "id": "1741474916918487", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1741474920251820_1913808292212490569_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3QN-kuVNP4Q7kNvwHnhD_r&_nc_oc=Adr8etuEvmvMxzP1rfDS5vrWMYLJvPRSEUrzW0vEeZf2VpsZqrueD16vKZjcIiIm398&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAoAZb7HLouuLyWEe126mVhwV95s0jNWVuFHvGRvNv_Q&oe=6B099809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot super 1.png", "id": "2490513521439232", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596149727_2490513524772565_6010061833148059404_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6Rc-hqZa30Q7kNvwEIFBwr&_nc_oc=AdqNGgUF5GshCINWcjtIqAcBxmXk_78zdd_7-xB7Dm0sVhpJbATL0_r_FK4FIdwP_Zg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4FH5bVm56YsPBt6-f4_GoAOtnUJoY8fOlGYn9iEIJUQ&oe=6B09B932"}, "display_name": "Liquid Sort VR puzzle", "keywords": ["puzzle", "sort", "liquid", "bottles"], "long_description": "Pour. Sort. Mix. Serve. Master the Bar.\nStart by sorting colorful liquids into the correct bottles. Grab, tilt, and pour each bottle to organize the colors and solve increasingly challenging puzzles. Plan your moves carefully \u2014 every pour can make the difference!\n{1095906740012590}\n\nOnce your bottles are sorted, the real bartending begins. Check what your customer wants, prepare their drink by mixing the correct liquids, and follow the recipe carefully.\n\nBut a great drink needs the perfect finishing touch. Add the garnish your customer requested, complete the drink, and serve it exactly as ordered.\n\nPlay naturally with hand tracking or use VR controllers. Reach out, grab bottles, pour liquids, prepare drinks, and add garnishes using intuitive VR interactions.\n\n\ud83c\udf79 Sort colorful liquids\n\ud83e\udde9 Solve challenging puzzles\n\ud83e\udd43 Mix customer orders\n\ud83c\udf4b Add the requested garnish\n\ud83d\udd90\ufe0f Play with hand tracking or controllers\n\ud83c\udfaf Complete every order perfectly\n\nThink before you pour. Follow the recipe. Add the finishing touch.\n\n", "short_description": "Step behind the counter and put your bartending skills to the test in The Bartender, a relaxing yet challenging VR liquid-sorting puzzle game where every customer has a drink to order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/the-bartendervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 owl studio", "support_website_url": null, "website_url": "https://sites.google.com/view/the-bartendervr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26691504220546823"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830576_1480040127291634_2438909503017623888_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkbf-SDF0I4Q7kNvwGT6rbS&_nc_oc=Adr75LDt-tXoHq4czu-MstyAmgapfSVV7CgZW9SCSlKhvlgpFVy6fltlRnaBy5D-OUA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgSKdriGU0ay25s_0VT-MmEJOmhonidstLu_o4vM_ItQ&oe=6B09BBD8"}
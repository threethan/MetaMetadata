6-1.oculuscdn.com/v/t64.5771-25/75196223_24626342266965364_4639153513506205510_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvoEHfKEPvcQ7kNvwFZZAtW&_nc_oc=Adp7osYUXj3EuiJ32KNHuz6dMiajA_HyWJxoqknBvqm1CiaIo5_m6igGtOqapCH_Vqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL0V-UHWn3aw4sqrh_k4-Bth1Y12kliZ4ywpcOI41DZA&oe=6B045A47"}, {"file_name": "Screenshot5.png", "id": "2810880739080202", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035346_2810880742413535_1026765721309172970_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjqvTlzny1MQ7kNvwG0szk6&_nc_oc=Adpa9DkXE4XTKp4Qs8-VNXB62LFvjSdfv77XcgZKPpa4YKG4tVE14bdD1NHY9VEuOJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEfpDWnw2Qu27GBCO-CzrXJpFhdxHJrZrnr3zJUF4wiA&oe=6B045882"}, {"file_name": "Screenshot3.png", "id": "970751160661943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974703_970751163995276_1778428781384122044_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Zp7WZJa0fgQ7kNvwGzBevH&_nc_oc=AdrnifCiWbIqiULiwOL5CLkvwlUe1B4U2d9eES3ff5r0hRwWFWQ2t5Y2LYOSNHCv6pE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAKxa8Igp8l70Y7IlQ7pT3iLhNEWut38Qpigfejk9BcA&oe=6B045F0A"}, {"file_name": "Screenshot4.png", "id": "3560933707454163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580060_3560933710787496_5663656956646368754_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7l1fysO1gC8Q7kNvwFeCIpO&_nc_oc=AdoCUVwuyKshPE-XWsdF_ke4iD8mw5NTvpsvm75lEdpgDL5IbWJGrRAnYw0kmTm6a3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5FW4UuLxU-u6yyYKFcBDNnOf9-u0_x0ZE2b1W-XowlA&oe=6B047F5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mythic Realms", "keywords": [], "long_description": "In Mythic Realms players step into the role of a curious adventurer. A chance encounter with a mysterious object triggers an astonishing transformation, transporting players into a mesmerizing parallel world with their own teeming with secrets to be discovered.\n\n\u2022 Mixed Reality: Seamlessly blend your reality with a mystical realm as you use your device to interact with objects and characters from both worlds. Experience the wonder of worlds colliding and witness monsters crossing over into your surroundings.\n\u2022 Mining: As the chosen hero, you'll need to rebuild a fallen kingdom. Venture through forests.\n\u2022 Dynamic Gameplay: Whether you're battling fearsome creatures in your living room or building a kingdom in VR mode, there are plenty of interactive activities to keep you occupied. \n\u2022 Foes: Sharpen and upgrade your weapons to defeat waves of enemies. \n\u2022 Creativity: Immerse yourself in a visually stunning world that seamlessly blends fantasy with reality. Build a kingdom, forge for materials, and upgrade your weapons through smithing. \n\u2022 Ascend as a Hero: Strengthen your character by unlocking new abilities, enhancing your magical prowess, and mastering combat techniques. \n\nMythic Realms invites you to transcend the boundaries of your world and enter a realm of endless possibilities. Unearth the mysteries of the world colliding with your own, uncover the truth behind why they are colliding, and shape the destiny of a realm in need of a hero. Are you ready?", "short_description": "Embark on an extraordinary journey of transformation and discovery in Mythic Realms, a captivating mixed reality role-playing game that blends the real world with a realm of mystery, monsters, and magic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Petricore", "support_website_url": null, "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2
6-1.oculuscdn.com/v/t64.5771-25/75196223_24626342266965364_4639153513506205510_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DatqO28by08Q7kNvwH1-o_I&_nc_oc=AdolvJldezje1rQDkE-htOvO8VzlN6WvZOk9t6Od_i_6Wtwi7peE4_az0OV42HwpG78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHMiKyeNGjdVi6jGwkDb9j1LSz8GZ9qq1z67tdWAXStg&oe=6B0F1E87"}, {"file_name": "Screenshot5.png", "id": "2810880739080202", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035346_2810880742413535_1026765721309172970_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QglyrWXW7U4Q7kNvwF2FPlI&_nc_oc=Adok7fO2_RweE0y0X6jUvr1YL2E5jAK-E8MhzECuYXE1ttolKtWAeZvsMGGVlnOO_g8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUmXOrSsK5LeEo1MdV5n_TzXURCNtPGRCKgQh4_3eKjQ&oe=6B0F1CC2"}, {"file_name": "Screenshot3.png", "id": "970751160661943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974703_970751163995276_1778428781384122044_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ehFJIpjfgkQ7kNvwFOzlMn&_nc_oc=AdorayJYz6blJxvTp3gNYX1n2_hvTQsFpSh2LfVBnV-BXOE4rlyplToyRwhNlQxBUzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU2ivkixMrlQ7yOyiyrb5Tz5dxK2N12sPZhtEBuewDpZA&oe=6B0F234A"}, {"file_name": "Screenshot4.png", "id": "3560933707454163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580060_3560933710787496_5663656956646368754_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXeuUxzM_4MQ7kNvwH3Ua4I&_nc_oc=AdoY6C9YDlOi9u_BEx7H7zJBy50AgliXzF_WookVW4C4q25_TGMaNUz9b5c4-vDqT0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU-4vtBbzAoy-IRKxDcSIt6fVnPMfKcS0v4MnViEhXd4w&oe=6B0F0B5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mythic Realms", "keywords": [], "long_description": "In Mythic Realms players step into the role of a curious adventurer. A chance encounter with a mysterious object triggers an astonishing transformation, transporting players into a mesmerizing parallel world with their own teeming with secrets to be discovered.\n\n\u2022 Mixed Reality: Seamlessly blend your reality with a mystical realm as you use your device to interact with objects and characters from both worlds. Experience the wonder of worlds colliding and witness monsters crossing over into your surroundings.\n\u2022 Mining: As the chosen hero, you'll need to rebuild a fallen kingdom. Venture through forests.\n\u2022 Dynamic Gameplay: Whether you're battling fearsome creatures in your living room or building a kingdom in VR mode, there are plenty of interactive activities to keep you occupied. \n\u2022 Foes: Sharpen and upgrade your weapons to defeat waves of enemies. \n\u2022 Creativity: Immerse yourself in a visually stunning world that seamlessly blends fantasy with reality. Build a kingdom, forge for materials, and upgrade your weapons through smithing. \n\u2022 Ascend as a Hero: Strengthen your character by unlocking new abilities, enhancing your magical prowess, and mastering combat techniques. \n\nMythic Realms invites you to transcend the boundaries of your world and enter a realm of endless possibilities. Unearth the mysteries of the world colliding with your own, uncover the truth behind why they are colliding, and shape the destiny of a realm in need of a hero. Are you ready?", "short_description": "Embark on an extraordinary journey of transformation and discovery in Mythic Realms, a captivating mixed reality role-playing game that blends the real world with a realm of mystery, monsters, and magic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Petricore", "support_website_url": null, "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2
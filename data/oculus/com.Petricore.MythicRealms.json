3-1.oculuscdn.com/v/t64.5771-25/75196223_24626342266965364_4639153513506205510_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnL1c4t3P6AQ7kNvwEQBYo_&_nc_oc=Adr4tV-A_uU2Gk36zV8GrFTPBR2CxQLOzga-1rr0PVrlYbFmG6yvUfHiq8sL6koMA-U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg7frlsmpQ-UrFhwvYY1cHXJd0zr7L1BND42kfNT7PRA&oe=6AFB1FC7"}, {"file_name": "Screenshot5.png", "id": "2810880739080202", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035346_2810880742413535_1026765721309172970_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS6Abe8lguoQ7kNvwG5mhL3&_nc_oc=Adp6odaPlWbZh8NlSwSNN1P8gAeD4Oy24vlx6P8pBN20hX2smaxfDxF65uQbRq0gbLw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQciPjxTV-9aeGVVlXMEk3GcEGwbi9MVRR_-i6sZtONLA&oe=6AFB1E02"}, {"file_name": "Screenshot3.png", "id": "970751160661943", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974703_970751163995276_1778428781384122044_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Of_PSI-ihUQ7kNvwGDbMrj&_nc_oc=AdpsNcJcEGzc7GPvsIjBemMQE1NU8ZGsLJ24civDe5uFTl_Mn5QvN1r_vbu8LYoX-eY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrSOnIJvZy843GVgeQkrqj_M-iGRWuLa-5k0SvALmLkQ&oe=6AFB248A"}, {"file_name": "Screenshot4.png", "id": "3560933707454163", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75580060_3560933710787496_5663656956646368754_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhvhqIJydMQQ7kNvwE6QvlK&_nc_oc=Ado2xXFdyq4s-BC9zCwbbI9T50H2ndeFq8VrCFZKXqWySsgP_8X5pAZol3aAwo-GPaw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGyNupso_eg_G4L22e3zgwslq0GgENeP-eRfn5e5Jl7Q&oe=6AFB44DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mythic Realms", "keywords": [], "long_description": "In Mythic Realms players step into the role of a curious adventurer. A chance encounter with a mysterious object triggers an astonishing transformation, transporting players into a mesmerizing parallel world with their own teeming with secrets to be discovered.\n\n\u2022 Mixed Reality: Seamlessly blend your reality with a mystical realm as you use your device to interact with objects and characters from both worlds. Experience the wonder of worlds colliding and witness monsters crossing over into your surroundings.\n\u2022 Mining: As the chosen hero, you'll need to rebuild a fallen kingdom. Venture through forests.\n\u2022 Dynamic Gameplay: Whether you're battling fearsome creatures in your living room or building a kingdom in VR mode, there are plenty of interactive activities to keep you occupied. \n\u2022 Foes: Sharpen and upgrade your weapons to defeat waves of enemies. \n\u2022 Creativity: Immerse yourself in a visually stunning world that seamlessly blends fantasy with reality. Build a kingdom, forge for materials, and upgrade your weapons through smithing. \n\u2022 Ascend as a Hero: Strengthen your character by unlocking new abilities, enhancing your magical prowess, and mastering combat techniques. \n\nMythic Realms invites you to transcend the boundaries of your world and enter a realm of endless possibilities. Unearth the mysteries of the world colliding with your own, uncover the truth behind why they are colliding, and shape the destiny of a realm in need of a hero. Are you ready?", "short_description": "Embark on an extraordinary journey of transformation and discovery in Mythic Realms, a captivating mixed reality role-playing game that blends the real world with a realm of mystery, monsters, and magic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Petricore", "support_website_url": null, "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2
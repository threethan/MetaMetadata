3-1.oculuscdn.com/v/t64.5771-25/75196223_24626342266965364_4639153513506205510_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvoEHfKEPvcQ7kNvwHQMax_&_nc_oc=AdrGKNK7QycpfpnBl_umFZfC8UGZPkSn7ja-AI1RoINRfiXzUo0CcYkufjmWzHP3JpQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFTnDNebekCSJbDxw-ijaCgV1fMrKpoaHNMkf7nxcsEQ&oe=6B0308C7"}, {"file_name": "Screenshot5.png", "id": "2810880739080202", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035346_2810880742413535_1026765721309172970_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjqvTlzny1MQ7kNvwEoMizg&_nc_oc=AdqaoU3KaVkmskQAgphhp7IAB-M_SukEniJU9MtKITUQRpkQ-zS9jMQzPZl8ta-nd1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsxOxpnwjDYt7imeHouh4bnO8NKiJBbTLjuHXKNCxDag&oe=6B030702"}, {"file_name": "Screenshot3.png", "id": "970751160661943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974703_970751163995276_1778428781384122044_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Zp7WZJa0fgQ7kNvwGayTDa&_nc_oc=AdrpwOSjS0xz45Yr1zKk6sOBNJQaI7VHOYuxpXkPXG3lAhR54jpGDFB3aL4IKlom8kE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgxuAw5YcSQfGKLxqvE0jhb_ZO_6DDTZnOHXGZqyq1Iw&oe=6B030D8A"}, {"file_name": "Screenshot4.png", "id": "3560933707454163", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580060_3560933710787496_5663656956646368754_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7l1fysO1gC8Q7kNvwEDKiT4&_nc_oc=AdoWTbVTlL4jY3LaDNLlwbIXG_uD7Les08ZEAri2wieotb3R78SU0SOCn6cmXJWYkIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkcxymGVgTQ3pjAv6zti4wvHOOSx3ASepv-MBwILGHvA&oe=6B032DDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mythic Realms", "keywords": [], "long_description": "In Mythic Realms players step into the role of a curious adventurer. A chance encounter with a mysterious object triggers an astonishing transformation, transporting players into a mesmerizing parallel world with their own teeming with secrets to be discovered.\n\n\u2022 Mixed Reality: Seamlessly blend your reality with a mystical realm as you use your device to interact with objects and characters from both worlds. Experience the wonder of worlds colliding and witness monsters crossing over into your surroundings.\n\u2022 Mining: As the chosen hero, you'll need to rebuild a fallen kingdom. Venture through forests.\n\u2022 Dynamic Gameplay: Whether you're battling fearsome creatures in your living room or building a kingdom in VR mode, there are plenty of interactive activities to keep you occupied. \n\u2022 Foes: Sharpen and upgrade your weapons to defeat waves of enemies. \n\u2022 Creativity: Immerse yourself in a visually stunning world that seamlessly blends fantasy with reality. Build a kingdom, forge for materials, and upgrade your weapons through smithing. \n\u2022 Ascend as a Hero: Strengthen your character by unlocking new abilities, enhancing your magical prowess, and mastering combat techniques. \n\nMythic Realms invites you to transcend the boundaries of your world and enter a realm of endless possibilities. Unearth the mysteries of the world colliding with your own, uncover the truth behind why they are colliding, and shape the destiny of a realm in need of a hero. Are you ready?", "short_description": "Embark on an extraordinary journey of transformation and discovery in Mythic Realms, a captivating mixed reality role-playing game that blends the real world with a realm of mystery, monsters, and magic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Petricore", "support_website_url": null, "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2
6-1.oculuscdn.com/v/t64.5771-25/75196223_24626342266965364_4639153513506205510_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1tsDXCp0jIQ7kNvwFQT9x6&_nc_oc=Adq-8mATAys-zpabh2O2G4TO1FSCl1-n5ej7uX7j8oId_oBlxQ27sR7sRwJQveqDHAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8DRExjdRWbs9NIHib--lvQXTkysOUYJu9WBlFiKAEAQ&oe=6B0C7B87"}, {"file_name": "Screenshot5.png", "id": "2810880739080202", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035346_2810880742413535_1026765721309172970_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oI0E7hOmL4Q7kNvwGHRFLI&_nc_oc=AdrczgTJLHs-os4WpCNQgprvhfXblcj3c3pyXfYbBh1TJNz2HN3ybEiMzEF79cCY3W0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQIE2GEbWAPl9ys2yseP81AsaDKSXNQeS9zqCn1riDWg&oe=6B0C79C2"}, {"file_name": "Screenshot3.png", "id": "970751160661943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974703_970751163995276_1778428781384122044_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0mz0BY9I9sQ7kNvwFbzhpI&_nc_oc=AdoW345aO6pSZihVQ4JXgVSsLsRRYY0EpsN883jY72UYgM3CGDzXcU4tusKXJJaAsX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSktOXbSCihFdE1JKzoW24DZtQtAvG6I5dPaVbyCLEK-A&oe=6B0C804A"}, {"file_name": "Screenshot4.png", "id": "3560933707454163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580060_3560933710787496_5663656956646368754_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z8L-9Ajy14Q7kNvwGarCvr&_nc_oc=AdqNsyxhF5EvW2DPSgWslxlsqqMWvhZ9auw0tEVONhLSB1YgWj8aVvpmPIWahxNTWMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMRdajvRksdVm2Tzn8Vo3N99QRS5SXqBFGDTsxRPyrdA&oe=6B0C685A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mythic Realms", "keywords": [], "long_description": "In Mythic Realms players step into the role of a curious adventurer. A chance encounter with a mysterious object triggers an astonishing transformation, transporting players into a mesmerizing parallel world with their own teeming with secrets to be discovered.\n\n\u2022 Mixed Reality: Seamlessly blend your reality with a mystical realm as you use your device to interact with objects and characters from both worlds. Experience the wonder of worlds colliding and witness monsters crossing over into your surroundings.\n\u2022 Mining: As the chosen hero, you'll need to rebuild a fallen kingdom. Venture through forests.\n\u2022 Dynamic Gameplay: Whether you're battling fearsome creatures in your living room or building a kingdom in VR mode, there are plenty of interactive activities to keep you occupied. \n\u2022 Foes: Sharpen and upgrade your weapons to defeat waves of enemies. \n\u2022 Creativity: Immerse yourself in a visually stunning world that seamlessly blends fantasy with reality. Build a kingdom, forge for materials, and upgrade your weapons through smithing. \n\u2022 Ascend as a Hero: Strengthen your character by unlocking new abilities, enhancing your magical prowess, and mastering combat techniques. \n\nMythic Realms invites you to transcend the boundaries of your world and enter a realm of endless possibilities. Unearth the mysteries of the world colliding with your own, uncover the truth behind why they are colliding, and shape the destiny of a realm in need of a hero. Are you ready?", "short_description": "Embark on an extraordinary journey of transformation and discovery in Mythic Realms, a captivating mixed reality role-playing game that blends the real world with a realm of mystery, monsters, and magic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Petricore", "support_website_url": null, "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2
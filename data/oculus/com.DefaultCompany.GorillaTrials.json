0x1440.png", "id": "1287619559018173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391904_1287619562351506_6491365879020215779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lS17x-toSwMQ7kNvwGd_X9m&_nc_oc=AdkhwkwkTsL86ItnxDyzP6HYPYJ4CGyYaHtEfk1gm68SoCSsvN3rjvhdk3S0_T_dGns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftcDMUWFo5JTk7PeWZk9PMKzk3Zn5KQEh4XWM4CJvQNzQ&oe=699B09B6"}, {"file_name": "Horror_4K_29.01.2025_22-23-15-2560x1440.png", "id": "2989552087858577", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_2989552094525243_3298438088562739191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnD1SDwYT30Q7kNvwEU4Kj6&_nc_oc=Adno2__qA1Ugar9Upeoz93brvs5cB1t3IhuuXbfLaFhcdA6Nh_3yr3sh6fpSTRTl3L0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afum6E9mkUOAMJrDENTU-oI_6D5pE51HLWSm_NttVV_Cmw&oe=699AE6CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GorillaTrials", "keywords": ["horror", "adventure", "action", "Survival"], "long_description": "Gorilla Trials is a psychological horror VR game that plunges players into the heart of a chilling, abandoned research facility where they must survive terrifying encounters with genetically engineered gorilla hybrids. The game begins as the player wakes up in a sterile, dimly lit room with no recollection of how they arrived. The air is thick with a sense of dread, and as the player steps forward, the realization quickly sinks in: something is horribly wrong in this place.", "short_description": "Welcome to Gorilla-Trials!\nWe provide a nice staff team\na playful and joy able game for others to play\nand we have nice staff members to moderate over the game so that any type of toxicity will not be prohibited\nThis game also includes horror and game-modes soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gorillatrialsprivatepolicy.mystrikingly.com/private-policy", "developer_terms_of_service_url": null, "publisher_name": "ZapoG
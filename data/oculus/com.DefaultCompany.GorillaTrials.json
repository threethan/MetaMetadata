0x1440.png", "id": "1287619559018173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391904_1287619562351506_6491365879020215779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2NW0UJ3yCIQ7kNvwFZcYw4&_nc_oc=Adr3gHgNSM6T2D8rkUyYrD_6DNFeX4GJempzxx-CO35L-lrPQaqnnSb4VsHMnKctmdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2gnLLdOu--eJuT365ArKbowBDGsQECeq8e0HRPoTOUKw&oe=69F0BB36"}, {"file_name": "Horror_4K_29.01.2025_22-23-15-2560x1440.png", "id": "2989552087858577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_2989552094525243_3298438088562739191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAdX8shFnasQ7kNvwF5ZcaY&_nc_oc=AdqZPwrxBVAFAGDqfrdkcjAAm-XOlyDbI3sixbthHSwIiQGUwB_g1OrfmAURkt8ZU-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3mer22hH-3kcjlUX3_5IbNXmA-QwPtxTwuyhFK5MsN4A&oe=69F0D08D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GorillaTrials", "keywords": ["horror", "adventure", "action", "Survival"], "long_description": "Gorilla Trials is a psychological horror VR game that plunges players into the heart of a chilling, abandoned research facility where they must survive terrifying encounters with genetically engineered gorilla hybrids. The game begins as the player wakes up in a sterile, dimly lit room with no recollection of how they arrived. The air is thick with a sense of dread, and as the player steps forward, the realization quickly sinks in: something is horribly wrong in this place.", "short_description": "Welcome to Gorilla-Trials!\nWe provide a nice staff team\na playful and joy able game for others to play\nand we have nice staff members to moderate over the game so that any type of toxicity will not be prohibited\nThis game also includes horror and game-modes soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gorillatrialsprivatepolicy.mystrikingly.com/private-policy", "developer_terms_of_service_url": null, "publisher_name": "ZapoG
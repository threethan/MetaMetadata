0x1440.png", "id": "1287619559018173", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391904_1287619562351506_6491365879020215779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdOjVoXN24kQ7kNvwE-qWN7&_nc_oc=AdlI1-TnA3aNz365DW2jX4XIn-65eUzg9vNqAeVS4Lqr8lcyDXuUHT_mWoRWJg_UuOk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvaUrL_EFpXMs1y1GT21_ELgJ21-9SDDSC8cvmA8TspWA&oe=69A1A136"}, {"file_name": "Horror_4K_29.01.2025_22-23-15-2560x1440.png", "id": "2989552087858577", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391949_2989552094525243_3298438088562739191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWz2jjhqGpUQ7kNvwFdpz6X&_nc_oc=Adm_esCN9HEVju3s9vmRugCQDlSYg01UFEwGLcVrZ_R01e--7d7UhWctauccOZIi340&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftut2Yn35CsD8Ecy42PZq0a9vE8BzkOK7jdJBGM45Vf7g&oe=69A17E4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GorillaTrials", "keywords": ["horror", "adventure", "action", "Survival"], "long_description": "Gorilla Trials is a psychological horror VR game that plunges players into the heart of a chilling, abandoned research facility where they must survive terrifying encounters with genetically engineered gorilla hybrids. The game begins as the player wakes up in a sterile, dimly lit room with no recollection of how they arrived. The air is thick with a sense of dread, and as the player steps forward, the realization quickly sinks in: something is horribly wrong in this place.", "short_description": "Welcome to Gorilla-Trials!\nWe provide a nice staff team\na playful and joy able game for others to play\nand we have nice staff members to moderate over the game so that any type of toxicity will not be prohibited\nThis game also includes horror and game-modes soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gorillatrialsprivatepolicy.mystrikingly.com/private-policy", "developer_terms_of_service_url": null, "publisher_name": "ZapoG
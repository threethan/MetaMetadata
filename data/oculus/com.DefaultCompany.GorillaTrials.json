VlWkQ7kNvwFuXoZT&_nc_oc=Adp5FIUBjgGorxKqSvkvOcASlMzezZwuTwBosZy1skbWWSApRnd2HvRVj1b_E8a5xjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBdz1AGKi8wZh69kXDhJk7rRtLiKkc4mA0Sa-uKg8bmw&oe=6AFDC28D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GorillaTrials", "keywords": ["horror", "adventure", "action", "Survival"], "long_description": "Gorilla Trials is a psychological horror VR game that plunges players into the heart of a chilling, abandoned research facility where they must survive terrifying encounters with genetically engineered gorilla hybrids. The game begins as the player wakes up in a sterile, dimly lit room with no recollection of how they arrived. The air is thick with a sense of dread, and as the player steps forward, the realization quickly sinks in: something is horribly wrong in this place.", "short_description": "Welcome to Gorilla-Trials!\nWe provide a nice staff team\na playful and joy able game for others to play\nand we have nice staff members to moderate over the game so that any type of toxicity will not be prohibited\nThis game also includes horror and game-modes soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gorillatrialsprivatepolicy.mystrikingly.com/private-policy", "developer_terms_of_service_url": null, "publisher_name": "ZapoGT", "support_website_url": null, "website_url": "https://gorillatrialsprivatepolicy.mystrikingly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
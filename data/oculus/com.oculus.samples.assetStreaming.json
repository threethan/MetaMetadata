oe=69BBF3A7"}, {"file_name": "ScreenShot3.png", "id": "524877715699300", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572923_524877719032633_510642910985323724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH7xRcnQMWsQ7kNvwH2HsY_&_nc_oc=Adk_b_bNixmZkGZ0St4Qa-dGND7xV8i4i6j2ygxo0mpk2iVvTmdvrTC4WoTUONiCCwg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8xZvXdDjjEXOGp0eD0jF2rsr8jL4wNfwuBWaXapL6Sg&oe=69BBEC8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Asset Streaming for Unity", "keywords": [], "long_description": "Navigate around a large open space where you can observe how we load the different level of details based on the position of the player.\n\nYou can Navigate using 3 modes (Switch using the B button on the remote)\nTeleport: Point your controller and Press A to show the target position\nWalk: Glide around on the ground using the joysticks and the direction of your head\nFree: Move around using the joystick and the direction of your head. In this mode you can fly around.\n\nToggle the Settings menu by pressing Y\nDifferent settings are available for you to see explore the loading system.", "short_description": "Oculus asset streaming showcase demonstrates how we can dynamically load assets in an open world environment using different level of details."}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
Rw1XDau1RvuPYA&oe=69A1A175"}, {"file_name": "ScreenShot2_LODView.png", "id": "306438428133837", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031619_306438431467170_2780197990881695162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn8rhoHEA8MQ7kNvwGnO1jT&_nc_oc=AdkUR8WktIV9zkYVonRAK0mmvWI5mbz24_M1DEUHOi0TIDAcQ1OhLlnW22N98XZiFIo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afua8eMWyX3lkamHOPqpQbLXwT6gWGZ0zEuintiNSIBJzA&oe=69A195A7"}, {"file_name": "ScreenShot3.png", "id": "524877715699300", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57572923_524877719032633_510642910985323724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzC97kfnkAYQ7kNvwECujSO&_nc_oc=Admr6Unm8OdSLi-Lf4aVPUssrsoP3RCekN41tIDA1jSrfFsn3FDYCrJNKoAvVBrZ8IA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuVoLGktb0CDyCcmoFVzBOgrfVcIEkXGkUQE4yhFPrtPw&oe=69A18E8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Asset Streaming for Unity", "keywords": [], "long_description": "Navigate around a large open space where you can observe how we load the different level of details based on the position of the player.\n\nYou can Navigate using 3 modes (Switch using the B button on the remote)\nTeleport: Point your controller and Press A to show the target position\nWalk: Glide around on the ground using the joysticks and the direction of your head\nFree: Move around using the joystick and the direction of your head. In this mode you can fly around.\n\nToggle the Settings menu by pressing Y\nDifferent settings are available for you to see explore the loading system.", "short_description": "Oculus asset streaming showcase demonstrates how we can dynamically load assets in an open world environment using different level of details."}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "p
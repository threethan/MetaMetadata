9031619_306438431467170_2780197990881695162_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akkTIjTa-14Q7kNvwHKagfX&_nc_oc=Ado0pmknI2t3BqlktsZGJOu62ddH88iUE_wTm0EGLSu9ag2bgbvL0lJlQ2oei0r4bVg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUrjCnlk1BIOK5ZD1D_TKJjh57W--JU0O-AP4VO6Dv8Q&oe=6AFB36E7"}, {"file_name": "ScreenShot3.png", "id": "524877715699300", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572923_524877719032633_510642910985323724_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5QsHMO71KgQ7kNvwEqEKDj&_nc_oc=AdpkzGSnHWwegGMxmacM7qMEzDSA0evMs5oy3J9VmlzhDhuoPyUqiaOSs7FcUlHeiIY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYtmVu2qLkdEWOaKr5zTtsWo-jkyZQpk8p71mP6WU_gQ&oe=6AFB2FCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Asset Streaming for Unity", "keywords": [], "long_description": "Navigate around a large open space where you can observe how we load the different level of details based on the position of the player.\n\nYou can Navigate using 3 modes (Switch using the B button on the remote)\nTeleport: Point your controller and Press A to show the target position\nWalk: Glide around on the ground using the joysticks and the direction of your head\nFree: Move around using the joystick and the direction of your head. In this mode you can fly around.\n\nToggle the Settings menu by pressing Y\nDifferent settings are available for you to see explore the loading system.", "short_description": "Oculus asset streaming showcase demonstrates how we can dynamically load assets in an open world environment using different level of details."}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://
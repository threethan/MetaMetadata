9031619_306438431467170_2780197990881695162_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_7hBsl67U0Q7kNvwGXU1ca&_nc_oc=AdrhZ5cuZt4k70byR2emXAZXYIHUGZQGjE0Emp3Ek4YsiB5KqWKy7D6cA4kQ_-lhLmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT44tMgF_OhDoeD5l_TEySFC_8PAoTwhebSI5bN8jNGnA&oe=6B01CE67"}, {"file_name": "ScreenShot3.png", "id": "524877715699300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572923_524877719032633_510642910985323724_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAwMrNihrL0Q7kNvwE5he1p&_nc_oc=AdrRmeO--HBl1feSA4bffsksRUyKRwh53X7Lrspl96r_EDNdsoYLxnTlqBeVdpZhYbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShCykqPETqVkukgzmn7KxRZ1oaksm625yZwM4guGn-6g&oe=6B01C74B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oculus Asset Streaming for Unity", "keywords": [], "long_description": "Navigate around a large open space where you can observe how we load the different level of details based on the position of the player.\n\nYou can Navigate using 3 modes (Switch using the B button on the remote)\nTeleport: Point your controller and Press A to show the target position\nWalk: Glide around on the ground using the joysticks and the direction of your head\nFree: Move around using the joystick and the direction of your head. In this mode you can fly around.\n\nToggle the Settings menu by pressing Y\nDifferent settings are available for you to see explore the loading system.", "short_description": "Oculus asset streaming showcase demonstrates how we can dynamically load assets in an open world environment using different level of details."}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://
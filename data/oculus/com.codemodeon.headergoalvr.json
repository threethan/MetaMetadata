dwdO9ye3MjCfReJtofE7ViDwMHZUDXuuriiQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDzOOYzc6_ZExcjGkf4sVnX5m3fSSGeLxQH35lG-jrbQ&oe=6A859A14"}, {"file_name": "12482260_1151552408262553_1609547455261573120_n[1].png", "id": "765191768012585", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974629_765191771345918_1739664510841846535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS3RYa89HWAQ7kNvwE2PtQi&_nc_oc=Adof6uE1Pj-oVeLRj_0WLN3EpSL48-2uBmvP0znF8lAFiUmN--66PTR-YJ71fJj0Pk4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5fgdLsadxx17PbuC0EMbw_BedZ5G9PLCTBvGhY_YU9w&oe=6A858147"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031308_3328597104028075_6193775273117411495_n[1].png", "id": "586326426208537", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974671_586326429541870_8809032610806279492_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gd1ahDPyuIQ7kNvwFCgZBf&_nc_oc=AdqKikjgmUBNdEZKUHrWa-rjOJXk72tnNKzTh9ivooj9tTDg1gXgi3ni_iSjfqmhVys&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdGWfJk2w31sE4FxJ602quD4xA9wKIh-m7plqy2Qkk_g&oe=6A859E0E"}, "display_name": "Header Goal VR : Being Axel Rix", "keywords": [], "long_description": "Header Goal VR is a physics based, action pumped, virtual reality sports game with a simulation like interaction dynamics. Through its story based levels you find yourself in the place of the character Axel Rix who is a young soccer player. Your main goal is to hit thrown balls by heading while targeting various objects in a soccer training field. Each stage has a unique level design. To achieve a better score, you should have a plan. Even hitting the targets in the right order makes a great difference. You will start feel like Axel within the immersive atmosphere of the game.\n\nBeing able to hit a virtual ball in the most natural and realistic way makes Header Goal VR the most entertaining way of heading a ball.", "short_descrip
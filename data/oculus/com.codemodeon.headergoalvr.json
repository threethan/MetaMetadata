034229463914643456_n[1].png", "id": "593757562311130", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375083_593757565644463_6230111182284871809_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ooz93bxbAYQ7kNvwHvslS2&_nc_oc=Ado0ckg52Zx1rJ0X8gtt1kxqAVxPaxRqTwYAknmxwz_7k1Eh1a0XwR0koY9xemORAFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNKvK7uczXoUk94wQLAJBhYp-u5VFh-Hq5-37laT_E6A&oe=6B0D9CD4"}, {"file_name": "12482260_1151552408262553_1609547455261573120_n[1].png", "id": "765191768012585", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_765191771345918_1739664510841846535_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1YXZnyvIY4Q7kNvwGckueS&_nc_oc=Adq2AxOIzx3VulkTEDRdkAmNWqdP5ClmS0xIO8BLLRAnF_qok-DMJJvN1y6nBUFPsjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSwck42potcwCu0PChBiEUlGSYlLI5iU2dtM6wHR88xA&oe=6B0DBC47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031308_3328597104028075_6193775273117411495_n[1].png", "id": "586326426208537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_586326429541870_8809032610806279492_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhNvHehoYcsQ7kNvwEXvgL4&_nc_oc=Ado7u7u2r3iWCx1V0lLHVK9plg9mPR1U6upd1R_bjaMaTWaJXxGZd2_CX45L9RJ6zDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtiNR4NU5v009UTB9ktVvje_6r1Ykv0asHpqVzzmmk-Q&oe=6B0DA0CE"}, "display_name": "Header Goal VR : Being Axel Rix", "keywords": [], "long_description": "Header Goal VR is a physics based, action pumped, virtual reality sports game with a simulation like interaction dynamics. Through its story based levels you find yourself in the place of the character Axel Rix who is a young soccer player. Your main goal is to hit thrown balls by heading while targeting various objects in a soccer training field. Each stage has a unique level design. To achieve a better score, you should have a plan. Even hitting the targets in the right order makes a great difference. You will start feel like Axel within the immersive atmosphere of the game.\n\nBeing able to hit a virtual ball in the most natural and realistic way makes Header Goal VR the most entertaining way of heading a ball.", "short_description": "Header Goal VR is a physics based, action pumped, virtual reality sports game with a simulation like interaction dynamics. Through its story based levels you find yourself in the place of the character Axel Rix who is a young soccer player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codemodeon.com/legal/privacy.pdf", "developer_terms_of_service_url": "https://codemodeon.com/legal/eula.pdf", "publisher_name": "Codemodeon", "support_website_url": null, "website_url": "https://codemodeon.com/headergoalvr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1092175874721227"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5482547921806985", "version": "1.3"}, "id": "1227390951388027", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
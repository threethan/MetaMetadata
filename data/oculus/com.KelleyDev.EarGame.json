, "display_name": "EarGame", "keywords": [], "long_description": "In EarGame, players step into the role of a clever monkey trapped in a sprawling, high-tech research facility. Guided by curiosity and mischief, the monkey must navigate a maze of sterile labs, advanced security systems, and watchful scientists to find a way out. Each area presents unique challenges: rooms filled with puzzles, complex machinery, and obstacles designed to keep test subjects in check.", "short_description": "In EarGame, players control a curious monkey exploring a high-tech research facility. The monkey must dodge scientists, outwit security systems, and solve puzzles to progress through each room. Using agility and clever interactions with the environment, the monkey climbs, swings, and collects items to unlock secrets and navigate toward escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/eargame-privacy-and-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/eargame-privacy-and-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8544708162244198"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_bina
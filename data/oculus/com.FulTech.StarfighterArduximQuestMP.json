YKc112TU3MqtV_LROxXDeou-Li-1mrFjGVlWjyzMDW9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cJD9WWBBfLf_rCKPfjhMJkOM9XZAnfdnCFhCsCDf7QQ&oe=69FCAE71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pdp8_2560x1440_2021-06-06_11-56-09.png", "id": "2573647642929739", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_2573647646263072_5000227285301093937_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4aGvIR4fg8Q7kNvwHgI9Ei&_nc_oc=Adr_D7ykDvJ0aUrsURAo7aAqqHIBiyN9bzISiCLeJjIWmKWSrndR-kmzESxCcndMYDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4llLP9Dub_WXM_T7jE96qCJ14Ani4JX6lrn8uYwg6DVw&oe=69FCB2F7"}, "display_name": "Starfighter Arduxim Multiplayer", "keywords": [], "long_description": "Strap into the cockpit of your starfighter and take on enemy starships in this first-person tactical space shooter. Fight as part of a team alongside your friends or in free for all battle. Features multiple game modes, ships and weapon load-outs.\n\nControl your ship using Touch controllers, a gamepad, or hand tracking. Players can use the thumb sticks on a physical controller, or for a more immersive experience grab virtual cockpit controls using the Touch controllers or your bare hands.\n\nThe multiplayer of Starfighter Arduxim is free to play and has no micro-transactions or ads.\n\nThe full version available separately includes:\n* A fourteen mission story based campaign covering your first tour of duty on the front lines\n* Practice mode\n* Survival/horde challenge mode with online leader board", "short_description": "Strap into the cockpit of your starfighter and take on enemy starships in this first-person tactical space shooter. Fight as part of a team alongside your friends or in free for all battle. Features multiple game modes, ships and weapon load-outs.\n\nThe multiplayer of Starfighter Arduxim is free to play and has no micro-transactions or ads."}]}, "developer_name": null, "developer_privac
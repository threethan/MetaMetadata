zthrN9Qz7BJ-1aU1vLB4dD-GIAGBQk6OaIYgSs83urEM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJseshG5tsaBOENoQx367zmd7OA5s6HDaKcS7ZLB_iv1g&oe=6AAD5771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pdp8_2560x1440_2021-06-06_11-56-09.png", "id": "2573647642929739", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974750_2573647646263072_5000227285301093937_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvlSpoDJt7UQ7kNvwE9bBa_&_nc_oc=AdptmoiR1HFpGotzhmAm5wZBQKs10hYr3ZaB9DaSUj4cY0OCFOyKHT3hlW9Oz9_QLRc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEkpftZt_1gRj9dJUHGmiJ1ZSnvQP5S8HYCZkeENWOTg&oe=6AAD5BF7"}, "display_name": "Starfighter Arduxim Multiplayer", "keywords": [], "long_description": "Strap into the cockpit of your starfighter and take on enemy starships in this first-person tactical space shooter. Fight as part of a team alongside your friends or in free for all battle. Features multiple game modes, ships and weapon load-outs.\n\nControl your ship using Touch controllers, a gamepad, or hand tracking. Players can use the thumb sticks on a physical controller, or for a more immersive experience grab virtual cockpit controls using the Touch controllers or your bare hands.\n\nThe multiplayer of Starfighter Arduxim is free to play and has no micro-transactions or ads.\n\nThe full version available separately includes:\n* A fourteen mission story based campaign covering your first tour of duty on the front lines\n* Practice mode\n* Survival/horde challenge mode with online leader board", "short_description": "Strap into the cockpit of your starfighter and take on enemy starships in this first-person tactical space shooter. Fight as part of a team alongside your friends or in free for all battle. Features multiple game modes, ships and weapon load-outs.\n\nThe multiplayer of Starfighter Arduxim is free to play and has no micro-transactions or ads."}]}, "developer_name": null, "developer_privac
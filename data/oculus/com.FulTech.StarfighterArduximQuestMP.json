a7rYgIWOHMuLlil_g-dPJaAb_PxQ42aN3lFrB5fSOdFw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BU9A0yCJBo98MQ2o1uRAxDumZS_RVzYESaLUZWPuAHw&oe=69FDFFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pdp8_2560x1440_2021-06-06_11-56-09.png", "id": "2573647642929739", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974750_2573647646263072_5000227285301093937_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4aGvIR4fg8Q7kNvwFSjwwi&_nc_oc=AdogoJvAVtxoVo2FPPUN7gJDGtnQYVAON6jMrCKGvY_U8NQX7DAnAJu0-HBf8ZtbYKo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zC3efS82qDfH8KnM9vjK7u1zfV9kPHuFlO9kJtpfueg&oe=69FE0477"}, "display_name": "Starfighter Arduxim Multiplayer", "keywords": [], "long_description": "Strap into the cockpit of your starfighter and take on enemy starships in this first-person tactical space shooter. Fight as part of a team alongside your friends or in free for all battle. Features multiple game modes, ships and weapon load-outs.\n\nControl your ship using Touch controllers, a gamepad, or hand tracking. Players can use the thumb sticks on a physical controller, or for a more immersive experience grab virtual cockpit controls using the Touch controllers or your bare hands.\n\nThe multiplayer of Starfighter Arduxim is free to play and has no micro-transactions or ads.\n\nThe full version available separately includes:\n* A fourteen mission story based campaign covering your first tour of duty on the front lines\n* Practice mode\n* Survival/horde challenge mode with online leader board", "short_description": "Strap into the cockpit of your starfighter and take on enemy starships in this first-person tactical space shooter. Fight as part of a team alongside your friends or in free for all battle. Features multiple game modes, ships and weapon load-outs.\n\nThe multiplayer of Starfighter Arduxim is free to play and has no micro-transactions or ads."}]}, "developer_name": null, "developer_privac
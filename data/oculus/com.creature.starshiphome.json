5/491820382_1158504925816288_8229125695556863388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT3bFbgSmrIQ7kNvwH_CjKK&_nc_oc=Adr73P5SbodUNvUUPXE0YTQhuplegf_7jHfFMeAk1dSYCCg7aUUpRcPQ9k229DqPF60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRG2OC4GnUan2CJ2t4d1-tKulScbKSXaXFAmlkh1jm7FA&oe=6B0D9F9D"}, {"file_name": "SH-04.png", "id": "1576701023322355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296890_1576701026655688_1120924638905245254_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZkX8S3M_OsQ7kNvwGSKT5W&_nc_oc=AdpsnqnzVJxwCtBrkm0zMHZgp5dkgrsJ2bMECguphtu5jEQtgyMj6vOf9kzhymnW0xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3QdOrUhK5wDfzHrIczAdVfiMggb7jHe_HOmOl6CoDsA&oe=6B0DB6A4"}, {"file_name": "SH-15.png", "id": "849473140776887", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303679_849473144110220_4339547579413768152_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBsG0DWf6gQQ7kNvwFjshYJ&_nc_oc=AdphchPgui7Mt34dtSeZQUKI_sXxKBreqG98YPMjXxAARPySOO_0xgX23v5oBoSi9pQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_QfqYziCaqdVHmZwzswHl0CsU0ngdC68E543T44gfGg&oe=6B0D9BEE"}, {"file_name": "SH-03.png", "id": "848357921225574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821193_848357924558907_5155037107089552375_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThzJgo2ztewQ7kNvwGW7jzI&_nc_oc=AdpC1Dvx41dCtg3dr5s8AWiA2ldl8Rq46h1znUqiWeth2FBw4BO_XMP2ZUEf1r1JwtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWtAKP0SlIs1MJFG9tes8FRXpchngMSJ-AhtmbMk77Cw&oe=6B0DBAC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Starship_CoverLandscape_2560x1440.png", "id": "1044437277419030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974456_1044437280752363_887301320170438020_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuH-LYmvntcQ7kNvwE80EHe&_nc_oc=AdpVybsXxVLdql5kK651skvHRraZK-0qEvurM-FSe_zVwI6AqNjFdsKP41QP1BXTe1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyO0H_PwBCdqJ-eqjPqN4PGMzntu_7guYAu_OpvPjZLA&oe=6B0D9E71"}, "display_name": "Starship Home", "keywords": ["cozy", "mixedreality", "adventure", "scifi", "plants"], "long_description": "\n**Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe.**\n\nTurn your home into a starship bound for adventure as you take flight in a brand new kind of mixed reality experience where the room you play in comes along on the adventure with you. \n{1568971607606576}\n\ud83d\ude80 Customize your starship to fit whatever room you want to play in. \n\n\ud83e\ude90 Travel to new planets and explore the surface with your lander.\n\n\ud83c\udf31 Help your plants grow by taking a ride into their dreams and see new worlds through their eyes.\n\nThese special plants need your help to restore balance to their universe!\n\n\n{1754750748392606}\n**We'll need your help to operate the starship!**\n{1550510362506032}\n**Every plant has its own personality and needs.**\n{7885685051560381}\n**Whoa! WHERE AM I?!**\n", "short_description": "Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe. Traverse the galaxy in a starship bound for adventure! Prepare your room for lift off as you depart on a cozy interplanetary expedition to collect, nurture, and befriend alien plants from around the galaxy. Immerse yourself in the mystery of an interstellar crisis from the comfort of your own home."}]}, "developer_name": "Creature", "developer_privacy_policy_url": "https://www.creature.page/privacy", "developer_terms_of_service_url": null, "publisher_name": "Creature", "support_website_url": null, "website_url": "https://www.creature.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
5/491820382_1158504925816288_8229125695556863388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjxjTiKf7twQ7kNvwFFUTrl&_nc_oc=Adrc9AqYv7H0-87SN8EqAO_OJGOnD6Iw4ojowUov9zb8Uik1g9CNi75cjwFVqIs8p1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0w1-19TqjYVj2DjT99SVXq3gCsRtXL8TVXG2TjDRTsw&oe=6B0C4E1D"}, {"file_name": "SH-04.png", "id": "1576701023322355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296890_1576701026655688_1120924638905245254_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r99Ss4VTvSUQ7kNvwEFlCYT&_nc_oc=AdpycjXY9uvWxUHacQ9_x-tp62E_IT3z88eYuoK5YUHFfmscwQDVR124Y9yv5wf_Mz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4OXhS9u34Xt9myr3exENQ9Mjc9gGKenZiiTFZYDOn4w&oe=6B0C6524"}, {"file_name": "SH-15.png", "id": "849473140776887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303679_849473144110220_4339547579413768152_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBsG0DWf6gQQ7kNvwGg5H-y&_nc_oc=Adovtb09L3lVChsQu3QPG1Zmn1iBK7H2bbQeaKr5g1p_2Pna30Gvwj5PUqNNANFXxNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBULlsqDIbQNorL31uLiZCjgMIgAg4QVq-23plfIxTSg&oe=6B0C82AE"}, {"file_name": "SH-03.png", "id": "848357921225574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821193_848357924558907_5155037107089552375_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3IRX33JNb0Q7kNvwF_YIy3&_nc_oc=AdoVhAjVQBr7colRpxKPxObUW2-a-bLmeoTekd7oUmGW0xjfTfA5YMlhhMrfgpWervs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTsPlH9tSdZVdbd7bx3kFbO8wcPRelsnR5UszAzZcfWTA&oe=6B0C6942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Starship_CoverLandscape_2560x1440.png", "id": "1044437277419030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_1044437280752363_887301320170438020_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXlt44FUVRAQ7kNvwGANvK2&_nc_oc=AdqcFWEguNGxH2q4GHInbE7NDzY3kXDjiMZoJbGiwYbWS0hOwH1MRe5YqcAt8DoN2Hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGoceyW4VvE8rvlAsfawpvqHfI0TedzOgmcz8DVL048g&oe=6B0C4CF1"}, "display_name": "Starship Home", "keywords": ["cozy", "mixedreality", "adventure", "scifi", "plants"], "long_description": "\n**Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe.**\n\nTurn your home into a starship bound for adventure as you take flight in a brand new kind of mixed reality experience where the room you play in comes along on the adventure with you. \n{1568971607606576}\n\ud83d\ude80 Customize your starship to fit whatever room you want to play in. \n\n\ud83e\ude90 Travel to new planets and explore the surface with your lander.\n\n\ud83c\udf31 Help your plants grow by taking a ride into their dreams and see new worlds through their eyes.\n\nThese special plants need your help to restore balance to their universe!\n\n\n{1754750748392606}\n**We'll need your help to operate the starship!**\n{1550510362506032}\n**Every plant has its own personality and needs.**\n{7885685051560381}\n**Whoa! WHERE AM I?!**\n", "short_description": "Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe. Traverse the galaxy in a starship bound for adventure! Prepare your room for lift off as you depart on a cozy interplanetary expedition to collect, nurture, and befriend alien plants from around the galaxy. Immerse yourself in the mystery of an interstellar crisis from the comfort of your own home."}]}, "developer_name": "Creature", "developer_privacy_policy_url": "https://www.creature.page/privacy", "developer_terms_of_service_url": null, "publisher_name": "Creature", "support_website_url": null, "website_url": "https://www.creature.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
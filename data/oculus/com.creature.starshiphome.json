5/491820382_1158504925816288_8229125695556863388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47r5gEzeNioQ7kNvwHJV-qu&_nc_oc=Adp0oclAp75fBG8Y8ACDGMZvuta8Zm29Cp3CiS5GyFuxZwJM-IiaQE3RHIS7wSoZTuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJIJDwO3zRKb6Sv1Ub8M3NEo-azbVEDa8ylgk0VZLHpg&oe=6AFDCD9D"}, {"file_name": "SH-04.png", "id": "1576701023322355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296890_1576701026655688_1120924638905245254_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZ45n5SoPtUQ7kNvwE5GUEk&_nc_oc=AdrteT9F2NbEG-CHmAKLKvZpJG5hnpKNqdS4Fx-gBkQqDv4BIrGB79l3MuL3qqXAcFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIU4aebohKHmHQaZHVGOFEaR_wm7UwO71cHZ8sfcd8cA&oe=6AFDE4A4"}, {"file_name": "SH-15.png", "id": "849473140776887", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303679_849473144110220_4339547579413768152_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUQ7TkWK2EQQ7kNvwE8UCbX&_nc_oc=Ado3JnQu_EwriN7f-_rXT-KukqLKI-WOTjI4QDsh7sRbAWaSQckl8-NnX-Z9XQB2QRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjwVXGFzkVxwnV0di5aqC7hnGVj6g0ZZvTW4Wcsgb3BA&oe=6AFDC9EE"}, {"file_name": "SH-03.png", "id": "848357921225574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821193_848357924558907_5155037107089552375_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfKRo0DUIEwQ7kNvwHYUfow&_nc_oc=AdoDYjL34iahDbDgj0MPFrjeRnaSaHrQy2EXrUo_jZSSeCoV8PIZzqtWQnRhT77r5GU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTln2f8ZiF--oslMePhfV7sfQqymCTnjoREaJyVLJ_jyg&oe=6AFDB082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Starship_CoverLandscape_2560x1440.png", "id": "1044437277419030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974456_1044437280752363_887301320170438020_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmB6gtbyRIUQ7kNvwFFkNta&_nc_oc=AdqbGl2ES6j0sAVKEsLhvOYetd9CvcppDkH65t2Rl41cw9nuHKuaQgDH0e-iqdJjQQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaG1IQdl-8iiXznRxZ9Kk9bAFcPpi2vgVyneS8olSLVw&oe=6AFDCC71"}, "display_name": "Starship Home", "keywords": ["cozy", "mixedreality", "adventure", "scifi", "plants"], "long_description": "\n**Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe.**\n\nTurn your home into a starship bound for adventure as you take flight in a brand new kind of mixed reality experience where the room you play in comes along on the adventure with you. \n{1568971607606576}\n\ud83d\ude80 Customize your starship to fit whatever room you want to play in. \n\n\ud83e\ude90 Travel to new planets and explore the surface with your lander.\n\n\ud83c\udf31 Help your plants grow by taking a ride into their dreams and see new worlds through their eyes.\n\nThese special plants need your help to restore balance to their universe!\n\n\n{1754750748392606}\n**We'll need your help to operate the starship!**\n{1550510362506032}\n**Every plant has its own personality and needs.**\n{7885685051560381}\n**Whoa! WHERE AM I?!**\n", "short_description": "Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe. Traverse the galaxy in a starship bound for adventure! Prepare your room for lift off as you depart on a cozy interplanetary expedition to collect, nurture, and befriend alien plants from around the galaxy. Immerse yourself in the mystery of an interstellar crisis from the comfort of your own home."}]}, "developer_name": "Creature", "developer_privacy_policy_url": "https://www.creature.page/privacy", "developer_terms_of_service_url": null, "publisher_name": "Creature", "support_website_url": null, "website_url": "https://www.creature.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
5/491820382_1158504925816288_8229125695556863388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT3bFbgSmrIQ7kNvwFJcSmE&_nc_oc=AdqgANWaRbDOfcpow-km5GBOYtr29TBXquN1zd_IDeQUbdjcFWpEOmfF4btzz03E214&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUj3hxIvmkH1qVSNasONtXTOZLbOv-6wL9VkGP6cWpg-Q&oe=6B10429D"}, {"file_name": "SH-04.png", "id": "1576701023322355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296890_1576701026655688_1120924638905245254_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZkX8S3M_OsQ7kNvwH-27ey&_nc_oc=Adoany0L7-ZrCTmhqQFgAQmX3NeNRLpFYA4o5b-S2b36eCq_KM-n1nQzlkrXg6yX1pk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVRwWFO2QwAhiwkfPklx3Yzz5jSzaTYEDvwqVx1p9JZ5A&oe=6B1059A4"}, {"file_name": "SH-15.png", "id": "849473140776887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303679_849473144110220_4339547579413768152_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4YWmWLuHDUQ7kNvwFzM_88&_nc_oc=AdoQ5kJi9jlWp3VWzcV7RlBT2_-9zgWI83cZCD1zKXLVOWv_GlxqCxlJZmExDGgIMMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1fhdzshld_MRHTPOv1ziT9d7-bqQ1eZOUK9nK4spf1A&oe=6B103EEE"}, {"file_name": "SH-03.png", "id": "848357921225574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821193_848357924558907_5155037107089552375_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThzJgo2ztewQ7kNvwG71lv3&_nc_oc=AdrvxYWtpkcAj7owJBYFqQ-uCGArQIG3-soJTRHazzqd_X5YxfE8miw_QRaL2OhhIdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXMDYPGLTRcp9lnngspw9jRXwFf6FwwRaiH2Ue8YkhxDg&oe=6B105DC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Starship_CoverLandscape_2560x1440.png", "id": "1044437277419030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_1044437280752363_887301320170438020_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuH-LYmvntcQ7kNvwFcSj7L&_nc_oc=Adphfswnw1WK_pV-c3gYxERnWdgiuanOShp6uJHr3PVTUNK9fJT3PD60r3AhaVhHhEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUmSVpo_y2CveeNKgAoCmvGLTbCqLnZZOUCNusFDommTw&oe=6B104171"}, "display_name": "Starship Home", "keywords": ["cozy", "mixedreality", "adventure", "scifi", "plants"], "long_description": "\n**Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe.**\n\nTurn your home into a starship bound for adventure as you take flight in a brand new kind of mixed reality experience where the room you play in comes along on the adventure with you. \n{1568971607606576}\n\ud83d\ude80 Customize your starship to fit whatever room you want to play in. \n\n\ud83e\ude90 Travel to new planets and explore the surface with your lander.\n\n\ud83c\udf31 Help your plants grow by taking a ride into their dreams and see new worlds through their eyes.\n\nThese special plants need your help to restore balance to their universe!\n\n\n{1754750748392606}\n**We'll need your help to operate the starship!**\n{1550510362506032}\n**Every plant has its own personality and needs.**\n{7885685051560381}\n**Whoa! WHERE AM I?!**\n", "short_description": "Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe. Traverse the galaxy in a starship bound for adventure! Prepare your room for lift off as you depart on a cozy interplanetary expedition to collect, nurture, and befriend alien plants from around the galaxy. Immerse yourself in the mystery of an interstellar crisis from the comfort of your own home."}]}, "developer_name": "Creature", "developer_privacy_policy_url": "https://www.creature.page/privacy", "developer_terms_of_service_url": null, "publisher_name": "Creature", "support_website_url": null, "website_url": "https://www.creature.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
5/491820382_1158504925816288_8229125695556863388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odPoBy-ziEYQ7kNvwEzWCRl&_nc_oc=AdrtUbGnmd6ZhfH2_RZdIPnD-1MQ_g0FEBwiXVWvvoDJc2VA9WIV5xCu1pdRqkAOmow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1cdD1cxXwnuohySIA2COA1Jh-WlgGZqhsACY0d0ghtQ&oe=6B07081D"}, {"file_name": "SH-04.png", "id": "1576701023322355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296890_1576701026655688_1120924638905245254_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9I6xbxdT0ZkQ7kNvwER_eMB&_nc_oc=AdpH72aKt9AUrQ08RZC4IdaboJyllCKN4lXkIDeKpkEZIRHUhutJz5s2ZRrlDwZtKB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrEmgtK8hXgq9XiZfVnhj9d4VYeBnJZrq0HwlhohGu2A&oe=6B071F24"}, {"file_name": "SH-15.png", "id": "849473140776887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303679_849473144110220_4339547579413768152_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6waE1dtsqC4Q7kNvwEA4CuK&_nc_oc=AdooJ7o4uOIp2UuRz7eSq28t7dduQ-NckBOUTtSJuNII2qVBWnhAATv8keMAE-fks_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8wd8g-ODe40_5RoEwK3-IQz0UKgOBMGt69W9qLHBtsQ&oe=6B07046E"}, {"file_name": "SH-03.png", "id": "848357921225574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821193_848357924558907_5155037107089552375_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4h5UQMpGIIQ7kNvwEf-BJ1&_nc_oc=AdodNv4TwkdE7oLOOPZGk5_xQPIhAbubHNOuRg9GbfIb5C4YZf5atKRnQCevZ5GsKbA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn1Z4O_90g8H6VmUMv9jUpUaGSQd7UeiLjZyM9lOaFWw&oe=6B072342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Starship_CoverLandscape_2560x1440.png", "id": "1044437277419030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_1044437280752363_887301320170438020_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvalMtj8N38Q7kNvwHhrywT&_nc_oc=AdpnwKdcKr-inf1bSYk7OgiJQRHnouchUVpEq2a05Bg_6tFPBbZeqrTOs9UaDTlKPV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSimu7qcgXomUDUzaUQg0LbA94_99gixVekISzNZ_Tk0w&oe=6B0706F1"}, "display_name": "Starship Home", "keywords": ["cozy", "mixedreality", "adventure", "scifi", "plants"], "long_description": "\n**Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe.**\n\nTurn your home into a starship bound for adventure as you take flight in a brand new kind of mixed reality experience where the room you play in comes along on the adventure with you. \n{1568971607606576}\n\ud83d\ude80 Customize your starship to fit whatever room you want to play in. \n\n\ud83e\ude90 Travel to new planets and explore the surface with your lander.\n\n\ud83c\udf31 Help your plants grow by taking a ride into their dreams and see new worlds through their eyes.\n\nThese special plants need your help to restore balance to their universe!\n\n\n{1754750748392606}\n**We'll need your help to operate the starship!**\n{1550510362506032}\n**Every plant has its own personality and needs.**\n{7885685051560381}\n**Whoa! WHERE AM I?!**\n", "short_description": "Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe. Traverse the galaxy in a starship bound for adventure! Prepare your room for lift off as you depart on a cozy interplanetary expedition to collect, nurture, and befriend alien plants from around the galaxy. Immerse yourself in the mystery of an interstellar crisis from the comfort of your own home."}]}, "developer_name": "Creature", "developer_privacy_policy_url": "https://www.creature.page/privacy", "developer_terms_of_service_url": null, "publisher_name": "Creature", "support_website_url": null, "website_url": "https://www.creature.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
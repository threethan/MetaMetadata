5/491820382_1158504925816288_8229125695556863388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtJbVgW1j4sQ7kNvwHOqF2w&_nc_oc=AdqcvnxqoI7G6WrYkdBN4bU83fAZPvyz3BShnx4jKdMlXXsD28jc9YI7fS49L2eXd7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrFJxjnPYWpThA359p5kUhgaKhlrqsQd07enGscxYcpA&oe=6B03139D"}, {"file_name": "SH-04.png", "id": "1576701023322355", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296890_1576701026655688_1120924638905245254_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnsh9vB9vCoQ7kNvwEG2tc6&_nc_oc=Adr_hQ1xcD2Wha2yG7VYfrE6tq24wVJNk6y33ZY1KB9deQYJ-D9snujBE7RtR_qPT7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk2vy-ar-bfJbz6g6nfftpoA7Ndm9D7F88AhCNOd4BaA&oe=6B032AA4"}, {"file_name": "SH-15.png", "id": "849473140776887", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303679_849473144110220_4339547579413768152_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRjV3Ht-6OkQ7kNvwEPJJap&_nc_oc=Adr6YEVoWU5mpIQIIsvw1BUO8-MyGb3ize_6LwrMZUUSLgrDMYRZ5zWpPrXLBlz-CSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCxXVN_S5ZQ5GKRwSTVTU04SVTsgRpISglGmjQzRbqAg&oe=6B030FEE"}, {"file_name": "SH-03.png", "id": "848357921225574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821193_848357924558907_5155037107089552375_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHDy8ONkV4UQ7kNvwGLeIvw&_nc_oc=AdpFmnV2ckUx8QpgevuKm95KJbTAX7gGS0gpngAiG8L5fyAvBbDOvVUHEX6o7NrqaIM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxfke0W_lMAy5jkkTodDXH8mcS7zmKZXaZkIpCBZcUbQ&oe=6B032EC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Starship_CoverLandscape_2560x1440.png", "id": "1044437277419030", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974456_1044437280752363_887301320170438020_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRog2f3ajscQ7kNvwHnonus&_nc_oc=Adr0Ljej7iqo0ZeaSsi34DxabU4JaQJKp7DmMMJif0bu4FmI3UjNLFGkJSha5siWfKU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStH7zqxAUaTg49FIrrytDIvXZNgsdnZowilJ5x03s-vw&oe=6B031271"}, "display_name": "Starship Home", "keywords": ["cozy", "mixedreality", "adventure", "scifi", "plants"], "long_description": "\n**Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe.**\n\nTurn your home into a starship bound for adventure as you take flight in a brand new kind of mixed reality experience where the room you play in comes along on the adventure with you. \n{1568971607606576}\n\ud83d\ude80 Customize your starship to fit whatever room you want to play in. \n\n\ud83e\ude90 Travel to new planets and explore the surface with your lander.\n\n\ud83c\udf31 Help your plants grow by taking a ride into their dreams and see new worlds through their eyes.\n\nThese special plants need your help to restore balance to their universe!\n\n\n{1754750748392606}\n**We'll need your help to operate the starship!**\n{1550510362506032}\n**Every plant has its own personality and needs.**\n{7885685051560381}\n**Whoa! WHERE AM I?!**\n", "short_description": "Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe. Traverse the galaxy in a starship bound for adventure! Prepare your room for lift off as you depart on a cozy interplanetary expedition to collect, nurture, and befriend alien plants from around the galaxy. Immerse yourself in the mystery of an interstellar crisis from the comfort of your own home."}]}, "developer_name": "Creature", "developer_privacy_policy_url": "https://www.creature.page/privacy", "developer_terms_of_service_url": null, "publisher_name": "Creature", "support_website_url": null, "website_url": "https://www.creature.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
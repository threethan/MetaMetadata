5/491820382_1158504925816288_8229125695556863388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjxjTiKf7twQ7kNvwFa3B8i&_nc_oc=Adpf8YgMq9HLqG0H6uAA8r6h9opCUkgJWu0LiGkg3UibNIhIyJe4ya0ly2sMPbizbzE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWGyEqUKue4OngVrGlmFCrAegIDM6dQUr_A5BskoMVsA&oe=6B0B34DD"}, {"file_name": "SH-04.png", "id": "1576701023322355", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296890_1576701026655688_1120924638905245254_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r99Ss4VTvSUQ7kNvwHzAwit&_nc_oc=AdrSIftuwseVOrPdwJzXh31oDcJWMsaQp62M3Cchc4jtP18NApUbg90qom3mJfj1JzU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSAQi28kC51boUOCuPxvnMPNQoC6jZ492PhJZmXzW6RRg&oe=6B0B13A4"}, {"file_name": "SH-15.png", "id": "849473140776887", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303679_849473144110220_4339547579413768152_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBsG0DWf6gQQ7kNvwGUbMDN&_nc_oc=Ado84z2Ca98OJetxmmm6ZEeeEyqGNtrZfckRYm2sDjX2L9PaqyPJbT7AleuddG6QpTc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1BDY0uWZW--WQN651G4vzm-FDRCLacP-qo-B4_2MZIg&oe=6B0B312E"}, {"file_name": "SH-03.png", "id": "848357921225574", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821193_848357924558907_5155037107089552375_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3IRX33JNb0Q7kNvwGmqBJt&_nc_oc=AdrxI6G0rbTlPu642_RiPYbJC5hIIzjTldHRFNcnYig9a3dlT_84k9Jl5uPT-KIFL9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3GKxEStzIpk-xSJDCMHDOm-DY-NKCH5JQuXOm2Ow-RA&oe=6B0B17C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Starship_CoverLandscape_2560x1440.png", "id": "1044437277419030", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974456_1044437280752363_887301320170438020_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXlt44FUVRAQ7kNvwGOZ0O9&_nc_oc=Adr-_DzblwWmi4IZ5CFaqtGUwn01PBUtzAvcJmgwMDfu_YSEJ1gUyjeDhw9sUhmk9Rw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQV2bT0_kwL7ceq0SHCzc-xHsQ_plUBvj4FfxP46cwX3w&oe=6B0B33B1"}, "display_name": "Starship Home", "keywords": ["cozy", "mixedreality", "adventure", "scifi", "plants"], "long_description": "\n**Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe.**\n\nTurn your home into a starship bound for adventure as you take flight in a brand new kind of mixed reality experience where the room you play in comes along on the adventure with you. \n{1568971607606576}\n\ud83d\ude80 Customize your starship to fit whatever room you want to play in. \n\n\ud83e\ude90 Travel to new planets and explore the surface with your lander.\n\n\ud83c\udf31 Help your plants grow by taking a ride into their dreams and see new worlds through their eyes.\n\nThese special plants need your help to restore balance to their universe!\n\n\n{1754750748392606}\n**We'll need your help to operate the starship!**\n{1550510362506032}\n**Every plant has its own personality and needs.**\n{7885685051560381}\n**Whoa! WHERE AM I?!**\n", "short_description": "Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe. Traverse the galaxy in a starship bound for adventure! Prepare your room for lift off as you depart on a cozy interplanetary expedition to collect, nurture, and befriend alien plants from around the galaxy. Immerse yourself in the mystery of an interstellar crisis from the comfort of your own home."}]}, "developer_name": "Creature", "developer_privacy_policy_url": "https://www.creature.page/privacy", "developer_terms_of_service_url": null, "publisher_name": "Creature", "support_website_url": null, "website_url": "https://www.creature.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
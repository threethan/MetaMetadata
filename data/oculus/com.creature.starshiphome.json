5/491820382_1158504925816288_8229125695556863388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47r5gEzeNioQ7kNvwFJoqh3&_nc_oc=AdomZ0mfLEz-J_1ar78szNw1uhyJ8x52CY5lMDkpp2pvgnHAX4ziRH5cu91nCotce5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvOXjy1-zmhJAZUpuwfAMLU1I7NxcwH1Hyp_E1rnxRwA&oe=6B00709D"}, {"file_name": "SH-04.png", "id": "1576701023322355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296890_1576701026655688_1120924638905245254_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JAX09PBhjsQ7kNvwFbXVA2&_nc_oc=AdpnwK07fRsbv44SwXbGccji8yUv85qrW07U7mP2OEmm8inSH1WxNqsu7AcxalOysIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSik1phbjO1tJh4nddMhCCK5S3K6XvNNpkM8NyPgvXlhA&oe=6B0087A4"}, {"file_name": "SH-15.png", "id": "849473140776887", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303679_849473144110220_4339547579413768152_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DI7ot3kmoF8Q7kNvwECFR6x&_nc_oc=AdozRNu0Xqh9GQSw0_FQrYEshzDxbVxiloFJ9U4i8lsCJ2Aj-o92CKGZCoN7szsv_Ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJYz1tN69vDQgUA3OGvyhGD_bJ8IpktOrzGZaSXxWs9w&oe=6B006CEE"}, {"file_name": "SH-03.png", "id": "848357921225574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821193_848357924558907_5155037107089552375_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfKRo0DUIEwQ7kNvwF1MgSs&_nc_oc=AdpAx-G2203rp0jE33Z8LVqhGAjUbC_rNSlQO9JaPQ2F56MOUhwUKhSYRo8g0Ygu9u8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYmKGgdQX4vtNcQsFvKwvWNL0GY9EqL4V9hN3qqWDi3w&oe=6B005382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Starship_CoverLandscape_2560x1440.png", "id": "1044437277419030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_1044437280752363_887301320170438020_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmB6gtbyRIUQ7kNvwEH8bWu&_nc_oc=Adrn_7P-zrGqdJHGco_mfPqaFskpKPeOFa_1rTO5eIMKsWjUKlvSBhGxeTJpRXr0NQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkx0WQB5CqTRWnE81RAp3tqf775jVbpXh_ayB9DyfgxA&oe=6B006F71"}, "display_name": "Starship Home", "keywords": ["cozy", "mixedreality", "adventure", "scifi", "plants"], "long_description": "\n**Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe.**\n\nTurn your home into a starship bound for adventure as you take flight in a brand new kind of mixed reality experience where the room you play in comes along on the adventure with you. \n{1568971607606576}\n\ud83d\ude80 Customize your starship to fit whatever room you want to play in. \n\n\ud83e\ude90 Travel to new planets and explore the surface with your lander.\n\n\ud83c\udf31 Help your plants grow by taking a ride into their dreams and see new worlds through their eyes.\n\nThese special plants need your help to restore balance to their universe!\n\n\n{1754750748392606}\n**We'll need your help to operate the starship!**\n{1550510362506032}\n**Every plant has its own personality and needs.**\n{7885685051560381}\n**Whoa! WHERE AM I?!**\n", "short_description": "Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe. Traverse the galaxy in a starship bound for adventure! Prepare your room for lift off as you depart on a cozy interplanetary expedition to collect, nurture, and befriend alien plants from around the galaxy. Immerse yourself in the mystery of an interstellar crisis from the comfort of your own home."}]}, "developer_name": "Creature", "developer_privacy_policy_url": "https://www.creature.page/privacy", "developer_terms_of_service_url": null, "publisher_name": "Creature", "support_website_url": null, "website_url": "https://www.creature.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
5/491820382_1158504925816288_8229125695556863388_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4MAn26NYZAQ7kNvwHWMArm&_nc_oc=Adqw3PpgLbJrWEbuwITDLSo0gPwHEhad-Sl8d_XajUmlkufX2OtklHDK12QcL15mntg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcIMy8z1U2W8LUwNzhpHLrepLODW5mlTTf4YBukRUs4g&oe=6AFC7C1D"}, {"file_name": "SH-04.png", "id": "1576701023322355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296890_1576701026655688_1120924638905245254_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZ45n5SoPtUQ7kNvwGzIEhH&_nc_oc=AdraF4-uJL4CEQFGG41TzNsUbGU001QbNfKbNhFBQV59Kw5yXLNHyxP2OUCYgo8s5WI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr28a9xQkhAjKfcGbvtlYbxuvaEWD_uNWmIi4qGbNpvg&oe=6AFC9324"}, {"file_name": "SH-15.png", "id": "849473140776887", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499303679_849473144110220_4339547579413768152_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUQ7TkWK2EQQ7kNvwGANmvC&_nc_oc=AdrqQHq282SVXrk-SVjSoS8Xr1f4Mc3fG4_8YwjJjP2PEuWW3QX4731rAbkO5ZxyIrc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRewjdYOf7Q1iAhQX90GW3hYYU8WJOYTNZKefBuEN-hAA&oe=6AFC786E"}, {"file_name": "SH-03.png", "id": "848357921225574", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821193_848357924558907_5155037107089552375_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsMJIONIvfYQ7kNvwGEEcGB&_nc_oc=AdoLTCee_t0aOwggGN2dCdY73NmcZIhFEQTtuLzr1F14FklLhn2-quw41g5Ap5BHWgc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRme0GEgUGHtONrzF6Gq2kwzieWaf_K0GDleG6Vpj5-kA&oe=6AFC5F02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Starship_CoverLandscape_2560x1440.png", "id": "1044437277419030", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974456_1044437280752363_887301320170438020_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlKm1GgzEhIQ7kNvwHh53xY&_nc_oc=Adrh9QovU2RF9Kbjjhi5JcuGHvK4_UjSnf8HmQ-rjhUQnsEeZuwYMDCixyXjsN4jisI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTCGatScj_uGa6iE4rdo_eTr6sA-x1eMcRSp0r5TyewA&oe=6AFC7AF1"}, "display_name": "Starship Home", "keywords": ["cozy", "mixedreality", "adventure", "scifi", "plants"], "long_description": "\n**Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe.**\n\nTurn your home into a starship bound for adventure as you take flight in a brand new kind of mixed reality experience where the room you play in comes along on the adventure with you. \n{1568971607606576}\n\ud83d\ude80 Customize your starship to fit whatever room you want to play in. \n\n\ud83e\ude90 Travel to new planets and explore the surface with your lander.\n\n\ud83c\udf31 Help your plants grow by taking a ride into their dreams and see new worlds through their eyes.\n\nThese special plants need your help to restore balance to their universe!\n\n\n{1754750748392606}\n**We'll need your help to operate the starship!**\n{1550510362506032}\n**Every plant has its own personality and needs.**\n{7885685051560381}\n**Whoa! WHERE AM I?!**\n", "short_description": "Travel the stars. Care for alien plants. Uncover the mysteries hidden deep at the center of the universe. Traverse the galaxy in a starship bound for adventure! Prepare your room for lift off as you depart on a cozy interplanetary expedition to collect, nurture, and befriend alien plants from around the galaxy. Immerse yourself in the mystery of an interstellar crisis from the comfort of your own home."}]}, "developer_name": "Creature", "developer_privacy_policy_url": "https://www.creature.page/privacy", "developer_terms_of_service_url": null, "publisher_name": "Creature", "support_website_url": null, "website_url": "https://www.creature.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
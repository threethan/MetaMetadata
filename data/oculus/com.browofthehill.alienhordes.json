wofthehill.co.uk/privacy-policy-ah", "developer_terms_of_service_url": null, "publisher_name": "Brow Of The Hill", "support_website_url": null, "website_url": "https://www.browofthehill.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26708585522102653"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1679001016469807"}, {"status": "PUBLISHED", "id": "27132519049733138"}]}, "baseline_offer": {"id": "27132519049733138"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782752400, "status": "PUBLISHED", "id": "27132519049733138"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27903589145935612", "version": "1.0.5"}, "id": "994883793001871", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26708585488769323", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27903589145935612"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "994883793001871"}]}, "change_log": "Updated art and campaign control room."
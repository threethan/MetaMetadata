0623R6AHbkM3FGuX_yCPaqHfJQ0i8q7uii7ps6ExC4HBB5X5YD8bjORSqp1Mg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMhzY9070GdKLGL9oUsk1vuhe2bE5a86zuRwIIaK0yfQ&oe=6AFDC486"}, "display_name": "Alien Hordes", "keywords": ["shooter", "aliens", "scifi"], "long_description": "A space marine stationed on the moon in a secret weapons testing crater receives a message that all Earth's defences have been disabled by a mysterious force. All contact is lost. Then the battleships of an alien race emerge from jump points over the horizon. He suddenly realises he is the only one who can stop the devastation that's on it's way to Earth.\n\n**Battle endless alien ships and creatures in this epic shooter from Brow Of The Hill.**\n\n**Test your battle skills in Arcade Mode and get yourself on the international Leaderboard of best fighters.**\n\n**Multiple new weapons and ammo drops throughout the game.**\n\n**New Campaign Mode Now Available with 19 missions plus teaser!**\n\nThe Draxx are coming! Only you can stop them.\n", "short_description": "A space marine stationed on the moon at a secret weapons testing base is the only one who stands between Earth and an alien invasion. Can you stop the Alien Hordes before they reach Earth ?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.browofthehill.co.uk/privacy-policy-ah", "developer_terms_of_service_url": null, "publisher_name": "Brow Of The Hill", "support_website_url": null, "website_url": "https://www.browofthehill.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_me
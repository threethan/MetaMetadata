tz7kjRzzCyHf4KEXJx0VQ9fquM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7hVzjQLAdPMD-Cd7WUSX9uEBTsvcY7B6hM_ohcSCtgw&oe=6A492973"}, {"file_name": "Screenshot_1.png", "id": "1932811260631650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1932811263964983_8227803877075376935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaEsQ0Gu_zgQ7kNvwFAMJwR&_nc_oc=AdoczMPugqVKp-IUb-dnw2SVAdxrhzKy_nDCnZYZ6DejpANTZWMYz3RmI8C30jH6ASI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVf7r2vaIVL3GI3uGu0fSa5JMIK6t3sWfgL5CfPaKy1A&oe=6A490EC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2k_banner.png", "id": "654563050924539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_654563054257872_440537785091841093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3X_rfZ4t1kQ7kNvwHncQHK&_nc_oc=AdpqTEnJqm84cI9RL9-QOgL90qX2e5cZFUD8NnOSdSA4kshUY0Y059lJbFNsvaO4ZyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3L-TsyHA9ysEx5sI1gPtCcQGhzi9_5lqVqyA9gPuyaA&oe=6A490FB0"}, "display_name": "Vaultline Rush", "keywords": ["parkour", "freerun", "physics", "scifi", "climb"], "long_description": "\n# SPEEDRUN TRIALS\nVaultline Rush is a high-speed sci-fi parkour experience built for players who crave momentum, precision, and full-body freedom. Jump, Climb and Vault your way across a series of dynamic Trials designed to push your speed and skill to the limit.\n\n{1467854205022339}\n\n# UNPRECEDENTED FREEDOM OF MOVEMENT\nCarefully designed challenges will push you to your limits. \n\n{1035697859115778}\n\n# PHYSICS YOU CAN TRUST\nPhysics-driven movement with high-fidelity Fullbody IK. Every jump, catch, and vault feels precise and realistic.\n\n{1285823750423762}\n\n{1392548829299460}\n\n{1697901144996751}\n\n# PREDICTIVE VAULT SYSTEM\nVAULTLINE RUSH introduces a breakthrough in physics climbing by utilizing complex systems that manage the legs of the player, resulting in effortless vaulting.\n{836522232404611}\n\n\n", "short_description": "Experience high-speed sci-fi parkour in Vaultline Rush. Run, jump, and vault through physics-based Trials using a full-body avatar that delivers unmatched immersion and fluid movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/vaultlinerush/vaultlinerush-website/refs/heads/main/VaultlineRush%20Privacy%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "QuantumDynamics", "support_website_url": null, "website_url": "https://raw.githubusercontent.com/vaultlinerush/vaultlinerush-website/refs/heads/main/VaultlineRush%20Privacy%20Policy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26478448531855846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_667212476252651_794731180131010827_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vw15--FzXTkQ7kNvwHhhpdv&_nc_oc=Adr28YnKhNkPQ0SoYAog4uj1UPRRgMgGSq7PfBU5swdUZy2ZpDkU5DH8RByFhBBvBE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRndhUOBzJEyKqg8R-ekn-KjAR8HQXMQfS_LPJEyvUlw&oe=6A4919E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vaultline Rush", "platform": "ANDROID_6DOF", "context_cat
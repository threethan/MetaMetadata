A9"}, {"file_name": "Screenshot5.png", "id": "1099757892000843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_1099757895334176_6729673874803168472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fookRSQQ2oQ7kNvwFvyrTx&_nc_oc=AdoiR2RKwQWZv6VE45C6mJ2M29_9MMQsHC5EDT520vCUk6i7wj4VWt0_foYlWryLiZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_NFUwBHlhxcZgAZOotU-X6eobX0hhd3LHBE3rvDq17Q&oe=6A0728A2"}, {"file_name": "Screenshot3.png", "id": "1163135392578846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307346_1163135395912179_8207980023548927820_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09pLWeQaELQQ7kNvwE_SW-i&_nc_oc=AdqGf-IMiRGY1fklw1jASEUi0oUJ_AU2o3bnw16W3MG_cI9Lxl1YidCgDE_VbSsxDwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jeJ9jTaDEqVo-Wroxo_urGS381GU-2PrZccKzuuDXag&oe=6A071001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_VaultlineRush_2k.png", "id": "1088892439808702", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304938_1088892443142035_4164629952400718194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2i4IIxb-W4Q7kNvwErfWn1&_nc_oc=AdoOI6lH9Hqo6kIJPmVUku3YKEcie3wuUrwEQ60jz5zRPeMq5BpMYmU5GAskyuDbw9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dSYg6jmBwT_PCyXifHAVloUQjeWCsxcHzYCdao-GrWA&oe=6A0736AD"}, "display_name": "Vaultline Rush", "keywords": [], "long_description": "Run. Vault. Speedrun.\nVaultline Rush is a high-speed sci-fi parkour experience built for players who crave momentum, precision, and full-body freedom. Using a fully immersive avatar and physics-driven movement, you\u2019ll race through futuristic environments \u2014 jumping, climbing, and vaulting your way across a series of dynamic Trials designed to push your speed and skill to the limit.\n\nEach Trial challenges your reflexes and creativity as you find new routes, shave off seconds, and perfect your flow. Whether you're chasing leaderboard times or mastering smooth, fluid movement, every motion feels natural and responsive thanks to full-body physics and realistic interactions.", "short_description": "Experience high-speed sci-fi parkour in Vaultline Rush. Run, jump, and vault through physics-based Trials using a full-body avatar that delivers unmatched immersion and fluid movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/vaultlinerush/vaultlinerush-website/refs/heads/main/VaultlineRush%20Privacy%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "QuantumDynamics", "support_website_url": null, "website_url": "https://raw.githubusercontent.com/vaultlinerush/vaultlinerush-website/refs/heads/main/VaultlineRush%20Privacy%20Policy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24569661679401217"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1746422760060988"}, {"status": "PUBLISHED", "id": "761876093321487"}, {"status": "PUBLISHED", "id": "1162295832353684"}, {"status": "PUBLISHED", "id": "1510070340086754"}, {"status": "PUBLISHED", "id": "853496773747439"}, {"status": "PUBLISHED", "id": "2240683359751490"}, {"status": "PUBLISHED", "id": "841158398308188"}, {"status": "CANCELLED", "id": "1869104234008708"}, {"status": "PUBLISHED", "id": "4125819057
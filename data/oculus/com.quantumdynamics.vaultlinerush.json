MDNk__yH-DC-7dJelCMGpg5RMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWrth3H04OZbwrF7Vpk_rwG_DKxMBpYl5sCE8JqzzfLg&oe=6A7C5BB3"}, {"file_name": "Screenshot_1.png", "id": "1932811260631650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1932811263964983_8227803877075376935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWMgi25muE4Q7kNvwH0YKcg&_nc_oc=AdrDpDQZIkU8dQJ-sAUzgz9gUCbLCfJBVYB0tuPK-xBLOEw4CQDLuSKll4qQwpbDNWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8tsrLVr9RXyrnVgfOqmmOd87tseLUUfrjjlH3iKRWWA&oe=6A7C7944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2k_banner.png", "id": "654563050924539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_654563054257872_440537785091841093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA6NpDtFCsoQ7kNvwFGsKn_&_nc_oc=AdqDoxWzGmgfVw4pASQFozsFg2jjSqyHgG81WCVvJ0KUMva4nnFTM0Ffc18NMSwdJCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0TV0j6pfEgO_drTPm73Vu-qKcfH0SFLXfwzw1_z66og&oe=6A7C7A30"}, "display_name": "Vaultline Rush", "keywords": ["parkour", "freerun", "physics", "scifi", "climb"], "long_description": "\n# SPEEDRUN TRIALS\nVaultline Rush is a high-speed sci-fi parkour experience built for players who crave momentum, precision, and full-body freedom. Jump, Climb and Vault your way across a series of dynamic Trials designed to push your speed and skill to the limit.\n\n{1467854205022339}\n\n# UNPRECEDENTED FREEDOM OF MOVEMENT\nCarefully designed challenges will push you to your limits. \n\n{1035697859115778}\n\n# PHYSICS YOU CAN TRUST\nPhysics-driven movement with high-fidelity Fullbody IK. Every jump, catch, and vault feels precise and realistic.\n\n{1285823750423762}\n\n{1392548829299460}\n\n{1697901144996751}\n\n# PREDICTIVE VAULT SYSTEM\nVAULTLINE RUSH introduces a breakthrough in physics climbing by utilizing complex systems that manage the legs of the player, resulting in effortless vaulting.\n{836522232404611}\n\n\n", "short_description": "Experience high-speed sci-fi parkour in Vaultline Rush. Run, jump, and vault through physics-based Trials using a full-body avatar that delivers unmatched immersion and fluid movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/vaultlinerush/vaultlinerush-website/refs/heads/main/VaultlineRush%20Privacy%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "QuantumDynamics", "support_website_url": null, "website_url": "https://raw.githubusercontent.com/vaultlinerush/vaultlinerush-website/refs/heads/main/VaultlineRush%20Privacy%20Policy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26478448531855846"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_667212476252651_794731180131010827_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uu3o-tFx0gEQ7kNvwFUb-E6&_nc_oc=AdoXEB0p3FKF2g-GgiBgJFYTPEoAVO_vzHvzua4i201t8zbyWH6-m2C1XdUWiuPq2Do&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCV71T2QgOcqz7xkU_o-q4EKqkgUUkjJnxq8fKBX1KPA&oe=6A7C4C20"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vaultline Rush", "platform": "ANDROID_6DOF", "context_cat
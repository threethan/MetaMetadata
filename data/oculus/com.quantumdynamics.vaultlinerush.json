ion", "id": "24345876715113049", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24909269425440439"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1765230635, "id": "24900134416353940", "version": "1.0.5", "version_code": 10, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24345876715113049", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24909269425440439"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1445693496507683"}]}, "change_log": null, "created_date": 1765048842, "id": "24883593684674680", "version": "1.0.5", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24345876715113049", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24909269425440439"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1445693496507683"}]}, "change_log": "\"-Prewarmed GPU intensive shaders to reduce the stutter in-game/n\n-Prebaked the font atlas to avoid runtime symbol generation/n\n-Multiple movement framework optimizations/n\n-Improved elbow IK/n\n-Improved shoulder IK/n\n-Improved leg IK/n\n-Improved jump cycle IK/n\n-Improved the relaxed hand pose/n\n-Improved the dynamic poser of the fingers/n\n-Improved the knee IK/n\n-Improved airborne detection system/n\n-Repositioned the camera to increase proprioception/n\n-Repositioned the physical shoulder to increase range/n\n-Increased one-handed grab strength/n\n-Increased hand stability/n\n-Increased sprint speed from 3 to 3.25/n\n-Increased sprint jump bonus from 0.25 to 0.5/n\n-Added an Info Ball to the HUB, pull it and release to receive fun facts/n\n-Multiple geometry fixes and improvements/n\n-Added a brand new tutorial system with prerecorded mechanics, to better explain certain mechanics/n\n-Fixed a rare case of permanent crouch/n\n-Fixed Trial progress not saving if you complete a Trial and manually reset/n\"", "created_date": 1764328000, "id": "24818853551148694", "version": "1.0.4", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
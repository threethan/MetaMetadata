ld to reach the ultimate peak, and uncover the true story hidden behind this infinite structure.", "short_description": "Climb through an endless alien structure filled with shifting platforms, risky obstacles, and mysterious rewards. Test your skill, break global records, and push higher than anyone before. Does this tower ever end? Become the first to find out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33305757995735893"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2410713369381257"}, {"status": "PUBLISHED", "id": "899671575981443"}, {"status": "PUBLISHED", "id": "1581581942894601"}, {"status": "PUBLISHED", "id": "1231300562188585"}, {"status": "PUBLISHED", "id": "1457474242429960"}, {"status": "CANCELLED", "id": "1243487540616375"}, {"status": "PUBLISHED", "id": "744632811849699"}, {"status": "PUBLISHED", "id": "1338443124938318"}]}, "baseline_offer": {"id": "1457474242429960"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775221740, "status": "PUBLISHED", "id": "14574742424299
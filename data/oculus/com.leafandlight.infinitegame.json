81243577_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY5MToitmYAQ7kNvwGDEf77&_nc_oc=AdpcR3a3bwa8G8dlo3jhJ_Crm97AC7c1Yfm7IvHK-HfQCa-cmj8N7GZYyEjqoz5KYzI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1GP7Z2uW68CGkF-lORURsbxFp78YX7krdydkwh21irw&oe=6ABA758D"}, {"file_name": "GamePlay_2560X1440_02.png", "id": "723615667209344", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_723615677209343_3275094603869789281_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doE2L93TZZ0Q7kNvwEmtE2P&_nc_oc=AdqKl0zaJd-ss9cySwJiLIhfWXNgh5Tug6kVtUAr9hUH85bwlojt--Sj4d6SLMILYzU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWhYqjXlkPgm0eRx1UTwXU9QNbhTonep5oGAzqVAgGZA&oe=6ABA5FEF"}, {"file_name": "GamePlay_2560X1440_06.png", "id": "1927065121249748", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293803_1927065124583081_8677631252842493974_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zeCZU9P4LoQ7kNvwES6Uig&_nc_oc=Adofg5YaQ8e2kEAKqm36ZTT0wbAskf058DYkqtXIb3LKyFyuiDRCnA5z-X9kBhxPusY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeeUghoEOBHVrSf_17tYCaz91zWUkf981GL9VyV52k2A&oe=6ABA7663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GamePlay_2560X1440_07.png", "id": "1787447628596472", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499309014_1787447631929805_7772280555897627679_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jrgprhickAQ7kNvwFkaAR0&_nc_oc=AdqTfzcgZUSnOQhYfIVgknnBMprduLjt1EwLWLVZluoZXy_AIZuoGSh7s-nN_apz1IU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUqaCksq4iFJ4CrUU0YUGhA5WtINOESrp-vapta67VKA&oe=6ABA5AC1"}, "display_name": "Infinity Climb", "keywords": ["tag", "Platformer", "Endless", "Parkour", "Climbing"], "long_description": "**THE TOWER HAS NO END.**\n\nAt least, no one has ever climbed high enough to prove otherwise.\n\n**Infinity Climb** is an intense VR climbing challenge where every movement comes from your own arms. Push, launch, grab, swing, and pull yourself upward through a massive alien structure built to test your skill.\n\nNavigate shifting platforms, rotating cylinders, dangerous traps, difficult jumps, and climbable surfaces suspended impossibly high above the world.\n\nEvery section demands better timing, stronger movement, and greater control. The higher you climb, the harder the tower fights back.\n\nThere is no easy path to the top.\n\nCompete for the highest position on the global leaderboard, break records, discover mysterious rewards, and uncover fragments of the story hidden inside the structure.\n\nMost climbers will fall.\n\nThe best will set records.\n\nBut only one may become the first person in the world to discover what waits at the final height.\n\n**How high can you climb?**\n", "short_description": "Scale a mysterious alien tower using fast, physical, arm-powered movement. Leap across shifting platforms, grab climbable holds, dodge deadly traps, and fight for every meter. The tower may be endless, but the leaderboard is not. How high can you climb before the structure defeats you?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "su
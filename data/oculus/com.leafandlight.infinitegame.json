81243577_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3fEl7VhKRwQ7kNvwFzP_ji&_nc_oc=AdoLnMeJZdNPdJu0RDofKpxqA7Yjq2uCNwXxDNMrabF6LaI5d9DqcyrRK7PxfPwPpIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmDHFZvb35J79jTjHp0qfok6PvoOyNxNxZTJPfyu3KKg&oe=6AB28C8D"}, {"file_name": "GamePlay_2560X1440_02.png", "id": "723615667209344", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_723615677209343_3275094603869789281_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQspiHGNpTAQ7kNvwEGdkkb&_nc_oc=AdpkhgYI2FEMpO8RJcPEstaPDD1v4t9pycBNkS8odvC_wCvvtLKIv5M6Wv2D0RAnhE4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKERQYbAIePlX6wqlzCk1lmHxDLTzpKzjJL2OhVq2g0Yw&oe=6AB276EF"}, {"file_name": "GamePlay_2560X1440_06.png", "id": "1927065121249748", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293803_1927065124583081_8677631252842493974_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1EQ7txEXq0Q7kNvwFFFbax&_nc_oc=AdqmL5OAHUv7QL5OtHhESCviPfvFk5bk5Z1Adxgstm-BuotFRqWUL7uEZ47Eaomjjy0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfL0LWKEnh7J9pZmVFTixkaIJvP2bAYeN0YAfhodl-DQ&oe=6AB28D63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GamePlay_2560X1440_07.png", "id": "1787447628596472", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499309014_1787447631929805_7772280555897627679_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgQIDZXph0QQ7kNvwEY7Dc8&_nc_oc=AdoI90iXpPIsKyJkAw3bXfZh2eqx5G2iiyIBCFdHs43eH1JnNnz5eFjd26jMf8r7qOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf6xNNNJTi6SX1DVP9G-BxH6yVKt9c-TGsNF_UxuHBOQ&oe=6AB271C1"}, "display_name": "Infinity Climb", "keywords": ["tag", "Platformer", "Endless", "Parkour", "Climbing"], "long_description": "**THE TOWER HAS NO END.**\n\nAt least, no one has ever climbed high enough to prove otherwise.\n\n**Infinity Climb** is an intense VR climbing challenge where every movement comes from your own arms. Push, launch, grab, swing, and pull yourself upward through a massive alien structure built to test your skill.\n\nNavigate shifting platforms, rotating cylinders, dangerous traps, difficult jumps, and climbable surfaces suspended impossibly high above the world.\n\nEvery section demands better timing, stronger movement, and greater control. The higher you climb, the harder the tower fights back.\n\nThere is no easy path to the top.\n\nCompete for the highest position on the global leaderboard, break records, discover mysterious rewards, and uncover fragments of the story hidden inside the structure.\n\nMost climbers will fall.\n\nThe best will set records.\n\nBut only one may become the first person in the world to discover what waits at the final height.\n\n**How high can you climb?**\n", "short_description": "Scale a mysterious alien tower using fast, physical, arm-powered movement. Leap across shifting platforms, grab climbable holds, dodge deadly traps, and fight for every meter. The tower may be endless, but the leaderboard is not. How high can you climb before the structure defeats you?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "su
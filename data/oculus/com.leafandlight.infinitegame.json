cture.", "short_description": "Climb through an endless alien structure filled with shifting platforms, risky obstacles, and mysterious rewards. Test your skill, break global records, and push higher than anyone before. Does this tower ever end? Become the first to find out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35080804344897907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830411_1205069364454280_3618736876582020434_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uMeESgxAWMQ7kNvwF01a9z&_nc_oc=AdpRHkj3Vl3pGaqAGjHaBtkd-lfdHIseqV4VfIMGDiziK5OIMJaV3lb3J-oZfDjU0zM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-BIrE2eK2GH7xhqNA805yCbCEDNPgP9UiS2RWgLFolg&oe=69F2024A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Game Infinity Climb", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_nam
81243577_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0t_vPGPLB0Q7kNvwF_u2E0&_nc_oc=Adpsy_FXaSTvx2kPAMbxW-gWKs4rZ9r5e08danGYoxJOBOhxFd22Z66uVqxFZTnErNo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3G1Fy27SOUkjAA3wWxgfrM0rTtdiX-QwfvRLDMzDreA&oe=6AD0DF0D"}, {"file_name": "GamePlay_2560X1440_02.png", "id": "723615667209344", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824322_723615677209343_3275094603869789281_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMqLXwdMoswQ7kNvwE17J-r&_nc_oc=AdoNqgyrgSfBgkAJ0RZeOFDfAr3IycZ_boXbIhx6w01bjStr933KlGuFNpWDULVyVNQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpch0LzOoXBKIJYwK0DvrLujUX7tLiwukgOJLutMVhjw&oe=6AD101AF"}, {"file_name": "GamePlay_2560X1440_06.png", "id": "1927065121249748", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499293803_1927065124583081_8677631252842493974_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_AV-aOUxn8Q7kNvwFuu4CU&_nc_oc=AdodqSTNQAseGRvbIJyHdV3tKMGsFQrsaoblAdi-14cY46jrbT8MY2to0geV-SPiEuE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRgD5z7q8qiIA1WzariaQv6MJ59rLTjEkNSVOg0b2sSA&oe=6AD0DFE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GamePlay_2560X1440_07.png", "id": "1787447628596472", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499309014_1787447631929805_7772280555897627679_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdDP_iuVAjEQ7kNvwGzJJ_5&_nc_oc=AdofoQytMZIRaMg4ntzIwcUCNCIf9vtUyW8JEKM9ks3xix4GlHAkMLKvBnNprcYt_Kk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgiaTHaROzaX_MYot3dY7jtfITqKDHnyktWUhNEXs9jQ&oe=6AD0FC81"}, "display_name": "Infinity Climb", "keywords": ["tag", "Platformer", "Endless", "Parkour", "Climbing"], "long_description": "**THE TOWER HAS NO END.**\n\nAt least, no one has ever climbed high enough to prove otherwise.\n\n**Infinity Climb** is an intense VR climbing challenge where every movement comes from your own arms. Push, launch, grab, swing, and pull yourself upward through a massive alien structure built to test your skill.\n\nNavigate shifting platforms, rotating cylinders, dangerous traps, difficult jumps, and climbable surfaces suspended impossibly high above the world.\n\nEvery section demands better timing, stronger movement, and greater control. The higher you climb, the harder the tower fights back.\n\nThere is no easy path to the top.\n\nCompete for the highest position on the global leaderboard, break records, discover mysterious rewards, and uncover fragments of the story hidden inside the structure.\n\nMost climbers will fall.\n\nThe best will set records.\n\nBut only one may become the first person in the world to discover what waits at the final height.\n\n**How high can you climb?**\n", "short_description": "Scale a mysterious alien tower using fast, physical, arm-powered movement. Leap across shifting platforms, grab climbable holds, dodge deadly traps, and fight for every meter. The tower may be endless, but the leaderboard is not. How high can you climb before the structure defeats you?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "su
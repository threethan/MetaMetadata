81243577_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkY9hzZVKlQQ7kNvwGhJ4Rt&_nc_oc=AdqMY_p9c2ZHRle1kHq8Bxs8MhdcIdcfGxH9CioyP7oLZ91cZ_7wy572TY2C28zfklg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeVLunH1sInm6HIYEekx1XVT_SznxMqV-NklSixlimlA&oe=6AEB3D0D"}, {"file_name": "GamePlay_2560X1440_02.png", "id": "723615667209344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_723615677209343_3275094603869789281_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSq7v9Gc3S4Q7kNvwHHakdU&_nc_oc=AdoCAlgF76XfYykrcIVpvO4lBPqH0QogN9be7asHg4SSnGFCUSKmc3vnFCftrBnm09A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv3B9gyzgUqyM-xfmEfEUoIk_FqKOH7n5yWcXsEiZfxg&oe=6AEB5FAF"}, {"file_name": "GamePlay_2560X1440_06.png", "id": "1927065121249748", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293803_1927065124583081_8677631252842493974_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qwppnRXhp8Q7kNvwE6YJdX&_nc_oc=AdoI8CdSDvk9QLEgAk8zog-jsVnNp-F8xUSz6SWGj2Pix2obCpYApMPCquMdL58aiF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfQukgCadb_voKO3E-V7TWkmLlhpVdTtX8ZG_m_mNDIg&oe=6AEB3DE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GamePlay_2560X1440_07.png", "id": "1787447628596472", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499309014_1787447631929805_7772280555897627679_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NsR9KOuJBcQ7kNvwHpGFUk&_nc_oc=Adqs_3aqk84Z9ujyE4KJq2KSZkZ6L9NP-M3vroE_DIcUi2ijMwLagqto6xWHzMo6CyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_Tym1HfNB0CVvm3Qky28ztyDlPOW2oKFzn7OdJhwD5w&oe=6AEB5A81"}, "display_name": "Infinity Climb", "keywords": ["tag", "Platformer", "Endless", "Parkour", "Climbing"], "long_description": "**THE TOWER HAS NO END.**\n\nAt least, no one has ever climbed high enough to prove otherwise.\n\n**Infinity Climb** is an intense VR climbing challenge where every movement comes from your own arms. Push, launch, grab, swing, and pull yourself upward through a massive alien structure built to test your skill.\n\nNavigate shifting platforms, rotating cylinders, dangerous traps, difficult jumps, and climbable surfaces suspended impossibly high above the world.\n\nEvery section demands better timing, stronger movement, and greater control. The higher you climb, the harder the tower fights back.\n\nThere is no easy path to the top.\n\nCompete for the highest position on the global leaderboard, break records, discover mysterious rewards, and uncover fragments of the story hidden inside the structure.\n\nMost climbers will fall.\n\nThe best will set records.\n\nBut only one may become the first person in the world to discover what waits at the final height.\n\n**How high can you climb?**\n", "short_description": "Scale a mysterious alien tower using fast, physical, arm-powered movement. Leap across shifting platforms, grab climbable holds, dodge deadly traps, and fight for every meter. The tower may be endless, but the leaderboard is not. How high can you climb before the structure defeats you?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "su
-Ud2nFRbum_oWHeZtHGx0h-RCnmbFVhQ2Ja-WY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW30y5-SuTp2QBVmlb5VawiD8YhaisCgyDH2y-rRBsBmw&oe=6B1057AD"}, {"file_name": "GamePlay_2560X1440_05.png", "id": "2163601451117357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_2163601454450690_3845115743381243577_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoVCNc_HR08Q7kNvwH6LBn6&_nc_oc=Ado9vKpq5YGFO4OtHKmCZTX_N_sz9NKzGwpDkIXi0GzesBOn-sycvpGmIg2cWAURwHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWLh-sHRuLg8zhK2Oln7MN57sZVewP4Soop-Pp6O365zQ&oe=6B105F4D"}, {"file_name": "GamePlay_2560X1440_02.png", "id": "723615667209344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_723615677209343_3275094603869789281_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSoImbGT8fEQ7kNvwEgbAlu&_nc_oc=AdqLK7vxmaDIhCLNaFxxwmM4H_x1Sn_2xCgPJvXyzBCGNSRRnM0jJyGD_3kaO-TX9ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmSuXyHTivUWqusuiFGEYoKnlq5FaQwPUS7wa8GgJanQ&oe=6B1049AF"}, {"file_name": "GamePlay_2560X1440_06.png", "id": "1927065121249748", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293803_1927065124583081_8677631252842493974_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZgvX3s5-L4Q7kNvwE-FDxX&_nc_oc=Adql_1u5yTqFhP5ZqNOkumI-E9rv4-pBXDbzPcFYBZIolu5yaqjb2wGQiiJuPdjruGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWO-31uUtSkdQGVWfG_1_C6EXBbW83d3PWglh9ORt989A&oe=6B106023"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GamePlay_2560X1440_07.png", "id": "1787447628596472", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309014_1787447631929805_7772280555897627679_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MQumYmNRX8Q7kNvwGHONSx&_nc_oc=AdqZdbHEYcv3Tsu2xbDIJzipuko-un2PHVKKWU0bvd_BVt1FUfS7HptcLf-_eMyHeeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzZqa7Cye9VT-NbZGDLypbhJw2H47FxaQ4B6M_dox2mw&oe=6B104481"}, "display_name": "Infinity Climb", "keywords": ["tag", "Platformer", "Endless", "Parkour", "Climbing"], "long_description": "**THE TOWER HAS NO END.**\n\nAt least, no one has ever climbed high enough to prove otherwise.\n\n**Infinity Climb** is an intense VR climbing challenge where every movement comes from your own arms. Push, launch, grab, swing, and pull yourself upward through a massive alien structure built to test your skill.\n\nNavigate shifting platforms, rotating cylinders, dangerous traps, difficult jumps, and climbable surfaces suspended impossibly high above the world.\n\nEvery section demands better timing, stronger movement, and greater control. The higher you climb, the harder the tower fights back.\n\nThere is no easy path to the top.\n\nCompete for the highest position on the global leaderboard, break records, discover mysterious rewards, and uncover fragments of the story hidden inside the structure.\n\nMost climbers will fall.\n\nThe best will set records.\n\nBut only one may become the first person in the world to discover what waits at the final height.\n\n**How high can you climb?**\n", "short_description": "Scale a mysterious alien tower using fast, physical, arm-powered movement. Leap across shifting platforms, grab climbable holds, dodge deadly traps, and fight for every meter. The tower may be endless, but the leaderboard is not. How high can you climb before the structure defeats you?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
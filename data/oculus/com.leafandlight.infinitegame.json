den behind this infinite structure.", "short_description": "Climb through an endless alien structure filled with shifting platforms, risky obstacles, and mysterious rewards. Test your skill, break global records, and push higher than anyone before. Does this tower ever end? Become the first to find out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34250623137916036"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830411_1205069364454280_3618736876582020434_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GNNwKnTW-YQ7kNvwGz7BQ8&_nc_oc=Adlk4-Ug642Fpde6zJ3PeAUfaMUhYhBIVotBBkSBLSN24EGIMyJrPgW09iuyAj6wN9k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0WSDrgZ4p6z-I8Jgwy2VozNYmvy5xUm0c1OFmB_QoPA&oe=69BE97CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Infinity Climb TAG", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "c
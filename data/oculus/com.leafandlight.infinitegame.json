H900ta_sSkf2sbt27pkWqNnwg&oe=6B086EAD"}, {"file_name": "GamePlay_2560X1440_05.png", "id": "2163601451117357", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823783_2163601454450690_3845115743381243577_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1G5ULv3bYYQ7kNvwFMIEV1&_nc_oc=Adoo-DsL-5jU1XKZh4ASNCZs4UxNeqMFEuYgbydBQ8sLb5IMwjOVAF2Denxr2UNq17I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLzZzQd08ZrIb-BeAAnfLOQ0CQRU0oSvue7ylJjnXKmQ&oe=6B083E0D"}, {"file_name": "GamePlay_2560X1440_02.png", "id": "723615667209344", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824322_723615677209343_3275094603869789281_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c7q7c4gjcAQ7kNvwEiyVTP&_nc_oc=Adqbpx8Lvo8B0N8AIkxNXMnoV1VpxHTUBeASCTl7aK-lmHwBz229_5JlgRnZskvo-yo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTYo0S4Fn7S1QgAc1EnIUtWxXSCDyf6vEYd33BJUAdag&oe=6B0860AF"}, {"file_name": "GamePlay_2560X1440_06.png", "id": "1927065121249748", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499293803_1927065124583081_8677631252842493974_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGip-17TWZkQ7kNvwGGagmw&_nc_oc=AdrIX1PfB8gT2Z1gXhpf8EVwADJ1n_lUWJpdPg0LZ8HXXa4_Jazxjia9f4vAI6bpYrI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWLIiUG5uUQ1jywrtpHnfi0izcZyI6zjJpBCJ8hfycig&oe=6B083EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GamePlay_2560X1440_07.png", "id": "1787447628596472", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499309014_1787447631929805_7772280555897627679_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDGVhblZcGUQ7kNvwFRbCGD&_nc_oc=Adp0oli6xdBKc0kXn01T670ZKLKqYcvoendmlmrpcL2Hmn8eQcj_D6qtVTt8keSqaoE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlIvrfJqI4dlSH05NfR8LedIXxu7oVl9hI_sk9VbObJw&oe=6B085B81"}, "display_name": "Infinity Climb", "keywords": ["tag", "Platformer", "Endless", "Parkour", "Climbing"], "long_description": "**THE TOWER HAS NO END.**\n\nAt least, no one has ever climbed high enough to prove otherwise.\n\n**Infinity Climb** is an intense VR climbing challenge where every movement comes from your own arms. Push, launch, grab, swing, and pull yourself upward through a massive alien structure built to test your skill.\n\nNavigate shifting platforms, rotating cylinders, dangerous traps, difficult jumps, and climbable surfaces suspended impossibly high above the world.\n\nEvery section demands better timing, stronger movement, and greater control. The higher you climb, the harder the tower fights back.\n\nThere is no easy path to the top.\n\nCompete for the highest position on the global leaderboard, break records, discover mysterious rewards, and uncover fragments of the story hidden inside the structure.\n\nMost climbers will fall.\n\nThe best will set records.\n\nBut only one may become the first person in the world to discover what waits at the final height.\n\n**How high can you climb?**\n", "short_description": "Scale a mysterious alien tower using fast, physical, arm-powered movement. Leap across shifting platforms, grab climbable holds, dodge deadly traps, and fight for every meter. The tower may be endless, but the leaderboard is not. How high can you climb before the structure defeats you?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres"
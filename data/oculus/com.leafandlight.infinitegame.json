orNUHNp7rUAQG6L0Hk0RT21K6lrF3jLAlclMQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWVvDIoSVR8tjIV-3SPsQrtjsw6cTxkln43xGMXGOmsog&oe=6B0F062D"}, {"file_name": "GamePlay_2560X1440_05.png", "id": "2163601451117357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_2163601454450690_3845115743381243577_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoVCNc_HR08Q7kNvwFmnN_g&_nc_oc=Adr7c42l3RCdjWJL304QSPsLjJ8sOhDR4G8RQJqTZJnHa9q1zQEZM9JTpJK6133NyS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQURtU1SiOL7udChTx-FQVKJu3Bj46jawyEpVE4tmQTEKQ&oe=6B0F0DCD"}, {"file_name": "GamePlay_2560X1440_02.png", "id": "723615667209344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_723615677209343_3275094603869789281_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQSWcKL8RqMQ7kNvwEUp3qv&_nc_oc=AdqtMRd2OrSex_LyqzQKopB6rMn7Oc7MDUrAcpbM_OsTGKBL7haQJbIQGoXLbDkxDS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9THvzPwVsY3oKdNV30q3TDLZFr2uslkUuhEaohRr4ZA&oe=6B0EF82F"}, {"file_name": "GamePlay_2560X1440_06.png", "id": "1927065121249748", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293803_1927065124583081_8677631252842493974_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlwrkixvF9MQ7kNvwGQJU5T&_nc_oc=AdrWMG9DnC246UBnbfPB1LDHsIqvZshxszuHiR4zpNmFRUWUwoE91P1ZhlfnginfFMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUmpK0zbDOXwHV-2GLlkIUcUEvUr2yPVhpzXwUqxMIuCA&oe=6B0F0EA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GamePlay_2560X1440_07.png", "id": "1787447628596472", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499309014_1787447631929805_7772280555897627679_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MQumYmNRX8Q7kNvwFsXu8a&_nc_oc=AdpvCu9yt-NncJBupFx8fvw0eLsIsnlIosiNzjelvy-Q-jVr14cvjl9QW2QR4_EqFVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXre413KOqLNn-DbjluTLiVafT-ZUbSpAV1LFQmQv2xdg&oe=6B0EF301"}, "display_name": "Infinity Climb", "keywords": ["tag", "Platformer", "Endless", "Parkour", "Climbing"], "long_description": "**THE TOWER HAS NO END.**\n\nAt least, no one has ever climbed high enough to prove otherwise.\n\n**Infinity Climb** is an intense VR climbing challenge where every movement comes from your own arms. Push, launch, grab, swing, and pull yourself upward through a massive alien structure built to test your skill.\n\nNavigate shifting platforms, rotating cylinders, dangerous traps, difficult jumps, and climbable surfaces suspended impossibly high above the world.\n\nEvery section demands better timing, stronger movement, and greater control. The higher you climb, the harder the tower fights back.\n\nThere is no easy path to the top.\n\nCompete for the highest position on the global leaderboard, break records, discover mysterious rewards, and uncover fragments of the story hidden inside the structure.\n\nMost climbers will fall.\n\nThe best will set records.\n\nBut only one may become the first person in the world to discover what waits at the final height.\n\n**How high can you climb?**\n", "short_description": "Scale a mysterious alien tower using fast, physical, arm-powered movement. Leap across shifting platforms, grab climbable holds, dodge deadly traps, and fight for every meter. The tower may be endless, but the leaderboard is not. How high can you climb before the structure defeats you?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/infinity-game-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "co
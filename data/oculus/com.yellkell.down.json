1-25/507830479_1072240671977566_7566627033533297227_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0JT1VGaMtQQ7kNvwEJDJWm&_nc_oc=AdoDPCI0cvGKvl4Vu-Kh9swcgJMeKNp4NpO0ptoS9JDIXSLk6UBWvie_-spUBr6XuA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-mjSbKoZis-ARdPc3PxkHswpsP96_ttKTMPE5chPYwQ&oe=6B1047A5"}, {"file_name": "screenshot-5.png", "id": "1666007728031080", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/585741071_1666007731364413_8929284328907937568_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP5juPK67CgQ7kNvwGUIuyu&_nc_oc=AdpRKBF7SXcyZSabhP49q7KuzQxpc6P7DEraPzrgBHENIMY3jIlRID16g340HPsppQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNZwF9rPaHJLHZGmeX8i_J3sd3dJCZtZzBcl7OLuQqJQ&oe=6B104B2A"}, {"file_name": "unnamed (1).png", "id": "1871544307483939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824741_1871544314150605_3898985176196315410_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Nr3NyzfVLgQ7kNvwG2DM53&_nc_oc=AdqmotmsQ_CeCGqrIcJwrJxxQsVSLwwNFf9AiQztEVyMpCa9pxU2zPAWpaGT9JXEJ0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdrfXcVU4iH-6-vvn5v-D5PooMNmnX93-O-jxpMkLSIw&oe=6B103DCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOWN", "keywords": ["descent", "falling", "synthwave", "arcade", "dodge"], "long_description": "DOWN is a fast, physical VR descent through a neon city suspended in the void.\n\nStand on a floating platform, read the incoming patterns, and move into the safe space before the next wave erupts. Survive three escalating rounds, launch onto high-speed slides, thread the barriers, and carry the run all the way to the finish gate.\n\nFeatures:\n- Short, replayable runs built around quick reactions and real-world movement\n- Three dodge rounds, two steep neon slides, and a final 220-metre victory drop\n- A pulsing synthwave soundtrack with unlockable tracks\n- Live altitude and route feedback throughout the descent\n- Finish-line graffiti: leave your name behind when you survive\n\nDOWN supports Touch controllers and hand tracking. Play standing or room-scale in a clear 2 m \u00d7 2 m area. The experience uses intense artificial motion and is best suited to players comfortable with high-speed VR.", "short_description": "Step off a neon skyline and commit to the drop. Dodge rising hazards, carve through high-speed slides, and survive three escalating stages in a replayable room-scale VR descent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://playdownvr.web.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "yellkelldotcom", "support_website_url": "https://github.com/yellkell/down/issues", "website_url": "https://playdownvr.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1152933947914274"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "879638184804874"}]}, "baseline_offer": {"id": "879638184804874"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785435960, "status": "PUBLISHED", "id": "879638184804874"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1166449486562720",
{"data": {"node": {"__typename": "Application", "id": "25915409604768641", "organization": {"id": "917574041439609", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25915409604768641"}]}, "id": "1256383489454359"}]}}, "firstRevision": {"nodes": [{"application": {"id": "25915409604768641", "release_date": 1772794020, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26131868849789381"}, "id": "1088197620111318"}]}}, "binary": null, "live_binary": null, "created_date": 1772795961, "id": "26139163319059934", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "26072333165742950"}, "release_status": "RELEASED", "id": "25915409604768641"}, "id": "26072333165742950", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "PENDING", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823270_1449829446599213_3478771048986771003_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaEkihGED7MQ7kNvwFmF7jk&_nc_oc=Adn0uXLga55K_dEe0iU-XpvhbvRklchOcFHK45wjVmcQxDmn3i_-HwqeI3uq83jSOGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaBMUr_NMhM9XB3EUzbKDBbCNxXRoecDyMV-OKY6oACQ&oe=69B148E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Laboratori 3D di fisica", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1772794020, "lastRevision": {"nodes": [{"id": "25915409701435298", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25915409604768641", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2935367006669218"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1989638532437977", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laboratori di fisica 3D", "keywords": [], "long_description": "Questa applicazione per Meta Quest trasforma lo studio della fisica in un\u2019esperienza immersiva e interattiva. L\u2019utente pu\u00f2 accedere a una serie di laboratori virtuali progettati per esplorare i principali argomenti della fisica sperimentale, dalle grandezze fondamentali alla meccanica, dall\u2019elettricit\u00e0 alla termodinamica.\n\nAll\u2019interno degli ambienti VR \u00e8 possibile utilizzare strumenti virtuali, effettuare misurazioni, osservare fenomeni fisici e verificare leggi e relazioni matematiche attraverso l\u2019esperimento diretto. I laboratori includono attivit\u00e0 su massa, densit\u00e0, forze, moto, oscillazioni, piani inclinati, circuiti elettrici, legge di Ohm, caratteristiche volt-amperometriche e scambi di calore.\n\nL\u2019approccio immersivo favorisce la comprensione dei concetti teorici, stimola l\u2019apprendimento attivo e consente di sperimentare in totale sicurezza, senza limiti di materiali o spazi fisici. L\u2019app \u00e8 pensata come supporto didattico per studenti, docenti e ambienti educativi, offrendo un modo innovativo e coinvolgente per apprendere la fisica attraverso l\u2019esperienza.", "short_description": "Un laboratorio di fisica in realt\u00e0 virtuale per Meta Quest. Sperimenta misure, meccanica, elettricit\u00e0 e fenomeni fisici fondamentali in ambienti immersivi e interattivi. L\u2019app consente di eseguire esperimenti virtuali realistici, raccogliere dati, osservare fenomeni e comprendere le leggi della fisica in modo pratico, sicuro e coinvolgente."}, {"images": {"nodes": [{"file_name": "banner-di-copertina-3000x900px.png", "id": "1976133187120801", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818852_1976133193787467_3742693911542954879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0tU1QXQP0AQ7kNvwHZnNpX&_nc_oc=AdnwlQ6AfpMsgknj4m8Z2ULeGRHw-dmOej7FrLXlE1YYHFim9FOlJ_h3E8boZSawsGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxHgToO0FYUcNu_EAsk-xjmk9GjC-KQAR2rr2qe1u4MQ&oe=69B143EA"}, {"file_name": "verticale-1009x1440.png", "id": "1858101284909744", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_1858101298243076_292410156732293931_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoKojVot4_gQ7kNvwFPcheF&_nc_oc=AdnNb2yDfIgQERXLQmRC3gPMoO9tSdOCXuh1VBmy8j8H5gggXC6AxPSjPZZPUm70dT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkdCblsh9pWZNNIrAJ1pFqVn_mBuUXLH1ClMD0tj9yug&oe=69B17A9E"}, {"file_name": "quadrata-1440x1440.png", "id": "1449829443265880", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823270_1449829446599213_3478771048986771003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaEkihGED7MQ7kNvwFmF7jk&_nc_oc=Adn0uXLga55K_dEe0iU-XpvhbvRklchOcFHK45wjVmcQxDmn3i_-HwqeI3uq83jSOGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNZc2i80zw6iF6QuUqk0BtvzQju_dM_6x2zdXdCl2bPw&oe=69B148E9"}, {"file_name": "logo-zanichelli.png", "id": "1418916343314195", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308090_1418916346647528_8957485135722998772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_
e-2560x1440.png", "id": "811780337865709", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_811780341199042_843550388313221436_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eq8_5yvsvIQ7kNvwGsea4F&_nc_oc=AdrI0pHtublLqggUJtO4wlXwT8fKpZWzUVbkYYM_-D8hWEI6qfzc9F9KeRT-S705mYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l668FEhnE8KCR4rhVXa4LsuSiU1DlKkaFaHMs-7Lslw&oe=6A047F0A"}]}, "id": "1711355720233445", "locale": "en_US", "screenshots": [{"file_name": "2_screenshot-app-5-immagini.png", "id": "1967674907288105", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823905_1967674910621438_1409248110587310477_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3HSFOYIvHMQ7kNvwHG3tRe&_nc_oc=AdqwFR9ss5galR50R3zpRXD2trETYkHEdl5aW7Ad_Ln9M6eg11F3xw_1PP16hmUtom4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WOdI_-XRd4JUzhJ3rPl-kAsPM0cUkJe6Vq-jOHdL5Gw&oe=6A048586"}, {"file_name": "3_screenshot-app-5-immagini.png", "id": "1635052707813739", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1635052711147072_8775355018955268885_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkHl8_41etYQ7kNvwE6mras&_nc_oc=Adozp4ow17APf3IflpS3utjm76Z5UedRHUZnYtrGAgMAuwtKjD9aaEiU9TKY7qhCCj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G_6AXkTInnzOkHrUP6CzTpgcMEGxHKyrY0Yo4EnKmQA&oe=6A047D5B"}, {"file_name": "4_screenshot-app-5-immagini.png", "id": "1272074191495307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507843239_1272074194828640_802548132900867466_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-qhooTbBj0Q7kNvwHxoXbg&_nc_oc=Ado18OCOtncqrYASxeFCbod2i_DwVuMpZfxdelvk5qvIL2MLmhxpoo1jAFPCczbtouI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43JEscrh6ONiiZUL4ffLeFJw-ruM5eZId1C_p0H9QwmQ&oe=6A047145"}, {"file_name": "6_screenshot-app-5-immagini.png", "id": "1480544736834966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825497_1480544740168299_3500702918948854010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoZyfQSmOQwQ7kNvwFHkXrL&_nc_oc=AdourlgMkxbjNtmvbejUGjbxttEr5fLJZerRFw9_GRyFfxAHJnD3pCTJznnm4SP22LQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xiy13epxc0wapOJyN0X_EJFm8HRBIRt9A9WbWc6Hq0A&oe=6A047E19"}, {"file_name": "5_screenshot-app-5-immagini.png", "id": "938342022207159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825503_938342028873825_9099555711940098515_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpPfq4jjCeQQ7kNvwHXiRQ4&_nc_oc=AdoP71HLLkHSob0HYyHPelUDeDLOTXvcIqGN7dB1otfaxM3dYiyh2g0bfYQ6EY3-3DE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xdI32yEJvocmf5g9KBtsO_6jxQGvOAAowv638YNltfw&oe=6A047C89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Physics Labs", "keywords": ["Physics", "Labs", "Zanichelli", "Lab", "experiments"], "long_description": "A Zanichelli 3D physics lab in virtual reality for Meta Quest that transforms the study of physics into an immersive and interactive experience.\nUsers can access a series of virtual labs designed to explore the main topics of experimental physics, from fundamental quantities to mechanics, from electricity to thermodynamics.\n\nWithin the VR environments, users can utilize virtual tools, take measurements, observe physical phenomena, and verify laws and mathematical relationships through hands-on experimentation. The labs include activities on mass, density, forces, motion, oscillations, inclined planes, electrical circuits, Ohm\u2019s law, volt-ampere characteristics, and heat transfer.\n\nThe immersive approach enhances understanding of theoretical concepts, stimulates active learning, and allows for experimentation in complete safety, without limitations on materials or physical space. The app is designed as an educational tool for students, teachers, and educational settings, offering an innovative and engaging way to learn physics through experience.", "short_description": "A Zanichelli virtual reality physics laboratory for Meta Quest. Experience measurements, mechanics, electricity, and fundamental physical phenomena in immersive and interactive environments. The app allows you to perform realistic virtual experiments, collect data, observe phenomena, and understand the laws of physics in a practical, safe, and engaging way."}, {"images": {"nodes": []}, "id": "1433196451822549", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laboratori 3D di fisica", "keywords": ["laboratori", "laboratorio", "Zanichelli", "fisica", "esperimenti"], "long_description": "Un laboratorio Zanichelli di fisica 3D in realt\u00e0 virtuale per Meta Quest che trasforma lo studio della fisica in un\u2019esperienza immersiva e interattiva.\nL\u2019utente pu\u00f2 accedere a una serie di laboratori virtuali progettati per esplorare i principali argomenti della fisica sperimentale, dalle grandezze fondamentali alla meccanica, dall\u2019elettricit\u00e0 alla termodinamica.\n\nAll\u2019interno degli ambienti VR \u00e8 possibile utilizzare strumenti virtuali, effettuare misurazioni, osservare fenomeni fisici e verificare leggi e relazioni matematiche attraverso l\u2019esperimento diretto. I laboratori includono attivit\u00e0 su massa, densit\u00e0, forze, moto, oscillazioni, piani inclinati, circuiti elettrici, legge di Ohm, caratteristiche volt-amperometriche e scambi di calore.\n\nL\u2019approccio immersivo favorisce la comprensione dei concetti teorici, stimola l\u2019apprendimento attivo e consente di sperimentare in totale sicurezza, senza limiti di materiali o spazi fisici. L\u2019app \u00e8 pensata come supporto didattico per studenti, docenti e ambienti educativi, offrendo un modo innovativo e coinvolgente per apprendere la fisica attraverso l\u2019esperienza.", "short_description": "Un laboratorio Zanichelli di fisica 3D in realt\u00e0 virtuale per Meta Quest. Sperimenta misure, meccanica, elettricit\u00e0 e fenomeni fisici fondamentali in ambienti immersivi e interattivi. \nL\u2019app consente di eseguire esperimenti virtuali realistici, raccogliere dati, osservare fenomeni e comprendere le leggi della fisica in modo pratico, sicuro e coinvolgente."}]}, "developer_name": null, "developer_privacy_policy_url": "https://my.zanichelli.it/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Zanichelli", "support_website_url": null, "website_url": "https://www.zanichelli.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26539732442336351"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_1449829446599213_3478771048986771003_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwDJwvzGbBEQ7kNvwHS7BPF&_nc_oc=AdpRuEK_aY7I1CJXD0ezsfANhPMM5hsVT2D9W-7yMks1dugDxzMivYrbNoowCV6Dzds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dty50sTfAqLs9IKkGpW1KHoGema0-2ZIb2UzpU9zREw&oe=6A048FA9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D Physics Labs", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1772794020, "lastRevision": {"nodes": [{"id": "25915409701435298", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25915409604768641", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2935367006669218"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1989638532437977", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laboratori di fisica 3D", "keywords": [], "long_description": "Questa applicazione per Meta Quest trasforma lo studio della fisica in un\u2019esperienza immersiva e interattiva. L\u2019utente pu\u00f2 accedere a una serie di laboratori virtuali progettati per esplorare i principali argomenti della fisica sperimentale, dalle grandezze fondamentali alla meccanica, dall\u2019elettricit\u00e0 alla termodinamica.\n\nAll\u2019interno degli ambienti VR \u00e8 possibile utilizzare strumenti virtuali, effettuare misurazioni, osservare fenomeni fisici e verificare leggi e relazioni matematiche attraverso l\u2019esperimento diretto. I laboratori includono attivit\u00e0 su massa, densit\u00e0, forze, moto, oscillazioni, piani inclinati, circuiti elettrici, legge di Ohm, caratteristiche volt-amperometriche e scambi di calore.\n\nL\u2019approccio immersivo favorisce la comprensione dei concetti teorici, stimola l\u2019apprendimento attivo e consente di sperimentare in totale sicurezza, senza limiti di materiali o spazi fisici. L\u2019app \u00e8 pensata come supporto didattico per studenti, docenti e ambienti educativi, offrendo un modo innovativo e coinvolgente per apprendere la fisica attraverso l\u2019esperienza.", "short_description": "Un laboratorio di fisica in realt\u00e0 virtuale per Meta Quest. Sperimenta misure, meccanica, elettricit\u00e0 e fenomeni fisici fondamentali in ambienti immersivi e interattivi. L\u2019app consente di eseguire esperimenti virtuali realistici, raccogliere dati, osservare fenomeni e comprendere le leggi della fisica in modo pratico, sicuro e coinvolgente."}, {"images": {"nodes": [{"file_name": "banner-di-copertina-3000x900px.png", "id": "1976133187120801", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818852_1976133193787467_3742693911542954879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enV3DLNFzO0Q7kNvwFyxZ-_&_nc_oc=AdrQAPLv1qHX5NmUImxxt168D-thpPhaA56-Uq7a2R2oKZrJxaI5G557Xd7N43msKno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nEeYwkXwSMZQmqyA5Vx07QVfnc33P-bM-LqlCByNYmg&oe=6A048AAA"}, {"file_name": "verticale-1009x1440.png", "id": "1858101284909744", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828816_1858101298243076_292410156732293931_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JxtG2vjSgAQ7kNvwGsN_t8&_nc_oc=AdrOAwnhaY25fJtvvj-oJXZPiqBYlcS29NiLRCIRl7oLf5a1DT9ekRomYnPWSQSy4yo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-eJz4ykdzG0OixArrHsyT6M6vSRrpv3IxV63EhDt1Gw&oe=6A04891E"}, {"file_name": "quadrata-1440x1440.png", "id": "1449829443265880", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_1449829446599213_3478771048986771003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwDJwvzGbBEQ7kNvwHS7BPF&_nc_oc=AdpRuEK_aY7I1CJXD0ezsfANhPMM5hsVT2D9W-7yMks1dugDxzMivYrbNoowCV6Dzds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rO1KV9h-d8Q9S4OLhB7pGg36SBr5zKgiRz4T7I0bDPA&oe=6A048FA9"}, {"file_name": "logo-zanichelli.png", "id": "1418916343314195", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308090_141891634664
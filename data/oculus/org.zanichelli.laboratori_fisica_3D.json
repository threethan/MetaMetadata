t=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLlTqTvPGxQOmfdQNv2oqsC8DVX1JMOCKo6Jz3YQopBg&oe=69D11399"}, {"file_name": "5_screenshot-app-5-immagini.png", "id": "938342022207159", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825503_938342028873825_9099555711940098515_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV0ki2YKwvwQ7kNvwExNvoR&_nc_oc=AdrbjgUFsImEOtLxNHwkBVdgcTl3qc2QnrKjl1c2AmK_rk8QTsXcQlAFg819HMlA0E0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPmxY8uiNeyzlUc6ag2uRJMD-90nYxBNDGSpzcfmWhPw&oe=69D11209"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Physics Labs", "keywords": [], "long_description": "This Meta Quest application transforms the study of physics into an immersive and interactive experience. Users can access a series of virtual laboratories designed to explore key topics in experimental physics, from fundamental quantities to mechanics, and from electricity to thermodynamics. \n\nWithin the VR environments, you can use virtual instruments, take measurements, observe physical phenomena, and verify laws and mathematical relationships through direct experimentation. The labs include activities on mass, density, forces, motion, oscillations, inclined planes, electrical circuits, Ohm's law, voltage-current characteristics, and heat exchange. \n\nThe immersive approach fosters the understanding of theoretical concepts, stimulates active learning, and allows for experimentation in total safety, without the limitations of physical materials or space. The app is designed as an educational support for students, teachers, and learning environments, offering an innovative and engaging way to learn physics through experience.", "short_description": "A virtual reality physics laboratory for Meta Quest. Experience measurements, mechanics, electricity, and fundamental physical phenomena in immersive and interactive environments. The app allows you to perform realistic virtual experiments, collect data, observe phenomena, and understand the laws of physics in a practical, safe, and engaging way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://my.zanichelli.it/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Zanichelli", "support_website_url": null, "website_url": "https://www.zanichelli.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26139173429058923"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823270_1449829446599213_3478771048986771003_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn0Kx1OIgxUQ7kNvwHiCtoz&_nc_oc=Adqm3ngFGbVHDIPxHekb5s84MLFF2oRcDVREhiEUGN5OU3w9KNEHSjLjOSwNSCcvBK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9kxj-J5tccTVumhTYokMbpk570dmHX7Va32k0cCMjDg&oe=69D0ECE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D Physics Labs", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1772794020, "lastRevision": {"nodes": [{"id": "25915409701435298", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25915409604768641", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2935367006669218"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1989638532437977", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laboratori di fisica 3D", "keywords": [], "long_description": "Questa applicazione per Meta Quest trasforma lo studio della fisica in un\u2019esperienza immersiva e interattiva. L\u2019utente pu\u00f2 accedere a una serie di laboratori virtuali progettati per esplorare i principali argomenti della fisica sperimentale, dalle grandezze fondamentali alla meccanica, dall\u2019elettricit\u00e0 alla termodinamica.\n\nAll\u2019interno degli ambienti VR \u00e8 possibile utilizzare strumenti virtuali, effettuare misurazioni, osservare fenomeni fisici e verificare leggi e relazioni matematiche attraverso l\u2019esperimento diretto. I laboratori includono attivit\u00e0 su massa, densit\u00e0, forze, moto, oscillazioni, piani inclinati, circuiti elettrici, legge di Ohm, caratteristiche volt-amperometriche e scambi di calore.\n\nL\u2019approccio immersivo favorisce la comprensione dei concetti teorici, stimola l\u2019apprendimento attivo e consente di sperimentare in totale sicurezza, senza limiti di materiali o spazi fisici. L\u2019app \u00e8 pensata come supporto didattico per studenti, docenti e ambienti educativi, offrendo un modo innovativo e coinvolgente per apprendere la fisica attraverso l\u2019esperienza.", "short_description": "Un laboratorio di fisica in realt\u00e0 virtuale per Meta Quest. Sperimenta misure, meccanica, elettricit\u00e0 e fenomeni fisici fondamentali in ambienti immersivi e interattivi. L\u2019app consente di eseguire esperimenti virtuali realistici, raccogliere dati, osservare fenomeni e comprendere le leggi della fisica in modo pratico, sicuro e coinvolgente."}, {"images": {"nodes": [{"file_name": "banner-di-copertina-3000x900px.png", "id": "1976133187120801", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818852_1976133193787467_3742693911542954879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Asg_UlRAVUQQ7kNvwGb4OQe&_nc_oc=AdrCLaS7ib44og_0ff7841Lg5-aCb8YYhC1K4bgoLgoa64YGxQmPrM_Bnk85A7iaUpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJYC9F6R-zMLPaBLPkHrIHBxvxkZq5StqksmaCquXKPg&oe=69D1202A"}, {"file_name": "verticale-1009x1440.png", "id": "1858101284909744", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828816_1858101298243076_292410156732293931_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2zK4V6yMOIQ7kNvwGutpt9&_nc_oc=AdoycwYwz3DTaUOF90AHUWlyM4ny8oVrggwrQrOC9uOtj7mj_mv9doTm_ibe6QGCjyU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKckE1zYpWDIBjLKnp-D7Fjl6INME6yoi7sAqJXKiBwA&oe=69D11E9E"}, {"file_name": "quadrata-1440x1440.png", "id": "1449829443265880", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823270_1449829446599213_3478771048986771003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn0Kx1OIgxUQ7kNvwHiCtoz&_nc_oc=Adqm3ngFGbVHDIPxHekb5s84MLFF2oRcDVREhiEUGN5OU3w9KNEHSjLjOSwNSCcvBK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9sH9mapUReXQCkS1WmXzaoAM8LE_nf71v474s6w_8ww&oe=69D0ECE9"}, {"file_name": "logo-zanichelli.png", "id": "1418916343314195", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308090_1418916346647528_8957485135722998772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ry1YUhfGSgQ7kNvwHsUDpM&_nc_oc=AdqX1do5QhUc9_WTWuz39o7xuhvwECtVyw2R-CFKKhMBkwDmEnY8XAfWYvGY6r7VRoI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss
-TYsm1ax1CC53VkLkVf-YAdjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxvGsMf30AiESdKZ7kMCZlyEatWr4Z05I1HTnzn2QA2g&oe=69BA8F97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Nitrogen Triiodide_Landscape.png", "id": "903454637922749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982652_903454641256082_5793174510247917846_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGejmBNUamYQ7kNvwGNHzUg&_nc_oc=AdlNaNTZCQeDRXqM8R9HIJHELtQF2S3bx4inQpwCOAcOl1tNEHXhziTnZpR6edZj-74&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzvg-oHfhswUGKIUsDLGiDin7rgWwI94AL75qcIghuoFA&oe=69BA88EB"}, "display_name": "Nitrogen Triiodide Experiment- ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "explosion", "science"], "long_description": "1. use an electronic balance to measure 10 grams of iodine into a beaker. \n2. Pour ammonia water into a 40 ml beaker. \n3. Add 10 g of the powdered iodine to the ammonia water and stir with a glass rod. \n4. Strain through a funnel into another beaker. \n5. Dry the filtered material on a filter paper. \nWhen it explodes, the purple smoke that comes out is iodine vapor from the sublimation of iodine. ", "short_description": "Experience a thrilling chemical reaction with the Iodine Bomb experiment. This visually spectacular experiment demonstrates the rapid reaction of iodine with another substance, resulting in a dramatic effect that's sure to captivate audiences."}]}, "developer_name": "ContentsDa Inc", "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
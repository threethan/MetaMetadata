zlTWFpy1d5z3h9xeaA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuitpIsveTxexRmCmCAazh85Tb-GS9x9I-BCad3fbpnUA&oe=699841EB"}, "display_name": "Nitrogen Triiodide Experiment- ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "explosion", "science"], "long_description": "1. use an electronic balance to measure 10 grams of iodine into a beaker. \n2. Pour ammonia water into a 40 ml beaker. \n3. Add 10 g of the powdered iodine to the ammonia water and stir with a glass rod. \n4. Strain through a funnel into another beaker. \n5. Dry the filtered material on a filter paper. \nWhen it explodes, the purple smoke that comes out is iodine vapor from the sublimation of iodine. ", "short_description": "Experience a thrilling chemical reaction with the Iodine Bomb experiment. This visually spectacular experiment demonstrates the rapid reaction of iodine with another substance, resulting in a dramatic effect that's sure to captivate audiences."}]}, "developer_name": "ContentsDa Inc", "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
4Ki-j3hDHBOsHxkqQOyDJo1nk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyElT3k-Ufwl2mdTiB7a8-IZfvYW92gWfJ-wpoPE7En9Q&oe=69BD3297"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Nitrogen Triiodide_Landscape.png", "id": "903454637922749", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982652_903454641256082_5793174510247917846_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGejmBNUamYQ7kNvwFqqI5T&_nc_oc=AdlAQ-La-7W6Rqr17mX6UwFdXBO5W2PRSIO71xK5HFhzi0tkNent1cy2v4vPkuS1uJ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoA_WbL2GdR18ofxwfrkBesf8zzG1dwtrOAEKRjwDfXQ&oe=69BD2BEB"}, "display_name": "Nitrogen Triiodide Experiment- ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "explosion", "science"], "long_description": "1. use an electronic balance to measure 10 grams of iodine into a beaker. \n2. Pour ammonia water into a 40 ml beaker. \n3. Add 10 g of the powdered iodine to the ammonia water and stir with a glass rod. \n4. Strain through a funnel into another beaker. \n5. Dry the filtered material on a filter paper. \nWhen it explodes, the purple smoke that comes out is iodine vapor from the sublimation of iodine. ", "short_description": "Experience a thrilling chemical reaction with the Iodine Bomb experiment. This visually spectacular experiment demonstrates the rapid reaction of iodine with another substance, resulting in a dramatic effect that's sure to captivate audiences."}]}, "developer_name": "ContentsDa Inc", "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
A&oe=69E0EFBF"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNiSthBK2cQQ7kNvwFqFwgS&_nc_oc=AdqClSVYHVCetOm8d4S8KksnL2dDhqy0lLNgiWp4DTakYqyde-nSMDCE1QWsgRv3eEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FBMfhsTkPvv2N951lRUBQRZDCMCVZXKkN3SHCTawSbg&oe=69E0DC3E"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyVwY7aVaR8Q7kNvwHIWY5G&_nc_oc=AdoE_B0rKdEuNDkrD0_iVFfUmL56VmIOGmsTmwRFKoDne-Bjr0xDRLS-U3mOSNOuaX8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IJD7s3r1AkpBZwMViXSa2F92XtZT1x5eouhVQT7FGDA&oe=69E0F030"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjw2388h0zYQ7kNvwGG7mGb&_nc_oc=Adrfe-9zajljsTqbiCmxqPx3kEOtNSzLTGD-79b1hrnO4F3MHv3fSse13r7XVHVfDws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OvT5tCupThKSEnn3Y0reFPHgKYiyF3Tajj12fD5CSHQ&oe=69E0CBA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
CjG1Osw&oe=6A8D6585"}, {"file_name": "shot34.png", "id": "886872056567213", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974828_886872059900546_8861963412351067565_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4PbDdvCsJMQ7kNvwHx85nz&_nc_oc=AdprlFb1SG8Ic0_BkNTWB7Tq3Tuy2TuLFaOMD3Ex2o7p6Y_xuqVf4Fgm9phK7RmC_9g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcOstZvQ8hYkwrgsF9NP0pcNm_DaUNFhOBucKFysFyrA&oe=6A8D9772"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape3.png", "id": "786866776676088", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984445_786866780009421_3311280814611894890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceI-sLQauAgQ7kNvwHPpTv8&_nc_oc=AdpfPrLJ5fvuEGrlR1WLUfPYT2itxbkjJvpa5wJRKp0x0H8QcCdqjcRaQNStWmYsGsA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvabp1ZL0yEfx8BYu0m-5EMg3RqCVppVfD5pW17Ci_Pw&oe=6A8D7320"}, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "develope
w&oe=69DA583F"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSXN0lYMmm4Q7kNvwE6ZPes&_nc_oc=Adra4Rk8HCjO0oSFKewMPJjFBoxa970gMXTgZ1SGgOnIc-R23jLPVeuATajgqcLSwfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3f_nGX-ICQCnpOR7SUywRM2LDwhGnIt1USkerfceYu1Q&oe=69DA44BE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnbgk47UO0wQ7kNvwGpP2hF&_nc_oc=Adpmdq9yIeTvctxCI7Nv2DA2p41H0Ts-c5Sts29TKn1BypGmdmVLTjJvki5YH65Nmb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hdJx32BRh15M1jKtq8jjiYHCL5U-3tAMqxYrhjXfy4Q&oe=69DA58B0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hp7uYMuq99YQ7kNvwHBwNMZ&_nc_oc=Adqwhyj9Jx5MPTIppBZXYHi848Wy7Le1uF4m7q6vhdeG2ueTczwQPBH2hJ1nkIxhxDU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pQjtxSWTRArL8-EcoHARXCe1KifIJK700XOSjykEcGQ&oe=69DA3424"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
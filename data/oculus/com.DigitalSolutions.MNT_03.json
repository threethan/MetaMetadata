3.png", "id": "1185691760012412", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N_jlfO5tCIQ7kNvwEdrNY1&_nc_oc=AdmNANEYAtkHJX4W8N0nmqjbQrPMV3BsmmRiYMXCgIfLr146xfzbXy_KuZxfsgDukIo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCXOz6B8ojDtEjzeEdbdcLeqvjk_SMsz69BQIMHHqt7Q&oe=69AACEBE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPM_UbueXYMQ7kNvwHLEopi&_nc_oc=Adn4lPrq_6TXNpPFBJxK51wBvRrOiwz0mVxj9glx6m2JnY7ErRdTn9n0eUtneR7a8ng&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHEYw_1XDy98a4BUS-OubpHRA2GrXZT3CiI_pH-JiKRg&oe=69AAE2B0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I--eLam0hJ0Q7kNvwH1Xyy9&_nc_oc=Adna2EeljdlqST49BdEFARkYq4TVZ-hGfc_XC5kI4bOqiE0q6XJIE1BdUzukkmni-1k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOMYc_9-Crt4xNASC3k_-MiqhtFkqWz12FMh2PVWU71A&oe=69AABE24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The V
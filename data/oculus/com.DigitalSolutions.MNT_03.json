A&oe=69DCFB3F"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzCTRMLmY88Q7kNvwHCwlI-&_nc_oc=AdoJmPfIeI42yNdQpfj1a9qBfPmUIbeZmYY64WRru-OFPwIq_SfGAntqL7iwKGzqW-g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AJReJB1-zCLEnAY3lHv5S0biHN-64iovfx-5tgE0YFg&oe=69DCE7BE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnbgk47UO0wQ7kNvwHHapb3&_nc_oc=AdoFK3dJamxE-TMru8RdgciVFVo3Fw3e7HN99bUzCySQQm0ytz5-B5YzlK9miKXNc8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wdbgAuOaEhlLs2hPDfD07H5T9uwRr2YPD2aCg1XuGbw&oe=69DCFBB0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gSKtzys5T8Q7kNvwFfsKIA&_nc_oc=Adpipa6-tBKioC_ajLQZvf0BDJNPtiWVY792CbSYQ_2SF59A8_M1QSQzTf-iueuWAtU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GQNkDpLUK6gmfGXa6Xve-8a1b8rffcYDJ3X1ZzKGBqw&oe=69DCD724"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
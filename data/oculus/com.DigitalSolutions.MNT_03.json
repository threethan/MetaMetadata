5BF05"}, {"file_name": "shot34.png", "id": "886872056567213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974828_886872059900546_8861963412351067565_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Pn9K0catqMQ7kNvwGlYhRu&_nc_oc=AdqJ5lzwhyb48bynF--JuSPKrKDQ1vrsa66gw_50YAe6kfBw6XGTIMP7c-E2Rxkj3oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqcVQ8dufL86Fo5Q1T0tuWhU90O_PDjzHmnK1olEKDMg&oe=6A95B8B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape3.png", "id": "786866776676088", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984445_786866780009421_3311280814611894890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5uFWmKIWx0Q7kNvwEnHB1B&_nc_oc=Ado1tTCjaHyEWH5S7znvEwJba1HYXy54XqBDjM-ARHcLX3L07G_rABE5Uo_nbVpygmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkb24UWL_bw5zlwOKKZPfk8zY7pwvyBJpv04hiA0bXyQ&oe=6A95CCA0"}, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service
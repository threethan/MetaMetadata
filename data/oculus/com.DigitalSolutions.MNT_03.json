Q&oe=69CD293F"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKQvr0kA6twQ7kNvwEHPiGn&_nc_oc=AdpQMOmRib73y2biUsceyzDu14Cv9q9C5KgpqKCJrjGlpu9pyhl9eq9Z5VpoBvuFKv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3OAhyN-uUYyhuHJGkaz3pusRza14pWK8m6QI_nEqHCw&oe=69CD15BE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p_2EwDg__kQ7kNvwHX0rnb&_nc_oc=AdpWBrcgFrePDl4xPbyfWBWHlFc_qiB1H8PfeFLEC7e2o77pbFCCyc8nhDmSta93Z1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycMmm3pLfrS1RjZjcgBQ-Ax5iBSpm_PTXZ5kMhgnAziQ&oe=69CD29B0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTIXFp8OlvsQ7kNvwFcAGgJ&_nc_oc=AdpyOJH_QbFpaN0cTgb6l2z24npq-TqliF8jGgfXa7UsDu4z97jVgWKP1IX4GtABLP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrQYAViCpfD_D-JILZF5pvYX0avmHYph8HmiRm-nK-iw&oe=69CD0524"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
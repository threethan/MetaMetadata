w&oe=69E2413F"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNiSthBK2cQQ7kNvwHv_Uo1&_nc_oc=AdpZ7BLxIWLoVXzfO1GukXocsKci8_3iC5_Uo8xvfyjREVvJaz4y3RB6DzRaXOR0Mkg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I_i7kflvnMGjxNYQP1F6eDMmMOuP_Y0V9sCs3936FhA&oe=69E22DBE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Im0NX6ppApEQ7kNvwH8pKw0&_nc_oc=AdotApEVMa7RnQsc6KjDKENeZLFuZztVO3JPzxDZgl-YsYcl4SlO3wAF5z-JVztExWE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Tix08GwcuKMO-Fxf62LPjnlnXHF0xwJIPG0az2AZlKg&oe=69E241B0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjw2388h0zYQ7kNvwEVEqCu&_nc_oc=AdpK1lxc-raeNPGA27_WOqIvk1cS6ukBWSaOoszJ22FT2YkLBPIrBf9tjnz4YS0ctUQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Es3IVl6_7gIFp5w8P-7hJBEUQQHNc3lSWgvJOYthCGg&oe=69E21D24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
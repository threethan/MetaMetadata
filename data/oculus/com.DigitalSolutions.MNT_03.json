Q&oe=69D26F3F"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M59Kz-vRxkUQ7kNvwFbHeFu&_nc_oc=AdrrCKnBDdz4KUMsUKcieydeS0F7MaZCO1xiKKGGi6v33wMFmq3Ly2PZkF1zmQM8dbo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0i6zolF55Aql6wWnhja7cxexfO85VvUuCEI2oT7CIQoA&oe=69D25BBE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg8ebW_HCN4Q7kNvwEBpjeK&_nc_oc=AdoW-2c1cLcoOdZRknrJc67naDlDcVUzMaUBIFR6SrQ6rMUzuJqzJnLJCooTTtvXRaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R9c4TrdtuGX_4amY_Ny1VgZlN2slkNgbi0ZOGgrdbvw&oe=69D26FB0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpWZgClX4c0Q7kNvwEkw2_6&_nc_oc=AdqTPIvYu3WNm9nBORpIK2pzA7VmluYp6r2_BXjjoE_f9ujSvfBbzeAKSypGHwF7hTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GtOo4fft9O6PF1oSl6amJ7m0T3M28Gf3BdbWP4-ly5w&oe=69D24B24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
w&oe=69CE7ABF"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKQvr0kA6twQ7kNvwHF68K4&_nc_oc=Adr3zZtt9fEwggwQawsaB_a-BmmjTnrncqTF8WtqLKAZxAVLxF4XVXaI79Y0KEnnXco&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgW0hZ7KYJMmG9g4F6OWeAIovA3xMzQcazeZMA5ecmqA&oe=69CE673E"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH0ESWfKr9YQ7kNvwEYdwPy&_nc_oc=AdrnZ_doabQKhA1W7btiUGKdkwz__UWFaZXvx4g-O_yJWhxLsUu5yyVqVL_f0kZQWeU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2KpQp6xq2n6ID64e35A5zZTN7Jl1Ofld9AlOlaFXHaQ&oe=69CE7B30"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTIXFp8OlvsQ7kNvwEnk6Zl&_nc_oc=AdpcjNNqLnMivqyT2ZRuGxO64fHBE5HRQTEKTJX9Cc36RUlF2V_3rCeGGG03WRQma6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE8WkVQZrycXyfwwFtGxT8mQZ5NTIGj6PKR64VacTBeg&oe=69CE56A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
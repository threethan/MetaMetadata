w&oe=69C5403F"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4txyqZH2ZoQ7kNvwHf61tR&_nc_oc=Ado5bQ7ATngoOw6TObrT1RCr990ZSYqO-UjipI4zCL9xT_QF0xPDs1m9Iy0gNiR7NdQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyApeIrWQ7csS6ITa_Lgwel0B64HBWqW6_GiGJfo93RWw&oe=69C52CBE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJHKJjzP6wUQ7kNvwEPMr77&_nc_oc=Adr-QRp4mi-LxuYhnmwOKbMfLdwgSiQ-1tBCrhCc86HukoTwY44Xkz9dL3LmDQNGdFU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGmZqH1oyGXWveJ1geMVQwH2ATX_HwPWoPum05-Ev_zQ&oe=69C540B0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urM2aPaZtXYQ7kNvwH5WMqo&_nc_oc=Adoi13-G0TcgW5QC1O01B3G5IqvZ3ci-0hgkKDzbGpb2KU9nVAI7vJCtTbbT-h6BcCo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHCps6Da1mXJ7vL8gafAdHjtBoNsT0m9F9tHHqJd7gMg&oe=69C51C24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
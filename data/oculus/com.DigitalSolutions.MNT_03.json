g&oe=69C3EEBF"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4txyqZH2ZoQ7kNvwHRcOcB&_nc_oc=AdoQuI3K_pPth0rlpbHKxHKAWpVUqNaFjJ4we5pvJK2FkIttITtUHuWfh3u3Z4tMSFQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLnps9wMyFUP1klJSOt5eEnWR9bEWc-YMJGNoMcqPd4A&oe=69C3DB3E"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJHKJjzP6wUQ7kNvwGQx0KD&_nc_oc=Adqnm_nYJzlVwe0tHlW0WnghPYUFifmDqgk0W-f1UfsJHmKKZK6dP7YlHNX_1ctk-oo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrGkWQcdgelACb07r8VgvvuGEwsUQawrhpFI8AK9XbjQ&oe=69C3EF30"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_OzM2ceCbAQ7kNvwHp_k7V&_nc_oc=Adp2ScqILBlmFLCiHMFpF5ZuLop-kkRL-rOsSgXnWRg0_VOCiAIvI5cNdXyErSmbcbw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzp7Jcii6JnFkE0L4nIoBNmGU1jqdZfklJRcIyiM-qwXA&oe=69C3CAA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
A70C5"}, {"file_name": "shot34.png", "id": "886872056567213", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974828_886872059900546_8861963412351067565_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCMsnHwWcAYQ7kNvwGTzP5y&_nc_oc=AdrRQPNKkqDmRSBLF5RC_GCPNUiFnd4d4sRexLL7gxN5RoYvsiuOub3G_AP7uAwKOR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbak7sYPJt955DoQuUioxzDjeAV54K-gG5OID9X7X-3A&oe=6ABA6A72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape3.png", "id": "786866776676088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984445_786866780009421_3311280814611894890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Id0-6tdUNwgQ7kNvwG9Pg59&_nc_oc=Ador5PENRWnWo_LLjFmX4dSzf_bGEQ2jWyfdsbamSL3JnYWghs9_v4Anv_iLVLpt0AM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5cTUOmdx2J5BfRtV4E4_Z_VOAIWfk1FTPzrn__JQXRA&oe=6ABA7E60"}, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service
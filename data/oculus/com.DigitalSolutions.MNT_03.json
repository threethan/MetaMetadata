7525519431071150803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u00D_JKdPysQ7kNvwFrF2od&_nc_oc=Adq2HS0O5kpJTAIc0TWOZghqbVi22-g4CTgDq182T-Zcc2z6e_WCWawb-7s2hA6W2vM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeqC7COryjy_LRrQQd8u4oGG6TYojz6wsTTSa_9TvH1A&oe=6B0DB785"}, {"file_name": "shot34.png", "id": "886872056567213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974828_886872059900546_8861963412351067565_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV2Xkk0HNMMQ7kNvwGHOyzj&_nc_oc=Adr92K9WHM50EkTanXbrzNyAalF06hy_ZtGKXQv7-jDNUD0texEB-pEURnDkMTCgxmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPkRBItvjZIBDeBrvBimpRf7M6e8_c-im1Dbf5rthgUQ&oe=6B0DB132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape3.png", "id": "786866776676088", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984445_786866780009421_3311280814611894890_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWmPks7ulk8Q7kNvwHBQJ2I&_nc_oc=Adpin-cQMR3QUre8qJr5pHRQf_MEaTfjS8VEMtUQGiF1fNtE-hgGQ-C4v9nAB-mWG2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT39cOk8mn6z2-EWxICBjFRmy_ZTXLEl-Jg-ZBZO_tRRQ&oe=6B0DC520"}, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7143309339120384"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4188942454653010"}, {"status": "PUBLISHED", "id": "1421624485903507"}, {"status": "PUBLISHED", "id": "1399657957336029"}]}, "baseline_offer": {"id": "4188942454653010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776157440, "status": "PUBLISHED", "id": "4188942454653010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7143324852452166", "version": "1.0"}, "id": "432517745874561", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7143309319120386", "is_
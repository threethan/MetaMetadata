A&oe=69DE4CBF"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzCTRMLmY88Q7kNvwFwMpfU&_nc_oc=Adr-YQTNtYrvGs4UdFaGczPnuuCkg05sI_NbmRc4F0p8oP1ofSzuT1nUOWJBhYb7m5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZmmBqCHrkV6t3n_5arBtxDx-HJ1V0BGjnVH3fcn_OZQ&oe=69DE393E"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyVwY7aVaR8Q7kNvwGsMcWV&_nc_oc=AdqT5Dcz6KuV9cAq93OXnThJLuzJHZz0zDDrXvg4tOBzwOrEQIX0KmkyIFctEy6SN_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x7IhcrVRwi6TWh2CAbAGNsCzQR5BVd0kqhcWVMaOK5w&oe=69DE4D30"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gSKtzys5T8Q7kNvwEEScId&_nc_oc=Adqah6MDH6FKcZdgKnrAyI7cgc-xkRzJL4i1UBXPXSUQAh-lRn5tURGIVEJ_MDx1H1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ikrKNTy9hSvPnxQFld7y5RyOksTvJaT5naNR3KxFRbw&oe=69DE28A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZNS3o-jkdYQ7kNvwGr-C2e&_nc_oc=Admf6yRn9WiXhttK2VvB0qzSojsNXy0MGfUMWsFCvLwyBqihdH1EyxZQZgpX2fDW8mY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvzO9HAORAIDt5rgobwUsuAU1HOOjJZ2gCDuIjDEAfUNw&oe=6999AB3E"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zsTxqmUTYkQ7kNvwGioHCt&_nc_oc=AdnViLUMUEzF6LpnrZEqoTyedsDC-fxmvwzan7Zc_wlmvkp_xweHqI87P8VZPq8oYlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWNeu32S1xO2AWEca2npp_tHDNWzqGzHRerJC1_5uasQ&oe=6999BF30"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3FFweKtpm8Q7kNvwE4wWbk&_nc_oc=AdndPKcFm5H4zKjMKjnZSm_bfUhBU_zxV4FsxlyHvJyXc20ZtcNo3QD3DHZfFXYF97Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsuMch2dvEVA176vPg_oUqRZrOz7fDuXShbSjJNLdv2VQ&oe=69999AA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience
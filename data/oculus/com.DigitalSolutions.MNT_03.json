F88C5"}, {"file_name": "shot34.png", "id": "886872056567213", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974828_886872059900546_8861963412351067565_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqy7gur_xgMQ7kNvwGSxfY3&_nc_oc=AdqRLky44jED9Fug0AjMelmqYU_gRUsVpgkt_3O372NxUon64iU6Kn6R0sW9wuqa7DI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuBCvYyPCcwzbk-CmoMhO1RMlDEVYoKtS_IZXG9_fooA&oe=6ACF8272"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape3.png", "id": "786866776676088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984445_786866780009421_3311280814611894890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIBLRtNO2u4Q7kNvwH141xV&_nc_oc=AdqjTzBic4rw35HlXga-jVpaDOMUSHo7wSZObzLv095Wb_oPZ4ej009CqvNwuIvhY50&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0rhL3Big0vNqaB6e3ijDgm4v9c6LJBQtLLXGXjbMUHA&oe=6ACF9660"}, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service
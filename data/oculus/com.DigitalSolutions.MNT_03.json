hjDcx3DeKf8Q7kNvwEGDii0&_nc_oc=AdoFf5MJga4XZPdViUKrejxFye_MGaNeR1YpyklAmy5GBFe2a6O0EeM3lwWAx_U0RZM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xixbTDnF1Yx1PrDwXC-ArecJHwpbPYSqWyICR6twz9Q&oe=69F20672"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape3.png", "id": "786866776676088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984445_786866780009421_3311280814611894890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6psYjGMNvsQ7kNvwGLuz62&_nc_oc=AdrqibVYWCbx21hA9lftERFA51f_NBBhrFvWuoNwln2g0HM_qDyK0jXxc-_jrjqHsdI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af37NI8K3cawNm1vgza8SArWHCnCq3bEsPvk94FRAVzMFQ&oe=69F21A60"}, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362
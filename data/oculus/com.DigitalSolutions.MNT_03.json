.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYyllWbyyRcQ7kNvwHjDpr7&_nc_oc=AdkYOf7zKQWaPa8LwziC_MdFN4ljoicneN7WqpkQTHjTuGdv6Me_vkVmQ3C108XlIRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftHlpshP31Q44OwQ_wfEHVuMwRX7v4g29gxcbSB04PsfQ&oe=69A4373E"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuYy9qZL2xMQ7kNvwGpQMvd&_nc_oc=AdlH4EMjRB7KnwKs6szVZRCj-SSK4uiz1zQAIEUyeBxSoaL4q4OjE8jsWKkwXUzlklQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvQO4XMdIlj59LT7YHwZ07ke_USX_gtIDZccMauf-5oag&oe=69A44B30"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f5LPM_yWS8Q7kNvwGnX5ja&_nc_oc=AdkAGcO182xbxszl2qZEjs8oybTBJ9KCblJo1tpBsohWNhhwY0Li181EZBkdYLeTDE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftch4p6trMlS0kpuYy2O3-ZR6VZVld4xQ4pRM3WZUtScQ&oe=69A426A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience
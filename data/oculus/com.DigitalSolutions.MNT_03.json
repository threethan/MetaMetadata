.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWh2PcHyvc0Q7kNvwFnC0vy&_nc_oc=AdnuPx2UyHTGzWp5FzUZk5Ujp1MSjolJqzX_q7K84a_UcQbIG67k-YWysqj8JmpK21w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftU8z0ss3PN9KNeUb4bnvkrktJVxHaTLhbmIZvNgSZQtQ&oe=69A1943E"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLnqSHD4LIEQ7kNvwHFunPd&_nc_oc=AdmbvJbEVXjDUbIZsKJA-i9J-1due1igitGbj_0GzMYdiQGxtCzbHkoTubxnjqiaRqE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu1BOTA-G5fKNf8Fuj2QL9bPFINlPccP5lGupc_edGjKA&oe=69A1A830"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f5LPM_yWS8Q7kNvwHhvxda&_nc_oc=Adlcu4dJ9EE7Tq2-_2itjOCfeXoDGYPZv7eFW5UVw54RItVmJVmO5XsdJyisAAQuIoc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsQwRnP1GfBYD1TblubQSpIM4DAxLMQWvRdmqUnVgsokg&oe=69A183A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience
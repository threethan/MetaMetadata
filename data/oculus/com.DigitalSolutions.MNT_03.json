w&oe=69CBD7BF"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKQvr0kA6twQ7kNvwFhaq8d&_nc_oc=AdpnVMMotHjy3JKVVKIuzOsNmEz6AXVrATffdgpxGYaiQUmbvUyJnIXfcV50u3D5eyk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4YBA5KLkiwR5Defu8qidCG0aTSeJCAf5ki08kTx4Leg&oe=69CBC43E"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p_2EwDg__kQ7kNvwFzulLO&_nc_oc=AdrergUaySr5jH1N2Zhr1-pVBXk7rfUMYodJRRYJFyuleJ__EkrgT1MiozZWgS_kX3s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwUQedkaDuWm_GCKoZ2yvY1p-RtsJwiZfxSKoIClq7Xg&oe=69CBD830"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV2aeJsf6QwQ7kNvwFb0N8X&_nc_oc=AdrrC4nka4d-Kp57MQL07audzyJAbbNXrjlI1BguEnSJpZegqy2HQjpbhi8DGf-21mY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3v2KdYqaHl8VSgyVu6JEUjhXprTK-3C2gTUzgzULrCw&oe=69CBB3A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
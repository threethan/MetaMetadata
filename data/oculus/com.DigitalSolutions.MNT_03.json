w&oe=69DF9E3F"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNiSthBK2cQQ7kNvwGe3_h1&_nc_oc=AdpyZuHbNT_9AHd2xMY4VPT456ZKqVKvo3IpquVeTrl_4lI1U1sKwERSsEov62S9XJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Fejs4eoSePknuAF2qB3nrC4KhavBWRk1AaDHDbv2wsg&oe=69DF8ABE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyVwY7aVaR8Q7kNvwHJKBjE&_nc_oc=AdpRzXMiuvKY_NeZwt4pvpH6ht7N3zQrVTnTbfGStGqHijo94254lRQbamq9U5puG4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tRooLk8nqhgoYTOjj655K-cKxbCDLiwyop_6az52bFw&oe=69DF9EB0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gSKtzys5T8Q7kNvwHFtq37&_nc_oc=Adog14UpvVK7V2d1UTs7VipqjZtT48unFiP4QIaRzfIUClxnldNG3k4zyl04O5kkeAs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-ynaTaRP-DMFmIRfUJ-mDBzKzLsFArSmaV8wYuU5Erw&oe=69DF7A24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
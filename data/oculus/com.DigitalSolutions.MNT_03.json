w&oe=69C29D3F"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xh18-9WZcFYQ7kNvwF3XTDZ&_nc_oc=AdqCl5ON9F99w8AwAVuCqRv5EOBnTLFSL18EVfqMpMC6jrFLalE9srmydKqaRwkt_zY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnvBre0Fbx33XZrDF1GX_wpT5sfRDVyNaK68JgSQKPzg&oe=69C289BE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJHKJjzP6wUQ7kNvwGLQU9x&_nc_oc=AdqSt6waEdahb3o_6Fq65zOsQiuL580GKNW7sg9fS4c8IVJcY30GhFcrH3aQiIEcluQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0x8LyRQWFawJc84Vh_X_bQQxJYgb0UdaPV3tObN7Gwg&oe=69C29DB0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_OzM2ceCbAQ7kNvwH3feyW&_nc_oc=AdqiiRH9VSdYZuis56NCypghemZU6snKAO3rvUjwZvLfYRb4GJ8w5x4GPGSBZUNlK1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHgqFLbKw2aDZPg-gwHloq98iAAm-RfEIQFB-UKzhRCA&oe=69C27924"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
g&oe=69E392BF"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86pkvxuV6FIQ7kNvwGxjiwz&_nc_oc=AdqXBQYdD22d9VNE_tcx4B8MAuhclItxFR89XI1WHntLyj4h8EzXjQRXSzlct5ctQsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_cIieoYufo2pKoYlJS6Oq2TXQYvLO9EtVYFicsCxBKw&oe=69E37F3E"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Im0NX6ppApEQ7kNvwGm1LAh&_nc_oc=Adp4Dwn99KAcwvgvdM-XIzQFL2KAoyXEO-Vm4FIywHYwwV4TN3UZamuropZx9uUTHKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vuf1vzomlgnGNIxg6xbieXpe1MFSd710T0-5EaqExYA&oe=69E39330"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjw2388h0zYQ7kNvwEIh1hv&_nc_oc=AdqbE3dC_67pBrCJXxS0ZMApEAk0slITDrd-ejK8-JPK93gFf9T5fWHOTLqsW9yfyPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m4dwF_8bKSVVftpKlzzfqg-LQ4f5BoS5X_8rLppIEzg&oe=69E36EA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
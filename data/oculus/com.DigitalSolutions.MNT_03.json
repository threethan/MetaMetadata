0DA45"}, {"file_name": "shot34.png", "id": "886872056567213", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974828_886872059900546_8861963412351067565_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EmZUG0RtHUQ7kNvwHw7V3Y&_nc_oc=AdqNYNgPc3HboO_5APUPQsIL2i5ViSSF-x9GrqR-y3LlYgOK_Bpc2IukG458crqIxFM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZc29ISNUnzUZ8SU1J3pBUv_FtXhweBZLut8nDf9XqSg&oe=6AD0D3F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape3.png", "id": "786866776676088", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984445_786866780009421_3311280814611894890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJrI4DhSuZIQ7kNvwHYyr0f&_nc_oc=AdooPwHF0gGSjEqRoDEuG7z5psDwzXYfmtsAykivIAGfpgZzajSap6eEO6xFOXqdSDk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs3bh5GYRWGl-FrgVFSHgAYksfy_tMU0b63eC6eCxaPg&oe=6AD0E7E0"}, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service
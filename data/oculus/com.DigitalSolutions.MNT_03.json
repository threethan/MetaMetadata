Q&oe=69C7E33F"}, {"file_name": "3.png", "id": "1185691760012412", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392314_1185691763345745_6741372949028790467_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEF_5TqqpWYQ7kNvwFWuULN&_nc_oc=AdqQKQIDR_9TQPvf0fPMd92WFcLd3r-GILd5RCUBbQq7tXSx8yO6XPMz16MNexR40t8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfEccQpSWGhooeI1X40wCGaGVLAgmANCgrNau8TLZ1-g&oe=69C7CFBE"}, {"file_name": "4.png", "id": "1218908323239789", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827665_1218908326573122_3605319583200557568_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELw2IQR5os8Q7kNvwFWi_Z9&_nc_oc=AdorMn9KnjqpBhdCjYgpKWXOAd5sOSHxtBFwkJQOX__o6GCqM9AZLTkUu1dQFt-8j5M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCSJefyrAAt0QbPiLaZJT6TkX_Z3ToOTBcSc-y8mr2yw&oe=69C7E3B0"}, {"file_name": "5.png", "id": "716938647660177", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393333_716938650993510_8481534992517515346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urM2aPaZtXYQ7kNvwGFIchh&_nc_oc=Adqh_hf6gaQXcmw0H4NIkRRGX507KH2vMLUjs5OnXFvhj-0uFMR6XmROFzDsndt0ASk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3QZXkwNk3Jojut3w9VvLm22Ff-OyNDVd-0qDwTZD9gQ&oe=69C7BF24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 3", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia'
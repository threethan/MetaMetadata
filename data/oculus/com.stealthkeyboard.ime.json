=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNIf2_PTUl2xBz3QMtnK98BNO-ukM7O0DJ90ZCjIoPRA&oe=6AE20BE1"}, {"file_name": "screenshot_2.png", "id": "981895207653386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593858738_981895210986719_7536809007093256079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTmHeA58Q7QQ7kNvwEtT8_8&_nc_oc=AdpMaQa7f0wGMfKZlCOQZEFePHLO8-VxdIaeS0gw5BiECX8jkxIMlD0KiyDila0GtHY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOihDM2vLOtVWKDSvId9yy_YWtwTl6B-pA6MtdRyYZXGA&oe=6AE21304"}, {"file_name": "screenshot_3.png", "id": "1724623042421869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624069_1724623045755202_4066682952889827325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P0Q_X0pnSAQ7kNvwEGOvoc&_nc_oc=AdpVFE-JhKynsEHPJnoSJ4pvsQY9X_qT77XGewjpFb3tdba1DXR5yjxHSMA6q2DYPDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx0nZoA5zHT96omY86uAiBB4JUnh9GukLgsbx-wNb2uA&oe=6AE216D5"}, {"file_name": "screenshot_4.png", "id": "2242451119650813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624619_2242451122984146_2046537726662352518_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKrpl8jKEBAQ7kNvwHLm0a9&_nc_oc=Adp3dk7dHfAyQYUD3jw3SP36W__FT_i9_B8MaumMnZysLj8xeOx0jfb4JkXeICGkPOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjNP6dWFuOQU-cLnDbvNV35B2QT_jqY8MbiR_wbAlYxw&oe=6AE21E01"}, {"file_name": "screenshot_5.png", "id": "3300705836984448", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620414_3300705840317781_1304812412331926804_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GdtnGCxWMUQ7kNvwG-B5VZ&_nc_oc=AdqjAkI9BQtWAAbjItbXNMHiUIEQrO5V61AqjKfHRTcq_qLj9sXaZrMnkE5wm5ZTx9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBfS4TgzvWGnZB8L8RCWdmMtJH4hK7TrmveBCqdl7rkg&oe=6AE1F9A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stealth Keyboard", "keywords": ["Japanese", "Keyboard", "IME", "Typing", "Input"], "long_description": "Stealth Keyboard is a distraction-free Japanese/English IME optimized for Meta Quest 3, 3S, and Pro. Designed for physical Bluetooth/USB keyboards and on-screen virtual typing.\n\n### Key Features\n\n* **Zero-UI Inline Typing & Candidate Toggle**:\nHides candidate windows to keep your VR view clear, or toggle candidate display on via settings whenever preferred.\n\n* **Phrase Palette & Dynamic Macros**:\nQuickly insert frequent phrases, business greetings, and templates. Supports real-time macros like {date} and {time} for automatic timestamps.\n\n* **Virtual On-Screen Keyboard**:\nType Japanese smoothly using Touch controllers or hand tracking when a physical keyboard is not connected.\n\n* **High-Accuracy Conversion (Mozc)**:\nPowered by Google Mozc's 1.28M-word dictionary. Smooth multi-clause conversion, context-aware kanji selection, and Katakana-to-English translation.\n\n* **JIS & US Layout Compatibility**:\nSupports Japanese (JIS) and US English keyboards. Customize mode-toggle shortcuts like Ctrl+Space, Alt+`, or Hankaku/Zenkaku.\n\n* **F6\u2013F10 Function Keys & Shortcuts**:\nOne-touch character conversion (F6 Hiragana, F7 Katakana, F8 Half-width Katakana, F9/F10 Alphanumeric). Also supports Mac-style Ctrl+J/K/L/;.\n\n* **100% Offline & Private**:\nZero internet permissions required. All keystrokes and inputs remain strictly on your headset.", "short_description": "A Japanese (Romaji) and English IME designed specifically for Meta Quest 3, 3S, and Pro. When using a physical keyboard, you can completely hide the candidate window to keep your view clear (configurable in settings), allowing you to type naturally and comfortably."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/SMZutch/e44a52d29aa20876de9c66166ad1a315", "developer_terms_of_service_url": null, "publisher_name": "Fantasy Kinoko", "support_website_url": null, "website_url": "https://gist.github.com/SMZutc
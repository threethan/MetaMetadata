et permissions requested. All conversions and keystrokes are processed strictly on-device without any data collection.", "short_description": "A completely invisible (No-UI) inline Japanese IME designed for Meta Quest 3, 3S, and Pro. Type naturally with physical keyboards without any distracting visual overlays blocking your virtual workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/SMZutch/e44a52d29aa20876de9c66166ad1a315", "developer_terms_of_service_url": null, "publisher_name": "Fantasy Kinoko", "support_website_url": null, "website_url": "https://gist.github.com/SMZutch/e44a52d29aa20876de9c66166ad1a315", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1406379342551119"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1070019258970667"}]}, "baseline_offer": {"id": "1070019258970667"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790957340, "status": "PUBLISHED", "id": "1070019258970667"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1455465564309163", "version": "1.7.1"}, "id": "1066095392872386", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": 
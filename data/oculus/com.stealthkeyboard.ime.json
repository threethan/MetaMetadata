{"data": {"node": {"__typename": "Application", "id": "1397856513403402", "organization": {"id": "671075482748179", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1397856513403402"}]}, "id": "1697358332001130"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1397856513403402", "release_date": 1790957340, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1455465564309163"}, "id": "1066095392872386"}]}}, "binary": null, "live_binary": null, "created_date": 1792706219, "id": "1455398080982578", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1455400464315673"}, "release_status": "RELEASED", "id": "1397856513403402"}, "id": "1455400464315673", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1397856513403402", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1074123862170256"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1547251140775151", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stealth Keyboard", "keywords": ["\u65e5\u672c\u8a9e", "\u30ad\u30fc\u30dc\u30fc\u30c9", "\u5165\u529b", "IME", "\u30bf\u30a4\u30d4\u30f3\u30b0"], "long_description": "Stealth Keyboard \u306f\u3001Meta Quest 3\u30013S\u3001Pro\u5411\u3051\u306b\u6700\u9069\u5316\u3055\u308c\u305f\u3001\u8996\u754c\u3092\u906e\u3089\u306a\u3044\u65e5\u672c\u8a9e\u30fb\u82f1\u5b57\u5165\u529b\u30b7\u30b9\u30c6\u30e0\uff08IME\uff09\u3067\u3059\u3002Bluetooth\u3084USB\u306e\u7269\u7406\u30ad\u30fc\u30dc\u30fc\u30c9\u306b\u3088\u308b\u672c\u683c\u7684\u306a\u30bf\u30a4\u30d4\u30f3\u30b0\u306f\u3082\u3061\u308d\u3093\u3001\u30aa\u30f3\u30b9\u30af\u30ea\u30fc\u30f3\u4eee\u60f3\u30ad\u30fc\u30dc\u30fc\u30c9\u306b\u3082\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\n\n### \u4e3b\u306a\u7279\u9577\u30fb\u6a5f\u80fd\n\n* **\u5b8c\u5168\u4e0d\u53ef\u8996\uff08No-UI\uff09\u30a4\u30f3\u30e9\u30a4\u30f3\u5165\u529b \uff06 \u5019\u88dc\u67a0\u306e\u5207\u66ff**:\n  VR\u7a7a\u9593\u3067\u306e\u4f5c\u696d\u6642\u306b\u90aa\u9b54\u306b\u306a\u308a\u304c\u3061\u306a\u5165\u529b\u5019\u88dc\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u5b8c\u5168\u306b\u975e\u8868\u793a\u306b\u3057\u3001\u30a8\u30c7\u30a3\u30bf\u4e0a\u306b\u76f4\u63a5\u6587\u5b57\u3092\u6253\u3061\u8fbc\u3081\u307e\u3059\u3002\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u5019\u88dc\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u8868\u793a\u3059\u308b\u8a2d\u5b9a\u3082\u53ef\u80fd\u3067\u3059\u3002\n\n* **\u5b9a\u578b\u6587\u30d1\u30ec\u30c3\u30c8 \uff06 \u52d5\u7684\u30de\u30af\u30ed**:\n  \u3088\u304f\u4f7f\u3046\u30d3\u30b8\u30cd\u30b9\u6328\u62f6\u3001\u65e5\u5831\u3001\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u306a\u3069\u3092\u30ef\u30f3\u30bf\u30c3\u30d7\u3067\u7d20\u65e9\u304f\u5165\u529b\u3067\u304d\u308b\u5b9a\u578b\u6587\u6a5f\u80fd\u3092\u642d\u8f09\u3002\u3055\u3089\u306b `{date}`\uff08\u65e5\u4ed8\uff09\u3001`{time}`\uff08\u6642\u523b\uff09\u306a\u3069\u306e\u52d5\u7684\u30de\u30af\u30ed\u30bf\u30b0\u306b\u3088\u308a\u3001\u73fe\u5728\u306e\u65e5\u6642\u30b9\u30bf\u30f3\u30d7\u3092\u81ea\u52d5\u5c55\u958b\u3057\u3066\u5165\u529b\u3067\u304d\u307e\u3059\u3002\u767b\u9332\u30fb\u7de8\u96c6\u3082\u81ea\u7531\u81ea\u5728\u3067\u3059\u3002\n\n* **\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\uff08\u4eee\u60f3\uff09\u30ad\u30fc\u30dc\u30fc\u30c9\u5bfe\u5fdc**:\n  \u7269\u7406\u30ad\u30fc\u30dc\u30fc\u30c9\u304c\u624b\u5143\u306b\u306a\u3044\u5834\u5408\u3067\u3082\u3001Touch\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3084\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\uff08\u624b\uff09\u3092\u4f7f\u3063\u3066\u30aa\u30f3\u30b9\u30af\u30ea\u30fc\u30f3\u30ad\u30fc\u30dc\u30fc\u30c9\u304b\u3089\u76f4\u63a5\u65e5\u672c\u8a9e\u5165\u529b\u304c\u53ef\u80fd\u3067\u3059\u3002\n\n* **\u9ad8\u7cbe\u5ea6\u304b\u306a\u6f22\u5b57\u5909\u63db\u30a8\u30f3\u30b8\u30f3**:\n  Google Mozc\u306e\u5927\u898f\u6a21\u8f9e\u66f8\uff08\u7d04128\u4e07\u8a9e\uff09\u3092\u642d\u8f09\u3002\u65e5\u5e38\u4f1a\u8a71\u304b\u3089\u30d3\u30b8\u30cd\u30b9\u30fbIT\u7528\u8a9e\u307e\u3067\u3001\u6ed1\u3089\u304b\u306a\u8907\u6587\u7bc0\u5909\u63db\u3084\u6587\u8108\u306b\u5fdc\u3058\u305f\u9069\u5207\u306a\u6f22\u5b57\u5909\u63db\u3001\u30ab\u30bf\u30ab\u30ca\u8a9e\u306e\u82f1\u8a9e\u5909\u63db\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\n\n* **JIS\uff08\u65e5\u672c\u8a9e\uff09\u914d\u5217 \uff06 US\uff08\u82f1\u8a9e\uff09\u914d\u5217 \u4e21\u5bfe\u5fdc**:\n  \u63a5\u7d9a\u3059\u308b\u30ad\u30fc\u30dc\u30fc\u30c9\u306e\u914d\u5217\u306b\u5408\u308f\u305b\u3066\u81ea\u7531\u306b\u5207\u308a\u66ff\u3048\u53ef\u80fd\u3002\u300c\u534a\u89d2/\u5168\u89d2\u300d\u30ad\u30fc\u3084\u300cCtrl + Space\u300d\u300cAlt + `\u300d\u306a\u3069\u3001\u304a\u597d\u307f\u306e\u5165\u529b\u5207\u66ff\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u8a2d\u5b9a\u3067\u304d\u307e\u3059\u3002\n\n* **\u30d5\u30a1\u30f3\u30af\u30b7\u30e7\u30f3\u30ad\u30fc\u5909\u63db\uff08F6\u301cF10 \uff06 \u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\uff09**:\n  - F6: \u3072\u3089\u304c\u306a\n  - F7: \u5168\u89d2\u30ab\u30bf\u30ab\u30ca\n  - F8: \u534a\u89d2\u30ab\u30bf\u30ab\u30ca\n  - F9: \u5168\u89d2\u82f1\u6570\n  - F10: \u534a\u89d2\u82f1\u6570\n  \u203bMac\u98a8\u306e Ctrl + J/K/L/; \u306b\u3082\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\n\n* **\u5b8c\u5168\u30aa\u30d5\u30e9\u30a4\u30f3 \uff06 \u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u5b89\u5fc3\u8a2d\u8a08**:\n  \u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u901a\u4fe1\u6a29\u9650\uff08INTERNET\uff09\u3092\u4e00\u5207\u8981\u6c42\u3057\u307e\u305b\u3093\u3002\u5165\u529b\u3057\u305f\u30c6\u30ad\u30b9\u30c8\u3084\u30ad\u30fc\u30b9\u30c8\u30ed\u30fc\u30af\u306f\u3059\u3079\u3066\u7aef\u672b\u5185\u3060\u3051\u3067\u5b89\u5168\u306b\u51e6\u7406\u3055\u308c\u3001\u5916\u90e8\u3078\u9001\u4fe1\u3055\u308c\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002", "short_description": "Meta Quest 3\u30013S\u3001Pro\u5c02\u7528\u306b\u8a2d\u8a08\u3055\u308c\u305f\u3001\u65e5\u672c\u8a9e\uff08\u30ed\u30fc\u30de\u5b57\uff09\u30fb\u82f1\u5b57\u5bfe\u5fdcIME\u3067\u3059\u3002\n\u7269\u7406\u30ad\u30fc\u30dc\u30fc\u30c9\u63a5\u7d9a\u6642\u306f\u8996\u754c\u3092\u906e\u308b\u5165\u529b\u5019\u88dc\u753b\u9762\u3092\u5b8c\u5168\u975e\u8868\u793a\u306b\u3082\u3067\u304d\u307e\u3059\uff08\u8a2d\u5b9a\u5207\u66ff\uff09\u3002\u7269\u7406\u30ad\u30fc\u30dc\u30fc\u30c9\u3067\u81ea\u7136\u304b\u3064\u5feb\u9069\u306b\u30bf\u30a4\u30d4\u30f3\u30b0\u3067\u304d\u307e\u3059\u3002"}, {"images": {"nodes": [{"file_name": "stealth_keyboard_cover_art.png", "id": "2311688519578425", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627502_2311688522911758_4551758148882649853_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKUfhIqgL_4Q7kNvwHWkoxB&_nc_oc=AdquCFaZoK2IEYQLI7MECKed0qbz1vDr5slHEc0iEBr8VZGTRWkybHjDqprDuGyDYHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAuDNmCdPmH9rVSLvo8HvHWygo3gsCyCXoQI3_MV10xw&oe=6AE21C97"}, {"file_name": "app_icon_512x512.png", "id": "1978459766182249", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_1978459772848915_640831713020407558_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WzlMdcFxyEQ7kNvwFnEfJp&_nc_oc=Adr1zisrxonhbr7iKG9HvppzDjv9K4Xw5ecTmExXFI4Pbi7jP8DtfyRWt
t64.5771-25/499622184_1766083721307959_8173778540486773788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjpzyke5IVgQ7kNvwEqx1pX&_nc_oc=Adrfz7L7SosGfOXNehpM2DQHzRTajjv8CdnaIql-QW91D3o5JDUWZGLlOXkmWG4Ml90&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXTASbPPOnAfssSQzsrhvG1mybe24iGgy5m5By1uFDNw&oe=6AD3AC2D"}, {"file_name": "com.oculus.vrshell-20260928-045756_2560x1440.png", "id": "1124924116734857", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499624606_1124924120068190_1613909125689018765_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1AZim12a1MQ7kNvwF8pZPl&_nc_oc=AdqCYMzyzMHbjBL75yIxf2zBtOj4bJY1Ck5kFvkMpYXty2sysbKqWoKJSzI6jB5m0Uw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND28NC61ETk7EvxLiKjlw_58XlH31QrO05eVTxRa32Tg&oe=6AD3B814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stealth Keyboard", "keywords": [], "long_description": "Stealth Keyboard is a distraction-free, zero-UI inline Japanese Input Method (IME) optimized for physical Bluetooth and USB keyboards on Meta Quest.\n\n### Key Features\n* **Zero-UI Inline Typing**: Visual input overlays and candidate windows are completely hidden, preserving full visibility of your VR workspace and text editors.\n* **Smart Conversion Engine**: High-accuracy Japanese conversion powered by open-source Mozc dictionary (over 1.28M words) supporting compound phrases, inflections, and Katakana-to-English translation.\n* **F6\u2013F10 Function Key Shortcuts**:\n  - F6: Hiragana\n  - F7: Full-width Katakana\n  - F8: Half-width Katakana\n  - F9: Full-width Alphanumeric\n  - F10: Half-width Alphanumeric\n* **100% Offline & Private**: Zero internet permissions requested. All conversions and keystrokes are processed strictly on-device without any data collection.", "short_description": "A completely invisible (No-UI) inline Japanese IME designed for Meta Quest 3, 3S, and Pro. Type naturally with physical keyboards without any distracting visual overlays blocking your virtual workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/SMZutch/e44a52d29aa20876de9c66166ad1a315", "developer_terms_of_service_url": null, "publisher_name": "Fantasy Kinoko", "support_website_url": null, "website_url": "https://gist.github.com/SMZutch/e44a52d29aa20876de9c66166ad1a315", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1406379342551119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620414_1398136385722243_7541381357013223626_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhzyolUKNWkQ7kNvwEv_0zC&_nc_oc=Adr1gB0PrqHPOZixEenxk5wgSIKn-Fwit_8n1ifxJwv7BHBMdDNlverOIxCrmReUaeM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ72_IPqPbiZSVb9Fwf7H-Je-XP_d5Y7IceZa4VtIpWA&oe=6AD3B20B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stealth Keyboard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1790957340, "lastRevision": {"nodes": [{"id": "1397856536736733", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "13978565134
{"data": {"node": {"__typename": "Application", "id": "1397856513403402", "organization": {"id": "671075482748179", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1397856513403402"}]}, "id": "1697358332001130"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1397856513403402", "release_date": 1790957340, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1466554656533587"}, "id": "1066095392872386"}]}}, "binary": null, "live_binary": null, "created_date": 1792887227, "id": "1459158107273242", "is_initial_release": false, "name_with_fallback": "v3", "pdp_metadata_with_fallback": {"version": 3, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1459160463939673"}, "release_status": "RELEASED", "id": "1397856513403402"}, "id": "1459160463939673", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1397856513403402", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1074123862170256"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "stealth_keyboard_cover_art.png", "id": "2311688519578425", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627502_2311688522911758_4551758148882649853_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FO2GSQZGfsQ7kNvwEFRyL_&_nc_oc=AdqyHbbb3j_zr1lptYgLiv-SE98GjAlcww7aB5-CulFYG-oC9givTsEz1cXrkNI_Es8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpQxzz0TJJTVohIHIE
&_nc_oc=AdkKqUXkSC76t9HSqrzBzAgH1-pQnGh8uyHxKFE5glC-5Uw8A-5qwans4tmoD_NtSng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwwBruMVu3r-wuYjGt_4wjjxJ3OZGpSldNQDJ2Mk-Zt_g&oe=69B41690"}, {"file_name": "Screenshot_20230904_203350.png", "id": "1704965506682413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422386_1704965510015746_7049685286896855844_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np90PGW34wYQ7kNvwGgM4fZ&_nc_oc=AdllWyQa6dz9eGFQYROsZkaa-292kck3xY_W7Ss8ol-V5NEQyVyrW33Rcz_Tk_4sYHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSuU-9rZkHTiCtTsqWccj1GiEhRVZEoT-gcoykJXRrvQ&oe=69B405B9"}, {"file_name": "Screenshot_20230904_203452.png", "id": "610020447986805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982675_610020451320138_2735289997432158872_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz5QcP92HpMQ7kNvwHhMLtk&_nc_oc=Adm14UTJ02R34KQJGJoNPS7TI6bwYi4VtgK4WRBuo0kO7yNayarli7_ME_m9K90BofM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwupGnWnvZDDFWxFlkqoRCTjvu5DMx7wiAS1rjZFW19zQ&oe=69B3FEEC"}, {"file_name": "Screenshot_20230828_172310.png", "id": "300478555953156", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982581_300478562619822_8806227422623848698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c97DK4kP3XgQ7kNvwHj_hRI&_nc_oc=AdnIEMUPH3prk1KdviyDNXr_VgzQPUV7LhTM4jbfZR16k0vbq-2NI7SZnK5oIeM2OtY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyP5xaq6aywxzjoxjX1skEl2zDmuJWYe0dMWZaze3oFwQ&oe=69B3F0AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "325625909929158", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982457_325625913262491_8659356926128038723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJt5XVEGeTAQ7kNvwEAf3GE&_nc_oc=AdktGEATpfWFjE8dnDI9CmKPCtWdH5iSKWp3RbI2ScKlz7YI44nl5AgNKkclAY7t97M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwdov8wfgAHq0LWSovMJUFhG6ZSLU4AYw_WqMC5ZKtwHA&oe=69B40E1C"}, "display_name": "Fantasia Canvas", "keywords": [], "long_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nThe game doesn't require any physical or in-game movement from you. You can play it comfortably both while standing and sitting. And the entire gameplay is exceptionally smooth, enveloping you in a meditative atmosphere.\n\nOur team is preparing numerous new exciting episodes for you to enjoy soon.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey.", "short_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fantasia.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fantasia Games", "support_website_url": null, "website_url": "https://fantasia.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
&_nc_oc=AdlCRAuxtS-syoyW9KRH2JGMMK13q9HNmsrufi4-0s_dkwHXRnl9asBByfO_1TvmOdM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzL9GQVTC0uMrfmlzWqnuZ7kX-LXg1PpVXFcTnuc34zxQ&oe=69B80B10"}, {"file_name": "Screenshot_20230904_203350.png", "id": "1704965506682413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422386_1704965510015746_7049685286896855844_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utCf8RyQSq4Q7kNvwH-mtZP&_nc_oc=AdliQaUccRExYr1xQn7GHwhweagjDRv0vcJMuyK7QqbfNJMxbKcolImW51jD2f9PB2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvCoARGvFhfsUxi6VmAH3cZQkAjvFWkmo19qrdeAKcew&oe=69B7FA39"}, {"file_name": "Screenshot_20230904_203452.png", "id": "610020447986805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982675_610020451320138_2735289997432158872_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNXTaMtwbc0Q7kNvwHucn4K&_nc_oc=AdkarV-MFp4PbLM2KRDWwmnhTFsWNSzKTOHfI2N3CElf_5_6vymbXtIcoU2X9xbatoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy59M7Edc1xL9O_k8SaRnKjo9JRrS0GazFpwBt73PYH_w&oe=69B7F36C"}, {"file_name": "Screenshot_20230828_172310.png", "id": "300478555953156", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982581_300478562619822_8806227422623848698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH_N4iG8rlAQ7kNvwGehVJu&_nc_oc=AdmRfRj_O73MW4-jgTXpKU1YhL2e35ZdTEqKOcuTIjJ81yzhbbMwmrYTn-kdLtumt6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTYxFQ98rDaAjSOc1MHTSNPYAOR2OiqRczM6HAfjuJ5Q&oe=69B7E52C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "325625909929158", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982457_325625913262491_8659356926128038723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO0_oJLfV58Q7kNvwE7s7Sz&_nc_oc=Adln1qJ-vmkC4QrsA7TgYVT4bLafi0coS5qnxkb0KUQZxRqvu9xFsTc3SlVAAsNf6q8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwY-lVyfaKP8Wv87PaKhrf4yV5UUT_BnuZVDnCK6R-Tpw&oe=69B8029C"}, "display_name": "Fantasia Canvas", "keywords": [], "long_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nThe game doesn't require any physical or in-game movement from you. You can play it comfortably both while standing and sitting. And the entire gameplay is exceptionally smooth, enveloping you in a meditative atmosphere.\n\nOur team is preparing numerous new exciting episodes for you to enjoy soon.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey.", "short_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fantasia.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fantasia Games", "support_website_url": null, "website_url": "https://fantasia.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
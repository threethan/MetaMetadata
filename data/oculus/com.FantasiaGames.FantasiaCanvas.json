&_nc_oc=AdmJpoEl7y950ZHB8-oF5IfKq1BrMae-1YwN_aGHFq1IZCmzDLARyxlnUShEFJoHnZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0kNIMKFvFDMbPbkS1hbZ5ZK8Wse0gDrAqpuJUfAoxWA&oe=69B17390"}, {"file_name": "Screenshot_20230904_203350.png", "id": "1704965506682413", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422386_1704965510015746_7049685286896855844_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhfCdsZVRioQ7kNvwFJTMqs&_nc_oc=AdkdVXwi6wcGVZnrMCJvSKdsbzEy1pqbvf8DkjAVExMgXxyfLLwztsxUzzCcv1cC2r0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAGpRYOJBHtSx6_YneQXqUlQGbxK1DpERttc_ITRooDA&oe=69B162B9"}, {"file_name": "Screenshot_20230904_203452.png", "id": "610020447986805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982675_610020451320138_2735289997432158872_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kcFZjxNfJIQ7kNvwEtbohb&_nc_oc=AdmcCTSwdJ-6fRu__5n92I5Av3ubvBUvq7OxutqJzYMJ-05jOhKpQsazerdbh0iEB80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoDtk0SemU427M4-IQdnoHgwmU9rN3b4mt9LIQo9kU4A&oe=69B15BEC"}, {"file_name": "Screenshot_20230828_172310.png", "id": "300478555953156", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982581_300478562619822_8806227422623848698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c97DK4kP3XgQ7kNvwEs37v1&_nc_oc=AdnH2wrjfarLjefJafmnd_oymgMxIyeE2BrABHade0M0MrhDNphh1m5RnqqQsox5-B4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTbEvtfNqB522MF-BCuHZToXDA4WbMGOENpPl-O2dy_w&oe=69B14DAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "325625909929158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982457_325625913262491_8659356926128038723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WnoCKclyIgQ7kNvwGrNj-A&_nc_oc=AdmpNAWZjOwTNkm-25Qn8Iu2Cr0TfGBmexzbD6ANuRAiEyMVUqu5SrseBRxj9630e_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzzIp007hUXasaqprvvc8g18p301DC0sMfaZvJUMvhbQ&oe=69B16B1C"}, "display_name": "Fantasia Canvas", "keywords": [], "long_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nThe game doesn't require any physical or in-game movement from you. You can play it comfortably both while standing and sitting. And the entire gameplay is exceptionally smooth, enveloping you in a meditative atmosphere.\n\nOur team is preparing numerous new exciting episodes for you to enjoy soon.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey.", "short_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fantasia.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fantasia Games", "support_website_url": null, "website_url": "https://fantasia.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
&_nc_oc=Adle1s2vXCf16jD8fW7FeES15o16apNGWPowiUugExaamcwKVELJ0FqF6PHEnG_A7yY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftanXnrWrMHTrB--hjBhG4Fg6qf6UXTvl3_vgBfFhF1aQ&oe=69A83910"}, {"file_name": "Screenshot_20230904_203350.png", "id": "1704965506682413", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422386_1704965510015746_7049685286896855844_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iihTXy5ReFYQ7kNvwG46zR7&_nc_oc=Adn7T74Ti63wOagwgwX6z9fMWqKan35qAoUfHzRujH_jmvUUuSmFt6p72BMRaPRwUpA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afut7erizS6fzzYyizEhLyAdA7nqRn_kiP-0uzDUWyZjaQ&oe=69A82839"}, {"file_name": "Screenshot_20230904_203452.png", "id": "610020447986805", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982675_610020451320138_2735289997432158872_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f62qLbtkD1QQ7kNvwEcsNbL&_nc_oc=Adm4TCGCN6vopz_A2ZobWOxa12jOmVz9J5esQbnRgxVnsSovTpJLlamlcrNm98OUXq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftwIYt_Wd9-jptAYLhxmqwRtrtHhAC2KQd3V8lt2zH0DQ&oe=69A8216C"}, {"file_name": "Screenshot_20230828_172310.png", "id": "300478555953156", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982581_300478562619822_8806227422623848698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMoJMEkWVYcQ7kNvwGHPnh4&_nc_oc=AdkS6QCSMsvL3P-mYcf8Rrdsp7pNsoF_y6-E75ifdeJuGngZMrXXsg7PhTWdmdWiumY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsxzF-0wz5XP0bjQ1NYgxdwqTAMRG4uk3vST20o0snaHw&oe=69A8132C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "325625909929158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982457_325625913262491_8659356926128038723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1bCvu0fLvIQ7kNvwFOyEFT&_nc_oc=AdlTwSp4h6gU3Qnkr1fTotnRt-UMVWHsL0sFXjkvJ_RUEPphebsLy7p5pYpvsXven0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu6wOQtMdp8P6hJDPyrLhBJGsLVsKd5_9VW3G2Ynq98LQ&oe=69A8309C"}, "display_name": "Fantasia Canvas", "keywords": [], "long_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nThe game doesn't require any physical or in-game movement from you. You can play it comfortably both while standing and sitting. And the entire gameplay is exceptionally smooth, enveloping you in a meditative atmosphere.\n\nOur team is preparing numerous new exciting episodes for you to enjoy soon.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey.", "short_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fantasia.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fantasia Games", "support_website_url": null, "website_url": "https://fantasia.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
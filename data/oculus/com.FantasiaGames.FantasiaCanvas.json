&_nc_oc=AdmY6nePp5MVFhdvkp1dMR1-T2eArkEPv-DF5dXTHWzqJ6d_M3gU-cFTFd8kVrVfXHE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiBZUxdsH4VhbBmzdressfdTersoKcJuHaSJEuLWdQvg&oe=69BAAE10"}, {"file_name": "Screenshot_20230904_203350.png", "id": "1704965506682413", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422386_1704965510015746_7049685286896855844_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utCf8RyQSq4Q7kNvwHoprW_&_nc_oc=AdmCjspLk3YtYbd9jsUKja3SQpMOsqC5iF_CeEg7MyTRvCgBm0IB-Sd5_SwTAiypjrk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwtry7L_ehHKoDG6t9B_L7r7KSgzk2j7DC43hNpaRycXg&oe=69BA9D39"}, {"file_name": "Screenshot_20230904_203452.png", "id": "610020447986805", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982675_610020451320138_2735289997432158872_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jjPoiv6aboQ7kNvwEVMAcA&_nc_oc=Adk2LQl3e789vHa3i4Hi21VAObt03aZ-ANL7x4rYpb8yCsG7oPkZ4KVPIMR3J_cM26Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcgWOYRe6e5SxZSC9f4yDheNf-R89GqakAtbgFs8aGxw&oe=69BA966C"}, {"file_name": "Screenshot_20230828_172310.png", "id": "300478555953156", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982581_300478562619822_8806227422623848698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfG4itIQZgcQ7kNvwF2CryB&_nc_oc=AdmM4JOO-krdqwgh5uCe7RCLRiROqrAumUCj6cSNYK5JpaZPw2zehtZbO83xyoXkCWg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzRuDvL2P2EIuv0Wv8-I7Zl7JkEa0tZNoIFoFY7g-E_g&oe=69BA882C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "325625909929158", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982457_325625913262491_8659356926128038723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uv6hOfly40Q7kNvwHLQdWC&_nc_oc=AdlBgG_ZtjoR4XwYmaMTt16ofcJLxPX7nDhKwpu6VWJFuVubN4MjT1GLyHSTfzno7eE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQVldIk0IOImo8O6BOyFcBkWy_gYSwgE2eJmtk4ePzQQ&oe=69BAA59C"}, "display_name": "Fantasia Canvas", "keywords": [], "long_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nThe game doesn't require any physical or in-game movement from you. You can play it comfortably both while standing and sitting. And the entire gameplay is exceptionally smooth, enveloping you in a meditative atmosphere.\n\nOur team is preparing numerous new exciting episodes for you to enjoy soon.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey.", "short_description": "Fantasia Canvas invites you to seamlessly transition from the bustling demands of daily life into an atmosphere of tranquility and relaxation.\n\nColoring vivid miniatures is a truly mesmerizing and engaging experience, complemented by a perfect harmony of effects, sounds, and surroundings designed to alleviate the stresses of a hectic day.\n\nEmbark on this engaging adventure and experience the meditative power of VR with a painting journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fantasia.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fantasia Games", "support_website_url": null, "website_url": "https://fantasia.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
scdn.com/v/t64.5771-25/54809986_2590251791170109_9110819640446803761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diFwKBoOyhoQ7kNvwHJRtKF&_nc_oc=AdqFeE27eYmZg9qloDT7S1vZjIhLTZ7kk9rNAtYg1ORB3rHYEOR6uGnKXid3iqi1Rpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PK8vGrTHrvDkATmBxKcLy-kXeSSYnh_2np10J387BMg&oe=6A2EA9D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Big_2560x1440_ohneText.png", "id": "1221838989112855", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/468733961_1221838992446188_819310889233430463_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esezQcWeebcQ7kNvwGaz2Ce&_nc_oc=AdrmM_PONSYkoIEq0uq9xokyGLLb-zKgQByPyqtQDJrOGLfJtyiuCIYzw_Fkve_xl9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Nlj8W7RgoREWr81rqqtStXQRrXhVSuxZrvbOqVT8qYw&oe=6A2ED3A3"}, "display_name": "AR Bubbles", "keywords": [], "long_description": "AR Bubbles \u2013 Magic in Your Living Room!\n\nBring the fun of soap bubbles into your world with AR Bubbles! Experience the joy of popping bubbles with your fingers or blowing them away to merge with others.\n\nEver seen red bubbles or heart-shaped ones? Now you can!\n\nCreate gigantic, elongated bubbles, cast a beautiful rainbow, or watch as a butterfly gently lands on your hand.\n\nWith AR Bubbles, the magic of bubbles is just a tap away. Try it now and enjoy the endless fun in your own living room!", "short_description": "Have fun with soap bubbles in all shapes and colors! Pop them with your fingers, blow them away, or merge them together. Create huge bubbles, cast a rainbow with your hand, or watch a butterfly land on your finger. The magic of bubbles is now in your living room with AR Bubbles!"}, {"images": {"nodes": [{"file_name": "Bubbles_1080x360.png", "id": "8621060391276933", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982460_8621060394610266_3306229921156622182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a
scdn.com/v/t64.5771-25/54809986_2590251791170109_9110819640446803761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KW-m3gdBwMIQ7kNvwEKYmOu&_nc_oc=Adq8toSFcI4kppR1oNHvJWe1Jb-EELhxiMcjBknm2aBfuVMnCnWJ8O1OfCmXHA9VUsM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yF7MmicTFgiaQ8i_hEFTJGkEc6sXg6u_dAeB5hpR_5A&oe=69F35654"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Big_2560x1440_ohneText.png", "id": "1221838989112855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/468733961_1221838992446188_819310889233430463_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY08NSn8qzEQ7kNvwFsLjGU&_nc_oc=Adr_8f12qaYHx8hryC8p3Qdan40zPoyMQdh3hmE0PJNytbyvH4_bQf_GiXXSw0UPz8E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HKajxCCMXACmgLixrW86woyoINwMKMTg619MgPnILjQ&oe=69F347E3"}, "display_name": "AR Bubbles", "keywords": [], "long_description": "AR Bubbles \u2013 Magic in Your Living Room!\n\nBring the fun of soap bubbles into your world with AR Bubbles! Experience the joy of popping bubbles with your fingers or blowing them away to merge with others.\n\nEver seen red bubbles or heart-shaped ones? Now you can!\n\nCreate gigantic, elongated bubbles, cast a beautiful rainbow, or watch as a butterfly gently lands on your hand.\n\nWith AR Bubbles, the magic of bubbles is just a tap away. Try it now and enjoy the endless fun in your own living room!", "short_description": "Have fun with soap bubbles in all shapes and colors! Pop them with your fingers, blow them away, or merge them together. Create huge bubbles, cast a rainbow with your hand, or watch a butterfly land on your finger. The magic of bubbles is now in your living room with AR Bubbles!"}, {"images": {"nodes": [{"file_name": "Bubbles_1080x360.png", "id": "8621060391276933", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982460_8621060394610266_3306229921156622182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a
scdn.com/v/t64.5771-25/54809986_2590251791170109_9110819640446803761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x67eWhHOWwkQ7kNvwFR77Jr&_nc_oc=Adp7GuEF5PST9mypwoOO6k6V_dtKlWu8URaXlDOjkWx6s10722SKg4hf3GlDDXU9RIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TOdc5O4XDeJ1SBb9oHFqR0HZCELdtTXYffZl1WsCLFw&oe=6A05CB54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Big_2560x1440_ohneText.png", "id": "1221838989112855", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/468733961_1221838992446188_819310889233430463_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57GtGEs8KqcQ7kNvwFPFJ2U&_nc_oc=AdpkBo9RnzCrMOGuEkS58KHObft19c3qHaMrvBVF1NwCIr_qBJVzfJ6k3OIaGmGr5o0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af455e5Z-SSC2yCezuhwu4iMQt7aZYoVivmuA6duDKVBZA&oe=6A05BCE3"}, "display_name": "AR Bubbles", "keywords": [], "long_description": "AR Bubbles \u2013 Magic in Your Living Room!\n\nBring the fun of soap bubbles into your world with AR Bubbles! Experience the joy of popping bubbles with your fingers or blowing them away to merge with others.\n\nEver seen red bubbles or heart-shaped ones? Now you can!\n\nCreate gigantic, elongated bubbles, cast a beautiful rainbow, or watch as a butterfly gently lands on your hand.\n\nWith AR Bubbles, the magic of bubbles is just a tap away. Try it now and enjoy the endless fun in your own living room!", "short_description": "Have fun with soap bubbles in all shapes and colors! Pop them with your fingers, blow them away, or merge them together. Create huge bubbles, cast a rainbow with your hand, or watch a butterfly land on your finger. The magic of bubbles is now in your living room with AR Bubbles!"}, {"images": {"nodes": [{"file_name": "Bubbles_1080x360.png", "id": "8621060391276933", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982460_8621060394610266_3306229921156622182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a
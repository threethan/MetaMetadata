9047181993", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569440_587289050515326_7557307109938305681_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULve79C2JUgQ7kNvwHHl6HP&_nc_oc=AdqcQroHyV06g7doM-zbeKVF-WiAPc13BbLU-npQe4g_LZ2ZOgIkO1DWJ3HdgzTfs3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQS_-nfpollUUBhpb95kGsKsbAT5TMlPdzB2Dui5_e28A&oe=6B0DB63B"}, {"file_name": "Colors_2560x1440_ohneText.png", "id": "1603863943837267", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_1603863947170600_2862312172643337800_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NLxKh1gz-MQ7kNvwEZHRV_&_nc_oc=AdqLvoAX4H71I24KcQ-0bfdpaFexLPhhccGPkzAqxMbzFS5E32KsAKGD11Ln_6Rm-GE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPK0r_k17t2P4M7wXSg6a5rf9Fbd9SJC0m2EmG4nCwEQ&oe=6B0D9ECB"}, {"file_name": "Rainbow_2560x1440_ohneText.png", "id": "941498240762349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031574_941498244095682_2093443099651532860_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvctZM4q2zMQ7kNvwEpaJ-5&_nc_oc=AdrqEl5KVcOJEGkdSwp5dDuSfBcvFusfRL3zScuKjwLJGF1rdsNheFNtiBn8YVbkGJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHV0a9B7tVkFsOijBHeKLvhknUgWGO-n2u2roUIcdGiQ&oe=6B0DB01A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Big_2560x1440_ohneText.png", "id": "8444469572342269", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569428_8444469575675602_6761309904453448073_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXLTVZoDLe4Q7kNvwFaVdG6&_nc_oc=AdoPKW1Jd1TwBqT01DWuxBqIiSCB8Pw4T-Ez08yKiN_SFRHa3o231AkGfVO3WYb3lvY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwiubErqzIGpIgqVJ_4bG4a60LOOP2bYzEccida3p4TA&oe=6B0DAFCA"}, "display_name": "AR Seifenblasen", "keywords": [], "long_description": "AR Seifenblasen \u2013 Magie in deinem Wohnzimmer!\n\nBringe den Spa\u00df von Seifenblasen in deine Welt mit AR Seifenblasen! Erlebe die Freude, Blasen mit deinen Fingern zu zerplatzen oder sie wegzublasen, um sie mit anderen zu vereinen.\n\nHast du schon mal rote Blasen oder herzf\u00f6rmige Blasen gesehen? Jetzt kannst du!\n\nErstelle riesige, lange Blasen, lasse einen wundersch\u00f6nen Regenbogen entstehen oder sieh zu, wie ein Schmetterling sanft auf deiner Hand landet.\n\nMit AR Seifenblasen ist die Magie der Blasen nur einen Fingertipp entfernt. Probier es jetzt aus und genie\u00dfe den endlosen Spa\u00df in deinem Wohnzimmer!", "short_description": "Habe Spa\u00df mit Seifenblasen in vielen Formen und Farben! Zerplatze sie mit deinen Fingern, blase sie weg oder vereine sie miteinander. Erstelle riesige Blasen, lasse mit deiner Hand einen Regenbogen entstehen oder beobachte, wie ein Schmetterling auf deinem Finger landet. Die Magie der Blasen ist jetzt in deinem Wohnzimmer mit AR Seifenblasen!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.itsth.de/en/kontakt/datenschutzerklaerung_arbubbles.php", "developer_terms_of_service_url": null, "publisher_name": "ITSTH", "support_website_url": null, "website_url": "https://www.itsth.de/en/saa/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
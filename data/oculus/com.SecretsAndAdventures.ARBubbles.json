scdn.com/v/t64.5771-25/54809986_2590251791170109_9110819640446803761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yh85Sxj_OsgQ7kNvwHt-3Wa&_nc_oc=AdqxeOOA6BTIKj6xWuDme0zo9nRulIvr04MiF-CGoG7jOvcYTi_GhZhvGBlpzA5mIHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGb9C5UvBXsNgnG990AzLoyedzhfm6HNrI3yy7N5Txuw&oe=6A9D67D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Big_2560x1440_ohneText.png", "id": "1221838989112855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468733961_1221838992446188_819310889233430463_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISic-hxuxiAQ7kNvwHSj8_h&_nc_oc=Ado1xbXr6xyZPFPc_OVP4xuBfQgSOVrNztPpkaxjCuyBP9DXDgpBRrc2N1MOxZp1G9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpacXrGp8oscO1JMHmlf8xXtr3OOu4994YWF7C_YuWAw&oe=6A9D5963"}, "display_name": "AR Bubbles", "keywords": [], "long_description": "AR Bubbles \u2013 Magic in Your Living Room!\n\nBring the fun of soap bubbles into your world with AR Bubbles! Experience the joy of popping bubbles with your fingers or blowing them away to merge with others.\n\nEver seen red bubbles or heart-shaped ones? Now you can!\n\nCreate gigantic, elongated bubbles, cast a beautiful rainbow, or watch as a butterfly gently lands on your hand.\n\nWith AR Bubbles, the magic of bubbles is just a tap away. Try it now and enjoy the endless fun in your own living room!", "short_description": "Have fun with soap bubbles in all shapes and colors! Pop them with your fingers, blow them away, or merge them together. Create huge bubbles, cast a rainbow with your hand, or watch a butterfly land on your finger. The magic of bubbles is now in your living room with AR Bubbles!"}, {"images": {"nodes": [{"file_name": "Bubbles_1080x360.png", "id": "8621060391276933", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982460_8621060394610266_3306229921156622182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a
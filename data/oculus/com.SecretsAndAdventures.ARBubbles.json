n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOGd0am2ki4Q7kNvwFfmDSf&_nc_oc=AdqJc_I-7ZALJ1NHLKgFBbb_MiWjuBn516712V4C2ccyDBI6OjC0zdx80cEleaS_jD0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJbb4U2QumOEvFvW__T8_V0wjwA6BLhUE7LWt0Ha5J1Q&oe=6A883F0B"}, {"file_name": "Rainbow_2560x1440_ohneText.png", "id": "941498240762349", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031574_941498244095682_2093443099651532860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLMtGA7Y9K4Q7kNvwFYuUMr&_nc_oc=AdpHa43kpOsJBLPakZI1UMP2NJSiqdp3tdRtGbVWFIa_X9t12cTvHQ45h5UguPT5ARE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETP28UxY1nwsr14hd9uJkDKJCp0UG-DLGCQ6w8OSEimg&oe=6A88505A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Big_2560x1440_ohneText.png", "id": "8444469572342269", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569428_8444469575675602_6761309904453448073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlD9i2tXWqcQ7kNvwG0EOUb&_nc_oc=Adqt-nBRSQvHxdWa6cPZlws62k_g2RElkdbooPldID2thGcLl399ci1YHcEQFCHFKXo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhn6yQyU0dI5KuPKm4ioYEo8J8S8XmjEdC87IEwp9TTA&oe=6A88500A"}, "display_name": "AR Seifenblasen", "keywords": [], "long_description": "AR Seifenblasen \u2013 Magie in deinem Wohnzimmer!\n\nBringe den Spa\u00df von Seifenblasen in deine Welt mit AR Seifenblasen! Erlebe die Freude, Blasen mit deinen Fingern zu zerplatzen oder sie wegzublasen, um sie mit anderen zu vereinen.\n\nHast du schon mal rote Blasen oder herzf\u00f6rmige Blasen gesehen? Jetzt kannst du!\n\nErstelle riesige, lange Blasen, lasse einen wundersch\u00f6nen Regenbogen entstehen oder sieh zu, wie ein Schmetterling sanft auf deiner Hand landet.\n\nMit AR Seifenblasen ist die Magie der Blasen nur einen Fingertipp entfernt. Probier es jetzt aus und genie\u00dfe den endlosen Spa\u00df in deinem Wohnzimmer!", "short_description": "Habe Spa\u00df mit Seifenblasen in vielen Formen und Farben! Zerplatze sie mit deinen Fingern, blase sie weg oder vereine sie miteinander. Erstelle riesige Blasen, lasse mit deiner Hand einen Regenbogen entstehen oder beobachte, wie ein Schmetterling auf deinem Finger landet. Die Magie der Blasen ist jetzt in deinem Wohnzimmer mit AR Seifenblasen!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.itsth.de/en/kontakt/datenschutzerklaerung_arbubbles.php", "developer_terms_of_service_url": null, "publisher_name": "ITSTH", "support_website_url": null, "website_url": "https://www.itsth.de/en/saa/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28241073872173161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75326677_1106271494184119_7557469526168279192_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noUqnBf7bE8Q7kNvwF2Ko9i&_nc_oc=AdqCLfsk8cYVRunTXHBj-EMZtzl1LT9F6D4ZDVTRFwxWBziP6wtEEuW5Ozy8Esjyo98&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYnrQKLjrXgIeKG1y71V02IG_NntHXLog7T_3s2GqPFQ&oe=6A8845AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AR Bubbles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925
n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aRu2OuwdugQ7kNvwGtYMJW&_nc_oc=AdrcG0ODOs79X9q_8qNFvLJIrZObIKR-vuQNWx0ryg2-zcP87buT5nAwmWLHYkEcd6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF2geXKWOym9QEun-b3FIZzkAR-fM_Dm67P7A_UfIG2A&oe=6A771B8B"}, {"file_name": "Rainbow_2560x1440_ohneText.png", "id": "941498240762349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031574_941498244095682_2093443099651532860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa5fRmDj30wQ7kNvwHaGlAH&_nc_oc=Adru_o3IOSxKT7MbU9XL_fa3f_cGWCL-VK77XpV5S51NQaDReQj8YZkJqifSnU7zxrE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFawTe9PpWHNsMiXkFOaOAkpdFW5NOOdQDuaba-8nUGxg&oe=6A772CDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Big_2560x1440_ohneText.png", "id": "8444469572342269", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569428_8444469575675602_6761309904453448073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRxeQS5WQNAQ7kNvwGvzIMQ&_nc_oc=AdqZXmwPlWlQ-rWApMSJqthf0llAaDBDns0vG7MwceDF6NHhmGh7MaMhkV1_mFn0DTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWANaF6lyGF__SXK6dRuwECPDcdnFdcDWSxXjZyYfkKg&oe=6A772C8A"}, "display_name": "AR Seifenblasen", "keywords": [], "long_description": "AR Seifenblasen \u2013 Magie in deinem Wohnzimmer!\n\nBringe den Spa\u00df von Seifenblasen in deine Welt mit AR Seifenblasen! Erlebe die Freude, Blasen mit deinen Fingern zu zerplatzen oder sie wegzublasen, um sie mit anderen zu vereinen.\n\nHast du schon mal rote Blasen oder herzf\u00f6rmige Blasen gesehen? Jetzt kannst du!\n\nErstelle riesige, lange Blasen, lasse einen wundersch\u00f6nen Regenbogen entstehen oder sieh zu, wie ein Schmetterling sanft auf deiner Hand landet.\n\nMit AR Seifenblasen ist die Magie der Blasen nur einen Fingertipp entfernt. Probier es jetzt aus und genie\u00dfe den endlosen Spa\u00df in deinem Wohnzimmer!", "short_description": "Habe Spa\u00df mit Seifenblasen in vielen Formen und Farben! Zerplatze sie mit deinen Fingern, blase sie weg oder vereine sie miteinander. Erstelle riesige Blasen, lasse mit deiner Hand einen Regenbogen entstehen oder beobachte, wie ein Schmetterling auf deinem Finger landet. Die Magie der Blasen ist jetzt in deinem Wohnzimmer mit AR Seifenblasen!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.itsth.de/en/kontakt/datenschutzerklaerung_arbubbles.php", "developer_terms_of_service_url": null, "publisher_name": "ITSTH", "support_website_url": null, "website_url": "https://www.itsth.de/en/saa/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28241073872173161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75326677_1106271494184119_7557469526168279192_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpw6R3repA4Q7kNvwGZRrGP&_nc_oc=AdpqPwVYFWLiw24_VDaepSRTH4013oAsK8pCHPqQjUDsO7L9xmte6a3EkPqrQdFKM90&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG96qcvAXbp2zs886Rt1tsbo9biyMwZC5REVUIZZ18-Qg&oe=6A77222D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AR Bubbles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925
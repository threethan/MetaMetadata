n.com&_nc_ss=8&oh=00_AfzDgTBqdDEY1o15Oygh3rGsKQOv1xLwWLAP8KqcWgeKOg&oe=69B3FFE3"}, "display_name": "AR Bubbles", "keywords": [], "long_description": "AR Bubbles \u2013 Magic in Your Living Room!\n\nBring the fun of soap bubbles into your world with AR Bubbles! Experience the joy of popping bubbles with your fingers or blowing them away to merge with others.\n\nEver seen red bubbles or heart-shaped ones? Now you can!\n\nCreate gigantic, elongated bubbles, cast a beautiful rainbow, or watch as a butterfly gently lands on your hand.\n\nWith AR Bubbles, the magic of bubbles is just a tap away. Try it now and enjoy the endless fun in your own living room!", "short_description": "Have fun with soap bubbles in all shapes and colors! Pop them with your fingers, blow them away, or merge them together. Create huge bubbles, cast a rainbow with your hand, or watch a butterfly land on your finger. The magic of bubbles is now in your living room with AR Bubbles!"}, {"images": {"nodes": [{"file_name": "Bubbles_1080x360.png", "id": "8621060391276933", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982460_8621060394610266_3306229921156622182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRryOxRxhRQQ7kNvwH3GRmc&_nc_oc=AdnSJiHoM20ve_yBJT2ux63zZu4i_6oRMJm-kWrLlAmGwAU2Jt67ul9d17nNNGl1dmc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyhndcGpLtLDJD7o0LgdBbgeg1LECA4jPqoWxryU-bmYA&oe=69B42060"}, {"file_name": "Icon512.png", "id": "8186871104747690", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569449_8186871111414356_2916422658037703410_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5YWK9qnL00Q7kNvwEUhvH1&_nc_oc=Adld4xZro_ZFBuRWSbu2bXChty5iD-bBUDgLV9OHs_EW_LEWJPOm7CqG3-s3Ri8zjHE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzt5ujtUyn0pjB0eqVWwERL3MDmvUICXF-i_bt8O6h5dg&oe=69B3FC80"}, {"file_name": "Icon1024.png", "id": "3779824665615971", "image_type"
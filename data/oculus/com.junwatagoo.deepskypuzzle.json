LPy4P1Ri0Z0LysHxPop1tBj-A&oe=6AF73C88"}, {"file_name": "m001.png", "id": "28297900459879781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622153_28297900486546445_8261627989519589707_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzZkJ_ZrA94Q7kNvwGhWd4p&_nc_oc=Adr7Z9sVIomiDwWuYH5rWHmEz2JFsM_RpeuaLPIWRRnOVBLImi7VxW3b-nnH2pC7B1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_B6GFQYGwamFYuBAJ-pE73NNLSP0ot2-1ODn4IXV7VA&oe=6AF7361F"}, {"file_name": "ranking_en_.png", "id": "1675188064312351", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623565_1675188067645684_4982812630564856525_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_6k5Wz1jEAQ7kNvwHKlqC2&_nc_oc=AdqRih338NRMncpYOgTo_OmrggDxKnVl7o0EIQsnf0GD0AisQro4NV9Xr2Jdh0_s3kg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBFcHWMYROeDVw-aWc4Ifsscr61uvZfBKLPJddvFszrA&oe=6AF71CCD"}, {"file_name": "game_mode_en.png", "id": "1819145926204523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593723055_1819145929537856_7137828326947511806_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7izCJLUsKsUQ7kNvwH_5dfT&_nc_oc=AdqrICncCqDMAV3S4NfanSzVksIx0bXak9Sqb9pdNrcXwILhPQ9xq00THV7q4y81C64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKtBFbE-1-2BYCiEAl9Jo6WmbR98mmHyMGEtKSkYwjXQ&oe=6AF72D46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pices_3_en - \u30b3\u30d4\u30fc.png", "id": "2192036448390655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623551_2192036451723988_6318204505656794810_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcjeOXnaKG8Q7kNvwGOBS9J&_nc_oc=AdqNis4tnwEFtms4Z8NQcybYrMDx9U7XssxdFFXW5rRw6lpzy_F7nLSildtFY2debMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROMJwGrgy6dm7h2iomQSlJB2Rgobik9JgXakt2-YICOg&oe=6AF71E67"}, "display_name": "Deep Sky Jigsaw VR - 110 Messier Puzzles", "keywords": ["Astronomy", "Constellations", "Puzzle", "Jigsaw", "Game"], "long_description": "**Rebuild the universe\u2014now with Messier objects!**\n\n**Deep Sky Jigsaw VR v1.2** turns the night sky into a giant 3D jigsaw puzzle for Meta Quest.\n\nChoose a constellation puzzle, or select any Messier object from **M001 to M110** and rebuild its real astronomical image as a 64-piece jigsaw puzzle in space.\n\nGrab each piece with your controller, then rotate and tilt it until it matches the correct position and orientation.\n\nUse stars, constellation lines, the Milky Way, nebulae, galaxies, and Messier images as clues.\n\nFor Messier puzzles, reconstruct real nebulae, galaxies, and star clusters piece by piece.\n\nVersion 1.2 also adds **Messier progress tracking** and integrates completed Messier objects into the ranking system.\n\nYou can save an interrupted Messier puzzle and continue it later.\n\nComplete more objects, improve your ranking, and challenge yourself to restore all **110 Messier objects**.\n\nWhen the final piece clicks into place, the complete constellation or deep-sky object appears before you.\n\n**Grab it. Rotate it. Fit it back into place. Complete the universe with your own hands.**", "short_description": "Turn the night sky into a giant jigsaw puzzle \u2014 now with Messier objects!\nSolve constellation puzzles or jigsaws using real Messier images from M001 to M110.\nGrab each piece, rotate and tilt it, then find its place in the sky.\nUse stars, constellation lines, the Milky Way, nebulae, galaxies, and Messier images as clues.\nTrack progress and improve your ranking as you complete objects.\nRestore the missing pieces and complete the deep sky.\nGrab it. Rotate it. Fit it back. Complete the universe!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jun1wata.wordpress.com/2019/04/24/spectraview-privacy-policy_/", "developer_terms_of_service_url": null, "publisher_name": "jun1wata", "support_website_url": null, "website_url": "https://jun1wata.wordpress.com/category/deep-sky-finder/", "
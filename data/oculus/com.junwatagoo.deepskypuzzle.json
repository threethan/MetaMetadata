ACQOc1cfp3HJKwyVrAromuWag&oe=6AF1F688"}, {"file_name": "m001.png", "id": "28297900459879781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622153_28297900486546445_8261627989519589707_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKx0vfpcLl0Q7kNvwFKxxDI&_nc_oc=AdoLhhfe27K1o8bTGKNmG0OOEVgUlBfGeS0ZbIO0ZMI1SKTrRgROgg1682UfxJuNmns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF5Yx1RbZEjv7O42h8Ua9h8UHyflDWOoXjImmOn7M1wA&oe=6AF1F01F"}, {"file_name": "ranking_en_.png", "id": "1675188064312351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623565_1675188067645684_4982812630564856525_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5fDxPGkudsQ7kNvwEOF-j3&_nc_oc=AdouWhxVJiSY1LAmuu2aqtF8Zg5G3FaK0OHhxe6eGUXFScv6U7Ki2KrNHLPfcfVM0Bc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTywQfLXQVU46Hpo3xZUI3mweCbPJPrWfqabFKLsXEWhQ&oe=6AF1D6CD"}, {"file_name": "game_mode_en.png", "id": "1819145926204523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593723055_1819145929537856_7137828326947511806_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jv3IjSQbIEQ7kNvwFTCXvh&_nc_oc=AdoMTwD_AqWEwWQDNOrtjg4m0BS0dYsj9gAM2Fiu9Tn59ltnPG36t3XBQ3ety-wGQe4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN25j9IvHxcrbdGXr2Li85HaVCtue9KhemxVHS7ipKiw&oe=6AF1E746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pices_3_en - \u30b3\u30d4\u30fc.png", "id": "2192036448390655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623551_2192036451723988_6318204505656794810_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwC_vMm6NhkQ7kNvwHlTmQR&_nc_oc=AdrMCUQk_yjuDaYMWHGCYTnEy7KtkiALdYeIMlBd8WR2mQpvAd9tJbuYsNoCgM9pjH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmkxOd0ZQorhW3WdejpXOnQZhehSg-UFoReJpLyXTbtg&oe=6AF1D867"}, "display_name": "Deep Sky Jigsaw VR - 110 Messier Puzzles", "keywords": ["Astronomy", "Constellations", "Puzzle", "Jigsaw", "Game"], "long_description": "**Rebuild the universe\u2014now with Messier objects!**\n\n**Deep Sky Jigsaw VR v1.2** turns the night sky into a giant 3D jigsaw puzzle for Meta Quest.\n\nChoose a constellation puzzle, or select any Messier object from **M001 to M110** and rebuild its real astronomical image as a 64-piece jigsaw puzzle in space.\n\nGrab each piece with your controller, then rotate and tilt it until it matches the correct position and orientation.\n\nUse stars, constellation lines, the Milky Way, nebulae, galaxies, and Messier images as clues.\n\nFor Messier puzzles, reconstruct real nebulae, galaxies, and star clusters piece by piece.\n\nVersion 1.2 also adds **Messier progress tracking** and integrates completed Messier objects into the ranking system.\n\nYou can save an interrupted Messier puzzle and continue it later.\n\nComplete more objects, improve your ranking, and challenge yourself to restore all **110 Messier objects**.\n\nWhen the final piece clicks into place, the complete constellation or deep-sky object appears before you.\n\n**Grab it. Rotate it. Fit it back into place. Complete the universe with your own hands.**", "short_description": "Turn the night sky into a giant jigsaw puzzle \u2014 now with Messier objects!\nSolve constellation puzzles or jigsaws using real Messier images from M001 to M110.\nGrab each piece, rotate and tilt it, then find its place in the sky.\nUse stars, constellation lines, the Milky Way, nebulae, galaxies, and Messier images as clues.\nTrack progress and improve your ranking as you complete objects.\nRestore the missing pieces and complete the deep sky.\nGrab it. Rotate it. Fit it back. Complete the universe!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jun1wata.wordpress.com/2019/04/24/spectraview-privacy-policy_/", "developer_terms_of_service_url": null, "publisher_name": "jun1wata", "support_website_url": null, "website_url": "https://jun1wata.wordpress.com/category/deep-sky-finder/", "
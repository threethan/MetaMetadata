m/v/t64.5771-25/499298502_1277605124305530_4939252586869181732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7u8v6Ov5eJEQ7kNvwFiBFmF&_nc_oc=AdpXQXpB5VBTrTii5yg0-RtuXrFiKJkhT5VGTIlkgzjVU9OnJrbiREQhvfAKfiyLMcE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af325Tp9-KD_1CrCfSW6Tm5vv-m0OHBSY9yjN38rfc5piQ&oe=69F1F215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560 x 1440.png", "id": "937199008904221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304764_937199015570887_6953729899292107560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCe4hUFYWmYQ7kNvwEqbaEm&_nc_oc=Adpxil_y177Gt-QTnBhbuFm-68WWjVyY4OrhjodvAkp_qFxj8fnclQubesiSHrHVgzs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3IgZwBMLCegJEgYRFtIg43ZTZx7bcm55hmvQbca4jtUg&oe=69F1E8B6"}, "display_name": "WRATH: Aeon of Ruin VR - Brutal Edition", "keywords": ["shooter", "action", "boomershooter", "retro", "quake"], "long_description": "The Old World has rotted. The Guardians are corrupted. The darkness is hungry.\n\n**WRATH: Aeon of Ruin VR - Brutal Edition** is a fast, old-school FPS built for VR. Dual-wield weapons, blade dash through swarms, and slide under danger to keep your momentum. \n\n{26839031932367628}\n\nBrutal Edition is WRATH rebuilt and enhanced by a simple philosophy: deliver a more visceral experience. Expect enhanced dynamic movement, over-the-top combat, ramped-up bullet effects, and a helluva lot of blood. This edition also refines the experience with wide-ranging improvements to combat, audio, effects, and overall polish. It\u2019s the definitive way to play WRATH and you\u2019re going to make a damn big mess doing it!\n\n{876196982105705}\n\n**What you do minute to minute:**\n\n-  Sprint through gothic ruins and cursed wilds, hunting secrets and survival pickups.\n- Keep one hand precise and the other clearing space with raw firepower.\n- Break formations with movement, slide lines, and blade dash escapes.\n- Pull out an artifact, use it physically, and turn the fight in your favor.\n\n{943083994749418}\n**Key Features:**\n\n- Dual-wielding combat built for VR\n- Quick reloads, two-handed weapon handling, and quick access to your arsenal\n- Blade dash movement and high-velocity slide\n- Physical artifact interactions, including throwables and deployable\n- Hand-based UI and an interactive 3D journal for lore, objectives, and options\n- An unsettling soundtrack by composer Andrew Hulshult (Doom Eternal DLC, Amid Evil, Dusk)\n- In-run difficulty options.\n\n\n{1135180692034663}\n", "short_description": "The Old World has rotted. The Guardians are corrupted. The darkness is hungry.\n\nWRATH: Aeon of Ruin VR - Brutal Edition is a fast, brutal old-school FPS built for motion controls. Dual-wield weapons, reload with a quick flick of the wrist, blade dash through swarms, and slide under danger to keep your momentum. "}]}, "developer_name": "Flat2VR Studios, Team Beef", "developer_privacy_policy_url": "https://flat2vrstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Flat2VR Studios", "support_website_url": null, "website_url": "https://flat2vrstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es_MX", "ja", "zh_CN", "tr", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26195
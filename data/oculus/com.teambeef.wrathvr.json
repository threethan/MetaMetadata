771-25/499304938_1288053109898093_5627647101387157081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDg85xs5Er0Q7kNvwEbXuR9&_nc_oc=Adrxsoy_KoZGHfswDk8vGVzM1p0h4Nuk_lnfm1tzk7OrRp9veOe_xVFnhijYPjeVif4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXUBhce4w4zneQdbllrVZM_gY302v4-qbKedHh9QNDeA&oe=6A942A7E"}, {"file_name": "___nf 24.png", "id": "1277605120972197", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499298502_1277605124305530_4939252586869181732_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKdINS3izlcQ7kNvwHzQA9-&_nc_oc=AdomCoxwMX85tTpdTmnGgsCdoquJ2kKtDarCkvryiAa8Az0izDvIl6qSH8aapfH8ckA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfs-oIzjG5vkSARafpKh6BYTiGzOABw_SOBODH5swhpQ&oe=6A941A95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560 x 1440.png", "id": "937199008904221", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499304764_937199015570887_6953729899292107560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3tO8mNMGcEQ7kNvwEZbd5z&_nc_oc=AdoAMCsaQTUVw-9IgE_j5mBV3883vriDCG4v21x_2lTo5IrVPys4DNYm3OHaTQTTvFQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV49BCwL4y6lO7y8V_SBbcsVHDK2ThnLiRBqkaF-zHsA&oe=6A941136"}, "display_name": "WRATH: Aeon of Ruin VR - Brutal Edition", "keywords": ["shooter", "action", "boomershooter", "retro", "quake"], "long_description": "The Old World has rotted. The Guardians are corrupted. The darkness is hungry.\n\n**WRATH: Aeon of Ruin VR - Brutal Edition** is a fast, old-school FPS built for VR. Dual-wield weapons, blade dash through swarms, and slide under danger to keep your momentum. \n\n{26839031932367628}\n\nBrutal Edition is WRATH rebuilt and enhanced by a simple philosophy: deliver a more visceral experience. Expect enhanced dynamic movement, over-the-top combat, ramped-up bullet effects, and a helluva lot of blood. This edition also refines the experience with wide-ranging improvements to combat, audio, effects, and overall polish. It\u2019s the definitive way to play WRATH and you\u2019re going to make a damn big mess doing it!\n\n{876196982105705}\n\n**What you do minute to minute:**\n\n-  Sprint through gothic ruins and cursed wilds, hunting secrets and survival pickups.\n- Keep one hand precise and the other clearing space with raw firepower.\n- Break formations with movement, slide lines, and blade dash escapes.\n- Pull out an artifact, use it physically, and turn the fight in your favor.\n\n{943083994749418}\n**Key Features:**\n\n- Dual-wielding combat built for VR\n- Quick reloads, two-handed weapon handling, and quick access to your arsenal\n- Blade dash movement and high-velocity slide\n- Physical artifact interactions, including throwables and deployable\n- Hand-based UI and an interactive 3D journal for lore, objectives, and options\n- An unsettling soundtrack by composer Andrew Hulshult (Doom Eternal DLC, Amid Evil, Dusk)\n- In-run difficulty options.\n\n\n{1135180692034663}\n", "short_description": "The Old World has rotted. The Guardians are corrupted. The darkness is hungry.\n\nWRATH: Aeon of Ruin VR - Brutal Edition is a fast, brutal old-school FPS built for motion controls. Dual-wield weapons, reload with a quick flick of the wrist, blade dash through swarms, and slide under danger to keep your momentum. "}]}, "developer_name": "Flat2VR Studios, Team Beef", "developer_privacy_policy_url": "https://www.flat2vrstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Flat2VR Studios", "support_website_url": null, "website_url": "https://flat2vrstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, 
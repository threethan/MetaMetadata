901_632659206367957_2534151627966787791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQP_WH7N09AQ7kNvwHMWTN-&_nc_oc=AdoqPS-ckjC2MBbjhIl9u38MD2ino4UcAnB0LkOLCtmoqxiZbFvL-mV-_U1HRXJQLEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-TAipMShKCRjw8zmJjPE-YvggKVhKRQOSA0Wli6ArAw&oe=6A50F5C6"}, {"file_name": "screenshot4 2560 x 1440.png", "id": "528999803638114", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392129_528999806971447_5289137167670269620_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiMgWx7O-_UQ7kNvwHHRvVm&_nc_oc=AdpNz0VTXzW2-9WkGv6AizFYgJFMfqNVAm_Nr8mBl4RP3bq9Qy6BPAT-MfuFf_GSISE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAR_b9UQMffeyMFjA4DpnIxLM4QXE1Ub2dS106a1LKeA&oe=6A50F4AB"}, {"file_name": "screenshot3 2560 x 1440.png", "id": "1182241993530364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393338_1182242000197030_241756094547206027_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqKb282tfzUQ7kNvwGQvEPW&_nc_oc=Adqp4BYNxYYZn5Zsj3MMVfoNnenSQCPhUkrgeYQKUfBo93cfUI3S6zj75kCX0UQ1hHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA24JEmr7sUh92Xte85QRhgkgVnQySphylZXpglWj5cBw&oe=6A50FA42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WRATH: Aeon of Ruin VR", "keywords": ["Wrath", "shooter", "action", "quake"], "long_description": "# The end is near\u2026 but not for you.\n\nThe Old World has rotted. Its once-mighty Guardians have fallen to corruption, and the darkness that consumed them now spreads unchecked. But from the void, a new force emerges\u2014you, Outlander. A wanderer from beyond time and space, tasked with hunting down the last of the fallen Guardians and purging the world of its decay. Wrath: Aeon of Ruin VR brings the relentless, pulse-pounding brutality of classic \u201890s shooters to virtual reality.\n\nPowered by the legendary Quake engine and reimagined from the ground up for VR, Wrath: Aeon of Ruin VR is an old-school FPS in the truest sense\u2014fast, brutal, and relentless. Traverse sprawling crypts, sunken ruins, and cursed temples, uncovering the secrets of a world on the brink of collapse. Each weapon has been rebuilt for VR, featuring physical reloading, two-handed interactions, and the ability to dual-wield devastating firepower\u2014including razor-sharp twin blades that carve through enemies with vicious precision. Wield dark artifacts that unleash devastating powers.\n\nThe experience is fully tailored for VR immersion, with an intuitive weapon wheel, hand-tracked HUD elements, and an all-new 3D journal that acts as your gateway to lore, mission objectives, and VR comfort options. The new in-level compass system keeps you oriented in the chaos, while a revised save system and extensive gameplay refinements make this the definitive Wrath experience. The hunt has only just begun.", "short_description": "Hunt the corrupted Guardians and purge a dying world in Wrath: Aeon of Ruin VR, a brutal old-school FPS built in the legendary Quake engine and reimagined for virtual reality. With dual-wielding combat, physical reloading, and deadly artifacts at your command, the darkness doesn\u2019t stand a chance."}]}, "developer_name": "Flat2VR Studios, Team Beef", "developer_privacy_policy_url": "https://docs.google.com/document/d/1-F9vzSB2bf2KL_MjGzBZxSFeLUvem5QVirzGqK0EPaU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Flat2VR Studios", "support_website_url": null, "website_url": "https://flat2vrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "
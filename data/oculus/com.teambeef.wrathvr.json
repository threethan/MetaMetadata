qF6G6IiXYeWqsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBvZsE04Qm_mKM5lnOhOS3lt7EivxJff2_o5mpbMIQuQ&oe=6B0EF428"}, {"file_name": "screenshot5 2560 x 1440.png", "id": "1175688120783484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393759_1175688124116817_4648474636849828607_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ha4Z7bZjYUQ7kNvwFMWVkk&_nc_oc=Adpthowu3eefBwFPoCeXnB7Y74K3WXr7ZWWG2urEU3gqwqmvUyYDwnqTsrBb7J8b4NI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWzsKovt3641rZk_3a7Z4ahBGeDOT8bQcNWLbDAuetZaA&oe=6B0EEFD4"}, {"file_name": "screenshot2 2560 x 1440.png", "id": "632659199701291", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_632659206367957_2534151627966787791_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTvcsjJbiTcQ7kNvwEG0Fu-&_nc_oc=Adpf6xnj4fbXhPWxxgGJuh5QboOsR4i22JkVRS2J_RSEsKJaVtTjH6G3htv5rmD-hTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWkDVsGRIXpvx1cKTNm3QgvfX2FMJdwJrdD84KCqXWkLA&oe=6B0F0606"}, {"file_name": "screenshot4 2560 x 1440.png", "id": "528999803638114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392129_528999806971447_5289137167670269620_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGRETR56tzkQ7kNvwEhnwm4&_nc_oc=Adp_U05JItMnCAQUJn4sEIMlXjQOD4G1d6Vjdvi3fcmwNfnQMrk7EiFeo0rWcCl_uW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6p5Sm_wDkoidkRBlyg5oAgFFHjc9hiD8gkoNAvUgSUw&oe=6B0F04EB"}, {"file_name": "screenshot3 2560 x 1440.png", "id": "1182241993530364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393338_1182242000197030_241756094547206027_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipIprVT9C7AQ7kNvwH90wnK&_nc_oc=Ado0dI_DpbSuKJJxU9B6AABm5lUiCtwFCn2d2pjbL9UL9aY9RPEiJS8TM7IBIfXbgEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVUwfPSibigL4cToCA8Og7nFr2dvnBp-JOTVpvnGN64yw&oe=6B0F0A82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WRATH: Aeon of Ruin VR", "keywords": ["Wrath", "shooter", "action", "quake"], "long_description": "# The end is near\u2026 but not for you.\n\nThe Old World has rotted. Its once-mighty Guardians have fallen to corruption, and the darkness that consumed them now spreads unchecked. But from the void, a new force emerges\u2014you, Outlander. A wanderer from beyond time and space, tasked with hunting down the last of the fallen Guardians and purging the world of its decay. Wrath: Aeon of Ruin VR brings the relentless, pulse-pounding brutality of classic \u201890s shooters to virtual reality.\n\nPowered by the legendary Quake engine and reimagined from the ground up for VR, Wrath: Aeon of Ruin VR is an old-school FPS in the truest sense\u2014fast, brutal, and relentless. Traverse sprawling crypts, sunken ruins, and cursed temples, uncovering the secrets of a world on the brink of collapse. Each weapon has been rebuilt for VR, featuring physical reloading, two-handed interactions, and the ability to dual-wield devastating firepower\u2014including razor-sharp twin blades that carve through enemies with vicious precision. Wield dark artifacts that unleash devastating powers.\n\nThe experience is fully tailored for VR immersion, with an intuitive weapon wheel, hand-tracked HUD elements, and an all-new 3D journal that acts as your gateway to lore, mission objectives, and VR comfort options. The new in-level compass system keeps you oriented in the chaos, while a revised save system and extensive gameplay refinements make this the definitive Wrath experience. The hunt has only just begun.", "short_description": "Hunt the corrupted Guardians and purge a dying world in Wrath: Aeon of Ruin VR, a brutal old-school FPS built in the legendary Quake engine and reimagined for virtual reality. With dual-wielding combat, physical reloading, and deadly artifacts at your command, the darkness doesn\u2019t stand a chance."}]}, "developer_name": "Flat2VR Studios, Team Beef", "developer_privacy_policy_url": "https://docs.google.com/document/d/1-F9vzSB2bf2KL_MjGzBZxSFeLUvem5QVirzGqK0EPaU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Flat2VR Studios", "support_website_url": null, "website_url": "https://flat2vrstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9072959516135118"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2781860885492595"}, {"status": "PUBLISHED", "id": "941841738603770"}, {"status": "PUBLISHED", "id": "2356221544888678"}, {"status": "PUBLISHED", "id": "922856767005160"}, {"status": "PUBLISHED", "id": "1841262237068233"}, {"status": "PUBLISHED", "id": "972048645403379"}, {"status": "PUBLISHED", "id": "2510954602661282"}, {"status": "PUBLISHED", "id": "1854140791966327"}]}, "baseline_offer": {"id": "1854140791966327"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1841262237068233"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26932486916422437", "version": "1.1.0005"}, "id": "939260424427035", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": f
2181_8714496177136339468_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0miv5I9_oMQ7kNvwFWFAOq&_nc_oc=AdrE5b366yCaM58YgX5StFCS0YR-4D83N6foRl0HSBtONQchFyxkei4cLoswty0zPxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZBOPo7q6dtGXNW6DeBZC3j61QIg8pXOcu6lpRoCMfcA&oe=6AE75112"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-00.png", "id": "702646655853271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507818746_702646659186604_6023110641115963117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9dmIzUK8AQQ7kNvwGzHbrN&_nc_oc=AdpzNe6FsagMCm51c3yuqSmWyegUuyUx59HHoqT0M7FCC7u9KVj8aFh6VomFwBmRxss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYDuFbiE8bdvwsfqlAnjRLNqNN1cY7Ah6qq8XR8OzFdg&oe=6AE73AE1"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-04-51.png", "id": "729748156218375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824592_729748159551708_7308466246207165334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_DGvdOOLV8Q7kNvwEzlVnB&_nc_oc=AdqXMaBgxpqxdlX4RBgZJsVs-LYBD7GdHXUknj8nzR3N9Xh6xk8sZOJOaNkkiyn5M5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjIc6OCFXI3MbDIqRW5svAbD1_I7EuY-q-am-MHI3j8w&oe=6AE75302"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UREfzIvGy0Q7kNvwGyDoeX&_nc_oc=AdqDFURQzp4ZVw1fy7VKFfQ_9NzTWnB8rWzpmDKFgIyTb6MRoW2t2Lm8qqYxy5fHnoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-oqEOvDCRjGWjPDYWPQ6KfA1HHalHqwkOyOzuqL2Q3g&oe=6AE76C43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "publisher_name": "Acouple Reboots", "support_website_url": null, "website_url": "https://sites.google.com/view/calicoinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24071993235771627"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "980789587
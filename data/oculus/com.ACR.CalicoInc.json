_14-05-31.png", "id": "733288112448628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507829691_733288115781961_7456511755855079974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qKPBtLkAqoQ7kNvwHQ7Fm5&_nc_oc=Adm_4nMpzLYpz8WxxhWQBvPwYV9DU2UyIt4P0n2r-mJkQHuV9sGY6mvRfktFMMEOFiA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYpSllX-PF_MoXif8yoqyfH11p-eYDqZiK3sqW4UGBzg&oe=69B7FE42"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-10.png", "id": "2231076957348848", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828806_2231076960682181_8714496177136339468_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cb-4BiZY54Q7kNvwGt8Ezl&_nc_oc=AdnJyseAfJBXdfWoavYJmeaYGyF_KJqpRMntVZHe1nuSk8bFkLwI05BOX7QDcyYJWB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7WI7IJoBp4CEbM4SthsJJ69xrFcDL-Ayl8GBiwJL1gg&oe=69B7DFD2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-00.png", "id": "702646655853271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_702646659186604_6023110641115963117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2zSp3HK5G4Q7kNvwGxDAg7&_nc_oc=AdnOiiX69v8pbbn4i6O421VnVAOoeJJzWd6clKOYzi-W-1VSyN1oQWbXwZkTBSeGvHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIev3XLY59FIjxaSJCB5elqoBrNw4fO_zkbjg7OuXN-Q&oe=69B801E1"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-04-51.png", "id": "729748156218375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824592_729748159551708_7308466246207165334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKDzgl3QjnQQ7kNvwERv6y_&_nc_oc=Adn0Kr3roCqWNqZSSSWJWdJyCb5DAy1fvhhPnHnkUZiZF_wQA2D77bBPuEwyZDew5Js&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxVeZIR0dhin6rEr9GwOb6OLx4qxeDI6dA_5P6CoPdXzg&oe=69B7E1C2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WkC5aFIUukQ7kNvwHuc2MC&_nc_oc=Adnamp6kWFXoxO6DETKhGr-Mg4IAk7ipZYbcRm9HG7tJikTGkROJ2SmlqaqrJqgwMZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfygJkz3UfSN9HXpjFcf84HbIp_3lb5071-_tv6r0OdQxg&oe=69B7FB03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "publisher_name": "Acouple Reboots", "support_website_url": null, "website_url": "https://sites.google.com/view/calicoinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id":
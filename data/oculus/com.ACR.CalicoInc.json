2181_8714496177136339468_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxHRyGW986oQ7kNvwEWppAD&_nc_oc=AdrAHxYJIyGQHcJZr81Yi3dS9odxL8IRAZby2iHrqEbyCJ8cZUE-gh10sekxmPAkL00&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JtLFkh-6V3TDR2k483pkqhd1n0BSym-9RGtgnBRbC1g&oe=69E78E12"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-00.png", "id": "702646655853271", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507818746_702646659186604_6023110641115963117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAU5WtwUTl4Q7kNvwFd6uYB&_nc_oc=AdqB18KTUa4A-90yuQ6cS4cPRFQuy71rmoNh5uTReb4IkIiDs5ClArIB4HJ8SkQzPgY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gzvi-vhRxp19qrDmB0z9pW-zfYGbdU3Dc9K_HPTKGWQ&oe=69E777E1"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-04-51.png", "id": "729748156218375", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824592_729748159551708_7308466246207165334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDnwqzuKtCIQ7kNvwH4aEhL&_nc_oc=AdqFyuzd2XPcN9TF_sk0i0L1qtEQ8mUm8cxxQXdXhUJhxP1PwayaoW1AUnDj3h8g40w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OuaUftQSZeE5z525sWdPOZnJFdOaOIXlqysAzfHZ4SA&oe=69E79002"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVxjdBBNtj0Q7kNvwGzdZ3G&_nc_oc=AdpctxhXEGdGycsKe5cGazmpN_AMngqWM17WlcnHh9bf0lWqRVQ46QdPm5S00tYrq3I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26PjhZr4Lg8EYAKAXMCN7PO5gM9ZxbuICYSAg0XQyr7w&oe=69E77103"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "publisher_name": "Acouple Reboots", "support_website_url": null, "website_url": "https://sites.google.com/view/calicoinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24071993235771627"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "980789587
_14-05-31.png", "id": "733288112448628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507829691_733288115781961_7456511755855079974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlPaVkppptcQ7kNvwFVc7xH&_nc_oc=Adn__RjrNH9DbOtkNPq5lYtHupWqVkaD7CKcRMMhSJ51EWNNDZqmmvNwzu31b8cZtHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMIXVDnSDMCn3FFR3ZS9bAFVPE9aXxXEeaAdJ9YuDgqA&oe=69B409C2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-10.png", "id": "2231076957348848", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828806_2231076960682181_8714496177136339468_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21h1K2ERq0wQ7kNvwHaSldM&_nc_oc=AdkzPBc61YZLEKRoA0rLXJLDDq67rrwLLzwFn0KU8GLDpnDSfASTzIVXq2TRZG1Esqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZxxjrDqtKO-jRIa2Af_m-IGPoYGTnIzwc_18HsfkNkA&oe=69B3EB52"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-00.png", "id": "702646655853271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_702646659186604_6023110641115963117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3haesIZEruMQ7kNvwEWFSIj&_nc_oc=AdmTghRX-YanAg8epvJIb9e2yMrkf7SkNTD-4cP6p4HiWJ763IXlk77Vb4SzEaiIESw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTklxiplAOud7_7_p5J9cZ6tE4VoLO6wdnkxwoQwoSBQ&oe=69B40D61"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-04-51.png", "id": "729748156218375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824592_729748159551708_7308466246207165334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTTg-Ud0alIQ7kNvwGR0V4m&_nc_oc=AdlJLsCadkkVPB-8eqsb3ZjJjFI6SXUpwp3CV_88XSYIp4LJi41bWU0egXNtgMcOBA4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSDuCUIrS4bxNqOiDtf7XpBZzSCjxPlISNC9zmMaC0lg&oe=69B3ED42"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGNeNEG0kKYQ7kNvwHRdu9S&_nc_oc=AdkUlXbaOPXvZBqriRYtA0cHOZTuJuJDivE9xbW_FSWkGqziy_GxMx5F7RWYUVaZ91Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOkfznWOjn4MwHAk8r4fpQVxIJK7fCgSGiuyCLfNxzpQ&oe=69B40683"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "publisher_name": "Acouple Reboots", "support_website_url": null, "website_url": "https://sites.google.com/view/calicoinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id":
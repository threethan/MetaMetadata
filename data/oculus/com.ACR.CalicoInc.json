_14-05-31.png", "id": "733288112448628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507829691_733288115781961_7456511755855079974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyyh_wA4-j8Q7kNvwEWJVOn&_nc_oc=AdmcEslrHdYErm613VJh3LC6UEkFBSnxGJIfDtxKyU2gkDHYFsTWV-grs2qeDlnfnp8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0pxrJ7-v1YJjrvt4830JE4WCnpEyy_6fa9rAU53VOQQ&oe=69B01542"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-10.png", "id": "2231076957348848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828806_2231076960682181_8714496177136339468_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh2l2atcuecQ7kNvwGl3lec&_nc_oc=Adnp5Lh8EKo1KeXS2QDwJ2IPW51SYyt9Zj86eUbTGF7wYsvREyAVorHMyfL_QFid1ms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afys3wUgCLmOxA5hj9d3NZbr7kXln5MMo5d6nKfA1Y6toQ&oe=69AFF6D2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-00.png", "id": "702646655853271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507818746_702646659186604_6023110641115963117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa9Kxq40OpAQ7kNvwGLCXD1&_nc_oc=AdlPsM1cuV1rWW1Nk-k-MaFSaKFIZCIBXW5-FObOiXDmkfC3Pbj-JfQ7hnzUJtSmf7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNjgeHFEAaMrA6_gYNmx4jvOsIpRR7-qj3UfMUd6s_ZQ&oe=69B018E1"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-04-51.png", "id": "729748156218375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824592_729748159551708_7308466246207165334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1itcaj8VbiAQ7kNvwHsJLx7&_nc_oc=AdkrMIJ7bi2n8qVcKS3Czznw2cDH89a9mQB_wEdaq9KwMbQicRW6cftbN49kC1CEg4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd_XR7Lhpnf5k7CSlDSQNAgY9OXJUA5omwbc914Fr8rg&oe=69AFF8C2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuYZReBm94oQ7kNvwFo04XM&_nc_oc=AdlV5qkPi14hq892zightEixEbMYLJQyRnVG9_zbReUGVvK1_mJSEAW2d4LPtDBt4K0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzJ-3JVZvORRrSxa1z20YO7i7IOcXAhKekSTqggFLT8w&oe=69B01203"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "publisher_name": "Acouple Reboots", "support_website_url": null, "website_url": "https://sites.google.com/view/calicoinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id":
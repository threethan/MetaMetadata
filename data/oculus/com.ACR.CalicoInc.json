nt-iad3-2.oculuscdn.com/v/t64.5771-25/507829691_733288115781961_7456511755855079974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c35O-M4dIEwQ7kNvwHWRhGd&_nc_oc=Adn-eUrAUBoq4SPCM3jI13tWV5mryvqZ9cqCSQf5ukJoRvZCLqWiMrTPFuqEigxOC9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPr92OkeA7lTENHkcbSZZ0fiewxNRS336GTnMHbD7rqg&oe=69A04342"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-10.png", "id": "2231076957348848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828806_2231076960682181_8714496177136339468_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wvyzo6mJ_VcQ7kNvwGAfgJD&_nc_oc=AdkPjQ8AJhQLddlR_A6wiMakVfUuJlnmAbzIaf4gMYwS_ZHQ_n3rHJXRUCEuX3LlgYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMQi3Dlh9hWNOLcp7UVCJGDCnaci3sqF7SpmEgfW54PQ&oe=69A05D12"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-00.png", "id": "702646655853271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507818746_702646659186604_6023110641115963117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0vEAKO1e4wQ7kNvwEsN3ZW&_nc_oc=Adl1q_KBI8_8jBOopwxYvcTetR_hogTh9haA-24mDDZz7Qqv0lGyM1nYVYLcBomKAtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslHq25b2m6k6kmrv4J_cbV7D4zcMF9D9gaHWWUd6F1VA&oe=69A046E1"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-04-51.png", "id": "729748156218375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824592_729748159551708_7308466246207165334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4wQdz6GNdoQ7kNvwGRSFNI&_nc_oc=Adm4WIBTtjz29P3bG7mD3r3eEoxI1JAcw05TStQun_ibWjNaoubi8B2qkXcsym2bT2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpZXizkY4i8cQGdrNyhpH8lFATsf-3rNuRWa1Zvsqd9g&oe=69A026C2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94mmh8lAZZcQ7kNvwHDYgEF&_nc_oc=Adm8trcpw-CmLEsdJe2X7V03f1WUzE4YAokZQIG4W-NY0FpMF21DrzOuQvGEvXrVlfI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDuXC_DrMU1Td2UgTyJpO6H8vE2bUmhBV_bHhTniWdzA&oe=69A04003"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "publisher_name": "Acouple Reboots", "support_website_url": null, "website_url": "https://sites.google.com/view/calicoinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
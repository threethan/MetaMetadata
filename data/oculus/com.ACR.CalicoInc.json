_14-05-31.png", "id": "733288112448628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507829691_733288115781961_7456511755855079974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyyh_wA4-j8Q7kNvwHqZ8TR&_nc_oc=AdmoHKS2W_kVMfZyPHJLU-2BUlO71pZE1jVsNSul2K3M2bvPaEF1ioHk8iCELo70uWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVt3upg6hpHwSSGaDE2ilUJ8eF6U-DlYM4faSUONK0LQ&oe=69AEC3C2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-10.png", "id": "2231076957348848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828806_2231076960682181_8714496177136339468_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh2l2atcuecQ7kNvwEmq9pT&_nc_oc=Adn4cg0dQOi6NsCHKOKmLwn0XqtvcYaBHsnZ2cWx2KnXwZGGQto-ZO3F0GUfv_nWQKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2qlqOTLMSHpP9uCVY0cfd8bnjnxLOyZczy1VzH1n9ig&oe=69AEA552"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-00.png", "id": "702646655853271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507818746_702646659186604_6023110641115963117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa9Kxq40OpAQ7kNvwF_rNOA&_nc_oc=Adk_BXpp0D9yyzR1EBGdiZ4w4HBUSezQJATInvvxQ1BxELHMjRemVxb1NhEklsxXK9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJR537ZDtZYwcQdv3n0NmfwBTLb2GOvSMaNjdILibvXg&oe=69AEC761"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-04-51.png", "id": "729748156218375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824592_729748159551708_7308466246207165334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6xHW0hoNegQ7kNvwExNEN0&_nc_oc=AdnelofzUGT3ofTWGx1JY78d6QmfIuPgHHytc63LmKuB4mmLDDjvNDxnIOjW6Sy0jz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2BTfUK6DVzmgnOV55lcC3HAn4AJrvyScf0fyn15q8sg&oe=69AEA742"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuYZReBm94oQ7kNvwE5hE0b&_nc_oc=AdlRvTdxP7E-_vdKcDAD8dj61RmXKOpjZEPsEyCJdbxjj7EskMSc2XR1evEKKW26-kA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIQzA7UDIuPqM2hqtZ6qzr1R01zHbARRjJQN3MQd4hFQ&oe=69AEC083"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "publisher_name": "Acouple Reboots", "support_website_url": null, "website_url": "https://sites.google.com/view/calicoinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id":
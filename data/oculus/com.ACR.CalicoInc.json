nt-ord5-1.oculuscdn.com/v/t64.5771-25/507829691_733288115781961_7456511755855079974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5oB5hvNaDcQ7kNvwGWDKID&_nc_oc=AdnKbjrzE2DsTUq3ypVY39dXkaXlyjuakVxU42jjmFXiszdknR9Y4qFKduBwcL1FPZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsLhFWmyqBFWojemL2J7ZsRDfgOuaRc-BWt3rCHBpRSfA&oe=699AFD42"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-10.png", "id": "2231076957348848", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828806_2231076960682181_8714496177136339468_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnsc9-sgwVQQ7kNvwFpHpBI&_nc_oc=AdmmTruTzQze0c9eXOTg1Y2h2XZWBR5ikyTMpIziZ7rZ6HkcY4TFOmvUQdPwpN6XdmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsl_xMMrGxCuaTix2WuixaY6RwV1ezN86ZWajSozVxOAA&oe=699ADED2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-00.png", "id": "702646655853271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_702646659186604_6023110641115963117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5JWoAFA5ksQ7kNvwEWhrpO&_nc_oc=AdlWC3tHXxArmz7Cq5Ybx0IUBK8S4ajS-eJGZkii4-FuGXJfENxmZmOfZUdgVNRYD0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvU7UfDg0m5jE1EU84mSPfLLSr4gSZDSaOHFJmo4zXtOQ&oe=699B00E1"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-04-51.png", "id": "729748156218375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824592_729748159551708_7308466246207165334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTE14zVlKOQQ7kNvwF1jAFK&_nc_oc=Adm6vCDMXPrHYweucm2zDvuW_zae8XNLlZiKIDm1nF2b-olldMxyVx9b2Lx9oIeAcN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftMSOPI8WacGgTcxbtDZ_wzVWjH1PElNE9R3XVihu_0hQ&oe=699AE0C2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6x3E-PvFK0Q7kNvwHTVAZQ&_nc_oc=AdmLp8WMgUYXDDv5YPjkC3FX4m0cSevxcnj16qRVyekMLcDYaQzFfqnbVWPGNXftmfI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsnj6s99mmUPcqJd7-3MJSdKrNAr0MlYm72PjuT8Olwvw&oe=699AFA03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "publisher_name": "Acouple Reboots", "support_website_url": null, "website_url": "https://sites.google.com/view/calicoinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
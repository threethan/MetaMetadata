TMJNJJPtgiPv2T2Xg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSl3_31JL5kYkk8Az4DXy2-89zU92rebqr6VgnEHmQMFg&oe=6B0C7542"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXmWVMJstmQQ7kNvwHK9o7Z&_nc_oc=AdpyBIIYNjAFtYfqAmIhpx6EARiRGxh3poxt450ihNlDYvSlfy_nmnsEX2UI3Lit9J0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8pvownZ4qJkQ9QH4JwA_Rk11bZLU9GFt3TQCZ_Gi5aQ&oe=6B0C5643"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "pub
e=69A56AD2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-05-00.png", "id": "702646655853271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507818746_702646659186604_6023110641115963117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhq4UoTeK6gQ7kNvwFES6hR&_nc_oc=AdlorACwppE5KQbgoMj08PoRHaYEwUdUOIQMB3uzMyOgFCQPX4SkocqL7HLPPav1YF4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfumngAH0d_YDAdV1LBwFS3DJdfRmlRMq70vKHRRrhUXLQ&oe=69A58CE1"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-04-51.png", "id": "729748156218375", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824592_729748159551708_7308466246207165334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpATNDDXTp8Q7kNvwG2hAnv&_nc_oc=AdmFEZ0lw5FADwCdQoMs_CaGfEnqbOQvtCQv48RHGloRML8LStv_e_UlczbwAlagxtU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu9jFrt5Yx2z-7RESTLwHnsM-rrzoGb2iKF43wuszE7yQ&oe=69A56CC2"}, {"file_name": "SampleScene_Custom..._17.06.2025_14-06-25.png", "id": "1464554918044035", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/507829689_1464554921377368_1711899260094545497_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFFEr-wv6a8Q7kNvwGuEu-5&_nc_oc=AdlxGRhstpEFizHnchjqGOOuuLdN6s_N6CI21Xvx5MNXLJQ9CrUqs6YanKASWcGkeDg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs2fwYg1acQjWDF6sopG0eXJwYEG1PrmZHdnIXXfw6kHw&oe=69A58603"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calico Inc", "keywords": [], "long_description": "Calico Inc is a chaotic, thrilling multiplayer survival game where teamwork is your only shot at making it out alive. Trapped inside a bizarre corporate facility crawling with horrifying monsters, you and your friends must complete a series of bizarre and sometimes hilarious tasks \u2014 all while being hunted by relentless, unpredictable creatures that stalk the halls.\n\nEvery level is a wild mix of tension and laughter as you juggle objectives, manage limited resources, and scream (or laugh uncontrollably) when someone inevitably attracts the monster\u2019s attention. Whether you\u2019re stealthily sneaking past danger or sacrificing a teammate (for the greater good, of course), no two rounds ever play out the same.\n\nGather your squad, gear up, and get ready to run. Welcome to Calico Inc. Don\u2019t get eaten.", "short_description": "Calico Inc is a fast-paced survival game where you must complete critical tasks while evading terrifying monsters in a mysterious corporate facility. Stay alert, stay quiet \u2014 and whatever you do, don\u2019t get caught."}]}, "developer_name": "numnum033", "developer_privacy_policy_url": "https://sites.google.com/view/calicoinc/tos", "developer_terms_of_service_url": null, "publisher_name": "Acouple Reboots", "support_website_url": null, "website_url": "https://sites.google.com/view/calicoinc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24071993235771627"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "980789587310120"}]}, "baseline_offer": {"id": "980789587310120"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750709760, "status": "PUBLISHED", "id": "980789587310120"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2410373926926
572oZSXA5FYbI6QjGsoopU1bRjPgvDCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ0sucigJWbksmmtHUS542s_mh5brd05WxnZl6zsDPbw&oe=6AB28A71"}, {"file_name": "screenshot2.png", "id": "3419831731485226", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392105_3419831734818559_1704518568771537687_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfX5HDnTWx8Q7kNvwGhjTLA&_nc_oc=Adr1x_ACJGlHl1-qjPmtlZnIA1X_uTIp_xqiecWm0pHyYNuWtxTkhRIMiDpGwsHKbrU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw-kiE2gOiFsclohlnyws-jkn_wFieWU8fpzbCso9TYg&oe=6AB29734"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzXVM4WLwNwQ7kNvwEYPdFE&_nc_oc=AdrwM5LgYcwdXvYHD_inKy12hdTP-uhu3vLaM-HcNbQ4nmPxZ4mSCPYtXGtlSnD6xVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEEV6z4s69YHtH17lpZnNPuVOAZoR6mK8r_D_2dvtsww&oe=6AB28502"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrkDHT-K0d4Q7kNvwEZqeZk&_nc_oc=Ado-JBIF-CYzWTcY1bdqB4QNwMO09QNYpi3F2crzFAEofvIlalrKDCZmIaJCS5K2Itk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfDcL-WAadkfzhldQ7nG5d-G3J-leXpTc7hzs0L5PxnQ&oe=6AB28625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U_Lbamka9cQ7kNvwGnwvUL&_nc_oc=Adp-243SQ2hZmt8-_N5O1W9_h4Yr07FFh_Vr8daNyywJT86Gk6VH_8P5-OrGePY8cdk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFM0mqVlCUltx9NawMXkNlAYiADESf9_6kox12jGLhaw&oe=6AB28CE4"}, "display_name": "Scary Dead Nights", "keywords": [], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME",
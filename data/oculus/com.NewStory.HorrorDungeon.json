8c5-1rWtt0wXQR92DkpSHV476sIWaFYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQcp01_V7zujOxrjG4n7_gv0eXGVScTX5w87Yvpvur8g&oe=6AA7FE71"}, {"file_name": "screenshot2.png", "id": "3419831731485226", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392105_3419831734818559_1704518568771537687_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozAV-GmqxlcQ7kNvwHA2Njo&_nc_oc=Adpim9O-li1zN454kB5TOdFCa3MGegtXUNhXVhlgo4SHtxzFktQb4mkJ7qqjr1UUOkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcmDJlg0aHVezIEi7SxIXeojnzpEGZs2T48HCBNM1GPg&oe=6AA80B34"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i14jspFLyuUQ7kNvwFmhPZy&_nc_oc=AdrBxRh9t4jhBeynr0xXg8cIiRaHzRTwJ9YCkkUCw7b_gRKMVVmrhOy0Yjl9Ul7NrXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFYZ09c7vb0MkSVeYXy2vVIaFnZjREk6AuHW4xA8P1BQ&oe=6AA7F902"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDWVB672LZgQ7kNvwES6Uru&_nc_oc=Adqe9ZqyonT0ClxdBJtgck09KcdpAlcArCzZe4lo6YADJ_LvHLGw236YhHBsderBxIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRWtAZSysQygoVehqVb6AArsk4XqhHMhoEcIlB_iHgpg&oe=6AA7FA25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0tjEkVfBOoQ7kNvwHwuY6g&_nc_oc=Adr4L-bryeORPmrYm5D6Xv4aXZa_hSK06YaKOSlPc_gASdVJY9UCNU2BUn2HVMB4q80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhHlSH1O5UGiGoEO-JNRl4909UyFoMuKLBFk_S6gvhyw&oe=6AA800E4"}, "display_name": "Scary Dead Nights", "keywords": [], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME",
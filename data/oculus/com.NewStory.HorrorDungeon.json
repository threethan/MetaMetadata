AsbZdK7g01lMteWJZ8E5gcL6pX_0EJcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLq9BSkoFvvkj5iWl5RoUWVEZKcuNbnsnB-MN3N5JBcw&oe=6AB921F1"}, {"file_name": "screenshot2.png", "id": "3419831731485226", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_3419831734818559_1704518568771537687_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkT_qdRIrLUQ7kNvwGCp6E8&_nc_oc=Adp863oxgtSbcKI1IYmx1_B64nZcNT6Tt2q8Eel6u5IDs3jG65XPcftY-B747C9mzFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxdZaO4Tw13VOdV7VD7DV7jszwR-xBtYjL-0jscBE-ew&oe=6AB92EB4"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5wS9tiJ1pMQ7kNvwEZFRAl&_nc_oc=Adr6QGdwPN6wKfPIAGRnjv0NfWsIJBSevWR8qKLzRtkvuvpBf9K-BoFGliElYBycraY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyV7DkKQn3FyxwpJTDXJrbWuhtngOKwY0OgvefuAN2PQ&oe=6AB91C82"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG6lg-eXTjYQ7kNvwFr4dPD&_nc_oc=AdpYP4rYU8u1lmA9DFnaAZBFTcNbm7nYMOkFuLY8rweX-GQWB102NLF2MrbiOLKA5S8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIREr3vEkrw7WFdHRfXbVTdxh9UZKO6oL1JI0N5GU6-A&oe=6AB91DA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St3nh3YwJZ8Q7kNvwFSJT1m&_nc_oc=AdoUiS8X7Ct9Uq6eo2ZO-OSrNRbLF0g8OJhF4CycTIt52aYM6U-I-mf1EqTPB4pmV2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFO3RNOa5ApsOhhyLhX2xUBh4u4ej-bo3yb7U9fsFVug&oe=6AB92464"}, "display_name": "Scary Dead Nights", "keywords": [], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME",
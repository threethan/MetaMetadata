Q7kNvwFOIsru&_nc_oc=AdpuzmviyNKl1pYfG6w7RrV4LVhJtmWAHtmNJq2VHpcwidv_vl6ZsbgKZGQRk6KHGyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY2RuA2Zvn3EuxL_82gCdUkXlfXFX_A5hU1EnmL9eC0g&oe=6B09C5B1"}, {"file_name": "screenshot2.png", "id": "3419831731485226", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392105_3419831734818559_1704518568771537687_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzjHVDyHiD0Q7kNvwFQTUib&_nc_oc=AdoHA4eOrcxsvXr72GYPXYwBaw4Xnk3FBP6bBq2Phj6wqjQs7JP9nFVygixAG1IDTyQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG47J8RrJZzktgtQxDq3gKHO7gZhnthECduhj9vqrZ0g&oe=6B099A34"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9V9PCvsWuIQ7kNvwGBk-no&_nc_oc=AdraImoGMhUBsL3Q06MFfMZZUnFmUnT7WeZ1jnnO9P1Eg2nF_22JZT0LbTG0nm6ZHWg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpVrI3xCX_sfsgMhfjAp3UTYD-BTLaY9AsDF8N_LIYmQ&oe=6B09C042"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLYKA5wFrr4Q7kNvwGe8ibz&_nc_oc=AdoleE-a2Sp-XgBLoYoPTV-zIbMu-IH-E3rwhnL9JSR9y-k3RlXp9pwJPRzyKUwITd0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsNfyqKxe3L2FNATSFJO2nwxDi-XmR0X1tJgpBh5C6RA&oe=6B09C165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqDKqpdj0LwQ7kNvwF2vw5K&_nc_oc=AdqGo3MSkmLNL0i3vy3xTa5nTWWgp6LsJNn_q6NWlojnHNkvz3iL4WrNsxDHL4tOVa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDDvm313QmranrjGofDOE_mSuhEYGE6sZ-CR6G9rvTTg&oe=6B09C824"}, "display_name": "Scary Dead Nights", "keywords": ["Survival", "horror", "Puzzle"], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_o
Q7kNvwHZkAH7&_nc_oc=Ado5U2633sUzjZwgbwS3kV8yq2ubQYqln68E7OH6wIqNxMrx6s-ci_uGOxi2BP65p1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSas4DPttJfhLHI-qGX-ZYgMiJJGcutNq5wvV4U2ejfpA&oe=6B05D131"}, {"file_name": "screenshot2.png", "id": "3419831731485226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392105_3419831734818559_1704518568771537687_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImBekMfH8WkQ7kNvwFBp19D&_nc_oc=AdpV4UYOd7fB4-s32d04dxIqxTyQoYJtzyjJ2mFDl8ta4bIBVmbN76hV2O61TfMS4k0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh0UPca0KqAeHjfufkDUyaJAHfWA1bLS_8Uv6oCq7TDQ&oe=6B05A5B4"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0VEg1MhpdUQ7kNvwGrOErG&_nc_oc=AdoCkleKo7wK0Pa3v4XFPpMl1gCOShzC1lfpMQ97ueUYz-I46wa0movgFh0KJyd7bFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoIwW1tFAOKhJDZPObjiUmWs3Hf8-CGO_PQuF2TfAz8Q&oe=6B05CBC2"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUrtiFMcopAQ7kNvwEJw7yf&_nc_oc=Adp_Mfmt6dIIOTLjQxKo67N8hJpxI0RRDjhx8ks-Pxw-fHveQUd6AIYhOaXNnihHpiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8V7k1gp3csaObPrc49Ki5ueDK7rAaRZ__4gdrUHRxUg&oe=6B05CCE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z34OHfNEUzMQ7kNvwFUN_uR&_nc_oc=Adp3s8hQTD4CZ2ga1vPmooqRzYZIpQLYaAegc0tJX5XYM-USZIMNsRgYqcbVXo5tH88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3cX3PHSzxJN9FFVxeOW-k8vIbGUTWOLTqteHyPFpFOA&oe=6B05D3A4"}, "display_name": "Scary Dead Nights", "keywords": ["Survival", "horror", "Puzzle"], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_o
prOQGXbzak6csuRSCg&oe=6A95C1B1"}, {"file_name": "screenshot2.png", "id": "3419831731485226", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_3419831734818559_1704518568771537687_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LgwujP6e1EQ7kNvwGNLKzC&_nc_oc=AdqU4XXf-ZISauLzNtoUt_7zP8s8ilxGhFmS1ko6w3-W7sF7Hk5MlepUFkxRSJUE1R0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-Dqg2Vk7x65-vpHCemnpKRkwZG4OIelqCn7aIpCj62A&oe=6A95CE74"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yslGR1WYyrUQ7kNvwE9dVwy&_nc_oc=AdrzaDTe7rKNR-OAzwR819Czc-2Q2yd-jl_65fpIqk0jHv-2DEl3zmrRsxLpHLp29Ic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe3GY2mcY8lLeoBQXdXJD3VQ9568cQwl5nEjOtOYAciw&oe=6A95BC42"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfo1JvxW8GsQ7kNvwEXBORQ&_nc_oc=AdqcuU1DHXJr4aY8wJhL4l_yBqQWWWG8hJDpHIxloevvMSg7se8jmbEAhWlpHwntWFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPm5ZBOeL_DRrpN_pjCqxuKBv-2IKFqqOGqXeptF8GDw&oe=6A95BD65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRjhX0nOy1cQ7kNvwEc4SGF&_nc_oc=AdqQks954s_WOUGXso_tozwPgG_QX-t5fHQh87Ht_mYbym5NF_7J0_qcb6qK8LTnADI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEox4I5fukI9TSY-HFSuZeymlwkDewsprYhaMCF5fkMQw&oe=6A95C424"}, "display_name": "Scary Dead Nights", "keywords": [], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2
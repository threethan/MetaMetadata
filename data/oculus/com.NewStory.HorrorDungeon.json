Q7kNvwHE8is1&_nc_oc=AdpzK9mxI9eaVGxlx9j4vQ7C--QVwSu3BgAbN1JCTg8_nZs0MCSqLOtjI1otOnv1cTA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa5F_Zd_7dTDFDwBp_kDNc2PG9hRuMv1YPYPFDc11fKw&oe=6AFC5E71"}, {"file_name": "screenshot2.png", "id": "3419831731485226", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392105_3419831734818559_1704518568771537687_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJi24ZxWcIQQ7kNvwEC_Pve&_nc_oc=AdqAcIt-ykuHes8xtRDuWXB1mrNW9OTFIg50j1G2Y3Rs2U1VcvZxpplmG4DKimrkDy0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgr-tiy8f-y00XBj1KOYqmwGzgmqcLfje7nNC7KEEMDA&oe=6AFC6B34"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNf9piTpHvcQ7kNvwHQHpMH&_nc_oc=AdrDlQFuw4ZrB0oKW470oLZEOOFekhfbAhuQQvRPUTwdpbx_xPFPzU9b74ofC5Qoxu4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKrTer6OKGKtlO5pdypjXHJWG9eKYCEMGYZq5iPOYBoQ&oe=6AFC9142"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ppC-ZtfwScQ7kNvwHjSTpk&_nc_oc=Ado3Xc65SO1LznpaQUu08i6cA4Larkpha0pGuZJMKSB_L7Z5EIuAYxUzMw4hHv-LYcg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC08g2gPsbHCkWGCphGZZeMRypFtn9KKQnqG8mJ7_Y7w&oe=6AFC9265"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d453u5BMeYQ7kNvwFAqw2p&_nc_oc=Adr1mI8c_6ttrWhdmtOisg3ChvnD_h4iILN9HGAQvdjyCq4qj-bp_mDAim6A7f40JgI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC38-nMiEMblE3TzXcOl5KSUODTTcwZIYK8HyTEL-Lzg&oe=6AFC60E4"}, "display_name": "Scary Dead Nights", "keywords": ["Survival", "horror", "Puzzle"], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_o
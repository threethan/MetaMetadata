dAwKJnjGPvcdTfxS2y3Laa0-d5tKWED-kkg&oe=69F5FE82"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laaJlSfc0lQQ7kNvwFpPiiV&_nc_oc=AdrIdZ0K0on7d78iRrIBC17xKtbl352U1vT6FDNNEGpAtL4g4EGuIgQB9OnR_tyDYhM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12j1SXv7yDikHk8f064qWROQD2ZyQT3dWVicLBlcgFxQ&oe=69F5FFA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJdbqSCgbwwQ7kNvwGjk8C0&_nc_oc=AdrTZKG-zJUpjWEO9LOzl4O8NgYboaEWKrBYZ_rAsR8cvgH5LjJ5WzZj1yu1VJutG90&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qeui6-bPgWaRpEuAriiHx4sXE5yHAxr6GjaAC5RKiDA&oe=69F60664"}, "display_name": "Scary Dead Nights", "keywords": [], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9384324231674987"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "781927827995948"}, {"status": "PUBLISHED", "id": "1817999768779835"}, {"status": "PUBLISHED", "id": "1067259241881889"}, {"status": "PUBLISHED", "id": "955995373404103"}]}, "baseline_offer": {"id": "955995373404103"}, "is_approved": true, 
971"}, {"file_name": "screenshot2.png", "id": "3419831731485226", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_3419831734818559_1704518568771537687_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SVUfzeL3H0Q7kNvwFFTwwd&_nc_oc=AdrFu4IUpMcSTIfbDZDdRC2P2YBIWwNuZ03RD4n_ufXNfic6pveayst3JSmNllujMww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGB9MFps8e1xN8P2ApcjkpXifKog8-UHyF6COTrwp5MA&oe=6ABFC634"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlotObKfDpoQ7kNvwEgiwP6&_nc_oc=Adr_lqlfT82_pBsCakCIUDa5n2g-WNx2mt0I9wGlBME3Bgm5WIeCIK2bFs3xxTNyPe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr94OkN1pkaxEW9Y3u-x2AMsSPCejyu-JaGl8kyIvb_w&oe=6ABFB402"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9QdQ4luOwkQ7kNvwGwZcCu&_nc_oc=AdpFFGCapH7_oMmemDMPZdqWT9bBmJtbC8Vku5czWZuthH4S_-tFHCM9L6OC0XjuZhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqX-JtKn5idd3Piv4sB8HneJPW4MCObEROwaYDyZzBVQ&oe=6ABFB525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS9SVP2hlMQQ7kNvwFqmzSl&_nc_oc=Adp53cLeuEyFv-1FvSfqlkw6Mznel4cf1BiFFEnWqjd7xRLUGsE-fVc64Z5ZDO7t458&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBVq0Fsh8FaQyH9WMfLAtktEb_LKD4YlozIAMTXHlqpg&oe=6ABFBBE4"}, "display_name": "Scary Dead Nights", "keywords": ["Survival", "horror", "Puzzle"], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
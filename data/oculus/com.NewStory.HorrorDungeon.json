51_1219996390133940_1652139665050494723_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8iGVueDrikQ7kNvwGvuEAm&_nc_oc=AdrfJ54GPLKSoPr4KpdSxGyR1eOPAa8M4I3rSeNkVsitZFUUqiCS4AxQKZyyPYIf83Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6OrOEpLyjiUTwjM2fFRXc61KSOPvPTsssZlzXC3PQXQ&oe=6B105D31"}, {"file_name": "screenshot2.png", "id": "3419831731485226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392105_3419831734818559_1704518568771537687_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osdMQ_jkedoQ7kNvwF5U2Sa&_nc_oc=AdrV_R8DiVidrVTcUBEik2ay097r8rOAMwMwrgL_KnnIEo3PZTMZZ54rkSEHfuaLNWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV-WPS80BLC9GOS3OaBgpBsru9OWB8ZHuZ2u8wOToeyvQ&oe=6B1069F4"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-0O210GGUcQ7kNvwGTRpvf&_nc_oc=AdpDggm9jVrh1hWFGeBDYc_BY_tZZn-25BXvAzphR0nF2etbmUFKgzbp3WbeBVHWPg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVy6bLxZUQDVs1g9J-tazNn12SJdHumFq3U3Seflv5huQ&oe=6B1057C2"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN7LV6idNI0Q7kNvwE33fdo&_nc_oc=Ado4nulALFfvUglIobC9HoudlKIfEjKx7HpWDbruWd8q5NpDGmTP_H3d_sqgnniwkBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJjhZDwKBkggTjD8ZL5ICIfen8Q3k4dtD_4NSy8IcSzA&oe=6B1058E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8-YTc3TVrcQ7kNvwE0lenz&_nc_oc=AdpQ1QDdLzcKVwU8_q8lTFL47RpysErVLmHeR2snte_ClqBvZnVfFVF4DRqwjzkkevI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOHwsDzNYV82SGC9Uubdtbv4Tqm2rrKyjPxDeKMEIRQw&oe=6B105FA4"}, "display_name": "Scary Dead Nights", "keywords": ["Survival", "horror", "Puzzle"], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27176254888721981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391954_521749244026950_461516161198272668_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjgA4aCU_P4Q7kNvwHEZp29&_nc_oc=AdoYcUlgWVG95aCtUQ5NsxqrF2iHfV7hylEt_8muBUEp1ZcmkTP0OYjYy4v929M-r8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXG4kAbwvJ6fkpYrOtlH-n9C1ovXyxY-xhDN8oSko8Xaw&oe=6B105C11"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scary Dead Nights", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1743682020, "lastRevision": {"nodes": [{"id": "9299527353488009", "release_type": "SCHEDULED", "administration_status": "A
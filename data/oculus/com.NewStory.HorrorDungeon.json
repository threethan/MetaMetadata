f&oh=00_AQHlDhZ3FiB7ji3YhcfAoibZR08n3GGABtPpD7nOIWCfYQ&oe=6A8045F4"}, {"file_name": "screenshot1.png", "id": "2169227793512189", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391921_2169227796845522_1751086112248992864_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCh8LPT3DpIQ7kNvwGThtDf&_nc_oc=AdroAt3I6MYOqGNre4jxZbzCtBTykE9JanZHQ2IDKZ_jwbg6efprseoB3fqvkFxQFHs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb-bkYb7SWd7E1JOV4SbkaddsMvaTrw4P5tY15jSx5yA&oe=6A806C02"}, {"file_name": "screenshot4.png", "id": "1185773750216604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391885_1185773753549937_6539952133673144749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO68nQNY84oQ7kNvwHQn8hv&_nc_oc=AdpcWGAZyI-hXQkKIrAPON7WpUf-N53VVikGgDsaxz0TloEWTF8yLzZX5Eg4NtkxOaI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZg0gEd6wKBmxAzxsekTtu97EkfoChAuAUdhC2A-34sQ&oe=6A806D25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "638637008882711", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393388_638637012216044_8049148435813989549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ri7niA_DHGMQ7kNvwGoAyef&_nc_oc=AdpYtyTut_fB0zPNqv6JqlBqfRhUI7PtBWoLr85EA2i4f67tj1wlhvTS-0ntI-P-Qj8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGIji4fYPGa2YpX2z4OSrraOUDPv7ERM0S2RFq3ylocA&oe=6A8073E4"}, "display_name": "Scary Dead Nights", "keywords": ["Survival", "horror", "Puzzle"], "long_description": "\nWhere are you? Lost, alone, with only fragments of memory and a cryptic note: \"Follow the pictures.\" A terrifying presence haunts this place, and it's hunting you.\n\n Search the shadows for scattered photographs \u2013 keys to unlock your forgotten memories and the path to freedom. Piece together the chilling puzzle, solve environmental riddles, and use stealth to evade the relentless nightmare that stalks you through this dark reality. Feel the fear up close in truly immersive VR.\n\nEach picture collected peels back a layer of a deeply disturbing truth. What happened here? Why can't you remember? The line blurs between the monster in the darkness and the secrets buried deep within your own mind. Explore a hauntingly atmospheric world where every shadow could hide a clue, or conceal the thing you fear most. Prepare to confront an evil you never expected.\n\n\n\n**Key Features**\n- Intense VR Horror: Atmospheric dread, jump scares, and terrifying encounters designed for immersive virtual reality. Feel your heart pound as you hide and seek safety.\n- Exploration & Puzzle Solving: Search every dark corner, examine objects, and solve puzzles woven into the environment to progress.\n- Evasion Gameplay: A relentless entity is on the chase. Use stealth, listen for cues, and hide to survive this deadly game of tag.\n- Uncover the Truth: Collect all the pictures to restore your memory and face the final, shocking revelation needed for your escape.\n", "short_description": "Every photo reveals a memory, every shadow hides a threat \u2013 survive the chase, find the truth, and escape your own personal nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_dev
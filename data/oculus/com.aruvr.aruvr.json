ract in training sessions and remote meetings, moderate and control what your audience views on their own headsets, in real-time.\n\n3. Interactive Streaming\nBroadcast the immersive experience live to your audience, anywhere in the world, transporting users to locations worldwide.\n", "short_description": "ARuVR is the world\u2019s first turnkey XR learning solution for Enterprises. Trusted by 1m+ business users."}]}, "developer_name": "ARuVR", "developer_privacy_policy_url": "https://aruvr.com/legal/", "developer_terms_of_service_url": null, "publisher_name": "ARuVR", "support_website_url": null, "website_url": "https://aruvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27885140704450905"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982678_4949302401855980_4896237859559316765_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDSJCf8TUq8Q7kNvwFZVSE4&_nc_oc=AdpuLeMTGpH1dTT5kDHNRGCVzV_pgcptJ-tIbaUJICFIeP_92zD8zKSWxlLwNXbhsTg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJVzjK9RXrFX0BLfLy-9Spc3aYSKXLp5ntIdufvKc4WQ&oe=6AF9C5CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARuVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "
t64.5771-25/39001655_1040310347165520_7426137919291405462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t1Cz8WIhuIQ7kNvwGDQuqP&_nc_oc=AdpdWOBl8C1lUBZJ7VrXOVMmnVETuTs9twndHbBZwFFfrPWvlj-Di0emrpBmSA-hyLo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D8CZt1VbbwcHlAvW9idoEMln-dd0JhwNm5vnzz4X8LQ&oe=69E24FED"}, {"file_name": "Capture5-4.png", "id": "3674100219471283", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75223486_3674100222804616_3378633347068020705_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYib39B4gggQ7kNvwFgvLpT&_nc_oc=AdqICXNTaqjQi4fkg39xNoFTMiHUVXe3r_KZIhLffxT7cuDuljpYTfqAU-5TG-lKBdI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MQfNSVNXrd95P1KYOf2nBD_XGe7qZ41YeyT5U1_6g6A&oe=69E21F77"}, {"file_name": "Capture5.png", "id": "2360923614103233", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001655_2360923617436566_1716315961900770007_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm_qLWBAKP4Q7kNvwFJzF2Z&_nc_oc=AdqlvL6Reoy-JcZVgXj_ffNODL60C0ufn5n9hw51f62dHuXnwZeM0DHmkny8U9CO0MY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b2_NsnJLrU2a8XMv7jPZOLuKB4TxMVZqdTK1wwYh7Fg&oe=69E232D3"}, {"file_name": "Capture5-3.png", "id": "672382414980649", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75429290_672382418313982_7235669626419530394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1qD4xMyRG4Q7kNvwGEMSpk&_nc_oc=AdoVz_vNmOOktqIagumMon3QrypuUrdVtBVUC93y4_8vjuWahG40TqADYKz-5s3lHr4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af019XU1_Vh-29Sbg5RS9SK8mmUlcRAVKyW-Mnp-EUbrXQ&oe=69E22BC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capture5-4.png", "id": "1201761504573664", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974503_1201761507906997_6376965417818159871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9F5eWTFESmMQ7kNvwFUcR4a&_nc_oc=AdoFOpsQgxS9fe1NQwC8AaPuU_Q9K1zy5fsV1XWHrGf4RpJEzXDkylD9TIZSlwP2I90&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JuaAsVTn9QSR3LG_hUNbwwqYer7_5FCftUiM0OTXfFg&oe=69E23BD9"}, "display_name": "MindMaze Demo", "keywords": [], "long_description": "Embark on an AR adventure with Mind Maze Demo, where everyday tasks turn into incredible puzzles right on your table! \ud83e\udd2f Navigate a car through bustling traffic with just a wave of your hand, solve playful brain teasers, and revel in the joy of learning through fun.\n\nImmerse yourself in chill vibes with engaging background music and lively sound effects that enhance every move. Engage in a 5-10 minute journey full of exciting challenges, and if you're skilled enough, climb the leaderboards to showcase your puzzle-solving talents. \ud83c\udfc6\n\nEager for more? Completing the demo can earn you early access to the full game with over 100 puzzles waiting to test your wits.\n\nExciting, educational, and easy to dive into, Mind Maze Demo is perfect for all ages and free to play. \nDownload now and turn your room into a maze of wonders! \ud83c\udf1f ", "short_description": "Dive into Mind Maze, an AR puzzle game that brings the fun of daily life to your tabletop!  \nInteract directly with the virtual world through hand tracking and enjoy quick, mind-bending puzzles. \ud83d\ude97\ud83c\udfb6 Play the free demo, compete on leaderboards, and unlock early access to 100+ levels. \nGet it now and start the fun! \u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metacampus.tech/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metacampus Tech LTD", "support_website_url": null, "website_url": "https://metacampus.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
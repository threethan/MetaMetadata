t64.5771-25/39001655_1040310347165520_7426137919291405462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRZ-eR72Q0EQ7kNvwEiZvP5&_nc_oc=Adq0x_n80_AqPuAKcsG7m568X2WGilS3GPwpySG6CUDtRLu7qdZmM3a0Y_kVQ8cOTpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28hZlXLM7OmuaTcYtPCT2M83JX1EgBG_OhwH76nntPMQ&oe=69DF74AD"}, {"file_name": "Capture5-4.png", "id": "3674100219471283", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223486_3674100222804616_3378633347068020705_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5KrwxVrpV4Q7kNvwFDB_yM&_nc_oc=AdpWp0g27Rcvw8flWp6kLrSRZauYCTT3xscBIp6TG4tYE7U5wMz8erd0u9HvRm8caPw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s-Vf4xmZd5EADNOc4Gwgn1H-m0eIWUbqeadxgAUQB7w&oe=69DF7C77"}, {"file_name": "Capture5.png", "id": "2360923614103233", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001655_2360923617436566_1716315961900770007_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LCvUnJHB8oQ7kNvwEwXXQt&_nc_oc=AdrDjmlgHsSrdtW9UGYX1pVkcd7cX1OP3D2GScgBM1WWoTNnp3goq7EfctOsk4D--BA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-S315Td84R_g17qSa_4nUnX2KvVmzO_zL5mzlaqKtCg&oe=69DF8FD3"}, {"file_name": "Capture5-3.png", "id": "672382414980649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75429290_672382418313982_7235669626419530394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ta_twST9m5MQ7kNvwGPh4cR&_nc_oc=Adqnn7AT9ulV3nZyhyi56A4043EUMck_M7gVoj7lIvB1suVABnEHPimmkshZ-YxtNFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LNc7tu4fzvKuDBO9n9OmyTyWlzVsqYU5yv1wWbRWwpQ&oe=69DF88C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capture5-4.png", "id": "1201761504573664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974503_1201761507906997_6376965417818159871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9F5eWTFESmMQ7kNvwHCM9CP&_nc_oc=AdqpGGnaAmAEuWqIOmNj05cxXFwPyWEBW0FFWiDVS0Fv9-JlwbMPP2lJiur2bkykO4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18UpEkzASD57vjLOqAXHGizYO98iVhrQQBcfXXBRZvlA&oe=69DF98D9"}, "display_name": "MindMaze Demo", "keywords": [], "long_description": "Embark on an AR adventure with Mind Maze Demo, where everyday tasks turn into incredible puzzles right on your table! \ud83e\udd2f Navigate a car through bustling traffic with just a wave of your hand, solve playful brain teasers, and revel in the joy of learning through fun.\n\nImmerse yourself in chill vibes with engaging background music and lively sound effects that enhance every move. Engage in a 5-10 minute journey full of exciting challenges, and if you're skilled enough, climb the leaderboards to showcase your puzzle-solving talents. \ud83c\udfc6\n\nEager for more? Completing the demo can earn you early access to the full game with over 100 puzzles waiting to test your wits.\n\nExciting, educational, and easy to dive into, Mind Maze Demo is perfect for all ages and free to play. \nDownload now and turn your room into a maze of wonders! \ud83c\udf1f ", "short_description": "Dive into Mind Maze, an AR puzzle game that brings the fun of daily life to your tabletop!  \nInteract directly with the virtual world through hand tracking and enjoy quick, mind-bending puzzles. \ud83d\ude97\ud83c\udfb6 Play the free demo, compete on leaderboards, and unlock early access to 100+ levels. \nGet it now and start the fun! \u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metacampus.tech/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metacampus Tech LTD", "support_website_url": null, "website_url": "https://metacampus.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
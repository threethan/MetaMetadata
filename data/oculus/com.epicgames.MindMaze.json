cdn.com/v/t64.5771-25/39001655_1040310347165520_7426137919291405462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CR77oIWhKIMQ7kNvwFHHyLC&_nc_oc=Adqn9YU5UsK615HwOZwvC2nPrlMyNQIPDGPz9uQ2UQUt2b4C7Q3Ukl31d1NkMbacjqc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0etLzP8jLxEuWBxTxOPRJxFGHbb_vOqR_0WlCGzqtCw&oe=6A8ECC2D"}, {"file_name": "Capture5-4.png", "id": "3674100219471283", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75223486_3674100222804616_3378633347068020705_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAQGyDsIc9gQ7kNvwFgHmbX&_nc_oc=AdrPzeHiEfpY8szwdcTLHAQabDLQO3WOWv-DzQ9K4uaENvmroKMwpK8IdEbQJ1Ymwm4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEgT5fyE3FCYkTXXK0cnndfOt-0gH3-dU1tAJ-gECpog&oe=6A8ED3F7"}, {"file_name": "Capture5.png", "id": "2360923614103233", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001655_2360923617436566_1716315961900770007_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cle5JdAo_tYQ7kNvwEM-hGG&_nc_oc=Adp4ZB4RpGw0VW0-EFSrLuWV3Y9Yol9aR7Yg8Gx1gGYyxim8_1S0Gdd4Ndzi5U88iZ0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe7zGwH0Xaa_ypxo6t3N0EF8eCItxvYTIWEx_Lp4JgDw&oe=6A8EE753"}, {"file_name": "Capture5-3.png", "id": "672382414980649", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75429290_672382418313982_7235669626419530394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY99l6XeRJAQ7kNvwEfvfn9&_nc_oc=Adq3xULfpwpRhDf4ElEwUi5mquwe7sz4Imy0i7SPHcxE44rAAWdz34c6_KxDcuvQLP0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNCJktHUoOn9F9O_WUHzN1ZNPz0_axAeF8kFJdTLvwIQ&oe=6A8EE047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capture5-4.png", "id": "1201761504573664", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974503_1201761507906997_6376965417818159871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYVO20U6TF4Q7kNvwEC2xXS&_nc_oc=AdpTl206Zl6xLi9Di668d1AgYUtXh9yRzIRmF0jHGclftVCXGvL8iylaZ_lNKHaQjvQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmw9LrvKq08AxMF3C7V7ZG2CPci2HE3DQ2LTIw62-EFQ&oe=6A8EF059"}, "display_name": "MindMaze Demo", "keywords": [], "long_description": "Embark on an AR adventure with Mind Maze Demo, where everyday tasks turn into incredible puzzles right on your table! \ud83e\udd2f Navigate a car through bustling traffic with just a wave of your hand, solve playful brain teasers, and revel in the joy of learning through fun.\n\nImmerse yourself in chill vibes with engaging background music and lively sound effects that enhance every move. Engage in a 5-10 minute journey full of exciting challenges, and if you're skilled enough, climb the leaderboards to showcase your puzzle-solving talents. \ud83c\udfc6\n\nEager for more? Completing the demo can earn you early access to the full game with over 100 puzzles waiting to test your wits.\n\nExciting, educational, and easy to dive into, Mind Maze Demo is perfect for all ages and free to play. \nDownload now and turn your room into a maze of wonders! \ud83c\udf1f ", "short_description": "Dive into Mind Maze, an AR puzzle game that brings the fun of daily life to your tabletop!  \nInteract directly with the virtual world through hand tracking and enjoy quick, mind-bending puzzles. \ud83d\ude97\ud83c\udfb6 Play the free demo, compete on leaderboards, and unlock early access to 100+ levels. \nGet it now and start the fun! \u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metacampus.tech/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metacampus Tech LTD", "support_website_url": null, "website_url": "https://metacampus.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [
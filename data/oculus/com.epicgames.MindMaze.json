0310347165520_7426137919291405462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9RdPzghgf0Q7kNvwF3UvHN&_nc_oc=Adk2tC-tsoTgtB901C5TggyGzKFM1UWhzCxZPpQIeALjdfM48WrkSm4ic0_JoSGBM6k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afzuc7MQNESegQ9PZxbpfhfcWm0HJ94BKP_-nsb-MMGV6Q&oe=69AAB8AD"}, {"file_name": "Capture5-4.png", "id": "3674100219471283", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75223486_3674100222804616_3378633347068020705_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VT7WvvEhYtcQ7kNvwFdzCKi&_nc_oc=AdlE3pXz6eH-5U2RI6iLJxJ6AU4imtKHUSDIFi9Uv3Mfe6yMdco5jHwyMa38qbdtTY4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRCYk2-bkqwY-5zYTYu72luJdR4BAzQ3ONOb_r2-nz4w&oe=69AAC077"}, {"file_name": "Capture5.png", "id": "2360923614103233", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001655_2360923617436566_1716315961900770007_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cpH0Izyk7UQ7kNvwFTon8c&_nc_oc=AdkdsQ-qz3Mum-_AiVbiiJRShwV0g4qKD0Tvdl-JXUfjhngNE_jspy-gDCpRBnmf3fw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwsLnV-ORoGoX0OoxTvzyVj3IY9jWA-RwHn-Ud-pVINdw&oe=69AAD3D3"}, {"file_name": "Capture5-3.png", "id": "672382414980649", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75429290_672382418313982_7235669626419530394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3uJZ83XGZkQ7kNvwE_1weq&_nc_oc=AdncCqyT8le7-7HGQ3lzA2CNbi8GBWlyDJLAbUf-5029U4PDLBGsu1Xt4h343mSBnXI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwER2kM4PRw8dQpqy4f3YEzrULAnwcSpP4hcfKuBmpNoQ&oe=69AACCC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capture5-4.png", "id": "1201761504573664", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974503_1201761507906997_6376965417818159871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwQazi-0Z20Q7kNvwG9JJnu&_nc_oc=AdkdGpYruOaPg1DlHS8-ciCmLw0rciAxFasCQvtcz2ngL3oODPKAdB8SUUcJwiZpW8w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzm6FxJ-XeV_TOnrVLxeBpyRDdWIp4q0JZBoAk0wKB-_Q&oe=69AADCD9"}, "display_name": "MindMaze Demo", "keywords": [], "long_description": "Embark on an AR adventure with Mind Maze Demo, where everyday tasks turn into incredible puzzles right on your table! \ud83e\udd2f Navigate a car through bustling traffic with just a wave of your hand, solve playful brain teasers, and revel in the joy of learning through fun.\n\nImmerse yourself in chill vibes with engaging background music and lively sound effects that enhance every move. Engage in a 5-10 minute journey full of exciting challenges, and if you're skilled enough, climb the leaderboards to showcase your puzzle-solving talents. \ud83c\udfc6\n\nEager for more? Completing the demo can earn you early access to the full game with over 100 puzzles waiting to test your wits.\n\nExciting, educational, and easy to dive into, Mind Maze Demo is perfect for all ages and free to play. \nDownload now and turn your room into a maze of wonders! \ud83c\udf1f ", "short_description": "Dive into Mind Maze, an AR puzzle game that brings the fun of daily life to your tabletop!  \nInteract directly with the virtual world through hand tracking and enjoy quick, mind-bending puzzles. \ud83d\ude97\ud83c\udfb6 Play the free demo, compete on leaderboards, and unlock early access to 100+ levels. \nGet it now and start the fun! \u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metacampus.tech/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metacampus Tech LTD", "support_website_url": null, "website_url": "https://metacampus.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUI
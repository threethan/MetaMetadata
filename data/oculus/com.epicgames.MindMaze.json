n.com/v/t64.5771-25/39001655_1040310347165520_7426137919291405462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0c2TN5FNR0Q7kNvwH3ehQW&_nc_oc=AdpmHdDgoNJzxO-GEmDQWv4GP3DQSI9nTy2hqSyYesD2gLWtd4DMbExOY5YafzrbDrg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8_SI_ZEKD_OPghHV6mEBD0Wbj5GA3QEeiG7Xhk-yUNw&oe=6A7DA8AD"}, {"file_name": "Capture5-4.png", "id": "3674100219471283", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75223486_3674100222804616_3378633347068020705_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgf9tZH7WtgQ7kNvwEqB9ov&_nc_oc=AdqWaYZlsxwMVQzU_1qNa-sZiD3aSQDTjWSnlxSoUfCHxe9Oik1lomxSE4MKZFX4joQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmq_kkswlfWiMjBRqwEApoH77nH_nB1N3O3gMooN5-OQ&oe=6A7DB077"}, {"file_name": "Capture5.png", "id": "2360923614103233", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001655_2360923617436566_1716315961900770007_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIET1Gdz6Z4Q7kNvwEk-Hdi&_nc_oc=Adq-QO9NOy0IOAmBC0gWG7PyF8_pIoP8PB989qCHt8kgTBqZo9nq_-nXkfMLv4ZBW3k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGirblkoBcfSQSzsz03fE07GOVcWhoxkyLHFWRiYx3U_g&oe=6A7DC3D3"}, {"file_name": "Capture5-3.png", "id": "672382414980649", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75429290_672382418313982_7235669626419530394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoK6p45KhDMQ7kNvwFPnYGp&_nc_oc=AdoAS30eUB57ipB9Vd9RNmj-Vjy1xQEUtTjbm-SGAJKCheGAi02sjyfOu8YeE55fgKw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9IVpNh2UZIYcVAqNX9FSW5mu7CrILdcE14EfsfCWDTQ&oe=6A7DBCC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capture5-4.png", "id": "1201761504573664", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974503_1201761507906997_6376965417818159871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNNE8e8vqtEQ7kNvwFr0kK7&_nc_oc=Adpqd7eQX-EEywVGjCX97u8ZuxKm0UNdEUY9h5r-fk5C_D_Dz1mu-JtV9m0ry_5unj8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOzDOjppKY6Rv_lhB3qSqSkBWpCgvDWfvPE8lruM3_iw&oe=6A7DCCD9"}, "display_name": "MindMaze Demo", "keywords": [], "long_description": "Embark on an AR adventure with Mind Maze Demo, where everyday tasks turn into incredible puzzles right on your table! \ud83e\udd2f Navigate a car through bustling traffic with just a wave of your hand, solve playful brain teasers, and revel in the joy of learning through fun.\n\nImmerse yourself in chill vibes with engaging background music and lively sound effects that enhance every move. Engage in a 5-10 minute journey full of exciting challenges, and if you're skilled enough, climb the leaderboards to showcase your puzzle-solving talents. \ud83c\udfc6\n\nEager for more? Completing the demo can earn you early access to the full game with over 100 puzzles waiting to test your wits.\n\nExciting, educational, and easy to dive into, Mind Maze Demo is perfect for all ages and free to play. \nDownload now and turn your room into a maze of wonders! \ud83c\udf1f ", "short_description": "Dive into Mind Maze, an AR puzzle game that brings the fun of daily life to your tabletop!  \nInteract directly with the virtual world through hand tracking and enjoy quick, mind-bending puzzles. \ud83d\ude97\ud83c\udfb6 Play the free demo, compete on leaderboards, and unlock early access to 100+ levels. \nGet it now and start the fun! \u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metacampus.tech/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metacampus Tech LTD", "support_website_url": null, "website_url": "https://metacampus.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
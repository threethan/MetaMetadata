65520_7426137919291405462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hSdv7HG5WIQ7kNvwG1mqtR&_nc_oc=Adkuny6A3VFEeHG4rrRXZsvoTOC-628WEWGl7zUnJZc-HC1uIdVjFQvK-7HkPngt9TI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQS_1fep6eFluMBYEdDJg5jwQruLjdLuRtzUeWf8mC4w&oe=69AFFEAD"}, {"file_name": "Capture5-4.png", "id": "3674100219471283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223486_3674100222804616_3378633347068020705_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhb0MpjSz9UQ7kNvwH0WIhY&_nc_oc=AdmISsoLv8lycuPBO1TUGKrVjNrz4SbbhAJB9QjnpNau2OiNfuQLG53-IeiZSS_qX2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyhn5Ms-SDvW5X0vl3S4ROyjpTzKiRPI0bznTFZdhFu9Q&oe=69B00677"}, {"file_name": "Capture5.png", "id": "2360923614103233", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001655_2360923617436566_1716315961900770007_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT_xKyYxXTsQ7kNvwGexKGg&_nc_oc=Adn2CY1IyXCdhlUCGux-GdQ7cb-jHUgmyAh8arHVhAkIVVcGwZ53BYmxanwOdbt1GCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdOg3Mup250hlJaccapZxOUlKm0eN-Qu9SsD3HTrd-LA&oe=69B019D3"}, {"file_name": "Capture5-3.png", "id": "672382414980649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75429290_672382418313982_7235669626419530394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yy3RYxYTQ-8Q7kNvwH8Y3iR&_nc_oc=AdmUi4tX0iPkiNAYRI9IxLGIMaM05CYsoVfbZW3gUnWsPqPZ6bhVEBlK3D7S6s8qE2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCHYbdSKj00wXnMzd-7wu4fdY9vq2KEfQgor47crfpWA&oe=69B012C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capture5-4.png", "id": "1201761504573664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_1201761507906997_6376965417818159871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JWTQxwfhhQQ7kNvwGmv9y7&_nc_oc=AdnXLReYLcFgO_h0dUJDMwq5uyi_WscI1FzAeXIj8Eri_79Z6Okx0AcBELAC7jXfwJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIIAuhIHePe4qLL9Zx34FWcgj1tbUA32umenrrRApmEQ&oe=69B022D9"}, "display_name": "MindMaze Demo", "keywords": [], "long_description": "Embark on an AR adventure with Mind Maze Demo, where everyday tasks turn into incredible puzzles right on your table! \ud83e\udd2f Navigate a car through bustling traffic with just a wave of your hand, solve playful brain teasers, and revel in the joy of learning through fun.\n\nImmerse yourself in chill vibes with engaging background music and lively sound effects that enhance every move. Engage in a 5-10 minute journey full of exciting challenges, and if you're skilled enough, climb the leaderboards to showcase your puzzle-solving talents. \ud83c\udfc6\n\nEager for more? Completing the demo can earn you early access to the full game with over 100 puzzles waiting to test your wits.\n\nExciting, educational, and easy to dive into, Mind Maze Demo is perfect for all ages and free to play. \nDownload now and turn your room into a maze of wonders! \ud83c\udf1f ", "short_description": "Dive into Mind Maze, an AR puzzle game that brings the fun of daily life to your tabletop!  \nInteract directly with the virtual world through hand tracking and enjoy quick, mind-bending puzzles. \ud83d\ude97\ud83c\udfb6 Play the free demo, compete on leaderboards, and unlock early access to 100+ levels. \nGet it now and start the fun! \u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metacampus.tech/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metacampus Tech LTD", "support_website_url": null, "website_url": "https://metacampus.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "p
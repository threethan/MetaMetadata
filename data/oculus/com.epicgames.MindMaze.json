n.com/v/t64.5771-25/39001655_1040310347165520_7426137919291405462_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4-CBBtB4s0Q7kNvwEY94Je&_nc_oc=AdqnvbOxsgh7imxVgIP5RMRMuQWec5Yf1E5s5DtELgr9WsnxT9nmQ__uFy0p8w_qoU8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m6WyI5SSJ8M55hExpFL3uk84gzgyUbdV0tv34H7ClMg&oe=6A11C5ED"}, {"file_name": "Capture5-4.png", "id": "3674100219471283", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75223486_3674100222804616_3378633347068020705_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCLSZzzT0L4Q7kNvwECusJY&_nc_oc=AdoXEWD5Ghfgon_1hPz4Ie9jy4gRep1YHqDYgaZQ5MlXkftDocy8eLgh8LTR-8SBOcc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rOGSBvKO_0cjO-KRmmHZ-flIfvOHWvGMwt_EoYOgwQw&oe=6A11CDB7"}, {"file_name": "Capture5.png", "id": "2360923614103233", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001655_2360923617436566_1716315961900770007_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVLYQ3lSHggQ7kNvwE89V0X&_nc_oc=AdrTlcnls2zy0o2K4r4vuYn_IoYPeD6yQCjJRcC7CS74dhoQvWwGbRqHLDeSMow0kU0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gGLKmUg3Ki0Frzr5WeqhLfoMiNXlxIuXVGfnP2ggauw&oe=6A11A8D3"}, {"file_name": "Capture5-3.png", "id": "672382414980649", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75429290_672382418313982_7235669626419530394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tI-DnFdMcWgQ7kNvwEoeEwF&_nc_oc=AdqTX_KqkzZgeAB0PFLQPdMoKedHV5ECE4__zvZySwRXpxTLbDBhnNdGpR8Feao431U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kXSAfvvZmY__3Z_5D6UnaD2TuSe9rzfGAQPvbR9p1_A&oe=6A11A1C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capture5-4.png", "id": "1201761504573664", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974503_1201761507906997_6376965417818159871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15V81jrwcU4Q7kNvwGGZNp7&_nc_oc=Ado9dQ48rbCTXO9fJerC8dQ1DMHJD0vU5boRFJEUXQAaY1aQCbFzerhg3ds7WRK5sJo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-JbZ-It94Su8VdDBHJXySPa7WjUQewYXnuk24PxUIVA&oe=6A11B1D9"}, "display_name": "MindMaze Demo", "keywords": [], "long_description": "Embark on an AR adventure with Mind Maze Demo, where everyday tasks turn into incredible puzzles right on your table! \ud83e\udd2f Navigate a car through bustling traffic with just a wave of your hand, solve playful brain teasers, and revel in the joy of learning through fun.\n\nImmerse yourself in chill vibes with engaging background music and lively sound effects that enhance every move. Engage in a 5-10 minute journey full of exciting challenges, and if you're skilled enough, climb the leaderboards to showcase your puzzle-solving talents. \ud83c\udfc6\n\nEager for more? Completing the demo can earn you early access to the full game with over 100 puzzles waiting to test your wits.\n\nExciting, educational, and easy to dive into, Mind Maze Demo is perfect for all ages and free to play. \nDownload now and turn your room into a maze of wonders! \ud83c\udf1f ", "short_description": "Dive into Mind Maze, an AR puzzle game that brings the fun of daily life to your tabletop!  \nInteract directly with the virtual world through hand tracking and enjoy quick, mind-bending puzzles. \ud83d\ude97\ud83c\udfb6 Play the free demo, compete on leaderboards, and unlock early access to 100+ levels. \nGet it now and start the fun! \u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metacampus.tech/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metacampus Tech LTD", "support_website_url": null, "website_url": "https://metacampus.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
OPDig&oe=699EE2F7"}, {"file_name": "Capture5.png", "id": "2360923614103233", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001655_2360923617436566_1716315961900770007_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3E17ZOkMyJIQ7kNvwF4R1tK&_nc_oc=Adnlc3VRFm34fTNB2w6oqgj5NNsXiZcedseF1oHnszAD4j5Qdk74gmsP9ET2ih2qRGA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfumMQ9x8-DByiyrCO6595YosB-R7GM_yI3eN62OP84IVw&oe=699EF653"}, {"file_name": "Capture5-3.png", "id": "672382414980649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75429290_672382418313982_7235669626419530394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XW9odBSjc1UQ7kNvwE07Gq7&_nc_oc=AdlK--c9ytaHcaPoNG-rIMaUnhBp342Wjlrd38msnPQ8YzWaowtCIybhWIbXp2ZhgpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftNR0yBZ3RaCC_5zaYIahELMM78mgSP49gruyhbBVcGYw&oe=699EEF47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capture5-4.png", "id": "1201761504573664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_1201761507906997_6376965417818159871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cL9u5JIz-AQ7kNvwFGbndf&_nc_oc=AdlGnn1Ct92pCWlcD1u1gyOn_Xh3-1y313g03iuXWU0cNYf7D0VB62X1VfTu-FlBEGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv27CXrSZAHz2eP3CcWtayy6AVeiIgxmK1jgsRYFG0eFg&oe=699EFF59"}, "display_name": "MindMaze Demo", "keywords": [], "long_description": "Embark on an AR adventure with Mind Maze Demo, where everyday tasks turn into incredible puzzles right on your table! \ud83e\udd2f Navigate a car through bustling traffic with just a wave of your hand, solve playful brain teasers, and revel in the joy of learning through fun.\n\nImmerse yourself in chill vibes with engaging background music and lively sound effects that enhance every move. Engage in a 5-10 minute journey full of exciting challenges, and if you're skilled enough, climb the leaderboards to showcase your puzzle-solving talents. \ud83c\udfc6\n\nEager for more? Completing the demo can earn you early access to the full game with over 100 puzzles waiting to test your wits.\n\nExciting, educational, and easy to dive into, Mind Maze Demo is perfect for all ages and free to play. \nDownload now and turn your room into a maze of wonders! \ud83c\udf1f ", "short_description": "Dive into Mind Maze, an AR puzzle game that brings the fun of daily life to your tabletop!  \nInteract directly with the virtual world through hand tracking and enjoy quick, mind-bending puzzles. \ud83d\ude97\ud83c\udfb6 Play the free demo, compete on leaderboards, and unlock early access to 100+ levels. \nGet it now and start the fun! \u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metacampus.tech/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metacampus Tech LTD", "support_website_url": null, "website_url": "https://metacampus.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6868942299884921"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1514912546008767"}]}, "baseline_offer": {"id": "1514912546008767"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1703179605, "status": "PUBLISHED", "id": "1514912546008767"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "705302463481
9256606522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334050_847299259939855_5788720511401078636_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMzRdqrHVqsQ7kNvwHPsLlp&_nc_oc=AdoQZdEVZH-gWa3Ja4929T6dt-39mTme9CczDKGAamrN81AsaCPng087HAMkYMK_Wko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg_aTasj-D6Ni7Nk3hlay_0NERp0qrka795UNd8ZwpbQ&oe=6AFDB17F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.VSA.WomanLifeLiberty-20230909-175850.png", "id": "814965250329351", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568677_814965253662684_9217900184427450001_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYx4YigRVJsQ7kNvwHh8JT4&_nc_oc=AdqCmX2j6mfltOBi6seBVQZ87B5D_LuYYyzIeiYUCNHcXO8PJhOVMzWKK52Wd4iUtu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw6kAQcwt4uMS6B6-A1865RSVtjgtKeMthhZuJTLQ10Q&oe=6AFDD0F3"}, "display_name": "Woman Life Liberty", "keywords": [], "long_description": "Visual Sound Ascension (VSA) - your gateway to the immersive metaverse! \ud83c\udf0c\u2728\n\ud83c\udfb5 Elevating Metaverse Experiences Through Music and Visuals \ud83c\udfa8\n\ud83c\udfb5 Dive into a 3D Music Video Revolution in VR! \ud83d\ude80 Immerse yourself in a world celebrating \"Woman, Life, and Liberty\" like never before. \ud83c\udf1f\n\n\ud83d\udc69\u200d\ud83c\udfa4 Empowerment in 3D: Experience the power of music through the eyes of women, as 3D VR takes you on a journey of strength and grace. \ud83c\udfb6\ud83d\udc83\n\n\ud83c\udf0d Life Unfolded: Explore the vivid tapestry of life's moments, from the ordinary to the extraordinary, all in immersive 3D. \ud83c\udf04\ud83c\udf0c\n\n\ud83d\uddfd Liberty Awakened: Break free from the ordinary and embrace the boundless possibilities of liberty in a virtual world like no other. \ud83d\udd13\ud83c\udf08\n\n\ud83d\ude80 Don't miss out on this extraordinary VR experience! Step into Oculus and be part of the future of music and storytelling. \ud83c\udf89\ud83d\udd76\ufe0f\n\nJoin us on this epic journey as we unlock the full potential of the metaverse. Subscribe and hit the notification bell to never miss out on our latest creations!\n\ud83d\udd17 Connect:\nWebsite: https://www.visualsoundascension.com/\nLinkedIn: https://www.linkedin.com/company/visual-sound-ascension\n\n#3DMusicVideoVR #WomanLifeLiberty #VRExperience #EmpowermentInVR #LifeIn3D #LibertyUnleashed #OculusVR #mahsa_amini #MusicRevolution #ImmersiveJourney \ud83c\udfb5\ud83d\udd76\ufe0f", "short_description": "Rana Mansour - For Woman, Life, Liberty (Baraye)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visualsoundascension.com/terms-wll", "developer_terms_of_service_url": null, "publisher_name": "Visual Sound Ascension", "support_website_url": null, "website_url": "https://www.visualsoundascension.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6977740012260503"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6977700982264406", "version": "0.0.5"}, "id": "236608929377707", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bin
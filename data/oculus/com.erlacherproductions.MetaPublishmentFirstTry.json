om&_nc_ss=7f20f&oh=00_AQQgbfjYKF9bBefMqC-XxbcS-eSApyfn1pmoU2ImqMQ-Kw&oe=6AEB2ED6"}, {"file_name": "Scherm\u00adafbeelding 2026-08-06 om 13.25.44.png", "id": "1408172614709690", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828050_1408172624709689_2470631332911904949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gBqPz8OlS8Q7kNvwH9LHz_&_nc_oc=Adq5TZN3WUM88WMkehO9no9izqYVYWfvi4YuVO1Z0h08rA9757tTcEbMVXsJSWNrnog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwhCZ8003DBcoiFXBjqu96M-WbZxGaXDXT-uOY6fYDig&oe=6AEB59E2"}, {"file_name": "Scherm\u00adafbeelding 2026-08-06 om 13.24.28.png", "id": "27820902254230097", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_27820902274230095_3106064071507596478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsHmzSA88scQ7kNvwGRQFJH&_nc_oc=AdpQakH94vfAIqXNM-k70IuMaNxriGGpCZJtye6I1yzvs0CkxqC_eCiRyRVKC4lD0AM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4xNCrnPxbhg4CokrjHrGLsmysVFhjIr0K5QiF0DaeMg&oe=6AEB61DE"}, {"file_name": "Scherm\u00adafbeelding 2026-08-06 om 13.24.42.png", "id": "1752926836024537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_1752926839357870_7142214457593480073_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5OKvmraTcUQ7kNvwGp4Ulg&_nc_oc=Adqq_uO8FqjZ34PwKcxWEpS_EUbgXPopwggyDyKSWZlekGtJQtrBG3iPs_Z8tY4HKhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvhHkhDbht8StGvD3P772TtqbV8cxxUJv9kiIP1Sk_Ug&oe=6AEB4185"}, {"file_name": "Scherm\u00adafbeelding 2026-08-06 om 13.26.04.png", "id": "1561150285461766", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1561150288795099_5320075380355554936_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg1p10z2Ch4Q7kNvwF3FGhR&_nc_oc=AdqgygAxVqDsJ_9kWvam_K56-aUfeUzet2VBScrO90-Ek5dgnksw1Rig1H2Nno2KVrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb3_hPVa-uVx-Ni_OxsFo_IFgG1IsMqAdJ8WNYgn1Enw&oe=6AEB3FA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Piano Sequence Learning App", "keywords": ["piano", "learning", "sequence", "midi", "education"], "long_description": "The Piano Sequence Learning App is an interactive learning application that enables students, musicians, and other users to practise piano sequences step by step. The app helps users recognise, memorise, and perform fixed patterns of piano keys.\n\nDuring each exercise, the notes are displayed visually, allowing users to see which keys need to be played and at what moment. Exercises can be divided into different phases, such as a familiarisation phase, repeated practice blocks, and a transfer test in which users perform the learned sequence independently.\n\nThe application can be connected to a MIDI keyboard, allowing every key press to be registered in real time. Based on this input, the app can provide insights into accuracy, speed, timing, and overall progress. Before starting a session, the user completes a guided setup process in which the keyboard, visual guidance, and practice environment are configured.\n\nThe Piano Sequence Learning App is suitable for individual practice, music education, and scientific research into motor learning, memory, and sequence learning. By combining clear visual guidance, structured practice phases, and direct interaction with a piano or MIDI keyboard, the app makes practising musical patterns more accessible, measurable, and organised.\n", "short_description": "The Piano Sequence Learning App is an interactive learning application that enables students, musicians, and other users to practise piano sequences step by step. The app helps users recognise, memorise, and perform fixed patterns of piano keys."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitale-duif.nl/privacy/piano-sequence-learning", "developer_terms_of_service_url": null, "publisher_name": "DigitaleDuif", "support_website_url": null, "website_url": "https://www.di
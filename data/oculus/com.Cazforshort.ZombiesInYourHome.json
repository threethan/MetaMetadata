MhHu9s8rw&oe=699C49BC"}, {"file_name": "Game1.png", "id": "620678782550537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982469_620678785883870_5326595014534282398_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKuL9qh5Z3UQ7kNvwGPsObR&_nc_oc=Admpmg07d5D3Zw6i5wrYxpgXCXB_45AN775o-L6u8uuANFcHmrvf5m5IiG3UpFbjVcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvSyWleja7k_Td46GibgDVZwKAJEZA0j7WrqNFlSnxTOw&oe=699C3935"}, {"file_name": "Game2.png", "id": "1071605420284743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1071605423618076_4019861243268235995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-1EtLX0Ku0Q7kNvwF_D6R6&_nc_oc=AdmGGak3hY02xY0F5fYbvqKBWcI3A3lSh3HXmdS0m8Ugzk006Miz7B5FM1_6ruzr8aI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsV2eP3WzpoZwRzYtyBKEuwIJMtaO3aKxw1lKeMYnowxw&oe=699C43EC"}, {"file_name": "Game3.png", "id": "1341930919587442", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974874_1341930922920775_2032434531725596727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNI5nXzSUWIQ7kNvwGS9JRR&_nc_oc=AdnYsVdeXLKMSUp7He0bdrJ6nxvjyGr72UYTSYC8JrEu_ocgKcaP9b0Pi5B2WXEFxKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuC45Qd6uLmc-0Yt2BdCYUMEF0YNPzjxbR_zKA1w1ymKQ&oe=699C3BAB"}, {"file_name": "Game4.png", "id": "483441523140842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982441_483441526474175_8637568278043978051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkEeQtmUGxAQ7kNvwE2OY1W&_nc_oc=Adnp0ZRbfzXonUjwJ7SjyzW9KVBE-WmJkLC5sUmINSQNvTKFJM8hAwUZ5JKXpiXW-5w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuLKTfsLAw6YNoLqtL6sEMA6oEeY3jCqBlKw5jh5Yuf0w&oe=699C3D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imgonline-com-ua-resize-5mxQnAdDtM8qR (5).png", "id": "307963504272287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_307963510938953_12489759764553333_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8itw1cIGYwQ7kNvwFCyRd7&_nc_oc=Adm8cG7pNhQdXN_RFP7CquEPpYlMyuALmLLFZwGQ5MUn7ooDEt-yQDP-4RLXXu-cCqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftvNBYt-vNpn3SNZYdzh4qiXiCjFVYjxr0ViCAbTdnp_A&oe=699C3C6F"}, "display_name": "Zombies in Your Home", "keywords": [], "long_description": "Zombies will chase you around and spawn randomly throughout your mapped house.\n\nGame Instructions\n\n1) Place nodes at each corner of your walls and doors with the right trigger going counter clockwise. If you put one in the wrong place, just click X on the left remote to clear them out.\n\n2) Press A on the right controller to Lock In your play area and walls. This will also start the game and dim the light.\n\n3) Press B on the right controller to turn on your flashlight. Use it to kill the enemies that are now spawning faster and faster and coming to find you. Just hold the light on them for 5 seconds.\n\n4) If the enemies get too close you will loose health and the game will stop and show your score. Restart with A on the right controller.", "short_description": "Oculus Passthrough has Zombies in your Livingroom! Kill them with your flashlight before they get you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zombiesprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Cazforshort", "support_website_url": null, "website_url": "https://sites.google.com/view/zombiesprivacypolicy", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
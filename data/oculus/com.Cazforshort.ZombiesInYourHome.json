sWgxm_SPQ&oe=69A18FBC"}, {"file_name": "Game1.png", "id": "620678782550537", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982469_620678785883870_5326595014534282398_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AewXFxx9n3YQ7kNvwHYclwZ&_nc_oc=AdkVDSm5jUZaS2CL9UA65FORyZB4gtwpWD8wLhrQ7ONUxULmuUu8Lfhy_UQeMlgihCI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvGSKgxp4SMnJt0ZolFeru7So4avuWyIHp4ciweX-UOcg&oe=69A17F35"}, {"file_name": "Game2.png", "id": "1071605420284743", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974444_1071605423618076_4019861243268235995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95QUXN_yyJMQ7kNvwGanIbE&_nc_oc=AdmkTlkp9c3jQjgrQpmNT4UZQfL8fytXjAlv0IfSCkcDh3P0RlH76fbtNzncpHU-gy8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs4-23Aznxn8BQJW1uqtumZajGTNjkQ1pmxIpxuKLWogA&oe=69A189EC"}, {"file_name": "Game3.png", "id": "1341930919587442", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974874_1341930922920775_2032434531725596727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmBhUrTIUOYQ7kNvwHEOKMT&_nc_oc=AdllcU3ffZnU8p06gkSTxTfGRoFCeM5ym2f5jMcGMtjnYcL45GThI-K-T3HczvtHu6A&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvOYIrQ5JQ8vbi1sMGovMnrzWp8tQvDCz-Dgoqps8hfiw&oe=69A181AB"}, {"file_name": "Game4.png", "id": "483441523140842", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982441_483441526474175_8637568278043978051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMwctlNl9QMQ7kNvwFhkeoC&_nc_oc=Adlk5Aryu9rVa3gutn44WMOAur3cuXzxre5zZqgaXsF6wA0CmzdaOqm9JaEfi6Q1xHg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsG3o944Deq7IP3igg6JPvLaaQx-2TsmQx6xrL81aeqyg&oe=69A18368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imgonline-com-ua-resize-5mxQnAdDtM8qR (5).png", "id": "307963504272287", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39036704_307963510938953_12489759764553333_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1NYaqNfzScQ7kNvwGP8x42&_nc_oc=Adn2hjkZ-71e4CDuf8VMo-Yzg0vePAlcqZ_eZgYkOjBLq0fkyy7qtT62c8b63ZKm1zc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu94P03qZpA8odkvUJrWUr2Zw3z-mMJsULFc6hy46rhwA&oe=69A1826F"}, "display_name": "Zombies in Your Home", "keywords": [], "long_description": "Zombies will chase you around and spawn randomly throughout your mapped house.\n\nGame Instructions\n\n1) Place nodes at each corner of your walls and doors with the right trigger going counter clockwise. If you put one in the wrong place, just click X on the left remote to clear them out.\n\n2) Press A on the right controller to Lock In your play area and walls. This will also start the game and dim the light.\n\n3) Press B on the right controller to turn on your flashlight. Use it to kill the enemies that are now spawning faster and faster and coming to find you. Just hold the light on them for 5 seconds.\n\n4) If the enemies get too close you will loose health and the game will stop and show your score. Restart with A on the right controller.", "short_description": "Oculus Passthrough has Zombies in your Livingroom! Kill them with your flashlight before they get you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zombiesprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Cazforshort", "support_website_url": null, "website_url": "https://sites.google.com/view/zombiesprivacypolicy", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
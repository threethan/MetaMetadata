e7-V1-DGg&oe=699AF83C"}, {"file_name": "Game1.png", "id": "620678782550537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982469_620678785883870_5326595014534282398_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i45xHpVLREQ7kNvwEc9Hlt&_nc_oc=AdnzPE3d_S5tWdK0OBxHGdcQIn7s921dL1akq-47V3qXOsD9IGMHTa8I5nX7J0K1_8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6ToLOSFiqjX72Zh1O-LIW8S8b-rtztK9QnpCkbCVimQ&oe=699AE7B5"}, {"file_name": "Game2.png", "id": "1071605420284743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1071605423618076_4019861243268235995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-1EtLX0Ku0Q7kNvwEZhV7j&_nc_oc=AdlNVfzHd2l3RzqLgapycgwUl_qtGsO7dYgQ_BbjwdAz4SGbBZHzDaqhRXXlda8MJbE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuy5-CQsM-XkhHXlnBNOgCe51jg9HJ0SB1Gj-RVMKGuFQ&oe=699AF26C"}, {"file_name": "Game3.png", "id": "1341930919587442", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974874_1341930922920775_2032434531725596727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNI5nXzSUWIQ7kNvwFLN7vf&_nc_oc=Adn2x35JIa4USsqkeub1WcObOaNb5p34Nd5L-zHocKUp7a2153LK-MaS0AeDhNvfZv0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKzixQ5E9Pbl71ZXhp-YH-OybttVYXJyT94MxM9FB6PA&oe=699AEA2B"}, {"file_name": "Game4.png", "id": "483441523140842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982441_483441526474175_8637568278043978051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkEeQtmUGxAQ7kNvwGlIz3u&_nc_oc=AdmTDzNTLxLCNa1lrm7BkTPtMpqSIt-pCQNAhqPaeo8Sze4an6Rr8F2uaucs5dImYWk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvrTnNA3RluFNUdKm47jAbiqYysSl1Wpc1Ov0OeXVLbVw&oe=699AEBE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imgonline-com-ua-resize-5mxQnAdDtM8qR (5).png", "id": "307963504272287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_307963510938953_12489759764553333_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8itw1cIGYwQ7kNvwH-tE65&_nc_oc=Adn_WbY79LNZubQzqDjBK95p4ydLhV-dMi2x4mwD-yqkS475u9haNtUyE-TCLiw4gQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs-LWEVf-ZXlvEkpbAgDgvJcHGuO8pP_eTEDK_zylac_g&oe=699AEAEF"}, "display_name": "Zombies in Your Home", "keywords": [], "long_description": "Zombies will chase you around and spawn randomly throughout your mapped house.\n\nGame Instructions\n\n1) Place nodes at each corner of your walls and doors with the right trigger going counter clockwise. If you put one in the wrong place, just click X on the left remote to clear them out.\n\n2) Press A on the right controller to Lock In your play area and walls. This will also start the game and dim the light.\n\n3) Press B on the right controller to turn on your flashlight. Use it to kill the enemies that are now spawning faster and faster and coming to find you. Just hold the light on them for 5 seconds.\n\n4) If the enemies get too close you will loose health and the game will stop and show your score. Restart with A on the right controller.", "short_description": "Oculus Passthrough has Zombies in your Livingroom! Kill them with your flashlight before they get you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zombiesprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Cazforshort", "support_website_url": null, "website_url": "https://sites.google.com/view/zombiesprivacypolicy", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
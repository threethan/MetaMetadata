S34iOhtxA&oe=69F0A9BC"}, {"file_name": "Game1.png", "id": "620678782550537", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982469_620678785883870_5326595014534282398_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48Gctd5oK0EQ7kNvwH-f8o_&_nc_oc=AdpxOn_CzChT952r5skgvJ0fIc1tyKs3GKw327hWKK2cTQ-YvpcpuU3-C7Nl8XUsHjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1C4rQDHQsL98lBxhhyB4IhRsVmoeuNPrv2KKLJYnzd-A&oe=69F0D175"}, {"file_name": "Game2.png", "id": "1071605420284743", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_1071605423618076_4019861243268235995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpDN5X-twdEQ7kNvwH6tWD0&_nc_oc=AdpDwppki_y558dS2WCnGauciRU8XOI2ky4EZcfmq2usouU_CpNz7x8iSUwkjXTCFtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1LBYk04-0o1wpHSTB9ERqE1g9RseLp_aqaXrfE92N9eQ&oe=69F0A3EC"}, {"file_name": "Game3.png", "id": "1341930919587442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974874_1341930922920775_2032434531725596727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9anF0JZQtYQ7kNvwHgbOxT&_nc_oc=AdqKFqaftpwtO2Lq5Doty2NF4u3rGBm_uKF4oJ9WI1cgMguURwmBiNhH2I8xJDVNsXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0o2KQhV9LcbnDxQlqmSe6XbA37kCdqzw7_AzMfQuoqHg&oe=69F09BAB"}, {"file_name": "Game4.png", "id": "483441523140842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982441_483441526474175_8637568278043978051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCwCBSYzcegQ7kNvwEj1kTx&_nc_oc=Adpv3SHalSpZHLvoibd2T4ZEJC9auysnv_X-q0A6xGHRezgbQFzstjqYyB5tYZS3LBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0mNXuE8fFyDqY77EFGPoBQei8urfgO3V3olbsK7_NrSA&oe=69F09D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imgonline-com-ua-resize-5mxQnAdDtM8qR (5).png", "id": "307963504272287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036704_307963510938953_12489759764553333_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5b2wvbe3LkQ7kNvwHUboEf&_nc_oc=AdqfPCsw1c61CAqmVT2BeIywO0-v8qSWi_fNW947vMx3edO5bHMpMq21qq1N-IIjtX0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0FeYkGRujP3wewi26Ob8m0D21z427Lu2L0fP4X-2X3Jw&oe=69F09C6F"}, "display_name": "Zombies in Your Home", "keywords": [], "long_description": "Zombies will chase you around and spawn randomly throughout your mapped house.\n\nGame Instructions\n\n1) Place nodes at each corner of your walls and doors with the right trigger going counter clockwise. If you put one in the wrong place, just click X on the left remote to clear them out.\n\n2) Press A on the right controller to Lock In your play area and walls. This will also start the game and dim the light.\n\n3) Press B on the right controller to turn on your flashlight. Use it to kill the enemies that are now spawning faster and faster and coming to find you. Just hold the light on them for 5 seconds.\n\n4) If the enemies get too close you will loose health and the game will stop and show your score. Restart with A on the right controller.", "short_description": "Oculus Passthrough has Zombies in your Livingroom! Kill them with your flashlight before they get you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zombiesprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Cazforshort", "support_website_url": null, "website_url": "https://sites.google.com/view/zombiesprivacypolicy", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
-VGdLJiOg&oe=69A2E13C"}, {"file_name": "Game1.png", "id": "620678782550537", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982469_620678785883870_5326595014534282398_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AewXFxx9n3YQ7kNvwFrlySi&_nc_oc=AdnQBP6s9oHjJgmInitohjuqpc3FMPpXFCLqPaS5sdjYaVP5Oz7ppZ0hSOLGQUcRPOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuo6SpxQEPsnFjVaobAWYXUlCubj7JqqxHKnDnQTTvUVg&oe=69A2D0B5"}, {"file_name": "Game2.png", "id": "1071605420284743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_1071605423618076_4019861243268235995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95QUXN_yyJMQ7kNvwGWQae3&_nc_oc=AdnRMmdx3GO0B2eRk54b9jYL71XoKHbIhfvvmhzGGbLNC0M4Bd8exQDQZTwCo3534jQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvJtu_nYu6dzZnlF9x8go7C-fftU56GEIiM-smYEF07Og&oe=69A2DB6C"}, {"file_name": "Game3.png", "id": "1341930919587442", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974874_1341930922920775_2032434531725596727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L8htqpVGesQ7kNvwEvMqWg&_nc_oc=AdmAP9pn-K5069KhJm7Zdvw46YCARw4_s0SICDBM0ay1Y1zejcvhdlxdCJ9yijX-yHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu73iy68YKTguOhby1EQ7wxXgkK_Kfxyz3SFj0G7qKoDA&oe=69A2D32B"}, {"file_name": "Game4.png", "id": "483441523140842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_483441526474175_8637568278043978051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEis58XJvngQ7kNvwGP2qW6&_nc_oc=AdlAqjYHyjUOs76xIl2wNShR6HYdpzCFU7zskLrK6qQRaOZBkvPRheVbuQhCvwFSE9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvPyWuRGAstU6hhg5axbDth2nhOP3lgFvtfdQtMtq0N8Q&oe=69A2D4E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imgonline-com-ua-resize-5mxQnAdDtM8qR (5).png", "id": "307963504272287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036704_307963510938953_12489759764553333_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1NYaqNfzScQ7kNvwEGbk97&_nc_oc=Adl-uaf45wu5LW9DAiug8T2TZC3_kjECvWJDtEEMdxidmDoe4CHgLlP-u1bW6Yz9L-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBD_QUfzldmgRU14Au8uoor4Y5-nSBXLV6fNGiWrMa5w&oe=69A2D3EF"}, "display_name": "Zombies in Your Home", "keywords": [], "long_description": "Zombies will chase you around and spawn randomly throughout your mapped house.\n\nGame Instructions\n\n1) Place nodes at each corner of your walls and doors with the right trigger going counter clockwise. If you put one in the wrong place, just click X on the left remote to clear them out.\n\n2) Press A on the right controller to Lock In your play area and walls. This will also start the game and dim the light.\n\n3) Press B on the right controller to turn on your flashlight. Use it to kill the enemies that are now spawning faster and faster and coming to find you. Just hold the light on them for 5 seconds.\n\n4) If the enemies get too close you will loose health and the game will stop and show your score. Restart with A on the right controller.", "short_description": "Oculus Passthrough has Zombies in your Livingroom! Kill them with your flashlight before they get you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zombiesprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Cazforshort", "support_website_url": null, "website_url": "https://sites.google.com/view/zombiesprivacypolicy", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
4743", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974444_1071605423618076_4019861243268235995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpDN5X-twdEQ7kNvwFToPQZ&_nc_oc=Adp6Klw7j9TwWTMjQP-l8Qrtz28wSDg8F_BnCWfShyrSXcjSuGUcxJvhTuh5KaZzEFQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1yPG882GhDi5Sa8pWqCKBQTZ3X32kya8zXmIJzLe-JEQ&oe=69F1F56C"}, {"file_name": "Game3.png", "id": "1341930919587442", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974874_1341930922920775_2032434531725596727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_zx1FQAuHEQ7kNvwEXJlGc&_nc_oc=Adqe_JrcPLIUqm5Zf9X183WmuzYy9eI8HPFotkKr6j0p-hcRTkeSgXfaKpLHlie5HJA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EGnQSd4XKqEZqTFUlKpmH4rOi3iqOzeEST-anRuE4bA&oe=69F1ED2B"}, {"file_name": "Game4.png", "id": "483441523140842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982441_483441526474175_8637568278043978051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVcap4Nq_8AQ7kNvwFo57LL&_nc_oc=AdpC4OjxMa4DsfKR95Urki5BEF_14zclKLOMzbNxZpronzG_lcdvu7SNir7A7DzWR44&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1DuutgsyREYFs6jyJCOcus1LWqpRbygXQdW9V5TIKSgg&oe=69F1EEE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imgonline-com-ua-resize-5mxQnAdDtM8qR (5).png", "id": "307963504272287", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036704_307963510938953_12489759764553333_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5b2wvbe3LkQ7kNvwE2MymZ&_nc_oc=AdpVFKZde0RwLYKIAFMwQc1N5DaXcGhhrMJU0oKfCIjyTE_iHMEtAl5rA49vz6_-lak&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af15rS5cRvIs_b_cqgQulKNCDFkker5jcgJGlSiXfkNHJQ&oe=69F1EDEF"}, "display_name": "Zombies in Your Home", "keywords": [], "long_description": "Zombies will chase you around and spawn randomly throughout your mapped house.\n\nGame Instructions\n\n1) Place nodes at each corner of your walls and doors with the right trigger going counter clockwise. If you put one in the wrong place, just click X on the left remote to clear them out.\n\n2) Press A on the right controller to Lock In your play area and walls. This will also start the game and dim the light.\n\n3) Press B on the right controller to turn on your flashlight. Use it to kill the enemies that are now spawning faster and faster and coming to find you. Just hold the light on them for 5 seconds.\n\n4) If the enemies get too close you will loose health and the game will stop and show your score. Restart with A on the right controller.", "short_description": "Oculus Passthrough has Zombies in your Livingroom! Kill them with your flashlight before they get you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zombiesprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Cazforshort", "support_website_url": null, "website_url": "https://sites.google.com/view/zombiesprivacypolicy", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5370311139648746"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "5220913331287331"}]}, "baseline_offer": {"id": "5220913331287331"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1647025500, "status": "PUBLISHED", "id": "5220913331287331"}]}, "liveChannel": {"no
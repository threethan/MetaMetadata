sdL8KUgjA&oe=6999A6BC"}, {"file_name": "Game1.png", "id": "620678782550537", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982469_620678785883870_5326595014534282398_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i45xHpVLREQ7kNvwHJXEyH&_nc_oc=Adk8PfXSvsH5n3mXrJjMDOEjtW5ebU-ImIwLBZYq51Fqp4uVIDUp0I6JGA-spp9KmXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuzEB745w3v7Que2Omietku454WrojvAGnfLNc3aLelaQ&oe=69999635"}, {"file_name": "Game2.png", "id": "1071605420284743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_1071605423618076_4019861243268235995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-1EtLX0Ku0Q7kNvwE1aV7H&_nc_oc=Adn6P8v1YYUJchid6kageHVOteM_5GtIHdo-BzAssvZ9LeZMelMfIfsDtBVi3iDi-bA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsBuwhYxlYxo1003S-uG5SL9wT15fKQvh8KNRI7QqnW-Q&oe=6999A0EC"}, {"file_name": "Game3.png", "id": "1341930919587442", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974874_1341930922920775_2032434531725596727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UadJUyLQD18Q7kNvwGu7pp1&_nc_oc=AdmIpoVemkNMruaFva-qZVde8nzlZIc7NZbXAuhZdnNJov4UdQlPy0Uc8MDPL89Fp6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftXYQGkxRqPVvjUnJveQq0PncflFRzSrBC5zN0GTvHToQ&oe=699998AB"}, {"file_name": "Game4.png", "id": "483441523140842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_483441526474175_8637568278043978051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rs4uaMJX2sQ7kNvwEmWR86&_nc_oc=Adm-5W7h5Nyw0rusa9qXEV_Y6PMIgnCcBDNfdqOX64axcIIHSZ1floo9GZqh1N038cQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftoeZp9zRaNvJ68trANBvAEDTfmkZliyJTPvuw9s3BAFA&oe=69999A68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imgonline-com-ua-resize-5mxQnAdDtM8qR (5).png", "id": "307963504272287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036704_307963510938953_12489759764553333_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8itw1cIGYwQ7kNvwHAcjR8&_nc_oc=AdlEz6H3oJIKmy5ZYqOTUFtBc5OpfIUSav3B25wyifnXIjYpuEe67GSRIh2o5fu0N-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftH71Fx4Ylyp1-eGF_0AG3bTCW-WUwC4zJ31fxTx8DcCw&oe=6999996F"}, "display_name": "Zombies in Your Home", "keywords": [], "long_description": "Zombies will chase you around and spawn randomly throughout your mapped house.\n\nGame Instructions\n\n1) Place nodes at each corner of your walls and doors with the right trigger going counter clockwise. If you put one in the wrong place, just click X on the left remote to clear them out.\n\n2) Press A on the right controller to Lock In your play area and walls. This will also start the game and dim the light.\n\n3) Press B on the right controller to turn on your flashlight. Use it to kill the enemies that are now spawning faster and faster and coming to find you. Just hold the light on them for 5 seconds.\n\n4) If the enemies get too close you will loose health and the game will stop and show your score. Restart with A on the right controller.", "short_description": "Oculus Passthrough has Zombies in your Livingroom! Kill them with your flashlight before they get you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zombiesprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Cazforshort", "support_website_url": null, "website_url": "https://sites.google.com/view/zombiesprivacypolicy", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
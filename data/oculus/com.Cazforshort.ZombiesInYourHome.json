PBHAGeWuA&oe=69A432BC"}, {"file_name": "Game1.png", "id": "620678782550537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982469_620678785883870_5326595014534282398_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M31rR_Slz7sQ7kNvwG5DDZQ&_nc_oc=AdkRt4coLam_wVAotnTUx6EFG0Rw_LSlJp8ss2yvVhdxUkH9p8XmUb2FB6cDvirC980&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsY4z_fRRg7nSjje0gvoe6CDhLYafZS9l6_-Qj02dUMlQ&oe=69A42235"}, {"file_name": "Game2.png", "id": "1071605420284743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_1071605423618076_4019861243268235995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95QUXN_yyJMQ7kNvwHCVVMm&_nc_oc=AdltgrWZ4-Bn7TAR04sbraQBpbmP6AsZ7260mDpc5iLqAgnK0zynHVaq9bbimCwP3-o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKzpGMnjIC5YS3Cba6hxJuaCAxVyDoSYHxFx_-RpiPbQ&oe=69A42CEC"}, {"file_name": "Game3.png", "id": "1341930919587442", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974874_1341930922920775_2032434531725596727_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L8htqpVGesQ7kNvwHZLZOs&_nc_oc=AdkawHvK5RPYCnwp4pH3wZrUU2lWcgdhg6Bg_w1neghbce3bCleL6Bp0iJ3znRQwiJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftEZIbEdZyZFQuu8mmUO_TTsZIngtqa-oln_V0AWFtL0A&oe=69A424AB"}, {"file_name": "Game4.png", "id": "483441523140842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982441_483441526474175_8637568278043978051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEis58XJvngQ7kNvwFWYw28&_nc_oc=AdkHWs1mU6bquIFdQN9sRDIW2AI1fMBeXCN8071_l0j26a8mgDDKlsWVWo65gjSkuFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsWtgiAgrlqBaoDrMimmnHYg7pdAhT_7AkmqZYMFISg1g&oe=69A42668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imgonline-com-ua-resize-5mxQnAdDtM8qR (5).png", "id": "307963504272287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_307963510938953_12489759764553333_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1NYaqNfzScQ7kNvwH55rMQ&_nc_oc=Adm8QFfgU3L9VVso_dHtEb_ZlvfoHOL1eVqGKha1-9bSSnupYLOq7CEwfvXw5O96RgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs3oN_6W_wzS0nEr4Z4N4Fc6rRiIeMvuqokW8hqjYlvZA&oe=69A4256F"}, "display_name": "Zombies in Your Home", "keywords": [], "long_description": "Zombies will chase you around and spawn randomly throughout your mapped house.\n\nGame Instructions\n\n1) Place nodes at each corner of your walls and doors with the right trigger going counter clockwise. If you put one in the wrong place, just click X on the left remote to clear them out.\n\n2) Press A on the right controller to Lock In your play area and walls. This will also start the game and dim the light.\n\n3) Press B on the right controller to turn on your flashlight. Use it to kill the enemies that are now spawning faster and faster and coming to find you. Just hold the light on them for 5 seconds.\n\n4) If the enemies get too close you will loose health and the game will stop and show your score. Restart with A on the right controller.", "short_description": "Oculus Passthrough has Zombies in your Livingroom! Kill them with your flashlight before they get you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zombiesprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Cazforshort", "support_website_url": null, "website_url": "https://sites.google.com/view/zombiesprivacypolicy", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
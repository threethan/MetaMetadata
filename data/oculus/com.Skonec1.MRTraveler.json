9e6L8TrGF6DOnROIAus&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq1SoMIStVZU4VNHqYoTKdsP3hmH794PvCqbi8UPT7JA&oe=6A93FB52"}, {"file_name": "491820047_1332229231939975_3487970403264993133_n.png", "id": "1170096511676747", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824202_1170096515010080_4657655505198286998_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liboLnKz01YQ7kNvwGV0nXx&_nc_oc=AdofZeZhNCKTcv1ipuRpaowZMRcrjWjdVrjD0s4wwOHik9cUxT7boWmjMpSA7Ox9i0M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtWTUFdV4_cqujBsa5WwUNeT6jnYI1cDanLzYMGOin6A&oe=6A940D96"}, {"file_name": "Screenshot_004.png", "id": "1123051486633095", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820953_1123051489966428_7104031918769715526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ytFh30QjV4Q7kNvwFeTN3P&_nc_oc=AdqnNqKYBSKi2no6iur4R_36gVyP5CIzRTGAXy2nHKao0lIIYWFp06vYe4pgrCIqcxc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH09Te0ifqpA0VEkuwE2q8TFm7G2scehUgZBubLP4nsGA&oe=6A942B1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MR. TRAVELER", "keywords": ["tabletop", "traveler", "mixedreality", "adventure", "partygame"], "long_description": "# \ud83c\udfb2\uc8fc\uc0ac\uc704\ub97c \ub358\uc9c0\uace0, \uc138\uacc4\ub97c \ub204\ube44\uc138\uc694 \u2013 \ud63c\ud569\ud604\uc2e4 \uc18d\uc5d0\uc11c!\n\nMR. TRAVELER\ub294 \ud63c\ud569\ud604\uc2e4\uc744 \ud1b5\ud574 \ud604\uc2e4 \uacf5\uac04\uc5d0 \uac70\ub300\ud55c \ubcf4\ub4dc\uac8c\uc784 \ub9f5\uc774 \ud3bc\uccd0\uc9c0\ub294 \uc2e0\uac1c\ub150 \uc5ec\ud589 \uac8c\uc784\uc785\ub2c8\ub2e4. Meta Quest \ud5e4\ub4dc\uc14b\ub9cc \uc788\uc73c\uba74, \ub2f9\uc2e0\uc758 \ubc29\uc774 \uc138\uacc4 \uc5ec\ud589\uc758 \ucd9c\ubc1c\uc9c0\uac00 \ub429\ub2c8\ub2e4! \uc720\ucf8c\ud55c \ubbf8\ub2c8\uac8c\uc784, \uc804 \uc138\uacc4 \ub79c\ub4dc\ub9c8\ud06c, \uc608\uce21\ubd88\ud5c8\uc758 \uc774\ubca4\ud2b8\uae4c\uc9c0 \uac00\ub4dd\ud55c \uae00\ub85c\ubc8c \ubaa8\ud5d8\uc774 \uc9c0\uae08 \uc2dc\uc791\ub429\ub2c8\ub2e4.\n\n**\uc8fc\uc694 \ud2b9\uc9d5**\n\n- **\uac13\ucc60\ub85c \ub9cc\ub098\ub294 \uc5ec\ud589 \uce5c\uad6c**: \uac8c\uc784\uc5d0\uc11c \ubaa8\uc740 \ucf54\uc778\uc73c\ub85c \uac13\ucc60\ub97c \ub3cc\ub824 \uadc0\uc5fd\uace0 \uac1c\uc131 \ub118\uce58\ub294 \ub9d0\ud310 \uce90\ub9ad\ud130\ub4e4\uc744 \uc218\uc9d1\ud574 \ubcf4\uc138\uc694. \uc774 \uce90\ub9ad\ud130\ub4e4\uc740 \uc5ec\ud589\uc758 \ub4e0\ub4e0\ud55c \ub3d9\ud589\uc790\uac00 \ub418\uc5b4 \uc904 \uac83\uc785\ub2c8\ub2e4! {1582545949830611}\n\n- **\ud63c\ud569\ud604\uc2e4 \ubcf4\ub4dc \uac8c\uc784\ud50c\ub808\uc774**: \uac8c\uc784 \ubcf4\ub4dc\ub97c \ud604\uc2e4 \uacf5\uac04\uc5d0 \uc790\uc720\ub86d\uac8c \ubc30\uce58\ud574\ubcf4\uc138\uc694. \uc2e4\uc2dc\uac04 \uc190 \ucd94\uc801\uc73c\ub85c \uc8fc\uc0ac\uc704\ub97c \uc7a1\uc544 \ub358\uc9c0\uba70, \ub9d0\ud310\uc744 \uc774\ub3d9\uc2dc\ud0a4\uba70 \ubab0\uc785\uac10 \ub118\uce58\ub294 \ud134\uc744 \uc990\uaca8\ubcf4\uc138\uc694! {1762917267720436}\n\n- **\uc138\uacc4 \uac01\uc9c0\uc5d0\uc11c \ud3bc\uce58\ub294 \ubbf8\ub2c8\uac8c\uc784**: \ub9f5\uc758 \uac01 \uc9c0\uc810\uc5d0\uc11c \ub79c\ub364\uc73c\ub85c \uc9c4\ud589\ub418\ub294 \ubbf8\ub2c8\uac8c\uc784! \ubc14\uc774\ud0b9 \ub450\ub354\uc9c0 \uc7a1\uae30, \ub9ac\uc6b0\uc758 \uae38\uac70\ub9ac \ucd95\uad6c, \ucf5c\ub85c\uc138\uc6c0 \uc7a5\uc560\ubb3c \ub2ec\ub9ac\uae30 \ub4f1 \ub2e4\ucc44\ub85c\uc6b4 \uac8c\uc784\uc73c\ub85c \uc7ac\ubbf8\uc640 \ubab0\uc785\uc744 \ub3d9\uc2dc\uc5d0 \uacbd\ud5d8\ud558\uc138\uc694.  {1875278790535252}\n\n\n\n\n**\ub2f9\uc2e0\uc758 \ub2e4\uc74c \uc5ec\ud589\uc9c0\ub294 \uc5b4\ub514\uc778\uac00\uc694?\ud83d\uddfa\ufe0f**\n\n\uc8fc\uc0ac\uc704\ub97c \uad74\ub9ac\uace0, \uc138\uacc4\ub85c \ub098\uc544\uac00\uc138\uc694! \n\nMR. TRAVELER \u2014 \uc774\uc81c \uc138\uacc4\uac00 \uc5ec\ub7ec\ubd84\uc758 \ubc29\uc73c\ub85c \ucc3e\uc544\uc635\ub2c8\ub2e4!\n\n", "short_description": "\uc8fc\uc0ac\uc704\ub97c \ub358\uc838 \ub5a0\ub098\ub294 \uc2e0\ub098\ub294 \uc138\uacc4 \uc5ec\ud589\ud83c\udfb2\n\ud604\uc2e4\uacfc \uac00\uc0c1\uc744 \ub118\ub098\ub4dc\ub294 \ud310\ud0c0\uc9c0 \ud30c\ud2f0\ub85c \ucc38\uc5ec\ud558\uc138\uc694!\n\ucd5c\ub300 4\uba85\uc774 \ud568\uaed8 \uc990\uae30\ub294 MR \ud30c\ud2f0 \ubcf4\ub4dc\uac8c\uc784 MR. TRAVELER! \n\uc804 \uc138\uacc4\ub97c \ub204\ube44\ub294 \ubaa8\ud5d8\uc744 \ub5a0\ub098\ubcf4\uc138\uc694. \uc8fc\uc0ac\uc704\ub97c \ub358\uc9c0\uace0, \uc9dc\ub9bf\ud55c \ubbf8\ub2c8\uac8c\uc784\uc5d0 \ub3c4\uc0ac\uc704\ub97c \ub358\uc838 \ub5a0\ub098\ub294 \uc2e0\ub098\ub294 \uc138\uacc4 \uc5ec\ud589\ud83c\udfb2\n\ud604\uc2e4\uacfc \uac00\uc0c1\uc744 \ub118\ub098\ub4dc\ub294 \ud310\ud0c0\uc9c0 \ud30c\ud2f0\ub85c \ucc38\uc5ec\ud558\uc138\uc694!\n\ucd5c\ub300 4\uba85\uc774 \ud568\uaed8 \uc990\uae30\ub294 MR \ud30c\ud2f0 \ubcf4\ub4dc\uac8c\uc784 MR. TRAVELER! \u2708\ufe0f\n\uc804 \uc138\uacc4\ub97c \ub204\ube44\ub294 \ubaa8\ud5d8\uc744 \ub5a0\ub098\ubcf4\uc138\uc694. \uc8fc\uc0ac\uc704\ub97c \ub358\uc9c0\uace0, \uc9dc\ub9bf\ud55c \ubbf8\ub2c8\uac8c\uc784\uc5d0 \ub3c4\uc804\ud558\uba70, \ub9c8\uc77c\ub9ac\uc9c0\ub97c \ubaa8\uc544 \uc138\uacc4 \uacf3\uacf3\uc744 \ud0d0\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "Icon_0.png", "id": "1561804774952021", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619697_1561804778285354_118921955870024847_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jamA3nd9EdMQ7kNvwEJam4o&_nc_oc=AdoJJVM8Fp8er0dqaE-kGNM1HYilDH-cZSYsz1ZF5kgHwkY-vm_vPA3Kj7kdXHyxESw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNtwhvKT-IV_AtPbn-r1zkFNQA2_6xgJy8RBdh-44Ahw&oe=6A942344"}, {"file_name": "Hero_Cover.png", "id": "1527285578701309", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491821886_1527285582034642_1857375708722439903_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNF2GqdkY0YQ7k
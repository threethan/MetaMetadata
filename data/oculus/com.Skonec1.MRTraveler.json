d": "811603264975447", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820987_811603268308780_7287038813199385571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvZlkS98Z3UQ7kNvwHSkm2M&_nc_oc=Adk30EEGVEiYt1GBXN9QgJJqdt8xzjnl9EYImQkzHKGADnv1yuihb3wNYP9sZGYJpUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvJetpKRKsJXWGtUeIm9obz2MWUCLZkbbTlAmYTCAgfmQ&oe=699AECDB"}, {"file_name": "appdata_01.png", "id": "1934114687127739", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618367_1934114690461072_4502926144465772310_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEVOpyWcD9EQ7kNvwG6oN8P&_nc_oc=AdlEDEu8dsb7nx0X_Rlc13W0a4nm1GvHvIQCDNZ9Enz5mucs0jUN0o_zwhLTB10HEyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftyRDw7HC5AwEr4xYTfcY9_RIdytmBrKqkjmBt_RwIAQg&oe=699B11E0"}, {"file_name": "screenshot_001.png", "id": "2354279904986417", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820382_2354279908319750_1580768247434966664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN6h6ecTQxsQ7kNvwHMZj7H&_nc_oc=AdkPkg4t9K5vksqnkqPthcVb6QqZf7avmN31KpDS1jKjXuZ0_va1rdBYuzM_f9ofX5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvXmOsumrUG75FeyBzk9_hTGPZXUKKbHo9qVdL8wyEalQ&oe=699AE89B"}, {"file_name": "screenshot_002.png", "id": "1332229228606642", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820047_1332229231939975_3487970403264993133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISp1MkquxhwQ7kNvwHY0CaX&_nc_oc=AdnJZRrHkUN6JibO3R7Ae4Qu3iyS-D8-iYI7RTOJBzX-Ve1y7yz5uyjJuLffoaGlywI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsqRaj0sFkiJPNNKVVTAHbXE4OszCjf-vlwUJx1ifT82g&oe=699AE796"}, {"file_name": "Screenshot_004.png", "id": "1732833994055728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821193_1732833997389061_4118909829513907629_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMgLO743k_4Q7kNvwGdM8br&_nc_oc=AdnuU5tiTAN1RvH3Gu8Mb_ntoHfbxPjgFZDlflbwEoHXnXRuL3JlAEKowZj6Ff3z2s0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvsZgWMxnWg3oYX8LZ11PbcMQInoXyLrT0QWSRO_eI8Xw&oe=699B0DDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_image.png", "id": "1090931546566392", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819464_1090931549899725_61930350821301656_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZWfyn7jTtEQ7kNvwG5rDf4&_nc_oc=AdkZIOvo-CLRL295vZAoEaqfKpN-l06W9U77MNnQ3-rXlQhpVOFmKHCqxyfoAkEJqc4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsLd5YHYMWW08bZxhgInApoUdD7nlPu34RckAgto9q--g&oe=699AFF97"}, "display_name": "MR. TRAVELER", "keywords": ["tabletop", "traveler", "mixedreality", "adventure", "partygame"], "long_description": "# \ud83c\udfb2Roll the dice and travel the world \u2013 in Mixed Reality!\n\nMR. TRAVELER is a groundbreaking travel-themed game where a giant board game map unfolds right in your own space through mixed reality. All you need is a Meta Quest headset, and your room becomes the starting point of an epic global journey! Dive into wacky mini-games, collect famous landmarks, and experience unpredictable adventures from around the world.\n\n**Key Features:**\n- **Travel mates from Gacha**: Use the coins you\u2019ve earned in the game to spin the gacha and collect adorable, one-of-a-kind pawn characters. These characters will become your reliable mates on every journey! {2228824020937045}\n\n- **Mixed Reality Tabletop Gameplay**: Place the board map freely in your real space. Grab and roll the dice with hand tracking in real time, move your pawn, and enjoy immersive turns like never before. {1375647757237394}\n\n- **Mini-Games from Around the World**: Play random mini-games at each spot on the map! From Viking whack-a-mole, Rio street soccer, to Roman Colosseum obstacle races \u2014 experience fun and excitement through a variety of global challenges. {1316633822994842}\n\n**Where will your next travel take you?\ud83d\uddfa\ufe0f**\n\nRoll the dice and set out to explore the world. \n\nMR. TRAVELER \u2014 now the world comes to you!", "short_description": "MR. TRAVELER is a super fun mixed reality board game where up to 4 friends can team up and explore the world together! \ud83c\udf0d\ud83d\uddfa\ufe0f Jump into exciting mini-games, collect awesome rewards \ud83e\udde9\ud83c\udf81, and experience famous global landmarks\u2014right from your room. Before the game begins, hang out in a vibrant social lounge with up to 16 players \ud83d\ude0e\ud83c\udfae. Chat, dance, and make new friends as you get ready for your next adventure. Travel the world from your room\u2014no passport needed! \u2708\ufe0f\ud83c\udfe0"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsquare.skonec.com/Traveler_PrivacyPolicy_EN.htm", "developer_terms_of_service_url": null, "publisher_name": "Skonec Entertainment", "support_website_url": null, "website_url": "https://www.skonec.com/en/new-games/mr-traveler/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1676485315806614"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24275716102101328"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3766970476778029"}]}, "baseline_offer": {"id": "3766970476778029"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763661600, "status": "PUBLISHED", "id": "3766970476778
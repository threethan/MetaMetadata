20f&oh=00_AQOTRZ4jR1pqdhv9-FulOORd2JWxBZqVJ2aahkgkoypFFw&oe=6AE1FF8E"}, {"file_name": "BSVR_steam_screenshot_menu.png", "id": "1566542923784086", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75542961_1566542927117419_8668564475589245577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nusTlYLKd3MQ7kNvwGCoh0E&_nc_oc=AdqhAjRTAsSPAW5b19Tf5h6fv_u9spyw6x-_6pfFw_UjOYBDCW-4CIoS4MSyAxWQR3c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4DRY-tTZ5w5rNrw7fo4aQJO81xOhY6oQcgaBvOY7Q2g&oe=6AE2177F"}, {"file_name": "BSVR_steam_screenshots_03.png", "id": "5151067148337343", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75458089_5151067155004009_1981440307324580415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKl_zsy7TZUQ7kNvwGDcWFi&_nc_oc=AdpWeFCa8Pj8IUO4YEjhY6RgT1hPSFxX2CRYG8PgO_EFFjALVZ4wucpTmPGdKwWm3kg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoNMFrIcS2ntmGR4Y8Zw2B0okX8OBboPuM0pJt_SeYNA&oe=6AE1FF14"}, {"file_name": "BSVR_screenshots_19.png", "id": "493482905511032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404387_493482908844365_5402491355073622510_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_b2ccs2eCUQ7kNvwHEtuTy&_nc_oc=Adp4sTX6TV5WrkXivxuvoqwDGVaV8RetsdstaLphxSae4xLeYmy4Qvd7kv5h39JR88c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOThuHA4HE3VrnM0xi_ykyKL1fQf_UH0QHRm-qN8VKexg&oe=6AE1EF20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CN0259_BSVR_trailer_cover_image.png", "id": "1367653933978944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230043_1367653937312277_2974675620369248290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srT0HBFXqawQ7kNvwEtw1la&_nc_oc=Ado5bm_FSnHKyAgLMiT168OxEeoi2nlmTzHAEs5KcNCbKc-tx_ApDBAwFDVOHSR_uO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLEtzAX8taBA_2j-oaQYLjrqV38gK7WHGrr2Hqh_Bv5Q&oe=6AE1E8BC"}, "display_name": "BlockStar VR", "keywords": [], "long_description": "BlockStar VR is a VR shooter where you put your reflexes to the test by shooting blocks and completing challenges in an action-packed futuristic tournament. Play the 40-mission story mode and show that you have what it takes to flex on the leaderboard!\n\nExperience what it\u2019s like to be a rising star in a harsh futuristic world aboard the BlockStar space station. Use your unique weapons, crazy power-ups and imaginative bonuses against changing patterns and indestructible obstacles. Shoot them all!\n\nUnlock a varied arsenal as you progress, from shotguns to ray guns, from shields to bazookas, from grenades to tennis balls. Shoot too much and your weapon might overheat, shoot too little and the cubes will get you! Can you stop them or do they stop you?\n\n- Action, shooting VR game\n- 360\u00b0 cutscenes\n- 40 unique arenas\n- Tournaments & Challenges\n- Various play modes\n- 12 unique weapons\n- 20+ bonuses\n- 8 special fusion projectiles\n- Crazy Power-Up\n- In-game commentators\n- Robo assistant 087", "short_description": "BlockStar VR is a VR shooter where you put your reflexes to the test by shooting blocks and completing challenges in an action-packed futuristic tournament. Play the 40-mission story mode and show that you have what it takes to flex on the leaderboard!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blockstarvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersvie Division", "support_website_url": null, "website_url": "https://blockstarvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
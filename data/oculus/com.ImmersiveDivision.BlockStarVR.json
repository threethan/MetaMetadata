20f&oh=00_AQLoLM79XQ_kbygOOlw0g4lSINI7Y1RK9litdr4eo7BwGA&oe=6AA6AC0E"}, {"file_name": "BSVR_steam_screenshot_menu.png", "id": "1566542923784086", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75542961_1566542927117419_8668564475589245577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCs30-4n-_MQ7kNvwEDJPPD&_nc_oc=Adq8ETip9o7SA8iMZoEM9Cx36YEvd9phBwWvoxcJoEjviKZLa36r6_lQGIrHV4N5hCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHbxS9BfG1IRpCSVPb9LVqEdqa2_4RBba3agVaeQj1Cg&oe=6AA6C3FF"}, {"file_name": "BSVR_steam_screenshots_03.png", "id": "5151067148337343", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458089_5151067155004009_1981440307324580415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJLl4sD7wG0Q7kNvwHjc7cl&_nc_oc=AdpTIhG8480YbWKyIfiW9PnoVozgGXrSR42-7r5pVg0wWIdY0ZU27VMOCa7VDXe7XbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW64oYEMpWedtQy0ykb_k-3zfzmNl_DenXPllz9Ko3Cg&oe=6AA6AB94"}, {"file_name": "BSVR_screenshots_19.png", "id": "493482905511032", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404387_493482908844365_5402491355073622510_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aKcBkwk12UQ7kNvwE3E1Z3&_nc_oc=AdqLp1cldDSfKJXL1KtErEA3nLQRR6FmuYgBXgCXSugMqIWWYy1xuHBvvLe1dwYlbd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5RRsVdoKJrtv9eE1zX5F-tdbeC-6kI_9UWttu5FQE_g&oe=6AA69BA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CN0259_BSVR_trailer_cover_image.png", "id": "1367653933978944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230043_1367653937312277_2974675620369248290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmnAOMCZmEkQ7kNvwGbTcrX&_nc_oc=Adp7Wm_6j61kNNBPVFaya2JQ7Gu7pBlqhzDjtIfOZMNrUWiwg2zW_BeLutZjylGRR1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzazylR6zXzqPyDIY36piXfnKVcvz1lp_9ZOVXus4Z_g&oe=6AA6953C"}, "display_name": "BlockStar VR", "keywords": [], "long_description": "BlockStar VR is a VR shooter where you put your reflexes to the test by shooting blocks and completing challenges in an action-packed futuristic tournament. Play the 40-mission story mode and show that you have what it takes to flex on the leaderboard!\n\nExperience what it\u2019s like to be a rising star in a harsh futuristic world aboard the BlockStar space station. Use your unique weapons, crazy power-ups and imaginative bonuses against changing patterns and indestructible obstacles. Shoot them all!\n\nUnlock a varied arsenal as you progress, from shotguns to ray guns, from shields to bazookas, from grenades to tennis balls. Shoot too much and your weapon might overheat, shoot too little and the cubes will get you! Can you stop them or do they stop you?\n\n- Action, shooting VR game\n- 360\u00b0 cutscenes\n- 40 unique arenas\n- Tournaments & Challenges\n- Various play modes\n- 12 unique weapons\n- 20+ bonuses\n- 8 special fusion projectiles\n- Crazy Power-Up\n- In-game commentators\n- Robo assistant 087", "short_description": "BlockStar VR is a VR shooter where you put your reflexes to the test by shooting blocks and completing challenges in an action-packed futuristic tournament. Play the 40-mission story mode and show that you have what it takes to flex on the leaderboard!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blockstarvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersvie Division", "support_website_url": null, "website_url": "https://blockstarvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
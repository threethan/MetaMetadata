20f&oh=00_AQJf-d4C8zG0kzySrHXoYm_WzbVoYTagm2hD8kEtoaI4uw&oe=6A9EC30E"}, {"file_name": "BSVR_steam_screenshot_menu.png", "id": "1566542923784086", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75542961_1566542927117419_8668564475589245577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqBPcf30upgQ7kNvwFiIi0W&_nc_oc=Adp13BlLsOTp4FkID4Zc9DOBZpcvmhtNk9dZ32IgmtLTn8m7VK_wQDSJHS4mGP0nX3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKd8nPZIYRgFdlw2nClkKk20kRDcO35MRTgUrn3r_XYQ&oe=6A9EDAFF"}, {"file_name": "BSVR_steam_screenshots_03.png", "id": "5151067148337343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458089_5151067155004009_1981440307324580415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNlNcrKn-ygQ7kNvwEumwWs&_nc_oc=Adq5LOjF3I-7KMmiLcWNFHava3YM-Eh3vKPjYr9Zh2oLkUWYwSd1eNpHEK8__8JLeGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXjZfPjDFT4YlBNZOjGp0jy7Ek4RD3-Ii4aT6eRkbr0Q&oe=6A9EC294"}, {"file_name": "BSVR_screenshots_19.png", "id": "493482905511032", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404387_493482908844365_5402491355073622510_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04I7rxwrHFwQ7kNvwERNJNC&_nc_oc=AdqG3aJGaQGvP_09xY4cY_HHFX0T0Lu-WJcOz4k_sT7SBYK3L-E5VnI9LNYEjyp_wA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ81R715EcNLGOKtRcvCySC4StS8K_hUp58RZwkOZsHA&oe=6A9EB2A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CN0259_BSVR_trailer_cover_image.png", "id": "1367653933978944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230043_1367653937312277_2974675620369248290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmAuE9c5AvYQ7kNvwHpeRvK&_nc_oc=AdpWZ5i7b_wNwTUV1kJA_ADNnLQThwZ8WHEArtB6bm2U-wdJ443tpyu_daAW2v1E0D0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeKCNxKpuZkYcGryzV2kptocHwjG2ehIQCbFnfWVnzDg&oe=6A9EE47C"}, "display_name": "BlockStar VR", "keywords": [], "long_description": "BlockStar VR is a VR shooter where you put your reflexes to the test by shooting blocks and completing challenges in an action-packed futuristic tournament. Play the 40-mission story mode and show that you have what it takes to flex on the leaderboard!\n\nExperience what it\u2019s like to be a rising star in a harsh futuristic world aboard the BlockStar space station. Use your unique weapons, crazy power-ups and imaginative bonuses against changing patterns and indestructible obstacles. Shoot them all!\n\nUnlock a varied arsenal as you progress, from shotguns to ray guns, from shields to bazookas, from grenades to tennis balls. Shoot too much and your weapon might overheat, shoot too little and the cubes will get you! Can you stop them or do they stop you?\n\n- Action, shooting VR game\n- 360\u00b0 cutscenes\n- 40 unique arenas\n- Tournaments & Challenges\n- Various play modes\n- 12 unique weapons\n- 20+ bonuses\n- 8 special fusion projectiles\n- Crazy Power-Up\n- In-game commentators\n- Robo assistant 087", "short_description": "BlockStar VR is a VR shooter where you put your reflexes to the test by shooting blocks and completing challenges in an action-packed futuristic tournament. Play the 40-mission story mode and show that you have what it takes to flex on the leaderboard!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blockstarvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersvie Division", "support_website_url": null, "website_url": "https://blockstarvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
F"}, {"file_name": "BSVR_steam_screenshots_03.png", "id": "5151067148337343", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75458089_5151067155004009_1981440307324580415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCbZyAP_UsQQ7kNvwFWYyz5&_nc_oc=AdmJYZVmFyYKCFkmr4nNJU8Wzok-MB3swc8CHzf2RUao_cmAZUUBK2cFbm9wHaBs-Yo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuwEZH9N0IWSZo4AtkVp19a2Ir5Nb1KfzIn-XAe4kDKgQ&oe=69A59714"}, {"file_name": "BSVR_screenshots_19.png", "id": "493482905511032", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404387_493482908844365_5402491355073622510_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1XXCW4btVgQ7kNvwGc8kHd&_nc_oc=Adminvh3pyC0pi7JeFm6mtPJB5FiuWldRmEUWDwonsT8qQqo49zOqBdnMAXk97zZXU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftNym-E_u4OHq8-QCDLQ4T42QDc-iwG5c0I_YbXNGkr5Q&oe=69A58720"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CN0259_BSVR_trailer_cover_image.png", "id": "1367653933978944", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230043_1367653937312277_2974675620369248290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JspoC0hwxSMQ7kNvwEiW0W9&_nc_oc=AdmaUU059Gqgv4NULUEtbHypQZqaaHxtIEFLPQxFhfk2NcrRZxbEN6CMolas6qtZ8WE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft2If8UE2Yj-2LW2BhB5dk3Y2k3eQ2s8Q_qeRaKNNuREQ&oe=69A580BC"}, "display_name": "BlockStar VR", "keywords": [], "long_description": "BlockStar VR is a VR shooter where you put your reflexes to the test by shooting blocks and completing challenges in an action-packed futuristic tournament. Play the 40-mission story mode and show that you have what it takes to flex on the leaderboard!\n\nExperience what it\u2019s like to be a rising star in a harsh futuristic world aboard the BlockStar space station. Use your unique weapons, crazy power-ups and imaginative bonuses against changing patterns and indestructible obstacles. Shoot them all!\n\nUnlock a varied arsenal as you progress, from shotguns to ray guns, from shields to bazookas, from grenades to tennis balls. Shoot too much and your weapon might overheat, shoot too little and the cubes will get you! Can you stop them or do they stop you?\n\n- Action, shooting VR game\n- 360\u00b0 cutscenes\n- 40 unique arenas\n- Tournaments & Challenges\n- Various play modes\n- 12 unique weapons\n- 20+ bonuses\n- 8 special fusion projectiles\n- Crazy Power-Up\n- In-game commentators\n- Robo assistant 087", "short_description": "BlockStar VR is a VR shooter where you put your reflexes to the test by shooting blocks and completing challenges in an action-packed futuristic tournament. Play the 40-mission story mode and show that you have what it takes to flex on the leaderboard!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blockstarvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersvie Division", "support_website_url": null, "website_url": "https://immersivedivision.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1194864478110713"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7981213855255254", "version": "1.7
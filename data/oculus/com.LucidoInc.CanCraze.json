-1.oculuscdn.com/v/t64.5771-25/499298862_1421279685960523_673875114933176436_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-qC1dYcW2wQ7kNvwH_BLZ7&_nc_oc=Adr_etkX_NhsLaaCKvQpiSNofPDXQG_vAlIezP4Rt4810BbZnl9lk6-6LBiOs7baV20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqP2py8hct8IpfGz5GHroJkvsJy67mcK84Zy2QXl6-BA&oe=6B01EA51"}, {"file_name": "7 (2).png", "id": "1038769921713217", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302631_1038769925046550_7805064287681363133_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQMZm6EcszsQ7kNvwGdqUcL&_nc_oc=AdobiJ7CevbIlc1g3SJE5p4NA9vzvluqXYbfj0cuGr1_p3fAK6bUkBPrAMfmwJrGB8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0YA-c6OqPUnxNFhcb0fPGsB8A-YGyRNMDFtewDIylvw&oe=6B01CC50"}, {"file_name": "7 (2).png", "id": "1433742190955471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1433742194288804_5732976123126194641_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWH7VDE5wDIQ7kNvwFeScPT&_nc_oc=AdrrTacZrPUU2VXaYpVhB4DxhPBQlYNTDKSgPb05exF3WMTdwYba9GSt-1dBublVT0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4htCAwt3W63OUgiNcwnfu6a3JeTZrBRbhNxL-vzcK6A&oe=6B01D191"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Can Craze", "keywords": [], "long_description": "Grab, Aim, Score \u2013 Before It's Too Late!\n\nStep into a fast-paced VR experience that puts your reflexes and hand-eye coordination to the test! In this addictive challenge, cans fall from above \u2014 and it's your job to catch them and throw them into the shopping cart before they disappear. Sounds easy? Think again.\n\nEach can has a limited time before it vanishes, so you'll need sharp reaction timing, quick decision-making, and precision throws to keep your score climbing. The faster you move, the more cans you save \u2014 and the higher your reward.\n\nPerfect for short bursts of play or intense high-score battles, this game blends arcade-style fun with immersive VR interaction. Whether you're training your speed or just looking for a satisfying tossing experience, it's all about grabbing cans and beating the clock!\n\n", "short_description": "est your reflexes in this fast-paced VR challenge!\nGrab falling cans and toss them into the shopping cart before they vanish. Sharpen your reaction time, aim quickly, and score big before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/cancraze/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc.", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491955153735570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307434_1425384208806888_1147236445333288583_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3G0GqKvAjoQ7kNvwHC3rwQ&_nc_oc=AdqOTX2HM5XCjQwgLF4rzOj_9aZj9e_D53eUKxOd9KsvKrtm8QDvjwjA2g65emhJEbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxHe-WTUgp8aJ4YB2C8iPlpyy1LKzXFQuejKTkdRr5Dw&oe=6B01D518"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Can Craze", "platform": "AN
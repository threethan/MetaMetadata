-2.oculuscdn.com/v/t64.5771-25/499298862_1421279685960523_673875114933176436_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1LHfFTSwjAQ7kNvwEmmoKQ&_nc_oc=AdoMvKKfK27jKU1uAzklJIvP0_Q0REsJdBLinh_tJcIZx_L4fNw-P2YGWGd-ORaxZcM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7I2wD-J7L1RaNwYS3fNe8eEnVRQ9pPAo3f0Sn24zIEQ&oe=6AFC6C11"}, {"file_name": "7 (2).png", "id": "1038769921713217", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499302631_1038769925046550_7805064287681363133_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP8Da_2iRIkQ7kNvwHV3PDS&_nc_oc=Adpb9e4w4QCCtuNJhcx1OsCZfhrlmk4k-BjbzEIv0IM4u6vAt8IOVaxSLGKQazW0AUU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9l3qi5sOYIZvGemfNwOEDdoz3qxDsi0WK6i8qHBt4gQ&oe=6AFC8650"}, {"file_name": "7 (2).png", "id": "1433742190955471", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302770_1433742194288804_5732976123126194641_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZJNceg-naIQ7kNvwH3qLnZ&_nc_oc=AdqanJ-XIoSiCcNc4p0lQHtjKjASak3XIazTMrwTMjZ23_wtX7BSGWGDKq-q6-2P3Gw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_pLmIBZ1GLZHg81qQF5HCUNT58ja2Td380rj3LHCdgw&oe=6AFC8B91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Can Craze", "keywords": [], "long_description": "Grab, Aim, Score \u2013 Before It's Too Late!\n\nStep into a fast-paced VR experience that puts your reflexes and hand-eye coordination to the test! In this addictive challenge, cans fall from above \u2014 and it's your job to catch them and throw them into the shopping cart before they disappear. Sounds easy? Think again.\n\nEach can has a limited time before it vanishes, so you'll need sharp reaction timing, quick decision-making, and precision throws to keep your score climbing. The faster you move, the more cans you save \u2014 and the higher your reward.\n\nPerfect for short bursts of play or intense high-score battles, this game blends arcade-style fun with immersive VR interaction. Whether you're training your speed or just looking for a satisfying tossing experience, it's all about grabbing cans and beating the clock!\n\n", "short_description": "est your reflexes in this fast-paced VR challenge!\nGrab falling cans and toss them into the shopping cart before they vanish. Sharpen your reaction time, aim quickly, and score big before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/cancraze/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc.", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491955153735570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307434_1425384208806888_1147236445333288583_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vongWa4ljDwQ7kNvwEiD74J&_nc_oc=AdqP0FanOi2E6C-EjqtE_qxf7uPEKl9iyLflAXGrzdqdiB62YJlY1hJwCighvvCKHUw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzElax9Tnvc8ED3HR44K61u79BP_l99dC_Jv1c_xBRMQ&oe=6AFC8F18"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Can Craze", "platform": "AN
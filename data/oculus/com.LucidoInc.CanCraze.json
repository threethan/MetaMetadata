dn.com&_nc_ss=7f20f&oh=00_AQN9ynzaERQuik9t4d5bdZzG3Rl_I5By59P89RzlMB3ZGA&oe=6AD248E1"}, {"file_name": "7 (2).png", "id": "1725241774744877", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1725241778078210_6769335050309751334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzmalK14ktEQ7kNvwFYYGJS&_nc_oc=Adr6ooHhWKgEKaol8KVrzWRTlldF4t9MYSfWwK4DDUWPTKjaoFFeBpI2Tff6y6kIdeQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmWp8NfCx2bin1xGm1nGSaG2QW6D6GqcmYHsD1vPc-Ig&oe=6AD22957"}, {"file_name": "7 (2).png", "id": "1421279682627190", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298862_1421279685960523_673875114933176436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYGgtG7SCc8Q7kNvwF5QlLK&_nc_oc=Adpp9L7P6hYjByduoUyR2DRhlF5mIG7kfYgMfxyOdZrkOwjA9QqRnoTRikNBB0DrvXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDe7TUIrzdD3BBFEqWbZ37WPE3DM-cCcyBl31KUxESIQ&oe=6AD23C11"}, {"file_name": "7 (2).png", "id": "1038769921713217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302631_1038769925046550_7805064287681363133_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCKSQsZduRcQ7kNvwG7383L&_nc_oc=AdqVTWnLx97aIHRT_U-ODTLVJFxgOJoucXcMq9MsOF87KGlfEOQsquNRWpieTo7C6z0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXyjt2-Bi1e8MM4ayb9U4TLCnBW8I2Fvs7JLfbA54sWA&oe=6AD25650"}, {"file_name": "7 (2).png", "id": "1433742190955471", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_1433742194288804_5732976123126194641_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5h8zAb_M0MQ7kNvwHkaLTG&_nc_oc=Adodv-NE5pGQ-OBEshqTpjEK0pixaUlcr03lYKI-6AGCnH_mftQuwtUrMFbvqb2yn6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcpR5N0SU7mv1WydKV02G6QlrPo4Db95s_dsN_l_TO5g&oe=6AD25B91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Can Craze", "keywords": [], "long_description": "Grab, Aim, Score \u2013 Before It's Too Late!\n\nStep into a fast-paced VR experience that puts your reflexes and hand-eye coordination to the test! In this addictive challenge, cans fall from above \u2014 and it's your job to catch them and throw them into the shopping cart before they disappear. Sounds easy? Think again.\n\nEach can has a limited time before it vanishes, so you'll need sharp reaction timing, quick decision-making, and precision throws to keep your score climbing. The faster you move, the more cans you save \u2014 and the higher your reward.\n\nPerfect for short bursts of play or intense high-score battles, this game blends arcade-style fun with immersive VR interaction. Whether you're training your speed or just looking for a satisfying tossing experience, it's all about grabbing cans and beating the clock!\n\n", "short_description": "est your reflexes in this fast-paced VR challenge!\nGrab falling cans and toss them into the shopping cart before they vanish. Sharpen your reaction time, aim quickly, and score big before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/cancraze/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc.", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491955153735570"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISH
_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx0zRNMDpktECwg1jH4cE6MayLEpVnOxmE3-bWTL2dww&oe=6ADE1991"}, {"file_name": "7 (2).png", "id": "1038769921713217", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499302631_1038769925046550_7805064287681363133_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwOJYFgB6wIQ7kNvwFv5RFU&_nc_oc=Ado7GiCyo488gVPGDllXNmQ_knzuzhT1h7O6d6xqCa0nGNPH_RXyoe7MuvaJv280JHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdQdIuTAX6R52IkhpKMLlOyuifusefprV3SksXZaRCaw&oe=6ADDFB90"}, {"file_name": "7 (2).png", "id": "1433742190955471", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499302770_1433742194288804_5732976123126194641_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvw5Aax7kSgQ7kNvwHGdrd-&_nc_oc=AdoQYrfp9zjrlZ5nSQpwz0HgSztme0R5IG-9R4n6v9rCCVkEhQm4WDC5XiSknxVeZvc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWspbEdYfSeQ0yiKf7CYg6jzhbKYs25guFR1eXRyUHSg&oe=6ADE00D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Can Craze", "keywords": [], "long_description": "Grab, Aim, Score \u2013 Before It's Too Late!\n\nStep into a fast-paced VR experience that puts your reflexes and hand-eye coordination to the test! In this addictive challenge, cans fall from above \u2014 and it's your job to catch them and throw them into the shopping cart before they disappear. Sounds easy? Think again.\n\nEach can has a limited time before it vanishes, so you'll need sharp reaction timing, quick decision-making, and precision throws to keep your score climbing. The faster you move, the more cans you save \u2014 and the higher your reward.\n\nPerfect for short bursts of play or intense high-score battles, this game blends arcade-style fun with immersive VR interaction. Whether you're training your speed or just looking for a satisfying tossing experience, it's all about grabbing cans and beating the clock!\n\n", "short_description": "est your reflexes in this fast-paced VR challenge!\nGrab falling cans and toss them into the shopping cart before they vanish. Sharpen your reaction time, aim quickly, and score big before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/cancraze/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc.", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491955153735570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307434_1425384208806888_1147236445333288583_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGx-8ngGkiAQ7kNvwFS1kVj&_nc_oc=AdoHXh8RXGD_PexIzCH6OuLTaezm17fHmSKL7BxTFAzvBHnAZZ8uYYq4nPDTM4LsMfw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT8q1IRWvogkYQodbiTWi_ZiEJL6q2K7vQR6sAOEAI4w&oe=6ADE0458"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Can Craze", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1750074480, "lastRevision": {"nodes": [{"id": "24491955177068901", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applicati
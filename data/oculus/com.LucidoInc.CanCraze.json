_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUAu1BNx8t9tQfTLKIbWFetOFZaoHbqWSvrtPE9u6XaQ&oe=6A998B91"}, {"file_name": "7 (2).png", "id": "1038769921713217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302631_1038769925046550_7805064287681363133_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DTaVqxW5JgQ7kNvwFuOfWx&_nc_oc=Adq0ckTMjtBXKGxGzqL1iGlUWkQrjB2Ne7m8Vi9Q4M4w52-yqCRA1-eo6e6KPRPORFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-uQfoeoAYnBjzNwR4PWrKgb9ZVWgxZ3HxdiidbAEVHg&oe=6A996D90"}, {"file_name": "7 (2).png", "id": "1433742190955471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302770_1433742194288804_5732976123126194641_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HnVFuQIyG0Q7kNvwFg1epX&_nc_oc=AdpFM3uvXPQmM94qjURP5zlgpdGIuEKUCQNWxXHHSDU-EYNuuz1_aEaU3Qjp8C2Y9AM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzh-xHgnmArB2XCKySJPpkOTl_OLcVGOjtoabPrkXs_g&oe=6A9972D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Can Craze", "keywords": [], "long_description": "Grab, Aim, Score \u2013 Before It's Too Late!\n\nStep into a fast-paced VR experience that puts your reflexes and hand-eye coordination to the test! In this addictive challenge, cans fall from above \u2014 and it's your job to catch them and throw them into the shopping cart before they disappear. Sounds easy? Think again.\n\nEach can has a limited time before it vanishes, so you'll need sharp reaction timing, quick decision-making, and precision throws to keep your score climbing. The faster you move, the more cans you save \u2014 and the higher your reward.\n\nPerfect for short bursts of play or intense high-score battles, this game blends arcade-style fun with immersive VR interaction. Whether you're training your speed or just looking for a satisfying tossing experience, it's all about grabbing cans and beating the clock!\n\n", "short_description": "est your reflexes in this fast-paced VR challenge!\nGrab falling cans and toss them into the shopping cart before they vanish. Sharpen your reaction time, aim quickly, and score big before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/cancraze/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc.", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491955153735570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307434_1425384208806888_1147236445333288583_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rw5HC_Y9aEQ7kNvwEBaUY-&_nc_oc=AdoPfWvm0IQ2lI3ifCvtbVfynAUYggdhCM_JA1FSSuPQ_W020LX0hPpJI0Qb3iLrZIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL75jLN6HTuTSPqcMz_3s9_lWPJdnXihuOz_Uv6thQbjA&oe=6A997658"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Can Craze", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1750074480, "lastRevision": {"nodes": [{"id": "24491955177068901", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applicati
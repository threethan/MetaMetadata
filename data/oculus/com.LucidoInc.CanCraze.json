dn.com&_nc_ss=7f20f&oh=00_AQM8gjhgAa-DAp9f40d-FnTsF3XxWjCRcq0OfHQT76T7EA&oe=6ACBB161"}, {"file_name": "7 (2).png", "id": "1725241774744877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305194_1725241778078210_6769335050309751334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iieGXZtsK0QQ7kNvwEgD4BY&_nc_oc=Adpu9neQaKN-Devx1c-mZRskpbIxvvIRhNAq5mTGJa8vSXWbPnccWTu19PWKJGfgDuA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrFsi2-VE0Nrp1bfJm4iFElHItuDA2K7-odQKsIvS1_Q&oe=6ACB91D7"}, {"file_name": "7 (2).png", "id": "1421279682627190", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298862_1421279685960523_673875114933176436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quC5mLomS78Q7kNvwFs1umu&_nc_oc=AdoBJobyaZRtNmoixSrzZXHmI1nVqsr0JAtozoMi31EegSmrKj8N1qtvTM09PY1Cs-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMSZA2YFFQKwSS2F8EcP-p_6d1VnyQ1jFLUh7HrvnSNw&oe=6ACBA491"}, {"file_name": "7 (2).png", "id": "1038769921713217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302631_1038769925046550_7805064287681363133_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96DMI_AVu5kQ7kNvwEpzOF5&_nc_oc=Adrn7kM-qM_Ne_50RnKNOR96lM9swJiDw-_6YMZe4jOq-3yhgCNl8BZ1uFN43AXpzDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSmfr4cHwrj5PppSyUPVvOphQRu3t8qT0B7nL7hrJz7Q&oe=6ACBBED0"}, {"file_name": "7 (2).png", "id": "1433742190955471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302770_1433742194288804_5732976123126194641_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGIeHB_IAl0Q7kNvwHcxI5l&_nc_oc=Adrc898EqRdSxxyhBOt-4XMGKjOQw_xh9v4AXHtZtAQ_dOd6W6cZFCNtMe9nBFfA_pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEkxN6wwUcetAegaialt07ZWfHQDfyGlKonQfA2AzwAQ&oe=6ACBC411"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Can Craze", "keywords": [], "long_description": "Grab, Aim, Score \u2013 Before It's Too Late!\n\nStep into a fast-paced VR experience that puts your reflexes and hand-eye coordination to the test! In this addictive challenge, cans fall from above \u2014 and it's your job to catch them and throw them into the shopping cart before they disappear. Sounds easy? Think again.\n\nEach can has a limited time before it vanishes, so you'll need sharp reaction timing, quick decision-making, and precision throws to keep your score climbing. The faster you move, the more cans you save \u2014 and the higher your reward.\n\nPerfect for short bursts of play or intense high-score battles, this game blends arcade-style fun with immersive VR interaction. Whether you're training your speed or just looking for a satisfying tossing experience, it's all about grabbing cans and beating the clock!\n\n", "short_description": "est your reflexes in this fast-paced VR challenge!\nGrab falling cans and toss them into the shopping cart before they vanish. Sharpen your reaction time, aim quickly, and score big before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/cancraze/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc.", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24491955153735570"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISH
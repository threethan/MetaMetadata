ukvr", "autodriver"], "long_description": "\ud83d\ude95 I Am TukTuk Driver VR \u2013 Your Journey Starts Here!\n\nStep into the driver\u2019s seat and experience the exciting life of a tuk-tuk driver in virtual reality! I Am TukTuk Driver VR puts you behind the wheel for an immersive driving experience where every journey is in your hands.\n\nDrive your tuk-tuk through lively streets, navigate roads and traffic, complete driving tasks, and experience what it feels like to work as a real tuk-tuk driver. Use your driving skills to control the vehicle, follow routes, and safely reach your destinations.\n\n\ud83e\udd7d Immersive VR Driving\nExperience tuk-tuk driving from an engaging first-person VR perspective. Look around your environment and feel connected to the road as you drive.\n\n\ud83d\udefa Drive a Tuk-Tuk\nTake control of a classic three-wheeled vehicle and enjoy a unique driving experience unlike traditional car racing games.\n\n\ud83c\udfd9\ufe0f Explore the Streets\nTravel through detailed environments, navigate roads, and experience the atmosphere of busy city driving.\n\n\ud83c\udfaf Complete Driving Tasks\nTake on different driving challenges and missions as you work your way through the world of a tuk-tuk driver.\n\n\ud83d\udea6 Drive Carefully\nControl your speed, navigate traffic, follow the road, and improve your driving skills as you progress.\n\nPre-order I Am TukTuk Driver VR and get ready to start your virtual tuk-tuk driving adventure on Meta Quest!\n", "short_description": "Get behind the wheel of a tuk-tuk in an immersive VR driving experience! Explore the streets, navigate traffic, pick up passengers, and experience the life of a tuk-tuk driver.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vision-edge-studio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vision Edge Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vision-edge-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1386609561182916"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1743631203419505"}, {"status": "PUBLISHED", "id": "1412622377669559"}]}, "baseline_offer": {"id": "1412622377669559"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792515600, "status": "PUBLISHED", "id": "1412622377669559"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1390698157440723", "version": "1.0"}, "id": "1656570779320674", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1386609557849583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1390698157440723"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1656570779320674"}]}, "change_log": null, "created_date": 1790586508, "id": "1390698157440723", "version": "1.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBi
2", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595119480_1413640384213485_7411439912147923807_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCHrfCecsXoQ7kNvwHiMfj9&_nc_oc=Adqy5JxszrHZlWp-J6PnJm4CnR0hdYQu2WP8KaonzgEHmoaiLckl_fWg_UAHELQPpjk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbtTP9W4MU3-q9LqYtvT5L6fQdJwRRSVYSIJZx96sV5A&oe=6AF9DB07"}, {"file_name": "6q.png", "id": "2536375746846237", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/596149727_2536375750179570_1414117255166694551_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnBrdaO38FkQ7kNvwFjD-ft&_nc_oc=AdpceVzd8-cVgcdhvse1v7yTaT-WkGHPlsX8Mws_Tu_kzQtGTPpg05bOmbVv-5Lidsk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlGgv4jUxgD1TYUGApy5kQ-yG5WSX-OvR2jFTeMQUuDw&oe=6AF9E1C6"}, {"file_name": "3q.png", "id": "2283335679086459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604317775_2283335682419792_7453050053891971758_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J16NSECN-WYQ7kNvwFPDwQL&_nc_oc=AdplWuD3hXO4maJluPakHrIut8UEUeyeGPQ2xkqaVrOs4HHmCPaO-HfR9yG1svBBWwQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQPt5qyRDStNll_Mu9WcBMVX0-BPdYtvrfqirXv5HFqg&oe=6AF9EB19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am TukTuk Driver VR", "keywords": ["tuktukdriver", "tuktukgame", "tuktukvr", "autodriver"], "long_description": "\ud83d\ude95 I Am TukTuk Driver VR \u2013 Your Journey Starts Here!\n\nStep into the driver\u2019s seat and experience the exciting life of a tuk-tuk driver in virtual reality! I Am TukTuk Driver VR puts you behind the wheel for an immersive driving experience where every journey is in your hands.\n\nDrive your tuk-tuk through lively streets, navigate roads and traffic, complete driving tasks, and experience what it feels like to work as a real tuk-tuk driver. Use your driving skills to control the vehicle, follow routes, and safely reach your destinations.\n\n\ud83e\udd7d Immersive VR Driving\nExperience tuk-tuk driving from an engaging first-person VR perspective. Look around your environment and feel connected to the road as you drive.\n\n\ud83d\udefa Drive a Tuk-Tuk\nTake control of a classic three-wheeled vehicle and enjoy a unique driving experience unlike traditional car racing games.\n\n\ud83c\udfd9\ufe0f Explore the Streets\nTravel through detailed environments, navigate roads, and experience the atmosphere of busy city driving.\n\n\ud83c\udfaf Complete Driving Tasks\nTake on different driving challenges and missions as you work your way through the world of a tuk-tuk driver.\n\n\ud83d\udea6 Drive Carefully\nControl your speed, navigate traffic, follow the road, and improve your driving skills as you progress.\n\nPre-order I Am TukTuk Driver VR and get ready to start your virtual tuk-tuk driving adventure on Meta Quest!\n", "short_description": "Get behind the wheel of a tuk-tuk in an immersive VR driving experience! Explore the streets, navigate traffic, pick up passengers, and experience the life of a tuk-tuk driver.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vision-edge-studio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vision Edge Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vision-edge-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "support
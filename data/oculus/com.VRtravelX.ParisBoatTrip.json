g", "id": "1306036203419027", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65402154_1306036206752360_6483680572337974199_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dYmiGGZ83AQ7kNvwFtjNfN&_nc_oc=AdnLd4Ifj255i1bdk_VJwEJ_RpBV3jPIB5sqPmlXc_LY3YKEsIl2iOTdVC1e5IAPJD8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs_Zn4l-fZuGjmhrcn39OFD1nU2DID79t2l7qAjKGwCHA&oe=69A44E28"}, {"file_name": "s1.png", "id": "894478868668585", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003268_894478872001918_7895451418393199292_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIV63JV5ekIQ7kNvwHd0DIh&_nc_oc=Adn_KpXpzNKK95J2BvvQfKi7uT96dhviv7ntcFPFG1VWoV1q4YFqFhtg1o0xFhOy5jc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftL23_27cxYaL454NN2ydXvpvhnj4QjotK4PzJ8vxEr4w&oe=69A42127"}, {"file_name": "s5.png", "id": "1101592570745455", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86658875_1101592577412121_1626027991741629959_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pI55NpfXZ_IQ7kNvwG8WufS&_nc_oc=AdkYwxAqzvXrh_ibc2A0ZQ8tYYWsMc9SCaQlMmWR1Lx-VE4TRTtJAa3MT-I0gOVG-GY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuvoIQmoNCVyRgwhY-mCtn5g1XbFj10HZnhgyNNUlGiDg&oe=69A42B2A"}, {"file_name": "s7.png", "id": "209819862179919", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035381_209819865513252_1363434148136089389_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lGTYDXby5cQ7kNvwHAeBWr&_nc_oc=AdkcuYelHalPe3va3HpC-M_RjyAxm0Ij_6FnnyLqsWqM_X6s8QpiVEMoBkGd8xfEEq8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuSCqKNLq8DSF1BAwQaRYtLA6GdKWKshjQhTmfpH9thng&oe=69A4461B"}, {"file_name": "s4.png", "id": "677574154261218", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75416834_677574160927884_8143487851179554974_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tow1O8UWpiQQ7kNvwFfO9Qz&_nc_oc=Adnau05ZpAGQSMNzfQc414yduBaP3drPfPz6Ajl0U32SMWILxmbb_DjQcIx_p3nA3xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvaZuPIJ8R5tXeiRvz0vT1LUuIBVHHpB7mJIW4r68ZeVg&oe=69A433D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paris Boat Trip", "keywords": [], "long_description": "Step into a world of unparalleled beauty and history with our immersive VR experience, taking you from the gothic grandeur of Notre-Dame Cathedral to the iconic Eiffel Tower. Begin your journey in the heart of Paris, at the awe-inspiring Notre-Dame, a testament to centuries of architectural brilliance. As you virtually set sail along the Seine, the lifeblood of Paris, you'll be captivated by the exquisite blend of modern vibrancy and timeless elegance that defines the city.\n\nMarvel at the intricate details of historic bridges arching gracefully over the river, each with its own story to tell. Witness the lively Parisian streets, bustling with artists, cafes, and the melody of French chansons. Your journey through these enchanting riverscapes leads you to the ultimate symbol of Parisian romance and innovation \u2013 the Eiffel Tower. Standing tall against the Paris skyline, it offers breathtaking views that have mesmerized visitors for generations.\n\nAlong the way, discover hidden courtyards, charming riverbanks, and glimpses of daily Parisian life that capture the true essence of the city. As the journey unfolds, historical narratives and cultural insights enrich your experience, making each moment more memorable.\n\nThis VR tour is not just a journey through places, but a passage through time, art, and the soul of Paris. Engage with the city's illustrious past, vibrant present, and promising future. An adventure awaits that's as educational as it is enchanting.\n#Paris #VRtravelX", "short_description": "Embark on a mesmerizing VR boat ride starting at the historic Notre-Dame Cathedral, gliding along the scenic banks of the Seine to the towering Eiffel Tower. Discover hidden gems of Paris on this unique journey, experience the vibrant Parisian culture, and enjoy breathtaking views. Each moment of this virtual tour is a sensory feast, filled with history, beauty, and the irresistible charm of Paris."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Paris-Boat-Trip", "developer_terms_of_service_url": null, "publisher_name": "VRTravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6968530753224454"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "907483711859850"}, {"status": "PUBLISHED", "id": "885899073955418"}, {"status": "PUBLISHED", "id": "25272319829092896"}, {"status": "PUBLISHED", "id": "829660929423852"}, {"status": "PUBLISHED", "id": "1149787377044438"}, {"status": "PUBLISHED", "id": "759045859781383"}, {"status": "PUBLISHED", "id": "9602327486477830"}, {"status": "PUBLISHED", "id": "1655419482039529"}, {"status": "PUBLISHED", "id": "1682844855616035"}, {"status": "PUBLISHED", "id": "273722159013360"}]}, "baseline_offer": {"id": "273722159013360"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "907483711859850"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9145107795566728", "version": "1.8"}, "id": "2053809658317909", "channel_name": "LIVE"}]}, "is_for_oculus_keys_o
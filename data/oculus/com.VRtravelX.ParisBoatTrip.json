hlnow1-DMe93nTHiHClpGFZElX0Nl4tDxBs2M99g&oe=6A3A911B"}, {"file_name": "s4.png", "id": "677574154261218", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75416834_677574160927884_8143487851179554974_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KETtyAO-MAEQ7kNvwESPHZr&_nc_oc=AdpUrsdfuIZ7jF0cl49gjfUgKJsnOgsy1vXbAAp7w6SjPuU5KdAisIsZpXCo89Qhyrk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Oclsr4jG198aiG9PW0nWdmpzhFDFAwTjv4wDA5FJ1mQ&oe=6A3AB719"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paris Boat Trip", "keywords": [], "long_description": "Step into a world of unparalleled beauty and history with our immersive VR experience, taking you from the gothic grandeur of Notre-Dame Cathedral to the iconic Eiffel Tower. Begin your journey in the heart of Paris, at the awe-inspiring Notre-Dame, a testament to centuries of architectural brilliance. As you virtually set sail along the Seine, the lifeblood of Paris, you'll be captivated by the exquisite blend of modern vibrancy and timeless elegance that defines the city.\n\nMarvel at the intricate details of historic bridges arching gracefully over the river, each with its own story to tell. Witness the lively Parisian streets, bustling with artists, cafes, and the melody of French chansons. Your journey through these enchanting riverscapes leads you to the ultimate symbol of Parisian romance and innovation \u2013 the Eiffel Tower. Standing tall against the Paris skyline, it offers breathtaking views that have mesmerized visitors for generations.\n\nAlong the way, discover hidden courtyards, charming riverbanks, and glimpses of daily Parisian life that capture the true essence of the city. As the journey unfolds, historical narratives and cultural insights enrich your experience, making each moment more memorable.\n\nThis VR tour is not just a journey through places, but a passage through time, art, and the soul of Paris. Engage with the city's illustrious past, vibrant present, and promising future. An adventure awaits that's as educational as it is enchanting.\n#Paris #VRtravelX", "short_description": "Embark on a mesmerizing VR boat ride starting at the historic Notre-Dame Cathedral, gliding along the scenic banks of the Seine to the towering Eiffel Tower. Discover hidden gems of Paris on this unique journey, experience the vibrant Parisian culture, and enjoy breathtaking views. Each moment of this virtual tour is a sensory feast, filled with history, beauty, and the irresistible charm of Paris."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Paris-Boat-Trip", "developer_terms_of_service_url": null, "publisher_name": "VRTravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6968530753224454"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "4101679943456954"}, {"status": "PUBLISHED", "id": "25961491473500207"}, {"status": "PUBLISHED", "id": "907483711859850"}, {"status": "PUBLISHED", "id": "885899073955418"}, {"status": "PUBLISHED", "id": "25272319829092896"}, {"status": "PUBLISHED", "id": "829660929423852"}, {"status": "PUBLISHED", "id": "1149787377044438"}, {"status": "PUBLISHED", "id": "759045859781383"}, {"status": "PUBLISHED", "id": "9602327486477830"}, {"status": "PUBLISHED", "id": "16554194820
A0Mu0cjhBWD2NQGhk1sxvU-CWAWNNwpv8iyTWdelcr2gnq6WpLIpsv1PETo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSYlFjfvfpzAZ-u_FPFtEmaavomv-1apn7C5Q_isVG2Q&oe=6AB67496"}, {"file_name": "Screenshot 2025-12-17 040342.png", "id": "1816382359011480", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619187_1816382362344813_3310801633175630845_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-GC63d9lhgQ7kNvwFOJ3eX&_nc_oc=AdqLliu9phGU9Sf8iTeQm1xMkYaqIs3CxsU2C6lMFCRPjV4BQ4CfdKWt9Iksh34Wexo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgsg5j_Qw5GIt4ePv1FjLEjRR4-OHdkWTZZJSleb7qCw&oe=6AB69165"}, {"file_name": "Screenshot 2025-12-17 040256.png", "id": "3016464425221544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620875_3016464428554877_8129239019570234968_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTbyQd0a8_IQ7kNvwE1aNr0&_nc_oc=AdoiHc0b0rCm4huPFpjuuRVH_Y8Y_f_4TvQ_52O2oCx6MizqeJr2F3HR-sCp9sORAMI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMuR3HrpNWg_Auox_7I8S5SNljKCAu-DHfVAv6-OeJrg&oe=6AB67173"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Christmas Party", "keywords": ["Christmas", "holiday", "Party", "friend", "scenery"], "long_description": "Invite your friends to enter this VR space specially crafted for Christmas. Together, you\u2019ll find yourselves in a lifelike, intricately designed Christmas-themed house\u2014from the spruce tree laden with ornaments to the cozy corners adorned with red velvet rugs, every detail captures the spirit of the season. You can unwind and soak in the gentle indoor lighting, watch the snowfall outside, feel the steady warmth of the fireplace, and admire the countless twinkling little decorations scattered throughout. There are no objectives or quests here\u2014everyone is free to leisurely enjoy each other\u2019s company or even play and frolic to their heart\u2019s content.", "short_description": "In this VR game, you and your friends can step into a warm and cozy Christmas cabin. There are no tasks or challenges\u2014simply relax and enjoy the carefully designed festive decorations in the room, linger by the window as snow falls outside, or quietly bask in the flickering embers of the fireplace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2f8cabb3-995b-4197-a44c-b1d05e6ce76e", "developer_terms_of_service_url": null, "publisher_name": "unity", "support_website_url": null, "website_url": "http://game.lvcn.net/ChristmasParty", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25326179343702973"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619187_1736911620335759_2078412514275036185_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UF_ejEpe6nwQ7kNvwHOa_mk&_nc_oc=Adq-Lnkxvxt5zeBLeMSKtWQKwbsqHK-0QqPuiG1dH_thudgW5Gb38ijaKwY-F_dXw7A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjc-geLZNj_ZYv_FtjUQn5By3u5OdUtgi1DXZZdPv8fw&oe=6AB66BA4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Christmas Party", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"top
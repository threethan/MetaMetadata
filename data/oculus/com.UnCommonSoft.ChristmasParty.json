-17 040723.png", "id": "864316243261103", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_864316246594436_317955758068270783_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2vlR_3JD8AQ7kNvwEJ_Mu8&_nc_oc=AdqHDNxRNpR_kA03pbFmdun7fHCXUSTPaM62oS1_GhkYCHwN94iCTg2lZkSkZLBx9DQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuIKBnUulhN1MBo-HK3TPK1kqYliiIpwmH4EXVCKEylg&oe=6A5CCE96"}, {"file_name": "Screenshot 2025-12-17 040342.png", "id": "1816382359011480", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619187_1816382362344813_3310801633175630845_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmskRf7JCQIQ7kNvwFODOFS&_nc_oc=Adqg7al_hgRCRuD3pNQCEhs1w9z2LCxm3GO0PJTx2jpbkt6B0ryhzOWwJXLW1cQmb1w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxMxCIh7utxDmHhbMEJNGg43Wpd4v2pYZGhgVdRzq9hg&oe=6A5CB325"}, {"file_name": "Screenshot 2025-12-17 040256.png", "id": "3016464425221544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620875_3016464428554877_8129239019570234968_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wl657Fot2AQ7kNvwF_PHcD&_nc_oc=AdoPMom3cvgYG_mY009AqIwdE3NyLgTiJjmpygjsPAtYTyhZDzMsMtcMMlgphX_1-f4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF_zgYXjo3DI1WsgwGBII1xZMBn-XtgI8GwTFw1Oh-kA&oe=6A5CCB73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Christmas Party", "keywords": ["Christmas", "holiday", "Party", "friend", "scenery"], "long_description": "Invite your friends to enter this VR space specially crafted for Christmas. Together, you\u2019ll find yourselves in a lifelike, intricately designed Christmas-themed house\u2014from the spruce tree laden with ornaments to the cozy corners adorned with red velvet rugs, every detail captures the spirit of the season. You can unwind and soak in the gentle indoor lighting, watch the snowfall outside, feel the steady warmth of the fireplace, and admire the countless twinkling little decorations scattered throughout. There are no objectives or quests here\u2014everyone is free to leisurely enjoy each other\u2019s company or even play and frolic to their heart\u2019s content.", "short_description": "In this VR game, you and your friends can step into a warm and cozy Christmas cabin. There are no tasks or challenges\u2014simply relax and enjoy the carefully designed festive decorations in the room, linger by the window as snow falls outside, or quietly bask in the flickering embers of the fireplace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2f8cabb3-995b-4197-a44c-b1d05e6ce76e", "developer_terms_of_service_url": null, "publisher_name": "unity", "support_website_url": null, "website_url": "http://game.lvcn.net/ChristmasParty", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25326179343702973"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1795352921172410"}]}, "baseline_offer": {"id": "1795352921172410"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766076300, "status": "PUBLISHED", "id": "1795352921172410"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25408501715470735", "version": "1.1"}, "id": "8729
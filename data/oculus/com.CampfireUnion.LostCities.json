249_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsW7SwDi4VwQ7kNvwFH3S0N&_nc_oc=Ado5n-0DvufGU4rBPL9HhAA_Mp1vkSEA0qgHdIv9aFp6_HCmweqpx6nIZKt_SzXeFP8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQklWdhDWvZOlmff5_68CRIezaUnhmUA-jiQzM-RPYk7Q&oe=6B099F94"}, {"file_name": "migrated_image.png", "id": "513297639362305", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12522304_1266461480061028_202959778_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4knednzkasQ7kNvwHdGhC4&_nc_oc=Adqqpydl1FlZxJtcLQR_-4_klTb6XZ3_wpkyINDpYPnVVO5oPP_h-XW2GTc7nm7YTS4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjsA_TsxE8C9Bssa_ZzwtY8C3Ws3Y4NjMwmFMQfgQSkw&oe=6B09CE08"}, {"file_name": "migrated_image.png", "id": "266262767714610", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12449015_1560160920981067_1221873216_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFpJbmDyxG4Q7kNvwFRXw02&_nc_oc=AdqqMJWIWIg0oIEIZE7CGamBUUR0PEjRcEdw5qnHIrNkAnLE7eisHPPdy8T9PC4Ym8c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxZGNAGlMjuv4AbiRr6XpmYajIgtMqM49QmI8-9rYFVQ&oe=6B09D161"}, {"file_name": "migrated_image.png", "id": "218869289311120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162745_884626381659278_501911891_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3obYM7W6u8IQ7kNvwG86mNq&_nc_oc=AdoDgenEhmdE1jEoVWUSixuwAVgFBWU90AV05ZTBCVc9hAtXcYCyU9lrBAq3-KIDmKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF1xI6zxm06DsPQ8-CwkvWumr1Vej6eaMcblFZiY0x8A&oe=6B09A254"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Cities", "keywords": ["Card", "Tile", "Strategy", "Casual", "Board"], "long_description": "** NEW: Play Lost Cities together, right from the Oculus Rooms app launcher! **\n\n\"Surprisingly good and a tantalizing hint at future of VR gaming.\"\n- Ars Technica\n\n\"If you are a board game fan and enjoy playing with others, you'll surely find yourself some good times in Lost Cities.\"\n- TwistedReality.tv\n\nHonorable Mention for \"5 Awesome Gear VR Multiplayer Games to Play With Your Friends.\"\n- Upload VR\n\nBased on the award-winning tabletop card game Lost Cities by world-renowned board game designer Reiner Knizia, Lost Cities VR is a two-player strategy game that transports you to unexplored regions and mythical realms. Can you outwit your opponent and make the most profit as you compete to be the first to discover the ancient lost cities?\n\nFeatures:\n\n* Multiplayer\n* VoIP\n* Matchmaking\n* Leaderboards\n* 3 Scenes:\n  - Desert Sands\n  - Himalayan Mountains\n  - Neptune's Realm", "short_description": "Based on the award-winning tabletop card game Lost Cities by world-renowned board game designer Reiner Knizia, Lost Cities VR is a two-player strategy game that transports you to unexplored regions and mythical realms. Can you outwit your opponent and make the most profit as you compete to be the first to discover the ancient lost cities?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lostcitiesvr.com/terms-and-privacy#", "developer_terms_of_service_url": "https://www.lostcitiesvr.com/terms-and-privacy", "publisher_name": "The Campfire Union", "support_website_url": null, "website_url": "https://www.lostcitiesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "su
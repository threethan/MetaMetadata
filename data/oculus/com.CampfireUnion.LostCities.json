0f&oh=00_Af7ve-t9tEMvGvoXDTjSNe20zYapIObm1wSkH9CXR80-DQ&oe=69FDFF14"}, {"file_name": "migrated_image.png", "id": "513297639362305", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12522304_1266461480061028_202959778_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRSWnwegaJ0Q7kNvwFnWlD6&_nc_oc=AdqEu6IuYwCjrpVzo-CiIPUpqKLDHArb79qYeHSh4YGhVRKFd-7g2_WZ0hTQz_s91-k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y21DQV8yIF0x7M9pWUWROjoUXxsPsfc5PGm10LWmlEQ&oe=69FDF548"}, {"file_name": "migrated_image.png", "id": "266262767714610", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12449015_1560160920981067_1221873216_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5oyEbN7glUQ7kNvwEcB0yz&_nc_oc=Adpc9Z0-fPewlKlviF4q4RmfbPEC2m0fNhDpWOI1iqqgTABL5_teDJhwIogqFvJja4Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fbU12ENLKVb6-lT03euaai8fY_VA1zFO3RaFUw_0xBQ&oe=69FDF8A1"}, {"file_name": "migrated_image.png", "id": "218869289311120", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162745_884626381659278_501911891_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8oF91puNi8Q7kNvwGp0J3d&_nc_oc=AdqI1NXIW2hGXMWqpS44P-WEu8rb5DnPlh_e3hBD2CsAAZvWzvoMPfYA8bchdT_KYZ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74ETQqperpNCiq68RxWloEpIw7dsraVVaHfYe529ia1Q&oe=69FE01D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Cities", "keywords": ["Card", "Tile", "Strategy", "Casual", "Board"], "long_description": "** NEW: Play Lost Cities together, right from the Oculus Rooms app launcher! **\n\n\"Surprisingly good and a tantalizing hint at future of VR gaming.\"\n- Ars Technica\n\n\"If you are a board game fan and enjoy playing with others, you'll surely find yourself some good times in Lost Cities.\"\n- TwistedReality.tv\n\nHonorable Mention for \"5 Awesome Gear VR Multiplayer Games to Play With Your Friends.\"\n- Upload VR\n\nBased on the award-winning tabletop card game Lost Cities by world-renowned board game designer Reiner Knizia, Lost Cities VR is a two-player strategy game that transports you to unexplored regions and mythical realms. Can you outwit your opponent and make the most profit as you compete to be the first to discover the ancient lost cities?\n\nFeatures:\n\n* Multiplayer\n* VoIP\n* Matchmaking\n* Leaderboards\n* 3 Scenes:\n  - Desert Sands\n  - Himalayan Mountains\n  - Neptune's Realm", "short_description": "Based on the award-winning tabletop card game Lost Cities by world-renowned board game designer Reiner Knizia, Lost Cities VR is a two-player strategy game that transports you to unexplored regions and mythical realms. Can you outwit your opponent and make the most profit as you compete to be the first to discover the ancient lost cities?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lostcitiesvr.com/terms-and-privacy#", "developer_terms_of_service_url": "https://www.lostcitiesvr.com/terms-and-privacy", "publisher_name": "The Campfire Union", "support_website_url": null, "website_url": "https://www.lostcitiesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "166908339633896"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974711_227150838228420_1076974482674941952_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7
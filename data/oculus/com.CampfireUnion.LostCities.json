249_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFHTHVcUkrsQ7kNvwGN9Mix&_nc_oc=AdofLKTntnOD0TanwCZrGX9oXssALX3ztMrKxD-zKwB8_Q5J5U-6stgwbAELChKLo9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVq3va5mUBrZTJcSgieCNKc7cV3cyNrAYTnnHg8N8FYDw&oe=6B103714"}, {"file_name": "migrated_image.png", "id": "513297639362305", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522304_1266461480061028_202959778_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrASCg9BkyQQ7kNvwH7Tw0U&_nc_oc=AdoL9L1bClnruetDu7OH5EGu2WfAU-15vLNoLMs3M4jNE9d5RxYuTkQouifFGL5DHhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWlTanbYgHixYT39H6sBxJj3l6CZ1rwRpTgFxcpdad_xg&oe=6B106588"}, {"file_name": "migrated_image.png", "id": "266262767714610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449015_1560160920981067_1221873216_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQgHOHuM8E0Q7kNvwH1miaz&_nc_oc=AdpGKNTzf8uPEmkgAqPPrEI_q5m1kwzrFwG81h5LnnlfDPlmBjyAJEygxiphH-H-XtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUthT8YqY8HwiqY6SXOTITabFSSjGOTYVtap-kS2idOZA&oe=6B1068E1"}, {"file_name": "migrated_image.png", "id": "218869289311120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162745_884626381659278_501911891_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFGk75ZZ8lMQ7kNvwHp0q8O&_nc_oc=AdpFG1Yd3mN2fC9HkmwEfyvZl_XJRS2bgn-78XhOK3jDnt1Xw2MD6imO6BgSqjnNUE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVVdF1Cim6ofMl_vgsJqmnNyQyxMy25PxyVwvF9-x5U4w&oe=6B1039D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Cities", "keywords": ["Card", "Tile", "Strategy", "Casual", "Board"], "long_description": "** NEW: Play Lost Cities together, right from the Oculus Rooms app launcher! **\n\n\"Surprisingly good and a tantalizing hint at future of VR gaming.\"\n- Ars Technica\n\n\"If you are a board game fan and enjoy playing with others, you'll surely find yourself some good times in Lost Cities.\"\n- TwistedReality.tv\n\nHonorable Mention for \"5 Awesome Gear VR Multiplayer Games to Play With Your Friends.\"\n- Upload VR\n\nBased on the award-winning tabletop card game Lost Cities by world-renowned board game designer Reiner Knizia, Lost Cities VR is a two-player strategy game that transports you to unexplored regions and mythical realms. Can you outwit your opponent and make the most profit as you compete to be the first to discover the ancient lost cities?\n\nFeatures:\n\n* Multiplayer\n* VoIP\n* Matchmaking\n* Leaderboards\n* 3 Scenes:\n  - Desert Sands\n  - Himalayan Mountains\n  - Neptune's Realm", "short_description": "Based on the award-winning tabletop card game Lost Cities by world-renowned board game designer Reiner Knizia, Lost Cities VR is a two-player strategy game that transports you to unexplored regions and mythical realms. Can you outwit your opponent and make the most profit as you compete to be the first to discover the ancient lost cities?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lostcitiesvr.com/terms-and-privacy#", "developer_terms_of_service_url": "https://www.lostcitiesvr.com/terms-and-privacy", "publisher_name": "The Campfire Union", "support_website_url": null, "website_url": "https://www.lostcitiesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "su
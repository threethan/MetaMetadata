249_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzYXzKLtPrkQ7kNvwG3VYkd&_nc_oc=Adrq-p6wrdZmhaRQyDhFgRo-uzoXkZn_PjOXDCDnrEstjeKwwXEvRrrAQO4V7-pFOlA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_N3j8dzDdFiK_T2pG9FBHjtLiCsu1tvH5l5t7cmEDXg&oe=6B0DCC54"}, {"file_name": "migrated_image.png", "id": "513297639362305", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522304_1266461480061028_202959778_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrASCg9BkyQQ7kNvwHFBe2O&_nc_oc=AdrUL_ew5nie5ixZwv3wwawmxs5R3TcnYib7-AZnxyKX5gClo40PR7G25SHkVnZYsz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-C-xRljQshYu7U8iR6D8jV6B7VP465GaKwRDapBg9jQ&oe=6B0DC288"}, {"file_name": "migrated_image.png", "id": "266262767714610", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449015_1560160920981067_1221873216_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5SynaGcspIQ7kNvwFX2mQf&_nc_oc=AdqPCsiwuAWAvdfwtRFzXcgn5iik4j0-tiOgMaw5mHfjowYTd8wsoW_7vw66XHbYh3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQS-z03AV6WC3lCPZM1xOhZCYAgJIjEE_PJaxWX73dnPA&oe=6B0DC5E1"}, {"file_name": "migrated_image.png", "id": "218869289311120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162745_884626381659278_501911891_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFGk75ZZ8lMQ7kNvwHNvcyp&_nc_oc=AdolpJKcepH56qL7eXxFGsl22D2D-pO6wvwtopskAJFNW4m4nvEBl4ss-Milk0iKz1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfEAWP4zjjuzgUM4RH07Mfrms6NowWeaE6owJentw7Ow&oe=6B0DCF14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Cities", "keywords": ["Card", "Tile", "Strategy", "Casual", "Board"], "long_description": "** NEW: Play Lost Cities together, right from the Oculus Rooms app launcher! **\n\n\"Surprisingly good and a tantalizing hint at future of VR gaming.\"\n- Ars Technica\n\n\"If you are a board game fan and enjoy playing with others, you'll surely find yourself some good times in Lost Cities.\"\n- TwistedReality.tv\n\nHonorable Mention for \"5 Awesome Gear VR Multiplayer Games to Play With Your Friends.\"\n- Upload VR\n\nBased on the award-winning tabletop card game Lost Cities by world-renowned board game designer Reiner Knizia, Lost Cities VR is a two-player strategy game that transports you to unexplored regions and mythical realms. Can you outwit your opponent and make the most profit as you compete to be the first to discover the ancient lost cities?\n\nFeatures:\n\n* Multiplayer\n* VoIP\n* Matchmaking\n* Leaderboards\n* 3 Scenes:\n  - Desert Sands\n  - Himalayan Mountains\n  - Neptune's Realm", "short_description": "Based on the award-winning tabletop card game Lost Cities by world-renowned board game designer Reiner Knizia, Lost Cities VR is a two-player strategy game that transports you to unexplored regions and mythical realms. Can you outwit your opponent and make the most profit as you compete to be the first to discover the ancient lost cities?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lostcitiesvr.com/terms-and-privacy#", "developer_terms_of_service_url": "https://www.lostcitiesvr.com/terms-and-privacy", "publisher_name": "The Campfire Union", "support_website_url": null, "website_url": "https://www.lostcitiesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "su
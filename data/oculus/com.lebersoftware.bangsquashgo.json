Yw&_nc_oc=AdowYpacHxfSi-FKTI-5LbLNHipQNlXU2Gznd2-cjDxrRS316D77_9CWaVykUtNiHe4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VXEVeZkOBkSf1AnLg-Zp-mYWdHZSDHWlCrQOlLzTfNw&oe=6A39584D"}, {"file_name": "inGame3.png", "id": "637495657186705", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75289720_637495660520038_1470567164424208805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaQEPcFMFe4Q7kNvwHH4_MI&_nc_oc=Adovi2JlxmsmK4_aExsK6b-U8UclV-xPCca08YRIH8d-WiETam-UyatYWJDcq2iV1Co&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f0K5MIQ0IDJvINo8Dv96SnLsh518zO07iS_UecAkorA&oe=6A393C36"}, {"file_name": "inGame5.png", "id": "325064548907262", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75488381_325064552240595_230086922070231217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1q7PraoJ4gQ7kNvwHULhue&_nc_oc=Adqun6td00NQi1YybwqIO77TVAkuCJyG-laN61EylxTRYZJN0TT-nr_Q4It84rPMRy4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s7kr4doYjmxoJM0iaasqkuZGemSoUR4TsR5VRrY7yBA&oe=6A3956D2"}, {"file_name": "inGame2.png", "id": "313720009870365", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57575352_313720013203698_4468974874963137331_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fk1Nea5PAEQ7kNvwH23ldj&_nc_oc=Adr9hK9-n26z4MIL7XdOLTZlCcrZbRpIKJxvg9QQ-B8M_jwu-8GJDvX7X1ZH6NgEX2c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98qnZBHbzzamiSDPKwlzpPckopVjEJ1C-0TYZCcqro3g&oe=6A394D4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "777653299736360", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75367588_777653303069693_993849786349685831_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o30SpB1cakQ7kNvwEcesJV&_nc_oc=AdrbRgmGQg-mRGZPu3Cw8jzmS5b5KQBg1g0f_6Z1Cxmp3dpJHQ-9rLWTXSIP11YF3ME&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v4f_PVNSusZUpz60opdDUVRddz3EIaqACcHU7DcSd9A&oe=6A394C12"}, "display_name": "BangSquash", "keywords": ["breakout", "pong", "ball", "arcade", "squash"], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": "Leber Software", "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-privacy-policy/", "developer_terms_of_service_url": "http://www.lebersoftware.hu/", "publisher_name": "Leber Software", "support_website_url": "http://www.lebersoftware.hu/", "website_url": "https://lebersoftware.hu/bang-squash/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
jj&_nc_oc=AdrDzcklMA6aX9wsJVptGmfplrhWgfC1CnmJs1lt8okCwXqI4H7MtOMSvFdbNw8PXJ4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_tolgBxXxIc4pFNG1QJw-awY0ZAgF_ThFc6oKTxrbKQ&oe=6AAEADCD"}, {"file_name": "inGame3.png", "id": "637495657186705", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75289720_637495660520038_1470567164424208805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUZGX__WpUcQ7kNvwH7UuNu&_nc_oc=AdpKL5QCo9fL4zDbkMvUxYBCFlWPw59gBY9-0G2PFFI7GUAoP-9CFF_E7dL-2DNDpzA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZni7JXrpBaquI6gY2xg4t6WdHJgBiXSQF36mkf3LWKg&oe=6AAE91B6"}, {"file_name": "inGame5.png", "id": "325064548907262", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75488381_325064552240595_230086922070231217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYSmSUvq8gYQ7kNvwGb6r5i&_nc_oc=AdoYaOZjslIUG6PORjxHR6NqAKxODHgd1wgk3VvgAh0Idmu7mvkII1kP1BqzXdOUMN8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZVLuzE2ED70eTeEehhe-zmZMM-KFXac1xOyyrrilEJw&oe=6AAEAC52"}, {"file_name": "inGame2.png", "id": "313720009870365", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57575352_313720013203698_4468974874963137331_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trCNPDgkZD4Q7kNvwF81p2y&_nc_oc=AdoyM4vi3weZiWslrYqPnX57xx1Ek5xdYNNnho4Espto2gQZGza1zdf4gM_kir5vK0c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGBB2jy7TYFt5gTW0IdFWoVQyGY1gw737SOGKVBVYhWg&oe=6AAEA2CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "777653299736360", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75367588_777653303069693_993849786349685831_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvjVg2aZ1ZgQ7kNvwHNb7eV&_nc_oc=AdqY8JjlIg5N1lULfbOoQdT2Mmj0ITOsxywbTniDvreY-bLBLhQR29J0PdZIptZRRS0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKC7zmyKaTPGzIM3KE-ago2vkACrMPekwqSaV-Mh5MRw&oe=6AAEA192"}, "display_name": "BangSquash", "keywords": ["breakout", "pong", "ball", "arcade", "squash"], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": "Leber Software", "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-privacy-policy/", "developer_terms_of_service_url": "http://www.lebersoftware.hu/", "publisher_name": "Leber Software", "support_website_url": "http://www.lebersoftware.hu/", "website_url": "https://lebersoftware.hu/bang-squash/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
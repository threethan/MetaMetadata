QsJQ3ohjKGETBG1lFNYPcrqhb25WOeTUZmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfykJZDXx82fot4IV4aVXSgeXm3fFpCU_u8_VT_VB-z69A&oe=69B0040D"}, {"file_name": "inGame3.png", "id": "637495657186705", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75289720_637495660520038_1470567164424208805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReXfjQmewJQQ7kNvwFgdcEn&_nc_oc=AdmEp0O5_1oVdfa-iS2-5LOTC0oN9A4kgOanLABWPsHqhisLO5Sam4STWr7fj2HgLAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8qW_P4Ob6zFmUdz-aup3w8C-kswE36dT-_nV43T7OcA&oe=69B02036"}, {"file_name": "inGame5.png", "id": "325064548907262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488381_325064552240595_230086922070231217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvAAGa_CclEQ7kNvwHKOeTy&_nc_oc=AdkGZPKn8JQzrG-i3VN2dcU4vrtfyVe7jIUzMRmRsG8Qa3M290iD1VLrmdd-gtG6Ty4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2UsUryjyOK-BrwNwE4GGOghNxNRuQqg1E4we0Xtz6Tg&oe=69B00292"}, {"file_name": "inGame2.png", "id": "313720009870365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575352_313720013203698_4468974874963137331_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VjPlaklb7IQ7kNvwHDRWvS&_nc_oc=Admh3qHifS_M7V_Q3u4hW8bRV0cxhZfyeklHSHRufu0DcFs_K7A84bIHgOuQ4Ma2epo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQPfp81-J_gVC-k62Kd7yRjL8aO6XlIkmQSQKtIxes4Q&oe=69AFF90D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "777653299736360", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75367588_777653303069693_993849786349685831_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRqr_kBSRFQQ7kNvwGed_2c&_nc_oc=Adnepf0JNoasDkh-krj9xx4F6Otb-UR0GLqul2gzdiUCI8wNoRZXTeF6tX8N-Asxe-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcH-Xz997h0IrPTm8mLkwTWOnFiN0qSU6Cvs-aatjC2g&oe=69AFF7D2"}, "display_name": "BangSquash", "keywords": ["breakout", "pong", "ball", "arcade", "squash"], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": "Leber Software", "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-privacy-policy/", "developer_terms_of_service_url": "http://www.lebersoftware.hu/", "publisher_name": "Leber Software", "support_website_url": "http://www.lebersoftware.hu/", "website_url": "https://lebersoftware.hu/bang-squash/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_pla
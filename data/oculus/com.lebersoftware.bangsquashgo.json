E_gegBzyAyvWDHCkOSZF1BD6pB1jRKpG5Pc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxd39YC-waGZKg64cOnrhk6RGbigMaqQFUWAGfS6zH_bg&oe=69B2A70D"}, {"file_name": "inGame3.png", "id": "637495657186705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75289720_637495660520038_1470567164424208805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReXfjQmewJQQ7kNvwEmtpds&_nc_oc=AdlQ8aG-o8MPkhGo8i4rLeZVT95tjcjOtPImMLxFJ_T7bpOM3XHbM-1ytcXNv_lUj1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmeS04h9h4EvnuDyl_-LdwHXXQWv9E4hJxyz8PKwQsMA&oe=69B2C336"}, {"file_name": "inGame5.png", "id": "325064548907262", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75488381_325064552240595_230086922070231217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvAAGa_CclEQ7kNvwHqq_1x&_nc_oc=Adn8rwDlB3InRaYXcdX9Aw2hFRHXglI5JVjzuk0l3VS4C_UbI0FWFdJxcYA0lvxtMbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxg8e3nzrNrmTeqLLc-cICZ1JX5uqDoN8x22wxzlHTU3A&oe=69B2A592"}, {"file_name": "inGame2.png", "id": "313720009870365", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575352_313720013203698_4468974874963137331_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VjPlaklb7IQ7kNvwF-PEiH&_nc_oc=Adnp4rlrFKPP2wPWpgizuSIGlf37JIy9Jw51pQnmPzoc_t1pvuDFDrtTrNYZ9OUI2uo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIaWpVxik3Gd3L-SIgMzh6NJ7qJgImrFxbC3aixnkGkA&oe=69B29C0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "777653299736360", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75367588_777653303069693_993849786349685831_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRqr_kBSRFQQ7kNvwFRotwg&_nc_oc=Adk_pJrQ0vgg3ZqCTPQJl5pfZ1JqArG-nQ8W6PvQiXe6YLVbALGMxbT3zmvdFbjDtoo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRCtcFWQ1HlusCZRqn_phsIaXdNzv6DfHbG_MoXi4Alw&oe=69B29AD2"}, "display_name": "BangSquash", "keywords": ["breakout", "pong", "ball", "arcade", "squash"], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": "Leber Software", "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-privacy-policy/", "developer_terms_of_service_url": "http://www.lebersoftware.hu/", "publisher_name": "Leber Software", "support_website_url": "http://www.lebersoftware.hu/", "website_url": "https://lebersoftware.hu/bang-squash/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_pla
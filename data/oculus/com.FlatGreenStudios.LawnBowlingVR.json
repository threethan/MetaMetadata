O_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819473_655085297507598_124143361847805389_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mrv6rBwgw-QQ7kNvwEwAxqa&_nc_oc=Ado2KUpB9nuBThnChRxgBpISWVhyej7tArP8KLrnOISJHk5cjqvkWxSnKsXq_IJ1Glw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Bw00-oH6K-APV1rt6iWZmslbewg7woU3ymh1UT6fPA&oe=6A78710E"}]}, "id": "4168297943455743", "locale": "en_US", "screenshots": [{"file_name": "megascreenshot.png", "id": "729576136726519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820619_729576140059852_8716769114727795332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh7Hw8fehukQ7kNvwFvk1_0&_nc_oc=AdoDntbXt23DfPNcRNqtJ9o9m3cBGiOIJskFhNNSF4TFwvw7KhUye5pTa4lwxcCGxpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZKnhJvDgtfx9WkmZXDkSchSas71NqwBNLyx1yCUR3sA&oe=6A7876C5"}, {"file_name": "screenshot3.png", "id": "1123372019679599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819385_1123372023012932_7552980920279852900_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25H9e7uDrlEQ7kNvwH_MUR4&_nc_oc=Adqeapc1nIjVyzH7JvB962n9ECfd5QN7CVj_y31m7kf8CxvwLeCG-iiHbHzJPmj40VE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7C0qR3sex7a8y2Wx3EK7OsQZvI8fN-9BoAmxMJ50r5A&oe=6A788829"}, {"file_name": "screenshot2.png", "id": "1100586671419007", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823427_1100586674752340_7974879799759938152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3JTbhB7IT4Q7kNvwEuyBNe&_nc_oc=AdqvEXOC85CY_IHJcnaeYYnFfrGQjqa6C9yIW-L3vnKDYj9R6BgmZDLDa-aLHKYBPWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV434T1xAVk1-7lTj7x1UwIyjBjbWfBYMGQ_D0t4ymmg&oe=6A78863E"}, {"file_name": "screenshot1.png", "id": "1258496455414508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820652_1258496458747841_372527930410987345_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYrZ2ejPtHYQ7kNvwFDq23o&_nc_oc=AdphbalzuhFaBTGNu7krWSRVp8AeHASBjd-54UmUzrHhuwFRn285OfQm6BHn-uZarg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl1vVIIf80fYav6IGIF06TZOlj27DSyL1wA2gO_Zi7XQ&oe=6A7877ED"}, {"file_name": "screenshot-2.png", "id": "1864836307641632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818900_1864836310974965_748400959475714348_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkMnqQsdMhYQ7kNvwGg6e65&_nc_oc=AdpzwpHhoc0i5dtOyWZW323dCRv_rZ6rTT29hsdPAgd13DwQpdXhaMC_e9pC6D5etJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwe4XnNOyzoKp_YMe_RcaY4SKhwxdP8Wx0Ypux0LgI4w&oe=6A787988"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lawn Bowling VR", "keywords": ["bowling", "bowls", "lawn"], "long_description": "# VR Lawn Bowls \u2013 Step Onto the Green\n\nExperience the sport of **lawn bowls** like never before in immersive **virtual reality**! Perfect your delivery, read the green, and challenge yourself across multiple game modes and skill levels.\n\n# Smarter AI, Bigger Challenges\n\nTake on **five levels of AI difficulty**\u2014from beginner to pro\u2014each offering unique strategies and shot precision. Whether you\u2019re learning or looking for a serious test, there\u2019s always a challenge waiting.\n\n# Game Modes for Every Style\n\nPlay solo or team up in:\n- **Singles** \u2013 One-on-one duels  \n- **Pairs** \u2013 Tactical two-player matches  \n- **Triples** \u2013 Team play with three  \n- **Fours** \u2013 Full four-player strategy  \n\n# Built for Meta Quest\n\nWith intuitive VR controls, realistic physics, and detailed greens, you\u2019ll feel like you're right on the green. Just grab your controllers and bowl.\n\n# Features\n\n- 5 AI difficulty levels (Beginner to Pro)  \n- Singles, Pairs, Triples, and Fours modes  \n- Realistic throwing mechanics  \n- Immersive audio and environments  \n- Designed for Meta Quest headsets\n\nAre you ready to become a VR bowls champion?", "short_description": "Step onto the green and experience the ultimate VR lawn bowls challenge! Compete in singles, pairs, triples, or fours against lifelike AI opponents across five skill levels\u2014from beginner to pro. Precision, strategy, and immersive gameplay await. Are you ready to bowl like a champion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lawn-bowling-vr.vercel.app/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Green Studios", "support_website_url": "https://lawn-bowling-vr.vercel.app/support.html", "website_url": "https://lawn-bowling-vr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25223931967195711"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618472_740199688695065_3451833669888380698_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PxDKWStrKoQ7kNvwFxGyYf&_nc_oc=Adrae8U7Pq_nqOOMemRYhlVYdyXm0FB9ek8uj2O7oCDkQ2GZlciukFoRIqhDT01ZiM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7BcK51_Cq5JREKovTEZBrcJH3Nf5TxubKkGkMkv2JKg&oe=6A789BB3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lawn Bowling VR", "platform": "ANDROID_6DOF", "context_category": {"context_categ
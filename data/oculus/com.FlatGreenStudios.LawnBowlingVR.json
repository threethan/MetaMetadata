MjLAtA&oe=6AFB1D6E"}, {"file_name": "screenshot-2.png", "id": "1864836307641632", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818900_1864836310974965_748400959475714348_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IeaH3-qox4Q7kNvwG-PGuS&_nc_oc=Adrxe0-hPPUrpbxWSOM3HgguFJ9_cgdFDNwS7I2nxFm3NbcV0fU2T21PVV6YY92B8Tc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgdM75BUPEjx2r85kiuv7GmyLD9-uC4gkaU6oAkpbbtw&oe=6AFB3648"}, {"file_name": "screenshot-3.png", "id": "2118277382025340", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821952_2118277388692006_8203953177139914431_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XndXqKK3SdcQ7kNvwGLXBHf&_nc_oc=AdrC6IMY95GknQiX3AtsJr2yZsoKaLmwwB93oOZbpJWh2iFEvL4rVD6PodX47_sTCqE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKQT7lIE5bu1HnOePrK4uWVHRLV51kJK6GculdSGqgsA&oe=6AFB2D4B"}, {"file_name": "screenshot-4.png", "id": "1014672447486038", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821941_1014672450819371_961092602449481116_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bkKWj98F5IQ7kNvwHp3j-q&_nc_oc=AdqJljga2kFtKIuE8jwAlFoVQvZbat1LcWU9BEk7czUZAm6X6sTUDf4VKKZd3BoeWIk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVhnfJHwR10RX4CyG5b6lnhPPnsGgomEn83VrJkyC_1A&oe=6AFB4D44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lawn Bowling VR", "keywords": ["bowling", "bowls", "lawn"], "long_description": "# VR Lawn Bowls \u2013 Step Onto the Green\n\nExperience the sport of **lawn bowls** like never before in immersive **virtual reality**! Perfect your delivery, read the green, and challenge yourself across multiple game modes and skill levels.\n\n---\n\n# Smarter AI, Bigger Challenges\n\nTake on **five levels of AI difficulty**\u2014from beginner to pro\u2014each offering unique strategies and shot precision. Whether you\u2019re learning or looking for a serious test, there\u2019s always a challenge waiting.\n\n---\n\n# Game Modes for Every Style\n\nPlay solo or team up in:\n- **Singles** \u2013 One-on-one duels  \n- **Pairs** \u2013 Tactical two-player matches  \n- **Triples** \u2013 Team play with three  \n- **Fours** \u2013 Full four-player strategy  \n\n---\n\n# Built for Meta Quest\n\nWith intuitive VR controls, realistic physics, and detailed greens, you\u2019ll feel like you're right on the green. Just grab your controllers and bowl.\n\n---\n\n# Features\n\n- 5 AI difficulty levels (Beginner to Pro)  \n- Singles, Pairs, Triples, and Fours modes  \n- Realistic throwing mechanics  \n- Immersive audio and environments  \n- Designed for Meta Quest headsets\n\n---\n\nAre you ready to become a VR bowls champion?\n\n", "short_description": "Step onto the green and experience the ultimate VR lawn bowls challenge! Compete in singles, pairs, triples, or fours against lifelike AI opponents across five skill levels\u2014from beginner to pro. Precision, strategy, and immersive gameplay await. Are you ready to bowl like a champion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lawn-bowling-vr.vercel.app/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Green Studios", "support_website_url": "https://lawn-bowling-vr.vercel.app/support.html", "website_url": "https://lawn-bowling-vr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
scdn.com/v/t64.5771-25/499618938_4334836233421906_4467737824482073946_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkXmhcZRbEgQ7kNvwE34KrS&_nc_oc=Adofx3P4K7olbtPSgITpkHI7NG2PF8NcqN6h-_8ZLfB7hoNUUvTj5xzFUMfmNfRIMmw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LOmnN-jzaEPDDY1CHdUkeEmmdSZllM89NvOb0AmXsgg&oe=6A2C0659"}, {"file_name": "Untitled design (6).png", "id": "1657642805417656", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618938_1657642808750989_6683978429731895125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fK4NwfvRxEQ7kNvwEtrJOE&_nc_oc=AdpD_1DtuQifGgdqi4Ph4DkQ1y7eS3KqBfnBN6KRGJMrNB0E4orW73sFeK5dW0APEfI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3B5kP3mTqzzbd0n8ju1T6oL8tWlb_vKtNEyCDTTMVYQ&oe=6A2C036B"}, {"file_name": "Untitled design (7).png", "id": "1424755272172053", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618103_1424755275505386_6648282306330140990_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHmDpFyK_rwQ7kNvwE0nXha&_nc_oc=AdrxVRsQYbZWPLdKABx1r6u2Ygj3qU1llblhhxAT3iQXw-BSQxQ1Or2Gp9YrfNmPbQw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SWZl6x8du8zfNXcvWmom3xtixYLq9Bh33YcHVID2AUQ&oe=6A2C09A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ModernHorrorsLogo2.png", "id": "939377075128684", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499294644_939377078462017_3474947905839197703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Tpj4g0z4o8Q7kNvwF46frA&_nc_oc=AdorzApwrvAtS8iOGemZcbQI5ESxf8E3lG_0De6n4FuJ-27LZ8Nm6rITR6UYpo_RfsM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O-ixqhlQZHDvPvlWTy9fGySFB4YsBQMO2Aq4VBiNi-Q&oe=6A2C2180"}, "display_name": "Modern Horrors", "keywords": ["Horror", "multiplayer", "analog", "liminal", "backrooms"], "long_description": "If you're easily scared, don't play this game, you'll literally die :)\n\nModern Horrors is a phycological horror game based around the famous analog horror videos across social media.  Play each terrifying level with friends, unlock many unique cosmetics, and uncover secrets that reveal the ball-shattering story that multiplayer games usually don't have.\n\nWHAT'S CURRENTLY IN THE GAME??\nThe first release currently has one level loosely based on Darian Quilloy's terrifying Vita Carnis series, 15 unique cosmetics unlocked through gameplay, and secrets hinting at an underlying story, along with a smooth singleplayer experience and a beta multiplayer one.\n\nWHAT'S TO COME?\nEach future level is planned to be completely unique from the others, each with a separate entity acting different than the last. Cosmetic updates are also promised, and will never be behind a paywall, completely accessible through gameplay. More secrets and side paths will also be added, along with updates to the current level. Obviously, bug fixes and performance updates will be added. It took MONTHS to make the first level, so be patient\ud83d\ude4f\n\nFinally, I would like to shout-out my boys James and Nolan for motivating me to make this game, and my subscribers for giving me great cosmetics ideas and analog horrors \ud83d\udeac\n\nMy dev channel: https://www.youtube.com/@P1xelK1ngStudi0s\nMy game channel: https://www.youtube.com/@P1xelK1ngGam1ng\nMy discord server: https://discord.gg/hnXFcXcF5", "short_description": "Modern Horrors is a multiplayer VR horror game focusing on many well-known analog horror videos across Youtube \ud83d\udc80"}]}, "developer_name": "Pixel King Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1JWYm78lfkrE1DxSbah1b7pPYyyROxNemwbop4J2CCe8", "developer_terms_of_service_url": null, "publisher_name": "Pixel King Studios", "support_website_url": null, "website_url": "https://www.youtube.com/@P1xelK1ngStudi0s", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "con
2306330140990_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QOghUI75koQ7kNvwEep8J1&_nc_oc=AdpLeHXKhJCQi7_kEQ3aRHhVfVCBunynGuXPvSxlEpKtw2pDC5FMEcoJcn8SCfQmXCY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEd2JO4nnHk89rK7JK7VEElShwwLWDF3dMPgXrsNuTjQ&oe=6A870127"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ModernHorrorsLogo2.png", "id": "939377075128684", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499294644_939377078462017_3474947905839197703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiKeyZGYjt8Q7kNvwEcJwvo&_nc_oc=AdrMSY5MKLZXkOBfnhRihRb6q7SAS6LBZxII8uTZ1iZxO5jjpr073JriIlrU-L8ElGw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH5NGx4TEk7JcE1PVS6UKnOHqK63O6XYPVgKrlo6QL1A&oe=6A86E0C0"}, "display_name": "Modern Horrors", "keywords": ["Horror", "multiplayer", "analog", "liminal", "backrooms"], "long_description": "If you're easily scared, don't play this game, you'll literally die :)\n\nModern Horrors is a phycological horror game based around the famous analog horror videos across social media.  Play each terrifying level with friends, unlock many unique cosmetics, and uncover secrets that reveal the ball-shattering story that multiplayer games usually don't have.\n\nWHAT'S CURRENTLY IN THE GAME??\nThe game currently has 2 TERRIFYING levels to play alone or with friends: Vita Carnis (OG analog horror by Darian Quilloy) and The Backrooms. Along with these two levels (totaling around an hour of gameplay for new players), there are plenty of cosmetics earned through gameplay.\n\nWHAT'S TO COME?\nEach future level is planned to be completely unique from the others, each with a separate entity acting different than the last. Cosmetic updates are also promised, and will never be behind a paywall, completely accessible through gameplay. More secrets and side paths will also be added, along with updates to the current levels. Work on this game may progressively slow as I begin a new project, but this will always be a game I'll come back to and work on in my free time.\n\nFinally, I would like to shout-out my boys James and Nolan for motivating me to make this game, and my subscribers for giving me great cosmetics ideas and analog horrors \ud83d\udeac\n\nMy dev channel: https://www.youtube.com/@P1xelK1ngStudi0s\nMy game channel: https://www.youtube.com/@P1xelK1ngGam1ng\nMy discord server: https://discord.gg/hnXFcXcF5", "short_description": "Modern Horrors is a multiplayer VR horror game focusing on many well-known analog horror videos across Youtube \ud83d\udc80"}]}, "developer_name": "Pixel King Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1JWYm78lfkrE1DxSbah1b7pPYyyROxNemwbop4J2CCe8", "developer_terms_of_service_url": null, "publisher_name": "Pixel King Studios", "support_website_url": null, "website_url": "https://www.youtube.com/@P1xelK1ngStudi0s", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "27214912941532010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499628454_1256073086119292_8763101493541723598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwJhr2YbEdYQ7kNvwHKuE8H&_nc_oc=AdrPEUX58DwenSHaaRh9BXxPJUxtwes3HQhEHd5qPpTp_-0mnrxz_0Me4cK755mRY7g&_nc_zt=3&_nc_ht=scontent-atl3-2.ocu
H2wPw&_nc_oc=AdqGcS3idV9wAyILDvfUne0GviOmGul5y95AA1eTeuwDuaBz9VNIFZQgma-C9NjMor8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4g6l4MJSw3acpvLK0Rh27wrnulrPkTW9NAxCWMK6MUQ&oe=6A95CC4B"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNcIemnRzG4Q7kNvwEWYB6p&_nc_oc=AdptoWRAWbvsCrmB80QRlNkR39TWFGSaXqsfL4bLsmDcZmP4PGqD4EuyNr3aVBGDfEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOydF7eD85mHSzkZHVSNMtK5h8yzs6T_9-RWXjEH-fEQ&oe=6A95CDCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaI3wlrY66QQ7kNvwFP0sxS&_nc_oc=AdqTxuObP3GyFVf13AFprftu5rpTksyE3bO8IFiEhIZU2ZxLepc1UU5Tc6c1A84V47w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgUlRSGhO_UOFji1Gi9iNOq8qQt_VS7j7bGsX2vcoR6w&oe=6A95C3E6"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-SG96yEhcgQ7kNvwF6LPQd&_nc_oc=Adp9Oz1tTlfcxRo3lqiXLmkbnHqRr-Z-9SwKyfFQEvEhPOaGtA7fRGXRsci1OY8Hsg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYgYbVQxfTQHRF_ZjdGIE5YZQrUxwbYENtPzUiDnRIsw&oe=6A95B369"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
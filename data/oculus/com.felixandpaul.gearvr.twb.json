KvDvN&_nc_oc=Adoj3g2Y8wSrDBh2Wajg9pyxQ5bjQ37jJ6rts53gjJd3J4Ku8cdY3sz4Uxl0lYz87Tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHZMgWRgN7yFUvNf0S5l6qOBFJWtlX2NJx5AtzL13k1A&oe=6AA8090B"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umaGi-bnEXsQ7kNvwFcDT1m&_nc_oc=Adpi97gc9X7yXI0ZbtKkUDN778fKRa2BgG2AggA7dWSBRcLEaaapL99VnM2wnG-GEuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnfOV60l1n8vzr5Cse3Hej8LiwQPbr5XR3NTZnxkpiXg&oe=6AA80A8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWuDz4OmVHEQ7kNvwFiUpcK&_nc_oc=AdroYso5JL9gZf03PpqpnkC4mI6vhcqBAS-UIp1g9urtDn4xppd8hLWwvCLzGvCWFgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV8EoIOty--If6KcibndIKzCuzjmoAk51XJTx-Yycf1A&oe=6AA800A6"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E27ZPED4oQgQ7kNvwFOrWa3&_nc_oc=Adozl1RMkXyJApZJQf5kpIzbxMPuDoAzQ7OD_JCbmquX5NjmsL_KUuwpPDGoH-LCzxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp3hbDNKIoQSKIGxA8bCNemIHhOPt2IqouxUnPSs5cbg&oe=6AA7F029"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
H0QHB&_nc_oc=AdoyVnYivlUGsogMDoxP8R2Gs3aZl2Nmy7TMwsTA-HyVHUXGpZmTIwC-oWV7Aqju3dw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1kXQrEoA7cL1ry_9zgmvzWnlIVWiwzbqRWmNtP9tjdw&oe=6AE4AE0B"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkxEZMMJOPoQ7kNvwEMOpYJ&_nc_oc=AdoP_biVS--D1nVOtbYeNzYy2hHT1GTaRwiQjbxSfwlFzhDC-i3XxE6IvE2yIQJ9CnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnoRGYKSg7ixQbZJpOgLbm1N8sYKyS6L1ZtEILN91gVw&oe=6AE4AF8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_jQu3nd8WcQ7kNvwHQ0e5d&_nc_oc=Ado1GNMI8Om3yjIgXuWuP-Ndn0c3E6cvPrdptM-VkwKaMv0VufRJ98H83cMP7QFcLOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_BY_2SL45dpT3vTdZs9Mwd9qxl5nEaOPULgMhORQKVg&oe=6AE4A5A6"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzyLFpDZIfgQ7kNvwE9iqLX&_nc_oc=AdoVaV3x9bwU4mg8m60ejqe_3l3TLG6eIevu9P_suwioNSWtmGT7TVMLMpHG6L9HUv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPvHCoqhcGhQvbeX9mUr5hQpPwbEkV8DomIqxRkcLkmA&oe=6AE49529"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
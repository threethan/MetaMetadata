8oJHd&_nc_oc=AdpkpEH8B_adgJ19AvXHSawKKEXHfTn9Ihg0PZEQMcCiKwTcQBPklqqds6WuhLjHyUI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLsPOpL1S97h_7M3UUr_WbicTQPx4leoji1n6PE32_IQ&oe=6A971DCB"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uB74Uq-BEgwQ7kNvwH3yNj4&_nc_oc=AdpJoyDIjvboCtpb7lhHDLz7-pNGnxSQjXRvlGor9PXG5Ib_JBstJAHSmjRKpaWPG-I&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUeR0yyRlXoxmzgh5uPv2amZgv2kVHszhj8xCoLt6wBQ&oe=6A971F4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUj1MJ7S6AcQ7kNvwFG0_7E&_nc_oc=AdpCDz8s_gSCmRBzByHX-rfAuS5BYiPmX_0dpdO_hFBCpmI9x5wq8Hcwdz6h4XJA7oE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHc1yLmP90IEiK-DttPOiUVClHx6WHRsf25bJNd4_B4w&oe=6A974DA6"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-SG96yEhcgQ7kNvwFA77qD&_nc_oc=Adr549IpzngBMSDzucbUg98_UPBGzYbaqTQmfa_6vDwmaMmwiBKW5iIWDy9191EaXII&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELs_VKVD0O-3Eh9AU6gK9p2qxoaIkBNc0Z4ME8MS47-Q&oe=6A973D29"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
x9MyR&_nc_oc=AdoOfc2vwOjKk7CfZ8U4y1pw0PCPwXmCjp4X8ko6-IfZks6-WC7klfiVlXnMONZWUsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOetRUTmCnyhF8bB3x8HS4ZN7zi5-28RrZ3_s3Q5hARnQ&oe=6ADF680B"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc0Ui79cmD8Q7kNvwGIcN8p&_nc_oc=AdqLt5ViT0Iu8RmQB3LQQSQ6LZXIzkO093AJ3KVbXmHVLyqlvFXyIQR6GHjophhpTGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOguNkdsJ6eOZ0DS43aaZtieVECRUjqL2gsmqJ89WiyAQ&oe=6ADF698A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpHa4VEra94Q7kNvwHAHo8Q&_nc_oc=AdqGFFSQBGTET1M5WjGvIPQGUdk-P9WAw0q7IQrpCmlRvpUGBN71ROCmeYFx8W2wNKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXHByg_mUiXIxwA-5OA64wAm66VI1GOr2QGJeVDxY5xw&oe=6ADF5FA6"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lc5daIjCTr8Q7kNvwEHTGna&_nc_oc=AdrdBXP4xCX0tjjem2e_8kNhpuuT0Z-fzqNUNOTuLWchyPrZwR74AaM9zoXBE0GFdiQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-y3aIjy2g6kvYasOp9cLzUbVCqQLwvt2BdaER9aXp6w&oe=6ADF4F29"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
xxMNi&_nc_oc=Adq2a0ec29MDa7HE0COP0SCXu0U4O8iZT7Mr2noRQ45_nSMRuWaj7IsSRb2fe_gwEEg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7cH4NyWFSczOob6hfah_PqwZBxXXb6hA3UW61KqzmHQ&oe=6A71FB8B"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN8kxeJvEK8Q7kNvwFeD9ig&_nc_oc=AdqiPvOq1pU-M1ZXPhNC1Mp6WMLG2kcjvOkDuKevdroeLkV_iYqlLBjMQeIGxcxGzcc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeblRbfzaQjbN1ynKZVkN8ux4O6n28LktaaRt6CdA45g&oe=6A71FD0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIx0cu4PoZ4Q7kNvwF3X4K2&_nc_oc=Adq-LB3itELe7cCAdXIjVCnF3TEQrAheTFl2ke_7OphxfmP-U-nLZtE5MNwMYLfiuaI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0sMSTB_YHjNLHpaitE0iZXUK3AJrfnDJ2sh4shwKhqg&oe=6A71F326"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eTvJ9-0c0cQ7kNvwEA0Cpp&_nc_oc=AdqirJ8s0mByIa_5vC1hFAXcRTJCbehEefCQuhsL4L0zi3t_ino56hD1K4Y0Zng3VNg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtZD91JG1Bsde6FqbNrLBdT2Sk45yM3_os8xLb_nITzA&oe=6A71E2A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
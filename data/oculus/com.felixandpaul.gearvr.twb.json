Q6KUK&_nc_oc=AdpJnCZFP9Iug7gfYP5EZHgkiiHyo3SINXRd7HyU-9aedMeq0R5HfLK_L1mstvEgDtA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtWecYeWW1ExGPgj9QiKvnvLiGX1mOaKSZzoW2iGJDaQ&oe=6ABA7E0B"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAVRO_WvQTEQ7kNvwHvv_2v&_nc_oc=AdpLIUhNZtrwaeneQ82RcsgiKxSlPWDqUGfTfkTMnFZv7H3AQc-WjN440XZPUpfsIY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiBWuvrLPp-UkNgM6xNmDSm6wvjnc2MX0SbfTD8jgjbQ&oe=6ABA7F8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hB0n8OH04IQ7kNvwFSBDM5&_nc_oc=Adpd5_v2C5Foj4JEviImGfOqxVBwlilzBgYg82B_5mCgHyD3L-ENpGd1Yni5Ml6C4yI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHoLxGTXBK_BGojKVtzCef0TJA7wlg-4SIr9qx1DT0-Q&oe=6ABA75A6"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-AOtPsh3IMQ7kNvwGnHg1U&_nc_oc=AdoyICJ5_hX9PverHiPCMCRQVx-btw6qlyogUUjrV5KPuak7yuWKVqr8c39QzEoLRC4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKw3DgY-3MSoOIFm4qe1egwfp3dputpH9PostsTcinUQ&oe=6ABA6529"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
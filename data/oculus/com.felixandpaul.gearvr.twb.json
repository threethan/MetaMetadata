A92aX&_nc_oc=AdrOluxEuXJWeOJ-lXDUPcSUvJx4yI8Zb5OejqrA98vFEuusyho1iQ_sYOLpVJ-YkYM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1L7V1445vrF3Ik4WPNsm-t42ebNnq-g1rFy1KTWLTpUA&oe=69F8B18B"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33TM7GNQyT0Q7kNvwEkXwfK&_nc_oc=AdoMvQaziL8W2Xp96kLm2DjCTH6rw2Azu3Y_QRUjLG1dTceNEmSrlwjhq2eBrTD_ZoE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VzSuqIUIcmhKCf1P2B7DaLVCegIu3pfwffpMbFaqNiQ&oe=69F8B30A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88VR97nv4K0Q7kNvwFpEwHO&_nc_oc=AdqEe3geBWPQHbvwkyLM1ZwFF9Jz2Jvujonc__quAIq4GjCICR6WOkjXrPwnGShYk4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0w0XnALFC7blAABuVt-gddpAsEPiWPdqW_-7CI3r2IQg&oe=69F8A926"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDtvSH0t-8kQ7kNvwGopE28&_nc_oc=AdrVUuSHtc0Z1oT6z6LYYR9lJA9M5TrT1mJhLj_qfMlmxH3sb2_8LjHr3OKJP2hJkuA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04iyFLav1lDUjXo5j1Q32nK3snkpcnUlFpvnRO68P9Bw&oe=69F898A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
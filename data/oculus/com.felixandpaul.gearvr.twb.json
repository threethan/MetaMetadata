ebPz0&_nc_oc=Ado9Al6ZhvCYctuwq5DwhNkOK8LkZH80MTThSeYwULs_3nX6Z7jCr7f1cQYNe8-177I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oN6GJG1GqUxFh6I4uMbJhJAX_hnAM28SJ3shKWknJyA&oe=6A18558B"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Iksr_VWYz4Q7kNvwG4AlRO&_nc_oc=AdrPgU1rAzZaxAnO_C60FDAlq9OMcPdQN1IsBaA8lzgkSN7ph474-qbXWLifkuMYl0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XXUezlFSRiro0px2ofAV1J36VMyDjMFUF8FtHXpf6QQ&oe=6A18570A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vUB9JCfLGUQ7kNvwGi3m9r&_nc_oc=AdrLIemc9EuBL5lCtd9CDG6b_KPHcUzGRnmbImc1uT1OmuuaYOK4FzDwaO3b8dIPT7o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XhbyiDziKtTsR72lW8bUyayLgNjIw10Xbns2S2029GQ&oe=6A184D26"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HamvBPSB-fQQ7kNvwELPQ6Z&_nc_oc=AdpulIoVEVSrpXMYhfiiddBBBKzMuLFucWABz-awv5-rfEbDAgJ9hUtJWiI9nb7dfk0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QdySG1X_80TKfh8LiATMMRMNPHbfQJoWMG5GwXgecSw&oe=6A183CA9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
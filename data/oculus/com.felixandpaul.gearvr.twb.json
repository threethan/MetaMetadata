7kNvwEoj32u&_nc_oc=AdoovLdNUAkpTFQxlbjwQQvSTY3v2qX8r_sVR_BNi1sk3Asy_syK84cgNMIa15PcvrI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mgiDeQZLsMPUdCwJR0_wUNxfMWspQYv02aunzEN3btw&oe=6A22E18B"}, {"file_name": "migrated_image.png", "id": "548259012475995", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982661_291455104904289_1982556500106674176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKXwLV6pBWsQ7kNvwFS3wF2&_nc_oc=AdoFK3XZFV2uZCcSst6H9uD2khVVRXlflo8fZTsMEIUVMKUTjloQFZ7RYsOGjwMSQwQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZfhkGtQw8netgg6ceMmPzZJ7wUC00EgT4zrMxPyL2aw&oe=6A22E30A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/w17Ljp", "id": "548979745613798", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974860_548979748947131_901371776955580416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgdReH0oF6AQ7kNvwEG6_7M&_nc_oc=AdrE30vJKgQvQx-mbK39WRczEUqxM1SFzbfzjrNF8A0VqJv0sNxCBjnvIO6bkr1p2E4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zkqnEQpjK_J5-bHVXlEXABVfl3MVKT8VHJ6TIOMcXaA&oe=6A22D926"}, "display_name": "Traveling While Black", "keywords": ["Travel", "Freedom", "Sundance", "Felix", "Movie"], "long_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities.\n\nAcademy Award winner Roger Ross Williams and Emmy Award-winning Felix & Paul Studios' film transports you to historic Ben's Chili Bowl in Washington DC. The viewer shares an intimate series of moments with several of the patrons of Ben's as they reflect on their experiences of restricted movement and race relations in the U.S. \n\nConfronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to not only remember the past but to learn from it, and facilitate a dialogue about the challenges minority travelers still face today.", "short_description": "Traveling While Black is a cinematic VR experience that immerses the viewer in the long history of restriction of movement for black Americans and the creation of safe spaces in our communities. Visit historic Ben's Chili Bowl and join patrons as they share and reflect on their experiences. Confronting the way we understand and talk about race in America, Traveling While Black highlights the urgent need to facilitate a dialogue about the challenges minority travelers still face today."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6705593606188739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982564_1153230604854159_9010878353791516672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQcrqMSqYGwQ7kNvwFpSNNB&_nc_oc=AdrrBORsEV7U6HOfizXzMfppik_04DyhKFEq3Cmq67Jwbg3aRd9lGiGJr5m69wSFiuU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o2Tkyncy-5DHx5cw_CQL_z8ZUNQqJ2KJ89eQo2B8hjg&oe=6A2300E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fal
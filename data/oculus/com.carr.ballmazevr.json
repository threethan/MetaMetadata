 game:\n*from that game startup just hit \"Load\"\n*from within the game, just hit \"Menu\" - then \"Load\"", "short_description": "Ball Maze Madness is a 3D roller ball game filled with addictive puzzles. Easy to control options - just tilt your device to control the ball. High res graphics and hours of fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ballmazemadness.wordpress.com/privacy-policy/", "developer_terms_of_service_url": "https://ballmazemadness.wordpress.com/terms-of-service/", "publisher_name": "CARR", "support_website_url": null, "website_url": "https://ballmazemadness.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3337171346569179"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162796_239216796558192_7175597506330361856_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8xQUCMZh0IQ7kNvwFGXcze&_nc_oc=AdmiCUj9GdzfN_c_Rbt6-U2gHqwd8DhC6DhDtfhO4ED8MutmiI38r4wW9QtbezUpEiU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlBlM9JMyY8rRM0IwnOSa2DQf0kAEFe8UghTYTzaJJGQ&oe=69AD7C57"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ball Maze VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1495645200, "lastRevision": {"nodes": [{"id": "436854616679282", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applica
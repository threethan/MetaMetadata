5dysaToq3h1XvIzTP_Xwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTBqvffQmrGBKF-vlZ_kBqd47oC9tuosy1cU2VdcOsbA&oe=6AB695F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u97624.png", "id": "1678091066672868", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296543_1678091070006201_591218003740482797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tfxwr5miqLcQ7kNvwH7CGAa&_nc_oc=AdriOkEG8lDsrZBJWKT_0TiTyHv5p_a1Bwh3k7AeeBGTJUqRGyGETioIuY_OasBH2Vg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDZ7gIn_XUaCG8oPR8EitOiMxf38KScrwahfG0CyTi1Q&oe=6AB67110"}, "display_name": "Bamboo Grove", "keywords": ["horror", "scary", "puzzle", "adventure"], "long_description": "You are a hired game tester, brought in to playtest an unfinished VR horror game.  \nAt first, everything seems routine. Then the line between the virtual world and reality begins to blur.\nThe game starts behaving in ways it shouldn\u2019t. \n{1381243190790893}\n{1291001946333927}\nStrange events become impossible to explain, familiar mechanics stop following the rules, and every step draws you deeper into the unknown.\n{1562527094856735}\n{1067667489460726}\nExplore abandoned homes, hidden cellars, sacred shrines, winding forest trails, and long-forgotten temples as you uncover the dark history hidden within the village while surviving terrifying encounters with creatures lurking in the shadows.\n{943286975492985}\n{1063030779656433}\nWill you uncover the truth behind Bamboo Grove, or become part of its forgotten story?", "short_description": "You are a hired game tester sent to playtest an unfinished VR horror game. As reality begins to unravel, explore abandoned homes, hidden shrines, and forgotten temples while surviving terrifying creatures and uncovering the dark truth behind Bamboo Grove."}]}, "developer_name": "LingYouth", "developer_privacy_policy_url": "https://www.ling-v.com/zhulinPrivacy", "developer_terms_of_service
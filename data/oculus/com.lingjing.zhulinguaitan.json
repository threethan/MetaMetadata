", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310831_4156729537916366_962872589422483702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw_AQeRx2vgQ7kNvwHG9Jv0&_nc_oc=AdobYOLGKrLWw3DvfLPLn9hc5XyUaxAUpZXpa38uEeVi_WVtpQ297N4jHk5fzbCmnck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJPymgByFyaid5LBQuaBeUZ2gjoycwMroYQOziNe6fbA&oe=6AB68599"}, {"file_name": "4.png", "id": "767708812535811", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821950_767708815869144_7420712944936183060_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh35tOaFEpoQ7kNvwFcLxtL&_nc_oc=AdpYE2Izv3EoW43t2lYavHI7qKnGUm6dqDpaVdLrdcSeqrDjJJOcGb4d_sc1n_PI-5g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLzSx2gNQo86dw8fJgdxW75sb0WhzNmgJZ1vQxRgIyjw&oe=6AB6806F"}, {"file_name": "6.png", "id": "1070449758223981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308961_1070449761557314_445683733039028123_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZUzJquge7IQ7kNvwHovQH3&_nc_oc=AdpIzPpp18E7LB-WpvF-WhuR1IVjDsLHMFSTxPrK-20uk6OL7amRqWDXyFDNk--HUmo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-yLHkP3b20EqRigyQvBH1L-miBzCO9ArgLJ1_4Drdtw&oe=6AB68D07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-\u89c6\u9891\u5c01\u97622.png", "id": "766946422787751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828836_766946426121084_4919069796570414103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgo_Q_pyJmcQ7kNvwGCsH_Z&_nc_oc=AdpPY_SaNp_e3KwcKHQWLBrea6j-7hEUujoSDjdgLTU7ZFW7IXPC6JjFCCZi8uxvHhg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeHFwDLROsKEBcWQ1qNuptuv6QkWrTjpbeYuZEn-ICNw&oe=6AB69A6C"}, "display_name": "Bamboo Grove", "keywords": [], "long_description": "Every line of code you test could rewrite reality.\"Bamboo Grove\" is a single-player VR horror game. Players assume the role of a game tester tasked with conducting the final evaluation of the company's upcoming VR project, \"Bamboo Grove\", late at night. At first, everything appears to be just an ordinary virtual game. However, as the testing progresses, strange occurrences begin to unfold: the game\u2019s mechanics twist inexplicably, bizarre glitches emerge one after another\u2026 Until, at a certain moment, the boundary between the virtual and the real completely dissolves\u2014you find yourself back in the office, with the VR headset nowhere to be found. Is this still the game? Or has the nightmare become your reality?", "short_description": "Testing games? No, the game is testing you\u2014step into an inescapable VR horror test."}]}, "developer_name": "LingVision Games", "developer_privacy_policy_url": "https://www.ling-v.com/zhulinPrivacy", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": null, "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31328802720096557"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1756557952348680"}, {"status": "PENDING", "id": "3990833601213510"}, {"status": "PUBLISHED", "id": "1561845155514363"}]}, "baseline_offer": {"id": "1756557952348680"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789628400, "status": "PUBLISHED", "id": "1
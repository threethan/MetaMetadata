_1843166183366538_8049745640595525187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3Q7qQPSOEAQ7kNvwEUsbjF&_nc_oc=Adrkg0PhlSHJC38fVtnDTn4YSGPz_ohmmhb8Htm3jc5n2JdZZjI_10GrmFxZgZgXDCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaJv4EHSJuoUiakkCm3X-Y2WelF23dcgoMuq9BSLNgpg&oe=6AF0A4BE"}, "display_name": "Bamboo Grove", "keywords": ["horror", "scary", "puzzle", "adventure"], "long_description": "You are a hired game tester, brought in to playtest an unfinished VR horror game.  \nAt first, everything seems routine. Then the line between the virtual world and reality begins to blur.\nThe game starts behaving in ways it shouldn\u2019t. \n{1381243190790893}\n{1291001946333927}\nStrange events become impossible to explain, familiar mechanics stop following the rules, and every step draws you deeper into the unknown.\n{1562527094856735}\n{1067667489460726}\nExplore abandoned homes, hidden cellars, sacred shrines, winding forest trails, and long-forgotten temples as you uncover the dark history hidden within the village while surviving terrifying encounters with creatures lurking in the shadows.\n{943286975492985}\n{1063030779656433}\nWill you uncover the truth behind Bamboo Grove, or become part of its forgotten story?", "short_description": "You are a hired game tester sent to playtest an unfinished VR horror game. As reality begins to unravel, explore abandoned homes, hidden shrines, and forgotten temples while surviving terrifying creatures and uncovering the dark truth behind Bamboo Grove."}]}, "developer_name": "LingVision Games", "developer_privacy_policy_url": "https://www.ling-v.com/zhulinPrivacy", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": null, "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465
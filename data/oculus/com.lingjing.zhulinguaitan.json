VrUJWQcEV410TGi1lY_UeCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq9vZktnK8G95MDhJWgeqEUfQQW3ON1GrJNYa3mK93Zw&oe=6AB3F2F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u97624.png", "id": "1678091066672868", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296543_1678091070006201_591218003740482797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tfxwr5miqLcQ7kNvwF6HIv5&_nc_oc=AdouuLKZJX_ER5sTg2Q6kujWrFixwRz_KZa7V11_xOF9UCguM5CseaNNz2AMbA5bCLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOYi295htI5pYBUW2up3iDSkEsL15HVYwwAhfTiU-KJg&oe=6AB3CE10"}, "display_name": "Bamboo Grove", "keywords": ["horror", "scary", "puzzle", "adventure"], "long_description": "You are a hired game tester, brought in to playtest an unfinished VR horror game.  \nAt first, everything seems routine. Then the line between the virtual world and reality begins to blur.\nThe game starts behaving in ways it shouldn\u2019t. \n{1381243190790893}\n{1291001946333927}\nStrange events become impossible to explain, familiar mechanics stop following the rules, and every step draws you deeper into the unknown.\n{1562527094856735}\n{1067667489460726}\nExplore abandoned homes, hidden cellars, sacred shrines, winding forest trails, and long-forgotten temples as you uncover the dark history hidden within the village while surviving terrifying encounters with creatures lurking in the shadows.\n{943286975492985}\n{1063030779656433}\nWill you uncover the truth behind Bamboo Grove, or become part of its forgotten story?", "short_description": "You are a hired game tester sent to playtest an unfinished VR horror game. As reality begins to unravel, explore abandoned homes, hidden shrines, and forgotten temples while surviving terrifying creatures and uncovering the dark truth behind Bamboo Grove."}]}, "developer_name": "LingYouth", "developer_privacy_policy_url": "https://www.ling-v.com/zhulinPrivacy", "developer_terms_of_servi
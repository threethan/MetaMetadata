s": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "784387584757275"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1768665191094468", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u7af9\u6797\u602a\u8c08", "keywords": ["\u6050\u6016", "\u89e3\u8c1c", "\u5192\u9669", "\u60ca\u609a"], "long_description": "\u4f60\u662f\u4e00\u540d\u53d7\u96c7\u7684\u6e38\u620f\u6d4b\u8bd5\u5458\uff0c\u8d1f\u8d23\u8bd5\u73a9\u4e00\u6b3e\u5c1a\u672a\u5b8c\u5de5\u7684VR\u6050\u6016\u6e38\u620f\u3002\u8d77\u521d\uff0c\u4e00\u5207\u4f3c\u4e4e\u6b63\u5e38\uff0c\u4f46\u968f\u7740\u6d4b\u8bd5\u6df1\u5165\uff0c\u865a\u62df\u4e16\u754c\u4e0e\u73b0\u5b9e\u7684\u754c\u9650\u9010\u6e10\u6a21\u7cca\uff0c\u6e38\u620f\u4e5f\u5f00\u59cb\u51fa\u73b0\u8d8a\u6765\u8d8a\u591a\u65e0\u6cd5\u89e3\u91ca\u7684\u5f02\u5e38\uff0c\u800c\u4e14\u6108\u53d1\u8be1\u5f02\u3002\n{1954953698506203}\n{2414217089410471}\n\u65e0\u6cd5\u89e3\u91ca\u7684\u602a\u4e8b\u63a5\u8fde\u53d1\u751f\uff0c\u719f\u6089\u7684\u673a\u5236\u4e0d\u518d\u9075\u5faa\u65e2\u5b9a\u89c4\u5219\uff0c\u800c\u4f60\u7684\u6bcf\u4e00\u6b65\u63a2\u7d22\uff0c\u90fd\u5c06\u4f60\u5e26\u5411\u66f4\u6df1\u7684\u672a\u77e5\u3002\n{1322568866439757}\n{4453294584912168}\n\u4f60\u5c06\u63a2\u7d22\u5e9f\u5f03\u7684\u6c11\u5b85\u3001\u9690\u79d8\u7684\u5730\u7a96\u3001\u795e\u5723\u7684\u795e\u9f9b\u3001\u873f\u8712\u7684\u6797\u95f4\u5c0f\u5f84\u4ee5\u53ca\u88ab\u9057\u5fd8\u5df2\u4e45\u7684\u53e4\u5e99\uff1b\u5728\u63ed\u5f00\u6751\u5e84\u80cc\u540e\u9ed1\u6697\u5386\u53f2\u7684\u540c\u65f6\uff0c\u8fd8\u8981\u5728\u9634\u5f71\u4e2d\u6f5c\u4f0f\u7684\u6050\u6016\u751f\u7269\u7684\u5a01\u80c1\u4e0b\u8270\u96be\u6c42\u751f\u3002\n{1334328305442355}\n{1877204660320086}\n\u4f60\u662f\u80fd\u63ed\u5f00\u201c\u7af9\u6797\u201d\u80cc\u540e\u7684\u771f\u76f8\uff0c\u8fd8\u662f\u4f1a\u6ca6\u4e3a\u5b83\u90a3\u88ab\u9057\u5fd8\u6545\u4e8b\u7684\u4e00\u90e8\u5206\uff1f", "short_description": "\u4f60\u662f\u4e00\u540d\u516c\u53f8\u65b0\u62db\u8058\u7684\u6e38\u620f\u6d4b\u8bd5\u5458\uff0c\u8d1f\u8d23\u6d4b\u8bd5\u4e00\u6b3e\u4ecd\u672a\u4e0a\u7ebf\u7684VR\u6050\u6016\u6e38\u620f\u3002\u968f\u7740\u4e0d\u65ad\u6df1\u5165\uff0c\u73b0\u5b9e\u4e0e\u6e38\u620f\u7684\u8fb9\u754c\u9010\u6e10\u6a21\u7cca\uff0c\u4f60\u5c06\u7a7f\u68ad\u4e8e\u5e9f\u5f03\u7684\u623f\u5c4b\u4e0e\u9690\u79d8\u7684\u7960\u5802\uff0c\u4e00\u8fb9\u8eb2\u907f\u6050\u6016\u602a\u7269\u7684\u8ffd\u6740\uff0c\u4e00\u8fb9\u63a2\u5bfb\u201c\u7af9\u6797\u201d\u80cc\u540e\u7684\u9ed1\u6697\u771f\u76f8\u3002"}, {"images": {"nodes": [{"file_name": "\u7eb8\u4eba\u7248\u672c2560x1440.png", "id": "4706728996224570", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628436_4706728999557903_2829086551206866017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep_vDEFGUmwQ7kNvwEtsa-T&_nc_oc=Ado1IfEYh7h70jEqzua-efL3j1k_N7i2rd5zoOBR9a1uF3eDPnL1juglKlK_AkIBZxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsSBQNrD2NUuKkuxLHKsMM6O8uJ6X6dCCJZII0JMUcVQ&oe=6AE0B0E1"}, {"file_name": "1440x1440.png", "id": "1817254442956729", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593839439_1817254459623394_8198236002741506253_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXzFhsKXYlYQ7kNvwHZz7Pb&_nc_oc=AdqWf8Xm4AWhCh-MkfjgV_v6vO9nkQ-AQqve1Y7GQrMJu4xW2WKmm8lesMOBzCxZr0U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA2bO3cDRuFbIcYZPaNp_p_YLfmC6laI21Mof08mlquQ&oe=6AE09BA6"}, {"file_name": "\u7af9\u6797\u6807\u9898\u82f1\u65872560.png", "id": "1582414369655771", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620559_1582414372989104_3551084783155974368_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBvChcwdzjQQ7kNvwEXGOjr&_nc_oc=Adoqm1lb24xcYanndgeAWfKsws_T6p
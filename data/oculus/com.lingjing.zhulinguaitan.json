com&_nc_ss=7f20f&oh=00_AQQp5z48Xaaz91PP2Mp9V2QWx9_hI4xu8xe7JUDiFp220w&oe=6AFDE541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u7eb8\u4eba\u7248\u672c2560x1440.png", "id": "1843166180033205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593734382_1843166183366538_8049745640595525187_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMAiYEMN8t0Q7kNvwHIU0-F&_nc_oc=AdqRBnToM99ZkxFTqQw8u4GdwxLcBiDfCIqQ4mPEHPwtVE3LGv11KUO5xgcjm8tp2J8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRieF5xkh8FvDNF6QEd-1-NZy27Qc4IogRaoPbE-3WGYQ&oe=6AFDD3BE"}, "display_name": "Bamboo Grove", "keywords": ["horror", "scary", "puzzle", "adventure"], "long_description": "You are a hired game tester, brought in to playtest an unfinished VR horror game.  \nAt first, everything seems routine. Then the line between the virtual world and reality begins to blur.\nThe game starts behaving in ways it shouldn\u2019t. \n{1381243190790893}\n{1291001946333927}\nStrange events become impossible to explain, familiar mechanics stop following the rules, and every step draws you deeper into the unknown.\n{1562527094856735}\n{1067667489460726}\nExplore abandoned homes, hidden cellars, sacred shrines, winding forest trails, and long-forgotten temples as you uncover the dark history hidden within the village while surviving terrifying encounters with creatures lurking in the shadows.\n{943286975492985}\n{1063030779656433}\nWill you uncover the truth behind Bamboo Grove, or become part of its forgotten story?", "short_description": "You are a hired game tester sent to playtest an unfinished VR horror game. As reality begins to unravel, explore abandoned homes, hidden shrines, and forgotten temples while surviving terrifying creatures and uncovering the dark truth behind Bamboo Grove."}]}, "developer_name": "LingVision Games", "developer_privacy_policy_url": "https://www.ling-v.com/zhulinPrivacy", "developer_terms_of_service_url": nul
le_name": "3.png", "id": "946278645185336", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593815290_946278648518669_5976411109950109060_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm9zjYsXQAoQ7kNvwHy00HX&_nc_oc=AdrudbsGWFhyt320_GlYa2JIzOmIKDYJsm4aOOsq5bUntoGo-xi2xqglNBgbmirrtA8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAKsBzDkX3eRHSu4ZCZUksQHZHQkl6TR0f1CJvNv6RSw&oe=6AC7AF7E"}, {"file_name": "4.png", "id": "1392921055545188", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622184_1392921058878521_4695942662737316707_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUmIJDoQXP8Q7kNvwE2GiIi&_nc_oc=AdoqLPUHnk1Hy9CkzGEK2L3DSvC7xDiOt6kLYMoOwJRXMJhe0_qeD8f0a7z0CRuG350&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtfbgarCDv-8R4hQZo2l7wtXoJWWb4TcDcVTe4VInxOg&oe=6AC79800"}, {"file_name": "5.png", "id": "1050468527827918", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622153_1050468531161251_1560466891364238666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6skh2y_1DHoQ7kNvwHHONBu&_nc_oc=AdoFbwan-Yt6yObmVavbhWzMjmyWJ4BnK13LZ1JkpsBOVtungpyosF717xyhpf3JSno&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-5BvV2b-7HNLPMElBMJMYU7rhERlnNzQ5Dun0Uwyk8A&oe=6AC7B976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1636580364762344", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499627502_1636580368095677_286315338881472690_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRQdVnbY8tUQ7kNvwGkdzl1&_nc_oc=AdrWW5kvtMIPn5_jYM7J78n27qoJPJD5hGYZdxpKYbTXMeNbf6mdKvMFcxY-yNJGzRc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0f7qVwGTbDASL8uUg4E4gykqVsuT6JJxNX7gBBgIU7g&oe=6AC79B67"}, "display_name": "Bamboo Grove", "keywords": ["horror", "scary", "puzzle", "adventure"], "long_description": "You are a hired game tester, brought in to playtest an unfinished VR horror game.  \nAt first, everything seems routine. Then the line between the virtual world and reality begins to blur.\nThe game starts behaving in ways it shouldn\u2019t. \n{1381243190790893}\n{1291001946333927}\nStrange events become impossible to explain, familiar mechanics stop following the rules, and every step draws you deeper into the unknown.\n{1562527094856735}\n{1067667489460726}\nExplore abandoned homes, hidden cellars, sacred shrines, winding forest trails, and long-forgotten temples as you uncover the dark history hidden within the village while surviving terrifying encounters with creatures lurking in the shadows.\n{943286975492985}\n{1063030779656433}\nWill you uncover the truth behind Bamboo Grove, or become part of its forgotten story?", "short_description": "You are a hired game tester sent to playtest an unfinished VR horror game. As reality begins to unravel, explore abandoned homes, hidden shrines, and forgotten temples while surviving terrifying creatures and uncovering the dark truth behind Bamboo Grove."}, {"images": {"nodes": []}, "id": "1246592314286852", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u7af9\u6797\u602a\u8c08", "keywords": ["\u6050\u6016", "\u89e3\u8c1c", "\u5192\u9669", "\u60ca\u609a"], "long_description": "\u4f60\u662f\u4e00\u540d\u53d7\u96c7\u7684\u6e38\u620f\u6d4b\u8bd5\u5458\uff0c\u8d1f\u8d23\u8bd5\u73a9\u4e00\u6b3e\u5c1a\u672a\u5b8c\u5de5\u7684VR\u6050\u6016\u6e38\u620f\u3002\u8d77\u521d\uff0c\u4e00\u5207\u4f3c\u4e4e\u6b63\u5e38\uff0c\u4f46\u968f\u7740\u6d4b\u8bd5\u6df1\u5165\uff0c\u865a\u62df\u4e16\u754c\u4e0e\u73b0\u5b9e\u7684\u754c\u9650\u9010\u6e10\u6a21\u7cca\uff0c\u6e38\u620f\u4e5f\u5f00\u59cb\u51fa\u73b0\u8d8a\u6765\u8d8a\u591a\u65e0\u6cd5\u89e3\u91ca\u7684\u5f02\u5e38\uff0c\u800c\u4e14\u6108\u53d1\u8be1\u5f02\u3002\n{1954953698506203}\n{2414217089410471}\n\u65e0\u6cd5\u89e3\u91ca\u7684\u602a\u4e8b\u63a5\u8fde\u53d1\u751f\uff0c\u719f\u6089\u7684\u673a\u5236\u4e0d\u518d\u9075\u5faa\u65e2\u5b9
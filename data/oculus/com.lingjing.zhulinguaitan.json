5\u4e8b\u7684\u4e00\u90e8\u5206\uff1f", "short_description": "\u4f60\u662f\u4e00\u540d\u516c\u53f8\u65b0\u62db\u8058\u7684\u6e38\u620f\u6d4b\u8bd5\u5458\uff0c\u8d1f\u8d23\u6d4b\u8bd5\u4e00\u6b3e\u4ecd\u672a\u4e0a\u7ebf\u7684VR\u6050\u6016\u6e38\u620f\u3002\u968f\u7740\u4e0d\u65ad\u6df1\u5165\uff0c\u73b0\u5b9e\u4e0e\u6e38\u620f\u7684\u8fb9\u754c\u9010\u6e10\u6a21\u7cca\uff0c\u4f60\u5c06\u7a7f\u68ad\u4e8e\u5e9f\u5f03\u7684\u623f\u5c4b\u4e0e\u9690\u79d8\u7684\u7960\u5802\uff0c\u4e00\u8fb9\u8eb2\u907f\u6050\u6016\u602a\u7269\u7684\u8ffd\u6740\uff0c\u4e00\u8fb9\u63a2\u5bfb\u201c\u7af9\u6797\u201d\u80cc\u540e\u7684\u9ed1\u6697\u771f\u76f8\u3002"}, {"images": {"nodes": [{"file_name": "\u7eb8\u4eba\u7248\u672c2560x1440.png", "id": "4706728996224570", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628436_4706728999557903_2829086551206866017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99_BpedTyp8Q7kNvwHjvJvE&_nc_oc=AdpLM-lmtrWsBLv2HPVurstOL6g5CAhkmR6BRo9fd0QNkkjiVF0WaXIsRaPSQAjZvQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMhP-smv33TBofp9psE4LZgx613vpzG3Ey0j77yT5F2Q&oe=6ADF5F61"}, {"file_name": "1440x1440.png", "id": "1817254442956729", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593839439_1817254459623394_8198236002741506253_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXzFhsKXYlYQ7kNvwG3D34C&_nc_oc=AdrrKe3MjCDi5mz9b5ddgFgGl6X6_3tATjnEsO-6aSUQcmoGsXg9f-0t5DwBmhpENFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-vtQLk2Hsvf-_UeBKdu888PQKY8DeTwRzLdj9VNxKbQ&oe=6ADF4A26"}, {"file_name": "\u7af9\u6797\u6807\u9898\u82f1\u65872560.png", "id": "1582414369655771", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620559_1582414372989104_3551084783155974368_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBvChcwdzjQQ7kNvwFCKPGZ&_nc_oc=AdqAxoaM8zYk4EvyQsiqzkjvJt-z4R
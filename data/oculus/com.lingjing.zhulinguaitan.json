1\u5e84\u80cc\u540e\u9ed1\u6697\u5386\u53f2\u7684\u540c\u65f6\uff0c\u8fd8\u8981\u5728\u9634\u5f71\u4e2d\u6f5c\u4f0f\u7684\u6050\u6016\u751f\u7269\u7684\u5a01\u80c1\u4e0b\u8270\u96be\u6c42\u751f\u3002\n{1334328305442355}\n{1877204660320086}\n\u4f60\u662f\u80fd\u63ed\u5f00\u201c\u7af9\u6797\u201d\u80cc\u540e\u7684\u771f\u76f8\uff0c\u8fd8\u662f\u4f1a\u6ca6\u4e3a\u5b83\u90a3\u88ab\u9057\u5fd8\u6545\u4e8b\u7684\u4e00\u90e8\u5206\uff1f", "short_description": "\u4f60\u662f\u4e00\u540d\u516c\u53f8\u65b0\u62db\u8058\u7684\u6e38\u620f\u6d4b\u8bd5\u5458\uff0c\u8d1f\u8d23\u6d4b\u8bd5\u4e00\u6b3e\u4ecd\u672a\u4e0a\u7ebf\u7684VR\u6050\u6016\u6e38\u620f\u3002\u968f\u7740\u4e0d\u65ad\u6df1\u5165\uff0c\u73b0\u5b9e\u4e0e\u6e38\u620f\u7684\u8fb9\u754c\u9010\u6e10\u6a21\u7cca\uff0c\u4f60\u5c06\u7a7f\u68ad\u4e8e\u5e9f\u5f03\u7684\u623f\u5c4b\u4e0e\u9690\u79d8\u7684\u7960\u5802\uff0c\u4e00\u8fb9\u8eb2\u907f\u6050\u6016\u602a\u7269\u7684\u8ffd\u6740\uff0c\u4e00\u8fb9\u63a2\u5bfb\u201c\u7af9\u6797\u201d\u80cc\u540e\u7684\u9ed1\u6697\u771f\u76f8\u3002"}, {"images": {"nodes": [{"file_name": "\u65b9\u5f62.png", "id": "1956551275181357", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301473_1956551278514690_4752481736259541522_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjA4gqAKyl0Q7kNvwGxcLwO&_nc_oc=AdpuTnxxS6VlmV-0jDGMtZZhM-MMUDT7QWyD_I0VWabMpGG_qMMNN9R7iLk9TvpxZH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrlcoue-CQlvgqZFX7KJhtdkcKn0kfZUxVmxY8FAeskQ&oe=6AB7E723"}, {"file_name": "3000x900.png", "id": "1096882919090139", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827764_1096882922423472_7638631709567123954_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAWWZ2jtmfIQ7kNvwFBnmtp&_nc_oc=Adq6GZkEqmbVrzDPARBMwtFA_LzRLh5MeA6xowRI2qczMpxDXsF4WcQhWV_diBIbNgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOzpXoySaYWopnPxCXDogrZwhkrfIwe2xswks_2Aq4yw
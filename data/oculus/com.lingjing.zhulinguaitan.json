n.com&_nc_ss=7f20f&oh=00_AQRnsKBStm2Bqt9bL4r0-1OuGM4JPH0IBqVrpakB-eewUQ&oe=6AFDCB6C"}, "display_name": "Bamboo Grove", "keywords": [], "long_description": "Every line of code you test could rewrite reality.\"Bamboo Grove\" is a single-player VR horror game. Players assume the role of a game tester tasked with conducting the final evaluation of the company's upcoming VR project, \"Bamboo Grove\", late at night. At first, everything appears to be just an ordinary virtual game. However, as the testing progresses, strange occurrences begin to unfold: the game\u2019s mechanics twist inexplicably, bizarre glitches emerge one after another\u2026 Until, at a certain moment, the boundary between the virtual and the real completely dissolves\u2014you find yourself back in the office, with the VR headset nowhere to be found. Is this still the game? Or has the nightmare become your reality?", "short_description": "Testing games? No, the game is testing you\u2014step into an inescapable VR horror test."}]}, "developer_name": "LingVision Games", "developer_privacy_policy_url": "https://www.ling-v.com/zhulinPrivacy", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": null, "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31328802720096557"}}]}, "scheduled_offer
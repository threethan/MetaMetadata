0_AQN19-gfwsvFYCuwAb049CYXF4QMEM-4I6Rj3PgIc3G2YQ&oe=6AE0B599"}, {"file_name": "4.png", "id": "767708812535811", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821950_767708815869144_7420712944936183060_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o71RN3Xk70QQ7kNvwHFBgZq&_nc_oc=AdrLmVRp2lg6XG9QUfpSZgo660MgbC-Sqmgma1jTDbC8hFmq585_-Vy8LmOGxzDhmQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCMeu6SJpV6H5nhYtWn5tRr4D4P6JtAjkIiYBGLaA_sQ&oe=6AE0B06F"}, {"file_name": "6.png", "id": "1070449758223981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308961_1070449761557314_445683733039028123_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDT26llMFd0Q7kNvwFEKl3C&_nc_oc=Adr303oKeRs_1eVGd7xUFrLtaN2Jx65XhnLkpiisJk0GgixzP6PZJlp01gabWQUoI-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8tMfI6TvNTXpzlQ7ZBK8wrSjfksha6d6oSVNeeUIhEw&oe=6AE0BD07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-\u89c6\u9891\u5c01\u97622.png", "id": "766946422787751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828836_766946426121084_4919069796570414103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WnEzI07F5UQ7kNvwF3r55G&_nc_oc=Adp2KEMtqTPPj7oAzlVvzCMos0qdUfvVpMe6FgaGouFCEuxwgxQaNDqGiIWj_yqd_Mg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd5IbW7k0WzYq2YnonO6R4aut6k_xyETWsvK4tG0PnXg&oe=6AE0CA6C"}, "display_name": "Bamboo Grove", "keywords": [], "long_description": "Every line of code you test could rewrite reality.\"Bamboo Grove\" is a single-player VR horror game. Players assume the role of a game tester tasked with conducting the final evaluation of the company's upcoming VR project, \"Bamboo Grove\", late at night. At first, everything appears to be just an ordinary virtual game. However, as the testing progresses, strange occurrences begin to unfold: the game\u2019s mechanics twist inexplicably, bizarre glitches emerge one after another\u2026 Until, at a certain moment, the boundary between the virtual and the real completely dissolves\u2014you find yourself back in the office, with the VR headset nowhere to be found. Is this still the game? Or has the nightmare become your reality?", "short_description": "Testing games? No, the game is testing you\u2014step into an inescapable VR horror test."}]}, "developer_name": "LingVision Games", "developer_privacy_policy_url": "https://www.ling-v.com/zhulinPrivacy", "developer_terms_of_service_url": null, "publisher_name": "LingVision Games", "support_website_url": null, "website_url": "https://www.ling-v.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31328802720096557"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1733439928486736"}, {"status": "PUBLISHED", "id": "1756557952348680"}, {"status": "PENDING", "id": "3990833601213510"}, {"status": "PUBLISHED", "id": "1561845155514363"}]}, "baseline_offer": {"id": "1756557952348680"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792868400, "status": "PUBLISHED", "id": "1733439928486736"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38415256581451100", "version": "1.1.0"}, "id": "1142737397701591", "channel_name": "LIVE"}]}, "is_for_oculus_keys_onl
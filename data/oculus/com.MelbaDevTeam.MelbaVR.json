.png", "id": "963981601606192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982549_963981604939525_7048254565176153513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oc9zCoZ2SRgQ7kNvwHMU2cG&_nc_oc=AdkZ8leH1B0C0QhGLtWMvJRH9jrsbPeA0wFfwCvEjxdF2-0Adi4LveW0stBTA-_6b1w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsgC7bsE12RribjuazE0oHCQZFaDJicctBNZR4hIoI_vg&oe=69984787"}, {"file_name": "MelbaRemake_Custom..._01.05.2024_12-10-48.png", "id": "811609293664091", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223481_811609300330757_4274023099672643865_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRX0qstm_bgQ7kNvwFXxyDq&_nc_oc=AdnZV9RB-h1w6CXYhd4N2oFGBWkwQBl5AGGFrMXd_xikV3CNIXCLxG0Ksmcco_xtHPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuk01nYqXJjyG2Ta2roN-N8Y-x3V5HgejEmDQPG56t9dw&oe=69985E8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MelbaRemake_Custom..._01.05.2024_12-08-10.png", "id": "956839295933600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974619_956839299266933_4410619895062726047_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxVtLTW4QPQQ7kNvwEDWcZq&_nc_oc=AdkZSCMBS2XRTm_bkRNxuL838xgfYGHkN4FALDemlMJiGo0JKxRWegjJmiOcfClmyrs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvJY5KzHyyxytJgsOzU49__iSYRZEZD2UgTnnhYyrsfjQ&oe=69984E47"}, "display_name": "MelbaVR Remake", "keywords": [], "long_description": "Welcome to Melba VR!\n\n\nBut beware, as the jungle holds its fair share of challenges and dangers. From treacherous terrain to cunning predators, players must use their wits and agility to overcome obstacles and outsmart their foes. Along the way, they'll uncover hidden treasures, solve puzzles, and forge unlikely friendships with the creatures they encounter.\n\n\nWith stunning graphics, immersive gameplay, and endless customization options, 'Melba: Monkey VR Adventure' is not just a game\u2014it's an unforgettable journey into a world of fun, excitement, and endless possibilities. So grab your VR headset, don your favourite accessories, and get ready to swing into action with Melba!\"", "short_description": "Experience the jungle like never before in MelbaVR! Swing through trees, customize your monkey with endless cosmetic options, and embark on an unforgettable journey filled with danger and discovery. Get ready to unleash your inner primate in this immersive VR experience!"}]}, "developer_name": "mmo0nVR", "developer_privacy_policy_url": "https://sites.google.com/view/melbavrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "mmo0nVR", "support_website_url": null, "website_url": "https://sites.google.com/view/melbavrmain/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25696846656595724"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28261099293503768", "version": "65"}, "id": "1441824320039155", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25677809618499428", "is_concept": false, "latest_released_binary": {"__type
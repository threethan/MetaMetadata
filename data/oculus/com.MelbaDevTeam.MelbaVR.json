n.com&_nc_ss=7f20f&oh=00_AQK_h26AEwIMNgWuXMQu7z0bnhhfY6WmvPri136dYNiFAw&oe=6AB131B7"}, {"file_name": "MelbaRemake_Custom..._01.05.2024_12-10-37.png", "id": "963981601606192", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982549_963981604939525_7048254565176153513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsVOPBbhE7oQ7kNvwGNIdwv&_nc_oc=AdqNu5ZcXw2wFGuPpg6A4LxT0W8DDUFTVzUDZWxB6kqjfe08dz69V5zx49P4-KT1NhE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa2S11Jc7WCFbntdy9rskv6qHXYS5chW73gIOYB8qNrw&oe=6AB14F47"}, {"file_name": "MelbaRemake_Custom..._01.05.2024_12-10-48.png", "id": "811609293664091", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223481_811609300330757_4274023099672643865_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nti2jH2iYmAQ7kNvwFIe9L6&_nc_oc=Ado6lEaJhwPra0Jc1hd75hgY9C5_f-5N3mT1V1QEOrcqFBcbu7d1EEurdXr06C5bi_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLssgBb8LrwqEPFjWNg7MG-7iautR2sWb-fMPtN_i9ikA&oe=6AB12E0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MelbaRemake_Custom..._01.05.2024_12-08-10.png", "id": "956839295933600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974619_956839299266933_4410619895062726047_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxtJCYYtjHMQ7kNvwFNVD_z&_nc_oc=AdqejYSMQ9Pq3kLqKIdh8SbZT91bwyOoJ08ehi-F80pxVpyEf0CBZcK4vvE64y1mELs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKddguwY9cjuKh3YP_3UiVpgCEQkGPDr8zGohsRu2Wfkw&oe=6AB15607"}, "display_name": "MelbaVR Remake", "keywords": [], "long_description": "Welcome to Melba VR!\n\n\nBut beware, as the jungle holds its fair share of challenges and dangers. From treacherous terrain to cunning predators, players must use their wits and agility to overcome obstacles and outsmart their foes. Along the way, they'll uncover hidden treasures, solve puzzles, and forge unlikely friendships with the creatures they encounter.\n\n\nWith stunning graphics, immersive gameplay, and endless customization options, 'Melba: Monkey VR Adventure' is not just a game\u2014it's an unforgettable journey into a world of fun, excitement, and endless possibilities. So grab your VR headset, don your favourite accessories, and get ready to swing into action with Melba!\"", "short_description": "Experience the jungle like never before in MelbaVR! Swing through trees, customize your monkey with endless cosmetic options, and embark on an unforgettable journey filled with danger and discovery. Get ready to unleash your inner primate in this immersive VR experience!"}]}, "developer_name": "mmo0nVR", "developer_privacy_policy_url": "https://sites.google.com/view/melbavrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "mmo0nVR", "support_website_url": null, "website_url": "https://sites.google.com/view/melbavrmain/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25696846656595724"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28261099293503768", "version": "65"}, "id": "1441824320039155", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "An
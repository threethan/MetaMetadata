cb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYgupm9Tf4gQ7kNvwEJSwWe&_nc_oc=AdnFqImQVN18UwRbj5wodn1FgUE6h-zhv6WA46_EwMN_0HutyOz1d-k2UYrqY6gmdf8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyS9XL3P28DMh-gDdz_9cnhNeMhSWA86EVXAo_Ny7hkSg&oe=69BD4B62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sea Level Rise Explorer: Santa Cruz", "keywords": ["Climate", "Change", "Sea", "Level", "Rise"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle. Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "As coastal communities contend with sea-level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle. Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "https://virtualplanet.tech/", "website_url": "https://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "con
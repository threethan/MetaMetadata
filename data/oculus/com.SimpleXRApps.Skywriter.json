UfeO2dWSUIkw&oe=6AF09053"}, {"file_name": "Balloons.png", "id": "2613887105752452", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654865194_2613887109085785_3035657248147195138_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUYsr_B3kykQ7kNvwFBaAGR&_nc_oc=Adqj4urYzZht2jowAZBE-rpr2bIG-78IX9NwiJcp8VKkQ8cgn5w3FcCS3G__Ndgzw-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPGkJENyGpOOZ2OvzqBR3NRmY-1yBYuG6PAJUcK1_Kag&oe=6AF0AE49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560 x 1440.png", "id": "2140200569922100", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_2140200573255433_8306778653406588980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4sJWp-WgisQ7kNvwGiq_L-&_nc_oc=Adoa9J-RqFGZdoVguxCrs34HPTbPVyJIl-ZDSFRgoEyQaWvHYjSVRxSnir_tpJbN6vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpIW-SBp8f4NRFKZdlGU8KSvBSQq7CmRNUGGqQAi4TYg&oe=6AF08DDC"}, "display_name": "Skywriter", "keywords": [], "long_description": "The cost to hire a skywriter or put on a fireworks show starts around $3,500.  For less than 1/1,000 of that cost, this app offers similar experiences and more.  You can write a custom message up to 30 characters in a eight different styles using Balloons, Bats, Drones, Fireworks, Flowers, Marquee Letters, Skydivers, or a Skywriter.  There are also four pre-set messages: Prom Proposal, I Love You, Marriage Proposal, and Baby Reveal. \n\nUser Notes: This app is intended to be used outdoors.  For the Bats, Drones, Fireworks, Skydivers, and Skywriter messages, use in an open area.  Test yourself first to find the perfect spot for sharing the message.  Once you selected the message and found the right spot, get to the Launch screen and then give the headset to the intended message recipient.", "short_description": "The cost to hire a skywriter or put on a fireworks show starts around $3,500.  For less than 1/1,000 of that cost, this app offers similar experiences and more.  Write a custom message up to 30 characters in a eight different styles using Balloons, Bats, Drones, Fireworks, Flowers, Marquee Letters, Skydivers, or a Skywriter.  There are also four pre-set messages: Prom Proposal, I Love You, Marriage Proposal, and Baby Reveal. \n\nUser Notes: This app is intended to be used outdoors. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/skywriterapp/home", "developer_terms_of_service_url": null, "publisher_name": "Simple XR Apps", "support_website_url": null, "website_url": "https://sites.google.com/view/skywriterapp/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1401929923005352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654949474_974833412364253_5935992590939630453_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtxGEvbzchUQ7kNvwEOSspI&_nc_oc=AdpjJtt7cxeNGBcdVepjM4_O2Yv8yqfz1y4xtaMDk8FuoYOcAuFG95youABokCAjbUk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRof7cfwWQK-XqzGvWZHvvxETLgGcPQXVzEwhYFpohPFg&oe=6AF0AF9E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Skywriter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{
3_1214572860577004903_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX-Xxvqa_iMQ7kNvwH6VyMC&_nc_oc=Adnn8fqqNLb5eEQVC1grVV1kexlXvxjgJ1qrGxohYDFYBD_CZy9BFK1Uwr5EemjfK0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswWwp6jRk6txVDIBuBmTK0IQufD_NtI3MTg-S5EmFk_A&oe=699D8EF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09.cover_image.png", "id": "1372730560002578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222939_1372730563335911_5938853884470029426_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAZjrJlLUS8Q7kNvwHNtXek&_nc_oc=AdnsZq7fmpDrlqg5OokLHDdbpnyMb6Rhx9X-qGJ_pHzqzVg9GOlDxzGwYKsrBzGzt7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0by-ILvbPplRXiGUDRq3ZQs6N0lK-CZ3gKs37PkxAQA&oe=699D8EDC"}, "display_name": "AED Use Training", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 experiment.  This application supports two languages, Korean and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website
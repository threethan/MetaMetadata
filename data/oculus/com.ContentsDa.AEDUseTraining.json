d8mC6ncGqHhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1OffcBGDqicq9mBSfzSlBPi4ttPcdKaeWjy6TrJts2A&oe=69B540D5"}, {"file_name": "ApplicationFrameHost_fRMIE5aUdI.png", "id": "546322251461310", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221315_546322254794643_5112882647191043104_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=244j59go1-kQ7kNvwG5PrkR&_nc_oc=AdnHcq9xZP2y2bU4Y3zjl0WDyIMRwrmRm-kGxQ4XBJMFbtVv4rNuwKhkM_VVyF7O_JQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMaW645MT3nz8YRYEdmtY2PlWWvf_gvIqJV3q8OmHbdg&oe=69B55225"}, {"file_name": "ApplicationFrameHost_yyUXFGAhXn.png", "id": "575294928309907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035332_575294931643240_5180533321967583887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvJ1llfjDUAQ7kNvwGCGOaC&_nc_oc=AdlqU9Om-4tf9kmpWkU4PcldID__9kB9ey5wxmvB6BLdIEaq82oItmV87NkwRoz12_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXci2VSiOrnr0395uOcQju71BNQT4m7kpL4_eLU_77qQ&oe=69B5563E"}, {"file_name": "ApplicationFrameHost_syYeiXoKhH.png", "id": "1673624933528728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974640_1673624936862061_8368538067706651094_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMiWgOlq7h4Q7kNvwGqowc5&_nc_oc=AdkLtx_O4Epp-l0EfV4HeCGuj_Llp9lZJu_akoobuTtxajaqGT3eaqK05_lknwHKmak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-T3S7hTrc62sCXxlYHAxr4RKjZRagEaXtSTOJHCMd2A&oe=69B54DB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AED Use Training_Landscape.png", "id": "1731682440686153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982681_1731682444019486_4602137284528913229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-Uea2oKcboQ7kNvwEwMmTq&_nc_oc=AdlIIoYkY3nh-O6PBQU6K2HQwgaGI05cowf1YnbFEK_ad3H224bKB1ikFJHH_zLKTfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBz1qf0fI2jWsyyNjDN2j_4N5gTdHSx-igzThAr28uaQ&oe=69B54078"}, "display_name": "AED Use Training - ContentsDA", "keywords": ["safety", "aed", "cpr", "simulation", "contentsda"], "long_description": "1. Check for consciousness: Approach the collapsed person and determine if they are conscious.\n2. Establish an airway: If the person is conscious, support their neck and tilt their chin back to establish an airway.\n3. What to do if unconscious: If the person is not breathing, call 911 and describe the situation.\n4. Prepare to use an AED: Locate and move to the nearest AED box.\n5. Apply the AED: Place the AED near the collapsed person and press the power button to activate the machine.\n6. Apply patches: Unbutton the person's shirt and place the AED patches over the right chest and next to the left chest.\n7. Shock: Press the defibrillation button to deliver an electric shock, keeping your distance from the victim.\n8. CPR: Continue CPR after defibrillation, using two hands at a rate of 100 compressions per minute.\n9. Check and repeat: Ends if the patient regains consciousness, but if they don't improve, check their condition and repeat the entire process if necessary.", "short_description": "Learn how to use an Automated External Defibrillator (AED). This life-saving skill is essential in emergency situations where someone is experiencing cardiac arrest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEME
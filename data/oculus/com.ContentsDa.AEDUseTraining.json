8727161269_2073223955086573622_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ccGQ9-gvdEQ7kNvwHH_oHE&_nc_oc=AdnbWhlh72K2d69HFv1ABWeD6J-HlS2yJPF33VQK6vQhyIXXEiel8G9aSktzUpS4H80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftXkDQFvZ_gFj_0DjescsgJnVHuYW6OyX7ltTCRTJHQhw&oe=69A41D55"}, {"file_name": "ApplicationFrameHost_fRMIE5aUdI.png", "id": "546322251461310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221315_546322254794643_5112882647191043104_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z86wVh4JyFAQ7kNvwEmQnqB&_nc_oc=AdnpvQvszCrMXHSHYFG6evCgh7ENnRnzAUGxR9c9LjR1Iy7O_wpzRY4Mfnw7i6RkfE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs7yuNfwrsTXTMiZ2oYUv5l7Z4iM6fUh_OyD-faXcmdug&oe=69A42EA5"}, {"file_name": "ApplicationFrameHost_yyUXFGAhXn.png", "id": "575294928309907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035332_575294931643240_5180533321967583887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azMqdWNS9bQQ7kNvwF8869U&_nc_oc=AdlNP4iIaBpt6RGYdcqNftQ3hXTN6cGwCtW_90oFa-m4vuAjcR1a3UanL28-DfqpevQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuJLyTqkqhttz5MbFGxqeOvOY1TzhW_34FFgW4XzB7z3w&oe=69A432BE"}, {"file_name": "ApplicationFrameHost_syYeiXoKhH.png", "id": "1673624933528728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1673624936862061_8368538067706651094_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zdWh9MukE8Q7kNvwG6sL6z&_nc_oc=AdmBnADXgWjE-9Ra5UIe-p_TU-Tk0GTjpGhu5fCharucN2-l_TZqUQSK6-_LKdOkIr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuT1MO34FNutxcM97oRDAqS7J6ayLsXzlVb6yBQd8PaNQ&oe=69A42A35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AED Use Training_Landscape.png", "id": "1731682440686153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982681_1731682444019486_4602137284528913229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNzAopatWTwQ7kNvwH33g28&_nc_oc=Adnqr7ulf6Yawfv6BOWMJryg7kqfORa7w8yMhd1-zuzGdgvishd618ZYWEOMujUckRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv8h08hq9pmiOjFMYIm7a_L2FpoOskLKr2uzuQM7xQpWA&oe=69A41CF8"}, "display_name": "AED Use Training - ContentsDA", "keywords": ["safety", "aed", "cpr", "simulation", "contentsda"], "long_description": "1. Check for consciousness: Approach the collapsed person and determine if they are conscious.\n2. Establish an airway: If the person is conscious, support their neck and tilt their chin back to establish an airway.\n3. What to do if unconscious: If the person is not breathing, call 911 and describe the situation.\n4. Prepare to use an AED: Locate and move to the nearest AED box.\n5. Apply the AED: Place the AED near the collapsed person and press the power button to activate the machine.\n6. Apply patches: Unbutton the person's shirt and place the AED patches over the right chest and next to the left chest.\n7. Shock: Press the defibrillation button to deliver an electric shock, keeping your distance from the victim.\n8. CPR: Continue CPR after defibrillation, using two hands at a rate of 100 compressions per minute.\n9. Check and repeat: Ends if the patient regains consciousness, but if they don't improve, check their condition and repeat the entire process if necessary.", "short_description": "Learn how to use an Automated External Defibrillator (AED). This life-saving skill is essential in emergency situations where someone is experiencing cardiac arrest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription
XFGAhXn.png", "id": "575294928309907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035332_575294931643240_5180533321967583887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SF9Mxf_XHEQ7kNvwHWtUyE&_nc_oc=AdkAchywtN6Fb-bjxpBcdUeykV9jzghnzB2rta6qRKTxOAl_6k-ZPX_BLOgHT015wx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBiTMpXwgLWY-Nq7aq7ZZivHOzDVJlYBeI674qyJhEwg&oe=69AC1BBE"}, {"file_name": "ApplicationFrameHost_syYeiXoKhH.png", "id": "1673624933528728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_1673624936862061_8368538067706651094_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOmqzNdXi0IQ7kNvwF9eh8t&_nc_oc=AdlMFIe3S69DqNNVossB5jGFn7Q0MK7Pw4IDvtCvxTKyib_21MlqXPF_YBDzhgogHEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwR_Ywf7aRhBU6NNyYkl6AhJjwoR_L0yiytQR5yfCMYNA&oe=69AC1335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AED Use Training_Landscape.png", "id": "1731682440686153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982681_1731682444019486_4602137284528913229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P44QMvmKb0IQ7kNvwFrkje6&_nc_oc=Adkf73CFt5YsM584A-p4wfK8sYf7GukDfcf15Il8CxDF1qyMOIrkhZerq95vp6mkoG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxB2XhzsLODsUbl2K1mhUCVHT8AHCO044I6nBlmb-aYgQ&oe=69AC05F8"}, "display_name": "AED Use Training - ContentsDA", "keywords": ["safety", "aed", "cpr", "simulation", "contentsda"], "long_description": "1. Check for consciousness: Approach the collapsed person and determine if they are conscious.\n2. Establish an airway: If the person is conscious, support their neck and tilt their chin back to establish an airway.\n3. What to do if unconscious: If the person is not breathing, call 911 and describe the situation.\n4. Prepare to use an AED: Locate and move to the nearest AED box.\n5. Apply the AED: Place the AED near the collapsed person and press the power button to activate the machine.\n6. Apply patches: Unbutton the person's shirt and place the AED patches over the right chest and next to the left chest.\n7. Shock: Press the defibrillation button to deliver an electric shock, keeping your distance from the victim.\n8. CPR: Continue CPR after defibrillation, using two hands at a rate of 100 compressions per minute.\n9. Check and repeat: Ends if the patient regains consciousness, but if they don't improve, check their condition and repeat the entire process if necessary.", "short_description": "Learn how to use an Automated External Defibrillator (AED). This life-saving skill is essential in emergency situations where someone is experiencing cardiac arrest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9076199069057029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982652_3751321161763777_1014289282419956088_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfwhnq8-_YgQ7kNvwHFFLw1&_nc_oc=AdnNTVblaiGhEibTPLWbYNDnkVlxDEz
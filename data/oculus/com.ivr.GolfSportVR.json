08_474377714213974_6799131651046693678_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpvWmrJ_1rkQ7kNvwHYSIAp&_nc_oc=AdrkPDf0cOXLbOPv9iM-o-u_u5JWlS2Th4TGBmebj5ymCMm1dn5kwgfkoVmFkc0_NbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBE5kKI6uHl1BHzQwpt5ocS5djFYMImEYyPQMbGCuRiw&oe=6AFDDD5C"}, "display_name": "GolfSportVR", "keywords": [], "long_description": "Features:\n\nMultiple course\n - Select clubs: Golf, Tennis, Hockey, Baseball\n - Multiple targets: Bowling, Archery, Handball, Football, Soccer, Basketball, Foot US Helmet, and more\n - Enable: Birds, Wind, Rain, Clouds, Water, Animals, Day&Night, and more\n - TV Cameras (watching your left hand, or above the scoreboard)\n - Scorecard summary\n - Leaderboard: Compare your score Vs other players\n - Click on the Oculus menu button to access menu and options", "short_description": "GolfSportVR is an alternative golf like gameplay, where you need to hit different targets."}]}, "developer_name": "IVR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1EUmzPM8ey-cSC0zuiQ9iLmZsM-WSoEr-UtA-zexiVhg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "IVR", "support_website_url": null, "website_url": "https://sidequestvr.com/app/976/golfsportvr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SIN
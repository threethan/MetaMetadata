NxNiEbB2l4ztpw&oe=6AEF649A"}, {"file_name": "2.png", "id": "1201959198114538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391773_1201959201447871_5303999708260622842_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQzA8uDrn_AQ7kNvwGZJ-tQ&_nc_oc=AdrKDSZiSXRclqy6B3lSA4FXTUzy1v5xR1BqWnmh-xJPv8YwElN3NEgjMNyBIfLKVyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSDLlYrSh_0gpG5YJmKIfN51pXYVtgqO3u5sH-gE65nw&oe=6AEF5C42"}, {"file_name": "5.png", "id": "4090010127912266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_4090010131245599_7170436208239150071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYnVaJA-2c8Q7kNvwFEdT98&_nc_oc=AdqPfhYB6KL9tZKYLcVzucWBqiKpSZ2BJr70MZlaaJxNjoI_LX_-206RCKriInHmq2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSukbKZs6gcQUXz7m9mZlFppgf033y7zfHx_hbZoKd8g&oe=6AEF49C5"}, {"file_name": "4.png", "id": "1814639946041245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391812_1814639949374578_575266627178674532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvc-m8GYvAgQ7kNvwH-E6aX&_nc_oc=AdpmG5ygQ4n5OZhozirlDtgCYSKor2xPaa8qru3iviBAQpvkPC7Rxxl9hKhW5neGcL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEI5LAb70OIw5nee1FDnXUqk9Fn9l3lec0iFaWMphf6g&oe=6AEF450B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "538121162698977", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821683_538121166032310_8041598740174897815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-Ag6Sa2REoQ7kNvwEldZCw&_nc_oc=AdrtICxDf5ZhzjIlMYifrPxVI7Lto7x8SLNy3c3eXzV52VALVTsbEo-eqtM8rnIm6Jo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQzRMeDngYWFAPrbHlzHysVbQ5eRIteyeDBxUycCl-wg&oe=6AEF4B2F"}, "display_name": "STARVAULT", "keywords": ["MOBA", "Multiplayer", "Free", "moba"], "long_description": "# STARVAULT \u2013 The first full-scale VR MOBA:\n- **Choose your hero and squad up** from 9 unique heroes, each with their own weapons, skills, and playstyles. Team synergy is everything.\n\n- **Push enemy lanes**, destroy towers, and capture vision obelisks to gain strategic map control. Use portals and jump pads for mobility.\n\n- **Farm creeps, clear camps, and gain XP** & credits **to unlock your abilities** and buy artifacts.\n\n- **Crush your enemies in 5v5 team fights**, shatter their Energy Core, and claim victory as the true master of STARVAULT\n\n**STARVAULT is a truly immersive world**, featuring highly detailed hero models, real-time lighting and dynamic shadows, glow effects, atmospheric fog, realistic water, and lush environments. It all runs buttery-smooth \u2014 right on your headset.\n\n\n# Open Beta Notice\n- **STARVAULT is currently in Open Beta.**\nThis is not the final version of the game \u2014 it\u2019s an early stage of development. However, what you\u2019ll experience is already a deep, polished, and fully playable VR MOBA crafted with care.\n\n- **STARVAULT is completely free to play**, with **no monetization** of any kind.\nThere are no in-game purchases, no microtransactions \u2014 just pure gameplay.\n\n- **We invite you to join us at this exciting early stage**, share your feedback, and help shape the future **of the first true VR MOBA**.\n\n**Play. Join the community. Share your thoughts.**\n\nTogether, let\u2019s build something amazing!", "short_description": "STARVAULT \u2013 the first full-scale VR MOBA on Meta Quest.\nChoose your hero. Squad up. Push lanes. Farm creeps. Clear jungle camps. Upgrade your abilities mid-match. And dominate the map in intense 5v5 team fights.\n\nClassic MOBA with stunning visuals that push the Meta Quest to its absolute limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starvaultvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://starvaultvr.com/", "category": n
26158702058707_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hey3d2lre9wQ7kNvwHlvsDN&_nc_oc=AdoWF127lEs_bI2DuiB2W3lGUSM90R9JLqtK80iRTz8w3rLNUncMQg-hlsztz1S0wKw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzED4shJgpX-qouOG3dKENtipA9HtPRnOfCfUve43Jxw&oe=6B09C29A"}, {"file_name": "2.png", "id": "1201959198114538", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391773_1201959201447871_5303999708260622842_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ2t908tYv4Q7kNvwFZ57pz&_nc_oc=Adqdmk0fhtF146LmrC81xs4LMUHs1HNFDFqUN2tED8nHBXQdkRmUg_vKbZDTm8pn630&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHqeYWav2KAR0VhRD-e6YePuQXV80V2jdEO-NHNjHUXA&oe=6B09BA42"}, {"file_name": "5.png", "id": "4090010127912266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820496_4090010131245599_7170436208239150071_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_X3R-Tvv68Q7kNvwGV65DE&_nc_oc=Adp9xkDO7mapXdeW8tW3SJwYJo0YeYTkewUPDc7w48lOELRkKibOmplgw6hZibQqNuA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkwcOTdz9SX0ravDiQfKGRqK-yToZqV_-LJ0RTsZY42g&oe=6B09A7C5"}, {"file_name": "4.png", "id": "1814639946041245", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391812_1814639949374578_575266627178674532_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1RFyIwgbxIQ7kNvwFwlJW8&_nc_oc=AdoXHalEUNGj6RAw_hSeCH4raP5t_7ureZir43iCM74eRiwRvc_9kOBUgYvtDd4bXAI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSweeslzhghLTIFBkMJge9ek_DZ-6oHxs_Z_7TAofp3qw&oe=6B09A30B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "538121162698977", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821683_538121166032310_8041598740174897815_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imiKPDKDG1YQ7kNvwEyfL2h&_nc_oc=AdryvSeF_8hPfmWiL001C2O2wtLzzNDRAM6YrahDcqlBE8M3eKgl6zGdOon0Tta4Ssw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeLBqOwYFEDcXx_w8eMSCo5hWYhIgjTyoi80UacKltkQ&oe=6B09A92F"}, "display_name": "STARVAULT", "keywords": ["MOBA", "Multiplayer", "Free", "moba"], "long_description": "# STARVAULT \u2013 The first full-scale VR MOBA:\n- **Choose your hero and squad up** from 9 unique heroes, each with their own weapons, skills, and playstyles. Team synergy is everything.\n\n- **Push enemy lanes**, destroy towers, and capture vision obelisks to gain strategic map control. Use portals and jump pads for mobility.\n\n- **Farm creeps, clear camps, and gain XP** & credits **to unlock your abilities** and buy artifacts.\n\n- **Crush your enemies in 5v5 team fights**, shatter their Energy Core, and claim victory as the true master of STARVAULT\n\n**STARVAULT is a truly immersive world**, featuring highly detailed hero models, real-time lighting and dynamic shadows, glow effects, atmospheric fog, realistic water, and lush environments. It all runs buttery-smooth \u2014 right on your headset.\n\n\n# Open Beta Notice\n- **STARVAULT is currently in Open Beta.**\nThis is not the final version of the game \u2014 it\u2019s an early stage of development. However, what you\u2019ll experience is already a deep, polished, and fully playable VR MOBA crafted with care.\n\n- **STARVAULT is completely free to play**, with **no monetization** of any kind.\nThere are no in-game purchases, no microtransactions \u2014 just pure gameplay.\n\n- **We invite you to join us at this exciting early stage**, share your feedback, and help shape the future **of the first true VR MOBA**.\n\n**Play. Join the community. Share your thoughts.**\n\nTogether, let\u2019s build something amazing!", "short_description": "STARVAULT \u2013 the first full-scale VR MOBA on Meta Quest.\nChoose your hero. Squad up. Push lanes. Farm creeps. Clear jungle camps. Upgrade your abilities mid-match. And dominate the map in intense 5v5 team fights.\n\nClassic MOBA with stunning visuals that push the Meta Quest to its absolute limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starvaultvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://starvaultvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9530157723738103"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PENDING", "id": "4535138046702049"}, {"status": "PUBLISHED", "id": "1411284303909993"}, {"status": "PUBLISHED", "id": "1759390908460719"}, {"status": "PUBLISHED", "id": "1385859046206709"}, {"status": "PUBLISHED", "id": "37257777687170678"}, {"status": "PUBLISHED", "id": "4649422398625770"}, {"status": "PUBLISHED", "id": "1769371580910494"}, {"status": "PUBLISHED", "id": "539572468909946"}]}, "baseline_offer": {"id": "1769371580910494"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "4535138046702049"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28348385938155331", "version": "1.0"}, "id": "1942627769487376
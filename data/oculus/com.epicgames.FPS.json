Nmmdi587yHVSRw&oe=6AC3AADA"}, {"file_name": "2.png", "id": "1201959198114538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391773_1201959201447871_5303999708260622842_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax1k1IFF-gQQ7kNvwG7aAvN&_nc_oc=AdqxJbBcHZBniey-hQqa_PVNUrBmrOm1NNo4C7A_Bu23bObtbIbf_rgtoqVvwtZjkV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbDaCtCnxwb4oM9A-3l6Omas15qP2pup2BQ-hmF9SJzA&oe=6AC3A282"}, {"file_name": "5.png", "id": "4090010127912266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820496_4090010131245599_7170436208239150071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymscxGSDfHgQ7kNvwHDb1QW&_nc_oc=Adoennnge0EFlnncdUtlxT9ZGG3Vp0bIKEAgVYDL6K_rUdXoURXQ4T0QgwDfAjGR6ss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmbwStTP8qKrC6C56L_6_UOA30FAlFquXHLm4rJtCVrA&oe=6AC3C845"}, {"file_name": "4.png", "id": "1814639946041245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391812_1814639949374578_575266627178674532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV1K3yaNm1AQ7kNvwGJX21b&_nc_oc=AdqlZ9Bq598McbAHqDuWq_LKymzRJjAej7sgDJ3WSYRUEtoXZ1klTqYW6pKzeN5fZj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4kOji863f5BUHO3TvULbSHSzdSsrgzszHntrhVaImig&oe=6AC3C38B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "538121162698977", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821683_538121166032310_8041598740174897815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKP1woitLjwQ7kNvwFFqciS&_nc_oc=AdouMXEmtJFplgZBS8Lup_ijBFVC7q05Pczv_P3eI5Cd-ksayWVSZEBFjMH5Bbq2ueo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhbCgBOqc6bhP17eeTUjls8PXxdX89-jhnl-mdZmQKBQ&oe=6AC3C9AF"}, "display_name": "STARVAULT", "keywords": ["MOBA", "Multiplayer", "Free", "moba"], "long_description": "# STARVAULT \u2013 The first full-scale VR MOBA:\n- **Choose your hero and squad up** from 9 unique heroes, each with their own weapons, skills, and playstyles. Team synergy is everything.\n\n- **Push enemy lanes**, destroy towers, and capture vision obelisks to gain strategic map control. Use portals and jump pads for mobility.\n\n- **Farm creeps, clear camps, and gain XP** & credits **to unlock your abilities** and buy artifacts.\n\n- **Crush your enemies in 5v5 team fights**, shatter their Energy Core, and claim victory as the true master of STARVAULT\n\n**STARVAULT is a truly immersive world**, featuring highly detailed hero models, real-time lighting and dynamic shadows, glow effects, atmospheric fog, realistic water, and lush environments. It all runs buttery-smooth \u2014 right on your headset.\n\n\n# Open Beta Notice\n- **STARVAULT is currently in Open Beta.**\nThis is not the final version of the game \u2014 it\u2019s an early stage of development. However, what you\u2019ll experience is already a deep, polished, and fully playable VR MOBA crafted with care.\n\n- **STARVAULT is completely free to play**, with **no monetization** of any kind.\nThere are no in-game purchases, no microtransactions \u2014 just pure gameplay.\n\n- **We invite you to join us at this exciting early stage**, share your feedback, and help shape the future **of the first true VR MOBA**.\n\n**Play. Join the community. Share your thoughts.**\n\nTogether, let\u2019s build something amazing!", "short_description": "STARVAULT \u2013 the first full-scale VR MOBA on Meta Quest.\nChoose your hero. Squad up. Push lanes. Farm creeps. Clear jungle camps. Upgrade your abilities mid-match. And dominate the map in intense 5v5 team fights.\n\nClassic MOBA with stunning visuals that push the Meta Quest to its absolute limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starvaultvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://starvaultvr.com/", "category": n
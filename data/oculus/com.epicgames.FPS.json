97Lw-dSWMMtgow&oe=6A9D6F5A"}, {"file_name": "2.png", "id": "1201959198114538", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391773_1201959201447871_5303999708260622842_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE4Vq_oCapoQ7kNvwGyWoj-&_nc_oc=Adqk_SQ4f2SzB9qXRwj2_mXlhv4gOGuqecKiDu4inpHlWLYjPZjFsJhxqlci8REtwQU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVB34vrfhTo3IhzyL9xrBZj8LvIffzpNUKfYuuR_w-WQ&oe=6A9D6702"}, {"file_name": "5.png", "id": "4090010127912266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820496_4090010131245599_7170436208239150071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5knqE7vESoQQ7kNvwHFzkqk&_nc_oc=AdrmrQqT5l3WzyphYYDfm2Yp_wzuVh1Q3TwF87ux5x6QvPGl8oIWKtCuuwu5hg1ZdIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4Ul6mAgTqb2n8pn9JuHgV2h_KCnAQgk06IDGhUvnopg&oe=6A9D5485"}, {"file_name": "4.png", "id": "1814639946041245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391812_1814639949374578_575266627178674532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onGtkaDT9_4Q7kNvwEe8xoL&_nc_oc=AdrTT209TlFt2A67vfjCYrd9yLGUEPvkps2oVKN9v3bW2A6M0LFJOon8wbMTQm4-KY0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZcdjnjzM988wyxFmUEbqHkZeZUNvz6IoYxReBGaCzzQ&oe=6A9D880B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "538121162698977", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821683_538121166032310_8041598740174897815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j39Gz7LH758Q7kNvwFuj3DE&_nc_oc=AdoZM1lE0ZlAatCIeQGJyrTAfELtmaTXrKLhumzOoXMoerjhhW6C2bqR82QYH75r0SY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHXtzeVjqxQpKZFkAoBIxpNU2mizCkCejbzuQBWSBzsg&oe=6A9D55EF"}, "display_name": "STARVAULT", "keywords": ["MOBA", "Multiplayer", "Free", "moba"], "long_description": "# STARVAULT \u2013 The first full-scale VR MOBA:\n- **Choose your hero and squad up** from 9 unique heroes, each with their own weapons, skills, and playstyles. Team synergy is everything.\n\n- **Push enemy lanes**, destroy towers, and capture vision obelisks to gain strategic map control. Use portals and jump pads for mobility.\n\n- **Farm creeps, clear camps, and gain XP** & credits **to unlock your abilities** and buy artifacts.\n\n- **Crush your enemies in 5v5 team fights**, shatter their Energy Core, and claim victory as the true master of STARVAULT\n\n**STARVAULT is a truly immersive world**, featuring highly detailed hero models, real-time lighting and dynamic shadows, glow effects, atmospheric fog, realistic water, and lush environments. It all runs buttery-smooth \u2014 right on your headset.\n\n\n# Open Beta Notice\n- **STARVAULT is currently in Open Beta.**\nThis is not the final version of the game \u2014 it\u2019s an early stage of development. However, what you\u2019ll experience is already a deep, polished, and fully playable VR MOBA crafted with care.\n\n- **STARVAULT is completely free to play**, with **no monetization** of any kind.\nThere are no in-game purchases, no microtransactions \u2014 just pure gameplay.\n\n- **We invite you to join us at this exciting early stage**, share your feedback, and help shape the future **of the first true VR MOBA**.\n\n**Play. Join the community. Share your thoughts.**\n\nTogether, let\u2019s build something amazing!", "short_description": "STARVAULT \u2013 the first full-scale VR MOBA on Meta Quest.\nChoose your hero. Squad up. Push lanes. Farm creeps. Clear jungle camps. Upgrade your abilities mid-match. And dominate the map in intense 5v5 team fights.\n\nClassic MOBA with stunning visuals that push the Meta Quest to its absolute limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starvaultvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://starvaultvr.com/", "category": n
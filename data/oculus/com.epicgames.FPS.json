6158702058707_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hey3d2lre9wQ7kNvwFIuFXH&_nc_oc=AdqPeNvAGGLmzMIu-KCqLDUQzBDqadVH2ZAN3nKoykpSzZ7E8yp9xPMddhwe5qZbt4Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5MGDjRbknfccllcVCyJ2eoJQq-ZKMDbLvPr3yXve8Fw&oe=6B0B141A"}, {"file_name": "2.png", "id": "1201959198114538", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391773_1201959201447871_5303999708260622842_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BF3uyv-I0wQ7kNvwFFay6a&_nc_oc=AdpJTyqKZLG2aHcKLbM3sXi-IImC0OWW_1ZoudvAWvOTBm7Z0VHkxYW8eSWUmpTDgeo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQj8YiAU4qSdeBt-WofJYZ3dZ3fOVtY-5ebW8iS-YAAlg&oe=6B0B4402"}, {"file_name": "5.png", "id": "4090010127912266", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820496_4090010131245599_7170436208239150071_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_X3R-Tvv68Q7kNvwHUgDo6&_nc_oc=AdqNjhpAew-D0mi11JgDmTbOcMJzN8HbUfW25AQmZl921sXhs7xhPUujkIWIRvmA058&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYqvC4Mt_scPimEGbU794Pa9WTb_TkiEdo5ygvZ5DuRw&oe=6B0B3185"}, {"file_name": "4.png", "id": "1814639946041245", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391812_1814639949374578_575266627178674532_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNtmXWXNyQEQ7kNvwEB9Bn1&_nc_oc=Adp5rUWJJRGyYH1fljb7Gfcc8WCbV549f5ZbE42lVGxGznadlX0CPHcjKKrpdH81Y5U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5g1FWv1YCkucgFBgetfQZ0O1VG1fEKR3wFKBLhSZ6kg&oe=6B0B2CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "538121162698977", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821683_538121166032310_8041598740174897815_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imiKPDKDG1YQ7kNvwH8BmBF&_nc_oc=Adq4M0jV3imGd6t2ieeLG10lIHkwoC_TH0THFKHMaQ6H7lvcl6B2qw7M12NAAjO9qt8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGkb2afWsPpYRqOMDQG_zG_tuALvzu-eT4sOL_8nplnw&oe=6B0B32EF"}, "display_name": "STARVAULT", "keywords": ["MOBA", "Multiplayer", "Free", "moba"], "long_description": "# STARVAULT \u2013 The first full-scale VR MOBA:\n- **Choose your hero and squad up** from 9 unique heroes, each with their own weapons, skills, and playstyles. Team synergy is everything.\n\n- **Push enemy lanes**, destroy towers, and capture vision obelisks to gain strategic map control. Use portals and jump pads for mobility.\n\n- **Farm creeps, clear camps, and gain XP** & credits **to unlock your abilities** and buy artifacts.\n\n- **Crush your enemies in 5v5 team fights**, shatter their Energy Core, and claim victory as the true master of STARVAULT\n\n**STARVAULT is a truly immersive world**, featuring highly detailed hero models, real-time lighting and dynamic shadows, glow effects, atmospheric fog, realistic water, and lush environments. It all runs buttery-smooth \u2014 right on your headset.\n\n\n# Open Beta Notice\n- **STARVAULT is currently in Open Beta.**\nThis is not the final version of the game \u2014 it\u2019s an early stage of development. However, what you\u2019ll experience is already a deep, polished, and fully playable VR MOBA crafted with care.\n\n- **STARVAULT is completely free to play**, with **no monetization** of any kind.\nThere are no in-game purchases, no microtransactions \u2014 just pure gameplay.\n\n- **We invite you to join us at this exciting early stage**, share your feedback, and help shape the future **of the first true VR MOBA**.\n\n**Play. Join the community. Share your thoughts.**\n\nTogether, let\u2019s build something amazing!", "short_description": "STARVAULT \u2013 the first full-scale VR MOBA on Meta Quest.\nChoose your hero. Squad up. Push lanes. Farm creeps. Clear jungle camps. Upgrade your abilities mid-match. And dominate the map in intense 5v5 team fights.\n\nClassic MOBA with stunning visuals that push the Meta Quest to its absolute limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starvaultvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://starvaultvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9530157723738103"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PENDING", "id": "4535138046702049"}, {"status": "PUBLISHED", "id": "1411284303909993"}, {"status": "PUBLISHED", "id": "1759390908460719"}, {"status": "PUBLISHED", "id": "1385859046206709"}, {"status": "PUBLISHED", "id": "37257777687170678"}, {"status": "PUBLISHED", "id": "4649422398625770"}, {"status": "PUBLISHED", "id": "1769371580910494"}, {"status": "PUBLISHED", "id": "539572468909946"}]}, "baseline_offer": {"id": "1769371580910494"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "4535138046702049"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28348385938155331", "version": "1.0"}, "id": "1942627769487376"
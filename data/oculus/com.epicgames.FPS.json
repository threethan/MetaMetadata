wGgJwooedKfhNQ&oe=6A95BE9A"}, {"file_name": "2.png", "id": "1201959198114538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391773_1201959201447871_5303999708260622842_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br3hkwtJFiIQ7kNvwF0_aT7&_nc_oc=Adqt5ONUimN8osFtyEJCgYKGzDmBEk38e5ZqAexTYmKikHHD3SGN6mwlwfwB9ZjZuB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWOUaslojtQABYssGQ0g0hDf8LFJgpV5wEbrf8Iq7Mzw&oe=6A95B642"}, {"file_name": "5.png", "id": "4090010127912266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_4090010131245599_7170436208239150071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHp8vZ7E0BUQ7kNvwEn5K8r&_nc_oc=Adr8AZl2CS9LpIEjWX3bk40QY4mzwMkKy96L-H1GWowH-WpouyhxepbXJzv2bSMn6DI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwBaexKJH-B5vwwGAAQ2LAyfIiQA1I628CWhQsjlcrqA&oe=6A95DC05"}, {"file_name": "4.png", "id": "1814639946041245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391812_1814639949374578_575266627178674532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIWaSRU2y5gQ7kNvwFu8GQ3&_nc_oc=AdoEdNv0mAK1I402seDAN1Ir9WO_0S9TV6P7xqvvm6In5cylfjXrxxSouH6-WsLjYK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOgYJ6IKM0z3ud3G7eWzc1-Oj9xHczx0wUCjlpBk7vqQ&oe=6A95D74B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "538121162698977", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821683_538121166032310_8041598740174897815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgaSJ60C-rMQ7kNvwGl_70C&_nc_oc=Adr6SsIi9QO806z6AJSpQZmnTDBCUpgwU9VzUC74loA9RjgzKWrck6gFyrWnpnejaYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZKE8bUiep-BdTawjuqRahP0a1p4d3Yf7MnWcEUuyRvg&oe=6A95DD6F"}, "display_name": "STARVAULT", "keywords": ["MOBA", "Multiplayer", "Free", "moba"], "long_description": "# STARVAULT \u2013 The first full-scale VR MOBA:\n- **Choose your hero and squad up** from 9 unique heroes, each with their own weapons, skills, and playstyles. Team synergy is everything.\n\n- **Push enemy lanes**, destroy towers, and capture vision obelisks to gain strategic map control. Use portals and jump pads for mobility.\n\n- **Farm creeps, clear camps, and gain XP** & credits **to unlock your abilities** and buy artifacts.\n\n- **Crush your enemies in 5v5 team fights**, shatter their Energy Core, and claim victory as the true master of STARVAULT\n\n**STARVAULT is a truly immersive world**, featuring highly detailed hero models, real-time lighting and dynamic shadows, glow effects, atmospheric fog, realistic water, and lush environments. It all runs buttery-smooth \u2014 right on your headset.\n\n\n# Open Beta Notice\n- **STARVAULT is currently in Open Beta.**\nThis is not the final version of the game \u2014 it\u2019s an early stage of development. However, what you\u2019ll experience is already a deep, polished, and fully playable VR MOBA crafted with care.\n\n- **STARVAULT is completely free to play**, with **no monetization** of any kind.\nThere are no in-game purchases, no microtransactions \u2014 just pure gameplay.\n\n- **We invite you to join us at this exciting early stage**, share your feedback, and help shape the future **of the first true VR MOBA**.\n\n**Play. Join the community. Share your thoughts.**\n\nTogether, let\u2019s build something amazing!", "short_description": "STARVAULT \u2013 the first full-scale VR MOBA on Meta Quest.\nChoose your hero. Squad up. Push lanes. Farm creeps. Clear jungle camps. Upgrade your abilities mid-match. And dominate the map in intense 5v5 team fights.\n\nClassic MOBA with stunning visuals that push the Meta Quest to its absolute limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starvaultvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://starvaultvr.com/", "category": n
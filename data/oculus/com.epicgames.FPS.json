26158702058707_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8R5eb_xbdIQ7kNvwFm1O_V&_nc_oc=AdoRT9UxImDdktmtlVIVRksKeRVP-a2Lvs6pQHrfgt_KPPjzReIrnumY0PIjeOPtxWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Xw6iiUpy0lcz_XOhWDsyG_ZwRuv4fAcjgXkmuaAj1w&oe=6B05CE1A"}, {"file_name": "2.png", "id": "1201959198114538", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391773_1201959201447871_5303999708260622842_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L433eNdCgvAQ7kNvwE817iU&_nc_oc=AdqwZJnA6DGjwwUXiSDi1I0iVUaXfeaLRRQ2KG90g8leFWS34gHjvFCtIHiIoHLJSZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQecdL1g4nVxrlSpYp6Bdm4tro21kfJJneUNoIX7ExSfA&oe=6B05C5C2"}, {"file_name": "5.png", "id": "4090010127912266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_4090010131245599_7170436208239150071_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXrq_yHp1goQ7kNvwHrPPfI&_nc_oc=Adp7wx3IZlI40Bx2eGs4BMmbEDu2OR00wM1GDh8wCfkjLb0YrEBYIfwx1mmocO47GeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRErT_Npkj6caTjnHZBsHKd1DTtEEJTh93tRiyskoEIPg&oe=6B05B345"}, {"file_name": "4.png", "id": "1814639946041245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391812_1814639949374578_575266627178674532_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhOvQn6AcFgQ7kNvwF1LfSb&_nc_oc=AdpyJYoKKbgjayyZDNNNEwkcokB7ieOH6zR8dy50Z-WuApBcNy9dtgWi8ygDC78hiiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEz2aI4HnT6iu-z7mjoVhnRlMmu8-yq-Tqkr0XR6dSrQ&oe=6B05AE8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "538121162698977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821683_538121166032310_8041598740174897815_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlUC93qYv34Q7kNvwFkLQJD&_nc_oc=Adohpn12Hf76zoB2Op6AeQ0-sEItoGYpuY6UK6PnLNY5NySHJOZ_syy9yd2N__mRNfo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkiYqZnWP7B80FcCC8MG2egLBkImg3_I7ZQlQl0JhUKg&oe=6B05B4AF"}, "display_name": "STARVAULT", "keywords": ["MOBA", "Multiplayer", "Free", "moba"], "long_description": "# STARVAULT \u2013 The first full-scale VR MOBA:\n- **Choose your hero and squad up** from 9 unique heroes, each with their own weapons, skills, and playstyles. Team synergy is everything.\n\n- **Push enemy lanes**, destroy towers, and capture vision obelisks to gain strategic map control. Use portals and jump pads for mobility.\n\n- **Farm creeps, clear camps, and gain XP** & credits **to unlock your abilities** and buy artifacts.\n\n- **Crush your enemies in 5v5 team fights**, shatter their Energy Core, and claim victory as the true master of STARVAULT\n\n**STARVAULT is a truly immersive world**, featuring highly detailed hero models, real-time lighting and dynamic shadows, glow effects, atmospheric fog, realistic water, and lush environments. It all runs buttery-smooth \u2014 right on your headset.\n\n\n# Open Beta Notice\n- **STARVAULT is currently in Open Beta.**\nThis is not the final version of the game \u2014 it\u2019s an early stage of development. However, what you\u2019ll experience is already a deep, polished, and fully playable VR MOBA crafted with care.\n\n- **STARVAULT is completely free to play**, with **no monetization** of any kind.\nThere are no in-game purchases, no microtransactions \u2014 just pure gameplay.\n\n- **We invite you to join us at this exciting early stage**, share your feedback, and help shape the future **of the first true VR MOBA**.\n\n**Play. Join the community. Share your thoughts.**\n\nTogether, let\u2019s build something amazing!", "short_description": "STARVAULT \u2013 the first full-scale VR MOBA on Meta Quest.\nChoose your hero. Squad up. Push lanes. Farm creeps. Clear jungle camps. Upgrade your abilities mid-match. And dominate the map in intense 5v5 team fights.\n\nClassic MOBA with stunning visuals that push the Meta Quest to its absolute limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starvaultvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://starvaultvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9530157723738103"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1411284303909993"}, {"status": "PUBLISHED", "id": "1759390908460719"}, {"status": "PUBLISHED", "id": "1385859046206709"}, {"status": "PUBLISHED", "id": "37257777687170678"}, {"status": "PUBLISHED", "id": "4649422398625770"}, {"status": "PUBLISHED", "id": "1769371580910494"}, {"status": "PUBLISHED", "id": "539572468909946"}]}, "baseline_offer": {"id": "1769371580910494"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797796800, "status": "PUBLISHED", "id": "1411284303909993"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28348385938155331", "version": "1.0"}, "id": "1942627769487376", "channel_name": "LIVE"}]}, "is_for_
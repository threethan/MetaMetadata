gjWmTeaDEtQ7sCcEwYDcHQxiZIxA&oe=6A8EEEDA"}, {"file_name": "2.png", "id": "1201959198114538", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391773_1201959201447871_5303999708260622842_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqyFSzEJgyIQ7kNvwGS927E&_nc_oc=AdrEwv2egE_mjU_XvZEZeW4jtoqaYs_uditqO27G9V3iyxFXql8Zotf1PF1CN3IGxUc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8DYMqfItBTkF4G5Kj0dZEo2J9trQ-tz2Wpp4HEu-nYw&oe=6A8EE682"}, {"file_name": "5.png", "id": "4090010127912266", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820496_4090010131245599_7170436208239150071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJnX7PdbHRgQ7kNvwG7WtQU&_nc_oc=AdovnAn4ykCaO3pO5z6XtE-DOn17WQMgtFizr6D66dFvNqyJmvJQar9F-GdIO4yBT3s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNeVFh5UNU8idnb0faY2LQnt_kMVfnrvDZm1yieaqNUA&oe=6A8ED405"}, {"file_name": "4.png", "id": "1814639946041245", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391812_1814639949374578_575266627178674532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L3Qadnsmj4Q7kNvwE8TbYl&_nc_oc=AdqyrHm03LiC8spvq6Vd3B1HNWbR7Qs8mQ4Sm_8hKAtQ5tWUDW_m51ifG4BY5LOhNgE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhJq5Z3ntxfM-mBwv14YLAiajL5PGNNPdW3MP7unVm1A&oe=6A8ECF4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "538121162698977", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821683_538121166032310_8041598740174897815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXNkVbAD_UYQ7kNvwGSYW-E&_nc_oc=AdpWfXTp8i3ExeO736vazh1MAZ8kHVG-MLl_CeaEzTVgjEDYbdNTVD_w5hjXqGs3m_c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnBQLQg1agmoStRRg7y9Xj73ANOmG4w-WuEVO2OkqLhQ&oe=6A8ED56F"}, "display_name": "STARVAULT", "keywords": ["MOBA", "Multiplayer", "Free", "moba"], "long_description": "# STARVAULT \u2013 The first full-scale VR MOBA:\n- **Choose your hero and squad up** from 9 unique heroes, each with their own weapons, skills, and playstyles. Team synergy is everything.\n\n- **Push enemy lanes**, destroy towers, and capture vision obelisks to gain strategic map control. Use portals and jump pads for mobility.\n\n- **Farm creeps, clear camps, and gain XP** & credits **to unlock your abilities** and buy artifacts.\n\n- **Crush your enemies in 5v5 team fights**, shatter their Energy Core, and claim victory as the true master of STARVAULT\n\n**STARVAULT is a truly immersive world**, featuring highly detailed hero models, real-time lighting and dynamic shadows, glow effects, atmospheric fog, realistic water, and lush environments. It all runs buttery-smooth \u2014 right on your headset.\n\n\n# Open Beta Notice\n- **STARVAULT is currently in Open Beta.**\nThis is not the final version of the game \u2014 it\u2019s an early stage of development. However, what you\u2019ll experience is already a deep, polished, and fully playable VR MOBA crafted with care.\n\n- **STARVAULT is completely free to play**, with **no monetization** of any kind.\nThere are no in-game purchases, no microtransactions \u2014 just pure gameplay.\n\n- **We invite you to join us at this exciting early stage**, share your feedback, and help shape the future **of the first true VR MOBA**.\n\n**Play. Join the community. Share your thoughts.**\n\nTogether, let\u2019s build something amazing!", "short_description": "STARVAULT \u2013 the first full-scale VR MOBA on Meta Quest.\nChoose your hero. Squad up. Push lanes. Farm creeps. Clear jungle camps. Upgrade your abilities mid-match. And dominate the map in intense 5v5 team fights.\n\nClassic MOBA with stunning visuals that push the Meta Quest to its absolute limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starvaultvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://starvaultvr.
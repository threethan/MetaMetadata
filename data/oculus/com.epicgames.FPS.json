7LunkJBmZ5hOXw&oe=6AE4A05A"}, {"file_name": "2.png", "id": "1201959198114538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391773_1201959201447871_5303999708260622842_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWO42XpPMJMQ7kNvwE6fsps&_nc_oc=AdqkX5tPby4Xfxf2wl7kjF7_hpHmdf9h9aaF7ttJJhvmtTA_E5XJuFcftcCw2gaScNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqKjHI-fWWk6v4YdKT5QGV1ho3cHRQCdx8v07hJti1pQ&oe=6AE49802"}, {"file_name": "5.png", "id": "4090010127912266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820496_4090010131245599_7170436208239150071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvVy4ek-MYkQ7kNvwFW8Nr3&_nc_oc=AdqKx1Gt1k7VnIcypYxczzZ0NIzonv1LrfehXvo9-b3jb3iU14uaiIUEmU4DWP5IeDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeEtauiwrW_SliCEifYXcCqP3Dr2wWwT5ujZrUt1lh8A&oe=6AE4BDC5"}, {"file_name": "4.png", "id": "1814639946041245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391812_1814639949374578_575266627178674532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMkhlSDRDxwQ7kNvwHd4ujM&_nc_oc=Adoq2hH0WTD2pblQI-zC1jZELfjTtUFBLCwLeO_f7S3CXZnHK7T5FcFnueDoA-ECLVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFl2FSwpcool4xLpi8BCooXoCn4AZpif8_F5XCskkAvA&oe=6AE4B90B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "538121162698977", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821683_538121166032310_8041598740174897815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HhbWB8hib8Q7kNvwGupJUv&_nc_oc=AdqsKK5xkdT3L7jgK1q-z-TZLL44vpv77Xg0roHqUxhQflQLdj2RWiDvr6Bmbb844L8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZQIcC0FDloa3eQBqgYS9fBdOaKlO37kbSDTDzd3uTVw&oe=6AE4BF2F"}, "display_name": "STARVAULT", "keywords": ["MOBA", "Multiplayer", "Free", "moba"], "long_description": "# STARVAULT \u2013 The first full-scale VR MOBA:\n- **Choose your hero and squad up** from 9 unique heroes, each with their own weapons, skills, and playstyles. Team synergy is everything.\n\n- **Push enemy lanes**, destroy towers, and capture vision obelisks to gain strategic map control. Use portals and jump pads for mobility.\n\n- **Farm creeps, clear camps, and gain XP** & credits **to unlock your abilities** and buy artifacts.\n\n- **Crush your enemies in 5v5 team fights**, shatter their Energy Core, and claim victory as the true master of STARVAULT\n\n**STARVAULT is a truly immersive world**, featuring highly detailed hero models, real-time lighting and dynamic shadows, glow effects, atmospheric fog, realistic water, and lush environments. It all runs buttery-smooth \u2014 right on your headset.\n\n\n# Open Beta Notice\n- **STARVAULT is currently in Open Beta.**\nThis is not the final version of the game \u2014 it\u2019s an early stage of development. However, what you\u2019ll experience is already a deep, polished, and fully playable VR MOBA crafted with care.\n\n- **STARVAULT is completely free to play**, with **no monetization** of any kind.\nThere are no in-game purchases, no microtransactions \u2014 just pure gameplay.\n\n- **We invite you to join us at this exciting early stage**, share your feedback, and help shape the future **of the first true VR MOBA**.\n\n**Play. Join the community. Share your thoughts.**\n\nTogether, let\u2019s build something amazing!", "short_description": "STARVAULT \u2013 the first full-scale VR MOBA on Meta Quest.\nChoose your hero. Squad up. Push lanes. Farm creeps. Clear jungle camps. Upgrade your abilities mid-match. And dominate the map in intense 5v5 team fights.\n\nClassic MOBA with stunning visuals that push the Meta Quest to its absolute limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starvaultvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://starvaultvr.com/", "category": n
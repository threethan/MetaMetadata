e_name": "5.png", "id": "1037634260910240", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974494_1037634264243573_7357842708086054238_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no-NTa98960Q7kNvwFaiMzB&_nc_oc=AdrXI2sjqcWwf1U1U0XWIRFFB3EhL_98l1EGSbEfapniN5ZHxTRyLekYA7NiGOuNgKA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEoWscfAe3Z63v5j8tjhKb4_HTtChRIyr96kEv_xSEew&oe=6B084DC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape.png", "id": "304503355723368", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334050_304503359056701_8911185125811091519_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-rySjtP1YoQ7kNvwGkCA5E&_nc_oc=Adr-rD5woiJxm9W0EtxqwZ0bBu5sPUZ6p41J6aVnX235xBvUK7vCdmqifB0o-fG4SzQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4vbr-jr5ZMeh3o86KQWpp16EmWD28TOPCEr2WhjduAw&oe=6B085CF1"}, "display_name": "Ikarus VR Portfolio", "keywords": [], "long_description": "\ud83c\udf1f Experience the Future of Fashion and Design \ud83c\udf1f\n\nWelcome to our cutting-edge VR app, where innovation meets style, and creativity knows no bounds! We are thrilled to introduce you to the immersive world of [Your Company Name]. \n\nAt this early stage, we invite you to be a part of our exciting journey as we unveil our incredible range of products, including:\n\n\ud83d\udc5f Shoes: Step into a realm of footwear fashion like never before. Explore the latest trends, experiment with unique designs, and virtually try on a stunning collection of shoes that combine comfort and style.\n\n\ud83d\udc53 Glasses: Discover eyewear that complements your personality and style. Dive into a virtual showroom where you can browse through a spectrum of frames, shapes, and colors, and find the perfect pair that speaks to you.\n\n\ud83e\ude91 Furniture: Redefine your living space with our exquisite furniture collection. Visualize how our pieces can transform your home, from cozy sofas to elegant dining tables, all in the immersive VR environment.\n\n\ud83d\udc8d Accessories: Elevate your everyday look with the perfect accessories. Explore a treasure trove of jewelry, bags, and more that will enhance your fashion statement and add a touch of luxury to your life.\n\nAnd so much more!", "short_description": "Our app is a canvas for your imagination, a portal into the future of design. We're eager to hear your thoughts, suggestions, and insights. Your feedback is invaluable as we fine-tune and expand our offerings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ikarusvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ikarus 3D", "support_website_url": null, "website_url": "https://www.ikarusvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6859524284141517"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7607602862666985", "version": "23"}, "id": "981404489826417", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"
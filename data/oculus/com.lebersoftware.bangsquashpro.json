=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv1GsTCe4owQ7kNvwEz5cmu&_nc_oc=AdotiDkPS_JzSoEH6p8HW_zv9A28yCia-nF1C8bASIBtGnME96fBOTTdBWNQdnE6GdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOO8dFDLgVoTTl88gIy-yH8trQEPHBZh7hDIlfM6cFLg&oe=6B05B043"}, {"file_name": "inGame4.png", "id": "772751526575834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974457_772751529909167_1971176831298816162_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcL6zIyYGH4Q7kNvwGRWe6w&_nc_oc=Adqe0epIg6a2rZ3Yol3kAJSqgznABnDsk1ZEqzjJTbPaRrjlTX9__YjcYBYpwgPrVSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXuv3Zcb3YiJTUuPLMcNFTs48hXaK7nhlTwlzf0_BuUA&oe=6B05C537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "197781205491543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_197781208824876_4790094533353552791_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnLotepNQkQQ7kNvwFo2wMo&_nc_oc=AdoRiC1WmHxufUpYUpLPsUJfz6_VHS-66CrU3j5dzgxwNG2Yx4hR7HVOie4aq-LOM0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRto681HlL5C5lX54MHfZ8I3Vioi9OdMjmXmx7OozJrUg&oe=6B05C0C8"}, "display_name": "BangSquash PRO", "keywords": [], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-privacy-policy/", "developer_terms_of_service_url": "http://www.lebersoftware.hu/", "publisher_name": "Leber Software", "support_website_url": "http://www.lebersoftware.hu/", "website_url": "https://lebersoftware.hu/bang-squash/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "666184364570454"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "811892723034123"}]}, "baseline_offer": {"id": "811892723034123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1623857160, "status": "PUBLISHED", "id": "811892723034123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3974105712658490", "version": "2.2"}, "id": "584131992989451", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prim
=1-7&_nc_sid=6e7a0a&_nc_ohc=gEPZNIKrDAYQ7kNvwEPbbv7&_nc_oc=Adlxnfb7Oea0-UKQ9X8_C1D22S6KnFsuRndGKYjG7yrCKrhtRIrwymM-9UNacB-vUAM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftpUr2ZPIvDelBvwiJC7DM-v6QHC8OUc1sEODQ47ULFFQ&oe=69A2E977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "197781205491543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982553_197781208824876_4790094533353552791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aivIAGMBwz0Q7kNvwHOzfNJ&_nc_oc=Admo9VpwdXlWOh5iManstlLx3sh5jv6Gi9mbcJjCuxLxNrGi7soCRJtxYIgdAZfhHV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsN6tY_ISS5_Gsfdxyq4O6RYjtT5ImC3P1AQYz0R6kd_w&oe=69A2E508"}, "display_name": "BangSquash PRO", "keywords": [], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-pri
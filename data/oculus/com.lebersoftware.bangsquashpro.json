=1-7&_nc_sid=6e7a0a&_nc_ohc=_Kc7s0SRWIkQ7kNvwFbEekG&_nc_oc=AdlDBYbICF-XFoym3eOB8qgh9latAffEbJ3gNhb8hJytl1HoEq1qD732FWJMgB79FmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft26TNcb6e6mKIvdRwOclLGTI2KBoRy8TSFdqpcr4PZVA&oe=69A6DDF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "197781205491543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982553_197781208824876_4790094533353552791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG0tCk4pabMQ7kNvwGOOMr6&_nc_oc=AdkZIBMhkcsHtwhdRj-nwLOceF7s30LLXey_81TznAaDNlp1jE57bNB4lSn1i0aXkz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvP3xSZJsTlv46sQ7seASQPWwLM7WGIbXZ4bFSr3xV_QA&oe=69A6D988"}, "display_name": "BangSquash PRO", "keywords": [], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-pri
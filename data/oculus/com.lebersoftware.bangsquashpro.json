=1-7&_nc_sid=6e7a0a&_nc_ohc=5W3dwIuB62EQ7kNvwGEyHQy&_nc_oc=Adm2fcr0-e227EZqnFDjlxuer_eYk0iQjZBw_2gY7YCAMldU_svDm35HMrgUIqZqIJE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftgCPfXSsqTKv4vbLQOVSQh-GIlFlUSVyybQOgLzSxTPA&oe=6999AEF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "197781205491543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982553_197781208824876_4790094533353552791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GckqYlUOhcQ7kNvwEz99qe&_nc_oc=AdkOsAFudFfkzuRL9KfYnYDlv-1R5Aji8ZAedZulGaXCl4IiZ1ptYGkrjXX0TNVFxos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsD5gS5XjRRhDehhJGRyi6pfk73hpNPsx7DdqH-DXY_RQ&oe=6999AA88"}, "display_name": "BangSquash PRO", "keywords": [], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-pri
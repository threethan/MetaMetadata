=1-7&_nc_sid=6e7a0a&_nc_ohc=5W3dwIuB62EQ7kNvwFd3oWb&_nc_oc=AdlQ0fiS30A1wF8nYQKSUKpWdWlDLSHCbhKu3eKfmtK-873dyQdFP2peFHj14adhKAg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs5byl7gLirysRjLHwaN-dzcXL7pk55Tn81d4NaUcV_mw&oe=699B0077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "197781205491543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_197781208824876_4790094533353552791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GckqYlUOhcQ7kNvwGA-03F&_nc_oc=Adm8S_uty8iu65Vf_O8IJn883qLbeA3U_njCnfZEFazvZvs_hOXjAnqRAhxZjY_ZZ2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvOnc6WqMkzbKtLEOHOZyXHVN3ZRBzgp-dxR7WeX7QAYA&oe=699AFC08"}, "display_name": "BangSquash PRO", "keywords": [], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-pri
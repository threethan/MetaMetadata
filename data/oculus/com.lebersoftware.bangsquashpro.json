=1-7&_nc_sid=6e7a0a&_nc_ohc=eGaEFnXBNMkQ7kNvwEV-uvL&_nc_oc=AdnmCpXbP0AhbFvZCG248gCZSBW53XaU_0qlCGbUrj33ORahJfHgXihoQtaJwtWTNyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv44dk9m7ibtOQVUi-gLsddYsIbhUjZfWIlmgvCFtw7Lw&oe=699C51F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "197781205491543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_197781208824876_4790094533353552791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYHFvnsM6_4Q7kNvwGgrCHi&_nc_oc=Adkyh1aw7VqG95IYvviH9MCW57X7rmwK34S4ouequEck1y3IGvDs9bF6E2QJ-ZBk2s4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuzujinoDj6aoCrhHV1ApQgdS19i4gf5CWz71JZZxD-0A&oe=699C4D88"}, "display_name": "BangSquash PRO", "keywords": [], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-pri
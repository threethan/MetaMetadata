=1-7&_nc_sid=6e7a0a&_nc_ohc=eGaEFnXBNMkQ7kNvwH7M0EJ&_nc_oc=AdmLtdvKtw9NfW5V_ngVQhg5aRyMkm7-FGjQfWcLOHncwEfj-ghTwdR2xidUx4Qg-kw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsvxJXuUqMBcY2vX3N2KGQGq2chmgcuIOnse_5tA4pGhA&oe=699DA377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "197781205491543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982553_197781208824876_4790094533353552791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYHFvnsM6_4Q7kNvwHFGwni&_nc_oc=Admu-dV-wvzsaafiR1wrFHVK7_ZYemzWWYyqTLAuoK7hB_R82ytkrc4ubxgd6mxmle8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstyeTmbfv_EhEPUIBXL2HuuTk6pynmLr09Dx0g531HZg&oe=699D9F08"}, "display_name": "BangSquash PRO", "keywords": [], "long_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\nIt is an arcade game, so each level could be repeatable many times and there aren\u2019t two similar scenarios regarding the playing of levels, everything happens differently each time because of the realistic physics.\nThe game launch with a whole set of fun achievements and a global ranking system to increase replayability.\n\n!!!Orientation-tracked controller is required to paly this game.", "short_description": "BangSquash is a block breaker-style for Oculus virtual reality (VR) platform which could be attractive for people of all ages. We believe Bang Squash to be an ideal game to show off the basic operation of the Oculus platform to novice players, or to get in a mini workout session in a couple of minutes.\n\n!!!Orientation-tracked controller is required to paly this game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lebersoftware.hu/bangsquash-pri
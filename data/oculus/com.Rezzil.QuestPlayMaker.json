_oc=AdoGJi8NVpumStucp7pIePwhYxKipCsPO6zBaet7U_JJ4ADZzvYTSjT5JSZ-ias9AWI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e8N3Yo2MjTxnG8QPK-tB2BFuzZgrBrWYP9MKtGdbdwQ&oe=6A12EE0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Egbin6dahR4Q7kNvwFjvpP9&_nc_oc=Adr7vxdaB84hrl7roQNJOOWJlXxJS03s9ehvwkHLSq-1f_WxllQrz12mAWnX200XuSo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iQQyiFuwVSM65KtCNLe93XTNHCl4loFxqifIPqr17PQ&oe=6A1317FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLCWVQEfE8YQ7kNvwGlvVE3&_nc_oc=Adq-9WrkXNDj_aygw2DCRSzCIqgHPT7IGqjPuHy4036d2-izoXmxQoShLw7VSiVgwM4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lispzQ8us57Ag9BCaDP8D8KRSQhW4y-rqzKnn9N4Swg&oe=6A130DBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7Ob1PTjOc8Q7kNvwG_OcyI&_nc_oc=AdpCQX21t6dynmhvfHlJ9PtYBLfyBpW7ajoEA2itYVheUQCEKz_R38zEm2hyOaKgmF8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72FsQ33zRo65NIKsYVgdR1DLeUF0z9LTnemKTQmf3UHQ&oe=6A13045E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFOZZf1QQOIQ7kNvwEBg0I1&_nc_oc=Ado2Gtq0DlRt_avDn16cjiWV5yjH9PdfTEqVckRd5Ud3izRyXj1yOn_cqx0IczhZbHg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qhfZs-scAWqtuZLo34Fg7htXHeTbN5ik7utGawc3oMQ&oe=6A131B57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
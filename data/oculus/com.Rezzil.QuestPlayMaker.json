_oc=AdosCEf17oCgZxUTWqXQP6p8jqo_CmrxYdgolLkq3hupR9QOHnR1J6eB86VAFWPJ7Zw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZZkgL41hDtsUhxrqUsI2qHksvxlZJExc2-v1DtQIcrQ&oe=69E4C98F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KseKGQPKH30Q7kNvwGPvGRn&_nc_oc=AdoxwcaTRAcSUOdVCKR4oFH-HjwS4nSxskJN39JR57rPm7oQKMj-7xSBmom44EhhTYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sz4mtdcS4Zixg_gl-MDkze_WidmcykHsKB1Nbp12BYQ&oe=69E4BB3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjsnpBfRlDYQ7kNvwHUth3q&_nc_oc=AdqAmTpaRJu6KCvOwnLxLmQvem4bjkXGOFucgWmGOWbbx-of18hWyRjRMP_s6n0JxRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l5lErNJuH4J20VM0c-2EvBsCrpvGz8qLf4lo-7ubSBw&oe=69E4E93B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0snOp_hFqZ4Q7kNvwEUNCeK&_nc_oc=Ado4a-rgyvXrDgJTw8Mol14aop9-3VY503UZfxQh2Lzsd0TkMzw_TFcDcaxY8oJDA7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gtwkrqhBb7uxBSIzWaOwdCWA1QHJLGTpmZzUaq0kLfA&oe=69E4DFDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBS_tF9M1gwQ7kNvwFgyyjh&_nc_oc=AdrKe7fpBVONKfWIakNw7w5mNUSSiIZHY1GYmu3UJPXkxRWkxJ8AnmnsJPxqIQeTeqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hdaSdYz-LbcKeFyiN8ScwTR8BU0mL2SWgoo6jdpbyyg&oe=69E4BE97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
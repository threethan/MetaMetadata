_oc=Adr5bfsfcof8CSrIPpg3hvI7QSxo6sV6IGIOMbjESGIAdTtun28GANxcUoAihkvJPng&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2hRXJ6Kx5zEDSk-RUgRe6o6ZrxEUjIG9miCwnJj6DGw&oe=6A917E0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZgPYIdHCvoQ7kNvwEDSvRl&_nc_oc=AdokzRdAl_AUwTxHcXinJLgo9w0G8R-7ybVpWaH16qcXEXBYirU5vu__7tRPgg0In-4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhMlZbDmMOmJs8VGW9i5zsHQN2aG6FRBbDmj3IjKDEmA&oe=6A916FBB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJH-1C6Qqn8Q7kNvwFN_MAH&_nc_oc=Adr5N1xtwrXPrPUDxvRdbNi8JOoc6285DbZOT4HH2lpFkjdxSa7zTqBhbmYgsTaRfeA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpNRerSZdq4h_YmFhAwAzRsxdl_V5Ys2qyQeupKkpmFA&oe=6A91657B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaN7snhLHvUQ7kNvwEdQmxM&_nc_oc=AdremPggqa0YrFdMDPt6G-j6ifUYqCQUGJ2pXa4Kj_PELltv73R-TxXGN_IJIkAGGAY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5-BwANiH35cPiuKoYYzRN21QsKrvk67anl0CTBUY2zg&oe=6A915C1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AMuUltUAH8Q7kNvwGHWe_S&_nc_oc=AdoYxNS3owskYCNP1gnCsh5Pr9Ql6D9cf1AzU-SpXkMc-MnaulYy3bznTKF8FK8iZ1A&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_PMU8Z2TqGEZDeaWOG7KOThjtwJ5ZvkotlEmG4cd7gg&oe=6A917317"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
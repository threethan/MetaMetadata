_oc=AdpCmdot_WAg-NS2XI2JWivBbzxWd2OT7o2qWJWGiCdNMVeX809j_EoNqbKDP4KAa8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjNoneu_4nENtHOx6U0F8Upn2T9B0VZ0r5fXVU_qpakg&oe=6AF1F3CF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbkGUYxCvOUQ7kNvwGxXML0&_nc_oc=Adq7RFDKWBppr_NjUPlf9f5ZmRB0odCEmMOj-QNh5g3CqZTb-9gvyduI6wQYng3qRHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_D6aydPkQFzxgA1D4HVOhP_ocvTouVpMpG4BRRf2Qzg&oe=6AF1E57B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV8_wnM5v4MQ7kNvwHrzdS_&_nc_oc=AdoiERdCNE85kBPPaSeuYFaPJIi9T7BaV4rHGg_5cB1E8CmzVcDsA3vyhBhwVIg0ad4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnFWDLy6nUBMKS3K1NoNiIC6-QPRzJwnCS_klIQ38udA&oe=6AF1DB3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1diEpuzMa2oQ7kNvwF-JdSr&_nc_oc=AdobEdiQ7kwF2-EwyDqUIoHaKWEwQoet8yJ198rhCzWaaFBflghJzNGHe_Kzg1_6Ja8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2BaNNcfIIB2eoeNAdmS6K0T0587Q6gc2J18cJj6el2g&oe=6AF20A1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_VxpgtAUVEQ7kNvwEyBpR8&_nc_oc=Adq3hhgU0rO4FuLqM5PAm9j7hcnjm__FWOKtlJEyealx3QiK_copmma7RMkHev5bjWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSogS4Rtvjblspq5vsaza9txTlyAzLrkKtjbdWcltxHYA&oe=6AF1E8D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
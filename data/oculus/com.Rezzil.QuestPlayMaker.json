=69DB8B38"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPdQND-fBpIQ7kNvwHp1n78&_nc_oc=AdpEDdUO-7AWiOe6meiPppsVKGtENe6uFcxV0MPvepqkR_mxGVLlLvW4Jg-MLlBGlJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2raRmJsHGXAQg8q3uNJOvoodqg1PXO6S2kFKMOvCI4cg&oe=69DB8F0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R08QJ7NMEnsQ7kNvwFUZ3EK&_nc_oc=AdrT3HnlnKctUXBgX8VYFpIpAxEmraGTG22VrG3HzYKtlrDg222gcNe4A83lydbUu5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BRToGcRxW8-iJkFHZvaHQr8DGtV60BNkD9WLVQ1vNiw&oe=69DB80BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIlUHE4fQHYQ7kNvwFNNqbA&_nc_oc=AdrqhGfnv6V2DiddK5CfHX35fbUFmZ82C15izzx0T5YBm7_z1qTA6DCCgwrYLHhPXgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qnQutbWbGEtrUK68gMphDNoOxUw0H1euRriJdw-sATw&oe=69DBAEBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pI5USKYFGbkQ7kNvwH7oxcJ&_nc_oc=AdrNqLW2gtlI-_DzWCAWf6V0gzHDhOA8vsMhcoRYgYuOMQOMY2PEk3WWkQoVlULMgVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rMmYzDpsXhx5lRvBxrJRSozFDSeKrVlKe3D6AMg7CNg&oe=69DBA55E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIwpg5zdMQsQ7kNvwEuIQX0&_nc_oc=AdrSpCOkwT6Q83iHCb2FOgFj6QJPVIMQ4b3HzNTKJBzVHZUtDmjCW9lUKS83GuFVvy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N8q47-CSpHmHbU0x4bSDiLz3dGw1kqHJMULESse2new&oe=69DB8417"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
_oc=AdoBeNWgBswd63HM6NXbcENYP91btxrek_o-kn_BTlVSN4G7ooY1eAeV3o6DybXmjwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9UUvn_w2l_IDfa-sspSGFygFE_uhc-JmSRmZmTFttaw&oe=6AEF50CF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IO8sF7hda0Q7kNvwEv1KSA&_nc_oc=AdrOfOt6sTcH-XXKPRnN-aHWnE5Yj9RZJOXw8j6zU0p3HUOxaSHq7otTHl0uvnQItOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc1atifXJXsWW0DWvWxfLWZnCWGGI-PilBUD-UF62w7A&oe=6AEF427B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF4SUshWbAgQ7kNvwF47M2z&_nc_oc=AdpV7oMerPJVyjNKioan4DNW_VioOwXFms4htMsDJouydsHsVJrbc7g5iXKOlQV0rJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfJNBP8ZVwpotEjF-CtpfH1Lt4al3sl8KSiAwRQBTvJQ&oe=6AEF383B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOwD49l1JCQQ7kNvwHLZ8E7&_nc_oc=AdrAie1A_h8wjnC0rDIDtBiU0KY0WdOeA6jzh-sPMuKOx4br-dUc041P2HOy49vCNKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmGDGaVdzVo2CR8WzqoHdYL2veZnpoBrP5qitNXVxanQ&oe=6AEF671E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjvKZf0A0-4Q7kNvwHhUMvt&_nc_oc=AdpEL0LNsfF1h3Hx_gJlbAjQveRgBGMGc-6ZGz8VGsVLQCLHbXXenUxU-Gx_DB2bSIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4C9Sy79ufhWuxnVlaz6t6TT896TiPjMfi-Z_Kwjb-Vw&oe=6AEF45D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
=6A8C3438"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISHvOE_M6KgQ7kNvwGLcAQG&_nc_oc=AdpoEe5qgR57YioRsmNAD6D2XPIzBiVuwaril5BkwIv0IOJT_tQtTA5AREGTol4paFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ4c5yy1xi14f3rUiKX1ea78t8r47nJDF9IsvBdG8XLg&oe=6A8C380F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paLpbc8Ae18Q7kNvwGj08lf&_nc_oc=AdqqIZRGtRwIVLAni8J0IYmZ2YEkc4NdADzcVMA3ooJmujt0XNbTrj_Y7HgpGV40h-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwCjtC5MvhaTcZKKDdZlY_Y8ljVBOZnwINdnUtJSqfgA&oe=6A8C29BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQa9Lf6j6MMQ7kNvwEla26c&_nc_oc=AdpL0uiXJfsfB6kT4VEajFgDkwr_MwUW9z1BPRGWNOuckgluBRybcxbGNF2xxO673co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiCk6CxdbEioMCxq4NxRzTrjVyAuasvi5yvc6lQ7-TUQ&oe=6A8C1F7B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf-cmvcIsh0Q7kNvwFEFpId&_nc_oc=AdqJnwYlsEafY3lV58qAnvox9XWNXrglTXk5B47bWMsgkZPVu9bl3tTg2ONvgF_9JLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlPTMfZ7h1Ez4du1Sat2Qk6Cvo1-w2L_qmQ59x9VQXgw&oe=6A8C161E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jf67L_x7M7kQ7kNvwF3g98V&_nc_oc=Ado92LcPdOw_Rqrg2v37yEZMOvWkatyqkdv2IullnKHTn5OsSNlNcfLk5WScC2qSM2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIHmtmFlsdS8P44XyEZuvWY12gctzs4uWe1VKMgeC2mA&oe=6A8C2D17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
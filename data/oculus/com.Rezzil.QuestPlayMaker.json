_oc=AdreroLmKl1LnQLGx--87G5LXgxp64YysITnr53aw9mAroPZmw0VdxGyXs9av6n3zIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sVfpvf0_-ZVypUNKA1VXLQ1OoL_caKJ2YPIGoadyJgg&oe=69D2548F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0_fGvRDY6wQ7kNvwFdGveo&_nc_oc=AdrUAZXh2qMVY1RAMJh51nINf8tbMd6bYdlPyA4H1f-fMhfVmseNd0I0GRPmwhw0uM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08TFXmf0njo7nVSaburmJ1iqhSYa9ek_Z9ULGdyGQ8rg&oe=69D2463B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBF7Do7tIwoQ7kNvwGk642O&_nc_oc=Adpws3lJ6gQUYow9ELRcpK2SSTyzak6AEdx0MJpz43X4RkWylByp85jsRzO4HhWQGug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05DdJFjtjJqTCxCm78HR_PYquKsUd_u3DTbv3lbPKb_A&oe=69D2743B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=briqn4tvLwUQ7kNvwG_uJU0&_nc_oc=Adr-5lzO9pHoWthBZ6nL1m98QRkK9VfpVWA0NHkrqO_cF4tm6GQ7ni940D4brbHMTDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0blgAGRjPRyVJpbBtl2_DKo3b9tan-dnpADhDpOM71RA&oe=69D26ADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEoFyBgyYVsQ7kNvwG3fAI3&_nc_oc=Adpj5ru2ZcHFPvanaQUkhKmvsgkbOTOVcOGhOyFn3YbxgtJMeHNFdzVuKqNSmLvGVnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ImVp48SWiuow0bpCTJH5WnE738fVjwMgkygBfuhlYTg&oe=69D24997"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
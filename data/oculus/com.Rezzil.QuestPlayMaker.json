_oc=AdrZVSNa381_8Obs9Ct6Kgr4YyBEdnyCg2rxGFqSqBVB3aNKlBzEy99Zmbq9ej0ZP5Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmL9CggXYfdSvnl8kWh100jTrgVwTDliGv47NeSLs53w&oe=6A65FC8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oppjl062D28Q7kNvwEXCSJz&_nc_oc=Adrh2ezmbk7ey3Qhg15cnfN42-pQp2G4-yYRUDROoBrS6vo66ao799vpgW1rLp5R94M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1Z-bXIt_fBGwhueV8h5NXDb7N5HG58W5S0ZJqUZJPnQ&oe=6A65EE3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctqROSaqva8Q7kNvwG1Ih-3&_nc_oc=AdoeX0T3-X-bUvNF_XvzNRTgeoOUMIHvPtHioH1TDO1moTbnHn74fx-QQfjvvy8KuVY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQgbWRlMc05998ZCYQkOBh7BFn0GNXDcaylR_70wVGPg&oe=6A661C3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE3BwX9gm7cQ7kNvwFt3oH0&_nc_oc=AdpMdKJDpp42hF_jrTGdPS0mE5x7W-SaMYs-VceRiU9VnsLbBxkqfuFEWBrc7Rc4p0I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0MLUXTHVqogdSP8jgtF1ACw0gqOwt9DesX3-t3Uk0tw&oe=6A6612DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBc5Dtsyh3UQ7kNvwH9AXXm&_nc_oc=Ado7v5_2Umg_nVmkfG2NxUtr3_4KBlgZ8Vi6hsvhDEON6-epncQ5SZnaAlh6k9vgflY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmJwGRD4Qe7kttHwetZvRqD5fqmx_28qMkVUmUZF5P6A&oe=6A65F197"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
=6A259778"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UukxNyfa92EQ7kNvwHFMNAW&_nc_oc=AdqMosBF5jBNA6N6cyM8RU06L_e-GVLmOyrQyBrohCjY6WcphiRRUv2UpCiW5fwY6AA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KN6Kb7_AYE4bhHAF1h9mfUFL60maNotWLrDfRcd-eLw&oe=6A259B4F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yC5tfbHRqUwQ7kNvwH1qE9t&_nc_oc=Adr1jqbNYYt0iopZlg0bcrqxzJJDGHDfxfZMdXG80M65i51CyOU0106Zl_DI4C3SKSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yCnfTn7AMlSiWoRAWEwzYUKIqbBWr3qPDhNQs-buwiw&oe=6A258CFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWWs_42yJwcQ7kNvwFrflxW&_nc_oc=Ado9ii3z5c0YMdSTqZTLDMLVV1iMWNM09x1H2K7VI088WIO6iOj4H6geQVPBvSLDe10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2ToAriLIKar1IarVrSJEgF1P-MynHAGjegbJn2gh8ZQ&oe=6A2582BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPbTd9OKLrkQ7kNvwFTB0xT&_nc_oc=AdoHLe3qzGUftlozFV9hP1QH2Xf7bHdrZt6UN8HoIB275Zzx_4_r_QaHu5i8FlsLtb4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a3k6m2BODule_M2siTiKgQ0VEt5rNYT3C0F44RosKEw&oe=6A25795E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfO1kIkv2Z8Q7kNvwHsgQDV&_nc_oc=Adqe4Upb2HEQ_tJEnlwVUnqcAbPbxJ-8RpqPUfEnkevJ44PsKQ8QVNTMA-I8SLweeBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pUo_hjCNRh_8rqjTJ4tjZ_zsmznUnRquovDLB3kaW5A&oe=6A259057"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
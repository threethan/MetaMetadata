culuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRt2v8kV4v8Q7kNvwE4HXcx&_nc_oc=AdlAcCx5RAV4RsSVDbIBDjeDCSrhL7tanuPel5nt1_3gYIgusKclsj_6h0UG8c2V2dE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoLx6qQP5wEMvCCXI_cVhujBmayflIqYqH1UOJj1a9OQ&oe=699D988F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGemCksIv00Q7kNvwEtJCmO&_nc_oc=AdmWTsEz-fiWqYf72975QQlm0riWXIRfZNO3btS0moLVseVrNsjzDp8bhULZnGtwN-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuapUGlcBJWD0XTZpkANkDtJgM2J87O_k0LYOfuZqKupQ&oe=699D8A3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGv8yRqVxIUQ7kNvwFY1Y8-&_nc_oc=Adk22Jng-ix93fHUn3BFpd_xTOwWDJPBzaFLHqYW1SrrneRLvjkDWlqt5ynlI_99GyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsApsucrtMpnlZX0u4AoefQJ4JCB88D0iwmtJ-2ql1-xw&oe=699DB83B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9hAx9XFVrEQ7kNvwHaJBNj&_nc_oc=AdnxoA38FH6d9qCAWSV7e2aUUQwAb5KyJx07nYmUZ2-ukP5b6R27bkWDuGW82fMK6Mc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsn1XM4CZ-3PyXzhAqMNvBzzncB9aIezk0Mipl5Cr7K8A&oe=699DAEDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UKyTbBDULcQ7kNvwE7tAoa&_nc_oc=AdkZiwyuHpJv94fiD0BrgCjYl9jY_hfmklT92Tp9rcGdDHW7vWs0s_cSM3maZR844JI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft_-S_la9WAuN7xdyO1FfvA5-fA4VWAWh7su6O1f62-ow&oe=699D8D97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "cont
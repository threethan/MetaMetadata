=6A5E0FB8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzWppX1i8mIQ7kNvwHRQTzH&_nc_oc=AdrQAyN6HPQWtBfxMkovYkeXQHuHnBgUhd04knbkZgu-JGIk0oU1Al8STiS_zdse2ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6kCrz1hjYyIpR_8nO3aOqdUIZFD7QWDGf7JQrwIqJCA&oe=6A5E138F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gAEVAUPsuEQ7kNvwH8C6GC&_nc_oc=AdqQ_yQc_PMA8ZvCEMOMro6i_3U6zTFlsvUZoE-H4rju6vtbXQlSEhLParXljxzDit0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgF0YEgSz-0mzhL3bvmqiF2_qrr86RKznMd5cQxhhXyA&oe=6A5E053B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH3J6Sd8H_YQ7kNvwFmIhsE&_nc_oc=AdrNQpM4oycblHKuogp3WlHAEpvRMOME4xHuBHUp1IHobOFRUkYI1f8O1IJaiC1_fis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9xsHC5cjSmvcQsBQvWdqpkdXuHIWcqWVsVOHpBn4xrQ&oe=6A5E333B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoTadL1gSQYQ7kNvwFg4eaX&_nc_oc=AdpDb8jv7B2OlchalU9hzpkc0q-5M_QN7dBwY5FQd2TjkPi1VYX-75rhWIEunCDe5bE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfJHHGgPb2PiO3bY-99aMuZMMhJ2PHdRJNtawNtfSIpw&oe=6A5E29DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKMSyCFMLjEQ7kNvwHU-_uy&_nc_oc=AdobMaEnRXTydzEmzx8x56VQcgn7kDAwD1DK6Xif1PXViETYf9x5VivONusGiozr9Vo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVQFwR7m1YpXCvn4u1LqZnsjwCj_WHGBq_YbJI6cCFBQ&oe=6A5E0897"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
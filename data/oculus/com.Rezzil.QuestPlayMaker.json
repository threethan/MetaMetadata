=6A71D638"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu0OSU-SFwwQ7kNvwH_1Rbh&_nc_oc=AdoAAizKz_x0Y15Yd9TWYB2syEBU4_JjLsZE5TIRaXfDBVwg415pibV1vDJLCaZstEE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdLqKNTCzXwOhPkAS2lJD_YEU-kLlx-GlGw5oAYqXkJQ&oe=6A71DA0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7oCgQSAUKgQ7kNvwGw9ksS&_nc_oc=AdqD0ejXNECIWbLv4uYO35A1koeLtPgUPgFFwMDLSpv0RDJkAT6d0QVVGlYULCE0foQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHglOgH0SbJvWXpEXAdcIdP3mP08IZHT7yPTmFxFZ9ZKA&oe=6A7203FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLgWUZGOEFUQ7kNvwHs6XuA&_nc_oc=AdrpNj3feZ6M-1kGzTUa542QPIBBAL0rR3tVpuPgVP-S5leX0sRPhtgF6xe5l-VkWGc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdTsWuKzCNMEL7YGlazmqOino5FCAC8uupGd68CPf5Hw&oe=6A71F9BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NswQv4DUawQ7kNvwHwFTbc&_nc_oc=AdqYhnd1d-N2jtl58l0MwvWm878Wahgfs59-uXZ80_sTB8OY5z7uaoeVWuQsj8bV9H4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEziN25udx52X_8PDe9J8sMEOcdQbBVWWgiiBIhHhc69w&oe=6A71F05E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zMQ8mjHJakQ7kNvwFDoPlO&_nc_oc=AdoF08D9TY2Qzl6EmnfmmuaUlhJXQDekAW-qS0qsxT-fNmWqCB0KGs1-hSSQsQ_ScmA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB1LKcFOZcZ3Sc0o1hkz1LX1Blg-8mKWM-k6evfybAAg&oe=6A71CF17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
_oc=AdqpJ7ZRxCy5KUHevisXa7814z3n7CFQB9Io8GqLpwmYF9E8zJ79-yZHMHzGZPf3s1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AOEwUKy_jMD8GmP7QCN3CRsRq7fIX2ziEivcRnjpCsw&oe=6A1ECB8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdCkUk1dN3QQ7kNvwF375f4&_nc_oc=AdrTn4JrdeG5fA32N7kvM6mVyDHG5UxlIFiL8Yzt7lE-irdfp_8oMWe-CwPcRdGpgcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QWzX1IPQ7YFssy2KbN8ZUzQ82PxX5p2pI1TxKd76jRw&oe=6A1EF57B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDe20KNwcfUQ7kNvwH2qyuY&_nc_oc=AdrTa5tHowVK9T0wr8vGu6jsq0banTYvWCNBfutP6BpsyLNxFXPYxmNmtHAl9LtExWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ipF1tOHLZUgYVfAmoBo-iYZzSfzwYFeKtI8fHpo5hAg&oe=6A1EEB3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8zfvU6ILQIQ7kNvwEzNUb3&_nc_oc=AdpM_h7kCj6Gx-1-v6RA9nTWHe2h4m1SBs0M3iz2Acr7Pk4l3C5e5a7PgkWsrLK-R2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cbvhcvX-2UwKncOCz0HQHcSLkEZXL-xjAGST4zCJZlw&oe=6A1EE1DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kffF5FcvRkQ7kNvwHS08mG&_nc_oc=Adrrei8r9H4qW0MVYdIIYtiPc4aeO4GJc-k-OoN1caFMTBSERPlw2kFPilHESc9NS_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52nzDa_AJ5NvUor9it9bLvkI5v47uze_sfHTH8XVJFjg&oe=6A1EF8D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
udc2w&oe=6A8D85B8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISHvOE_M6KgQ7kNvwFqWX15&_nc_oc=AdpSPpQ7mVK_zYxuS96zimfK1DaNWLXLkhK99xN9WxVftKcq16GfQ08_ax5P6uoxFu8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg8CGu0i4MvyQ_j6sIloysjvZlZ_F_UalpRkLWStPo8Q&oe=6A8D898F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paLpbc8Ae18Q7kNvwFmR1wb&_nc_oc=AdqH7VxRKbfmxHd1GAcot_1wSfQoazoMH-9F6XklWR2yHwNChI7TgV9eJtbr7KwoVV0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr53KJVtceFqERmHpWf5DDsn-Pug8MA6rRkdAJ0hXPzw&oe=6A8D7B3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQa9Lf6j6MMQ7kNvwEHk9C_&_nc_oc=AdoYfAE8bioU4Sn0FNP1GXkt15Kl3J2uVteg768P1nL18LGcILN7T8bIuv_k9TqPDhY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-ayIQqTxr5YWgCk7eAz8RDsC8JxorxrEu-DGVGnSF5A&oe=6A8D70FB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf-cmvcIsh0Q7kNvwEuonl-&_nc_oc=AdpHD5WWGV36l9WHcZ9LyKMDrZFNq3PkyjAJjBrVFbQre85frfS_xX3FCezokAI7JwQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcNY6UZpwUf8gs_-OuO-srBhuzfrGrOsLIHw6PdxL8lg&oe=6A8D679E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jf67L_x7M7kQ7kNvwFDEjQj&_nc_oc=AdqsmnRfXfuN8CZbhwDJDlwW8ezSR2_-mEh3r2zuFHecABu4vpN8jP53j3XojdCk29o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj8oFrY95XZxBXtf6G6PyfYFqYHT6NElGkASn818mqKQ&oe=6A8D7E97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzi
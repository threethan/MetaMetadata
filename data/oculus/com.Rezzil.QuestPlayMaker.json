=6AC279F8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiY14RxkubcQ7kNvwFq1Wmb&_nc_oc=AdrtBA77aBksa5-OpVXRGS1iyK9TAgDdrTcgCxmf8i7F0c9RSD3pm8USB6mirTtUWkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGjYLZNzeKCJU3dzhK4S7IKHUeMRW1qBXTUeDNBCvOIw&oe=6AC27DCF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9S_2SETrDMwQ7kNvwH8dW_Y&_nc_oc=AdojzxztHktVRft2RGMLpv5tMqbpLOY2gQ4QlYwhpcMM2EoTaRwPZL99iFqkFN8GXkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNipRvrqdfF6wyLaJu6VIJxhr805qxFQe1kY9wurfiSTA&oe=6AC26F7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP9Fo1Sm73cQ7kNvwG-SJNX&_nc_oc=AdrK2P5qzpcb15aBDnbMlKTmWV30BNcYtvu1dW2VMdt2LxBlde8zGpWRfHrxhe7jN0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxDswYjqONVPiGFKR7DLYg45ev_jwnc9D38AFUzIcZZA&oe=6AC2653B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCX0Ef3RDLkQ7kNvwEe2szs&_nc_oc=Ado_D6BNl62hvoY9i2bMcnUqUTbh3jfXDNqnMO8g-_ZsB7P1UyoN10Lo5FNGS-eVC7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv2tSdprwQkdPZmzF3gZ58NqFQGb_65mC9A2NjLI9dpA&oe=6AC25BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7AIfI9jpjgQ7kNvwEG8PJY&_nc_oc=AdquFgNcUKrKjmjWi83Gtyo_t7DGmH-Cr5ge0zDZe8cwzxAtp89cYEBXyiJirXAzfG0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSK7Q5wTnS8jDAKxY1S3-ER6PEFfFtFdcoHnObf9pXCQ&oe=6AC272D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
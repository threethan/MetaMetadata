=6A5383B8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVdSlvgwcZkQ7kNvwF_EKry&_nc_oc=AdoRT0a8qIM7xNcNIgypwhKJy2B42k3RxrtA-HbOB-7GPktcfFAHTJVvmYBCqLdbm2s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeyh205MUngwEBX3w6H8VMTBiVDu5xXqAcuHd5NmVjUg&oe=6A53878F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv9KL5-ykYUQ7kNvwFPcFNY&_nc_oc=AdozMJ-I533djV4tDQLWn-cxfHdHqHHdWHfI17TuqzYhZF2BCXswsNzCC0s7OllWy4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMJM2QW_N71fQ4fjaNOCFEikN-C_QXRP7dOW1mrghZSw&oe=6A53793B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AC6a0gRCp1AQ7kNvwHmmZQS&_nc_oc=AdqczhfGYi1SlKQubgrZM4p66pJA118upEBViJ4LAQVrFwUYlpqDfUfEl_G70-CVzNI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-8ow-dVBM2lxwDBhuVOzGkzSQx99GhQBnMUxqb4dK3g&oe=6A53A73B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_CNXaOxNZEQ7kNvwGqr-h9&_nc_oc=Adrn1ADFdeL-GuFZ9ON29eYRC2jivsPMUzEG8vOiIOftll0Yeg3Modyj7czWuVs1imU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8xUkPUOHkfhHVeVF6U3uU_UwJc1PU9ve07XwKJoS1dw&oe=6A539DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcTSDUruJ7gQ7kNvwEGTSwW&_nc_oc=Adr0NXqSqQRsLk5NSs8mz8ahCp5Jf009lU2jkdmEVQM22_-LYmK_WdSYomnfMbSsims&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX2ZrClslFXuzhiPlnBwK6Jo0SSeqt1GKeMxYTrJe9wQ&oe=6A537C97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
_oc=AdqCvkhhwvkpe2zOysnQN6WR6vl8-LvcOmnrfDSGFfgxQ48ot3NiOWHEiNnU999lvhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLWPvyteXrIyDlRIhHeJy9KDdeFq_65Bv5Z-crs8q1cA&oe=6A69F10F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asuOLE6TWSEQ7kNvwF8Fnch&_nc_oc=AdpPFhxM_ORu9-qgwrc743pgyuBBDXPqipb7f34Belj1_KSTHWkv8PmFCiouqmXqgiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvx86nY_pI1ZjoUQHrJbfz5moNDF30aD0VcChJcTMyWg&oe=6A69E2BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5twbT60M7wQ7kNvwGNL45s&_nc_oc=AdolGcsC5eH1yn4-MwYODNPiNEar7MyineoCwVvLhbVCDDaGf3Qyn6Q34Bmat5puqVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoIkQG_1oFnjtvU-OMJqAa5EC6BG-I7lOp_7efj4hIIA&oe=6A6A10BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Okiskkd0I5QQ7kNvwHfpRWG&_nc_oc=AdpYPDMqvoCbHNlqerRfteps7RoMCxZF0dbysrU6X5YX1r0nfedscrT7fbh5rj9Q6yY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHjYLw9Z0UpmiFgNMZGTkb8e9TMHSnfrPVmMbyiCDy9w&oe=6A6A075E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUP9RQhgcGoQ7kNvwEgaVyi&_nc_oc=AdpPAxb97Y41U7PUntdSyvqSngvmHUH-nvv2_jfcIDMn6flXSPkQJjWQW3mZXEajYCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI8AlwqfP9IoQWDh19-29CMi0EVWYa1WKaO8AJMeX5eQ&oe=6A69E617"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
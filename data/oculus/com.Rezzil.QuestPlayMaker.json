_oc=AdrgW1BLgHMlR4eLctQQvv_bm1aZEMBP9GOeaO4FzXQ67JmEcKc2yJ8cadEvPMC3PCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOea1TKwnKBfYtIIEtiG4HmBGdKuim1ssQdU_seoEA9HA&oe=6AD24FCF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhagDFtAdp8Q7kNvwEFuY2p&_nc_oc=Adp3cB6r659zpdxjJ-f563uqXUdPAPeit8ZtgT2Kt_Ylew_ZnXu8cqX3gTDQ8Gc__No&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBo2VOlUUOVyXAXK94N2-_tOwLJXbPqEEOHKvUeW4ofg&oe=6AD2417B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi6q7NJCSDgQ7kNvwFUQnxg&_nc_oc=AdoUcZr8ImFG-4RXXgTIR980h0TKlLcJb854MiwVykK_f8p1waQ7ud0c6z1Jh5-nAcs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi_ba5RcC1jt0JnUn3Cfyj21c5nWtoKapOCSNgaQ_RnQ&oe=6AD2373B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8BsNb2GHjcQ7kNvwFbJ_4Y&_nc_oc=Adr7I495g8n4wg-DTf5-iYlVZNCo1nQ_PrEKAnqD5SEaTgrInZ2b_xaLmRqv6hZbG8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW0AIbCKo6Vg6nU2LMpt-pHrcQD_A_8Vs2E2_sXYhW9g&oe=6AD22DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWuwtlCAJbYQ7kNvwEJljX5&_nc_oc=AdprlXsyf319ol5yLw8tk74uTpchMCqGYmWUBYbGYr_LBaGn0t_DSoWWi2X-vkwpfn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJVlR4dH9a2WnszIPcYTGtc1HJDI0QqLzhDF69QgOzyg&oe=6AD244D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
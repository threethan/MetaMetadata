enshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3FZRucdApkQ7kNvwG_iS0w&_nc_oc=AdlW-trRhab3LAn5wXmTR4D64JnDDUlVobHwubty2y9E_NNpIJTUEHfOddrCyulRlCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIE768lVjGVL1vLL710Zxd3a7IWTmPCdek0q3_blCmiw&oe=69B5538F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s30clDaItOUQ7kNvwGhltsc&_nc_oc=AdnZaB3UldLtPh02JeHSZjFcpkhG8UrWHxrloq6zun7iRy1ag9OzsQG0O9XbWwLPosg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyntVTsoDuBBdd24L9GhwgzmdZqox92a7Gfd6oiEnZ2eg&oe=69B5453B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwWvCzuldM4Q7kNvwGcVham&_nc_oc=AdnSNbOkg8ur62k-3RlvV1EkKga9z6O0wrzT21OK5h219pSTfHU2oWMwX7LzJu_MH9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRN2r6SYSu2ALvvS0k8WJmoBuh2BnZKDUsgn1EAJ0NSA&oe=69B53AFB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzbejogRQcYQ7kNvwGEOAAI&_nc_oc=AdnnEy6k0aiOT60ZIoIaj9lfA0yeArMnnmVcms-Drou_jUViVZt3LhKuA3KpyIHngQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzwdVb8lpJqpqxK7k0Q4oqoh09ztSX82Sbuuy5kUFibyQ&oe=69B569DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9MBeX91fkEQ7kNvwFFmNhs&_nc_oc=AdmgQZMFmLuVFdMrD9zxjxahHXThHcB952kTMbHK59IDiK_Po7AKLg1wWte4N0dZ6CM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQFwpjBF3Iva144MtMh_qUoANtDRb5DNXA7CF329db6Q&oe=69B54897"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com
=6A3417F8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrI4O0E7iyAQ7kNvwFYM6Ie&_nc_oc=AdrLdzAFVoFriBDuPD7koXOtWjGPgltz7hYhO5RHiCnT-A5L-dNigQZ5rnf-_pReQOQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p1b5kMGW4MMFvXMqyRKIDpNxq54-pzyw_Fo1eFCk3-A&oe=6A341BCF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7KPOZ4Nu-8Q7kNvwGIow_z&_nc_oc=AdrRoIIKKUp-fbbHiCATxFtqHeltBh8WdP8cYmP274XurnueZdD2EmprukrxjnVgbNA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__MtkoIb3p7Eshth-D_z_ccLl5Al3qXZw44DQxfYxfGQ&oe=6A340D7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJbr8tcxaW0Q7kNvwH7t2xo&_nc_oc=Adr00i51o-I_N17Gf1I_A9FauX060LBID0t18u7ZqxJv1nM_cx_u7PJxsMpD1_ceqfU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nVTwbV9MHrmsyrDivQIrSUtkktRJfxVXQPCSOA815vQ&oe=6A34033B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htwQk5hqgY4Q7kNvwHZjZQD&_nc_oc=AdoV17xb_bgvuuwywUQY56OIA9vS1jqft_-986SWtzJJt-7jj373xci6OM6DmAaKbsI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nr5cvswCYWeQjBhjFhrWdr-P4-0Q5O7C5r_qt9tBVWg&oe=6A33F9DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85TnVi9eA1oQ7kNvwHymy1Q&_nc_oc=Ado-dV6GXz4ibIH-ioJtok5R2nlchXP4UFaR9OsU1EHmK39ppN3Vxwtn9Y2Ql6bG17c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yu3OfWy9Rjx5G40PQug-ZAvHZ-sE7XZvTdWiPfGyFrw&oe=6A3410D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
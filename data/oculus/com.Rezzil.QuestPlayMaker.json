=6AB3C138"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fUmqCwfE1UQ7kNvwEaOUdd&_nc_oc=Adqg48I9ks-D1KPCAEVRtdBuymt_5YQxI1_tKL9UgB3gVlPCZsZlOBXg4QfncD-wYxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg8sI7lVhkTMT6BFagj0Vnn2SJhno_oF7uNKtaONmdtA&oe=6AB3C50F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C78HRtQthYoQ7kNvwGu5Tf5&_nc_oc=AdrhpKSepImZr4p_l2ANFDajwOAIg9YosNi6eJNWoYTBG_DJ4mV-57sx7qJf8vdDANE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK063-lkf7PioEzxc0vS4Qgbj3ByGjEX4dR41ChRw6Kzw&oe=6AB3EEFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHlno0AGXjgQ7kNvwHXqbAJ&_nc_oc=AdryRGccfaTseYJbnSlKvuv7iH0ed1tZSgsRyn0ttawlqNuD1ImHftNbI6uIL2GHvFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7VoQwkb5_1guPZBAqtcZ-ho2dXL5pQ1dHiDH51bU71g&oe=6AB3E4BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj_PtXlw3UQQ7kNvwGsIUev&_nc_oc=AdrYtYuBwo85-l0FIBj66kQuXIyEidBGdoj5hZ1VHO7U2_m-6oQaMVv6UWS_qt8HjBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUy0n7ADxqZkKMZ5SMecGM9KntusGCJSp_f9iHXRFhpw&oe=6AB3DB5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAwYeHQg1OIQ7kNvwFyKik2&_nc_oc=AdoSHxrWBMN8GWyy83TIJtYl-Q9pmAZUSC3e4AznFACtR4dp81JiLBXat-w-q9R51Go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuH7viigTK-dfh7ewDiYnwnkYVgglBhg-DaFPLcXQ_tg&oe=6AB3F257"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
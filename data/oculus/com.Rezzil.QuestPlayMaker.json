_oc=AdpqXSGL-Ebve27KY8a3VyV0ExsbERHYsFqf_FyDZ-yOdvn3E3Yap_7THSTwA3aB1tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYdjkQucZzTWv3OYbIzFaNLooWzbd4oIcJK_HKCzchbw&oe=69CE600F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDx7EW-rqmMQ7kNvwEFKc7c&_nc_oc=AdoXLqxe9ASR_EZmMKjr3PNRIsbgwtjJp7qoDQ54oLbOznEbz9z9pnj2oP8wWVdW-qU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUKaebHvg9X9kJaVS8ahXufROHHUQfinPMgs5wUYbOfQ&oe=69CE51BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRxJWKOqttwQ7kNvwEJ1cCl&_nc_oc=AdpcibpsWE6WuedvGnDmxR3BpBjU-lw3-zIubGk0NH0yu2yt1RQbTfZrv2j3RUPdse4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRO7lQaf1qeGP3F58_ToJRec0wFok6zDyxoWzbnVqIJg&oe=69CE7FBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZAn6I6oNWgQ7kNvwEEeQkd&_nc_oc=Adpw-vrtVeJh0H6LwVtcvw-7XkJvmDOsZGcW-C2AR1mFDZdJ3w-WDEpmtRqtUwe8GAk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUGBWIpWh2PClFVo3HZpp0fBRuHz55JNk1d4jkkZkiXA&oe=69CE765E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O0p954bx2MQ7kNvwH5HjUn&_nc_oc=AdrjiVda30lbLwFtl_ktU7ogciOXpomLzCYiEBC9uQZJB0hDMPxl-iX1tj2jYuVwIbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrNx23Lw3NPe5i1Ee2PZWeBENSGHg0c-XI-WQwjQ0BWw&oe=69CE5517"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
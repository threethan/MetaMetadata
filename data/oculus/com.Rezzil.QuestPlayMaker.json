=6AEB5878"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEgSPBkHUgYQ7kNvwGJdiXK&_nc_oc=AdpfY_dIo-6k6iPqqW-i8jaW7bwsDPa_6xTLlIOTX7DEd3jGbSBlICMJYZwX-Kvjp9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_9vNn2-Uf-96WDcvltn_vFsc9CvLJ8RulaBJEJ3e5CA&oe=6AEB5C4F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=927YIbJ2Xy0Q7kNvwEC6vTA&_nc_oc=AdquaCEy60P-rsIvKYlibgs9STKjwMiJZg1RIB1tmyyJKCK-S1cl-1R_g7nL8D8eC1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIPv7Y3CFUkoSNblkOMIa_G0qIYO70r8hb65U9SfSnYA&oe=6AEB4DFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUES-1ECA78Q7kNvwHgAARW&_nc_oc=Adr1oj9cpHbUSsAhrW5L3IGoMckSm_jAPFbpE6FfhTRyELOx5nDHSooQKKeFBeF_7VY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDc8-B_PHwNaWBW3kEBVYTg-UEpv1v2oD6yW4BgqxZdw&oe=6AEB43BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-2t6Tw8lJgQ7kNvwHuDvkQ&_nc_oc=Ado1LZ9hbXJaswPc2fydqAlAoxdnF6unHpmUUnz8wbjARChvgAJgZUI6PwYqfrsMyao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtoHcXaBEDtUmmxLrJRA3WTc9u1Vq9TPnnRWe_y3UY8w&oe=6AEB3A5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJM_x4ut4koQ7kNvwEOF7y9&_nc_oc=AdpUAlYkuCG9WEA-ThLopPegx7hO8ON6vDeicM1L4RQGnEy5LXgXBsfgZUR4wFn2FUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSylO1GEFXKyRUMJzgsv6R-qZWs7BKsmBHGwc_AL455oQ&oe=6AEB5157"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
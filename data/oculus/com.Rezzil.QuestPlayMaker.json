=6AB69C78"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTNV2y5HA8EQ7kNvwHURCSK&_nc_oc=Adp9ek1xkCFWRAvgd9zZDXBL6xKs-a90VeJ4aIjXTb_GBpwCBwmXvi23-IoBW9BnGlo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIykY2QGxJikErJaNObGiC7MPdc1FwGPDATcGMK82lgXQ&oe=6AB6A04F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhFIFgHQA94Q7kNvwFTeRue&_nc_oc=AdqzR7Kd46tFYuuxxqhQ7zZKHb-H_TxCCrbc90bMCv4ngoMAkfY5l6Cfqg9nZxgf550&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJepANHYQiX0rE8p0o3wb5DE46LgrpTG96c8Zq-dXfdTw&oe=6AB691FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHlno0AGXjgQ7kNvwFA7L8-&_nc_oc=AdpflouYXhQbNbG2Gw2uqP57TC10iSiAEdiIQH-1KMJUJnpsZjR-y-sIRga53TWsYSE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISNtMXP11WbsKGYSO9Ot0mtVLtspiqyMo1UlwpXl_etQ&oe=6AB687BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Pc1qadk0CEQ7kNvwGozjyV&_nc_oc=AdoJDEQgBkWuxSRLOPXLKRX33Ejqk3jFQAA2cCFDZIlFX59aSTrgwZYNwtReiGAweNI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLman1xz0Dm41BWVUy3TB8Dp2bwk8QZqtZLfNiLcw2kDg&oe=6AB67E5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1v5_xdINT0Q7kNvwHVsNnM&_nc_oc=AdqurJoX7PtrIRcvZui9mbwe8ZSobGcLNS1PX5reWumz_snBTTNHm2_tImrq4oJJI9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYbIbF-xbDF72lLveVSEDFpdJUR_YsYwLc23uGG2_5Og&oe=6AB69557"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
=6ACE5778"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocqitq8vgvsQ7kNvwEMiqJg&_nc_oc=AdpNicxgqVwgx9eTN09nGX2XJMTfUKx8NlOShVnEzyIzDHGbZsbqrEI9XTsTA4SEg_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUQIHICVx-_4vMqbyhNkOO2cJUn6LxQzxoRWXG78U8WA&oe=6ACE5B4F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG-tBxVfGEcQ7kNvwFPvEl3&_nc_oc=AdrncLlJR4bQ7VXapk_dn4Cdngih8doCKze3gtynXT9qHf1B2vjq6ramf_HVwXecKpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIVLAfYGTUtm0TFNmQICQrrPLcE3XbpUfhXRby_7ONCw&oe=6ACE4CFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu9uk-8YSggQ7kNvwEnnzZh&_nc_oc=Adp9G0TfWadHZGB6pGJjM7t0QAvh8H7BuBwnVBs9T52hv3nDMOUNFBGwI3c1y9916o4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqGicJM-sGTT8x0Nrx6pgp53UV1b8Y6MwFgt-u3-FU_w&oe=6ACE42BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BPgolVFy78Q7kNvwFxNN5S&_nc_oc=Adq4fOmZmyqTDZZnwoLYi2_x46g1w7m6bOcU0oImPUPV5mlsfzonDzSn0xkg5Gn88tE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUht8mnroDHDOXJW3SkRf4rleAXRjwZ5z2_9YmuZQL_g&oe=6ACE395E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obVIjrj-IkcQ7kNvwH8f4qK&_nc_oc=Adre9Z7OyinK30I1SGK_87XYbDD4A5Gs4shfARd8jFILnKSTqngmek-8O1QO1vz1nwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqBQoSZ8jBtgdgzOTjxgTzEMIc3UI5p9KL0_Bv9l3eYw&oe=6ACE5057"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
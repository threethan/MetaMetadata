_oc=Adp3p_W-Sj9Ti6X6yDU3EilJwGwWrtYrovDiGB3-lhBbe1NmC98lbWRIf3WEDxJAPEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lcaC_yJ-kGgw6YIvkrTqT0m_qI11kSOsnbGLmNlIV-g&oe=69F8900F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZA81vPhUS8Q7kNvwEPQSRr&_nc_oc=AdplY2zJZMoeN-E9so0NTWrP_H1OF_zmjjJfSiCAo1CkHw8l-UK5C4o4TSOzYX8CrxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0It0YPf0cb0A2C6uCYE-wO_n6yxQMhRHIZob9iG6KZUw&oe=69F8B9FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1WhwLbExdsQ7kNvwG0_iq3&_nc_oc=AdpDJ7kBzhyd3Mm45ILrOdf4aNwmx4CfB72k1nSannOJvMuS-gSNmw9Ygn0kKG4Lgy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ucyqHPGXrW71Y7B5-1x0w0IrJUaC_XAR3GhEit38HRg&oe=69F8AFBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtwJUS0uibEQ7kNvwEeEILT&_nc_oc=AdpRPTxjBn96RXZH8TISVzk3YLGFZasuh5PqqNKmNstHqbc_BR6Eqx3ucCO60np8als&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sWsCTVPFTkhLVc0h8xY04x4JXctIf5fIGzpnO5Ff6_Q&oe=69F8A65E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL1O3lIR0oAQ7kNvwHlS2aw&_nc_oc=Ado3Yxbj2mD4OOyD-YM67JKIUWc1POwK159CV7cPDZWuhv56qHvb-TDQp54hkppqvBc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Uuqr0yF2jEcjUO1_7j3wRV288iL1VkoUqgXTpdXwUBg&oe=69F8BD57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
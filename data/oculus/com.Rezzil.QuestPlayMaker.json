=6A410EB8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zoob1lClwocQ7kNvwE2ThtC&_nc_oc=Adq9Gt95muK1lr79x7xJa3SoX0A9IaHqVDrOwT75-eMCkX_Q11USKVcziXyHzvcGJhA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oaLSsem0GWX9xQVQluRNi4605h1g39uBogI1mW6Jsiw&oe=6A41128F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alzY1rTs2zoQ7kNvwGmLU0l&_nc_oc=AdpT4x67veW8gelkGd6GxTNO62X16ZmlyOrXATd-qRoeWJmy0Jz5xEEoaGnJ3q3ClHg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r2VBxgL6DbKqkxl62mkGj2egf_NQq_QOLanW9SnRxwA&oe=6A413C7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSaIUx00G6YQ7kNvwGDA8t_&_nc_oc=AdpGpCFgUUVEisL-hug2X0UB1xz6OQKQ9Slkupt2RibbqOt-ATAu9XXBtAJnJEgJ4u4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wIkb1F1-hX0Jm0-Bqbk6SuG6I9dvtpOkQzJUTyA7eVA&oe=6A41323B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BhBVLRjr_8Q7kNvwE_tQaU&_nc_oc=Adpejnkne_e41HTUnkk2cgh_DC33yprxO-2i6Q_BCqXEI-m7VbZziZXb3n94dB58BYs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W4cAsEx5tb91-yVyovTumMFxck49inwfLavuBdd9fIA&oe=6A4128DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gP-xOVdEPQQ7kNvwG_9wW5&_nc_oc=AdoIZkl9MD4xQhFN6noxoDVU2x6OMJHXPfwBpE1D1guPGvZzn-GJrmyR4b7Kb5Lf0G4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WinalDNmbEk_iCSAHpHZkK0WRZk61hQo_AlntRbzFOw&oe=6A413FD7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
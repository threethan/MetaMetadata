_oc=Ado9rwI9P53mNqhFGb5YtdsNd47VRYHf5Ezbjkqe7BBbZAQn8yggP_Hv6H6ctxX2zJk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qWBjxce8DSrBQ-h5gkwNM0QJ1a5rJqg20WoHmtHWZMw&oe=69F5ED0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu9XQiGlXUMQ7kNvwHCJUBT&_nc_oc=Adrbijw-ae373rjJo9_HwJNLSUisb4st5pYpbbXEVPLAb0M6n91NIP1EsUp4Qvu4gUs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VBosesZ_yrOTj-EU2_H3ZsUODTSpijeiK4lT4w_uyjw&oe=69F616FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1WhwLbExdsQ7kNvwHw73k3&_nc_oc=AdoVBNTP_pXPQLzYr8tYjqqGgW5Ix6hsmwBU2OTHIPMrt9hmFXbZS7psJqyA_TGJ_K4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0t1DJWoaU7OoVwXXInDnyBXVep9eRlOzCMANniyMHSKQ&oe=69F60CBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3wXyDORuccQ7kNvwHBwUS7&_nc_oc=AdqKPT8Z1B9Mybo1UU3Ca2fV4ZyC3loZUZD2NGBaki7qi1nnxMJjzyeYBo4XIE0E-IU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hc05nYL4grkJ09v7gVlhiZk5DRlL9XNtJ_cRTUBQDHg&oe=69F6035E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2o79aHmY7QQ7kNvwEvqiT2&_nc_oc=Adof8PBRgLXbkO6RfmQet-eyOcNt_R0uWFOLFmByrsrj8In6UIybw_Jj7ZPXM2cVAO4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0csqQzZ01NF4QdabOiBX2VhGnuP5EoEef3PMeGJjii8Q&oe=69F61A57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
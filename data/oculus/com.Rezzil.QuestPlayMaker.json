=6A2C2EF8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ab867XMt3UQ7kNvwEltqTr&_nc_oc=AdquoGHSNyUi8K52akDLQ3H3wPrO9yutcpiDpcIbjCGlaf8IXdY_rWVWZ121Mrwn0bU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HmrfqEO3p1yeOkTjm-f_Gtcfg-DFf1ugrzFwWzqyuIQ&oe=6A2C32CF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTwfh4L_K_UQ7kNvwFD_ISk&_nc_oc=AdptjzU9ldCLO79b8f3pQjAUQDmvDNmyWYZo49DVz4lto1OfYVdHsSwYLd4CNCqEGVg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D-RfcKZOkMxdE23x_cvqcHlBa-Nx9WuwArtK0jOU4EQ&oe=6A2C247B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2s0zQX2fNUAQ7kNvwGyBndV&_nc_oc=Adod910Xw0VKxvtGRGm6X6y1oJm98E2UIZfG5st-lcRCleznqzasWjufbENDd9hZRes&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JgAMBINNLelUQmDoCiKL_R6ar3ZiK3jGgX3BEv-AOQA&oe=6A2C1A3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZmyCTKw7ccQ7kNvwG_Tqns&_nc_oc=AdpN1lDx6VeFgXqBnw8dOxMQGvogb5fUP6yoJPibeVsvWQ_ozIlOpLpS9zkXRodDWxU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LmDaigZ9iP3PQQiG8CJUiQNomZqUiApoKiRVZb66Pfg&oe=6A2C10DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2X_sfNECSKgQ7kNvwEM9lP4&_nc_oc=AdrhFO-PbaiwRWuoFIq7NUfJiAqbsB5e_m4Crcfy9wAQRIHeNtr03lWGmuMTbQewSK4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u7AfoFQ0t_pqj2D0zt-GKakrQ0B3mnT6ZlE6rMsWiLg&oe=6A2C27D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
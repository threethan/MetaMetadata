=6AC12878"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh568Twx_7AQ7kNvwHL3H4m&_nc_oc=AdqnBvPMkcCqs2_jef1qA6Sa2MN1Ni0H4RodTZd1YQfpLrVPYuRUNuXa2fIdZxKfQW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuZwaeVTf2o-GRUHXsCZXqJVEwkyroEzhaZYdWpFXN_g&oe=6AC12C4F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayi5jpHJoIkQ7kNvwEPkzv4&_nc_oc=Adq2mblq6qVJYhwWhbLnxSokHpYTJuTzAfhgMnHw9uumO9rRbeGu3s4OnSHd3CcdMng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv5xAeNw6G9A3DrPwnnSMtmC4XVy59K7TLVUQ8DyT0Kg&oe=6AC11DFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP9Fo1Sm73cQ7kNvwF3o9sF&_nc_oc=Adppm_ljTxOt_27eEIGrWYaXCC3lZUiEZfqNF_tEvl_ah0_AVbEEZi0Enz2BILdQnFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8YD-2BiytLCRm-9cnQzUzMZo9vtN0_1088hzJhjRe0g&oe=6AC113BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCX0Ef3RDLkQ7kNvwEuAywh&_nc_oc=AdrcA9m4KwCxAeWT1a8ri-eISXImVouRNF__D2VJWxSJo8N7xg9E-FNnECgI3s7s0HI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAo7bHCL0-mJBuyni2CDKbOdXe331Nv6Fm5Yu1TMqFLQ&oe=6AC10A5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkQbNzsXphAQ7kNvwETb83f&_nc_oc=AdoSpfLwsxBbW_A6sOHN6RF_MHlMyMILTqMVs0_R88rsJD1pzBS7iafaE_QVhxBDz0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGjVXUDm2b3Qe-t1RE_oCIIHAWM5HE7tLopCpD9jx86A&oe=6AC12157"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
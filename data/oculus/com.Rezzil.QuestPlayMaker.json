_oc=AdrnkB1HI2j8k5ntNhdzHT4IWs0LnFr4SsXwgCk0RYV9VFrPRjl2a9JaJ34ZA7s2PM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtLws5j087_tYL5ez2KSQnDUn79ul8Mrm6YZq_CkOjaw&oe=6A747D0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTxYSbQ3WAsQ7kNvwFoINTK&_nc_oc=Adpvg4RrIsI_ddJgqG-zMM1HwE8RV8usljU1lmlNums-SnemUJYxgmRvX0n0YKECCug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExAjck7eR66MNTlt6jHEQ12uYyJyKvGIyRHPGnwlC6Sw&oe=6A74A6FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3cO4NXPoA8Q7kNvwFXDFv_&_nc_oc=AdrBqz9CIBHtdAwoaEKZJQnheGSUe76L_8JwfZ8GZmEkpB8nH9jOilQBxghuhPRjgsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVfrm2vCpUG0bg26uN9Z6j7rdgalZOpJeE_wHBZlqrHg&oe=6A749CBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NswQv4DUawQ7kNvwE2nbp8&_nc_oc=Adp6mPmlz5DSz3ZmqwtSgG1onnEcjEEXRCu6TYiiNvxuMaIRmwOqCRVAaH-v6eCt_eA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOjarAt55-VAR28qVmFR0q6Aw2oy1ESdCq06CKo8IV1w&oe=6A74935E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-chRtFvcsDoQ7kNvwE9Wyt1&_nc_oc=AdqlPgfLFJyFeYKMbHXDDZqDlNCxIDnIiRgt9Q86vnxZKMcUmjZ0xIro2t1FjH6fg3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeuNOJqk_l51Zw7pLJDqswY4Atn8igLjaP86bfEdYF0A&oe=6A74AA57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
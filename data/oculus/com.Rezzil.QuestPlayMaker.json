=6AB004F8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk1yz9arSCoQ7kNvwGtDZKT&_nc_oc=AdrVdCgFBSyzdx4SXAuoSaj-DgLV72T7OEWajTWSyZMnfiNf7A6XJB6xMwmdUqfjWY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhqXqC1blO_aQn8AdOkuSqtNxJcjSftXJYuXVs9VOmYA&oe=6AAFD08F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahJgw-tEO-4Q7kNvwGbABUP&_nc_oc=AdpGNvJ-XGfrt1Wh677T_IP6aaraT6SoxrVVZcnBDZXtnzjUKfpq0-Z5tS0k2UAMKoA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe2eVA8eEZqrrL83E4We8FErwVld3eYT0c2VgtbXUmTQ&oe=6AAFFA7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5Mf7sRP1GAQ7kNvwHgTGBF&_nc_oc=AdpHC34Ji_y_Ibr4wfzeo2e_mfVlVCDgKKWqbqI27XRLiHsxT2Park81pigAQQ4USE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcDtwfEMeoX7ZZq_zYhYYb5M1NDKl6sjndA_7Q7qSURg&oe=6AAFF03B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKGqvLlrOkEQ7kNvwGSOlVp&_nc_oc=AdpY0zfM60orKruCJOdalxgj_Zar0VE7YfrhSjRsCIxqiX74lG2OsXbbEgznzNNQH6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlPxjbVQ_BnCEh6PjQavL4G0OvGNTSn8hO-VNvHBykxw&oe=6AAFE6DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHZmx8eSk4wQ7kNvwEjty_R&_nc_oc=AdrjHWbGwQMy_II6tSjFmuNDIb0tGBr_EmmYGo5064mE2evbVzxiOcu5ZdYT1lbMu5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf-bX9nxciKCHUZAMMq9LavtMicKdytCLuF4JwW9Y5Kg&oe=6AAFFDD7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
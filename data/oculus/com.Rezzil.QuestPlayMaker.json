=6A15C578"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAq3LbEi_60Q7kNvwEFfTF8&_nc_oc=AdoZetU-vJN197RNToxMEfPUFmSbZm5rPgsLoG0G1eiLYaA_MF69Q8-FhxWACP6uIb8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GjgIBfh7F-ZhtzGhHHW9TlhvIc3mvkGg27ba1oNCR4g&oe=6A15910F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7JPzrGHuaoQ7kNvwFbZ9CY&_nc_oc=AdrVE7GDvKtHkgaNLWn6TbVrNOc2X6qtVMco8b8vw-sQSMPdRPGWRA-06OqbzkRZhj8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_XNY-7-pUiLk_4HCXEisbBhFwJv-LfXQkieZ6X1jnLA&oe=6A15BAFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JhXfLSfLuYQ7kNvwHNYcMF&_nc_oc=AdqLFXjm3Bx4ALL6ulDgT5XG1YSn06lNQU9jMtq810kkNVju2UM7B-yZ2yO2OUK0AN0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sD-3DGqjCpabsB8clAtF69z6-DEdWDZnVEMNcJcVV8A&oe=6A15B0BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7Ob1PTjOc8Q7kNvwGS0Twd&_nc_oc=AdpGzQ4vdwRLPkizCYkXdUKbriGap-GnAbsq7kpm4lsSajJn5YnU1t_n2f8-0l2ZjNs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49PX-9yYSpVAJifa3BbJQGE9AIS3xfq3cmvq7IKaKVAg&oe=6A15A75E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4ayp4PM0fUQ7kNvwGUpCU_&_nc_oc=AdqWCry0uZcQGDiZdRUCAhYWSidS4hHlCDI-wU3WdXS-oxGPg8ab442Iqa9N-EnqV-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KdZOzszAhwxe98M_9KsN2OmzBYcE4el7xcvIILZuCQA&oe=6A15BE57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
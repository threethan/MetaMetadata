=6AF5E478"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls0mpF7VdCgQ7kNvwFhPo3-&_nc_oc=AdrulR-Imxz65pJBuKM0wpQCNbpJVKSebXCfwVA8kGAa-rvpbZADL0mfuxVIyBxhD1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsd86-U4huQeIPV6bfXahE_MT0_Zx_nDEERT5JxEVUJQ&oe=6AF5E84F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBhw7iaazzwQ7kNvwHrmK-M&_nc_oc=AdpkALz70G9C_E5dZ1qhNr-h6Cx63xsMCuL5ALyhwV3oxtIk9sMaRAyS5yh8l4dMiaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoMQcmvldleMtKVuzGr0KRPrXUsdlyvrtUVWZLrhIq_Q&oe=6AF5D9FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV8_wnM5v4MQ7kNvwGzpEJY&_nc_oc=AdqYBCsKMPMel6koLUAfk9fN-NCL18DXFzxqWU0v1rS8eboy_nR9cACzO0llM0QqAoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ0SCuRlar6-fiYBolly9K5hXa27Pyx1MIEaUltLifDA&oe=6AF5CFBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oCEC03tSRwQ7kNvwHAmvG-&_nc_oc=AdrJAb-8rnjd_qTt22d7Rb0-h2sHzI-kMdMyEMoK1MJsVbmetEQ4DV22XHRMb2LaSec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4RxTK6553IsT_Gz4UJtfPSLxXfn1FxdKdbzVJ9YCLLw&oe=6AF5C65E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoGx2pw04eQQ7kNvwE1xp57&_nc_oc=AdryXFlqNHoSEQU5JWEgxNg5IJmsbU7J2dtUS0neBzfKQ9q1Yazmk6G11JmVXAItR0c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT240V0n9OSrsA5rKyccdR8fAUllRkKHDXGuaWN8zmLvg&oe=6AF5DD57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
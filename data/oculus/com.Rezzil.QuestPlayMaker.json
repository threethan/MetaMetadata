=6ABA90F8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhbb6HIV6PsQ7kNvwEMSK5Z&_nc_oc=AdoWlmA4vmu3t5FrO8JL_Q3-R7aRFLEhC5patEaABR6iOLfjAmGhDrSXc__DF0yFGYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINrSvlJMM5_tO51TIYpZ0RR9HFNnbx5st1noPoB6cV1g&oe=6ABA5C8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2FF4-xRy38Q7kNvwG9DqUM&_nc_oc=Adq97Hiwr8Qr48XpoaRr7uyS33iaWTlQl8yipbsAev77a6GR1Ez8gbWsPyj-jyMLYNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5lrAzq6BMuzU_D3QWnZZp-KI9NnIVFWYRq86wiAj8Fw&oe=6ABA867B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtZAFAiWz6oQ7kNvwFyQpcL&_nc_oc=AdrTSAlCkPhxH0MVCr2zFjWvdDMJ7KZy_ozOquly8npiyST63Cus7Jm6cGL0dWI8HBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJcKq5QGfreM2D72OxI_yG9cdY_k8Rhsm8DqC7Au3VJw&oe=6ABA7C3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szkoED6CufwQ7kNvwGi_8z1&_nc_oc=Adotu6sjTm9Yi6CHOVuFDbXSxnI0ybN61J7bBQsDmX5NF5a3mlYlowf8p8S5Ylz2zw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_7myVYclQ5U9iEQxYSizXuIod-1sImfNmvMHaq7-u_Q&oe=6ABA72DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmOadXN4agEQ7kNvwH6lsdO&_nc_oc=AdrZtRN2xayBx_ifKPyBrbmPPQ8jDiVmd-Ci1Ox-TN-9c_6cPuf0u7D8t391eqw42Dc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0GPXy5iYLq88n2O1wvjVS5GkM-PpbNirIB8WRLKzRkg&oe=6ABA89D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
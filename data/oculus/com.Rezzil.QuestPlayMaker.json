=6AE61278"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NMLyb9vkvkQ7kNvwE1Kkrv&_nc_oc=AdoD9u-GUSw32NsNTT9ww8No4xPAzI8S33B5vCGt5Wr_3JhT13CRQn89OKKfO8cr29o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6qQQ5djDASzc92BsQpizFpDfqb_QtihHR9APfxYBHvw&oe=6AE6164F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdZlJCutrsQQ7kNvwHohZLj&_nc_oc=AdoWrPqaz41IqEVgh7B06-ahAO35xktUo00z2GS92TvwY4VKfFp4f0Va8alL70ExX6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU2bJS30UFLU1fWfs-TUxYhX9GaihQ9PLb7OGGob_Wdg&oe=6AE607FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCehDH6G3qYQ7kNvwHmcAK2&_nc_oc=Ado3Xe8fLK1TNpSc5kXv7gtGV6IrGDaz1sxw9lidLxkNaAWaZ8W9a4gw5hT6oEE_CTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXKpzDEUOM_rrG_utI8rSE_zdhhAQINRyeXarqrb76ww&oe=6AE5FDBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQujxezjQ-sQ7kNvwGh0RHQ&_nc_oc=AdqxVFHV0vrEgKwfYSJE_rsMeJvO0OEH9-S_5h1AJCXQ4EfzVXwHN3tOFTRSERsgsXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWRqudZpZvpZb3Gg62ts1C5i6Ltjno7y5NsLtRBIJvVg&oe=6AE5F45E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWkOBkx1Ur4Q7kNvwGnRB1y&_nc_oc=AdpdDbiLxzZpqj5_X3t_tWRDqMo0SqvfvB4TfSSsBI5GL39eVNIlfKOCvvgiwdhH2bM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTKNwp1hgFIQISIXA6FbtPo_U3Tt5FX3tq7Spon_FPVw&oe=6AE60B57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
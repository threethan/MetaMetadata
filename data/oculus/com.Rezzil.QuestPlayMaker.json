=6A0EF5B8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AG-ZtAd5REQ7kNvwF7_yw8&_nc_oc=Adp-f1-Fhe884aVhqquHYasw0XO2DauriVYqdNG6ab-rwYf_Do3P1W9jvWtorqmcC6g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40E5_pln5SkJr0Sa_4GdfaZauPnW1xehkrqA7IhDsIKg&oe=6A0EF98F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0mVuc6uJrQQ7kNvwG3Fc3k&_nc_oc=AdrO_JrAW7lDtOD633ZiMAPJgh4YqzDOhY-hQM_92IQo8AvK6AoNwdYfTaQVLJzieYI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ahweJAkJv-Kd3UIcQoUIrE7ZZMmxdPWF0_ys56J-ljg&oe=6A0F237B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FngQcF7NkFoQ7kNvwGdjA-p&_nc_oc=AdqwZPgQttq-KGEOa8ncgUxea3m8CEGqVq_gJfUJHpSTT9rcaiaXj9BVioMqPqXPlWc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sDg3PnD4vUaVwcg3_JurZyTsP2zWcp5_2plS7lS3iJA&oe=6A0F193B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soj0w_xSI4cQ7kNvwFDZBeM&_nc_oc=AdqJZ2opmuJlwLq91MNKraAxpG_wmOKVOSy9lChV7e7vW6jnLMs3VGgclfxarcQacxU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67DGOfUtXgVLxjcSSfxun2Jz0ZmBcCY1S7IL1L_8oVpw&oe=6A0F0FDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Ro6KeTOIwQ7kNvwGMAYxX&_nc_oc=Adr8aW_YBzRS4GpFVXcWO2jB08DGI-ryAzdCBG_RaVqY1k2knEpjQAxtwnMCN-jFRKA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AGK8NakbhJA-ImZKnodI_F92eycX5W27R2qDE-aX8rA&oe=6A0F26D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
_oc=AdpGZaLPMqH9oHYZPl91lLxOdvQ9ux4lo8bsfRA-Yb9i1NWHRKYRVRlrwX9QRhj29p4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yu2hhrlNBau8S55ybWckctSlZDOS5Njg5fNxoDWZYvg&oe=6A046D8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tlw1O1mXo6oQ7kNvwGxFrdR&_nc_oc=Adpq-2aP3nCAydH-CRECSYgwlVwIb8yv-wT5EwGkO-X7WHVvDjHcfqElpXHfy3we8RQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_IxWVaNVb4xaQCXDTZJISEdS4wphhHHo10S4jsR5eTw&oe=6A04977B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW4u_XUgOUAQ7kNvwGcTwOZ&_nc_oc=Adpv-R1q8mkAsghuutguwCx5FUF-M1QW47gOP4RxrAMsZMCjb_fW1UwdhWdB1NmVw08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XYfUDoEIFzQT9aSY2fNyDtJmZ3ylSXsNO1mX0WiB0pg&oe=6A048D3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJvweCcMsNwQ7kNvwG9MG_Z&_nc_oc=AdqmVbFJax1vOor1TJo4UQNS0n-wmMacbHA03V7UX2tXv9cMqKIQaNGOM1M5cIszx88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dbvEvm1klRVm8bwQNkFg80AU5Q1iet722EyUgC0RXKg&oe=6A0483DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvv_3mrjR2cQ7kNvwFLeekG&_nc_oc=AdokF8Ytw1HX3DPBSOl2QvYj8hAg2gtruhcY0He3rOBcITwttCncHcIqi02HUWjC-gc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J6b-pxvs8O4daviNTW_BQZvhFF7sHLbyV5wtdYym0uQ&oe=6A049AD7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
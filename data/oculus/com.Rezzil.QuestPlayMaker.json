_oc=AdpKG53juqV02hCXcoOCGp0d_jlqK8CdaXuW_MRjKPJS3sfHMNopUSeXtoQyExtuNV4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL3gQmWNUHJwz7guOCxy26M7w47MCDYZFvjlCIKjMBpQ&oe=6A5A1F0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNB87V7eIpwQ7kNvwHzdprZ&_nc_oc=AdoI4uaB9Uje5fIuP9QxPlhTYzbG-YTxvotLLIEKSKBQju_v_z9LfUwpt9s51OHLeu8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnu9TE3ZaBBEaW4wX0J9LqArpeQZ3yak5xJKJ51cao3g&oe=6A5A48FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtpTO5L-64cQ7kNvwEFJViE&_nc_oc=AdpQWK1PI4x5XuxVaB_NYspaxz_Fcz2JbUseEf8XHVfpUtH3V5oP5jDwUsSHtNK-uFI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnmGboa-yKLTSvOTFq-I-zP4O0b3UAU2JMs0UuCFwTSA&oe=6A5A3EBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoTadL1gSQYQ7kNvwHWn7On&_nc_oc=AdrV07A8nEcfoiXYFb7uL8JQZphlgYh5AIwUYSdqpNs3LaSCpnJAd8aI7vYDDXEdbLo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8mgOxX1mtXR8bFfuLmfwXUpt1up0i1GfNS2YwbQPThA&oe=6A5A355E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOzRt52E9-kQ7kNvwFvk7xx&_nc_oc=AdpKCSwnFMT58gMPkj0UZuilbaY6d4eJGV6Jwhu25Wk_3RI5Ne34qRKUN83AH1LU1MA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3pHktx0ar4-9Yi9rcNAhLEGRhZ5bm6yOAhJNAm9Wiag&oe=6A5A1417"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
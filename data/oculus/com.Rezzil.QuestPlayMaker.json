_oc=AdqdFPungONal_fp3C8vvx2pHNLdN0piBG3pt8Fdsaef-jGcCJKCELlfIm4DysbjHVE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR160Qfkk8jTFWFj8RNOU4JYlwx1uDxvmWH4gAChfW6A&oe=6A9FFE8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDNQErcl_n4Q7kNvwE2eUa_&_nc_oc=AdqEUyKvk7SR38J_xEZe6_NsGlRy3qof_LpmCFwofCZQS27PY3ouPJC2NR9X84eF05Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpxYt5qWPs4YJwByP4DT7fvLdWmfT7LebKaEhnq0yscA&oe=6AA0287B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otUO5GQjMGgQ7kNvwGqx4Xt&_nc_oc=AdogblmZwDcUifFNqx8KQCMmcQVk21myx-dAzYN4c7imhZ5O1Uqw053ryDINEsJ5t44&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO5kRrFxPAeIz5rmdPZIR7jbPUgLk46WJmv0oPvZgV9Q&oe=6AA01E3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeBSDXkUhcIQ7kNvwFCFtwv&_nc_oc=AdoCcRqCezwpHttPJJ10xLFT9kr_k_3hRSc8rMDkZ5S5mC1-ts51CbA44AAui_qk33U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8671zksppcOAbdm3qJl_FHZoAwVY1osg6vz2yULoA1w&oe=6AA014DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xDuod6BkEMQ7kNvwGbFKgn&_nc_oc=Adr7OU4U34QH50aUntyMI6XGFplwe4r0mzlqjMxU5i5bLVb_BV2PbQzCPaspt3FC-Yo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLokbKIPQZBfnPIvOhJ9QGCUJydqLvelBcadQBBEy1QSg&oe=6AA02BD7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
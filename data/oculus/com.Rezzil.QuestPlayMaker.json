_oc=AdoTqoWLQwty9Uxp5MjF8zFKOAnjTDiQJ-Ku0i0MhcoOvWO7zG3qkWysGOBxXAqyGik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qx09OpzbhvyXuUaWsb6-CSoT4aEeOpg9OD3ShNM_qPw&oe=69FC848F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TUJcK14PwcQ7kNvwHTUgfB&_nc_oc=AdpXUb4_Lb_xKdLfFCFaW0Ek0ZmUiGli8fX2UijQGxqs57N4iiGX3ahCPZmC4uzaZ7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RHO0TM6c_BcUYPyMwPmjkujSxeyj55sjrzTLCmal1Eg&oe=69FCAE7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHUJnS86kyAQ7kNvwGanvYs&_nc_oc=AdoS-41-h2Y0Xs_qfqY3fNOoJUk9SGORR3kpmD99yX_g4Npwu0sKBdCTrQIZF0Ld-T4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BbrVN67AYMPdNBSgRVUwwUS52544J__x0bxlMSB-RcA&oe=69FCA43B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdzZ41gwOXYQ7kNvwHmIDz6&_nc_oc=Adq2E5zX619SHTIDkP8HADLEb_SU2u7p1dBU6hbUPRLzcLtGSkGDk3DzMkQv1ThRi3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6crl860B1SoFsiBK3zTrdyLfY4KuSRoA2oVadjW3DUgg&oe=69FC9ADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjraxaTmWngQ7kNvwFmbA28&_nc_oc=Adr-xWkoZjyKZySBcL3BbzC0Mi1h4rBXG3qaN4naFvtTNYPO-JBwQ-XNyH83fYjhxNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_6mDZTkZCDTLQ2jInTaQqNigqc9KgKkdfhuGMtRC0zg&oe=69FCB1D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
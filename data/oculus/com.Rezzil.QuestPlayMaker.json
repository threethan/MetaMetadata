aQg&oe=6A468CF8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EcZGyoDS2wQ7kNvwFSmgm8&_nc_oc=AdrM1nRy088t_dt4vWfecurDDXFMIQJ-dR5kvL8VyQbQJYOq4H3HbOYeSWPi_2km96o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pwFb1cL8gs7cR9pFmMVaa9rgKqTVkg-H4uzEM4KG2FQ&oe=6A4690CF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCx1C4ASFBgQ7kNvwGlnxa2&_nc_oc=AdrrxLGcsOP-FSkhPx1j7sDKYwmub096ca89FKdgPZ9CZFvxEqbdIbbVKFnJqAy4yiI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ws-JL8MGUUgb097BVY7gOtWYTwQBtfpGitUZeZ83Vw&oe=6A46827B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOoOXB5ghKkQ7kNvwGqzTTU&_nc_oc=AdqVnz2CNBfYGe-ff1st6c8SxY7zDs3TfvntL7hx2yePVJkiUnPuQSnAxoQ7fK1nUiE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pehLYnzvas9jc2piz2QT0CBSZ_nI5csPVBG4UJ6SJHw&oe=6A46783B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0sXOKogrsoQ7kNvwGz7uuG&_nc_oc=Adr41m7NJOjcuqfVT99diJhAI2OeFTyympTeUE2O8buopBG4n_SLJfk92_ZHlh4qpMA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ng5TPOXuPvVBwBXf94PUV7GdudpIcMfPqkhpv6ARWBg&oe=6A466EDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vhg88m0E3UQ7kNvwHMfHUM&_nc_oc=AdrTTzx5Rliol1c9fg-PiF0kiurZWVfRsF3zCUweQ4mD6jv1PbjkjPXwEUIZprBxTbw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_oLo7Gz37QcBT_gKa2OtdlG53gwGRIrAeTtZKykYoaQ&oe=6A4685D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzi
=69F34638"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8ND1W8ksj0Q7kNvwGaxgWP&_nc_oc=AdpQeDT0IyHjQoD63Pwmb7r4pmctq3fbHjTMBATuiPrxtjGBGgt-fV3whfOR9FJblUw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wr7ghxN04vN7GcxSpFA5HLMO-urxH5iNp-Yfih-Wm6Q&oe=69F34A0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyyAUhOPv-gQ7kNvwEETm1S&_nc_oc=AdpoT4Kj8YETIEh_uZH-DlaU3aMtez4FzYTb-A4hNBcLqUcGcLHYcj8bxAnKVsc4t58&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HpfId6Oy-b5eCkW7txYXnxQOafDctSHGL-vrSoZV6qQ&oe=69F373FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVtF8h1oKfEQ7kNvwGJflPY&_nc_oc=AdoWx0MylcrdAmNuppUATCxdj9lXZdy2Wh8OMeL5pVHKfb8N9IAqbskdmCaGoLdzgZ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nYMoeYvh4x2BUZLqyWFNrm6lGm52KQk6N5P3_ulsKWQ&oe=69F369BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3wXyDORuccQ7kNvwHxe87c&_nc_oc=AdrSKkFc5R-u4wm6Y7_2zMgVOrkMkHF2cZQyhcKmS6cM1OcWQgTMBUC_82NhA1sUOK0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0w_-Bc3XBwJJszU0hpDPQIDqswsrkRGTkrYaTdtR5yNw&oe=69F3605E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X27kqCgl2FAQ7kNvwErEejs&_nc_oc=AdoCQCQRTQG9e77AACeZ5W3mmDB5GrtZ8aVB0VolhiIzoO5l_RRg0lGc5JCj5ZtQ0so&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39xW7XyBFSZkxWKi0UxELRM8Q7bQcdoeMhRJpShjYTRw&oe=69F33F17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
_oc=AdptJ5Ko37djNBW_MhsrccYEUHS1d2iro6msrJDu-vpRGK8HtTeAh49XSarkebUsscw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK0IoIp5ja_y1DrM0FAOsCC-bexeJ1eHby0s_UQRsdoQ&oe=6A95E30F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l26TxdZMq9cQ7kNvwGk9166&_nc_oc=Adowk0UbwTl_-PHwM9EBo2kGvM-6OnxEGxH6Lq9d0nCa1yrLc5qO-trgDk246i_zZMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFebinltiCawML1cC8PA15urWgs3bwXDd6Dqr2Tuar04A&oe=6A95D4BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEaMdzr7LyIQ7kNvwGR03Tc&_nc_oc=AdrKYm4y7aDzmjNqOv32xD4HT9DOrqlAufXi5kw8D8rBoWI_XXWYLL1d2GXHU687oO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEd8llO5LyuyGuLnVts4-bVFRyn-cCZ7UiMohPiPPqww&oe=6A95CA7B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qjkU0fil9wQ7kNvwES-KnZ&_nc_oc=AdoLRVqt6nqFdk4LbJdov_D8go1ke6SGRavZZ81OaA9SRpMDDip-14lJEQkS3B-72sE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4rnm0MquiahFEdSxbXqUohqhrVaNEQa4APIS-I9cUiw&oe=6A95C11E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKQiJqh52ncQ7kNvwEf6Ogf&_nc_oc=AdrPqyvE8CQ5RMeYQP515T5xOwtL5Wnzwj12OUWPpDVi5rBhZ51pO8l1zmwxdHrS2KQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKIFyUosiWeh_bicFJaH5y-OV9aPnjROTZjDnHb3MU7Q&oe=6A95D817"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
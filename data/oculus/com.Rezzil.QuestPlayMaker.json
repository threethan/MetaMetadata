_oc=Adosx8K3l0RdudwIGBuXh9zrEsGs3U_HS4hI0kz5lWldeMLWczHjFzIdUkYccyE8kZ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJj5643LFdf904kFAA7sSZjnFwTb6PA6U2glu-sA8m7Q&oe=6AD0FE4F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG-tBxVfGEcQ7kNvwELTbhS&_nc_oc=Adr5Lle7rrhUiIRIFQXPh4iYom2tSCT7_KVYbkoCTaWkyEW4ENFx8XjCBSmYsHMQuGU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_oE09uAkcSQd-76FhTnCX1zjNG9_qC5iAObl5tEyOQg&oe=6AD0EFFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi6q7NJCSDgQ7kNvwEpxWp_&_nc_oc=Adoa4oHrtSKH5M2X9ftn2HLyzFIiowOQ3GLZH7hsqfWJQiXdCD2ijHQno4ItLqpHgSA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBW4-SqczsQwpV6DmcYkhg7BLMDbY-LModz5qQpLiCQg&oe=6AD0E5BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8BsNb2GHjcQ7kNvwEA4v-4&_nc_oc=AdqkTC_rG5vN3tbDj9PWUW8e2x_OnmEe25lRitRaEdtigLvE_lLgA6ZoiXFVAib0yU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLgDBZt1kIslgCfaE3pLJhQiVW49yx4UaYSXiWyTh2Iw&oe=6AD0DC5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obVIjrj-IkcQ7kNvwG_eOjs&_nc_oc=Ado2Bxr54-OD6R8qtbHPD5X73JswSO7Ke757kjGT5ORNZCiGYSN5XZ-zbdrZo0VwbLA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML9qAsQXAcXH4fNmZol2ioF8iiMFpUVy6RP7m6AaAEoQ&oe=6AD0F357"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
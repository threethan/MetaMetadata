=6A450338"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EcZGyoDS2wQ7kNvwEqg85f&_nc_oc=AdrIQ2wJt-cqLGwm4ZoINDoEUPe0Qbn5a4UMERjj7QwkCHc3UZ_d9hj7cWgwXsHkzJM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pUR7o6qbB-i4igKFLAOn7C7fT9g5M5NzselPLfqGchw&oe=6A45070F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCx1C4ASFBgQ7kNvwFTdQjx&_nc_oc=Adr2Ul_eNji1d0EFFy6F0HuMD2H0N7VAD70LEsbpZvhac9E_N7ekwm-Eicq7piT_p0A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j3MFbg7BkMIBHNPgfMqxkSxCvW0mnTrqyxo20MIskPQ&oe=6A4530FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOoOXB5ghKkQ7kNvwFl0kac&_nc_oc=Adqw2AuV-zN55osADy9tUoBJ_NuUwB-9rdlRLUrAohxUF74EWnl89rZIj_jYMLcOj6Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HD3xUiFHbWBQZPMw07HfGl39A12EhBGBPFtVfazRCaA&oe=6A4526BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8ozSDGqE3cQ7kNvwGFsAJG&_nc_oc=Adp-GNVUEthO-T62549jAoj6d9MjjFWrFHbZ5_S4rHS4li8lAc5JVOMZzqz1eN9fD-o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RUJm33cMKnlPy9yOhk_xHOG07uUmuy2DtDplj2HRq3g&oe=6A451D5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vhg88m0E3UQ7kNvwFKY_Uc&_nc_oc=AdqwaqjxGv-OLjFzTmZJvfVZE_amXzEEYxJNWOlYYQuaENKTxJ6htUm8pGWXwspzuJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PouwjuTyNps0KU7glkv4-hdQs7ipKiUK_sF49kFqZbw&oe=6A453457"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
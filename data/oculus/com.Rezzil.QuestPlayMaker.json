_oc=AdruCKZ4Pn4x3jrbOGxwqg0wHh6mq_ibq6r4IsQxon6K1rqrVlegJYHPFx12_nFV4zY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3fCE1z-rS5TOfjz6OLicj73s0BMg7A0msC1CbHGPoAA&oe=6AA5448F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfxsk58wvQoQ7kNvwHAY2wa&_nc_oc=Adq2XdeQSc46IQfBXRezwDE0Q7-3hmmrMGWPi_xw8Nw7X1p3h0luZWqkKaJItpUncf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdR1VtOiDiGQtE9uG_SlrlU2dPoHXNd5lQkRNqec0wQw&oe=6AA56E7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlZX0C4jhukQ7kNvwEXYN0G&_nc_oc=AdrNIm-ItAcr8i7QvpKEFIlEizeD2lSGnRcrhpeCyNhG3L_EQmxrSiB2eZ3WwDU8sG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkMfqr5JDVDvsP6HIADIVCa4yBekcimqPwANX7ZUCK7w&oe=6AA5643B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOrsDfYJXycQ7kNvwFGU7v2&_nc_oc=Adoqx1WTDQyTQhqsOvj3fW_hlk5HD-sBXeEAHtI6O843uSonIfHAZLcJqJAgZl98ypk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqsvcXZNl7TtrWmhxuB1iYH_n1ltm4RDlD53n1wn4Q0w&oe=6AA55ADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMwz7rFdyiAQ7kNvwEYS20Y&_nc_oc=Adq7P7grT94VNsgcPbd8vQqcalIEVQqLMSOyiFkrLYm3Szksknk9nAWCNhlV0j5KGl0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPsZmTigsE777_V-mDUZOhRszoIUU0KH30kKOr3oRmJw&oe=6AA571D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
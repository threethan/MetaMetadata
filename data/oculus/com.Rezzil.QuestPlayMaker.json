enshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW6eE2QHsXIQ7kNvwF5v5Jc&_nc_oc=AdnXk9Ig2DDeYKT-zoi_eL_6uCDSML6dcxGAqx62GVvu2uG6MWALke-3AUvygL1qh2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft81AXLmB5LfJhqAW-d1mOJdq19Uov6rI5SfYDRTJE-5w&oe=69A9760F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwzlBByS6c8Q7kNvwH5_L8r&_nc_oc=Adnf4ml02Pr76jQiilV5WOxnI0bnwxdNq89_ANnOuXBb2JFsGf0MdqgLlKXnBe3Bnq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvMWW4AZ6g2_wjKEYiwIlaA2OBVRH6LZC3g72aKHv9ZRg&oe=69A967BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W348qftiuJ8Q7kNvwFyISg4&_nc_oc=AdmqztfCihkBOQHrhIXvemvA2aLfpUlRa2RBqqkYzKHk2-lfp7vPt1FUtJfV3cVeNXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvbcR67Dmx9RtwHWSN-Gw0VxHHSC7izhYcO4bJ1Bp8zTQ&oe=69A995BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cY5GXVdvn0EQ7kNvwEVrvV5&_nc_oc=AdlQtoWd_Tk3D1vNw8wpGx19fLmmn_fZW-sPTW49sUfmLmozdqoXBekw1oTobivNEJw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsx6R2rc6ancr3kJlc7oYEl4V8o1y6TYIcPF2s7fS1xzQ&oe=69A98C5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEsp2yacjGMQ7kNvwGrBvwb&_nc_oc=Adl0lPKUDuhHohEIgfU3riFEnCqkoGnDIRvfh7frlxKUsmbPpiGvfZ8gFv9dSIGv7iM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuexg2qeIhy-0YgXYxa4znFFKyTQEUBx-yZACkcwvHOBw&oe=69A96B17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com
_oc=AdrWZ2gYgC1v8_Wx9i1CjNhiZdxow9QwLNv1ImJlFykrhG8tHC0_UDXrOICCqZBeBgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMbhDg-i1fssr5KuBXEKSMwQ89zobGeKJ2PCurdSoRHg&oe=6ADDF50F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3SqWlLY-S0Q7kNvwEImh06&_nc_oc=AdqNaoZtJqEmPCoJGFRQAJOFKFBp8gG7HoNxo8FUUmaO9k9DnyqMdSnA5zW7ZMYr18U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcmUbatOiffPa-V9335xvy-ttvf584QFs8yZ2RwZIMbQ&oe=6ADE1EFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ2fBMav2Y8Q7kNvwH15ER4&_nc_oc=AdqOQEOeQjqv4yj-kBsGZ3OofGVD41xZZgHsvGMzhkos-eLfA82fTT9F3kCHNlgyf5w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY8TUEC90r0-j_ySAgP6W9i1xyzVz0I7CZk7lXMW3OAw&oe=6ADE14BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lBx59-yHCMQ7kNvwFUZH6Z&_nc_oc=AdqUpapqWmZxUJNVuwTnuQx1GfnpRfDFK81mgN2dE0W5Cejao3_5tWW9WDl7DfJJO2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2Da16MG_Xlbv7kQKXFd5RcS7L027hG7_rvhKLLlPggQ&oe=6ADE0B5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-0GSBYXgzAQ7kNvwGjMd4V&_nc_oc=AdobMrhjeeNCwGkGpNRJSiZonCFLe0hEAePED0L_dVxJm7OrSg_78Jrn4nAgkHCwVKg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJss_TbVt4y7do8X5jnUBgD0GPXH4yDx8SrYH3jd-77Q&oe=6ADE2257"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
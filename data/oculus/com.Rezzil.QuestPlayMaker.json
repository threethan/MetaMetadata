=6A0DA438"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AG-ZtAd5REQ7kNvwHiW73T&_nc_oc=AdrRPBHYyRMG5ejOIDyP03DuU_QJbAJ36SotE-9poU7aypK6P62Kk1uYvF0PmRgOXQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VMCi_a6Rkz8rIZYgpkIaKfbYOGMjPtIo6OVuCR5mHVg&oe=6A0DA80F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0mVuc6uJrQQ7kNvwGIYUnB&_nc_oc=Adrf4rTLjm73RFFuKfdcTaOWBCQNlh6KrSkDbJaHUrMahYQ5vIJ_nhje-Wk726YHPug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a3_iIcZOjupz3jTZoZY1UXRoDu0yakVh7qnWwVRxh2g&oe=6A0DD1FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FngQcF7NkFoQ7kNvwG83nQh&_nc_oc=AdqVJbgJO3Z9BAQSujmLhaNhuyKeg0pE83B81UCxTdwdONd57t7n3gH0R7WSxXa1F8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eXWldl_R35D6cRzXv255v2LrDQc0EYxEIRj7wDTICNg&oe=6A0DC7BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D63kEUJrZ0AQ7kNvwEgzvun&_nc_oc=AdpchXxDrA4VujqOBEg3IdIf6f3LembhBM3PyUYDCbsj3h_dZ1yA03grHAeXwQAH3_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EJqDjvPC1qiyTqELUCZik4TCzy3nDzsyaEzEXJaaQVA&oe=6A0DBE5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Ro6KeTOIwQ7kNvwFGKw4u&_nc_oc=Adp2tZRGdG_NJYrO3vgwfqS9JhOTNePUa0YK6EKcYt1nLog7rgVc0DlTjP5-7LTE60k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6grKttbG6V8iUZwO0LIfm2ZlACHg7Cch8_UzdL-UalTQ&oe=6A0DD557"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
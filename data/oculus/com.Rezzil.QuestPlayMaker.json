=6A4A8178"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPz5xNka6F0Q7kNvwG68qtO&_nc_oc=Adryxr9jwyiLZtEkgGbT78DF7NGtsyP8TPAiYO_4YOLfE5ZEkV2C6oRn59HogbShTJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA81yB9LQ8DjDm0iOdl56KYC9fZw_fQ5UcGiir887sgUQ&oe=6A4A4D0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y20lysNIw2IQ7kNvwE-j6BZ&_nc_oc=Adrl7hgcI26YXuVbB43mRPNaLNFgtrttZTJNTdJJ6PaOSUSdEFS5H9Lppef61qNMlr4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ1wuuHNviKt6FE1WEGIpJWzU3aCzobPz0nGIOpGWIiQ&oe=6A4A76FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaHWOOR-zR4Q7kNvwFDT4E8&_nc_oc=Adp9CDryTEuQrC9Ms1jrlYsYXKZ5J3Wd0X9KtCEnfcLOA4BuS6T19pQPrPFoFJV5-2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6-UEdb3O34-txXbFSfvaOkxBTndZl7Y8loks5Bh36gA&oe=6A4A6CBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o29nTVl1_UQQ7kNvwGX-JCO&_nc_oc=AdrydKOVWswAVU9zcspRkZkT4DF7DdV60R943YDUv2g10BO3SvlHlRhOtKDb7WahFfU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFKmR1IaqAkyyBqWiqffEc5NWR--LVRZvyH6zB4qQuzA&oe=6A4A635E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOyoSsDZ18kQ7kNvwHPt2he&_nc_oc=AdqIywxM4LwOLjLZ0RMDG20yRAxIERrWfeNkYdr7CY2z4yIYHZYiR6m0WEIIUDdp1yQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtzQ9ydBiXyCh0Kn4s5wMCsk52jaVBBgEFEx_bs84MJw&oe=6A4A7A57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
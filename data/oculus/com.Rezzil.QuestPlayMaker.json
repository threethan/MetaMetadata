=6A0B0138"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bUCSElWJAMQ7kNvwHiGQxX&_nc_oc=AdrNQ7GiefxTKtYrDilYN4AnILqLhk74KgFROESiXUOVUWXpTaRUuxsf65w7liH7SGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KNfkvz0sXMMzeJ2GlCiuimuniuSSUe8FBF8KtsSRwIg&oe=6A0B050F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms-RxWfro98Q7kNvwEqJwTF&_nc_oc=AdqFp3BUsqS6bA60LgkFBQNVXydxOuQlD-BVOoXQDEx2ZEwANSwj7RK9yla-PrGJ_uY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YLnK1rCFmQhU4b5XyvT1QQihe7Y5WYH3h5oE7P2lRbw&oe=6A0B2EFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XarsfUoXhZEQ7kNvwGQsJwr&_nc_oc=AdrmyX2ltDk6jpC7FMsVoAFle1dOs0GbbRexis4TNMqjai3fKZZ5wnB3Nm7wejICsJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_09vPUQ9DvL9SZx9uQW8fYTZgajn_fE1M7XCs_ZAIMg&oe=6A0B24BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D63kEUJrZ0AQ7kNvwHZieaE&_nc_oc=Adr0XTWSIT257VmU09FcQhTYtkOWlucxVH2_I-ayaF0K5U-bvjMPASryzb5DNNgnLr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-b6rcNmZRyi7iAch35p9tZ5iEE8QLlC8pw-jvpf-VJw&oe=6A0B1B5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihVrGcvWfDoQ7kNvwFAwrry&_nc_oc=Ado_DysEn5WuRoC9Dl9TuqCU9jr94b0NlDSO3XUEbZwbCc5asMGNw6fxA8subiiVJNY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BdXoBLxXCrOmVfrLSQCDVvUv6uLiNTsrvG2g3i1aJiQ&oe=6A0B3257"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
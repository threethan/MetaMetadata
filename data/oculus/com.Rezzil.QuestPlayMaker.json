_oc=Adoclc5KQlACTU-CpM7aH3bELPHw6h_756tNN4A2WHpiJMhbtWGPLLyG2i_hWMhbPjU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCOcdGnee_iny2cGegGYqcsGlBzwttW34p6Nch_IorUw&oe=69C5258F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H2njOeY0K8Q7kNvwFz6AaM&_nc_oc=AdqDuUNsggCQm3JEzh_m0L7GSwwyML1cfyEZ3xWLyLMZbl-npbMt4NlcNaUyMQRe0lo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdvJsPeYlYGG4q2FPXby-kGWU5dJKNhtWOZY0AvPAQCw&oe=69C5173B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cmq-Zxq40iAQ7kNvwFJeFLh&_nc_oc=AdruDU_lCpV7WsT8nR6Jg-2yZ1b9TZCvcN4WCUsRyvJs3wDByLz4WUGp3X21CcdMIyk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztxAoIs2veZaZreaFN-7PKnvdMLiT9wS4YnZ-Uf6Oo2Q&oe=69C5453B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoRMA2Tp7YMQ7kNvwEkOasI&_nc_oc=AdoyfzPaG7wpAtAjRADEvrOMLDUlzaXqtbV-LmZBzJAa3G-GGC7NvISAy8vVFdgzce0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhpO3f1uRcXFf6xtLcway23CV_1r_nzE5tiPnEjurlFQ&oe=69C53BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrW2Haj3h-UQ7kNvwE7wVix&_nc_oc=AdrXsFz2dpgZhUoSbfxGXCLvbn5-plddO8PrEll7idSkYKFjF1cetHueWdRsHp_yR4I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0Fn8Og0SpyMnvW0VsqKnvdeUtpv0pRtE9hjpIhF2pLw&oe=69C51A97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
=6A64A738"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMwSvEjhppQQ7kNvwG6Cpid&_nc_oc=AdrH511hcJKlKBWKdrCJQ_L-NaMDVcn0QVv-M0ZDB6oAj5aObF2gA6QOBfXyijtjpwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQShTtS7tdOnfHD82KHTJgAjG0UeW9H0ixv49hg_Otwg&oe=6A64AB0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oppjl062D28Q7kNvwHt2Fcs&_nc_oc=AdosH4MKYPEgQqspRgyG9WnhaB9zyUQlXUV9CcaCDyF8AUjz96TrwSorsi2EmLSxUVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrX3XrpZge74g9fj2RcpBIXk0nb76oQ6dz-79WPuxcXw&oe=6A649CBB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctqROSaqva8Q7kNvwEpLpPW&_nc_oc=Ado3Dz6qe7DrDQ69ZYA5O5_bi8BNli-bqOjeIgCP3ziQxT6myFmM90tKlJw3L_eI39M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr1yFEG0ucu4cV3IRSKK5TGPypLGxirS6FmUDhJWi-aQ&oe=6A64CABB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE3BwX9gm7cQ7kNvwGWptc4&_nc_oc=Adoo5xPAtAh04nYyorG65QLWnk6hPfuzwzzj-P2ujB--i_2m_FlaiaJVbRZGy7Q3wTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe4E0kHbR1DJJjbq2s7VHfPJ3N8Gd7fVcFUnUFK9_GtA&oe=6A64C15E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBc5Dtsyh3UQ7kNvwGuEzga&_nc_oc=AdrtMDxVYZzdiYZ6BK31IslyhBUMFFpe4pCKw9pGkPc8FP5bD0tSRxrtpkxMRc76OWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc853T6Zxsu-Z0Jw0vnCbrUK3Z3HO1lRMUkRn1IHuWkg&oe=6A64A017"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
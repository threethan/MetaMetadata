enshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XiK7K37vmwQ7kNvwHCALF7&_nc_oc=Adk0Z7l5A4evLxepf_oQBNf8cqcduEV7JpZv1gmg_ou6QooxPWvg56IZMt7OVfggjzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYTfvpcm_5oiFcVIW_DV-RX3gaPTIldJxFiskk8luRjw&oe=69B9480F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjeFniiekXsQ7kNvwGQ_ktL&_nc_oc=AdmTVFsdzN1mKNcG6NgJt50N2MBbnXbAexzTEokHAyO64FMLhVi2i45-RlASznTx34Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpS_oqR2tvos7PvI6UTPgHEnOvhQUOL7o1fue5R0lqzA&oe=69B939BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItpjNtcuqdEQ7kNvwFCyOnM&_nc_oc=AdnkzBE9y0JMgEBr0OKV_g1gWPZ1Y9S3TxFvH8o9lo5KYWVw2woedxR7vG7E6ZMA6MM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeKqwCMUvh-2XPr-EMRnfSY1FOmA4IrdPuG45b9nLihA&oe=69B92F7B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdBDM4IkZ1cQ7kNvwFiaYbr&_nc_oc=AdksFUweUMJlAkMVjvUsLEw9MH-5CjBeaTLPn8FMv5hKeCfwVMxIevd7pgqC7vhtRYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwvQ1ocel0b_7ro9xLNZC0QQ3y-60p4YyvcgukAI5Oq6w&oe=69B95E5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOwHhu3FcvUQ7kNvwGbcZxP&_nc_oc=AdlvB_L2iysMtJjyutCfJbWKgkWjCUx0SopZHtYZUZLKz7jCe9XmSolKWt_Ltv-_-N8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0ZeloQWxRmvDX0StkRAgh9kipAgwsXdYh4F9GY7gnXg&oe=69B93D17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com
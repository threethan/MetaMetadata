_oc=AdpJFMXIxhWs2zmdCRmQO2zO0oDssf_Dd3dUYE3soHCvGNQKa23udpNGov1bRLk5fJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvyrOAX1N4oZFHTPPlrhd5Iw9UuJSF4bgo4HFPUJ5xIg&oe=6AB5168F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C78HRtQthYoQ7kNvwF_EgGC&_nc_oc=AdpZrPMLOpd4sQcNT4J2P3vRRkvFxgFh2eUvBCUaiXVrZ91Ril_GlPR4G0Ewzst0Ido&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJRES7CkGSQrsZNTsYCOYndgJIgC7cB7FMFv-TRuc9VQ&oe=6AB5407B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHlno0AGXjgQ7kNvwF6Soh0&_nc_oc=AdpkQx9JgvH2JWYnORqMPdJp4tcl4361NvJ-SO58gcIZGRR-1OWpfghvZMYlFyGjXrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHAS4eqZ7ECbiZBxUOTOyW1dk9iN5HMhWD4egExqyvuw&oe=6AB5363B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Pc1qadk0CEQ7kNvwGdd4mW&_nc_oc=AdrIr-FhEINp4CU4ESt3ulM2Di6nD2rrmtym8zg9KP6_dDPnizfgtsqr4Uihyi-0dEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsUYXyWUzujo78odjwOpmBUOHcSgtx-d2iB0iDELluGw&oe=6AB52CDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAwYeHQg1OIQ7kNvwFIhzy6&_nc_oc=AdpQjmkv-3-0cUxPpjrfutaRyzxvpZ9ROnemn8F2orjc77nPJSnFnLN91B96WoxWhsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId1mZIUcAyvwe4AsvwAIdkX5QvW27y_WZbeZDFO3wDJw&oe=6AB543D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
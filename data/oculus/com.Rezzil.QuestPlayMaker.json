_oc=AdowM2BViFyIULHsap7Ohrc_I3hlmeDrAvxlCTI21N7sjLIBOTURkKXtx0U1ZIrHFu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElFrG62TGz7QdmX47efFQkxaqZ9aRVVbidoUqGx5Rchw&oe=6A70888F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7oCgQSAUKgQ7kNvwHuL95Y&_nc_oc=Adr-Pa0jEo0uayXZYMZDEBxHF3crmJeYbqsNatwUpMosuT8Ued_YxOyM5X19m_8sTE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLklaRpucYa5KKKdjVBIwG6PA-ttzzmApdio1nHoKK-A&oe=6A707A3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLgWUZGOEFUQ7kNvwHMVVw2&_nc_oc=AdpwBPV35LH2cOBRRbWCLZkfTvKQaAKafqzUmIWn4DKlnBYpjrjyGul0Bdbu8iE3Ddg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2OTe5DAZjEHXd3e6nUgGur1FuNKqoutlBml1yTGGWRQ&oe=6A70A83B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MSJxjtxRcwQ7kNvwE39lnh&_nc_oc=Ado0F8n2SeR4pfHg8HXWs9WIKabuTE8pOgBYBJy6ljaKoZqzCZEiZ1FZ8mkDKbQdF68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOUEkRZNOpxXhumhE7oG46JDGi98y3Av8oRAx-HHOSKg&oe=6A709EDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zMQ8mjHJakQ7kNvwHdK2-G&_nc_oc=Ado_0OJnnY9LiYtrEd8G-ao4PKqHKMWOfUflFV-3LVBBFaok_Rx_5qBJWctYQbFZ4Bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH66GA5iIiDgeVa6wLkDfIh6KxSddi_Y_8J5IeAFxYkEA&oe=6A707D97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
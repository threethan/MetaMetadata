_oc=AdrINcw9ZS7e0-HoIe11C39yCOf6R01IuDfdJf9bvDvlwop67QF-p6lS6NvVuEpT3UU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNypC8aEWr2aRtT30X22vnrU2yn6kVHzR8HTuEaW7OgZg&oe=6ADF468F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3SqWlLY-S0Q7kNvwFv7geV&_nc_oc=AdpoL_Ps7uoJ45w7mwTSCT6FFNmpyeouO-C7ucp67fYsVNqaxJtoYMnVgE0fdc2aBLk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3k0JT3dfgB6XVtqULx59hm0QEp-cAP6SVaDndEv9ADw&oe=6ADF707B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3yhecJ2bdoQ7kNvwFMHTeD&_nc_oc=Adpq3lmL96TSnCG9389SLGwEWR6Rv7H-lv63q2_aJw_ECmSiIOX7r9S36sJXg0qwBBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAI54W9eXFO0_nhHGFCvlaKG2-b21I1m5ZRarazCfCqw&oe=6ADF663B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lBx59-yHCMQ7kNvwG0i7EL&_nc_oc=AdrMNpSBJbL5XfEJ5gsCVlkxLjrAAnB41R1zDJzdwgGmbFk2QVJVd-vXqy5qznVimJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeHQovR55TnnlSWSzjk5G3VHx0sEI0Hfl8gcYxjREE_A&oe=6ADF5CDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-0GSBYXgzAQ7kNvwG3ECey&_nc_oc=AdpV8xGdPa7KmRYkzcT7jWDxO1dV6mLWLgvoJC6jRNH_QwnbwcmYDUHeEv1knvVJPTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsmAKX34yC8tkEVPiKvfWkEIPdx62HE3QqAjqRxQuhvA&oe=6ADF73D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
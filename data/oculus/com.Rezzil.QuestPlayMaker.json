_oc=AdowRgmk3oKzdxl06WhBf8jkQ7lw3u9l4RI6KlLq9T6RhLkfgFNzAN2Jfuc1rP7KyGw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V55Y3dIlMDPDzUaFWk3JgSrci20I4fcChXaxL0UGcXA&oe=6A2449CF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yC5tfbHRqUwQ7kNvwEx_HOb&_nc_oc=AdrDPMVvE_QOHIqrkrmX03z7ETw4zbFeD9yQvg5e01uq5Aro3TkEah91Bb39PMl25vg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0aZBvqFitzXdKno78iLqWXtzDaTMJwfUfdC49ckD6Ww&oe=6A243B7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFkfXck_TDMQ7kNvwHjNZid&_nc_oc=AdoWTf3vs37hdiPJKJhI0rG9N-SnfiRmieGkSzRV2M8fG04R6LIxNqt62AwS-JDE4O4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q7Ms9yGTaOby_T56EMu_nsjNr3fdRYJSr6gDbAOEClw&oe=6A24313B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPbTd9OKLrkQ7kNvwE8hBv_&_nc_oc=AdouwryWrtJRqY8Tq_CCIlp1ILbGuVb3RtOh4JEx6wgEFfeSx997HM9wO7iWBQ6EAjc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rli3EMUpE-3DBd-aNvO5n7b8TahiOXa2za2gPBPFDfw&oe=6A2427DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfO1kIkv2Z8Q7kNvwEwwOP9&_nc_oc=AdqIHhTkBGvcdML5ajmyccSPA2XqLTnJwz1M5wl-AXKzP8wJDB1Y7llddFMKVyT3mKI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ysd9w_TiElW6tfpcBoavxlWY8t46sZkuFegQwSZItvQ&oe=6A243ED7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
=6A883FB8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skp1hHNU9JAQ7kNvwFNbvlh&_nc_oc=Adre1p0LEAnt2KsCZorXZdlBNDY4oAASab84-QxiV8k_tV6SnaAjwqmWEzaMLQOxHKc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnq-bzLkdufxdyti-U1GmAXaFvZynw8b3mqaW4MjtRPA&oe=6A88438F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WakFmjh95tAQ7kNvwEuWuiU&_nc_oc=Adpdbr9_wP_q-scSVOzVgG80WGRpQAnSXm0ZzG35VtFmPRc2EBnuk8XOH5NwrL6fO7o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEZiVGf8x8TukeOSrkmrWQ5lazPYGSWUnjMLPla9CxGQ&oe=6A88353B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLlqIat-cTgQ7kNvwHaYxOP&_nc_oc=Adp4VlFQ8x76SR-gMZe6I6ZXhNJqBEgzd1fk39LVa4gjIwZequjFv2vwru3GdaJAdu4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGorZummGP_aMPlP0zpBIUyNFyJ0K9ije032uQ3BfKRIA&oe=6A882AFB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOUlXguQws4Q7kNvwFls0-7&_nc_oc=AdplDK6dybTacp6MfhB0MnfsUCTLDtLzEJo39ZpP8XvkDl1bbIe2Nt94WCaz4kSsx04&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJo_7JiE6qNzlzYFuTKJohECFD-EKK4MyzGh8ih-U--Q&oe=6A88219E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiGaQ6S2P_oQ7kNvwHyOIDF&_nc_oc=AdponkdseApSvjgS3WjuFpEoZTzPjnNoY5s79cNjBHZcQCoG3kMpr-sSDxJYc954p8A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyDBspqsjwhpW7PBhOiL_SOXefce_dtknPyNVFxR1NSQ&oe=6A883897"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
culuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRt2v8kV4v8Q7kNvwGkz2oP&_nc_oc=AdlCRWc3PxqkCcmzSzqt326oY0jmoBPCr9Mwch71kg4YKRHEkRbwATbrFMpYUi0Bb-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft0IZLP2g-SFxSMgQGjb3WhalYkhlBJCbWLBSYvouPD7g&oe=699EEA0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGemCksIv00Q7kNvwGzkHHt&_nc_oc=AdnVLyLeL3ND8ZhLgF857UcgGlDhcelowll-YfCK9DpKbimSmENPTE5txUK_OdqFLYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftyKzKl0FMxYu6dJLUe3eIXTedWgIv2uUr94yEsD7hLpQ&oe=699EDBBB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=803u4dHuEFUQ7kNvwEeizhf&_nc_oc=AdnXiarU-uVidpQ-IL1IsNIg3SdnK4aFfVsK9WZixgxeG4l__LxX6zN4kEyGOizgYAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvBksjKFd52lRFuFOdDfqEilttCNir-Fcw9Z7u17-MiNQ&oe=699ED17B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9hAx9XFVrEQ7kNvwGfCjax&_nc_oc=AdmYUvgQhotM0hObbEvHXhRiolW4NoK4LhPdy51a0-s8WyTHN27RBg0QHIJaMAGHA8Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftc7CfpDwdUeZytbo4j-gtRV4Iy_B03kPaPnOichiwC8Q&oe=699F005E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UKyTbBDULcQ7kNvwF-nLHS&_nc_oc=Adn8dxBjUsAIXZmuAVyeeiDeLbeonv0E1kUvTFKsBiNBF4uek-jrOKn3nKVjI7T9hWg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftmDtor7Ne2F-Fq59nbM3fCn5w7GCDmwbUMfMpG-SZ66Q&oe=699EDF17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "cont
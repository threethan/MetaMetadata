_oc=AdrGW5m4M6F1Hdc1R-fHYO6-_5KWJSNnUZcanR_sAIjVr20yX-YtYVv1DFH4nMXkQJA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhe-J55-V8hSI9lgmOcjEfooOmDkb3wDzLTOEhHYEolQ&oe=6A97348F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkvRwAWyr4oQ7kNvwEZVWt-&_nc_oc=Adqo77_t8_A8jS2UETMuWmHCNSIVbR0j2Hqln6Lv2cbVJD5Lg7qmiJLP6Tdg8JJl98M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwxwN6g1DFluHQps08eDaevO98tbC2xuiFc0Yc2NDOhQ&oe=6A97263B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBMT3LlJSzwQ7kNvwG_cp5h&_nc_oc=AdrFzRaNmgoADMVcxg54S0b0hFjdVcmf5MYW606cBb5OsWkYzDI13lZMtExU3Powv9w&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBV7C_GMY5Svkro-UdRP2omnKgceMMefDgUKMK316Maw&oe=6A971BFB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qjkU0fil9wQ7kNvwFJ69dM&_nc_oc=AdpfEvL_aurl_8DkXUjsXzDTiFp8rbmBwRkd8lR6JK_pMxDv1lZbFesx5yPVcwJwgQY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDlowOHNMNSrINdXvS9PlVKbxc1kFjPPVpwYssvSZzfg&oe=6A974ADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0HFPofmytwQ7kNvwF95OaL&_nc_oc=Ado56Xq3CPp4eA3hkvGECUKf1WUeULXyB-3JQEsGdRv3stJhjicmoBarLE3vam59rxk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoA6czVAZp5EJKs8uL6dYWM3Mde3Owij5ol79Or6dbeQ&oe=6A972997"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
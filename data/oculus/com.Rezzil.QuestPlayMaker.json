_oc=AdrDOT4xQA7GwV8NfUWHS8WU-gcemyuuBh71rTsXRF9_9SSbUE5tO2T_RIGBq0z4Qzk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZdMSWOl1GeUof_OXZCJh4j5eGV_UPqeS2PUx8Nok2Ig&oe=6AF739CF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBhw7iaazzwQ7kNvwEf7OWY&_nc_oc=AdqiqPZa6WT0obfl-FyLl64ZzsbvXBnqpduO7UVtzI33rK0FY3wLRbuBsxcLuXzR3-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsrpcF06R6FBrbK9LhfYS9DogEA6Ht5w6_yCZC7nSaMw&oe=6AF72B7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEZ4YaygFVIQ7kNvwHAliWL&_nc_oc=AdpY6JMGcFiS1ywM2jYAyUvCF4d2oF06SYbtuY27L-s915WEZou7rr12uD_9RdDba7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWZHVOrT7lTAPsHqnJFlaSpPsxgyMXAAD6pJukuyQ0VQ&oe=6AF7213B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oCEC03tSRwQ7kNvwGq2R7t&_nc_oc=AdpWjDv4DOPo2E-YYx8Mpa1Du1JYlRwoAOxSoE3j__lHv3t2hnzku8NcsXkVnW99kIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc2qXZp4Z2yxr5N_gsbi0z7a5x76Gi-t5_1bOv8NyQ4A&oe=6AF717DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoGx2pw04eQQ7kNvwGzmMUp&_nc_oc=AdrQ5kIN4RRF786MaBYVSs3V72puOXTvpD55Q894ikDDOK5ZhXTPJMzvq94_8mJ4zrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWjIY6Oigm8zuNw5OQWdxUPc8EdD6GIx096Ybrjv-BPA&oe=6AF72ED7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
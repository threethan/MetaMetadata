_oc=Adpxa4b_STHVHXqN5U3PBWHeeYbi7HKSXvgOYWI9sFL2OvRKCpmbqZh1vOhR85va624&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k5IX5V1k--3LfM_r_wbE8seOhxN00QGHDEuVXAnu7oQ&oe=6A2AE14F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMsdt-mbP9gQ7kNvwH1elFe&_nc_oc=Adpyyo-WtJqSk3BQ_goyevFmtyp0glvB1FHxpxcWYFoOOnh4y903D16CTjJCfjAps1U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GFR8e9fBmtb4I9vT4tZSwoHkoo2JrI8R1pXV_htYUdw&oe=6A2AD2FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2s0zQX2fNUAQ7kNvwEy-zoD&_nc_oc=Ado3GBZXxTy8gIohQoe5-7_-XMSEv2AI0ZhQxpez8qOV-_lKVmChFITsyUwj9Q7At3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UN7Kl-mFomXHreAMw1Dmq8LlOanuFYV_txE5CFh_Spg&oe=6A2AC8BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZmyCTKw7ccQ7kNvwGqqDEa&_nc_oc=AdpPfuMnXyZ9l2i0PTM6qPiiBZ5imeg7hC4yLXzn7vlbUoFrcGfVQ3CBHWVZZ0QS1_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OpifFTuSvEUrMkRqxJfbvZQ29JfMojWOe1pUMeNFDCw&oe=6A2ABF5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEdGIEH0IlgQ7kNvwGzirmA&_nc_oc=AdpvumxJqsglM8rPrzsf_RZmlB9TQ9T6ZpmDnpkt4GtW5lssrJ4e4tkm85cUZY0l1SE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uIqHx4cExzM7kehYJ7yEgqnKAmq_49giFtqDuUiSqlw&oe=6A2AD657"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
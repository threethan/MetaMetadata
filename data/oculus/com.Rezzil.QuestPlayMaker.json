enshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3FZRucdApkQ7kNvwFDJKl1&_nc_oc=AdmbnCpLMY5vW_4NaVUwrTR4dHyf-j3BlNOjHHTZ18QemGAG94z4LZ1MXUrmY686Hag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfynIPYdlIraKuGFrvPpYt-y7XInqu-EW54IzWBsmy8JeQ&oe=69B7F68F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s30clDaItOUQ7kNvwE46eq0&_nc_oc=Adm9Og4wtFFQjPGNFSOO7PmFILFU19CqiyaXEtKAVVJiIoiQ_nSNpEnDROXiM-LkGGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afym_IkD3AVDGN_F8Qo3-EkYxFPTDjeysjfKijTBfnQpaQ&oe=69B7E83B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItpjNtcuqdEQ7kNvwGqfrSi&_nc_oc=AdkFL12ytr2jK0NjIfRqFPOlf-kzHtsESHEXdGTz6jb6MDcANZaR5bDD-DgZQP-VufQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDz1YqIgnPEORvmxJ_u7UM5K4285MMVJUm1iw3BR4Dfg&oe=69B7DDFB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzbejogRQcYQ7kNvwEsLAbE&_nc_oc=Adm5C9uIFb8Axg_BoIKfh3Phh6o2aX8rf97F2zEE7cWt9TwiWiFlKvYmt0M1tQhfyVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxo9g5DZGN5Jh9akvTKX9ummZ3RIv72cMqs5VsRfaWdDA&oe=69B80CDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9MBeX91fkEQ7kNvwEoLAsh&_nc_oc=AdlSbeKLbis5GE_Yy__td19_QSEyXwcPPFUQj-Y9bjWfwAMDC1SHuvXssnR824I_xS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwz9XA-6z4Y2mI9o00zRANhKmLo9F9YDROyV_Bad-ipgw&oe=69B7EB97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com
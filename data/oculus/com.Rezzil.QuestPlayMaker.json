_oc=AdpuvO9qBjcr1CISFtroHAgxOZkeVyy1dQCdOYU_f7oZ8RrRnRjhFKAmsGNhacOHDT4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG7HLHv0hQAwmR_QoYPk3ohrssfY1xUBAT4P1YpCv1Zg&oe=6A805A8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwYsurKMEWEQ7kNvwEnhX2g&_nc_oc=AdrtEQfEKQovJZ9bRiDCluUiXNE9LpTPFf8Tpgjp9WUAfHkHyYccO1vQeYSvYcuWoxI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCBnSZVqJifmwYjpZuysWGu0bzgfNL0t_O8BV7sC9F9A&oe=6A804C3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpnRnoWZXNcQ7kNvwHO4TtD&_nc_oc=AdoC8qffpZNEqZ-MvnnE7UHOFt8w_lltQJAysP9RweQuxcWDNxweC_25OiYAiOKoZPI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv6ikTLU5_071q0YNKUycZ-zH9pwHZJ9JXK_YYt2KNaw&oe=6A8041FB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGg9lia7TGMQ7kNvwEQCtcN&_nc_oc=AdqCE85qD-is3VdIoj5gbfAadwOe8RpaVqKMVy1sgmC-H4ciVqaQVF0ZP8wA7t64qjw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcECvuTzu7jdqF3l0KceprooTdGGcaBm03PrjbH3AUQg&oe=6A8070DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d95bnLKoHvYQ7kNvwHenLOa&_nc_oc=Adq8VmUc-656u1ICGUk6Rb6UXKoVn5byQFyI6TUuOnC9-MnA7Kuf1PK3G47cvzht2lw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWXEM1ksLPdBw0vHxzZEU_eR_yozfxiZViF1t37v711Q&oe=6A804F97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
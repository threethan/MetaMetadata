=6A007538"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnPbDvzqomYQ7kNvwHojcSK&_nc_oc=Ado800D6_a9mvIxo9h5pZatYnyppSUn0ZM3Lj5twL-6ePY5dLNfF-VH80iO25VQetN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L-VmsekhSWQIXQYiu3BRNWbJkuYGj_vNMmgQh6LV7xw&oe=6A00790F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0zmhWd70N0Q7kNvwFQ67Bi&_nc_oc=Adq6oe6-42OfHW71xK6dNf8tIiNaf6a-ZozZpg8aNgVGYbEpG4ounaVxzIhsgTtbElE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L_KrV1o9dox1_wiCwZLbuvYj8xedpgGqNOWciVcK02A&oe=6A00A2FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt8RcctGKRUQ7kNvwGxqLW0&_nc_oc=AdoOZ3j5KTVpF-YRbkFJgYKisu4zCatmfsBm6TXFnjgBbnbyIbZrI4PkH0zZP2g3hJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tBq91Ou5LCBRA4t4ePmgIhoGH8c7YyZ7Lkvwk-WKAqw&oe=6A0098BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=504Hb-u-UkIQ7kNvwGiQ-ic&_nc_oc=AdprlGcbiIu2loWxBJ2bV6xigEHRY1ZQk7s-j-VdzVeGIktNC487xR0S0EOdl-2HMRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ig0sKCiD7SsyPlOOC2h6VePu9Hf7bhoK01dC1SaEmlA&oe=6A008F5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZUUDy7UeywQ7kNvwEd57-9&_nc_oc=Ado7INdKvEWnUCNLVhRxg-pfzmrVpC6sto_o71k9uzA1MguJVMS4EWmG1D_vDjiRL14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5222lLuScSCZ_xg3Kmtp0LGGV3-MBdtpw-MgK2bc_GAQ&oe=6A00A657"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
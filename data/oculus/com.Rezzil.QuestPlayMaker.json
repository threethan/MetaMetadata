=6A426038"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zoob1lClwocQ7kNvwFkNh4f&_nc_oc=Adro9TIlEPtIF-iaWS_ciz1sfIjkFWtJqGhgLcYlemfCVEoeGlF1qwk6AoCYOSeqbnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PTuaU8y0LBMrD8r3nYIJxLlgSlIpbaujb4KW0ifWWbQ&oe=6A42640F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alzY1rTs2zoQ7kNvwFdYdi0&_nc_oc=AdrQFwlLf_ZJDM8glxNEV6cDPA7h0SGFx2ba0kt1BwKJfjHvxowyG83mFCk2l0jXJLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85kKfmfp5TZG-gASZLAUGEMpIDQfYEBWr4EITy4Lp6cg&oe=6A428DFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSaIUx00G6YQ7kNvwGJ2TkH&_nc_oc=AdqlwedFh-4PEymsxz4LM8KUH09sxV7CICU_YrEkx9DdOgT_A8PjTD0wzl3McOfRUvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p1qCFgjV9a21at0vwXIayZeAb3Q1zSiWOFLix9noPqg&oe=6A4283BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8ozSDGqE3cQ7kNvwFpBfY9&_nc_oc=AdqL2t7eT42Sgpo6OXfTBV2EAJsP0et8CLweJS7p9CxYnQLz_Dt_wqWk_eomSfF-iJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CHB5S-tI9r5dyJHMx0jDM28A-Yqp35gPGb9n8Nz3AcQ&oe=6A427A5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gP-xOVdEPQQ7kNvwEdJfhh&_nc_oc=AdoIQJHh4ifo4v-Ghg9zGab5Jr-BItucc6Q1CyTqA1a1gSXIcsoPX3IKsatEJ2Faq8w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R98JZ-gZFoNu8vTsrvacTT1Vkbg1yxpbmh4nZF31CgQ&oe=6A429157"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
_oc=Ado_BN7sWLMwhDKTURhX9lIaLuaBojaUD2018E3JX2-LTnufX_E-4gjztmxxElmmNFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8mnpX1TWHSBDszcI_6c4Ndb3isl9jkH9v6dKy_3s1hQ&oe=6ABD37CF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2FF4-xRy38Q7kNvwFAEIfQ&_nc_oc=AdqDKxD8HibKCX-d9LQlJXy_mZXSQAwhYVNvOGwpd_s3aa2JHG2B9n9n87mln-m2mTQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcTrGA6kOmI9EVgSuiXWKyHZ6Om2E5X1X8WZ30Jd0PdQ&oe=6ABD297B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TzP0ywOD50Q7kNvwGEWw70&_nc_oc=AdpdG965VCGyrc-iMnlnklfxHLSiQhQTy0hVjBjlVaXkSbMYpkW3c7HlS0S-Ul6Vl_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9c_7MD2ZN8cSQ9x336GafVdLPTw0b4KyTlQJDaAo3oQ&oe=6ABD1F3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=His8tKeNcJUQ7kNvwEEj3lo&_nc_oc=Adre_wFkhJqS1UNLEayRHuu2G_VThTFhlmFcjpXki_CjgTEDQS1rIFsZWpQBbr5GQng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEVJPZkdLB12fsVoDQiJAOOlCED2wOiZ_EvvBpyi8S6Q&oe=6ABD15DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmOadXN4agEQ7kNvwGJm0Ju&_nc_oc=Adpo2H7yplzPUeTgTLFpZq8OsUoYyeEAxFJclaMo9tsz3VDnAFdnRRO0ctgm7buF2IU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgUU2_XpYMw0Dz7sxG-iORwiUYuRQ7-xrGQ9qNBBPdYw&oe=6ABD2CD7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
_oc=AdpGw8x65TLjMZ6D0_hpTWvtEU9zBiGw79DuhrDlp-aCSJhdXHoCLWoCGu5_sJUbXxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1lu0osYhNK3JII8yCBmnKfXK58t4-BDu1tj9ESofCnA&oe=6A4F930F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYgjYuXhjykQ7kNvwF3RHFZ&_nc_oc=Adq0dGn-0PkKmwtdGtXIg9OQB_JnutyH1MkpX06H7LNJL_o4YL7Aayr-OEc2G3qKEVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK2Vj1sy4r74KrS0FL2mEDNZfV1kI90MO_2fGt6Gm6Dg&oe=6A4FBCFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0Ttv7d2nl4Q7kNvwGDieRd&_nc_oc=AdoY-zSLSkNp-29kh-OVD1lbSY0vL-x-s3IrrOpnxLzdlAfTIbrsfEWAdVkvtaRG4c8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-duYsSeS8b6iqhgBnzqAidX7JV--IhImx03Jelr5gGA&oe=6A4FB2BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcM6vextjzQQ7kNvwFw8CjR&_nc_oc=AdoZiQfYFlfZFg0A2imeWGITZjOjvUjRYbA7LaCNXLroDun9kbHZgs4X3x_O0FquJns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAaWAvHVdQwNmWpxn1fEz_cqxSYjdXTgxHQnjgHkRZZQ&oe=6A4FA95E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jxod3scf-_MQ7kNvwEqIPo2&_nc_oc=AdqiKfPdlVzMxFAeA1vh9p8S9sis6p3_4jJNWfvFDNuPLRRXCvxCsDpth8xKYYMtt5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZdvq3-Ih9-IcrGOR61T2gJlWVJ-rGMOVt1LBvwb3ZzQ&oe=6A4FC057"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
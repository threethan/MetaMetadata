=6A107F78"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tmDJUEMXwAQ7kNvwE-qbOm&_nc_oc=Adqhv7_N5Pi1GxQvhrATG0jL5Ecd4AJ3qi704zgduq5UrgkUKEORCngOJSdoZKTjp8M&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KuIMkmF9yIYhZeZJnBljjY6bLCuqVbMU1ywh3erxZLQ&oe=6A104B0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Egbin6dahR4Q7kNvwGqKb47&_nc_oc=AdqzuvpIR224kWOBSPA4HcjhFswsn4GaghpXYHNuJUumyJL7i71FLweF2VGkQlUs83U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GzrGDEI9k7MkwHFePZ2puE8A3EMCBaHDI5D5R6dKmQw&oe=6A1074FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FngQcF7NkFoQ7kNvwEFeFyl&_nc_oc=Adrcd4yP85FrraSHLWZxgxZOuFsZvyheJYqOPVV753M3UHXkBQr1IKF_Q9K_X6Nvry4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49Uf_-U3ViCbFKVCW9c9-7-6vcXxVdA62XepCd4r28ZA&oe=6A106ABB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soj0w_xSI4cQ7kNvwGP0cpO&_nc_oc=AdoZtFzicMSacSz_ByHbK9ed0G9kypoR6qvZjkpOcR4DF-rsIuQzg6g2-Ex0Ujvz6go&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BY_FITkuPB0tPzQnI6DWigSgnC4woMjxVFGrUIPVujQ&oe=6A10615E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFOZZf1QQOIQ7kNvwF0OP4H&_nc_oc=AdoML57COGKDMFFCjHEi02eHts7gkSoQxIJMAiS-HaCFNhUYonZuTqtYxYAfHRfnk2Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gVWrPdh4e994hc81Sy3olMrGP7GigRtug7QcnCxB7_w&oe=6A107857"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
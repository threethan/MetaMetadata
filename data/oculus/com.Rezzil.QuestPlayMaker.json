_oc=Ado3qzg3_yvLOsem1URTeojEmJUr9d_ItxpQM5m11KAAXFF3VUCPHc-MmY_h6FfFbb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yxIwVl9k2z_Zxs0sTKrFtzZrmkAUILRQQZutyHX49tQ&oe=6A05BF0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tlw1O1mXo6oQ7kNvwEQ0aZf&_nc_oc=Adrz0zftK5ogmqXmFq6L2bGIMgtXL-EQt6oSTvfUsz1uHiej8_Jly8tBXg18YRgGu64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zrb7LSeFdq2cVw3XMczacQ9jd819hhWrhSFKC4bOzlQ&oe=6A05E8FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8c98Ic_GkMQ7kNvwHc6ZVQ&_nc_oc=Adoa-nHi9hpMYeeYMdYhQAXAjX429x24xPm0jS0uYN1bbNrXCm45UdwH1bhmWj4qVVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DkhXAtXHszInUSaCH_7tqZzk1XflPrCJGtw77xCVDdw&oe=6A05DEBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJvweCcMsNwQ7kNvwFG_Asb&_nc_oc=Adpv2II6B0JABlOxLmyguJRGdQZpmIT6oy1a2r0oiMumskcrmw6gBO30Q1N_TDWZKIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HYCWmSX59GyJqi1VfRxdd9MzQrWWjaDtTNPxtgGn-MQ&oe=6A05D55E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvv_3mrjR2cQ7kNvwGz0uwe&_nc_oc=AdrUzsNnd4we9jpa8KzTvR0Wd-PfUad3E05Cg0SFcvEUVur8E66TFaS8CCowqiR6CW8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CDEjBuovlawCfqy3Fb8L8G53vmSh_L02x71EMAW33CQ&oe=6A05EC57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
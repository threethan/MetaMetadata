=6A9D57B8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYAcLmbLrzIQ7kNvwHcJSSY&_nc_oc=AdpChmf481qQm3_JO-DWKLdudnVQF7Nr24KL0381X7v1sl4nXVAX6OzNFM9du4tYVHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqLUKXfUPc5ct11wfsE3slV3ql1EqlE6EwvgUfubOVaw&oe=6A9D5B8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZugYv_dEC3oQ7kNvwHtSmJE&_nc_oc=AdrdF-Z5ShH3gKqw3UoPnN6Zm1qWDnRpWa79ZGvXE9ECyKF8xvID1q13uggZKKEQETw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILVa5lkdfseObaeegnOKABARj3rW0fAT4YGOd7TfmJSg&oe=6A9D857B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N503zeLhbfkQ7kNvwEOXGsc&_nc_oc=AdoROsw410EsElcZgFq-vWaehGP8sQeQXu8RVZ9p-fP83yYsCl9ytS-9piOBQbzQA8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf5mqsIw2a_pYU6hHBvthr7h_8XLovT6mef9Aabk6dVw&oe=6A9D7B3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeBSDXkUhcIQ7kNvwF33Luc&_nc_oc=Adq0CZy5-1GS2Mj_Ey3cRQeJ4KsW6cpiQKESqUBgpAUpuq-LYi1Er5eOdewEk_gqpxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8J_iI_akH7690IJXhCfmKAQHLfBTlrtym0Ui_XZlnwg&oe=6A9D71DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g8M0ZUTRVcQ7kNvwF-CKVf&_nc_oc=AdpESJ7LUl8nWQmYqS-hqw6Jm2c41mwga3h6svWjj4q5qN5kJZT3R9NQSpewf4DIaQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIGDQa-hORVn_cvJzbxy-6OSGp_rc_hPk1tdF1fXGAHw&oe=6A9D88D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
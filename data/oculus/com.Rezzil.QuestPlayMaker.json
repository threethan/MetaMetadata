enshot1.png", "id": "191426200727649", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT3M3yGBtPkQ7kNvwGnUgaD&_nc_oc=Adnm9Y1Z9qk8p59GKIiAC4RAgm-FnqunhX9W-5vmYpO3GCRU2l5gtv8Tt0FHKwfyJTo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRLl6gSV5J_PxTUMrhHeXSQkpCG8AA_Ee9aB2bh8IE1A&oe=69BD3C8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m4bRaoyadsQ7kNvwGihtG5&_nc_oc=Adnddw-u7A77-q7NSrfOiBpHzdyag7nRi7vmp9njRrXGwfWvzRffNNGyRaCmHjSdQwQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyN-qEaKi1BQema7i6mAl0yygCDCtBX6sxwcPcxW29kqw&oe=69BD2E3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1-RJL0zdfEQ7kNvwHjxbdu&_nc_oc=AdmWNHjS0Yn42XPF04o76D0_0RWG2rui2_V_ngFFafaogTSbnBVpH5MHsQvpMLmh0TQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6JgCyifaEZI4qASbpKw9Jnyzker-_3ohhafZ1qm3XoA&oe=69BD5C3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTyGGdBncwcQ7kNvwEidCq2&_nc_oc=AdlXj6EldkT6-ZRbD2oy6chPMhJKMW-CEKW12Ue0KtePFdi1vokyoMuu9uInax2basw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlnWf8N7r1EzBDG42ft3D_ddNFB9jnwecEioqPXEffYQ&oe=69BD52DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyjAExtuxGIQ7kNvwH5Cc0c&_nc_oc=Adnl8e9aSki5tM6-tyLTeUt1qmLzp8dh7nHTI5F8Nj_NI-x9sb20mcbOfa5kz2KxPw0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaKozUIx-gzJi7ZQZ6vsXPJ-2ak8LKwbADVFQAF4ADyQ&oe=69BD3197"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com
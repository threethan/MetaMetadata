=6AA29DB8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpaiE9nbjgkQ7kNvwG_MRS5&_nc_oc=AdqJVt9vmK9UowXjq7c6yhkPkI3_asMZ9gXYRGUsX8nYBbjZg8qs6CHNrRItWMNtixo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5K-ARbRrV2ny4rKj25ojQStgZRHgj-8clfDVCgIbnBw&oe=6AA2A18F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfxsk58wvQoQ7kNvwGt6TsO&_nc_oc=Adr1LmtO5EvAdWsQJcB34ThODMDw7VbystdsA3ek_xMPbfS8-ywlyyW-_ntQbThinkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCY-wmKboaOEYXRzbEbTz_Epwa-X_bx3Upu2S08XjC3Q&oe=6AA2CB7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otUO5GQjMGgQ7kNvwFmbuKQ&_nc_oc=AdpVN4D3Ahex1FQsL4TtgINnr04gXv5aInKfqZd5lLXLggL86KPsoqcQYbRYPmtshVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpVAu8QMLmJVj0R-ZNr_pgdJQlmap-9RPRPw2ubSQeSg&oe=6AA2C13B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9JTVdnwFuQQ7kNvwGU0Oea&_nc_oc=AdqSg_VhvLezfUJmzXogIJ1wmA1OBAn2zYKjxMO1gGxe7-upstDlyKc9Xa0CzH1AlUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhiEO8kb0EMHNiqwGEnsmIROhenamgXtMLYtMOXe0oIA&oe=6AA2B7DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMwz7rFdyiAQ7kNvwEExUad&_nc_oc=AdpZ5RhsXlesTTg8MsMifV8SY_KSP5Esp_JtfPLaHTB078cam1efgPnIbHhPqNkypsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIebgKgqFiPZ02PfMBlTPABrqdyiapgMKI12HUkzb8DDQ&oe=6AA2CED7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
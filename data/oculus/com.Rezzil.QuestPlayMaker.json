=6A2953B8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOZcQQ6uofQQ7kNvwHWmLt9&_nc_oc=AdqC9OadscxTKkt2Y1W9EQ9fk0XO9IuvfcixWbgxi2WQ9WqrWN9UvqX-MKPJhhbIq5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zMncOHDLojE1-xU3oSsLkJmci7Qu32aPmon6yRchGrg&oe=6A29578F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMsdt-mbP9gQ7kNvwEe9abY&_nc_oc=AdqMyox28qwyXXRW-FlNylKYbcFHiN-ThDlhly9-th-22KhYM7cCWppzkx1jfQvcAfc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e1LEjR4shYHV3l8ZSwSBoO3uwImc07P7O969EW1woQg&oe=6A29817B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2s0zQX2fNUAQ7kNvwF_Yvid&_nc_oc=Adp8NSjQApSmIt8uRvbMAtRxg6IBqHwZzQ7n7qSOsFHoewrijFtbEmPL7QR3vczYSDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D0_if86SN_Wc7hVNavZGpXE299JNWJ_AyLhJQEHMa4w&oe=6A29773B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwY9i3HvuE8Q7kNvwH2KLoh&_nc_oc=Adr3LM-UZJgZ7MyGieXmkoeYaq10BtNzMWn8dmDJPpbsrlhb9p-ulGsmbCN5-5aYR9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tYy2dCmektF8xiH9ExfAfvjbrfCyiYd0G0rrfqIaWwQ&oe=6A296DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEdGIEH0IlgQ7kNvwGpvGr2&_nc_oc=Adp-kzUr9kWZ6bQJhGTs1qpg7uuTDmZs3gR3-tD8cw7nj5m2o6IE6GeD-262hoidJLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MlzvBeEF-kVZV9m3IBiWWzpB6TZ5m7FUfFPUTtYusew&oe=6A2984D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
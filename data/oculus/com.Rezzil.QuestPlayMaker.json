.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mn7G6be1vU8Q7kNvwEoCUoB&_nc_oc=AdnU19JK7MjHdyy7-aivnDhG08kFx-aOOElpRXrIWWWvtvku-sFuMT22FHA4uFBz1NU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvovH3dBKRGtQFKEEl9JDUZsmXReVcKLQL1wugAvMXvrw&oe=699C38BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGv8yRqVxIUQ7kNvwGCFMqj&_nc_oc=Adk-v-inwE_BWAB52te6bXnePxgNM4eCI-X455DOSbIBdCnhQ2CA6oz6g30dMQCF53s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftSoiplmlfk98GYApc6RM3JEHiuWVRtbNDvqCU8KBfKrw&oe=699C2E7B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCScZoW8IGAQ7kNvwHxBSn5&_nc_oc=AdmX_GL8TywxN6YLvnsXZBDLOsgckB30-V8bzcBo6031NJ2VNSc-US-7eWVREcD7Tcg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv8VzCm1rtujK_O4apSs93g4NfCgBhSvJj9-0tcxuZYUA&oe=699C5D5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNppmLTExh8Q7kNvwFIJ0KM&_nc_oc=Adnhcnd7WVTCOIXTx7T6jdZOROQsFVmdLzxHVAQ24Sek4pwCAjk4haoe7S6Ri4prEjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsy2SYQfGx8AkZ_GlGBFG0c6weeltzCvkv5lkVIoxlfuA&oe=699C3C17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
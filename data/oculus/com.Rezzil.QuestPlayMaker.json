=6AF09E78"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oE4wmuc3H8Q7kNvwFda7TJ&_nc_oc=AdopAEETHRSWSFZy6vDVS8zr_pZeHG1hgzXQUUEOsQcJWGBMie1K4_OEmZkdSh4k_Bg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfhoRVdRFsh58m3p4qqtimRSrniIFnqMclo7glJJhfUg&oe=6AF0A24F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IO8sF7hda0Q7kNvwG78WNR&_nc_oc=AdqoN66HmAPJOFDLaojy4dOhPzIrqo7rWLXheNTVgUNci0AmutPyaGOo-sFa5FB-gg8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToXfsGzXWoUbQNGouMp5Cd7ksvkHkdjRUDNhVLWZD8pA&oe=6AF093FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF4SUshWbAgQ7kNvwG2I45Q&_nc_oc=AdqBT96PNF88zDb-Yqg91WwgREbAfJBqSB_WiBddeNstLgoAJbQp9SrMJ4QtV69Dz20&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyoYL9rHGCQ-5Cf7bIRi9gFxLjPr7ZZD0GNRw23NfolA&oe=6AF089BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1diEpuzMa2oQ7kNvwE-ipog&_nc_oc=AdrVqwFc4VTd5WeB6_EvdRyqo6sTDifMn8FB8-AtVNBYdFJXD7qIW_pxbtisk6DvqCw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVEH5iGEijieNJNvVO3wZ_-cyg1Uamz9nsipJFC_Ismg&oe=6AF0805E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjvKZf0A0-4Q7kNvwFMWcbv&_nc_oc=Adqwr7d9GDxdGqzgLrTpWiSQHmIhPY6IIJJLDUzZ2BP2p-yWft873M36YnrHJGD7v8U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4xq1J5ByfqrDK4-dYQH-OcsIO9VQ3urv59fLcpE7s9Q&oe=6AF09757"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
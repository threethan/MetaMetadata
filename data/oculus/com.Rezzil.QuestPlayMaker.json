=6A6C9038"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3pkp6rKXwAQ7kNvwElxqoB&_nc_oc=Adr9IwTEb7keS6TN8TjDa6FdTw78RuUjcCCoANXen-b3nT3GufsVmgrGChjhXJRlW5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4jMQ0gmMCXgoWrlivKjjmStvXTDFUjBkJrW5ZxP3CcA&oe=6A6C940F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3tbL7ZnyfoQ7kNvwExvz_9&_nc_oc=AdpHkNLHXWkTqWjS5MsWaFetKo_gbhSteOaL7PIDXFcJgh4YiXA8w-d9ppqjOj2V6hw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpOx6CzJuSa0T1s6BLnqtKe_-p29iMvX1NMkS8toc34w&oe=6A6CBDFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrYcwqRdHxMQ7kNvwEThjbp&_nc_oc=AdrAO2byyyWjE6GP4CLi8nTNhYPip-1GytL985MGnwPo3c3JroPfSSUwqFuee4BDcJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGHdYk0djwVYLk8j_vXWNLsMEKqZb-Q8xWh8aCQXP2EQ&oe=6A6CB3BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdR3m5xJ1MkQ7kNvwFt0hNe&_nc_oc=AdphoFeZoyXvoHdZ8b_T6s4qDS4Tqa2KDP986RDn1Vz48fB943VrW--XZQFXqndQ9cU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL5QWBJzmQxk8S6RE5CrZjLNMuWaEQjU6IeYviP-I0Nw&oe=6A6CAA5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_VZ-JOyC5gQ7kNvwFd4SUi&_nc_oc=AdomAqhR5o7-Nommx5Z8DST8ZWts7A_zwGzEspYmn23jiuoORJalz874pS9rv6yTIUI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUQukuJEih7FcchcC6Ehrrj2341ujy352OK8Q_nVdqjw&oe=6A6CC157"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
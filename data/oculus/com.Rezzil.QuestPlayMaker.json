_oc=Adra5eq7xOdmUF7k3YxkR6XDdLJyq0BBhqcvqpRbfr1YIQ8JMo_wupTZ1mY4Tfp_ZEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Y6r2tpUkeGx01Qm6mQ0bB_ms6kDd5xnlkIY6UcGHgxg&oe=69EB610F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn56rIMPF6EQ7kNvwEu_cKJ&_nc_oc=Adq1KJuVhorAEUhkeVTX9SOymGpXi3ddkQ1hUCFirEDXTunFAxhyXdbdmCy3ZLugB6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1a0u1jtD5eOr2sPiKhYBY7sjcef2OKyFXhxhPk4G58hg&oe=69EB8AFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKAuEfvXcYUQ7kNvwGqMMay&_nc_oc=AdqBk1ULHddSIlO8jyCzfTWWSkHWaKSlu-EqdhKNPY8CUTZmfBrvv-JJjv5v0gvufiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UQUAvsJttr-J2wPTuPkx_bwEJ9Wv7kiHp3UnPFODHQA&oe=69EB80BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fViowIsAf4Q7kNvwHOdAML&_nc_oc=Adr-Adtu6jjl4Kd_ZlheyWJ4pGdj_I-YeYh2HcB6MIUrzUDZizTXT10E7CixfgR3ef8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Jcf9lCLHZ76b2745GofwdRT_rvEbM7dUWZkxp-0--kw&oe=69EB775E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIbqYA5d4x8Q7kNvwFx-AFG&_nc_oc=AdosByvhWWcBEhTaWOwYSY20lBPSTaUrSCSbKJj2l7ExExjtQImUtriWgfjwfp4Cyik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TCti6x7DDIP11deXm126UthgiLY-4ObXXgDn2_MdLmw&oe=69EB5617"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
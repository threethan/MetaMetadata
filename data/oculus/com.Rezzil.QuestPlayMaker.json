=6A7C6238"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzx5vEUuOx0Q7kNvwHQx31H&_nc_oc=AdpU4mPNaeKUNwVUvn9TNllU-7wQMDzfm0GKi4SKfkZFzZ0YUnt1iUOmEUPcQFb81Qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq7hcc86yBBc9tJEn0tShTVz6DUXLWiErJxPyjr5eNJg&oe=6A7C660F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kbhx3vMwSdkQ7kNvwFYEtox&_nc_oc=Adqvy2yzh6Jd4B_lrYn4oSTPVddPdKEZ4MOUj4sVUQevPWE-g4Ry-Y3aLunGkgGNz8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGdjZ4w5vs3WvTOygwUCLtW6ob2u8R9gq1kFuT0RjHJA&oe=6A7C57BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kv1TMJmQhK4Q7kNvwHlHw7c&_nc_oc=AdrnUsQh84wHVMOTcKQfeSNoTYTZz4tW15bKXIYr7J2yO_5duP2E6Iub5Hn4EeCkVbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJyM9ylYs3seEsUemGXvmkRSSiBU5ddrxEMVIiZ42dDw&oe=6A7C4D7B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JCJCvty66cQ7kNvwFJ3-UE&_nc_oc=AdoEJb5KMIcOhl74zYiunHrOHapPPkdzaq1elhkEBa0fzZR3warxwboOVBuLIGvENWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjzqP2obbHUnIwPXIopMgDdV5u55nbfOKbdzmZOaaLoQ&oe=6A7C441E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbvpykoZGToQ7kNvwGQrOXn&_nc_oc=AdqHfzG_hSN-Gbr573fLyLu_3_YX48M5aAEWgNS800cVITvCQIBcidXpObQ8si5uvq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPYZ4rtZ3dhYSBgAbd7k5JziptcVvauwsUvkwn6EnOzw&oe=6A7C5B17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
_oc=Adp3eLCtgwsr2La2TN-z7LbLo3xhEUpTnB0bziaBpY37IOwzKT89SseAAhA5I7W10Ck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJcwy5VXErLLTdFbZ2ZNC6zHINRQuR3RLwSfwnyYqruw&oe=6A77200F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tg6spB45bIQ7kNvwFj6Y6D&_nc_oc=Adr1es7A30KY63sUWFynG-Kzi4_E2OyPFgYEgmG7QbIAOO2qEAlj-NzlQlevHi8yn1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTLo09fNPB-VzS87GwUCWB1GTmFLE8J8DhYrabg03APQ&oe=6A7711BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3cO4NXPoA8Q7kNvwGWTpNa&_nc_oc=AdqLWD7aM3Hd52ZJgIQNsjlBuua3_Emf6f_DcHeOdR26tbWk089ioeGQv6segAqQG2U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8KsDWAk85Lzuhwyd2uIJDm3t9HVxnTx5aZ0ZmKTAQnQ&oe=6A773FBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpmaM1YfvAYQ7kNvwFTKoFM&_nc_oc=AdrldYKXwZyam-gprHKqVhTVJrex85jZAyVGk05tAgspuwoM0n4IH2h891YwqhaL9x4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd_SUdWPyAEoRqYNXn1hzLVtCyRvFqA1EQJwCRfx_asw&oe=6A77365E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3osLKY8DugQ7kNvwHrIu9q&_nc_oc=AdpGaLEgeLv9O0REPuHrW2J18ZO-od8Y5-wITNlEMF8k7p_FNenNPHaFtYGWoLoktGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7JRUnhi1vDGENO08Wt4FS6RWdbnQ3DnfYgxnGZU_jag&oe=6A771517"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
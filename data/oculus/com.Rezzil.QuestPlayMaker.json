=6A7F0538"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iYKkq1eJtUQ7kNvwFzH-a4&_nc_oc=Ado6eQe6d17OPIJhs9RmdxzDMkxmEHr1CLPrSFgdL_VkKoO5-BSHRmfpUlly3swX7bQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKyiKH0Zb5d9GnwauBMykrqgH0qezzE5yen8EgkD2rgQ&oe=6A7F090F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwYsurKMEWEQ7kNvwGwk9is&_nc_oc=AdrAHgfrSqJEITb5oG3i_F0oQZjfFfbQxCi5Zcc1KFBVihZHGro4Y2kb5bh2Tx3Y6Es&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_0CdfecS7O9v9CIRxSxhiuSMUJJg1fYKePXSiLaqrIg&oe=6A7EFABB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kv1TMJmQhK4Q7kNvwHMfydd&_nc_oc=AdoG0HiqxRuOwzpp84caWZNiEsKIXmtH-JQmiMqyoTrmY9kJheLlPIExwul8ul7RkFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm-c4hDHHUFvM0l2rej26-a6QNZ_0bDN0vcFuWkpJqjw&oe=6A7F28BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGg9lia7TGMQ7kNvwHhhWH5&_nc_oc=AdoJH1zEfOZRzIwVKp2KdhyGtnMeWgZ6G2a0N8AW0O_OHJ3v_cCm670jehOLbezHKVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAsDDAYVQnOoxqx5YdyGqGhBh2u7XO9HXqYslybKvOAg&oe=6A7F1F5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d95bnLKoHvYQ7kNvwGz6-7K&_nc_oc=AdobPS348F0Cr_1ZenjMqL0uAUJMEa4pLjTHvb7XbE5TyTQeX2uQEEmbl3SZjci-OSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiY8d8_OjAF7LwPGQUoE8jSad-zP0LwOVjTQiD08YhcQ&oe=6A7EFE17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
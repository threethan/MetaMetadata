=6A4CEC38"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj2RmTEQADYQ7kNvwHU6luY&_nc_oc=AdoJjVwmFYxZ-NbhNgBQqd-64J2kCDc-vAo6ixecUJtKAGXSeZu6jnolrHYSDHJpryQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGzn4_80sBaBoFwLORMQ7w6SxuBuNg84FhkdXAEjE8Vg&oe=6A4CF00F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqE6gXEtgMwQ7kNvwG3FnHz&_nc_oc=Adp0PQSsEtoqgFUMFPLgbQzwwbWmkTrwjtLrDSGS4uJ69_dk_oRPC6bN3UDPeRZsoKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuggKMTvHX8kbkxLfPTBPG13Mu0OWd-yU-UoGPxmOZ0w&oe=6A4D19FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0Ttv7d2nl4Q7kNvwGcpiGv&_nc_oc=AdpSsVRhz1luinHavV72ECHoi3h-2Ic3WiNxlGdjNQzl7uOPdlhk-jmUH33eF78APtA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOQjUStAY3VvyFzvQerl2o-vYVcB8z7kJbWl2s5E5brw&oe=6A4D0FBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o29nTVl1_UQQ7kNvwHjqWMs&_nc_oc=AdpdlzZmOnuJgeHHW4w_TV0DDiYag4Hfd3aIH8UOJLxyfzNlPv0eBc7oNIlJNKusV94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3kyrCHPQvZnuHUZQqTC60-4AUrm0NVpy6u-dsiTKJYQ&oe=6A4D065E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dsi2ZeJy0NUQ7kNvwGkPWgM&_nc_oc=AdoRfoaUvsuxtzXidIk_stcQuX5Gn_3rmXAkn5a21Kq1qmrWiJkrymHtG9G1bVjZNnc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABoJfwQcnF9bg0625HXttTHIyrj5-Sx67DK50XQVtU8g&oe=6A4D1D57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
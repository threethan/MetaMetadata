_oc=AdooQdhyrgNcqIp5vIDPjIuZ6lh8H138S_GncMTTnhxRPo9ZGW35vlm-VZJpme35cWQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymVStqU6tu3PuNO9VDDT1kodCtPG7SoYjPemiuVrBPgw&oe=69CD0E8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDx7EW-rqmMQ7kNvwGb8LeM&_nc_oc=Adp3sTXOzPTH0SZsQdRGjF58sa4vkI39jyAH9odf2btd-lApWlsWAV3aJJZKhJ1HNBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxA9bzcBNva4dv2hbXNC2klO0Ou9E_RmI3s5MVLFsQlAw&oe=69CD003B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWrz1nLbY7UQ7kNvwGrieKl&_nc_oc=AdqzkTZ_fHoPXhk_4VTDGEU7ziWPlesjIBQ7_JFE2zEITMau_mKyn-0JeAAHc9ygS9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEbIEc3a2G19w_oE-S-iZN-WlcPd2auYeIXh65oH5XtA&oe=69CD2E3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZAn6I6oNWgQ7kNvwE-XTRg&_nc_oc=AdooVhqXH_c_l_BKUXb6chX2fiaEIOzna3KOLBE8Tbl82Oc-IMtaehmkkTs9GPdhPEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw51o2pF6npQKzDizsp0CxVuiGVbxGzB_s5KTlzkN0Ebg&oe=69CD24DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O0p954bx2MQ7kNvwF4AXnZ&_nc_oc=AdrHVhZN-TxwqIllLFjy5uoKQPdBdCjgRJ6rdN6Re-5Zh-NYviMsKjsquU1iOxszC-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcntF3Cu1SFniZb6xNbqRTqnGvzeMITMuaml1QFFs6ug&oe=69CD0397"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
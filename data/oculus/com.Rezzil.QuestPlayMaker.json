m3A&oe=6A22F478"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttskvEd_8VQQ7kNvwE_gTG5&_nc_oc=Adpbo5CsbzOgx8_6IAgsxwi2BbtbrnGBDA7R3IT2DeBRbmy3yCwgtpOrffAyJCs5tJw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84cG4oNr_j1pWRkhtHMIfyGdvt6nc57aPW7NBm56vaSw&oe=6A22F84F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_QnxZCdZVoQ7kNvwFyj0uP&_nc_oc=Adrjluo4k58hCQ-yqVjM1ZqmEGBrWxNaE6qO-O3k0Eva9u6Ujz0CR9xy2VL2-k39xsE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ARZ5L8oFwVjOPTu1EOcxztuwBVKM2V9QAmoXrvfwIiA&oe=6A22E9FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFkfXck_TDMQ7kNvwFsAJQ2&_nc_oc=Adp_6Xdxc1bky14s_HiVLOiErL1Cbonv4TPppho1gDDoO536d1-2exLgr11OBx1WroM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97PrDukY_9XbV2ILaRV8v2nlDuv-RSLI4QL0FQDDEGQQ&oe=6A22DFBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPbTd9OKLrkQ7kNvwErkONk&_nc_oc=AdoTLKUH2RmdET4wYuoo5zsgOgoYaksWE4evOS4Mhs9On5WYWhzAneuf4l_WdFrKwok&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dEYOUYxxO57hCnLdx9eXuGMNjb49jm0yrmijmfH0vVA&oe=6A22D65E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApRZDkijU9sQ7kNvwH0j9JC&_nc_oc=Ado71qajLpmoCKF4KE11XOLhGvSf7-Wsqhj4P4Z7GiiSWZui-SBGPw1XCoSHw-U4nTE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Eg9TaH8uUdzulffTi53oT7UEwBCNEicdrt_P709HQ3Q&oe=6A22ED57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzi
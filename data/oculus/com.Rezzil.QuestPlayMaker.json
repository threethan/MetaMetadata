_oc=AdqueZXgb7Ubw3GYGIjZK9IaQXeARpHLk44KBW-fvteZaha50r5U91MqXJbUwSj39x8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjHtbeYo4G_qTWTIuuwr3xWZLJknoBsKcR9uuN_U_Iog&oe=69C2828F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1mc9ZoiV00Q7kNvwEevw5p&_nc_oc=AdqRMjyRh6FY24r-y44PgpIwiBWDwvvmj3RCJlIJyPIGA6Hu5XGBbjmvw1FKmzRkplM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySQq2L0dBG7ju3rsH9eH1ct3Evdw-SgV4h5GEm19fFMQ&oe=69C2743B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cmq-Zxq40iAQ7kNvwEEjIG8&_nc_oc=Adp_P5Kg1V0157vJ0CYNP_dqkdSH5jWU_0x0xfbvyjFdF5AfowO9Aj7gokdGECFRWd0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyG03Sq6QeISaGGMVIveXMXbWOCvHKo5Zd3NxNGnHJ15Q&oe=69C269FB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr4A_jmcNWUQ7kNvwE1tQWX&_nc_oc=AdrHVtE3t1Ywzr6zwew55eLSK_GluAJd78dGElVwgz0lCOZB-V9oAGSrxsAaR-EApGg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO7rBqSm_P5FEbOEFSza6QzKRlQU_KeuikKh8duMEsxA&oe=69C298DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMfsj8sgr5YQ7kNvwHfvkoy&_nc_oc=AdqliJysGzcejV2kHxPthX3Z0aSr3XjEV-9IgzIf7N41SdFncs91PFxbbqpA-Tj4tBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzo7dLImqN82M3xMopH4z_sZkF8F5rZeL3CeKzZjksw1w&oe=69C27797"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
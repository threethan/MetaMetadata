_oc=AdoQATF7S43vm82QzQLMiH97DX7y2zBDqlzVcL4UnZRH46hq_Xt94M0V8zCm9wFiqOk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-0zcNUxh8owiakd4BjrmhQESjpq7Y_snRxK5eQaX1ew&oe=6A58CD8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNB87V7eIpwQ7kNvwGH8YFO&_nc_oc=AdqyVm8DY88lnQ_7ehpa02syh3iXjNMHAAfacJ768PGqRihHSEvsfr_TKiROcwwOuaA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaoZsIhyP7IVs81TZ23aF8PBvPdrKuROyrXe-sqNcEVQ&oe=6A58F77B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtpTO5L-64cQ7kNvwFie_uq&_nc_oc=AdqqUbh2cvV5FpR8BCuIAmPO_QZXjy1gzktDVPoI5EYHMvCPcAIkZo5doo4e5RTMqPk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYbc9IU1-vKgafB3vsnnMVuIzUQnEJshcmlrKii5mnoQ&oe=6A58ED3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciSeN_uEKHEQ7kNvwHzbh8C&_nc_oc=AdqSWxbEpXbGcYg30CVTIth7MhYDxcyNdvAaelGj8vjFI154U71KqUQnHUrytId2B9U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIAxC3Was5fPH45FXG5GrjHAk-DOnUg1u8QbYaCpjCNw&oe=6A58E3DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOzRt52E9-kQ7kNvwF5HZ-W&_nc_oc=Adq3G-0XGgFxxNW3bVkF2m9uE0dZPFYPLZzn2loqVv8dAjrx_sUT5phBeOlluk-3d10&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDILPK_D8aWbWcNpMvUWW3OiB0qTuEsDNf4cp87wcfsFA&oe=6A58C297"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
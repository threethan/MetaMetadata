_oc=AdqCsODYEBwwXQuCR7b92KrsjwE7qB1-8ticKztWVRWRtPLHFg3SDCgwdmQsuGX2MXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7LB-GkW1PD21wOaQ3FQr7k7p9yBQPIRy0seDzUA1A7Q&oe=6A5F650F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JU9JJmSJhwQ7kNvwHO70W-&_nc_oc=AdqpPBy7prpezDG2KAgThJX4WA4mrmFNQtXQCkH11_7_rbnYaITiBK7txDZUnPMsiCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1lgv3-fmuadIHVBFGTh7QGdMtXzKueJ4km_nOS8VZ9A&oe=6A5F56BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH3J6Sd8H_YQ7kNvwFin-oX&_nc_oc=Ado2xK5k7zmT8W9fjq-EgvDLN2flT8c2G-fQ_xBb_rbrLxl5RKNlRlSQAaWDfRpprZc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsxwAFiS3lEIH2BS6iOYR2ode0-lp4zE1jP9xyDQXdFA&oe=6A5F84BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePdLk0SV2HUQ7kNvwGbjbUX&_nc_oc=AdqxJvOOCRaT9vooB6Z39-yVsw5MuuMCyuSE4XMMILrrRlDrV8g4LKP0iYcGCFimac8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_sU4XsNBVV1ODQFBVNHqnD6Dam9itkCc7ZkB9e7m8Jw&oe=6A5F7B5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQNX_QZiQJIQ7kNvwEfM3gC&_nc_oc=AdoSVF1L7_8iuYHYYqh7s2QCdqxsr7yfYBHJjBjTrJIYearIf6NspV6wU46jn0v5Fz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKolMlUrlbpgLciqmMeQPGOHiLJ8a67Syr3SDJkLD6NA&oe=6A5F5A17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
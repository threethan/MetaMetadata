culuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7tFYauAQVcQ7kNvwGZbkPH&_nc_oc=AdnfaYRAfOobq4iCcU7XC9kWjymoU16Ct9aIa1NBzzUuwO-Bb7BG4U-kItreJo7l6tg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsReO1FsDra1M4nBFJZjiKZsLfkamURkYlgTh94gPNjig&oe=69A5818F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFBh-XlyqgEQ7kNvwEc9Im2&_nc_oc=AdlMqphhjjSekW-a2v-vKlCUiukrtDHMmX47U2Ia5Nx3OxaB3XtvRrCXwXVN7S7RMwQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftW2vjc4UsqZuQYaYZyZOdWL15j4vuU4eFF8UetpYaHpA&oe=69A5733B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6llsZcE1TgQ7kNvwHB9caW&_nc_oc=AdkdDyvRHFTJRmsupodnfDuuMqJD9NOC4aEXkZnaR06jufHlmVyz1hJv2DQog-s486c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvf5P_FKLJcprh-KdBl2cRofmRo2DmZuzIyJ6EBIqwHXQ&oe=69A5A13B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNbSEQjlWBQQ7kNvwHG_cJ9&_nc_oc=AdkjnqokuD29S9m9Nis-eiDVGXsqsSQgLhc71uf649FQSjmJalaH5nEjXhyPJf3VWZU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afunf6J9qdlnJadwc3_ADzd2rFwZBd238n2WOfv7LfZ6tg&oe=69A597DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzYSGP-rrX8Q7kNvwHD3a5P&_nc_oc=Adk0N_a0Ty6CuMyk0J1suFkzV9SueqbJ8XDUHE1Y9radNeGLnPI_M-a3zuI7YvphLmY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvHmnCFeq-6G-PuiahDeRqDGZaVBlfhwew0v0z-liMRLg&oe=69A57697"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "cont
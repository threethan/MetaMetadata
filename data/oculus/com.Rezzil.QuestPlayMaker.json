=6A070CB8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nsGC3iYprcQ7kNvwEokhkw&_nc_oc=Adoegprsok9-EJKM3rA14gv-4vgq0Ebed0jxn82RGoBIycZXy7tv6dryWlLnOLioatI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jp6vKCESzN1Kz27I_Wh3WG5-rnwMpeS9U-uUYmfgJEA&oe=6A07108F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tlw1O1mXo6oQ7kNvwHAla1i&_nc_oc=Ado7Dkx1NU7HdcMmFog3kHwptVDasOz4EAGdBUjWFicSEJdAd1BfVxiTJ0egKXv7m90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zZzIqhogoCVfESTCS-jEarStz7P1nkBotF1SJajnjmw&oe=6A073A7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8c98Ic_GkMQ7kNvwFGMDeI&_nc_oc=Adp4_VXXAcmZecsZmDPO9jM8MrZRNuSLtjmEJPakTu-FgHvLdkqjYpMR2YGz2OI9574&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S8OmZaEzvViubBZEw9E1ATzqSh2CnB_yRE027P5QEGw&oe=6A07303B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ilkPVBfCY8Q7kNvwG4ShD_&_nc_oc=AdqDpfuNEkPxTMP-bcikoG1hbuZNZbrijLz_lUx0OmIrnmugrmiyztEvlvuJCud38GM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MkSftVG-SK2daNpkyob1u8qwtFP6L0V4OrTgKvN74Tw&oe=6A0726DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvv_3mrjR2cQ7kNvwGV7qgA&_nc_oc=Adpai3EQst7aG1A02H2VsfQLbqQGnbmGasdIxAZpR3nMtVo1_DD4SqwCxndjuoeEhN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UR-AALgJkg6X8Pj2f5s6oOaiheMRDzdfvNDiSXwyKRw&oe=6A073DD7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
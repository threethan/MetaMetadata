_oc=AdrLZvRnNGttONagUgp_JIqDqVQT5sP86OF4fLjXCxyCCQ1989RXWqOW41855k28-4U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUXNrnLQFl0LUJM0vOndbydUEhleRMG5Tz7XBCWdEMBQ&oe=6AC9154F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzevU2sZtSEQ7kNvwE0HH49&_nc_oc=AdreI_Hy505OScuRb5wUuLhj-7TJKfdbew-UBwkiuNT1FLzjCme1_UvSP0lX2Up8G0w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf4qf5HoYvwfaX49_EBJ_PKx4HlpJcObnLaKfwCA5Tgw&oe=6AC906FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlQW11cOdZ0Q7kNvwEpN0L0&_nc_oc=Adp2wzy_nstwmudiXQOQZov5XZRJioNPR1M0fYzsbWG_AFNbAFe1JsxNtfGKemuvETE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6xaox06skaMtjwYND7eJHU_VGQsRdfORcJn1KKafphA&oe=6AC8FCBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC_IxuO-jCgQ7kNvwGPoHxo&_nc_oc=Adqkx9wlBhgwrUm8XgtPVXm7j0cIScAdRYPoc97biv3U7uzZN2Fs2rLWOrDVLuX_aX4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd7gedtJs425WC-9bEbLXv_3GUcgTPhA5sYLm4eME0gg&oe=6AC8F35E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvYctpqTYAAQ7kNvwEi6INT&_nc_oc=AdpAvf-N4QBmc25qqVeK2p6ngtH-bOVxqwisVYiNWmXPfcifZklQ3yOzVp3i2pW9JSc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpzd-PnJ1EYaFYDfkI2NhxtUe5c5DPrsZP2NNWlOY8Dw&oe=6AC90A57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
_oc=AdpD6OgwiiCr32wdn0pO8TWjHtmPxFPl7XMQqHjt9e9j_55Q3gLH7YGSbWkOoBSXUg4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AQRhSE_9X5G3NwNfer5r-t3HShkp4_Oa2yXJtMd6fsA&oe=6A3D564F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOcTAJI98x0Q7kNvwGKKPNK&_nc_oc=AdpmpoxVZod3sxxmtf6b85AtI8cXYnZozhV0YIUiI0r3IatCqSWniCDeITP12wDBXQI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S2kh5q72S_GHYNjkybYhmCNsFxBKZxT1IMcLERrtbIA&oe=6A3D47FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeqRnmNQqEEQ7kNvwHCb9UV&_nc_oc=AdrqeSu2jKZKU69zMXXVrvzSZH2JNMUabm9k4O73aIeqT38MoiCPUW6Q_uB7NwqTB2I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gucvQ845LIkXhAge2NdK_Lf03zM9qODvCdWFwlfyFRQ&oe=6A3D3DBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt3HVSWFbY0Q7kNvwHAbtO5&_nc_oc=Adr7SBwwr3LCXRFN38-P0ro3AypvOC9IOVUuIqZTxZYhoqw54AmJZZSbAz3sGY75TQo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KIUXyi4sW1LV6O2qV5PgSr3dBsmDQc4wDTgitpzGwZA&oe=6A3D345E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqoTViGImRgQ7kNvwFZDBsU&_nc_oc=Adop7fHbhp8jBjaTJcx5Y_FTbxziyaQdkSApMZ1J0J5lGGsfb-dCmv4betvYijvn87Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-QhZjy0dRU-0J0HBhTg98OOV17mY1A5r6hTP32J9hzw&oe=6A3D4B57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
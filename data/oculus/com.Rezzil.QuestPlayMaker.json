_oc=AdpmodwkwrKki3SJ51Wy8-9UBY_MsDzCSUQWfR-GnNkZLzSwMFciC94l5D04r0-EyBI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jnevGHvkeuBVIkKpuEijEcZ9PUkrsC0C-3U_9fJoK4Q&oe=6A26ECCF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yC5tfbHRqUwQ7kNvwHnXFWy&_nc_oc=AdrgH5Y7IruVPy6hDEHQDSmEJoAJ06ryk9cm4XaRR2OjU71ALPYta0FgIYPBROrMvHA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ey2ta4rcSDF1LMHOjSPAjbvhJZiuHHEM8a6PBWJ_eZw&oe=6A26DE7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWWs_42yJwcQ7kNvwHUw75h&_nc_oc=AdpXhvBFQVJRVUC4wKO4wRV3PU73O5m4iZKyF_ZVfmmkGkkbrGO_xaOdb2eHZ-YoiDU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qVqi7J6eqoqSfUPmAXV2YsEblP7KGIVTp-Rw4Y7A1kg&oe=6A26D43B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwY9i3HvuE8Q7kNvwFN1rXP&_nc_oc=AdrWkK7pUptJOZb1QPb08hHT66haVRHs3UBM0hCr__Yz7CT5cZ6EAakKJB73SPcX-7U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lL2rc0SVRsFqaDtR1blm0LH1XWqDObxEf1b-NVO3MqA&oe=6A26CADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfO1kIkv2Z8Q7kNvwHFuLtk&_nc_oc=Adp7Ars_NW0LTApf9O23M5g47QAXD9hvRbpHAaOAeqkL8DUn7HnmQjs9ip4BO2wDGFY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1NU9EV3kEci5Zx296xxd8ce76aNaeh6MP1CfLbupLpQ&oe=6A26E1D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
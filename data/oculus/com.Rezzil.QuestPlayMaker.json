_oc=Adr4p8PTLrR9GMYQj_CorV0mMpaQnrNDkY8JYy3xiPKbjekS_R25F_kLQA-QWIP2HAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18SldMndKMEN6-FHOHQ5Gy-3nygXvusBjREREQBYv_6g&oe=69D6490F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSmwaXBml40Q7kNvwENYDmN&_nc_oc=AdqkNAxD2ub5mrwXoKfKZoFpNbU7tt1U8yV6AvVZo-JU0pYZm7ZP8tkjZnhHIEycWMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rSX5OkQ9R9Z9Qlr399olMqH-L3_MwMN13Hmr8jz3zJw&oe=69D63ABB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clDiv7QGPZEQ7kNvwGEJLaj&_nc_oc=AdqJbvvytHpgepYz10DooyOA6stcPYeliqfANp9myo1mnA-YcT_LGgLuezJ_JOPd9uk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w_QmWM26J1ARAOQzVwKuwGg_ozN54b1_I-507vAQSaQ&oe=69D668BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U8sUDfvcfQQ7kNvwGAjWiR&_nc_oc=AdqJH1ETbU30d4spEzql6eHLAja-BFKEFLDrm1EAPlnUVcA9yYoIcqQoLGXXZ5DKo4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y0DBbQb4d7SX5sPBRCxg48q4FQMUO_nXpluFL4fRumA&oe=69D65F5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXBx19LCwsMQ7kNvwGAlVg1&_nc_oc=Adqg-hPuzhfFEYmxYycVkyXBPc9nwcu9Dd5rtkptSeY1FGQELT5flyRKtxX9qv9owYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GV2ghizQmAXyhh7On377uhipx-0myOq8Rc3GgylzOhw&oe=69D63E17"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
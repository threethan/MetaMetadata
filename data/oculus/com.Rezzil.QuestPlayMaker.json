_oc=Adr8m_bT-lE9vrIcTJayukQMYpl_hRz6qJLGUzM86Cg150pohRvmEbHT0kCTgh8zDxw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjr4vVMMYbe-kFEq2LAMiQaIhLPn3R_7vPHDNDcKi-_Q&oe=6A9AF0CF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZugYv_dEC3oQ7kNvwHoCH2U&_nc_oc=AdpMf_J94RXjIi6AAEEOSjqCOrGuGzYA7CA80mmEn4frZDhzlY2NILNFtu6E26Atho4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw38-AjEIBrtRSlZ_VDXm-tkcA02DjfUIxqQjZg6tB8Q&oe=6A9AE27B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBMT3LlJSzwQ7kNvwG6VzMR&_nc_oc=AdqFp_mpYExa-ry-FOwJErE_cSCYKNn7jwMmKnAHBGA5rGOwoXc5DaXVI1brjQESvQw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBn_7DOIJoccj5wPJDSeUs2ahiXVNlAH8_ZZbyCozEpA&oe=6A9AD83B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTY_I3_bJ5EQ7kNvwF5FpM6&_nc_oc=Adr0EnVqR6gXSzkTwCMXy5Qf81G7GEuECTdGy5kN2XEfmqViacuBm4BUNzpNty_nz9E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj0aORk4Rs433AkEBotgKpe8yO2P4xoHwzm0G43LknFw&oe=6A9ACEDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g8M0ZUTRVcQ7kNvwFp7B_w&_nc_oc=AdoquZJ4bEQ5NBMNEoIofG5HaEckqbRfW3NZ_DaawYr4rKZL7nCVdQGfgeNbl3KKAiA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzUJuH05pVY2rdjKYwOgnFYLg9157scrt8n3YnYGUgXg&oe=6A9AE5D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
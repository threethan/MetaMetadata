enshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT3M3yGBtPkQ7kNvwHKr0nb&_nc_oc=Adkwiq_5RSY79_vovjvo0pPGiseTLTutnW7sBYT37Q96-OnTXDk08piztJ8w4qw6Vso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxG0JwviTEx20AHVCuwZ1_A8n5cf2lB7CIfmfuqYHh4kQ&oe=69BFDF8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m4bRaoyadsQ7kNvwEM6Ujz&_nc_oc=AdnNce9j-Erb2mNpsvTQ7a0L5-DTOZLbvYUf0PvUogXaRtgJRtt0L2Mvct2O54L6d80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxx92gdX8kYRWIyNDs_akDOKLeoNOA0DJqEB05Bc56Xog&oe=69BFD13B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=698yC3wC_kUQ7kNvwEFzGkH&_nc_oc=AdnS-X2Z4jOhVFPjgmuX1LbHq6Q3pNjN1eO8B-zJJ3TJ08-Y0MV_02PgAPumnQwOIYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4E2QR5AcAzjSv41gGaS8f4LRfUQjNQ1CmwF9vcnnyWw&oe=69BFFF3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTyGGdBncwcQ7kNvwFET4Dr&_nc_oc=AdlkPFDwpV7WQWrU-1l_yVKeTEF0j2oJw_EcHmeLSDp4oJDCgGNdD38nkcmAFNjjvvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZRe1Gfg3whUF4OD0hHUZJARMVJda7OmQkjK3Ab4DPkw&oe=69BFF5DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyjAExtuxGIQ7kNvwEnctWA&_nc_oc=Admgs11C7eZTjkb02cCWtqcFr_sUOCsay219B5tSXbY7hzPPU8LYwRlJuA1FZAsgTmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy9tLppxIiVPdKjVSQOovsE7CCukYUt1tTvSdd62cwqOg&oe=69BFD497"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com
=69FF23B8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nis78YxX1W4Q7kNvwFAovJv&_nc_oc=AdqAmXPNP74fsmkN3byWpJGu7Lva3NxV_7vc5HwyfMN4ebc4B2Q02bFOXQimyKwpOiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bb4pLTiKieofm5Xs87-MWDiIeslRChhd36qlhwcv61Q&oe=69FF278F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TUJcK14PwcQ7kNvwHi-I-0&_nc_oc=AdoQkP3i3aJOGUTnOGjiv9m9LCLDKCb5clVELrk5fiW-qj_51OCJA1ZNMJLxh-mHgxQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-4-ovC4yM9H01uY92Twu2fYreqd6ckhlX_UbpABuQmA&oe=69FF517B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt8RcctGKRUQ7kNvwER7sCX&_nc_oc=Adq3ZSQmD3zYjht2DEYDFTRS0csMZqZ5e3Gaz9R-lSmUnxnpa8Z2_qXfu9Iy_uQDh9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RQSiIL_qZLpnfUutp8Z0yY4Y0lwXqVtA6mmqCJ7x5Xg&oe=69FF473B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=504Hb-u-UkIQ7kNvwGLV95X&_nc_oc=AdqCAv6J4K6pVeWcUKBSrDw5f8GNF301NxDu15Qk0jO00d3XEHg4aucXx0-pe5ZTjvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ahvKJhdo5Q56zLy9AdpeI6UFJq13WE9kgn42iR2IZxw&oe=69FF3DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjraxaTmWngQ7kNvwFIdBeK&_nc_oc=AdpNmpWVVWCxBTgorcZ_47XGTAYpT-cMpSUgt6pdnbugG2f3P5ThUS22WMxViXpjr-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jbKqC7YvH1uxPW4ZEEzWzZYjmugxnKblySAwh-dfzcA&oe=69FF54D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
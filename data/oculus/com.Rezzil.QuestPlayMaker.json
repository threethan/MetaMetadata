=6A302378"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRPsuS3AJ-cQ7kNvwFTcbSJ&_nc_oc=Adojonkkkf1eLAvKtUQUM_m4z_8djLgl73Q9XNWs23OEBEiZSXaHGqtU2oxhHc5M3qI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y-O1LI7ZwSPfsMER2-hJLrOLosTPBIWl2C0XuMUcRcQ&oe=6A30274F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWlCrLLtpNYQ7kNvwHSE_05&_nc_oc=AdruGUoCY_eyscnpCyb8KKbDlm60NmUwUIgQyg4fNnEEuMkipZut5yeTAK31t55rpqE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ONaWvCTOGrPu1x4DSzEcIRET0I5elcT0hUl0aOovR4A&oe=6A3018FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VdVd_wZuBQQ7kNvwEs_T2P&_nc_oc=AdpbqqhuyzpnbC1P12mHkmT07VmWRg-WsXqG82sBvP9HhFTWD4LgnAo8QYt_G37ecqk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MTXnhPgi6GYFGO1VpWavcIDOrwnhDoKyUP15PeXJDuA&oe=6A300EBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AE0WfdVo6EQ7kNvwHdCzp1&_nc_oc=AdqRa9PkmHI7-CwvcSN78utKDIfOb36zq2_uPBn7il9X2JPRb8uEVDjo0ZADKpkgdXI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91tTTcPgM-QKZz3oMtSiWmADP4PZEzoRDVDNIjr0EOpw&oe=6A30055E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAz701CFVUoQ7kNvwEAgANn&_nc_oc=AdpfXPYzpmLIz-0x_9KUPP0IakvmJjlEWzEmbNuvqdQQBowBJWh6Kxe4GXIEJWvijIA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZYDzd_VgF8KreuffwIn33sgy0XYpS4nk6WgeANHOZ3Q&oe=6A301C57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
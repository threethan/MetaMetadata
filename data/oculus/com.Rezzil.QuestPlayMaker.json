enshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT3M3yGBtPkQ7kNvwF8q-jy&_nc_oc=Adnwn74pVXwdPfnLfu3FYwQW09E_5F0cDdxSCrShi4scaPp2KeFKqlRV2hZLmH5d6FQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWOIRjTrJ1FJVBy9J2qK7G4CEMeksvz4q2CyUtxOKTXQ&oe=69BE8E0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m4bRaoyadsQ7kNvwFGIJsU&_nc_oc=AdnQTzEndu1IIBznQYO_30loJAq0mXYIyA8h-ibUFr4_LAS8kh7coTElNp7FGbF8vvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzy4o_jtWoyBLKHdBpz3fd07xPcc5iaCQ-pM86CBcHRpA&oe=69BE7FBB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=698yC3wC_kUQ7kNvwGnrI8f&_nc_oc=Adkww6Tvlcr22k--QMAzjgwr5qF18RVIdweMafOOJyUlB1tAdBKRBrFnqJ9Y1L0EQ1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-Ca-z54OIm4wWmmyfBr2zrSs25XR8kBNoogg8XQFarg&oe=69BE757B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTyGGdBncwcQ7kNvwH022Y7&_nc_oc=AdnE9nxftU0-MsI91j_jTFHMS7zd2YmupMg6rvSEDUD1jxh7fLgUaNnB5ZIatSQB3vI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwy1iQ8Pes76KUDo3fCEH9CEpT7PCRPsV-l0MwdFITv6A&oe=69BEA45E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyjAExtuxGIQ7kNvwHHUeNy&_nc_oc=AdmoebEe1frHnp-v1dy7NBSfXLGm3muFlBenOB_Sv5ENiprAwk9iuDuSGC6n_9fe9Ok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0tjnmxcNiM3UAwDS7J8rW94f9F4CgLLe6e11HexpASw&oe=69BE8317"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com
=6A86EE38"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skp1hHNU9JAQ7kNvwF63bu_&_nc_oc=AdraOKiuIbNqnIERGi7Ingy-9CXJ7E-nQDc-d_yA8prADJX6pZ0cEaBIcVBVGlsW2a0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyD8NIbm5Dr0qeS9IiHGLOTdwj6ER2mWQc-J9P_UyCMA&oe=6A86F20F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WakFmjh95tAQ7kNvwFV0pl1&_nc_oc=AdqJ2c33O8vsOlLtNj0XFG2z51FDEd1MqzoiSuk9lZ_MPtwe_xrqgUtCsmqQo6f955g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy6aPhZjVGdd4lMz0BhQwxs33lYD2La0xXY_xfT6nRkw&oe=6A86E3BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFfehSsrxFgQ7kNvwEqjTFO&_nc_oc=AdrMe27brzaVhw9CTgfnj9xSjhqnqefruZeR6yJDhfe5di_mp4GPqoVlWjmLvsNz9eg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjug7q3vFc0qUK_VWXXHog8A2PCjvl5Q4gClvZJnswTA&oe=6A86D97B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOUlXguQws4Q7kNvwFVtueT&_nc_oc=Adob4-3kimUk_tdhuuUoyQTgWRxwQKI4X90sL3868ZjK2XUhhbS3FwFQIgaZ-W8dZjE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3cCXYfzbrtMdVeApAg_9irD6Oj1gzqNgDCHgHapGTOg&oe=6A86D01E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiGaQ6S2P_oQ7kNvwEjuAex&_nc_oc=AdoprOjLXfRird1oYtTPQTBj8Ethq49eMA2i_ABlQ79LIYa7dchV-SzbOB1h2DwZza0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZL23WA4_hWT3ibm31aGulWWsGgR10oDorxpf7Nt_f4g&oe=6A86E717"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
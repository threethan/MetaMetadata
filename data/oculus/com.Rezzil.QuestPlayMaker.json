=6A19B9F8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss4OIRFzD_sQ7kNvwHAhQLf&_nc_oc=AdqdFk5xM7MCvV4jJjgFyHxi9kSA-VnV-K1qsBvRtUW54elJvTFlx_SpUHuj59ETXFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uYUja2GeO9Q0GORaBfmZ7eN1jxTXywTIg5k0Vz9iEDA&oe=6A19858F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpvpeGf3eNUQ7kNvwEoCAmi&_nc_oc=AdrGLO0qivUbHMun7Pgwsrl-zIUR_z3llC--6pCQCA-MCnHE-TTKRNwTxvgYY2jv9WE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N0-nDPxRCZTZgUGnewrAgZfDVi5KSfT_OzDNxSD0ePA&oe=6A19AF7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgpXEangN2oQ7kNvwFJwc0H&_nc_oc=AdplYx8GBbW7L5VyMAFJLKfV0MXDxe6WwDxE3dK6n_HcQ9Q-g4UVW8zH_4Snjg1UZXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QttX6LSoRL3cipOjM5lcGwMHPzCklAtkptXDW1iEVXA&oe=6A19A53B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsRh_fbn_yYQ7kNvwGoq__G&_nc_oc=Adr4REFVvrRtUxX_ROgvdSrU1mrC2SGY1_e75OYIDeJOyYi_s8FUIOco4nypuQBDXrI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bkfIk33P-yy2-BhyUatrFIJHALIak3khuSPhasWqS4Q&oe=6A199BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbTOzAVCJPQQ7kNvwHf3yjV&_nc_oc=AdoCldrR2FoQvLiE9BxTcE70qLp4dlmpwcoYm9XtyxpfkZ_Nl2SdFNUb6IfDRVqrLR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jPeT4yZnLlI6ytlUsMw_u8MEnOcYyx-0Nx5vTAImGBw&oe=6A19B2D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
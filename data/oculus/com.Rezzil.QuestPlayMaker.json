=69E8BA38"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkmCAID2TMkQ7kNvwGkru7o&_nc_oc=AdoHkwRtpSn_niYCZo6mwgyJGK_FvUxXCRvjKOOux7yXjMDTjpBrRc1aCbcg3DEhzro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lkgCq0PUAYWTgNqE9zVa4UyYFoUJJHgAahDLWEhKH9A&oe=69E8BE0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn56rIMPF6EQ7kNvwFq5U4R&_nc_oc=Adp37Rp5l2G3Tto4inLcs0_Q2xiR_lW4DZi236TuQKewPukIha4aKX_d7R_Y6f33ucE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aOc3pkCZUr1hWqfnadRMAlrXSiXyYvUGLtu1A3rhCnw&oe=69E8AFBB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9DZtWFFdr4Q7kNvwHayftK&_nc_oc=AdqKzIcnk2Xl03FVucy47AnvQwCcrDQn_3pBqJeNemeXvuwNF9Gm90pj0urTZiRa8Kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27MqAqhQWO6CCBIvp5R5Opl15TpNftm0HO7rfO34S0wQ&oe=69E8DDBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSQCRrUWtEUQ7kNvwHqW1Kn&_nc_oc=Ado0a-yB0VidRG1m-rv7Bpo5uMSI9bpYVbeG91aE2uKIN4LOjmI21RJ6RSaVdlmnAg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YdutH19A3u1N2HSyWJoArKo4rzJqKRiLjDhgYfsaFsg&oe=69E8D45E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIbqYA5d4x8Q7kNvwGERZP-&_nc_oc=AdqLL_tx1qP8PNqo7DoLNI7x6ZHuvkvi6uf5z_DQRswidgKX5dy3xvAXb88crxWNCMU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P0gXKn-YywUscsXBcH9qZPaM558XmGyZik5slpq-8Zg&oe=69E8B317"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
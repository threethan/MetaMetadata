enshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXNLwdHNX2MQ7kNvwH3YH_N&_nc_oc=AdmljplLWTOV6Hxoez5MJMTqUOBbdVn1n6x3r4OHiGVv85hBnpq0PSYghEKkyvEIj2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwz4494ne4DtkwYpX34-oKH5gxKLqCW_qkoPqF4Rxb3yQ&oe=69B15F0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41yTXRYrY3cQ7kNvwEl8joL&_nc_oc=Adl1a4960oZxnU2oZlsFMcBqN_kMOMlxLHHYQxLib2vek1kn6F7vPVdEycDJN0z8Kis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYVfKjUOdOq7-jeFfkdn7FBEbkuAbwABZz-pT72irxjg&oe=69B150BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvR-5GIh010Q7kNvwGIB5P8&_nc_oc=Adl5qRWtHt-hWB6bnZoRngTZVRRLzTWJGOVp9xOSDC5d-AxNW5anVquQIVSAWwkzuK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwnr97Z22kel7KoteQvhymLU51WlAcUhm-k7pT4MVgnAQ&oe=69B1467B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9mWAo06jsAQ7kNvwFGE0I_&_nc_oc=AdlvxPSFA6C3o2UnXqKmX5J35E5iTDm60gttGuJivMSQyz1OS2dPWvdEbPjvfYNe954&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJtIUBQ6JMccte6TgIc4YbrOsZATFvA8K8Lu9PsRn2-Q&oe=69B1755E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csk-xTcObYsQ7kNvwFb-T5-&_nc_oc=AdkNbg8pegRtUsgUyJ4OhZFKwPk4P6MCq6V1zcd0ArA0leryZVgn7u6HhMuuWyF_B6Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4IuvWrbw9_flSJcJ2UdHzBVOCbeIZqtxl9aWQ3yWdrA&oe=69B15417"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com
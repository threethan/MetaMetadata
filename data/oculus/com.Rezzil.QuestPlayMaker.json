_oc=AdoIu7EJep-WS8_oVyOOhjwies_py_nHYHJ6Sp-iZee4yu_VT0stTsgb-QbKpsoCh0M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEFfd2fgk0p_rq5Y7jYQj67P2--OiKsc9TE7vG4PTaXA&oe=6AA1500F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDNQErcl_n4Q7kNvwGUKZVD&_nc_oc=Adq5e3-7F2BvobY4H9uySaV-sxQB29jvpYvXlxzML0ZigTkqx-ZE0OGnpEBmsGJUPGY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ47Ygqk3V20G0p4OpxkKnjtDMBy02zQyoST5ADqUUXHQ&oe=6AA179FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otUO5GQjMGgQ7kNvwF5eaIe&_nc_oc=AdrkuiB80wZXFJT0MZByE3uLJgwh0PIcl2M70NVV15IvRgVNnLHPclgo6n8X-WOSw7E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeF6x9n1dUcJmF-Qnd5T9KKfcSvsJp41Vf65tfGE7uJQ&oe=6AA16FBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9JTVdnwFuQQ7kNvwG91lsu&_nc_oc=AdoimudUW0LGSFdbjT4-tIDsPSQ3pl4r-1hdXjEtjJutxQ-9tZZqqWd-KWybImr9VCo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7SJh2PghL46cW_yB4ClZ2_c4SYS21TbsZX1cGXvbDvw&oe=6AA1665E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xDuod6BkEMQ7kNvwHds0dl&_nc_oc=AdqL_-bUpTwf4XRXVoL6akfBHJgZpo-Atjgk-r0Ist0EfLjSmVe1KMv6hrLMdi9jAiA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlWxuzSNbRQG1G5mHfF44U6Nw7SG1zY14a8ZR_NiLpYg&oe=6AA17D57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
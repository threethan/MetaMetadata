_oc=Adpv_RcaU_jKx8A5Zudlzqzf7TzlmreDF_Q1iXK3GNrOhrHkHyaxzcb9mBiFvMLiPJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlAsfibNxbWT_fBPr8x8uL0TnqktNF2o0qQb8I9ihjiQ&oe=6AB7B98F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhFIFgHQA94Q7kNvwHlRIox&_nc_oc=AdoTU5g57xKGfoPfe4vB1DEVNAYjsQxVTqEbYwOzY-ONfq1XfCxuyZzBf44HnF3XFiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLP4Gyk7wwyJrAbJ579Z8ubjrIC_VBSo98yswYP7r7Fw&oe=6AB7E37B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtZAFAiWz6oQ7kNvwH9DMB-&_nc_oc=AdqhN5FKbE5SqRJqCrx6wYRYfDy4HkvvknPGuuMkvyF1fzg_2-vkQFAymxUif67ovPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtaSldtNTQKRAgYSMGM9E8PvME2yUYEmju6RgIDkvmkA&oe=6AB7D93B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Pc1qadk0CEQ7kNvwFH5YLB&_nc_oc=AdrOGG_--f3KLCFcNmFnnS6Gi2zpDHWyY2qOqyw-mZaH9pkia1u9ea-NwrQDu0l2I5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjFCacMMBTVBM4iGddeO0IVDoePQK75cT6JvBDBTRdPQ&oe=6AB7CFDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1v5_xdINT0Q7kNvwHGn-fF&_nc_oc=Ado2VLoetAYYPf8alA-y9-KD7-OGFTCp2we-NnPfmdMvb8-a0pwvfMe3A62VZ4nzokI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfoKgtYxl8YX4cILtQhzb9POQqzjOkT46BxqbaxKJmHw&oe=6AB7E6D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
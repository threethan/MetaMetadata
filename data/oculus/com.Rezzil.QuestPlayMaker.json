_oc=AdpZi_1toFedbsI4Jx2AkTKA8j3Q7-CMPgnkPRGWlCSIN6wnrDq7GCld9nyEdEKqACw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjc2bcUxhtOvLqurQwkhYCI3R1Reubtb0BfuchJhCjuw&oe=6A577C0F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNB87V7eIpwQ7kNvwGTnCvn&_nc_oc=Adpfco126efGJZftbXLTgIPbBJY6PLnGEeFHaepLn4FcBczCtmsEU1IMATFF_NRrbvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5sOBNlGaiGuJQjxaOXQuy8LhWjXJqwoFNtXfA4yjfHg&oe=6A576DBB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LA4q5W2pSe0Q7kNvwEMmYS9&_nc_oc=Adqz9tIX-PnvR0mTffcEnshJeeMOh4aWadLu15T22cq_AOvsagXC_LJz0B0Y1AN3gw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQtDUopC-2U8bo2LoG4CXhJrMQmm9Mt1BsK_RZyMYr5Q&oe=6A579BBB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciSeN_uEKHEQ7kNvwFbbOPK&_nc_oc=AdoYKzsN7P-tSR1yt10tsj2_M4TiROnJhkq0CyxxWyMDTLord7rnRMyUjfcxSX1N7aI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-GD3EokOrteMdhKlhLFvN4jhPtFNjj0cYigzSNsedNg&oe=6A57925E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOzRt52E9-kQ7kNvwHnN__6&_nc_oc=AdqXuG5J9hEQcmBMPAQUSy1_oC3J-DSAbnxpHUOS1vPGMAQDsOYzqOx_uZ0Jf02zOfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7bMhoigj6EP5-k7UkDxKOJVqe1B1Z8NdsearkpSSYlA&oe=6A577117"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
=6A82F9B8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5Hz93iRMe4Q7kNvwEbKzud&_nc_oc=AdqPW9bq71M5DzyEDchd5k0lH5C4ncU-zoI3FNrgxld-pTGv5KXL1WImf6jsryKrqik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWLJ5KgBSYi30eASjCH5NyG7ON6am8GQA6gwV1YHc83A&oe=6A82FD8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HJ6Vjq7S6kQ7kNvwHSe9mQ&_nc_oc=AdpzCXBySgVsX_V4KRaa6l2Lp3hPhmT5Kz0IJXRRZMyfyBOOkZcEF9POra2FqTWIOy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0DRrcsb6e64OpxZ8p5GvaJUtKBz2VqcQrRkNsKN4-Vg&oe=6A82EF3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpnRnoWZXNcQ7kNvwHhaz4O&_nc_oc=AdqALieFDQgSzbojGNruKC3EHtfGOZj4p-TuUP94oL_WE0GS-hxKIPw_vqOlVz9E88g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiUXJs46CyAglw2sMo7503anzsEm_aPcPx1mcuizUVXw&oe=6A82E4FB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16SVz20J1L0Q7kNvwFM4BSY&_nc_oc=AdqEFrLZOody6J-7VUJPXpcIYSrc8MV_8XOchO5sKMDL0BwGmyq5HE0f1UyKmf0BwFM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHJxgqupiZwACPiBTSJ3cfF3378ROuBBEAGrHd60Ol9A&oe=6A8313DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ij0c5aU5-NsQ7kNvwHn-gQt&_nc_oc=Adom8dG2tWXTZXPlWjeAVdCXlO6LsFyBEGfFXSMMsyxc6Ia8huDDsjmRbXkR0Q0LchY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmn-as4I1xGr_Sk0Z3FeHP4D8PA_ABgp2U2IT6et8QWQ&oe=6A82F297"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
=69EA0BB8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkmCAID2TMkQ7kNvwGRQAPp&_nc_oc=Ado1bMaGNiqA6mf-19CatmRGhBX4ggMpexdPFcpC7zSNbcFU0x9jteHmeY9M55c7tNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0elkb-zYVgvwirP8leGFbkS6jljFXhIadWPtc7opke4Q&oe=69EA0F8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn56rIMPF6EQ7kNvwE9-C9I&_nc_oc=AdqZMLKIGH9wqegUt-D1DX-Mz5mSIMzECbz7DlIycGmYT48LeN6vcgKBQKwmzh_Fg20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s3RKy0kcAhDcnBlR1ckozzi0FAVZyBtIo-vyBIFuGpw&oe=69EA397B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKAuEfvXcYUQ7kNvwHbnW1o&_nc_oc=Adqq9k1tj9ubJlhayYohdcFp9dDgtgo82qtZ0KzTl--KgLWv0VOUsMHR7WRZ3LnlLjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kpBSuaGSVXr7yYJe5rn9QZLu-SKWwVfITBQvFdOMhsQ&oe=69EA2F3B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSQCRrUWtEUQ7kNvwHU_hRo&_nc_oc=Adr5wHgTsUlGh5kw6LCTHMyAVhX5PCK1e9N5JgrUBg-Bj_yvwCvKvzFHG1CCz8JQrWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-yukM1GRCh2HqSdw0y6hRs5t6j0i0QPpBrZAIGDPJaQ&oe=69EA25DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIbqYA5d4x8Q7kNvwHILl2h&_nc_oc=AdoqGDF6IR02dd1yEyIdgoEEyof2wQ310w87U-Tg_pPcCZgb7O-tYV8Bu7VXoPMxbAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DxtKsLt04uYUVMQU8vuwUzRGX68ejuWDz3ek1-yP5Eg&oe=69EA0497"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
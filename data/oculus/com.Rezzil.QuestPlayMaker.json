=6AF88778"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls0mpF7VdCgQ7kNvwHWrp6E&_nc_oc=AdqjQYNtkhmamKlJy-dZCbZu3c9No1X2k_0STVDlpUS7qtH-4BnpDySrBgEEuev-akc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpQ9RqyAAu7fs5OCGosPQUrafkb7mbac2Le8au4t9ldQ&oe=6AF88B4F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBhw7iaazzwQ7kNvwH83lF7&_nc_oc=Adp4qck4nGKD2sVGGUyQI9p_2OpWGiFUo1t_Hbg2TQAdQkCyeJiVCjimvYKak69s5Y8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS62WBJlzmO5mUSMzGG1ouVFM-1NgLKBE6z2QMmAj2OSg&oe=6AF87CFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEZ4YaygFVIQ7kNvwFE9BSv&_nc_oc=AdoNpXrgxg2uz-xnoyw64ApqQszjymTGzq8TY_4YPlL2WQl280ral05t-lo3AvJP64g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzICA03bZjI6KhNIDNkAUG8Fzd0-s_2xrVvpAJ9sQsCQ&oe=6AF8AAFB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63wzVm0CIjYQ7kNvwEWCxw5&_nc_oc=AdrLeR2qpkcBlgMg82qM4WSP4bc8yiIU7H70drYRATWm0xsMKuYsY7KnGsMGi2Y4o40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7w77SPRITAvFTeN3vgczo-h0e36KRI3_FcXQscWknow&oe=6AF8A19E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoGx2pw04eQQ7kNvwEvbERO&_nc_oc=AdoQJGtpJjkYTB0ugvQVgFsKNHLiWGElzaCBdnivNGFExFoitRJrsII_cqUTX3idDm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-D8yMegtNU-eQJAkMIEMsiYJLsyjqRraxjIyel8DfcQ&oe=6AF88057"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
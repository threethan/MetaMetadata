_oc=AdqFI7kUQIXLQFdlztO1tpqCcIj9MYTx_BsEoIxrVRJl9Dp9bg6RxGdGocu4MLDAd2E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wz9R3C7WvZ_Fmy_UGd-Y83Hr7lBJewEOn-GdADdgnFg&oe=69EF558F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnmDhXFReX4Q7kNvwEP9fJI&_nc_oc=AdrZhXZZtukxSJrtRF1JrCqGIOC5WGgeBI0GcZCWMxFjhL2xxZVOIq7UxwaKy7p_Hpg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Lyt-J1o-Zbr14vMSedErnf5rHo4nq5ccVq7fRXxEemw&oe=69EF7F7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVGHR6YMiWIQ7kNvwE0TwiK&_nc_oc=AdoVBXGUE7tTq6JE5WX2gv45iAEZMOQylDGxiaYQZ6L9Oe2Wxhacenvzc2F8UtBrTA0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14s3EhR_-wkjJEjkWMwYz35XWB0GnrrNsKEAkUICVDDQ&oe=69EF753B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oAR9Rs6PrQQ7kNvwE70-kg&_nc_oc=Adq4AXbH3G7GmA9wr87cwRrwDdKB_EKoWWBxk2sTeVptYpaUp2-aA-lgzalA4ynRBy4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SAbdfplMh4iAduhgil1tK4XsgTS05AwShLjsAdBGSCQ&oe=69EF6BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaT7yCjBK58Q7kNvwFSfirG&_nc_oc=Adq_YD1QI-WCsGfHdwA2NL0v1F_uxCie67hR2UwwvacC7A4aY8CPZrY4L1s1FnX9mvI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BPp3mgfwe9x67vilbHHUnIWfttMR0s2kyBPT1s9ef4Q&oe=69EF4A97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
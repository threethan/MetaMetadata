=69EE0038"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcNC4Rcw-RwQ7kNvwFkKdY9&_nc_oc=AdoHTDQWVDD-sfc8QiNL1odNMMcjc3ltvaPcyg_tRwMSigJ9CuugNsQ5EmcyRroBnKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_ukCAiM3qZ9rf-jSIH_d969JdgiS6cjtMod8fEfM8Pw&oe=69EE040F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnmDhXFReX4Q7kNvwGfz8in&_nc_oc=Adp_6u12X7j_DBPIU7cKLDTUVNSWtb1fsu4otvPkgsdE-hJ9_INQqdp3ZaI9ai3XTH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZFHmcViyffgKLikHyTSkzv47juqIoWElkxcva5_JjKg&oe=69EDF5BB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVGHR6YMiWIQ7kNvwHCaLv8&_nc_oc=Adpb_7DlGWOLslz08gkQrOzRh4awgDrgiutMXOI4JqU44FMvnAvbt-X1w81nh2xhps8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O8OPSwtYvQ58BCIAb71mGm24f9ZqNGjZfJVqLLqPN3Q&oe=69EE23BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fViowIsAf4Q7kNvwEPV6Wn&_nc_oc=AdqK8bKDBQsWA8JJvIsdWB_0UNzaG0EhKIPAcyDYu_dKkFhNJ3EcfvbKkTTGypCAkcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ppcHi7qv-rVjpbpROfAo3xhFeb6661TqIsoh1367TaA&oe=69EE1A5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaT7yCjBK58Q7kNvwHqEoGZ&_nc_oc=AdoLGML-zxE59Au-dZ44oyCcpec4bgnaqkgwUvpEjPT0wVnSQ0PgFzAv4FJSb2sSqFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Haqoe8SbWSl64jjKn-ilywBbWMqD-PziKRKvxmISqQg&oe=69EDF917"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
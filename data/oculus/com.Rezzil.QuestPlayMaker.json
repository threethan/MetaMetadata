_oc=AdrDonImTWInrDNW0x-c3Oduq1tz8qt7JH4tqH-YVFvHvW6vzHa-w6sitWH01j7c02I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFbXHAzuiz9695rBSe-gHZK3GRHLA9iGpOV3dI2JkDdQ&oe=6AB2738F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C78HRtQthYoQ7kNvwFSu-rO&_nc_oc=Adpq6TSTDezaJI4joyE8eYV_EXw2iplMozKx4Bxyt-CZIB5S_r2SpLt0CO2WgKCd8oM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw3uTWPdIKEwfNiwdecfnNTlS4TIYKjmMHW5K_p3X0-g&oe=6AB29D7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5Mf7sRP1GAQ7kNvwFO0x5f&_nc_oc=AdrxO26GsSpdK_be8RGNDXO9AVAd0GVxDz1LD1zCPZi4rI2-eZdTQTFFua-TQJMjn3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk4w7OsK19N6UHJr2-_lQ0FtZwI_VSqPbY8yvX3D9cEQ&oe=6AB2933B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj_PtXlw3UQQ7kNvwHpM-9h&_nc_oc=Adps5RujLvb_HCUp0COhMCjFVWetVYdcqi17flQd_BGc9E1pxV7rsrx2YU7dWmSbYS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR5ZLGUTjahyKPOq6RHyzLeFQInDhBH3fPr-0oBUbFbw&oe=6AB289DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAwYeHQg1OIQ7kNvwEOQrbt&_nc_oc=Adqa3OSEDvJz0QJctVaklEvcx9xokRTotJwx70In4AH64ki6vrQUgAdMvbn_LvQoS90&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0w4G6OSXRqIUPx_3wIUcWEfYbLZBBURYBqzNiTXWpYA&oe=6AB2A0D7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
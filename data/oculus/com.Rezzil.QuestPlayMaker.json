=6A3AAF78"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr5y4IK3xkcQ7kNvwFeVrXQ&_nc_oc=Adok8o2oIDzvIZ3SDxTifsp9xICK_OqIJFSK7uGG07eP7jRKr7Kcidm1gYjvcJJu6Fc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y3oVytWflh78GD8EkPF6NgbK-gyr2yLxcKlTLEY1EVA&oe=6A3AB34F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D1DNQdjpZQQ7kNvwEngLsc&_nc_oc=AdrxQnaRxeuAlS1-9NN9Z-QDYegloeZIO9NsCUuya_7VYjzmzr-CJu5hfbn4lm71ehY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9spSBwoxE-D1iXFg8rWxwnASpShHv1EhZqLexGkkwOmg&oe=6A3AA4FB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKLuGuA2F_4Q7kNvwFNUJQK&_nc_oc=Adr5A7bdkQezNWPRB45XQTFdB27kJc1HRp24buPBGEBQuWCkDL3WNS2MfFjpaNvYq-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RXhMfjzp32QZQQ1jaSDhsntytznO7Bk9BKlUBPTNh7A&oe=6A3A9ABB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt3HVSWFbY0Q7kNvwHaxWWD&_nc_oc=Adp7WVgnSRJQv7JF4Llv3cA2Nj4CFs3A4byKxnb1QRiX0rLsiy7hK_YNukwr8w3O_lY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XWmaM82ynfu53DbaRW7q7ZQuf-6xvhs3OiR0X6L2dMA&oe=6A3A915E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE_dDc8NWeQQ7kNvwHAklHp&_nc_oc=AdrGAcYT1yPAMMEu3tV6XRAAMYqWxfIGbxdiMLqcu-49FA_tbymT9_Ry5cs9ujI7LaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4rqR7W-oB7tVujvofE6i-1_e-PXlD9qjCfrMeB8C1Bg&oe=6A3AA857"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
=69D4F3B8"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PmMAhYqB5UQ7kNvwEDQYNQ&_nc_oc=Adp57oe67ImbfAuTjb1GZVyG8OuhKyH7JbD6f06D8FrXKGgBYtNV0EnYV3b74TA8JXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d1WUsfHvdGmRyANGXJQRS0JHxc5rifuwmlH9oc1p9SA&oe=69D4F78F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSmwaXBml40Q7kNvwGGchm3&_nc_oc=AdqgCHUi3jmPqKLypHuYwPTpsdOzOkpfYOzxio638WlgtRglYVHglB9y_xFL-RYeitk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RANl0J8sJJMNHmU4a2SbetKdAcTWEgEETMEWGS6JRjQ&oe=69D4E93B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBF7Do7tIwoQ7kNvwGmPgB_&_nc_oc=Adoad-JjUMavUOADqTS6VfQuEzsCiAgyvjzAl9k6UE9KqOvHCrmf068ZzfKQR5w-9TY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05m45ZpaC9Fw-saSh1Q_HYk0eaZQfFU7-RNZrFZCmbpw&oe=69D5173B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U8sUDfvcfQQ7kNvwFOcdUV&_nc_oc=AdpIQOcMDLNL1gh1XJJzeuHbIHL3ZKAt-jLQpxeMP3ZLYC2nFbHBXaMrwGv1F35IHYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Arx4VCwaVtNSMdlITEpYQorzfiyKusNe9fsnb7cGalw&oe=69D50DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXBx19LCwsMQ7kNvwFgHbTA&_nc_oc=Adpb74G_BD3gYMr7IbI1uHba0RWpCr1WEj4dd_OKykr97NpdfpdVYVqOyonBjaaj2Es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p23-bkt7s1DNH6HuiCyiVzSt3hKM222yUmCGC0edU0Q&oe=69D4EC97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
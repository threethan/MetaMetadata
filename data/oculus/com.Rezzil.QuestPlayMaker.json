hot2.png", "id": "1095471491907793", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyyAUhOPv-gQ7kNvwEfYrxw&_nc_oc=AdpYK1Djqsk0vUHMotv89NoRseSpusCM8oS825UjSWmgzQra0v9KLurxoEgZF0dutxw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XPoTwPXj0EQHbmqO3McloAQqws80SrRHz6hqShspCmQ&oe=69F1EA3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVtF8h1oKfEQ7kNvwEKuOin&_nc_oc=AdrnL27Y__rWz1JtjNyrWKbyaij2Pl9dtLkyHt9au5zj-5aq8GcpmmpbvN1bfLXk_hg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0M7EHQW9nCnF7-cTSeuvy_B5sJs24E_OHoJXiTNn7c6Q&oe=69F2183B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oAR9Rs6PrQQ7kNvwEglupM&_nc_oc=Adp8UJ7mwe8ikAEozHcSHFnr39kJwaK2Dj6fjKSCadGEyYnAg0txcXHKhTkNZY5hWRQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15JsKrIdcKYVOGMegSfbkN2xC4tFGZN1EWIOLak4lufQ&oe=69F20EDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X27kqCgl2FAQ7kNvwGIL5Al&_nc_oc=Ado2nuCfzp6_CYQtgR9onxWjp6jB9UKOkR6ELBHZbaKGB4u07jTPDBBqFhPUp_cPU2Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0RKmd-2buUVup35h5c5JQFggls6qA9fLQzlxBI-7Wa0w&oe=69F1ED97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
enshot1.png", "id": "191426200727649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjj5Yjuehb8Q7kNvwEjGI_f&_nc_oc=AdlIUSLrwfSzegYAMnNTf8nZ_leRvMIj0c80jPp0JjaH_1p7zkCbzdiNyNxLXIlY0gc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtSPVhjUAeRtyrXbse_Ks68oIIvtVEsCiAM0CMMKaCVQ&oe=69AD6A8F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL71pe9F0SUQ7kNvwHZAKHP&_nc_oc=AdlUz41Uhhizq6_DSFqHp0V9xAWI0t0vGPsR5yzfO0pwkIS9ibXmWJZ7o9cRYLvYwO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1xoEYWiFPe-9At99AxLktyxbMCsyjg_4PhxzCs84lpA&oe=69AD5C3B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlT6UQZa0k8Q7kNvwEY8Jub&_nc_oc=Adn6mk7u4yXmlXtSO_N6tabDbTbP5ZL7TR9eAi8D-O4FW1Mz6KRDM0_KYZzCVJN6bo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQvLVSWGilbkR3vB1f61b3InbAdaPNnzspHXCHLwKyLQ&oe=69AD51FB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEKye90ZpAIQ7kNvwGwu0b7&_nc_oc=AdnoEwQNiM0ZknpdUfRdV3DSWdggXckLueI3UnYQmWqn4tM119vGd43A2RpdUhDkVLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4OMjTeegXZZALBjqfcezC_s1fveAW9CALg5_Kc00k7g&oe=69AD80DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOB0oCpUEioQ7kNvwEjdXeK&_nc_oc=AdkKACPmk6W6tzwRCYeO-ptt-AzoiRvYzGv446BhSeVlQDW3y9VZQGfbPQQso7CfgfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzp3pANGsHYnUISPPuQ5KKqv-5aZspRTQQ4Cl7O0fBACw&oe=69AD5F97"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com
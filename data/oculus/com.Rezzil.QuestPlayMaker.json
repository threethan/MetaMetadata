=6A089678"}, {"file_name": "screenshot1.png", "id": "191426200727649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974606_191426204060982_7564565095945023473_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bUCSElWJAMQ7kNvwHqkAyh&_nc_oc=AdqX12HSabQMF9mkuiqIRecaB2h_r0kXWS2ZMU3L5wwv2tdQQu7Ty-JZdMaSxJUWHsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MboDEfYyJpZkSZx5kUNX9MGhVllaBh6pO3maK35BVxg&oe=6A08620F"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms-RxWfro98Q7kNvwF4eKPt&_nc_oc=AdrI_dclcr1i7GaH80dYbTPZ0-HJg6OLww7jLphk0VAw7VTwuES0OEBXAOQ0X9nACfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zmz7NlMzzkzM4iCNuyoG-0wHDtBeOqXPQXzmHmE8fOQ&oe=6A088BFB"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8c98Ic_GkMQ7kNvwH3QfPT&_nc_oc=AdqH2joMf15Tv109VvtymGy939CvcZwTzCWbWuPRyxDi8L2wUXDQ90eUe0crJHMGKsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uyuIqaJ75QtLRq6Xvq2xd2c2gn1eJPl76307KdrPI2w&oe=6A0881BB"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ilkPVBfCY8Q7kNvwGLggzY&_nc_oc=AdqEd3OBbb5r3zom7CBgUhWhQ8PCodrESN4OTjMao6BH0d0gdP_hR5C-GWPxvFkLuKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DLrVrTuahikNyEl_sD4ngh1d77yTz74fGMR_ziFWTew&oe=6A08785E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihVrGcvWfDoQ7kNvwGMb_DN&_nc_oc=AdrCIoRGB5Bhe4oW6W9Rzc7GEjSMO0L9DJlsyIxtFGkqXbDZykypS3Py86VO53jfnEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71N2Po1hYIUNJ7dX9kQVgCCOvQ7uuuwUzjAtGKtSc4Ww&oe=6A088F57"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_w
_oc=Adpqlb6ey5Z1Bjvkhtuhz8dz19GqRHmZnZn_uyVm_43bQXb7t1TAwaJX0MMDYgwyFmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6hGw2IsxOnEn4o4aOTD8r7CfdbcHx7cuB4ExOcdRtNQ&oe=6ABFDACF"}, {"file_name": "screenshot2.png", "id": "1095471491907793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_1095471495241126_7904825382140520563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayi5jpHJoIkQ7kNvwHESXQC&_nc_oc=Ado9Csm1h56o-vZLWXZi9GP8A9YPmprucKFe7quC0l-lhNnujWj6vyUSyMDt8JnAw3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZwIJXnx1njuj3dqlQE136sj99ENSwl18ZWUpbI5o6Pg&oe=6ABFCC7B"}, {"file_name": "screenshot3.png", "id": "1049137639698936", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982554_1049137646365602_1414254081213079555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP9Fo1Sm73cQ7kNvwGjrSU-&_nc_oc=AdoZB0kgjBy6OLkobbt0QLnSagq3xAe_BVIF8om44ewbgQfO8AUC3CJO2srhctTARTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZTSQx_1_yLqo0fvg9XUAZUw4qaz7LM7uARRnWuTUitw&oe=6ABFC23B"}, {"file_name": "screenshot5.png", "id": "1535088327286928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984462_1535088330620261_2696574789503898695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=His8tKeNcJUQ7kNvwHq98pJ&_nc_oc=Adpd3vIoBVD6VyQ8UCxie7GZPsVIxJ7UnLpLrxtWqcHE0dkD42p2V_ACyIWk6Ytc7_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJpHF8MqL39JCdoO3xog1G_N0e5qwiHWMj4kebJQVFlg&oe=6ABFB8DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7050636325025275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_7050636331691941_4735315412487883710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkQbNzsXphAQ7kNvwEelNtG&_nc_oc=Adpktj5lAcYZ_9Xffh6xCG7dqm7Mwy4hW5twgbp3mMdO4dqiwsA4DjdccKjWrvK42HI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR97z1Wfsvcviq8wRitc6PRHArXiEAM6AmNk1pGU-SNA&oe=6ABFCFD7"}, "display_name": "PlayMaker", "keywords": [], "long_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment.\n\nKey Features:\n\nInteractive Strategy Creation: Design and manipulate soccer plays in 3D, offering in-depth tactical understanding.\n\nMixed Reality Meetups: Connect with friends or teammates in a virtual setting, ideal for discussing strategies or socializing.\n\nYouTube Integration: Analyze weekend matches in-app, facilitating group discussions and breakdowns of key game moments.\n\nMeta Avatar Customization: Personalize your meta avatar with team jerseys and accessories, enhancing engagement.\n\nReal-Time Collaboration: Work together in real-time, share ideas, and adjust tactics with teammates or coaches, irrespective of physical location.\n\nEnhanced Communication Tools: Utilize integrated voice chat and gesture recognition for natural, effortless team discussions.\n\nPlayMaker is more than just a tactical tool; it's a bridge between virtual and physical sports training, perfect for soccer teams and enthusiasts eager to leverage technology for an edge in their game.", "short_description": "PlayMaker is an innovative VR sports app dedicated to soccer, transforming how teams strategize and collaborate. As a multiplayer platform, it allows users to create, visualize, and share tactical plays in a dynamic mixed-reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rezzil.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rezzil", "support_website_url": null, "website_url": "http://rezzil.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "ext
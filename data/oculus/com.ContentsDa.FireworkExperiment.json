gVWZ9hWQ&oe=699DA208"}, {"file_name": "ApplicationFrameHost_G0KFU8sDNF.png", "id": "948953303917496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_948953307250829_968421093373764706_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJqOZAInFsEQ7kNvwEVqKnr&_nc_oc=AdmQbACC9Gwj4U7NWmnCBW9KWTCyHDELOiRLOG4CepyFN2f97uL7Ymm1hj0PVnDz6tE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsy9SkPMlSORIDwUjV0vB7s6hMzBsy2TO7UMWrsGzwNHA&oe=699D8D49"}, {"file_name": "ApplicationFrameHost_9nSexyADp8.png", "id": "1254992109169671", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75549077_1254992112503004_5828632407424175005_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejaT6q8-lC0Q7kNvwEpBLs0&_nc_oc=AdmIPrFSeS9m5b0QBs2b3W_SO0IFbL7b_iBr-I_Pljoi88A_9i0V6fQ5J22Ni9ajCEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsvxh9De1bZdwMbRSoUDr7abuwV90mmNwlZDOdAxGU4Bg&oe=699D908E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Flame reaction of an element_Landscape.png", "id": "3444291265864251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974485_3444291269197584_7011456396736561393_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnxhLrn-MDUQ7kNvwHjZlIs&_nc_oc=AdmfWFEgHLFF1OH6w3HWAb0qF0nRiofK4QAsukUevOZqsZ1fLYoyqZV93ROGk0QmgDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUQ6ooWH_EZ_0QTMnnCKtxgY32oXQYf82rUdsZH1Q8Hw&oe=699D857D"}, "display_name": "Flame Reaction of an Element(Firework) - ContentsDa Chemical Experiment", "keywords": ["experiment", "chemistry", "flame", "science", "contentsda"], "long_description": "1. place the elemental powders of barium (Ba), calcium (Ca), copper (Cu), potassium (K), lithium (Li), sodium (Na), and strontium (Sr) on the table\n2. place 7 ceramic bowls for the elements on the table\n3. place the alcohol swabs on the porcelain bowls\n4. place the elemental powders of barium (Ba), calcium (Ca), copper (Cu), potassium (K), lithium (Li), sodium (Na), and strontium (Sr) in the ceramic bowls\n5. light the igniter to ignite the elements and observe the color of the flame for each element\n6. place the strontium (Sr) on the firecracker launcher and ignite it\n7. Observe the color of the firecrackers\n\n<Results\nLearn the different flame colors of the elements.", "short_description": "Dive into the colorful world of flame tests. This experiment involves burning different elements to observe the color of their flames, teaching about the electromagnetic spectrum and electron energy levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9221931617858072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031377_796333262319234_624666617177018659_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLLgmFN95qgQ7kNvwGJLWKO&_nc_oc=AdkCwpCFJ23_RCyutG6JZvmnzNpyW_lbvi8U_GFYtPdJzFzIyy5Zg-2GtYd1Dpwa3ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsv7-1mL-wYvS2dEwb56R71wslgkl5rWeL41vBVBrVASA&oe=699DA66A"}, "is_concept": false, "is_test": 
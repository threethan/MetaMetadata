170495278688_8585340289524710617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4Pgbu2g2IcQ7kNvwFp3hsL&_nc_oc=Adk1H6hB9eKkOHAcMHIiYPmCM-IQPtC5PcjSzHWc9QXM-apZzxaTcBz_ua9HbWq2zhQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsIAPYE9dCIAiyK46NC4DL2y05HKQlJukTpeLFQLZdbgw&oe=699DA6E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "736878895139957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_736878898473290_4129667305785651696_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjN54sla86wQ7kNvwGNhDmx&_nc_oc=Adk7bRERSMCXkXbUUsP8rtGqc9Z0hZOM3GzBhsKZdawn3ZrwL6zFzWpns18R7lzMK3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJT0f5seWLWN0bFmfST0s-YQ2PrlmMgMaLNajysZHMTQ&oe=699D94CA"}, "display_name": "Firework - ContentsDa Chemical Experiment", "keywords": [], "long_description": "\"Dive into the realm of realistic chemistry experiments through Virtual Reality (VR). Experience the excitement of conducting actual chemical reactions in a risk-free digital laboratory. Mix substances, observe genuine chemical changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 chemistry experiment.  This application supports two languages, Korean and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-
516_1680663499536547_748393867856117289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiH-8wfgJD4Q7kNvwGkAW7M&_nc_oc=AdqUDc5O9tDpbGbReM5Sd9DfpWbZY-IHPPCNApTBa6IyDg-0TJJdfcXif3QMKhtONxE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-CKXDTP8UPvTtnG5QOMN18WjcyffzawRLtYmzYyowxA&oe=6A50F14F"}, {"file_name": "screenshot1.png", "id": "639654868744662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391906_639654872077995_7099948604760232702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCZpgC3eLSQQ7kNvwGarEPK&_nc_oc=AdqeeKBshVl3M2cfWph588--0UTEBe8aiaPz_OMq_s0DZT0_GTnt_4e9gdcoUjWOYnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdEn2emzxfAdX0SsCicbUZPAwyK1j39ZZ7v2LUdkC01w&oe=6A5106C8"}, {"file_name": "screenshot5.png", "id": "1153580576773244", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_1153580580106577_8618381996379398927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw3caRJEdJIQ7kNvwExGGdH&_nc_oc=AdrZnWjyxNf7tXM4-o9Rvr5wfjMQ2BB5AXT8kUF6-ZhoV1xByzYTLji0fIjjjEMkr8Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7goxL0CHpJRq3ht0qhrkx4eVFrD8KFpR5iB558VKL7A&oe=6A51172F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1384826422652355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392301_1384826425985688_8801629390390687592_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLiH0Hc4-CcQ7kNvwHpsdkh&_nc_oc=AdqBjrcRA17Z2VVLTl9WHoQcBngqfCwiFU3EBlOF8usGcRFxh_QsaMUmTCyyArzrMvY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_eVD_MPkRxKW2cl-YRSPglJp4mXmhqIhXFjbkoaJ_Kg&oe=6A50F6B8"}, "display_name": "Maze Tag", "keywords": ["maze", "tag", "horror", "hide", "seek"], "long_description": "You are a wild gorilla. After escaping from the cage, you find yourself in a giant maze where nightmarish clowns roam...!\n\n# \ud83e\udd21 The horror of \"It\"\nMadness is hidden behind the colorful smile. The clown \"It\" lurks in the maze and chases you relentlessly to find and capture you! If you let your guard down, you will become their prey...!\n\n\n# \ud83d\udd79\ufe0f Intuitive VR action\nJump with your strength! With the immersive feeling that only VR can provide, become a gorilla and run through the maze!\n\n\n# \ud83d\udd11 Collect the keys and escape!\nCollect the keys scattered around the maze and open the escape gate! The location of the keys changes randomly. Slip away from the clown's evil hands and find a way out with wisdom and courage!\n\nWhen you clear the stage, even more clowns will greet you! An even more chaotic nightmare awaits you!\n\nSo, can you also take on the nightmare maze and escape alive?\n\n", "short_description": "In this game, navigate intricate mazes and engage in thrilling tag. Enjoy the adventure!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9063005887082232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391955_1021257689814688_3881890280698
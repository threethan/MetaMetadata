_sid=6e7a0a&_nc_ohc=fdgQzcpSl4oQ7kNvwHJrLnO&_nc_oc=AdkAt8TIAk5ZgViLHWVUh2uKiFQDVczAs926LAj7qeyCTELrcATwQsQWOBCMXw3115Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsFxa6O7gvH_ypiIw7aoIJyLJC7Pn-b1w0o32u40bFEtQ&oe=69A56B88"}, {"file_name": "screenshot5.png", "id": "1153580576773244", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_1153580580106577_8618381996379398927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSE0XTyL7_AQ7kNvwFl3WL7&_nc_oc=AdmICYQHvBr2SWkXPXyQTTErcX6Uk5LY9qNTFm3rlwDozugXtnEqiUl5rx369yfFyg8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsftQMY8uFszZBvryZiR0gU5ciQq3rPW3_rsnoEn-S0KA&oe=69A57BEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1384826422652355", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392301_1384826425985688_8801629390390687592_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Anu8s-sZKpMQ7kNvwGWYkfH&_nc_oc=AdklzdlNXXxc10ELLgedEwg0XTmjle2NBsKVviBC1_oR94RdNro3r_nzoYPGkk_vj3A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu4224w_aAe51nLtdP6C5vBWey8nfIMZafgF2RcJIcBYA&oe=69A593B8"}, "display_name": "Maze Tag", "keywords": ["maze", "tag", "horror", "hide", "seek"], "long_description": "You are a wild gorilla. After escaping from the cage, you find yourself in a giant maze where nightmarish clowns roam...!\n\n# \ud83e\udd21 The horror of \"It\"\nMadness is hidden behind the colorful smile. The clown \"It\" lurks in the maze and chases you relentlessly to find and capture you! If you let your guard down, you will become their prey...!\n\n\n# \ud83d\udd79\ufe0f Intuitive VR action\nJump with your strength! With the immersive feeling that only VR can provide, become a gorilla and run through the maze!\n\n\n# \ud83d\udd11 Collect the keys and escape!\nCollect the keys scattered around the maze and open the escape gate! The location of the keys changes randomly. Slip away from the clown's evil hands and find a way out with wisdom and courage!\n\nWhen you clear the stage, even more clowns will greet you! An even more chaotic nightmare awaits you!\n\nSo, can you also take on the nightmare maze and escape alive?\n\n", "short_description": "In this game, navigate intricate mazes and engage in thrilling tag. Enjoy the adventure!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9063005887082232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391955_1021257689814688_3881890280698829020_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU9FNrHDOh0Q7kNvwFomCD9&_nc_oc=AdmmnNtzjap8uJZ9pTPYmVm4cuOR6wiuTy33_utGYplp-mApDo7LEwd0Pf7MASKJBIE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afufhu8C9aQ9j6rXv0Oif1o2jLEfS4Qy-_r3XoKCiv9k9Q&oe=69A583FD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Maze Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459
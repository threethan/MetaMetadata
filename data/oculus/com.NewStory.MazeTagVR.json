-25/473391906_639654872077995_7099948604760232702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDcJ3XQWI6YQ7kNvwGOqumU&_nc_oc=AdpegVAf8nb5Wjxy87h-nBd6pmm4QeKX1q8r6kQ3i1BpwGI_CXna4yoz4pJX3kdGYgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt1900O8MIBoW6WqSNab4tj9DUZdOexCJy3rC4UiJZFw&oe=6A4D1248"}, {"file_name": "screenshot5.png", "id": "1153580576773244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_1153580580106577_8618381996379398927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erUWBCFzgM0Q7kNvwH1DOrc&_nc_oc=Adp7DY3Rjh7y5glcLfXlCkfwuAqT_tfteccBY5khDalmRftPQOpupoLofYeWRKz4TBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRt_ndtmXduXIWxw1E2ZzjQBWAE47IfBC7T1ukaRRcsw&oe=6A4CEA6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1384826422652355", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392301_1384826425985688_8801629390390687592_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD4xWcm_KbAQ7kNvwHE6OQQ&_nc_oc=AdqbH1xs6uJBYCfFVOu_Sx_klx6gh6qmQti1r5msP75PH4zSJ0YdmEylvdZeSBXh3jc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4yccnvgviBapq5I-oQxgq8nPohKikn3eYHCtCq2G6-g&oe=6A4D0238"}, "display_name": "Maze Tag", "keywords": ["maze", "tag", "horror", "hide", "seek"], "long_description": "You are a wild gorilla. After escaping from the cage, you find yourself in a giant maze where nightmarish clowns roam...!\n\n# \ud83e\udd21 The horror of \"It\"\nMadness is hidden behind the colorful smile. The clown \"It\" lurks in the maze and chases you relentlessly to find and capture you! If you let your guard down, you will become their prey...!\n\n\n# \ud83d\udd79\ufe0f Intuitive VR action\nJump with your strength! With the immersive feeling that only VR can provide, become a gorilla and run through the maze!\n\n\n# \ud83d\udd11 Collect the keys and escape!\nCollect the keys scattered around the maze and open the escape gate! The location of the keys changes randomly. Slip away from the clown's evil hands and find a way out with wisdom and courage!\n\nWhen you clear the stage, even more clowns will greet you! An even more chaotic nightmare awaits you!\n\nSo, can you also take on the nightmare maze and escape alive?\n\n", "short_description": "In this game, navigate intricate mazes and engage in thrilling tag. Enjoy the adventure!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9063005887082232"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1390608969140528"}, {"status": "PUBLISHED", "id": "703597999227438"}, {"status": "PUBLISHED", "id": "1175454361030124"}, {"status": "PUBLISHED", "id": "1657091255192203"}]}, "baseline_offer": {"id": "1657091255192203"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1390608969140528"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9045416248841196", "versi
_sid=6e7a0a&_nc_ohc=U-5xSgdpWSIQ7kNvwGGysG3&_nc_oc=AdnPWK6H2wNhY7HIuyiMUaGiKOZ1ljHX6UNRToVT-LYehyUSaULETfkG2Uqi0NeHu18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsg3Ugr_coNwzo6nwqCMK0pMPxbguTyRMmJJoMqoHugJQ&oe=69A2C888"}, {"file_name": "screenshot5.png", "id": "1153580576773244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_1153580580106577_8618381996379398927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSE0XTyL7_AQ7kNvwG8pW9U&_nc_oc=AdkBHiN3pW_8wnGSp1RFGES5mCLJtp7dlY2yfr__GKoYBn5JBgHCrRNmwMTZ0HAspMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvG4EwW3P7tcZMB94H7ne6_fwtS2lv8iYHZYk9KNm1z6g&oe=69A2D8EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1384826422652355", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392301_1384826425985688_8801629390390687592_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2glAUA5yvJ8Q7kNvwHOn6a9&_nc_oc=Adk4VYzT5S865rN4PzNNHujbwUz9ARg6lPGDO0oIPTjI3YTHa2-zrWyoP_MBYgRcQzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5lKV5eJQpbFSjOGKdVDw1h6ai65onm_sUDhpGIFV7zQ&oe=69A2F0B8"}, "display_name": "Maze Tag", "keywords": ["maze", "tag", "horror", "hide", "seek"], "long_description": "You are a wild gorilla. After escaping from the cage, you find yourself in a giant maze where nightmarish clowns roam...!\n\n# \ud83e\udd21 The horror of \"It\"\nMadness is hidden behind the colorful smile. The clown \"It\" lurks in the maze and chases you relentlessly to find and capture you! If you let your guard down, you will become their prey...!\n\n\n# \ud83d\udd79\ufe0f Intuitive VR action\nJump with your strength! With the immersive feeling that only VR can provide, become a gorilla and run through the maze!\n\n\n# \ud83d\udd11 Collect the keys and escape!\nCollect the keys scattered around the maze and open the escape gate! The location of the keys changes randomly. Slip away from the clown's evil hands and find a way out with wisdom and courage!\n\nWhen you clear the stage, even more clowns will greet you! An even more chaotic nightmare awaits you!\n\nSo, can you also take on the nightmare maze and escape alive?\n\n", "short_description": "In this game, navigate intricate mazes and engage in thrilling tag. Enjoy the adventure!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9063005887082232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391955_1021257689814688_3881890280698829020_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9-enSEKa1gQ7kNvwGPTKa6&_nc_oc=Adkn5k8PfUxvJSOxHdZeLK7y8wUf30PIufuUm8GEM7TvK083-HKXBxJdxFFz-Sip_1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftCjW1tF9q5FOUQGTLbMEg3b-N3WlhD99No515DoO63pA&oe=69A2E0FD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Maze Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459
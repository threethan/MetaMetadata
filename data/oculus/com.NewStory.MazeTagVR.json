: "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391906_639654872077995_7099948604760232702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir2u8X7rheQQ7kNvwHl8D2K&_nc_oc=AdqtdLJ7YVEVVmCS70AxU9tFv6ZO56M5MiJ_WOqAKrqrvodkmimKJlKEvXVAt8M9l2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzd0YQxlwGjn_yUhf4BSt3U5dbxSnFKeVECFZfWxZkN2Q&oe=69C90408"}, {"file_name": "screenshot5.png", "id": "1153580576773244", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_1153580580106577_8618381996379398927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhuFQw8ibvQQ7kNvwHq5edN&_nc_oc=AdoE8lrzy9s63X0eU2erwKzauNHJLNaRoQ5l6nWWtVYBg_de1ljrMhOrKFry2Pj9BmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKNG0Hd-FQF01hXtyx1nhRMFdY-v9ul3oE8V9sv0-z6A&oe=69C9146F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1384826422652355", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392301_1384826425985688_8801629390390687592_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92dkZaXS8aEQ7kNvwE9EqgF&_nc_oc=AdrqWYHY0Kol9DcYqVf_vI0erC4GYfa3axmGd3hyq3fftEHnnPqQRPV_afyKYdSOe3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdYjULatz3Ripz1T3jUyreh-OPw_N6jjjQftOQQHbOyQ&oe=69C92C38"}, "display_name": "Maze Tag", "keywords": ["maze", "tag", "horror", "hide", "seek"], "long_description": "You are a wild gorilla. After escaping from the cage, you find yourself in a giant maze where nightmarish clowns roam...!\n\n# \ud83e\udd21 The horror of \"It\"\nMadness is hidden behind the colorful smile. The clown \"It\" lurks in the maze and chases you relentlessly to find and capture you! If you let your guard down, you will become their prey...!\n\n\n# \ud83d\udd79\ufe0f Intuitive VR action\nJump with your strength! With the immersive feeling that only VR can provide, become a gorilla and run through the maze!\n\n\n# \ud83d\udd11 Collect the keys and escape!\nCollect the keys scattered around the maze and open the escape gate! The location of the keys changes randomly. Slip away from the clown's evil hands and find a way out with wisdom and courage!\n\nWhen you clear the stage, even more clowns will greet you! An even more chaotic nightmare awaits you!\n\nSo, can you also take on the nightmare maze and escape alive?\n\n", "short_description": "In this game, navigate intricate mazes and engage in thrilling tag. Enjoy the adventure!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9063005887082232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391955_1021257689814688_3881890280698829020_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2v5AY1J3X0Q7kNvwF9Y6my&_nc_oc=AdrYkjRfOa8YexozwRgE1LJr1V-LZKKWMMPwrYa6UCivnbV89AjJfaegDNCZL5Uncf8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvL8XKT_GoNO8aayitE6M1zeI7Vb2yt78JXv3xwb-74g&oe=69C91C7D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
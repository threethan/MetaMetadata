asy"], "long_description": "You are on the island and participate in the battle of aborigine throwing fruit, and your task is to destroy the enemy. Target and send the fruit directly to the enemy. Defend yourself by destroying the opponent's fruit and go back into battle! We have many new features for your enjoyment this time around, two new multiplayer scenarios and another refresh of the user interface. Beautiful map for single and multiplayer modes. Multiplayer for up to 4 players! You should concentrate yours on fighting. For more information please visit www.vicovr.com", "short_description": "You participate in the battle of aboriginal throwing fruit."}]}, "developer_name": "3DiVi Company", "developer_privacy_policy_url": "https://drive.google.com/file/d/1gkdXFMy7jOM5EdYvz1S58lq6odmSMNZP/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "FIGHTING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt", "ru", "es"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "621016185868340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12410355_1836259010016200_4057160540277964800_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcAzLlFXk98Q7kNvwFdvR0P&_nc_oc=Adp2EPkgbBmY5ULzAPXeKIij0iNaKhO2e5YhOgA4nD6mOHlayT6FhUw_mNVJu4tpKi8&_nc_zt=3&_nc_ht=scon
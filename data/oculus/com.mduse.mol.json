=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH70-f145bN1JGHbSoqAxOSYPm-UuVf-6nYbSSGl4mV9Q&oe=6A8ED683"}, {"file_name": "sector3.png", "id": "870590772325637", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499620451_870590775658970_6646555899156481311_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa306zZNOXAQ7kNvwFIb4VJ&_nc_oc=Adopw1LsZPkoNZcSOHb0ob8a0BFGDPoWjRFpez0KWT724QosYrynUhzwCehZ42-Ahm0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4vwJUuO7E0UUh-maqkfio8bvA2DTsPYIzPBQ3T5NEtA&oe=6A8EE503"}, {"file_name": "sector1.png", "id": "1491518605617795", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499312310_1491518608951128_2988634153333598259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfTgnZ24AokQ7kNvwHgKsip&_nc_oc=Adof3yhOblDoskc2IZvWJoBSKZKoJXNcQ7g2VSs6RExcxZkyFX02yGPActTJNoltNcs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlQettYcAsXEEb7uBRcLX9YLYEJCXAG5Ugnbl5HSValA&oe=6A8EE4AD"}, {"file_name": "sector2.png", "id": "2251458048928626", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619163_2251458052261959_5292299677131368650_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiMGWI2MEw4Q7kNvwEzeA1j&_nc_oc=AdpE_CA4fIhIUDP1iRxZ4EDWRkPMbhkHSyCIC-Vn7TtG7zgWArU_F5WgCF5PO9Pi2tM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp1kdRY4sR0N1q09Po5FHdNy9IFUbWX6CfrLnrTbBUuQ&oe=6A8ED806"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuckingVR", "keywords": ["Molecular", "docking", "chemistry"], "long_description": "DuckingVR is the virtual reality module of the MMDR platform, designed as a hands-on molecular simulation laboratory for universities and research institutions.\n\nThe Meta Quest app ships with preloaded demonstration experiments, ready to use immediately after installation \u2014 no additional setup required. To access experiments generated on the MMDR platform, a small companion desktop application handles login and downloads the user's experiments to the local PC. Once running, it exposes the library to the headset over the local network, and a list of available experiments appears directly inside VR.\n\nThe experience presents the protein in cartoon representation and the ligand in sticks, each placed in 3D space at real molecular scale. The user physically grabs the ligand with the controller and navigates it toward the protein, exploring the binding cavity by hand. When the ligand reaches the computationally predicted binding site and locks into the correct pose, the molecular dynamics trajectory animation plays automatically, revealing the simulated behavior of the complex over time.\n\nThis bridges computational results with spatial intuition: instead of reading docking scores on a screen, the researcher lives the binding event in first person.\n\nCompatible with Meta Quest 2, 3, 3S, and Pro.\n", "short_description": "DuckingVR  is a VR application for university molecular simulation labs. It lets users physically grab a ligand and dock it onto a protein in 3D space; when the correct binding pose is reached, the molecular dynamics animation plays. User experiments from the MMDR platform are accessed via a companion PC server app. The Quest app ships with demo experiments included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mmdr.simbioslab.com/front/privacy-policy", "developer_terms_of_service_url": "https://mmdr.simbioslab.com/front/terms", "publisher_name": "MDUSE_invonations", "support_website_url": null, "website_url": "https://mmdr.simbioslab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
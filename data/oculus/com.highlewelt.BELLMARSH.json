229175357223_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9I-o5yGU-2QQ7kNvwEXOKkq&_nc_oc=AdoX38N0_3WkkEOVAGRiDKm45o88Mfh30sULIKvGX161IUAz2ujXg35ErfckN4MRjG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVlD7fIbtvW7ZW5GCDKLY-7gwPnxoiAMu2_4QWwgplxUg&oe=6B0F13C1"}, {"file_name": "4-2560.png", "id": "5769633293123190", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974456_5769633313123188_3019550844415727258_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdOmn1YSpOQQ7kNvwEiSJTz&_nc_oc=AdoaMv8a31cLXFlXOdSNoW64wbGZUH1SuvKRDvmtxoQJRCFtplZc1nrbvlUS3x9j4l4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXGRhi7G_kVoAdQMHQa6gOxC5YN5i5Lo3qipTBT4xpd6A&oe=6B0F1A41"}, {"file_name": "5-2560.png", "id": "5833988766684761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_5833988773351427_6394502236207774478_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCHnSol9Y0MQ7kNvwGon2xF&_nc_oc=AdpFxSoUKGmxpb_VP4AmCKeI7OuOT6Xd3bACd4vRgC3CNiCigcALfxDkagcpP2PztkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUmE40wgjPimpe62UnCwCMrK876e5C-RHKxqzrEyls6TA&oe=6B0F218C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belmarsh VR", "keywords": [], "long_description": "Since April 2019, journalist Julian Assange has been a political prisoner in a solitary cell in Belmarsh Maximum Security Prison in the Thamesmead district of the Royal Borough of Greenwich in the British capital London. We have recreated this cell visually and acoustically as close as possible, so that everyone can experience first-hand what isolation and psychological torment mean. \nWe hope that with this project we will reach more people who are campaigning for the release of Julian Assange. Just sharing this app with more Oculus users can make all the difference. HELP FREE JULIAN FROM THIS PRISON.", "short_description": "Since
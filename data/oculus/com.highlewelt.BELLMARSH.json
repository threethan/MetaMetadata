P5HyDR3zP79rQIqP1s9jqy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15IopasJUxu8MMOTZQpD-OCriS6hSjKdfoGlE4BSOmmA&oe=69D8D941"}, {"file_name": "5-2560.png", "id": "5833988766684761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974888_5833988773351427_6394502236207774478_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B89eOPKhhQIQ7kNvwFz7QZ1&_nc_oc=AdpxnRO5af1rMfSWSB8_DjRaIxRrMGXtCiztamQ5L7vcLty7uiF1iNkv40bxOCaNGXc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SI6FyC0NASsRYgevi3A_mDDvgBcAt-IBEHDwYPMclyw&oe=69D8E08C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belmarsh VR", "keywords": [], "long_description": "Since April 2019, journalist Julian Assange has been a political prisoner in a solitary cell in Belmarsh Maximum Security Prison in the Thamesmead district of the Royal Borough of Greenwich in the British capital London. We have recreated this cell visually and acoustically as close as possible, so that everyone can experience first-hand what isolation and psychological torment mean. \nWe hope that with this project we will reach more people who are campaigning for the release of Julian Assange. Just sharing this app with more Oculus users can make all the difference. HELP FREE JULIAN FROM THIS PRISON.", "short_description": "Since April 2019, journalist Julian Assange has been a political prisoner in a solitary cell in Belmarsh Maximum Security Prison in the Thamesmead district of the Royal Borough of Greenwich in the British capital London. We have recreated this cell visually and acoustically as close as possible, so that everyone can experience first-hand what isolation and psychological torment mean. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://highlewelt.com/privacy_belmarsh.html", "developer_terms_of_service_url": null, "publisher_name": "highlewelt GmbH", "support_website_url": null, "website_url": "http://highlewelt.com/", "category
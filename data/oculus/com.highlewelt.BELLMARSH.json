229175357223_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHSV8-5YcK0Q7kNvwEWo9z8&_nc_oc=AdpHwtptV1Im-Un5HYcvt-8uah70vCClWxLvynqlraQpywZzpYgQovO8q9gdRAg0Ecs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOhuKGOd-RqSp6N9C10ncqDreOPpc_eT_hFwP2zScf5g&oe=6AFB4D41"}, {"file_name": "4-2560.png", "id": "5769633293123190", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974456_5769633313123188_3019550844415727258_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkXJyVmLRqgQ7kNvwG1KLhb&_nc_oc=Ado3HgB2DyYpLbBxScoMfrMdlqVRdmjBy4l_BMAEY-QOEvJBO45IcHxe4n2D1B7N_gA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBYsFJ_b-tD4one-IwH6k0a3UIzaKSNO44lE-c4T0O3A&oe=6AFB1B81"}, {"file_name": "5-2560.png", "id": "5833988766684761", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974888_5833988773351427_6394502236207774478_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T8tPdQ3bAwQ7kNvwELY4T-&_nc_oc=AdpHrH8jg2JAR5ZxTrBCJSjRH4p76OFA1dVRScg7rkhOhenoTLz36NWGjDixB_Ak9Uk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-sM1nY7gT6dF7LTbGUR6vz0xyEj7cAIrqSBCD045RsA&oe=6AFB22CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belmarsh VR", "keywords": [], "long_description": "Since April 2019, journalist Julian Assange has been a political prisoner in a solitary cell in Belmarsh Maximum Security Prison in the Thamesmead district of the Royal Borough of Greenwich in the British capital London. We have recreated this cell visually and acoustically as close as possible, so that everyone can experience first-hand what isolation and psychological torment mean. \nWe hope that with this project we will reach more people who are campaigning for the release of Julian Assange. Just sharing this app with more Oculus users can make all the difference. HELP FREE JULIAN FROM THIS PRISON.", "short_description": "Since
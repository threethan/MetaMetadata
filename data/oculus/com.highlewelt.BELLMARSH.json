229175357223_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBy19dXA5gYQ7kNvwHDQyTV&_nc_oc=AdrpJmX97zQt8pYoVLFV93GKsscB4xihQfX0wNZMst0MOXDKpPCe6weUDbh03RRA9ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR66faj1ls9dFhBX3R5RbZDjUCN1M-6zvP9QaZNBg8KdA&oe=6B0487C1"}, {"file_name": "4-2560.png", "id": "5769633293123190", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974456_5769633313123188_3019550844415727258_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49zzFHthJPkQ7kNvwF0HuUt&_nc_oc=AdouicqW8WSb9u8ea4aWCZw-2OQWIWXWcpZHQpI8_7QwET0BpbRk7iVPyh5a7lKEDm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC-dmbLnJsDn2FFwgycPO8HjIhuVCM0ej4sFhdIa0oJg&oe=6B045601"}, {"file_name": "5-2560.png", "id": "5833988766684761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_5833988773351427_6394502236207774478_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2FOoX8KxAgQ7kNvwEkqk6C&_nc_oc=AdpggzRfW-SCHlTRtBdu6mwKgaH5ohLynNGTWgWUk6QjG3BByxMT64zO17sLPyNqqbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU2mU4kJ5tXFSix400QkxbvA15V3J9HzEFUsV3Js_Rdg&oe=6B045D4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belmarsh VR", "keywords": [], "long_description": "Since April 2019, journalist Julian Assange has been a political prisoner in a solitary cell in Belmarsh Maximum Security Prison in the Thamesmead district of the Royal Borough of Greenwich in the British capital London. We have recreated this cell visually and acoustically as close as possible, so that everyone can experience first-hand what isolation and psychological torment mean. \nWe hope that with this project we will reach more people who are campaigning for the release of Julian Assange. Just sharing this app with more Oculus users can make all the difference. HELP FREE JULIAN FROM THIS PRISON.", "short_description": "Since
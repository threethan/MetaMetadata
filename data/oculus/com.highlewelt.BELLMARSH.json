229175357223_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QR6dgASH5VUQ7kNvwFQDWba&_nc_oc=AdpkU5nnSjcB6evq7nVZahWz9cJUhWh_ObkcHWBKu5mg4a9xK3l8RRzHqTNzbD1CMcA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSkbnynWvc5942eCYdXeg2CoPsJxObkfSy2CCdb-yzoQ&oe=6B084401"}, {"file_name": "4-2560.png", "id": "5769633293123190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974456_5769633313123188_3019550844415727258_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpVRB7X91kIQ7kNvwEkW_k8&_nc_oc=AdrA-LfGc2bHoqoytHNWZ4zLoohxoiZwyfVJPr6PN5Mx58JrvPsyMWkf-kl70BSFnEQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdoGoDZjXvmSsUgtRf2CV10xPWQWLE-TOMrlnmi1xe3g&oe=6B084A81"}, {"file_name": "5-2560.png", "id": "5833988766684761", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974888_5833988773351427_6394502236207774478_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KC2u3SBYHcQ7kNvwGKW-_S&_nc_oc=AdqsCci6Vya4Lj2sMU5jmBfj15YdptLfF27ExvGGVkAD8gAZdcpN1QrLsqa6xai-1-8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqX7Zrt-nqIvhj91L7g1TuB-0UpmGgmHTR5zFCM8w0jg&oe=6B0851CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belmarsh VR", "keywords": [], "long_description": "Since April 2019, journalist Julian Assange has been a political prisoner in a solitary cell in Belmarsh Maximum Security Prison in the Thamesmead district of the Royal Borough of Greenwich in the British capital London. We have recreated this cell visually and acoustically as close as possible, so that everyone can experience first-hand what isolation and psychological torment mean. \nWe hope that with this project we will reach more people who are campaigning for the release of Julian Assange. Just sharing this app with more Oculus users can make all the difference. HELP FREE JULIAN FROM THIS PRISON.", "short_description": "Since
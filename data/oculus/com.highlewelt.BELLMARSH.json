tM4vyfBhW8KPrPUQ-Iyx7NIv4Tn5Ie3wjSz1Ic5ZZ2w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N9Kv2lBwfLTMt9BpJHk0aom4uesQp0TsHVCvR0CK92g&oe=6A22E581"}, {"file_name": "5-2560.png", "id": "5833988766684761", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974888_5833988773351427_6394502236207774478_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7rqLp1Db04Q7kNvwHlKql0&_nc_oc=AdrC2OuxmCIf5oT900WyqQMiACKKvZ84GX-rT1ceekbzZUSDiJ4XQgAeBrYw4_pZif8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SoTGsI82x4Vkeker17xjm9mbUm4Dq86fpcPIJgKBfoQ&oe=6A22ECCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belmarsh VR", "keywords": [], "long_description": "Since April 2019, journalist Julian Assange has been a political prisoner in a solitary cell in Belmarsh Maximum Security Prison in the Thamesmead district of the Royal Borough of Greenwich in the British capital London. We have recreated this cell visually and acoustically as close as possible, so that everyone can experience first-hand what isolation and psychological torment mean. \nWe hope that with this project we will reach more people who are campaigning for the release of Julian Assange. Just sharing this app with more Oculus users can make all the difference. HELP FREE JULIAN FROM THIS PRISON.", "short_description": "Since April 2019, journalist Julian Assange has been a political prisoner in a solitary cell in Belmarsh Maximum Security Prison in the Thamesmead district of the Royal Borough of Greenwich in the British capital London. We have recreated this cell visually and acoustically as close as possible, so that everyone can experience first-hand what isolation and psychological torment mean. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://highlewelt.com/privacy_belmarsh.html", "developer_terms_of_service_url": null, "publisher_name": "highlewelt GmbH", "support_website_url": null, "website_url": "http://highlewelt.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1659125401226711"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "177266694813066"}]}, "baseline_offer": {"id": "177266694813066"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1682530952, "status": "PUBLISHED", "id": "177266694813066"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5354510494652479", "version": "2.1"}, "id": "3320918458221846", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5049899865113545", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5354510494652479"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3320918458221846"}]}, "change_log": null, "created_date": 1682281673, "id": "5354510494652479", "version": "2.1", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary"
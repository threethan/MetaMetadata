229175357223_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHSV8-5YcK0Q7kNvwH6FLZF&_nc_oc=AdruHoQ0_0FDqukiUplOEt_m7Jy9YQfWHQNKCAjCHuf2FcNBXm51UfHF-NuI7T8huaI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKivQxYF3ZkBzQKhE8JHfQVnsTrkLxTYG5TEC5DoZbPQ&oe=6AFC6681"}, {"file_name": "4-2560.png", "id": "5769633293123190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974456_5769633313123188_3019550844415727258_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkXJyVmLRqgQ7kNvwGVYx4s&_nc_oc=AdqPAJEca9vQNWv-jpvma3ZKMkqbpB_hGgHtKQp72A-7G-UPpQyjfNUXvMVlcVMLTks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQal3MoeS11MX5zBnhIDBQL7JdGWnkokRknpBP7qZVk3g&oe=6AFC6D01"}, {"file_name": "5-2560.png", "id": "5833988766684761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974888_5833988773351427_6394502236207774478_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtjFG2kkoFEQ7kNvwHuEwTJ&_nc_oc=Adq8NVktYyWj4QbPnpNx-YEJmNEJXvTVJ1UBjs3llrzI3GeznX6A4crakXAGAjCOE_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDCmLlUtiFUoEk8SSInugYhBb8fVtP7Cp6Ha0Xssu1yg&oe=6AFC744C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belmarsh VR", "keywords": [], "long_description": "Since April 2019, journalist Julian Assange has been a political prisoner in a solitary cell in Belmarsh Maximum Security Prison in the Thamesmead district of the Royal Borough of Greenwich in the British capital London. We have recreated this cell visually and acoustically as close as possible, so that everyone can experience first-hand what isolation and psychological torment mean. \nWe hope that with this project we will reach more people who are campaigning for the release of Julian Assange. Just sharing this app with more Oculus users can make all the difference. HELP FREE JULIAN FROM THIS PRISON.", "short_description": "Since
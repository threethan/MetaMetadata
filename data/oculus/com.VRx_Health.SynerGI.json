nm4aqzS1t8fU1eA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5E09QVpr3uNkKXaM4QF8xMwotDJvvkAZMP7KBEQrJ3Q&oe=6A8D7EE9"}, {"file_name": "Zoom Out Green Earth.png", "id": "435099962531373", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75404389_435099965864706_7827745048409383350_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tW6LiuZjmIYQ7kNvwEd4vcm&_nc_oc=Ado7CrfTmYYPmR-pCyuWm62M28XD9mU3pJaJ4FTH-TqsHGt89rjmQTd3S2Io-__mpr0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyWOLthfF5mZuAWl0CHKXS9Qv7D8m66fkhtC0GAvEwvA&oe=6A8D80EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "synergi trailer cover.png", "id": "949587129940314", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982473_949587133273647_374740217864517409_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMDwdYYUBuwQ7kNvwEulnxg&_nc_oc=AdoWNFS4OzOF0BalFpAOvcnq82oWZh-H1hi1YX4qofQluZ0FANrYTgDIALzIVJI2VsA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_JH3dxXZ_IbEJAF5KAfw9lsc-MyAzYN02sygy5WvgXg&oe=6A8D7B2C"}, "display_name": "SynerGI", "keywords": [], "long_description": "Developed at Cedars-Sinai Medical Center, a leader in gastroenterology, SynerGI invites you to explore an immersive world tailored to enhance your understanding and management of digestive well-being. SynerGI is more than just a virtual experience; it's a gateway to a new perspective on gut health, offering engaging, interactive modules that make learning and self-care both accessible and enjoyable.\n\nBy combining expert insights with virtual exploration, SynerGI is uniquely designed to transform your approach to digestive wellness. Join us in this unique journey, and discover how virtual reality can open new horizons in your approach to digestive wellness.", "short_description": "Welcome to SynerGI, where groundbreaking virtual reality and artificial intelligence technologies meet the pursuit of gut health and wellness.\n\nNOTE: SynerGI is currently invite-only beta. If you do not have an invite, you can visit an affiliated physician. Please visit our website at https://synergi.health for more information."}]}, "developer_name": null, "developer_privacy_policy_url": "https://synergi.health/privacy_policy", "developer_terms_of_service_url": "https://synergi.health/tos", "publisher_name": "VRx Health", "support_website_url": "https://synergi.health/", "website_url": "https://vrx.health/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7497673183643830"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "824587039494820"}]}, "baseline_offer": {"id": "824587039494820"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715097989, "status": "PUBLISHED", "id": "824587039494820"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24280458474938704", "version": "1.60"}, "id": "236184285661457", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6172920406119121", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24280458474938704"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_nam
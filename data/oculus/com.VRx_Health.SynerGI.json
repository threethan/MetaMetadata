nvite-only beta. If you do not have an invite, you can visit an affiliated physician. Please visit our website at https://synergi.health for more information."}]}, "developer_name": null, "developer_privacy_policy_url": "https://synergi.health/privacy_policy", "developer_terms_of_service_url": "https://synergi.health/tos", "publisher_name": "VRx Health", "support_website_url": "https://synergi.health/", "website_url": "https://vrx.health/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7497673183643830"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24280458474938704", "version": "1.60"}, "id": "236184285661457", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6172920406119121", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24280458474938704"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "236184285661457"}]}, "change_log": null, "created_date": 1754690985, "id": "24280458474938704", "version": "1.60", "version_code": 92, "release_
.png", "id": "342629148317754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75439596_342629151651087_2032965022969246624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joyCY2HnQiYQ7kNvwGUPY3V&_nc_oc=Adqb1K9i0puLs6ZdiZOZloydE4axwLKvICDVj6-kKVw9s3UnSNQG7olZr_b5VNUKur4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIktVKM6O8xSejqKBnh00DhIcjBCQ29wEpOScajtub4Q&oe=6B070129"}, {"file_name": "Zoom Out Green Earth.png", "id": "435099962531373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404389_435099965864706_7827745048409383350_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7v0w1qM1y0Q7kNvwHzhxIr&_nc_oc=Adocgaeg2uZLVo-Xj5epLLj0r6H4cdblR6qJyI_by2tUChRADSuqFd1xW8dPojIG37g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8HztocyGNiR6ajdyVW3tuGI9wwArDBbwNhZ0fk9l4mg&oe=6B07032F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "synergi trailer cover.png", "id": "949587129940314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982473_949587133273647_374740217864517409_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RHN4pzjrnMQ7kNvwH4BKey&_nc_oc=Adqyu7o_vctLEqUoblU8yrU7JlvHbaLkjNij1OjsOVbEDDx6qpx76cJzisdYxBaNPz0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG0LJhfisIh5xMzllf5zPDiWC1PHZC3qdB4Yz8696H4g&oe=6B06FD6C"}, "display_name": "SynerGI", "keywords": [], "long_description": "Developed at Cedars-Sinai Medical Center, a leader in gastroenterology, SynerGI invites you to explore an immersive world tailored to enhance your understanding and management of digestive well-being. SynerGI is more than just a virtual experience; it's a gateway to a new perspective on gut health, offering engaging, interactive modules that make learning and self-care both accessible and enjoyable.\n\nBy combining expert insights with virtual exploration, SynerGI is uniquely designed to transform your approach to digestive wellness. Join us in this unique journey, and discover how virtual reality can open new horizons in your approach to digestive wellness.", "short_description": "Welcome to SynerGI, where groundbreaking virtual reality and artificial intelligence technologies meet the pursuit of gut health and wellness.\n\nNOTE: SynerGI is currently invite-only beta. If you do not have an invite, you can visit an affiliated physician. Please visit our website at https://synergi.health for more information."}]}, "developer_name": null, "developer_privacy_policy_url": "https://synergi.health/privacy_policy", "developer_terms_of_service_url": "https://synergi.health/tos", "publisher_name": "VRx Health", "support_website_url": "https://synergi.health/", "website_url": "https://vrx.health/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7497673183643830"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24280458474938704", "version": "1.60"}, "id": "236184285661457", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6172920
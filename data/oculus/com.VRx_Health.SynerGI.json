.png", "id": "342629148317754", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75439596_342629151651087_2032965022969246624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt9xzGWnbGIQ7kNvwFoYHcn&_nc_oc=AdoToE9pJxhd5Nzmgwnw8CbbBo8lVk5MYHNuhoyj9j4R4WsGf0uFseDTSx0Kvh8BJqM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStQGc_al5FC0TCXPkWjWY0vrsUqiKqwpmfhLp5GpOYwQ&oe=6AFB23A9"}, {"file_name": "Zoom Out Green Earth.png", "id": "435099962531373", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404389_435099965864706_7827745048409383350_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIcyEQ3yDtsQ7kNvwHhX7UJ&_nc_oc=AdpAvr0wOCwEjX6gJnuTVytTpI771-OaCqYbDsicCYlwaoqlwoCXMEWGJRuA4HphYXg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQMw5TiqsoBvYYV37Ujk5GgnSxVFvkvrazS5_Wjo0QdA&oe=6AFB25AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "synergi trailer cover.png", "id": "949587129940314", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982473_949587133273647_374740217864517409_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kH9lOLNnesQ7kNvwE17Gkh&_nc_oc=Adqk3F-borQ0Gpy_eloPGQmhLfS5012nBAl8JXZlJMTGnCHBTCaP_etkd9N53yrnemE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRycvQ_HV5SRGuSkXGgL1Mufaq5CRPjsenlEKQt8pPumg&oe=6AFB1FEC"}, "display_name": "SynerGI", "keywords": [], "long_description": "Developed at Cedars-Sinai Medical Center, a leader in gastroenterology, SynerGI invites you to explore an immersive world tailored to enhance your understanding and management of digestive well-being. SynerGI is more than just a virtual experience; it's a gateway to a new perspective on gut health, offering engaging, interactive modules that make learning and self-care both accessible and enjoyable.\n\nBy combining expert insights with virtual exploration, SynerGI is uniquely designed to transform your approach to digestive wellness. Join us in this unique journey, and discover how virtual reality can open new horizons in your approach to digestive wellness.", "short_description": "Welcome to SynerGI, where groundbreaking virtual reality and artificial intelligence technologies meet the pursuit of gut health and wellness.\n\nNOTE: SynerGI is currently invite-only beta. If you do not have an invite, you can visit an affiliated physician. Please visit our website at https://synergi.health for more information."}]}, "developer_name": null, "developer_privacy_policy_url": "https://synergi.health/privacy_policy", "developer_terms_of_service_url": "https://synergi.health/tos", "publisher_name": "VRx Health", "support_website_url": "https://synergi.health/", "website_url": "https://vrx.health/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7497673183643830"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24280458474938704", "version": "1.60"}, "id": "236184285661457", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6172920
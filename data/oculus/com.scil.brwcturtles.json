2-xa6rPyb9WedJlyeWwhoaN1OevYPqV6xfadBaJrCZDV55N_tpniC0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZR6t_uQNas3SoisqDKmv3bxjwWslfjjSWUFJTMwwB8w&oe=6AFF2B82"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mk4LZRPZ34Q7kNvwFmiQlb&_nc_oc=AdrbrnaSWcSK1Wjo1Jo597EYbLA66xjLYtAIS3QebSvcFjVi2k4tDCuWuvzPb24BtmI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc8tL_qfYVok2MxnzeyFSCC5PUH4HoLTvm6z58FmnIvA&oe=6AFF2D82"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v50cWhHxgwoQ7kNvwF6lN8f&_nc_oc=AdoT6cqiw3l1VzLiVlBF30zFehMNrEacWpQF7Mi0ECdkkycuK8t8ZJHyUbz7IKQf1sc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUXQWAW99NxgA0M8_Ww1z6F52nWdWeSdaF5Alqj0ncYw&oe=6AFF1C84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_desc
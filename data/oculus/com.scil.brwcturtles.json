8PAbtlrryy0tije8eLTEeep2lkz9udYJ2-J9FoxC5qYfnpBuoV-b9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6dSk_02VGXyGVEFXLZG84OGCFgyQVHZBaQmuY_huqKw&oe=6AFDDA02"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mk4LZRPZ34Q7kNvwHVmjRF&_nc_oc=AdoNh8fOMPhYLhol_fC2x5iuGcJwwcAsOU3XRWdGNv6sve0Dn-cZJCekiFzQuU9ypy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZR7QhgSh9T7K3MQI6N-SxVRhH3Rd_38a-ywxAGXcj-w&oe=6AFDDC02"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v50cWhHxgwoQ7kNvwF3_QjL&_nc_oc=Adp8XXjmI44xH8syJNNCloFtKa2CbaP6LgI-jZ_kin49zu4a0M0SD9KJSwULOuGG6b4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRrMFcHlRr9eOGsF9RUrklfDj3k5GwXN1M9iQZ_usHBA&oe=6AFDCB04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_desc
DxTc-_Yv4FEaiThgdJxBJG1C2poHK4HSpAH7Yiz0Ue5Q5iiDCUX1Jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU-I4kbZRcyusCWxne_Sn7LO1gFE1I6d5aIu0MUXN-ZRQ&oe=6B104F02"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NDfRTUFr3gQ7kNvwEBX4dR&_nc_oc=AdrCZjKjt6fVgBVeSascRaYJ7LItP2SGvgR9GBDIVRbdiYe792aGD9--Z1Mmb8imo0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW3eBVFrBNQDfHPkgAaRHb1833nlBFJs-T4BlDgJPsKSQ&oe=6B105102"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmS8kK9IZVEQ7kNvwEmz7Fy&_nc_oc=AdqP95W7AaQzNh4PEVGjr_YvZgYtxBX4FDPVZzbO6nNMGWO1Xakx95uADEnyA58W-0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIlWD2vIvZ76hjcNbg2xVnTI4xVP1AoePRPFpLhraqnA&oe=6B104004"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_desc
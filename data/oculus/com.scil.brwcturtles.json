95661_858628413896308_7854337799976750667_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tF11Q-L6zQQ7kNvwE1JnPq&_nc_oc=Adr9-gZfNOQE1-MEY7Oa8_LFpxF4RGxEKYQ9AvG6lVA_TbyavQH7npSQH8EryZu9iI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70lRGN_xYQ6Unxlonz9HEp0zoUHoWHh4U_BGwNGjWhtA&oe=6A1D8597"}, {"file_name": "brwc_screenshot_just_passing_through.png", "id": "3915852885387945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304106_3915852888721278_4341458014559372227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quhi4U8M8t0Q7kNvwEWgjxT&_nc_oc=Adpwjg9Z8K-h4FA0Ma_udB77dFLfpxuDqNpFIR2w3xJ8oWAvLVx8ovjlu93s-Cl8QNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76BYtvBMNPjQkIThheZttTQYexShbCMZNRpga6y_b2wA&oe=6A1D82C2"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdd0GnVpSnYQ7kNvwElkwZE&_nc_oc=AdqVaKW3t5xbOanrfhT8sNBkvLSWl2czed6fWtVl5OX96bYpVe_kHezhnYUEbmAd2Vk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zRBUvQpVmEy9EXnLp3WWaa5iFbpdg1Hdzt2w_3DN3VA&oe=6A1D84C2"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eKRZheDxDQQ7kNvwGTppAe&_nc_oc=AdqHwIMMGH9rx2TWI-Oj1JAVxTsLSUDo_kNoSPrnIz8jatcGYLUeW_Ls2kRGfW9gRR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ee9xIFYMPAzBVp8Yub6LUu1JcHygYJDktc6Z_Q3TgnQ&oe=6A1DAC04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_description": "BRWC: Wood Turtle Habitats is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta). Bask on a log, explore low-lying areas, and swim in turbulent streams. This relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26048290784873925"}, "review_messages": []}]}, "cover_s
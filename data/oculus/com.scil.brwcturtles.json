95661_858628413896308_7854337799976750667_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGFa2QYsCTQQ7kNvwETq3cl&_nc_oc=AdrMXvSxlkIT3pmyJtgzI79mARtmzZS-jwIqX2EzM38mqYzAfAb5_tEzA6kpezaWhYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p6OLd6TPIZ9kclC4p8pgYZwFfbRVU6vUivtG2uYh3eQ&oe=6A05CA97"}, {"file_name": "brwc_screenshot_just_passing_through.png", "id": "3915852885387945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_3915852888721278_4341458014559372227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0ELDTpvPscQ7kNvwHFbigJ&_nc_oc=AdojuoO4-oGI5kdphnYOlm_NUZVeQqqrPZg9yTAXjtURMPy_6IEiYD8YeTi-7sk1XPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42AQJpnLqqvNluf9B4LQlsg22yQQ9Im80WW_k6LdPGew&oe=6A05C7C2"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqbGIwep2hUQ7kNvwE72nhM&_nc_oc=AdrLh7ZFFtnha3TYFFm4TOp9gEW3gHUF_ZBKGbJ8n6qxFhjiEIq9hlETU5_x_KAz0gY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HQ3PzxK2u1YnxN3kPyTU7OEHQtAuE5HLbLlDc026SNQ&oe=6A05C9C2"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW6K3pJP8TwQ7kNvwH-WC9r&_nc_oc=AdoTPoEWWY64_W3b4Fu8DAVYKehQaFKJ7DUl_GBYEvuRHoHwE-C_l1J4m1kpknO5VLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7erpr0F331lam6JCz6RRruXSrAoLhtyA4xFpGe4_2i3A&oe=6A05F104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_description": "BRWC: Wood Turtle Habitats is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta). Bask on a log, explore low-lying areas, and swim in turbulent streams. This relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26048290784873925"}, "review_messages": []}]}, "cover_s
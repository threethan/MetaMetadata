95661_858628413896308_7854337799976750667_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqFkBZYdBl4Q7kNvwG4Kbo3&_nc_oc=Adp1IJKTJBORanJkm_BdxKxLRgW4qSZ9jcssyQrJ0-Pq58S9CcscxgQqB39M0F3ssoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ljXJDRbWM3WbPCSbmuqdhuUQeT3QQ_me0o3X6dRjMTQ&oe=6A086D97"}, {"file_name": "brwc_screenshot_just_passing_through.png", "id": "3915852885387945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_3915852888721278_4341458014559372227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf1cu93qMSoQ7kNvwGMrfWJ&_nc_oc=AdptiRUJFwt45wT5vts14VqZJX8xIZDzY7K2jWMNYmBYnjTDE3fGi1H3RHO3ckhxIfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uMi-1mE6Rpyh-nBl1xXjLal6r5hWF54PzxPB3x-bEIw&oe=6A086AC2"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrYgGvEMtDkQ7kNvwGDk2lU&_nc_oc=Adq8I74rUb7mERnogt-TKcSdUWRlf2od33QDEEqhfN4uquzdqmMVA4g-A8DpgLoB2C4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bS9nAykerdHKwRUxaRJcMbCCVPhiJ4HZdaO4EUPBQeA&oe=6A086CC2"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O13R7q80X8wQ7kNvwG3uG51&_nc_oc=AdqO30XfG4aDouD0T243zK98PmZU2wb738LN3QwMCaDNNaWp8J_I-J3ExpUGjUqOecw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ct-dZX8AR_ZuFtVNzbNiY40CAp_3EUJYhmru7EnQcQQ&oe=6A085BC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_description": "BRWC: Wood Turtle Habitats is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta). Bask on a log, explore low-lying areas, and swim in turbulent streams. This relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26048290784873925"}, "review_messages": []}]}, "cover_s
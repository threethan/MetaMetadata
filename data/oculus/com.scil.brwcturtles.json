dIzYxDgUxz1NS-A4n4bqzsx8U8N1Lf_yT-CcdukxrHpc2H3d1PEgMc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRclPy4-AKTen500Ef1qu0T9dheZCZmpRPH1WyiyJmoug&oe=6B0B4142"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmDApjpgzCYQ7kNvwF2ZJXJ&_nc_oc=Ado2GA9ycyus1utR9PjPfUsxFM33_O1U3UW-DBngES2LxmvJ7DRtyQ1FOzenlcltaD4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrY5wBqCEl3ZnhQUVHqW5FY5C9MW1fyn00NG_FfD_QBg&oe=6B0B4342"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFNowPoS2goQ7kNvwE6pyZ5&_nc_oc=Adq7ToWVPiOR5l-j2Ql-HMyTuKteo6jLb5CeO7I7NceysqDanfpu-jlfL_AujG2bqoY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9bBpcKvgpZH0hUyGdJatztvHVj-dDJmfNPW_fA74uKw&oe=6B0B3244"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_desc
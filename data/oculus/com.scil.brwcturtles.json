3NML_dBev7KUX8uXjQCeqiPfLzaTGT5_SHZf3YJL9OhD1EjRGm7KwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDdC5_y3IFQ0umyCM8_PS6eh03L7BzeYzaNKEqBb4_2g&oe=6B047182"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbfRDovPgoIQ7kNvwHCukFQ&_nc_oc=Adqdp54Pkjj-vL9jbIr0eCHRzYoFo4dhP24oQg9rtww1UP6sIKWrqfTqZrDQXfTx1D0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDA3B-rdKp67l6lnsxg-4__asASKFO9Zrx4oFfRLe0ww&oe=6B047382"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxMBYADfkScQ7kNvwE0sMpg&_nc_oc=AdpDDtcRXR19w0njwz8eGIHmPs8hwrqjzY1qoRm48Qqsd_XOdk30Dqm2TiHc02meFH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3qPCe8yOt99N7saApjys6B_Ah7vkRtpY0YblKoQIiug&oe=6B046284"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_desc
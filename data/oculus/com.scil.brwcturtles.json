IycyWaGJmqkh8iL2uAQrpRo58InPLJHs3mcTEtpVOZ5RAB-R4ZpCj4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8RsAFA15DZi89fBTPOHBnaSmzAYqP6beHo997XJtIog&oe=6B086602"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EW2lTu9JDSkQ7kNvwGSEbOC&_nc_oc=AdqNSFG6vHKJ75Tn1w0Qc02l3zj42zWY2VLi7EjE-P0saAxgDA0bXtZf-DqNzGf8gJw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgmw2IMY8abxvzIT6vIVZ7EaeURPM6_qOCQD5antdPTw&oe=6B086802"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqTFIPkAQrQQ7kNvwE9E-R1&_nc_oc=Ado05TNFPVJnV6MpG0wjYSVupEhTX_jGboW9BDidfFB4Vu6O9vznyk7WKqF0A8GB8dU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0Fluq2318UP8-ATUg_zjNj5NXMDBR7GS-XIJIIMrRbw&oe=6B085704"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_desc
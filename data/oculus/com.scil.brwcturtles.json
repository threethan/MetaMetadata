95661_858628413896308_7854337799976750667_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp6Gg8RuXSIQ7kNvwHLDt4d&_nc_oc=AdoFshJZBKnPxAROyX-3-k_UdYrX30F7VkV-kgzafYEY-FWGKbPBoZm3FTYjv18eQDM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LgTscFO34r7P3zTJDgozKyDuPyU-nsuXrK0xGlzoJFg&oe=6A0C6217"}, {"file_name": "brwc_screenshot_just_passing_through.png", "id": "3915852885387945", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304106_3915852888721278_4341458014559372227_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey_3eedd2_8Q7kNvwFqFl0g&_nc_oc=AdqDX9PiWnoo6dyrJ1ElzlWT8EXClmJQTbORuQR1SJ8vH7IfUsEcY9AYTUMzxoF1kyg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71M43T8Q8szKJlVAIzKmOWhZjGNFh0QnT352gQcmUD7w&oe=6A0C5F42"}, {"file_name": "brwc_screenshot_river.png", "id": "788250364003960", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303672_788250367337293_2673834546363597511_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALMBtCekyGsQ7kNvwHkQ6f9&_nc_oc=Adrxfj4ZZSTWSBp2Yu-jFWlIIfUSxd2-dKslDDa1T-a9DqFB6K4ZJDRfcYjMlsGGH3g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o5O0koXjWOjpDhIdoNM7fki-XPb1QtPA04kHpxZOrlw&oe=6A0C6142"}, {"file_name": "brwc_screenshot_main_menu_1.png", "id": "2830338847325924", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307470_2830338850659257_4915963760438780869_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpGCys5mBsIQ7kNvwEECm0z&_nc_oc=Adphx52kbdF93I7VNEnil5GjiEmlVtfel2yqoie4hTla6yiMITw-4UAD3hsfPYK57kE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oQP0zXhdTxWoKniF__0KCgYLhJ7CtwIdoP8JL6mCeVQ&oe=6A0C8884"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRWC: Wood Turtle Habitats", "keywords": ["Turtles", "Education", "Biology", "Environment", "Conservation"], "long_description": "**BRWC: Wood Turtle Habitats** is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta), which thrives in the eastern part of the United States and Canada. Designed as part of an interdisciplinary online curriculum, this relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world. Bask on a log, explore low-lying areas, and swim in turbulent streams. Learn to think and live like a wood turtle!\n\nThis project is generously supported by the Blue Ridge Wildlife Center (BRWC) and Shenandoah University.", "short_description": "BRWC: Wood Turtle Habitats is an exploration of the ecosystems inhabited by the North American Wood Turtle (Glyptemys insculpta). Bask on a log, explore low-lying areas, and swim in turbulent streams. This relaxing educational VR experience uses pop-up information and 360 videos, including underwater footage, to show you a turtle's perspective on the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "https://www.su.edu/scil/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26048290784873925"}, "review_messages": []}]}, "cover_s
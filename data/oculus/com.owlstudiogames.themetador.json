5771-25/491823901_1602947764903256_6701114915924066550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brEoe0pQ3P0Q7kNvwHgOkWd&_nc_oc=Ado7EKMwqDnE_ZItgeLKzLBit-AtkLgASFdVZUZzyZwLj1wdNS_HSgBqkl1kPzg9ma8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPhsZPKdeQZiHiqyclbNsQYjiqqNAYvFxEiNDINaKzig&oe=6AF1D2B9"}, {"file_name": "bull 5.png", "id": "2545047915908472", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_2545047919241805_6532747180761211242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_YeArA20OUQ7kNvwEMNuqC&_nc_oc=AdqE6uRy0iLqEXb3ZKsDk4lC5WHUmEQhEJ1OravFgPUL0-jAxUG1mewnBvuVmag_Yas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwjIAhQyBLwe9rkQyDf-sOud5zXWatSL4ldLkSFkFHgQ&oe=6AF2042C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "the coverr.png", "id": "1942129173132983", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604375581_1942129179799649_445206811654691547_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeU_aw7eWi8Q7kNvwG8IoRw&_nc_oc=AdqTpCbRqBiq7MoINEIVXa_cebwBPTe2ZCeIQJ3XwU8GJ1i_vxCJmKvSo8DAGKo9zhs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp-eGeypGJr3t7YlURR68jMgZ2p36_Gd5QAOATlBVXoQ&oe=6AF1E8B2"}, "display_name": "The Metador", "keywords": [], "long_description": "The Metador VR puts you inside an intense and immersive bullfighting-inspired VR experience where skill, timing, courage, and strategy are everything.\n\nTake on multiple action-packed challenges:\n\n\ud83d\udc02 Face the Bull\nUse your muleta to challenge and evade the bull. Test your timing and reflexes as you control the action from inside the arena.\n\n\ud83d\udc0e Ride Into Battle\nMount your horse and experience the thrill of riding while taking on the challenges of the arena.\n\n\ud83c\udfaf Hunt the Bulls\nTrack down and hunt powerful bulls in an exciting VR challenge that puts your accuracy and reactions to the test.\n\n\ud83e\uddf1 Jump the Barriers\nRide at full speed and jump over horse barriers, putting your timing and riding skills to the ultimate test.\n\n\ud83c\udfa8 Hide the Doll \u2013 Camouflage Challenge\nThink you can outsmart the bull? Hide a doll somewhere in the environment, then paint it to blend into its surroundings. The better your camouflage, the harder it is for the bull to discover it. Can you make it invisible before time runs out?\n\nMETADOR VR combines action, riding, reflex challenges, hunting, and strategic camouflage into one unique VR experience.\n\nEnter the arena. Face the bull. Outsmart it. Become the MATADOR.", "short_description": "Step into the arena, master the muleta, ride into the action, leap over barriers, hunt bulls, and outsmart them in a unique VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/quest-emulator/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/quest-emulator/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26082725161424735"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1601426728370719"}, {"status": "PUBLISHED", "id": "1107232068461995"}]}, "baseline_offer": {"id": "1601426728370719"}, "is_approved": true, "firstOffer": {"nodes": [{"start_tim
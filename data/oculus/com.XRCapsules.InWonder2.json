_oc=AdpK_gJN1dbWhvEcuBUkgOTpRg2Z_wdX1_78e8XnsjE4n257GFIRB8Cjvj1Dpb_ObTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGV9WqQj1n2gxRJC2tecyh-qyQExdSQX4csnO746_1EA&oe=6AFDD8CD"}, {"file_name": "New Project (4).png", "id": "1303981287381783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392325_1303981290715116_1160405968877243752_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5OAdLAUQRsQ7kNvwFqKBKK&_nc_oc=AdpdqFkNzmCJyVLUDz9IhLb_-9S8s3MNjGIkHy3tDSs5Z0qV1mIgAqPNZ59pVN_ZxVM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT4MiPjtvZkvac78qKCxecIG2o2W7Z4mDzYO9w1YAGSA&oe=6AFDC06A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2K_Clear.png", "id": "1366106834424694", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392301_1366106837758027_2887167376858393370_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlFaubOQsZUQ7kNvwHLJCym&_nc_oc=AdqYIbE70mL5P-ZEGcJJHXZg8D1I96JCe3n7dkiwFKX8kXDG1cjONWUQJ13leqUgHJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9WGhUpEFkcfGxnU4UwhSATajyG2_5o5jYouw6bNPSog&oe=6AFDAE83"}, "display_name": "In Wonder Demo", "keywords": ["Nostalgia", "Relaxation", "MR"], "long_description": "This is an experience of nostalgia, relaxation, and wonder. We transform your room into a Mixed Reality supported world. There is no goal, competition, or thrill\u2014just a familiar place modified for you to take your time, relax, and breathe.\n\nWe offer an experience that allows you to explore your room anew and in tranquillity. Traces of retro artifacts scattered around your house each hold a different interaction, each with a different story. You are set back a few years; be young, be childish, be wonderful!\n\nJoin our Discord if you want the latest updates!! https://discord.gg/9dxeBtEJUt", "short_description": "Ever felt exhausted from a whole day of work? Take a break, sit back and relax. Watch t
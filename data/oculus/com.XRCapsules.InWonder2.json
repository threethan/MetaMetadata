0U9R08_K0O3a4Be_dYsC5rYXx9cH2KmGzOw&oe=6AFC826A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "icon bubbles 2k.png", "id": "2094716244361794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302259_2094716247695127_5968120425093163150_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQp07QeExgkQ7kNvwFLG8oe&_nc_oc=Adouvb_GDJfOKHUbE5KRu0sAbfkb5JU_EA2W7z8DDFFgR4am6kbF4qkzOsXuR4_3DRE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQaZXwxJKVvAHRl7HFg3vD6sD1S5g7ic5Xcj2bCCSmkQ&oe=6AFC7DAD"}, "display_name": "In Wonder Demo", "keywords": ["MR", "Cozy", "Relax", "Custom"], "long_description": "# Transform your space. Escape the ordinary\n# Build your own 4D movie experience. Write your own story and journey\n\n\nIf you are:\n- Explorers looking for a **relaxing**, **non-game escape**\n- Fans of **nostalgia**, atmospheric **immersion**, or **ambient worlds**\n- Apartment dwellers wanting **something personal and transformative**\n\n\n{637302309362963}\n\n\n# Turn your real-world apartment into a calming, surreal escape \u2014 without ever leaving the room\n\nThis Mixed Reality experience blends your physical environment with immersive transformation like **4D movie experience**, **mesmerizing gameplay**, and **intuitive interactive artifacts**\n\n\n\ud83e\udde0\n\nFeatures:\n\n\ud83d\udcf7 Real-world photo import: Capture your space and personalize your MR experience (MR and VR)\n\n\ud83c\udf0c Seamless transformation via scene understanding: walls, furniture, and lighting\n\n\ud83d\udd0d Interactive \u201crelics\u201d that spark ambient sounds, animations, or memories\n\n\ud83c\udf08 Multiple themes starting with dreamscapes, retro sci-fi, and quiet zones\n\n\ud83c\udfa7 Pairs beautifully with your own playlists or ambient tracks\n\n\ud83d\udef3\ufe0f\n\n\n**Venture into your space like you\u2019ve never seen it**\n\nBring your world into the experience\u2014and reshape it into something wonderful\n\nSnap a picture of your real space and import it into the app to shape how the MR elements adapt and react\u2014every environment becomes uniquely yours.\n\n\ud83d\udd17 https://discord.gg/9dxeBtEJUt\n\n\ud83d\ude80 New worlds and customizations are added regularly!", "short_description": "Transform your space. Escape the ordinary\nBuild your own 4D movie experience. Write your own story\nBring your fantasy into your home. Begin your journey from your room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jimmyd95/In-Wonder-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Self publish/  Meta", "support_website_url": null, "website_url": "https://www.xrcapsules.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24788114587443111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392168_1163717738731282_9072804056599871303_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X8YLmKpZbUQ7kNvwFihW6m&_nc_oc=Adq0MvdE8R7uLwX30ANA7L7G80qaGCgXXYrnsRnTsTSXLED7eJ0yjQFaFBzS8X7rCrk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQClPwnaXC4UX8Vi0v_mLaONG-LtVKbgnaBfSpaoQ0V0w&oe=6AFC7C90"}, "is_concept": false, "is_test": false, "is_trial_of
railer_thumbnail": {"file_name": "2K_Clear.png", "id": "1366106834424694", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392301_1366106837758027_2887167376858393370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1dSugxP_wgQ7kNvwHtus_l&_nc_oc=Ado00HDFQ-aNlsh596Hsre1crqOTbgQT6u87SDexB9IpWy05X_rReazhlYslZ_MI_nc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKsW-WDaHLLiRBx_GMtUng9OUQzj5KwcfePOPpY39XKA&oe=6AEDDC83"}, "display_name": "In Wonder Demo", "keywords": ["Nostalgia", "Relaxation", "MR"], "long_description": "This is an experience of nostalgia, relaxation, and wonder. We transform your room into a Mixed Reality supported world. There is no goal, competition, or thrill\u2014just a familiar place modified for you to take your time, relax, and breathe.\n\nWe offer an experience that allows you to explore your room anew and in tranquillity. Traces of retro artifacts scattered around your house each hold a different interaction, each with a different story. You are set back a few years; be young, be childish, be wonderful!\n\nJoin our Discord if you want the latest updates!! https://discord.gg/9dxeBtEJUt", "short_description": "Ever felt exhausted from a whole day of work? Take a break, sit back and relax. Watch the world change through VR portals or explore the VR worlds behind the scenes. Enjoy the curiosity, enjoy in wonder"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jimmyd95/In-Wonder-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Self publish/  Meta", "support_website_url": null, "website_url": "https://www.xrcapsules.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads":
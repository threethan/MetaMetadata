8", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393713_1331054531485281_1875370352214122514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEDGiRzaNoMQ7kNvwHH3fWP&_nc_oc=AdoE-bR4ts72mPxCCNCckZJtcE4vUcTdL7jj3nX900Sey3GeLR5qfoElTU32b3j9Ym8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLhwsBhXdYgm29edbpf4sI6PNDftSTpoiPKHicMtbbyw&oe=6AE9F9B9"}, {"file_name": "SpaceMeta.png", "id": "1394908631790380", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821923_1394908635123713_7625135031165981820_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8eQai4G4ngQ7kNvwEhfouU&_nc_oc=AdoaJr6IbB1U8FGj1PYBFQ4vuQWmBynTcbYJtAb8ZVS1Ai4SKYEwGf4Uaqnvppip5uI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0N4jAgx1NsUEyYYb2N4tI_AyWYPZ-QG95ETf78v4cyg&oe=6AEA0C9A"}, {"file_name": "New Project (2).png", "id": "686164690761161", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391955_686164694094494_3457372755508931964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgKI3bslaOgQ7kNvwF_8fvw&_nc_oc=AdoIX2o3jM5txLWG_lXB2s8C_DDCDfOnmPapfG39KdUSRZqvN28aVAPNyKNc6uFFJv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo-T1EJ0Y2ohTiGGVEcYLEA6SBbUJcukUNbbH6SrsZCw&oe=6AE9FB88"}, {"file_name": "New Project (2).png", "id": "1045838367222483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1045838370555816_3216338584968395190_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD0KbM_O07MQ7kNvwFuB5nC&_nc_oc=AdpkKLRoBwmmhGdNbjY1wL23qfPXXkSaI9UllRhiFZsH52f9UMqbQYNQLLL4_k96_oc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4gg-3CkZLJq61uvixDt0jrIYFUAuBuaK0LbQSrp0FMA&oe=6AEA0D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "icon bubbles 2k.png", "id": "2094716244361794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302259_2094716247695127_5968120425093163150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiQ4ZmB7jo8Q7kNvwEe2f8t&_nc_oc=AdpEa4iYfZYtoywsTXUdKX9GyD8DWLyCPIPsTrziQlMLo5AzjsQd2lUs_q1shyLmuTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvTX2iLJyEDPZgb4NJ9t_fCQoZ6dIF9AjmQU-yxI7ajw&oe=6AEA08AD"}, "display_name": "In Wonder Demo", "keywords": ["MR", "Cozy", "Relax", "Custom"], "long_description": "# Transform your space. Escape the ordinary\n# Build your own 4D movie experience. Write your own story and journey\n\n\nIf you are:\n- Explorers looking for a **relaxing**, **non-game escape**\n- Fans of **nostalgia**, atmospheric **immersion**, or **ambient worlds**\n- Apartment dwellers wanting **something personal and transformative**\n\n\n{637302309362963}\n\n\n# Turn your real-world apartment into a calming, surreal escape \u2014 without ever leaving the room\n\nThis Mixed Reality experience blends your physical environment with immersive transformation like **4D movie experience**, **mesmerizing gameplay**, and **intuitive interactive artifacts**\n\n\n\ud83e\udde0\n\nFeatures:\n\n\ud83d\udcf7 Real-world photo import: Capture your space and personalize your MR experience (MR and VR)\n\n\ud83c\udf0c Seamless transformation via scene understanding: walls, furniture, and lighting\n\n\ud83d\udd0d Interactive \u201crelics\u201d that spark ambient sounds, animations, or memories\n\n\ud83c\udf08 Multiple themes starting with dreamscapes, retro sci-fi, and quiet zones\n\n\ud83c\udfa7 Pairs beautifully with your own playlists or ambient tracks\n\n\ud83d\udef3\ufe0f\n\n\n**Venture into your space like you\u2019ve never seen it**\n\nBring your world into the experience\u2014and reshape it into something wonderful\n\nSnap a picture of your real space and import it into the app to shape how the MR elements adapt and react\u2014every environment becomes uniquely yours.\n\n\ud83d\udd17 https://discord.gg/9dxeBtEJUt\n\n\ud83d\ude80 New worlds and customizations are added regularly!", "short_description": "Transform your space. Escape the ordinary\nBuild your own 4D movie experience. Write your own story\nBring your fantasy into your home. Begin your journey from your room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jimmyd95/In-Wonder-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Self publish/  Meta", "support_website_url": null, "website_url": "https://www.xrcapsules.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24788114587443111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392168_1163717738731282_9072804056599871303_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlIUQWAgc-QQ7kNvwFpysDQ&_nc_oc=AdrG2SXCR3MYjcfC2kUSqhPh1Kb99eG5r8ZErETsABCleBv4HCiXSqjfIG75y9BSxyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUrmklchRWySQg-d1C8uZ8k5-KR12vRZmtmlJw-GGiRw&oe=6AEA0790"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "In Wonder Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1744905600, "lastRevision": {"nodes": [{"id": "10044854832195663", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_meta
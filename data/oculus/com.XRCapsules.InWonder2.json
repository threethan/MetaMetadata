_oc=AdpfmQBpq_EJE2_-KSuADzanPzHj3smjglTqrJw_ZLztg383NgWITwsG4ULSS3YocK4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR1gNIy38ruoPj2Z8RF4yXXu5i89e9-X9iZQ5VynKh1g&oe=6AFB35CD"}, {"file_name": "New Project (4).png", "id": "1303981287381783", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392325_1303981290715116_1160405968877243752_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHToRaOR2JcQ7kNvwFKvHwB&_nc_oc=AdoHF44H45UTKpE_ofnbh73DZvRGcslMa4OGUHG6TarycsQK-UAlc0gj5e8gLSkk2iQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJdra5NYYV3i11dioP3PMRWpwvgieE09BnoJu19OmIyQ&oe=6AFB1D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2K_Clear.png", "id": "1366106834424694", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392301_1366106837758027_2887167376858393370_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Lg1CXPTpc0Q7kNvwHnt7k1&_nc_oc=AdqX9fK1W6oQHbd3OFfqQhHnSLu4nIj3qMfxkHDHXdiORoZeHAMNT0MZIHXH4NQ5jy0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUxkW6ajKryhdWrFkCZERiztJYFX_zSRtYET9qFlXtBw&oe=6AFB43C3"}, "display_name": "In Wonder Demo", "keywords": ["Nostalgia", "Relaxation", "MR"], "long_description": "This is an experience of nostalgia, relaxation, and wonder. We transform your room into a Mixed Reality supported world. There is no goal, competition, or thrill\u2014just a familiar place modified for you to take your time, relax, and breathe.\n\nWe offer an experience that allows you to explore your room anew and in tranquillity. Traces of retro artifacts scattered around your house each hold a different interaction, each with a different story. You are set back a few years; be young, be childish, be wonderful!\n\nJoin our Discord if you want the latest updates!! https://discord.gg/9dxeBtEJUt", "short_description": "Ever felt exhausted from a whole day of work? Take a break, sit back and relax. Watch t
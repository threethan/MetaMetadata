797_5683758558436592551_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6h7Pxo1ejAQ7kNvwG1fK5e&_nc_oc=Adp685QxZ5BYmOEJbFC_B43g3MkMs1efAZVMVRoPPquX7qNXgQwpTSuaU-A0gABXe_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVDUMmC8gbNvwaP3kgbIOX3mKmiyR7xuLQbukdJyzJCw&oe=6B07134D"}, {"file_name": "New Project (4).png", "id": "1303981287381783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392325_1303981290715116_1160405968877243752_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRSy68Ovn9IQ7kNvwErC-ue&_nc_oc=AdrVhs-MznxyscjYRoLcbfr-GkBBrhlFLkeJhukYgVnouj4pReYXApPYUlsn4_6lYdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgPOv_BnMUDyyBQdv0mlKuJND1iPogvCoKOzFmggSBqQ&oe=6B06FAEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2K_Clear.png", "id": "1366106834424694", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392301_1366106837758027_2887167376858393370_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaA0ydsSL2kQ7kNvwHzKSVX&_nc_oc=AdpftUE0dy4QRIvQiPdr6FuWRvCITB8PDy5rvnTzaV4cQvzJC1uc9hetZit7PL8uTok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCAXjNEQDSMiu7lueJi7N17dclaFd8vkRGg7YFXFXj2Q&oe=6B072143"}, "display_name": "In Wonder Demo", "keywords": ["Nostalgia", "Relaxation", "MR"], "long_description": "This is an experience of nostalgia, relaxation, and wonder. We transform your room into a Mixed Reality supported world. There is no goal, competition, or thrill\u2014just a familiar place modified for you to take your time, relax, and breathe.\n\nWe offer an experience that allows you to explore your room anew and in tranquillity. Traces of retro artifacts scattered around your house each hold a different interaction, each with a different story. You are set back a few years; be young, be childish, be wonderful!\n\nJoin our Discord if you want the latest updates!! https://discord.gg/9dxeBtEJUt", "short_description": "Ever felt exhausted from a whole day of work? Take a break, sit back and relax. Watch the world change through VR portals or explore the VR worlds behind the scenes. Enjoy the curiosity, enjoy in wonder"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jimmyd95/In-Wonder-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Self publish/  Meta", "support_website_url": null, "website_url": "https://www.xrcapsules.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24219644327623476"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1148019703738432"}]}, "baseline_offer": {"id": "1148019703738432"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744905600, "status": "PUBLISHED", "id": "1148019703738432"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26816740437913839", "version": "0.7.4"}, "id": "931481409094318", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10044854808862332", "is_concept": false, "latest_released_bin
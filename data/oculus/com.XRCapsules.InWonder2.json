8", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393713_1331054531485281_1875370352214122514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmECdZ6f7qQQ7kNvwHI_x6D&_nc_oc=AdoEyJg6Gf7BG5j9mqinc6-O26mvK8iNqkvPrIsVVqyqMQJ89dGW4bY2vper4by5Dlc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-KvvkuAPZbbs-MfzfMuG3NF0JWLdLfuB-NThYSbuPKQ&oe=6AF9CBB9"}, {"file_name": "SpaceMeta.png", "id": "1394908631790380", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821923_1394908635123713_7625135031165981820_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wpQlNDu-OMQ7kNvwGC2hoe&_nc_oc=Adqgekg1NAZP_cjOlkV4fjjBXuu2BcXht4nJo9CLrqlL2847j-6cMpw-lDXVNMk9bOw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWkeTyBHnNTVl5c844vvnLFJD2HWSWADrjnXN04oyHtQ&oe=6AF9DE9A"}, {"file_name": "New Project (2).png", "id": "686164690761161", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391955_686164694094494_3457372755508931964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPQlGfI9O3kQ7kNvwEjvLVN&_nc_oc=Adow8WFQ759BGqa6ThdUk1TQlRvVnTLJYRPW-1qFFjH9RntoVuAyYPvaJRNXH_ElsYY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdX8_rUYX6UgtXbbGIFP-dqOTfWHio64nZc9zCuGykHg&oe=6AF9CD88"}, {"file_name": "New Project (2).png", "id": "1045838367222483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619098_1045838370555816_3216338584968395190_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkFxRapVnncQ7kNvwGp5Sdy&_nc_oc=AdqUdeqP0X_iu8oGDHPqkF4zHDpZPzi-9ZGHLlzX5THWWyyha6DvK3fhT9qQFfe7XVc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6z2RMbvZw5Roph3TMooV3uF5SZNaIRg9KGJKy2a2TLw&oe=6AF9DF6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "icon bubbles 2k.png", "id": "2094716244361794", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499302259_2094716247695127_5968120425093163150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6fc36ZwAj4Q7kNvwFySk0T&_nc_oc=AdqFWTJOEJfBWW0pV-wYkenmOf_t1pfYjnVvHShizN93fPJL8RwDAWURSunsVEEzgWc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG4H5bHm-OhZItkcr8ZIOSdXwuFE8wXoRCZ_bWO7nflA&oe=6AF9DAAD"}, "display_name": "In Wonder Demo", "keywords": ["MR", "Cozy", "Relax", "Custom"], "long_description": "# Transform your space. Escape the ordinary\n# Build your own 4D movie experience. Write your own story and journey\n\n\nIf you are:\n- Explorers looking for a **relaxing**, **non-game escape**\n- Fans of **nostalgia**, atmospheric **immersion**, or **ambient worlds**\n- Apartment dwellers wanting **something personal and transformative**\n\n\n{637302309362963}\n\n\n# Turn your real-world apartment into a calming, surreal escape \u2014 without ever leaving the room\n\nThis Mixed Reality experience blends your physical environment with immersive transformation like **4D movie experience**, **mesmerizing gameplay**, and **intuitive interactive artifacts**\n\n\n\ud83e\udde0\n\nFeatures:\n\n\ud83d\udcf7 Real-world photo import: Capture your space and personalize your MR experience (MR and VR)\n\n\ud83c\udf0c Seamless transformation via scene understanding: walls, furniture, and lighting\n\n\ud83d\udd0d Interactive \u201crelics\u201d that spark ambient sounds, animations, or memories\n\n\ud83c\udf08 Multiple themes starting with dreamscapes, retro sci-fi, and quiet zones\n\n\ud83c\udfa7 Pairs beautifully with your own playlists or ambient tracks\n\n\ud83d\udef3\ufe0f\n\n\n**Venture into your space like you\u2019ve never seen it**\n\nBring your world into the experience\u2014and reshape it into something wonderful\n\nSnap a picture of your real space and import it into the app to shape how the MR elements adapt and react\u2014every environment becomes uniquely yours.\n\n\ud83d\udd17 https://discord.gg/9dxeBtEJUt\n\n\ud83d\ude80 New worlds and customizations are added regularly!", "short_description": "Transform your space. Escape the ordinary\nBuild your own 4D movie experience. Write your own story\nBring your fantasy into your home. Begin your journey from your room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/jimmyd95/In-Wonder-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Self publish/  Meta", "support_website_url": null, "website_url": "https://www.xrcapsules.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24788114587443111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392168_1163717738731282_9072804056599871303_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqbR4ZCAzp4Q7kNvwHo3UzY&_nc_oc=AdptiJh3BI7f8ZBySnEs9TpQSz3AQfgACPyHu7zk0sTNJ3NVO1FPASCVYmy96pu9Z_o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiBS5lVonjpxy2zSV95UrCvDMqBX_4n2vwq7A3dydnjg&oe=6AF9D990"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "In Wonder Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1744905600, "lastRevision": {"nodes": [{"id": "10044854832195663", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_meta
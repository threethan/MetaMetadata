_oc=Adpbjxx_P1E8HjdVA6cx3V1U6OxetyfvQw16hOenbcLu9L3mfWi60PYdWZsdt_T2Q0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeOq2qE5dcUiKAm12g1k2btowk7BlyLBHMi7BAkuI8hQ&oe=6B007BCD"}, {"file_name": "New Project (4).png", "id": "1303981287381783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392325_1303981290715116_1160405968877243752_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHZa0YeMGPAQ7kNvwGoyd4Z&_nc_oc=Adq8gYgDO45fhgK5RNslAiQLzxJ1QGDMEX2nj7SMXPG7q-MWJiRe_te0rxee3ZBsV4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIdG3lZkb9qdPYGnmQLqrtn_oo2TySujnYWZ9hh0TgRA&oe=6B00636A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2K_Clear.png", "id": "1366106834424694", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392301_1366106837758027_2887167376858393370_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlFaubOQsZUQ7kNvwGBJFfJ&_nc_oc=Adq3lTXFFskbh7ARS3sWFlNk6jjgHlekKiPELgX7U5x6mfeFtJ4GEhWmXFTaQeNuIEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpnWPxXDLDZLg2_eD7h5lP_SlQb_6zu3iVwZOttifG-Q&oe=6B005183"}, "display_name": "In Wonder Demo", "keywords": ["Nostalgia", "Relaxation", "MR"], "long_description": "This is an experience of nostalgia, relaxation, and wonder. We transform your room into a Mixed Reality supported world. There is no goal, competition, or thrill\u2014just a familiar place modified for you to take your time, relax, and breathe.\n\nWe offer an experience that allows you to explore your room anew and in tranquillity. Traces of retro artifacts scattered around your house each hold a different interaction, each with a different story. You are set back a few years; be young, be childish, be wonderful!\n\nJoin our Discord if you want the latest updates!! https://discord.gg/9dxeBtEJUt", "short_description": "Ever felt exhausted from a whole day of work? Take a break, sit back and relax. Watch t
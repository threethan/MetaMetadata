_oc=AdrAG7jRx7t_EG2ecxXStqrbnc7474_ZLxQfy2lJRU3qnA6rbx3ZQnmxPOhR6QwqCus&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYw_BblSVvwZSFJBk8nIiTjb8lRsxVMGXuZdanaktApQ&oe=6B031ECD"}, {"file_name": "New Project (4).png", "id": "1303981287381783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392325_1303981290715116_1160405968877243752_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHZa0YeMGPAQ7kNvwFFY86p&_nc_oc=AdreTvdmdEww5VIh_ZHi2uUdQEwjre_spScMQvnD6I3O1LAXXpJnaw81ORMI0_ZYRKg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkGKISX_sXmPdt9bnt_tCFZ6rpj_owztKCd6IUWD39HA&oe=6B03066A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2K_Clear.png", "id": "1366106834424694", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392301_1366106837758027_2887167376858393370_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBnkmlV0ij0Q7kNvwFNLNmn&_nc_oc=Adr_lSwQyZG6hpf7WREtB44UYm14WfQcaroSibA0CUamaQnf5HRNjz775lCyRmQX25M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWoMDFkgRYe0jrSLrOfg-ymRlZZ9EGJ8-lsZaJiL71-Q&oe=6B032CC3"}, "display_name": "In Wonder Demo", "keywords": ["Nostalgia", "Relaxation", "MR"], "long_description": "This is an experience of nostalgia, relaxation, and wonder. We transform your room into a Mixed Reality supported world. There is no goal, competition, or thrill\u2014just a familiar place modified for you to take your time, relax, and breathe.\n\nWe offer an experience that allows you to explore your room anew and in tranquillity. Traces of retro artifacts scattered around your house each hold a different interaction, each with a different story. You are set back a few years; be young, be childish, be wonderful!\n\nJoin our Discord if you want the latest updates!! https://discord.gg/9dxeBtEJUt", "short_description": "Ever felt exhausted from a whole day of work? Take a break, sit back and relax. Watch t
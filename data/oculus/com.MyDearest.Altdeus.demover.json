55_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=918AAer46yAQ7kNvwFTFUoQ&_nc_oc=AdmSLZTbOYNgGXEUGL8EN-7QQlZcOKHr-BHqRtmloZWhdLvzBlNYrlFRryyJd-LtWD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvY-qUaRX4nQs3anCOwZZip6DkzDXAr9D3MppOXfTUJGw&oe=69A6C395"}, {"file_name": "Oculus_ScreenShot-5 (2).png", "id": "454796315725944", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982707_454796319059277_5809357137146335155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9dhBq6eC10Q7kNvwG09yrF&_nc_oc=AdkKLiPClnNzDimZ25cUV3TY8tff6SA3XtBYMh64p6nmLOXpRG3CkQbri1rYhc3gaD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJU4yOqElysHb1o6_I1jtMLEW5l7vtYWxiufU697j0-g&oe=69A6DE53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ALTDEUS_\u30b9\u30c8\u30a2\u30ab\u30cf\u3099\u30fc_\u6a2a.png", "id": "623014301855381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572932_623014305188714_1244469375191983437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9SkP7mW2DwQ7kNvwHjIbUN&_nc_oc=Adlsf8_YxMZPDXuKO81J8fSO3PEjaJ3GVsgfcIpHm4JDfQloT5yDKrf-tsTNjLWIE3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftXIaBms7W2CfxBpveghebelofYtWWYRCtNChUyneglYA&oe=69A6CA4B"}, "display_name": "Demo_ALTDEUS: Beyond Chronos", "keywords": [], "long_description": "The best-rated paid Oculus Quest App as of January 2021 according to Road to VR!\nThis is the free demo of ALTDEUS: Beyond Chronos.\nYou can play the beginning part of the unprecedented spectacular story.\nIf you love it, please purchase the actual product!\n\nDive 300 years into the future of Tokyo. Altdeus: Beyond Chronos is a sci-fi adventure full of robot battles, pop music, and emotion. It features 15-20 hours of gameplay with one of the largest branching storylines ever in a VR game. \nBecome Chloe, a mecha pilot who will have her revenge and annihilate the Meteora once and for all. Pilot a giant mecha and make the decisions to determine humanity\u2019s future. Explore new choices to uncover new branches of the story and discover all of ALTDEUS\u2019 endings!\nThis game is highly recommended for people who don\u2019t have a high tolerance against motion sickness.\n\nDiscover the truth, destroy the enemy, and enjoy the cyberspace pop concerts!\n\n*This free demo does not include the concert part", "short_description": "The best-rated paid Oculus Quest App as of January 2021 according to Road to VR!\nThis is the free demo of ALTDEUS: Beyond Chronos.\nYou can play the beginning part of the unprecedented spectacular story.\nIf you love it, please purchase the actual product!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://altdeus.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": "https://altdeus.com/en/", "website_url": "https://altdeus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "fr", "ja", "zh_CN", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5426386004042739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568674_1672762189576663_2485270210677196043_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMkohtaqD8YQ7kNvwERUxpr&_nc_oc=AdnSUpvLUFjlAq7ZMIL-hW_-Nd4aIlVTwF7OPb2DO6nOGD_hl69EbUy-z5yMHzxDURo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsYtu-zoiKlx2uoXSJrf3R5ifhT6psGjZhH8TZlWOxuRg&oe=69A6DFCB"}, "is_concept": false, "is_test": false, "is_
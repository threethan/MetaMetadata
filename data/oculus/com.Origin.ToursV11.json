XcXGw2AJI38rQ&oe=6A0DB818"}, "display_name": "ImmersiveLink Tours", "keywords": [], "long_description": "\ufeffJoin Immersivelink tours and visit remote locations while you learn\nabout investment attractions and Canada's most remote region's traditional knowledge. Moving between environments, you will uncover the territory's ways of life and development opportunities. Gain an insider's view of what it is like to live and learn from the most culturally rich communities on Earth. In addition to visiting the locations within the Virtual Tour, you also need to look for several spots of information that contain extra valuable knowledge for you to learn and share while indulging in the stunning environments captured with high-quality 360 videos. Navigate the tour using an interactive map with hot spots where you can teleport by pressing the trigger of the right or left handle.", "short_description": "\ufeffJoin Immersivelink tours and visit remote locations while you learn\nabout investment attractions and Canada's most remote region's traditional knowledge. Moving between environments, you will uncover the territory's ways of life and development opportunities. Gain an insider's view of what it is like to live and learn from the most culturally rich communities on Earth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersivelink.ca/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ORIGIN", "support_website_url": null, "website_url": "https://immersivelink.ca/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["TRAVEL", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_
018375_672703317241086981_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki29qtK5QfUQ7kNvwHC_YrJ&_nc_oc=AdqETrbPX-8qd5e5N5FhDlhXCVQab1Z_-bOLrW8KKDUCJDJsczso85mBPdGm8yTUK5I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm8xKxjUzsWt0B-BapzwVFRqlx1tLkMCvknzsm3E9GeA&oe=6AFB4339"}, {"file_name": "SS VT 3.png", "id": "654310477061290", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303391_654310480394623_8351354957288183396_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y06CLuAoojAQ7kNvwHgyl1y&_nc_oc=AdqrRaWQQCSQLi_EyaPYl0wSPWaVL8M1TWa_8tZxIIJIITTEzU0SSW2xQdgMMuBT84o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUElSb-E5ybWPendPOn5VXv_7Xe1iqV8XWk4UxzDBpiQ&oe=6AFB248D"}, {"file_name": "SS VT 4.png", "id": "794280876359106", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822968_794280883025772_1518247421080104284_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9Eqwt0DctgQ7kNvwGu3ZNW&_nc_oc=AdoEJQWgBGsJCdOOoprt82QMQEXMfxI2TXDlmMzPsZCKs7bRrfc0eELX2y4EY8BiEN8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn7g7-SQix8-lgX_dcqEMPHQ529N9oTX4_i9Gyn2e95g&oe=6AFB45E5"}, {"file_name": "SS VT 5.png", "id": "785881623774689", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296890_785881627108022_2214000507698219832_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2ul5DitdRkQ7kNvwEio01x&_nc_oc=AdpYQ1Jr7YFlWnwvpcypit3HDRU-GdnmylgDmXXGJxu-10fZk80O0S6JHE6l4uAc0fU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHvkY-84lNJWDeOlI5o07wid-t2EdIJRDyTrAnmZUpQA&oe=6AFB45EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Trials | Remake", "keywords": ["Virtual", "Games", "RedLightGreenLight", "Trials", "Multiplayer"], "long_description": "Virtual Trials Remake \u2013 The Ultimate VR Survival Challenge\n\nVirtual Trials Remake is a fast-paced, multiplayer VR experience inspired by Squid Game and rebuilt from the ground up for Meta Quest 2, 3, and 3S. Face off against up to 40 players in intense, high-stakes games where only the strongest survive.\nCompete in iconic trials like:\n\nRed Light, Green Light \u2013 Freeze or be eliminated.\n\n\nDalgona \u2013 Carve the perfect shape with precision.\n\n\nTug of War \u2013 Team strength tested in a brutal pull.\n\n\nGlass Bridge \u2013 Choose the right step\u2014or fall.\n\n\nSquid Game \u2013 The final strategic showdown.\n\n\nCustomize your look with cosmetics and bundles in the in-game store. With improved graphics, smooth VR controls, and regular updates, Virtual Trials Remake offers an immersive, chaotic, and thrilling VR battle for survival.\nWill you be the last one standing?\n", "short_description": "Virtual Trials is a game based off the show 'Squid Games' we have designed maps and a game system so you feel like your a real player in the show! Will you survive the games and win the money?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1w1iDcpIpqVF0-eFvitQuTi1B9pQGok76882NFJkbfQs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PHOZE", "support_website_url": null, "website_url": "https://sites.google.com/view/phoze-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_mod
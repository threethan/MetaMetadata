uscdn.com&_nc_ss=8&oh=00_AfyCDLPxtLrt6XShWbeJ1dEkfxMlULwAci7wCGx3FVq6uw&oe=69BEA2F9"}, {"file_name": "SS VT 3.png", "id": "654310477061290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303391_654310480394623_8351354957288183396_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmNkjl26dt4Q7kNvwFNPpQK&_nc_oc=Adm53LWIKlSxq-CXhsTeIKF7j-lRbZmVOgq-QZh_yJkxRcm7HNg7Lwv0dq1eDhEStmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzREM8z3vKeRlSD7ROnMCutHkXCA7mLziHz3ddS-1PYg&oe=69BE844D"}, {"file_name": "SS VT 4.png", "id": "794280876359106", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_794280883025772_1518247421080104284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDG-zL2hgu0Q7kNvwEavdEi&_nc_oc=AdmTGOOMUYV27JCQhPOKONyVoQYsBZ3vaIG3as58Rlkhij56OBGBbdj3uaAI9V-Qizw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz64GzQeKmnEUol91ivyGW329mIAtcUFIQg7_vtqg-gUg&oe=69BEA5A5"}, {"file_name": "SS VT 5.png", "id": "785881623774689", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296890_785881627108022_2214000507698219832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGFGgSaBQhgQ7kNvwHx1W0x&_nc_oc=Adn8OnL5Bg9fpPd4bngbIq95bYfDHjFLKtAWIM9ToB17pCB2aovIkHJKW3fcVWVZ2Ng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhloUmBO0gjXiNguQ_1uX6_o6i6GyJR9kjd-MdQFM5zg&oe=69BEA5AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Trials | Remake", "keywords": ["Virtual", "Games", "RedLightGreenLight", "Trials", "Multiplayer"], "long_description": "Virtual Trials Remake \u2013 The Ultimate VR Survival Challenge\n\nVirtual Trials Remake is a fast-paced, multiplayer VR experience inspired by Squid Game and rebuilt from the ground up for Meta Quest 2, 3, and 3S. Face off against up to 40 players in intense, high-stakes games where only the strongest survive.\nCompete in iconic trials like:\n\nRed Light, Green Light \u2013 Freeze or be eliminated.\n\n\nDalgona \u2013 Carve the perfect shape with precision.\n\n\nTug of War \u2013 Team strength tested in a brutal pull.\n\n\nGlass Bridge \u2013 Choose the right step\u2014or fall.\n\n\nSquid Game \u2013 The final strategic showdown.\n\n\nCustomize your look with cosmetics and bundles in the in-game store. With improved graphics, smooth VR controls, and regular updates, Virtual Trials Remake offers an immersive, chaotic, and thrilling VR battle for survival.\nWill you be the last one standing?\n", "short_description": "Virtual Trials is a game based off the show 'Squid Games' we have designed maps and a game system so you feel like your a real player in the show! Will you survive the games and win the money?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1w1iDcpIpqVF0-eFvitQuTi1B9pQGok76882NFJkbfQs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PHOZE", "support_website_url": null, "website_url": "https://sites.google.com/view/phoze-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24250322621285072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619555_704433612558734_5074799280265168055_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rsj5tYpfWmMQ7kNvwGu24zA&_n
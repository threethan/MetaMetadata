&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DOuBlI-uyerPy3QWvcCRqSmmOf5lRF0pvFTwvabjCIA&oe=6A105FF9"}, {"file_name": "SS VT 3.png", "id": "654310477061290", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499303391_654310480394623_8351354957288183396_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1mybQS1QdcQ7kNvwGUCvn5&_nc_oc=Adq64DSGUtAyVSSkk0kXI39QAVH8futF8J8XfAUjL2mrIY-l-BBBjbx_X-dKkS52RmY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pzhZ30nOD3lXyF5y7hPPE1NyvHQdUSFcsuREO9e3Qrw&oe=6A10798D"}, {"file_name": "SS VT 4.png", "id": "794280876359106", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822968_794280883025772_1518247421080104284_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EUfys3McbMQ7kNvwGQjNkQ&_nc_oc=Adq46MiNO5GcLuKF1X7kM2OX-NfceFOn2DSd4y0R7KI-KGYKK85IQjQ3CqfTl5oeSHw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YOXGQPmqBqaOEHCZMuaGnA5BHboSc1tqmwqoB5e5KkA&oe=6A1062A5"}, {"file_name": "SS VT 5.png", "id": "785881623774689", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499296890_785881627108022_2214000507698219832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CB2UDUGroAQ7kNvwGbbWkV&_nc_oc=AdrQAnQ1vUv7ef_4yQ5-AtKZKzWK3NpnhL8Kj1Mv100qHbv_zx7YXo4Boe0eNF8lGoM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_urijFFx8FolhBQKW4CJEJm3LKr_DYqBDGAleK1tDZw&oe=6A1062AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Trials | Remake", "keywords": ["Virtual", "Games", "RedLightGreenLight", "Trials", "Multiplayer"], "long_description": "Virtual Trials Remake \u2013 The Ultimate VR Survival Challenge\n\nVirtual Trials Remake is a fast-paced, multiplayer VR experience inspired by Squid Game and rebuilt from the ground up for Meta Quest 2, 3, and 3S. Face off against up to 40 players in intense, high-stakes games where only the strongest survive.\nCompete in iconic trials like:\n\nRed Light, Green Light \u2013 Freeze or be eliminated.\n\n\nDalgona \u2013 Carve the perfect shape with precision.\n\n\nTug of War \u2013 Team strength tested in a brutal pull.\n\n\nGlass Bridge \u2013 Choose the right step\u2014or fall.\n\n\nSquid Game \u2013 The final strategic showdown.\n\n\nCustomize your look with cosmetics and bundles in the in-game store. With improved graphics, smooth VR controls, and regular updates, Virtual Trials Remake offers an immersive, chaotic, and thrilling VR battle for survival.\nWill you be the last one standing?\n", "short_description": "Virtual Trials is a game based off the show 'Squid Games' we have designed maps and a game system so you feel like your a real player in the show! Will you survive the games and win the money?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1w1iDcpIpqVF0-eFvitQuTi1B9pQGok76882NFJkbfQs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PHOZE", "support_website_url": null, "website_url": "https://sites.google.com/view/phoze-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24250322621285072"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619555_704433612558734_5074799280265168055_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_s
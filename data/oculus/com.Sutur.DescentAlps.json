c=AdneYFNsSrcqqlvbFUOD1V8FDYoT03cM11YAO9TIBSE3K48_jv-aBRzyUIwSczG-azo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd-sRpJ7MzEJKBWriiijqN-D2LGndDWDX4yobkqHXBtA&oe=69AEB921"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail1.png", "id": "447643492970800", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982495_447643499637466_9110429777194935910_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHnpPAq5iK4Q7kNvwEPdp1X&_nc_oc=AdmB8vdwF1Ia-p6jGciT2C9H8Ou0qiZP9Blb5EqgA3FhBBpe6TViNVeTU0-sbmNZtaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVQyu7mdKB2Iv4RMc3482MBye63v4SjKurwhTJUE-tVw&oe=69AED186"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Rhythm-based gameplay meets extreme winter sports in VR\u2019s most intense skiing experience ever. Face the exhilarating challenge of speeding down steep mountains as you carve a path through the powder, hitting the gates with precision and finding the rhythm of the slopes.\n\nControl your descent down the treacherous mountainsides using whole body motions. Lean into the hairpin turns, and hunch down when it\u2019s time to carve the skis and make the gates. The paths down the slopes are randomly generated based on the soundtrack, so moving with the music improves your skiing skills and boosts your scores, while making the game feel even smoother and more realistic.\n\nWith over 60,000 downloads of the demo version, Descent Alps has been finely tuned to deliver an invigoratingly real experience, while remaining comfortable and fun for pro skiers, gamers and total newcomers alike.", "short_description": "Rhythm-based gameplay meets extreme winter sports in VR\u2019s most intense skiing experience ever. Speed down steep mountains as you carve a path through the powder that connects your movement with the awesome soundtrack and the rhythm of the slopes."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io
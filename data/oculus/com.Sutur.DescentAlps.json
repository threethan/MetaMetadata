nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToXUyC8mdObQItqbcOhK0NObvbTKL8i6XW5HoSco6tPQ&oe=6B0077FF"}, {"file_name": "screenshot5.png", "id": "1478408759157323", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031630_1478408769157322_7373404166607691092_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnNqxsvY1skQ7kNvwEo_XKi&_nc_oc=AdrVE1Mw4-oCKx-9lZsv1XnzcmuvNJ74iDaeHCZ8o7w6w_fwvmwiD_ONWhbbssovP8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYNwKNWvw2gFH1YjOTR7lt0uYOHdnuolPn9Abu-fCbTQ&oe=6B007161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail1.png", "id": "447643492970800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_447643499637466_9110429777194935910_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QumQLiPiSEQ7kNvwF4offt&_nc_oc=Adrgm1-KDFXK2QwTFzXCMc1x-S_nY7gHS0xYSjJpZu95cJL3A3L0qF335A7Pw-gDFKE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiCY81SqYDfqAKskMd8OcelBdrLaoyBV7jWGc8Y0ZBAQ&oe=6B005186"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Rhythm-based gameplay meets extreme winter sports in VR\u2019s most intense skiing experience ever. Face the exhilarating challenge of speeding down steep mountains as you carve a path through the powder, hitting the gates with precision and finding the rhythm of the slopes.\n\nControl your descent down the treacherous mountainsides using whole body motions. Lean into the hairpin turns, and hunch down when it\u2019s time to carve the skis and make the gates. The paths down the slopes are randomly generated based on the soundtrack, so moving with the music improves your skiing skills and boosts your scores, while making the game feel even smoother and more realistic.\n\nWith over 60,000 downloads of the demo version, Descent Alps has been finely tuned to deliver an invigoratingly real experience, while remaining comfortable and fun for pro skiers, gamers and total newcomers alike.", "short_description": "Rhythm-based gameplay meets extreme winter sports in VR\u2019s most intense skiing experience ever. Speed down steep mountains as you carve a path through the powder that connects your movement with the awesome soundtrack and the rhythm of the slopes."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1643018716047982"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "507556007291283"}]}, "baseline_offer": {"id": "507556007291283"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1619499540, "status": "PUBLISHED", "id": "507556007291283"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4656378277730689", "version": "0.5.3"}, "id": "1370424569992177", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application",
-7&_nc_sid=6e7a0a&_nc_ohc=lnFQoawBAxYQ7kNvwG16zar&_nc_oc=AdqnFC0JpWyIp9dQ7yUn8TXzr_viLtafpi0jJBURz4jWp0VqUMqKCDJwAItNGJLoI7g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OM2h5rztGmLhUQvMz5xhp_e5G98I9fwj266_dGc75nA&oe=6A468DE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail1.png", "id": "447643492970800", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982495_447643499637466_9110429777194935910_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHQ4hxF-Lx4Q7kNvwF5_akU&_nc_oc=Adr3s54_NxsrMaJ-MrnzHARBqOtxnUq9svq2TMN_sq21tugzn913CDNSYFy3DdJ5Vi0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1khkZuNu_x57qJT6uPLw9bSikrT3hB632Gq3vVDP8Mg&oe=6A466E06"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Rhythm-based gameplay meets extreme winter sports in VR\u2019s most intense skiing experience ever. Face the exhilarating challenge of speeding down steep mountains as you carve a path through the powder, hitting the gates with precision and finding the rhythm of the slopes.\n\nControl your descent down the treacherous mountainsides using whole body motions. Lean into the hairpin turns, and hunch down when it\u2019s time to carve the skis and make the gates. The paths down the slopes are randomly generated based on the soundtrack, so moving with the music improves your skiing skills and boosts your scores, while making the game feel even smoother and more realistic.\n\nWith over 60,000 downloads of the demo version, Descent Alps has been finely tuned to deliver an invigoratingly real experience, while remaining comfortable and fun for pro skiers, gamers and total newcomers alike.", "short_description": "Rhythm-based gameplay meets extreme winter sports in VR\u2019s most intense skiing experience ever. Speed down steep mountains as you carve a path through the powder that connects your movement with the awesome soundtrack and the rhythm of the slopes."}]}, "developer_nam
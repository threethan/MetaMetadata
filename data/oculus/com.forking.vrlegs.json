 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHDZeL4OT6IQ7kNvwFgFT7l&_nc_oc=AdqhuUU9gGeAwYOL9MlBGsHDN9CE3f9AaqGyUIq-cgrkebSlLL5YBXx1STNokhU0mg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh2ae-gYO6bgrBr7ZcfANfWii2TUe3KfAT2-xfZVV4fA&oe=6A9D6427"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sg0rDupvVo8Q7kNvwGn_h9n&_nc_oc=AdpWLGdqt86YRD2T_9jLJOscMLN480-YDh99jBLMZwv48a6hie_QwaYAvtf2jB59Xyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd1KIHaYb3GJg8w4CZztn0j12HG3YpvaV7j8D5tXSLMQ&oe=6A9D5B04"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXMOmrPJSOgQ7kNvwERkXaC&_nc_oc=AdqmkBwZJ7D3xAbFINPDCXiqa2JvKqVSrdkhkaznnZxy-pYPHUwXDRkCErd7nGJrD3Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRBy56gMqV-zsgEQb88M6Wvq8gr57sv0tOm4iemD3jjg&oe=6A9D61EE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AucEIb-ih00Q7kNvwG7PGbc&_nc_oc=AdpZN3JAIYwKkPtKO0pjQ6_4eg6a4mmdD-NP7THQlSeIdXc0IVjNm61QyzLFZrXnWCs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6NgdrtNXPP3cjOZOOetCghPbU8TvqgW1hNl_NDoFptA&oe=6A9D6BD3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=di8OHUi7kQoQ7kNvwHm_O90&_nc_oc=AdoTAS8F53xT4SBm_qw3bQa6xGbXpTkktiDCnWbdVECN9e1bWOkBVfQtoh0Fyv5p6YY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS7dm3R2jkfMZHZ6hOk_Md0BozFq3IxXUZEBX3LF6baA&oe=6A9D6628"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
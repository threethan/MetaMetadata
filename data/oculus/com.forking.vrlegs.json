"id": "324169743635280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArsMyxCHeiIQ7kNvwHLd0uE&_nc_oc=AdphP-p2_kN-QaujpJ0of7ln3Wo1pwWjbLvgJb1UZbWbj8yhOTxg3yEEXZAp1vpDrqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFcRPBtqEbG29qlA_wItzC5Jjb9bw9-bUyP8aK1xEaaA&oe=69D10BA7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2XsLRGKfPgQ7kNvwHRBDWv&_nc_oc=AdpQbDQFjReHI4EYcCoOOaqdrvHX5KgNSWKc5HdxoKBk8u5QHcSAFbWjZm-8lUABePY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnEtlfDNws5K_o1GLEBPL2dXPwihUDVrmx8ffeDFPllA&oe=69D10284"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTMD4PbrVcAQ7kNvwFd_rwo&_nc_oc=Adpc_8IXG5nZP3K_lhxn-QSC1TDYqhVRmPqGaj7MDsspYQGk0q-RfbEGSZqWNczmuhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJu55gyF3lOuPFetOABHgHAF-DA7_49Hu-rfaaVH14vA&oe=69D1096E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2M7Ofk0tJYQ7kNvwFZn5j7&_nc_oc=AdogF8z0C7-9bl1sfSzpMvg3jXO3vQk3PPcZdtRks_aArvWJ16x-EB7iEDmfON16v2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiFxQIkZL6wNyyf0jLiLML6pCXUilOM4rBJZ9jKtmToA&oe=69D11353"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPD5cMJHWa4Q7kNvwEe_6r-&_nc_oc=AdqEwvQwnZv2OgRjeovdDm9DdDqJso2WuyEwnzC_LNIKo5AITHIYPLiE_JGWkzw7yjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDCAejVH5dDEq9ao4nxw3HwCVlZ-5vy-Plgor9_gzquQ&oe=69D10DA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
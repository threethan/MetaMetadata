41601944762875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391961_941601948096208_7632721309992638398_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUEv-ncHaWQQ7kNvwFJ92-O&_nc_oc=AdmYMMtR9m-jgYmw5thyByAh1spfnmX4okvJS8YPo6Ov5Z_mBgwCgMZg8cDMvWyHjQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfufBp-neGnZ48H_o2Zaa8uNX6vl2W0UUQdHt1EppjXGpw&oe=69A8410E"}, {"file_name": "\u5c01\u97621.png", "id": "963574985583086", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974649_963574988916419_3763510593318718466_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OU5DsGSuDIQ7kNvwEbWJMw&_nc_oc=AdkXnU6qdrZ6nVKfFXeQ-Oofp5XhrQyfHBM3-2y9MevEgcEZlTaQolEQj1vgt-wsQIU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfscVaFhskyBWI6P3wWmq2c7-emcZd9jDKUZhomjnOFhng&oe=69A81014"}, {"file_name": "ScreenShot_04.png", "id": "4053444874874795", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392019_4053444878208128_3527469773861649100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3i1fZoAfOZQQ7kNvwGvRjlT&_nc_oc=Adk9DNOtdwvq1zAl9vtc-F7oMeywDIQWMpPIBaWbqr2dcj8uAMl6C-P1GSpqPvs2tgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftSaV_82G4EHLE-pUXhXKTYt6IYNEfmhinsN-SLgj854g&oe=69A83B18"}, {"file_name": "ScreenShot_05.png", "id": "1049308367241254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391934_1049308370574587_8068744517803419363_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb1q4m9Gda8Q7kNvwFlpe5Z&_nc_oc=AdmgEzxO3o0wav0uObnIvhVNhud1AD4ctQzSoZ4COFeoSnY_SmEbcbiJvzOa7qemqkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuEctbe0YZS5UJ_rx_kkpXjGr4znxTILq-cPlNWmNVd7Q&oe=69A82155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s2.png", "id": "293807386481345", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75584096_293807389814678_7525229344081857969_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okslSDFBX7UQ7kNvwEEQfn6&_nc_oc=Adnl2Zc018nsdwS7xShsdcoF-TObXmyBJvkHxbsB6KmGtLaq7y1yKKcRrnsDsJIZte0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuTofUksmQjv_8ukVjYeNPHUnOrEko1aeLHuQs9XvJfXg&oe=69A83AE5"}, "display_name": "VRLegs: Parkour Tag", "keywords": ["parkour", "free", "social", "hangout", "climb"], "long_description": "**VRLegs** is the coolest VR parkour game! \n\n**Discord**: https://discord.gg/9aBVGM2FGy\n\nImagine you could jump, climb, and run like a superhero in a video game, but it feels super real. That's VRLegs! It's a new VR game that lets you do awesome parkour moves right in your living room.\n\n# How It Works\n\nIn VRLegs, you're not just pushing buttons - your whole body becomes part of the game! Our special technology makes it feel like you're really:\n\n* Running on walls\n* Jumping between buildings\n* Doing crazy flips\n\n# Play with Friends\n\nIt's not just about playing alone. You can:\n\n1. Challenge your friends to super fun games of tag\n2. Team up to beat tough obstacle courses together\n\nThe game has cool maps that look like real places where parkour athletes hang out.\n\n# Cool Stuff You Can Do\n\n* Move like a parkour pro in VR\n* Play tag or work together with your friends\n* Explore awesome city maps that feel real\n* Figure out sneaky ways to win\n* Use cool gadgets like gliders and bombs\n\n---\n\nVRLegs isn't just another game - it's a whole new way to move in VR. \n\n**Ready to feel like a parkour master?**", "short_description": "Jump, flip, and run like a superhero in this awesome VR parkour game! Use your whole body to move through cool city maps, challenge friends to tag, or team up for obstacle courses. With special gadgets and sneaky moves, VRLegs brings parkour thrills right to your living room. Ready to become a parkour master?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": "https://vrlegs.xyz/terms-of-service", "publisher_name": "ForkingVR", "support_web
 "id": "324169743635280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKI_gjq7zB0Q7kNvwEl9OKf&_nc_oc=AdqNblTncd5R6Tk-odXAkU-2nUkQVteoezJ3_nlED4LyHcliiOdtpqC_2MJBwzc6Vzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMsem8ZpQKE_IsipZB90IBvOkcuwMP3o_o908GCh-LHg&oe=6ACBC0E7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8rVqICAq6oQ7kNvwEjLiod&_nc_oc=AdqyMk7OMJaFzp8MAMnIeORChnmCuNHKbry15vj5M99-8IZ7d4CcqqNOZ03SLd5mbgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEaj45HHvFlJG4PJSLEgp9mWcko9nDxK3DmOod3keNFQ&oe=6ACBB7C4"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuYbyL2geBoQ7kNvwEU1Utz&_nc_oc=Adrc4E3baG8e-QCRHl8QgbxTrZk8HR1WlrVIH3FLn0byVftMlJQi8WFZvNKD6j0TM0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv054f-EafmeIgsEFV-vpXghlMMYOBgadIrt-zT7rVxQ&oe=6ACBBEAE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-sLaI78FZ4Q7kNvwG0k1-j&_nc_oc=AdpsXWg94nCfPWPN-OBIJIYH2QqZNBJeObb7SZ2U8wh0ibMbpijoTntiZyrJaExljho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtA-De4ZWWT61FlHitbd6V1ETbc7vz0AGRcMmlo0LQxQ&oe=6ACB9053"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9_KwifRlHIQ7kNvwG7dNuD&_nc_oc=AdqYSCIMbUifTXsV9CwdK8Bgk3pRCWfvxuMFDGI0mdpoy3hQWJP9fiVfTH_8NeYJ5xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoOeAByukdTiOCI85rB8jkIpslZbmu43Fw7DQBqPPhKQ&oe=6ACBC2E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
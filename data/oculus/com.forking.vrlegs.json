 "id": "324169743635280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKI_gjq7zB0Q7kNvwHJG2Hc&_nc_oc=Ador3mj3h5WAKg_LT01lhuPTasTzPc4UbiMJGLere1sbneQQZmmSmeVhsyotYYHbRYE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH0tAXfCpalIQZI0W1eK1qC-1_64zzmSzau4xIa0NR-w&oe=6ACE63E7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxI9sNgw014Q7kNvwESJsq8&_nc_oc=AdpiU8vSHxRXNzWb-fcqlVICQ84-5tgDe2e2lukz01mXsdsABgza6qCP4U0KMDgfR6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsY0gPTWivIlVUVsEZ-hwu20n-TYoKf_X3VTJx_H8PuA&oe=6ACE5AC4"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAwj2nQsFT0Q7kNvwEeAymV&_nc_oc=AdokCGH-Tz92EHgcDz17AAZsKu75THTKurn0XklSx39HkZA5Bg350oXPPuI0_362H1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKWvvUV0ZzFRDUrFGmxfa8L-_AVXcYk1eM9VVbUqOpog&oe=6ACE61AE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbRNofRf6_EQ7kNvwGsRzkK&_nc_oc=AdqV5lIgo-hKpW7cCsTsGJkuvuHrXThUdfY20-g_5vXM-VrNrpxQSpztGdUg8LLmbmE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOayz-lTJyeFpDVjHYK3sjAD96lPk8RIG8nJFz-XimK2w&oe=6ACE6B93"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkqtUDYt7GsQ7kNvwHv5mBa&_nc_oc=AdpoH6wQwgYITl07ntuE1PJplIl2Vktrca0f41ucs8aC8ctdAArTDOlaVAFpBpeQY2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYVKl1Vhn6cwKk-sYHaHgA0_KPU4h8Weto3NUqMhoPlw&oe=6ACE65E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
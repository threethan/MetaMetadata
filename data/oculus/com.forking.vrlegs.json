 "id": "324169743635280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZPqkbPjKQ0Q7kNvwEE8J30&_nc_oc=AdqPzz4sAYN3Jox_Jryjyxc_ehW87-7-xlpZMFfbyl0zRnuGWsbWxne0A7WD6W5oq5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-xJm9BWW1EIcvGB1860CNgAo7AxTZF7E18J0pJaTm-w&oe=6A086AA7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZq1IN7shU8Q7kNvwH2Gp6W&_nc_oc=Adr672mbTUBPXXJ_c4grpBgjX-3B6Qg-eXkVTzJZm7ORh6gSrcofOAzNM0X18AiJGpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y6wydRvJ0Dhj_jkddpIRx2Jp1z7Hu4CNQqWyOAtHMsQ&oe=6A086184"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if9agjqpJ7cQ7kNvwE2LT68&_nc_oc=AdpuZZjSyhB3lgbR4hdB5p3zQBPF9761sFahrKbed83_EETewVACAShrXNRLIgxyzek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qYxLQHKNpmDXmFogoHnnWy2CNZVZpY5IPwUzq9zrl4g&oe=6A08686E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWdYTKNsQo0Q7kNvwHp-U68&_nc_oc=Adq85NhbjIIZMwx37jKa2xb8t-1llN4xcIQo518zshHYBLBWqRQ2mLxDYVIYCx4yMr8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AT5UwnH-UbCYB9lLnHE-ttJfQQK0rvjiYlZ-MGEJHrg&oe=6A087253"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCSvwp5obasQ7kNvwF7vm9J&_nc_oc=Adq_o8hqkT26rZdah0M6g8lW3-YGGr6TKXfW-QdTZNh-R0GDIhNwE0WTeSIosry0tR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zv8RDnZpk7qB_dIhjdSxgP7Rry_v2U7w4YEuNuru9RA&oe=6A086CA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
 "id": "324169743635280", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu4gToUssasQ7kNvwFZ8r8Z&_nc_oc=AdovUJqnZrNi08QIxy2g6qs30FZCEVIJZwNh0lflM223eTpv7N_yky5VJcV7Ihj8FQs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwkmYSi3d7eYeIuXVA-gzBkIsKF_YwDWxEQ0EX0kFPkg&oe=6A81B4A7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m_kni07jCEQ7kNvwF1dNKY&_nc_oc=AdpsRewSWbRH0tMXVQ4AdDLVDtrUNvxC-QiZAgku5vl8CFBLB87Z04e6XzglXS0YuvU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFesZJ1qxZQdaYTKKs2fsYRw0PaXc6cvdmibTroQc9_CA&oe=6A81AB84"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZXVSYfOObIQ7kNvwHNcJHO&_nc_oc=AdqTylDGkOg2kPM_32qLzAvqP8EFCN7RkT16UhTGhRdJg6aoKftO-9Sg1BgQgikMxp4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqbquSlkUI-j7dM4dhmDp3EAjCzPOtrdfKlA20pAymww&oe=6A81B26E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osFAEH89nrEQ7kNvwEnOQ7Z&_nc_oc=AdosYBN0pchXb5fHGdfpzQPmJ7KdLjlrSzq2dSBfk3fmzo3URZa3FgqvZjyumoMH7xk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSsEVTcqghfMJcm4hUbWYt-33jaPT__v9BtddKp-pT-g&oe=6A81BC53"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZap_9dp1bUQ7kNvwHEDt5C&_nc_oc=Adp0cs18M57w2TjJKzS-Ibv8aNEpLhDA8eh-N5gWbpHS1M2jDu-62d6rDeiFfjSSwWI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoApbWN6fWiMcBeZogSa8fJjzEEFi0F8LFTcgXHf9nwg&oe=6A81B6A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
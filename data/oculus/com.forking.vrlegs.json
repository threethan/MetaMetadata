 "id": "324169743635280", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPgx5SE3tZAQ7kNvwFQ6w7G&_nc_oc=AdqQdj8Q1IVs6yeo1-ihXslodnHssZRjPJgMighIEhXtmET9ToRmqY9c3v_U6Hn2zqk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9WVE-GMbGQbV969QNZfpCZ7uXnXLp2IqRNV19RFDVBA&oe=6A5A27A7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsDIackUhW4Q7kNvwETBqgJ&_nc_oc=AdqjfHyyKOU_UPnsrLAXbTO_n5meJQpde-LeBwTr4NcNQwWew-OgnlHSqmE6EaRqPYk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAysYffeOmguVFv01THsQOwql7INyqhTwKT_zOeBBKIzw&oe=6A5A1E84"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLUHDCTXnskQ7kNvwEJvFOX&_nc_oc=AdrKQJ61KEI-jCLaUq2TyzJzXZdcgfIz02B0imCotiNcY37b3V6Es2mh-9qVybOob8Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHt80TZZm8xfZjOJ2ZEDZmNke5KC05JMKe-pXt6UXVgA&oe=6A5A256E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lLdStXQc-kQ7kNvwHhoTky&_nc_oc=Adp3u4upDZqFegqDLmZevQq1CeMqqA8VvJpGC_K3V0OvFgzeKt7-VnRAJ3Sqa_R0V80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9e9n3fe19dSNdGk0m6M4vcG1nZuvIx2XwFKk7Qd2RSQ&oe=6A5A2F53"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z6bdlyOCrIQ7kNvwGHpWCx&_nc_oc=AdqIC8VxzZZi-N_9HB_Mmn4mOn-ATIhIUqfqWB6J3Gj_t0gxk4kWGGCrWw1IDKorWiw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQworqaUNnvgRwGPl82h4sOvKJglSpV3rXPN8SJqFYRw&oe=6A5A29A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
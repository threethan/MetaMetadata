 "id": "324169743635280", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bl_OLVzIEOwQ7kNvwEAD-jf&_nc_oc=Adp0LXpswCa7HP5NEt2NcEecA_3YJt9fg3wnMgXXb6mQCGTZmxiE5FNleIx1m1EyKY4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvdiCjOC7uM4sYiVAleZ-pRHd-ndhcBz_uOHIo17mg2A&oe=6A4E4A27"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxlDiIqYJIUQ7kNvwHilJ3C&_nc_oc=AdoDB-jQ8tbeR3l1JBGNgDS0wS_VWMOnysQ9ARdvnw3Ca-LgsrOoeYh7Pgq_8g8UKBU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9n_kMh83abPBR0DYdKkdmAndB656gR_jm4nBbaB4fsw&oe=6A4E4104"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DL93Rp_9UgQQ7kNvwH-D2cc&_nc_oc=AdoLZ1mKyIov6ccxPWqynfBmJLBSPNGU2uk7Dw_aY1VlS0590h4bJmqOBvjm1t7pJCk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW_dD_pw2kP_O41mieid4rBT0DL-b6k_NgKC7tCzEu_g&oe=6A4E47EE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8--Q0GvrooQ7kNvwH10Oxy&_nc_oc=Adp8_tJyQYSdqLhjBQLlnQfz36gS3BQL755UAjV73UR-rcemu264vWNTgblUoD12eJI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKkpcW_zM29RbLmSUpP1XJ2oAE6n3WZSjq8mdDoRgzjA&oe=6A4E51D3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoL0ovQMNXUQ7kNvwHmInX8&_nc_oc=AdoEejioJHkm-QCX-aYDAKU_T1LUO1-P3kt29auJnD5b9E0kIin7nW9GBuejBClg8MQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmo9jwVIIdhV-ldCVu415umW3SDZHDHk7l28AnWtjqgQ&oe=6A4E4C28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
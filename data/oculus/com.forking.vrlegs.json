 "id": "324169743635280", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu4gToUssasQ7kNvwF7ePjP&_nc_oc=AdqBtZn6U55JalXfWvmsYFlFMAtW4n-Y_TO5vPe4h7cln8MrwI5SjRayv4dYReh5i8A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHctP8Z-yJPZTK6PFdeli-HiYG8BYw5xgFIkvjWLBR6w&oe=6A806327"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaXkH1O6TkkQ7kNvwED_Byl&_nc_oc=AdqCLC7A11hx-KqmY6otZ1mpbLI8-yxOzT_h8MLqMwEspFNfAuhyY7RxeWCl2fKP_LU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-YCA3q3FJSjg_cjzhQ9zl7CknKMGj29UF5hsBvafhFw&oe=6A805A04"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWt7M8x0RQUQ7kNvwGvoQVt&_nc_oc=Adq0Utjeo62kDn0RvVDMRtt3Ef8qySOr8yVfq_tAUL3T7hcpUQSVbHKnUnuUUdpUjCo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYGjsnhPN-3MiknJfomjFrIu70IJy657Ez5OVtQMn8GQ&oe=6A8060EE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osFAEH89nrEQ7kNvwFGij-D&_nc_oc=AdqaP2CLM1hSukdu--2_5LxwEvtSwZ6OiBISKZXJ9CVC3y9E48o2r7R1mk3-cwoeXBU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHe7DibHmJYKULWhwEWzyWS6LdnkwNFUxW9MzoWwOiUg&oe=6A806AD3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdWjdY2aKqwQ7kNvwGuypuS&_nc_oc=AdrbGVtAVyV-10dovYTlTc76MUhP0HYpoypXPo5QyWxR-7m1nQLM81MknanjDAkpT74&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESMRXq5doRbEImi__Ty5AoQrJwMGAb4Km3-cWqkcHdDg&oe=6A806528"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTrBhLN_nfgQ7kNvwFWnU5u&_nc_oc=Adp_rcRSWEBvoDW-0lisEN7ciSfPrxQhv3mt3o9gnGdnwRemNKz2o2oLBlca5oqGecA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFH-B6V6z9L1hcVpKj1bGvioJL4zL2qtYO2pUvbfnjHg&oe=6A6DEE27"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNlnWUmyouUQ7kNvwGO1EkZ&_nc_oc=AdoIVxVR4l-v0WK72i0jnr43_Ony9dI5RfmI-n_m5eoY_R1-jL6SRmrMoA6RFGa4Lcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsRnSEeKB_YDS0Sh86xukwzwi_LHDXN58HmAIezZpkew&oe=6A6DE504"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcrN0ETBSDEQ7kNvwEYHGPh&_nc_oc=AdrMSdwAk1nQJuDlkBaD5aS2Jk6fHSfbmtcscg1rcp_tHiLgRg0pnPUunwWjvTbNvLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9QTl7rG9PawdBy625UBiGUFpBpNLrOVQjTjQu9Sh4hw&oe=6A6DEBEE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnGp0a_xvZkQ7kNvwFlpQu0&_nc_oc=Adpx7untJb3Sog_fHQRMcQMZM43KIvSwJ8kPrLkjS0omDUiHk89cEriCR3bmIrh5sH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdZ1UvezYm14ROjuXYYTBk4YGgOgxfWQ3rU84Uz1bU3A&oe=6A6DF5D3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI9waR14AeIQ7kNvwH9wWbn&_nc_oc=AdohHltp9v2tvmAY0iZDXDfKK0MG0854DX-Z5EXM_XLCCSkT3jpbDy_3dzFtdK9Oask&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy-shGC-edtXJiZnZWDx9gvBk1w5c-MsCaaP3htMw6nA&oe=6A6DF028"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
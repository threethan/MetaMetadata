 "id": "324169743635280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CWyTqYr4YcQ7kNvwHLaHSf&_nc_oc=AdoFIv6K-nI2pM29L_yeHqiMjpVUCDQGvTN7KwzbkHk3cU3DbYyZXMBjkAQ00jTWSxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrClukw120Z5FNmaHXor8C3h8PajiEkuKjncl1B-Ft1w&oe=6A709127"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNlnWUmyouUQ7kNvwExoEkx&_nc_oc=AdoxI4ZWoDVzNXv4RroEwNk5fDP-rn3Euo2ZmMbpiP60nPdwvHQk1BJVFAvpOSd_pfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGKjGAbzoBe5IlxgDMmLseAyVSWbVMza18-houRcxd3A&oe=6A708804"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcrN0ETBSDEQ7kNvwHFTeaZ&_nc_oc=AdpyuGHSf7vAZ9vZfJkAu6chGfTm7YqWSlGJ8TJ1EHGMc9_hcOLctg54JaZ-Ax2awz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgmYhuC9kfTJSCgGioESLqu73lNXHjpIOeftK_iSaU8w&oe=6A708EEE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhbLMGIhaEoQ7kNvwHRtwMK&_nc_oc=AdrLC_pKv81EUP23sNlDsiITE6LvQXr3VTblmzwRStIM_eDiWDXIbHeg6wVvfAnzZXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEvX00VG5HVeOQFQfjHbsoHxGvjmg_2BwJtQaNNgfCHQ&oe=6A7098D3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI9waR14AeIQ7kNvwGn_zh4&_nc_oc=AdphKSbIm4uKUVo2JCcQjiueIC35IzVlsHqqHHHr7cUxsnYb2P7KDfxO0ZeA9KH-XiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhUwednMFHWS8BFXefulti3B3LrneZ1p5wZu7bpNOFwA&oe=6A709328"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
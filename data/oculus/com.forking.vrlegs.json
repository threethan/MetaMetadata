 "id": "324169743635280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD3TbCLwoIkQ7kNvwGLP3Bg&_nc_oc=Adq9Rsyhs_OozRk75i6RuPBO-WpsPxIvrPy13euG-rvdfpaGr6ZcgsGrlwqvbhy8Xac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xbJGYvCZonyAIasUG8SiIvf5ofPMMiOvPPxuAghh7oA&oe=6A25A3E7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u59uQdohH9YQ7kNvwHW6dLP&_nc_oc=Ado_nkUX4xqjW13m22-1twtYbXFU7V4s1OCzNnYvGI53rdCqCQZMGuM1MMkOhJKwFMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98S7aj9ooqU7vMS7A83injXwVHevVhHdv4SOkb_Ra9cw&oe=6A259AC4"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNIUBA9yJdsQ7kNvwH55rAG&_nc_oc=AdqR8b5O_zsVK_ThV6H1pOwioh2FDEEF3ZvbDTvAU1sHTfhvNJYQ7QL0WHyAuChg_IM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2zFV7qsWSU_pg-eMowRpTZxK_hGLAIKU7ExIzfqe6cA&oe=6A25A1AE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP0_F9GDDpEQ7kNvwE8FOu1&_nc_oc=Adp_WQkO6fmffqnbc0-8rpbQAM2ariXoCr9NcCtbO2Ii5g1BA6N_d8C63AXCd9LoPMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-xOv9b-IRSYx59Olcn5Q8cxAT1H9pJftuQcej5KkKaw&oe=6A257353"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ef4gDOGuk-4Q7kNvwFF1MmV&_nc_oc=Ado_gUCYawfwkpmwIwH8siXuGtueSCc6TRv2kE8Xwi-qDjcFT3KYVn2imYhDlmvA764&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_20yH3aJfeUKKONmyZjN5cOOPgt2i__me-NBkD0J2A_Q&oe=6A256DA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
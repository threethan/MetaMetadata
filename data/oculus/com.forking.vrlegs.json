 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTrBhLN_nfgQ7kNvwHvEzRG&_nc_oc=AdpYxIfRaj1gzKBQ5zWUlWdD7OGueKvNSzgoJ2Iu2__jLeDaFAFCG9EGiWC9hLLpl7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWjcWhIwQU6Sw7pOi96BtlmVWwPhzOmDyIGISCJlrkMw&oe=6A6C9CA7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9nwgH3o8UoQ7kNvwEBoT9V&_nc_oc=AdpVncsimPSUAGeDOTnNSO2YOkcvZMYBo6Fc2GXikRRT-g-KglDVvrUyTN-CjXjGjpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPgztjDFTDFGiXl1rMY5XzXXobb9nJsTGTctKgoou2Yg&oe=6A6C9384"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK1hLXOcLoQQ7kNvwFZOp71&_nc_oc=Adr_16brbslfq1B7fhjUyFNwq6dgGtuiTS_-L9lmP5qHiKsXOMKzjq4GKdMxm09U14k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWx72gUw_U4P9iM-mZc5UH1doE3EghLc1OWTJLrQsBMg&oe=6A6C9A6E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnGp0a_xvZkQ7kNvwGFB4RC&_nc_oc=AdqayHz91CARvHGPmCjd33WOhycRmYHVax_OmA4V3gDq6W0Xvr_F39nfMR-g33ksjtA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRt5QS-S-_bwMNcztzt7hMy5fzuEHPHCP6Caf6U2jvTg&oe=6A6CA453"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSq4GbnaQeAQ7kNvwEa9QzS&_nc_oc=AdpcZPTtTW6Zd3nK8mvNxMNYYJoM2ZHMSpqVMHJFWUxXzXmM5tN4A0h54pg9dBOIyY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq_5N4IUrfzz6Sb7f9ekoicb_IdURssYxKduwSCc3YvA&oe=6A6C9EA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
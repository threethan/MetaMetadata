 "id": "324169743635280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8L51wDTkXyoQ7kNvwGywYcl&_nc_oc=AdrSehB5riOTfxV9NT-kEkDox66ZdL4SQ8Dz4cfJF_npznmk4B00OY6pNqJ_1-lgLMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk605Yl80lQi4olTYiB9aYPM4XUMFGwk3rOitQRQI94Q&oe=6AAFD927"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjxI43NRtL8Q7kNvwHOVggM&_nc_oc=AdqiMvW4j_PwQ-D1dhUgV2_vdGhXRq9ltlYeB6fRd0CG8q4UlPf3T4G2IDYwiYLLQ4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk_njEU7nSmX720ldTqSt2t69QItX1FzeoYOW4RQbo0w&oe=6AAFD004"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IfDiufNZqEQ7kNvwHO747i&_nc_oc=AdpS6_FXUeP1br7FcImDvfdZ29zZZ85nkq_ae46cJtFUUBjQnjyfiAh4tbh0uBGv_cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZtrxgh5Hu6NiuTsKHENK_Vxobf5WsKYgEqUxa880w7w&oe=6AAFD6EE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Foy3RcgKBw4Q7kNvwHbrJvh&_nc_oc=AdquH_VMRZoQEMdb1wSNUf9r49kqOrTbluj0J0MrNKs_en5OiotA32KJT2uwE7dkUgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ15LSgr8PlBJzp728sz0-CqLv5trtGP9wcNyuqF9z0Q&oe=6AAFE0D3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auRZKJDbYGcQ7kNvwGcrbeI&_nc_oc=AdqELTQSCro88bC7WcnhPN8_gA_uG4zPYKBrQhcQSBTJFk32LCLnvtDYanqD_6IrdjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJonxkNineArIvdAoAnZ3keYOSyDtpdALB61Zpj1s9d8g&oe=6AAFDB28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
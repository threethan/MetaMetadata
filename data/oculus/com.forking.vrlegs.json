 "id": "324169743635280", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB3T0njPvEYQ7kNvwFDngGR&_nc_oc=AdrwK5J2-LpG4-723P8Sgxlh3jgMfgabHhYmEC4N3fqpqJcssFPoULvue-fQiRBCKKM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-vMzEmf48Xg5seleESbnvcuo7B8f8AIQRDVeiPkBVUQ&oe=6AC7CC67"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHgVUYeX8-IQ7kNvwGrvzqK&_nc_oc=Adp48sRu-5GZjkL1pBJPnz0aozktX5yTrFWEzIheyGNpe_fj96VWfDFAtgS_2cCBsgQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkmOwCO-E9YNEk1Tiu3hjXmQDHYSOYKNindUsv4fLs9A&oe=6AC7C344"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-nPA80BvBkQ7kNvwGHf2k9&_nc_oc=AdpRbRjIwpXarrBVXCa_3ltnVCjmsJ-SvUx3pC6HjwGx7cxRJfvVjRosOe738OCt2qE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUKzlj9OU0L6TQ-JPffdpyD0GtfQDeUIG9QheHJE2WAA&oe=6AC7CA2E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk1HbWWco6MQ7kNvwGTiyUQ&_nc_oc=AdrL5xemNZ-163SNfl5KpYy3su7E2YkrD813zi-vVMqT__GELU6XcQN5CqB9hd75RlY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKsC64qY79D5Iy6Q0oRBBt3GifWeR3BaxR2zcg3NuACA&oe=6AC79BD3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mR92P9bxkwQ7kNvwEL5HWz&_nc_oc=AdqQL7nhSNvDbpHZ6N_Kg12bL0F1IjPH-cXvri6u7eNT76bj3VKx6zV2QE7DzajezzI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2nZlOifdWQdBKV5aChieGWATSTONw2anhv49jiq6QYw&oe=6AC7CE68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
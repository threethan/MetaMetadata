dscape.png", "id": "324169743635280", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXdfpnqz38MQ7kNvwGmXyEc&_nc_oc=Adqxb80Na6hYUbjPWkkV_4P2MPjwDRVjqzK5LdYsyiJpgtQWkFSp88D89rA4sf05HVg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoR2_qn0hscmqAqITZGVK97dUs6Mb5g7UgIDuAVE65cw&oe=6A8EE3A7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eE1juMRTbkQ7kNvwEWePVq&_nc_oc=AdpZaP2eU9K_61uuem1Bn7U8GlqTx1CSqzl_biPm5m3-PIfFyYPYi7IuR7rYnEei0sc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCuemVLIH4QUWEJSbPab5y-zZnpTWhdstICuUsfaWPUA&oe=6A8EDA84"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIW0vp67SH0Q7kNvwEUpQZU&_nc_oc=AdqVhAj_gx_MAda54NyS7BFrjC5l8dB0Blxj2l0rMfylXewwkU6XDK1iDOuvCimnwN4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnOYThwA4F8bg97ob4GhWvprhJ0hXRh5mvw94WiFenrA&oe=6A8EE16E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYTm3Z-2KcMQ7kNvwGcySbq&_nc_oc=Adr64uivnry-qBPYMcCX8IKh-K0pDQP_ZuliKWe3DIaPRuO4hNUlFZXXyunwxzjq8lU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3KnOlwiVipU5u2Q2LHmjBVO89SAO_0q5izKV7pJYR2Q&oe=6A8EEB53"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3n4Mnv1G_UQ7kNvwFelHe8&_nc_oc=Adoi9w5jyJh4pXTYg9vvDIitkxUXlQLhBzeUM5pPxdN_WFPfquD27UuCTq6cDoo4u9Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO8rus85yfG5J2-p4CLgrMJl5kfSrkQNYitgKYkh1VOA&oe=6A8EE5A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBuQMc1OVi8Q7kNvwHLE1ym&_nc_oc=AdoM5v1Yiy71Flt2HlkCu_76nyH4bw46yJwhQPr7yvyJmnPrMo0GHolQ0IF2v-yms-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvZpXNj-jj4dYtA4DCeTUD1dBR0gWKCOiYAlzOUNZ5tQ&oe=6A6210A7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAfNnHjxw2cQ7kNvwHGcG_R&_nc_oc=AdrAPPhrAcA6w6U4eXhOXiox2AelyTDmqJ9u5FS96vH0qDrdpPbJcgcMyEy32f6uHAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1uwzU7T_5rHqiIsgM6Gstm6H6aBdbwnnDQ5e_lvKqfQ&oe=6A620784"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guhOQoPsc94Q7kNvwFX4Ass&_nc_oc=AdrZtoe6GzkDk-w9fr9K5v75BMr15mXmCnLq4z4MrJko8XwawYqQ6ngA3cso34We5Jk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdFd5jRJ2Qwga35KfOj9K9FAxmHVZCtgBXFycRe5DCCw&oe=6A620E6E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4c1YIVAY1yYQ7kNvwHBl5Ud&_nc_oc=Adrg6KB6nzYIfHmnWMSGqiyQZlParH9PRAbmnGLN5Fg0ACDZ1Fv85M0PyiFb79TSrDY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVfShU5XfVhTBDX0V7pRfBAAWNJRXto7kwozlAazX1sA&oe=6A621853"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgSmdM_2WHsQ7kNvwGNqYi1&_nc_oc=Adp8vf2_s1jRi-2f9FyHXcfRW_kapavob039yGVVGchSUUHM0VF1zKVy_7AqfSjIMIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2EkwuLMxFU5VIx10qxgFRVPLYN6HrTcHgU0W_cDmiIQ&oe=6A6212A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
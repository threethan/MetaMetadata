 "id": "324169743635280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wd_eUjKNU4Q7kNvwEV5AfN&_nc_oc=Adp8uP2HLvbRUJeFpzaSfEnfVPHFtz93WptOqgos2C3H-Ad16CiyBmiWcFwChwSMq-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eijijUqZwbeeaTZJxLGwGy9bZIISx2YNK6R0FE1SYtg&oe=6A2D54A7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzSba_slB_IQ7kNvwEmpQJX&_nc_oc=AdqUXsy864n3MnyP7U3I5OeeFaZebFLT6tjFI1dUBknumT7fy4W_Nkvh9gKaTi3Q9xM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mStxA5IvzsC4LeYzKA74Cohr4fT9R4Zc6ASd2YoMarQ&oe=6A2D4B84"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a72rys_rEHoQ7kNvwEbwkrc&_nc_oc=AdqkJUWoQzXLxRnMQWSga2hL7MtGA584q56F_MoGfvzXLFOJ7T6XsGtFqThirXSJ2oY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b0a4_GUOb5ehbvFTTRoVMnCXqT8vgQdfuVyzLvd5ITQ&oe=6A2D526E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0SQcloX8JgQ7kNvwFc6NJz&_nc_oc=AdoBSxjuog4H5zHK9blWjjjq8BwZe4soCBLXeAzRTM8P77IGW3mHg9KYkiw70ID5P1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qr5vJWUSbZPmmswgtbJh5xH5UY21478INvbU7W4bheg&oe=6A2D5C53"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou9Iuv8qw3oQ7kNvwGFyFT3&_nc_oc=AdoDn-yxu1D4qncj6eVRyslKyTIcTmY1ODwV-ZriE1t1YYbM87PyR3J-s3VDxPPJ16k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O3sIv9gbZ25gUpt4u7KzM1_G7OjyOPSOW2sMN24yzhQ&oe=6A2D56A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
 "id": "324169743635280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jSuR0AhtmcQ7kNvwH37rPV&_nc_oc=AdoZzdwyd_Ef-RhiyFaHchFQtyeDnbc58QJB7wgGEnMoPSCJhSa8d6fpPeUAQqRc1LM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72u2WaowYo05FLB_2Zle9IVcru3_Pzd5yP4qNfD-Rv1w&oe=6A144827"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNGzRxboPukQ7kNvwEGbu1U&_nc_oc=AdpVeKZ2PiBVnJKzc-mOgICn_rKAc90af9bQvE19NBvQYQWQbOssyVlW5IDb809kEXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62PRwmJ6HILCT8YRgCl3f6JB6WLZ2oJoma-fq4zy4gvg&oe=6A147744"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBHUXH84oHIQ7kNvwFABuRN&_nc_oc=AdokN_Zt8ij0bgJKDKymP0j3m7rH5zDpfvR5pj_-U7NOXCyAPd9qwNpoBxwUjvrwhCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fMJBPu8ntDLeNExrZi3cJqJ4YkZ_c15K1J_oN032D9A&oe=6A1445EE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZmn2nvP6tUQ7kNvwHJWyrl&_nc_oc=Adocpcjb-bh0Y1Biij46xtzCYa_eLHaUgjQvZd25cZ8tCNBy6coO6ynUTeZWtl1Hcng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T3SbF4RDlCesLZEAT_VM3Z7FOk2L8K8srJ-id7kbq_w&oe=6A144FD3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_W7ofd4b5IQ7kNvwEByuEF&_nc_oc=AdqF1jUEvZ73b-6TVrQjwFR7rjKiXoJ8ELI-0fF5-WAWKZoGT1-WFuwxixIqmaMuo1w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lMjQbIN3shqLtH5uYuTjuS2HFVMGrginZZeKXS5WqFg&oe=6A144A28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
 "id": "324169743635280", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz4kF8wZE_cQ7kNvwFZmuQ_&_nc_oc=Adq1RluG5ZzRES1Ury7RAD_YWeBxg9EJB2ZNnMXeMtJwhOWqGGwvfHWL2s_VvDIvaWc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6MqDIXx2QJ3l-jeT_gKqvxG1uUL-tJmt-OEa9D3gSgQ&oe=6A9429A7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0BxTd74S4oQ7kNvwHAW6IG&_nc_oc=AdrzJ7KfSQSAeYxCrn8-o-srLfhX9-YvRuc66WAjKG4pbzn-fGLMV84j2sxfktDDAPE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJqztMFfNo2oUWHZrm0BUUM8boA4ZchCmBvrdHpl4B7A&oe=6A942084"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrDuqcT38PgQ7kNvwF-Ob7Y&_nc_oc=AdqbdjTkel1iL-SVz1tBWy32jgT_obvp7JxxCN18fbfalc0aYN5s1loC2T9FBFCb7nI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLGxZOKGWJhYDBvwzgFqMGlrFoJdAoMmGG0M1cBo0Nxg&oe=6A94276E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgREpKAcvKwQ7kNvwG8-HlD&_nc_oc=AdpmCpVyj5uH07QcTRL7mUzXYGwLqSlr67DhWaoK85_z8DIgeh_3XejNbM8Y8NY1x9M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcT4SCYP6JMvJOAgcCKmf7BzDWwA2K9qjo2whbr6_2Rg&oe=6A943153"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1MLSd4bm7gQ7kNvwFNr8bl&_nc_oc=AdqJ6hV2btJ7wcW3HGdYCUX_mCDo_gRqT_8ljS2Gjo-EeSyHWH9DzgHTUDMOEZ64IAs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaX4MmjnMb9FVdNX6O2YGDd2Jhl99Ibv33CXv-8zsndw&oe=6A942BA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
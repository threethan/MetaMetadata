 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlfryCHAxGQQ7kNvwHrqLbf&_nc_oc=AdrNRQ0xySyGFRzUiVByxlvv7FEk2oPRS4-NF4HUBBBaobT9p37qL-y0f8l0r7JUBks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz76s69LnVGTobCLx9hdRVIgeASK-AmmgFORjMZev1Jg&oe=6A8457A7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m_kni07jCEQ7kNvwHLfLB2&_nc_oc=AdpbzSJlsViACmgvhp_jtchVd4s5kPaviSof3MWMhnmc92RQlmrwDxLj368raU4QNa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5wxnXO0EqFwdA1NNuAkOFfv5nV0p_4dJqdM1Ka38iyw&oe=6A844E84"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZXVSYfOObIQ7kNvwERPdJB&_nc_oc=AdqvuQ0VJhtpywfFbUSl0JjfXruj7eJafFyy8eQwol9u_PtK0YqV00XAaE7DZO2_5HY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-lvy6Lpm5UAKUIUDGnRD9iFcQYM9_4HzwuXKrRoJhwg&oe=6A84556E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYaJjox8ojkQ7kNvwGTKxD3&_nc_oc=AdrE3FA4kNVWaKbzgmsoq0excr9YVDnIWorR0ScMq71W8vYFUUPAkZg4SoSJrMM0XyI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6eY8NRs2MIA8XJ8gGHjHzLlEQsIz2SRIRD6tAy1c-zw&oe=6A845F53"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZap_9dp1bUQ7kNvwGhpAYr&_nc_oc=AdrtD3JlrkrHa7MP30h_VyTHg6ui1LraP_Wtj2m-QZKiAQ53gH59HZoGSe8a_-qrqHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbk4-sLSZfyb0xfc6wp_J4x19S68l1CV6urVcH-frcDw&oe=6A8459A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
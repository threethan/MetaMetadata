 "id": "324169743635280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OxjCn069qYQ7kNvwEwTAiJ&_nc_oc=Adqolw7z36gkXg458BomRXRUoFbwXqs67gUhwX8gQgRJAITuefYGp0t-HaGWKEI09Bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9ifGRItF_ActbZvYqzxLGq0xBiPJd4CU0f-mZd-TJJg&oe=6AF5F0E7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRMCbcTYi6oQ7kNvwGX6Ch-&_nc_oc=AdoL5s7l2-UwwO_JA19zt47fhFPOfMXvNEWc56EM_6KInGRBgobHjiWMwjv4CEjR2XA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHSrXHQON9YB3I8E1S4oPwdDA6PYciboWy9yupRIZ30Q&oe=6AF5E7C4"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgF88FQY08YQ7kNvwG4_M2M&_nc_oc=AdrCEpvNobn49MtsK3nEbVxgxq3slq_0NI3NlEKdwFpFkbLLgRvQ9EdK2CIKVAEIC1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo7tQg2Gd-7NYICCO8CikAoR-ul2Jcil2mBRRiveYMIg&oe=6AF5EEAE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqmR9BfPl6QQ7kNvwEqUYo8&_nc_oc=AdoFliD3f6QhwBJR6nlgW6Po9Gk8h2nBHcP90iu805DGrxThr8i-pa8QlvFP3CJILrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3EcARX7dMdabgJd0IpaPVhqzBR63vlZ6AQMBVrQLZFQ&oe=6AF5C053"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRr8tuBZV30Q7kNvwE4_q8V&_nc_oc=AdrmA6f1L0ZNDB487SFnklfvH1dN3G_B-QdGbwH2hUdiePFYm6_CIb2kQI19IKbRPLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSHSfdbfTSsc7CPTEylUiiQSIEkZaWFV47kagh9V2oTA&oe=6AF5F2E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
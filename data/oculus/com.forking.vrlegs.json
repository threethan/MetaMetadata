 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eppaYrBasm8Q7kNvwFjFmTe&_nc_oc=Adp9c9LaSzhiLaqKGy7WxomAPTIRhjWBIztFAoxphD7NGO2D3QsfBiXqbMa6BkzLJME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYNDat65iPnJc20HClBS4W6ekQXgwcfHTRZ_9ABmOkyg&oe=6AA54D27"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-aBcT-v3T0Q7kNvwHsc57_&_nc_oc=Adpo5FmnAxJHrK-ub_YA3xbo3hfN6Vp1nU343IE7oJDclN1CyGsLazG-tGZt0RmRRsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEY9nAmVEr1_PdO2V2DmdRIUydxEuMA_pvPgCTn2lgKQ&oe=6AA54404"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU_srwcF2ekQ7kNvwFdrmo4&_nc_oc=AdrKeTCBGAccwnclYSq3WZKWjlJPBKVb108ZILAMzQH01dX6MxcHJoLofTgvAmhtNLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwgujmqjF-zwCO9yzydtpdI333sJnHLA75-qD58KLB5Q&oe=6AA54AEE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8AFsDl1gt0Q7kNvwFUAthU&_nc_oc=AdpzWL5GguDVeojjvfyuqS8SRaKI7l0bAuwGNcZJzYTajnMy8YX25xxLp_RuAfJFr6k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQc5urdsbrwkS9iia42L4INuRbDSUM88UorAVvFzyuDQ&oe=6AA554D3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ76zTPwY50Q7kNvwHfGikB&_nc_oc=Adp7-CfIgLAuESziMIo2525r0zHywOhPkmducOC15dmYVsGnuC3xCwZc4HmFOKCLbkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBCgjk6mLnsejbGDhmDIPKljAkAiTvAoxugVuWI34G7g&oe=6AA54F28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
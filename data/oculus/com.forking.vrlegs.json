 "id": "324169743635280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PeJAx_h_s0Q7kNvwEWSCnL&_nc_oc=AdpsxMCrFAGEf1AtD8Tz-VEQmbV8EspceulABS-jRx_ehn3LOEWL2zJ-AdffV-gOXtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmmY_8Y-y4iS74UVk7vXd-4791wKEK06CbMd-vz6pteQ&oe=6A7C6EA7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ha5Kh5kaxMUQ7kNvwENM4rk&_nc_oc=AdqPNAaZYxAEWxZbmnhR1G5-lnJITHODs_JMdDxHCexR-_BM31Lr99a88NGchNt5oUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmgN0ovjoF369NYpMJr0-2cK8BRc0W2X90TPdvFBFLcw&oe=6A7C6584"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHdGvvqfL18Q7kNvwFgKmoU&_nc_oc=AdpOnlOdQz2gPeE9o1a4SmEAg42C6ufReqC4mdmlYtcN6Gvlwl0frAr4RZ7CQ2YRuMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8Jrx23HGW-7p-N-kCo05XWVC-DlP7w2zPvSWC-t39Aw&oe=6A7C6C6E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y96ZfaqMBqUQ7kNvwHJNScq&_nc_oc=Adpth-YEOpVpY2tGLc8fdUgH3Oa8IHHGP2zRnLHnjxVXneQh-cuTfjbcS1NX-5iewaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2cyatxKayhBqmXE8aYaUYEr5aAhGseqR6edZ1H16KzQ&oe=6A7C7653"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqLPgY8RQw4Q7kNvwG5aeu3&_nc_oc=AdpuKdRb6imicHxeFwmWQCfyENs3wwCvd9JykBZBCmh4Vcs0NzFPaKz-i4X5ENyV56M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXrBdLbQmDUDjCbWynXVTEOVtB-gEvCe2DQDgJyrGAaQ&oe=6A7C70A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
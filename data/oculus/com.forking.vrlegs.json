 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUtkbVraq54Q7kNvwFkkkea&_nc_oc=AdpzrnRrMSYLGUZl6TpEVgtjJ07CXrFv8JquWFlKv3El3PT7Yv2nCr64iV2b3gI0wn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af858GPJ8Rjz6yTwEobMCwXhbTrT37capS0_AAFczuNrKg&oe=6A2AB1A7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzSba_slB_IQ7kNvwGOKzvH&_nc_oc=Adr4NCIZYV9U7eqSxp4tt-r5G9wcX6ylAHC_5Kl5J4uG_iyezBcvMeltoL_bVoHp8O0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y0etFv_gLBOAJJYcTEe3GfFMrJ3kc3777xBw_Sqi9ww&oe=6A2AE0C4"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a72rys_rEHoQ7kNvwFioox1&_nc_oc=AdpkRnw2jfyZT7hmyBjXqLJpnQTHAXEKqC9rdtldwf-RP0OONOg7uWgVPyfARgU8r4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hS44Ux-mxxXjLyKoeSZvXtuXmfHSGw7G7HnKzrYMv1A&oe=6A2AAF6E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ1uX0JwXlEQ7kNvwEGCHAP&_nc_oc=Adqs0mCVVicBwehBDhNH9dwQAOe1OL1PH19csln805CSO4xG2LMNF_qTknkGv0P4n4k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JnzDEc7pea80B89aUB68mz2S4gAJN6TyOrf4SFcWa_w&oe=6A2AB953"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou9Iuv8qw3oQ7kNvwHroE-Q&_nc_oc=AdpUkiuBcK1W-t9NoUMJa5f0AswFfPlz557q2aBc9oqzDDeHyGnFquuaFRsIwRFEc0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mf8C13E3O1i6kdhh1H0qN2Lv5FXSE9Ie2M1EUK03u-A&oe=6A2AB3A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
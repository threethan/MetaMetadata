 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKI_gjq7zB0Q7kNvwEs5dsZ&_nc_oc=AdrvHiGLKQcuXL5mM3LYz4oErHWxsmtHb82qazoj9E6EnOlmwh14perxGp_obJlZYPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2eH43AF8wd1ViciQg8LAOSKCFcFWqc1ATS0PrLl7AuQ&oe=6ACD1267"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxI9sNgw014Q7kNvwF25Ksc&_nc_oc=Adp6mmUcHuQL3iX_O9aXZPOs6vrFvPwVBoNDa6nCG4vKyyf0ub3MNPGtIRStQC7YwqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeRRaaonOLaTQ31-B0E2PE6rhFvRlW2aMp0wZa-yweXg&oe=6ACD0944"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAwj2nQsFT0Q7kNvwFHH_hb&_nc_oc=AdpUyostLnPWJ6toMj0KzG9Vp2ghf1_lAORpBuVT8X138yAetnkFxvvhDMtoHp2o5MA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-SmndOmxLzbY_y0fJgedjPWAhvSVL_1PJuSKvhbtpbg&oe=6ACD102E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-sLaI78FZ4Q7kNvwFPZGGm&_nc_oc=Adpz4k4K7doSwGJdeB1T8lJ4J3f9nDks3XJzkhXuziuTtOriKs-eAoZcOENfZM-MCZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObFD9PItMHMWSeHujnsgaj_92mDqUJpIBnG2dDP8_Ogg&oe=6ACCE1D3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkqtUDYt7GsQ7kNvwEZ18Xq&_nc_oc=AdoPKmzK7eDR_3YhlubvP-C3IUDZWMzUPlSioZMfsxwj8T8ETkrSCM_XXQTIMPqWV3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX-oAfuGSFKl5peQyh4aVKaKKi-TE3G9bqscEtHBwVCg&oe=6ACD1468"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
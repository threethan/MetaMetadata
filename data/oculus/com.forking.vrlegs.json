 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD3TbCLwoIkQ7kNvwGeziM0&_nc_oc=Adq1kBjtcwdIfLMipfUCfY7FX121HKb2sLgZNH_aRi0eredmPlqBYvEooGUeNa5D8Lc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZHv58EpiP1FcDIxgpN2U0zyPsSu2ZyKfrj5HYMT5GCw&oe=6A280EA7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbGp26HxwVEQ7kNvwEe501o&_nc_oc=AdpT3gNiSzM8dsN50T12kghl55dIpehA8GwtOGFJvPZBBtY7ClstRKIZ06U-ZdEwtS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6s9QqsDuq8OCrV_gjPEtt0FDvGTtVQF2-E0jLjUB6Hg&oe=6A280584"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPWCcEQk7NAQ7kNvwFEJMGs&_nc_oc=Adq6QnWcGwjKYyJV7362NZgq-ngLO8GNWuNmunIYtXATBQcOD-c6RvWduF1mHkCFIHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IyR91VzIj1S74WyJ_sfeX36SB20q0PF2Sp1Lb1cnZSA&oe=6A280C6E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ1uX0JwXlEQ7kNvwHW13F_&_nc_oc=Adq8NGqkbP2of3SyW6DoqB5nsJS_yv9ZNnr9wbwkJzn_EYsJu9Q3vBXhrEPjZB08lTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q962ANH7H363swLCgV3BRDS0Oi2x2HcUj-O8Gqa5VEQ&oe=6A281653"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5orC9__XRsQ7kNvwH3YQ1s&_nc_oc=AdpPlSfXX4E1S9OjiOIl-ZkFLbK_73BIintFohO40Yjzaw_t7ovre15UhBXJXyTvWsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iGr02yXUixai7d3k6fBCSH_Es-cK5F8-4m7uYW7hEXw&oe=6A2810A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
 "id": "324169743635280", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHRdZVMa5-sQ7kNvwH3AcHV&_nc_oc=AdpF5VYwf8vx3Y67jfrTxubC_DWjbcIWqlQRSqCt4VP4De0y9GOEECeVRWiKRtK5Vys&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM77qsqKTJVrLycZR-t6DY9AtDiJeEXNbB1wgHv-v5aoQ&oe=6AD106E7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgDUSNJVTioQ7kNvwH_NoWt&_nc_oc=AdoT1xcxjJrTlHzjLY23LsPvPTvFoi2HyCipYyD6ThwRYAPRWk4sNmmI5omj3ZeOv4U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0JyXoi5GYRPHWIIWuFs_JVhX8mcUW72xhhEGn-7pxJg&oe=6AD0FDC4"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u402K7_R5NcQ7kNvwHjZufh&_nc_oc=AdoIU1xjT8pdSA1vWsj4gx9EvktLQP5CQ0kJIpkMgeCtCfwjYyYrKzL0Jl8--uIs3bI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx1nftSwJKbaG_WKmiWzXP4hgoMVe60Q5zfaWEuPHfxw&oe=6AD104AE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbRNofRf6_EQ7kNvwHYsGqz&_nc_oc=AdohvniktUeT0sW6ReKtcKAXT21alPBX3QmaxTjxMUNZQMX702TrfSTMZOEJFelEd-U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjtpLy4jO5u9RfaUZTfNVZGSu_ecg3jsDuo1Y3vY8Iyg&oe=6AD0D653"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9eZKHKyg7oQ7kNvwHGOTJQ&_nc_oc=AdoqaMB7iy3bQ0XCATyPMzatuxzQO5Z0P15WCmCXIIvJ8pzVjL-JiSKZ9zdCuzWEjIM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI1GJu5d4X2m5RahtadhadsSWQmIMiO5_sMJDZ5FRHaw&oe=6AD0D0A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
 "id": "324169743635280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gk2y_SsGxgMQ7kNvwF7qL5M&_nc_oc=Adp2D91jraazRBokj28a953U5pKm_s5gxxenDXdyevCToVdPXuhDbTe2zXQeyzEykoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyzub3KUNMDlzHrQNnB2-f-Je10ckGBlB9prWC8s8BRw&oe=6A899DA7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QN99QjA3LkEQ7kNvwF7CUNF&_nc_oc=AdqIR4HymsK4IvY0VVpgsw5hzunFAgRLT1Oz1dZgK9VUF0IKhseqzg44TqA_h9kE_YM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYQ3M53aqKSXJ_wPg1ZsLj0uF8BPyWWN87Y_tg5G38kA&oe=6A899484"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQW1v_Xy8jkQ7kNvwEsr8FZ&_nc_oc=AdrYfGPuqM5sIpeI524kkZCaw9foukIPoIPin8Wsvkx_4Gi4QS3oP9mhUlfl6bdrBfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvMwX8suLXUVxvy7aJW6UngTypSjelgzUyD2fNauZNbw&oe=6A899B6E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bHPIlKVf3kQ7kNvwGIdiei&_nc_oc=Adp-v5SCKjp1fJn0tAu2Ec6ReL8DUpDGsE-WJeaXlLtmsOXy-b5usEL2Gbfug1G1GRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGApxRcTfvlnQHhAHsSfl6VSDIiGHBAHZptaDUux4BueA&oe=6A89A553"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnL7pcC1FUYQ7kNvwH3nUKr&_nc_oc=AdrV06yILUt7_PIpavz00gs14HBFrtl_nxt-6ir7ksGT6NwG2hBK-Xs7_mdphnNEWbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx9AQTttHw5QoWGf3PtOiHJxfFCRleaw3CkTrAG_sVjg&oe=6A899FA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
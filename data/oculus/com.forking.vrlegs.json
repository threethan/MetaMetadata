 "id": "324169743635280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9nj8sizfwQQ7kNvwGwZrqu&_nc_oc=AdqNflkEyKXeKWe4gF7qaiJxzD6iIAAxJL7NFWo7W6KeZbBktnoENpe4UiN8K0w3__0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToUzlxP_q2iC-paacTFxhhoCBEODJeNN01S627nnLTVQ&oe=6AEA1367"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6euX5jiJXwQ7kNvwE1omWQ&_nc_oc=Adoe2q9VntpsrDJ4p4V1d1bdcq_KqyDF92IT_4tAHdEn_rETx3FeIlbkIYei5i-WpZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0RggpbYwAOTzLpf1nnRAI6aLvVkillJclcj-sMGnJdg&oe=6AEA0A44"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhEFH0bKdy0Q7kNvwHBqjw-&_nc_oc=Adq8PjULWSn0NLbjRR9x-aFThH_MBULmXee-nqHVRc0BpOkyEw_MC9qNjLxPUMnk1UE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6wm5fSt_GD0AmjK1eyONJ74AIc3KkdCJogpjpInWzKg&oe=6AEA112E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0djtWULi9IQ7kNvwHFoP2e&_nc_oc=AdrPNHfuNvp9rGS2JIGYvsXeQFCC-vphq_BuKdvWEq4et3hUJ4-GBC3t1CdWkCv4nYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwhkKey1SpkNSg05hKJ8XHkpAom7Mi81U0HLomXlGIww&oe=6AE9E2D3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFA76OmDAmgQ7kNvwHFvTgO&_nc_oc=Adpdp_L1ACPYuJJwOA_2tCIBZ1ZvYiSdQn70dfkJifZ6av0Dzcq6Qw7jub_HouWG2_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTADmQr-QIK8yE7Nu6BEzHFtVTsNXb0XEgjQc2ibSphog&oe=6AE9DD28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
 "id": "324169743635280", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEL-dO3M2cIQ7kNvwGkGoUa&_nc_oc=AdpOsA3VUSloHJzdijwBHYpaaa_ZIs5g2DDhufp2z2pdVNF-ZLAyBiPvL3FVzeCVYI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vU3a02K7mgv8CGQFKsWd1N3LDZXiLtVEI-j8lpuaflQ&oe=6A450FA7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3lT-R6vV4QQ7kNvwHRuxnh&_nc_oc=AdrdDYPU8ZSFBoWfDsQfU_pKx3jNUpheQPT82pGAwz1nd6pa1bTWqS6nIzgFZny-Bwo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aNUwXUJ74Lpn6TdLGe-OCBdMuCNDYoE_-G_OxutRIFg&oe=6A450684"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbd5jEakGIsQ7kNvwHklbgW&_nc_oc=AdrnyJNrC9mGMqIP4qby5zx5AAXlQp5R56eZDb8UDS6k5xkI7vtVtSrjYh_wjWKjpwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hYlcjs2suwHnQle5rfMjXyCg0c5JnLfzSF9_iWJurbw&oe=6A450D6E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW3tWz32Vd8Q7kNvwFvchA1&_nc_oc=AdqT8WizI5z9PTt38FumMjqFJ_k74QV0g-yQgzzvLUEKdKUE1pxm06PU6c7lA9gxc7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97Mqj3a4DbG_QflVgI0z8fxHDF3jRex1yxRaHevXFnfw&oe=6A451753"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSR0MnWINLgQ7kNvwGpq4c0&_nc_oc=Adr-rMhot-QCCDtFe3zGtb6vGp9mLmTbLrps4S_j4srkxhMb-TFdzXLMKm3uXeGWldU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mG-ior7x-ZpssIt0RbQLK3_RfXrOlMp-S7-hbaGu0DQ&oe=6A4511A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
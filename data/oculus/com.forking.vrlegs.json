 "id": "324169743635280", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfkW4hidtuEQ7kNvwHmDHnI&_nc_oc=AdrqXMy937qMUl9AJOMNHY_OLq9gaU7gbtq9UYn9p6sOXxwCXiR4hy1L0zB2-gMs8IA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb5-RbaRf8_7w_2K6xBiWgq14XYwH_Dm6iaK9_T0C9Mg&oe=6A973D27"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EC53Lf2pycQ7kNvwGpJaPa&_nc_oc=AdrVr1xypp4p2nW1JkTC77G0-j_pLtOMKiZTg5UjvC7dztvjxXweEPWJwXj0_yGEzx8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcO7ee7YynC1xWOOzdoIODd-tKHSQPJD4CGwlSRc9afw&oe=6A973404"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhbCJnrP424Q7kNvwGsrgqu&_nc_oc=AdpihcAnnFIZkAm5TTqoCL40_JOdOTV2j7wtIMqY7lFtZZq-zsxhEa6dZHtbWGU--bY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSK90VCCwsAfFH_nkYdsb8zsUFhLrCz1wzslaAX5SmlQ&oe=6A973AEE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQGR-cE2bIMQ7kNvwFQtURs&_nc_oc=AdotFQb1qpcycB9UtXicb4qTBq3EtlWpsUWkthWSegLW3pkU7eObQOH7PKMJnY8ezMk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4j3KskO9wh9Imw7akB_JHPr-7aT3-0H9aUwQUZqO_MA&oe=6A9744D3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myk-du-KxFQQ7kNvwGQhU1M&_nc_oc=AdqZJ79ohu7Xke5geUu6QWYs4SzRGwBK00nQyF-TpyyoyEFWCOWJLwp8cGS5RO9lLX0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhBCocZsUuWR2gXXmuvd8P7fVEhd5buyK7vdxWnLynig&oe=6A973F28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
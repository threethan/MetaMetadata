 "id": "324169743635280", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbjVyvf9pOQQ7kNvwG8N9he&_nc_oc=AdqDSh4nbiqCGDl0Mx-YmnJWRWnSJaI4AxTnqAu-MLFMhnhYQtL1fL-8xHuu2H22tXw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHy0AwDl0cb9TlisUYrvRHhnSWi_YyU58F6gaY1zV8sg&oe=6AA00727"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sg0rDupvVo8Q7kNvwHBFpAS&_nc_oc=AdqFAqzAdUW-SeYPEVvD53KAUfby-tXysJA-no-0o8cyg_Q1p3RZnz6BpxXzXhLyHVI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3YJqaFvMFheu9UMhQkUbtYSW8K37Gje0QQBaZ4SHKPg&oe=6A9FFE04"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXMOmrPJSOgQ7kNvwHYBCMq&_nc_oc=AdrJ0qFrW4aGKuGMcVR0EwRwZTAVEvdL_Km7Hort5kWSJ6S2_4tFcJTId4y5JHsYRA4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY2IZlV30-UZlXoiEfrmHeb5MRmHxsOl2DRHT8x7Tc4w&oe=6AA004EE"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CggU9Nq1ZcQ7kNvwEWPSGj&_nc_oc=AdpBRDSnBgjtn0OSjLCjl-G2LuJ9lV9TWGBYsWnpfe7sr_WniOZo2HgCGblgprWqgxk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKigLBF00cMoTymmVwn3500p7ef_F1G_YnbirjtXiRfnw&oe=6AA00ED3"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=di8OHUi7kQoQ7kNvwEU85RA&_nc_oc=Adpw43EyHM6Kd364WRpv76WsP4zxM0aAHoJpQBbXbk84SsEW7sFLs457ZAo-oa_fdXc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzbuwhLfpvFE3KNbCGnew_UlvK6j62ivqIf6Gy9qTPEQ&oe=6AA00928"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
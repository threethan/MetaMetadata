 "id": "324169743635280", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86620220_324169746968613_7117931673492806532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbjVyvf9pOQQ7kNvwG3EtBA&_nc_oc=AdqLITmqMM6dU9_IB6bs5R4fmCTM7tce2FdUOPZviqqUzIstQsKhlH2MXezVfX2xsMA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfu9xOZJHdFt1adRFe5yMB-llFwHRCfM7YycN-BIvQtQ&oe=6AA158A7"}, {"file_name": "Landscape.png", "id": "284554587659447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974709_284554590992780_5763669827891232699_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGQd6AWXOSEQ7kNvwETg1LZ&_nc_oc=AdqWehXAmdVWUP2q2sHs8kZ0aZVeVDJ5cenEPRUrpT4J0JuJiP9KVrPxGdhK1WHAzTg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQQznA7fx3kJb7dTLXevHGlhqKGfhU6or7DX6H78vEwg&oe=6AA14F84"}, {"file_name": "Landscape.png", "id": "677824147318518", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/54823267_677824150651851_3688777864047447478_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK81Rqtvzz8Q7kNvwEeMTRk&_nc_oc=Adrse52K0C5rRx_UpairtwmTXKKxaq8Cz34uJeUgSLC5C2Sj0Sh6CqmrHyDydYLBJFg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJst8TKRg-9Ycux6FahMccinSubzO9rbVLoMHo9AwdPuA&oe=6AA1566E"}, {"file_name": "Landscape.png", "id": "329704216222612", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75250460_329704219555945_6993099148500521476_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CggU9Nq1ZcQ7kNvwFBoXPC&_nc_oc=AdpRsbU71VOB8D1lQSksRJXpegLk1K1rRzEVxKyKIXo-ZkuauogTVt2xPfwUfUeYSr0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxACnW9_NUTmTWmEat7dUd_60LMQOlVKLVnrHtoURMqg&oe=6AA16053"}, {"file_name": "Landscape.png", "id": "627211022861814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031653_627211026195147_859210511188470322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qph3CPGzO1AQ7kNvwEULk4z&_nc_oc=AdoI-3Dw7-f004XJGEr-RJsxUZXqLeAmaLJ-Q5m33_7bAPyEB5u8uETCA5t61ksvhuw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_IiBZ_BIhEOfum3nChaz05rS3pscQNnBCgtT9AF4mlQ&oe=6AA15AA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRLegs", "keywords": [], "long_description": "Welcome to \"VRLegs\", where the thrill of parkour meets the immersive world of virtual reality. Step into a realm where your movements are fluid, intuitive, and empowering. Our state-of-the-art locomotion system redefines how you move, jump, and traverse in the VR space, offering an unparalleled sensation of freedom.\n\nChallenge friends or team up in heart-pounding multiplayer tag matches. Navigate complex terrains, leap across buildings, and experience the exhilaration of real-time chases. As you master your environment, you'll discover new strategies, shortcuts, and moves to stay one step ahead or elude capture.\n\nWhether you're a parkour enthusiast or new to the world of VR, \"VRLegs\" promises an adrenaline-pumping experience like no other. Join the revolution, find your rhythm, and let the chase begin!", "short_description": "Unleash parkour prowess in \"VRLegs\"! Dive into multiplayer tag, powered by a groundbreaking VR locomotion system. Feel the rush!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrlegs.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ForkingVR", "support_website_url": null, "website_url": "https://vrlegs.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
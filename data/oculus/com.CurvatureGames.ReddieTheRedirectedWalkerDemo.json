.com/v/t64.5771-25/57575363_692706158434842_3848831456700693944_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olxIUVIYH7oQ7kNvwFMvunm&_nc_oc=AdqfLqx_gBF_kW_GzMPMUYBG9YvAzRcMUxkOhZYn8r5-09PHdX0FDe1kIQbcZvgUQm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDn4qzoHKlGU-3nxIrPoqvVawJk4bNJgQdmyIWkCiGVw&oe=6AF73697"}, {"file_name": "Exp01.png", "id": "992477658715870", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236133_992477662049203_915703585734935503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIaf2uu7mfAQ7kNvwFqEzvk&_nc_oc=Adp23nvdOgCLml3K4NkyAP0m9ulirqMJ72dlgCbECY7O__9pyQAa6g5HwqVa-WMrcpE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRut2UWKX1LoNO5tc1LUx3OKjI_tBaHGOrzQ1hAPlGsCQ&oe=6AF74B11"}, {"file_name": "HandsRoom.png", "id": "362088040218456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_362088043551789_4839502739932527712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEadkQHAsqwQ7kNvwHW3jhq&_nc_oc=Adp14-03uDl8f5oM3fRnL2QJgLMSj_c4IUb0FddMk6SxZgAdZllfdV11t5gaXz_7bRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9CqlVXkPv0GdbCugMeHCBQ36-XUxQdKozLGeG19An_A&oe=6AF72C44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Reddie_WebBanner_2560x1440.png", "id": "867147411855690", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974570_867147415189023_456499109819350697_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXOyzemevgsQ7kNvwEg8WRr&_nc_oc=AdqC0IOdIdPIzOGsgqTQp7rZmY7DL3cl8V-jo1Vz20hZ5pABIeff1aWstjQOGPi1q8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcX1GjB9mBhVsxEaxtIibvOTxlDKTEvWkBkc-pvQftEw&oe=6AF71F6C"}, "display_name": "Reddie: Re-Run of Reality: Demo 02", "keywords": [], "long_description": "# NEW MIXED REALITY DEMO!\n\nBEST TECHNOLOGY AWARD\ud83c\udfc6 XRC: NEXT REALITY CONTEST \ud83c\udfc6\n\nFrom the Studio Scientists at Curvature Games Revolutionizing VR locomotion and the muddled minds behind the Cult VR hit Elevator... To The Moon!\n\nComes a greatly expanded 20 min (Or more if you can't work it out) Virtual Reality, Mixed Reality, Walking Simulator (with real walking) sci-fi educational film, existential crisis, hybrid puzzler.\n\nEnjoy having your mind blown (metaphorically of course) as you travel in and out of mixed and virtual reality in a quest, on a quest for a greater purpose.\n\nOur Love letter to GameCity Hamburg and the XR community.\n\n\u2764\ufe0f Curvature Games\n\n\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\ud83d\udeb6\u200d\u2642\ufe0f\ud83d\udd34\n\n# IMPORTANT INFORMATION FOR CLEVER PEOPLE\n\nPlease ensure you have a 2X2 meter room scale playspace before starting. If the scene goes dark it means you have put your head inside a wall - normally impossible without hurting yourself - or have left the designated play area (naughty).\n\n**Please note: this is a a proof-of-concept for a larger VR game** \n\nIt is, what they call in the industry a vertical slice (not to be be confused with a powerful fencing technique or interesting pizza cutting specialty) \n\nWe are releasing it to you in a \u201cplayable\u201d state and you may encounter some bugs along the way. However you could also just be stuck. Our only hint is you use your head to complete the experience, or better yet\u2026 someone else's.\n", "short_description": "NEW DEMO! MIXED REALITY!\n\nExperiment 2! \nYou may be surprised as we have HUGELY expanded this Award Winning experiment now we not only explore a virtual environment, but perhaps your own environment as well.\n\nThis now 20 minute experiment (Or infinite, if you cannot wrap your head ((or a head (((Or a Reddie around it))) )) ) multiplies your 2x2 meter tracking space several times over. We take a human being test subject (YOU) through a wondrous test environment using the power of REDIRECTION. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://curvaturegames.com/footer/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Curvature Games", "support_website_url": null, "website_url": "https://curvaturegames.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7593792224040245"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75367593_1124981751918415_6698643176074759093_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_9hS-RDhnYQ7kNvwEIJgeI&_nc_oc=AdoRfvjVITKPDeUiYIZ3i4LRvaI3o6avfDFSzYVM-YWnovACbBB1i6RUP_6qmrzrfR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfuk6ynCDMvs4erNIqfcuRjElIIQG5XlOUWfmejmYNOA&oe=6AF71A03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Reddie: Re-Run of Reality: Demo 02", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAME
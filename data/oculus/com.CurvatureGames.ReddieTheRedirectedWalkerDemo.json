 mind with my answer \u201cA cutting edge locomotion technique that allows you to move and walk as freely as you would in reality\u2026.  in Virtual Reality\u201d\n\nThis 5 minute experiment multiplies your 2x2 meter tracking space several times over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://curvaturegames.com/privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "Curvature Games", "support_website_url": null, "website_url": "https://curvaturegames.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "533939204735612"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2194964677319846"}]}, "baseline_offer": {"id": "2194964677319846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649752800, "status": "PUBLISHED", "id": "2194964677319846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7743940399025426", "version": "0.1.32"}, "id": "271602838470811", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4887759827976845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", 
R6Ik_v9FFN9EbENp9zIW1fRYAFWFHbE7x5m-pMDfg&oe=6A2C1888"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "keyart2560x1440V2.png", "id": "1363632130734323", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974821_1363632134067656_4009014843547301982_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa-RUvYlRI4Q7kNvwExKdOe&_nc_oc=Adr1RG46urCcpUlAt1SnnC4fBFVyIbvmbJ2HZW9DHO7td3FzEwVKl5XN-ssw7G21REE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iHJTNkR5Jv-Hw1ZmCqgzf9to4HptqmNqTi9JtX8mt5A&oe=6A2BFFD8"}, "display_name": "Reddie", "keywords": [], "long_description": "EXPERIMENT 01\n\nThis 5 minute experiment multiplies your 2x2 meter tracking space several times over.\n\nWe take a Human being test subject: YOU Through a wondrous test environment using the power of REDIRECTION. You may or may not be asking \u201cWhat is REDIRECTION?\u201d I may or may not have read your mind with my answer \u201cA cutting edge locomotion technique that allows you to move and walk as freely as you would in reality\u2026. in Virtual Reality\u201d\n\nWe have prepared a mind altering experience that will demonstrate how we can extend a playspace with no teleportation or stick movement. You will explore a space naturally and it is probable your mind will be blown open like a cantaloupe (metaphorically)\n\n-IMPORTANT INFORMATION FOR CLEVER PEOPLE-\n\nPlease ensure you have 2X2 meter roomscale playspace before starting.\n\nIf the scene goes dark it means you have put your head inside a wall (Normally impossible without hurting yourself) or have left the designated play area (naughty)\n\nPlease enjoy yourself", "short_description": "Experiment 01\n\nWe take a Human being test subject: YOU \nThrough a wondrous test environment using the power of REDIRECTION.\nYou may or may not be asking \u201cWhat is REDIRECTION?\u201d\nI may or may not have read your mind with my answer \u201cA cutting edge locomotion technique that allows you to move and walk as freely as you would in reality\u2026.  in Virtual Reality\u201d\n\nThis 5 minute experiment multiplies your 2x2 meter tracking space several times over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://curvaturegames.com/privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "Curvature Games", "support_website_url": null, "website_url": "https://curvaturegames.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "533939204735612"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2194964677319846"}]}, "baseline_offer": {"id": "2194964677319846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649752800, "status": "PUBLISHED", "id": "2194964677319846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7743940399025426", "version": "0.1.32"}, "id": "271602838470811", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4887759827976845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7743940399025426"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"ch
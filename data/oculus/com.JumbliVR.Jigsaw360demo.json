&oh=00_AQSMyPHad23_u_L1H7ce9kacekNhjIiKe1soMlSCVZ9YAg&oe=6AFB4412"}, {"file_name": "migrated_image.png", "id": "137298767720623", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572928_2983841678326576_5985576198774718464_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQH6mNPnzYoQ7kNvwGWSZE9&_nc_oc=Adr7C6QcAAxuduSIMJFzAH8DO9pyNj4lMPl5MOMdlnek3x7DaqK7nNCLrtY81bAo85s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBHJ_1Xo2MU9CcQvHnh4XcULLFrX5RciKG3A0Z8IKBsg&oe=6AFB23EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jigsaw 360 Demo", "keywords": ["free", "demo"], "long_description": "Relax while completing beautifully detailed spherical jigsaws. The new way to experience a traditional puzzle. \n\nDemo includes two scenes with both spherical and flat jigsaws to try.\n\nFind yourself stood inside the jigsaw. Use your controllers to precisely place your pieces as you build the spherical puzzle. Rotate the jigsaw and scene to see it from different angles. Traditional flat jigsaws are also included.\n\n***What to expect***\nBe relaxed by the music\nCalmed by the sounds of nature, rain or waves (headphones recommended)\nGrab and manipulate pieces with ease\n\nFull version includes 10 scenes plus the ability to add your own photos and a choice of between 8 and 162 piece jigsaws.", "short_description": "Relax while completing beautifully detailed spherical jigsaws. The new way to experience a traditional puzzle. Demo includes two scenes with both spherical and flat jigsaws to try."}]}, "developer_name": "Head Start Design", "developer_privacy_policy_url": "http://www.jumblivr.com/privacy/", "developer_terms_of_service_url": "http://www.jumblivr.com/terms/", "publisher_name": "Head Start Design", "support_website_url": "http://www.jumblivr.com/", "website_url": "http://www.jumblivr.com/519_jigsaw_360/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "c
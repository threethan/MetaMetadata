": "migrated_image.png", "id": "814435499059488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75556795_722573121602268_2439440449446871040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcIc2kviz10Q7kNvwHl6khi&_nc_oc=AdnXpRYtprc6ZWPVb0QLu5vBHDrbwRUhJ69jnuPxLve5HVvZVMfgvHSjr93C2_PTx5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLItib4-4P8jN-F1x-xkCrA42okJV0eaTCqEJi4mcpWw&oe=69B2CD7F"}, {"file_name": "migrated_image.png", "id": "611328609422308", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031399_1435821183245152_3665174268334833664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HkrkT5hBjcQ7kNvwGQf0Wd&_nc_oc=AdnWLEffzcMixibF9p8JGCXT0JPRK8Sr79U47qcCuvV-GyvhTQM4KxWHVVQ9591LzpU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRiD3HqT9pY6bN7ejpGsUVk16dG3Vr54LGlVlvsQXhLQ&oe=69B2AB94"}, {"file_name": "migrated_image.png", "id": "204906770729817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982556_1480853892091762_2567871409095180288_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug79Tn-5rvYQ7kNvwGoyjE4&_nc_oc=Adm-cu11HgZGiP2WM8wsNuCmJoRD93qs48hJIkP_EEE0kRcbbMvn3vGQJimKdc-GFZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwlviv0n080nf3_gjje9fm6T3tlbB7k39UQKnOslACxKg&oe=69B2BAC8"}, {"file_name": "migrated_image.png", "id": "197898624964196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75485579_560409358148798_4511889940748959744_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pssawm-l2voQ7kNvwGemxBL&_nc_oc=AdlvhWzqsNhlfn-aqgrk89GYUFDkzscDo3-0989h9Lodubk_i380uR4l_jVCBBzCyRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxeSmXdl8iHpb9bsXjxy0e4PkvxvTymmhVNkslQtryDOw&oe=69B2C652"}, {"file_name": "migrated_image.png", "id": "137298767720623", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572928_2983841678326576_5985576198774718464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=119_xBEZCDoQ7kNvwHP18oa&_nc_oc=AdkMff3zHHSbeHaakVlURkJRSk0VCyLG_kpaWOmgV-JXlYkHqc51naDp_XOGTeqnXRo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy3vw3UKmONSctYaUq1usdxnb3-y8BmEovHANQqkT0P3A&oe=69B2A62F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jigsaw 360 Demo", "keywords": ["free", "demo"], "long_description": "Relax while completing beautifully detailed spherical jigsaws. The new way to experience a traditional puzzle. \n\nDemo includes two scenes with both spherical and flat jigsaws to try.\n\nFind yourself stood inside the jigsaw. Use your controllers to precisely place your pieces as you build the spherical puzzle. Rotate the jigsaw and scene to see it from different angles. Traditional flat jigsaws are also included.\n\n***What to expect***\nBe relaxed by the music\nCalmed by the sounds of nature, rain or waves (headphones recommended)\nGrab and manipulate pieces with ease\n\nFull version includes 10 scenes plus the ability to add your own photos and a choice of between 8 and 162 piece jigsaws.", "short_description": "Relax while completing beautifully detailed spherical jigsaws. The new way to experience a traditional puzzle. Demo includes two scenes with both spherical and flat jigsaws to try."}]}, "developer_name": "Head Start Design", "developer_privacy_policy_url": "http://www.jumblivr.com/privacy/", "developer_terms_of_service_url": "http://www.jumblivr.com/terms/", "publisher_name": "Head Start Design", "support_website_url": "http://www.jumblivr.com/", "website_url": "http://www.jumblivr.com/519_jigsaw_360/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
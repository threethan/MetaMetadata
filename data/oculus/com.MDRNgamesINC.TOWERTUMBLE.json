4074784655101_9009019294281346842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIbraHZCxicQ7kNvwGvc_YP&_nc_oc=Admpza4E_woPSiC41F-MkqfdBrBtZEFfltgFkSLouMJzqSShM4NYpU0HYHQCD2xhjwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-UVE9KW-qfDdgkR_3cAJg3HiJfD5l4pQrtMdN3bQGZw&oe=69AD7F1E"}, {"file_name": "ttumblescreen4.png", "id": "962077512796578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_962077516129911_7604590174041344366_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKzgoLhRsX0Q7kNvwEjBVMv&_nc_oc=AdnT3SZAhtdRWTBqrBOsyAyzlQpnlXuXVjFh6jQqWk8RTi-H-xt1Eov_BmUDSU2ED0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxfi6MMHf_lJtBlbbdNtETyaiewYUhQTFwl9oLOhaWtHA&oe=69AD5898"}, {"file_name": "ttumblescreen5.png", "id": "1164643554982200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391952_1164643558315533_1763938509532410487_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4rPBjt7GT0Q7kNvwH-89kg&_nc_oc=AdkzoWeLRZdtPj0_8UCvSBXWTRdO_pDaTSZR_vcmmOSbTjICm0Gb4466oeKWzkfzj-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBCLOX8mJsWSUuyOmxyghqpWcZrZ-HGU9dWSywjW05eA&oe=69AD8513"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TOWER TUMBLE (Early Access)", "keywords": ["jenga", "block", "tower", "tumble", "stack"], "long_description": "Tower Tumble is a physics-first multiplayer block-stacking game where balance, tension, and timing collide.\nBuilt with deep attention to physical realism using the Havok Physics engine, every block interaction feels dynamic, weighty, and unpredictable. Challenge friends or strangers online in a simple-to-learn, hard-to-master game where the smallest move can mean total collapse. Strategically pull and stack bricks, use special power-ups, and adapt to wobbling chaos in solo or multiplayer. With every match procedurally generated and physics-powered, no two towers tumble the same.", "short_description": "Stack, slide, and survive in Tower Tumble! Build the ultimate block tower, pull pieces without causing collapse, and challenge friends or chaos in solo mode. With power-ups and unpredictable physics, every move counts in this high-stakes balance game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgames INC", "support_website_url": null, "website_url": "https://www.mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "1700921480735423"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "28869644152679503"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1215730107032248"}, {"status": "PUBLISHED", "id": "1786449425577139"}, {"status": "PUBLISHED", "id": "1233660918421606"}, {"status": "CANCELLED", "id": "1604728450212416"}, {"status": "PUBLISHED", "id": "687077373858978"}]}, "baseline_offer": {"id": "1215730107032248"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758734880, "status": "PUBLISHED", "id": "1215730107032248"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31282737771370117", "version": "Z"}, "id": "645993321485939", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false
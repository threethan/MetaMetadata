4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYOiAMl_Dar8cFChFKSgdQ2_xZCjmoPlHRgHHccSgO3Q&oe=6A8AE465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VoxelInteriorMR_StoreVideo_Meta - frame at 0m57s.png", "id": "1377386177058260", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619680_1377386180391593_7582846852580148437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cwmSkLcfSsQ7kNvwEBbmr5&_nc_oc=Ado9o7HNwcms6UjcUngPIOjUXMD3X-lyZYo39wkCW5flnq_z93RL-rV8vx132WI3AxM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOfGuy5Cpyl6TDnl5enI-RoBcj2AtKljzJrx-RP9OTew&oe=6A8AE74C"}, "display_name": "VoxelInteriorMR", "keywords": ["MR", "Voxel"], "long_description": "\u201cVoxel Interior MR\u201d turns your room into an infinite creative canvas.\n\nThis MR interior design app lets you create your own unique furniture and accessories using intuitive voxel art and decorate your actual room with them.\nYou can freely adjust the position, orientation, and size of the objects you create. Without worrying about physical space or budget, you can bring your ideal virtual interior to life right on the spot.\n\nExperience the joy of creating and the excitement of redecorating right in your own room.\n\nTo use the app, press the A, B, X, or Y button to display the menu, then use the trigger to view \u201cHELP.\u201d", "short_description": "\u201cVoxel Interior MR\u201d turns your room into an infinite creative canvas.\n\nThis MR interior design app lets you create your own unique furniture and accessories using intuitive voxel art and decorate your actual room with them.\nYou can freely adjust the position, orientation, and size of the objects you create. Without worrying about physical space or budget, you can bring your ideal virtual interior to life right on the spot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ho-lo.jp/privacy-policy/", "developer_terms_of_service_url": null, "publ
8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6w6KwaT1XC808UPMk4yeo8OD2mevueff0eohDKQUT-w&oe=6A9C4025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VoxelInteriorMR_StoreVideo_Meta - frame at 0m57s.png", "id": "1377386177058260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619680_1377386180391593_7582846852580148437_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQacF9Qma18Q7kNvwHpcOIs&_nc_oc=Ado_U4-1qKHvf7kZBowAbnq-LQkKkQnlGgZnuwGmajZKZug0M92amw1QihCxpU1mAyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI2DhduPix8CWqv6bXmnfNPk1pPVW-k4k9exWRqaaS0w&oe=6A9C430C"}, "display_name": "VoxelInteriorMR", "keywords": ["MR", "Voxel"], "long_description": "\u201cVoxel Interior MR\u201d turns your room into an infinite creative canvas.\n\nThis MR interior design app lets you create your own unique furniture and accessories using intuitive voxel art and decorate your actual room with them.\nYou can freely adjust the position, orientation, and size of the objects you create. Without worrying about physical space or budget, you can bring your ideal virtual interior to life right on the spot.\n\nExperience the joy of creating and the excitement of redecorating right in your own room.\n\nTo use the app, press the A, B, X, or Y button to display the menu, then use the trigger to view \u201cHELP.\u201d", "short_description": "\u201cVoxel Interior MR\u201d turns your room into an infinite creative canvas.\n\nThis MR interior design app lets you create your own unique furniture and accessories using intuitive voxel art and decorate your actual room with them.\nYou can freely adjust the position, orientation, and size of the objects you create. Without worrying about physical space or budget, you can bring your ideal virtual interior to life right on the spot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ho-lo.jp/privacy-policy/", "developer_terms_of_service_url": null, "publ
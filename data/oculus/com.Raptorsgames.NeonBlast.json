.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Aa1gkzdHWwQ7kNvwFxTxBO&_nc_oc=AdnDoKCQoI9RgDtS5pRMsjuItXHotj35eEtY7IlZUrK4m0UXopHc4k6K7bgxzCJPAPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftuQ21qTeFscB8IOFccPcgb1P20Bysm4FGOaXCYF50JpQ&oe=69A05015"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blast2560.png", "id": "525515925096423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974684_525515928429756_1954054654482429878_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcHAcoDJUXgQ7kNvwHndrGy&_nc_oc=AdnbHHjWu0wTuDreLkjj3XNzxFpuaLeNEXsJXYz_xLGniGjnbx11khroxdXRLgvV1Ls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0B64CYp4of7pw3yKfr4yrCh97AEZ4mlOLfkBXpX8Z-w&oe=69A04F16"}, "display_name": "Neon Blast VR", "keywords": ["arcade", "shooter", "music", "sound", "neon"], "long_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots\n", "short_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots"}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/Privacy%20Policy%20-%20Neon%20Blast.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptors
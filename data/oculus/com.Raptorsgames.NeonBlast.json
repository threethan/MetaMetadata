74684_525515928429756_1954054654482429878_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVrNSOUg7roQ7kNvwGzu7_1&_nc_oc=Adq_FhW9gl0ENq5s8i0FUiLssvKjQENXKK9Yx2ib0OVZrg3jssUSKnNjNv_zaQ3fJzk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7_vnP7PHEmVvlCpWD42lbrhv8dHtMk8CIMYMidjBspw&oe=6A857BD6"}, "display_name": "Neon Blast VR", "keywords": [], "long_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots\n", "short_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots"}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Aa1gkzdHWwQ7kNvwEODVD4&_nc_oc=AdnGbmOCREmZWUP8T4ItKItwTIibfkGQ90NSlc5HJVRW4cf2f4r1Jr1F0iwNi8aU65E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsmkGL9N1gbULTR_vrNLRAZdSQbn6Q6M1zqN4VTpn198A&oe=699EFE95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blast2560.png", "id": "525515925096423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974684_525515928429756_1954054654482429878_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGmKxz2G-U0Q7kNvwFm7yfx&_nc_oc=AdlCUDxnyMqZAKQWEbm69rojHE-h158WXkht_XBmCL-ngAAAXBiqOToWXvfyi3QY2ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs7RqINSGlaY0H5B2rUUHmolE7KlxkKiqrAPXJ8FMGIFw&oe=699EFD96"}, "display_name": "Neon Blast VR", "keywords": ["arcade", "shooter", "music", "sound", "neon"], "long_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots\n", "short_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots"}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/Privacy%20Policy%20-%20Neon%20Blast.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9842262909166631"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_445512060102816_7766516421672116562_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uim2Ih3mmYwQ7kNvwHL_Bk2&_nc_oc=AdlatzbI5wfoINvK-fmn0AZDoDKPVsHPQixPv96HXcvrdyQFqvhYShiDZlO2V90HTho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuE96Q6Cn3WuLc4JIIM6EK5ZHa3U72q3KlcT0tBiADNJg&oe=699EE61F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Neon Blast VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1621274460, "lastRevision": {"nodes": [{"id": "2765289883685909", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4012505742142406", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "774916586789178"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "
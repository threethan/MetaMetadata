.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9cqTnB2gIwQ7kNvwGV-dlE&_nc_oc=Admre3Nu1DBo4ASWTZswknKx4tgMgwnjEqFUh4PkhMG_lF15-X-WgIKlzrmwXPo1yaw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftPE9n1mvsiVz9BITkXB5IS6XTvlN-5ZVXgIKlQizr5jw&oe=69A1A195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blast2560.png", "id": "525515925096423", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974684_525515928429756_1954054654482429878_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcHAcoDJUXgQ7kNvwEjyfmM&_nc_oc=AdlTKD5zfZ0LDiNXaelVlyd5YWx1nzfxbDYAOwhd2_rzxmTEwCXnb_FrY5PQVs0Ln-c&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftca7md_5kbv_kJYkN-h2QODFKAzNC_OcGPY85GpQolBA&oe=69A1A096"}, "display_name": "Neon Blast VR", "keywords": ["arcade", "shooter", "music", "sound", "neon"], "long_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots\n", "short_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots"}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/Privacy%20Policy%20-%20Neon%20Blast.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptors
9878_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6S9ByAj_p0Q7kNvwEyaK1s&_nc_oc=Adrh3rp5tmqljJMzGV3HKh4BzY9yJQ8u_sAMr9vtANY6LzrLLsjhQffE67-xrmktz28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6otFOgSBat8S53uPYOESbFFw9oITKl_3RGYc_--CaDag&oe=6A032F96"}, "display_name": "Neon Blast VR", "keywords": [], "long_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots\n", "short_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots"}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
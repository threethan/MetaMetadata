.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F09SRy3p2G4Q7kNvwG4tm6V&_nc_oc=AdrL3NZJLskaFZgeD8el0azU8Z7C2YwgtLq-qE6h0duU33d7s-Bi2_1PiETMn3_uJ60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af202m_rjc2_ADWZGXRUcEju3fZXyIiLw0xSfvz0uY512Q&oe=69F0BB95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blast2560.png", "id": "525515925096423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974684_525515928429756_1954054654482429878_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwOID76rLnQQ7kNvwGGiQzJ&_nc_oc=Ado3KQznfqV3Q5ggH1vAWX7decDdlZrnMyTE00sDi6h8Oq7IWE7N7a16IuWiFRnf7iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3oUOf5TstiRaSYVx5uk5wMlKNXMHNsEHUAgj6LyXFokw&oe=69F0BA96"}, "display_name": "Neon Blast VR", "keywords": ["arcade", "shooter", "music", "sound", "neon"], "long_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots\n", "short_description": "This is an exciting VR experience. \"Neon blast\" is an endless shooter where you can enjoy the colorful and unusual neon world.\nVizual sound effects make this game even more original.\n\nThe numbers of shoots is unlimited. But time is limited, it can be increased by shooting at objects.\nThe main thing is don't let the music stop.\n\nFeatures:\n- Sound visualization\n- Neon lights world\n- Infinite numbers of shoots"}]}, "developer_name": "Kaplunov Yurii", "developer_privacy_policy_url": "https://raptorsreality.com/Privacy%20Policy%20-%20Neon%20Blast.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptors
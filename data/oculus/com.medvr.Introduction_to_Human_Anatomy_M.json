9NujukJ9CbQXEt-Jqg&oe=69B69B62"}, {"file_name": "com.oculus.vrshell-20250528-110558.png", "id": "690292123959308", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300972_690292127292641_5125620323420043632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kEkcV_UmYkQ7kNvwH90J4q&_nc_oc=AdkSRd6TP90MxCm4jX4inn47xtqjQdGaRRwsa3B2qNi7n1fCOFwRHNz5mAT8GHFB630&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0WIKufpmkrW4gjYFegF7FTJYZxp6cYWuTbRB_cWMVTg&oe=69B6AC92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Complete Human Anatomy", "keywords": ["Human", "Anatomy", "immerselearn", "vr"], "long_description": "Complete Human Anatomy is a virtual reality simulation designed to provide a comprehensive and engaging review of foundational human anatomy. This hands-on training app covers key modules including body planes, cells, tissues, regions, and quadrants, allowing learners to explore anatomical structures in an immersive 3D environment. Ideal for medical students, healthcare trainees, and anatomy educators, the app enhances understanding through interactive practice, visual learning, and spatial awareness.", "short_description": "Complete Human Anatomy is an immersive VR training app that offers hands-on learning of core anatomical concepts. Explore body planes, cells, tissues, regions, and quadrants in a realistic, interactive environment\u2014perfect for students, educators, and healthcare trainees."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED
16.png", "id": "1675805153133003", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295506_1675805156466336_1649896911198035046_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz9wLy1IqUYQ7kNvwFml9ky&_nc_oc=AdqMThblRkpdnCQeUmpEAjD6Nt0F6L9UypbfciejvGZZvKyvFjyW_VgeLocUB7caOAc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNY-vC2vXbQ1V21Um7oxhEcQ9rSY8zlCoLKZ_aKzUe1g&oe=6A773C28"}, {"file_name": "com.oculus.vrshell-20250528-110923.png", "id": "690825850219146", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293058_690825853552479_8266151275688953961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxJc7X6FS14Q7kNvwEH-mNV&_nc_oc=AdqKprx-UnRB9y6-kRY4km3dZLL0Ak3MWYoEbTHAPuuhiwTFB-eMnsGeaXrDB24iqjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyRTEjiwLaofibSQnJTzVVHlOAI_SFk6Q5_DQkRNDCAA&oe=6A770E14"}, {"file_name": "com.oculus.vrshell-20250528-112503.png", "id": "1962554057615194", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499297336_1962554060948527_2510552217155107236_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amy_2js2Kv4Q7kNvwHkxoly&_nc_oc=AdpZ7BmsaebA0aGeojD3lsi-ug1yQP98keLDNE1To_JdbydAittrzK4xJKtkM9Zncu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrevDR6HnjgVIhiMXaVIXTp1vAoXEHPjIx1vyqvncndA&oe=6A771662"}, {"file_name": "com.oculus.vrshell-20250528-110558.png", "id": "690292123959308", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300972_690292127292641_5125620323420043632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUQyOBVjZyYQ7kNvwG50rdC&_nc_oc=AdpxJutbtCPu8LWfwTR63fIeRSntUecI5-SiE7gfdr29gT5omGUJMcZC6-fYofr75N8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKsx1tO89z5x6RL0gwf8ZTlkkIl94uZ5cSSh-oxgxN7Q&oe=6A772792"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Complete Human Anatomy", "keywords": ["Human", "Anatomy", "immerselearn", "vr"], "long_description": "Complete Human Anat
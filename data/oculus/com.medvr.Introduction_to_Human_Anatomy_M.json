64.5771-25/499297336_1962554060948527_2510552217155107236_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKCNq-XJL5MQ7kNvwEALK0w&_nc_oc=AdpEtglZnEwcrwqecGMKkfT9jj15bBkgpOVsNSpNousD9XbjisJnA1vvGR1zMeEQ03o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kSVipVT_spj2aUZXHDNwxhDPvchy6PR14udZqeFGR_Q&oe=69D24AE2"}, {"file_name": "com.oculus.vrshell-20250528-110558.png", "id": "690292123959308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300972_690292127292641_5125620323420043632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSKXZYK5svQQ7kNvwFBl5aU&_nc_oc=Adolpsvf9EITFhy6-iFp4gbeKlZfv6yL6A5YwEdDuRxhLU5WhsLFOP3K8fdKpHfuGhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OQF-k1DDoI3mL27GLYsT3tgjTCd350eH4rhGPvluJKw&oe=69D25C12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Complete Human Anatomy", "keywords": ["Human", "Anatomy", "immerselearn", "vr"], "long_description": "Complete Human Anatomy is a virtual reality simulation designed to provide a comprehensive and engaging review of foundational human anatomy. This hands-on training app covers key modules including body planes, cells, tissues, regions, and quadrants, allowing learners to explore anatomical structures in an immersive 3D environment. Ideal for medical students, healthcare trainees, and anatomy educators, the app enhances understanding through interactive practice, visual learning, and spatial awareness.", "short_description": "Complete Human Anatomy is an immersive VR training app that offers hands-on learning of core anatomical concepts. Explore body planes, cells, tissues, regions, and quadrants in a realistic, interactive environment\u2014perfect for students, educators, and healthcare trainees."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url"
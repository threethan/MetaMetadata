6A36ACD4"}, {"file_name": "com.oculus.vrshell-20250528-112503.png", "id": "1962554057615194", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499297336_1962554060948527_2510552217155107236_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9PpzIVvaesQ7kNvwEgxDJC&_nc_oc=Ado5ysz2zvlGy7kWQiHGLtlteaQ5myDuzZeV0ceR94mNY5iCfflMmN2iDEefWGIC1k8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m2KhSvBhO6E5c6OKrM5Sgcknn4Jz85sivYQRptCBvdg&oe=6A36B522"}, {"file_name": "com.oculus.vrshell-20250528-110558.png", "id": "690292123959308", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499300972_690292127292641_5125620323420043632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wwnp0lJr37sQ7kNvwGANnWa&_nc_oc=Adr1WgeduX_suNdrL7eFoXwV__wHuimoNWklrnnqsVgxgiO_sjQlIkA3_HOaUMTkgns&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I-CDCBOEmtsQDC0ubjZmTlb_RlEWLgUEityIp8o0TbQ&oe=6A36C652"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Complete Human Anatomy", "keywords": ["Human", "Anatomy", "immerselearn", "vr"], "long_description": "Complete Human Anatomy is a virtual reality simulation designed to provide a comprehensive and engaging review of foundational human anatomy. This hands-on training app covers key modules including body planes, cells, tissues, regions, and quadrants, allowing learners to explore anatomical structures in an immersive 3D environment. Ideal for medical students, healthcare trainees, and anatomy educators, the app enhances understanding through interactive practice, visual learning, and spatial awareness.", "short_description": "Complete Human Anatomy is an immersive VR training app that offers hands-on learning of core anatomical concepts. Explore body planes, cells, tissues, regions, and quadrants in a realistic, interactive environment\u2014perfect for students, educators, and healthcare trainees."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immers
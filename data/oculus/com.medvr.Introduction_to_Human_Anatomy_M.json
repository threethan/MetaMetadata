16.png", "id": "1675805153133003", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295506_1675805156466336_1649896911198035046_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hrWxgb9SV4Q7kNvwH_shic&_nc_oc=AdoLWTMOqXiPph-3LO4jCydZUUa_LgRG_xsls-ZktEnafgK0Bi6WBYVIVoiCRgfCo8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC8mpKYkPmV1hXyMmymn0JeEZo83xKPuNL0T0PPVTxuw&oe=6A5F8128"}, {"file_name": "com.oculus.vrshell-20250528-110923.png", "id": "690825850219146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499293058_690825853552479_8266151275688953961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iispRj70TIoQ7kNvwEuPWjo&_nc_oc=AdpgAlo4rs_WEPqDfH3oV1TnJIBuWa3pS3I_H5nmI5y9VL2DDefqY_Eohl8W9vl7-qI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApvGreDW14tVXrEh3_Tz3-ya91DzcMfXLMHDiLH1vT-g&oe=6A5F8B54"}, {"file_name": "com.oculus.vrshell-20250528-112503.png", "id": "1962554057615194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297336_1962554060948527_2510552217155107236_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7aMGze9KlEQ7kNvwFBZ3US&_nc_oc=Adq0msJrvEHpmkwBzmFSKNrw2iXyr4sLh5E8aCywqfTRjROhkNlSTpBqyxQPCClwb8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcJ3ZGd7IpP8QqwD8kyNMcgeinRI0HCPOpWe9y-Sr5MQ&oe=6A5F5B62"}, {"file_name": "com.oculus.vrshell-20250528-110558.png", "id": "690292123959308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300972_690292127292641_5125620323420043632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75Kc1hxsZEIQ7kNvwHOZGPv&_nc_oc=Adp9kNEdGUCe20-YfUnIpSAtvAYbww_1NpLBIXgQCZIE9mOerPLdb0tc_EG8ku9YVkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh0AIN-gHiG4LuD-1TeEcs7t9qBMJ7ZSYE3d3pv02YjQ&oe=6A5F6C92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Complete Human Anatomy", "keywords": ["Human", "Anatomy", "immerselearn", "vr"], "long_description": "Complete Human Anat
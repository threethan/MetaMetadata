16.png", "id": "1675805153133003", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295506_1675805156466336_1649896911198035046_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRNXuhQ8YnIQ7kNvwE1b9PE&_nc_oc=AdogNrJncpjX-NC_b50wFYGzwx3CY--aMsCWWlP3KOU6PRl8YYasEf-ChlEnLGFDgvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoSTrdLcjQ_0Gc7JOQgABCQKsPtXh_MjGsGpI7ynwPtA&oe=6A68BBA8"}, {"file_name": "com.oculus.vrshell-20250528-110923.png", "id": "690825850219146", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293058_690825853552479_8266151275688953961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=584JVVUf1gkQ7kNvwHKEh_R&_nc_oc=AdonNRZ1sp7oHzss_GD_5XTCf3EXohO7VUFvv_Ttcaevzf_uL9oN8cA2g-WjO3k6tGc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLxSavIcJIkTQBFaOSwsJP8u9XTYJCXq2SljPREBV2UA&oe=6A68C5D4"}, {"file_name": "com.oculus.vrshell-20250528-112503.png", "id": "1962554057615194", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499297336_1962554060948527_2510552217155107236_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37fDMYudWO0Q7kNvwHdl2V3&_nc_oc=AdoQMptIJaJ8Ygmwsw4qgC0m0K7kmN6C6uL15Mn_lBafvtJk1lz3FEzaBkmEbAxtW5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_xsJmDSRRztDpJnPlE3rjruzrKKaYUefSyuDNeM3EEw&oe=6A6895E2"}, {"file_name": "com.oculus.vrshell-20250528-110558.png", "id": "690292123959308", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300972_690292127292641_5125620323420043632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A__Yuz2AwQQ7kNvwFi9f-D&_nc_oc=AdpsQgQqekoZ4MImRLIzwQxH4f6T0uuW_JDl-t9E-wzugOtpL0jdu0k768WqqrC1XmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIn6ykJNgsTBx_firhoTxcDSmJQyih0sAHbAjb_jxxCQ&oe=6A68A712"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Complete Human Anatomy", "keywords": ["Human", "Anatomy", "immerselearn", "vr"], "long_description": "Complete Human Anat
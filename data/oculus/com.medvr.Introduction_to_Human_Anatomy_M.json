64.5771-25/499297336_1962554060948527_2510552217155107236_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FioNXwf-hgcQ7kNvwFH4tAw&_nc_oc=AdpifbCk7LurdKTACrl2lhn_jWXMgA9ba22l4MXyQjLMB0yWV7tliFwNpguXGkiZmhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ttANalRUCVvdYbkbP950OkEj_3LtpCDEhium30i9Kbw&oe=69DF79E2"}, {"file_name": "com.oculus.vrshell-20250528-110558.png", "id": "690292123959308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300972_690292127292641_5125620323420043632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KyWHr3hlLUQ7kNvwHZdE--&_nc_oc=AdplkNiS2C1r6Js2ohlLD8S-ZkR3gQYgsrW3KfhswiiNnxgsAcNHVlPGNH_Wp6A9Vzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Bt0KkcJFhb29sZbP4YLBnW1vbPSsqMwuQIZLZNoKf0Q&oe=69DF8B12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Complete Human Anatomy", "keywords": ["Human", "Anatomy", "immerselearn", "vr"], "long_description": "Complete Human Anatomy is a virtual reality simulation designed to provide a comprehensive and engaging review of foundational human anatomy. This hands-on training app covers key modules including body planes, cells, tissues, regions, and quadrants, allowing learners to explore anatomical structures in an immersive 3D environment. Ideal for medical students, healthcare trainees, and anatomy educators, the app enhances understanding through interactive practice, visual learning, and spatial awareness.", "short_description": "Complete Human Anatomy is an immersive VR training app that offers hands-on learning of core anatomical concepts. Explore body planes, cells, tissues, regions, and quadrants in a realistic, interactive environment\u2014perfect for students, educators, and healthcare trainees."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url"
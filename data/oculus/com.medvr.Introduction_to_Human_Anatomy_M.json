"}, {"file_name": "com.oculus.vrshell-20250528-112503.png", "id": "1962554057615194", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499297336_1962554060948527_2510552217155107236_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_irr-jf9iZ4Q7kNvwH-Pv0z&_nc_oc=Adozz9QyNGHATJxo9lSl9Qsj-nSHW7M_8IhTdkaBHy3sZ0mJn68ncuVFKpUkU6Wv_iM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cZ8EWOC4dSXnnfF0hlN2TGxfTO7jOScJphtjb9y4bjQ&oe=6A32C0A2"}, {"file_name": "com.oculus.vrshell-20250528-110558.png", "id": "690292123959308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300972_690292127292641_5125620323420043632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs5JsbYQED0Q7kNvwFzs45J&_nc_oc=AdpCa9YkYd5FP0Cv9o6_F-eEuVIuY7HtEMGrV9PsFdbBf1TRjrqALgreBNEE91fV2xk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pa6LM2xoRYICe9-9xDFpGA_tNr9G-W8mtwWmFcFE2yQ&oe=6A329992"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Complete Human Anatomy", "keywords": ["Human", "Anatomy", "immerselearn", "vr"], "long_description": "Complete Human Anatomy is a virtual reality simulation designed to provide a comprehensive and engaging review of foundational human anatomy. This hands-on training app covers key modules including body planes, cells, tissues, regions, and quadrants, allowing learners to explore anatomical structures in an immersive 3D environment. Ideal for medical students, healthcare trainees, and anatomy educators, the app enhances understanding through interactive practice, visual learning, and spatial awareness.", "short_description": "Complete Human Anatomy is an immersive VR training app that offers hands-on learning of core anatomical concepts. Explore body planes, cells, tissues, regions, and quadrants in a realistic, interactive environment\u2014perfect for students, educators, and healthcare trainees."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com